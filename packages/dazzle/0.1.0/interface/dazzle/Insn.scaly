    function make_or(host: ref[Page], next_test: ref[Insn]?, next: ref[Insn]?) @ret_explicit_0 true @deep true returns ref[Insn] linked






    function make_and(host: ref[Page], next_test: ref[Insn]?, next: ref[Insn]?) @ret_explicit_0 true @deep true returns ref[Insn] linked






    function make_case(host: ref[Page], obj: ref[ELObj], matched: ref[Insn]?, fail: ref[Insn]?) @ret_explicit_0 true @deep true returns ref[Insn] linked






    function make_pop(host: ref[Page], next: ref[Insn]?) @ret_explicit_0 true @deep true returns ref[Insn] linked






    function make_cons(host: ref[Page], next: ref[Insn]?) @ret_explicit_0 true @deep true returns ref[Insn] linked






    function make_append(host: ref[Page], loc: Location, next: ref[Insn]?) @ret_explicit_0 true @deep true returns ref[Insn] linked






    function make_apply(host: ref[Page], n_args: int, loc: Location, next: ref[Insn]?) @ret_explicit_0 true @deep true returns ref[Insn] linked






    function make_tail_apply(host: ref[Page], n_caller_args: int, n_args: int, loc: Location) @ret_explicit_0 true @deep true returns ref[Insn] linked






    function make_frame_ref(host: ref[Page], index: int, next: ref[Insn]?) @ret_explicit_0 true @deep true returns ref[Insn] linked






    function make_stack_ref(host: ref[Page], index: int, frame_index: int, next: ref[Insn]?) @ret_explicit_0 true @deep true returns ref[Insn] linked






    function make_closure_ref(host: ref[Page], index: int, next: ref[Insn]?) @ret_explicit_0 true @deep true returns ref[Insn] linked






    function make_top_ref(host: ref[Page], ident: ref[Identifier], next: ref[Insn]?) @ret_explicit_0 true @deep true returns ref[Insn] linked






    function make_return(host: ref[Page], total_args: int) @ret_explicit_0 true @deep true returns ref[Insn] linked






    function raw_pop_bindings(host: ref[Page], n: int, next: ref[Insn]?) @ret_explicit_0 true @deep true returns ref[Insn] linked






    ; PopBindingsInsn::make — the peephole: fold into a following Return or
    ; PopBindings so the two never chain.
    function make_pop_bindings(host: ref[Page], n: int, next: ref[Insn]?) @deep true returns ref[Insn] linked











    function make_primitive_call(host: ref[Page], n_args: int, prim: ref[ELObj], loc: Location, next: ref[Insn]?) @ret_explicit_0 true @deep true returns ref[Insn] linked






    function make_closure_insn(host: ref[Page], sig: Signature, code: ref[Insn]?, display_length: int, next: ref[Insn]?) @ret_explicit_0 true @deep true returns ref[Insn] linked






    function make_function_call(host: ref[Page], n_args: int, func: ref[ELObj], loc: Location, next: ref[Insn]?) @ret_explicit_0 true @deep true returns ref[Insn] linked






    function make_function_tail_call(host: ref[Page], n_args: int, func: ref[ELObj], loc: Location, n_caller_args: int) @ret_explicit_0 true @deep true returns ref[Insn] linked






