; --- MifOS: MifOutputByteStream — a byte sink plus the CurTagIndent cursor.
; Several MifOS views can share one byte array (the reference constructs a
; fresh MifOutputByteStream with indent 0 over a stream at commit time). ----
define MifOS (b: ref[Array[u8]], var ind: int)
{
    function make(host: ref[Page], b: ref[Array[u8]], ind: int) returns ref[MifOS] linked





    procedure put(mutable this: ref[MifOS], c: u8) @persists true linked


    procedure raw(mutable this: ref[MifOS], s: Slice[char]) linked









    ; the raw bytes of a String<char>-valued property (T_keyword prints bare)
    procedure str(mutable this: ref[MifOS], s: String) linked













    ; T_string / T_tagstring / T_pathname: backtick + bytes + apostrophe
    procedure tstr(mutable this: ref[MifOS], s: String) linked






    procedure indent(mutable this: ref[MifOS]) linked


    procedure undent(mutable this: ref[MifOS]) linked


    ; `os << '\n' << MifOutputByteStream::INDENT`
    procedure nlind(mutable this: ref[MifOS]) linked










    procedure udec(mutable this: ref[MifOS], n_in: int) linked






















    procedure num(mutable this: ref[MifOS], n: int) linked










    ; T_dimension: sprintf("%li.%.3i", d/1000, abs(d%1000)) with the trailing
    ; zeros (and a bare trailing '.') stripped, then "pt". Values in
    ; (-1000, 0) lose their sign because the integer part prints as 0 —
    ; faithful to the reference.
    procedure dim(mutable this: ref[MifOS], d: int) linked


























































    ; T_percentage: sprintf("%.6f")
    procedure pct(mutable this: ref[MifOS], x: double) linked






























    procedure boolyn(mutable this: ref[MifOS], v: bool) linked







    procedure sp(mutable this: ref[MifOS]) linked


    procedure ltrb(mutable this: ref[MifOS], l: int, t: int, r: int, b2: int) linked










    procedure two(mutable this: ref[MifOS], a: int, b2: int) linked






    ; `<Name ` … `>` at the current indent
    procedure open_prop(mutable this: ref[MifOS], name: Slice[char]) linked







    procedure close_prop(mutable this: ref[MifOS]) linked


    procedure p_dim(mutable this: ref[MifOS], name: Slice[char], v: int) linked






    procedure p_num(mutable this: ref[MifOS], name: Slice[char], v: int) linked






    procedure p_udec(mutable this: ref[MifOS], name: Slice[char], v: int) linked






    procedure p_kw(mutable this: ref[MifOS], name: Slice[char], v: String) linked






    procedure p_tstr(mutable this: ref[MifOS], name: Slice[char], v: String) linked






    procedure p_bool(mutable this: ref[MifOS], name: Slice[char], v: bool) linked






    procedure p_pct(mutable this: ref[MifOS], name: Slice[char], v: double) linked






    procedure p_ltrb(mutable this: ref[MifOS], name: Slice[char], l: int, t: int, r: int, b2: int) linked






    procedure p_two(mutable this: ref[MifOS], name: Slice[char], a: int, b2: int) linked






    ; `<Name ` … open a nested statement and indent
    procedure begin_stmt(mutable this: ref[MifOS], name: Slice[char]) linked








    procedure end_stmt(mutable this: ref[MifOS]) linked





}

