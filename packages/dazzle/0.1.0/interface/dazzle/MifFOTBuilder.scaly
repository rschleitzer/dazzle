define MifFOTBuilder
@resident true (
    host: ref[Page]
    mc: ref[MifConsts]
    ; --- MifDoc state -------------------------------------------------------
    out_loc: String
    var next_id: int
    var obj_id_cnt: int
    var cur_os: ref[MifOS]?
    book_components: ref[Array[ref[MifBookComponent]?]]
    var cur_tbl_num: int
    var doc_format: ref[MifFormat]
    var cur_text_flow: ref[MifTagStream]?
    var cur_cell: ref[MifTagStream]?
    var cur_para: ref[MifTagStream]?
    ts_stack: ref[Array[ref[MifTagStream]?]]
    var ts_depth: int
    cross_ref_infos: ref[Array[ref[MifCrossRefInfo]?]]
    ; ElementSet: the SgmlIdInfo PointerTable + the per-grove flag vectors
    var elem_slots: ref[Array[ref[MifSgmlIdInfo]?]]
    var elem_used: int
    var elem_limit: int
    elem_flags: ref[Array[ref[Array[int]]?]]
    ; the statics: Para::currentlyOpened, ParaLine::setProperties/TextRectID/ATbl
    var para_currently_opened: bool
    var paraline_set: int
    var paraline_text_rect_id: int
    var paraline_atbl: int
    ; --- MifFOTBuilder state ------------------------------------------------
    char_table: ref[Array[int]]
    format_stack: ref[Array[ref[MifFormat]?]]
    var format_depth: int
    next_format: ref[MifFormat]
    display_stack: ref[Array[ref[MifDisplayInfo]?]]
    var display_depth: int
    dsq: ref[Array[ref[MifDsi]?]]
    var dsq_head: int
    var dsq_tail: int
    node_stack: ref[Array[ref[MifNodeInfo]?]]?
    var node_depth: int
    link_stack: ref[Array[ref[MifLinkInfo]?]]
    var link_depth: int
    index_entry_stack: ref[Array[ref[MifMarker]?]]
    var index_depth: int
    var pending_break: int
    var pending_eds: MifEds
    var non_empty_elements_opened: int
    var cur_node_level: int
    var pending_mif_closings: int
    var paragraph_break_in_effect: bool
    var in_leader: bool
    var last_flow_object_was_whitespace: bool
    var first_header_footer: bool
    var in_simple_page_sequence: bool
    var book_component_opened: bool
    var book_component_available: bool
    var cur_leader_stream: ref[MifTmp]?
    sps: ref[MifSps]
    cur_table: ref[MifTable]
    ; the port passes a null NIC pointer where the reference has a
    ; default-constructed one; these stand in for it
    default_dnic: ref[DisplayNIC]
    default_cell_nic: ref[TableCellNIC]
)
