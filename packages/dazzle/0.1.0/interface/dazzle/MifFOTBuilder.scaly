; --- MifFormat: FontFormat + ParagraphFormat + MifFOTBuilder::Format -------
define MifFormat
(
    var ff_set: int
    var f_family: String
    var f_angle: String
    var f_weight: String
    var f_var: String
    var f_size: int
    var f_color: String
    var f_underlining: String
    var f_overline: bool
    var f_strike: bool
    var f_position: String
    var f_pair_kern: bool
    var f_case: String
    var f_dx: double
    var f_dy: double
    var f_dw: double
    var pf_set: int
    var pgf_tag: String
    var pgf_findent: int
    var pgf_lindent: int
    var pgf_rindent: int
    var pgf_alignment: String
    var pgf_sp_before: int
    var pgf_sp_after: int
    var pgf_line_spacing: String
    var pgf_leading: int
    var pgf_num_tabs: int
    var tab_stops: ref[Array[ref[MifTabStop]?]]
    var pgf_placement: String
    var pgf_placement_style: String
    var pgf_with_prev: bool
    var pgf_with_next: bool
    var pgf_block_size: int
    var pgf_auto_num: bool
    var pgf_num_format: String
    var pgf_number_font: String
    var pgf_hyphenate: bool
    var hyphen_max_lines: int
    var hyphen_min_prefix: int
    var hyphen_min_suffix: int
    var hyphen_min_word: int
    var pgf_letter_space: bool
    var pgf_language: String
    var pgf_cell_alignment: String
    var pgf_cm_l: int
    var pgf_cm_t: int
    var pgf_cm_r: int
    var pgf_cm_b: int
    var pgf_cell_l_fixed: bool
    var pgf_cell_t_fixed: bool
    var pgf_cell_r_fixed: bool
    var pgf_cell_b_fixed: bool
    ; --- MifFOTBuilder::Format: the FOT-side snapshot -----------------------
    var fot_first_line_start_indent: LengthSpec
    var fot_start_indent: LengthSpec
    var fot_end_indent: LengthSpec
    var fot_line_spacing: LengthSpec
    var fot_position_point_shift: LengthSpec
    var fot_field_width: LengthSpec
    var fot_min_leading_has: bool
    var fot_cur_display_size: int
    var fot_line_thickness: int
    var fot_line_cap: int
    var fot_border_priority: int
    var fot_border_present: bool
    var fot_line_repeat: int
    var fot_line_sep: int
    var fot_display_alignment: int
    var fot_left_margin: int
    var fot_right_margin: int
    var fot_top_margin: int
    var fot_bottom_margin: int
    var fot_header_margin: int
    var fot_footer_margin: int
    var fot_page_width: int
    var fot_page_height: int
    var fot_field_align: int
    var fot_input_whitespace: int
    var fot_lines: int
    var fot_page_n_columns: int
    var fot_page_column_sep: int
    var fot_span: int
    var fot_page_balance: bool
    var fot_cell_background: bool
    var mif_background_color: String
    var fot_language: int
    var fot_country: int
)
{
    ; the reference Format ctor's member initialiser list
    function make(host: ref[Page]) returns ref[MifFormat] linked





























































































    ; the FontFormat + ParagraphFormat slice (`ParagraphFormat = Format`)
    procedure copy_pf(host: ref[Page], mutable dst: ref[MifFormat], src: ref[MifFormat]) linked


































































    ; the full Format copy (`new Format(nextFormat)` / `nextFormat = *head`)
    procedure copy_all(host: ref[Page], mutable dst: ref[MifFormat], src: ref[MifFormat]) linked






































    procedure set_dsssl_defaults(mutable this: ref[MifFormat], mc: ref[MifConsts]) linked





















































    ; FontFormat::compare
    function ff_compare(a: ref[MifFormat], b2: ref[MifFormat]) returns int linked



































    ; FontFormat::setFrom
    procedure ff_set_from(mutable dst: ref[MifFormat], src: ref[MifFormat], props: int) linked

































    procedure ff_update_from(mutable dst: ref[MifFormat], src: ref[MifFormat]) linked






    ; ParagraphFormat::compare
    function pf_compare(a: ref[MifFormat], b2: ref[MifFormat]) returns int linked












































































    ; ParagraphFormat::setFrom
    procedure pf_set_from(mutable dst: ref[MifFormat], src: ref[MifFormat], props: int, fprops: int) linked







































































    procedure pf_update_from(mutable dst: ref[MifFormat], src: ref[MifFormat]) linked







    procedure clear_set_props(mutable this: ref[MifFormat]) linked





    ; FontFormat::out — `is_pgf_font` picks the statement name
    procedure ff_out(this: ref[MifFormat], mutable os: ref[MifOS], props: int, is_pgf_font: bool) linked







































}

