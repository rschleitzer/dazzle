    procedure set_msg_prog(prog: pointer[const_char]) @deep true @deep_beyond_1 true @deep_whole_1 true mutable msg_prog reads msg_prog linked

    ; render one diagnostic line to stderr, byte-identical to the reference
    ; MessageReporter::dispatchMessage the style Interpreter reports through:
    ;   <prog>:[<file>:<line>[:<col>]:]<sev>: <formatted text>\n
    ; The location is the Messenger's next-location (setNextLocation), CONSUMED
    ; by this message (initMessage clears it). A null-origin location renders
    ; no location segment at all (`<prog>:I: called from here`); a non-null
    ; origin whose chain names no real backing source renders the reference's
    ; "(invalid location)". Errors count; Info (stack traces) does not.
    procedure emit(mutable this: ref[Interpreter], mt: MessageType, args: Vector[MessageArg]) @deep true io reads msg_prog linked

    ; an auxiliary message line (`<prog>:<file>:<line>:<col>: <text>` — no
    ; severity char; the reference MessageReporter's auxiliary fragment, e.g.
    ; duplicateDefinition's "first definition was here").
    ; ★The parameter is a MessageFragment, not a MessageType, and said so in
    ; the wrong place until 2026-08-23: every caller hands over an `*_aux()`
    ; accessor, all of which return MessageFragment, and the body only ever
    ; wants the template text. It ran correctly because MessageType's FIRST
    ; field IS a MessageFragment, so MessageType.get_text() read `fragment.text`
    ; at exactly the offset the argument's own `text` sits at — right by
    ; layout coincidence. Caught by lookup_method#'s type gate the day it
    ; landed; nothing else could see it, since emit_call builds the callee's
    ; type from the argument VALUES.
    procedure emit_aux(mutable this: ref[Interpreter], mt: MessageFragment, loc: Location) @deep true io reads msg_prog linked
}
