; Interpreter — the style-language interpreter (style/Interpreter.cxx).
; Inc-2 scope: the READER seam the SchemeParser datum reader needs — the
; lexical-category table, symbol/keyword/identifier interning, number
; conversion (convertNumber family incl. quantities and units), character
; names (charNames.h table + U-XXXX), sdata entity mapping, and the
; standard-chars / add-name-chars / add-separator-chars / map-sdata-entity
; declaration hooks. The evaluation half (syntactic keys, primitives,
; processing modes, Insn/VM) lands with Inc 3 per DESIGN.md.
;
; Messages: text/severity sourced from the generated InterpreterMessages
; table (InterpreterMessages.msg). Rendering here is the package-level seam
; (`dazzle:<severity>: <text>` on stderr + error count); the full
; file:line:col MessageReporter prefix is the CLI driver's job and lands
; with Inc 7 (DssslApp/CmdLineApp port), like the reference where the app
; object IS the Messenger.

; argv0 for the MessageReporter prefix (`<argv0>:<file>:<line>:<col>:<sev>: …`,
; exactly the reference where the app object IS the Messenger). The CLI driver
; sets this once before processing; unset (unit tests, --jit suite) the prefix
; stays the historical package name `dazzle`. A `shared` module global, not an
; Interpreter field — growing a heap-hosted struct in the dazzle run region
; trips the page-boundary RBMM fragility (S62), and `mutable` (TLS) in a dep
; package aborts under --jit.
shared msg_prog: pointer[const_char] linked

; whether the active backend provides the transform extension flow-object
; classes (jade.cxx passes an extension table only for -t sgml/xml); the CLI
; clears it for -t fot. A `shared` module global by the S62 rule (no
; Interpreter field growth); single-threaded CLI setup writes it once.
shared xt_extensions_on: bool linked

; MessageReporter's column-omission sentinel (opensp.Location COL_OMITTED —
; module-level consts are not cross-package-visible; mirrored here).
define MSG_COL_OMITTED: u32 0xFFFFFFFF

; Interpreter::LexCategory
define LEX_LETTER: int 0            ; a-z A-Z
define LEX_OTHER_NAME_START: int 1  ; !$%&*/<=>?~_^:
define LEX_ADD_NAME_START: int 2
define LEX_DIGIT: int 3             ; 0-9
define LEX_OTHER_NUMBER_START: int 4 ; -+.
define LEX_OTHER: int 5
define LEX_DELIMITER: int 6         ; ();"
define LEX_WHITESPACE: int 7
define LEX_ADD_WHITESPACE: int 8

; the printer's replacement char for unknown character names
define DEFAULT_CHAR: int 0xFFFD

; Unit::computed_ states
define UNIT_NOT_COMPUTED: int 0
define UNIT_BEING_COMPUTED: int 1
define UNIT_COMPUTED_EXACT: int 2
define UNIT_COMPUTED_INEXACT: int 3
define UNIT_COMPUTED_ERROR: int 4

; strtod(3) — fixed-prototype, non-variadic, errno-free use: direct extern
; per the containment rule.
function strtod(s: pointer[const_char], endp: pointer[pointer[u8]]) returns double extern

; the memo-host seam's one switch (DZ_MEMO_PERM)
function getenv(name: pointer[const_char]) returns pointer[const_char] extern

; A named-character-table entry (Interpreter::CharPart): the char plus the
; index of the defining part (unsigned(-1) = predefined).
define CharPart (name: StringC, var c: u32, var def_part: u32)
{
    init(name: StringC, c: u32, def_part: u32) linked
}

; CharProp (Interpreter.h) — one character property: a DEFAULT value plus a
; per-character map. The reference's map is a full CharMap<ELObjPart> whose
; unset slot is a null object; here it is an ordered list of
; [first, last] -> value entries searched BACKWARD, so a later
; add-char-properties overrides an earlier install exactly as setChar over
; setRange does. `def_part` carries the spec part that supplied the default,
; which is what the duplicate-declaration rule compares.
; ★`part` is the ELObjPart half of the reference's CharMap<ELObjPart>
; (Interpreter.cxx:2347): a per-character value remembers WHICH PART set it,
; because that is what decides between overwrite, silence and a duplicate
; diagnostic.
define CharPropRange (first: u32, last: u32, obj: ref[ELObj]?, part: u32)
{
    init(first: u32, last: u32, obj: ref[ELObj], part: u32) linked
}

define CharProp (name: StringC, var def: ref[ELObj], var def_part: u32, var loc: Location, ranges: ref[Array[CharPropRange]])
{
    function make(host: ref[Page], name: StringC, def: ref[ELObj], def_part: u32) @ret_explicit_0 true @deep true returns ref[CharProp] linked

    ; CharMap::setRange — a later entry wins, so the lookup walks BACKWARD.
    procedure set_range(mutable this: ref[CharProp], first: u32, last: u32, obj: ref[ELObj], part: u32) @persists true @deep true @deep_this_8 true @deep_whole_8 true linked

    ; the part that last set this character's own value; 0xFFFFFFFF when it
    ; has none (the reference's ELObjPart(0, unsigned(-1)) default).
    function lookup_part(this: CharProp, c: u32) @ret_param_0 true @deep true returns u32 linked

    ; (*cp->map)[c].obj — null when the character has no value of its own.
    function lookup(this: CharProp, c: u32) @ret_param_0 true @deep true returns ref[ELObj]? linked
}

; Unit — a named measurement unit (Interpreter.h class Unit : Named).
; Builtin units get their value from unitsPerInch in installUnits (setValue
; marks them computedExact/Inexact); define-unit bodies arrive via
; setDefinition and compute lazily in tryCompute (canEval-gated without
; force, exactly the reference's eager-top-level shape).
define Unit (name: StringC, var computed: int, var exact: int, var inexact: double, var dim: int, var def_part: u32, var def_expr: ref[Expression]?, var def_insn: ref[Insn]?, var def_loc: Location)
{
    function make(host: ref[Page], name: StringC) @ret_explicit_0 true @deep true returns ref[Unit] linked

    ; void setDefinition(Owner<Expression> &, unsigned part, const Location &)
    ; — the define-unit body; computed resets so the next resolve recomputes.
    procedure set_definition(mutable this: ref[Unit], expr: ref[Expression]?, part: u32, loc: Location) @deep true @deep_this_10 true @deep_whole_10 true linked

    ; bool defined(unsigned &part, Location &loc)
    procedure defined(this: ref[Unit], mutable part_out: ref[u32], mutable loc_out: ref[Location]) @ret_nonlocal true @deep true returns bool linked

    function get_name(this: Unit) @page true @direct true @ret_param_0 true @deep true returns StringC linked

    ; void setValue(long)
    procedure set_value_long(mutable this: ref[Unit], n: int) @deep true linked

    ; void setValue(double)
    procedure set_value_double(mutable this: ref[Unit], n: double) @deep true linked

    ; bool defined(unsigned &part, Location &loc) — Inc-2 subset: no def_
    ; expression yet, so defined <=> a computed value exists (the out-params
    ; feed doDefineUnit's duplicate diagnostics, Inc 3).
    function is_defined(this: Unit) @ret_param_0 true @deep true returns bool linked

    ; static bool scale(long val, int valExp, long factor, long &result):
    ; result = val * 10^valExp * factor, 0 on overflow.
    procedure scale(val: int, val_exp_in: int, factor_in: int, mutable result: ref[int]) @ret_nonlocal true @deep true returns bool linked

    ; ELObj *resolveQuantity(bool force, Interpreter &, long val, int valExp)
    ; (val * 10^valExp of this unit; the unit's own exponent is 1).
    procedure resolve_quantity_long(mutable this: ref[Unit], force: bool, mutable interp: ref[Interpreter], val: int, val_exp_in: int) @ret_param_2 true @deep true @deep_this_4 true @deep_whole_4 true returns ref[ELObj]? io reads msg_prog linked

    ; ELObj *resolveQuantity(bool force, Interpreter &, double val, int unitExp)
    procedure resolve_quantity_double(mutable this: ref[Unit], force: bool, mutable interp: ref[Interpreter], val: double, unit_exp_in: int) @ret_param_2 true @deep true @deep_this_4 true @deep_whole_4 true returns ref[ELObj]? io reads msg_prog linked

    ; void tryCompute(bool force, Interpreter &) — evaluate the define-unit
    ; body (compiled once); without force only a canEval body computes (the
    ; reference's lazy top-level shape); a recursive resolve is the unitLoop
    ; error; a non-quantity result is badUnitDefinition at the definition.
    procedure try_compute(mutable this: ref[Unit], force: bool, mutable interp: ref[Interpreter]) @deep true @deep_this_4 true @deep_whole_4 true io reads msg_prog linked
}

; externalProcTable_ entry: a public identifier -> primitive value binding
; (Interpreter::installPrimitive / installXPrimitive; external-procedure
; resolves against it). Linear array, insertion order.
define ExternalProc (pubid: StringC, value: ref[ELObj]?)
{
    function make(host: ref[Page], pubid: StringC, value: ref[ELObj]) @ret_explicit_0 true @deep true returns ref[ExternalProc] linked
}

define Interpreter
(
    var host: ref[Page]
    var units_per_inch: int
    var debug_mode: bool
    var dsssl2: bool
    var strict_mode: bool
    var part_index: u32
    var d_part_index: u32
    ; the permanent singletons (one per run; eqv? = identity)
    var nil_obj: ref[ELObj]
    var true_obj: ref[ELObj]
    var false_obj: ref[ELObj]
    var error_obj: ref[ELObj]
    var unspecified_obj: ref[ELObj]
    ; interning tables. The Array holds the objects in insertion order (the
    ; reference's NamedTable owns its entries the same way); the NameTable
    ; beside it is the hash index that answers a lookup — see the module
    ; header there for why the linear scan had to go.
    var symbol_table: ref[Array[ref[ELObj]?]]
    var ident_table: ref[Array[ref[Identifier]?]]
    var symbol_index: ref[NamedTable[ELObj]]
    var ident_index: ref[NamedTable[Identifier]]
    var unit_table: ref[Array[ref[Unit]?]]
    var named_char_table: ref[Array[ref[CharPart]?]]
    var sdata_entity_name_table: ref[Array[ref[CharPart]?]]
    var sdata_entity_text_table: ref[Array[ref[CharPart]?]]
    var lex_category_table: ref[XcharMap]
    ; Messenger seam (see header note): counts + prints; the driver owns
    ; the full location-prefixed rendering (Inc 7).
    var error_count: int
    var next_loc: Location
    ; processing modes (Style/Interpreter.cxx): the unnamed initial mode plus
    ; every named mode (mode NAME …). Rules register here; compile() finalises.
    var initial_mode: ref[ProcessingMode]
    var processing_mode_table: ref[Array[ref[ProcessingMode]?]]?
    ; declare-default-language: the declaration expression (evaluated by
    ; compile(), like the reference compileDefaultLanguage) and the resulting
    ; language value char-upcase/downcase consult.
    var default_language_def: ref[Expression]?
    var default_language_part: int
    var default_language_loc: Location
    var default_language: ref[ELObj]?
    ; NumberCache — the reference DERIVES Interpreter from it
    ; (style/Interpreter.h:303), so `element-number` reaches it as a method on
    ; the interpreter. One per run; the grove-order vector it steps along hangs
    ; off the grove, not off this.
    var number_cache: ref[NumberCache]
    ; charProperties_ — the character-property table (installCharProperties +
    ; declare-char-property + add-char-properties).
    var char_property_table: ref[Array[ref[CharProp]?]]
    ; externalProcTable_ — public id -> FunctionObj (external-procedure).
    var external_proc_table: ref[Array[ref[ExternalProc]?]]
    ; the canned border styles (a single border-present? spec; table borders
    ; specified as booleans resolve to these).
    var border_true_style_obj: ref[ELObj]?
    var border_false_style_obj: ref[ELObj]?
    ; nextGlyphSubstTableUniqueId_ — the fot dump's gst<n> ids.
    var next_gst_unique_id: int
    ; nInheritedC_ — the next fresh IC index (registry entries end at 164;
    ; declare-characteristic extensions allocate from here).
    var next_ic_index: int
    ; the backend extension characteristic table selector: true under -t rtf
    ; (jade.cxx passes the RtfFOTBuilder extension table; fot/transform have
    ; none in this port — the IgnoredC fallback).
    var rtf_extensions: bool
    var tex_extensions: bool
    var html_extensions: bool
    var mif_extensions: bool
    ; declared initial values (declare-initial-value / declare-characteristic):
    ; parallel ident/expr arrays, compiled into initialStyle_ by compile().
    var initial_value_names: ref[Array[ref[Identifier]?]]
    var initial_value_exprs: ref[Array[ref[Expression]?]]
    var current_part_first_initial_value: int
    var initial_style_obj: ref[ELObj]?
    ; nodePropertyTable_ — the grove ComponentName metamodel (both the RCS and
    ; the SDQL spelling of all 107 component names).
    var component_names: ref[ComponentName]
    ; Pattern::MatchContext — the reference's Interpreter IS the match context,
    ; and these are its two vectors: the attribute names that carry a CLASS and
    ; an ID, filled by declare-class-attribute / declare-id-attribute (both
    ; dsssl2-only forms). The class qualifier can match NOTHING while the class
    ; list is empty; the id qualifier still has the grove's own ID attribute.
    var class_attribute_names: ref[Array[ref[StringC]?]]
    var id_attribute_names: ref[Array[ref[StringC]?]]
    ; Interpreter::groveManager_ — the driver's (DssslApp IS one); null under
    ; the unit paths, where no document is parsed and nothing folds.
    var grove_mgr: ref[GroveManager]?
    ; where this interpreter lays its messages instead of writing them (null:
    ; it writes) -- ParserState.emit_or_hold; the program sets it around the
    ; reading of the stylesheet
    var msg_hold: ref[Array[u32]]?
    ; the sibling-position memo GroveNode.group_index reads and refreshes
    var sib_hint: ref[SiblingHint]
    ; The eval scratch region (Collector seam, RBMM shape): while ProcessContext
    ; evaluates a construction rule, get_host() returns this region instead of
    ; the run page, so every eval-transient (intermediate ELObjs, sosofo trees,
    ; per-call insns, fresh VMs) dies with the node's bracket instead of
    ; retaining until run end — the reference reclaims the same objects with
    ; Clark's GC. null outside processing (load/compile allocate on the run
    ; page as before). Interning (symbols/identifiers/units) and Identifier
    ; value forcing go to the PERM host explicitly (makePermanent semantics).
    var eval_region: ref[Page]?
    ; the region the lazy memos of `memo_for`'s bracket go to (memo_host)
    var memo_for: ref[Page]?
    var memo_region: ref[Page]?
    ; where a frame's result waits while the frame is rewound (ELObj.evacuate):
    ; a region of its own under the run arena, empty between two uses
    var evac_region: ref[Page]?
    var evac_mark: pointer[void]
    ; the frame mark's state block (FrameMark.create; null: the mark is off)
    var frame_mark: pointer[i64]
)
{
    procedure make(host: ref[Page], units_per_inch: int, debug_mode: bool, dsssl2: bool, strict_mode: bool) @deep true @deep_beyond_1 true @deep_whole_1 true returns ref[Interpreter] io reads msg_prog linked

    procedure set_lex_ascii(mutable lex: ref[XcharMap], s: Slice[char], cat: u8) @deep true linked

    ; LexCategory lexCategory(Xchar c)
    function lex_category(this: Interpreter, c: i32) @ret_param_0 true @deep true returns int linked

    ; the allocation page (Collector seam) — cross-module allocation sites
    ; reach it through this accessor: the eval scratch region while a
    ; construction rule evaluates, the run arena page otherwise.
    function get_host(this: Interpreter) @ret_param_0 true @deep true returns ref[Page] linked

    ; the run arena page unconditionally — for allocations that must outlive
    ; the eval bracket (interning, forced Identifier values).
    function get_perm_host(this: Interpreter) @ret_param_0 true @deep true returns ref[Page] linked

    ; --- the LAZY MEMO host (DZ_MEMO_PERM) ----------------------------------
    ;
    ; ★★★Where a lazy MEMOISATION puts its storage: the array a node-list view
    ; fills on demand, the flattened buffer of a string rope. Until now that was
    ; `Page.get(the object)` — the END of the object's own region — with the
    ; documented reason that the memo must live exactly as long as the object,
    ; and a caller's host can be shorter-lived. Right against BRACKET
    ; granularity, and the class that shaped both the frame mark's store sweep
    ; and the escape audit: within ONE region the region's end is above every
    ; live frame mark, so the memo of an outer frame's object is younger than the
    ; object. Two consequences, both measured: memoisation PUBLISHES under the
    ; mark (10.5 M frames blocked), and every node-list and string-rope primitive
    ; has to stay conservative in the escape analysis (its 8.8x gate).
    ;
    ; This makes the choice a seam instead of an idiom: on the RUN arena the memo
    ; is older than every frame and every bracket, so neither problem can arise —
    ; at the price of memo storage that outlives the bracket it was filled in.
    ; The elements stored are grove nodes (permanent) or the rope's own flattened
    ; buffer, so nothing here can create a pointer from the run arena into a
    ; shorter-lived region.
    ;
    ; ★★★It FOLLOWS THE MARK (see memo_host), because the two only make sense
    ; together. With the mark it is a large win, because memoisation stops
    ; PUBLISHING: 18.9 M publications become 1.4 M, 4.1 M more frames are
    ; rewound, 10.03 -> 17.22 GB reclaimed, peak footprint 3911 -> 3463 MB
    ; (-11.5 %). Without the mark the same change is pure retention and costs
    ; +18 % peak (5966 -> 7047 MB), so alone it is never right.
    ;
    ; ★★★And the reason this stood OFF for a day is the most valuable thing the
    ; seam produced: with the mark it made 3 of the 48 real-world codegens write
    ; garbage. It was not this placement — mark + memo on the object's region was
    ; identical, and memo on the run arena WITHOUT the mark was identical too. It
    ; was the extra REWINDS: removing 17.5 M publications took away a blanket
    ; protection nobody had meant as one, and exposed a hole in the mark's rule.
    ; The hole is condition 6 (BACKFILL) in `FrameMark.scaly`, and it was not a
    ; missing store hook at all — `Page.allocate` serves from the page it is
    ; CALLED ON, so the region head kept handing out small objects BELOW every
    ; live mark. With that condition in place this configuration is 48/48
    ; byte-identical, which is why the seam is armed.
    ;
    ; ★The seam FOLLOWS THE MARK. On its own the run-arena host is pure
    ; retention (+18 % peak, measured); together with the mark it is a large
    ; win, because memoisation stops publishing — so it is on exactly when the
    ; mark is, and `DAZZLE_FRAME_MARK=0` turns both off.
    ;
    ; The run arena is kept in the mark's own state block (FrameMark.set_perm,
    ; from `make`): the lazy flatten deep in ELObj that asks has the object and
    ; a transient host, not the interpreter.
    function memo_host(this: Interpreter, own: ref[Page]) @deep true returns ref[Page] linked

    function get_evac_region(this: Interpreter) @ret_param_0 true @deep true returns ref[Page] linked

    procedure reset_evac_region(mutable this: ref[Interpreter]) @ret_nonlocal true @deep true linked

    function get_memo_for(this: Interpreter) @ret_param_0 true @deep true returns ref[Page]? linked

    function get_memo_region(this: Interpreter) @ret_param_0 true @deep true returns ref[Page]? linked

    procedure set_memo(mutable this: ref[Interpreter], region: ref[Page]?, memo: ref[Page]?) @deep true @deep_this_6 true @deep_whole_6 true linked

    ; The CLI's `--no-frame-mark`: the mark and the memo seam that follows it
    ; go off together. Runs before the first VM is made, since every VM copies
    ; the block.
    procedure disable_frame_mark(mutable this: ref[Interpreter]) @deep true linked

    function get_eval_region(this: Interpreter) @ret_param_0 true @deep true returns ref[Page]? linked

    ; `p` is the NULLABLE form because clearing the region is the documented
    ; operation: Identifier.compute_value and Expression.make_macro both pass
    ; null to take the eval scratch region out of play, and the field starts
    ; null too.
    procedure set_eval_region(mutable this: ref[Interpreter], p: ref[Page]?) @deep true @deep_this_2 true @deep_whole_2 true linked

    function is_dsssl2(this: Interpreter) @ret_param_0 true @deep true returns bool linked

    ; Interpreter::addClassAttributeName / addIdAttributeName (Interpreter.h:742)
    ; — the MatchContext vectors the class and id pattern qualifiers read. The
    ; name is stored as declared; matchAttribute normalizes on the way in.
    procedure add_class_attribute_name(mutable this: ref[Interpreter], name: ref[StringC]) @persists true @deep true @deep_this_2 true @deep_whole_2 true linked

    procedure add_id_attribute_name(mutable this: ref[Interpreter], name: ref[StringC]) @persists true @deep true @deep_this_2 true @deep_whole_2 true linked

    function get_class_attribute_names(this: Interpreter) @ret_param_0 true @deep true returns ref[Array[ref[StringC]?]]? linked

    function get_id_attribute_names(this: Interpreter) @ret_param_0 true @deep true returns ref[Array[ref[StringC]?]]? linked

    ; ★The grove ID index, the governing DTD and the fold table used to live
    ; here as interpreter state — right only while exactly one grove could
    ; exist. They are GroveInfo fields now, one record per grove, and every
    ; consumer reaches its own through Node::getGroveRoot (dazzle/Grove.scaly).

    function get_units_per_inch(this: Interpreter) @ret_param_0 true @deep true returns int linked

    ; --- singletons --------------------------------------------------------
    function make_nil(this: Interpreter) @ret_param_0 true @deep true returns ref[ELObj] linked

    function make_true(this: Interpreter) @ret_param_0 true @deep true returns ref[ELObj] linked

    function make_false(this: Interpreter) @ret_param_0 true @deep true returns ref[ELObj] linked

    ; #t / #f from a Scaly bool (Primitive predicate results).
    function make_bool(this: Interpreter, b: bool) @ret_param_0 true @deep true returns ref[ELObj] linked

    function make_error(this: Interpreter) @ret_param_0 true @deep true returns ref[ELObj] linked

    function make_unspecified(this: Interpreter) @ret_param_0 true @deep true returns ref[ELObj] linked

    function is_error(this: Interpreter, obj: ref[ELObj]?) @ret_param_1 true @deep true returns bool linked

    ; endPart(): the next specification part (later parts' defines lose to
    ; earlier ones — doDefine's defPart gate).
    ; Interpreter::dEndPart (Interpreter.cxx:755) — the DECLARATION phase has
    ; its own part counter, separate from end_part's: declarations of all
    ; parts are processed before any body element, so the two numbering
    ; schemes cannot share a counter. `d_part_index` is what
    ; `def_char`/`add_sdata_entity` arbitrate on (earlier part wins, same part
    ; with a different value is a duplicate diagnostic).
    procedure d_end_part(mutable this: ref[Interpreter]) @deep true linked

    procedure end_part(mutable this: ref[Interpreter]) @deep true linked

    ; installBuiltins brackets the builtins parse with part index -1 (so any
    ; user define overrides a builtin), then endPart wraps back to 0.
    procedure set_part_index(mutable this: ref[Interpreter], n: u32) @deep true linked

    ; --- processing modes --------------------------------------------------
    function current_part_index(this: Interpreter) @ret_param_0 true @deep true returns u32 linked

    function initial_processing_mode(this: Interpreter) @ret_param_0 true @deep true returns ref[ProcessingMode] linked

    ; lookupProcessingMode(name): the named mode, created (with the initial mode
    ; as fall-through parent) on first reference.
    procedure lookup_processing_mode(mutable this: ref[Interpreter], str: StringC) @ret_param_0 true @deep true @deep_this_2 true @deep_whole_2 true returns ref[ProcessingMode] linked

    ; WithModeExpression::compile's defined() gate — the check + undefinedMode
    ; message live on this seam because the message table does, not because
    ; Expression could not name ProcessingMode (see VM.processing_mode).
    procedure check_mode_defined(mutable this: ref[Interpreter], mode: ref[ProcessingMode]?, loc: Location) @deep true @deep_this_4 true @deep_whole_4 true io reads msg_prog linked

    ; compile(): finalise every mode's rules (Interpreter::compile). Top-level
    ; definitions used by rule bodies compute lazily via TopRefInsn at eval.
    ; The sorted element-rule scan order is built HERE (not lazily on the
    ; first find_match): during processing get_host() is the eval scratch
    ; region, and a lazily-built sorted array would dangle after the bracket.
    procedure compile(mutable this: ref[Interpreter]) @deep true io reads msg_prog linked

    ; --- declare-default-language (Interpreter::compileDefaultLanguage) -----
    ; --- character properties (Interpreter.cxx:2064-2380) -------------------

    function lookup_char_property(this: ref[Interpreter], nm: StringC) @deep true returns ref[CharProp]? linked

    ; the installCharProperties helper: a fresh property with `def` as its
    ; default and defPart -1 (predefined).
