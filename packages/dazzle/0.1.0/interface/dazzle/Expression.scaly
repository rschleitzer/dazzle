use scaly.memory.Page
use scaly.containers.Array
use opensp.Location.Location
use opensp.StringC.StringC
use dazzle.ELObj.ELObj
use dazzle.ELObj.Identifier
use dazzle.ELObj.FlowObj
use dazzle.ELObj.MacroDef
use dazzle.ELObj.OutputCharStream
use dazzle.Insn.Insn
use dazzle.Insn.Signature
use dazzle.Interpreter.Interpreter
use dazzle.InterpreterMessages.InterpreterMessages
use dazzle.Style.InheritedC
use dazzle.Style.Convert
use dazzle.Style.DisplayNIC
use dazzle.ProcessingMode.ProcessingMode

; Expression — the compiled-form AST (Style/Expression.cxx). Each Expression
; compiles to an Insn chain against a compilation Environment that resolves
; lexical variables to frame / closure-display slots and tracks which need
; boxing (assigned or captured-and-is_shared). The C++ optimize() constant-folding
; pass is a pure performance/IR transform — the interpreter yields *values*,
; so folding never changes a result; it is a no-op here and joins later if
; byte-identical IR is ever needed. markBoundVars (the box/unbox analysis) and
; compile are ported faithfully — they are correctness-bearing. Style / make /
; with-mode expressions join with the FOT machinery in a later increment.

; BoundVar flags (Expression.cs BoundVar).
define BV_USED: u32 0x1
define BV_ASSIGNED: u32 0x2
define BV_UNINIT: u32 0x4
define BV_SHARED: u32 0x8
define BV_NOT_USED_MASK: u32 0xFFFFFFFE

define BoundVar (ident: ref[Identifier]?, var flags: u32, var rebound_count: u32)
{
    init(ident: ref[Identifier]?, flags: u32) linked






    function boxed(this: BoundVar) returns bool linked


    function flags_boxed(flags: u32) returns bool linked

}

; A growable BoundVar list (Expression.cs BoundVarList) with the compile-time
; mutation ops (mark/rebind/unbind/removeUnused/resize).
define BoundVarList (host: ref[Page], var buf: Slice[BoundVar], var n: int, var cap: int)
{
    function make(host: ref[Page]) returns ref[BoundVarList] linked





    function make_from_idents(host: ref[Page], idents: ref[Array[ref[Identifier]?]]) returns ref[BoundVarList] linked












    ; BoundVarList(idents, n, flags): first n idents, flags & ~usedFlag.
    function make_from_idents_n(host: ref[Page], idents: ref[Array[ref[Identifier]?]], n: int, flags: u32) returns ref[BoundVarList] linked












    function copy(host: ref[Page], other: ref[BoundVarList]) returns ref[BoundVarList] linked












    function count(this: BoundVarList) returns int linked


    function get_host(this: BoundVarList) returns ref[Page] linked


    function at(this: BoundVarList, i: int) returns ref[BoundVar] linked


    procedure ensure_cap(mutable this: ref[BoundVarList], need: int) linked




















    procedure append(mutable this: ref[BoundVarList], ident: ref[Identifier]?, flags: u32) linked







    procedure append_raw(mutable this: ref[BoundVarList], ident: ref[Identifier]?, flags: u32, rebound: u32) linked







    procedure resize(mutable this: ref[BoundVarList], m: int) linked










    function find_index(this: BoundVarList, ident: ref[Identifier]?) returns int linked











    function find(this: BoundVarList, ident: ref[Identifier]) returns ref[BoundVar]? linked







    procedure mark(mutable this: ref[BoundVarList], ident: ref[Identifier]?, flags: u32) linked










    procedure rebind(mutable this: ref[BoundVarList], idents: ref[Array[ref[Identifier]?]]) linked















    procedure unbind(mutable this: ref[BoundVarList], idents: ref[Array[ref[Identifier]?]]) linked















    procedure remove_unused(mutable this: ref[BoundVarList]) linked















}

define FrameVarList (vars: ref[BoundVarList]?, stack_pos: int, next: ref[FrameVarList]?)

; Compilation environment (Expression.cs Environment): a chain of frame-var
; scopes plus the enclosing closure's captured vars.
define Environment (closure_vars: ref[BoundVarList]?, var frame_var_list: ref[FrameVarList]?)
{
    function make(host: ref[Page]) returns ref[Environment] linked





    function copy(host: ref[Page], other: ref[Environment]) returns ref[Environment] linked





    function make_with(host: ref[Page], frame_vars: ref[BoundVarList], closure_vars: ref[BoundVarList]?) returns ref[Environment] linked






    procedure lookup(this: Environment, ident: ref[Identifier]?, mutable is_frame: ref[bool], mutable index: ref[int], mutable flags: ref[u32]) returns bool linked































    procedure bound_vars(this: Environment, mutable result: ref[BoundVarList]) linked




























    procedure augment_frame(mutable this: ref[Environment], host: ref[Page], vars: ref[BoundVarList]?, stack_pos: int) linked




}

; --- expression arm records ------------------------------------------------
define ConstantExpr (obj: ref[ELObj]?, loc: Location)
define ResolvedConstantExpr (obj: ref[ELObj]?, loc: Location)
; is_top mirrors VariableExpression::isTop_ — stamped when a compile/fold
; resolves the reference to the TOP level (no frame binding); canEval reads it.
define VariableExpr (ident: ref[Identifier]?, loc: Location, is_top: bool)
define IfExpr (test: ref[Expression], consequent: ref[Expression], alternate: ref[Expression]?, loc: Location)
define OrExpr (test1: ref[Expression], test2: ref[Expression], loc: Location)
define AndExpr (test1: ref[Expression], test2: ref[Expression], loc: Location)
define CallExpr (op: ref[Expression], args: ref[Array[ref[Expression]?]], loc: Location)
define SequenceExpr (seq: ref[Array[ref[Expression]?]], loc: Location)
define LetExpr (vars: ref[Array[ref[Identifier]?]]?, inits: ref[Array[ref[Expression]?]], body: ref[Expression], loc: Location)
define LetStarExpr (vars: ref[Array[ref[Identifier]?]]?, inits: ref[Array[ref[Expression]?]], body: ref[Expression], loc: Location)
define LetrecExpr (vars: ref[Array[ref[Identifier]?]]?, inits: ref[Array[ref[Expression]?]], body: ref[Expression], loc: Location)
define CondFailExpr (loc: Location)
; datums / results are parallel arrays; each case's datums begin at
; case_starts[i] and run to case_starts[i+1] in the flat datums array.
define CaseExpr (key: ref[Expression], datums: ref[Array[ref[ELObj]?]], case_starts: ref[Array[int]], results: ref[Array[ref[Expression]?]], else_expr: ref[Expression]?, loc: Location)
define QuasiquoteExpr (members: ref[Array[ref[Expression]?]], spliced: ref[Array[bool]], qq_type: int, loc: Location)
define AssignmentExpr (var_ident: ref[Identifier], value: ref[Expression], loc: Location)
define LambdaExpr (formals: ref[Array[ref[Identifier]?]], inits: ref[Array[ref[Expression]?]], sig: Signature, loc: Location, body: ref[Expression])
; MakeExpr — a transform `make FOC key: val … content…` (MakeExpression). `keys`
; parallels the first `keys.length` entries of `exprs` (the characteristic
; values); the remaining exprs are content. `foc_ident` is the FO-class
; IDENTIFIER, not a resolved kind: the reference resolves foc_->flowObj() in
; MakeExpression::compile, AFTER the whole part is parsed, so a
; declare-flow-object-class LATER in the part reaches back (cql.dsl loads
; fodeclare.scm last). Unknown class at compile = message + sequence fallback.
define MakeExpr (foc_ident: ref[Identifier], keys: ref[Array[ref[Identifier]?]], exprs: ref[Array[ref[Expression]?]]?, loc: Location)
define StyleExpr (keys: ref[Array[ref[Identifier]?]], exprs: ref[Array[ref[Expression]?]]?, loc: Location)

; WithModeExpr — `(with-mode NAME expr)` (WithModeExpression): eval `content`
; with the VM's EvalContext processingMode switched to `mode`. ProcessingMode
; uses Expression and Expression uses ProcessingMode; that mutual `use` is
; legal and is why this field names its type (see VM.processing_mode).
define WithModeExpr (mode: ref[ProcessingMode]?, content: ref[Expression], loc: Location)

; QuasiquoteExpression.Type
define QQ_LIST: int 0
define QQ_IMPROPER: int 1
define QQ_VECTOR: int 2

define Expression union
(
    Constant: ConstantExpr
    ResolvedConstant: ResolvedConstantExpr
    Variable: VariableExpr
    If: IfExpr
    Or: OrExpr
    And: AndExpr
    Call: CallExpr
    Sequence: SequenceExpr
    Let: LetExpr
    LetStar: LetStarExpr
    Letrec: LetrecExpr
    CondFail: CondFailExpr
    Case: CaseExpr
    Quasiquote: QuasiquoteExpr
    Assignment: AssignmentExpr
    Lambda: LambdaExpr
    Make: MakeExpr
    StyleE: StyleExpr
    WithMode: WithModeExpr
)
{
    ; --- constructors ------------------------------------------------------
    function alloc(host: ref[Page]) returns ref[Expression] linked


    function make_constant(host: ref[Page], obj: ref[ELObj]?, loc: Location) returns ref[Expression] linked






    function make_variable(host: ref[Page], ident: ref[Identifier], loc: Location) returns ref[Expression] linked






    function make_if(host: ref[Page], test: ref[Expression], consequent: ref[Expression], alternate: ref[Expression]?, loc: Location) returns ref[Expression] linked






    function make_or(host: ref[Page], test1: ref[Expression], test2: ref[Expression], loc: Location) returns ref[Expression] linked






    function make_and(host: ref[Page], test1: ref[Expression], test2: ref[Expression], loc: Location) returns ref[Expression] linked






    function make_call(host: ref[Page], op: ref[Expression], args: ref[Array[ref[Expression]?]], loc: Location) returns ref[Expression] linked






    function make_sequence(host: ref[Page], seq: ref[Array[ref[Expression]?]], loc: Location) returns ref[Expression] linked






    function make_let(host: ref[Page], vars: ref[Array[ref[Identifier]?]], inits: ref[Array[ref[Expression]?]], body: ref[Expression], loc: Location) returns ref[Expression] linked






    function make_let_star(host: ref[Page], vars: ref[Array[ref[Identifier]?]], inits: ref[Array[ref[Expression]?]], body: ref[Expression], loc: Location) returns ref[Expression] linked






    function make_letrec(host: ref[Page], vars: ref[Array[ref[Identifier]?]], inits: ref[Array[ref[Expression]?]], body: ref[Expression], loc: Location) returns ref[Expression] linked






    function make_cond_fail(host: ref[Page], loc: Location) returns ref[Expression] linked






    function make_case(host: ref[Page], key: ref[Expression], datums: ref[Array[ref[ELObj]?]], case_starts: ref[Array[int]], results: ref[Array[ref[Expression]?]], else_expr: ref[Expression]?, loc: Location) returns ref[Expression] linked






    function make_quasiquote(host: ref[Page], members: ref[Array[ref[Expression]?]], spliced: ref[Array[bool]], qq_type: int, loc: Location) returns ref[Expression] linked






    function make_assignment(host: ref[Page], var_ident: ref[Identifier], value: ref[Expression], loc: Location) returns ref[Expression] linked






    function make_lambda(host: ref[Page], formals: ref[Array[ref[Identifier]?]], inits: ref[Array[ref[Expression]?]], sig: Signature, body: ref[Expression], loc: Location) returns ref[Expression] linked






    function make_make(host: ref[Page], foc_ident: ref[Identifier], keys: ref[Array[ref[Identifier]?]], exprs: ref[Array[ref[Expression]?]], loc: Location) returns ref[Expression] linked






    function make_style_expr(host: ref[Page], keys: ref[Array[ref[Identifier]?]], exprs: ref[Array[ref[Expression]?]], loc: Location) returns ref[Expression] linked






    function make_with_mode(host: ref[Page], mode: ref[ProcessingMode]?, content: ref[Expression], loc: Location) returns ref[Expression] linked






    ; --- location ----------------------------------------------------------
    function location(this: ref[Expression]) @page true @direct true returns Location linked













































    ; --- constantValue (minimal; only resolved constants report a value) ---
    function constant_value(this: ref[Expression]) returns ref[ELObj]? linked









    ; the datum of either constant arm — the make-IC compile split uses it
    ; (a parsed literal like 12pt or a quoted symbol is a Constant carrying
    ; its ELObj; evaluation would be pure, so folding it here is safe).
    function constant_datum(this: ref[Expression]) returns ref[ELObj]? linked











    ; --- canEval (Expression.cxx, faithful) ---------------------------------
    ; Whether the expression can be EAGERLY evaluated at compile time
    ; (Identifier::computeValue's force-0 gate). Runs on a compiled tree:
    ; Variable is_top stamps come from compile_variable/fold_variable; a
    ; Constant stands in for the reference's post-optimize state via a silent
    ; resolve probe (resolved -> ResolvedConstantExpression, canEval 1).
    procedure can_eval(mutable this: ref[Expression], maybe_call: bool, mutable interp: ref[Interpreter]) returns bool io reads msg_prog linked























































































































































































    ; Let/Letrec/Lambda init lists: every (non-null) init must canEval(1).
    procedure can_eval_inits(mutable inits: ref[Array[ref[Expression]?]]?, mutable interp: ref[Interpreter]) returns bool io reads msg_prog linked


















    procedure can_eval_exprs(mutable exprs: ref[Array[ref[Expression]?]]?, maybe_call: bool, mutable interp: ref[Interpreter]) returns bool io reads msg_prog linked


















    ; VariableExpression::optimize — fold a TOP-LEVEL reference to a defined
    ; identifier whose value computes eagerly (canEval-gated inside
    ; compute_value) into a resolved constant, stamping is_top either way.
    ; The classification loops call this where the reference calls
    ; expr->optimize before constantValue().
    procedure fold_variable(mutable this: ref[Expression], mutable interp: ref[Interpreter], env: ref[Environment]) io reads msg_prog linked





























    ; keyword(): the keyword identifier of a constant keyword (make/style).
    function keyword(this: ref[Expression]) returns ref[Identifier]? linked









    ; optimize(): the constant-folding pass — a no-op here (see header).
    function optimize(this: ref[Expression], interp: ref[Interpreter], env: ref[Environment]) returns ref[Expression] linked


    ; optimizeCompile: optimize then compile (Expression.cs).
    procedure optimize_compile(mutable expr: ref[Expression]?, mutable interp: ref[Interpreter], mutable env: ref[Environment], stack_pos: int, next: ref[Insn]?) returns ref[Insn]? io reads msg_prog linked







    ; compilePushVars: push captured vars (frame/closure refs) for a closure's
    ; display, recursively.
    procedure compile_push_vars(mutable interp: ref[Interpreter], env: ref[Environment], stack_pos: int, vars: ref[BoundVarList]?, var_index: int, next: ref[Insn]?) returns ref[Insn]? linked














    ; --- markBoundVars -----------------------------------------------------
    procedure mark_bound_vars(this: ref[Expression], mutable vars: ref[BoundVarList]?, is_shared: bool) linked


































































































































    procedure mark_list(list: ref[Array[ref[Expression]?]], mutable vars: ref[BoundVarList]?, is_shared: bool) linked












    ; a fresh Array of the first n idents (Lambda.markBoundVars sub-lists).
    function ident_prefix(idents: ref[Array[ref[Identifier]?]], host: ref[Page], n: int) returns ref[Array[ref[Identifier]?]] linked











    ; --- compile -----------------------------------------------------------
    procedure compile(mutable this: ref[Expression], mutable interp: ref[Interpreter], mutable env: ref[Environment], stack_pos: int, next: ref[Insn]?) @page true @returnpage true returns ref[Insn]? io reads msg_prog linked




























































































    ; MakeExpression::compile, collapsed for extension flow objects (the whole
    ; transform surface): no inherited characteristics, no style stack, no
    ; content-map / label — those are the print path (Inc 9). Push each
    ; characteristic value then each content sosofo on the stack, then a
    ; MakeFlowObjInsn folds them into a SOSO_FLOWOBJ. exprs[0..nKey-1] are the
    ; characteristic values (parallel to keys); exprs[nKey..] the content.
    procedure compile_make(this: ref[Expression], foc_ident: ref[Identifier], keys: ref[Array[ref[Identifier]?]]?, mutable exprs: ref[Array[ref[Expression]?]], loc: Location, mutable interp: ref[Interpreter], mutable env: ref[Environment], stack_pos: int, next: ref[Insn]?) @page true @direct true returns ref[Insn]? io reads msg_prog linked












































































































































































































































































































































































































































































































































































































































































































    ; MacroFlowObj::Definition::compile — the body of a flow-object macro,
    ; compiled LAZILY on its first process (the whole part must be read first;
    ; the reference calls this from Definition::process when code_ is null).
    ;
    ; The frame is: one slot per declared characteristic, then the
    ; `#!contents` variable. UnpackMacroFlowObjInsn fills it from the flow
    ; object; a slot left NULL (the characteristic was not given in the make)
    ; is filled by its declared default — or by #f when it has none. Only the
    ; frame is in scope: a macro is a top-level declaration, so there are no
    ; closure variables.
    procedure compile_macro(mutable def: ref[MacroDef], mutable interp: ref[Interpreter]) returns ref[Insn] io reads msg_prog linked















    procedure compile_macro_on_arena(mutable def: ref[MacroDef], mutable interp: ref[Interpreter]) returns ref[Insn]? io reads msg_prog linked















































































    ; the compiled body, compiling it on first demand.
    procedure macro_code(mutable def: ref[MacroDef], mutable interp: ref[Interpreter]) returns ref[Insn]? io reads msg_prog linked








    ; a key of the form force!<name> where <name> names an inherited
    ; characteristic (StyleExpression::compile's forceKeys scan).
    procedure force_key_target(ident: ref[Identifier], mutable interp: ref[Interpreter]) @page true @direct true returns ref[Identifier]? linked













    ; StyleExpression::compile — the pure style form `(style key: val …)`:
    ; the same keyword split as the styled make, minus NICs and content.
    procedure compile_style(this: ref[Expression], keys: ref[Array[ref[Identifier]?]]?, mutable exprs: ref[Array[ref[Expression]?]], loc: Location, mutable interp: ref[Interpreter], mutable env: ref[Environment], stack_pos: int, next: ref[Insn]?) @page true @direct true returns ref[Insn]? io reads msg_prog linked







































































































































































    ; StyleExpression::unknownStyleKeyword — "<name>:" is not a style keyword.
    procedure unknown_style_keyword(this: ref[Expression], ident: ref[Identifier]?, mutable interp: ref[Interpreter], loc: Location) io reads msg_prog linked






    ; the header/footer part slot for a simple-page-sequence NIC key
    ; (FOTBuilder HF bits >> 2): left-footer 0, left-header 1, center-footer 2,
    ; center-header 3, right-footer 4, right-header 5; -1 = not an HF key.
    function hf_part_index(sk: int) returns int linked
















    ; MakeExpression::unknownStyleKeyword — "<name>:" is not valid for this
    ; flow object class.
    procedure unknown_make_keyword(this: ref[Expression], ident: ref[Identifier]?, foc_ident: ref[Identifier], mutable interp: ref[Interpreter], loc: Location) io reads msg_prog linked






    ; "<name>:" — the keyword-shaped message argument.
    function keyword_arg(host: ref[Page], ident: ref[Identifier]) @page true @direct true returns StringC linked



















    ; VariableExpression::compile.
    procedure compile_variable(mutable this: ref[Expression], mutable ident: ref[Identifier], loc: Location, mutable interp: ref[Interpreter], env: ref[Environment], stack_pos: int, next: ref[Insn]?) returns ref[Insn] io reads msg_prog linked



















































    ; CallExpression::compile.
    procedure compile_call(mutable this: ref[Expression], mutable interp: ref[Interpreter], mutable env: ref[Environment], stack_pos: int, next: ref[Insn]?) returns ref[Insn]? io reads msg_prog linked
































































    ; CallExpression::compile constant-op arity check: returns the effective
    ; arg count (truncated on tooManyArgs/oddKeyArgs like args_.resize), or
    ; -1 when the call must compile to an ErrorInsn (non-function/missingArg).
    procedure check_call_arity(mutable interp: ref[Interpreter], mutable value: ref[ELObj], n: int, loc: Location) returns int io reads msg_prog linked







































    ; LetExpression::compile.
    procedure compile_let(this: ref[Expression], mutable var_names: ref[Array[ref[Identifier]?]], mutable inits: ref[Array[ref[Expression]?]], mutable body: ref[Expression], mutable interp: ref[Interpreter], mutable env: ref[Environment], stack_pos: int, next: ref[Insn]?) returns ref[Insn]? io reads msg_prog linked











    procedure compile_let_inits(mutable interp: ref[Interpreter], mutable env: ref[Environment], mutable inits: ref[Array[ref[Expression]?]], init_vars: ref[BoundVarList], init_index: int, stack_pos: int, next: ref[Insn]?) returns ref[Insn]? io reads msg_prog linked











    ; LetStarExpression::compile.
    procedure compile_let_star(this: ref[Expression], var_names: ref[Array[ref[Identifier]?]], mutable inits: ref[Array[ref[Expression]?]], mutable body: ref[Expression], mutable interp: ref[Interpreter], mutable env: ref[Environment], stack_pos: int, next: ref[Insn]?) returns ref[Insn]? io reads msg_prog linked






















    procedure compile_let_star_inits(mutable interp: ref[Interpreter], mutable env: ref[Environment], mutable inits: ref[Array[ref[Expression]?]], init_vars: ref[BoundVarList], init_index: int, stack_pos: int, next: ref[Insn]?) returns ref[Insn]? io reads msg_prog linked
















    ; LetrecExpression::compile.
    procedure compile_letrec(this: ref[Expression], mutable var_names: ref[Array[ref[Identifier]?]], mutable inits: ref[Array[ref[Expression]?]], mutable body: ref[Expression], mutable interp: ref[Interpreter], mutable env: ref[Environment], stack_pos: int, next: ref[Insn]?) returns ref[Insn]? io reads msg_prog linked





































    procedure compile_letrec_inits(mutable interp: ref[Interpreter], mutable env: ref[Environment], mutable inits: ref[Array[ref[Expression]?]], init_index: int, stack_pos: int, next: ref[Insn]?) returns ref[Insn]? io reads msg_prog linked








    ; CaseExpression::compile — datums are resolved inline (the optimize pass'
    ; job in the reference; done here so no optimize is needed).
    procedure compile_case(mutable this: ref[Expression], mutable interp: ref[Interpreter], mutable env: ref[Environment], stack_pos: int, next: ref[Insn]?) returns ref[Insn]? io reads msg_prog linked























































    ; QuasiquoteExpression::compile.
    procedure compile_quasiquote(mutable this: ref[Expression], mutable interp: ref[Interpreter], mutable env: ref[Environment], stack_pos: int, next: ref[Insn]?) returns ref[Insn]? io reads msg_prog linked




























































    ; AssignmentExpression::compile.
    procedure compile_assignment(this: ref[Expression], var_ident: ref[Identifier], mutable value: ref[Expression], loc: Location, mutable interp: ref[Interpreter], mutable env: ref[Environment], stack_pos: int, next: ref[Insn]?) returns ref[Insn]? io reads msg_prog linked






























    ; LambdaExpression::compile — the closure builder with the optional/rest/key
    ; varargs entry-point machinery (Expression.cs).
    procedure compile_lambda(mutable this: ref[Expression], mutable interp: ref[Interpreter], env: ref[Environment], stack_pos: int, next: ref[Insn]?) returns ref[Insn]? io reads msg_prog linked






















































    ; the optional/rest/key entry-point construction (LambdaExpression.compile).
    procedure compile_lambda_varargs(mutable interp: ref[Interpreter], sig: Signature, formals: ref[Array[ref[Identifier]?]], mutable inits: ref[Array[ref[Expression]?]], mutable formal_vars: ref[BoundVarList], mutable bound_vars: ref[BoundVarList], code: ref[Insn]?, host: ref[Page], lambda_loc: Location) returns ref[Insn] io reads msg_prog linked
























































































































}

; the host page reachable from a BoundVarList (used by markBoundVars' Lambda
; sub-list construction).
function interp_host_of(vars: ref[BoundVarList]?) returns ref[Page] linked

