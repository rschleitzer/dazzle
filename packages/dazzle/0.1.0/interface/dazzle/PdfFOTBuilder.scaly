; PdfFOTBuilder — the `-t pdf` backend. It is not in the reference: jade has
; no PDF backend, and the C# port's one hands the flow object tree to a
; document library that sets the pages. Here the builder sets them itself and
; writes the file with the `pdf` package.
;
; It is rudimentary, and means to be: simple page sequences with headers and
; footers, paragraphs, display groups, line fields, leaders, rules, external
; graphics and tables — enough to set a book with the DocBook print
; stylesheets, and not more.
;
; Fonts: a font-family-name is looked for among the TrueType files of the
; system's font directories (those of DAZZLE_FONTS, if that is set), by the
; family name and style each file states; the font found is embedded with
; the glyphs the document uses, so the text may be any Unicode the font has.
; For a family the system does not have, the sans serif, serif or typewriter
; face it usually has instead is taken, by what the name says. A character
; the font lacks is taken from another font that has it (other_font). Where none of
; those is found either, the text is set in a standard font -- Helvetica,
; Times or Courier, which every reader has and none embeds -- and there a
; character outside Windows code page 1252 prints as `?`.
;
; Shape: the builder does NOT stream. The flow object calls build a TREE of
; nodes, each with a snapshot of the inherited characteristics it was made
; under; finish() lays the tree out TWICE — the first pass finds the page every
; element begins on, the second writes the file with the page numbers of
; `current-node-page-number` filled in.
;
; Layout: blocks flow down the page; a paragraph is broken greedily into
; lines. Everything placed goes into a flat list of drawing operations of the
; page being set (`ops`), absolute in thousandths of a point, y downwards. A
; page is written when it is full. Because the operations are plain numbers,
; a run of them can still be moved: a table row that does not fit, and a
; heading that must stay with what follows it, are cut out and put down again
; on the next page. Inside a table cell no page is ever broken (`nobreak`).
;
; Display space collapses as DSSSL has it: between two blocks the larger of
; the space after the one and the space before the other, and none at the top
; of a page.
;
; The flow-object bracket (start/end/atomic over the characteristics set for
; the NEXT flow object) is the FOTBuilder base's, as in the other backends.
;
; RBMM: nodes, snapshots and buffers live on the builder's page (the run
; arena).

use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String.String
use scaly.containers.StringBuilder.StringBuilder
use scaly.os.File.File
use opensp.StringC.StringC
use pdf.Font.PdfFont
use pdf.Font.PDF_TIMES
use pdf.Font.PDF_COURIER
use pdf.Font.PDF_FONT_COUNT
use pdf.FontFiles.PdfFontFiles
use pdf.Document.PdfDocument
use dazzle.Grove.GroveNode
use dazzle.ELObj.ELObj
use dazzle.Style.InheritedC
use dazzle.Style.LengthSpec
use dazzle.Style.FotSym
use dazzle.Style.DisplaySpace
use dazzle.Style.DisplayNIC
use dazzle.Style.RuleNIC
use dazzle.Style.LinkNIC
use dazzle.Style.ExternalGraphicNIC
use dazzle.Style.LeaderNIC
use dazzle.Style.BoxNIC
use dazzle.Style.ScoreNIC
use dazzle.Style.LineFieldNIC
use dazzle.Style.TableNIC
use dazzle.Style.TableColumnNIC
use dazzle.Style.TableCellNIC
use dazzle.Style.PageFloatNIC
use dazzle.Style.CharacterNIC
use dazzle.Style.AnchorNIC
use dazzle.Style.GlyphAnnotationNIC
use dazzle.Style.EmphasizingMarkNIC
use dazzle.Style.GridNIC
use dazzle.Style.GridCellNIC
use dazzle.Style.EmbeddedTextNIC
use dazzle.Style.IncludedContainerAreaNIC
use dazzle.Style.MultiModeRec
use dazzle.Style.MultiModeNIC

; --- node kinds --------------------------------------------------------------
; a block container: display-group, scroll, a display box
define PN_GROUP: int 0
define PN_PARAGRAPH: int 1
; an inline container: sequence, link, score, an inline box
define PN_SEQUENCE: int 2
define PN_TEXT: int 3
define PN_PAGE_NUMBER: int 4
; i0 = the element the page number is asked of
define PN_NODE_PAGE_NUMBER: int 5
define PN_LEADER: int 6
; i0 = orientation is horizontal, i1 = has length, i2 = length
define PN_RULE: int 7
; text = the file; i0 = display, i1/i2 = max width (-1 none), i3/i4 = max height
define PN_GRAPHIC: int 8
; i0..i3 = thickness of the border before row, after row, before column,
; after column (-1 none), i4..i7 their colors
define PN_TABLE: int 9
; i0 = column, i1 = columns spanned, i2 = has width, i3 = width, i4 = table
; units in thousandths
define PN_COLUMN: int 10
; i0 = 0 body, 1 header, 2 footer
define PN_ROW: int 11
; i0 = column, i1 = columns spanned, i2 = rows spanned, i3 = missing,
; i4..i7 = border thickness as on the table, i8..i11 their colors
define PN_CELL: int 12
; i0 = the element that begins here
define PN_MARK: int 13
; i0 = the field width
define PN_FIELD: int 14
define PN_BREAK: int 15
define PN_PAGE_SEQUENCE: int 16
; i0 = the header/footer flags
define PN_HEADER_FOOTER: int 17

; --- the symbols read here (the FotSym codes of Interpreter's table) ---------
define PSYM_SEMI_BOLD: int 16
define PSYM_ULTRA_BOLD: int 19
define PSYM_OBLIQUE: int 21
define PSYM_ITALIC: int 23
define PSYM_START: int 25
define PSYM_END: int 26
define PSYM_CENTER: int 27
define PSYM_JUSTIFY: int 28
define PSYM_ASIS: int 34
define PSYM_ASIS_TRUNCATE: int 36
define PSYM_HORIZONTAL: int 47
define PSYM_PAGE: int 61
define PSYM_PRESERVE: int 77

; --- the header/footer flags (FOTBuilder::HF) --------------------------------
define PHF_FIRST: int 1
define PHF_FRONT: int 2
define PHF_HEADER: int 4
define PHF_CENTER: int 8
define PHF_RIGHT: int 16

; --- drawing operations: kind, x, y and five operands ------------------------
define POP_SIZE: int 8
; font, size, color, text at, text length
define POP_TEXT: int 0
; x2, y2, thickness, color
define POP_LINE: int 1
; width, height, color
define POP_RECTANGLE: int 2
; width, height, image
define POP_IMAGE: int 3
; element
define POP_MARK: int 4

; --- the atoms of a line: kind, characteristics, two operands, width, and
; for text the font it is set in ------------------------------------------
define PAT_SIZE: int 6
; text at, text length
define PAT_TEXT: int 0
define PAT_SPACE: int 1
define PAT_NEWLINE: int 2
; text at, text length of the pattern; width of one pattern
define PAT_LEADER: int 3
; element
define PAT_MARK: int 4
; image, height
define PAT_IMAGE: int 5
; width = the field width
define PAT_FIELD_START: int 6
define PAT_FIELD_END: int 7

; A growing list of numbers that can be cut back — the drawing operations,
; the atoms, and the scratch space of the layout.
define PdfInts (var items: ref[Array[int]], var count: int)
{
    function make(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[PdfInts] linked

    procedure push(mutable this: ref[PdfInts], v: int) @deep true linked

    function at(this: ref[PdfInts], i: int) @ret_param_0 true @deep true returns int linked

    procedure put(mutable this: ref[PdfInts], i: int, v: int) @persists true @ret_nonlocal true @deep true linked

    procedure cut(mutable this: ref[PdfInts], n: int) @deep true linked
}

; --- the inherited characteristics a flow object is made under ---------------
define PdfChars
(
    ; its place in the builder's list of snapshots
    var id: int
    var font_size: int
    ; the family's place in the builder's list of families
    var family: int
    var bold: bool
    var italic: bool
    var color: int
    var has_background: bool
    var background: int
    var start_indent: int
    var end_indent: int
    var first_line_indent: int
    var line_spacing: int
    ; a PSYM_ code
    var quadding: int
    var display_alignment: int
    var asis: bool
    var preserve: bool
    var shift: int
    var field_width: int
    var page_width: int
    var page_height: int
    var left_margin: int
    var right_margin: int
    var top_margin: int
    var bottom_margin: int
    var header_margin: int
    var footer_margin: int
    var border_present: bool
    var line_thickness: int
    var cell_before_row_margin: int
    var cell_after_row_margin: int
    var cell_before_column_margin: int
    var cell_after_column_margin: int
    var cell_background: bool
    var cell_row_alignment: int
    ; the character of page-number-format: 1 i I a A
    var number_format: int
    var number_restart: bool
)
{
    init() linked

    ; Everything but the id.
    procedure copy(mutable dst: ref[PdfChars], src: ref[PdfChars]) @deep true linked

    function same(a: ref[PdfChars], b: ref[PdfChars]) @ret_nonlocal true @deep true returns bool linked
}

; --- one node of the buffered tree -------------------------------------------
define PdfNode
(
    kind: int
    var next: ref[PdfNode]?
    var first: ref[PdfNode]?
    var last: ref[PdfNode]?
    var parent: ref[PdfNode]?
    var chars: ref[PdfChars]
    ; the node's text in the builder's pool
    var text_at: int
    var text_length: int
    ; the display characteristics of a block
    var space_before: int
    var space_after: int
    var keep_with_next: bool
    var break_before: bool
    var break_after: bool
    ; what the kind says
    var i0: int
    var i1: int
    var i2: int
    var i3: int
    var i4: int
    var i5: int
    var i6: int
    var i7: int
    var i8: int
    var i9: int
    var i10: int
    var i11: int
)
{
    function make(host: ref[Page], kind: int, chars: ref[PdfChars]) @ret_explicit_0 true @deep true returns ref[PdfNode] linked
}

define PdfFOTBuilder
(
    var host: ref[Page]
    var out_name: String
    ; --- the tree ------------------------------------------------------------
    var root: ref[PdfNode]
    ; the container the next node goes into
    var cur: ref[PdfNode]
    ; the text of all nodes, as codes of the fonts' encoding; the layout
    ; appends what it makes up (page numbers, leaders)
    var pool: ref[Array[u8]]
    ; --- the flow-object bracket ---------------------------------------------
    ; the characteristics of the NEXT flow object, the snapshots of the open
    ; ones, and the snapshot of `next` while it is unchanged
    var next: PdfChars
    var stack: ref[Array[ref[PdfChars]?]]
    var depth: int
    var snap: ref[PdfChars]?
    var snaps: ref[Array[ref[PdfChars]?]]
    ; the font families named: where the name is in `family_names`, its
    ; length, and the font of the document for each of the four styles
    ; (-1: not asked for yet)
    var families: ref[PdfInts]
    var family_names: ref[Array[u8]]
    ; the font files of the system, read when the first family is asked for
    var font_files: ref[PdfFontFiles]
    var fonts_scanned: bool
    ; the families a character is looked for in that its own font lacks
    var others: ref[PdfInts]
    ; the font files read: where the path is in `family_names`, its length,
    ; and the font of the document it became (-1: no font)
    var loaded: ref[PdfInts]
    var others_known: bool
    ; 0 body, 1 header, 2 footer: where the rows of the open table part go
    var section: int
    ; --- the layout ------------------------------------------------------------
    var doc: ref[PdfDocument]
    var ops: ref[PdfInts]
    var atoms: ref[PdfInts]
    var scratch: ref[PdfInts]
    ; elements met where no line is: they go with the next line set
    var marks: ref[PdfInts]
    ; per element the page it begins on (from 1; 0 unknown), and per page its
    ; number as shown and the format of that number
    var element_page: ref[Array[int]]
    var page_shown: ref[Array[int]]
    var page_format: ref[Array[int]]
    ; the files already read: text at, image (-1: not an image), and its
    ; width and height in pixels
    var images: ref[PdfInts]
    ; the first pass only measures: it reads the size of an image and does
    ; not take it into its document, which is thrown away
    var measuring: bool
    ; where the next block goes, and the space to leave before it
    var y: int
    var pending: int
    var at_top: bool
    var page_open: bool
    var page_no: int
    ; the first page of a page sequence gets a page label
    var page_labelled: bool
    ; the area blocks are set into
    var frame_x: int
    var frame_width: int
    var body_top: int
    var body_bottom: int
    ; inside a table cell no page is broken
    var nobreak: int
    ; where what must stay with the next block begins (-1: nothing)
    var keep_at: int
    var keep_y: int
    ; the paragraph being collected
    var para_base: int
    var para_chars: ref[PdfChars]?
    var para_first: bool
    var para_keep: bool
    ; collecting a header or footer: blocks are read as their text
    var flat: bool
    ; the page sequence being set
    var seq: ref[PdfNode]?
    var seq_chars: ref[PdfChars]
    var seq_first: bool
    var seq_base: int
    ; the ops of the page in front of which nothing is moved (the header)
    var page_fixed: int
    ; the height of the table row set last
    var row_height: int
)
{
    function make(host: ref[Page], out_name: String) @ret_args_3 true @deep true returns ref[PdfFOTBuilder] linked

    ; --- the flow-object bracket (FOTBuilder start/end/atomic) ---------------

    ; The snapshot of `next`: the one in hand while nothing was set, the open
    ; flow object's when `next` came back to it, else a new one.
    procedure snapshot(mutable this: ref[PdfFOTBuilder]) @ret_param_0 true @deep true returns ref[PdfChars] linked

    procedure fo_start(mutable this: ref[PdfFOTBuilder]) @deep true linked

    procedure fo_end(mutable this: ref[PdfFOTBuilder]) @deep true linked

    ; atomic(): the next flow object is made under the open one's again
    procedure fo_atomic(mutable this: ref[PdfFOTBuilder]) @deep true linked

    ; --- characteristics -------------------------------------------------------
    procedure set_ic(mutable this: ref[PdfFOTBuilder], ic: ref[InheritedC]) @deep true @deep_this_2 true linked

    ; --- fonts -----------------------------------------------------------------

    ; The place of a font-family-name in the list of families.
    procedure family_of(mutable this: ref[PdfFOTBuilder], name: StringC) @ret_nonlocal true @deep true returns int linked

    procedure family(mutable this: ref[PdfFOTBuilder], name: Slice[u8]) @persists true @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true returns int linked

    ; The font of the document that characteristics ask for: the family's
    ; file in the style, embedded, if the system has one; else the standard
    ; font nearest to the family's name.
    procedure font_of(mutable this: ref[PdfFOTBuilder], c: ref[PdfChars]) @ret_param_0 true @deep true returns int io linked

    ; The font of the document a file is: read and given to the document
    ; the first time, the same font every time after.
    procedure load_font(mutable this: ref[PdfFOTBuilder], path: String) @ret_param_0 true @deep true returns int io linked

    ; The file of a family in a style: the family's own, else that of a
    ; family commonly installed in its place -- for a name that means a sans
    ; serif, a serif or a typewriter face the usual one of each system.
    function font_file(this: ref[PdfFOTBuilder], name: Slice[u8], bold: bool, italic: bool) @page true @direct true @ret_caller true @deep true returns String linked

    ; Read which font files there are: in the directories DAZZLE_FONTS names
    ; (separated by colons; set but empty, none at all), else in the places
    ; the systems keep their fonts.
    procedure scan_fonts(mutable this: ref[PdfFOTBuilder]) @deep true io linked

    ; --- the tree --------------------------------------------------------------
    procedure append(mutable this: ref[PdfFOTBuilder], mutable n: ref[PdfNode]) @deep true @deep_this_2 true @deep_whole_2 true linked

    ; A node under the current container, made under the characteristics
    ; set for the next flow object.
    procedure add(mutable this: ref[PdfFOTBuilder], kind: int) @ret_param_0 true @deep true returns ref[PdfNode] linked

    ; The node becomes the container; the flow object is open.
    procedure open(mutable this: ref[PdfFOTBuilder], n: ref[PdfNode]) @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true linked

    procedure close(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure display(this: ref[PdfFOTBuilder], mutable n: ref[PdfNode], nic: ref[DisplayNIC]?) @deep true @deep_into_1_4 true linked

    ; --- characters ------------------------------------------------------------
    ; A run of text. Outside verbatim text every run of white space is one
    ; space; in it a record end is a line break and spaces are kept.
    procedure characters(mutable this: ref[PdfFOTBuilder], s: Slice[u32]) @deep true linked

    ; One space, unless the run so far ends in one.
    procedure add_space(mutable this: ref[PdfFOTBuilder], run_at: size_t) @deep true linked

    procedure characters_from_node(mutable this: ref[PdfFOTBuilder], node: ref[GroveNode]?, s: Slice[u32]) @ret_nonlocal true @deep true linked

    procedure character(mutable this: ref[PdfFOTBuilder], nic: ref[CharacterNIC]) @ret_nonlocal true @deep true linked

    ; --- node bracket ----------------------------------------------------------
    ; An element processed in the default mode begins here: that is the place
    ; current-node-page-number asks for.
    procedure start_node(mutable this: ref[PdfFOTBuilder], node: ref[GroveNode]?, mode_name: StringC) @deep true linked

    procedure end_node(mutable this: ref[PdfFOTBuilder]) @deep true linked

    procedure current_node_page_number(mutable this: ref[PdfFOTBuilder], node: ref[GroveNode]?) @ret_nonlocal true @deep true linked

    procedure page_number(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    ; --- blocks ----------------------------------------------------------------
    procedure start_paragraph(mutable this: ref[PdfFOTBuilder], nic: ref[DisplayNIC]?) @ret_nonlocal true @deep true linked

    procedure end_paragraph(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure paragraph_break(mutable this: ref[PdfFOTBuilder], nic: ref[DisplayNIC]?) @ret_nonlocal true @deep true linked

    procedure start_display_group(mutable this: ref[PdfFOTBuilder], nic: ref[DisplayNIC]?) @ret_nonlocal true @deep true linked

    procedure end_display_group(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure start_scroll(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure end_scroll(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure start_box(mutable this: ref[PdfFOTBuilder], nic: ref[BoxNIC]?, dnic: ref[DisplayNIC]?) @ret_nonlocal true @deep true linked

    procedure end_box(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure rule(mutable this: ref[PdfFOTBuilder], nic: ref[RuleNIC]?, dnic: ref[DisplayNIC]?) @ret_nonlocal true @deep true @deep_this_2 true linked

    procedure external_graphic(mutable this: ref[PdfFOTBuilder], nic: ref[ExternalGraphicNIC]?, dnic: ref[DisplayNIC]?) @ret_nonlocal true @deep true @deep_this_2 true linked

    ; --- inline containers -----------------------------------------------------
    procedure start_sequence(mutable this: ref[PdfFOTBuilder]) @deep true linked

    procedure end_sequence(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure start_line_field(mutable this: ref[PdfFOTBuilder], nic: ref[LineFieldNIC]?) @ret_nonlocal true @deep true linked

    procedure end_line_field(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure start_leader(mutable this: ref[PdfFOTBuilder], nic: ref[LeaderNIC]?) @ret_nonlocal true @deep true linked

    procedure end_leader(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    ; --- simple page sequence --------------------------------------------------
    procedure start_simple_page_sequence(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure start_simple_page_sequence_header_footer(mutable this: ref[PdfFOTBuilder], flags: int) @ret_nonlocal true @deep true linked

    procedure end_simple_page_sequence_header_footer(mutable this: ref[PdfFOTBuilder], flags: int) @ret_nonlocal true @deep true linked

    procedure end_all_simple_page_sequence_header_footer(mutable this: ref[PdfFOTBuilder]) @deep true linked

    procedure end_simple_page_sequence(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    ; --- tables ----------------------------------------------------------------
    procedure start_table(mutable this: ref[PdfFOTBuilder], tnic: ref[TableNIC]?, dnic: ref[DisplayNIC]?) @ret_nonlocal true @deep true linked

    procedure end_table(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure start_table_part_serial(mutable this: ref[PdfFOTBuilder], dnic: ref[DisplayNIC]?) @ret_nonlocal true @deep true linked

    procedure end_table_part_serial(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure start_table_part_header(mutable this: ref[PdfFOTBuilder]) @deep true linked

    procedure end_table_part_header(mutable this: ref[PdfFOTBuilder]) @deep true linked

    procedure start_table_part_footer(mutable this: ref[PdfFOTBuilder]) @deep true linked

    procedure end_table_part_footer(mutable this: ref[PdfFOTBuilder]) @deep true linked

    procedure table_column(mutable this: ref[PdfFOTBuilder], nic: ref[TableColumnNIC]?) @ret_nonlocal true @deep true @deep_this_2 true linked

    procedure start_table_row(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure end_table_row(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure start_table_cell(mutable this: ref[PdfFOTBuilder], nic: ref[TableCellNIC]) @ret_nonlocal true @deep true linked

    procedure end_table_cell(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    ; A border: the characteristics set for it say whether it is there, how
    ; thick and of what color. Answers the thickness, -1 for none.
    function border_thickness(this: ref[PdfFOTBuilder]) @ret_param_0 true @deep true returns int linked

    procedure table_before_row_border(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure table_after_row_border(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure table_before_column_border(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure table_after_column_border(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure table_cell_before_row_border(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure table_cell_after_row_border(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure table_cell_before_column_border(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure table_cell_after_column_border(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true linked

    ; =========================================================================
    ; The layout
    ; =========================================================================

    ; Lay the tree out twice and write the file. False when the file cannot
    ; be written.
    procedure finish(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true returns bool io linked

    procedure layout(mutable this: ref[PdfFOTBuilder]) @ret_nonlocal true @deep true io linked

    ; The body area of the page sequence being set.
    procedure set_frame(mutable this: ref[PdfFOTBuilder]) @deep true linked

    ; --- pages -----------------------------------------------------------------
    procedure open_page(mutable this: ref[PdfFOTBuilder]) @deep true io linked

    ; Write the page being set.
    procedure emit_page(mutable this: ref[PdfFOTBuilder]) @deep true linked

    ; An element begins on the page being written.
    procedure note_element(mutable this: ref[PdfFOTBuilder], element: int) @persists true @ret_nonlocal true @deep true linked

    ; The page is full: write it and go on on a new one. What must stay with
    ; the block being set goes along, unless that is half a page.
    procedure new_page(mutable this: ref[PdfFOTBuilder]) @deep true io linked

    ; Operations saved in the scratch space from `base` on come back, moved
    ; down by dy.
    procedure put_back(mutable this: ref[PdfFOTBuilder], base: int, dy: int) @ret_nonlocal true @deep true linked

    ; Move the operations from `from` on down by dy, where they are.
    procedure shift_ops(mutable this: ref[PdfFOTBuilder], from: int, dy: int) @deep true linked

    procedure op(mutable this: ref[PdfFOTBuilder], kind: int, x: int, y: int, a: int, b: int, c: int, d: int, e: int) @ret_nonlocal true @deep true linked

    ; Make room for something `height` high: a page is opened if none is,
    ; and broken if it does not fit. Then the pending space is put in, and
    ; the elements waiting for a line are marked here.
    procedure make_room(mutable this: ref[PdfFOTBuilder], height: int, keep: bool) @deep true io linked

    ; A block begins: its break, and its space before against the space
    ; after the block before it.
    procedure block_start(mutable this: ref[PdfFOTBuilder], n: ref[PdfNode]) @deep true linked

    procedure block_end(mutable this: ref[PdfFOTBuilder], n: ref[PdfNode]) @ret_nonlocal true @deep true linked

    ; --- the flow --------------------------------------------------------------

    ; Set the children of a container: what is inline is collected into
    ; lines under the paragraph's characteristics (those of the first text
    ; where there is no paragraph), a block ends the lines before it.
    procedure flow_children(mutable this: ref[PdfFOTBuilder], parent: ref[PdfNode], p: ref[PdfChars]?, keep: bool) @deep true @deep_this_4 true @deep_whole_4 true io linked

    procedure flow_inside(mutable this: ref[PdfFOTBuilder], parent: ref[PdfNode]) @deep true @deep_this_2 true io linked

    procedure atom(mutable this: ref[PdfFOTBuilder], kind: int, chars: ref[PdfChars], a: int, b: int, width: int, font: int) @ret_nonlocal true @deep true linked

    procedure flow_node(mutable this: ref[PdfFOTBuilder], n: ref[PdfNode]) @deep true @deep_this_2 true io linked

    procedure flow_block(mutable this: ref[PdfFOTBuilder], n: ref[PdfNode]) @deep true @deep_this_2 true io linked

    procedure flow_sequence(mutable this: ref[PdfFOTBuilder], n: ref[PdfNode]) @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true io linked

    ; A horizontal rule across the area, or of its length.
    procedure flow_rule(mutable this: ref[PdfFOTBuilder], n: ref[PdfNode]) @deep true io linked

    procedure flow_graphic(mutable this: ref[PdfFOTBuilder], n: ref[PdfNode]) @deep true io linked

    ; --- images ----------------------------------------------------------------

    ; The image of a graphic's file in the document being written, -1 when
    ; the file cannot be read or is neither JPEG nor PNG. Answers the place
    ; of its entry in `images`, where its size is.
    procedure image_of(mutable this: ref[PdfFOTBuilder], n: ref[PdfNode]) @ret_param_0 true @deep true returns int io linked

    ; The size an image is set at: its own at 96 pixels to the inch, made
    ; smaller to fit the widths and heights that limit it.
    procedure image_size(this: ref[PdfFOTBuilder], n: ref[PdfNode], entry: int, available: int, mutable width: ref[int], mutable height: ref[int]) @deep true linked

    procedure image_atom(mutable this: ref[PdfFOTBuilder], n: ref[PdfNode]) @deep true io linked

    ; --- atoms -----------------------------------------------------------------

    ; The atoms of a run of text: words and the spaces between them, in
    ; verbatim text lines and the breaks between them.
    procedure text_atoms(mutable this: ref[PdfFOTBuilder], c: ref[PdfChars], at: int, length: int) @deep true io linked

    ; The atoms of one word: one, in the font of its characteristics --
    ; unless that font lacks a character of it; then the word is as many
    ; atoms as it has runs of characters from one font, with no break
    ; between them.
    procedure word_atoms(mutable this: ref[PdfFOTBuilder], c: ref[PdfChars], font: int, from: int, to: int) @ret_nonlocal true @deep true io linked

    ; A font that has a character the font asked for lacks: the first of
    ; the fonts kept for this -- the usual faces of the systems, then the
    ; ones made to have everything -- that has it; the font asked for where
    ; none does.
    procedure other_font(mutable this: ref[PdfFOTBuilder], font: int, ch: u32) @ret_param_0 true @deep true returns int io linked

    procedure add_other(mutable this: ref[PdfFOTBuilder], name: Slice[u8]) @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true linked

    ; A leader: its pattern is the text in it, a dot where there is none.
    procedure leader_atom(mutable this: ref[PdfFOTBuilder], n: ref[PdfNode]) @ret_nonlocal true @deep true io linked

    ; A page number in a format (the character of page-number-format),
    ; appended to the pool.
    procedure number_text(mutable this: ref[PdfFOTBuilder], number: int, format: int) @deep true linked

    procedure roman_digit(mutable this: ref[PdfFOTBuilder], digit: int, one: u8, five: u8, ten: u8, lower: u8) @deep true linked

    ; --- lines -----------------------------------------------------------------

    function atom_chars(this: ref[PdfFOTBuilder], i: int) @ret_param_0 true @deep true returns ref[PdfChars] linked

    ; The width of the atoms from..to set side by side; a leader counts as
    ; one pattern, a line field as at least its width.
    function line_width(this: ref[PdfFOTBuilder], from: int, to: int) @ret_nonlocal true @deep true returns int linked

    ; The atoms collected since the paragraph began become lines.
    procedure flush_lines(mutable this: ref[PdfFOTBuilder]) @deep true io linked

    ; Set one line of a paragraph at the place of the next block.
    procedure set_line(mutable this: ref[PdfFOTBuilder], p: ref[PdfChars], from: int, to: int, indent: int, available: int, last: bool) @deep true io linked

    ; Put the atoms from..to side by side with their baseline at `baseline`.
    ; Every space gets `extra` more, every leader `fill` more than one
    ; pattern.
    procedure set_atoms(mutable this: ref[PdfFOTBuilder], from: int, to: int, start: int, baseline: int, top: int, extra: int, fill: int) @deep true linked

    ; --- headers and footers ---------------------------------------------------

    ; The headers and footers of the page just opened: of the six parts each
    ; is one line, at the left, in the middle and at the right.
    procedure set_headers(mutable this: ref[PdfFOTBuilder]) @deep true io linked

    procedure set_header_part(mutable this: ref[PdfFOTBuilder], part: ref[PdfNode], c: ref[PdfChars]) @ret_nonlocal true @deep true @deep_this_2 true io linked

    ; --- tables ----------------------------------------------------------------

    ; A table: the widths of its columns, then its rows one below the other,
    ; the header rows first and again at the top of every further page.
    procedure flow_table(mutable this: ref[PdfFOTBuilder], table: ref[PdfNode]) @deep true @deep_this_2 true io linked

    ; One row at the place of the next block: its cells side by side, each
    ; set into its columns; the row is as high as its highest cell. A row
    ; that does not fit on the page moves to the next one as a whole.
    procedure flow_row(mutable this: ref[PdfFOTBuilder], table: ref[PdfNode], row: ref[PdfNode], x: int, widths: int, columns: int, body: bool) @deep true @deep_this_4 true io linked

