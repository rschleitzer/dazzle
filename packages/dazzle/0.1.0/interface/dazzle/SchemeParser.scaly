use scaly.os.File

; SchemeParser — the DSSSL expression-language reader
; (style/SchemeParser.cxx; the C# mirror's lexer DIVERGES from the C++ —
; lexCategory-driven scanning, #b/#o/#x/#d radix tokens, #A glyph ids,
; keyword tokens with the colon already stripped — the C++ is the oracle).
;
; Inc-2 scope: the lexer (getToken and friends over the opensp InputSource
; token cursor) and the DATUM reader (parseDatum / parseSelfEvaluating /
; parseAbbreviation) plus the declaration-content parsers
; (parseStandardChars / parseNameChars / parseSeparatorChars /
; parseMapSdataEntity). The EXPRESSION half (parse()/parseTopLevel and the
; parse<Form> family building Expression trees) lands with Inc 3 — it
; shares this lexer unchanged.
;
; Line ends: SchemeParser reads OpenSP-normalized text (records end in RE =
; 0x0D); skipComment therefore stops at '\r', exactly like the reference.

; token-allow bits (SchemeParser.h; octal in the reference)
define ALLOW_END_OF_ENTITY: int 0x1
define ALLOW_FALSE: int 0x2
define ALLOW_KEYWORD: int 0x4
define ALLOW_OPEN_PAREN: int 0x8
define ALLOW_CLOSE_PAREN: int 0x10
define ALLOW_IDENTIFIER: int 0x20
define ALLOW_PERIOD: int 0x40
define ALLOW_OTHER_EXPR: int 0x80
define ALLOW_EXPRESSION_KEY: int 0x100
define ALLOW_KEY_DEFINE: int 0x200
define ALLOW_KEY_ELSE: int 0x400
define ALLOW_KEY_ARROW: int 0x800
define ALLOW_STRING: int 0x1000
define ALLOW_HASH_OPTIONAL: int 0x2000
define ALLOW_HASH_KEY: int 0x4000
define ALLOW_HASH_REST: int 0x8000
define ALLOW_UNQUOTE: int 0x10000
define ALLOW_UNQUOTE_SPLICING: int 0x20000
define ALLOW_QUASIQUOTE_KEY: int 0x40000
define ALLOW_VECTOR: int 0x80000
define ALLOW_HASH_CONTENTS: int 0x100000
; allowExpr = False|Keyword|OpenParen|Identifier|String|HashOptional
;           | HashKey|HashRest|OtherExpr
define ALLOW_EXPR: int 0xF0AE

; tokens (SchemeParser.h enum Token)
define TOKEN_END_OF_ENTITY: int 0
define TOKEN_TRUE: int 1
define TOKEN_FALSE: int 2
define TOKEN_STRING: int 3
define TOKEN_IDENTIFIER: int 4
define TOKEN_KEYWORD: int 5
define TOKEN_CHAR: int 6
define TOKEN_NUMBER: int 7
define TOKEN_GLYPH_ID: int 8
define TOKEN_OPEN_PAREN: int 9
define TOKEN_CLOSE_PAREN: int 10
define TOKEN_PERIOD: int 11
define TOKEN_VECTOR: int 12
define TOKEN_QUOTE: int 13
define TOKEN_QUASIQUOTE: int 14
define TOKEN_UNQUOTE: int 15
define TOKEN_UNQUOTE_SPLICING: int 16
define TOKEN_HASH_REST: int 17
define TOKEN_HASH_OPTIONAL: int 18
define TOKEN_HASH_KEY: int 19
define TOKEN_HASH_CONTENTS: int 20
define TOKEN_VOID: int 21

; every allow bit set (recovery / skipForm).
define ALLOW_ALL: int 0x1FFFFF

; parseFormals argument kinds.
define FORMAL_REQUIRED: int 0
define FORMAL_OPTIONAL: int 1
define FORMAL_REST: int 2
define FORMAL_KEY: int 3

define SchemeParser
(
    host: ref[Page]
    interp: ref[Interpreter]
    input: ref[InputSource]
    current_token: StringC
    dsssl2: bool
    ; the mode currently being defined (SchemeParser::defMode_): the initial
    ; mode at top level, a named mode inside a (mode NAME …) body.
    def_mode: ref[ProcessingMode]
)
{
    function make(host: ref[Page], interp: ref[Interpreter], input: ref[InputSource]) returns ref[SchemeParser] linked





    ; --- helpers -----------------------------------------------------------
    ; currentToken_.assign(in->currentTokenStart() + from, len): a fresh copy
    ; on the run page (each token keeps its own buffer, so a StringObj built
    ; from a token survives later tokens — arena semantics).
    procedure set_token_slice(mutable this: ref[SchemeParser], from: size_t, len: size_t) linked







    procedure set_token_char(mutable this: ref[SchemeParser], c: u32) linked







    function lex_cat(this: ref[SchemeParser], c: i32) returns int linked


    ; the reference's initMessage: messages carry the current input location —
    ; in_->currentLocation() = the current TOKEN'S start, not the read cursor.
    procedure message0(mutable this: ref[SchemeParser], mt: MessageType) io reads msg_prog linked





    procedure message1(mutable this: ref[SchemeParser], mt: MessageType, a1: StringC) io reads msg_prog linked





    ; --- the lexer ---------------------------------------------------------
    ; void extendToken(): extend to a delimiter.
    procedure extend_token(mutable this: ref[SchemeParser]) io linked












    ; bool tokenRecover(unsigned allowed, Token &tok)
    procedure token_recover(mutable this: ref[SchemeParser], allowed: int, mutable tok: ref[int]) returns bool io reads msg_prog linked



















    ; bool handleNumber(unsigned allowed, Token &tok)
    procedure handle_number(mutable this: ref[SchemeParser], allowed: int, mutable tok: ref[int]) returns bool io reads msg_prog linked









    ; bool handleIdentifier(unsigned allowed, Token &tok)
    procedure handle_identifier(mutable this: ref[SchemeParser], allowed: int, mutable tok: ref[int]) returns bool io reads msg_prog linked









    ; void skipComment(): to end of entity or RE.
    procedure skip_comment(mutable this: ref[SchemeParser]) io linked









    ; bool scanString(unsigned allowed, Token &tok)
    procedure scan_string(mutable this: ref[SchemeParser], allowed: int, mutable tok: ref[int]) returns bool io reads msg_prog linked



























































    ; bool getToken(unsigned allowed, Token &tok)
    procedure get_token(mutable this: ref[SchemeParser], allowed: int, mutable tok: ref[int]) returns bool io reads msg_prog linked










































































































































































































































































































































    ; --- the datum reader --------------------------------------------------
    ; ELObj *convertAfiiGlyphId(const StringC &): #Annnn -> GlyphIdObj (null
    ; on a malformed suffix, exactly the reference).
    procedure convert_afii_glyph_id(mutable this: ref[SchemeParser], str: StringC) @page true @direct true returns ref[ELObj]? io reads msg_prog linked























    ; bool parseSelfEvaluating(unsigned otherAllowed, ELObj *&result, Token &tok)
    procedure parse_self_evaluating(mutable this: ref[SchemeParser], other_allowed: int, mutable result: ref[ref[ELObj]?], mutable tok: ref[int]) returns bool io reads msg_prog linked


































    ; bool parseAbbreviation(const char *sym, ELObj *&result): 'x -> (quote x)
    procedure parse_abbreviation(mutable this: ref[SchemeParser], sym: Slice[char], mutable result: ref[ref[ELObj]?]) returns bool io reads msg_prog linked














    ; bool parseDatum(unsigned otherAllowed, ELObj *&result, Location &loc, Token &tok)
    procedure parse_datum(mutable this: ref[SchemeParser], other_allowed: int, mutable result: ref[ref[ELObj]?], mutable loc: ref[Location], mutable tok: ref[int]) returns bool io reads msg_prog linked






























































































    ; --- declaration-content parsers (style-specification declarations) ----
    ; void parseStandardChars()
    procedure parse_standard_chars(mutable this: ref[SchemeParser]) io reads msg_prog linked








































































    ; void parseNameChars()
    procedure parse_name_chars(mutable this: ref[SchemeParser]) io reads msg_prog linked












    ; void parseSeparatorChars()
    procedure parse_separator_chars(mutable this: ref[SchemeParser]) io reads msg_prog linked












    ; void parseMapSdataEntity(const StringC &ename, const StringC &etext)
    procedure parse_map_sdata_entity(mutable this: ref[SchemeParser], mutable ename: StringC, mutable etext: StringC) io reads msg_prog linked















    ; ======================================================================
    ; Inc 3 — the EXPRESSION reader (SchemeParser.cxx parseExpression family).
    ; Builds Expression trees the Interpreter compiles + runs. Shares the Inc-2
    ; lexer unchanged. make / style / with-mode / the query forms (there-exists?
    ; ...) and quasiquote route to later increments; the pure-eval forms are
    ; here (if/cond/case/and/or/let/let*/letrec/lambda/begin/set!/quote + define).
    ; ======================================================================

    ; in_->currentLocation() — the START of the current (last-scanned) token,
    ; NOT the read cursor: a call expression anchors at its `(`, a special
    ; form at its keyword (the reference captures right after the token is
    ; consumed; verified against openjade's -G trace columns).
    function cur_loc(this: SchemeParser) @page true @direct true returns Location linked


    procedure expect_close_paren(mutable this: ref[SchemeParser]) returns bool io reads msg_prog linked





    ; bool parseExpression(out expr) — the public entry.
    procedure parse_expression(mutable this: ref[SchemeParser], mutable result: ref[ref[Expression]?]) returns bool io reads msg_prog linked






    ; `key <= Identifier::lastSyntacticKey` (= keyWithMode). The EXPRESSION
    ; keys are the eval-core forms plus the four query forms, make, style,
    ; with-mode, and — ordered inside that run by the reference — define,
    ; else and =>. Everything ABOVE lastSyntacticKey (element, mode, label,
    ; define-unit, query, every NIC keyword) is an ordinary name in
    ; expression position and must NOT be reported. In this port's numbering
    ; that set is SK_DEFINE plus the contiguous SK_QUOTE..SK_ARROW run.
    function is_expression_key(sk: int) returns bool linked






    ; the allow-bit half of that arm: define/else/=> each carry their own bit
    ; (a cond clause may open with `else`, a body with `define`); unquote and
    ; unquote-splicing have none in identifier position, so they always
    ; report; every other expression key needs ALLOW_EXPRESSION_KEY, which
    ; only the OPERATOR position of a form ever sets.
    function expression_key_allowed(this: SchemeParser, sk: int, allowed: int) returns bool linked
















    ; bool parseExpression(allowed, out expr, out key, out tok).
    procedure parse_expr_full(mutable this: ref[SchemeParser], allowed: int, mutable result: ref[ref[Expression]?], mutable key: ref[int], mutable tok: ref[int]) returns bool io reads msg_prog linked
























































































    ; bool parseCall(out expr) — the open paren has been consumed.
    procedure parse_call(mutable this: ref[SchemeParser], mutable result: ref[ref[Expression]?]) returns bool io reads msg_prog linked











































































    procedure parse_regular_call(mutable this: ref[SchemeParser], func: ref[Identifier], loc: Location, op_loc: Location, mutable result: ref[ref[Expression]?]) returns bool io reads msg_prog linked





















    ; parseWithMode (SchemeParser.cxx) — `(with-mode NAME expr)`. NAME is a
    ; mode identifier (created on first reference, like the reference's
    ; lookupProcessingMode) or #f for the initial mode; the single content
    ; expression evaluates with the VM's processing mode switched.
    procedure parse_with_mode(mutable this: ref[SchemeParser], mutable result: ref[ref[Expression]?]) returns bool io reads msg_prog linked
























    ; parseStyle (SchemeParser.cxx) — `(style key: val …)`: keyword/value
    ; pairs only, no class and no content.
    procedure parse_style(mutable this: ref[SchemeParser], mutable result: ref[ref[Expression]?]) returns bool io reads msg_prog linked




































    ; parseMake (SchemeParser.cxx) — (make FOC key: val … content…). FOC is the
    ; flow-object-class identifier (declare-flow-object-class bound it); keyword:
    ; value pairs are characteristics; the rest are content. The MakeExpr carries
    ; exprs = [characteristic values …, content …] with `keys` parallel to the
    ; leading value slice. Characteristics must precede content (the DSSSL make
    ; idiom); duplicate keys keep the first (C++ dedup).
    procedure parse_make(mutable this: ref[SchemeParser], mutable result: ref[ref[Expression]?]) returns bool io reads msg_prog linked

































































    procedure parse_call_args(mutable this: ref[SchemeParser], func: ref[Expression]?, loc: Location, mutable result: ref[ref[Expression]?]) returns bool io reads msg_prog linked






















    procedure parse_if(mutable this: ref[SchemeParser], mutable result: ref[ref[Expression]?]) returns bool io reads msg_prog linked























    ; collect a body's expressions until the close paren (parseBegin).
    procedure parse_begin(mutable this: ref[SchemeParser], mutable result: ref[ref[Expression]?]) returns bool io reads msg_prog linked








































    ; an expression sequence -> unspecified / the single expr / a Sequence.
    procedure collapse_body(mutable this: ref[SchemeParser], exprs: ref[Array[ref[Expression]?]], loc: Location) returns ref[Expression] linked










    procedure parse_and(mutable this: ref[SchemeParser], mutable result: ref[ref[Expression]?]) returns bool io reads msg_prog linked





































    procedure parse_or(mutable this: ref[SchemeParser], mutable result: ref[ref[Expression]?]) returns bool io reads msg_prog linked





































    procedure parse_set(mutable this: ref[SchemeParser], mutable result: ref[ref[Expression]?]) returns bool io reads msg_prog linked


















    procedure parse_quote(mutable this: ref[SchemeParser], mutable result: ref[ref[Expression]?]) returns bool io reads msg_prog linked













    procedure parse_quoted_datum(mutable this: ref[SchemeParser], mutable result: ref[ref[Expression]?]) returns bool io reads msg_prog linked











    ; ======================================================================
    ; quasiquote (SchemeParser.cxx parseQuasiquote / parseQuasiquoteTemplate).
    ; The eval side (QuasiquoteExpr / compile_quasiquote) is already in place;
    ; this builds the QuasiquoteExpr tree from `x / ,x / ,@x / nested levels.
    ; ======================================================================

    ; (quasiquote X) form — template then the closing paren.
    procedure parse_quasiquote(mutable this: ref[SchemeParser], mutable result: ref[ref[Expression]?]) returns bool io reads msg_prog linked










    ; createQuasiquoteAbbreviation: wrap `inner` as (sym inner), a listType QQ.
    procedure create_quasiquote_abbrev(mutable this: ref[SchemeParser], sym: Slice[char], inner: ref[Expression]?) returns ref[Expression] linked
















    ; bool parseQuasiquoteTemplate(level, allowed, expr, key, tok, spliced).
    procedure parse_quasiquote_template(mutable this: ref[SchemeParser], level: int, allowed: int, mutable result: ref[ref[Expression]?], mutable key: ref[int], mutable tok: ref[int], mutable spliced: ref[bool]) returns bool io reads msg_prog linked



















































































    ; the tokenOpenParen / tokenVector arm of parseQuasiquoteTemplate.
    procedure parse_quasiquote_list(mutable this: ref[SchemeParser], level: int, open_tok: int, mutable result: ref[ref[Expression]?], mutable key: ref[int], mutable tok: ref[int], mutable spliced: ref[bool]) returns bool io reads msg_prog linked






































































































    ; (cond (test expr...) ... (else expr...)) -> nested ifs.
    procedure parse_cond(mutable this: ref[SchemeParser], mutable result: ref[ref[Expression]?]) returns bool io reads msg_prog linked





































































    ; (case key ((d...) expr...) ... (else expr...)).
    procedure parse_case(mutable this: ref[SchemeParser], mutable result: ref[ref[Expression]?]) returns bool io reads msg_prog linked

























































    ; --- let family --------------------------------------------------------
    ; parse `(var init) ...)` — the bindings-list open paren already consumed.
    procedure parse_bindings(mutable this: ref[SchemeParser], mutable vars: ref[Array[ref[Identifier]?]], mutable inits: ref[Array[ref[Expression]?]]) returns bool io reads msg_prog linked






















    procedure parse_let(mutable this: ref[SchemeParser], mutable result: ref[ref[Expression]?]) returns bool io reads msg_prog linked

















































    procedure parse_let_star(mutable this: ref[SchemeParser], mutable result: ref[ref[Expression]?]) returns bool io reads msg_prog linked


















    procedure parse_letrec(mutable this: ref[SchemeParser], mutable result: ref[ref[Expression]?]) returns bool io reads msg_prog linked


















    procedure parse_lambda(mutable this: ref[SchemeParser], mutable result: ref[ref[Expression]?]) returns bool io reads msg_prog linked



































    ; assemble a Signature, materializing the keyword-arg identifier table.
    procedure build_signature(mutable this: ref[SchemeParser], formals: ref[Array[ref[Identifier]?]], n_required: int, n_optional: int, has_rest: bool, n_key: int) @page true @direct true returns Signature linked

















    ; bool parseSpecialQuery(out expr, const char *query) — SchemeParser.cxx:2401.
    ; The whole DSSSL query language is this one desugaring: `(FORM v nl e)`
    ; becomes `(PRIM (lambda (v) e) nl)`, PRIM being one of four builtins.dsl
    ; procedures. Two things follow from the shape and are pinned in
    ; tests/dazzle/engine/query1:
    ;  - the bound variable is a LAMBDA variable, so it is in scope in the
    ;    EXPRESSION only — the node-list argument still sees the outer binding;
    ;  - the operator is a CONSTANT holding the primitive's BUILTIN value,
    ;    read here at parse time, so a stylesheet that redefines
    ;    node-list-filter changes its own calls and never `select-each`.
    ; The order matters: the reference resolves the operator BEFORE parsing
    ; the two argument expressions, and compute_builtin_value can run the VM.
    procedure parse_special_query(mutable this: ref[SchemeParser], mutable result: ref[ref[Expression]?], mutable prim: Slice[char]) returns bool io reads msg_prog linked





































    ; bool parseFormals(formals, inits, out nRequired, out hasRest, out nKey).
    procedure parse_formals(mutable this: ref[SchemeParser], mutable formals: ref[Array[ref[Identifier]?]], mutable inits: ref[Array[ref[Expression]?]], mutable n_required: ref[int], mutable has_rest: ref[bool], mutable n_key: ref[int]) returns bool io reads msg_prog linked


















































































    ; grow inits with null defaults up to n entries.
    procedure pad_inits(this: ref[SchemeParser], mutable inits: ref[Array[ref[Expression]?]], n: int) linked





    ; --- top level ---------------------------------------------------------
    ; the reader loop (SchemeParser::parse) — one top-level form per iteration.
    procedure parse(mutable this: ref[SchemeParser]) io reads msg_prog linked
































    ; `recovering` gates the DIAGNOSTIC and, like the reference, widens the
    ; head token's allow set to everything (SchemeParser.cxx:126).
    procedure parse_top_level(mutable this: ref[SchemeParser], recovering: bool) returns bool io reads msg_prog linked








































































    ; --- construction-rule top-level forms (SchemeParser.cxx do*) -----------
    ; (element PATTERN body) — PATTERN is a GI string/symbol or an ancestor /
    ; attribute-qualifier list (convertToPattern). A malformed pattern still
    ; consumes the body (matching the reference), it just adds no rule.
    procedure do_element(mutable this: ref[SchemeParser]) returns bool io reads msg_prog linked





















    ; (or-element (GI …) body) — one action, several GI patterns.
    procedure do_or_element(mutable this: ref[SchemeParser]) returns bool io reads msg_prog linked



































    ; (default body) — the empty-GI pattern (matches any element).
    procedure do_default(mutable this: ref[SchemeParser]) returns bool io reads msg_prog linked














    ; (id ID body) — SchemeParser::doId (SchemeParser.cxx:349). A construction
    ; rule keyed by the node's ID-typed attribute: one pattern element with an
    ; EMPTY GI (so it matches any element) carrying a single IdQualifier.
    ; ★Found by the 2026-08-08 message audit, via `badModeForm`: the form was
    ; not ported anywhere — `unknown top level form "id"` at top level, a
    ; silently dropped mode group inside `(mode …)` — and it is OUTPUT-
    ; AFFECTING, not a diagnostic gap. Everything it needs was already here
    ; (`Qualifier.make_id`, the QK_ID arms of `satisfies` and of the
    ; specificity vector); only this parser half was missing.
    procedure do_id(mutable this: ref[SchemeParser]) returns bool io reads msg_prog linked






















    ; (root body) — the root rule (matches the grove root).
    procedure do_root(mutable this: ref[SchemeParser]) returns bool io reads msg_prog linked










    ; (mode NAME rule…) — set the def-mode, parse its nested rules, restore.
    procedure do_mode(mutable this: ref[SchemeParser]) returns bool io reads msg_prog linked



























































    ; doDeclareFlowObjectClass — (declare-flow-object-class NAME "public-id").
    ; Binds NAME's value to a FlowObjBox for the transform flow-object class
    ; (FOC_* resolved from the public id). ★The duplicate gate is the same one
    ; declare-flow-object-macro uses and reads the INHERITED-CHARACTERISTIC
    ; record: only a name this part already declared with
    ; declare-characteristic is refused (a second declare-flow-object-class
    ; overwrites in silence, since nothing here ever writes that record).
    procedure do_declare_flow_object_class(mutable this: ref[SchemeParser]) returns bool io reads msg_prog linked
























    ; doDeclareFlowObjectMacro — (declare-flow-object-macro NAME (NIC …
    ; (NIC default) … [#!contents VAR]) BODY). A keys2[] form, so DSSSL2-only.
    ; The declaration binds NAME to a macro flow object: a `make NAME` binds
    ; the listed characteristics (defaulting to their declared expression, or
    ; #f) plus, with `#!contents`, the content sosofo, and evaluates BODY,
    ; whose sosofo is processed inside a sequence.
    ;
    ; ★The duplicate gate reads the INHERITED-CHARACTERISTIC definition record,
    ; not a flow-object one (the reference has no flowObjDefined test here) —
    ; so a name already declared by declare-characteristic in this part is
    ; `duplicate flow object class` and the macro is NOT installed, while a
    ; second declare-flow-object-macro of the same name simply overwrites.
    ; A BUILT-IN characteristic name (font-size) has part -1 and never
    ; triggers it.
    procedure do_declare_flow_object_macro(mutable this: ref[SchemeParser]) returns bool io reads msg_prog linked











































































    ; parseRuleBody: one expression + the closing paren. Inc 5a is
    ; construction-rule only (a dsssl2 style rule — a keyword-headed body — is
    ; deferred with the print path); no keyword branch here.
    ; SchemeParser::parseRuleBody (SchemeParser.cxx:399). ★A rule whose body
    ; STARTS WITH A KEYWORD is a dsssl2 STYLE RULE — `(element p font-size:
    ; 14pt)` sets characteristics without building a flow object — and the
    ; whole body is then a keyword/value sequence gathered into one
    ; StyleExpression. Anything else is a construction rule and its body is a
    ; single expression yielding a sosofo.
    ; ★The keyword test is `expr->keyword()` on the FIRST parsed expression,
    ; not a token peek: `font-size:` is an ordinary constant expression whose
    ; value happens to be a keyword object, so the parse is unchanged and only
    ; the classification is new.
    procedure parse_rule_body(mutable this: ref[SchemeParser], mutable result: ref[ref[Expression]?], mutable rule_type: ref[int]) returns bool io reads msg_prog linked









































    ; (declare-initial-value NAME expr) — SchemeParser::doDeclareInitialValue.
    ; The identifier must already carry an inherited characteristic
    ; (notABuiltinInheritedC otherwise); the expression is collected for
    ; compileInitialValues.
    procedure do_declare_initial_value(mutable this: ref[SchemeParser]) returns bool io reads msg_prog linked



















    ; The pubid token both characteristic declarations read: a string, or —
    ; under -2 only — `#f` for "no public identifier", in which case the
    ; reference leaves `pubid` EMPTY (`if (tok == tokenString) pubid = …`).
    procedure get_pubid_token(mutable this: ref[SchemeParser], mutable out: ref[StringC]) returns bool io reads msg_prog linked












    ; (declare-characteristic NAME PUBID expr) — SchemeParser::
    ; doDeclareCharacteristic: bind the identifier to the backend extension
    ; characteristic named by PUBID (IgnoredC when the backend has none —
    ; see installExtensionInheritedC) and collect the initial value.
    ; ★The duplicate gate is two-stage and asymmetric: a name already
    ; registered as a CHAR NIC is refused outright (no part comparison at
    ; all), while a name already carrying a characteristic is refused only
    ; when the record is from THIS part — an earlier part wins in silence, and
    ; a BUILT-IN characteristic (part -1, i.e. 0xFFFFFFFF) fails the
    ; `defPart <= currentPartIndex` test and so may be re-declared.
    procedure do_declare_characteristic(mutable this: ref[SchemeParser]) returns bool io reads msg_prog linked








































    ; (declare-char-characteristic+property NAME PUBID default) —
    ; SchemeParser::doDeclareCharCharacteristicAndProperty. The one
    ; declaration that installs TWO things: a non-inherited characteristic of
    ; the `character` flow object (the CHAR NIC — a flag on the Identifier,
    ; read by CharacterFlowObj::hasNonInheritedC) and a character property of
    ; the same name with the same default (the very same addCharProperty
    ; declare-char-property uses, so the default must be a CONSTANT).
    ; ★The gate is the MIRROR IMAGE of declare-characteristic's: here a name
    ; carrying a characteristic is refused unconditionally — a BUILT-IN one
    ; too, since there is no part comparison on this arm — and a name already
    ; registered as a char NIC only within the same part.
    ; ★The diagnostic points at the FORM (setNextLocation(loc) taken at
    ; entry), unlike declare-char-property, whose diagnostics point at the
    ; value expression.
    procedure do_declare_char_characteristic_and_property(mutable this: ref[SchemeParser]) returns bool io reads msg_prog linked











































    ; (define-unit NAME expr) — SchemeParser::doDefineUnit. The name must be
    ; all letters and not the single letter `e` (the exponent marker); the
    ; body computes lazily in Unit::tryCompute. The defined gate mirrors
    ; doDefine: an earlier part wins silently, a same-part redefinition is
    ; duplicateUnitDefinition with the first definition as the aux line.
    procedure do_define_unit(mutable this: ref[SchemeParser]) returns bool io reads msg_prog linked















































    procedure do_define(mutable this: ref[SchemeParser]) returns bool io reads msg_prog linked




































































    ; doDefineLanguage — `(define-language NAME (collate …) (toupper (lc UC)…)
    ; (tolower (UC lc)…))`: build a LangObj, compile it and bind it as the
    ; identifier's definition (a constant, the reference's
    ; ConstantExpression(LangObj)).
    ;
    ; ★Its duplicate gate is NOT doDefine's: a same-part redefinition reports
    ; and FAILS the form (so the first language survives), while an
    ; earlier-part definition falls through and is OVERWRITTEN — doDefine
    ; skips that case instead.
    ; ★Every clause dispatches on the KEY, and a head that is no key at all,
    ; or a key with no meaning here, fails the form SILENTLY: no diagnostic
    ; is reported anywhere in define-language's sub-parsers, only the
    ; top-level recovery is entered.
    procedure do_define_language(mutable this: ref[SchemeParser]) returns bool io reads msg_prog linked






























































    ; doCollate — the `(collate …)` clause: multi-collating elements,
    ; collating symbols and the order. ★`element` and `position` are the same
    ; keys the construction rules and the NIC tables use.
    procedure do_collate(mutable this: ref[SchemeParser], mutable lang: ref[LangObj]) returns bool io reads msg_prog linked

































    ; doMultiCollatingElement — `(element SYM "string")`: SYM collates as one
    ; unit standing for that character sequence.
    procedure do_multi_collating_element(mutable this: ref[SchemeParser], mutable lang: ref[LangObj]) returns bool io reads msg_prog linked



















    ; doCollatingSymbol — `(symbol SYM)`: a name that takes a collating
    ; position of its own without standing for any characters.
    procedure do_collating_symbol(mutable this: ref[SchemeParser], mutable lang: ref[LangObj]) returns bool io reads msg_prog linked













    ; doCollatingOrder — `(order (LEVELS…) POSITIONS…)`. The first list gives
    ; one sort level per parenthesized group; then the collating positions in
    ; ascending order, each of them an identifier, a character, `#t` (the
    ; position unknown characters take) or a `(SYM WEIGHTS…)` group.
    ;
    ; ★The LevelSort accumulator is NEVER reset between levels — that is the
    ; reference's own structure, and it is observable: a `(forward)` level
    ; followed by a `(backward)` one fails the whole define-language form
    ; (silently), and a `position` flag, once set, holds for every level
    ; after it.
    procedure do_collating_order(mutable this: ref[SchemeParser], mutable lang: ref[LangObj]) returns bool io reads msg_prog linked































































































    ; doWeights — `(SYM (level-0 weights…) (level-1 weights…) …)`: a
    ; collating position with explicit weights per level. ★A STRING weight
    ; contributes one weight PER CHARACTER, and an unparenthesized weight
    ; advances the level just like a group does (the level counter is bumped
    ; whenever the nesting is back at zero).
    procedure do_weights(mutable this: ref[SchemeParser], mutable lang: ref[LangObj]) returns bool io reads msg_prog linked




















































    ; doToupper / doTolower — `(toupper (lc UC) …)` / `(tolower (UC lc) …)`.
    ; The pairs go into a CharMap in the reference, so a repeated left-hand
    ; character is REPLACED: the last pair wins.
    procedure do_case_pairs(mutable this: ref[SchemeParser], mutable lang: ref[LangObj], up: bool) returns bool io reads msg_prog linked
































    ; doDeclareDefaultLanguage — `(declare-default-language EXPR)`: store the
    ; expression; Interpreter.compile() evaluates it (compileDefaultLanguage).
    procedure do_declare_default_language(mutable this: ref[SchemeParser]) returns bool io reads msg_prog linked





























    ; (declare-class-attribute NAME) / (declare-id-attribute NAME) —
    ; SchemeParser::doDeclareClassAttribute / doDeclareIdAttribute
    ; (SchemeParser.cxx:639). Both are dsssl2-only KEYS, so without `-2` the
    ; form is an unknown top level form. The name feeds the MatchContext
    ; vectors the class/id pattern qualifiers read; it is stored VERBATIM (the
    ; reference pushes currentToken_ unfolded) and normalized at match time.
    procedure do_declare_class_attribute(mutable this: ref[SchemeParser]) returns bool io reads msg_prog linked











    procedure do_declare_id_attribute(mutable this: ref[SchemeParser]) returns bool io reads msg_prog linked











    ; (declare-char-property NAME default-expr) — SchemeParser::
    ; doDeclareCharProperty. ★The default must be a CONSTANT: the reference
    ; optimizes the expression and then demands `constantValue()`, so even
    ; `(+ 1 2)` is varCharPropertyExprUnsupported. Measured.
    procedure do_declare_char_property(mutable this: ref[SchemeParser]) returns bool io reads msg_prog linked




















    ; (add-char-properties PROP: expr … #\c …) — SchemeParser::
    ; doAddCharProperties: a run of keyword/value pairs followed by a run of
    ; CHARACTERS, and every pair is applied to every character. A non-char in
    ; the second run is badAddCharProperty.
    procedure do_add_char_properties(mutable this: ref[SchemeParser]) returns bool io reads msg_prog linked



















































    ; Expression::optimize + constantValue — null when the expression is not
    ; a compile-time constant, which both char-property declarations reject.
    procedure const_value_of(mutable this: ref[SchemeParser], mutable expr: ref[Expression]?) @page true @returnpage true returns ref[ELObj]? io reads msg_prog linked




















    ; skip a form to its matching close paren (recovery / unhandled forms).
    procedure skip_form(mutable this: ref[SchemeParser]) returns bool io reads msg_prog linked





















    ; --- self-test ---------------------------------------------------------
    ; parse one datum from an ASCII snippet and print it; empty result means
    ; parse failure. (Line ends in snippets are RE = \r, the OpenSP record
    ; convention this reader lives on.)
    procedure dump_one(mutable this: ref[SchemeParser], mutable os: ref[OutputCharStream]) returns bool io reads msg_prog linked














    procedure check(host: ref[Page], mutable interp: ref[Interpreter], mutable src: Slice[char], expect: Slice[char]) returns bool io reads msg_prog linked










    ; The suite is split across functions so each runs on its OWN local region
    ; (its `_rp`, released on return): a single region accumulating every
    ; interpreter + eval + grove parse crosses a page boundary the RBMM growth
    ; edge mishandles. reader_test's interps die before eval_test's ei is made.
    procedure test() returns int io reads msg_prog linked







    procedure reader_test() returns int io reads msg_prog linked















































































    ; ================= Inc 3: the evaluator =============================
    procedure eval_test() returns int io reads APP_INPUT_CS linked













































































































































































































































































































































































































































    ; --- style-engine test helper (Inc 5) ----------------------------------
    ; Self-contained: its own local region (own interp + FOTBuilder), released
    ; on return, so a stylesheet's whole footprint never accumulates on the
    ; caller's region. `root` lives on the caller's (persisting) region; only
    ; the scalar result crosses back. Loads the stylesheet, processes `root`,
    ; and compares the collected output to `expected`.
    procedure style_eq(mutable src: Slice[char], mutable root: ref[GroveNode], expected: Slice[char]) returns bool io reads msg_prog linked
















    ; --- eval-test helpers -------------------------------------------------
    ; parse ONE expression from src, compile it, run it on a fresh VM.
    procedure eval_str(host: ref[Page], mutable interp: ref[Interpreter], mutable src: Slice[char]) @page true @direct true returns ref[ELObj]? io reads msg_prog linked















    ; run a whole program (its top-level defines register on interp).
    procedure run_program(host: ref[Page], mutable interp: ref[Interpreter], mutable src: Slice[char]) io reads msg_prog linked







    procedure eval_int(host: ref[Page], mutable interp: ref[Interpreter], mutable src: Slice[char]) returns int io reads msg_prog linked









    procedure eval_bool(host: ref[Page], mutable interp: ref[Interpreter], mutable src: Slice[char]) returns bool io reads msg_prog linked







    ; eval src and compare the resulting string to an ASCII expected value.
    procedure eval_str_eq(host: ref[Page], mutable interp: ref[Interpreter], mutable src: Slice[char], expected: Slice[char]) returns bool io reads msg_prog linked










}
