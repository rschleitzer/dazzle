; SgmlFOTBuilder — the `-t fot` backend: the flow object tree dumped as SGML
; (Stage 6a Inc 8, slice 1). Ported from ~/repos/dazzle/jade/SgmlFOTBuilder.cxx
; (C++ oracle; C# mirror openjade-net/src/OpenJade/Jade/SgmlFOTBuilder.cs).
;
; Structure mirror: the reference's ~147 characteristic setters each render
; ` name="value"` into the `ics_` string stream, flushed by the next flow
; object's start into its start tag; here one set_ic renders a Style.InheritedC
; by kind (the fot backend is a pure printer — the semantic setters return
; with the RTF port). Flow objects of this slice: sequence, paragraph,
; paragraph-break, display-group, line-field, plus text/characters and the
; pending-anchor machinery (<a name=.../> for source elements). Units print in
; the reference's millipoint format (72000 units/inch, "%03d" + point-insert —
; quirks preserved: 500 -> ".5pt"); the LengthSpec display-size factor is NEVER
; printed (dead sprintf in the reference operator<<).
;
; Output frame: `<?xml version="1.0"?>` RE `<fot>` RE ... `</fot>` RE, RE =
; 0x0D rendered as the output newline by the record encoder at flush (the
; RecordOutputCharStream seam, same as the transform sink).
;
; RBMM: both buffers (out, ics) live on the sink's own page; ics is reused
; via a length cursor (the open_elements pattern), never reallocated per FO.

use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String.String
use opensp.StringC.StringC
use opensp.CodingSystem.CodingSystem
use opensp.CodingSystemKit.CodingSystemKit
use opensp.CodingSystem.IENC_UTF8
use dazzle.Grove.GroveNode
use dazzle.Grove.GroveInfo
use dazzle.ELObj.Identifier
use dazzle.ELObj.ELObj
use dazzle.ELObj.GlyphSubstTableRec
use dazzle.ELObj.OutputCharStream
use dazzle.Style.InheritedC
use dazzle.Style.RuleNIC
use dazzle.Style.LinkNIC
use dazzle.Style.ExternalGraphicNIC
use dazzle.Style.LeaderNIC
use dazzle.Style.BoxNIC
use dazzle.Style.ScoreNIC
use dazzle.Style.LengthSpec
use dazzle.Style.DisplaySpace
use dazzle.Style.InlineSpace
use dazzle.Style.FotSym
use dazzle.Style.DisplayNIC
use dazzle.Style.TableNIC
use dazzle.Style.TableColumnNIC
use dazzle.Style.TableCellNIC
use dazzle.Style.CharacterNIC
use dazzle.Style.AnchorNIC
use dazzle.Style.GlyphAnnotationNIC
use dazzle.Style.EmphasizingMarkNIC
use dazzle.Style.GridNIC
use dazzle.Style.GridCellNIC
use dazzle.Style.EmbeddedTextNIC
use dazzle.Style.IncludedContainerAreaNIC
use dazzle.Style.MultiModeRec
use dazzle.Style.MultiModeNIC

define SgmlFOTBuilder
(
    out: ref[Array[u32]]
    ics: ref[Array[u32]]
    ics_len: size_t
    in_ics: bool
    ; the header/footer capture (curOs_ = &hfs_ between startSimplePageSequence
    ; and endAllSimplePageSequenceHeaderFooter); hf holds the 24 extracted
    ; part strings (StringC hf_[nHF]).
    hfs: ref[Array[u32]]
    hfs_len: size_t
    in_hfs: bool
    hf: ref[Array[StringC]]?
    ; em[0] — the emphasizing-mark's captured mark content (same buffer as the
    ; header/footer parts, exactly as in the reference).
    em: StringC
    pending_elements: ref[Array[ref[GroveNode]?]]
    pending_levels: ref[Array[int]]
    pending_count: size_t
    n_pending_non_empty: int
    node_level: int
    suppress_anchors: bool
    ; (the label:/content-map: port capture moved UP to the FotSink seam —
    ; recorded calls, SaveFOTBuilder.scaly; this sink only ever renders the
    ; live stream.)
    ; glyphSubstTableDefined_ — which gst<n> tables the dump has defined.
    gst_defined: ref[Array[bool]]
    ; multiModeHasPrincipalMode_ — one flag per open multi-mode: whether its
    ; principal `<multi-mode.mode>` is still open (the first named mode closes
    ; it, and so does the serial end if there is no named mode at all).
    mm_principal: ref[Array[bool]]
    mm_depth: size_t
    host: ref[Page]
)
{
    function make(host: ref[Page]) returns ref[SgmlFOTBuilder] linked



































    ; the destructor's closing tag — the CLI calls this before flushing.
    procedure finish(mutable this: ref[SgmlFOTBuilder]) linked





    ; --- low-level output ----------------------------------------------------
    ; one char into the current stream (out, or ics while a set_ic renders).
    procedure put(mutable this: ref[SgmlFOTBuilder], c: u32) linked













    ; the curOs_ seam: the main tree, or the header/footer capture while a
    ; simple-page-sequence's parts render.
    procedure out_put(mutable this: ref[SgmlFOTBuilder], c: u32) @persists true linked













    procedure raw(mutable this: ref[SgmlFOTBuilder], s: Slice[char]) linked









    procedure re(mutable this: ref[SgmlFOTBuilder]) linked


    procedure raw_stringc(mutable this: ref[SgmlFOTBuilder], s: StringC) linked










    ; unsigned decimal.
    procedure raw_uint(mutable this: ref[SgmlFOTBuilder], n_in: int) linked






















    ; signed long per the reference operator<< (sign, then magnitude).
    procedure raw_int(mutable this: ref[SgmlFOTBuilder], n: int) linked










    ; Data escaping (operator<<(Data)): &amp; &lt; &gt; &quot;, raw ASCII,
    ; numeric char refs at and above 0x80.
    procedure data_escaped(mutable this: ref[SgmlFOTBuilder], s: Slice[u32]) linked

























    ; Units — the reference "%03d" + point-insertion algorithm, quirks intact
    ; (500 -> ".5pt", -500 -> "-.5pt", 0 -> "0pt", 12000 -> "12pt").
    procedure units(mutable this: ref[SgmlFOTBuilder], n_in: int) linked





































































    ; operator<<(LengthSpec) — factor-bearing specs print ONLY the length part
    ; (the reference never streams the sprintf'd percentage; dead code kept
    ; faithfully).
    procedure length_spec(mutable this: ref[SgmlFOTBuilder], ls: LengthSpec) linked














    ; "%.2f" — two decimals, round half away from zero (printf shape for the
    ; factor magnitudes the corpus produces).
    procedure raw_fixed2(mutable this: ref[SgmlFOTBuilder], d_in: double) linked















    ; operator<<(TableLengthSpec) — unlike the plain LengthSpec operator this
    ; one really prints the factors: "%.2f%%" for display-size, "%.2f*" for
    ; table-unit, '+'-joined after a leading length.
    procedure table_length_spec(mutable this: ref[SgmlFOTBuilder], ls: LengthSpec, tfactor: double) linked





























    ; hex2 — two uppercase hex digits.
    procedure hex2(mutable this: ref[SgmlFOTBuilder], c: int) linked






    ; operator<<(DeviceRGBColor) — '#RRGGBB'.
    procedure color_out(mutable this: ref[SgmlFOTBuilder], rgb: int) linked







    ; inlineSpaceC — reference quirks kept faithfully: nothing at all when
    ; nominal, min and max are all zero; and the value is NEVER closed (the
    ; reference forgets the trailing quote).
    procedure inline_space_c(mutable this: ref[SgmlFOTBuilder], name: StringC, sp: ref[InlineSpace]) linked

























    procedure sym_out(mutable this: ref[SgmlFOTBuilder], s: FotSym) linked














    ; the two scale symbols printed from their CODE. Every other FotSym this
    ; backend renders arrived through a symbol conversion and carries its own
    ; name, but included-container-area's scaleType DEFAULTS to symbolMaxUniform
    ; without ever being converted — and the reference prints symbolName(sym)
    ; there, not a captured string.
    procedure scale_sym_out(mutable this: ref[SgmlFOTBuilder], s: FotSym) linked














    ; --- characteristic rendering (the set* family) --------------------------
    procedure set_ic(mutable this: ref[SgmlFOTBuilder], ic: ref[InheritedC]) linked








































































































    ; a GlyphId attribute value: the public id (raw), "::<suffix>" when the
    ; suffix is set; an id-less glyph id prints "false".
    procedure glyph_id_out(mutable this: ref[SgmlFOTBuilder], gid: ref[ELObj]) linked
















    ; setGlyphSubstTable — the reference dump: first use of a table writes a
    ; <define-glyph-subst-table id="gst<n>"> block to the MAIN stream (before
    ; the element's open tag — set* runs at style push); the characteristic
    ; itself renders the space-separated id list into the ics buffer.
    procedure gst_out(mutable this: ref[SgmlFOTBuilder], tabs: ref[Array[ref[GlyphSubstTableRec]?]]?) linked











































































    procedure output_ics(mutable this: ref[SgmlFOTBuilder]) linked












    ; --- NIC rendering --------------------------------------------------------
    procedure display_space_nic(mutable this: ref[SgmlFOTBuilder], name: Slice[char], ds: DisplaySpace) linked
















































    procedure display_nic(mutable this: ref[SgmlFOTBuilder], nic: ref[DisplayNIC]) linked





































    ; --- pending element anchors ----------------------------------------------
    procedure start_node(mutable this: ref[SgmlFOTBuilder], node: ref[GroveNode], mode_name: StringC) linked






























    procedure end_node(mutable this: ref[SgmlFOTBuilder]) linked













    ; outputElementName(groveIndex, idData, idSize) — a NON-document grove
    ; prefixes its index and a dot; grove 0 writes the bare name.
    procedure output_element_name_g(mutable this: ref[SgmlFOTBuilder], g: int, id_chars: Slice[u32]) linked









    procedure output_element_name(mutable this: ref[SgmlFOTBuilder], node: ref[GroveNode]) linked


















    procedure flush_pending_elements(mutable this: ref[SgmlFOTBuilder]) linked




















    ; --- text ------------------------------------------------------------------
    procedure characters(mutable this: ref[SgmlFOTBuilder], s: Slice[u32]) linked










    ; SDATA substitution is deferred grove-wide (see the transform sink); the
    ; plain character path matches.
    procedure characters_from_node(mutable this: ref[SgmlFOTBuilder], node: ref[GroveNode]?, s: Slice[u32]) linked


    ; --- flow objects ------------------------------------------------------------
    procedure start_simple_flow_obj(mutable this: ref[SgmlFOTBuilder], name: Slice[char]) linked








