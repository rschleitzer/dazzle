    ; --- flush ---------------------------------------------------------------
    ; the whole tree, record-encoded (RE -> NL, RS dropped) and then run
    ; through the app's OUTPUT coding system — the
    ; RecordOutputCharStream(EncodeOutputCharStream(&outputFile_,
    ; outputCodingSystem_)) seam of jade.cxx:175. The stream carries
    ; outputNumericCharRef as its escaper (SgmlFOTBuilder.cxx:615), so a char
    ; the coding system cannot express leaves as `&#<decimal>;`; the BOM
    ; belongs to stream creation, i.e. to this one file.
    procedure to_utf8(mutable this: ref[SgmlFOTBuilder]) @page true @direct true returns String reads OUTPUT_ENC linked






























