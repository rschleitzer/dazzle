define FotSink (sgml: ref[SgmlFOTBuilder]?, rtf: ref[RtfFOTBuilder]?, tex: ref[TeXFOTBuilder]?, html: ref[HtmlFOTBuilder]?, mif: ref[MifFOTBuilder]?, transform: ref[TransformFOTBuilder]?, var save: ref[SaveFOTBuilder]?)
{
    function make_sgml(host: ref[Page], sgml: ref[SgmlFOTBuilder]) @ret_explicit_0 true @deep true returns ref[FotSink] linked

    function make_rtf(host: ref[Page], rtf: ref[RtfFOTBuilder]) @ret_explicit_0 true @deep true returns ref[FotSink] linked

    function make_tex(host: ref[Page], tex: ref[TeXFOTBuilder]) @ret_explicit_0 true @deep true returns ref[FotSink] linked

    function make_html(host: ref[Page], html: ref[HtmlFOTBuilder]) @ret_explicit_0 true @deep true returns ref[FotSink] linked

    function make_mif(host: ref[Page], mif: ref[MifFOTBuilder]) @ret_explicit_0 true @deep true returns ref[FotSink] linked

    ; the transform backend (`-t sgml` / `-t xml`). It answers only the
    ; nineteen calls TransformFOTBuilder overrides; every other method finds
    ; all five print slots null and does nothing, which IS the FOTBuilder base.
    function make_transform(host: ref[Page], transform: ref[TransformFOTBuilder]) @ret_explicit_0 true @deep true returns ref[FotSink] linked

    ; --- the capture seam ----------------------------------------------------
    procedure set_save(mutable this: ref[FotSink], q: ref[SaveFOTBuilder]?) @deep true @deep_this_2 true @deep_whole_2 true linked

    function get_save(this: ref[FotSink]) @ret_param_0 true @deep true returns ref[SaveFOTBuilder]? linked

    ; replay a recorded queue through this sink (SaveFOTBuilder::emit). The
    ; ctor-node form wraps the replay in startNode/endNode on the TARGET —
    ; recorded again if the sink is currently capturing (reference splice
    ; semantics).
    procedure emit_saved(mutable this: ref[FotSink], mutable q: ref[SaveFOTBuilder]) @ret_nonlocal true @deep true @deep_this_2 true io reads tex_prog linked

    ; replay a queue INTO another queue (endConnection: saved->emit(*port->fotb)).
    procedure emit_saved_into(mutable this: ref[FotSink], mutable q: ref[SaveFOTBuilder]?, dst: ref[SaveFOTBuilder]?) @deep true @deep_this_4 true @deep_whole_4 true io reads tex_prog linked

    procedure emit_one(mutable this: ref[FotSink], mutable r: ref[SaveCallRec]) @deep true @deep_this_2 true io reads tex_prog linked

    ; --- the forwarded surface -------------------------------------------------
    procedure set_ic(mutable this: ref[FotSink], mutable ic: ref[InheritedC]) @deep true @deep_this_2 true io reads tex_prog linked

    procedure characters(mutable this: ref[FotSink], s: Slice[u32]) @deep true io reads tex_prog linked

    procedure characters_from_node(mutable this: ref[FotSink], node: ref[GroveNode]?, s: Slice[u32]) @deep true @deep_this_6 true @deep_whole_6 true io reads tex_prog linked

    procedure start_node(mutable this: ref[FotSink], node: ref[GroveNode], mode_name: StringC) @deep true @deep_this_2 true @deep_whole_2 true io reads tex_prog linked

    procedure end_node(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure start_sequence(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure end_sequence(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure start_paragraph(mutable this: ref[FotSink], mutable nic: ref[DisplayNIC]?) @deep true @deep_this_2 true io reads tex_prog linked

    procedure end_paragraph(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure paragraph_break(mutable this: ref[FotSink], mutable nic: ref[DisplayNIC]?) @deep true io reads mif_prog linked

    procedure start_display_group(mutable this: ref[FotSink], mutable nic: ref[DisplayNIC]) @deep true io reads mif_prog linked

    procedure end_display_group(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure start_line_field(mutable this: ref[FotSink], nic: ref[LineFieldNIC]?) @deep true io reads mif_prog linked

    procedure end_line_field(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure start_leader(mutable this: ref[FotSink], nic: ref[LeaderNIC]) @deep true io reads mif_prog linked

    procedure end_leader(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure start_link(mutable this: ref[FotSink], mutable nic: ref[LinkNIC]) @deep true @deep_this_2 true @deep_whole_2 true io reads tex_prog linked

    procedure end_link(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure start_score(mutable this: ref[FotSink], mutable nic: ref[ScoreNIC]) @deep true io reads mif_prog linked

    procedure end_score(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure start_box(mutable this: ref[FotSink], nic: ref[BoxNIC], mutable dnic: ref[DisplayNIC]?) @deep true io reads mif_prog linked

    procedure end_box(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure rule(mutable this: ref[FotSink], mutable nic: ref[RuleNIC], mutable dnic: ref[DisplayNIC]?) @deep true io reads mif_prog linked

    procedure external_graphic(mutable this: ref[FotSink], mutable nic: ref[ExternalGraphicNIC]?, mutable dnic: ref[DisplayNIC]?) @deep true io reads mif_prog linked

    procedure page_number(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure current_node_page_number(mutable this: ref[FotSink], mutable node: ref[GroveNode]) @deep true @deep_this_2 true @deep_whole_2 true io reads tex_prog linked

    procedure start_simple_page_sequence(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure end_simple_page_sequence_header_footer(mutable this: ref[FotSink], flags: int) @deep true io reads tex_prog linked

    procedure end_all_simple_page_sequence_header_footer(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure end_simple_page_sequence(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure start_table(mutable this: ref[FotSink], tnic: ref[TableNIC], mutable dnic: ref[DisplayNIC]?) @deep true io reads tex_prog linked

    procedure end_table(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure start_table_part_serial(mutable this: ref[FotSink], mutable dnic: ref[DisplayNIC]?) @deep true io reads tex_prog linked

    procedure end_table_part_serial(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure start_table_part_header(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure end_table_part_header(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure start_table_part_footer(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure end_table_part_footer(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure table_column(mutable this: ref[FotSink], nic: ref[TableColumnNIC]) @deep true io reads tex_prog linked

    procedure start_table_row(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure end_table_row(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure start_table_cell(mutable this: ref[FotSink], nic: ref[TableCellNIC]) @deep true io reads tex_prog linked

    procedure end_table_cell(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure table_before_row_border(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure table_after_row_border(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure table_before_column_border(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure table_after_column_border(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure table_cell_before_row_border(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure table_cell_after_row_border(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure table_cell_before_column_border(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure table_cell_after_column_border(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    ; --- the TeX backend's extension flow objects (page-float/page-footnote):
    ; only -t tex ever sees them (every other backend binds their classes as
    ; FOC_UNKNOWN, which never reaches a sink).
    procedure start_page_float(mutable this: ref[FotSink], mutable nic: ref[PageFloatNIC]?) @deep true linked

    procedure end_page_float(mutable this: ref[FotSink]) @deep true linked

    procedure start_page_footnote(mutable this: ref[FotSink]) @deep true linked

    procedure end_page_footnote(mutable this: ref[FotSink]) @deep true linked

    ; --- the MIF backend's index-entry extension flow object (only -t mif
    ; ever sees it; every other backend binds its class as FOC_UNKNOWN).
    procedure index_entry(mutable this: ref[FotSink], mutable nic: ref[IndexEntryNIC]?) @deep true linked

    ; --- the online scroll ------------------------------------------------------
    procedure start_scroll(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure end_scroll(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    ; the per-part header/footer bracket OPEN (SerialFOTBuilder::
    ; startSimplePageSequenceHeaderFooter(k) — start() in the base, a no-op in
    ; the fot/rtf/tex ports whose part handling is driven by the close hook).
    procedure start_simple_page_sequence_header_footer(mutable this: ref[FotSink], flags: int) @deep true io reads mif_prog linked

    ; --- the INLINE/MARK family -------------------------------------------------
    ; Only the fot dump and (for the first three) the TeX backend override
    ; these; rtf/html/mif/transform inherit the FOTBuilder base, whose
    ; `character` ALSO EMITS THE CHARACTER as text before the atomic bracket
    ; (FOTBuilder.cxx:174 — measured: `-t rtf` and `-t sgml` both render
    ; `(make character char: #\A)` as an "A"). rtf/html/mif spell that base out
    ; in their own `character`; the transform arm does it here.
    procedure character(mutable this: ref[FotSink], mutable nic: ref[CharacterNIC]) @deep true io reads mif_prog linked

    procedure alignment_point(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure start_sideline(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure end_sideline(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure anchor(mutable this: ref[FotSink], nic: ref[AnchorNIC]) @deep true io reads tex_prog linked

    procedure start_glyph_annotation(mutable this: ref[FotSink], nic: ref[GlyphAnnotationNIC]) @deep true io reads mif_prog linked

    procedure end_glyph_annotation(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure start_emphasizing_mark_serial(mutable this: ref[FotSink], nic: ref[EmphasizingMarkNIC]) @deep true io reads mif_prog linked

    procedure end_emphasizing_mark_serial(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure start_emphasizing_mark_mark(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure end_emphasizing_mark_mark(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure end_all_emphasizing_mark_mark(mutable this: ref[FotSink]) @deep true linked
    procedure start_math_sequence(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure end_math_sequence(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure start_fraction_serial(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure end_fraction_serial(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure fraction_bar(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure start_fraction_numerator(mutable this: ref[FotSink]) @deep true linked

    procedure end_fraction_numerator(mutable this: ref[FotSink]) @deep true linked

    procedure start_fraction_denominator(mutable this: ref[FotSink]) @deep true linked

    procedure end_fraction_denominator(mutable this: ref[FotSink]) @deep true linked

    procedure start_unmath(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure end_unmath(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure start_superscript(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure end_superscript(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure start_subscript(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure end_subscript(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure start_script_serial(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure end_script_serial(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure start_script_pre_sup(mutable this: ref[FotSink]) @deep true linked

    procedure end_script_pre_sup(mutable this: ref[FotSink]) @deep true linked

    procedure start_script_pre_sub(mutable this: ref[FotSink]) @deep true linked

    procedure end_script_pre_sub(mutable this: ref[FotSink]) @deep true linked

    procedure start_script_post_sup(mutable this: ref[FotSink]) @deep true linked

    procedure end_script_post_sup(mutable this: ref[FotSink]) @deep true linked

    procedure start_script_post_sub(mutable this: ref[FotSink]) @deep true linked

    procedure end_script_post_sub(mutable this: ref[FotSink]) @deep true linked

    procedure start_script_mid_sup(mutable this: ref[FotSink]) @deep true linked

    procedure end_script_mid_sup(mutable this: ref[FotSink]) @deep true linked

    procedure start_script_mid_sub(mutable this: ref[FotSink]) @deep true linked

    procedure end_script_mid_sub(mutable this: ref[FotSink]) @deep true linked

    procedure start_mark_serial(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure end_mark_serial(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure start_mark_over(mutable this: ref[FotSink]) @deep true linked

    procedure end_mark_over(mutable this: ref[FotSink]) @deep true linked

    procedure start_mark_under(mutable this: ref[FotSink]) @deep true linked

    procedure end_mark_under(mutable this: ref[FotSink]) @deep true linked

    procedure start_fence_serial(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure end_fence_serial(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure start_fence_open(mutable this: ref[FotSink]) @deep true linked

    procedure end_fence_open(mutable this: ref[FotSink]) @deep true linked

    procedure start_fence_close(mutable this: ref[FotSink]) @deep true linked

    procedure end_fence_close(mutable this: ref[FotSink]) @deep true linked

    procedure start_radical_serial(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure end_radical_serial(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure radical_radical(mutable this: ref[FotSink], mutable nic: ref[CharacterNIC]) @deep true io reads mif_prog linked

    procedure radical_radical_defaulted(mutable this: ref[FotSink]) @deep true linked

    procedure start_radical_degree(mutable this: ref[FotSink]) @deep true linked

    procedure end_radical_degree(mutable this: ref[FotSink]) @deep true linked

    procedure start_math_operator_serial(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure end_math_operator_serial(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure start_math_operator_operator(mutable this: ref[FotSink]) @deep true linked

    procedure end_math_operator_operator(mutable this: ref[FotSink]) @deep true linked

    procedure start_math_operator_lower_limit(mutable this: ref[FotSink]) @deep true linked

    procedure end_math_operator_lower_limit(mutable this: ref[FotSink]) @deep true linked

    procedure start_math_operator_upper_limit(mutable this: ref[FotSink]) @deep true linked

