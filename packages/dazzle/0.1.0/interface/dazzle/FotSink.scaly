    procedure start_grid(mutable this: ref[FotSink], nic: ref[GridNIC]) @deep true io reads mif_prog linked

    procedure end_grid(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure start_grid_cell(mutable this: ref[FotSink], nic: ref[GridCellNIC]) @deep true io reads mif_prog linked

    procedure end_grid_cell(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    ; --- the LAYOUT-COMPOSITE family --------------------------------------------
    ; Five plain brackets; only the fot backend overrides any of them, so on the
    ; other five the FOTBuilder base start()/end() applies.
    procedure start_embedded_text(mutable this: ref[FotSink], mutable nic: ref[EmbeddedTextNIC]) @deep true io reads mif_prog linked

    procedure end_embedded_text(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure start_included_container_area(mutable this: ref[FotSink], mutable nic: ref[IncludedContainerAreaNIC], mutable dnic: ref[DisplayNIC]?) @deep true io reads mif_prog linked

