    procedure end_side_by_side(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure start_side_by_side_item(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure end_side_by_side_item(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure start_aligned_column(mutable this: ref[FotSink], mutable dnic: ref[DisplayNIC]?) @deep true io reads mif_prog linked

    procedure end_aligned_column(mutable this: ref[FotSink]) @deep true io reads tex_prog linked
    ; --- the ONLINE family ------------------------------------------------------
    ; `marginalia` is a bare bracket; the three multi-mode brackets are what a
    ; SerialFOTBuilder decomposes the class into (its named modes are replayed
    ; between startMultiModeMode/endMultiModeMode, one per port).
    procedure start_marginalia(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure end_marginalia(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure start_multi_mode_serial(mutable this: ref[FotSink], mode: ref[MultiModeRec]?) @deep true @deep_this_2 true @deep_whole_2 true io reads mif_prog linked

    procedure end_multi_mode_serial(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure start_multi_mode_mode(mutable this: ref[FotSink], mode: ref[MultiModeRec]?) @deep true linked

    procedure end_multi_mode_mode(mutable this: ref[FotSink]) @deep true linked

    ; --- the PAGE/COLUMN MODEL ---------------------------------------------------
    ; Two plain brackets; only the fot backend overrides them (as the *Serial
    ; pair), so on the other five the FOTBuilder base start()/end() applies.
    procedure start_page_sequence(mutable this: ref[FotSink]) @deep true io reads mif_prog linked

    procedure end_page_sequence(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    procedure start_column_set_sequence(mutable this: ref[FotSink], mutable dnic: ref[DisplayNIC]?) @deep true io reads mif_prog linked

    procedure end_column_set_sequence(mutable this: ref[FotSink]) @deep true io reads tex_prog linked

    ; --- the TRANSFORM backend's own leaf calls --------------------------------
    ; The eleven methods TransformFOTBuilder overrides that no print backend
    ; declares at all. In the reference these are the SGML-transformation
    ; extension flow objects (TransformFOTBuilder.cxx:203-215); under `-t fot`
    ; and friends their classes bind as UnknownFlowObj, so a print sink can
    ; never reach one — and if it did, the FOTBuilder base would do nothing,
    ; which is exactly what these do with all five print slots null.
    procedure start_element(mutable this: ref[FotSink], mutable gi: StringC, atts: ref[Array[StringC]]?) @deep true @deep_this_2 true @deep_whole_2 true linked

    procedure end_element(mutable this: ref[FotSink]) @deep true linked

    procedure empty_element(mutable this: ref[FotSink], mutable gi: StringC, atts: ref[Array[StringC]]?) @deep true linked

    procedure start_entity(mutable this: ref[FotSink], system_id: StringC) @deep true io reads tfb_prog linked

    procedure end_entity(mutable this: ref[FotSink]) @deep true io reads tfb_prog linked

    procedure entity_ref(mutable this: ref[FotSink], name: StringC) @deep true linked

    procedure processing_instruction(mutable this: ref[FotSink], data: StringC) @deep true linked

    procedure document_type(mutable this: ref[FotSink], name: StringC, public_id: StringC, system_id: StringC) @deep true linked

    ; `formatting-instruction` is the ONE extension class jade.cxx installs for
    ; every backend, so a print sink really can reach this — and there the
    ; FOTBuilder base is a no-op (measured: `-t fot` renders nothing for it).
    procedure formatting_instruction(mutable this: ref[FotSink], data: StringC) @deep true linked

    procedure start_directory(mutable this: ref[FotSink], mutable path: StringC) @deep true io linked

    procedure end_directory(mutable this: ref[FotSink]) @deep true linked

}
