; InheritedC — one record for the reference's class family. `kind` selects the
; payload; `slot` <> -1 marks a pending entry (value converted from the VM
; stack at make-exec); `proto` is the registry prototype a pending/converted
; entry derives from. `print_name` is the exact attribute name SgmlFOTBuilder
; emits (faithful quirks included: "inhibit-line-breaks?" keeps its '?',
; justify-spread? prints "jystify-spread").
define InheritedC
(
    kind: int
    ident: ref[Identifier]?
    index: int
    print_name: StringC
    var bval: bool
    var lval: int
    var sym: FotSym
    var sval: StringC
    var ls: LengthSpec
    var obj: ref[ELObj]?
    var gst: ref[Array[ref[GlyphSubstTableRec]?]]?
    var code: ref[Insn]?
    var proto: ref[InheritedC]?
    var loc: Location
    ; rtf-backend extension characteristic setter id (0 = none; the 12-entry
    ; jade.cxx extension table, RtfFOTBuilder.set_extension_ic)
    var ext_setter: int
    ; Identifier::inheritedCPart_ / inheritedCLoc_ (the reference keeps them on
    ; the Identifier; here they ride the prototype, the only cell a
    ; declare-characteristic install writes). -1 = a BUILT-IN characteristic,
    ; which is what makes `defPart <= currentPartIndex()` false for every
    ; builtin and true only for one the stylesheet declared itself.
    var def_part: u32
    var def_loc: Location
)
{
    function make(host: ref[Page], kind: int, ident: ref[Identifier]?, index: int, print_name: StringC) @ret_explicit_0 true @deep true returns ref[InheritedC] linked

    ; InheritedC::identifier()->name() — the characteristic's name, which only
    ; the ambiguousStyle diagnostic needs.
    function get_ident_name(this: InheritedC) @page true @direct true @ret_param_0 true @deep true returns StringC linked

    function get_index(this: InheritedC) @ret_param_0 true @deep true returns int linked

    function get_kind(this: InheritedC) @ret_param_0 true @deep true returns int linked

    function get_proto(this: InheritedC) @ret_param_0 true @deep true returns ref[InheritedC]? linked

    ; VarInheritedC (Style.cxx): a non-constant spec — `code` (an Insn chain,
    ; typed void: Style cannot import Insn) evaluated at style-push against the
    ; owning style's display + node; `loc` anchors the invalid-value message.
    procedure make_var(host: ref[Page], mutable proto: ref[InheritedC], code: ref[Insn]?, loc: Location) @ret_args_15 true @deep true returns ref[InheritedC] linked

    function is_var(this: InheritedC) @ret_param_0 true @deep true returns bool linked

    ; pin a StringC's bytes onto `host` (empty stays empty) — the save-queue
    ; records outlive the eval bracket the conversion ran under.
    function pin_string(host: ref[Page], s: StringC) @page true @direct true @ret_explicit_0 true @deep true returns StringC linked

    function pin_fotsym(host: ref[Page], s: FotSym) @page true @direct true @deep true returns FotSym linked

    ; the SaveFOTBuilder deep copy: everything set_ic reads at replay time
    ; must live on the queue's host (the reference Call records copy their
    ; args by value). Payload ELObjs are rematerialized for the kinds the
    ; sinks dereference (color / inline-space); other object payloads are
    ; consumed at capture time and dropped here.
    procedure copy_for_save(mutable this: ref[InheritedC], host: ref[Page]) @deep true returns ref[InheritedC] linked

}

; --- value conversions (Interpreter::convert*C, InheritedC.cxx make()) ------
define Convert
{
    ; ★The identifier is NULLABLE, in Primitive.arg_error#'s shape and for its
    ; reason: the characteristic's name is materialised HERE and nowhere else,
    ; the reference recovers it from a `const Identifier *`, and a value that
    ; has no identifier still has an invalid value to report. An empty name is
    ; what the reference's own message machinery prints for one.
    procedure invalid_value(mutable interp: ref[Interpreter], ident: ref[Identifier]?, loc: Location) @ret_nonlocal true @deep true @deep_this_4 true @deep_whole_4 true io reads msg_prog linked

    ; convertLengthC: an exact/inexact quantity of dimension 1.
    procedure convert_length(mutable val_in: ref[ELObj], mutable out: ref[int], mutable interp: ref[Interpreter], loc: Location) @ret_nonlocal true @deep true returns bool io reads msg_prog linked

    ; convertLengthSpecC: the characteristic form — the `-2` string leniency
    ; first, then the raw conversion below. ★The two are separate in the
    ; reference too (Interpreter.h:388 declares the raw one on its own), and
    ; the difference is observable: the display-space/inline-space PRIMITIVES
    ; call the raw form, so a string argument stays invalid there even under
    ; `-2`.
    procedure convert_length_spec_c(mutable val_in: ref[ELObj]?, mutable out: ref[LengthSpec], mutable interp: ref[Interpreter], loc: Location) @ret_nonlocal true @deep true returns bool io reads msg_prog linked

    ; convertLengthSpec: a length quantity, or an engine length-spec
    ; (display-size / arithmetic results) — LengthSpec::convert rounds the
    ; length component and carries the display-size factor (the table-unit
    ; component is dropped; the TableLengthSpec variant keeps it).
    procedure convert_length_spec(val: ref[ELObj], mutable out: ref[LengthSpec]) @ret_nonlocal true @deep true returns bool linked

    ; long(v < 0 ? v - .5 : v + .5) — LengthSpec::convert's rounding.
    function round_length(v: double) @ret_nonlocal true @deep true returns int linked

    ; LengthSpec::convert(FOTBuilder::TableLengthSpec &) — like
    ; convert_length_spec but the table-unit factor survives.
    procedure convert_table_length_spec(mutable val: ref[ELObj], mutable out: ref[LengthSpec], mutable out_tfactor: ref[double], mutable interp: ref[Interpreter], loc: Location) @ret_nonlocal true @deep true returns bool io reads msg_prog linked

    ; convertBooleanC is STRICT: only the #t/#f singletons convert (is_true
    ; is truthiness — any non-#f object — and must NOT be used here). Under
    ; `-2` the strings "yes"/"no"/"true"/"false" become those singletons
    ; first; every other string stays invalid.
    procedure convert_boolean(mutable val_in: ref[ELObj]?, mutable out: ref[bool], mutable interp: ref[Interpreter], loc: Location) @ret_nonlocal true @deep true returns bool io reads msg_prog linked

    ; convertEnumC (identifier-less overload): #f / #t / any symbol installed
    ; with a c-value. Under `-2` a string may name one of them.
    procedure convert_enum(mutable val_in: ref[ELObj]?, mutable out: ref[FotSym], mutable interp: ref[Interpreter], loc: Location) @ret_nonlocal true @deep true returns bool io reads msg_prog linked

    ; convertEnumC (allowed-set overload, the NIC form): the value must convert
    ; AND its code must be in `allowed` (codes array, n entries).
    procedure convert_enum_set(mutable val: ref[ELObj]?, allowed: Slice[int], mutable out: ref[FotSym], mutable interp: ref[Interpreter], loc: Location) @ret_nonlocal true @deep true returns bool io reads msg_prog linked

    procedure convert_string(host: ref[Page], mutable val: ref[ELObj], mutable out: ref[StringC]) @ret_nonlocal true @deep true returns bool linked

    ; ELObjExtensionFlowObjValue::convertStringList — a proper list of
    ; strings; a malformed tail keeps the prefix already collected and fails.
    procedure convert_string_list(host: ref[Page], mutable val: ref[ELObj], mutable out: ref[Array[StringC]]) @ret_nonlocal true @deep true returns bool linked

    procedure convert_integer(mutable val_in: ref[ELObj]?, mutable out: ref[int], mutable interp: ref[Interpreter], loc: Location) @ret_nonlocal true @deep true returns bool io reads msg_prog linked

    ; convertPublicIdC: #f (empty) or a (possibly empty) string.
    procedure convert_public_id(host: ref[Page], mutable val: ref[ELObj], mutable out: ref[StringC], mutable out_false: ref[bool]) @ret_nonlocal true @deep true returns bool linked

    ; convertLetter2C: #f clears; a STRING of exactly two UPPERCASE letters
    ; (the reference accepts no symbols and does not case-fold — "de" is an
    ; invalid value); the empty string also clears.
    procedure convert_letter2(host: ref[Page], mutable val: ref[ELObj], mutable out: ref[StringC], mutable out_false: ref[bool]) @ret_nonlocal true @deep true returns bool linked

    ; InheritedC::make(value, loc, interp) — derive a constant IC from the
    ; prototype `proto` with the converted value; null + message on invalid.
    ; Quantities resolve first (a parse-time datum like 18pt is an
    ; UnresolvedLengthObj until forced — ResolveQuantitiesInsn's job on the
    ; eval path; the compile-time constant path forces here).
    procedure ic_from_value(host: ref[Page], mutable proto: ref[InheritedC], mutable val_in: ref[ELObj], mutable loc: Location, mutable interp: ref[Interpreter]) @page true @direct true @deep true @deep_into_4_8 true returns ref[InheritedC]? io reads msg_prog linked

    ; FlowObj::setDisplayNIC — returns true when `sk` is a display NIC key
    ; (value converted into `nic`; an invalid value messages and leaves the
    ; default, per the reference convert*C behaviour).
    procedure set_display_nic(mutable nic: ref[DisplayNIC], sk: int, mutable val: ref[ELObj], ident: ref[Identifier]?, loc: Location, mutable interp: ref[Interpreter], host: ref[Page]) @ret_nonlocal true @deep true @deep_into_5_16 true returns bool io reads msg_prog linked

    ; a (make table-border …) sosofo — the only sosofo with a border style
    ; (SosofoObj::tableBorderStyle).
    function is_table_border_sosofo(val: ref[ELObj]) @ret_nonlocal true @deep true returns bool linked

    ; RuleC::make's test — a rule-FO sosofo, or the rule class binding's
    ; FlowObj prototype itself (a FlowObj IS a sosofo in the reference;
    ; fraction-bar's initial value is lookup("rule")->flowObj()).
    function is_rule_value(val: ref[ELObj]) @ret_nonlocal true @deep true returns bool linked

    ; a border characteristic VALUE resolved to the style to push: a
    ; table-border sosofo's style, or a boolean -> the canned border-present
    ; styles; null = invalid (caller messages).
    procedure border_style_from(mutable val: ref[ELObj], mutable interp: ref[Interpreter], loc: Location) @ret_args_3 true @deep true returns ref[ELObj]? io reads msg_prog linked

    ; TableFlowObj::setNonInheritedC, the table-specific keys (the display
    ; NICs go through set_display_nic).
    procedure set_table_nic(mutable rec: ref[TableNIC], sk: int, mutable val: ref[ELObj], ident: ref[Identifier]?, loc: Location, mutable interp: ref[Interpreter]) @deep true @deep_into_5_16 true io reads msg_prog linked

    ; TableColumnFlowObj::setNonInheritedC.
    procedure set_table_column_nic(mutable rec: ref[TableColumnNIC], sk: int, mutable val: ref[ELObj]?, ident: ref[Identifier]?, loc: Location, mutable interp: ref[Interpreter]) @deep true @deep_into_5_16 true io reads msg_prog linked

    ; TableCellFlowObj::setNonInheritedC.
    procedure set_table_cell_nic(mutable rec: ref[TableCellNIC], sk: int, mutable val: ref[ELObj]?, ident: ref[Identifier]?, loc: Location, mutable interp: ref[Interpreter]) @deep true @deep_into_5_16 true io reads msg_prog linked

    ; the table-family NIC key sets (Table*FlowObj::hasNonInheritedC +
    ; hasPseudoNonInheritedC — both classes route the same way here).
    function is_table_nic_key(foc: int, sk: int) @ret_nonlocal true @deep true returns bool linked

    ; dispatch a table-family NIC key into the FO's record (created on demand
    ; on `host`); `tnic` is the in/out record slot.
    procedure apply_table_nic(foc: int, mutable nic_in: NICRef, sk: int, mutable val: ref[ELObj]?, ident: ref[Identifier]?, loc: Location, mutable interp: ref[Interpreter], host: ref[Page]) @direct true @ret_args_130 true @deep true returns NICRef io reads msg_prog linked

    ; RuleFlowObj::hasNonInheritedC — the rule extras beyond the display NICs.
    function is_rule_nic_key(foc: int, sk: int) @ret_nonlocal true @deep true returns bool linked

    ; RuleFlowObj::setNonInheritedC (the non-display keys).
    procedure apply_rule_nic(mutable nic_in: NICRef, sk: int, mutable val: ref[ELObj]?, ident: ref[Identifier]?, loc: Location, mutable interp: ref[Interpreter], host: ref[Page]) @direct true @deep true @deep_into_5_16 true returns NICRef io reads msg_prog linked

    ; the link/external-graphic/leader/box/score NIC keys (each class's
    ; hasNonInheritedC minus the display-NIC base, which rides the shared
    ; display_foc admission).
    function is_fo_nic_key(foc: int, sk: int) @ret_nonlocal true @deep true returns bool linked

    ; the ident-aware admission: is_fo_nic_key plus the ONE case that is not a
    ; syntactic key at all — a name registered as a char NIC by
    ; `declare-char-characteristic+property` is a non-inherited characteristic
    ; of the `character` flow object (CharacterFlowObj::hasNonInheritedC's
    ; charNICDefined tail).
    function is_fo_nic_ident(foc: int, sk: int, ident: ref[Identifier]?) @ret_param_2 true @deep true returns bool linked

    ; the SGML-transformation classes' hasNIC, by NAME (TransformFOTBuilder.cxx
    ; — an ExtensionFlowObj cannot extend the syntactic-key enum, so the
    ; reference compares strings: `name == "gi"`, `name == "attributes"`, …).
    ; Everything a class does NOT claim here is an ordinary inherited
    ; characteristic, exactly as for any other flow object; that is why these
    ; classes take the styled make path.
    function is_transform_nic_name(foc: int, name: StringC) @ret_nonlocal true @deep true returns bool linked

    function is_transform_foc(foc: int) @ret_nonlocal true @deep true returns bool linked

    function make_fo_nic(foc: int, host: ref[Page]) @direct true @deep true returns NICRef linked

    function copy_fo_nic(foc: int, p: NICRef, host: ref[Page]) @direct true @deep true returns NICRef linked

    ; Link/ExternalGraphic/Box/Leader/Score FlowObj::setNonInheritedC.
    procedure apply_fo_nic(foc: int, mutable nic_in: NICRef, sk: int, mutable val: ref[ELObj], ident: ref[Identifier]?, mutable loc: Location, mutable interp: ref[Interpreter], host: ref[Page]) @direct true @deep true @deep_beyond_8 true @deep_whole_40 true @deep_into_6_32 true returns NICRef io reads msg_prog linked

    ; MultiModeFlowObj::handleMultiModesMember — the four accepted shapes of a
    ; `multi-modes:` member: `#f` (the principal mode), a symbol (a named
    ; mode), `(#f "desc")` and `(sym "desc")`.
    procedure multi_modes_member(mutable r: ref[MultiModeNIC], mutable obj: ref[ELObj], host: ref[Page]) @ret_nonlocal true @deep true returns bool linked

    ; SosofoObj::isCharacter (ProcessContext.cxx:535) — only a `character`
    ; flow-object sosofo answers true; it is what `radical:` demands.
    function is_character_sosofo(val: ref[ELObj]?) @ret_nonlocal true @deep true returns bool linked

    ; convertRealC.
    procedure convert_real(mutable val_in: ref[ELObj], mutable out: ref[double], mutable interp: ref[Interpreter], loc: Location) @ret_nonlocal true @deep true returns bool io reads msg_prog linked

    ; convertCharC: a char object, or a string of exactly one character.
    procedure convert_char(host: ref[Page], mutable val: ref[ELObj], mutable out: ref[u32]) @ret_nonlocal true @deep true returns bool linked

    ; the math-class enum set (CharacterFlowObj::setNonInheritedC).
    procedure convert_math_class(mutable val: ref[ELObj], mutable out: ref[FotSym], host: ref[Page], mutable interp: ref[Interpreter], loc: Location) @ret_nonlocal true @deep true returns bool io reads msg_prog linked

    ; the math-font-posture enum set — #f is IN the set here (symbolFalse is
    ; the first allowed value), so `math-font-posture: #f` is valid.
    procedure convert_math_font_posture(mutable val: ref[ELObj], mutable out: ref[FotSym], host: ref[Page], mutable interp: ref[Interpreter], loc: Location) @ret_nonlocal true @deep true returns bool io reads msg_prog linked

    ; CharacterFlowObj::setNonInheritedC. Every branch marks its `specified`
    ; bit ONLY on a successful conversion (the reference's `if (convert…)`
    ; shape) — an invalid value leaves the field unspecified and the fot dump
    ; silent. `stretch-factor` is the one field with no bit: it renders
    ; whenever it differs from 1.0.
    ; ★A name that is a DECLARED char NIC (not a syntactic key) is accepted by
    ; hasNonInheritedC and then does NOTHING here — the reference's
    ; charNICDefined arm returns before the CANNOT_HAPPEN, so the value is
    ; swallowed without a diagnostic. Measured against the reference binary.
    procedure set_character_nic(mutable r: ref[CharacterNIC], sk: int, mutable val: ref[ELObj], ident: ref[Identifier]?, mutable loc: Location, mutable interp: ref[Interpreter], host: ref[Page]) @deep true @deep_this_4 true @deep_whole_4 true io reads msg_prog linked

    ; CharacterFlowObj::setImplicitChar — the heart of the class: once `char`
    ; is known, every characteristic still UNSPECIFIED is filled from that
    ; character's PROPERTIES (the thirteen built-ins of installCharProperties
    ; plus whatever a stylesheet declared). Answers false when the char does
    ; not convert or was already specified — the reference then leaves the NIC
    ; alone (and, on the `char:` branch, skips the specified bit as well).
    procedure set_implicit_char(mutable r: ref[CharacterNIC], mutable val: ref[ELObj], ident: ref[Identifier]?, mutable loc: Location, mutable interp: ref[Interpreter], host: ref[Page]) @ret_nonlocal true @deep true @deep_into_4_8 true returns bool io reads msg_prog linked

    procedure char_prop_bool(mutable name: Slice[char], ch: u32, mutable loc: Location, mutable interp: ref[Interpreter], ident: ref[Identifier]?, mutable out: ref[bool]) @deep true @deep_into_3_4 true io reads msg_prog linked

    procedure char_prop_int(mutable name: Slice[char], ch: u32, mutable loc: Location, mutable interp: ref[Interpreter], ident: ref[Identifier]?, mutable out: ref[int]) @deep true @deep_into_3_4 true io reads msg_prog linked

    function is_display_nic_key(sk: int) @ret_nonlocal true @deep true returns bool linked
}

; --- StyleStack (Style.cxx) --------------------------------------------------
; VarStyleObj's payload (the ELObj Style arm keeps its two-pointer shape: spec
; points here, use_chain stays in the arm). `display` is the captured closure
; vars of the style's VarInheritedC codes (null-terminated, like a closure
; display); `node` the current node at style creation (typed void: Style does
; not import Grove — only the VM glue dereferences it).
define VarStyleRec
(
    force_specs: ref[Array[ref[InheritedC]?]]?
    specs: ref[Array[ref[InheritedC]?]]?
    display: pointer[pointer[ELObj]]
    node: ref[GroveNode]?
)
{
    function make(host: ref[Page], force_specs: ref[Array[ref[InheritedC]?]]?, specs: ref[Array[ref[InheritedC]?]]?, display: pointer[pointer[ELObj]], node: ref[GroveNode]?) @ret_explicit_0 true @deep true returns ref[VarStyleRec] linked
}

; InheritedCInfo — one pushed spec for one characteristic index; `prev` chains
; to the spec shadowed at an outer level (restored by pop). `style` is the
; VarStyleRec the spec came from (display + node for VarInheritedC evaluation);
; `cached_value` the push-time evaluated value (valid only while none of
; `dependencies` — indices this value read via actual-*/inherited-* — changed).
define InheritedCInfo
(
    spec: ref[InheritedC]
    prev: ref[InheritedCInfo]?
    val_level: int
    spec_level: int
    style: ref[VarStyleRec]
    var cached_value: ref[ELObj]?
    dependencies: ref[Array[int]]
    ; the STYLE RULE that specified this characteristic at this level, null for
    ; a style pushed by `make` (which has no rule). Only ambiguousStyle reads
    ; it: two rules of EQUAL specificity setting the same characteristic at
    ; the same level is the one case the reference reports.
    rule: ref[Rule]?
)
{
    function make(host: ref[Page], spec: ref[InheritedC], style: ref[VarStyleRec], prev: ref[InheritedCInfo], val_level: int, spec_level: int) @ret_explicit_0 true @deep true returns ref[InheritedCInfo] linked

    function make_ruled(host: ref[Page], spec: ref[InheritedC], style: ref[VarStyleRec], prev: ref[InheritedCInfo]?, val_level: int, spec_level: int, rule: ref[Rule]?) @ret_explicit_0 true @deep true returns ref[InheritedCInfo] linked
}

define PopList (list: ref[Array[int]]?, depending_list: ref[Array[int]], prev: ref[PopList]?)
{
    function make(host: ref[Page], prev: ref[PopList]?) @ret_explicit_0 true @deep true returns ref[PopList] linked
}

define StyleStack (var info: ref[Array[ref[InheritedCInfo]?]], var level: int, var pop_list: ref[PopList]?, var host: ref[Page])
{
    function make(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[StyleStack] linked

    procedure push_start(mutable this: ref[StyleStack], scratch: ref[Page]) @deep true linked

    ; the C++ StyleStack copy (Connectable/Connection snapshots): a shallow
    ; copy of the info vector (the InheritedCInfo chains are immutable and
    ; shared), same level, SHARED pop-list pointer — balanced push/pop on the
    ; copy builds and unwinds its own PopLists on top and never mutates the
    ; shared tail (push_end_prologue only READS prev's depending list).
    function copy(this: ref[StyleStack], host: ref[Page]) @ret_args_3 true @deep true returns ref[StyleStack] linked

    ; grow the info vector to cover index `ind`.
    function info_at(this: ref[StyleStack], ind: int) @ret_param_0 true @deep true returns ref[InheritedCInfo]? linked

    procedure info_set(mutable this: ref[StyleStack], ind: int, v: ref[InheritedCInfo]?) @persists true @ret_nonlocal true @deep true @deep_this_4 true @deep_whole_4 true linked

    ; StyleStack::pushContinue — walk the style chain per VarStyleObj::
    ; appendIter: own force! specs, own specs, then the use chain (its force
    ; and normal specs at that point); first spec per characteristic wins
    ; within this level.
    procedure push_continue(mutable this: ref[StyleStack], style: ref[ELObj]?, scratch: ref[Page], rule: ref[Rule]?, mutable interp: ref[Interpreter]) @deep true @deep_this_8 true @deep_whole_8 true io reads msg_prog linked

    procedure push_spec_array(mutable this: ref[StyleStack], arr: ref[Array[ref[InheritedC]?]]?, rec: ref[VarStyleRec], scratch: ref[Page], rule: ref[Rule]?, mutable interp: ref[Interpreter]) @deep true @deep_this_20 true @deep_whole_20 true io reads msg_prog linked

    procedure push_spec(mutable this: ref[StyleStack], spec: ref[InheritedC], rec: ref[VarStyleRec], scratch: ref[Page], rule: ref[Rule]?, mutable interp: ref[Interpreter]) @deep true @deep_this_22 true @deep_whole_22 true io reads msg_prog linked

    ; StyleStack::pushEnd's prologue: a characteristic that DEPENDS (via
    ; actual-*) on another characteristic re-evaluates at this level when any
    ; of its dependencies was re-specified here — re-push it (keeping its
    ; original spec_level); otherwise it keeps depending at this level too.
    procedure push_end_prologue(mutable this: ref[StyleStack], scratch: ref[Page]) @deep true linked

    ; pushEnd's per-spec epilogue: a spec whose evaluation recorded
    ; dependencies keeps re-evaluating at deeper levels (see prologue).
    procedure note_depending(mutable this: ref[StyleStack], ind: int) @ret_nonlocal true @deep true linked

    procedure pop(mutable this: ref[StyleStack]) @deep true linked

    procedure push_empty(mutable this: ref[StyleStack]) @deep true linked

    procedure pop_empty(mutable this: ref[StyleStack]) @deep true linked

    function get_level(this: ref[StyleStack]) @ret_param_0 true @deep true returns int linked

    ; the specs pushed at the CURRENT level, in push order — the set* feed for
    ; pushEnd (the caller renders them through its sink).
    function current_specs(this: ref[StyleStack]) @ret_param_0 true @deep true returns ref[Array[int]]? linked

}
