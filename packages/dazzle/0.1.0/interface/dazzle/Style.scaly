; ScoreFlowObj::Type — type: is a char, a length(-spec), or one of the
; symbols before/through/after; absent = the plain-sequence fallback.
define SCORE_NONE: int 0
define SCORE_CHAR: int 1
define SCORE_LENGTH: int 2
