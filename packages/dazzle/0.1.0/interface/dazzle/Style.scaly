; FOTBuilder::CharacterNIC — the `character` flow object's non-inherited
; characteristics. `specified` is the bit set above: the fot dump prints a
; field only when its bit is set, and setImplicitChar fills every UNSET field
; from the character properties of `ch`. `glyph_id` is a GlyphId-arm ELObj
; (null = the reference's id-less FOTBuilder::GlyphId(), which prints "false");
; `script` is a public identifier (empty = the reference's null PublicId).
; ★The reference ctor initializes only valid/specifiedC/stretchFactor — every
; other field is left indeterminate and is read only under `valid` or under
; its own specified bit, so zeroing here is observationally identical.
define CharacterNIC
(
    var valid: bool
    var specified: int
    var ch: u32
    var glyph_id: ref[ELObj]?
    var break_before_priority: int
    var break_after_priority: int
    var math_class: FotSym
    var math_font_posture: FotSym
    var script: StringC
    var is_drop_after_line_break: bool
    var is_drop_unless_before_line_break: bool
    var is_punct: bool
    var is_input_whitespace: bool
    var is_input_tab: bool
    var is_record_end: bool
    var is_space: bool
    var stretch_factor: double
)
{
    function make(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[CharacterNIC] linked

    function copy(this: ref[CharacterNIC], host: ref[Page]) @ret_args_3 true @deep true returns ref[CharacterNIC] linked

    function is_specified(this: ref[CharacterNIC], bit: int) @ret_param_0 true @deep true returns bool linked

    procedure set_specified(mutable this: ref[CharacterNIC], bit: int) @deep true linked
}

