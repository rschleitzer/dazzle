    function make(host: ref[Page]) @ret_caller true @deep true returns ref[IncludedContainerAreaNIC] linked

    function copy(this: ref[IncludedContainerAreaNIC], host: ref[Page]) @deep true returns ref[IncludedContainerAreaNIC] linked
}

