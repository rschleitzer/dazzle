define SV_END_GRID: int 128
define SV_START_GRID_CELL: int 129
define SV_END_GRID_CELL: int 130

; the LAYOUT-COMPOSITE family — five plain brackets, three of which carry a
; NIC (the display half of `included-container-area` rides the dnic slot next
; to its own record, exactly like `box`).
define SV_START_EMBEDDED_TEXT: int 131
define SV_END_EMBEDDED_TEXT: int 132
define SV_START_ICA: int 133
define SV_END_ICA: int 134
define SV_START_SIDE_BY_SIDE: int 135
define SV_END_SIDE_BY_SIDE: int 136
define SV_START_SIDE_BY_SIDE_ITEM: int 137
define SV_END_SIDE_BY_SIDE_ITEM: int 138
define SV_START_ALIGNED_COLUMN: int 139
define SV_END_ALIGNED_COLUMN: int 140

; the ONLINE family. The multi-mode PORTS are already decomposed by
; ProcessContext before anything reaches a queue, so the two mode brackets
; carry only the mode record they print.
define SV_START_MARGINALIA: int 141
define SV_END_MARGINALIA: int 142
define SV_START_MULTI_MODE_SERIAL: int 143
define SV_END_MULTI_MODE_SERIAL: int 144
define SV_START_MULTI_MODE_MODE: int 145
define SV_END_MULTI_MODE_MODE: int 146

; the PAGE/COLUMN MODEL — two plain brackets; `page-sequence` carries nothing
; (all six of its characteristics are inherited ones, already queued as
; setIc calls), `column-set-sequence` a bare DisplayNIC.
define SV_START_PAGE_SEQUENCE: int 147
define SV_END_PAGE_SEQUENCE: int 148
define SV_START_COLUMN_SET_SEQUENCE: int 149
define SV_END_COLUMN_SET_SEQUENCE: int 150

; the TRANSFORM backend's own eleven calls (work package 23). They reach a
; queue for exactly the same reason every other call does: `-t sgml` runs the
; same port/connection machinery as the print backends, so an `(make element)`
; inside a `label:`ed child is captured and replayed like anything else.
define SV_START_ELEMENT: int 151
define SV_END_ELEMENT: int 152
define SV_EMPTY_ELEMENT: int 153
define SV_START_ENTITY: int 154
define SV_END_ENTITY: int 155
define SV_ENTITY_REF: int 156
define SV_PROCESSING_INSTRUCTION: int 157
define SV_DOCUMENT_TYPE: int 158
define SV_FORMATTING_INSTRUCTION: int 159
define SV_START_DIRECTORY: int 160
define SV_END_DIRECTORY: int 161

; the two multi-field payloads of those calls, parked in the `nic` slot.
define SaveElementRec (gi: StringC, atts: ref[Array[StringC]]?)
{
    procedure make(host: ref[Page], mutable gi: StringC, atts: ref[Array[StringC]]?) returns ref[SaveElementRec] linked
}

define SaveDocTypeRec (name: StringC, public_id: StringC, system_id: StringC)
{
    function make(host: ref[Page], name: StringC, public_id: StringC, system_id: StringC) returns ref[SaveDocTypeRec] linked
}

; one recorded call: `tag` selects which payload slots are live (union by
; convention — every slot is initialized; the replay walker in FotSink casts
; `nic` per tag).
define SaveCallRec
(
    next: ref[SaveCallRec]?
    tag: int
    ic: ref[InheritedC]?
    node: ref[GroveNode]?
    str: StringC
    data: Slice[u32]
    dnic: ref[DisplayNIC]?
    nic: NICRef
    flags: int
)
{
    function make(host: ref[Page], tag: int) returns ref[SaveCallRec] linked
}

define SaveFOTBuilder
(
    head: ref[SaveCallRec]?
    tail: ref[SaveCallRec]?
    node: ref[GroveNode]?
    mode_name: StringC
    host: ref[Page]
)
{
    function make(host: ref[Page]) returns ref[SaveFOTBuilder] linked

    ; the reference SaveFOTBuilder(currentNode, processingMode) form — emit
    ; wraps the replay in startNode/endNode (over-connection save-queue and
    ; principal-queue entries).
    function make_node(host: ref[Page], node: ref[GroveNode]?, mode_name: StringC) returns ref[SaveFOTBuilder] linked

    procedure append(mutable this: ref[SaveFOTBuilder], r: ref[SaveCallRec]) linked

    procedure record0(mutable this: ref[SaveFOTBuilder], tag: int) linked

    procedure record_set_ic(mutable this: ref[SaveFOTBuilder], mutable ic: ref[InheritedC]) linked

    procedure record_characters(mutable this: ref[SaveFOTBuilder], s: Slice[u32]) linked

    ; grove data is run-lived — keep the raw pointer (reference shape; the
    ; pointer feeds the fot sink's text-run regrouping).
    procedure record_chars_from_node(mutable this: ref[SaveFOTBuilder], node: ref[GroveNode]?, s: Slice[u32]) linked

    procedure record_start_node(mutable this: ref[SaveFOTBuilder], node: ref[GroveNode], mode_name: StringC) linked

    ; --- the transform backend's calls ---------------------------------------
    procedure record_element(mutable this: ref[SaveFOTBuilder], tag: int, mutable gi: StringC, atts: ref[Array[StringC]]?) linked

    procedure record_str(mutable this: ref[SaveFOTBuilder], tag: int, s: StringC) linked

    procedure record_document_type(mutable this: ref[SaveFOTBuilder], name: StringC, public_id: StringC, system_id: StringC) linked

    procedure pin_dnic(mutable this: ref[SaveFOTBuilder], mutable dnic: ref[DisplayNIC]) returns ref[DisplayNIC]? linked

    procedure record_dnic(mutable this: ref[SaveFOTBuilder], tag: int, mutable dnic: ref[DisplayNIC]?) linked

    procedure record_start_leader(mutable this: ref[SaveFOTBuilder], nic: ref[LeaderNIC]) linked

    procedure record_start_line_field(mutable this: ref[SaveFOTBuilder], nic: ref[LineFieldNIC]) linked

    procedure record_index_entry(mutable this: ref[SaveFOTBuilder], mutable nic: ref[IndexEntryNIC]) linked

    procedure record_start_page_float(mutable this: ref[SaveFOTBuilder], mutable nic: ref[PageFloatNIC]) linked

    procedure record_start_link(mutable this: ref[SaveFOTBuilder], nic: ref[LinkNIC]) linked

    procedure record_start_score(mutable this: ref[SaveFOTBuilder], mutable nic: ref[ScoreNIC]) linked

    procedure record_start_box(mutable this: ref[SaveFOTBuilder], nic: ref[BoxNIC], mutable dnic: ref[DisplayNIC]?) linked

    procedure record_rule(mutable this: ref[SaveFOTBuilder], mutable nic: ref[RuleNIC], mutable dnic: ref[DisplayNIC]?) linked

    procedure record_external_graphic(mutable this: ref[SaveFOTBuilder], mutable nic: ref[ExternalGraphicNIC], mutable dnic: ref[DisplayNIC]?) linked

    procedure record_node(mutable this: ref[SaveFOTBuilder], tag: int, node: ref[GroveNode]) linked

    procedure record_flags(mutable this: ref[SaveFOTBuilder], tag: int, flags: int) linked

    procedure record_start_table(mutable this: ref[SaveFOTBuilder], nic: ref[TableNIC], mutable dnic: ref[DisplayNIC]?) linked

    procedure record_table_column(mutable this: ref[SaveFOTBuilder], nic: ref[TableColumnNIC]) linked

    procedure record_start_table_cell(mutable this: ref[SaveFOTBuilder], nic: ref[TableCellNIC]) linked

    procedure record_character(mutable this: ref[SaveFOTBuilder], mutable nic: ref[CharacterNIC]) linked

    procedure record_anchor(mutable this: ref[SaveFOTBuilder], nic: ref[AnchorNIC]) linked

    procedure record_start_glyph_annotation(mutable this: ref[SaveFOTBuilder], nic: ref[GlyphAnnotationNIC]) linked

    ; the emphasizing-mark serial open. The `mark:` sosofo has already been
    ; replayed into its own bracket by the time this is recorded, so only the
    ; two priorities need to survive.
    procedure record_start_em_serial(mutable this: ref[SaveFOTBuilder], nic: ref[EmphasizingMarkNIC]) linked

    ; the three math calls that carry a payload (everything else in the family
    ; is a bare bracket recorded with record0).
    procedure record_radical_radical(mutable this: ref[SaveFOTBuilder], mutable nic: ref[CharacterNIC]) linked

    procedure record_start_grid(mutable this: ref[SaveFOTBuilder], nic: ref[GridNIC]) linked

    procedure record_start_grid_cell(mutable this: ref[SaveFOTBuilder], nic: ref[GridCellNIC]) linked

    ; the two NIC-bearing layout-composite opens (`side-by-side` and
    ; `aligned-column` carry a bare DisplayNIC and go through record_dnic).
    procedure record_start_embedded_text(mutable this: ref[SaveFOTBuilder], mutable nic: ref[EmbeddedTextNIC]) linked

    procedure record_start_ica(mutable this: ref[SaveFOTBuilder], mutable nic: ref[IncludedContainerAreaNIC], mutable dnic: ref[DisplayNIC]?) linked

    ; the two multi-mode brackets that carry a mode record (a null principal
    ; mode is the no-principal-port case and stays null).
    procedure record_multi_mode(mutable this: ref[SaveFOTBuilder], tag: int, mode: ref[MultiModeRec]?) linked
}
