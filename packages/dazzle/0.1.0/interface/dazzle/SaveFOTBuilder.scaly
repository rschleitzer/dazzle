; the MATH family. Every port bracket of the six serial classes is a plain
; no-arg call — the ports themselves were already decomposed by ProcessContext
; before anything reaches a queue, so a recorded math call never carries a
; nested SaveFOTBuilder (unlike the reference's StartFractionCall & co., which
; record the ports and re-emit them at replay).
define SV_START_MATH_SEQUENCE: int 72
define SV_END_MATH_SEQUENCE: int 73
define SV_START_FRACTION_SERIAL: int 74
define SV_END_FRACTION_SERIAL: int 75
