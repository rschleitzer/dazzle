define SV_END_UNMATH: int 82
define SV_START_SUPERSCRIPT: int 83
define SV_END_SUPERSCRIPT: int 84
define SV_START_SUBSCRIPT: int 85
define SV_END_SUBSCRIPT: int 86
define SV_START_SCRIPT_SERIAL: int 87
define SV_END_SCRIPT_SERIAL: int 88
define SV_START_SCRIPT_PRE_SUP: int 89
define SV_END_SCRIPT_PRE_SUP: int 90
define SV_START_SCRIPT_PRE_SUB: int 91
define SV_END_SCRIPT_PRE_SUB: int 92
