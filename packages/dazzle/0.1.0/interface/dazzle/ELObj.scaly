    function get_style(this: FlowObj) @ret_param_0 true @deep true returns ref[ELObj]? linked

    procedure set_style(mutable this: ref[FlowObj], s: ref[ELObj]) @deep true @deep_this_2 true @deep_whole_2 true linked

    function get_dnic(this: FlowObj) @ret_param_0 true @deep true returns ref[DisplayNIC]? linked

    procedure set_dnic(mutable this: ref[FlowObj], n: ref[DisplayNIC]?) @deep true @deep_this_2 true @deep_whole_2 true linked


