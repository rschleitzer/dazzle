    function vector_length(this: ref[ELObj]) @ret_param_0 true @deep true returns size_t linked









    ; VectorObj::operator[] read — caller must bounds-check first.
    function vector_elem(this: ref[ELObj], i: size_t) @ret_param_0 true @deep true returns ref[ELObj]? linked









    ; VectorObj::operator[] write (vector-set!).
    procedure vector_set_elem(mutable this: ref[ELObj], i: size_t, val: ref[ELObj]?) @deep true linked








    ; KeywordObj::name() — the interned Identifier's name.
    function keyword_name(this: ref[ELObj]) @page true @direct true @deep true returns StringC linked







    ; #t and #f are the only booleans.
    function is_boolean_p(this: ref[ELObj]) @ret_nonlocal true @deep true returns bool linked











    ; NilObj: true; PairObj: walks the cdr chain; everything else: false.
    function is_list(this: ref[ELObj]) @ret_nonlocal true @deep true returns bool linked
























    ; Everything is true except #f.
    function is_true(this: ref[ELObj]) @ret_nonlocal true @deep true returns bool linked









    function is_false(this: ref[ELObj]) @ret_nonlocal true @deep true returns bool linked









    ; --- accessors (NULL-sentinel, the opensp lookup convention) -----------
    function get_car(this: ref[ELObj]) @ret_param_0 true @deep true returns ref[ELObj]? linked









    function get_cdr(this: ref[ELObj]) @ret_param_0 true @deep true returns ref[ELObj]? linked









    ; Arm rebuild in place — the union address (eq?-identity) is unchanged.
    procedure set_car(mutable this: ref[ELObj], v: ref[ELObj]) @deep true @deep_this_2 true @deep_whole_2 true linked






    procedure set_cdr(mutable this: ref[ELObj], v: ref[ELObj]?) @deep true @deep_this_2 true @deep_whole_2 true linked






    ; charValue: the codepoint, or -1 (no codepoint is negative).
    function char_value(this: ref[ELObj]) @ret_param_0 true @deep true returns int linked









    ; stringData: chars and strings have it (a char is a 1-char string).
    function has_string_data(this: ref[ELObj]) @ret_nonlocal true @deep true returns bool linked













    ; The string data as a StringC (Chr allocates its 1-char buffer on host;
    ; Str returns a shallow view of its page-resident buffer).
    procedure string_data(mutable this: ref[ELObj], host: ref[Page]) @page true @direct true @deep true @deep_pageof_1 true returns StringC linked












































    ; stringData total WITHOUT flattening a rope (string-append/string-length
    ; fast path). Negative when the object carries no string data.
    function string_size(this: ref[ELObj]) @ret_param_0 true @deep true returns i64 linked













    ; flatten walk: write this object's string data at buf+off, return the
    ; advanced offset.
    procedure strcat_fill(this: ref[ELObj], mutable buf: Slice[u32], off: size_t) @ret_nonlocal true @deep true returns size_t linked






































    ; collapse a rope in place (consumers that pattern-match the Str arm
    ; directly — printer, is_equal — normalize first).
    procedure normalize_string(mutable this: ref[ELObj]) @deep true linked















