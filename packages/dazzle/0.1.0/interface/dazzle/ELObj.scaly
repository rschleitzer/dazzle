    procedure set_nic_code(mutable this: ref[FlowObj], c: ref[Insn]?) @deep true @deep_this_2 true @deep_whole_2 true linked


    function get_foc(this: FlowObj) @ret_param_0 true @deep true returns int linked

    function get_gi(this: FlowObj) @page true @direct true @ret_param_0 true @deep true returns StringC linked

    function get_atts(this: FlowObj) @ret_param_0 true @deep true returns ref[Array[StringC]]? linked

    function get_system_id(this: FlowObj) @page true @direct true @ret_param_0 true @deep true returns StringC linked

    function get_public_id(this: FlowObj) @page true @direct true @ret_param_0 true @deep true returns StringC linked

    function get_name(this: FlowObj) @page true @direct true @ret_param_0 true @deep true returns StringC linked

    function get_data(this: FlowObj) @page true @direct true @ret_param_0 true @deep true returns StringC linked

    function get_path(this: FlowObj) @page true @direct true @ret_param_0 true @deep true returns StringC linked


    ; setNonInheritedC seam: map a characteristic key name to the right slot.
    ; The value StringC is copied onto `host` (the run region) so it outlives the
    ; frame that built the make (the sosofo is walked later by ProcessContext).
    procedure set_char(mutable this: ref[FlowObj], host: ref[Page], key: StringC, value: StringC) @deep true linked
















    procedure set_atts(mutable this: ref[FlowObj], atts: ref[Array[StringC]]) @deep true @deep_this_2 true @deep_whole_2 true linked


    ; the attached style (a Style-arm ELObj built by the make insn) and the
