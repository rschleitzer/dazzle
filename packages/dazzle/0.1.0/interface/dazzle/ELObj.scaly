; --- transform flow-object classes -----------------------------------------
; The extension flow objects the transform backend registers (jade/Transform-
; FOTBuilder.cxx; dazzle-net TransformFOTBuilder.cs mirror). A declare-flow-
; object-class binds a stylesheet identifier's VALUE to a FlowObjBox carrying
; one of these kinds (keyed on its public id — see Interpreter); `make FOC …`
; reads that value to build a SOSO_FLOWOBJ sosofo. (Binding the VALUE, not a new
; Identifier field, is both DSSSL-correct and avoids growing the Identifier
; record — a heap-allocation size change there shifts the run region across a
; page boundary and corrupts it; port history.) Compound kinds (element/entity/
; directory/sequence) carry content; atomic kinds do not. FOC_SEQUENCE is the
; built-in fallback (also the SequenceFlowObj used for an unknown class).
define FOC_NONE: int 0
define FOC_SEQUENCE: int 1
define FOC_ELEMENT: int 2
define FOC_EMPTY_ELEMENT: int 3
define FOC_ENTITY: int 4
define FOC_ENTITY_REF: int 5
define FOC_PROCESSING_INSTRUCTION: int 6
define FOC_DOCUMENT_TYPE: int 7
define FOC_FORMATTING_INSTRUCTION: int 8
define FOC_DIRECTORY: int 9
; standard (print) flow-object classes — installed unconditionally like the
; reference installFlowObjs; rendered by the fot backend, content-transparent
; under the transform backend (whose reference virtuals are no-ops). Inc 8.
define FOC_PARAGRAPH: int 10
define FOC_PARAGRAPH_BREAK: int 11
define FOC_DISPLAY_GROUP: int 12
define FOC_LINE_FIELD: int 13
define FOC_SIMPLE_PAGE_SEQUENCE: int 14
; the table family (FlowObj.cxx Table*FlowObj) — FOC_TABLE_BORDER is the
; style-carrier sosofo (processes to nothing; tableBorderStyle = its style).
define FOC_TABLE: int 15
define FOC_TABLE_PART: int 16
define FOC_TABLE_COLUMN: int 17
define FOC_TABLE_ROW: int 18
define FOC_TABLE_CELL: int 19
define FOC_TABLE_BORDER: int 20
; RuleFlowObj — an atomic display/inline flow object (orientation decides);
; also the fraction-bar characteristic's value class (RuleC).
define FOC_RULE: int 21
; UnknownFlowObj — what declare-flow-object-class binds when the active
; backend does not provide the public id (e.g. the transform extensions under
; -t fot): swallows every keyword, processes content, emits nothing.
define FOC_LINK: int 22
define FOC_EXTERNAL_GRAPHIC: int 23
define FOC_LEADER: int 24
define FOC_BOX: int 25
define FOC_SCORE: int 26
; the TeX backend's extension flow-object classes (jade.cxx makeTeXFOTBuilder
; extension table: Sebastian Rahtz's page-float / page-footnote). Only bound
; under -t tex — every other backend binds them as FOC_UNKNOWN. They sit
; INSIDE the styled range (their keywords classify as ICs plus page-float's
; placement NIC).
define FOC_PAGE_FLOAT: int 28
define FOC_PAGE_FOOTNOTE: int 29
; ScrollFlowObj — the online scroll (one HTML document per scroll in the html
; backend, a plain `<scroll>` element in the fot dump). Installed
; unconditionally like the reference installFlowObjs.
define FOC_SCROLL: int 27

; the MIF backend's own extension class (jade.cxx passes it in the
; makeMifFOTBuilder extension table) — an ATOMIC, NIC-bearing flow object.
define FOC_INDEX_ENTRY: int 30
; the INLINE/MARK family (installFlowObjs; FlowObj.cxx CharacterFlowObj /
; AlignmentPointFlowObj / SidelineFlowObj plus style/Anchor.cxx,
; GlyphAnnotation.cxx, EmphasizingMark.cxx). `character` and `alignment-point`
; are ATOMIC; `anchor` is compound in the reference but DISCARDS its content
; (AnchorFlowObj::processInner never calls the base) — measured. They extend
; the styled range (Convert.make_fo_nic answers null for the NIC-less classes,
; so the shared NIC-copy range covers them harmlessly).
define FOC_CHARACTER: int 31
define FOC_ALIGNMENT_POINT: int 32
define FOC_SIDELINE: int 33
define FOC_ANCHOR: int 34
define FOC_GLYPH_ANNOTATION: int 35
define FOC_EMPHASIZING_MARK: int 36
; the MATH family (installFlowObjs' `// math` block, FlowObj.cxx:1708-2115).
; All twelve are CompoundFlowObjs. Six of them have non-principal PORTS and
; therefore a SerialFOTBuilder decomposition: `fraction` (numerator/
; denominator), `script` (six), `mark` (over/under), `fence` (open/close),
; `radical` (degree) and `math-operator` (operator/lower-limit/upper-limit).
; ★`fraction` is the only one that pushes its ports with connectable-level 0 —
; it has NO principal port, so its own content is discarded; the other five
; pass 1 and keep theirs. Only three carry characteristics: `radical`
; (a sosofo), `grid` and `grid-cell` (two positive integers each). The styled
; range's upper bound is FOC_GRID_CELL until the layout-composite block below.
define FOC_MATH_SEQUENCE: int 37
define FOC_FRACTION: int 38
define FOC_UNMATH: int 39
define FOC_SUPERSCRIPT: int 40
define FOC_SUBSCRIPT: int 41
define FOC_SCRIPT: int 42
define FOC_MARK: int 43
define FOC_FENCE: int 44
define FOC_RADICAL: int 45
define FOC_MATH_OPERATOR: int 46
define FOC_GRID: int 47
define FOC_GRID_CELL: int 48
; the LAYOUT-COMPOSITE family (installFlowObjs: EmbeddedTextFlowObj,
; IncludedContainerAreaFlowObj, SideBySideFlowObj, SideBySideItemFlowObj,
; AlignedColumnFlowObj — the five Universitat-Politecnica classes of
; style/{EmbeddedText,IncludedContainerArea,SideBySide,SideBySideItem,
; AlignedColumn}.cxx). All five are plain CompoundFlowObjs with NO ports:
; each is one start*/end* bracket around its content. `side-by-side` and
; `aligned-column` carry a bare DisplayNIC, `side-by-side-item` carries
; nothing at all, `embedded-text` one symbol, and `included-container-area`
; a NIC that DERIVES from both DisplayNIC and InlineNIC and adds nine fields
; of its own. The styled range's upper bound is FOC_ALIGNED_COLUMN until the
; online block below.
define FOC_EMBEDDED_TEXT: int 49
define FOC_INCLUDED_CONTAINER_AREA: int 50
define FOC_SIDE_BY_SIDE: int 51
define FOC_SIDE_BY_SIDE_ITEM: int 52
define FOC_ALIGNED_COLUMN: int 53
; the ONLINE family (installFlowObjs' `// online` block, next to link and
; scroll): MarginaliaFlowObj is a bare compound bracket; MultiModeFlowObj is
; the only class in the whole port whose PORTS are decided at run time — its
; `multi-modes:` characteristic names them (FlowObj.cxx:952-1060). The styled
; range's upper bound is FOC_MULTI_MODE until the page/column block below.
define FOC_MARGINALIA: int 54
define FOC_MULTI_MODE: int 55
; the PAGE/COLUMN MODEL (installFlowObjs, FlowObj.cxx:2996-2998, right after
; simple-page-sequence): PageSequenceFlowObj (style/PageSequence.cxx) and
; ColumnSetSequenceFlowObj (style/ColumnSetSequence.cxx). The last two classes
; of the reference's registry. Both are plain CompoundFlowObjs with NO ports —
; one start*/end* bracket around the content, decomposed by SerialFOTBuilder
; into the *Serial pair that only the fot backend overrides.
; ★`page-sequence` has NO hasNonInheritedC at all: every one of its six
; characteristics (`page-category` `force-last-page` `force-first-page`
; `first-page-type` `justify-spread?` `binding-edge`) is an INHERITED one, so
; they arrive through the ics buffer and any other keyword is unknown.
; `column-set-sequence` carries a bare DisplayNIC, exactly like
; `aligned-column`. The styled range's upper bound is
; FOC_COLUMN_SET_SEQUENCE from here on.
define FOC_PAGE_SEQUENCE: int 56
define FOC_COLUMN_SET_SEQUENCE: int 57
define FOC_UNKNOWN: int 58
; MacroFlowObj (style/MacroFlowObj.cxx) — the class a
; `declare-flow-object-macro` binds. Not a backend class at all: its `make`
; binds the declared characteristics (plus, with `#!contents`, the content
; sosofo) as frame variables and evaluates the declaration's BODY, whose
; sosofo is then processed inside a startSequence/endSequence bracket. It sits
; OUTSIDE the styled FOC_PARAGRAPH..FOC_COLUMN_SET_SEQUENCE range but is styled
; all the same (the reference runs StyleExpression::compile for every make), so
; every dispatch that tests that range names it explicitly.
define FOC_MACRO: int 59

; Identifier — a top-level name cell (ELObj.cs class Identifier : Named). Inc-1
; carried the bare name; Inc 3 adds the definition/lazy-eval machinery: a value
; or an uncompiled Expression that computeValue compiles-and-runs on demand,
; plus the syntactic-key tag. The inheritedC / flowObj slots are later
; increments and are not carried yet.
define Identifier
@resident true (
    name: StringC
    var value: ref[ELObj]?
    var expr: ref[Expression]?
    var insn: ref[Insn]?
    var def_part: u32
    var def_loc: Location
    var is_defined: bool
    var evaluated_flag: bool
    var being_computed: bool
    var syn_key: int
    var inherited_c: ref[InheritedC]?
    var builtin: ref[Identifier]?
    ; Identifier::charNIC_ / inheritedCPart_ / inheritedCLoc_ — the char-NIC
    ; registration a `declare-char-characteristic+property` leaves behind. The
    ; reference REUSES the inherited-characteristic part/loc pair for it (and
    ; setCharNIC nulls inheritedC_ at the same time); this port keeps the
    ; inherited part/loc inside the InheritedC object, so the char NIC gets its
    ; own two slots. Equivalent: the only writer of either pair is a
    ; declaration, and each declaration's duplicate gate refuses the other's
    ; name before it can overwrite.
    var char_nic: bool
    var char_nic_part: u32
    var char_nic_loc: Location
)
{
    function make(host: ref[Page], name: StringC) @ret_explicit_0 true @deep true returns ref[Identifier] linked





    function get_name(this: Identifier) @page true @direct true @ret_param_0 true @deep true returns StringC linked


    ; the eagerly-set value (set_definition), without triggering lazy compute —
    ; parse_make reads a flow-object-class binding here at parse time.
    function get_value_raw(this: Identifier) @ret_param_0 true @deep true returns ref[ELObj]? linked


    procedure set_syntactic_key(mutable this: ref[Identifier], key: int) @deep true linked


    ; syntacticKey(out key) returns synKey != notKey; callers read syn_key().
    function syntactic_key(this: Identifier) @ret_param_0 true @deep true returns int linked


    ; Identifier::inheritedC — the inherited-characteristic prototype this
    ; name denotes (null = not a characteristic).
    function get_inherited_c(this: Identifier) @ret_param_0 true @deep true returns ref[InheritedC]? linked


    procedure set_inherited_c(mutable this: ref[Identifier], ic: ref[InheritedC]?) @deep true @deep_this_2 true @deep_whole_2 true linked


    ; Identifier::setCharNIC(part, loc) — what installExtensionCharNIC writes.
    ; ★It also CLEARS the inherited characteristic: after this the name is a
    ; non-inherited characteristic of `character` and nothing else, so a later
    ; declare-flow-object-class (which gates on inheritedCDefined) sees a free
    ; name while a later declare-characteristic (which gates on charNICDefined
    ; FIRST) does not.
    procedure set_char_nic(mutable this: ref[Identifier], part: u32, loc: Location) @deep true @deep_this_4 true @deep_whole_4 true linked







    ; Identifier::charNICDefined(part, loc).
    procedure char_nic_defined(this: Identifier, mutable part: ref[u32], mutable loc: ref[Location]) @ret_nonlocal true @deep true returns bool linked








    function is_syntactic_key(this: Identifier) @ret_param_0 true @deep true returns bool linked


    function is_def(this: Identifier) @ret_param_0 true @deep true returns bool linked


    function get_def_part(this: Identifier) @ret_param_0 true @deep true returns u32 linked


    function get_def_loc(this: Identifier) @page true @direct true @ret_param_0 true @deep true returns Location linked


    function evaluated(this: Identifier) @ret_param_0 true @deep true returns bool linked


    ; Identifier::maybeSaveBuiltin (Interpreter.cxx:1742). The FIRST
    ; redefinition of a name whose current definition came from the builtins
    ; part (def_part = -1) snapshots that definition into a shadow Identifier.
    ; Its ONLY consumer is compute_builtin_value, i.e. the operator of a query
    ; form: `(there-exists? …)` must reach the BUILTIN node-list-some? even in
    ; a stylesheet that has redefined the name — while a direct call to that
    ; name reaches the redefinition. No recursion: the shadow is fresh, so its
    ; own def_part is 0 and its setter returns at the first guard.
    procedure maybe_save_builtin(mutable this: ref[Identifier]) @deep true linked














    ; computeBuiltinValue(force). The reference flips a static preferBuiltin_
    ; around computeValue; with the shadow held on the Identifier the flag
    ; reduces to this one branch. A name never redefined has no shadow and
    ; answers with its own value.
    procedure compute_builtin_value(mutable this: ref[Identifier], force: bool, mutable interp: ref[Interpreter]) @ret_param_0 true @deep true @deep_this_4 true @deep_whole_4 true returns ref[ELObj]? io reads msg_prog linked






    ; setDefinition(part, loc, value): a ready value (primitive/flow-obj install).
    procedure set_definition(mutable this: ref[Identifier], part: u32, loc: Location, value: ref[ELObj]?) @deep true @deep_this_12 true @deep_whole_12 true linked









    ; setExpression(expr, part, loc): a top-level (define ...) — compiled
    ; lazily. Clears a ready value (reference setDefinition's `value_ = 0`) —
    ; a user define must displace an installed builtin's value.
    procedure set_expression(mutable this: ref[Identifier], expr: ref[Expression]?, part: u32, loc: Location) @deep true @deep_this_10 true @deep_whole_10 true linked










    function get_expression(this: Identifier) @ret_param_0 true @deep true returns ref[Expression]? linked


    ; computeValue(force): value if known; else compile the expression and, if
    ; forced or compile-time-evaluable, run it on a fresh VM. beingComputed
    ; guards a self-referential definition loop.
    procedure compute_value(mutable this: ref[Identifier], force: bool, mutable interp: ref[Interpreter]) @ret_param_0 true @deep true @deep_this_4 true @deep_whole_4 true returns ref[ELObj]? io reads msg_prog linked










































}

