; --- item tags ---------------------------------------------------------------
define HTM_ADDRESSABLE: int 0
define HTM_MARKUP: int 1
define HTM_PCDATA: int 2
define HTM_CONTAINER: int 3
define HTM_REF: int 4
define HTM_BLOCK: int 5
define HTM_DOCUMENT: int 6

; ParaProps::align
define HTM_ALIGN_LEFT: int 0
define HTM_ALIGN_CENTER: int 1
define HTM_ALIGN_RIGHT: int 2
define HTM_ALIGN_JUSTIFY: int 3

; CharProps::fontStyle
define HTM_STYLE_NORMAL: int 0
define HTM_STYLE_ITALIC: int 1
define HTM_STYLE_OBLIQUE: int 2

; --- a CSS class prefix (one per GI) -----------------------------------------
define HtmlClassPrefix (prefix: StringC, n_char_classes: int, n_para_classes: int)
{
    function make(host: ref[Page], prefix: StringC) returns ref[HtmlClassPrefix] linked
}

; --- a style class (one GI within one style) — an IList node ------------------
define HtmlStyleClass (gi: StringC, prefix: ref[HtmlClassPrefix], prefix_index: int, next: ref[HtmlStyleClass]?)
{
    function make(host: ref[Page], gi: StringC, prefix: ref[HtmlClassPrefix]) returns ref[HtmlStyleClass] linked
}

; --- one distinct style (character or paragraph) ------------------------------
; is_para picks which property half is live; `classes` is the reference IList
; (insert-at-head, iterated head-first).
define HtmlStyle
(
    is_para: bool
    ; CharProps
    font_weight: int
    font_style: int
    color: int
    font_size: int
    font_family: StringC
    ; ParaProps
    left_margin: int
    right_margin: int
    line_height: int
    text_indent: int
    align: int
    top_margin: int
    classes: ref[HtmlStyleClass]?
)
{
    function make(host: ref[Page], is_para: bool) returns ref[HtmlStyle] linked
}

; --- FlowObjectInfo: the inherited-characteristic snapshot -------------------
define HtmlFoInfo
(
    ; CharProps
    font_weight: int
    font_style: int
    color: int
    font_size: int
    font_family: StringC
    ; InheritParaProps
    left_margin: int
    right_margin: int
    line_height: int
    text_indent: int
    align: int
    ; FlowObjectInfo proper
    doc_index: int
    has_scroll_title: bool
    scroll_title: StringC
    parent_left_margin: int
    parent_right_margin: int
)
{
    ; CharProps() + InheritParaProps() + FlowObjectInfo() ctor defaults
    init() linked
}

; --- one item of the buffered tree -------------------------------------------
define HtmlItem
(
    tag: int
    next: ref[HtmlItem]?
    ; container/ref/block/document content (head of the child IList)
    content: ref[HtmlItem]?
    ; block / pcdata style class
    style_class: ref[HtmlStyleClass]?
    ; pcdata payload (immediate copies, node-backed keeps the grove view)
    data: Slice[u32]
    ; markup payload
    str: StringC
    ; ref target (an addressable item, or null)
    aref: ref[HtmlItem]?
    ; document
    doc_index: int
    has_title: bool
    title: StringC
    ; addressable
    grove_index: int
    ; -1 = the whole document
    element_index: int
    ; -1 = not defined
    a_doc_index: int
    referenced: bool
)
{
    function make(host: ref[Page], tag: int) returns ref[HtmlItem] linked

    function defined(this: ref[HtmlItem]) returns bool linked
}

; libc + shim externs (prototypes type-match the other roots').
procedure scaly_eputs(s: pointer[const_char]) extern
procedure scaly_eputnl() extern
function strerror(code: i32) returns pointer[const_char] extern
function scaly_eio_errno() returns i32 extern

; argv0 for the HtmlMessages prefix (`<argv0>:E: …`), like tfb_prog.
shared html_prog: pointer[const_char] linked

define HtmlFOTBuilder
(
    ; the item tree: `root` is the reference's root_ Container, `dest_` the
    ; current insertion owner (its content list), with the DestInfo stack.
    root: ref[HtmlItem]
    dest: ref[HtmlItem]
    dest_stack: ref[Array[ref[HtmlItem]?]]
    dest_depth: int
    ; the flow-object info stack + NextFlowObject
    fo_stack: ref[Array[ref[HtmlFoInfo]?]]
    fo_depth: int
    next_fo: HtmlFoInfo
    ; the two style tables (open addressing, hash = 17, decrementing probe)
    char_slots: ref[Array[ref[HtmlStyle]?]]
    char_used: int
    char_limit: int
    para_slots: ref[Array[ref[HtmlStyle]?]]
    para_used: int
    para_limit: int
    ; the GI-keyed prefix table (OpenSP Hash = Torek)
    prefix_slots: ref[Array[ref[HtmlClassPrefix]?]]
    prefix_used: int
    prefix_limit: int
    ; per-grove element anchors: elements_[g][e]
    elements: ref[Array[ref[Array[ref[HtmlItem]?]]?]]
    ; pendingAddr_ — a stack of (grove, element) pair vectors
    pending: ref[Array[ref[Array[int]]?]]?
    pending_depth: int
    ; giStack_
    gi_stack: ref[Array[StringC]]
    gi_depth: int
    n_documents: int
    top_margin: int
    space_after_stack: ref[Array[int]]
    space_after_depth: int
    ; the output file name (the reference's outputFilename_, already
    ; defaulted by the CLI) + the stylesheet name once written
    out_name: String
    css_name: String
    have_css: bool
    ; output state (OutputState) — one live emission at a time
    out_doc_index: int
    cur_aref: ref[HtmlItem]?
    spec_aref: ref[HtmlItem]?
    cur_char_class: ref[HtmlStyleClass]?
    ; the byte sink of the current emission (null = discard)
    os: ref[Array[u32]]?
    host: ref[Page]
)
{
    function make(host: ref[Page], out_name: String) returns ref[HtmlFOTBuilder] linked

    ; --- messages ------------------------------------------------------------
    procedure msg_cannot_open(this: ref[HtmlFOTBuilder], name: String, err: i32) io reads html_prog linked

    procedure set_prog_name(prog: pointer[const_char]) mutable html_prog reads html_prog linked

    ; --- the flow-object bracket (FOTBuilder start/end/atomic) ---------------
    procedure copy_fo(mutable dst: ref[HtmlFoInfo], src: ref[HtmlFoInfo]) linked

    procedure fo_push(mutable this: ref[HtmlFOTBuilder]) linked

    procedure fo_start(mutable this: ref[HtmlFOTBuilder]) linked

    procedure fo_end(mutable this: ref[HtmlFOTBuilder]) linked

    ; atomic(): nextFlowObject_ = flowObjectStack_.back()
    procedure fo_atomic(mutable this: ref[HtmlFOTBuilder]) linked

    ; --- gi stack -------------------------------------------------------------
    procedure gi_push(mutable this: ref[HtmlFOTBuilder], gi: StringC) linked

    function gi_top(this: ref[HtmlFOTBuilder]) @page true @direct true returns StringC linked

    function gi_at(this: ref[HtmlFOTBuilder], i: int) @page true @direct true returns StringC linked

    ; --- item list handling (IList insert-at-head + reverse) -----------------
    procedure insert_item(mutable this: ref[HtmlFOTBuilder], mutable it: ref[HtmlItem]) linked

    procedure reverse_content(mutable owner: ref[HtmlItem]) linked

    procedure dest_push(mutable this: ref[HtmlFOTBuilder], owner: ref[HtmlItem]) linked

    procedure dest_pop(mutable this: ref[HtmlFOTBuilder]) linked

    ; --- style tables ---------------------------------------------------------
    ; CharProps/ParaProps equality (the reference operator==)
    function char_props_equal(a: ref[HtmlStyle], b: ref[HtmlFoInfo]) returns bool linked

    function para_props_equal(a: ref[HtmlStyle], b: ref[HtmlFoInfo], top_margin: int) returns bool linked

    ; hash() is the constant 17 for both prop classes
    function props_start_index(size: size_t) returns size_t linked

    function torek_hash(s: StringC) returns size_t linked

    ; grow an empty table to 8 null slots
    procedure table_init(this: ref[HtmlFOTBuilder], mutable slots: ref[Array[ref[HtmlStyle]?]]) linked

    ; PointerTable::insert for the character-style table; returns the entry
    ; already present, else null after inserting `s`.
    function char_table_lookup(this: ref[HtmlFOTBuilder]) returns ref[HtmlStyle]? linked

    procedure char_table_insert(mutable this: ref[HtmlFOTBuilder], s: ref[HtmlStyle]) @persists true linked

    function para_table_lookup(this: ref[HtmlFOTBuilder], top_margin: int) returns ref[HtmlStyle]? linked

    procedure para_table_insert(mutable this: ref[HtmlFOTBuilder], s: ref[HtmlStyle]) @persists true linked

    ; the GI-keyed prefix table
    procedure make_class_prefix(mutable this: ref[HtmlFOTBuilder], gi: StringC) @page true @direct true returns ref[HtmlClassPrefix]? linked

    ; makeCharStyleClass / makeParaStyleClass
    procedure make_char_style_class(mutable this: ref[HtmlFOTBuilder]) returns ref[HtmlStyleClass] linked

    procedure make_para_style_class(mutable this: ref[HtmlFOTBuilder]) returns ref[HtmlStyleClass] linked

    ; --- characteristics (the eleven the reference overrides) -----------------
    procedure set_ic(mutable this: ref[HtmlFOTBuilder], ic: ref[InheritedC]) linked

    ; --- pending addresses / element anchors ----------------------------------
    procedure element_address(mutable this: ref[HtmlFOTBuilder], g: int, e: int) returns ref[HtmlItem] linked

    function pending_top(this: ref[HtmlFOTBuilder]) returns ref[Array[int]]? linked

    procedure pending_push(mutable this: ref[HtmlFOTBuilder]) linked

    procedure insert_addr(mutable this: ref[HtmlFOTBuilder], g: int, e: int) linked

    procedure flush_pending_addresses(mutable this: ref[HtmlFOTBuilder]) linked

    ; --- characters -----------------------------------------------------------
    procedure characters(mutable this: ref[HtmlFOTBuilder], s: Slice[u32]) linked

    ; NodePcdata keeps the RAW grove pointer (reference shape)
    procedure characters_from_node(mutable this: ref[HtmlFOTBuilder], node: ref[GroveNode]?, s: Slice[u32]) linked

    procedure formatting_instruction(mutable this: ref[HtmlFOTBuilder], instr: StringC) linked

    ; --- node bracket ---------------------------------------------------------
    procedure start_node(mutable this: ref[HtmlFOTBuilder], node: ref[GroveNode]?, mode_name: StringC) linked

    procedure end_node(mutable this: ref[HtmlFOTBuilder]) linked

    ; --- display bracket (only paragraphs reach it, like the reference) -------
    procedure start_display(mutable this: ref[HtmlFOTBuilder], nic: ref[DisplayNIC]) linked

    procedure end_display(mutable this: ref[HtmlFOTBuilder]) linked

    ; --- paragraph ------------------------------------------------------------
    procedure start_paragraph(mutable this: ref[HtmlFOTBuilder], nic: ref[DisplayNIC]?) linked

    procedure end_paragraph(mutable this: ref[HtmlFOTBuilder]) linked

    ; --- link -----------------------------------------------------------------
    procedure start_link(mutable this: ref[HtmlFOTBuilder], nic: ref[LinkNIC]) linked

    procedure end_link(mutable this: ref[HtmlFOTBuilder]) linked

    ; --- scroll ---------------------------------------------------------------
    procedure start_scroll(mutable this: ref[HtmlFOTBuilder]) linked

    procedure end_scroll(mutable this: ref[HtmlFOTBuilder]) linked

    ; --- low-level output (the current emission buffer; null = discard) -------
    procedure put(mutable this: ref[HtmlFOTBuilder], c: u32) @persists true linked

    procedure raw(mutable this: ref[HtmlFOTBuilder], s: Slice[char]) linked

    procedure raw_stringc(mutable this: ref[HtmlFOTBuilder], s: StringC) linked

    procedure re(mutable this: ref[HtmlFOTBuilder]) linked

    procedure raw_ulong(mutable this: ref[HtmlFOTBuilder], n_in: int) linked

    ; outputLength: "%04ld", then the last three digits shift right and a '.'
    ; lands three from the end; trailing zeros (then a bare point) are cut,
    ; then "pt". Quirks intact (-300 -> "-.3pt").
    procedure out_length(mutable this: ref[HtmlFOTBuilder], n: int) linked

    ; StyleClass::outputName
    procedure out_class_name(mutable this: ref[HtmlFOTBuilder], sc: ref[HtmlStyleClass]) linked

    ; outputCdata
    procedure out_cdata(mutable this: ref[HtmlFOTBuilder], s: Slice[u32]) linked

    procedure out_cdata_stringc(mutable this: ref[HtmlFOTBuilder], s: StringC) linked

    ; --- the stylesheet -------------------------------------------------------
    ; CharStyle::output
    procedure out_char_style(mutable this: ref[HtmlFOTBuilder], st: ref[HtmlStyle]) linked

    ; ParaStyle::output
    procedure out_para_style(mutable this: ref[HtmlFOTBuilder], st: ref[HtmlStyle]) linked

    ; the filename helpers: strip an extension within the last five characters
    function strip_ext(name: String) @page true @direct true returns String linked

    function ext_of(name: String) @page true @direct true returns String linked

    ; OutputState::outputFilename(index): base + index + ext (index 0 = as-is)
    procedure doc_filename(mutable this: ref[HtmlFOTBuilder], index: int) @page true @direct true returns String linked

    ; the basename after the last slash/backslash
    function basename(name: String) @page true @direct true returns String linked

    ; encode the record buffer (RE -> LF), then run the chars through the app's
    ; OUTPUT coding system — every file this backend opens gets its own
    ; RecordOutputCharStream(EncodeOutputCharStream(&file,
    ; app_->outputCodingSystem())) (HtmlFOTBuilder.cxx:448 for the stylesheet,
    ; :995 per document). ★NO escaper: the reference leaves a bare
    ; `// FIXME setEscaper` at :997, so a char the coding system cannot express
    ; DROPS here where the fot and transform sinks would write `&#<decimal>;`.
    procedure encode(mutable this: ref[HtmlFOTBuilder], buf: ref[Array[u32]]) @page true @direct true returns String reads OUTPUT_ENC linked

    ; --- the emission pass (the reference destructor) --------------------------
    procedure finish(mutable this: ref[HtmlFOTBuilder]) io reads OUTPUT_ENC linked

    procedure output_stylesheet(mutable this: ref[HtmlFOTBuilder]) io reads OUTPUT_ENC linked

    ; Container::output
    procedure out_container(mutable this: ref[HtmlFOTBuilder], owner: ref[HtmlItem]) io reads OUTPUT_ENC linked

    procedure out_item(mutable this: ref[HtmlFOTBuilder], it: ref[HtmlItem]) io reads OUTPUT_ENC linked

    ; Addressable::outputRef
    procedure out_ref(mutable this: ref[HtmlFOTBuilder], aref: ref[HtmlItem], is_end: bool) linked

    ; OutputState::syncChar — <A><SPAN>…</SPAN></A> transitions
    procedure sync_char(mutable this: ref[HtmlFOTBuilder], sc: ref[HtmlStyleClass]?) linked

    ; --- the rest of the sink surface: the inherited FOTBuilder brackets ------
    procedure start_sequence(mutable this: ref[HtmlFOTBuilder]) linked

    procedure end_sequence(mutable this: ref[HtmlFOTBuilder]) linked

    procedure start_display_group(mutable this: ref[HtmlFOTBuilder], nic: ref[DisplayNIC]?) linked

    procedure end_display_group(mutable this: ref[HtmlFOTBuilder]) linked

    procedure start_line_field(mutable this: ref[HtmlFOTBuilder], nic: ref[LineFieldNIC]?) linked

    procedure end_line_field(mutable this: ref[HtmlFOTBuilder]) linked

    procedure start_leader(mutable this: ref[HtmlFOTBuilder], nic: ref[LeaderNIC]?) linked

    procedure end_leader(mutable this: ref[HtmlFOTBuilder]) linked

    procedure start_score(mutable this: ref[HtmlFOTBuilder], nic: ref[ScoreNIC]?) linked

    procedure end_score(mutable this: ref[HtmlFOTBuilder]) linked

    procedure start_box(mutable this: ref[HtmlFOTBuilder], nic: ref[BoxNIC]?, dnic: ref[DisplayNIC]?) linked

    procedure end_box(mutable this: ref[HtmlFOTBuilder]) linked

    procedure paragraph_break(mutable this: ref[HtmlFOTBuilder], nic: ref[DisplayNIC]?) linked

    procedure rule(mutable this: ref[HtmlFOTBuilder], nic: ref[RuleNIC]?, dnic: ref[DisplayNIC]?) linked

    procedure external_graphic(mutable this: ref[HtmlFOTBuilder], nic: ref[ExternalGraphicNIC]?, dnic: ref[DisplayNIC]?) linked

    ; FOTBuilder::pageNumber / currentNodePageNumber are EMPTY (no atomic)
    function page_number(this: ref[HtmlFOTBuilder]) linked

    function current_node_page_number(this: ref[HtmlFOTBuilder], node: ref[GroveNode]?) linked

    procedure start_simple_page_sequence(mutable this: ref[HtmlFOTBuilder]) linked

    procedure start_simple_page_sequence_header_footer(mutable this: ref[HtmlFOTBuilder], flags: int) linked

    procedure end_simple_page_sequence_header_footer(mutable this: ref[HtmlFOTBuilder], flags: int) linked

    function end_all_simple_page_sequence_header_footer(this: ref[HtmlFOTBuilder]) linked

    procedure end_simple_page_sequence(mutable this: ref[HtmlFOTBuilder]) linked

    procedure start_table(mutable this: ref[HtmlFOTBuilder], tnic: ref[TableNIC]?, dnic: ref[DisplayNIC]?) linked

    procedure end_table(mutable this: ref[HtmlFOTBuilder]) linked

    procedure start_table_part_serial(mutable this: ref[HtmlFOTBuilder], dnic: ref[DisplayNIC]?) linked

    procedure end_table_part_serial(mutable this: ref[HtmlFOTBuilder]) linked

    function start_table_part_header(this: ref[HtmlFOTBuilder]) linked

    function end_table_part_header(this: ref[HtmlFOTBuilder]) linked

    function start_table_part_footer(this: ref[HtmlFOTBuilder]) linked

    function end_table_part_footer(this: ref[HtmlFOTBuilder]) linked

    procedure table_column(mutable this: ref[HtmlFOTBuilder], nic: ref[TableColumnNIC]?) linked

    procedure start_table_row(mutable this: ref[HtmlFOTBuilder]) linked

    procedure end_table_row(mutable this: ref[HtmlFOTBuilder]) linked

    procedure start_table_cell(mutable this: ref[HtmlFOTBuilder], nic: ref[TableCellNIC]) linked

    procedure end_table_cell(mutable this: ref[HtmlFOTBuilder]) linked

    procedure table_before_row_border(mutable this: ref[HtmlFOTBuilder]) linked

    procedure table_after_row_border(mutable this: ref[HtmlFOTBuilder]) linked

    procedure table_before_column_border(mutable this: ref[HtmlFOTBuilder]) linked

    procedure table_after_column_border(mutable this: ref[HtmlFOTBuilder]) linked

    procedure table_cell_before_row_border(mutable this: ref[HtmlFOTBuilder]) linked

    procedure table_cell_after_row_border(mutable this: ref[HtmlFOTBuilder]) linked

    procedure table_cell_before_column_border(mutable this: ref[HtmlFOTBuilder]) linked

    procedure table_cell_after_column_border(mutable this: ref[HtmlFOTBuilder]) linked

    ; the TeX extension flow objects never reach this backend (their classes
    ; bind as FOC_UNKNOWN unless -t tex), but the sink surface is shared.
    function start_page_float(this: ref[HtmlFOTBuilder], nic: ref[PageFloatNIC]?) linked

    function end_page_float(this: ref[HtmlFOTBuilder]) linked

    function start_page_footnote(this: ref[HtmlFOTBuilder]) linked

    function end_page_footnote(this: ref[HtmlFOTBuilder]) linked
    ; --- the INLINE/MARK family -------------------------------------------------
    ; None of these six classes is overridden by the reference Html backend, so the
    ; plain FOTBuilder brackets apply. ★`character` is the interesting one: the
    ; base EMITS THE CHARACTER as text when the NIC is valid, then takes the
    ; atomic bracket (FOTBuilder.cxx:174) — measured (`-t rtf` renders
    ; `(make character char: #\A)` as an "A").
    procedure character(mutable this: ref[HtmlFOTBuilder], nic: ref[CharacterNIC]) linked

    procedure alignment_point(mutable this: ref[HtmlFOTBuilder]) linked

    procedure start_sideline(mutable this: ref[HtmlFOTBuilder]) linked

    procedure end_sideline(mutable this: ref[HtmlFOTBuilder]) linked

    procedure anchor(mutable this: ref[HtmlFOTBuilder], nic: ref[AnchorNIC]?) linked

    procedure start_glyph_annotation(mutable this: ref[HtmlFOTBuilder], nic: ref[GlyphAnnotationNIC]?) linked

    procedure end_glyph_annotation(mutable this: ref[HtmlFOTBuilder]) linked

    procedure start_emphasizing_mark_serial(mutable this: ref[HtmlFOTBuilder], nic: ref[EmphasizingMarkNIC]?) linked

