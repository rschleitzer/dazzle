; --- item tags ---------------------------------------------------------------
define HTM_ADDRESSABLE: int 0
define HTM_MARKUP: int 1
define HTM_PCDATA: int 2
define HTM_CONTAINER: int 3
define HTM_REF: int 4
define HTM_BLOCK: int 5
define HTM_DOCUMENT: int 6

; ParaProps::align
define HTM_ALIGN_LEFT: int 0
define HTM_ALIGN_CENTER: int 1
define HTM_ALIGN_RIGHT: int 2
define HTM_ALIGN_JUSTIFY: int 3

; CharProps::fontStyle
define HTM_STYLE_NORMAL: int 0
define HTM_STYLE_ITALIC: int 1
define HTM_STYLE_OBLIQUE: int 2

; --- a CSS class prefix (one per GI) -----------------------------------------
define HtmlClassPrefix (prefix: StringC, var n_char_classes: int, var n_para_classes: int)
{
    function make(host: ref[Page], prefix: StringC) @ret_explicit_0 true @deep true returns ref[HtmlClassPrefix] linked




}

; --- a style class (one GI within one style) — an IList node ------------------
define HtmlStyleClass (gi: StringC, prefix: ref[HtmlClassPrefix], prefix_index: int, var next: ref[HtmlStyleClass]?)
{
    function make(host: ref[Page], gi: StringC, prefix: ref[HtmlClassPrefix]) @ret_explicit_0 true @deep true returns ref[HtmlStyleClass] linked




}

; --- one distinct style (character or paragraph) ------------------------------
; is_para picks which property half is live; `classes` is the reference IList
; (insert-at-head, iterated head-first).
define HtmlStyle
(
    is_para: bool
    ; CharProps
    var font_weight: int
    var font_style: int
    var color: int
    var font_size: int
    var font_family: StringC
    ; ParaProps
    var left_margin: int
    var right_margin: int
    var line_height: int
    var text_indent: int
    var align: int
    var top_margin: int
    var classes: ref[HtmlStyleClass]?
)
{
    function make(host: ref[Page], is_para: bool) @ret_explicit_0 true @deep true returns ref[HtmlStyle] linked




}

; --- FlowObjectInfo: the inherited-characteristic snapshot -------------------
define HtmlFoInfo
(
    ; CharProps
    var font_weight: int
    var font_style: int
    var color: int
    var font_size: int
    var font_family: StringC
    ; InheritParaProps
    var left_margin: int
    var right_margin: int
    var line_height: int
    var text_indent: int
    var align: int
    ; FlowObjectInfo proper
    var doc_index: int
    var has_scroll_title: bool
    var scroll_title: StringC
    var parent_left_margin: int
    var parent_right_margin: int
)
{
    ; CharProps() + InheritParaProps() + FlowObjectInfo() ctor defaults
    init() linked

















}

; --- one item of the buffered tree -------------------------------------------
define HtmlItem
(
    tag: int
    var next: ref[HtmlItem]?
    ; container/ref/block/document content (head of the child IList)
    var content: ref[HtmlItem]?
    ; block / pcdata style class
    var style_class: ref[HtmlStyleClass]?
    ; pcdata payload (immediate copies, node-backed keeps the grove view)
    var data: Slice[u32]
    ; markup payload
    var str: StringC
    ; ref target (an addressable item, or null)
    var aref: ref[HtmlItem]?
    ; document
    var doc_index: int
    var has_title: bool
    var title: StringC
    ; addressable
    var grove_index: int
    ; -1 = the whole document
    var element_index: int
    ; -1 = not defined
    var a_doc_index: int
    var referenced: bool
)
{
    function make(host: ref[Page], tag: int) @ret_explicit_0 true @deep true returns ref[HtmlItem] linked





    function defined(this: ref[HtmlItem]) @ret_param_0 true @deep true returns bool linked

}

; libc + shim externs (prototypes type-match the other roots').
procedure scaly_eputs(s: pointer[const_char]) extern
procedure scaly_eputnl() extern
function strerror(code: i32) returns pointer[const_char] extern
function scaly_eio_errno() returns i32 extern

; argv0 for the HtmlMessages prefix (`<argv0>:E: …`), like tfb_prog.
shared html_prog: pointer[const_char] linked

define HtmlFOTBuilder
(
    ; the item tree: `root` is the reference's root_ Container, `dest_` the
    ; current insertion owner (its content list), with the DestInfo stack.
    var root: ref[HtmlItem]
    var dest: ref[HtmlItem]
    var dest_stack: ref[Array[ref[HtmlItem]?]]
    var dest_depth: int
    ; the flow-object info stack + NextFlowObject
    var fo_stack: ref[Array[ref[HtmlFoInfo]?]]
    var fo_depth: int
    var next_fo: HtmlFoInfo
    ; the two style tables (open addressing, hash = 17, decrementing probe)
    var char_slots: ref[Array[ref[HtmlStyle]?]]
    var char_used: int
    var char_limit: int
    var para_slots: ref[Array[ref[HtmlStyle]?]]
    var para_used: int
    var para_limit: int
    ; the GI-keyed prefix table (OpenSP Hash = Torek)
    var prefix_slots: ref[Array[ref[HtmlClassPrefix]?]]
    var prefix_used: int
    var prefix_limit: int
    ; per-grove element anchors: elements_[g][e]
    var elements: ref[Array[ref[Array[ref[HtmlItem]?]]?]]
    ; pendingAddr_ — a stack of (grove, element) pair vectors
    var pending: ref[Array[ref[Array[int]]?]]?
    var pending_depth: int
    ; giStack_
    var gi_stack: ref[Array[StringC]]
    var gi_depth: int
    var n_documents: int
    var top_margin: int
    var space_after_stack: ref[Array[int]]
    var space_after_depth: int
    ; the output file name (the reference's outputFilename_, already
    ; defaulted by the CLI) + the stylesheet name once written
    var out_name: String
    var css_name: String
    var have_css: bool
    ; output state (OutputState) — one live emission at a time
    var out_doc_index: int
    var cur_aref: ref[HtmlItem]?
    var spec_aref: ref[HtmlItem]?
    var cur_char_class: ref[HtmlStyleClass]?
    ; the byte sink of the current emission (null = discard)
    var os: ref[Array[u32]]?
    var host: ref[Page]
)
{
    function make(host: ref[Page], out_name: String) @ret_explicit_0 true @deep true returns ref[HtmlFOTBuilder] linked
















































