    var page_number_format: int
    var n_columns: int
    var column_sep: int
    var balance: bool
)

define RtfDisplayInfo
(
    var space_after: int
    var keep_with_next: bool
    var save_keep: bool
    var break_after: int
)

define RtfBorder
(
    var priority: int
    var flags: int
    var thickness: int
    var color: int
)
{
    function make(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[RtfBorder] linked




}

