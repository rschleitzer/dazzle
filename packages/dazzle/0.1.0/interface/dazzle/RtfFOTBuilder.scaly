define RTF_N_WIN_CHARSETS: int 7
define RTF_JIS_CHARSET: int 5
define RTF_N_SYMBOL_FONTS: int 3
define RTF_CHAR_BITS: int 16
; 1 << 31 / 1 << 30 as u32 flag masks
define RTF_SYMBOL_FLAG: int 0x80000000
define RTF_DB_FLAG: int 0x40000000
define RTF_SYMBOL_FONT_PAGE: int 0xf000
define RTF_DEFAULT_LANG: int 0x400
define RTF_HF_PRE_SPACE: int 190
define RTF_HF_POST_SPACE: int 50

; inline states
define RTF_INLINE_FIRST: int 0
define RTF_INLINE_START: int 1
define RTF_INLINE_FIELD: int 2
define RTF_INLINE_FIELD_END: int 3
define RTF_INLINE_MIDDLE: int 4
define RTF_INLINE_TABLE: int 5

; underline kinds
define RTF_UL_NONE: int 0
define RTF_UL_SINGLE: int 1
define RTF_UL_DOUBLE: int 2
define RTF_UL_WORDS: int 3

; break kinds
define RTF_BREAK_NONE: int 0
define RTF_BREAK_PAGE: int 1
define RTF_BREAK_COLUMN: int 2

; current output stream (the reference osp_ pointer)
define RTF_ST_MAIN: int 0
define RTF_ST_HF: int 1
define RTF_ST_FIELD: int 2
define RTF_ST_CELL: int 3

; page-number formats
define RTF_PGN_DEC: int 0
define RTF_PGN_UCLTR: int 1
define RTF_PGN_LCLTR: int 2
define RTF_PGN_UCRM: int 3
define RTF_PGN_LCRM: int 4

; border flag bits (Border::isPresent/isDouble/omitAtBreak)
define RTF_BORDER_PRESENT: int 1
define RTF_BORDER_DOUBLE: int 2
define RTF_BORDER_OMIT: int 4

; widow/orphan control bits
define RTF_WIDOW_CONTROL: int 1
define RTF_ORPHAN_CONTROL: int 2

; math escaping mode (RtfFOTBuilder::MathSpecial) and grid cell positioning
define RTF_MATH_NORMAL: int 0
define RTF_MATH_FENCE: int 1
define RTF_MATH_INTEGRAL: int 2
define RTF_GRIDPOS_ROW_MAJOR: int 0
define RTF_GRIDPOS_COLUMN_MAJOR: int 1
define RTF_GRIDPOS_EXPLICIT: int 2

; FOTBuilder::Symbol c-values consumed here (enum order verified against
; the reference; matches the Style.scaly SYM_* constants)
define RSYM_FALSE: int 0
define RSYM_TRUE: int 1
define RSYM_MEDIUM: int 11
define RSYM_OBLIQUE: int 21
define RSYM_ITALIC: int 23
define RSYM_START: int 25
define RSYM_END: int 26
define RSYM_CENTER: int 27
define RSYM_JUSTIFY: int 28
define RSYM_WRAP: int 33
define RSYM_NONE: int 37
define RSYM_THROUGH: int 39
define RSYM_AFTER: int 40
define RSYM_MATH: int 51
define RSYM_DISPLAY: int 81
define RSYM_INLINE: int 82
define RSYM_EXPLICIT: int 102
define RSYM_ROW_MAJOR: int 103
define RSYM_COLUMN_MAJOR: int 104
define RSYM_PAGE: int 61
define RSYM_PAGE_REGION: int 62
define RSYM_COLUMN_SET: int 63
define RSYM_COLUMN: int 64
define RSYM_PRESERVE: int 77
define RSYM_COLLAPSE: int 78
define RSYM_IGNORE: int 79
define RSYM_BORDER: int 83
define RSYM_BACKGROUND: int 84
define RSYM_BOTH: int 85
define RSYM_HORIZONTAL: int 47
define RSYM_VERTICAL: int 48
define RSYM_ESCAPEMENT: int 49
define RSYM_LINE_PROGRESSION: int 50

; extension characteristic setter ids (InheritedC.ext_setter; the 12-entry
; jade.cxx/RtfFOTBuilder extension table)
define RTF_EXT_PAGE_NUMBER_FORMAT: int 1
define RTF_EXT_PAGE_NUMBER_RESTART: int 2
define RTF_EXT_PAGE_N_COLUMNS: int 3
define RTF_EXT_PAGE_COLUMN_SEP: int 4
