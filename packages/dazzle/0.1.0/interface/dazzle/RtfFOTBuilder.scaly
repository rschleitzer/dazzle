; --- format records (CommonFormat/ParaFormat/Format flattened; OutputFormat;
; PageFormat; DisplayInfo) ---------------------------------------------------

; what the RTF reader thinks the format is (OutputFormat : CommonFormat)
define RtfOutputFmt
(
    var is_bold: bool
    var is_italic: bool
    var is_small_caps: bool
    var underline: int
    var is_strikethrough: bool
    var font_family: int
    var font_size: int
    var color: int
    var char_background_color: int
    var position_point_shift: int
    var language: int
    var country: int
    var kern: bool
    var char_border: bool
    var char_border_color: int
    var char_border_thickness: int
    var char_border_double: bool
    var charset: int
    var lang: int
    var lang_charsets: int
)

; the specified format (Format : ParaFormat, CommonFormat — flattened)
define RtfFormat
(
    ; CommonFormat
    var is_bold: bool
    var is_italic: bool
    var is_small_caps: bool
    var underline: int
    var is_strikethrough: bool
    var font_family: int
    var font_size: int
    var color: int
    var char_background_color: int
    var position_point_shift: int
    var language: int
    var country: int
    var kern: bool
    var char_border: bool
    var char_border_color: int
    var char_border_thickness: int
    var char_border_double: bool
    ; ParaFormat
    var left_indent: int
    var right_indent: int
    var first_line_indent: int
    var line_spacing: int
    var line_spacing_at_least: bool
    var quadding: int
    var lines: int
    var widow_orphan_control: int
    var heading_level: int
    ; Format
    var hyphenate: bool
    var field_width: int
    var field_align: int
    var input_whitespace_treatment: int
    var expand_tabs: int
    var display_alignment: int
    var line_thickness: int
    var line_double: bool
    var score_spaces: bool
    var box_has_border: bool
    var box_has_background: bool
    var background_color: int
    var border_present: bool
    var border_omit_at_break: bool
    var cell_background: bool
    var border_priority: int
    var cell_top_margin: int
    var cell_bottom_margin: int
    var cell_left_margin: int
    var cell_right_margin: int
    var cell_vertical_alignment: int
    var math_posture: bool
    var math_inline: bool
    var grid_pos_type: int
    var grid_column_alignment: int
    var superscript_height: int
    var subscript_depth: int
    var over_mark_height: int
    var under_mark_depth: int
    var grid_row_sep: int
    var grid_column_sep: int
    var span: bool
    var pps_spec: LengthSpec
    var li_spec: LengthSpec
    var ri_spec: LengthSpec
    var fli_spec: LengthSpec
    var ls_spec: LengthSpec
    var fw_spec: LengthSpec
)

; the paragraph format in force (ParaFormat)
define RtfParaFmt
(
    var left_indent: int
    var right_indent: int
    var first_line_indent: int
    var line_spacing: int
    var line_spacing_at_least: bool
    var quadding: int
    var lines: int
    var widow_orphan_control: int
    var heading_level: int
)

define RtfPageFmt
(
    var page_width: int
    var page_height: int
    var left_margin: int
    var right_margin: int
    var header_margin: int
    var footer_margin: int
    var top_margin: int
    var bottom_margin: int
