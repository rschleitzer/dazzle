}

; RtfFOTBuilder::ReorderFlowObject (jade/RtfFOTBuilder.cxx:543) — the capture
; record of a math class whose ports are written to the RTF stream in a
; DIFFERENT order than they arrive (fraction is not one of these; radical,
; fence, math-operator, mark and script are). `streams` collects one captured
; buffer per port bracket, each still wrapped in its `{`…`}`, so the reference's
; `size() > 2` emptiness test carries over unchanged.
define RtfReorder
(
    streams: ref[Array[ref[Array[u8]]?]]
    save_out_fmt: RtfOutputFmt
)
{
    function make(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[RtfReorder] linked





}

; RtfFOTBuilder::Grid (jade/RtfFOTBuilder.cxx:551) — the cell matrix of a
; `grid`. ★`cells` is indexed [i][j] and the three positioning modes disagree
; about which index is the row: explicit writes cells[column-1][row-1] while
; row-major appends to cells.back() as a ROW. Reproduced as measured.
; cur_row/cur_col address the cell being captured (-1 = none, the reference's
; null curCellPtr).
define RtfGrid
(
    var cells: ref[Array[ref[Array[ref[Array[u8]]?]]?]]?
    var n_columns: int
    var n_rows: int
    var pos_type: int
    var cur_row: int
    var cur_col: int
    var save_out_fmt: RtfOutputFmt
    var host: ref[Page]
)
{
    function make(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[RtfGrid] linked














    ; Vector<Vector<String> >::resize — grow the outer vector to `n` rows,
    ; each new row an empty vector.
    procedure grow_rows(mutable this: ref[RtfGrid], n: int) @deep true linked






    procedure grow_row(mutable this: ref[RtfGrid], i: int, n: int) @deep true linked







}

; --- the builder ------------------------------------------------------------
define RtfFOTBuilder
(
    ; output streams: the body temp buffer, header/footer, line-field and
    ; table-cell captures; cur_stream selects (the reference osp_ pointer),
    ; discard models the leader null stream.
    var out: ref[Array[u8]]
    var hfos: ref[Array[u8]]
    var fieldos: ref[Array[u8]]
    var cellos: ref[Array[u8]]
    var cur_stream: int
    var discard: bool
    ; inline/paragraph state
    var inline_state: int
    var continue_par: bool
    ; formats
    var out_fmt: RtfOutputFmt
    var save_out_fmt: RtfOutputFmt
    var leader_save_out_fmt: RtfOutputFmt
    var spec: RtfFormat
    var para: RtfParaFmt
    var page: RtfPageFmt
    ; stacks (slot-reused pointer arrays with depth cursors)
    var spec_stack: ref[Array[ref[RtfFormat]?]]
    var spec_depth: int
    var para_stack: ref[Array[ref[RtfParaFmt]?]]
    var para_depth: int
    var page_stack: ref[Array[ref[RtfPageFmt]?]]
    var page_depth: int
    var display_stack: ref[Array[ref[RtfDisplayInfo]?]]
    var display_depth: int
    var display_box_levels: ref[Array[int]]
    var dbl_len: int
    var box_first_para: bool
    var box_left_sep: int
    var box_right_sep: int
    var box_top_sep: int
    var accum_space_box: int
    ; pending element bookmarks
    var pending_elements: ref[Array[ref[GroveNode]?]]
    var pending_levels: ref[Array[int]]
    var pending_len: int
    var n_pending_non_empty: int
    var suppress_bookmarks: bool
    var node_level: int
    ; fonts: the OpenSP HashTable<StringC,int> (open addressing, decrementing
    ; probe, slot-order iteration) + the per-family charset font numbers
    var font_slots: ref[Array[ref[RtfFontEntry]?]]
    var font_used: int
    var font_used_limit: int
    var ffcs: ref[Array[ref[RtfFontCharsets]?]]
    var next_font_number: int
    ; spacing/keeps/breaks
    var accum_space: int
    var keep_with_next: bool
    var hyphenate_suppressed: bool
    var max_consec_hyphens: int
    var do_break: int
    var keep: bool
    var had_par_in_keep: bool
    ; tables
    var table_level: int
    var table_width: int
    var table_alignment: int
    var table_display_size: int
    var table_left_indent: int
    var table_right_indent: int
    var add_left_indent: int
    var add_right_indent: int
    var tborders: ref[Array[ref[RtfBorder]?]]
    var cell_index: int
    var rows: ref[Array[ref[Array[ref[RtfCell]?]]?]]
    var in_table_header: bool
    var n_header_rows: int
    var columns: ref[Array[ref[RtfColumn]?]]?
    ; line fields
    var field_tab_pos: int
    ; sections/pages
    var display_size: int
    var had_section: bool
    var do_balance: bool
    var span_display_levels: int
    var current_cols: int
    var in_simple_page_sequence: int
    var hf_parts: ref[Array[ref[Array[u8]]?]]
    ; links
    var link_depth: int
    var pending_link: ref[LinkNIC]?
    var have_pending_link: bool
    ; colors
    var color_table: ref[Array[int]]
    ; character state
    var follow_whitespace_char: bool
    var current_column: int
    var char_table: ref[Array[u32]]
    ; element reference set (grove 0 only in practice; grove-indexed rows)
    var elements_refed: ref[Array[ref[Array[bool]]?]]
    ; leaders
    var leader_depth: int
    var pre_leader_stream: int
    var pre_leader_discard: bool
    var rtf_version: int
    ; --- math (jade/RtfFOTBuilder.cxx) ---------------------------------------
    ; mathLevel_ counts nested math brackets (the RTF EQ field is opened once,
    ; at level 0→1); mathSpecial_ switches the escaping of `,`/`(`/`)`/`\` in
    ; characters(); eqArgSep_ is the field's argument separator. The reorder
    ; and grid stacks are the two output REDIRECTS the math classes use — both
    ; ride the shared `redirect` buffer stack so they nest correctly (the
    ; reference saves and restores its raw `osp_` pointer for the same reason).
    var math_level: int
    var math_special: int
    var eq_arg_sep: int
    var math_save_out_fmt: RtfOutputFmt
    var redirect: ref[Array[ref[Array[u8]]?]]
    var redirect_depth: int
    var reorder_stack: ref[Array[ref[RtfReorder]?]]
    var reorder_depth: int
    var grid_stack: ref[Array[ref[RtfGrid]?]]
    var grid_depth: int
    var interp: ref[Interpreter]
    var host: ref[Page]
)
{
    function make(host: ref[Page], interp: ref[Interpreter]) @ret_explicit_0 true @deep true returns ref[RtfFOTBuilder] linked





































































































































































































    ; --- format defaults (the reference default constructors) ---------------
    procedure output_fmt_defaults(mutable o: ref[RtfOutputFmt]) @deep true linked























    procedure format_defaults(mutable s: ref[RtfFormat]) @deep true linked









































































    procedure para_defaults(mutable p: ref[RtfParaFmt]) @deep true linked












    procedure page_defaults(mutable p: ref[RtfPageFmt]) @deep true linked
















    ; --- field-copy helpers --------------------------------------------------
    procedure copy_format(mutable dst: ref[RtfFormat], src: ref[RtfFormat]) @deep true linked



































































    procedure copy_para(mutable dst: ref[RtfParaFmt], src: ref[RtfParaFmt]) @deep true linked












    ; paraFormat_ = specFormat_ (the C++ ParaFormat slice assignment)
    procedure para_from_spec(mutable dst: ref[RtfParaFmt], src: ref[RtfFormat]) @deep true linked












    procedure copy_page(mutable dst: ref[RtfPageFmt], src: ref[RtfPageFmt]) @deep true linked
















    procedure copy_output_fmt(mutable dst: ref[RtfOutputFmt], src: ref[RtfOutputFmt]) @deep true linked























    ; --- stack machinery (slot reuse) ----------------------------------------
    procedure push_spec(mutable this: ref[RtfFOTBuilder]) @deep true linked


















    procedure pop_spec(mutable this: ref[RtfFOTBuilder]) @ret_nonlocal true @deep true linked







    function spec_at(this: ref[RtfFOTBuilder], i: int) @deep true returns ref[RtfFormat]? linked







    procedure push_page(mutable this: ref[RtfFOTBuilder]) @deep true linked


















    procedure pop_page(mutable this: ref[RtfFOTBuilder]) @ret_nonlocal true @deep true linked







    ; endSimplePageSequenceSerial: pageFormat_ = pageFormatStack_.back()
    ; without popping.
    procedure page_from_back(mutable this: ref[RtfFOTBuilder]) @ret_nonlocal true @deep true linked






    procedure push_para(mutable this: ref[RtfFOTBuilder]) @deep true linked


















    procedure pop_para(mutable this: ref[RtfFOTBuilder]) @ret_nonlocal true @deep true linked







    procedure push_display(mutable this: ref[RtfFOTBuilder]) @deep true returns ref[RtfDisplayInfo]? linked























    function display_back(this: ref[RtfFOTBuilder]) @deep true returns ref[RtfDisplayInfo]? linked







    ; --- char table helpers ---------------------------------------------------
    function ct_get(this: ref[RtfFOTBuilder], c: u32) @deep true returns u32 linked









    procedure ct_set(mutable this: ref[RtfFOTBuilder], c: u32, v: u32) @ret_nonlocal true @deep true linked





    ; NOTE: these helpers EMIT directly instead of returning the cstring
    ; literal — written around the cstring-literal-return compiler bug
    ; (2026-07-29). That bug is FIXED (dd18c0d7); the direct-emitting shape
    ; stays deliberately (reverting would be emission churn for no gain).
    procedure emit_charset_suffix(mutable this: ref[RtfFOTBuilder], i: int) @ret_nonlocal true @deep true linked











    ; --- font family hash table (OpenSP PointerTable semantics) --------------
    function torek_hash(this: ref[RtfFOTBuilder], s: StringC) @ret_nonlocal true @deep true returns size_t linked












    function font_lookup(this: ref[RtfFOTBuilder], key: StringC) @deep true returns int linked























