; Pattern — the construction/style rule matcher (Style/Pattern.{h,cxx} +
; Interpreter::convertToPattern). A pattern is an ancestor chain of Elements
; (first = self, then parent, grandparent …); each Element is a GI plus a set
; of Qualifiers. matches() walks the chain against a grove node. Rule ordering
; uses compareSpecificity over a fixed vector of specificity dimensions.
;
; COMPLETENESS work package 10 completed the qualifier set: all ten
; Pattern::Qualifier subclasses (attribute / attribute-has / attribute-missing,
; id, class, the four position qualifiers, the two only qualifiers, children,
; priority, importance), the repeat metacharacters, and the whole keyword half
; of convertToPattern — which is dsssl2-ONLY, exactly like the `-2` gates found
; in packages 7 and 8 (`KeywordObj *key = dsssl2() ? head->asKeyword() : 0;`,
; Interpreter.cxx:1466). Its diagnostics are issued too; they used to be this
; port's debt (a malformed pattern returned null in silence).
;
; The MatchContext of the reference is the Interpreter itself (it derives from
; Pattern::MatchContext), which is why the class/id attribute NAME lists that
; `declare-class-attribute` / `declare-id-attribute` fill live there and the
; interpreter is threaded through every satisfies() here.

use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.Location.Location
use dazzle.Grove.GroveNode
use dazzle.Grove.GroveInfo
use dazzle.ELObj.ELObj
use dazzle.ELObj.OutputCharStream
use dazzle.ELObj.Identifier
use dazzle.Interpreter.Interpreter
use dazzle.InterpreterMessages.InterpreterMessages
use opensp.AttributeList.AttributeList
use opensp.Attribute.AttributeValue
use opensp.Attribute.Text

; specificity dimensions (Pattern.h enum) — importance..attribute, in order.
define SPEC_IMPORTANCE: int 0
define SPEC_ID: int 1
define SPEC_CLASS: int 2
define SPEC_GI: int 3
define SPEC_REPEAT: int 4
define SPEC_PRIORITY: int 5
define SPEC_ONLY: int 6
define SPEC_POSITION: int 7
define SPEC_ATTRIBUTE: int 8
define N_SPECIFICITY: int 9

define REPEAT_INF: int 0x7FFFFFFF

; the ten Pattern::Qualifier subclasses as one tagged record — they differ only
; in which of (name, value, number, child list) they carry, and a tag keeps
; every satisfies/contributeSpecificity switch in one place next to the C++.
define QK_ATTR: int 0            ; AttributeQualifier             name + value
define QK_ATTR_HAS: int 1        ; AttributeHasValueQualifier     name
define QK_ATTR_MISSING: int 2    ; AttributeMissingValueQualifier name
define QK_ID: int 3              ; IdQualifier                    value
define QK_CLASS: int 4           ; ClassQualifier                 value
define QK_POSITION: int 5        ; {First,Last}Of{Type,Any}       n
define QK_ONLY: int 6            ; OnlyOf{Type,Any}               n
define QK_CHILDREN: int 7        ; ChildrenQualifier              children
define QK_PRIORITY: int 8        ; PriorityQualifier              n
define QK_IMPORTANCE: int 9      ; ImportanceQualifier            n

define POS_FIRST_OF_TYPE: int 0
define POS_LAST_OF_TYPE: int 1
define POS_FIRST_OF_ANY: int 2
define POS_LAST_OF_ANY: int 3

define ONLY_OF_TYPE: int 0
define ONLY_OF_ANY: int 1

; --- attribute helpers (the loose, case-insensitive lookup) ----------------
; Kept for the primitives that still use it (attribute-string and friends);
; the PATTERN side now goes through Pattern.match_attribute, which is
; Qualifier::matchAttribute proper.
define AttrLookup
{
    ; the index of the case-insensitively named attribute, or -1.
    function index_ci(atts: ref[AttributeList], name: StringC) returns int linked













    function present(node: ref[GroveNode]?, name: StringC) returns bool linked
















    function value(node: ref[GroveNode]?, name: StringC) @page true @direct true returns StringC linked




















    ; whether the attribute's value is TOKENIZED
    function tokenized(node: ref[GroveNode]?, name: StringC) returns bool linked














}

; --- GI matching -----------------------------------------------------------
; GiMatch is the loose ASCII fold the PRIMITIVES still compare with; the
; pattern matcher uses Pattern.gi_matches, which is ElementNode::hasGi.
define GiMatch
{
    function fold(c: u32) returns u32 linked






    function equal(a: StringC, b: StringC) returns bool linked













}

; --- Qualifier -------------------------------------------------------------
define Qualifier (kind: int, name: StringC, value: StringC, n: int, children: ref[Array[ref[Element]?]]?)
{
    function alloc(host: ref[Page], kind: int) returns ref[Qualifier] linked





    function make_attr(host: ref[Page], name: StringC, value: StringC) returns ref[Qualifier] linked






    function make_attr_has(host: ref[Page], name: StringC) returns ref[Qualifier] linked





    function make_attr_missing(host: ref[Page], name: StringC) returns ref[Qualifier] linked





    function make_id(host: ref[Page], id: StringC) returns ref[Qualifier] linked





    function make_class(host: ref[Page], cls: StringC) returns ref[Qualifier] linked





    function make_position(host: ref[Page], which: int) returns ref[Qualifier] linked





    function make_only(host: ref[Page], which: int) returns ref[Qualifier] linked





    function make_children(host: ref[Page], kids: ref[Array[ref[Element]?]]) returns ref[Qualifier] linked





    function make_priority(host: ref[Page], n: int) returns ref[Qualifier] linked





    function make_importance(host: ref[Page], n: int) returns ref[Qualifier] linked






    procedure satisfies(this: ref[Qualifier], host: ref[Page], interp: ref[Interpreter], mutable node: ref[GroveNode]) returns bool linked
















































































    ; NB: distinct name from Element.contribute_specificity — a same-named
    ; method on two concepts collides in call resolution (the get_insn/get_action
    ; footgun), and `q.contribute_specificity(...)` silently mis-dispatched,
    ; dropping all attribute specificity.
    procedure qualifier_specificity(this: ref[Qualifier], mutable s: Slice[int]) linked





















































    ; VacuousQualifier — priority and importance constrain nothing, so an
    ; element carrying only those is still trivial.
    function vacuous(this: ref[Qualifier]) returns bool linked





}

; --- Element ---------------------------------------------------------------
define Element (gi: StringC, min_repeat: int, max_repeat: int, qualifiers: ref[Array[ref[Qualifier]?]])
{
    function make(host: ref[Page], gi: StringC) returns ref[Element] linked





    procedure add_qualifier(mutable this: ref[Element], q: ref[Qualifier]) @persists true linked


    procedure set_repeat(mutable this: ref[Element], mn: int, mx: int) linked





    procedure matches(this: ref[Element], host: ref[Page], interp: ref[Interpreter], mutable node: ref[GroveNode]?) returns bool linked


























    function trivial(this: ref[Element]) returns bool linked
















    ; mustHaveGi: an element with minRepeat>0 and a non-empty GI pins the GI.
    procedure must_have_gi(this: ref[Element], mutable out: ref[StringC]) returns bool linked









    procedure contribute_specificity(this: ref[Element], mutable s: Slice[int]) linked















}

; --- Pattern ---------------------------------------------------------------
define Pattern (ancestors: ref[Array[ref[Element]?]], is_trivial: bool)
{
    function make(host: ref[Page]) returns ref[Pattern] linked





    ; finalize trivial after ancestors are populated (computeTrivial).
    procedure finish(mutable this: ref[Pattern]) linked

















    procedure add_element(mutable this: ref[Pattern], e: ref[Element]?) @persists true linked


    function trivial(this: Pattern) returns bool linked


    procedure must_have_gi(this: ref[Pattern], mutable out: ref[StringC]) returns bool linked








    ; --- the grove-side tests the qualifiers run on ------------------------

    ; BaseNamedNodeList::normalize (GroveBuilder.cxx:1565) — fold every
    ; character through the list's substitution table. Both lists a pattern
    ; ever normalizes against (attributes, elements) carry the parse's GENERAL
    ; table, so one helper serves matchAttribute and normalizeGeneralName
    ; alike. Answers on `host` through an explicit construction (a StringC
    ; RETURNED by value allocates its buffer through Page.get(<return slot>)).
    function normalize_general(host: ref[Page], node: ref[GroveNode], s: StringC) returns ref[StringC] linked






















    ; ElementNode::hasGi (spgrove/GroveBuilder.cxx:2998) — the PATTERN's GI is
    ; folded through the grove's general subst table and compared against the
    ; stored name, which the parse already normalized. ★A ONE-SIDED fold, not
    ; the two-sided ASCII approximation GiMatch does: in an XML (NAMECASE NO)
    ; grove the table is the identity and the comparison is therefore CASE
    ; SENSITIVE, exactly as the reference. ★With no table at all the reference
    ; matches NOTHING (`if (!subst) return 0`) — the driver installs it right
    ; after the parse.
    function gi_matches(node: ref[GroveNode], gi: StringC) returns bool linked























    ; NamedNodeList::namedNode over an element's attributes: normalize the
    ; query name, then find the DEFINITION whose (already normalized) name
    ; equals it. -1 = accessNull/no such attribute.
    function named_attr_index(host: ref[Page], node: ref[GroveNode]?, name: StringC) returns int linked



















    ; AttributeAsgnNode::getImplied — `value->text() == 0`, the
    ; #IMPLIED-without-a-value test (a DEFAULTED attribute is NOT implied).
    ; No value object at all is accessNull, which every caller reads as "not
    ; implied".
    function attr_implied(node: ref[GroveNode], idx: int) returns bool linked










    ; Pattern::Qualifier::matchAttribute (Pattern.cxx:88) — the shared engine
    ; of the attribute, id and class qualifiers.
    ; ★A TOKENIZED value compares against the WHOLE token string (separators
    ; included) after normalizing the pattern value; a CDATA value compares
    ; against its character data EXACTLY. ★An implied attribute never matches,
    ; not even against the empty string.
    function match_attribute(host: ref[Page], name: StringC, value: StringC, node: ref[GroveNode]) returns bool linked




























    ; The four position qualifiers (Pattern.cxx:270-330). The reference walks
    ; the CHUNK sibling axis — firstSibling, then assignNextChunkSibling — and
    ; reads a FAILING firstSibling as "must be document element", i.e. the
    ; qualifier is satisfied. In this port that root rule is
    ; GroveNode.has_siblings, and the axis is the node's sibling GROUP.
    ; ★"of type" compares the stored GIs directly (both already normalized);
    ; "of any" counts every node that HAS a GI, i.e. every element.
    procedure position_satisfies(mutable node: ref[GroveNode], which: int) returns bool linked

































    ; OnlyOfTypeQualifier / OnlyOfAnyQualifier — count over the WHOLE sibling
    ; group (the node itself included); a second hit fails.
    procedure only_satisfies(mutable node: ref[GroveNode], which: int) returns bool linked




































    ; ChildrenQualifier::satisfies (Pattern.cxx:138) — EVERY element of the
    ; children list must match SOME child; the reference keeps the unmatched
    ; ones in a shrinking vector and succeeds as soon as it is empty. A node
    ; with no children can never satisfy it.
    procedure children_satisfies(host: ref[Page], interp: ref[Interpreter], kids: ref[Array[ref[Element]?]]?, mutable node: ref[GroveNode]) returns bool linked








































    ; --- matching (matchAncestors / matchAncestors1) -----------------------
    procedure match_ancestors(a: ref[Array[ref[Element]?]], idx: size_t, host: ref[Page], interp: ref[Interpreter], mutable node: ref[GroveNode]?) returns bool linked






    procedure match_ancestors1(a: ref[Array[ref[Element]?]], idx: size_t, host: ref[Page], interp: ref[Interpreter], mutable node: ref[GroveNode]?) returns bool linked
































    procedure matches(this: ref[Pattern], host: ref[Page], interp: ref[Interpreter], mutable node: ref[GroveNode]?) returns bool linked


    ; --- specificity -------------------------------------------------------
    procedure compute_specificity(this: ref[Pattern], mutable s: Slice[int]) linked


















    ; -1 if p1 is MORE specific (sorts earlier), +1 if less, 0 if equal.
    ; ★The two vectors are STACK arrays, exactly as the reference declares them
    ; (`int s1[nSpecificity]`, Pattern.cxx:460). They used to come off the page
    ; the caller passed, and that page is the PERMANENT arena: `build_sorted`
    ; runs a selection sort over every element rule of the stylesheet, so the
    ; DocBook print stylesheet paid two 72-byte allocations per comparison and
    ; never got them back — measured 2026-08-07 as 20 % of a startup run plus
    ; the page churn under it (PERFORMANCE.md, "Was der Start kostet").
    ; The size must be a numeric literal (the language takes no expression
    ; there); it is N_SPECIFICITY and the loop below still reads that constant,
    ; so a change to it breaks LOUDLY here rather than silently overrunning.
    function compare_specificity(p1: ref[Pattern], p2: ref[Pattern]) returns int linked





















    ; a GI / attribute name may be a string OR a symbol (identifier) — that IS
    ; ELObj::convertToString ("either symbol or string", ELObj.h:78).
    function has_name(obj: ref[ELObj]) returns bool linked






    procedure name_of(host: ref[Page], mutable obj: ref[ELObj]) @page true @direct true returns StringC linked









    ; ELObjMessageArg — the object as the reference prints it into a message.
    procedure obj_arg(host: ref[Page], interp: ref[Interpreter], mutable obj: ref[ELObj]) @page true @direct true returns StringC linked






    ; --- convertToPattern (Interpreter::convertToPattern) ------------------
    ; string/symbol -> single GI element; #t -> empty-GI (any element);
    ; list -> ancestor chain with attribute-qualifier sublists and (under -2)
    ; keyword qualifiers. Returns null on a malformed pattern, after reporting
    ; the reference's diagnostic.
    procedure convert(host: ref[Page], mutable interp: ref[Interpreter], mutable obj: ref[ELObj]?, loc: Location) @page true @direct true returns ref[Pattern]? io reads msg_prog linked


















    ; Interpreter::convertToPattern's list half (Interpreter.cxx:1402).
    ; `is_child` is set inside a `children:` qualifier, where `repeat:` is an
    ; error.
    procedure convert_list(host: ref[Page], mutable interp: ref[Interpreter], mutable obj_in: ref[ELObj]?, loc: Location, is_child: bool, mutable list: ref[Array[ref[Element]?]]) returns bool io reads msg_prog linked






















































































































    ; the `switch (k)` of convertToPattern — one keyword qualifier.
    procedure add_key_qualifier(host: ref[Page], mutable interp: ref[Interpreter], sk: int, key: ref[Identifier], mutable value: ref[ELObj], loc: Location, is_child: bool, mutable elem: ref[Element]) returns bool io reads msg_prog linked












































































































































    procedure bad_qualifier_value(host: ref[Page], mutable interp: ref[Interpreter], key: ref[Identifier], mutable value: ref[ELObj], loc: Location) returns bool io reads msg_prog linked








    ; patternAddAttributeQualifiers: a FLAT (name value name2 value2 …) list —
    ; e.g. (ALIGN "center") is one qualifier, (A "x" B #t) is two.
    ; ★#f (attribute-missing) and #t (attribute-has-value) are dsssl2-ONLY;
    ; without `-2` neither converts to a string and the whole qualifier list is
    ; malformed.
    procedure add_attribute_qualifiers(host: ref[Page], interp: ref[Interpreter], mutable obj_in: ref[ELObj]?, mutable elem: ref[Element]) returns bool linked
















































}
