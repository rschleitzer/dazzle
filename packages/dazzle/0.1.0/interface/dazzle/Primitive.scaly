define Primitive
{
    ; primitiveCall dispatch. args points into the VM value stack (n_args
    ; slots). An error result is interp.makeError(); the VM turns it into the
    ; error unwind.
    ; The four error paths the HOT arms of `dispatch` can take. They are
    ; separate functions for the region-frame reason spelled out at `dispatch`:
    ; an `InterpreterMessages.<tag>()` accessor allocates its MessageType on the
    ; CALLER page, so calling one inside `dispatch` would give every one of its
    ; millions of entries a frame. Building the message one frame deeper costs
    ; the error path a call it does not notice.
    procedure arg_error_not_a_pair(mutable interp: ref[Interpreter], loc: Location, name: ref[Identifier]?, index: int, mutable obj: ref[ELObj]) returns ref[ELObj] io reads msg_prog linked

    procedure arg_error_not_a_string(mutable interp: ref[Interpreter], loc: Location, name: ref[Identifier]?, index: int, mutable obj: ref[ELObj]) returns ref[ELObj] io reads msg_prog linked

    procedure arg_error_not_a_node_list(mutable interp: ref[Interpreter], loc: Location, name: ref[Identifier]?, index: int, mutable obj: ref[ELObj]) returns ref[ELObj] io reads msg_prog linked

    procedure error_no_current_node(mutable interp: ref[Interpreter], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; ★★★The HOT half of the primitive dispatch (2026-08-07, PERFORMANCE.md
    ; „Der Rahmen je Primitivaufruf"). Twenty-four arms carry 94 % of the primitive
    ; calls of the heaviest codegen, 99 % of the single-file one and 96 % of a
    ; styling run, and they live here so that they pay a SMALL prologue and NO
    ; region frame; everything else is one call deeper in `dispatch_rest`. Same
    ; shape and the same two conditions as the Insn.execute / execute_rest /
    ; execute_cold split one level up:
    ;
    ;  (a) the ARM IDS MUST STAY DENSE. The dispatch is an `if` chain and LLVM
    ;      lowers it to a jump table only when the case values are dense enough
    ;      AND numerous enough — AArch64 wants 13 cases at minimum. Scattered ids
    ;      give a compare chain and the whole win disappears into it (measured
    ;      twice, one level up). That is why the twenty-four constants are
    ;      renumbered to 0..24 (11 is one of the six historic holes) and why
    ;      moving one of them out of that range is not a cosmetic change.
    ;
    ;  (b) NO ARM HERE MAY DEMAND THE CALLER PAGE. Every
    ;      `InterpreterMessages.<tag>()` accessor allocates its MessageType on the
    ;      caller page, and ONE such call anywhere in a body gives the whole body
    ;      a region frame — two stores at entry plus a load, a branch and an
    ;      inlined release test at every return, paid by every entry. The four
    ;      `*_error` helpers above exist for exactly that reason: they build the
    ;      message one frame deeper. Adding an arm that allocates on its own
    ;      region undoes this silently; the check is one `stp xzr, xzr` in the
    ;      prologue of the disassembled `Primitive::dispatch`.
    procedure dispatch(id: int, mutable name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], mutable ctx: ref[VM], mutable interp: ref[Interpreter], mutable loc: Location) @page true @returnpage true returns ref[ELObj] io reads msg_prog linked

    procedure dispatch_rest(id: int, mutable name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], mutable ctx: ref[VM], mutable interp: ref[Interpreter], mutable loc: Location) @page true @returnpage true returns ref[ELObj] io reads msg_prog linked

    ; --- the time family (primitive.cxx:1571, 5191-5280) --------------------
    ;
    ; DEFPRIMITIVE TimeToString — an exact integer, optionally a second
    ; argument selecting gmtime. The reference's gate is
    ; `argc > 1 && argv[1] != interp.makeFalse()`, so an explicit #f means
    ; LOCAL time, like no second argument at all.
    procedure time_to_string(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; DEFTIMECOMP (primitive.cxx:5265) — the four comparisons over timeConv.
    ; op: 0 `<`, 1 `>`, 2 `<=`, 3 `>=`.
    ; ★The reference calls timeConv FOUR times per comparison (twice to test
    ; for the error value, twice more inside the comparison itself); one call
    ; per argument is the same answer, since timeConv is a pure function of
    ; its string plus the wall clock, which only the defaults of the
    ; time-of-day form read at all.
    procedure time_compare(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], loc: Location, op: int) returns ref[ELObj] io reads msg_prog linked

    ; Interpreter::convertGlyphId — split a trailing "::<digits>" suffix (the
    ; digit run must not start with '0' and must be non-empty), then store the
    ; public id: chars >= 128 message invalidPublicIdChar and are dropped
    ; (storePublicId).
    procedure convert_glyph_id(host: ref[Page], mutable interp: ref[Interpreter], s: StringC, loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; the glyph-subst-table primitive — a list of (old-gid . new-gid) pairs
    ; flattened into the table's pair sequence.
    procedure glyph_subst_table_prim(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable a0: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; PrimitiveObj::argError (Insn.cxx:592): report the offending argument
    ; with the primitive's name, the 1-based ordinal, and the printed object,
    ; then yield the error object. The C++ suppression arm (a node-list whose
    ; suppressError() is true) is only ever taken for the lazy MapNodeListObj;
    ; our node-list-map is eager and yields plain node-lists, so no
    ; suppression here.
    procedure arg_error(mutable interp: ref[Interpreter], loc: Location, mt: MessageType, name: ref[Identifier]?, index: int, mutable obj: ref[ELObj]) returns ref[ELObj] io reads msg_prog linked

    ; The reference's inline `setNextLocation + message + makeError` shape
    ; (outOfRange, divideBy0, ...).
    procedure simple_error(mutable interp: ref[Interpreter], loc: Location, mt: MessageType) returns ref[ELObj] io reads msg_prog linked

    ; --- list helpers ------------------------------------------------------
    function build_list(host: ref[Page], interp: ref[Interpreter], args: pointer[pointer[ELObj]], n_args: int) returns ref[ELObj] linked

    procedure list_length(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], loc: Location) returns ref[ELObj]? io reads msg_prog linked

    procedure append_lists(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns ref[ELObj] io reads msg_prog linked

    procedure reverse_list(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    procedure list_ref(mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable list: ref[ELObj], mutable k_obj: ref[ELObj], loc: Location) returns ref[ELObj]? io reads msg_prog linked

    ; mode: 0 memq (eq/eqv-ptr), 1 memv (eqv), 2 member (equal).
    procedure member_of(mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], mutable list: ref[ELObj], mode: int, loc: Location) returns ref[ELObj]? io reads msg_prog linked

    ; assoc: DEFPRIMITIVE(Assoc) — the alist lookup, comparing with
    ; ELObj::equal (there is no assq/assv in the reference). A non-pair
    ; ELEMENT is notAnAlist, a non-pair non-nil TAIL is notAList; both point
    ; at argument 2.
    procedure assoc(mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], mutable list: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; --- numeric core ------------------------------------------------------
    ; Accumulate args as exact-long while all operands are exact, promoting to
    ; double on the first inexact. Dimensions are not tracked in the starter
    ; set (numbers assumed dimensionless); length/quantity dims join later.
    ; a dimensioned arithmetic result (the DEFPRIMITIVE tails): exact — dim 0
    ; integer, dim 1 length, else promoted to an inexact quantity; inexact —
    ; dim 0 real, else quantity.
    function quantity_result(host: ref[Page], is_double: bool, l: int, d: double, dim: int) returns ref[ELObj] linked

    ; signed-64 overflow predicates (the reference's LONG_MIN/LONG_MAX
    ; guards); overflow promotes the accumulation to double.
    function add_overflows(a: int, b: int) returns bool linked

    ; neg_low32: the reference's `-(unsigned)x` — and `unsigned` there is
    ; `unsigned INT`, i.e. 32 bits, not `unsigned long`. So it truncates x to
    ; its low 32 bits, negates within 32 bits, and the result reads back as a
    ; non-negative value. That is NOT |x|: for |x| >= 2^32 the high bits are
    ; gone, and that loss is part of the behaviour the goldens encode. Kept as
    ; its own function so the artifact is named once and used twice.
    function neg_low32(x: int) returns int linked

    ; mul_overflows mirrors primitive.cxx:948-957 case by case. ★The two
    ; mixed-sign arms ALWAYS report overflow, and that is faithful, not a
    ; shortcut: the reference divides by `-(unsigned)LONG_MIN`, which with the
    ; 32-bit cast above is **0**, so its right-hand side is `0 / something` = 0
    ; and any nonzero left side exceeds it. That is why the reference prints
    ; `(* 1000000 -1000000)` as `-1e+12` (the double fallback) while keeping
    ; `(* -1000000 -1000000)` exact — an asymmetry that looks like a slip and
    ; is the specification. Pinned by tests/dazzle/prims num6, whose golden is
    ; minted from the reference binary.
    ;
    ; History worth keeping: the port used to write these four cases with a
    ; `minv` bound taken from a HEX literal, which defaults to u64. That made
    ; every division here unsigned (emit_intrinsic_binary_op reads signedness
    ; off the LEFT operand), and the both-negative arm then claimed an overflow
    ; that was not there — `(* -1000000 -1000000)` came out `1e+12`. Fixing
    ; only the signedness swung it too far the other way (both mixed-sign arms
    ; then stayed exact, where the reference promotes). Only the case-by-case
    ; mirror gets all four right.
    ;
    ; Not replicated: the reference divides by `-(unsigned)b`, which is 0 when
    ; b's low 32 bits are 0 (b = -2^32 and friends) — a division by zero in the
    ; reference itself. We answer `true` there rather than trap.
    function mul_overflows(a: int, b: int) returns bool linked

    ; the length-spec accumulation path of Plus/Minus (primitive.cxx `spec`
    ; branch): component-wise over the engine 3-vector; every plain-quantity
    ; operand must be dimension 1. `negate_rest` = Minus (args past the first
    ; subtract; a sole arg negates).
    procedure arith_spec(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location, negate_rest: bool) returns ref[ELObj] io reads msg_prog linked

    ; the length-spec scaling path of Multiply/Divide: only the FIRST arg may
    ; be a length-spec; the rest scale it as plain reals. QUIRK kept: the
    ; not-a-number error always reports argument 1 (argv[1]) whatever i is.
    procedure arith_spec_scale(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location, divide: bool) returns ref[ELObj] io reads msg_prog linked

    ; Plus (primitive.cxx): all args must share ONE dimension
    ; (incompatibleDimensions otherwise); exact stays exact unless an inexact
    ; arg or overflow promotes. A length-spec operand diverts the whole sum
    ; onto the spec path (dimension checks of the scanned prefix included).
    procedure arith_add(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; Multiply (primitive.cxx): dimensions ADD; an exact product whose
    ; dimension exceeds 1 (or overflows) is promoted to an inexact quantity.
    procedure arith_mul(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; Minus (primitive.cxx): like Plus — one shared dimension; a length-spec
    ; operand diverts onto the spec path (later args subtract; a sole arg
    ; negates).
    procedure arith_sub(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; Divide (primitive.cxx): dimensions SUBTRACT; an exact quotient stays
    ; exact only for dimensionless divisors that divide evenly (dividing BY a
    ; dimensioned quantity — lengths are inexact — promotes to double).
    procedure arith_div(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; op: 0 =, 1 <, 2 >, 3 <=, 4 >=. Chain comparison over adjacent operands.
    procedure compare(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location, op: int) returns ref[ELObj] io reads msg_prog linked

    ; test: 0 zero?, 1 positive?, 2 negative?.
    procedure sign_test(mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], loc: Location, test: int) returns ref[ELObj] io reads msg_prog linked

    ; parity: 1 odd?, 0 even?.
    procedure parity_test(mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], loc: Location, want_odd: int) returns ref[ELObj] io reads msg_prog linked

    procedure abs_val(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; op: 0 modulo, 1 remainder, 2 quotient.
    procedure int_div(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable a: ref[ELObj], mutable b: ref[ELObj], loc: Location, op: int) returns ref[ELObj] io reads msg_prog linked

    ; --- string primitives -------------------------------------------------
    ; string-append: concatenate the string-data of every argument.
    procedure string_append(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns ref[ELObj] io reads msg_prog linked

    procedure string_ref(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], mutable k_obj: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    procedure substring(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], mutable s_obj: ref[ELObj], mutable e_obj: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; string: build a string from char arguments.
    procedure string_from_chars(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; mode: 0 string=?, 1 string<?, 2 string<=?.
    ; string=? is a plain code-point comparison; string<? and string<=? are
    ; COLLATING and therefore GETCURLANG-gated, exactly like char<? / char<=?.
    ; mode: 0 string=?, 1 string<?, 2 string<=?.
    procedure string_compare(mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable a: ref[ELObj], mutable b: ref[ELObj], loc: Location, mode: int, ctx: ref[VM]) returns ref[ELObj] io reads msg_prog linked

