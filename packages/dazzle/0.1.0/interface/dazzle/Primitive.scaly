    procedure list_to_string(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; string->number: parse in the given radix (default 10). Non-numeric → #f.
    procedure string_to_number(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns ref[ELObj] io reads msg_prog linked

    function parse_integer(host: ref[Page], interp: ref[Interpreter], s: StringC, radix: int) returns ref[ELObj] linked

    function parse_real(host: ref[Page], interp: ref[Interpreter], s: StringC) returns ref[ELObj] linked

    ; number->string: print with radix (2/8/10/16 only; else radix 10).
    procedure number_to_string(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; --- format-number (primitive.cxx formatNumberLetter/Decimal/Roman) ----
    ; formatNumberLetter — 1->a, 26->z, 27->aa; 0 -> "0"; a negative value
    ; appends '-' before the final segment reversal (so it ends up first).
    procedure format_number_letter(n: int, letters: Slice[char], mutable out: ref[Array[u32]]) linked

    ; formatNumberDecimal — zero-padded to min_width digits; the '-' does not
    ; count toward the width.
    procedure format_number_decimal(n: int, min_width: size_t, mutable out: ref[Array[u32]]) linked

    ; formatNumberRoman — out of range (|n| > 5000 or 0) falls back to plain
    ; decimal. letters = "mdclxvi" / "MDCLXVI"; the pointer advances 2 per
    ; decade so [0]=subtractive base, [1]=five-unit, [2]=one-unit.
    procedure format_number_roman(n: int, letters: Slice[char], mutable out: ref[Array[u32]]) linked

    ; formatNumber — dispatch on the LAST char of the format string; an
    ; unrecognized format falls back to plain decimal and returns false
    ; (the caller emits invalidNumberFormat but keeps the result).
    procedure format_number(n: int, fmt: StringC, mutable out: ref[Array[u32]]) returns bool linked

    ; format-number (FormatNumber)
    procedure format_number_prim(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; format-number-list (FormatNumberList) — formats/seps may each be a
    ; single string (reused) or a list consumed in step; the reference's
    ; arg-index quirk on a non-string format element (index 0) is kept.
    procedure format_number_list_prim(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; --- char primitives ---------------------------------------------------
    procedure integer_to_char(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; mode: 0 char=?, 1 char<?, 2 char<=?.
    ; GETCURLANG (primitive.cxx:4639) — the context's language, else the
    ; declared default IF that is a language; null = the caller must report
    ; noCurrentLanguage and return the error object. Every collating
    ; primitive is gated on this, `char=?` alone excepted.
    function current_lang(interp: ref[Interpreter], ctx: ref[VM]) returns ref[ELObj]? linked

    procedure no_current_language(mutable interp: ref[Interpreter]) returns ref[ELObj] io reads msg_prog linked

    ; LangObj::compare (LangObj.cxx:322) — the collating comparison of a
    ; define-language value, at collating strength `k`. ★A language with no
    ; `collate` clause has ZERO levels, so the loop body never runs and
    ; compare is 0 for EVERY pair: `char<?` is then always #f, `char<=?`
    ; always #t and `string-equiv?` always #t, whatever the code points say.
    ; Measured against the reference.
    ; The temporaries (collating-element and weight strings) go on the
    ; CALLER's host — a comparison must not allocate on the language's own
    ; run-arena page, or a sort loop grows the arena per comparison.
    function lang_compare(host: ref[Page], lang: ref[ELObj], a: StringC, b: StringC, k: u32) returns int linked

    function lang_levels(lang: ref[ELObj]) returns u32 linked

    ; char=? never consults a language; char<? and char<=? always do.
    ; mode: 0 char=?, 1 char<?, 2 char<=?.
    procedure char_compare(mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable a: ref[ELObj], mutable b: ref[ELObj], loc: Location, mode: int, ctx: ref[VM]) returns ref[ELObj] io reads msg_prog linked

    ; string-equiv?: DEFPRIMITIVE(StringEquiv) — equivalence at collating
    ; strength k (a POSITIVE exact integer).
    procedure string_equiv(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; with-language: DEFPRIMITIVE(WithLanguage) — bind the context language
    ; around a THUNK (a procedure taking nothing at all, like
    ; map-constructor's) and restore it afterwards, error or not.
    procedure with_language(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable lang: ref[ELObj], mutable f: ref[ELObj], mutable ctx: ref[VM], mutable loc: Location) @page true @returnpage true returns ref[ELObj] io reads msg_prog linked

    ; char-upcase / char-downcase — GETCURLANG, then the language's case
    ; tables (define-language pairs; a miss is identity, so sf latin1 folds
    ; the umlauts and nothing else). ★Without a language this now reports
    ; noCurrentLanguage like the reference: the ASCII fallback this port used
    ; to apply was a marked deviation, and it is closed — a stylesheet that
    ; wants ASCII folding has to declare a language that says so, exactly as
    ; the reference demands.
    procedure char_case(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], loc: Location, up: bool, ctx: ref[VM]) returns ref[ELObj] io reads msg_prog linked

    ; --- vector primitives -------------------------------------------------
    procedure make_vector_prim(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns ref[ELObj] io reads msg_prog linked

    procedure vector_ref(mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], mutable k_obj: ref[ELObj], loc: Location) returns ref[ELObj]? io reads msg_prog linked

    procedure vector_set(mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], mutable k_obj: ref[ELObj], val: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; vector-fill!: DEFPRIMITIVE(VectorFill) — every slot takes argument 2.
    ; ★The reference's readOnly gate is NOT reproduced: readOnly is a
    ; COLLECTOR bit (Collector.h:20, set by makePermanent and the tracing
    ; pass), and this port has no collector — the same reason vector-set!
    ; carries no such check. Nothing in the language can observe the bit
    ; other than by mutating a permanent object, which our object model does
    ; not distinguish.
    procedure vector_fill(mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], val: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; quantity->number: DEFPRIMITIVE(QuantityToNumber) — a DIMENSIONLESS
    ; quantity passes through with its exactness; a dimensioned one is scaled
    ; into METRES per dimension and always comes back inexact. (The reference
    ; carries a FIXME here about what "the number of the quantity" even means;
    ; the arithmetic is ported as written.)
    procedure quantity_to_number(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; quantity->string: DEFPRIMITIVE(QuantityToString) — number->string with
    ; the quantityValue gate instead of the realValue one, so it prints what
    ; number->string refuses (a length as "1pt1", an area as "1pt2").
    procedure quantity_to_string(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; map-constructor: DEFPRIMITIVE(MapConstructor) — call a ZERO-argument
    ; procedure once per node of the list, with that node as the current
    ; node, and append the sosofos it returns. The arity gate is the mirror
    ; image of node-list-map's: here totalArgs() must be 0, i.e. the
    ; procedure may take NOTHING (a required OR optional parameter is
    ; tooManyArgs).
    procedure map_constructor(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable f: ref[ELObj], mutable nl: ref[ELObj], ctx: ref[VM], mutable loc: Location) returns ref[ELObj] io reads msg_prog linked

    procedure vector_to_list(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    procedure list_to_vector(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; list-tail: drop the first k pairs.
    procedure list_tail(mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], mutable k_obj: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; --- grove / node-list helpers -----------------------------------------
    procedure node_list_ref(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable nl: ref[ELObj], mutable k_obj: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; node-list: concatenate the argument node-lists into one buffer.
    procedure node_list_concat(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; children: the child axis of the first node (empty if none / not present).
    ; children: DEFPRIMITIVE(Children) — a singleton yields the node's child
    ; list; a NON-singleton node-list maps `children` over every member and
    ; appends (the reference wraps itself in a MapNodeListObj), so nested
    ; `(children (children nl))` flattens across all members.
    procedure children(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable nl: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; Node::getGi — accessOK for the THREE classes that implement it: an ELEMENT
    ; (its chunk's type name), an ELEMENT-TYPE and an ELEMENT-TOKEN (their
    ; declared names). Several primitives use getGi as a GATE (gi,
    ; first-sibling?, last-sibling?), so the test has to name all three —
    ; measured: `(gi <element-type>)` is "DOC" and `(gi <entity>)` is #f.
    function node_has_gi(node: ref[GroveNode]) returns bool linked

    function gi_of(node: ref[GroveNode]) @page true @direct true returns StringC linked

    ; gi: the generic identifier of the first node, else #f.
    procedure node_gi(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable nl: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; The node-taking core. DEFPRIMITIVE(Gi) works on a `NodePtr` and never
    ; builds a node-list at all (style/primitive.cxx:2908); the port's zero-arg
    ; arm used to wrap the current node in a singleton purely to hand it to
    ; node_gi, which extracted it again on the next line — one ELObj built,
    ; read once and dropped, on 296 801 calls of a styling run.
    function gi_of_node(host: ref[Page], interp: ref[Interpreter], node: ref[GroveNode]?) returns ref[ELObj] linked

    ; data: the string value — the concatenated descendant data of EVERY
    ; member of the node list (DEFPRIMITIVE(Data) loops nodeListFirst/
    ; nodeListChunkRest, appending nodeData per node into ONE StringObj;
    ; the earlier first-node-only reading dropped the tail members of
    ; multi-<return> sprocs).
    procedure node_data(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable nl: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; --- property axis (Inc 4) ---------------------------------------------
    ; A GI / attribute-name argument may arrive as a string or a symbol; both
    ; carry a name StringC (else empty). Single construction site + one tail
    ; return (a by-value struct returned from multiple branches region-allocates
    ; per site and the merging phi fails llc verification).
    procedure name_arg(host: ref[Page], mutable obj: ref[ELObj]) @page true @direct true returns StringC linked

    ; parent: the parent AXIS of the first node — empty node-list when the axis
    ; has no parent (DEFPRIMITIVE(Parent): `getParent != accessOK ->
    ; makeEmptyNodeList`). ChunkNode::getParent stops at the document element,
    ; so the sgml-document node is not reachable here; see get_axis_parent.
    procedure node_parent(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable nl: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; attribute-string: the value of the named attribute on the first node of
    ; the node-list arg, as a string — or #f when the attribute is absent.
    ; Faithful to nodeAttributeString / DEFPRIMITIVE(AttributeString): read
    ; arg0 as the attribute name, look it up in the node's attribute list, and
    ; return its text. The reference's 1-arg (current-node) form needs a
    ; current-node context, not yet modeled here, so the node-list is required.
    ; Name lookup is AttrLookup.index_ci — the case-insensitive approximation
    ; of normalizeGeneralName for both namecase regimes (a lowercase name
    ; matches an upper-folded SGML grove AND an as-is XML grove).
    procedure attribute_string(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable name_obj: ref[ELObj], mutable nl: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; select-elements: the members of a node-list matching a pattern (a GI
    ; string/symbol, #t, or an ancestor/attribute-qualifier list). Faithful to
    ; DEFPRIMITIVE(SelectElements) — convertToPattern the 2nd arg, filter the
    ; node-list. (Inc 5: unblocked by the Pattern type.)
    procedure select_elements(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable nl: ref[ELObj], mutable pat_obj: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; element-with-id: the element in the grove whose ID-typed attribute equals
    ; the given string, as a singleton node-list (empty if none). DEFPRIMITIVE
    ; (ElementWithId): the optional 2nd arg NAMES THE GROVE to search — a strict
    ; singleton whose grove root's `elements` list answers; without it the
    ; current node's grove, and no current node is a hard diagnostic.
    procedure element_with_id(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; ancestor: the nearest ancestor element of the first node whose GI equals
    ; the given name, or the empty node-list. The GI compare is GiMatch —
    ; convertGeneralName normalizes the argument per the grove's namecase.
    procedure ancestor(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable gi_obj: ref[ELObj], mutable nl: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; descendants: every descendant, in document order (self excluded).
    ; DEFPRIMITIVE(Descendants) — like children, a non-singleton node-list
    ; maps itself over the members.
    procedure descendants(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable nl: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; the subtree in document order as CHUNK-LEVEL members, materialized in one
    ; go. `descendants` itself is lazy (ELObj.emit_descendant is the same walk
    ; one node at a time); this stays for the callers that need the whole set
    ; anyway — the CHILDREN AXIS, so a data chunk is a member but not a parent.
    procedure collect_descendants(host: ref[Page], mutable node: ref[GroveNode], mutable arr: ref[Array[ref[GroveNode]?]]) linked

    ; id: the node's unique identifier — the value of its ID-typed attribute —
    ; or #f. DEFPRIMITIVE(Id): the optional arg is an opt-singleton node-list
    ; (an empty one yields #f); without it the current node, whose absence is
    ; the noCurrentNode error.
    procedure node_id(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; The 0/1-arg singleton-node resolution shared by first-sibling? /
    ; last-sibling? / child-number (DEFPRIMITIVE arg handling: a present arg
    ; must resolve to a NON-empty singleton, absent means the current node).
    ; Returns null when an error object must be produced instead; err_kind
    ; distinguishes the two error shapes (0 = notASingletonNode on the arg,
    ; 1 = noCurrentNode).
    procedure singleton_node_arg(n_args: int, mutable args: pointer[pointer[ELObj]], ctx: ref[VM]) returns ref[GroveNode]? linked

    ; first-sibling?: no preceding sibling element shares the node's GI.
    ; DEFPRIMITIVE(IsFirstSibling): a node whose GI is inaccessible (a
    ; non-element) is #f; siblings without a GI (data/pi chunks) are skipped.
    procedure is_first_sibling(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], mutable ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; last-sibling?: no following sibling element shares the node's GI.
    ; DEFPRIMITIVE(IsLastSibling).
    procedure is_last_sibling(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], mutable ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; child-number: the 1-based position of the node among the siblings with
    ; the same GI. DEFPRIMITIVE(ChildNumber) via NumberCache::childNumber
    ; (semantics without the cache): a GI-less node is #f, the document
    ; element (no parent) is 1, else 1 + the count of preceding same-GI
    ; sibling elements.
    procedure child_number(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], mutable ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; the optional-singleton decode at arg index k for the strict (`|| !node
    ; -> notASingletonNode`) query primitives; without the arg, the current
    ; node. The CALLER must have verified the arg/current-node preconditions
    ; (mirroring singleton_node_arg's contract).
    procedure singleton_node_arg_at(n_args: int, mutable args: pointer[pointer[ELObj]], k: int, ctx: ref[VM]) returns ref[GroveNode]? linked

    ; the same-GI ordinal among the node's preceding siblings, 1-based
    ; (NumberCache::childNumber + the primitive's +1; document element = 1).
    procedure same_gi_sibling_ordinal(mutable node: ref[GroveNode]) returns int linked

    ; have-ancestor?: DEFPRIMITIVE IsHaveAncestor. The string form walks the
    ; parent axis for a GI match (convertGeneralName -> namecase-insensitive
    ; GiMatch); the list form is matchAncestors — the ancestor chain, OUTERMOST
    ; first, must consume the whole pattern list (non-consecutive matches
    ; allowed); a non-list / non-string member is the notAList arg error.
    procedure have_ancestor(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; inherited-attribute-string: the named attribute on the node or its
    ; nearest ancestor carrying a value for it (DEFPRIMITIVE
    ; InheritedAttributeString — the do/while getParent walk). An explicit
    ; EMPTY osnl is #f, not an error (notAnOptSingletonNode gate).
    procedure inherited_attribute_string(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; inherited-element-attribute-string: DEFPRIMITIVE
    ; (InheritedElementAttributeString) — inherited-attribute-string narrowed
    ; to a GI: the walk climbs the parent axis and takes the attribute from
    ; the first node that BOTH has that GI and has the attribute. ★An empty
    ; explicit node-list is #f, not a diagnostic (the opt-singleton form).
    procedure inherited_element_attribute_string(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; match-element?: DEFPRIMITIVE(IsMatchElement) — does the pattern of
    ; argument 1 match the singleton of argument 2. ★Unlike its neighbours
    ; the node argument is REQUIRED and strict: an empty node-list is the
    ; notASingletonNode diagnostic.
    procedure is_match_element(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable pat_obj: ref[ELObj], mutable nl: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; merge-style: DEFPRIMITIVE(MergeStyle) — a StyleObj that expands to its
    ; arguments IN ORDER when the style stack walks it (MergeStyleObj::
    ; appendIter), so the FIRST argument's specifications win. Zero arguments
    ; are legal and yield an empty style.
    procedure merge_style(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; sosofo-label / sosofo-discard-labeled: DEFPRIMITIVE(SosofoLabel) /
    ; (SosofoDiscardLabeled) — the procedural spellings of the `label:`
    ; keyword and its opposite. Same argument gates; `discard` picks the
    ; sosofo kind whose processing drops what connects to the label.
    procedure sosofo_label(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable so: ref[ELObj], mutable sym: ref[ELObj], loc: Location, discard: bool) returns ref[ELObj] io reads msg_prog linked

    ; process-first-descendant / process-matching-children: DEFPRIMITIVE
    ; (ProcessFirstDescendant) / (ProcessMatchingChildren) — both take a REST
    ; of patterns and process what matches ANY of them.
    ; ★process-first-descendant filters the DESCENDANTS — the node itself
    ; excluded, because DescendantsNodeListObj advances once in its own
    ; constructor — and processes only the FIRST hit; process-matching-
    ; children filters the children axis and processes ALL hits. ★With no
    ; patterns at all,
    ; process-matching-children is the empty sosofo outright, while
    ; process-first-descendant runs a zero-pattern filter that matches
    ; nothing — same result by a different road.
    procedure process_matching(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], mutable ctx: ref[VM], loc: Location, first_descendant: bool) returns ref[ELObj] io reads msg_prog linked

    ; absolute-first-sibling?: no ELEMENT sibling precedes the node
    ; (DEFPRIMITIVE IsAbsoluteFirstSibling — data/PI siblings don't count;
    ; a parentless node is #f via the failing firstSibling).
    procedure absolute_first_sibling(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], mutable ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; absolute-last-sibling?: no ELEMENT sibling follows the node
    ; (DEFPRIMITIVE IsAbsoluteLastSibling; a parentless node has no
    ; following siblings, so #t).
    procedure absolute_last_sibling(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], mutable ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; hierarchical-number-recursive: the child-number of every ancestor
    ; matching the GI, outermost first (DEFPRIMITIVE
    ; HierarchicalNumberRecursive — the upward walk PREPENDS, so higher
    ; levels end up at the list head).
    procedure hierarchical_number_recursive(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], mutable ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; The shared prologue of the numbering primitives whose OPTIONAL node is
    ; argument `idx`: a strict singleton there, the current node otherwise.
    ; Returns null when the gate passes, else the object to return.
    procedure number_node_gate(mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], ctx: ref[VM], loc: Location, idx: int) returns ref[ELObj]? io reads msg_prog linked

    ; ancestor-child-number: DEFPRIMITIVE(AncestorChildNumber) — the
    ; child-number of the NEAREST ancestor with that GI, 1-based, #f when
    ; there is none. ★The walk starts at the PARENT: the reference's loop
    ; condition reassigns the node before testing the GI, so a node is never
    ; its own ancestor here.
    procedure ancestor_child_number(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], mutable ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; hierarchical-number: DEFPRIMITIVE(HierarchicalNumber) — one number per
    ; GI in the argument list, OUTERMOST first. The reference walks the list
    ; reversed (innermost GI first) and consumes the ancestor chain as it
    ; goes, so each GI is resolved against what is left ABOVE the previous
    ; match — and ★once the walk runs out of ancestors every remaining GI
    ; scores 0, rather than the whole call failing.
    procedure hierarchical_number(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], mutable ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; element-number-list: DEFPRIMITIVE(ElementNumberList) — for the GI list
    ; (g0 g1 ... gk), the numbers (n0 n1 ... nk) where n0 is the PLAIN
    ; element-number of g0 and every later ni counts gi occurrences since the
    ; last g(i-1). ★So the list reads outermost-to-innermost and each level
    ; is reset by the level BEFORE it: for `("chap" "sec" "p")` at the second
    ; paragraph of the first section of chapter two the answer is (2 1 2) —
    ; chapter 2 outright, section 1 within it, paragraph 2 within that. The
    ; reference reaches this by reversing the list and pairing each entry
    ; with its SUCCESSOR in the reversal, which is its predecessor here.
    procedure element_number_list(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], mutable ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; first-child-gi: DEFPRIMITIVE(FirstChildGi) — the GI of the first CHILD
    ; that has one, scanning chunk-siblings until one answers. ★Its node
    ; argument is the FIRST one and is an OPT singleton: an EMPTY node-list
    ; is #f, not a diagnostic (notAnOptSingletonNode is only for a non-list).
    procedure first_child_gi(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; element-number: the node's ordinal among the same-GI elements in
    ; document order, 1-based (NumberCache::elementNumber — `interp` owns the
    ; cache, exactly as the reference derives Interpreter from it). A
    ; non-element is #f.
    procedure element_number(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], mutable ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; preced: the preceding siblings of each member, in order (DEFPRIMITIVE
    ; Preced — SiblingNodeListObj from firstSibling up to the node; a
    ; non-singleton arg maps itself over the members à la MapNodeListObj).
    procedure preced_prim(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable nl: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; The first character a DATA member of a node-list contributes to `data`:
    ; a character VIEW stands for exactly its own character, a chunk for its
    ; whole run — and member 0 starts past whatever a preceding node-list-rest
    ; already consumed (node_list_member_skip).
    function data_member_first(node: ref[GroveNode], index: int, skip: int) returns size_t linked

    ; How many characters that member contributes. ★The two `data` rules are
    ; asymmetric and this is where the asymmetry lives: in a PLAIN node-list a
    ; data member is one per-character node and contributes exactly ITS
    ; character (measured: `(data (node-list-first (children p)))` = "F", even
    ; though that node IS the chunk — the index-0 view); only in an EXPANDED
    ; list does a chunk member stand for its whole run, because there the
    ; run's other characters have no member of their own. A character VIEW is
    ; one character either way.
    function data_member_len(node: ref[GroveNode], index: int, skip: int, expanded: bool) returns size_t linked

    ; process-element-with-id: process the element carrying the ID, in the
    ; current mode (DEFPRIMITIVE ProcessElementWithId — the grove-root
    ; elements index; unknown id = the empty sosofo).
    procedure process_element_with_id(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable a0: ref[ELObj], ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; --- the grove DTD's general-entity axis (groveRoot getEntities) --------
    ; entity-public-id / entity-generated-system-id / entity-notation query
    ; the document DTD's general entities (installed on the Interpreter by the
    ; CLI after the parse). Entity names are NOT namecase-folded here: the
    ; reference folds per NAMECASE ENTITY, which is NO in every corpus
    ; declaration (XML and the reference SGML default alike).
    procedure entity_arg_node_gate(mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], ctx: ref[VM], loc: Location, mutable out_node: ref[ref[GroveNode]?]) returns ref[ELObj]? io reads msg_prog linked

    ; The entity these primitives name. Every one of them spells the lookup
    ; `getGroveRoot -> getEntities -> namedNode`, so it is the sgml-document
    ; `entities` NAMED NODE LIST that answers — and that list carries the
    ; DEFAULTED-ENTITY FALLBACK (DocEntitiesNodeList::namedNode). ★So a
    ; PARAMETER entity is findable here although it is not a general entity
    ; and not a member of the list: the grove's defaulted-entity table is fed
    ; from every successful entity lookup of the parse, parameter entities
    ; included. Measured — `(entity-type "pent")` is `text`, not #f. Entity
    ; names are NOT case-folded (the entity substitution table is identity
    ; unless NAMECASE ENTITY says otherwise), which is why the plain name
    ; comparison is right here and wrong for notations below.
    function grove_entity(node: ref[GroveNode]?, nm: StringC) returns ref[Entity]? linked

    ; the governing DTD's notation of that name (Dtd::lookupNotationTemp),
    ; the name taken AS GIVEN — the one caller is the attribute-value-token
    ; `notation` property, whose token the parser already normalized.
    function grove_notation(node: ref[GroveNode]?, nm: StringC) returns ref[Notation]? linked

    ; ★The three notation-*-id primitives reach the notation through the
    ; `notations` NAMED NODE LIST, which folds the queried name with the
    ; GENERAL substitution table — so `(notation-system-id "tiff")` finds the
    ; notation declared as `tiff` and stored under `TIFF`. Without the fold
    ; every lowercase notation name missed.
    function grove_notation_named(node: ref[GroveNode]?, host: ref[Page], interp: ref[Interpreter], nm: StringC) returns ref[Notation]? linked

    ; --- the ATTRIBUTE axis --------------------------------------------------

    ; ElementNode::getAttributes — the attribute assignments of one element as a
    ; NAMED node list. Its members are views (GroveNode.attr_views), so building
    ; the list costs one array; the naming folds queries through the GENERAL
    ; substitution table (AttributesNamedNodeList passes generalSubstTable).
    procedure make_attributes_list(host: ref[Page], mutable elem: ref[GroveNode]) returns ref[ELObj] linked

    ; the children AXIS of one node as a character-expanded node-list — the
    ; shape `content` and an assignment's `value` both hand out.
    procedure axis_children_list(host: ref[Page], mutable node: ref[GroveNode]) returns ref[ELObj] linked

    ; DEFPRIMITIVE(Attributes) — the attributes of a SINGLETON node as a named
    ; node list; an empty argument answers itself, and a MULTI-node list maps
    ; the property over its members (MapNodeListObj), which is an ordinary
    ; node-list, not a named one.
    procedure attributes_prim(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; DEFPRIMITIVE(NamedNode) — the member of a named node list whose name
    ; matches, the query folded through the list's substitution table first.
    ; A miss is the EMPTY node-list (NodePtrNodeListObj over a null NodePtr).
    procedure named_node_prim(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable a0: ref[ELObj], mutable a1: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; DEFPRIMITIVE(NamedNodeListNames) — the members' names, in order, as a list
    ; of strings (a member without a name is skipped, as nodeName failing is).
    procedure named_node_list_names(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable a0: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; DEFPRIMITIVE(NamedNodeListNormalize) — (string nnl symbol): the string
    ; folded through the list's substitution table. The third argument only has
    ; to BE a symbol (the reference checks and then ignores it).
    procedure named_node_list_normalize(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; The name a NAMED node list answers to for one member — `named-node`
    ; compares against this and `named-node-list-names` collects it.
    ; NamedNodeList::nodeName (grove/Node.cxx:727) dispatches on the pair (LIST
    ; TYPE, node class) through NodeNameNodeVisitor, and the two disagree in one
    ; place that matters: in an `elements` list an element answers with its ID,
    ; everywhere else with its GI. A member whose class does not occur in the
    ; list type answers accessNotInClass, which the two callers skip — modelled
    ; as the empty name.
    function named_member_name(node: ref[GroveNode]?, named: int) @page true @direct true returns StringC linked

    ; BaseNamedNodeList::normalize — fold every character through the list's
    ; substitution table. Every list type but the ENTITY ones folds through the
    ; parse's GENERAL subst table (upper folding under NAMECASE GENERAL YES,
    ; identity for XML); the entity lists use the entity table, which every
    ; declaration in reach leaves at identity (NAMECASE ENTITY NO).
    ; ★The general table is the PARSE's, held by the queried node's own GROVE —
    ; not a blanket ASCII upper-fold like the GI matcher's documented
    ; approximation.
    ; Answers on `host` through an explicit construction (a StringC RETURNED by
    ; value would allocate its buffer through Page.get(<the return slot>)).
    ; ★`node` null = "no grove nameable from the arguments". The reference always
    ; has one, because the table belongs to the NamedNodeList object itself
    ; (BaseNamedNodeList carries its grove's SubstTable); this port reads it off
    ; a node instead, and an EMPTY named node list has none to offer. The
    ; document grove answers for that case — the only observable difference
    ; would be an empty named list from a grove sgml-parse loaded whose NAMECASE
    ; differs from the document's, and no caller can tell such a list apart from
    ; the document's own. Growing NodeListObj by a grove pointer instead would
    ; widen the whole ELObj union for every value in the engine.
    function nnl_normalize(host: ref[Page], interp: ref[Interpreter], node: ref[GroveNode]?, named: int, s: StringC) returns ref[StringC] linked

    ; widen an opensp byte String (public ids / system ids are minimum-data)
    ; into an ELObj string.
    function make_string_from_bytes(host: ref[Page], s: String) returns ref[ELObj] linked

    procedure entity_public_id(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    procedure entity_generated_system_id(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    procedure entity_notation(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; entity-system-id: DEFPRIMITIVE(EntitySystemId) — getEntities ->
    ; namedNode -> getExternalId -> getSystemId. That is the DECLARED system
    ; identifier (ExternalIdNode::getSystemId reads systemIdString()), NOT the
    ; resolved one entity-generated-system-id returns; an entity declared
    ; without one is accessNull -> #f.
    procedure entity_system_id(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; entity-text: DEFPRIMITIVE(EntityText) — Node::getText, i.e. the
    ; REPLACEMENT TEXT of an internal entity. Every external arm has no text
    ; and answers #f, exactly like an unknown name (the chained accessOK test
    ; makes no distinction between "no such entity" and "not accessible").
    procedure entity_text(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; entity-type: DEFPRIMITIVE(EntityType) — a plain SYMBOL, one of text /
    ; cdata / sdata / ndata / subdocument / pi. ★These are the same six words
    ; the entity-type PROPERTY answers with, but as ordinary symbols: the
    ; property goes through the component-name table and switches spelling
    ; under rcs?, this does not.
    procedure entity_type(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; entity-attribute-string: DEFPRIMITIVE(EntityAttributeString) — the
    ; nodeAttributeString of the named entity's DATA attributes (an NDATA
    ; entity's ATTLIST). #f whenever any link in the chain fails: unknown
    ; entity, no data attributes, unknown attribute, or an IMPLIED one.
    procedure entity_attribute_string(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; entity-name-normalize: DEFPRIMITIVE(EntityNameNormalize) — fold a name
    ; with the ENTITY substitution table of the parse (the same table the
    ; `entities` named node list uses), so it can find `&Logo;` under `logo`
    ; or not, depending on NAMECASE ENTITY. ★Unlike its siblings this one
    ; NEVER answers #f: the reference ignores every access result and
    ; normalizes whatever it was handed.
    procedure entity_name_normalize(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; notation-system-id / -public-id / -generated-system-id: the three
    ; DEFPRIMITIVEs that walk grove root -> governing doctype -> notations ->
    ; named notation -> external id. kind: 0 system, 1 public, 2 generated.
    procedure notation_id(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], ctx: ref[VM], loc: Location, kind: int) returns ref[ELObj] io reads msg_prog linked

    ; round: DEFPRIMITIVE(Round) — floor(d + .5), then corrected to
    ; round-half-to-EVEN (the .5 case that rounded up away from an even
    ; result steps back down). An exact integer is returned UNCHANGED (same
    ; object); anything that is neither an inexact real nor an exact integer
    ; is notANumber. `inexactRealValue` is true for RealObj always and for a
    ; QuantityObj only when its dimension is 0, so a LENGTH errors.
    procedure round_prim(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; --- the numeric / transcendental family --------------------------------
    ;
    ; (double)LONG_MAX. LONG_MAX itself is not representable as a double and
    ; rounds UP to 2^63, so the reference's `fabs(res) < LONG_MAX` compares
    ; against exactly this value.
    function long_max_double() returns double linked

    function fabs_d(x: double) returns double linked

    ; min / max: DEFPRIMITIVE(Min) / (Max) — one shape with the comparison
    ; flipped. The reference runs TWO loops: an exact one over the leading
    ; run of longQuantities, and an inexact one entered as soon as a double
    ; argument WINS. ★The switch-over carries a quirk that is deliberately
    ; reproduced: a double argument that does NOT beat a DIMENSIONED exact
    ; result `break`s the switch (primitive.cxx:1310/1392) and leaves the
    ; accumulator exact — only for dim 0 does a losing double force the
    ; conversion. Every argument must share arg 0's dimension.
    procedure min_max(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location, want_min: bool) returns ref[ELObj] io reads msg_prog linked

    ; floor / ceiling / truncate: DEFPRIMITIVE(Floor) / (Ceiling) /
    ; (Truncate) — the same shape as Round. mode: 0 floor, 1 ceiling,
    ; 2 truncate. The reference's truncate is `modf(d, &iPart)`, i.e. the
    ; integer part toward ZERO — floor above 0, ceil below.
    procedure round_to_integral(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], loc: Location, mode: int) returns ref[ELObj] io reads msg_prog linked

    ; sqrt: DEFPRIMITIVE(Sqrt) — an ODD dimension or a negative value is
    ; outOfRange; the dimension HALVES. ★An exact argument whose root is
    ; exact comes back as an integer, everything else as a QuantityObj —
    ; including the dimensionless case, which is the reference's own choice
    ; (a dim-0 quantity, not a RealObj).
    procedure sqrt_prim(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; exact? / inexact?: DEFPRIMITIVE(IsExact) / (IsInexact) — the quantity
    ; TYPE is the answer; a non-quantity is notAQuantity.
    procedure exactness_test(mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], loc: Location, want_exact: bool) returns ref[ELObj] io reads msg_prog linked

    ; exp / log / sin / cos / tan / asin / acos: the one-argument libm
    ; family. Every one gates on realValue (integers, reals and DIMENSIONLESS
    ; quantities) with notANumber; log and the two arcs add a domain check
    ; that is outOfRange, not a libm NaN.
    ; mode: 0 exp, 1 log, 2 sin, 3 cos, 4 tan, 5 asin, 6 acos.
    procedure transcendental(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], loc: Location, mode: int) returns ref[ELObj] io reads msg_prog linked

    ; atan: DEFPRIMITIVE(Atan) — one argument is plain atan over a
    ; DIMENSIONLESS quantity (a dimensioned one is notANumber); two are
    ; atan2, which allows any dimension as long as BOTH share it.
    procedure atan_prim(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; expt: DEFPRIMITIVE(Expt) — pow over two realValues; the result is an
    ; exact integer only when BOTH arguments were exact integers and it fits
    ; a long.
    procedure expt_prim(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable a: ref[ELObj], mutable b: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; XExpt: the XXPRIMITIVE variant (primitive.h:235), reachable only as
    ; `UNREGISTERED::OpenJade//Procedure::expt` through external-procedure —
    ; the identifier `expt` stays bound to the ISO one above. It is the
    ; DIMENSIONED power: a length raised to an exact integer multiplies the
    ; dimension.
    ;
    ; ★MEASURED REFERENCE DEFECT, ported bug-for-bug where it is DEFINED and
    ; documented where it is not (primitive.cxx:5042): the second quantity is
    ; read from `argv[0]` — `argv[0]->quantityValue(n2, d2, dim2)`, where
    ; every sibling reads argv[1]. Two consequences, both measured against
    ; the reference binary and both reproduced here:
    ;   (xexpt 2.0 3.0) = 4  and  (xexpt 3.0 2.0) = 27   -- argv[0] to its
    ;     OWN power, argv[1]'s value never read;
    ;   (xexpt 2.0 "x") = 4  with NO diagnostic          -- the type guard
    ;     inspects argv[0] too, so it can never fire on argv[1].
    ; The DIMENSIONED branch is unaffected: it reads argv[1] properly and
    ; reports notAnExactInteger.
    ; ★NOT reproduced, because it is undefined behaviour: when argv[0] is an
    ; exact integer or a length, quantityValue never writes the double slot
    ; and the reference powers UNINITIALIZED stack — measured as
    ; `(xexpt 2 3)` = 0 and `(xexpt 2pt 2)` = 0 on this build, which is not a
    ; value any implementation can be held to. This port uses argv[0]'s real
    ; value there, so those two cases diverge by design.
    procedure x_expt_prim(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable a: ref[ELObj], mutable b: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; exact->inexact: DEFPRIMITIVE(ExactToInexact) — an inexact argument is
    ; returned UNCHANGED, an exact one becomes a RealObj.
    ; ★The reference feeds RealObj from `realValue`, which FAILS for a
    ; dimensioned quantity and leaves the double unwritten — `(exact->inexact
    ; 1pt)` reads uninitialized stack there. This port answers with the
    ; port's own realValue result (0.0 for a Length) rather than garbage.
    procedure exact_to_inexact(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; inexact->exact: DEFPRIMITIVE(InexactToExact) — only an inexact value
    ; that is integral, dimensionless and in long range converts; everything
    ; else that is inexact reports noExactRepresentation and then ★FALLS
    ; THROUGH to `return argv[0]` (the C++ case label has no break), so the
    ; primitive yields the ARGUMENT after the error, not an error object.
    procedure inexact_to_exact(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; select-by-class: DEFPRIMITIVE(SelectByClass) — the members of the node
    ; list whose CLASS is the named one. The reference resolves the name
    ; through Interpreter::lookupNodeProperty over the whole RCS component-name
    ; table and hands the id to a lazy SelectByClassNodeListObj that keeps
    ; members with `classDef() == id`; a name that is not a component name at
    ; all yields the empty node list, and one that is a component name but not
    ; a CLASS name matches nothing — so matching the four grove class names and
    ; returning empty otherwise is behaviourally identical.
    procedure select_by_class(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable nl: ref[ELObj], mutable cls: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; follow: DEFPRIMITIVE(Follow) — BaseNode::follow is the FOLLOWING
    ; SIBLINGS (nextSibling, then a SiblingNodeList from there), the exact
    ; mirror of preced. A multi-member argument maps over its members and
    ; concatenates, like preced.
    procedure follow_prim(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable nl: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; general-name-normalize: the string normalized per the grove's general-
    ; namecase (DEFPRIMITIVE GeneralNameNormalize / convertGeneralName) — the
    ; grove being the optional node argument's, else the current node's.
    procedure general_name_normalize(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], ctx: ref[VM], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; convertGeneralName (primitive.cxx:2868) — a GI written in a stylesheet
    ; folded with the ELEMENTS named node list's table, i.e. the general
    ; substitution table of the parse, so `"doc"` matches an element stored
    ; as `DOC`. ★This used to be the IDENTITY here, which made
    ; `general-name-normalize` a no-op and left every GI-matching primitive
    ; below relying on a case-insensitive compare instead of the parse's own
    ; table. Null = the argument had no string data.
    procedure convert_general_name(host: ref[Page], interp: ref[Interpreter], node: ref[GroveNode]?, mutable obj: ref[ELObj]) returns ref[StringC]? linked

    ; read-entity: the entity's decoded text (XPRIMITIVE ReadEntity —
    ; GroveManager::readEntity). The sysid opens as a file relative to the
    ; run's working directory; records normalize to RE (CR / CRLF / LF ->
    ; one 0x0D) exactly like the stylesheet reader; bytes widen 1:1
    ; (ASCII/Latin-1, the stylesheet-reader convention). A failing open is
    ; the error object — the reference reports it through the entity
    ; manager's messenger; we report the plain fact.
    ; a Scheme list of strings -> a byte-String list for the parser's -a/-A
    ; surfaces. Returns null on success, else the argError to return; `argx` is
    ; the 0-based argv index the reference names in the diagnostic.
    procedure decode_string_list(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable obj: ref[ELObj], argx: int, mutable blame: ref[ELObj], mutable out: ref[Array[String]], loc: Location) @page true @direct true returns ref[ELObj]? io reads msg_prog linked

    ; DEFPRIMITIVE SgmlParse (primitive.cxx:4303) and XSgmlParse (:4347) —
    ; groveManager()->load of a second document. The two differ in their key
    ; table only: ISO takes `active:` and `parent:`, the OpenJade-prefixed
    ; extension inserts `architecture:` between them.
    ;
    ; ★★The extension's decode loop is BROKEN in the reference, measured against
    ; the reference binary, and this port reproduces every reachable half of it:
    ;
    ;   for (int i = 0; i < 3; i++)
    ;     if (pos[i] >= 0) { ELObj *obj = argv[pos[0] + 1]; ... lists[i] ... }
    ;
    ; the subscript is `pos[0]` for EVERY i (a copy-paste slip), and `lists` has
    ; only TWO elements while i runs to 2. So:
    ;   * `architecture:` or `parent:` WITHOUT `active:` walks argv[0] — the
    ;     sysid string, which is no list — and reports `not a list` naming the
    ;     OTHER key's argument (measured: `3rd argument … "("arch")" not a
    ;     list`, and with parent: the node-list prints as `#<unknown object …>`);
    ;   * `architecture:` WITH `active:` silently fills the architecture list
    ;     from the ACTIVE names;
    ;   * `parent:` WITH `active:` writes past `lists` and the reference
    ;     SEGFAULTS (rc 139, measured). Reproducing a stack smash is not
    ;     fidelity — this port takes the same walk into a discarded list and
    ;     carries on, which is what the write would have meant.
    ; The ISO primitive has none of this: its single block reads pos[0] and is
    ; the one the standard names.
    procedure sgml_parse_prim(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, id: int, n_args: int, mutable args: pointer[pointer[ELObj]], ctx: ref[VM], loc: Location) returns ref[ELObj] io reads STDERR_ENC linked

    procedure read_entity_prim(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable a0: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; node-list=?: the two node-lists contain identical nodes in identical
    ; order. DEFPRIMITIVE(IsNodeListEqual): node identity, pairwise.
    procedure node_list_equal(mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable a0: ref[ELObj], mutable a1: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; node-list-map: apply the procedure to each member (as a singleton) and
    ; append the resulting node-lists. DEFPRIMITIVE(NodeListMap) is lazy
    ; (MapNodeListObj); this eager equivalent mirrors mapNext exactly: an
    ; erroring call or a non-node-list result stops the mapping (the reference
    ; truncates the lazy list — it does NOT yield an error object), the
    ; non-node-list case additionally reporting returnNotNodeList.
    procedure node_list_map(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable f: ref[ELObj], mutable nl: ref[ELObj], ctx: ref[VM], mutable loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; --- the DECLARATION axis: nodes over the prolog's tables ---------------
    ;
    ; BaseNode::getGroveRoot — the sgml-document node. A tree node climbs its
    ; structural parents; a DECLARATION node climbs the OWNER chain, which is
    ; what its `parent` field holds (its parent AXIS is null).
    function grove_root_of(node: ref[GroveNode]) returns ref[GroveNode] linked

    ; grove->governingDtd(), as a document-type node owned by the grove root.
    ; Null when the run has no DTD (the reference answers accessNull then).
    function doctype_node(host: ref[Page], node: ref[GroveNode]) returns ref[GroveNode]? linked

    ; an entity node: EntityNode / DefaultEntityNode. The data ATTRIBUTES ride in
    ; the node's attribute slot so the assignment views (GroveNode.attr_views)
    ; work off an entity origin exactly as off an element.
    procedure entity_node(host: ref[Page], node_class: int, mutable ent: ref[Entity], mutable owner: ref[GroveNode]?) returns ref[GroveNode] linked

    ; --- EntityRefNode (spgrove/GroveBuilder.cxx:3580) --------------------
    ; The two accessors the sdata / external-data / subdocument classes share
    ; with a PI ENTITY node: the referenced entity's name, and an entity NODE
    ; over it. The builder parked the Entity in the node's `decl` slot; a
    ; markup PI has none, and there the reference's PiNode answers accessNull
    ; for both (they ARE declared on the pi class, so never notInClass).
    procedure entity_ref_name(host: ref[Page], node: ref[GroveNode], mutable access: ref[int]) returns ref[ELObj]? linked

    procedure entity_ref_node_value(host: ref[Page], interp: ref[Interpreter], mutable node: ref[GroveNode], mutable access: ref[int]) returns ref[ELObj]? linked

    ; SdataNode::charChunk — the one character the SdataMapper resolves for
    ; this reference. The entity NAME is the primary key (the built-in sdata.h
    ; table), its replacement text the secondary one.
    procedure sdata_char(interp: ref[Interpreter], mutable node: ref[GroveNode]) returns u32 linked

    ; SdataNode::charChunk's string: the same character as a one-element run,
    ; for the callers that hand a (pointer, length) to a FOT builder — which
    ; may RECORD the pointer, so it has to be the node's memoized copy.
    procedure sdata_view_string(interp: ref[Interpreter], mutable node: ref[GroveNode]) @page true @direct true returns StringC linked

    ; The reference's NamedTable ITERATION ORDER as a permutation of an
    ; insertion-ordered name list: every declaration table in this port is an
    ; insertion-ordered Array while the reference's is a PointerTable, and the
    ; order is OBSERVABLE through the named node lists. Computed by the table
    ; itself (IdTable.bucket_order, the same layout the -oentity general-entity
    ; sweep re-derives) — the permutation, not the nodes, is what crosses the
    ; package boundary.
    function bucket_order(host: ref[Page], names: ref[Array[StringC]]) returns ref[Array[size_t]] linked

    ; EntitiesNodeList over a DTD entity table (general or parameter), in bucket
    ; order, as entity nodes owned by the doctype node.
    procedure dtd_entity_nodes(host: ref[Page], dtd: ref[Dtd], is_parameter: bool, mutable dt_node: ref[GroveNode]) returns ref[Array[ref[GroveNode]?]] linked

    ; the grove's defaulted-entity table (GroveImpl::defaultedEntityIter), same
    ; bucket-order treatment.
    procedure defaulted_entity_nodes(host: ref[Page], mutable dt_node: ref[GroveNode]?) returns ref[Array[ref[GroveNode]?]] linked

    ; SgmlDocumentNode::getEntities — DocEntitiesNamedNodeList. ★Its LIST is the
    ; governing DTD's general entities; the grove's defaulted entities appear
    ; only when that table is EMPTY, because DocEntitiesNodeList's default-entity
    ; fallback sits in chunkRest and the rest chain hands out a PLAIN
    ; EntitiesNodeList from the second step on. The NAMED lookup does have the
    ; fallback for every step, which NNL_DOC_ENTITIES carries (named_node_prim).
    procedure doc_entities_list(host: ref[Page], interp: ref[Interpreter], mutable node: ref[GroveNode]) returns ref[ELObj]? linked

    ; NotationsNodeList over the DTD's notation table, in bucket order.
    function notation_nodes(host: ref[Page], dtd: ref[Dtd], dt_node: ref[GroveNode]) returns ref[Array[ref[GroveNode]?]] linked

    ; ElementTypesNodeList over the DTD's element-type table, in bucket order.
    function element_type_nodes(host: ref[Page], dtd: ref[Dtd], dt_node: ref[GroveNode]?) returns ref[Array[ref[GroveNode]?]] linked

    ; AttributeDefsNodeList — every definition of an attribute definition list in
    ; DECLARATION order (attIndex 0..n, no permutation: the reference walks the
    ; index, not a table). `owner` is the element-type or notation node, which is
    ; also the attribute-def's identity (attributeOriginId).
    function attribute_def_nodes(host: ref[Page], adl: ref[AttributeDefinitionList]?, owner: ref[GroveNode]) returns ref[Array[ref[GroveNode]?]] linked

    ; the attribute definition list an attribute-def node (or an element-type /
    ; notation node) reads: AttributeDefOrigin::attDefList.
    function att_def_list_of(node: ref[GroveNode]) returns ref[AttributeDefinitionList]? linked

    ; `entity_->defaulted() && grove()->lookupDefaultedEntity(name)` — the
    ; reference's own conjunction (EntityNode::getOrigin / …RelPropertyName):
    ; the entity must be a DEFAULTED COPY *and* registered in the grove's table.
    ; A prolog-time defaulted copy lands in the DTD but not in that table, and a
    ; plainly declared entity that the instance referenced is in the table but is
    ; not a copy — neither counts.
    function entity_is_grove_defaulted(node: ref[GroveNode], ent: ref[Entity]?) returns bool linked

    ; the NAME of the declaration a node stands for (EntityNodeBase::getName,
    ; NotationNode::getName, DocumentTypeNode::getName — all the same property).
    function decl_name_of(node: ref[GroveNode]) @page true @direct true returns StringC linked

    ; the definition an attribute-def node stands for, null out of range
    function att_def_of(node: ref[GroveNode]) returns ref[AttributeDefinition]? linked

    ; ModelGroupNode::makeNode — one content token of a model group: a nested
    ; group, an element token, or the #PCDATA token.
    function content_token_node(host: ref[Page], mg_node: ref[GroveNode], member: ref[CmNode]?, index: int) returns ref[GroveNode]? linked

    ; ContentTokenNodeList over a model group's members.
    function content_token_nodes(host: ref[Page], mg_node: ref[GroveNode]) returns ref[Array[ref[GroveNode]?]] linked

    ; GroveStringListPtr — a proper list of strings (exclusions / inclusions /
    ; tokens), built back to front onto nil like every other ELObj list.
    function make_string_list(host: ref[Page], interp: ref[Interpreter], items: ref[Array[StringC]]) returns ref[ELObj] linked

    ; ElementTypeCurrentGroupAttributeDefsNodeList — every #CURRENT attribute
    ; definition in the DTD that shares one current-attribute index, walking the
    ; element types in bucket order.
    ; ★DOCUMENTED DEVIATION: the reference dereferences
    ; `elementType->attributeDefTemp()` without a null check, so this property
    ; SEGFAULTS for any DTD holding an element type without an attribute
    ; definition list (measured: one #CURRENT probe on a document whose title
    ; element has no ATTLIST kills it). We skip such element types.
    function current_group_nodes(host: ref[Page], interp: ref[Interpreter], node: ref[GroveNode], current_index: size_t) returns ref[Array[ref[GroveNode]?]] linked

    ; AttributeDefOrigin::makeAttributeValueNodeList — an attribute definition's
    ; DEFAULT VALUE as a node list: accessNull when there is no value object or
    ; the CDATA text holds no character data (skipBoring), else the same two
    ; shapes an attribute assignment's `value` has — one attribute-value-token
    ; per token, or a data chunk whose per-character views are the members.
    procedure default_value_list(host: ref[Page], mutable node: ref[GroveNode], mutable access: ref[int]) @page true @direct true returns ref[ELObj]? linked

    ; node-property: the named property of a singleton node (DEFPRIMITIVE
    ; NodeProperty), keyword args default:/null:/rcs? decoded per the
    ; reference decodeKeyArgs (first occurrence wins, odd count / non-keyword /
    ; unknown keyword are hard messages). The name resolves through the full
    ; ComponentName table (Grove.ComponentName — both the RCS and the SDQL
    ; spelling of all 107 ids, case-insensitively), the value comes from
    ; node_property_value below, and the three access results decide the answer:
    ; accessOK -> the value, accessNull -> null: then default:, and both
    ; accessNotInClass and an unknown NAME -> default:, without which the
    ; reference reports noNodePropertyValue and yields an error object.
    ;
    ; NOT ported: the reference's one hack for the duplicate RCS name `tokens`
    ; (on a model-group node it means content-tokens) — that node class does not
    ; exist here, so the plain table lookup is equivalent.
    procedure node_property(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, n_args: int, mutable args: pointer[pointer[ELObj]], loc: Location) @page true @direct true returns ref[ELObj]? io reads msg_prog linked

    ; Node::property for the DECLARATION classes (the per-class blocks of
    ; grove/Node.cxx's switch, whose accessors live in spgrove/GroveBuilder.cxx).
    ; The INTRINSIC props are answered by node_property_value before it gets
    ; here; `access` arrives set to accessNotInClass, which is the answer for
    ; every id a class does not declare.
    procedure decl_property_value(host: ref[Page], mutable interp: ref[Interpreter], mutable node: ref[GroveNode], id: int, want_rcs: bool, mutable access: ref[int]) @page true @direct true returns ref[ELObj]? linked

    ; Node::property (grove/Node.cxx:465) — the property VALUE of a node, with
    ; the access result out of band. The reference dispatches an id through one
    ; switch onto per-class virtual getX accessors that default to
    ; accessNotInClass; here the same shape is one id chain for the eleven
    ; INTRINSIC_PROPS (which every class carries) plus a per-class block, the
    ; declaration classes' blocks living in decl_property_value above.
    ;
    ; UNPORTED, and therefore accessNotInClass where the reference answers:
    ; `messages`/`severity` (the message class), `subdocument`/`external-data`
    ; (the entity-reference classes) and the address/HyTime properties — the
    ; remaining items of COMPLETENESS.md's property list. Note that
    ; `all-property-names` LISTS every property a class declares, exactly as the
    ; reference does: it answers from the ClassDef table, which is a statement
    ; about the class, not about what is implemented.
    procedure node_property_value(host: ref[Page], mutable interp: ref[Interpreter], mutable node: ref[GroveNode], id: int, want_rcs: bool, mutable access: ref[int]) @page true @direct true returns ref[ELObj]? linked

    ; a half-open range of the sgml-document node's structural children as a
    ; node-list (the prolog / epilog sibling groups).
    function document_child_range(host: ref[Page], node: ref[GroveNode], from: int, to: int) returns ref[ELObj] linked

    ; ELObjPropertyValue::set(ComponentName::Id) — a component name is a SYMBOL
    ; whose spelling the rcs? flag selects (short RCS vs long SDQL name).
    procedure make_component_name(mutable interp: ref[Interpreter], id: int, want_rcs: bool) returns ref[ELObj] linked

    ; getChildrenPropertyName / getDataPropertyName / getDataSepPropertyName:
    ; the ClassDef slot, accessNull when it holds ComponentName::noId.
    procedure component_name_or_null(mutable interp: ref[Interpreter], id: int, want_rcs: bool, mutable access: ref[int]) returns ref[ELObj]? linked

    ; ELObjPropertyValue::set(const ComponentName::Id *) — a proper LIST of
    ; component-name symbols, built back to front onto nil.
    procedure make_component_name_list(host: ref[Page], mutable interp: ref[Interpreter], ids: ref[Array[int]], want_rcs: bool) returns ref[ELObj] linked

    ; node-list-reverse: the members in reverse order. NodeListObj::
    ; nodeListReverse (the lazy ReverseNodeListObj), eagerly.
    procedure node_list_reverse_prim(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable nl: ref[ELObj], loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; nodeData (style/primitive.cxx:4070) recurses through firstChild, so this
    ; is the children AXIS: `(data <sgml-document node>)` is the empty string.
    ; `nodeData` (style/primitive.cxx:4070) in its exact order: charChunk, then
    ; ★`tokens` — an ATTRIBUTE ASSIGNMENT with a tokenized value contributes the
    ; whole value STRING, separators included, which is why `(data <assignment>)`
    ; reads "ONE TWO" and not "ONETWO" — then the children, and last `getToken`
    ; for a value token reached on its own.
    procedure collect_data_len(interp: ref[Interpreter], mutable node: ref[GroveNode]?) returns size_t linked

    ; sosofo-append: an append sosofo whose parts are the argument sosofos
    ; themselves (AppendSosofoObj holds the sosofos; process() walks them in
    ; order). Args are added directly — NOT flattened by their inner parts:
    ; a literal / process-children sosofo has no parts, so flattening would
    ; drop it.
    procedure sosofo_append(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; --- display-space / inline-space / color (primitive.cxx + Style.cxx) ---

    ; the strict boolean of the keyword args (#t/#f identity — see
    ; convertBooleanC's trap).
    procedure strict_bool(val: ref[ELObj], mutable out: ref[bool]) returns bool linked

    procedure invalid_key_arg(mutable interp: ref[Interpreter], loc: Location, kname: ref[Identifier]?) returns ref[ELObj] io reads msg_prog linked

    ; DEFPRIMITIVE(DisplaySpace): nominal from arg 0, keyword args scanned
    ; BACKWARDS (first specified wins); odd trailing args -> oddKeyArgs.
    procedure display_space_prim(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; DEFPRIMITIVE(InlineSpace): like display-space with min:/max: only.
    procedure inline_space_prim(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; --- color spaces (DEFPRIMITIVE(ColorSpace) + Style.cxx makeColor) ------

    procedure color_space_message(mutable interp: ref[Interpreter], loc: Location, mt: MessageType, sname: Slice[char]) returns ref[ELObj] io reads msg_prog linked

    ; ascii compare of str[from..from+len) against a literal of exactly len.
    function str_part_is(s: StringC, from: size_t, lit: Slice[char]) returns bool linked

    procedure color_space_prim(host: ref[Page], mutable interp: ref[Interpreter], name: ref[Identifier]?, mutable args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; decodeNumVector: a list of exactly-readable numbers of length len.
    procedure decode_num_vector(mutable res: Slice[double], obj: ref[ELObj]) returns bool linked

    procedure decode_func_vector(mutable res: pointer[pointer[ELObj]], len: int, obj: ref[ELObj]) returns bool linked

    ; decodeKeyArgs: pos[j] = value index (relative to args) of key j, -1 if
    ; absent; first occurrence wins (reverse scan). Messages fire here AND the
    ; caller adds colorSpaceArgError (reference double-message shape).
    procedure decode_key_args(argc: int, args: pointer[pointer[ELObj]], keys: Slice[int], mutable interp: ref[Interpreter], loc: Location, mutable pos: Slice[int]) returns bool io reads msg_prog linked

    ; the CIE space constructors (primitive.cxx ColorSpace + Style.cxx ctors).
    ; keys order: white-point black-point range range-abc range-lmn range-a
    ; matrix-abc matrix-lmn matrix-a decode-abc decode-lmn decode-a.
    procedure make_cie_space(host: ref[Page], mutable interp: ref[Interpreter], kind: int, sname: Slice[char], args: pointer[pointer[ELObj]], argc: int, loc: Location) returns ref[ELObj] io reads msg_prog linked

    ; a range buffer: given values, or the 0/1 alternating default.
    function range_buf(host: ref[Page], len: int, given: bool, vals: Slice[double]) @page true @direct true returns Slice[double] linked

    ; a 3x3 matrix buffer: given values, or identity ((i % 4) ? 0 : 1).
    function matrix_buf(host: ref[Page], given: bool, vals: Slice[double]) @page true @direct true returns Slice[double] linked

    function func_buf(host: ref[Page], given: bool, vals: Slice[ref[ELObj]?]) @page true @direct true returns Slice[ref[ELObj]?] linked

    ; CIEXYZColorSpaceObj ctor: white point + the phosphor matrix (color faq)
    ; inverted twice into the XYZ->RGB matrix. Layout: white[3], white_u,
    ; white_v, M[9].
    function xyz_data(host: ref[Page], wp: Slice[double]) @page true @direct true returns Slice[double] linked

    ; invert a 3x3 matrix (Style.cxx invert; the near-singular case is left
    ; unreported like the reference FIXME).
    procedure invert3(a: Slice[double], mutable b: Slice[double]) linked

    ; --- makeColor per space kind -------------------------------------------

    procedure color_arg_real(mutable interp: ref[Interpreter], loc: Location, sname: Slice[char], a: ref[ELObj], lo: double, hi: double, mutable out: ref[double]) returns ref[ELObj]? io reads msg_prog linked

    ; (unsigned char)(d*255.0 + .5)
    function to_255(d: double) returns int linked

    ; applyFunc (Style.cxx): call a decode function on a fresh VM with the
    ; component as a real; the result must read back as a real.
    procedure apply_color_func(mutable interp: ref[Interpreter], mutable f: ref[ELObj], mutable d: ref[double]) returns bool io reads msg_prog linked

    ; CIEXYZColorSpaceObj::makeColor — XYZ through M into device RGB.
    function xyz_make_color(host: ref[Page], xyz: Slice[double], h: Slice[double]) returns ref[ELObj] linked

    procedure make_color_from_space(host: ref[Page], mutable interp: ref[Interpreter], mutable space: ref[ELObj], argc: int, args: pointer[pointer[ELObj]], loc: Location) returns ref[ELObj] io reads msg_prog linked

    procedure collect_data_fill(interp: ref[Interpreter], mutable node: ref[GroveNode]?, mutable buf: Slice[u32], off: size_t) returns size_t linked
}
