    ; with the override — `fraction-bar` included (it is an `\insertFractionBar`
    ; atomic, TeXFOTBuilder.cxx:2227).
    procedure start_math_sequence(mutable this: ref[TeXFOTBuilder]) @ret_nonlocal true @deep true linked

