; TeXFOTBuilder — the `-t tex` backend: David Megginson's generic TeX macro
; stream (jadetex input). Ported from ~/repos/dazzle/jade/TeXFOTBuilder.cxx
; (C++ oracle, openjade 1.3.3-pre1; the build defines OUTLINES and leaves
; TEXDEBUG/NDEBUG undefined — reference asserts are live and port as loud
; exit-17 traps). The C# mirror has no TeX backend; the C++ is the only
; source.
;
; Output model: byte streams. Every characteristic setter renders
; "\def\Name%\n{value}" into the pending string stream (stringout_); the
; next flow-object group start dumps it inside its brace group. Groups are
; "\Name%\n{...}" ... "\endName{}"; atomic flow objects are
; "\insertName%\n{...}". Numbers print in printf %g form; setlength values
; pass through FLOAT precision (the reference casts to float before
; streaming — port via the f32 round-trip). Chars stream as single bytes
; (C++ char truncation); chars > 255 become \Character{N}.
;
; Tables buffer into a FotElement tree (Table/TablePart/Row/Cell/Border
; records with prolog/characteristics/content byte buffers) and emit at
; endTable after border resolution and column processing — a faithful port
; of the Marszalek table machinery including its quirks (the row-separator
; "&" emission clears `first` even for suppressed cells; the trailing dummy
; cell; LengthInPoints losing the sign of -0.x values).
;
; The simple-page-sequence header/footer parts arrive live from
; ProcessContext (part content, then end_simple_page_sequence_header_footer
; with the reference's k = pageType | (part << 2) flags); the sink captures
; each part in a reused buffer and wraps it retroactively in the
; "\n\SpS<First|Other><Front|Back><Left|Center|Right><Header|Footer>%\n{...}"
; bracket — byte-equivalent to the reference SerialFOTBuilder replay.
;
; RBMM: everything lives on the builder's page (the run arena); the pending
; stream, HF capture and heading-text buffers are cursor-reused (TexBuf),
; stacks are slot-reused pointer arrays with depth cursors. Table trees
; allocate fresh per table (few, bounded by the document).

use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use dazzle.Grove.GroveNode
use dazzle.Grove.GroveInfo
use dazzle.ELObj.ELObj
use dazzle.Style.InheritedC
use dazzle.Style.LengthSpec
use dazzle.Style.DisplaySpace
use dazzle.Style.InlineSpace
use dazzle.Style.FotSym
use dazzle.Style.DisplayNIC
use dazzle.Style.RuleNIC
use dazzle.Style.LinkNIC
use dazzle.Style.ExternalGraphicNIC
use dazzle.Style.LeaderNIC
use dazzle.Style.BoxNIC
use dazzle.Style.ScoreNIC
use dazzle.Style.TableNIC
use dazzle.Style.TableColumnNIC
use dazzle.Style.TableCellNIC
use dazzle.Style.PageFloatNIC
use dazzle.Style.LineFieldNIC
use dazzle.Style.CharacterNIC
use dazzle.Style.AnchorNIC
use dazzle.Style.GlyphAnnotationNIC
use dazzle.Style.EmphasizingMarkNIC
use dazzle.Style.GridNIC
use dazzle.Style.GridCellNIC
use dazzle.Style.EmbeddedTextNIC
use dazzle.Style.IncludedContainerAreaNIC
use dazzle.Style.MultiModeRec
use dazzle.Style.MultiModeNIC

; --- constants ---------------------------------------------------------------
; FotObjectClassType
define TEX_OC_UNKNOWN: int 0
define TEX_OC_CELL: int 1

; lengthUnspecified = LONG_MAX (LP64)
define TEX_LEN_UNSPEC: int 0x7FFFFFFFFFFFFFFF

; FotElement tags
define TEX_EL_BORDER: int 0
define TEX_EL_CELL: int 1
define TEX_EL_ROW: int 2
define TEX_EL_PART: int 3
define TEX_EL_TABLE: int 4

; border kinds (0-3 cell borders, 4-7 table borders)
define TEX_B_CELL_BEFORE_ROW: int 0
define TEX_B_CELL_AFTER_ROW: int 1
define TEX_B_CELL_BEFORE_COL: int 2
define TEX_B_CELL_AFTER_COL: int 3
define TEX_B_TABLE_BEFORE_ROW: int 4
define TEX_B_TABLE_AFTER_ROW: int 5
define TEX_B_TABLE_BEFORE_COL: int 6
define TEX_B_TABLE_AFTER_COL: int 7

; --- TexBuf: a cursor-reused byte buffer (StrOutputByteStream/String<char>) --
define TexBuf (arr: ref[Array[u8]]?, var len: size_t)
{
    function make(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[TexBuf] linked

    procedure put(mutable this: ref[TexBuf], c: u8) @deep true linked

    procedure clear(mutable this: ref[TexBuf]) @deep true linked

    function size(this: ref[TexBuf]) @ret_param_0 true @deep true returns size_t linked
}

; --- Format: the inherited-characteristic snapshot the table/page machinery
; consults (reference struct Format; ctor defaults preserved) ----------------
define TexFormat
(
    var cur_display_size: int
    var line_thickness: int
    var line_cap: int
    var border_priority: int
    var border_present: bool
    var line_repeat: int
    var line_sep: int
    var lines_sym: int
    var display_alignment: int
    var cell_row_alignment: int
    var start_indent_spec: LengthSpec
    var end_indent_spec: LengthSpec
    var left_margin: int
    var right_margin: int
    var page_width: int
    var page_n_columns: int
    var page_column_sep: int
    var span_count: int
    var cell_background: bool
    var bg_r: int
    var bg_g: int
    var bg_b: int
    var cell_before_col_margin: int
    var cell_after_col_margin: int
    var object_class: int
)
{
    init() linked
}

; --- FotElementState ---------------------------------------------------------
define TexFoState (var enforcing: bool, var is_open: bool, ni_prolog: ref[TexBuf])
{
}

; --- OUTLINES ParHead --------------------------------------------------------
define TexParHead (var is_headed: bool, var level: int, heading_text: ref[TexBuf], var previous: int)
{
}

; --- Column ------------------------------------------------------------------
define TexColumn
(
    var is_explicit: bool
    var has_width: bool
    var width: LengthSpec
    var width_tuf: double
    var computed_width: int
    var display_size: int
    var display_alignment: int
    var default_left_border: int
    var default_right_border: int
    var default_before_margin: int
    var default_after_margin: int
)
{
    function make(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[TexColumn] linked
}

; --- FotElement: one tagged record covers Border/Cell/Row/TablePart/Table ----
define TexFotEl
(
    tag: int
    var parent: ref[TexFotEl]?
    var sibling_idx: int
    characteristics: ref[TexBuf]
    ni_prolog: ref[TexBuf]
    ni_epilog: ref[TexBuf]
    ; compound state
    var cur_open_child: int
    var last_closed_child: int
    var pre_content: ref[TexBuf]?
    ; border payload
    var border_kind: int
    var b_priority: int
    var b_thickness: int
    var b_present: bool
    var b_repeat: int
    var b_sep: int
    ; cell payload
    var missing: bool
    var tex_row_idx: int
    var tex_col_idx: int
    var n_cols_spanned: int
    var n_rows_spanned: int
    var br_border: ref[TexFotEl]?
    var ar_border: ref[TexFotEl]?
    var bc_border: ref[TexFotEl]?
    var ac_border: ref[TexFotEl]?
    var needs_override: bool
    var before_col_margin: int
    var eff_before_col_margin: int
    var after_col_margin: int
    var eff_after_col_margin: int
    var row_alignment: int
    var eff_alignment: int
    var display_size: int
    var cell_background: bool
    var bg_r: int
    var bg_g: int
    var bg_b: int
    var overlapping: ref[TexFotEl]?
    var content: ref[TexBuf]?
    ; row payload
    var cells: ref[Array[ref[TexFotEl]?]]?
    ; table-part payload
    var columns: ref[Array[ref[TexColumn]?]]?
    var header_rows: ref[Array[ref[TexFotEl]?]]?
    var body_rows: ref[Array[ref[TexFotEl]?]]?
    var footer_rows: ref[Array[ref[TexFotEl]?]]?
    var header_prolog: ref[TexBuf]?
    var header_epilog: ref[TexBuf]?
    var footer_prolog: ref[TexBuf]?
    var footer_epilog: ref[TexBuf]?
    var columns_processed: bool
    var needs_col_reproc: bool
    var is_explicit: bool
    ; table payload
    var parts: ref[Array[ref[TexFotEl]?]]?
    var t_br_border: ref[TexFotEl]?
    var t_ar_border: ref[TexFotEl]?
    var t_bc_border: ref[TexFotEl]?
    var t_ac_border: ref[TexFotEl]?
    var table_width: int
    var t_display_alignment: int
    var start_indent: int
    var cur_part: ref[TexFotEl]?
    var cur_cell: ref[TexFotEl]?
    ; which row vector CurRows points at: 0 header, 1 body, 2 footer
    var cur_rows_sel: int
    var no_parts_seen: bool
)
{
    ; every field explicit — define-header defaults do NOT apply (S79 trap).
    function make(host: ref[Page], tag: int) @ret_explicit_0 true @deep true returns ref[TexFotEl] linked

    function make_border(host: ref[Page], kind: int) @ret_explicit_0 true @deep true returns ref[TexFotEl] linked

    function make_cell(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[TexFotEl] linked

    function make_row(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[TexFotEl] linked

    function make_part(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[TexFotEl] linked

    function make_table(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[TexFotEl] linked

    ; the macro name of this element
    function el_name(this: ref[TexFotEl]) @ret_nonlocal true @deep true returns Slice[char] linked

    function is_cell_border(this: ref[TexFotEl]) @ret_param_0 true @deep true returns bool linked

    ; Cell::isOverlapped — NULL OverlappingCell counts as overlapped (the
    ; reference's `OverlappingCell == this ? false : true`).
    function is_overlapped(this: ref[TexFotEl]) @ret_nonlocal true @deep true returns bool linked

    ; TablePart child(): header rows, then body, then footer — with the
    ; reference's missing body-size subtraction quirk preserved (idx into the
    ; footer is offset by the body size only, after subtracting the header).
    function part_child(this: ref[TexFotEl], idx_in: int) @ret_param_0 true @deep true returns ref[TexFotEl]? linked

    procedure child(this: ref[TexFotEl], idx: int) @ret_param_0 true @deep true returns ref[TexFotEl]? io reads tex_prog linked

    ; CompoundFotElement::currentlyOpen_ / lastClosed_
    procedure currently_open(this: ref[TexFotEl]) @ret_param_0 true @deep true returns ref[TexFotEl] io reads tex_prog linked

    procedure last_closed(this: ref[TexFotEl]) @ret_param_0 true @deep true returns ref[TexFotEl]? io reads tex_prog linked

    procedure child_just_opened(mutable this: ref[TexFotEl], c: ref[TexFotEl]) @deep true linked

    procedure child_just_closed(mutable this: ref[TexFotEl], c: ref[TexFotEl]) @deep true linked

    ; the row vector CurRows selects
    function cur_rows(this: ref[TexFotEl]) @ret_param_0 true @deep true returns ref[Array[ref[TexFotEl]?]] linked
}

; libc + shim externs (prototypes type-match the other roots').
function log10(x: double) returns double extern
function pow(x: double, y: double) returns double extern
function floor(x: double) returns double extern
function exit(code: i32) extern
procedure scaly_eputs(s: pointer[const_char]) extern
procedure scaly_eputnl() extern

; argv0 for backend messages (TeXMessages warnings, W0 severity: the
; reference renders `<argv0>:W: <text>` through CmdLineApp::message). The CLI
; driver sets it once; a `shared` module global, like tfb_prog.
shared tex_prog: pointer[const_char] linked

; --- the builder -------------------------------------------------------------
define TeXFOTBuilder
(
    ; fileout_ + the osStack_ (top = current output target)
    out: ref[TexBuf]
    os_stack: ref[Array[ref[TexBuf]?]]
    var os_depth: int
    ; stringout_ (the pending \def stream)
    sout: ref[TexBuf]
    ; FormatStack + NextFormat
    fmt_stack: ref[Array[ref[TexFormat]?]]
    var fmt_depth: int
    next_format: TexFormat
    ; FotElementStateStack_
    state_stack: ref[Array[ref[TexFoState]?]]
    var state_depth: int
    ; TableStack
    table_stack: ref[Array[ref[TexFotEl]?]]?
    var table_depth: int
    ; DisplayBoxLevels
    dbl: ref[Array[int]]
    var dbl_len: int
    var preserve_sdata: bool
    var in_math: int
    ; OUTLINES machinery
    var heading_set: bool
    var in_heading: bool
    var last_headed: int
    par_stack: ref[Array[ref[TexParHead]?]]
    var par_depth: int
    ; simple-page-sequence header/footer part capture
    hf_capture: ref[TexBuf]
    var in_hf: bool
    host: ref[Page]
)
{
    function make(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[TeXFOTBuilder] linked

    ; the reference destructor
    procedure finish(mutable this: ref[TeXFOTBuilder]) @ret_nonlocal true @deep true linked

    function output(this: ref[TeXFOTBuilder]) @ret_param_0 true @deep true returns ref[TexBuf] linked

    ; --- loud assert (reference asserts are live) -----------------------------
    procedure trap(what: Slice[char]) @ret_nonlocal true @deep true @deep_beyond_1 true io reads tex_prog linked

    procedure set_prog_name(prog: pointer[const_char]) @deep true @deep_beyond_1 true @deep_whole_1 true mutable tex_prog reads tex_prog linked

    ; TeXMessages warnings (W0 severity, no location): `<prog>:W: <text>`.
    procedure msg_w(this: ref[TeXFOTBuilder], text: Slice[char]) @ret_nonlocal true @deep true @deep_beyond_2 true io reads tex_prog linked

    ; --- stacks ---------------------------------------------------------------
    procedure os_push(mutable this: ref[TeXFOTBuilder], b: ref[TexBuf]?) @deep true @deep_this_2 true @deep_whole_2 true linked

    procedure os_pop(mutable this: ref[TeXFOTBuilder]) @deep true io reads tex_prog linked

    function cur_os(this: ref[TeXFOTBuilder]) @ret_param_0 true @deep true returns ref[TexBuf] linked

    procedure copy_fmt(mutable dst: ref[TexFormat], src: ref[TexFormat]) @deep true linked

    ; FormatStack.push_back(NextFormat)
    procedure fmt_push(mutable this: ref[TeXFOTBuilder]) @deep true linked

    procedure cur_format(this: ref[TeXFOTBuilder]) @ret_param_0 true @deep true returns ref[TexFormat] io reads tex_prog linked

    ; start()/elementStart()/end() — the FOTBuilder format bracket
    procedure fo_start(mutable this: ref[TeXFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure element_start(mutable this: ref[TeXFOTBuilder], oc: int) @ret_nonlocal true @deep true linked

    procedure fo_end(mutable this: ref[TeXFOTBuilder]) @ret_nonlocal true @deep true io reads tex_prog linked

    ; FotElementState stack
    procedure state_push(mutable this: ref[TeXFOTBuilder]) @deep true linked

    procedure state_pop(mutable this: ref[TeXFOTBuilder]) @deep true io reads tex_prog linked

    procedure cur_state(this: ref[TeXFOTBuilder]) @ret_param_0 true @deep true returns ref[TexFoState] io reads tex_prog linked

    procedure enforcing_structure(this: ref[TeXFOTBuilder]) @ret_param_0 true @deep true returns bool io reads tex_prog linked

    ; TableStack
    procedure table_push(mutable this: ref[TeXFOTBuilder]) @ret_param_0 true @deep true returns ref[TexFotEl] linked

    procedure cur_table(this: ref[TeXFOTBuilder]) @ret_param_0 true @deep true returns ref[TexFotEl] io reads tex_prog linked

    ; ParHead stack (OUTLINES)
    procedure par_push(mutable this: ref[TeXFOTBuilder], is_headed: bool, level: int) @deep true linked

    procedure par_pop(mutable this: ref[TeXFOTBuilder]) @deep true io reads tex_prog linked

    procedure par_top(this: ref[TeXFOTBuilder]) @ret_param_0 true @deep true returns ref[TexParHead] io reads tex_prog linked

    function par_at(this: ref[TeXFOTBuilder], i: int) @ret_param_0 true @deep true returns ref[TexParHead] linked

    ; --- low-level writers (current os) ---------------------------------------
    procedure w_byte(mutable this: ref[TeXFOTBuilder], c: u8) @ret_nonlocal true @deep true linked

    procedure w_raw(mutable this: ref[TeXFOTBuilder], s: Slice[char]) @ret_nonlocal true @deep true linked

    ; --- low-level writers (explicit buffer) -----------------------------------
    procedure b_raw(mutable b: ref[TexBuf], s: Slice[char]) @deep true linked

    ; StringC -> bytes (C++ char truncation)
    procedure b_stringc(mutable b: ref[TexBuf], s: StringC) @deep true linked

    ; unsigned decimal (n >= 0)
    procedure b_udec(mutable b: ref[TexBuf], n_in: int) @deep true linked

    ; signed long decimal
    procedure b_long(mutable b: ref[TexBuf], n: int) @deep true linked

    ; printf %g (6 significant digits, trailing zeros stripped, e-form with
    ; signed two-digit exponent outside [1e-4, 1e6))
    procedure b_g(mutable b: ref[TexBuf], x_in: double) @page true @direct true @deep true linked

    ; %g of a value squeezed through FLOAT precision (the reference streams
    ; `float(...)` through operator<<(double))
    procedure b_gf(mutable b: ref[TexBuf], x: double) @ret_nonlocal true @deep true linked

    ; LengthInPoints: "%li.%.3i" of l/1000 and |l%1000|, trailing zeros (and a
    ; bare point) stripped, then "\p@". Sign of -0.x values is lost (faithful).
    procedure b_pts(mutable b: ref[TexBuf], l: int) @ret_nonlocal true @deep true linked

    ; append buffer to buffer (TmpOutputByteStream::commit)
    procedure b_buf(mutable dst: ref[TexBuf], src: ref[TexBuf]) @deep true linked

    ; --- the Symbol -> TeX name table (reference switch; enum order codes) ----
    function sym_name(code: int) @ret_nonlocal true @deep true returns Slice[char] linked

    ; --- characteristic set helpers (all render into stringout_) --------------
    procedure def_open(mutable this: ref[TeXFOTBuilder], name: Slice[char]) @ret_nonlocal true @deep true linked

    procedure def_close(mutable this: ref[TeXFOTBuilder]) @ret_nonlocal true @deep true linked

    ; setlength — float(size/1000.0) + \p@
    procedure set_len(mutable this: ref[TeXFOTBuilder], name: Slice[char], l: int) @ret_nonlocal true @deep true linked

    procedure set_sym(mutable this: ref[TeXFOTBuilder], name: Slice[char], code: int) @ret_nonlocal true @deep true linked

    ; `unsigned long g = node->groveIndex(); if (g) set("GroveIndex", g);` —
    ; emitted only for a NON-document grove, which is exactly what sgml-parse
    ; can produce.
    procedure set_grove_index(mutable this: ref[TeXFOTBuilder], node: ref[GroveNode]?) @deep true linked

    procedure set_stringc(mutable this: ref[TeXFOTBuilder], name: Slice[char], s: StringC) @ret_nonlocal true @deep true linked

    ; set(name, PublicId) — the id bytes. A #f id is a NULL const char* in the
    ; reference, and its operator<<(const char *) dereferences unguarded: the
    ; reference SIGSEGVs. We render an empty value (documented divergence; no
    ; corpus stylesheet sets a public-id characteristic to #f).
    procedure set_pubid(mutable this: ref[TeXFOTBuilder], name: Slice[char], ic: ref[InheritedC]) @ret_nonlocal true @deep true linked

    ; set(name, LengthSpec) — float length + \p@, then the Factor def (%g)
    procedure set_lenspec(mutable this: ref[TeXFOTBuilder], name: Slice[char], ls: LengthSpec) @ret_nonlocal true @deep true linked

    procedure set_double(mutable this: ref[TeXFOTBuilder], name: Slice[char], d: double) @ret_nonlocal true @deep true linked

    procedure set_long(mutable this: ref[TeXFOTBuilder], name: Slice[char], n: int) @ret_nonlocal true @deep true linked

    procedure set_bool(mutable this: ref[TeXFOTBuilder], name: Slice[char], f: bool) @ret_nonlocal true @deep true linked

    ; setletter2 — the two code bytes verbatim; a #f characteristic is
    ; Letter2 0, i.e. TWO NUL BYTES in the stream (reference-verified).
    procedure set_letter2(mutable this: ref[TeXFOTBuilder], name: Slice[char], ic: ref[InheritedC]) @ret_nonlocal true @deep true linked

    ; set(name, DeviceRGBColor) — Red/Green/Blue defs
    procedure set_color(mutable this: ref[TeXFOTBuilder], name: Slice[char], r: int, g: int, b_in: int) @ret_nonlocal true @deep true linked

    ; one member of the DisplaySpace/InlineSpace family: NAME+suffix def with a
    ; PLAIN double length (no float squeeze — reference streams the division)
    procedure set_space_part(mutable this: ref[TeXFOTBuilder], name: Slice[char], suffix: Slice[char], v: double, pts: bool) @ret_nonlocal true @deep true linked

    procedure set_display_space(mutable this: ref[TeXFOTBuilder], name: Slice[char], ds: DisplaySpace) @deep true linked

    procedure set_inline_space(mutable this: ref[TeXFOTBuilder], name: Slice[char], sp: ref[InlineSpace]) @deep true linked

    ; dumpInherited — flush the pending defs into the current os
    procedure dump_inherited(mutable this: ref[TeXFOTBuilder]) @ret_nonlocal true @deep true linked

    ; stringout_.extractString(target) — REPLACES the target
    procedure extract_into(mutable this: ref[TeXFOTBuilder], mutable dst: ref[TexBuf]) @ret_nonlocal true @deep true linked

    ; --- group scaffolding -----------------------------------------------------
    procedure group_start(mutable this: ref[TeXFOTBuilder], name: Slice[char]) @ret_nonlocal true @deep true linked

    ; startGroup(name, output) — "\Name%\n{<extract>}" APPENDED to output
    procedure group_start_out(mutable this: ref[TeXFOTBuilder], name: Slice[char], mutable dst: ref[TexBuf]) @page true @direct true @ret_nonlocal true @deep true linked

    procedure group_end(mutable this: ref[TeXFOTBuilder], name: Slice[char]) @ret_nonlocal true @deep true linked

    procedure group_end_out(this: ref[TeXFOTBuilder], name: Slice[char], mutable dst: ref[TexBuf]?) @ret_nonlocal true @deep true linked

    procedure simple_group_start(mutable this: ref[TeXFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure simple_group_end(mutable this: ref[TeXFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure closeopen_brace(mutable this: ref[TeXFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure brace_start(mutable this: ref[TeXFOTBuilder], name: Slice[char]) @ret_nonlocal true @deep true linked

    procedure brace_end(mutable this: ref[TeXFOTBuilder]) @ret_nonlocal true @deep true linked

    procedure insert_atomic(mutable this: ref[TeXFOTBuilder], name: Slice[char]) @ret_nonlocal true @deep true linked

    ; startGroup(FotElement&)/insertAtomic(FotElement&) — capture the pending
    ; defs as the element's characteristics
    procedure capture_into(mutable this: ref[TeXFOTBuilder], mutable el: ref[TexFotEl]) @ret_nonlocal true @deep true linked

    ; --- the characteristic dispatch (reference setters by registry index) ----
    procedure set_ic(mutable this: ref[TeXFOTBuilder], ic: ref[InheritedC]) @deep true io reads tex_prog linked

    ; setFontFamilyName — spaces become '-'
    procedure set_font_family_name(mutable this: ref[TeXFOTBuilder], name: StringC) @ret_nonlocal true @deep true linked

    ; the jade.cxx TeX extension characteristics (makeTeXFOTBuilder table)
    procedure set_extension_ic(mutable this: ref[TeXFOTBuilder], ext: int, ic: ref[InheritedC]) @ret_nonlocal true @deep true linked

    ; setHeadingLevel (OUTLINES): 1..9 arms the next paragraph as a heading
    procedure set_heading_level(mutable this: ref[TeXFOTBuilder], n: int) @ret_nonlocal true @deep true linked

    ; --- computeLengthSpec -----------------------------------------------------
    procedure compute_length_spec(this: ref[TeXFOTBuilder], ls: LengthSpec) @ret_param_1 true @deep true returns int io reads tex_prog linked

    ; --- characters ------------------------------------------------------------
    procedure add_headed_byte(mutable this: ref[TeXFOTBuilder], c: u8) @deep true io reads tex_prog linked

    procedure characters(mutable this: ref[TeXFOTBuilder], s: Slice[u32]) @deep true io reads tex_prog linked

    ; charactersFromNode — the reference emits \Entity{name} for a preserved
    ; single-char SDATA entity node; our grove carries no entity-name axis on
    ; data nodes (the documented SDATA=data-char gap, S78), so every call
    ; falls through to characters().
    procedure characters_from_node(mutable this: ref[TeXFOTBuilder], node: ref[GroveNode]?, s: Slice[u32]) @ret_nonlocal true @deep true io reads tex_prog linked

    ; formattingInstruction — raw pass-through
    procedure formatting_instruction(mutable this: ref[TeXFOTBuilder], instr: StringC) @ret_nonlocal true @deep true linked

    ; --- node bracket ----------------------------------------------------------
    procedure start_node(mutable this: ref[TeXFOTBuilder], node: ref[GroveNode]?, mode_name: StringC) @ret_nonlocal true @deep true io reads tex_prog linked

    procedure end_node(mutable this: ref[TeXFOTBuilder]) @ret_nonlocal true @deep true io reads tex_prog linked

    ; --- link ------------------------------------------------------------------
    procedure start_link(mutable this: ref[TeXFOTBuilder], nic: ref[LinkNIC]) @ret_nonlocal true @deep true io reads tex_prog linked

    procedure end_link(mutable this: ref[TeXFOTBuilder]) @ret_nonlocal true @deep true linked

    ; --- sequence --------------------------------------------------------------
    procedure start_sequence(mutable this: ref[TeXFOTBuilder]) @ret_nonlocal true @deep true io reads tex_prog linked

    procedure end_sequence(mutable this: ref[TeXFOTBuilder]) @ret_nonlocal true @deep true io reads tex_prog linked

    ; --- line field ------------------------------------------------------------
    procedure start_line_field(mutable this: ref[TeXFOTBuilder], nic: ref[LineFieldNIC]) @ret_nonlocal true @deep true linked

    procedure end_line_field(mutable this: ref[TeXFOTBuilder]) @ret_nonlocal true @deep true io reads tex_prog linked

    ; --- NIC renderers ----------------------------------------------------------
    procedure set_display_nic(mutable this: ref[TeXFOTBuilder], nic: ref[DisplayNIC]) @deep true linked

