; dazzle - a Scaly port of the openjade DSSSL style engine (Part II of the
; dazzle epic, ROADMAP-dazzle.md). Stage 6a: faithful port, Insn/VM
; interpreter included; the JIT arrives in 6b behind the Expression seam,
; with the interpreter as its in-process differential oracle. Ported FROM
; the C# mirror (~/repos/openjade-net/src/OpenJade, dazzle-net for the
; directory flow object); James Clark's C++ upstream is the single source
; of truth on any doubt. See DESIGN.md for the RBMM mapping and port order.
;
; Memory doctrine: the run arena region holds everything that survives the
; run (interning, compiled rules, forced Identifier values, FOT output);
; construction-rule evaluation runs under nested per-node SCRATCH regions
; (ProcessContext's eval bracket via Interpreter.get_host) that die when
; the node is done — the RBMM shape of Clark's Collector. eq?-identity =
; arena address, stable because nothing is ever copied between regions;
; inner regions may point into outer ones, never back.

package scaly 0.1.0
package opensp 0.1.0

define dazzle
{
    ; the LLVM-C / ORC binding set the Stage-6b JIT needs (Llvm.scaly). Pure
    ; extern declarations, no dependency of its own, so it goes first.
    module Llvm
    ; The frame mark (DAZZLE_FRAME_MARK). Declared FIRST: VM, Insn, ELObj,
    ; Grove, Interpreter and Jit call into it, and it depends on nothing but
    ; Page.
    module FrameMark
    ; NamedTable<T> (generic/NamedTable.h) — the hash-probed name index behind
    ; the interning tables and the per-GI element-rule buckets. Declared first:
    ; it depends on nothing but Page/StringC, and both Interpreter and
    ; ProcessingMode build on it.
    module NameTable
    ; Stage 6a Inc 4 — the Grove (SGML property set): node model + builder.
    module Grove
    ; the GroveManager seam (style/GroveManager.h): sgml-parse's document
    ; loader + the per-run grove table. Declared right after Grove — it owns
    ; the GROVE_MGR cell that Primitive reads, and module declaration order
    ; decides whether a global resolves.
    module GroveManager
    ; NumberCache (style/NumberCache.cxx) — the per-GI element-numbering cache
    ; behind `element-number`/`element-number-list`. After Grove (it reads
    ; GN_ELEMENT and the document-order vector) and before Interpreter, which
    ; holds one per run exactly as the reference derives Interpreter from it.
    module NumberCache
    ; the define-language value (LangObj.cxx): case tables + the collation
    ; machinery. Declared BEFORE ELObj, whose Language arm points at it; it
    ; depends on nothing but Page/Array/StringC.
    module LangObj
    ; Stage 6a Inc 1 — the ELObj value model (ELObj.cs / ELObj.cxx).
    module ELObj
    ; Stage 6a Inc 8 — inherited characteristics + style stack (Style.cxx /
    ; InheritedC.cxx); declared before Insn/Expression/Interpreter, which
    ; read its IC_*/KEY_* constants.
    module Style
    ; Stage 6a Inc 3 — the evaluation engine: Insn/VM threaded-code core,
    ; Expression compiler, primitive dispatch (declared before Interpreter so
    ; its prim_id / opcode constants resolve).
    module Insn
    module VM
    module Expression
    module Primitive
    ; The escape analysis over the Insn graph (DAZZLE_ESCAPE). Declared right
    ; AFTER Primitive and not earlier: its audit table is written against
    ; Primitive's PRIM_* constants, and a module-level `define` read from a
    ; module declared LATER is dropped in silence — as a call argument it takes
    ; the whole call with it, which would leave the table uniformly conservative.
    ; `Escape.setup` checks exactly that before it turns itself on.
    module Escape
    ; Stage 6b — the JIT: the Insn graph lowered to native code through
    ; scaly/llvm + ORC. Declared AFTER the evaluation core so it can read the
    ; Insn/VM/Style/Primitive types and constants (a module-level `define` read
    ; from an EARLIER-declared module is the silent-drop trap); VM calls back
    ; into it, which is a plain forward function reference and resolves the same
    ; way Insn's calls into Primitive do.
    module Jit
    ; Stage 6a Inc 5 — the style engine: pattern matcher, processing modes
    ; (construction rules), and the ProcessContext that drives a grove through
    ; them into a FOTBuilder.
    module Pattern
    module ProcessingMode
    module ProcessContext
    ; Stage 6a Inc 5b (slice A) — the faithful transform SGML/XML output sink
    ; (record-end state machine + flow-object callbacks + entity/directory
    ; file emission), replacing the Inc 5a character collector.
    module TransformFOTBuilder
    ; Stage 6a Inc 8 — the `-t fot` backend (SgmlFOTBuilder.cxx).
    module SgmlFOTBuilder
    ; Stage 6a step 3 — the `-t rtf` backend (RtfFOTBuilder.cxx) + the
    ; styled-sink dispatch seam; SaveFOTBuilder is the recorded-call capture
    ; medium for ports/connections (declared before FotSink — it defines the
    ; SV_* tag constants FotSink's replay walker reads).
    module RtfFOTBuilder
    ; the `-t tex` backend (TeXFOTBuilder.cxx) — declared before FotSink,
    ; which dispatches to it.
    module TeXFOTBuilder
    ; the `-t html` backend (HtmlFOTBuilder.cxx, JADE_HTML).
    module HtmlFOTBuilder
    ; the `-t mif` backend (MifFOTBuilder.cxx, JADE_MIF) — a MIF document
    ; object model written out at commit(), one file per book component.
    module MifFOTBuilder
    module SaveFOTBuilder
    module FotSink
    ; Stage 6a Inc 2 — the reader: Interpreter reader seam + SchemeParser
    ; datum reader (generated tables: InterpreterMessages, CharNames, Sdata).
    module InterpreterMessages
    module Interpreter
    module CharNames
    module CharProps
    module Sdata
    module SchemeParser
    module DssslSpecEventHandler

    procedure test() returns int mutable CM_SCRATCH_ARENAS, CM_SCRATCH_INLINE, CM_SCRATCH_PAGES, CM_SCRATCH_STATE, CM_SCRATCH_STATS, GROVE_MGR, JIT_COMPILE_USEC, JIT_N_ENTRIES, JIT_N_ENTRY_POINTS, JIT_N_INSNS, JIT_N_INTERP_STEPS, JIT_N_MODULES, JIT_N_NATIVE_INSNS, JIT_N_REGIONS, JIT_N_REJECTED, JIT_PIPELINE, JIT_SESSION, SPEC_ARENA_FREED, SPEC_ARENA_HELD, SPEC_ARENA_STATE, SPEC_ARENA_STATS, SPEC_CHUNKS_KEPT, SPEC_CHUNK_CHARS, es_bailed, es_code_region, es_d, es_depth_bad, es_depth_checks, es_dyn_bytes_aband, es_dyn_bytes_esc, es_dyn_bytes_local, es_dyn_bytes_none, es_dyn_calls_aband, es_dyn_calls_esc, es_dyn_calls_local, es_dyn_calls_none, es_dyn_crossed, es_host, es_iters, es_n_bodies, es_n_both, es_n_local, es_n_ok, es_n_pub, es_n_ret, es_n_roots, es_n_sites, es_n_unaudited, es_state, es_stats, es_stats_on, es_tick_bump, es_tick_class, es_tick_page, es_trust, es_verify, es_writing, eval_region, fm_backfill, fm_below, fm_below_checked, fm_below_missed, fm_limit, fm_s, fm_scan, fm_seq, fm_state, fm_stats, fm_trap, fm_trap_pop, fm_verified, fm_verify, fm_violations, fm_walk, fm_walk_max, fm_watch, fm_watch_at, g_es_b_arity, g_es_b_ins, g_es_b_len, g_es_b_off, g_es_b_ok, g_es_b_pub, g_es_b_ret, g_es_b_root, g_es_bail, g_es_bodies, g_es_cur, g_es_depths, g_es_ed_next, g_es_ed_to, g_es_i_addr, g_es_i_depth, g_es_i_soff, g_es_nd_ehead, g_es_nd_flags, g_es_nd_insn, g_es_nd_owner, g_es_prim, g_es_prop, g_es_seen, g_es_stack, g_es_verdicts, g_es_work, memo_perm, memo_sites_nl, memo_sites_rope, perm_cell, sib_hint_index, sib_hint_parent, tfb_probe, tfb_probe_bufcap, tfb_probe_bytes, tfb_probe_ent, tfb_probe_files, tfb_probe_first, tfb_probe_last, tfb_probe_mark
    {
        var result NameTable.test()
        if result <> 0
            return result - 50

        set result: ELObj.test()
        if result <> 0
            return result - 100

        set result: Interpreter.test()
        if result <> 0
            return result - 200

        set result: SchemeParser.test()
        if result <> 0
            return result - 300

        set result: DssslSpecEventHandler.test()
        if result <> 0
            return result - 400

        set result: TransformFOTBuilder.test()
        if result <> 0
            return result - 500

        set result: SgmlFOTBuilder.test()
        if result <> 0
            return result - 600

        0
    }
}
