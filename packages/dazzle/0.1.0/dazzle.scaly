; dazzle - a Scaly port of the openjade DSSSL style engine (Part II of the
; dazzle epic, ROADMAP-dazzle.md). Stage 6a: faithful port, Insn/VM
; interpreter included; the JIT arrives in 6b behind the Expression seam,
; with the interpreter as its in-process differential oracle. Ported FROM
; the C# mirror (~/repos/openjade-net/src/OpenJade, dazzle-net for the
; directory flow object); James Clark's C++ upstream is the single source
; of truth on any doubt. See DESIGN.md for the RBMM mapping and port order.
;
; Memory doctrine: the run arena region holds everything that survives the
; run (interning, compiled rules, forced Identifier values, FOT output);
; construction-rule evaluation runs under nested per-node SCRATCH regions
; (ProcessContext's eval bracket via Interpreter.get_host) that die when
; the node is done — the RBMM shape of Clark's Collector. eq?-identity =
; arena address, stable because nothing is ever copied between regions;
; inner regions may point into outer ones, never back.

package scaly 0.1.0
package opensp 0.1.0

define dazzle
{
    ; Stage 6a Inc 4 — the Grove (SGML property set): node model + builder.
    module Grove
    ; Stage 6a Inc 1 — the ELObj value model (ELObj.cs / ELObj.cxx).
    module ELObj
    ; Stage 6a Inc 8 — inherited characteristics + style stack (Style.cxx /
    ; InheritedC.cxx); declared before Insn/Expression/Interpreter, which
    ; read its IC_*/KEY_* constants.
    module Style
    ; Stage 6a Inc 3 — the evaluation engine: Insn/VM threaded-code core,
    ; Expression compiler, primitive dispatch (declared before Interpreter so
    ; its prim_id / opcode constants resolve).
    module Insn
    module VM
    module Expression
    module Primitive
    ; Stage 6a Inc 5 — the style engine: pattern matcher, processing modes
    ; (construction rules), and the ProcessContext that drives a grove through
    ; them into a FOTBuilder.
    module Pattern
    module ProcessingMode
    module ProcessContext
    ; Stage 6a Inc 5b (slice A) — the faithful transform SGML/XML output sink
    ; (record-end state machine + flow-object callbacks + entity/directory
    ; file emission), replacing the Inc 5a character collector.
    module TransformFOTBuilder
    ; Stage 6a Inc 8 — the `-t fot` backend (SgmlFOTBuilder.cxx).
    module SgmlFOTBuilder
    ; Stage 6a step 3 — the `-t rtf` backend (RtfFOTBuilder.cxx) + the
    ; styled-sink dispatch seam; SaveFOTBuilder is the recorded-call capture
    ; medium for ports/connections (declared before FotSink — it defines the
    ; SV_* tag constants FotSink's replay walker reads).
    module RtfFOTBuilder
    ; the `-t tex` backend (TeXFOTBuilder.cxx) — declared before FotSink,
    ; which dispatches to it.
    module TeXFOTBuilder
    ; the `-t html` backend (HtmlFOTBuilder.cxx, JADE_HTML).
    module HtmlFOTBuilder
    ; the `-t mif` backend (MifFOTBuilder.cxx, JADE_MIF) — a MIF document
    ; object model written out at commit(), one file per book component.
    module MifFOTBuilder
    module SaveFOTBuilder
    module FotSink
    ; Stage 6a Inc 2 — the reader: Interpreter reader seam + SchemeParser
    ; datum reader (generated tables: InterpreterMessages, CharNames, Sdata).
    module InterpreterMessages
    module Interpreter
    module CharNames
    module Sdata
    module SchemeParser
    module DssslSpecEventHandler

    function test() returns int
    {
        var result ELObj.test()
        if result <> 0
            return result - 100

        set result: Interpreter.test()
        if result <> 0
            return result - 200

        set result: SchemeParser.test()
        if result <> 0
            return result - 300

        set result: DssslSpecEventHandler.test()
        if result <> 0
            return result - 400

        set result: TransformFOTBuilder.test()
        if result <> 0
            return result - 500

        set result: SgmlFOTBuilder.test()
        if result <> 0
            return result - 600

        0
    }
}
