function dsssl_data_name(i: int) returns String
{
    if i = 0
        return "builtins.dsl"
    if i = 1
        return "catalog"
    if i = 2
        return "dsssl.dtd"
    if i = 3
        return "fot.dtd"
    if i = 4
        return "style-sheet.dtd"
    ""
}

