; SgmlFOTBuilder — the `-t fot` backend: the flow object tree dumped as SGML
; (Stage 6a Inc 8, slice 1). Ported from ~/repos/dazzle/jade/SgmlFOTBuilder.cxx
; (C++ oracle; C# mirror openjade-net/src/OpenJade/Jade/SgmlFOTBuilder.cs).
;
; Structure mirror: the reference's ~147 characteristic setters each render
; ` name="value"` into the `ics_` string stream, flushed by the next flow
; object's start into its start tag; here one set_ic renders a Style.InheritedC
; by kind (the fot backend is a pure printer — the semantic setters return
; with the RTF port). Flow objects of this slice: sequence, paragraph,
; paragraph-break, display-group, line-field, plus text/characters and the
; pending-anchor machinery (<a name=.../> for source elements). Units print in
; the reference's millipoint format (72000 units/inch, "%03d" + point-insert —
; quirks preserved: 500 -> ".5pt"); the LengthSpec display-size factor is NEVER
; printed (dead sprintf in the reference operator<<).
;
; Output frame: `<?xml version="1.0"?>` RE `<fot>` RE ... `</fot>` RE, RE =
; 0x0D rendered as the output newline by the record encoder at flush (the
; RecordOutputCharStream seam, same as the transform sink).
;
; RBMM: both buffers (out, ics) live on the sink's own page; ics is reused
; via a length cursor (the open_elements pattern), never reallocated per FO.

use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String.String
use opensp.StringC.StringC
use opensp.CodingSystem.CodingSystem
use dazzle.Grove.GroveNode
use dazzle.ELObj.Identifier
use dazzle.ELObj.ELObj
use dazzle.ELObj.GlyphSubstTableRec
use dazzle.ELObj.OutputCharStream
use dazzle.Style.InheritedC
use dazzle.Style.RuleNICRec
use dazzle.Style.LinkNICRec
use dazzle.Style.GraphicNICRec
use dazzle.Style.LeaderNICRec
use dazzle.Style.BoxNICRec
use dazzle.Style.ScoreNICRec
use dazzle.Style.LengthSpec
use dazzle.Style.DisplaySpace
use dazzle.Style.InlineSpace
use dazzle.Style.FotSym
use dazzle.Style.DisplayNIC
use dazzle.Style.TableNICRec
use dazzle.Style.TableColumnNICRec
use dazzle.Style.TableCellNICRec

define SgmlFOTBuilder
(
    out: pointer[Array[u32]]
    ics: pointer[Array[u32]]
    ics_len: size_t
    in_ics: bool
    ; the header/footer capture (curOs_ = &hfs_ between startSimplePageSequence
    ; and endAllSimplePageSequenceHeaderFooter); hf holds the 24 extracted
    ; part strings (StringC hf_[nHF]).
    hfs: pointer[Array[u32]]
    hfs_len: size_t
    in_hfs: bool
    hf: pointer[Array[StringC]]
    pending_elements: pointer[Array[pointer[GroveNode]]]
    pending_levels: pointer[Array[int]]
    pending_count: size_t
    n_pending_non_empty: int
    node_level: int
    suppress_anchors: bool
    ; (the label:/content-map: port capture moved UP to the FotSink seam —
    ; recorded calls, SaveFOTBuilder.scaly; this sink only ever renders the
    ; live stream.)
    ; glyphSubstTableDefined_ — which gst<n> tables the dump has defined.
    gst_defined: pointer[Array[bool]]
    host: pointer[Page]
)
{
    function make(host: pointer[Page]) returns pointer[SgmlFOTBuilder]
    {
        let f host.allocate(sizeof SgmlFOTBuilder, alignof SgmlFOTBuilder) as pointer[SgmlFOTBuilder]
        set f.out: Array[u32]^host()
        set f.ics: Array[u32]^host()
        set f.ics_len: 0
        set f.in_ics: false
        set f.hfs: Array[u32]^host()
        set f.hfs_len: 0
        set f.in_hfs: false
        let hf Array[StringC]^host()
        var k 0
        while k < 24
        {
            hf.add(StringC())
            set k: k + 1
        }
        set f.hf: hf
        set f.pending_elements: Array[pointer[GroveNode]]^host()
        set f.pending_levels: Array[int]^host()
        set f.pending_count: 0
        set f.n_pending_non_empty: 0
        set f.node_level: 0
        set f.suppress_anchors: false
        set f.gst_defined: Array[bool]^host()
        set f.host: host
        f.raw("<?xml version=\"1.0\"?>")
        f.re()
        f.raw("<fot>")
        f.re()
        f
    }

    ; the destructor's closing tag — the CLI calls this before flushing.
    function finish(this: pointer[SgmlFOTBuilder])
    {
        this.raw("</fot>")
        this.re()
    }

    ; --- low-level output ----------------------------------------------------
    ; one char into the current stream (out, or ics while a set_ic renders).
    function put(this: pointer[SgmlFOTBuilder], c: u32)
    {
        if this.in_ics
        {
            if this.ics_len < this.ics.get_length()
                this.ics.put(this.ics_len, c)
            else
                this.ics.add(c)
            set this.ics_len: this.ics_len + (1 as size_t)
            return
        }
        this.out_put(c)
    }

    ; the curOs_ seam: the main tree, or the header/footer capture while a
    ; simple-page-sequence's parts render.
    function out_put(this: pointer[SgmlFOTBuilder], c: u32)
    {
        if this.in_hfs
        {
            if this.hfs_len < this.hfs.get_length()
                this.hfs.put(this.hfs_len, c)
            else
                this.hfs.add(c)
            set this.hfs_len: this.hfs_len + (1 as size_t)
            return
        }
        this.out.add(c)
    }

    function raw(this: pointer[SgmlFOTBuilder], s: pointer[const_char])
    {
        var i: size_t 0
        while true
        {
            let b *((s as pointer[u8]) + i)
            if b = (0 as u8)
                break
            this.put(b as u32)
            set i: i + 1
        }
    }

    function re(this: pointer[SgmlFOTBuilder])
        this.put(0x0D as u32)

    function raw_stringc(this: pointer[SgmlFOTBuilder], s: StringC)
    {
        let n s.get_size()
        var i: size_t 0
        while i < n
        {
            this.put(s.get(i))
            set i: i + 1
        }
    }

    ; unsigned decimal.
    function raw_uint(this: pointer[SgmlFOTBuilder], n_in: int)
    {
        var n n_in
        if n = 0
        {
            this.put(0x30 as u32)
            return
        }
        var digits u8[24]
        var k 0
        while n > 0
        {
            set *((digits as pointer[u8]) + k): ((n % 10) + 0x30) as u8
            set n: n / 10
            set k: k + 1
        }
        while k > 0
        {
            set k: k - 1
            this.put((*((digits as pointer[u8]) + k)) as u32)
        }
    }

    ; signed long per the reference operator<< (sign, then magnitude).
    function raw_int(this: pointer[SgmlFOTBuilder], n: int)
    {
        if n < 0
        {
            this.put(0x2D as u32)
            this.raw_uint(0 - n)
        }
        else
            this.raw_uint(n)
    }

    ; Data escaping (operator<<(Data)): &amp; &lt; &gt; &quot;, raw ASCII,
    ; numeric char refs at and above 0x80.
    function data_escaped(this: pointer[SgmlFOTBuilder], s: pointer[u32], n: size_t)
    {
        var i: size_t 0
        while i < n
        {
            let c *(s + i)
            if c = (0x26 as u32)
                this.raw("&amp;")
            else if c = (0x3C as u32)
                this.raw("&lt;")
            else if c = (0x3E as u32)
                this.raw("&gt;")
            else if c = (0x22 as u32)
                this.raw("&quot;")
            else if c < (0x80 as u32)
                this.put(c)
            else
            {
                this.raw("&#")
                this.raw_uint(c as int)
                this.put(0x3B as u32)
            }
            set i: i + (1 as size_t)
        }
    }

    ; Units — the reference "%03d" + point-insertion algorithm, quirks intact
    ; (500 -> ".5pt", -500 -> "-.5pt", 0 -> "0pt", 12000 -> "12pt").
    function units(this: pointer[SgmlFOTBuilder], n_in: int)
    {
        var buf u8[32]
        var len 0
        var n n_in
        if n < 0
        {
            set *((buf as pointer[u8])): 0x2D as u8
            set len: 1
            set n: 0 - n
        }
        var tmp u8[24]
        var k 0
        while n > 0
        {
            set *((tmp as pointer[u8]) + k): ((n % 10) + 0x30) as u8
            set n: n / 10
            set k: k + 1
        }
        while k < 3
        {
            set *((tmp as pointer[u8]) + k): 0x30 as u8
            set k: k + 1
        }
        while k > 0
        {
            set k: k - 1
            set *((buf as pointer[u8]) + len): *((tmp as pointer[u8]) + k)
            set len: len + 1
        }
        ; count up to three trailing zeros
        var i 0
        while i < 3
        {
            if *((buf as pointer[u8]) + (len - i - 1)) <> (0x30 as u8)
                break
            set i: i + 1
        }
        if i = 3
        {
            ; whole points: drop the three zeros
            set i: len - 3
            if i = 0
            {
                set *((buf as pointer[u8])): 0x30 as u8
                set i: 1
            }
        }
        else
        {
            ; shift the last digits right and insert the point (sprintf-quirk
            ; faithful: ".5pt", "-.5pt", "1.005pt")
            let j len + 1 - i
            while i < 3
            {
                set *((buf as pointer[u8]) + (len - i)): *((buf as pointer[u8]) + (len - i - 1))
                set i: i + 1
            }
            set *((buf as pointer[u8]) + (len - 3)): 0x2E as u8
            set i: j
        }
        var m 0
        while m < i
        {
            this.put((*((buf as pointer[u8]) + m)) as u32)
            set m: m + 1
        }
        this.raw("pt")
    }

    ; operator<<(LengthSpec) — factor-bearing specs print ONLY the length part
    ; (the reference never streams the sprintf'd percentage; dead code kept
    ; faithfully).
    function length_spec(this: pointer[SgmlFOTBuilder], ls: LengthSpec)
    {
        if ls.factor <> 0.0
        {
            if ls.length <> 0
            {
                this.units(ls.length)
                if ls.factor >= 0.0
                    this.put(0x2B as u32)
            }
            return
        }
        this.units(ls.length)
    }

    ; "%.2f" — two decimals, round half away from zero (printf shape for the
    ; factor magnitudes the corpus produces).
    function raw_fixed2(this: pointer[SgmlFOTBuilder], d_in: double)
    {
        var d d_in
        if d < 0.0
        {
            this.put(0x2D as u32)
            set d: 0.0 - d
        }
        let cents ((d * 100.0) + 0.5) as int
        this.raw_uint(cents / 100)
        this.put(0x2E as u32)
        let frac cents % 100
        this.put(((frac / 10) + 0x30) as u32)
        this.put(((frac % 10) + 0x30) as u32)
    }

    ; operator<<(TableLengthSpec) — unlike the plain LengthSpec operator this
    ; one really prints the factors: "%.2f%%" for display-size, "%.2f*" for
    ; table-unit, '+'-joined after a leading length.
    function table_length_spec(this: pointer[SgmlFOTBuilder], ls: LengthSpec, tfactor: double)
    {
        if (ls.factor <> 0.0) or (tfactor <> 0.0)
        {
            var need_sign false
            if ls.length <> 0
            {
                this.units(ls.length)
                set need_sign: true
            }
            if ls.factor <> 0.0
            {
                if need_sign and (ls.factor >= 0.0)
                    this.put(0x2B as u32)
                this.raw_fixed2(ls.factor * 100.0)
                this.put(0x25 as u32)
                set need_sign: true
            }
            if tfactor <> 0.0
            {
                if need_sign and (tfactor >= 0.0)
                    this.put(0x2B as u32)
                this.raw_fixed2(tfactor)
                this.put(0x2A as u32)
            }
            return
        }
        this.units(ls.length)
    }

    ; hex2 — two uppercase hex digits.
    function hex2(this: pointer[SgmlFOTBuilder], c: int)
    {
        let digits "0123456789ABCDEF"
        this.put((*((digits as pointer[u8]) + ((c >> 4) & 0xF))) as u32)
        this.put((*((digits as pointer[u8]) + (c & 0xF))) as u32)
    }

    ; operator<<(DeviceRGBColor) — '#RRGGBB'.
    function color_out(this: pointer[SgmlFOTBuilder], rgb: int)
    {
        this.put(0x23 as u32)
        this.hex2((rgb >> 16) & 0xFF)
        this.hex2((rgb >> 8) & 0xFF)
        this.hex2(rgb & 0xFF)
    }

    ; inlineSpaceC — reference quirks kept faithfully: nothing at all when
    ; nominal, min and max are all zero; and the value is NEVER closed (the
    ; reference forgets the trailing quote).
    function inline_space_c(this: pointer[SgmlFOTBuilder], name: StringC, sp: pointer[InlineSpace])
    {
        var any sp.nominal.is_set()
        if sp.min.is_set()
            set any: true
        if sp.max.is_set()
            set any: true
        if any = false
            return
        this.put(0x20 as u32)
        this.raw_stringc(name)
        this.put(0x3D as u32)
        this.put(0x22 as u32)
        this.length_spec(sp.nominal)
        var diff sp.min.differs(sp.nominal)
        if sp.max.differs(sp.nominal)
            set diff: true
        if diff
        {
            this.put(0x2C as u32)
            this.length_spec(sp.min)
            this.put(0x2C as u32)
            this.length_spec(sp.max)
        }
    }

    function sym_out(this: pointer[SgmlFOTBuilder], s: FotSym)
    {
        if s.code = SYM_FALSE
        {
            this.raw("false")
            return
        }
        if s.code = SYM_TRUE
        {
            this.raw("true")
            return
        }
        this.raw_stringc(s.name)
    }

    ; --- characteristic rendering (the set* family) --------------------------
    function set_ic(this: pointer[SgmlFOTBuilder], ic: pointer[InheritedC])
    {
        let kind ic.get_kind()
        ; IgnoredC::set is a no-op — nothing rendered (BorderC and RuleC
        ; included).
        if kind = IC_IGNORED
            return
        if kind = IC_BORDER
            return
        if kind = IC_RULE
            return
        if kind = IC_GST
        {
            this.gst_out(ic.gst)
            return
        }
        ; setInlineSpaceSpace is not overridden in the reference SgmlFOTBuilder
        ; — an inline-space-space set renders nothing.
        if kind = IC_OPT_INLINE_SPACE
            return
        if kind = IC_INLINE_SPACE
        {
            ; inlineSpaceC writes its own frame (no closing quote — quirk).
            set this.in_ics: true
            if ic.obj <> null
                this.inline_space_c(ic.print_name, ic.obj.as_inline_space() as pointer[InlineSpace])
            set this.in_ics: false
            return
        }
        if kind = IC_OPT_LENGTH_SPEC
        {
            if ic.bval
            {
                ; optLengthSpecC's #f arm omits the '=' (reference quirk).
                set this.in_ics: true
                this.put(0x20 as u32)
                this.raw_stringc(ic.print_name)
                this.put(0x22 as u32)
                this.raw("false")
                this.put(0x22 as u32)
                set this.in_ics: false
                return
            }
        }
        set this.in_ics: true
        this.put(0x20 as u32)
        this.raw_stringc(ic.print_name)
        this.put(0x3D as u32)
        this.put(0x22 as u32)
        if kind = IC_BOOL
        {
            if ic.bval
                this.raw("true")
            else
                this.raw("false")
        }
        else if kind = IC_LENGTH
            this.units(ic.lval)
        else if kind = IC_LENGTH_SPEC
            this.length_spec(ic.ls)
        else if kind = IC_SYMBOL
            this.sym_out(ic.sym)
        else if kind = IC_STRING
            this.raw_stringc(ic.sval)
        else if kind = IC_INT
            this.raw_int(ic.lval)
        else if kind = IC_MAYBE_INT
            ; GenericMaybeIntegerInheritedC::set calls the integer setter
            ; unconditionally (#f arrives as 0).
            this.raw_int(ic.lval)
        else if kind = IC_PUBLIC_ID
        {
            ; publicIdC: an unset/empty id prints "false"
            if ic.bval or (ic.sval.get_size() = (0 as size_t))
                this.raw("false")
            else
                this.raw_stringc(ic.sval)
        }
        else if kind = IC_LETTER2
        {
            if ic.bval or (ic.sval.get_size() = (0 as size_t))
                this.raw("false")
            else
                this.raw_stringc(ic.sval)
        }
        else if kind = IC_OPT_LENGTH_SPEC
            ; the has-length arm (the #f arm returned above).
            this.length_spec(ic.ls)
        else if kind = IC_COLOR
        {
            if ic.obj <> null
                this.color_out(ic.obj.color_rgb())
        }
        else if kind = IC_OPT_COLOR
        {
            ; setBackgroundColor() (no arg, #f) prints "false".
            if ic.obj = null
                this.raw("false")
            else
                this.color_out(ic.obj.color_rgb())
        }
        this.put(0x22 as u32)
        set this.in_ics: false
    }

    ; a GlyphId attribute value: the public id (raw), "::<suffix>" when the
    ; suffix is set; an id-less glyph id prints "false".
    function glyph_id_out(this: pointer[SgmlFOTBuilder], gid: pointer[ELObj])
    {
        let pubid gid.glyph_pubid()
        if pubid.get_size() = (0 as size_t)
        {
            this.raw("false")
            return
        }
        this.raw_stringc(pubid)
        let suffix gid.glyph_suffix()
        if suffix <> 0
        {
            this.raw("::")
            this.raw_int(suffix)
        }
    }

    ; setGlyphSubstTable — the reference dump: first use of a table writes a
    ; <define-glyph-subst-table id="gst<n>"> block to the MAIN stream (before
    ; the element's open tag — set* runs at style push); the characteristic
    ; itself renders the space-separated id list into the ics buffer.
    function gst_out(this: pointer[SgmlFOTBuilder], tabs: pointer[Array[pointer[GlyphSubstTableRec]]])
    {
        set this.in_ics: true
        this.raw(" glyph-subst-table=")
        this.put(0x22 as u32)
        var n: size_t 0
        if tabs <> null
            set n: tabs.get_length()
        var i: size_t 0
        while i < n
        {
            let tp tabs.get(i)
            if tp <> null
            {
                let t *tp
                let uid t.get_unique_id()
                while this.gst_defined.get_length() <= (uid as size_t)
                    this.gst_defined.add(false)
                var need true
                let dp this.gst_defined.get(uid as size_t)
                if dp <> null
                {
                    if *dp
                        set need: false
                }
                if need
                {
                    this.gst_defined.put(uid as size_t, true)
                    set this.in_ics: false
                    this.raw("<define-glyph-subst-table id=")
                    this.put(0x22 as u32)
                    this.raw("gst")
                    this.raw_int(uid)
                    this.put(0x22 as u32)
                    this.put(0x3E as u32)
                    this.re()
                    let pairs t.get_pairs()
                    let np pairs.get_length()
                    var j: size_t 0
                    while j < np
                    {
                        let op pairs.get(j)
                        let vp pairs.get(j + (1 as size_t))
                        if op <> null
                        {
                            if vp <> null
                            {
                                this.raw("<glyph-subst old=")
                                this.put(0x22 as u32)
                                this.glyph_id_out(*op)
                                this.put(0x22 as u32)
                                this.raw(" new=")
                                this.put(0x22 as u32)
                                this.glyph_id_out(*vp)
                                this.put(0x22 as u32)
                                this.raw("/>")
                                this.re()
                            }
                        }
                        set j: j + (2 as size_t)
                    }
                    ; the reference emits NO record end after the closing tag.
                    this.raw("</define-glyph-subst-table>")
                    set this.in_ics: true
                }
                if i > (0 as size_t)
                    this.put(0x20 as u32)
                this.raw("gst")
                this.raw_int(uid)
            }
            set i: i + (1 as size_t)
        }
        this.put(0x22 as u32)
        set this.in_ics: false
    }

    function output_ics(this: pointer[SgmlFOTBuilder])
    {
        let n this.ics_len
        let b this.ics.get_buffer()
        var i: size_t 0
        while i < n
        {
            this.out_put(*(b + i))
            set i: i + (1 as size_t)
        }
        set this.ics_len: 0
    }

    ; --- NIC rendering --------------------------------------------------------
    function display_space_nic(this: pointer[SgmlFOTBuilder], name: pointer[const_char], ds: DisplaySpace)
    {
        var any ds.nominal.is_set()
        if ds.min.is_set()
            set any: true
        if ds.max.is_set()
            set any: true
        if any
        {
            this.put(0x20 as u32)
            this.raw(name)
            this.put(0x3D as u32)
            this.put(0x22 as u32)
            this.length_spec(ds.nominal)
            var diff ds.min.differs(ds.nominal)
            if ds.max.differs(ds.nominal)
                set diff: true
            if diff
            {
                this.put(0x2C as u32)
                this.length_spec(ds.min)
                this.put(0x2C as u32)
                this.length_spec(ds.max)
            }
            this.put(0x22 as u32)
        }
        if ds.force
        {
            this.put(0x20 as u32)
            this.raw(name)
            this.raw("-priority=\"force\"")
        }
        else if ds.priority <> 0
        {
            this.put(0x20 as u32)
            this.raw(name)
            this.raw("-priority=")
            this.put(0x22 as u32)
            this.raw_int(ds.priority)
            this.put(0x22 as u32)
        }
        if ds.conditional = false
        {
            this.put(0x20 as u32)
            this.raw(name)
            this.raw("-conditional=\"false\"")
        }
    }

    function display_nic(this: pointer[SgmlFOTBuilder], nic: pointer[DisplayNIC])
    {
        if nic = null
            return
        if nic.keep_with_previous
            this.raw(" keep-with-previous=\"true\"")
        if nic.keep_with_next
            this.raw(" keep-with-next=\"true\"")
        if nic.may_violate_keep_before
            this.raw(" may-violate-keep-before=\"true\"")
        if nic.may_violate_keep_after
            this.raw(" may-violate-keep-after=\"true\"")
        if nic.position_preference.code <> SYM_FALSE
        {
            this.raw(" position-preference=\"")
            this.sym_out(nic.position_preference)
            this.put(0x22 as u32)
        }
        if nic.keep.code <> SYM_FALSE
        {
            this.raw(" keep=\"")
            this.sym_out(nic.keep)
            this.put(0x22 as u32)
        }
        if nic.break_before.code <> SYM_FALSE
        {
            this.raw(" break-before=\"")
            this.sym_out(nic.break_before)
            this.put(0x22 as u32)
        }
        if nic.break_after.code <> SYM_FALSE
        {
            this.raw(" break-after=\"")
            this.sym_out(nic.break_after)
            this.put(0x22 as u32)
        }
        this.display_space_nic("space-before", nic.space_before)
        this.display_space_nic("space-after", nic.space_after)
    }

    ; --- pending element anchors ----------------------------------------------
    function start_node(this: pointer[SgmlFOTBuilder], node: pointer[GroveNode], mode_name: StringC)
    {
        set this.node_level: this.node_level + 1
        if mode_name.get_size() <> (0 as size_t)
            return
        if node.get_class() <> GN_ELEMENT
            return
        var i: size_t 0
        while i < this.pending_count
        {
            let pp this.pending_elements.get(i)
            if pp <> null
            {
                if *pp = node
                    return
            }
            set i: i + (1 as size_t)
        }
        if this.pending_count < this.pending_elements.get_length()
        {
            this.pending_elements.put(this.pending_count, node)
            this.pending_levels.put(this.pending_count, this.node_level)
        }
        else
        {
            this.pending_elements.add(node)
            this.pending_levels.add(this.node_level)
        }
        set this.pending_count: this.pending_count + (1 as size_t)
    }

    function end_node(this: pointer[SgmlFOTBuilder])
    {
        if this.pending_count > (0 as size_t)
        {
            let lp this.pending_levels.get(this.pending_count - (1 as size_t))
            if lp <> null
            {
                if (*lp = this.node_level) and (this.n_pending_non_empty < (this.pending_count as int))
                    set this.pending_count: this.pending_count - (1 as size_t)
            }
        }
        set this.node_level: this.node_level - 1
    }

    function output_element_name(this: pointer[SgmlFOTBuilder], node: pointer[GroveNode])
    {
        let id node.get_id()
        if id.get_size() > (0 as size_t)
        {
            this.data_escaped(id.data_ptr(), id.get_size())
            return
        }
        ; groveIndex prefix omitted: the document grove is index 0 (external
        ; groves arrive with sgml-parse); elementIndex only.
        let ei node.get_element_index()
        if ei >= 0
            this.raw_uint(ei)
    }

    function flush_pending_elements(this: pointer[SgmlFOTBuilder])
    {
        if this.suppress_anchors
            return
        var i: size_t 0
        while i < this.pending_count
        {
            let pp this.pending_elements.get(i)
            if pp <> null
            {
                this.raw("<a name=\"")
                this.output_element_name(*pp)
                this.raw("\"/>")
                this.re()
            }
            set i: i + (1 as size_t)
        }
        set this.n_pending_non_empty: 0
        set this.pending_count: 0
    }

    ; --- text ------------------------------------------------------------------
    function characters(this: pointer[SgmlFOTBuilder], s: pointer[u32], n: size_t)
    {
        if n = (0 as size_t)
            return
        this.flush_pending_elements()
        this.raw("<text>")
        this.data_escaped(s, n)
        this.raw("</text>")
        this.re()
    }

    ; SDATA substitution is deferred grove-wide (see the transform sink); the
    ; plain character path matches.
    function characters_from_node(this: pointer[SgmlFOTBuilder], node: pointer[GroveNode], s: pointer[u32], n: size_t)
        this.characters(s, n)

    ; --- flow objects ------------------------------------------------------------
    function start_simple_flow_obj(this: pointer[SgmlFOTBuilder], name: pointer[const_char])
    {
        this.put(0x3C as u32)
        this.raw(name)
        this.output_ics()
        this.raw(">")
        this.re()
    }

    function end_flow(this: pointer[SgmlFOTBuilder], name: pointer[const_char])
    {
        this.raw("</")
        this.raw(name)
        this.raw(">")
        this.re()
    }

    function start_sequence(this: pointer[SgmlFOTBuilder])
        this.start_simple_flow_obj("sequence")

    function end_sequence(this: pointer[SgmlFOTBuilder])
        this.end_flow("sequence")

    function start_paragraph(this: pointer[SgmlFOTBuilder], nic: pointer[DisplayNIC])
    {
        this.raw("<paragraph")
        this.display_nic(nic)
        this.output_ics()
        this.raw(">")
        this.re()
    }

    function end_paragraph(this: pointer[SgmlFOTBuilder])
        this.end_flow("paragraph")

    function paragraph_break(this: pointer[SgmlFOTBuilder], nic: pointer[DisplayNIC])
    {
        this.raw("<paragraph-break")
        this.display_nic(nic)
        this.output_ics()
        this.raw("/>")
        this.re()
    }

    ; InlineNIC dump — the break priorities (only when nonzero).
    function inline_nic(this: pointer[SgmlFOTBuilder], break_before_priority: int, break_after_priority: int)
    {
        if break_before_priority <> 0
        {
            this.raw(" break-before-priority=\"")
            this.raw_int(break_before_priority)
            this.put(0x22 as u32)
        }
        if break_after_priority <> 0
        {
            this.raw(" break-after-priority=\"")
            this.raw_int(break_after_priority)
            this.put(0x22 as u32)
        }
    }

    ; SgmlFOTBuilder::rule — display NICs for the display orientations
    ; (horizontal/vertical), inline NICs otherwise; length only when set.
    function rule(this: pointer[SgmlFOTBuilder], nic: pointer[RuleNICRec], dnic: pointer[DisplayNIC])
    {
        this.flush_pending_elements()
        var orientation FotSym()
        var has_length false
        var length LengthSpec()
        var bbp 0
        var bap 0
        if nic <> null
        {
            set orientation: nic.orientation
            set has_length: nic.has_length
            set length: nic.length
            set bbp: nic.break_before_priority
            set bap: nic.break_after_priority
        }
        else
        {
            set orientation.code: SYM_HORIZONTAL
            set orientation.name: StringC("horizontal")
        }
        ; symbolName guard — a nameless orientation renders nothing.
        if orientation.name.get_size() = (0 as size_t)
            return
        this.raw("<rule orientation=")
        this.put(0x22 as u32)
        this.raw_stringc(orientation.name)
        this.put(0x22 as u32)
        if (orientation.code = SYM_HORIZONTAL) or (orientation.code = SYM_VERTICAL)
            this.display_nic(dnic)
        else
            this.inline_nic(bbp, bap)
        if has_length
        {
            this.raw(" length=")
            this.put(0x22 as u32)
            this.length_spec(length)
            this.put(0x22 as u32)
        }
        this.output_ics()
        this.raw("/>")
        this.re()
    }

    ; C's %g (the reference's operator<<(OutputCharStream&, double)).
    function raw_double(this: pointer[SgmlFOTBuilder], x: double)
    {
        let host this.host
        let os OutputCharStream.make(host)
        ELObj.print_double(os, x)
        this.raw_stringc(os.to_string_c(host))
    }

    ; SgmlFOTBuilder::startLink — ics BEFORE the destination (reference
    ; order); a resolved-node destination prints only for elements.
    function start_link(this: pointer[SgmlFOTBuilder], nic: pointer[LinkNICRec])
    {
        this.raw("<link")
        this.output_ics()
        var addr_type ADDR_NONE
        var node: pointer[GroveNode] null
        if nic <> null
        {
            set addr_type: nic.addr_type
            set node: nic.node as pointer[GroveNode]
        }
        if addr_type = ADDR_RESOLVED_NODE
        {
            if node <> null
            {
                if node.get_class() = GN_ELEMENT
                {
                    this.raw(" destination=")
                    this.put(0x22 as u32)
                    this.output_element_name(node)
                    this.put(0x22 as u32)
                }
            }
        }
        this.raw(">")
        this.re()
    }

    function end_link(this: pointer[SgmlFOTBuilder])
        this.end_flow("link")

    ; SgmlFOTBuilder::externalGraphic.
    function external_graphic(this: pointer[SgmlFOTBuilder], nic: pointer[GraphicNICRec], dnic: pointer[DisplayNIC])
    {
        this.flush_pending_elements()
        var r nic
        if r = null
            set r: GraphicNICRec.make(this.host)
        this.raw("<external-graphic entity-system-id=")
        this.put(0x22 as u32)
        this.data_escaped(r.entity_system_id.data_ptr(), r.entity_system_id.get_size())
        this.put(0x22 as u32)
        this.raw(" notation-system-id=")
        this.put(0x22 as u32)
        this.data_escaped(r.notation_system_id.data_ptr(), r.notation_system_id.get_size())
        this.put(0x22 as u32)
        if r.scale_type.code <> SYM_FALSE
        {
            this.raw(" scale=")
            this.put(0x22 as u32)
            this.raw_stringc(r.scale_type.name)
            this.put(0x22 as u32)
        }
        else
        {
            this.raw(" scale-x=")
            this.put(0x22 as u32)
            this.raw_double(r.scale_x)
            this.put(0x22 as u32)
            this.raw(" scale-y=")
            this.put(0x22 as u32)
            this.raw_double(r.scale_y)
            this.put(0x22 as u32)
        }
        if r.has_max_width
        {
            this.raw(" max-width=")
            this.put(0x22 as u32)
            this.length_spec(r.max_width)
            this.put(0x22 as u32)
        }
        if r.has_max_height
        {
            this.raw(" max-height=")
            this.put(0x22 as u32)
            this.length_spec(r.max_height)
            this.put(0x22 as u32)
        }
        if r.is_display
        {
            this.raw(" display=\"true\"")
            this.display_nic(dnic)
        }
        else
        {
            if r.escapement_direction.code <> SYM_FALSE
            {
                this.raw(" escapement-direction=")
                this.put(0x22 as u32)
                this.raw_stringc(r.escapement_direction.name)
                this.put(0x22 as u32)
            }
            ; positionPointX/Y print on LengthSpec truthiness (non-zero).
            let ppx r.position_point_x
            if ppx.is_set()
            {
                this.raw(" position-point-x=")
                this.put(0x22 as u32)
                this.length_spec(ppx)
                this.put(0x22 as u32)
            }
            let ppy r.position_point_y
            if ppy.is_set()
            {
                this.raw(" position-point-y=")
                this.put(0x22 as u32)
                this.length_spec(ppy)
                this.put(0x22 as u32)
            }
            this.inline_nic(r.break_before_priority, r.break_after_priority)
        }
        this.output_ics()
        this.raw("/>")
        this.re()
    }

    ; SgmlFOTBuilder::startLeader — the length prints UNQUOTED (reference
    ; quirk: `os() << " length=" << nic.length`).
    function start_leader(this: pointer[SgmlFOTBuilder], nic: pointer[LeaderNICRec])
    {
        this.flush_pending_elements()
        this.raw("<leader")
        if nic <> null
        {
            if nic.has_length
            {
                this.raw(" length=")
                this.length_spec(nic.length)
            }
            this.inline_nic(nic.break_before_priority, nic.break_after_priority)
        }
        this.output_ics()
        this.raw(">")
        this.re()
    }

    function end_leader(this: pointer[SgmlFOTBuilder])
        this.end_flow("leader")

    ; SgmlFOTBuilder::startBox.
    function start_box(this: pointer[SgmlFOTBuilder], nic: pointer[BoxNICRec], dnic: pointer[DisplayNIC])
    {
        this.flush_pending_elements()
        this.raw("<box")
        var is_display false
        var bbp 0
        var bap 0
        if nic <> null
        {
            set is_display: nic.is_display
            set bbp: nic.break_before_priority
            set bap: nic.break_after_priority
        }
        if is_display
        {
            this.raw(" display=\"true\"")
            this.display_nic(dnic)
        }
        else
            this.inline_nic(bbp, bap)
        this.output_ics()
        this.raw(">")
        this.re()
    }

    function end_box(this: pointer[SgmlFOTBuilder])
        this.end_flow("box")

    ; SgmlFOTBuilder::startScore (the three typed variants; symbolName guard
    ; on the symbol form).
    function start_score(this: pointer[SgmlFOTBuilder], nic: pointer[ScoreNICRec])
    {
        if nic.kind = SCORE_SYMBOL
        {
            if nic.sym.name.get_size() = (0 as size_t)
                return
            this.raw("<score type=")
            this.put(0x22 as u32)
            this.raw_stringc(nic.sym.name)
            this.put(0x22 as u32)
        }
        else if nic.kind = SCORE_LENGTH
        {
            this.raw("<score type=")
            this.put(0x22 as u32)
            this.length_spec(nic.length)
            this.put(0x22 as u32)
        }
        else
        {
            this.raw("<score type=\"char\" char=")
            this.put(0x22 as u32)
            this.put(nic.ch)
            this.put(0x22 as u32)
        }
        this.output_ics()
        this.raw(">")
        this.re()
    }

    function end_score(this: pointer[SgmlFOTBuilder])
        this.end_flow("score")

    function start_display_group(this: pointer[SgmlFOTBuilder], nic: pointer[DisplayNIC])
    {
        this.raw("<display-group")
        if nic <> null
        {
            if nic.has_coalesce_id
            {
                this.raw(" coalesce-id=\"")
                this.data_escaped(nic.coalesce_id.data_ptr(), nic.coalesce_id.get_size())
                this.put(0x22 as u32)
            }
        }
        this.display_nic(nic)
        this.output_ics()
        this.raw(">")
        this.re()
    }

    function end_display_group(this: pointer[SgmlFOTBuilder])
        this.end_flow("display-group")

    function start_line_field(this: pointer[SgmlFOTBuilder])
    {
        ; LineFieldNIC (inline priorities) is not printed by the reference.
        this.flush_pending_elements()
        this.start_simple_flow_obj("line-field")
    }

    function end_line_field(this: pointer[SgmlFOTBuilder])
        this.end_flow("line-field")

    ; --- simple-page-sequence -------------------------------------------------
    ; startSimplePageSequenceSerial: the start tag (ics flushed into it), then
    ; anchors off and output redirected into the header/footer capture until
    ; end_all_simple_page_sequence_header_footer.
    function start_simple_page_sequence(this: pointer[SgmlFOTBuilder])
    {
        this.start_simple_flow_obj("simple-page-sequence")
        set this.suppress_anchors: true
        set this.in_hfs: true
    }

    ; endSimplePageSequenceHeaderFooter(flags): hfs_.extractString(hf_[flags]).
    function end_simple_page_sequence_header_footer(this: pointer[SgmlFOTBuilder], flags: int)
    {
        let host this.host
        let s StringC^host(this.hfs.get_buffer(), this.hfs_len)
        this.hf.put(flags as size_t, s)
        set this.hfs_len: 0
    }

    ; endAllSimplePageSequenceHeaderFooter: restore the main stream, then the
    ; six part groups, each deduplicated across the four page types — front=
    ; only when front/back differ, first= only when first/other differ.
    function end_all_simple_page_sequence_header_footer(this: pointer[SgmlFOTBuilder])
    {
        set this.in_hfs: false
        set this.suppress_anchors: false
        var i 0
        while i < 24
        {
            let s3 this.hf_at(i + 3)
            let s2 this.hf_at(i + 2)
            let s1 this.hf_at(i + 1)
            let s0 this.hf_at(i + 0)
            var front 0
            if (s3.equals(s1) = false) or (s2.equals(s0) = false)
                set front: 2
            var first 0
            if (s3.equals(s2) = false) or (s1.equals(s0) = false)
                set first: 1
            var j 0
            while j <= front
            {
                var k 0
                while k <= first
                {
                    let str this.hf_at(i + j + k)
                    if str.get_size() <> (0 as size_t)
                    {
                        var side "left"
                        if (i & 8) <> 0
                            set side: "center"
                        else if (i & 16) <> 0
                            set side: "right"
                        var hf_name "footer"
                        if (i & 4) <> 0
                            set hf_name: "header"
                        this.raw("<simple-page-sequence.")
                        this.raw(side)
                        this.put(0x2D as u32)
                        this.raw(hf_name)
                        if front <> 0
                        {
                            this.raw(" front=\"")
                            if j <> 0
                                this.raw("true")
                            else
                                this.raw("false")
                            this.put(0x22 as u32)
                        }
                        if first <> 0
                        {
                            this.raw(" first=\"")
                            if k <> 0
                                this.raw("true")
                            else
                                this.raw("false")
                            this.put(0x22 as u32)
                        }
                        this.raw(">")
                        this.re()
                        this.raw_stringc(str)
                        this.raw("</simple-page-sequence.")
                        this.raw(side)
                        this.put(0x2D as u32)
                        this.raw(hf_name)
                        this.raw(">")
                        this.re()
                    }
                    set k: k + 1
                }
                set j: j + 2
            }
            set i: i + 4
        }
    }

    function end_simple_page_sequence(this: pointer[SgmlFOTBuilder])
        this.end_flow("simple-page-sequence")

    function hf_at(this: pointer[SgmlFOTBuilder], k: int) returns StringC
    {
        let pp this.hf.get(k as size_t)
        if pp = null
            return StringC()
        *pp
    }

    ; --- tables -----------------------------------------------------------------
    ; simpleFlowObj: an atomic element, ics flushed into the tag.
    function simple_flow_obj(this: pointer[SgmlFOTBuilder], name: pointer[const_char])
    {
        this.put(0x3C as u32)
        this.raw(name)
        this.output_ics()
        this.raw("/>")
        this.re()
    }

    function start_table(this: pointer[SgmlFOTBuilder], tnic: pointer[TableNICRec], dnic: pointer[DisplayNIC])
    {
        this.flush_pending_elements()
        this.raw("<table")
        if tnic <> null
        {
            if tnic.width_type = TABLE_WIDTH_EXPLICIT
            {
                this.raw(" width=\"")
                this.length_spec(tnic.width)
                this.put(0x22 as u32)
            }
            if tnic.width_type = TABLE_WIDTH_MINIMUM
                this.raw(" minimum-width=\"true\"")
        }
        this.display_nic(dnic)
        this.output_ics()
        this.raw(">")
        this.re()
    }

    function end_table(this: pointer[SgmlFOTBuilder])
        this.end_flow("table")

    function table_before_row_border(this: pointer[SgmlFOTBuilder])
        this.simple_flow_obj("table.before-row-border")

    function table_after_row_border(this: pointer[SgmlFOTBuilder])
        this.simple_flow_obj("table.after-row-border")

    function table_before_column_border(this: pointer[SgmlFOTBuilder])
        this.simple_flow_obj("table.before-column-border")

    function table_after_column_border(this: pointer[SgmlFOTBuilder])
        this.simple_flow_obj("table.after-column-border")

    function table_column(this: pointer[SgmlFOTBuilder], nic: pointer[TableColumnNICRec])
    {
        this.raw("<table-column column-number=\"")
        this.raw_uint(nic.column_index + 1)
        this.put(0x22 as u32)
        if nic.n_columns_spanned <> 1
        {
            this.raw(" n-columns-spanned=\"")
            this.raw_uint(nic.n_columns_spanned)
            this.put(0x22 as u32)
        }
        if nic.has_width
        {
            this.raw(" width=\"")
            this.table_length_spec(nic.width, nic.width_tfactor)
            this.put(0x22 as u32)
        }
        this.output_ics()
        this.raw("/>")
        this.re()
    }

    function start_table_part_serial(this: pointer[SgmlFOTBuilder], dnic: pointer[DisplayNIC])
    {
        this.raw("<table-part")
        this.display_nic(dnic)
        this.output_ics()
        this.raw(">")
        this.re()
        this.raw("<table-part.principal>")
        this.re()
    }

    function end_table_part_serial(this: pointer[SgmlFOTBuilder])
        this.end_flow("table-part")

    function start_table_part_header(this: pointer[SgmlFOTBuilder])
    {
        this.end_flow("table-part.principal")
        this.raw("<table-part.header>")
        this.re()
    }

    function end_table_part_header(this: pointer[SgmlFOTBuilder])
        this.end_flow("table-part.header")

    function start_table_part_footer(this: pointer[SgmlFOTBuilder])
    {
        this.raw("<table-part.footer>")
        this.re()
    }

    function end_table_part_footer(this: pointer[SgmlFOTBuilder])
        this.end_flow("table-part.footer")

    function start_table_row(this: pointer[SgmlFOTBuilder])
        this.start_simple_flow_obj("table-row")

    function end_table_row(this: pointer[SgmlFOTBuilder])
        this.end_flow("table-row")

    function start_table_cell(this: pointer[SgmlFOTBuilder], nic: pointer[TableCellNICRec])
    {
        if nic.missing
            this.raw("<table-cell column-number=\"0\"")
        else
        {
            this.raw("<table-cell column-number=\"")
            this.raw_uint(nic.column_index + 1)
            this.put(0x22 as u32)
            if nic.n_columns_spanned <> 1
            {
                this.raw(" n-columns-spanned=\"")
                this.raw_uint(nic.n_columns_spanned)
                this.put(0x22 as u32)
            }
            if nic.n_rows_spanned <> 1
            {
                this.raw(" n-rows-spanned=\"")
                this.raw_uint(nic.n_rows_spanned)
                this.put(0x22 as u32)
            }
        }
        this.output_ics()
        this.raw(">")
        this.re()
    }

    function end_table_cell(this: pointer[SgmlFOTBuilder])
        this.end_flow("table-cell")

    function table_cell_before_row_border(this: pointer[SgmlFOTBuilder])
        this.simple_flow_obj("table-cell.before-row-border")

    function table_cell_after_row_border(this: pointer[SgmlFOTBuilder])
        this.simple_flow_obj("table-cell.after-row-border")

    function table_cell_before_column_border(this: pointer[SgmlFOTBuilder])
        this.simple_flow_obj("table-cell.before-column-border")

    function table_cell_after_column_border(this: pointer[SgmlFOTBuilder])
        this.simple_flow_obj("table-cell.after-column-border")

    ; --- page-number references -------------------------------------------------
    function page_number(this: pointer[SgmlFOTBuilder])
    {
        this.raw("<page-number/>")
        this.re()
    }

    function current_node_page_number(this: pointer[SgmlFOTBuilder], node: pointer[GroveNode])
    {
        if node.get_class() <> GN_ELEMENT
            return
        this.raw("<page-number ref=\"")
        this.output_element_name(node)
        this.raw("\"/>")
        this.re()
    }

    ; --- flush ---------------------------------------------------------------
    ; the whole tree, record-encoded (RE -> NL, RS dropped) and UTF-8-encoded —
    ; the RecordOutputCharStream(EncodeOutputCharStream(file)) seam.
    function to_utf8(this: pointer[SgmlFOTBuilder]) returns String
    {
        let host this.host
        let buf this.out.get_buffer()
        let n this.out.get_length()
        let cap n * (4 as size_t) + (1 as size_t)
        let src host.allocate(n * (4 as size_t) + (4 as size_t), 4) as pointer[u32]
        var m: size_t 0
        var i: size_t 0
        while i < n
        {
            let c *(buf + i)
            if c = (0x0D as u32)
            {
                set *(src + m): (0x0A as u32)
                set m: m + (1 as size_t)
            }
            else if c = (0x0A as u32)
                0
            else
            {
                set *(src + m): c
                set m: m + (1 as size_t)
            }
            set i: i + (1 as size_t)
        }
        let bytes host.allocate(cap, 1) as pointer[u8]
        let cs CodingSystem.UTF8()
        let blen cs.encode(src, m, bytes, cap)
        String(bytes as pointer[const_char], blen)
    }

    ; the raw tree as a StringC — the unit-test observation point.
    function to_stringc(this: pointer[SgmlFOTBuilder], host: pointer[Page]) returns StringC
        StringC^host(this.out.get_buffer(), this.out.get_length())

    function test() returns int
    {
        let anchor StringC("x")
        let host Page.get(anchor.data_ptr() as pointer[void])

        ; 1. Units quirks (millipoints; reference "%03d" + point-insert)
        let f SgmlFOTBuilder.make(host)
        f.units(12000)
        f.units(500)
        f.units(0 - 500)
        f.units(0)
        f.units(1005)
        f.units(5)
        let got f.to_stringc(host)
        if got.equals(StringC("<?xml version=\"1.0\"?>\r<fot>\r12pt.5pt-.5pt0pt1.005pt.005pt")) = false
            return 0 - 1

        ; 2. text escaping incl. numeric char refs >= 0x80
        let f2 SgmlFOTBuilder.make(host)
        let chars Array[u32]^host()
        chars.add(0x61 as u32)
        chars.add(0x26 as u32)
        chars.add(0x3C as u32)
        chars.add(0xFC as u32)
        f2.characters(chars.get_buffer(), chars.get_length())
        f2.finish()
        let got2 f2.to_stringc(host)
        if got2.equals(StringC("<?xml version=\"1.0\"?>\r<fot>\r<text>a&amp;&lt;&#252;</text>\r</fot>\r")) = false
            return 0 - 2

        ; 3. ics buffer: a length IC flushed into a paragraph start tag
        let f3 SgmlFOTBuilder.make(host)
        let ident3 Identifier.make(host, StringC("font-size"))
        let ic3 InheritedC.make(host, IC_LENGTH, ident3, 0, StringC("font-size"))
        set ic3.lval: 18000
        f3.set_ic(ic3)
        f3.start_paragraph(null)
        f3.end_paragraph()
        let got3 f3.to_stringc(host)
        if got3.equals(StringC("<?xml version=\"1.0\"?>\r<fot>\r<paragraph font-size=\"18pt\">\r</paragraph>\r")) = false
            return 0 - 3

        0
    }
}
