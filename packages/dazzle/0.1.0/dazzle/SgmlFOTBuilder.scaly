    ; grid / grid-cell — their own start tags (a zero count prints nothing).
    function start_grid(this: ref[SgmlFOTBuilder], nic: ref[GridNICRec])
    {
        this.raw("<grid")
        if nic.n_columns <> 0
        {
            this.raw(" grid-n-columns=\"")
            this.raw_uint(nic.n_columns)
            this.put(0x22)
        }
        if nic.n_rows <> 0
        {
            this.raw(" grid-n-rows=\"")
            this.raw_uint(nic.n_rows)
            this.put(0x22)
        }
        this.output_ics()
        this.raw(">")
        this.re()
    }

    function end_grid(this: ref[SgmlFOTBuilder])
        this.end_flow("grid")

    function start_grid_cell(this: ref[SgmlFOTBuilder], nic: ref[GridCellNICRec])
    {
        this.raw("<grid-cell")
        if nic.column_number <> 0
        {
            this.raw(" column-number=\"")
            this.raw_uint(nic.column_number)
            this.put(0x22)
        }
        if nic.row_number <> 0
        {
            this.raw(" row-number=\"")
            this.raw_uint(nic.row_number)
            this.put(0x22)
        }
        this.output_ics()
        this.raw(">")
        this.re()
    }

    function end_grid_cell(this: ref[SgmlFOTBuilder])
        this.end_flow("grid-cell")

    ; --- the LAYOUT-COMPOSITE family ------------------------------------------
    ; SgmlFOTBuilder is the ONLY backend that overrides any of the five. All
    ; five opens are SELF-CLOSING (`… />` RE) and are then closed by a real
    ; `</…>` — the same asymmetry glyph-annotation and the math classes have.
    function start_embedded_text(this: ref[SgmlFOTBuilder], nic: ref[EmbeddedTextNICRec])
    {
        this.raw("<embedded-text")
        if nic.direction.code <> SYM_FALSE
        {
            this.raw(" direction=")
            this.put(0x22)
            this.sym_out(nic.direction)
            this.put(0x22)
        }
        this.output_ics()
        this.raw("/>")
        this.re()
    }

    function end_embedded_text(this: ref[SgmlFOTBuilder])
        this.end_flow("embedded-text")

    ; SgmlFOTBuilder::includedContainerAreaNIC — the class's own ten fields in
    ; the reference's order, then the display half (whose printer is byte-for-
    ; byte the tail of this function in the reference).
    ; ★`scale` prints for ANY non-false scaleType, and the initial one is
    ; symbolMaxUniform — an untouched included-container-area therefore carries
    ; scale="max-uniform". The name comes from the CODE (the reference prints
    ; symbolName(sym)); a defaulted symbol never went through a conversion and
    ; so carries no name string of its own.
    function start_included_container_area(this: ref[SgmlFOTBuilder], nic: ref[IncludedContainerAreaNICRec], dnic: ref[DisplayNIC])
    {
        this.raw("<included-container-area")
        if nic.escapement_direction.code <> SYM_FALSE
        {
            this.raw(" escapement-direction=")
            this.put(0x22)
            this.sym_out(nic.escapement_direction)
            this.put(0x22)
        }
        if nic.is_display
            this.raw(" display=\"true\"")
        if nic.scale_type.code <> SYM_FALSE
        {
            this.raw(" scale=")
            this.put(0x22)
            this.scale_sym_out(nic.scale_type)
            this.put(0x22)
        }
        else
        {
            this.raw(" scale-x=")
            this.put(0x22)
            this.raw_double(nic.scale_x)
            this.put(0x22)
            this.raw(" scale-y=")
            this.put(0x22)
            this.raw_double(nic.scale_y)
            this.put(0x22)
        }
        if nic.width_type = ICA_WIDTH_EXPLICIT
        {
            this.raw(" width=")
            this.put(0x22)
            this.length_spec(nic.width)
            this.put(0x22)
        }
        else if nic.width_type = ICA_WIDTH_MINIMUM
            this.raw(" minimum-width=\"true\"")
        if nic.height_type = ICA_HEIGHT_EXPLICIT
        {
            this.raw(" height=")
            this.put(0x22)
            this.length_spec(nic.height)
            this.put(0x22)
        }
        else if nic.height_type = ICA_HEIGHT_MINIMUM
            this.raw(" minimum-height=\"true\"")
        if nic.contents_rotation <> 0
        {
            this.raw(" contents-rotation=")
            this.put(0x22)
            this.raw_int(nic.contents_rotation)
            this.put(0x22)
        }
        let ppx nic.position_point_x
        if ppx.is_set()
        {
            this.raw(" position-point-x=")
            this.put(0x22)
            this.length_spec(ppx)
            this.put(0x22)
        }
        let ppy nic.position_point_y
        if ppy.is_set()
        {
            this.raw(" position-point-y=")
            this.put(0x22)
            this.length_spec(ppy)
            this.put(0x22)
        }
        this.inline_nic(nic.break_before_priority, nic.break_after_priority)
        this.display_nic(dnic)
        this.output_ics()
        this.raw("/>")
        this.re()
    }

    function end_included_container_area(this: ref[SgmlFOTBuilder])
        this.end_flow("included-container-area")

    function start_aligned_column(this: ref[SgmlFOTBuilder], dnic: ref[DisplayNIC])
    {
        this.raw("<aligned-column")
        this.display_nic(dnic)
        this.output_ics()
        this.raw("/>")
        this.re()
    }

    function end_aligned_column(this: ref[SgmlFOTBuilder])
        this.end_flow("aligned-column")

