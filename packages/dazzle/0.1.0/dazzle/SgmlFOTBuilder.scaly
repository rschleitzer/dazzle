    ; ★Both radical-radical forms OPEN `<radical.principal>` — the radical
    ; element itself is what start_radical_serial wrote, and the principal port
    ; only begins once the radical glyph (or its absence) is settled.
    function radical_radical(this: ref[SgmlFOTBuilder], nic: ref[CharacterNICRec])
    {
        this.raw("<radical.radical")
        this.character_nic(nic)
        this.output_ics()
        this.raw("/>")
        this.re()
        this.start_port_flow("radical.principal")
    }

