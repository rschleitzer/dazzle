; SgmlFOTBuilder — the `-t fot` backend: the flow object tree dumped as SGML
; (Stage 6a Inc 8, slice 1). Ported from ~/repos/dazzle/jade/SgmlFOTBuilder.cxx
; (C++ oracle; C# mirror openjade-net/src/OpenJade/Jade/SgmlFOTBuilder.cs).
;
; Structure mirror: the reference's ~147 characteristic setters each render
; ` name="value"` into the `ics_` string stream, flushed by the next flow
; object's start into its start tag; here one set_ic renders a Style.InheritedC
; by kind (the fot backend is a pure printer — the semantic setters return
; with the RTF port). Flow objects of this slice: sequence, paragraph,
; paragraph-break, display-group, line-field, plus text/characters and the
; pending-anchor machinery (<a name=.../> for source elements). Units print in
; the reference's millipoint format (72000 units/inch, "%03d" + point-insert —
; quirks preserved: 500 -> ".5pt"); the LengthSpec display-size factor is NEVER
; printed (dead sprintf in the reference operator<<).
;
; Output frame: `<?xml version="1.0"?>` RE `<fot>` RE ... `</fot>` RE, RE =
; 0x0D rendered as the output newline by the record encoder at flush (the
; RecordOutputCharStream seam, same as the transform sink).
;
; RBMM: both buffers (out, ics) live on the sink's own page; ics is reused
; via a length cursor (the open_elements pattern), never reallocated per FO.

use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String.String
use opensp.StringC.StringC
use opensp.CodingSystem.CodingSystem
use opensp.CodingSystemKit.CodingSystemKit
use opensp.CodingSystem.IENC_UTF8
use dazzle.Grove.GroveNode
use dazzle.Grove.GroveInfo
use dazzle.ELObj.Identifier
use dazzle.ELObj.ELObj
use dazzle.ELObj.GlyphSubstTableRec
use dazzle.ELObj.OutputCharStream
use dazzle.Style.InheritedC
use dazzle.Style.RuleNICRec
use dazzle.Style.LinkNICRec
use dazzle.Style.GraphicNICRec
use dazzle.Style.LeaderNICRec
use dazzle.Style.BoxNICRec
use dazzle.Style.ScoreNICRec
use dazzle.Style.LengthSpec
use dazzle.Style.DisplaySpace
use dazzle.Style.InlineSpace
use dazzle.Style.FotSym
use dazzle.Style.DisplayNIC
use dazzle.Style.TableNICRec
use dazzle.Style.TableColumnNICRec
use dazzle.Style.TableCellNICRec
use dazzle.Style.CharacterNICRec
use dazzle.Style.AnchorNICRec
use dazzle.Style.GlyphAnnotationNICRec
use dazzle.Style.EmphasizingMarkNICRec
use dazzle.Style.GridNICRec
use dazzle.Style.GridCellNICRec
use dazzle.Style.EmbeddedTextNICRec
use dazzle.Style.IncludedContainerAreaNICRec
use dazzle.Style.MultiModeRec
use dazzle.Style.MultiModeNICRec

define SgmlFOTBuilder
(
    out: ref[Array[u32]]
    ics: ref[Array[u32]]
    ics_len: size_t
    in_ics: bool
    ; the header/footer capture (curOs_ = &hfs_ between startSimplePageSequence
    ; and endAllSimplePageSequenceHeaderFooter); hf holds the 24 extracted
    ; part strings (StringC hf_[nHF]).
    hfs: ref[Array[u32]]
    hfs_len: size_t
    in_hfs: bool
    hf: ref[Array[StringC]]?
    ; em[0] — the emphasizing-mark's captured mark content (same buffer as the
    ; header/footer parts, exactly as in the reference).
    em: StringC
    pending_elements: ref[Array[ref[GroveNode]?]]
    pending_levels: ref[Array[int]]
    pending_count: size_t
    n_pending_non_empty: int
    node_level: int
    suppress_anchors: bool
    ; (the label:/content-map: port capture moved UP to the FotSink seam —
    ; recorded calls, SaveFOTBuilder.scaly; this sink only ever renders the
    ; live stream.)
    ; glyphSubstTableDefined_ — which gst<n> tables the dump has defined.
    gst_defined: ref[Array[bool]]
    ; multiModeHasPrincipalMode_ — one flag per open multi-mode: whether its
    ; principal `<multi-mode.mode>` is still open (the first named mode closes
    ; it, and so does the serial end if there is no named mode at all).
    mm_principal: ref[Array[bool]]
    mm_depth: size_t
    host: pointer[Page]
)
{
    function make(host: pointer[Page]) returns ref[SgmlFOTBuilder]
    {
        let f host.allocate(sizeof SgmlFOTBuilder, alignof SgmlFOTBuilder) as pointer[SgmlFOTBuilder]
        set f.out: Array[u32]^host()
        set f.ics: Array[u32]^host()
        set f.ics_len: 0
        set f.in_ics: false
        set f.hfs: Array[u32]^host()
        set f.hfs_len: 0
        set f.in_hfs: false
        let hf Array[StringC]^host()
        var k 0
        while k < 24
        {
            hf.add(StringC())
            set k: k + 1
        }
        set f.hf: hf
        set f.em: StringC()
        set f.pending_elements: Array[ref[GroveNode]?]^host()
        set f.pending_levels: Array[int]^host()
        set f.pending_count: 0
        set f.n_pending_non_empty: 0
        set f.node_level: 0
        set f.suppress_anchors: false
        set f.gst_defined: Array[bool]^host()
        set f.mm_principal: Array[bool]^host()
        set f.mm_depth: 0
        set f.host: host
        f.raw("<?xml version=\"1.0\"?>")
        f.re()
        f.raw("<fot>")
        f.re()
        f
    }

    ; the destructor's closing tag — the CLI calls this before flushing.
    function finish(this: ref[SgmlFOTBuilder])
    {
        this.raw("</fot>")
        this.re()
    }

    ; --- low-level output ----------------------------------------------------
    ; one char into the current stream (out, or ics while a set_ic renders).
    function put(this: ref[SgmlFOTBuilder], c: u32)
    {
        if this.in_ics
        {
            if this.ics_len < this.ics.get_length()
                this.ics.put(this.ics_len, c)
            else
                this.ics.add(c)
            set this.ics_len: this.ics_len + 1
            return
        }
        this.out_put(c)
    }

    ; the curOs_ seam: the main tree, or the header/footer capture while a
    ; simple-page-sequence's parts render.
    function out_put(this: ref[SgmlFOTBuilder], c: u32)
    {
        if this.in_hfs
        {
            if this.hfs_len < this.hfs.get_length()
                this.hfs.put(this.hfs_len, c)
            else
                this.hfs.add(c)
            set this.hfs_len: this.hfs_len + 1
            return
        }
        this.out.add(c)
    }

    function raw(this: ref[SgmlFOTBuilder], s: pointer[const_char])
    {
        var i: size_t 0
        while true
        {
            let b *((s as pointer[u8]) + i)
            if b = 0
                break
            this.put(b as u32)
            set i: i + 1
        }
    }

    function re(this: ref[SgmlFOTBuilder])
        this.put(0x0D)

    function raw_stringc(this: ref[SgmlFOTBuilder], s: StringC)
    {
        let n s.get_size()
        var i: size_t 0
        while i < n
        {
            this.put(s.get(i))
            set i: i + 1
        }
    }

    ; unsigned decimal.
    function raw_uint(this: ref[SgmlFOTBuilder], n_in: int)
    {
        var n n_in
        if n = 0
        {
            this.put(0x30)
            return
        }
        var digits u8[24]
        var k 0
        while n > 0
        {
            set *((digits as pointer[u8]) + k): ((n % 10) + 0x30) as u8
            set n: n / 10
            set k: k + 1
        }
        while k > 0
        {
            set k: k - 1
            this.put((*((digits as pointer[u8]) + k)) as u32)
        }
    }

    ; signed long per the reference operator<< (sign, then magnitude).
    function raw_int(this: ref[SgmlFOTBuilder], n: int)
    {
        if n < 0
        {
            this.put(0x2D)
            this.raw_uint(0 - n)
        }
        else
            this.raw_uint(n)
    }

    ; Data escaping (operator<<(Data)): &amp; &lt; &gt; &quot;, raw ASCII,
    ; numeric char refs at and above 0x80.
    function data_escaped(this: ref[SgmlFOTBuilder], s: pointer[u32], n: size_t)
    {
        var i: size_t 0
        while i < n
        {
            let c *(s + i)
            if c = 0x26
                this.raw("&amp;")
            else if c = 0x3C
                this.raw("&lt;")
            else if c = 0x3E
                this.raw("&gt;")
            else if c = 0x22
                this.raw("&quot;")
            else if c < 0x80
                this.put(c)
            else
            {
                this.raw("&#")
                this.raw_uint(c as int)
                this.put(0x3B)
            }
            set i: i + 1
        }
    }

    ; Units — the reference "%03d" + point-insertion algorithm, quirks intact
    ; (500 -> ".5pt", -500 -> "-.5pt", 0 -> "0pt", 12000 -> "12pt").
    function units(this: ref[SgmlFOTBuilder], n_in: int)
    {
        var buf u8[32]
        var len 0
        var n n_in
        if n < 0
        {
            set *((buf as pointer[u8])): 0x2D
            set len: 1
            set n: 0 - n
        }
        var tmp u8[24]
        var k 0
        while n > 0
        {
            set *((tmp as pointer[u8]) + k): ((n % 10) + 0x30) as u8
            set n: n / 10
            set k: k + 1
        }
        while k < 3
        {
            set *((tmp as pointer[u8]) + k): 0x30
            set k: k + 1
        }
        while k > 0
        {
            set k: k - 1
            set *((buf as pointer[u8]) + len): *((tmp as pointer[u8]) + k)
            set len: len + 1
        }
        ; count up to three trailing zeros
        var i 0
        while i < 3
        {
            if *((buf as pointer[u8]) + (len - i - 1)) <> 0x30
                break
            set i: i + 1
        }
        if i = 3
        {
            ; whole points: drop the three zeros
            set i: len - 3
            if i = 0
            {
                set *((buf as pointer[u8])): 0x30
                set i: 1
            }
        }
        else
        {
            ; shift the last digits right and insert the point (sprintf-quirk
            ; faithful: ".5pt", "-.5pt", "1.005pt")
            let j len + 1 - i
            while i < 3
            {
                set *((buf as pointer[u8]) + (len - i)): *((buf as pointer[u8]) + (len - i - 1))
                set i: i + 1
            }
            set *((buf as pointer[u8]) + (len - 3)): 0x2E
            set i: j
        }
        var m 0
        while m < i
        {
            this.put((*((buf as pointer[u8]) + m)) as u32)
            set m: m + 1
        }
        this.raw("pt")
    }

    ; operator<<(LengthSpec) — factor-bearing specs print ONLY the length part
    ; (the reference never streams the sprintf'd percentage; dead code kept
    ; faithfully).
    function length_spec(this: ref[SgmlFOTBuilder], ls: LengthSpec)
    {
        if ls.factor <> 0.0
        {
            if ls.length <> 0
            {
                this.units(ls.length)
                if ls.factor >= 0.0
                    this.put(0x2B)
            }
            return
        }
        this.units(ls.length)
    }

    ; "%.2f" — two decimals, round half away from zero (printf shape for the
    ; factor magnitudes the corpus produces).
    function raw_fixed2(this: ref[SgmlFOTBuilder], d_in: double)
    {
        var d d_in
        if d < 0.0
        {
            this.put(0x2D)
            set d: 0.0 - d
        }
        let cents ((d * 100.0) + 0.5) as int
        this.raw_uint(cents / 100)
        this.put(0x2E)
        let frac cents % 100
        this.put(((frac / 10) + 0x30) as u32)
        this.put(((frac % 10) + 0x30) as u32)
    }

    ; operator<<(TableLengthSpec) — unlike the plain LengthSpec operator this
    ; one really prints the factors: "%.2f%%" for display-size, "%.2f*" for
    ; table-unit, '+'-joined after a leading length.
    function table_length_spec(this: ref[SgmlFOTBuilder], ls: LengthSpec, tfactor: double)
    {
        if (ls.factor <> 0.0) or (tfactor <> 0.0)
        {
            var need_sign false
            if ls.length <> 0
            {
                this.units(ls.length)
                set need_sign: true
            }
            if ls.factor <> 0.0
            {
                if need_sign and (ls.factor >= 0.0)
                    this.put(0x2B)
                this.raw_fixed2(ls.factor * 100.0)
                this.put(0x25)
                set need_sign: true
            }
            if tfactor <> 0.0
            {
                if need_sign and (tfactor >= 0.0)
                    this.put(0x2B)
                this.raw_fixed2(tfactor)
                this.put(0x2A)
            }
            return
        }
        this.units(ls.length)
    }

    ; hex2 — two uppercase hex digits.
    function hex2(this: ref[SgmlFOTBuilder], c: int)
    {
        let digits "0123456789ABCDEF"
        this.put((*((digits as pointer[u8]) + ((c >> 4) & 0xF))) as u32)
        this.put((*((digits as pointer[u8]) + (c & 0xF))) as u32)
    }

    ; operator<<(DeviceRGBColor) — '#RRGGBB'.
    function color_out(this: ref[SgmlFOTBuilder], rgb: int)
    {
        this.put(0x23)
        this.hex2((rgb >> 16) & 0xFF)
        this.hex2((rgb >> 8) & 0xFF)
        this.hex2(rgb & 0xFF)
    }

    ; inlineSpaceC — reference quirks kept faithfully: nothing at all when
    ; nominal, min and max are all zero; and the value is NEVER closed (the
    ; reference forgets the trailing quote).
    function inline_space_c(this: ref[SgmlFOTBuilder], name: StringC, sp: ref[InlineSpace])
    {
        var any sp.nominal.is_set()
        if sp.min.is_set()
            set any: true
        if sp.max.is_set()
            set any: true
        if any = false
            return
        this.put(0x20)
        this.raw_stringc(name)
        this.put(0x3D)
        this.put(0x22)
        this.length_spec(sp.nominal)
        var diff sp.min.differs(sp.nominal)
        if sp.max.differs(sp.nominal)
            set diff: true
        if diff
        {
            this.put(0x2C)
            this.length_spec(sp.min)
            this.put(0x2C)
            this.length_spec(sp.max)
        }
    }

    function sym_out(this: ref[SgmlFOTBuilder], s: FotSym)
    {
        if s.code = SYM_FALSE
        {
            this.raw("false")
            return
        }
        if s.code = SYM_TRUE
        {
            this.raw("true")
            return
        }
        this.raw_stringc(s.name)
    }

    ; the two scale symbols printed from their CODE. Every other FotSym this
    ; backend renders arrived through a symbol conversion and carries its own
    ; name, but included-container-area's scaleType DEFAULTS to symbolMaxUniform
    ; without ever being converted — and the reference prints symbolName(sym)
    ; there, not a captured string.
    function scale_sym_out(this: ref[SgmlFOTBuilder], s: FotSym)
    {
        if s.code = SYM_MAX_UNIFORM
        {
            this.raw("max-uniform")
            return
        }
        if s.code = SYM_MAX_SCALE
        {
            this.raw("max")
            return
        }
        this.sym_out(s)
    }

    ; --- characteristic rendering (the set* family) --------------------------
    function set_ic(this: ref[SgmlFOTBuilder], ic: ref[InheritedC])
    {
        let kind ic.get_kind()
        ; IgnoredC::set is a no-op — nothing rendered (BorderC and RuleC
        ; included).
        if kind = IC_IGNORED
            return
        if kind = IC_BORDER
            return
        if kind = IC_RULE
            return
        if kind = IC_GST
        {
            this.gst_out(ic.gst)
            return
        }
        ; setInlineSpaceSpace is not overridden in the reference SgmlFOTBuilder
        ; — an inline-space-space set renders nothing.
        if kind = IC_OPT_INLINE_SPACE
            return
        if kind = IC_INLINE_SPACE
        {
            ; inlineSpaceC writes its own frame (no closing quote — quirk).
            set this.in_ics: true
            if ic.obj <> null
                this.inline_space_c(ic.print_name, ic.obj.as_inline_space() as ref[InlineSpace])
            set this.in_ics: false
            return
        }
        if kind = IC_OPT_LENGTH_SPEC
        {
            if ic.bval
            {
                ; optLengthSpecC's #f arm omits the '=' (reference quirk).
                set this.in_ics: true
                this.put(0x20)
                this.raw_stringc(ic.print_name)
                this.put(0x22)
                this.raw("false")
                this.put(0x22)
                set this.in_ics: false
                return
            }
        }
        set this.in_ics: true
        this.put(0x20)
        this.raw_stringc(ic.print_name)
        this.put(0x3D)
        this.put(0x22)
        if kind = IC_BOOL
        {
            if ic.bval
                this.raw("true")
            else
                this.raw("false")
        }
        else if kind = IC_LENGTH
            this.units(ic.lval)
        else if kind = IC_LENGTH_SPEC
            this.length_spec(ic.ls)
        else if kind = IC_SYMBOL
            this.sym_out(ic.sym)
        else if kind = IC_STRING
            this.raw_stringc(ic.sval)
        else if kind = IC_INT
            this.raw_int(ic.lval)
        else if kind = IC_MAYBE_INT
            ; GenericMaybeIntegerInheritedC::set calls the integer setter
            ; unconditionally (#f arrives as 0).
            this.raw_int(ic.lval)
        else if kind = IC_PUBLIC_ID
        {
            ; publicIdC: an unset/empty id prints "false"
            if ic.bval or (ic.sval.get_size() = 0)
                this.raw("false")
            else
                this.raw_stringc(ic.sval)
        }
        else if kind = IC_LETTER2
        {
            if ic.bval or (ic.sval.get_size() = 0)
                this.raw("false")
            else
                this.raw_stringc(ic.sval)
        }
        else if kind = IC_OPT_LENGTH_SPEC
            ; the has-length arm (the #f arm returned above).
            this.length_spec(ic.ls)
        else if kind = IC_COLOR
        {
            if ic.obj <> null
                this.color_out(ic.obj.color_rgb())
        }
        else if kind = IC_OPT_COLOR
        {
            ; setBackgroundColor() (no arg, #f) prints "false".
            if ic.obj = null
                this.raw("false")
            else
                this.color_out(ic.obj.color_rgb())
        }
        this.put(0x22)
        set this.in_ics: false
    }

    ; a GlyphId attribute value: the public id (raw), "::<suffix>" when the
    ; suffix is set; an id-less glyph id prints "false".
    function glyph_id_out(this: ref[SgmlFOTBuilder], gid: ref[ELObj])
    {
        let pubid gid.glyph_pubid()
        if pubid.get_size() = 0
        {
            this.raw("false")
            return
        }
        this.raw_stringc(pubid)
        let suffix gid.glyph_suffix()
        if suffix <> 0
        {
            this.raw("::")
            this.raw_int(suffix)
        }
    }

    ; setGlyphSubstTable — the reference dump: first use of a table writes a
    ; <define-glyph-subst-table id="gst<n>"> block to the MAIN stream (before
    ; the element's open tag — set* runs at style push); the characteristic
    ; itself renders the space-separated id list into the ics buffer.
    function gst_out(this: ref[SgmlFOTBuilder], tabs: ref[Array[ref[GlyphSubstTableRec]?]]?)
    {
        set this.in_ics: true
        this.raw(" glyph-subst-table=")
        this.put(0x22)
        var n: size_t 0
        if tabs <> null
            set n: tabs.get_length()
        var i: size_t 0
        while i < n
        {
            let tp tabs.get(i)
            if tp <> null
            {
                let t *tp
                let uid t.get_unique_id()
                while this.gst_defined.get_length() <= (uid as size_t)
                    this.gst_defined.add(false)
                var need true
                let dp this.gst_defined.get(uid as size_t)
                if dp <> null
                {
                    if *dp
                        set need: false
                }
                if need
                {
                    this.gst_defined.put(uid as size_t, true)
                    set this.in_ics: false
                    this.raw("<define-glyph-subst-table id=")
                    this.put(0x22)
                    this.raw("gst")
                    this.raw_int(uid)
                    this.put(0x22)
                    this.put(0x3E)
                    this.re()
                    let pairs t.get_pairs()
                    let np pairs.get_length()
                    var j: size_t 0
                    while j < np
                    {
                        let op pairs.get(j)
                        let vp pairs.get(j + 1)
                        if op <> null
                        {
                            if vp <> null
                            {
                                this.raw("<glyph-subst old=")
                                this.put(0x22)
                                this.glyph_id_out(*op)
                                this.put(0x22)
                                this.raw(" new=")
                                this.put(0x22)
                                this.glyph_id_out(*vp)
                                this.put(0x22)
                                this.raw("/>")
                                this.re()
                            }
                        }
                        set j: j + 2
                    }
                    ; the reference emits NO record end after the closing tag.
                    this.raw("</define-glyph-subst-table>")
                    set this.in_ics: true
                }
                if i > 0
                    this.put(0x20)
                this.raw("gst")
                this.raw_int(uid)
            }
            set i: i + 1
        }
        this.put(0x22)
        set this.in_ics: false
    }

    function output_ics(this: ref[SgmlFOTBuilder])
    {
        let n this.ics_len
        let b this.ics.get_buffer()
        var i: size_t 0
        while i < n
        {
            this.out_put(*(b + i))
            set i: i + 1
        }
        set this.ics_len: 0
    }

    ; --- NIC rendering --------------------------------------------------------
    function display_space_nic(this: ref[SgmlFOTBuilder], name: pointer[const_char], ds: DisplaySpace)
    {
        var any ds.nominal.is_set()
        if ds.min.is_set()
            set any: true
        if ds.max.is_set()
            set any: true
        if any
        {
            this.put(0x20)
            this.raw(name)
            this.put(0x3D)
            this.put(0x22)
            this.length_spec(ds.nominal)
            var diff ds.min.differs(ds.nominal)
            if ds.max.differs(ds.nominal)
                set diff: true
            if diff
            {
                this.put(0x2C)
                this.length_spec(ds.min)
                this.put(0x2C)
                this.length_spec(ds.max)
            }
            this.put(0x22)
        }
        if ds.force
        {
            this.put(0x20)
            this.raw(name)
            this.raw("-priority=\"force\"")
        }
        else if ds.priority <> 0
        {
            this.put(0x20)
            this.raw(name)
            this.raw("-priority=")
            this.put(0x22)
            this.raw_int(ds.priority)
            this.put(0x22)
        }
        if ds.conditional = false
        {
            this.put(0x20)
            this.raw(name)
            this.raw("-conditional=\"false\"")
        }
    }

    function display_nic(this: ref[SgmlFOTBuilder], nic: ref[DisplayNIC])
    {
        if nic.keep_with_previous
            this.raw(" keep-with-previous=\"true\"")
        if nic.keep_with_next
            this.raw(" keep-with-next=\"true\"")
        if nic.may_violate_keep_before
            this.raw(" may-violate-keep-before=\"true\"")
        if nic.may_violate_keep_after
            this.raw(" may-violate-keep-after=\"true\"")
        if nic.position_preference.code <> SYM_FALSE
        {
            this.raw(" position-preference=\"")
            this.sym_out(nic.position_preference)
            this.put(0x22)
        }
        if nic.keep.code <> SYM_FALSE
        {
            this.raw(" keep=\"")
            this.sym_out(nic.keep)
            this.put(0x22)
        }
        if nic.break_before.code <> SYM_FALSE
        {
            this.raw(" break-before=\"")
            this.sym_out(nic.break_before)
            this.put(0x22)
        }
        if nic.break_after.code <> SYM_FALSE
        {
            this.raw(" break-after=\"")
            this.sym_out(nic.break_after)
            this.put(0x22)
        }
        this.display_space_nic("space-before", nic.space_before)
        this.display_space_nic("space-after", nic.space_after)
    }

    ; --- pending element anchors ----------------------------------------------
    function start_node(this: ref[SgmlFOTBuilder], node: ref[GroveNode], mode_name: StringC)
    {
        set this.node_level: this.node_level + 1
        if mode_name.get_size() <> 0
            return
        if node.get_class() <> GN_ELEMENT
            return
        var i: size_t 0
        while i < this.pending_count
        {
            let pp this.pending_elements.get(i)
            if pp <> null
            {
                if *pp = node
                    return
            }
            set i: i + 1
        }
        if this.pending_count < this.pending_elements.get_length()
        {
            this.pending_elements.put(this.pending_count, node)
            this.pending_levels.put(this.pending_count, this.node_level)
        }
        else
        {
            this.pending_elements.add(node)
            this.pending_levels.add(this.node_level)
        }
        set this.pending_count: this.pending_count + 1
    }

    function end_node(this: ref[SgmlFOTBuilder])
    {
        if this.pending_count > 0
        {
            let lp this.pending_levels.get(this.pending_count - 1)
            if lp <> null
            {
                if (*lp = this.node_level) and (this.n_pending_non_empty < (this.pending_count as int))
                    set this.pending_count: this.pending_count - 1
            }
        }
        set this.node_level: this.node_level - 1
    }

    ; outputElementName(groveIndex, idData, idSize) — a NON-document grove
    ; prefixes its index and a dot; grove 0 writes the bare name.
    function output_element_name_g(this: ref[SgmlFOTBuilder], g: int, data: pointer[u32], size: size_t)
    {
        if g <> 0
        {
            this.raw_uint(g)
            this.put(0x2E)
        }
        this.data_escaped(data, size)
    }

    function output_element_name(this: ref[SgmlFOTBuilder], node: ref[GroveNode])
    {
        let g GroveInfo.index_of(node)
        let id node.get_id()
        if id.get_size() > 0
        {
            this.output_element_name_g(g, id.data_ptr(), id.get_size())
            return
        }
        if g <> 0
        {
            this.raw_uint(g)
            this.put(0x2E)
        }
        let ei node.get_element_index()
        if ei >= 0
            this.raw_uint(ei)
    }

    function flush_pending_elements(this: ref[SgmlFOTBuilder])
    {
        if this.suppress_anchors
            return
        var i: size_t 0
        while i < this.pending_count
        {
            let pp this.pending_elements.get(i)
            if pp <> null
            {
                this.raw("<a name=\"")
                this.output_element_name(*pp)
                this.raw("\"/>")
                this.re()
            }
            set i: i + 1
        }
        set this.n_pending_non_empty: 0
        set this.pending_count: 0
    }

    ; --- text ------------------------------------------------------------------
    function characters(this: ref[SgmlFOTBuilder], s: pointer[u32], n: size_t)
    {
        if n = 0
            return
        this.flush_pending_elements()
        this.raw("<text>")
        this.data_escaped(s, n)
        this.raw("</text>")
        this.re()
    }

    ; SDATA substitution is deferred grove-wide (see the transform sink); the
    ; plain character path matches.
    function characters_from_node(this: ref[SgmlFOTBuilder], node: ref[GroveNode], s: pointer[u32], n: size_t)
        this.characters(s, n)

    ; --- flow objects ------------------------------------------------------------
    function start_simple_flow_obj(this: ref[SgmlFOTBuilder], name: pointer[const_char])
    {
        this.put(0x3C)
        this.raw(name)
        this.output_ics()
        this.raw(">")
        this.re()
    }

    function end_flow(this: ref[SgmlFOTBuilder], name: pointer[const_char])
    {
        this.raw("</")
        this.raw(name)
        this.raw(">")
        this.re()
    }

    function start_sequence(this: ref[SgmlFOTBuilder])
        this.start_simple_flow_obj("sequence")

    ; ScrollFlowObj — SgmlFOTBuilder::startScroll/endScroll
    function start_scroll(this: ref[SgmlFOTBuilder])
        this.start_simple_flow_obj("scroll")

    function end_scroll(this: ref[SgmlFOTBuilder])
        this.end_flow("scroll")

    function end_sequence(this: ref[SgmlFOTBuilder])
        this.end_flow("sequence")

    function start_paragraph(this: ref[SgmlFOTBuilder], nic: ref[DisplayNIC])
    {
        this.raw("<paragraph")
        this.display_nic(nic)
        this.output_ics()
        this.raw(">")
        this.re()
    }

    function end_paragraph(this: ref[SgmlFOTBuilder])
        this.end_flow("paragraph")

    function paragraph_break(this: ref[SgmlFOTBuilder], nic: ref[DisplayNIC])
    {
        this.raw("<paragraph-break")
        this.display_nic(nic)
        this.output_ics()
        this.raw("/>")
        this.re()
    }

    ; InlineNIC dump — the break priorities (only when nonzero).
    function inline_nic(this: ref[SgmlFOTBuilder], break_before_priority: int, break_after_priority: int)
    {
        if break_before_priority <> 0
        {
            this.raw(" break-before-priority=\"")
            this.raw_int(break_before_priority)
            this.put(0x22)
        }
        if break_after_priority <> 0
        {
            this.raw(" break-after-priority=\"")
            this.raw_int(break_after_priority)
            this.put(0x22)
        }
    }

    ; SgmlFOTBuilder::rule — display NICs for the display orientations
    ; (horizontal/vertical), inline NICs otherwise; length only when set.
    function rule(this: ref[SgmlFOTBuilder], nic: ref[RuleNICRec], dnic: ref[DisplayNIC])
    {
        this.flush_pending_elements()
        var orientation FotSym()
        var has_length false
        var length LengthSpec()
        var bbp 0
        var bap 0
        set orientation: nic.orientation
        set has_length: nic.has_length
        set length: nic.length
        set bbp: nic.break_before_priority
        set bap: nic.break_after_priority
        ; symbolName guard — a nameless orientation renders nothing.
        if orientation.name.get_size() = 0
            return
        this.raw("<rule orientation=")
        this.put(0x22)
        this.raw_stringc(orientation.name)
        this.put(0x22)
        if (orientation.code = SYM_HORIZONTAL) or (orientation.code = SYM_VERTICAL)
            this.display_nic(dnic)
        else
            this.inline_nic(bbp, bap)
        if has_length
        {
            this.raw(" length=")
            this.put(0x22)
            this.length_spec(length)
            this.put(0x22)
        }
        this.output_ics()
        this.raw("/>")
        this.re()
    }

    ; C's %g (the reference's operator<<(OutputCharStream&, double)).
    function raw_double(this: ref[SgmlFOTBuilder], x: double)
    {
        let host this.host
        let os OutputCharStream.make(host)
        ELObj.print_double(os, x)
        this.raw_stringc(os.to_string_c(host))
    }

    ; SgmlFOTBuilder::startLink — ics BEFORE the destination (reference
    ; order); a resolved-node destination prints only for elements.
    function start_link(this: ref[SgmlFOTBuilder], nic: ref[LinkNICRec])
    {
        this.raw("<link")
        this.output_ics()
        var addr_type ADDR_NONE
        var node: ref[GroveNode]? null
        set addr_type: nic.addr_type
        set node: nic.node as pointer[GroveNode]
        if addr_type = ADDR_RESOLVED_NODE
        {
            if node <> null
            {
                if node.get_class() = GN_ELEMENT
                {
                    this.raw(" destination=")
                    this.put(0x22)
                    this.output_element_name(node)
                    this.put(0x22)
                }
            }
        }
        else if addr_type = ADDR_IDREF
        {
            ; the (groveIndex, idData, idSize) overload — the WHOLE param
            ; string, spaces and all; this backend does not cut at the first
            ; IDREF the way rtf/html/mif do.
            this.raw(" destination=")
            this.put(0x22)
            this.output_element_name_g(GroveInfo.index_of(node), nic.p0.data_ptr(), nic.p0.get_size())
            this.put(0x22)
        }
        ; sgmlDocument and entity are bare `// FIXME` breaks in the reference
        ; (SgmlFOTBuilder.cxx:1801/1816) — the link element is written with no
        ; destination at all; so is every other type via `default`.
        this.raw(">")
        this.re()
    }

    function end_link(this: ref[SgmlFOTBuilder])
        this.end_flow("link")

    ; SgmlFOTBuilder::externalGraphic.
    function external_graphic(this: ref[SgmlFOTBuilder], nic: ref[GraphicNICRec], dnic: ref[DisplayNIC])
    {
        this.flush_pending_elements()
        var r nic
        if r = null
            set r: GraphicNICRec.make(this.host)
        this.raw("<external-graphic entity-system-id=")
        this.put(0x22)
        this.data_escaped(r.entity_system_id.data_ptr(), r.entity_system_id.get_size())
        this.put(0x22)
        this.raw(" notation-system-id=")
        this.put(0x22)
        this.data_escaped(r.notation_system_id.data_ptr(), r.notation_system_id.get_size())
        this.put(0x22)
        if r.scale_type.code <> SYM_FALSE
        {
            this.raw(" scale=")
            this.put(0x22)
            this.raw_stringc(r.scale_type.name)
            this.put(0x22)
        }
        else
        {
            this.raw(" scale-x=")
            this.put(0x22)
            this.raw_double(r.scale_x)
            this.put(0x22)
            this.raw(" scale-y=")
            this.put(0x22)
            this.raw_double(r.scale_y)
            this.put(0x22)
        }
        if r.has_max_width
        {
            this.raw(" max-width=")
            this.put(0x22)
            this.length_spec(r.max_width)
            this.put(0x22)
        }
        if r.has_max_height
        {
            this.raw(" max-height=")
            this.put(0x22)
            this.length_spec(r.max_height)
            this.put(0x22)
        }
        if r.is_display
        {
            this.raw(" display=\"true\"")
            this.display_nic(dnic)
        }
        else
        {
            if r.escapement_direction.code <> SYM_FALSE
            {
                this.raw(" escapement-direction=")
                this.put(0x22)
                this.raw_stringc(r.escapement_direction.name)
                this.put(0x22)
            }
            ; positionPointX/Y print on LengthSpec truthiness (non-zero).
            let ppx r.position_point_x
            if ppx.is_set()
            {
                this.raw(" position-point-x=")
                this.put(0x22)
                this.length_spec(ppx)
                this.put(0x22)
            }
            let ppy r.position_point_y
            if ppy.is_set()
            {
                this.raw(" position-point-y=")
                this.put(0x22)
                this.length_spec(ppy)
                this.put(0x22)
            }
            this.inline_nic(r.break_before_priority, r.break_after_priority)
        }
        this.output_ics()
        this.raw("/>")
        this.re()
    }

    ; SgmlFOTBuilder::startLeader — the length prints UNQUOTED (reference
    ; quirk: `os() << " length=" << nic.length`).
    function start_leader(this: ref[SgmlFOTBuilder], nic: ref[LeaderNICRec])
    {
        this.flush_pending_elements()
        this.raw("<leader")
        if nic.has_length
        {
            this.raw(" length=")
            this.length_spec(nic.length)
        }
        this.inline_nic(nic.break_before_priority, nic.break_after_priority)
        this.output_ics()
        this.raw(">")
        this.re()
    }

    function end_leader(this: ref[SgmlFOTBuilder])
        this.end_flow("leader")

    ; SgmlFOTBuilder::startBox.
    function start_box(this: ref[SgmlFOTBuilder], nic: ref[BoxNICRec], dnic: ref[DisplayNIC])
    {
        this.flush_pending_elements()
        this.raw("<box")
        var is_display false
        var bbp 0
        var bap 0
        set is_display: nic.is_display
        set bbp: nic.break_before_priority
        set bap: nic.break_after_priority
        if is_display
        {
            this.raw(" display=\"true\"")
            this.display_nic(dnic)
        }
        else
            this.inline_nic(bbp, bap)
        this.output_ics()
        this.raw(">")
        this.re()
    }

    function end_box(this: ref[SgmlFOTBuilder])
        this.end_flow("box")

    ; SgmlFOTBuilder::startScore (the three typed variants; symbolName guard
    ; on the symbol form).
    function start_score(this: ref[SgmlFOTBuilder], nic: ref[ScoreNICRec])
    {
        if nic.kind = SCORE_SYMBOL
        {
            if nic.sym.name.get_size() = 0
                return
            this.raw("<score type=")
            this.put(0x22)
            this.raw_stringc(nic.sym.name)
            this.put(0x22)
        }
        else if nic.kind = SCORE_LENGTH
        {
            this.raw("<score type=")
            this.put(0x22)
            this.length_spec(nic.length)
            this.put(0x22)
        }
        else
        {
            this.raw("<score type=\"char\" char=")
            this.put(0x22)
            this.put(nic.ch)
            this.put(0x22)
        }
        this.output_ics()
        this.raw(">")
        this.re()
    }

    function end_score(this: ref[SgmlFOTBuilder])
        this.end_flow("score")

    function start_display_group(this: ref[SgmlFOTBuilder], nic: ref[DisplayNIC])
    {
        this.raw("<display-group")
        if nic.has_coalesce_id
        {
            this.raw(" coalesce-id=\"")
            this.data_escaped(nic.coalesce_id.data_ptr(), nic.coalesce_id.get_size())
            this.put(0x22)
        }
        this.display_nic(nic)
        this.output_ics()
        this.raw(">")
        this.re()
    }

    function end_display_group(this: ref[SgmlFOTBuilder])
        this.end_flow("display-group")

    function start_line_field(this: ref[SgmlFOTBuilder])
    {
        ; LineFieldNIC (inline priorities) is not printed by the reference.
        this.flush_pending_elements()
        this.start_simple_flow_obj("line-field")
    }

    function end_line_field(this: ref[SgmlFOTBuilder])
        this.end_flow("line-field")

    ; --- the INLINE/MARK family -------------------------------------------------
    ; SgmlFOTBuilder::characterNIC — one attribute per SPECIFIED field, in this
    ; exact order; `stretch-factor` has no specified bit and renders whenever it
    ; differs from 1.0.
    function character_nic(this: ref[SgmlFOTBuilder], nic: ref[CharacterNICRec])
    {
        if nic.specified <> 0
        {
            if nic.is_specified(CNIC_CHAR)
            {
                this.raw(" char=\"&#")
                this.raw_uint(nic.ch as int)
                this.raw(";\"")
            }
            if nic.is_specified(CNIC_GLYPH_ID)
            {
                this.raw(" glyph-id=\"")
                if nic.glyph_id = null
                    this.raw("false")
                else
                    this.glyph_id_out(nic.glyph_id)
                this.put(0x22)
            }
            if nic.is_specified(CNIC_IS_DROP_AFTER_LINE_BREAK)
                this.bool_attr("drop-after-line-break", nic.is_drop_after_line_break)
            if nic.is_specified(CNIC_IS_DROP_UNLESS_BEFORE_LINE_BREAK)
                this.bool_attr("drop-unless-before-line-break", nic.is_drop_unless_before_line_break)
            if nic.is_specified(CNIC_IS_PUNCT)
                this.bool_attr("punct", nic.is_punct)
            if nic.is_specified(CNIC_IS_INPUT_WHITESPACE)
                this.bool_attr("input-whitespace", nic.is_input_whitespace)
            if nic.is_specified(CNIC_IS_INPUT_TAB)
                this.bool_attr("input-tab", nic.is_input_tab)
            if nic.is_specified(CNIC_IS_RECORD_END)
                this.bool_attr("record-end", nic.is_record_end)
            if nic.is_specified(CNIC_IS_SPACE)
                this.bool_attr("space", nic.is_space)
            if nic.is_specified(CNIC_SCRIPT)
            {
                ; a null PublicId prints "false" (the reference's `if
                ; (nic.script)`); here an EMPTY public id is that null.
                this.raw(" script=\"")
                if nic.script.get_size() = 0
                    this.raw("false")
                else
                    this.raw_stringc(nic.script)
                this.put(0x22)
            }
            if nic.is_specified(CNIC_MATH_CLASS)
            {
                this.raw(" math-class=\"")
                this.sym_out(nic.math_class)
                this.put(0x22)
            }
            if nic.is_specified(CNIC_MATH_FONT_POSTURE)
            {
                this.raw(" math-font-posture=\"")
                this.sym_out(nic.math_font_posture)
                this.put(0x22)
            }
            if nic.is_specified(CNIC_BREAK_BEFORE_PRIORITY)
            {
                this.raw(" break-before-priority=\"")
                this.raw_int(nic.break_before_priority)
                this.put(0x22)
            }
            if nic.is_specified(CNIC_BREAK_AFTER_PRIORITY)
            {
                this.raw(" break-after-priority=\"")
                this.raw_int(nic.break_after_priority)
                this.put(0x22)
            }
        }
        if nic.stretch_factor <> 1.0
        {
            this.raw(" stretch-factor=\"")
            this.raw_double(nic.stretch_factor)
            this.put(0x22)
        }
    }

    function bool_attr(this: ref[SgmlFOTBuilder], name: pointer[const_char], b: bool)
    {
        this.put(0x20)
        this.raw(name)
        this.raw("=\"")
        if b
            this.raw("true")
        else
            this.raw("false")
        this.put(0x22)
    }

    ; ★the record ends `RE` then `/>` — the reference writes
    ; `os() << RE << "/>"` (SgmlFOTBuilder.cxx:698), so the empty-element tag of
    ; a character is split across the line break. Reproduced verbatim.
    function character(this: ref[SgmlFOTBuilder], nic: ref[CharacterNICRec])
    {
        this.flush_pending_elements()
        this.raw("<character")
        this.character_nic(nic)
        this.output_ics()
        this.re()
        this.raw("/>")
    }

    function alignment_point(this: ref[SgmlFOTBuilder])
        this.simple_flow_obj("alignment-point")

    function start_sideline(this: ref[SgmlFOTBuilder])
        this.start_simple_flow_obj("sideline")

    function end_sideline(this: ref[SgmlFOTBuilder])
        this.end_flow("sideline")

    ; SgmlFOTBuilder::anchor — ★no flushPendingElements (the reference's call is
    ; commented out), so a pending anchor stays pending across this flow object.
    function anchor(this: ref[SgmlFOTBuilder], nic: ref[AnchorNICRec])
    {
        this.raw("<anchor")
        if nic.is_display
            this.raw(" display=\"true\"")
        this.inline_nic(nic.break_before_priority, nic.break_after_priority)
        this.output_ics()
        this.raw("/>")
        this.re()
    }

    ; ★glyph-annotation and emphasizing-mark open with a SELF-CLOSING tag and
    ; are then closed by endFlow — the reference's own asymmetry
    ; (SgmlFOTBuilder.cxx:2126/2140), reproduced.
    function start_glyph_annotation(this: ref[SgmlFOTBuilder], nic: ref[GlyphAnnotationNICRec])
    {
        this.raw("<glyph-annotation")
        this.inline_nic(nic.break_before_priority, nic.break_after_priority)
        this.output_ics()
        this.raw("/>")
        this.re()
    }

    function end_glyph_annotation(this: ref[SgmlFOTBuilder])
        this.end_flow("glyph-annotation")

    ; the emphasizing-mark bracket: the start tag, then anchors off and the
    ; output redirected into the SAME capture buffer the header/footer parts use
    ; (the reference shares curOs_ = &hfs_ between both, aliasing and all).
    function start_emphasizing_mark_serial(this: ref[SgmlFOTBuilder], nic: ref[EmphasizingMarkNICRec])
    {
        this.raw("<emphasizing-mark")
        this.inline_nic(nic.break_before_priority, nic.break_after_priority)
        this.output_ics()
        this.raw("/>")
        this.re()
        set this.suppress_anchors: true
        set this.in_hfs: true
    }

    function start_emphasizing_mark_mark(this: ref[SgmlFOTBuilder])
    {
    }

    function end_emphasizing_mark_mark(this: ref[SgmlFOTBuilder])
    {
        let host this.host
        set this.em: StringC^host(this.hfs.get_buffer(), this.hfs_len)
        set this.hfs_len: 0
    }

    function end_all_emphasizing_mark_mark(this: ref[SgmlFOTBuilder])
    {
        set this.in_hfs: false
        set this.suppress_anchors: false
        if this.em.get_size() <> 0
        {
            this.start_simple_flow_obj("emphasizing-mark.mark")
            this.raw_stringc(this.em)
            this.end_flow("emphasizing-mark.mark")
        }
    }

    function end_emphasizing_mark_serial(this: ref[SgmlFOTBuilder])
        this.end_flow("emphasizing-mark")

    ; --- the MATH family ---------------------------------------------------------
    ; SgmlFOTBuilder implements every one of the twelve. ★A PORT element opens
    ; with startPortFlow (`<name>` + RE, NO inherited characteristics) while the
    ; class's own element opens with startSimpleFlowObj (ics flushed into the
    ; tag) — the ics belong to the flow object, not to its ports.
    ; ★And the four classes with a principal port (script, mark, fence,
    ; math-operator) plus radical open `<x.principal>` as part of the SERIAL
    ; open and close it in their FIRST port bracket, so the principal content is
    ; wrapped without any callback of its own. `fraction` has no principal port
    ; and so no such element.
    function start_port_flow(this: ref[SgmlFOTBuilder], name: pointer[const_char])
    {
        this.raw("<")
        this.raw(name)
        this.raw(">")
        this.re()
    }

    function start_math_sequence(this: ref[SgmlFOTBuilder])
        this.start_simple_flow_obj("math-sequence")

    function end_math_sequence(this: ref[SgmlFOTBuilder])
        this.end_flow("math-sequence")

    function start_fraction_serial(this: ref[SgmlFOTBuilder])
        this.start_simple_flow_obj("fraction")

    function end_fraction_serial(this: ref[SgmlFOTBuilder])
        this.end_flow("fraction")

    function fraction_bar(this: ref[SgmlFOTBuilder])
        this.simple_flow_obj("fraction.fraction-bar")

    function start_fraction_numerator(this: ref[SgmlFOTBuilder])
        this.start_port_flow("fraction.numerator")

    function end_fraction_numerator(this: ref[SgmlFOTBuilder])
        this.end_flow("fraction.numerator")

    function start_fraction_denominator(this: ref[SgmlFOTBuilder])
        this.start_port_flow("fraction.denominator")

    function end_fraction_denominator(this: ref[SgmlFOTBuilder])
        this.end_flow("fraction.denominator")

    function start_unmath(this: ref[SgmlFOTBuilder])
        this.start_simple_flow_obj("unmath")

    function end_unmath(this: ref[SgmlFOTBuilder])
        this.end_flow("unmath")

    function start_superscript(this: ref[SgmlFOTBuilder])
        this.start_simple_flow_obj("superscript")

    function end_superscript(this: ref[SgmlFOTBuilder])
