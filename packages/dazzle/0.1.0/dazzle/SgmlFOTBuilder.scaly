    {
        this.raw("<side-by-side")
        this.display_nic(dnic)
        this.output_ics()
        this.raw("/>")
        this.re()
    }

    function end_side_by_side(this: ref[SgmlFOTBuilder])
        this.end_flow("side-by-side")

    function start_side_by_side_item(this: ref[SgmlFOTBuilder])
    {
        this.raw("<side-by-side-item")
        this.output_ics()
        this.raw("/>")
        this.re()
    }

    function end_side_by_side_item(this: ref[SgmlFOTBuilder])
        this.end_flow("side-by-side-item")

    ; --- the ONLINE family ----------------------------------------------------
    function start_marginalia(this: ref[SgmlFOTBuilder])
        this.start_simple_flow_obj("marginalia")

    function end_marginalia(this: ref[SgmlFOTBuilder])
        this.end_flow("marginalia")

    ; SgmlFOTBuilder::startMultiModeSerial — the class element, then the
    ; PRINCIPAL mode's element if the characteristic asked for one. Its flag is
    ; stacked, because a multi-mode can sit inside a multi-mode.
    function start_multi_mode_serial(this: ref[SgmlFOTBuilder], mode: ref[MultiModeRec])
    {
        this.start_simple_flow_obj("multi-mode")
        if mode <> null
        {
            this.raw("<multi-mode.mode")
            if mode.has_desc
            {
                this.raw(" desc=")
                this.put(0x22)
                this.data_escaped(mode.desc.data_ptr(), mode.desc.get_size())
                this.put(0x22)
            }
            this.raw(">")
            this.re()
        }
        while this.mm_principal.get_length() <= this.mm_depth
            this.mm_principal.add(false)
        this.mm_principal.put(this.mm_depth, mode <> null)
        set this.mm_depth: this.mm_depth + 1
    }

    function end_multi_mode_serial(this: ref[SgmlFOTBuilder])
    {
        if this.mm_depth > 0
        {
            set this.mm_depth: this.mm_depth - 1
            let fp this.mm_principal.get(this.mm_depth)
            if fp <> null
            {
                if *fp
                    this.end_flow("multi-mode.mode")
            }
        }
        this.end_flow("multi-mode")
    }

    ; SgmlFOTBuilder::startMultiModeMode — the FIRST named mode closes the
    ; principal mode's element (the reference clears the flag as it does).
    function start_multi_mode_mode(this: ref[SgmlFOTBuilder], mode: ref[MultiModeRec])
    {
        if this.mm_depth > 0
        {
            let top this.mm_depth - 1
            let fp this.mm_principal.get(top)
            if fp <> null
            {
                if *fp
                {
                    this.end_flow("multi-mode.mode")
                    this.mm_principal.put(top, false)
                }
            }
        }
        this.raw("<multi-mode.mode name=")
        this.put(0x22)
        if mode <> null
            this.data_escaped(mode.name.data_ptr(), mode.name.get_size())
        this.put(0x22)
        if mode <> null
        {
            if mode.has_desc
            {
                this.raw(" desc=")
                this.put(0x22)
                this.data_escaped(mode.desc.data_ptr(), mode.desc.get_size())
                this.put(0x22)
            }
        }
        this.raw(">")
        this.re()
    }

    function end_multi_mode_mode(this: ref[SgmlFOTBuilder])
        this.end_flow("multi-mode.mode")

    ; --- the PAGE/COLUMN MODEL ------------------------------------------------
    ; SgmlFOTBuilder::startPageSequenceSerial (2113) and
    ; startColumnSetSequenceSerial (1973). Both opens are SELF-CLOSING and are
    ; then closed by a real `</…>`, the asymmetry this backend has for every
    ; class it decomposes. `page-sequence` prints NOTHING but its ics — its six
    ; characteristics are inherited ones, so they arrive through outputIcs.
    function start_page_sequence(this: ref[SgmlFOTBuilder])
    {
        this.raw("<page-sequence")
        this.output_ics()
        this.raw("/>")
        this.re()
    }

    function end_page_sequence(this: ref[SgmlFOTBuilder])
        this.end_flow("page-sequence")

    function start_column_set_sequence(this: ref[SgmlFOTBuilder], dnic: ref[DisplayNIC])
    {
        this.raw("<column-set-sequence")
        this.display_nic(dnic)
        this.output_ics()
        this.raw("/>")
        this.re()
    }

    function end_column_set_sequence(this: ref[SgmlFOTBuilder])
        this.end_flow("column-set-sequence")

    ; --- simple-page-sequence -------------------------------------------------
    ; startSimplePageSequenceSerial: the start tag (ics flushed into it), then
    ; anchors off and output redirected into the header/footer capture until
    ; end_all_simple_page_sequence_header_footer.
    function start_simple_page_sequence(this: ref[SgmlFOTBuilder])
    {
        this.start_simple_flow_obj("simple-page-sequence")
        set this.suppress_anchors: true
        set this.in_hfs: true
    }

    ; endSimplePageSequenceHeaderFooter(flags): hfs_.extractString(hf_[flags]).
    function end_simple_page_sequence_header_footer(this: ref[SgmlFOTBuilder], flags: int)
    {
        let host this.host
        let s StringC^host(this.hfs.get_buffer(), this.hfs_len)
        this.hf.put(flags as size_t, s)
        set this.hfs_len: 0
    }

    ; endAllSimplePageSequenceHeaderFooter: restore the main stream, then the
    ; six part groups, each deduplicated across the four page types — front=
    ; only when front/back differ, first= only when first/other differ.
    function end_all_simple_page_sequence_header_footer(this: ref[SgmlFOTBuilder])
    {
        set this.in_hfs: false
        set this.suppress_anchors: false
        var i 0
        while i < 24
        {
            let s3 this.hf_at(i + 3)
            let s2 this.hf_at(i + 2)
            let s1 this.hf_at(i + 1)
            let s0 this.hf_at(i + 0)
            var front 0
            if (s3.equals(s1) = false) or (s2.equals(s0) = false)
                set front: 2
            var first 0
            if (s3.equals(s2) = false) or (s1.equals(s0) = false)
                set first: 1
            var j 0
            while j <= front
            {
                var k 0
                while k <= first
                {
                    let str this.hf_at(i + j + k)
                    if str.get_size() <> 0
                    {
                        var side "left"
                        if (i & 8) <> 0
                            set side: "center"
                        else if (i & 16) <> 0
                            set side: "right"
                        var hf_name "footer"
                        if (i & 4) <> 0
                            set hf_name: "header"
                        this.raw("<simple-page-sequence.")
                        this.raw(side)
                        this.put(0x2D)
                        this.raw(hf_name)
                        if front <> 0
                        {
                            this.raw(" front=\"")
                            if j <> 0
                                this.raw("true")
                            else
                                this.raw("false")
                            this.put(0x22)
                        }
                        if first <> 0
                        {
                            this.raw(" first=\"")
                            if k <> 0
                                this.raw("true")
                            else
                                this.raw("false")
                            this.put(0x22)
                        }
                        this.raw(">")
                        this.re()
                        this.raw_stringc(str)
                        this.raw("</simple-page-sequence.")
                        this.raw(side)
                        this.put(0x2D)
                        this.raw(hf_name)
                        this.raw(">")
                        this.re()
                    }
                    set k: k + 1
                }
                set j: j + 2
            }
            set i: i + 4
        }
    }

    function end_simple_page_sequence(this: ref[SgmlFOTBuilder])
        this.end_flow("simple-page-sequence")

    function hf_at(this: ref[SgmlFOTBuilder], k: int) returns StringC
    {
        let pp this.hf.get(k as size_t)
        if pp = null
            return StringC()
        *pp
    }

    ; --- tables -----------------------------------------------------------------
    ; simpleFlowObj: an atomic element, ics flushed into the tag.
    function simple_flow_obj(this: ref[SgmlFOTBuilder], name: pointer[const_char])
    {
        this.put(0x3C)
        this.raw(name)
        this.output_ics()
        this.raw("/>")
        this.re()
    }

    function start_table(this: ref[SgmlFOTBuilder], tnic: ref[TableNICRec], dnic: ref[DisplayNIC])
    {
        this.flush_pending_elements()
        this.raw("<table")
        if tnic.width_type = TABLE_WIDTH_EXPLICIT
        {
            this.raw(" width=\"")
            this.length_spec(tnic.width)
            this.put(0x22)
        }
        if tnic.width_type = TABLE_WIDTH_MINIMUM
            this.raw(" minimum-width=\"true\"")
        this.display_nic(dnic)
        this.output_ics()
        this.raw(">")
        this.re()
    }

    function end_table(this: ref[SgmlFOTBuilder])
        this.end_flow("table")

    function table_before_row_border(this: ref[SgmlFOTBuilder])
        this.simple_flow_obj("table.before-row-border")

    function table_after_row_border(this: ref[SgmlFOTBuilder])
        this.simple_flow_obj("table.after-row-border")

    function table_before_column_border(this: ref[SgmlFOTBuilder])
        this.simple_flow_obj("table.before-column-border")

    function table_after_column_border(this: ref[SgmlFOTBuilder])
        this.simple_flow_obj("table.after-column-border")

    function table_column(this: ref[SgmlFOTBuilder], nic: ref[TableColumnNICRec])
    {
        this.raw("<table-column column-number=\"")
        this.raw_uint(nic.column_index + 1)
        this.put(0x22)
        if nic.n_columns_spanned <> 1
        {
            this.raw(" n-columns-spanned=\"")
            this.raw_uint(nic.n_columns_spanned)
            this.put(0x22)
        }
        if nic.has_width
        {
            this.raw(" width=\"")
            this.table_length_spec(nic.width, nic.width_tfactor)
            this.put(0x22)
        }
        this.output_ics()
        this.raw("/>")
        this.re()
    }

    function start_table_part_serial(this: ref[SgmlFOTBuilder], dnic: ref[DisplayNIC])
    {
        this.raw("<table-part")
        this.display_nic(dnic)
        this.output_ics()
        this.raw(">")
        this.re()
        this.raw("<table-part.principal>")
        this.re()
    }

    function end_table_part_serial(this: ref[SgmlFOTBuilder])
        this.end_flow("table-part")

    function start_table_part_header(this: ref[SgmlFOTBuilder])
    {
        this.end_flow("table-part.principal")
        this.raw("<table-part.header>")
        this.re()
    }

    function end_table_part_header(this: ref[SgmlFOTBuilder])
        this.end_flow("table-part.header")

    function start_table_part_footer(this: ref[SgmlFOTBuilder])
    {
        this.raw("<table-part.footer>")
        this.re()
    }

    function end_table_part_footer(this: ref[SgmlFOTBuilder])
        this.end_flow("table-part.footer")

    function start_table_row(this: ref[SgmlFOTBuilder])
        this.start_simple_flow_obj("table-row")

    function end_table_row(this: ref[SgmlFOTBuilder])
        this.end_flow("table-row")

    function start_table_cell(this: ref[SgmlFOTBuilder], nic: ref[TableCellNICRec])
    {
        if nic.missing
            this.raw("<table-cell column-number=\"0\"")
        else
        {
            this.raw("<table-cell column-number=\"")
            this.raw_uint(nic.column_index + 1)
            this.put(0x22)
            if nic.n_columns_spanned <> 1
            {
                this.raw(" n-columns-spanned=\"")
                this.raw_uint(nic.n_columns_spanned)
                this.put(0x22)
            }
            if nic.n_rows_spanned <> 1
            {
                this.raw(" n-rows-spanned=\"")
                this.raw_uint(nic.n_rows_spanned)
                this.put(0x22)
            }
        }
        this.output_ics()
        this.raw(">")
        this.re()
    }

    function end_table_cell(this: ref[SgmlFOTBuilder])
        this.end_flow("table-cell")

    function table_cell_before_row_border(this: ref[SgmlFOTBuilder])
        this.simple_flow_obj("table-cell.before-row-border")

    function table_cell_after_row_border(this: ref[SgmlFOTBuilder])
        this.simple_flow_obj("table-cell.after-row-border")

    function table_cell_before_column_border(this: ref[SgmlFOTBuilder])
        this.simple_flow_obj("table-cell.before-column-border")

    function table_cell_after_column_border(this: ref[SgmlFOTBuilder])
        this.simple_flow_obj("table-cell.after-column-border")

    ; --- page-number references -------------------------------------------------
    function page_number(this: ref[SgmlFOTBuilder])
    {
        this.raw("<page-number/>")
        this.re()
    }

    function current_node_page_number(this: ref[SgmlFOTBuilder], node: ref[GroveNode])
    {
        if node.get_class() <> GN_ELEMENT
            return
        this.raw("<page-number ref=\"")
        this.output_element_name(node)
        this.raw("\"/>")
        this.re()
    }

    ; --- flush ---------------------------------------------------------------
    ; the whole tree, record-encoded (RE -> NL, RS dropped) and then run
    ; through the app's OUTPUT coding system — the
    ; RecordOutputCharStream(EncodeOutputCharStream(&outputFile_,
    ; outputCodingSystem_)) seam of jade.cxx:175. The stream carries
    ; outputNumericCharRef as its escaper (SgmlFOTBuilder.cxx:615), so a char
    ; the coding system cannot express leaves as `&#<decimal>;`; the BOM
    ; belongs to stream creation, i.e. to this one file.
    function to_utf8(this: ref[SgmlFOTBuilder]) returns String
    {
        let host this.host
        let buf this.out.get_buffer()
        let n this.out.get_length()
        let cap n * 4 + 1
        let src host.allocate(n * 4 + 4, 4) as pointer[u32]
        var m: size_t 0
        var i: size_t 0
        while i < n
        {
            let c *(buf + i)
            if c = 0x0D
            {
                set *(src + m): 0x0A
                set m: m + 1
            }
            else if c = 0x0A
                0
            else
            {
                set *(src + m): c
                set m: m + 1
            }
            set i: i + 1
        }
        let bytes host.allocate(cap, 1) as pointer[u8]
        let blen CodingSystem.encode_utf8_bytes(src, m, bytes, cap)
        var olen: size_t 0
        let obytes CodingSystemKit.encode_output_charref(host, bytes, blen, true, &olen)
        String(obytes as pointer[const_char], olen)
    }

    ; the raw tree as a StringC — the unit-test observation point.
    function to_stringc(this: ref[SgmlFOTBuilder], host: pointer[Page]) returns StringC
        StringC^host(this.out.get_buffer(), this.out.get_length())

    function test() returns int
    {
        let anchor StringC("x")
        let host Page.get(anchor.data_ptr() as pointer[void])

        ; 1. Units quirks (millipoints; reference "%03d" + point-insert)
        let f SgmlFOTBuilder.make(host)
        f.units(12000)
        f.units(500)
        f.units(0 - 500)
        f.units(0)
        f.units(1005)
        f.units(5)
        let got f.to_stringc(host)
        if got.equals(StringC("<?xml version=\"1.0\"?>\r<fot>\r12pt.5pt-.5pt0pt1.005pt.005pt")) = false
            return 0 - 1

        ; 2. text escaping incl. numeric char refs >= 0x80
        let f2 SgmlFOTBuilder.make(host)
        let chars Array[u32]^host()
        chars.add(0x61)
        chars.add(0x26)
        chars.add(0x3C)
        chars.add(0xFC)
        f2.characters(chars.get_buffer(), chars.get_length())
        f2.finish()
        let got2 f2.to_stringc(host)
        if got2.equals(StringC("<?xml version=\"1.0\"?>\r<fot>\r<text>a&amp;&lt;&#252;</text>\r</fot>\r")) = false
            return 0 - 2

        ; 3. ics buffer: a length IC flushed into a paragraph start tag
        let f3 SgmlFOTBuilder.make(host)
        let ident3 Identifier.make(host, StringC("font-size"))
        let ic3 InheritedC.make(host, IC_LENGTH, ident3, 0, StringC("font-size"))
        set ic3.lval: 18000
        f3.set_ic(ic3)
        f3.start_paragraph(null)
        f3.end_paragraph()
        let got3 f3.to_stringc(host)
        if got3.equals(StringC("<?xml version=\"1.0\"?>\r<fot>\r<paragraph font-size=\"18pt\">\r</paragraph>\r")) = false
            return 0 - 3

        0
    }
}
