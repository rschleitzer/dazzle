    ; PageTypeSosofoObj — processes match/noMatch depending on the page-type
    ; flags in effect (if-first-page / if-front-page).
    function make_page_type_sosofo(host: pointer[Page], flag: int, matched: pointer[ELObj], no_match: pointer[ELObj]) returns pointer[ELObj]
    {
        let parts Array[pointer[ELObj]]^host()
