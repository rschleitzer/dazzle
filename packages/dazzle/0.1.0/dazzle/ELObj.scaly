; --- transform flow-object classes -----------------------------------------
; The extension flow objects the transform backend registers (jade/Transform-
; FOTBuilder.cxx; dazzle-net TransformFOTBuilder.cs mirror). A declare-flow-
; object-class binds a stylesheet identifier's VALUE to a FlowObjBox carrying
; one of these kinds (keyed on its public id — see Interpreter); `make FOC …`
; reads that value to build a SOSO_FLOWOBJ sosofo. (Binding the VALUE, not a new
; Identifier field, is both DSSSL-correct and avoids growing the Identifier
; record — a heap-allocation size change there shifts the run region across a
; page boundary and corrupts it; port history.) Compound kinds (element/entity/
; directory/sequence) carry content; atomic kinds do not. FOC_SEQUENCE is the
; built-in fallback (also the SequenceFlowObj used for an unknown class).
define FOC_NONE: int 0
define FOC_SEQUENCE: int 1
define FOC_ELEMENT: int 2
define FOC_EMPTY_ELEMENT: int 3
define FOC_ENTITY: int 4
define FOC_ENTITY_REF: int 5
define FOC_PROCESSING_INSTRUCTION: int 6
define FOC_DOCUMENT_TYPE: int 7
define FOC_FORMATTING_INSTRUCTION: int 8
define FOC_DIRECTORY: int 9
; standard (print) flow-object classes — installed unconditionally like the
; reference installFlowObjs; rendered by the fot backend, content-transparent
; under the transform backend (whose reference virtuals are no-ops). Inc 8.
define FOC_PARAGRAPH: int 10
define FOC_PARAGRAPH_BREAK: int 11
define FOC_DISPLAY_GROUP: int 12
define FOC_LINE_FIELD: int 13
define FOC_SIMPLE_PAGE_SEQUENCE: int 14
; the table family (FlowObj.cxx Table*FlowObj) — FOC_TABLE_BORDER is the
; style-carrier sosofo (processes to nothing; tableBorderStyle = its style).
define FOC_TABLE: int 15
define FOC_TABLE_PART: int 16
define FOC_TABLE_COLUMN: int 17
define FOC_TABLE_ROW: int 18
define FOC_TABLE_CELL: int 19
define FOC_TABLE_BORDER: int 20
; RuleFlowObj — an atomic display/inline flow object (orientation decides);
; also the fraction-bar characteristic's value class (RuleC).
define FOC_RULE: int 21
; UnknownFlowObj — what declare-flow-object-class binds when the active
