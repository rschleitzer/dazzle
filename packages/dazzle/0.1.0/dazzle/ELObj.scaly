    ; LangObj::toUpper / toLower — pair-table lookup, miss = identity.
    function language_case(this: pointer[ELObj], c: u32, up: bool) returns u32
    {
        choose *this
            when l: Language
            {
                var m l.downmap
                if up
                    set m: l.upmap
                if m = null
                    return c
                let n m.get_length()
                let b m.get_buffer()
                var i: size_t 0
                while (i + (1 as size_t)) < n
                {
                    if *(b + i) = c
                        return *(b + i + (1 as size_t))
                    set i: i + (2 as size_t)
                }
                return c
            }
            else
                return c
        c
    }

    ; SOSO_FLOWOBJ — a transform flow object (MakeExpression result). parts = the
    ; content sosofos (null/empty for atomic); aux = a FlowObjBox wrapping the
    ; FlowObj characteristics (keeps SosofoObj at two pointers).
    function make_flowobj_sosofo(host: pointer[Page], fo: pointer[FlowObj], content: pointer[Array[pointer[ELObj]]]) returns pointer[ELObj]
    {
        let box ELObj.make_flowobj_box(host, fo)
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(SOSO_FLOWOBJ, content, box))
        p
    }

    ; LabelSosofoObj — wraps a labeled flow object (label: sym). The content
    ; (the flow-object sosofo) sits in aux; the ctl record (symbol + location)
    ; is smuggled through parts.
    function make_label_sosofo(host: pointer[Page], sym: pointer[ELObj], loc: Location, content: pointer[ELObj]) returns pointer[ELObj]
    {
        let ctl SosofoCtlRec.make(host, sym, loc)
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(SOSO_LABEL, ctl as pointer[Array[pointer[ELObj]]], content))
        p
    }

    ; DiscardLabeledSosofoObj — sosofo-discard-labeled. No location is
    ; needed (the reference's ctor takes none), but the ctl record is reused
    ; so the symbol travels the same slot as SOSO_LABEL's.
    function make_discard_labeled_sosofo(host: pointer[Page], sym: pointer[ELObj], content: pointer[ELObj]) returns pointer[ELObj]
    {
        let ctl SosofoCtlRec.make(host, sym, Location())
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(SOSO_DISCARD_LABELED, ctl as pointer[Array[pointer[ELObj]]], content))
        p
    }

    ; ContentMapSosofoObj — wraps a flow object's content with a content-map:
    ; value (the ctl record carries the map + location, content in aux).
    function make_content_map_sosofo(host: pointer[Page], map: pointer[ELObj], loc: Location, content: pointer[ELObj]) returns pointer[ELObj]
    {
        let ctl SosofoCtlRec.make(host, map, loc)
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(SOSO_CONTENT_MAP, ctl as pointer[Array[pointer[ELObj]]], content))
        p
    }

    ; the ctl record of a SOSO_LABEL / SOSO_CONTENT_MAP sosofo (parts slot).
    function sosofo_ctl(this: pointer[ELObj]) returns pointer[SosofoCtlRec]
    {
        choose *this
            when s: Sosofo
                return s.parts as pointer[SosofoCtlRec]
            else
                return null
        null
    }

    function is_sosofo_p(this: pointer[ELObj]) returns bool
    {
        choose *this
            when s: Sosofo
                return true
            else
                return false
        false
    }

    function sosofo_parts(this: pointer[ELObj]) returns pointer[Array[pointer[ELObj]]]
    {
        choose *this
            when s: Sosofo
                return s.parts
            else
                return null
        null
    }

    function sosofo_kind(this: pointer[ELObj]) returns int
    {
        choose *this
            when s: Sosofo
                return s.kind
            else
                return 0 - 1
        0 - 1
    }

    ; the kind-specific ELObj payload (string / node-list / node-singleton).
    function sosofo_aux(this: pointer[ELObj]) returns pointer[ELObj]
    {
        choose *this
            when s: Sosofo
                return s.aux
            else
                return null
        null
    }

    ; the flow-object characteristics of a SOSO_FLOWOBJ sosofo (the FlowObjBox
    ; wrapped in the `aux` slot).
    function sosofo_flowobj(this: pointer[ELObj]) returns pointer[FlowObj]
    {
        choose *this
            when s: Sosofo
            {
                if s.aux = null
                    return null
                return s.aux.flowobj_box_ref()
            }
            else
                return null
        null
    }

    ; the FlowObj pointer inside a FlowObjBox (null if not a box).
    function flowobj_box_ref(this: pointer[ELObj]) returns pointer[FlowObj]
    {
        choose *this
            when b: FlowObjBox
                return b.fo
            else
                return null
        null
    }

    ; --- continuation state (call/cc) --------------------------------------
    ; ContinuationObj::set(stackSize, controlStackSize) — record the capture.
    function continuation_set(this: pointer[ELObj], ss: int, css: int)
    {
        choose *this
            when k: Continuation
            {
                var nk k
                set nk.stack_size: ss
                set nk.control_stack_size: css
                set *this: ELObj.Continuation(nk)
            }
            else
                return
    }

    function continuation_kill(this: pointer[ELObj])
    {
        choose *this
            when k: Continuation
            {
                var nk k
                set nk.live: false
                set *this: ELObj.Continuation(nk)
            }
            else
                return
    }

    function continuation_live(this: pointer[ELObj]) returns bool
    {
        choose *this
            when k: Continuation
                return k.live
            else
                return false
        false
    }

    function continuation_read_only(this: pointer[ELObj]) returns bool
    {
        choose *this
            when k: Continuation
                return k.read_only
            else
                return false
        false
    }

    function continuation_stack_size(this: pointer[ELObj]) returns int
    {
        choose *this
            when k: Continuation
                return k.stack_size
            else
                return 0
        0
    }

    function continuation_control_stack_size(this: pointer[ELObj]) returns int
    {
        choose *this
            when k: Continuation
                return k.control_stack_size
            else
                return 0
        0
    }

    ; --- box accessors -----------------------------------------------------
    function box_value(this: pointer[ELObj]) returns pointer[ELObj]
    {
        choose *this
            when b: Box
                return b.value
            else
                return null
        null
    }

    function box_set_value(this: pointer[ELObj], v: pointer[ELObj])
    {
        choose *this
            when b: Box
                set *this: ELObj.Box(BoxObj(v, b.read_only))
    }

    function box_is_read_only(this: pointer[ELObj]) returns bool
    {
        choose *this
            when b: Box
                return b.read_only
            else
                return false
        false
    }

    ; --- function protocol -------------------------------------------------
    ; asFunction != null: a Closure/Primitive/Continuation/apply/cc.
    function is_function(this: pointer[ELObj]) returns bool
    {
        choose *this
            when c: Closure
                return true
            when p: Primitive
                return true
            when k: Continuation
                return true
            when a: ApplyFn
                return true
            when cc: CallCCFn
                return true
            else
                return false
        false
    }

    function signature_of(this: pointer[ELObj]) returns Signature
    {
        choose *this
            when c: Closure
                return c.sig
            when p: Primitive
                return p.sig
            when k: Continuation
                return Signature(1, 0, false)
            when a: ApplyFn
                return Signature(2, 0, true)
            when cc: CallCCFn
                return Signature(1, 0, false)
            else
                return Signature(0, 0, false)
        Signature(0, 0, false)
    }

    function n_required_args(this: pointer[ELObj]) returns int
        this.signature_of().n_required

    function n_optional_args(this: pointer[ELObj]) returns int
        this.signature_of().n_optional

    function n_key_args(this: pointer[ELObj]) returns int
        this.signature_of().n_key

    function has_rest_arg(this: pointer[ELObj]) returns bool
        this.signature_of().rest_arg

    function primitive_set_ident(this: pointer[ELObj], ident: pointer[Identifier])
    {
        choose *this
            when p: Primitive
                set *this: ELObj.Primitive(PrimitiveObj(p.sig, p.prim_id, ident))
    }

    ; makeCallInsn / makeTailCallInsn: primitives compile to a PrimitiveCallInsn
    ; (direct dispatch), everything else to a FunctionCallInsn.
    function make_call_insn(this: pointer[ELObj], n_args: int, interp: pointer[Interpreter], loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        let host interp.get_host()
        choose *this
            when p: Primitive
                return Insn.make_primitive_call(host, n_args, this, loc, next)
            else
                return Insn.make_function_call(host, n_args, this, loc, next)
        null
    }

    function make_tail_call_insn(this: pointer[ELObj], n_args: int, interp: pointer[Interpreter], loc: Location, n_caller_args: int) returns pointer[Insn]
        Insn.make_function_tail_call(interp.get_host(), n_args, this, loc, n_caller_args)

    ; primitiveCall dispatch for the Primitive arm.
    function prim_call(this: pointer[ELObj], n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], interp: pointer[Interpreter], loc: Location) returns pointer[ELObj]
    {
        choose *this
            when p: Primitive
            {
                var nm StringC()
                if p.ident <> null
                    set nm: p.ident.get_name()
                return Primitive.dispatch(p.prim_id, nm, n_args, args, ctx, interp, loc)
            }
            else
                return interp.make_error()
        interp.make_error()
    }

    ; FunctionObj::call — dispatch a call to this callable (VM.cs/FunctionObj.cs).
    function call(this: pointer[ELObj], vm: pointer[VM], loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        choose *this
            when c: Closure
            {
                vm.need_stack(1)
                let naa vm.get_n_actual_args()
                vm.push_frame(next, naa)
                vm.set_frame_start(vm.get_sp() - naa)
                vm.set_closure(c.display)
                vm.set_protect_closure(this)
                vm.set_closure_loc(loc)
                return c.code
            }
            when p: Primitive
                return this.prim_call_return(vm, loc, next)
            when a: ApplyFn
                return this.apply_call(vm, loc, next, false, 0)
            when cc: CallCCFn
                return this.callcc_call(vm, loc, next, false, 0)
            when k: Continuation
                return this.continuation_call(vm, loc)
            else
            {
                vm.set_sp(0 - 1)
                return null
            }
        null
    }

    ; CallWithCurrentContinuationPrimitiveObj::call/tailCall — replace the sole
    ; argument (the receiver proc) with a fresh Continuation, invoke it, then
    ; (for closures) record the continuation in its frame via setArgToCC.
    function callcc_call(this: pointer[ELObj], vm: pointer[VM], loc: Location, next: pointer[Insn], tail: bool, n_caller_args: int) returns pointer[Insn]
    {
        let f vm.stack_ref(vm.get_sp() - 1)
        if (f = null) or (f.is_function() = false)
        {
            vm.get_interp().set_next_location(loc)
            vm.set_sp(0 - 1)
            return null
        }
        let host vm.get_host()
        let k ELObj.make_continuation(host)
        vm.stack_set(vm.get_sp() - 1, k)
        var insn: pointer[Insn] null
        if tail
            set insn: f.tail_call(vm, loc, n_caller_args)
        else
            set insn: f.call(vm, loc, next)
        f.set_arg_to_cc(vm, k)
        insn
    }

    ; FunctionObj::setArgToCC — only a Closure records the continuation.
    function set_arg_to_cc(this: pointer[ELObj], vm: pointer[VM], k: pointer[ELObj])
    {
        choose *this
            when c: Closure
                vm.set_closure_arg_to_cc(k)
            else
                return
    }

    ; ContinuationObj::call — restore the captured stack + control stack and
    ; resume with the supplied result (an escape-only, one-shot continuation).
    function continuation_call(this: pointer[ELObj], vm: pointer[VM], loc: Location) returns pointer[Insn]
    {
        if (this.continuation_live() = false) or this.continuation_read_only()
        {
            vm.get_interp().set_next_location(loc)
            vm.set_sp(0 - 1)
            return null
        }
        let result vm.stack_ref(vm.get_sp() - 1)
        vm.unwind_control_stack(this.continuation_control_stack_size())
        vm.set_sp(this.continuation_stack_size() - 1)
        let nxt vm.pop_frame()
        vm.need_stack(1)
        let sp2 vm.get_sp()
        vm.stack_set(sp2, result)
        vm.set_sp(sp2 + 1)
        nxt
    }

    function tail_call(this: pointer[ELObj], vm: pointer[VM], loc: Location, n_caller_args: int) returns pointer[Insn]
    {
        choose *this
            when c: Closure
            {
                vm.need_stack(1)
                let n_args vm.get_n_actual_args()
                if n_caller_args > 0
                {
                    let old_frame vm.get_sp() - n_args
                    let new_frame old_frame - n_caller_args
                    var i 0
                    while i < n_args
                    {
                        vm.stack_set(new_frame + i, vm.stack_ref(old_frame + i))
                        set i: i + 1
                    }
                    vm.set_frame_start(new_frame)
                    vm.set_sp(new_frame + n_args)
                }
                else
                    vm.set_frame_start(vm.get_sp() - n_args)
                vm.set_closure(c.display)
                vm.set_protect_closure(this)
                vm.set_closure_loc(loc)
                return c.code
            }
            when p: Primitive
                return this.prim_tail_call(vm, loc, n_caller_args)
            when a: ApplyFn
                return this.apply_call(vm, loc, null, true, n_caller_args)
            when cc: CallCCFn
                return this.callcc_call(vm, loc, null, true, n_caller_args)
            when k: Continuation
                return this.continuation_call(vm, loc)
            else
            {
                vm.set_sp(0 - 1)
                return null
            }
        null
    }

    ; PrimitiveObj::call — gather args, dispatch, push result.
    function prim_call_return(this: pointer[ELObj], vm: pointer[VM], loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        let naa vm.get_n_actual_args()
        if naa = 0
            vm.need_stack(1)
        let argp vm.get_sp() - naa
        let result this.prim_call(naa, vm.sbase_at(argp), vm, vm.get_interp(), loc)
        vm.stack_set(argp, result)
        vm.set_sp(argp + 1)
        if vm.get_interp().is_error(result)
        {
            vm.set_sp(0 - 1)
            return null
        }
        next
    }

    ; PrimitiveObj::tailCall — dispatch, pop frame, push result.
    function prim_tail_call(this: pointer[ELObj], vm: pointer[VM], loc: Location, n_caller_args: int) returns pointer[Insn]
    {
        let naa vm.get_n_actual_args()
        let argp vm.get_sp() - naa
        let result this.prim_call(naa, vm.sbase_at(argp), vm, vm.get_interp(), loc)
        if vm.get_interp().is_error(result)
        {
            vm.set_sp(0 - 1)
            return null
        }
        vm.set_sp(argp - n_caller_args)
        let nxt vm.pop_frame()
        vm.need_stack(1)
        vm.stack_set(vm.get_sp(), result)
        vm.set_sp(vm.get_sp() + 1)
        nxt
    }

    ; ApplyPrimitiveObj::call/tailCall — shuffle the arg list onto the stack,
    ; then run an (Tail)Apply against the extracted function.
    function apply_call(this: pointer[ELObj], vm: pointer[VM], loc: Location, next: pointer[Insn], tail: bool, n_caller_args: int) returns pointer[Insn]
    {
        if vm.apply_shuffle(loc) = false
            return null
        if tail
            return Insn.exec_tail_apply(vm, n_caller_args, vm.get_n_actual_args(), loc)
        Insn.exec_apply(vm, vm.get_n_actual_args(), loc, next)
    }

    function is_nil(this: pointer[ELObj]) returns bool
    {
        choose *this
            when n: Nil
                return true
            else
                return false
        false
    }

    function is_pair(this: pointer[ELObj]) returns bool
    {
        choose *this
            when p: Pair
                return true
            else
                return false
        false
    }

    ; KeywordObj::identifier() — the interned Identifier, or null if not a keyword.
    function keyword_ident(this: pointer[ELObj]) returns pointer[Identifier]
    {
        choose *this
            when k: Keyword
                return k.ident
            else
                return null
        null
    }

    ; --- type predicates (Primitive.cs) ------------------------------------
    ; ★There is no separate isNumber in the reference: `number?` (IsNumber),
    ; `real?` (IsReal), `number->string` and the scale-NIC conversion are all
    ; literally `realValue(d)` — and realValue is overridden ONLY by
    ; IntegerObj, RealObj and QuantityObj (dimensionless), never by LengthObj
    ; or the unresolved arms. So a LENGTH is not a number: `(number? 1pt)`,
    ; `(number? (* 1pt 1pt))` and `(number->string 1pt)` are #f / #f / an
    ; error. This used to answer true for every numeric-looking arm.
    function is_number(this: pointer[ELObj]) returns bool
        this.is_real()

    function is_integer_p(this: pointer[ELObj]) returns bool
    {
        choose *this
            when i: Int
                return true
            else
                return false
        false
    }

    function is_string_p(this: pointer[ELObj]) returns bool
    {
        choose *this
            when s: Str
                return true
            when sc: StrCat
                return true
            else
                return false
        false
    }

    function is_symbol_p(this: pointer[ELObj]) returns bool
    {
        choose *this
            when s: Symbol
                return true
            else
                return false
        false
    }

    function is_char_p(this: pointer[ELObj]) returns bool
    {
        choose *this
            when c: Chr
                return true
            else
                return false
        false
    }

    function is_keyword_p(this: pointer[ELObj]) returns bool
    {
        choose *this
            when k: Keyword
                return true
            else
                return false
        false
    }

    function is_vector_p(this: pointer[ELObj]) returns bool
    {
        choose *this
            when v: Vec
                return true
            else
                return false
        false
    }

    ; VectorObj::size() — element count (0 for a non-vector).
    function vector_length(this: pointer[ELObj]) returns size_t
    {
        choose *this
            when v: Vec
                return v.n
            else
                return 0 as size_t
        0 as size_t
    }

    ; VectorObj::operator[] read — caller must bounds-check first.
    function vector_elem(this: pointer[ELObj], i: size_t) returns pointer[ELObj]
    {
        choose *this
            when v: Vec
                return *(v.elems + i)
            else
                return null
        null
    }

    ; VectorObj::operator[] write (vector-set!).
    function vector_set_elem(this: pointer[ELObj], i: size_t, val: pointer[ELObj])
    {
        choose *this
            when v: Vec
                set *(v.elems + i): val
            else
                return
    }

    ; KeywordObj::name() — the interned Identifier's name.
    function keyword_name(this: pointer[ELObj]) returns StringC
    {
        let id this.keyword_ident()
        if id = null
            return StringC()
        id.get_name()
    }

    ; #t and #f are the only booleans.
    function is_boolean_p(this: pointer[ELObj]) returns bool
    {
        choose *this
            when t: True
                return true
            when f: False
                return true
            else
                return false
        false
    }

    ; NilObj: true; PairObj: walks the cdr chain; everything else: false.
    function is_list(this: pointer[ELObj]) returns bool
    {
        choose *this
            when n: Nil
                return true
            when pr: Pair
            {
                var p pr.cdr
                while p <> null
                {
                    choose *p
                        when n2: Nil
                            return true
                        when p2: Pair
                            set p: p2.cdr
                        else
                            return false
                }
                return true
            }
            else
                return false
        false
    }

    ; Everything is true except #f.
    function is_true(this: pointer[ELObj]) returns bool
    {
        choose *this
            when f: False
                return false
            else
                return true
        true
    }

    function is_false(this: pointer[ELObj]) returns bool
    {
        choose *this
            when f: False
                return true
            else
                return false
        false
    }

    ; --- accessors (NULL-sentinel, the opensp lookup convention) -----------
    function get_car(this: pointer[ELObj]) returns pointer[ELObj]
    {
        choose *this
            when pr: Pair
                return pr.car
            else
                return null
        null
    }

    function get_cdr(this: pointer[ELObj]) returns pointer[ELObj]
    {
        choose *this
            when pr: Pair
                return pr.cdr
            else
                return null
        null
    }

    ; Arm rebuild in place — the union address (eq?-identity) is unchanged.
    function set_car(this: pointer[ELObj], v: pointer[ELObj])
    {
        choose *this
            when pr: Pair
                set *this: ELObj.Pair(PairObj(v, pr.cdr))
    }

    function set_cdr(this: pointer[ELObj], v: pointer[ELObj])
    {
        choose *this
            when pr: Pair
                set *this: ELObj.Pair(PairObj(pr.car, v))
    }

    ; charValue: the codepoint, or -1 (no codepoint is negative).
    function char_value(this: pointer[ELObj]) returns int
    {
        choose *this
            when c: Chr
                return c.ch as int
            else
                return 0 - 1
        0 - 1
    }

    ; stringData: chars and strings have it (a char is a 1-char string).
    function has_string_data(this: pointer[ELObj]) returns bool
    {
        choose *this
            when c: Chr
                return true
            when s: Str
                return true
            when sc: StrCat
                return true
            else
                return false
        false
    }

    ; The string data as a StringC (Chr allocates its 1-char buffer on host;
    ; Str returns a shallow view of its page-resident buffer).
    function string_data(this: pointer[ELObj], host: pointer[Page]) returns StringC
    {
        choose *this
            when c: Chr
            {
                var buf u32[1]
                set *(buf as pointer[u32]): c.ch
                return StringC^host(buf as pointer[u32], 1 as size_t)
            }
            when s: Str
                return s.str
            when sc: StrCat
            {
                ; flatten once and memoize in place. The scratch fill buffer
                ; goes on the caller's host (transient); the final buffer on
                ; the rope's OWN page — the memoized Str must live exactly as
                ; long as the object itself, and callers pass shorter-lived
                ; hosts (a deeper eval scratch region).
                let n sc.size
                if n = (0 as size_t)
                {
                    set *this: ELObj.Str(StringObj(StringC()))
                    return StringC()
                }
                let tmp host.allocate(n * (sizeof u32), alignof u32) as pointer[u32]
                this.strcat_fill(tmp, 0 as size_t)
                let own Page.get(this as pointer[void])
                let flat StringC^own(tmp, n)
                set *this: ELObj.Str(StringObj(flat))
                return flat
            }
            else
                return StringC()
        StringC()
    }

    ; stringData total WITHOUT flattening a rope (string-append/string-length
    ; fast path). Negative when the object carries no string data.
    function string_size(this: pointer[ELObj]) returns i64
    {
        choose *this
            when c: Chr
                return 1 as i64
            when s: Str
                return s.str.get_size() as i64
            when sc: StrCat
                return sc.size as i64
            else
                return (0 - 1) as i64
        (0 - 1) as i64
    }

    ; flatten walk: write this object's string data at buf+off, return the
    ; advanced offset.
    function strcat_fill(this: pointer[ELObj], buf: pointer[u32], off: size_t) returns size_t
    {
        choose *this
            when c: Chr
            {
                set *(buf + off): c.ch
                return off + 1
            }
            when s: Str
            {
                let m s.str.get_size()
                var k: size_t 0
                while k < m
                {
                    set *(buf + off + k): s.str.get(k)
                    set k: k + 1
                }
                return off + m
            }
            when sc: StrCat
            {
                let ps sc.parts
                let n ps.get_length()
                let b ps.get_buffer()
                var o off
                var i: size_t 0
                while i < n
                {
                    let part *(b + i)
                    if part <> null
                        set o: part.strcat_fill(buf, o)
                    set i: i + 1
                }
                return o
            }
            else
                return off
        off
    }

    ; collapse a rope in place (consumers that pattern-match the Str arm
    ; directly — printer, is_equal — normalize first).
    procedure normalize_string(this: pointer[ELObj])
    {
        choose *this
            when sc: StrCat
            {
                let own Page.get(this as pointer[void])
                this.string_data(own)
            }
            else
                return
    }

    function is_exact_integer(this: pointer[ELObj]) returns bool
    {
        choose *this
            when i: Int
                return true
            else
                return false
        false
    }

    function exact_integer_value(this: pointer[ELObj]) returns int
    {
        choose *this
            when i: Int
                return i.n
            else
                return 0
        0
    }

    ; realValue: integers and reals; quantities only when dimensionless.
    function is_real(this: pointer[ELObj]) returns bool
    {
        choose *this
            when i: Int
                return true
            when r: Real
                return true
            when q: Quantity
                return q.dim = 0
            else
                return false
        false
    }

    function real_value(this: pointer[ELObj]) returns double
    {
        choose *this
            when i: Int
                return i.n as double
            when r: Real
                return r.n
            when q: Quantity
                return q.val
            else
                return 0.0
        0.0
    }

    ; inexactRealValue: reals and dimensionless quantities, NOT integers.
    function is_inexact_real(this: pointer[ELObj]) returns bool
    {
        choose *this
            when r: Real
                return true
            when q: Quantity
                return q.dim = 0
            else
                return false
        false
    }

    function is_length(this: pointer[ELObj]) returns bool
    {
        choose *this
            when l: Length
                return true
            else
                return false
        false
    }

    function length_value(this: pointer[ELObj]) returns int
    {
        choose *this
            when l: Length
                return l.n
            else
                return 0
        0
    }

    ; quantityValue — Int: long dim 0; Real: double dim 0; Length: long
    ; dim 1; Quantity: double with its dim; everything else noQuantity.
    function quantity_value(this: pointer[ELObj]) returns QuantityValue
    {
        var qtype QT_NONE
        var lval 0
        var dval 0.0
        var dim 0
        choose *this
            when i: Int
            {
                set qtype: QT_LONG
                set lval: i.n
            }
            when r: Real
            {
                set qtype: QT_DOUBLE
                set dval: r.n
            }
            when l: Length
            {
                set qtype: QT_LONG
                set lval: l.n
                set dim: 1
            }
            when q: Quantity
            {
                set qtype: QT_DOUBLE
                set dval: q.val
                set dim: q.dim
            }
        QuantityValue(qtype, lval, dval, dim)
    }

    ; ELObj *resolveQuantities(bool force, Interpreter &, const Location &):
    ; the unresolved-quantity arms resolve through their unit (undefined
    ; unit -> undefinedQuantity + error); everything else IS resolved.
    function resolve_quantities(this: pointer[ELObj], force: bool, interp: pointer[Interpreter], loc: Location) returns pointer[ELObj]
    {
        choose *this
            when ul: UnresolvedLength
            {
                let u ul.unit
                ; the reference gate is Unit::defined (a definition
                ; EXPRESSION counts, not just a computed value — a redefined
                ; builtin sits notComputed until tryCompute).
                var dp 0 as u32
                var dl Location()
                if u.defined(&dp, &dl) = false
                {
                    interp.set_next_location(loc)
                    interp.message1(InterpreterMessages.undefinedQuantity(), u.get_name())
                    return interp.make_error()
                }
                return u.resolve_quantity_long(force, interp, ul.val, ul.val_exp)
            }
            when uq: UnresolvedQuantity
            {
                let u uq.unit
                var dp 0 as u32
                var dl Location()
                if u.defined(&dp, &dl) = false
                {
                    interp.set_next_location(loc)
                    interp.message1(InterpreterMessages.undefinedQuantity(), u.get_name())
                    return interp.make_error()
                }
                return u.resolve_quantity_double(force, interp, uq.val, uq.unit_exp)
            }
            else
                return this
        this
    }

    ; convertToString: strings themselves, symbols their name, chars their
    ; 1-char string; null otherwise.
    function convert_to_string(this: pointer[ELObj], host: pointer[Page]) returns pointer[ELObj]
    {
        choose *this
            when s: Str
                return this
            when sc: StrCat
                return this
            when sym: Symbol
                return ELObj.make_string(host, sym.name)
            when c: Chr
            {
                var buf u32[1]
                set *(buf as pointer[u32]): c.ch
                let s StringC^host(buf as pointer[u32], 1 as size_t)
                return ELObj.make_string(host, s)
            }
            else
                return null
        null
    }

    ; --- printer -----------------------------------------------------------
    ; ELObj::print(Interpreter&, OutputCharStream&). Of the Interpreter the
    ; printer only consults unitsPerInch() (Length/Quantity); it is threaded
    ; as a scalar until Inc 3 lands the Interpreter record.
    function print(this: pointer[ELObj], os: pointer[OutputCharStream], units_per_inch: int)
    {
        this.normalize_string()
        choose *this
            when e: Error
                os.put_ascii("#<error>")
            when u: Unspecified
                os.put_ascii("#v")
            when n: Nil
                os.put_ascii("()")
            when t: True
                os.put_ascii("#t")
            when f: False
                os.put_ascii("#f")
            when sym: Symbol
                os.write(sym.name.data_ptr(), sym.name.get_size())
            when k: Keyword
            {
                let name k.ident.get_name()
                os.write(name.data_ptr(), name.get_size())
                os.put_ascii(":")
            }
            when pr: Pair
            {
                os.put_ascii("(")
                if pr.car <> null
                    pr.car.print(os, units_per_inch)
                var p pr.cdr
                var done false
                while done = false
                {
                    if p = null
                    {
                        os.put_ascii(")")
                        set done: true
                    }
                    else
                    {
                        choose *p
                            when n2: Nil
                            {
                                os.put_ascii(")")
                                set done: true
                            }
                            when p2: Pair
                            {
                                os.put_ascii(" ")
                                if p2.car <> null
                                    p2.car.print(os, units_per_inch)
                                set p: p2.cdr
                            }
                            else
                            {
                                os.put_ascii(" . ")
                                p.print(os, units_per_inch)
                                os.put_ascii(")")
                                set done: true
                            }
                    }
                }
            }
            when v: Vec
            {
                ; the reference's cycle guard: null the slot while printing
                ; it, restore after; a null slot prints #<cycle>.
                os.put_ascii("#(")
                var i: size_t 0
                while i < v.n
                {
                    if i > (0 as size_t)
                        os.put_ascii(" ")
                    let e *(v.elems + i)
                    if e = null
                        os.put_ascii("#<cycle>")
                    if e <> null
                    {
                        set *(v.elems + i): null
                        e.print(os, units_per_inch)
                        set *(v.elems + i): e
                    }
                    set i: i + 1
                }
                os.put_ascii(")")
            }
            when c: Chr
            {
                os.put_ascii("#\\")
                os.put(c.ch)
            }
            when s: Str
            {
                os.put_ascii("\"")
                var i: size_t 0
                let n s.str.get_size()
                while i < n
                {
                    let ch s.str.get(i)
                    if ch = (0x5C as u32)
                        os.put_ascii("\\")
                    if ch = (0x22 as u32)
                        os.put_ascii("\\")
                    os.put(ch)
                    set i: i + 1
                }
                os.put_ascii("\"")
            }
            when i2: Int
                ELObj.print_integer(os, i2.n, 10 as u32)
            when r: Real
                ELObj.print_double(os, r.n)
            when l: Length
            {
                ELObj.print_double(os, (l.n as double) * 72.0 / (units_per_inch as double))
                os.put_ascii("pt")
            }
            when q: Quantity
            {
                ELObj.print_double(os, q.val * pow(72.0 / (units_per_inch as double), q.dim as double))
                os.put_ascii("pt")
                ELObj.print_integer(os, q.dim, 10 as u32)
            }
            else
            {
                ; ELObj::print default: "#<unknown object <addr>>" — the
                ; unresolved-quantity and glyph-id arms have no printed form.
                os.put_ascii("#<unknown object ")
                ELObj.print_integer(os, (this as size_t) as int, 10 as u32)
                os.put_ascii(">")
            }
    }

    ; print(interp, os, radix) — only integers honor the radix.
    function print_radix(this: pointer[ELObj], os: pointer[OutputCharStream], radix: u32, units_per_inch: int)
    {
        choose *this
            when i: Int
                ELObj.print_integer(os, i.n, radix)
            else
                this.print(os, units_per_inch)
    }

    ; IntegerObj::print — magnitude via unsigned wrap (covers INT64_MIN).
    function print_integer(os: pointer[OutputCharStream], n: int, radix: u32)
    {
        if n = 0
        {
            os.put_ascii("0")
            return
        }
        var m: size_t 0
        if n < 0
        {
            os.put_ascii("-")
            set m: (0 as size_t) - (n as size_t)
        }
        if n > 0
            set m: n as size_t
        var buf u8[64]
        var i 0
        let r radix as size_t
        while m <> (0 as size_t)
        {
            let d (m % r) as int
            var c 0x30 + d
            if d >= 10
                set c: 0x61 + d - 10
            set *((buf as pointer[u8]) + i): c as u8
            set i: i + 1
            set m: m / r
        }
        while i > 0
        {
            set i: i - 1
            os.put((*((buf as pointer[u8]) + i)) as u32)
        }
    }

    ; RealObj::print is C's %g (precision 6, trailing zeros stripped,
    ; scientific when exp < -4 or >= 6). Reimplemented here; the corpus
    ; differential gate validates byte-fidelity against the reference.
    function print_double(os: pointer[OutputCharStream], x_in: double)
    {
        var x x_in
        if x < 0.0
        {
            os.put_ascii("-")
            set x: 0.0 - x
        }
        if x = 0.0
        {
            os.put_ascii("0")
            return
        }
        ; 6 significant digits: m in [100000, 999999] and decimal exponent e
        var e (floor(log10(x))) as int
        var m (floor((x / pow(10.0, (e - 5) as double)) + 0.5)) as int
        if m >= 1000000
        {
            set m: m / 10
            set e: e + 1
        }
        ; the six digits, most significant first
        var digits u8[6]
        var i 6
        while i > 0
        {
            set i: i - 1
            set *((digits as pointer[u8]) + i): (0x30 + (m % 10)) as u8
            set m: m / 10
        }
        ; strip trailing zeros -> k significant digits (k >= 1)
        var k 6
        while k > 1
        {
            if (*((digits as pointer[u8]) + (k - 1))) <> (0x30 as u8)
                break
            set k: k - 1
        }
        var use_sci false
        if e < (0 - 4)
            set use_sci: true
        if e >= 6
            set use_sci: true
        if use_sci
        {
            os.put((*(digits as pointer[u8])) as u32)
            if k > 1
            {
                os.put_ascii(".")
                var j 1
                while j < k
                {
                    os.put((*((digits as pointer[u8]) + j)) as u32)
                    set j: j + 1
                }
            }
            os.put_ascii("e")
            var ea e
            if ea < 0
            {
                os.put_ascii("-")
                set ea: 0 - ea
            }
            if ea >= 0
            {
                if e >= 0
                    os.put_ascii("+")
            }
            if ea < 10
                os.put_ascii("0")
            ELObj.print_integer(os, ea, 10 as u32)
            return
        }
        if e >= 0
        {
            ; point after e+1 digits; zero-pad when all digits are integral
            var j 0
            while j <= e
            {
                if j < k
                    os.put((*((digits as pointer[u8]) + j)) as u32)
                if j >= k
                    os.put_ascii("0")
                set j: j + 1
            }
            if k > (e + 1)
            {
                os.put_ascii(".")
                while j < k
                {
                    os.put((*((digits as pointer[u8]) + j)) as u32)
                    set j: j + 1
                }
            }
            return
        }
        ; e < 0: 0.<zeros><digits>
        os.put_ascii("0.")
        var z 0 - e - 1
        while z > 0
        {
            os.put_ascii("0")
            set z: z - 1
        }
        var j2 0
        while j2 < k
        {
            os.put((*((digits as pointer[u8]) + j2)) as u32)
            set j2: j2 + 1
        }
    }

    ; --- equality ----------------------------------------------------------
    ; ELObj::equal — pointer identity, then structural isEqual.
    function equal(a: pointer[ELObj], b: pointer[ELObj]) returns bool
    {
        if a = b
            return true

        ELObj.is_equal(a, b)
    }

    ; ELObj::eqv — pointer identity, then isEquiv (default: isEqual; Pair
    ; recurses with eqv, Vec is never equivalent).
    function eqv(a: pointer[ELObj], b: pointer[ELObj]) returns bool
    {
        if a = b
            return true

        choose *a
            when pr: Pair
            {
                choose *b
                    when pb: Pair
                    {
                        if ELObj.eqv(pr.car, pb.car)
                            return ELObj.eqv(pr.cdr, pb.cdr)
                        return false
                    }
                    else
                        return false
                return false
            }
            when v: Vec
                return false
            else
                return ELObj.is_equal(a, b)
        false
    }

    function is_equal(a: pointer[ELObj], b: pointer[ELObj]) returns bool
    {
        a.normalize_string()
        b.normalize_string()
        choose *a
            when k: Keyword
            {
                choose *b
                    when kb: Keyword
                        return k.ident = kb.ident
                    else
                        return false
                return false
            }
            when pr: Pair
            {
                ; the reference's recursive FIXME, ported as-is
                choose *b
                    when pb: Pair
                    {
                        if ELObj.equal(pr.car, pb.car)
                            return ELObj.equal(pr.cdr, pb.cdr)
                        return false
                    }
                    else
                        return false
                return false
            }
            when v: Vec
            {
                choose *b
                    when vb: Vec
                    {
                        if v.n <> vb.n
                            return false
                        var i: size_t 0
                        while i < v.n
                        {
                            if ELObj.equal(*(v.elems + i), *(vb.elems + i)) = false
                                return false
                            set i: i + 1
                        }
                        return true
                    }
                    else
                        return false
                return false
            }
            when c: Chr
            {
                choose *b
                    when cb: Chr
                        return c.ch = cb.ch
                    else
                        return false
                return false
            }
            when s: Str
            {
                ; accepts anything with stringData (char or string)
                if b.has_string_data() = false
                    return false
                choose *b
                    when sb: Str
                        return s.str.equals(sb.str)
                    when cb: Chr
                    {
                        if s.str.get_size() <> (1 as size_t)
                            return false
                        return s.str.get(0 as size_t) = cb.ch
                    }
                    else
                        return false
                return false
            }
            when i: Int
            {
                choose *b
                    when ib: Int
                        return i.n = ib.n
                    else
                        return false
                return false
            }
            when r: Real
            {
                ; RealObj: other.inexactRealValue == n_
                if b.is_inexact_real() = false
                    return false
                return b.real_value() = r.n
            }
            when l: Length
            {
                let qv b.quantity_value()
                if qv.qtype = QT_LONG
                {
                    if qv.dim = 1
                        return qv.lval = l.n
                    return false
                }
                if qv.qtype = QT_DOUBLE
                {
                    if qv.dim = 1
                        return qv.dval = (l.n as double)
                    return false
                }
                return false
            }
            when q: Quantity
            {
                let qv b.quantity_value()
                if qv.qtype = QT_LONG
                {
                    if qv.dim = q.dim
                        return (qv.lval as double) = q.val
                    return false
                }
                if qv.qtype = QT_DOUBLE
                {
                    if qv.dim = q.dim
                        return qv.dval = q.val
                    return false
                }
                return false
            }
            when g: GlyphId
            {
                ; GlyphIdObj::isEqual — same public id and suffix
                choose *b
                    when gb: GlyphId
                    {
                        if g.suffix <> gb.suffix
                            return false
                        return g.pubid.equals(gb.pubid)
                    }
                    else
                        return false
                return false
            }
            else
                return false
        false
    }

    ; --- self-test ---------------------------------------------------------
    function test() returns int
    {
        ; bootstrap the run region (the established test idiom)
        let anchor StringC("x")
        let host Page.get(anchor.data_ptr() as pointer[void])

        ; singletons print
        let nil ELObj.make_nil(host)
        var os OutputCharStream.make(host)
        nil.print(os, 72000)
        if os.is_ascii("()") = false
            return -1

        let t ELObj.make_true(host)
        set os: OutputCharStream.make(host)
        t.print(os, 72000)
        if os.is_ascii("#t") = false
            return -2

        let f ELObj.make_false(host)
        set os: OutputCharStream.make(host)
        f.print(os, 72000)
        if os.is_ascii("#f") = false
            return -3

        if f.is_true()
            return -4

        if t.is_true() = false
            return -5

        let unspec ELObj.make_unspecified(host)
        set os: OutputCharStream.make(host)
        unspec.print(os, 72000)
        if os.is_ascii("#v") = false
            return -6

        ; integers
        let i42 ELObj.make_integer(host, 42)
        set os: OutputCharStream.make(host)
        i42.print(os, 72000)
        if os.is_ascii("42") = false
            return -7

        let neg ELObj.make_integer(host, 0 - 7)
        set os: OutputCharStream.make(host)
        neg.print(os, 72000)
        if os.is_ascii("-7") = false
            return -8

        set os: OutputCharStream.make(host)
        let i255 ELObj.make_integer(host, 255)
        i255.print_radix(os, 16 as u32, 72000)
        if os.is_ascii("ff") = false
            return -9

        ; char
        let ca ELObj.make_char(host, 0x41 as u32)
        set os: OutputCharStream.make(host)
        ca.print(os, 72000)
        if os.is_ascii("#\\A") = false
            return -10

        if ca.char_value() <> 0x41
            return -11

        if i42.char_value() <> (0 - 1)
            return -12

        ; string with escapes: a"b prints as "a\"b"
        var sbuf u32[3]
        set *(sbuf as pointer[u32]): (0x61 as u32)
        set *((sbuf as pointer[u32]) + (1 as size_t)): (0x22 as u32)
        set *((sbuf as pointer[u32]) + (2 as size_t)): (0x62 as u32)
        let sc StringC(sbuf as pointer[u32], 3 as size_t)
        let str ELObj.make_string(host, sc)
        set os: OutputCharStream.make(host)
        str.print(os, 72000)
        if os.is_ascii("\"a\\\"b\"") = false
            return -13

        ; symbol + keyword
        let sym ELObj.make_symbol(host, StringC("foo"))
        set os: OutputCharStream.make(host)
        sym.print(os, 72000)
        if os.is_ascii("foo") = false
            return -14

        let ident Identifier.make(host, StringC("use"))
        let kw ELObj.make_keyword(host, ident)
        set os: OutputCharStream.make(host)
        kw.print(os, 72000)
        if os.is_ascii("use:") = false
            return -15

        ; pairs: (1 2), (1 . 2), improper tail
        let one ELObj.make_integer(host, 1)
        let two ELObj.make_integer(host, 2)
        let l2 ELObj.make_pair(host, two, nil)
        let l12 ELObj.make_pair(host, one, l2)
        set os: OutputCharStream.make(host)
        l12.print(os, 72000)
        if os.is_ascii("(1 2)") = false
            return -16

        let dotted ELObj.make_pair(host, one, two)
        set os: OutputCharStream.make(host)
        dotted.print(os, 72000)
        if os.is_ascii("(1 . 2)") = false
            return -17

        if l12.is_list() = false
            return -18

        if dotted.is_list()
            return -19

        if nil.is_list() = false
            return -20

        ; car/cdr + set_car (eq-stable arm rebuild)
        if l12.get_car() <> one
            return -21

        if l12.get_cdr() <> l2
            return -22

        let l12b l12
        l12.set_car(two)
        if l12 <> l12b
            return -23

        if l12.get_car() <> two
            return -24

        l12.set_car(one)

        ; vector print + cycle guard
        let vec ELObj.make_vector(host, 2 as size_t, nil)
        set os: OutputCharStream.make(host)
        vec.print(os, 72000)
        if os.is_ascii("#(() ())") = false
            return -25

        ; equal? / eqv?
        ; the tail shares the ONE nil — the reference relies on singleton
        ; identity (NilObj has no isEqual; Interpreter.makeNil is unique)
        let l12c ELObj.make_pair(host, one, ELObj.make_pair(host, two, nil))
        if ELObj.equal(l12, l12c) = false
            return -26

        if ELObj.equal(l12, dotted)
            return -27

        if ELObj.eqv(l12, l12) = false
            return -28

        ; reference semantics: PairObj.isEquiv recurses, so structurally
        ; equal pairs of eqv leaves ARE eqv
        if ELObj.eqv(l12, l12c) = false
            return -29

        ; strings: equal? by content, and the char/string asymmetry
        let strb ELObj.make_string(host, sc)
        if ELObj.equal(str, strb) = false
            return -30

        var abuf u32[1]
        set *(abuf as pointer[u32]): (0x41 as u32)
        let sa ELObj.make_string(host, StringC(abuf as pointer[u32], 1 as size_t))
        if ELObj.equal(sa, ca) = false
            return -31

        if ELObj.equal(ca, sa)
            return -32

        ; numbers: 2 = 2.0 across is_equal? IntegerObj.isEqual demands Int
        let r2 ELObj.make_real(host, 2.0)
        if ELObj.equal(two, r2)
            return -33

        ; RealObj.isEqual: inexactRealValue of b — integer b has none
        if ELObj.equal(r2, two)
            return -34

        ; reals print (%g)
        set os: OutputCharStream.make(host)
        let r25 ELObj.make_real(host, 2.5)
        r25.print(os, 72000)
        if os.is_ascii("2.5") = false
            return -35

        set os: OutputCharStream.make(host)
        let r3 ELObj.make_real(host, 3.0)
        r3.print(os, 72000)
        if os.is_ascii("3") = false
            return -36

        set os: OutputCharStream.make(host)
        let rml ELObj.make_real(host, 0.001)
        rml.print(os, 72000)
        if os.is_ascii("0.001") = false
            return -37

        set os: OutputCharStream.make(host)
        let rbig ELObj.make_real(host, 10000000000.0)
        rbig.print(os, 72000)
        if os.is_ascii("1e+10") = false
            return -38

        set os: OutputCharStream.make(host)
        let rn ELObj.make_real(host, 0.0 - 123456789.0)
        rn.print(os, 72000)
        if os.is_ascii("-1.23457e+08") = false
            return -39

        ; lengths and quantities: 144000 units at 72000/inch = 144pt
        let len ELObj.make_length(host, 144000)
        set os: OutputCharStream.make(host)
        len.print(os, 72000)
        if os.is_ascii("144pt") = false
            return -40

        let q ELObj.make_quantity(host, 2.0, 2)
        set os: OutputCharStream.make(host)
        q.print(os, 72000)
        if os.is_ascii("2e-06pt2") = false
            return -41

        ; length equality via quantityValue
        let len2 ELObj.make_length(host, 144000)
        let qvd len.quantity_value()
        if qvd.qtype <> QT_LONG
            return -60
        if qvd.lval <> 144000
            return -62
        if qvd.dim <> 1
            return -61
        if ELObj.equal(len, len2) = false
            return -42

        if ELObj.equal(len, two)
            return -43

        ; convertToString
        let cs sym.convert_to_string(host)
        if cs = null
            return -44

        set os: OutputCharStream.make(host)
        cs.print(os, 72000)
        if os.is_ascii("\"foo\"") = false
            return -45

        let cs2 str.convert_to_string(host)
        if cs2 <> str
            return -46

        if sym.has_string_data()
            return -47

        0
    }
}
