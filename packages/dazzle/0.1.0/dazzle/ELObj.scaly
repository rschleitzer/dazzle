    ; --- node lists (Grove Inc 4) ------------------------------------------
    function make_node_list(host: pointer[Page], nodes: pointer[Array[pointer[GroveNode]]], start: int) returns pointer[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.NodeList(NodeListObj(nodes, start, null, NNL_NONE))
        p
    }

    ; a node-list over an existing (members, prefix) pair — node-list-rest and
    ; friends carry the prefix along when they bump `start`.
    function make_node_list_prefix(host: pointer[Page], nodes: pointer[Array[pointer[GroveNode]]], start: int, prefix: pointer[Array[int]]) returns pointer[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.NodeList(NodeListObj(nodes, start, prefix, NNL_NONE))
        p
    }

    ; a NAMED node-list (NamedNodeList): the same buffer plus which substitution
    ; table `named-node` / `named-node-list-normalize` fold the query through.
    function make_named_node_list(host: pointer[Page], nodes: pointer[Array[pointer[GroveNode]]], named: int) returns pointer[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.NodeList(NodeListObj(nodes, 0, null, named))
        p
    }

    ; NNL_NONE unless this list is a named one (named-node-list?)
    function node_list_named(this: pointer[ELObj]) returns int
    {
        choose *this
            when nl: NodeList
                return nl.named
            else
                return NNL_NONE
        NNL_NONE
    }

    ; a CHARACTER-EXPANDED node-list over chunk-level members: builds the prefix
    ; index (one int per member plus the total sentinel) instead of one pointer
    ; per character. Members whose span is 1 make this identical in meaning to
    ; the plain form, so producers may pass any mix.
    function make_node_list_expanded(host: pointer[Page], members: pointer[Array[pointer[GroveNode]]], start: int) returns pointer[ELObj]
    {
        let m members.get_length() as int
        let prefix Array[int]^host()
        var total 0
        var k 0
        while k < m
        {
            prefix.add(total)
            let node *(members.get_buffer() + k)
            set total: total + GroveNode.member_span(node)
            set k: k + 1
        }
        prefix.add(total)
        ELObj.make_node_list_prefix(host, members, start, prefix)
    }

    ; a singleton node-list over one node
    function make_node_singleton(host: pointer[Page], node: pointer[GroveNode]) returns pointer[ELObj]
    {
        let arr Array[pointer[GroveNode]]^host()
        arr.add(node)
        ELObj.make_node_list(host, arr, 0)
    }

    function is_node_list_p(this: pointer[ELObj]) returns bool
    {
        choose *this
            when nl: NodeList
                return true
            else
                return false
        false
    }

    ; count of nodes from `start` to the end of the buffer — for an expanded
    ; list, of CHARACTER positions (the prefix sentinel holds the total).
    function node_list_count(this: pointer[ELObj]) returns int
    {
        choose *this
            when nl: NodeList
            {
                if nl.nodes = null
                    return 0
                let m nl.nodes.get_length() as int
                if nl.prefix = null
                    return m - nl.start
                return *(nl.prefix.get_buffer() + m) - nl.start
            }
            else
                return 0
        0
    }

    function node_list_start(this: pointer[ELObj]) returns int
    {
        choose *this
            when nl: NodeList
                return nl.start
            else
                return 0
        0
    }

    ; the i-th node from `start` (null if out of range). On an expanded list the
    ; position is resolved through the prefix index and the char view is
    ; materialized only here — a caller that merely counts, or that walks
    ; members (node_list_member*), never touches a per-character node.
    function node_list_node(this: pointer[ELObj], i: int) returns pointer[GroveNode]
    {
        choose *this
            when nl: NodeList
            {
                if nl.nodes = null
                    return null
                let m nl.nodes.get_length() as int
                let idx nl.start + i
                if idx < 0
                    return null
                if nl.prefix = null
                {
                    if idx >= m
                        return null
                    return *(nl.nodes.get_buffer() + idx)
                }
                let pb nl.prefix.get_buffer()
                if idx >= *(pb + m)
                    return null
                let k ELObj.locate_member(pb, m, idx)
                let node *(nl.nodes.get_buffer() + k)
                if GroveNode.member_span(node) = 1
                    return node
                return GroveNode.char_view(node, idx - *(pb + k))
            }
            else
                return null
        null
    }

    ; the member of an expanded buffer covering flat position `p`: the largest k
    ; in [0, m) with prefix[k] <= p. Zero-span members (empty data chunks) are
    ; skipped by taking the LARGEST such k. Caller guarantees 0 <= p < total.
    function locate_member(pb: pointer[int], m: int, p: int) returns int
    {
        var lo 0
        var hi m - 1
        while lo < hi
        {
            let mid (lo + hi + 1) / 2
            if *(pb + mid) <= p
                set lo: mid
            else
                set hi: mid - 1
        }
        lo
    }

    function node_list_buffer(this: pointer[ELObj]) returns pointer[Array[pointer[GroveNode]]]
    {
        choose *this
            when nl: NodeList
                return nl.nodes
            else
                return null
        null
    }

    function node_list_prefix(this: pointer[ELObj]) returns pointer[Array[int]]
    {
        choose *this
            when nl: NodeList
                return nl.prefix
            else
                return null
        null
    }

    ; --- member-level walk (the reference's nodeListChunkRest) --------------
    ; A consumer that does not care about per-character identity iterates
    ; MEMBERS: whole data runs in one step, no view materialized. Positions are
    ; still flat, so `start` may sit INSIDE the first member — node_list_member_
    ; skip reports how many of its characters are already consumed.

    ; number of members from the one holding `start` to the end of the buffer.
    function node_list_member_count(this: pointer[ELObj]) returns int
    {
        choose *this
            when nl: NodeList
            {
                if nl.nodes = null
                    return 0
                let m nl.nodes.get_length() as int
                if nl.prefix = null
                {
                    if nl.start >= m
                        return 0
                    return m - nl.start
                }
                let pb nl.prefix.get_buffer()
                if nl.start >= *(pb + m)
                    return 0
                return m - ELObj.locate_member(pb, m, nl.start)
            }
            else
                return 0
        0
    }

    ; the k-th member from the one holding `start` (null out of range).
    function node_list_member(this: pointer[ELObj], k: int) returns pointer[GroveNode]
    {
        choose *this
            when nl: NodeList
            {
                if nl.nodes = null
                    return null
                let m nl.nodes.get_length() as int
                var base nl.start
                if nl.prefix <> null
                {
                    let pb nl.prefix.get_buffer()
                    if nl.start >= *(pb + m)
                        return null
                    set base: ELObj.locate_member(pb, m, nl.start)
                }
                let idx base + k
                if (idx < 0) or (idx >= m)
                    return null
                return *(nl.nodes.get_buffer() + idx)
            }
            else
                return null
        null
    }

    ; characters of member 0 already consumed by `start` (always 0 for a plain
    ; list, where a member IS one node).
    function node_list_member_skip(this: pointer[ELObj]) returns int
    {
        choose *this
            when nl: NodeList
            {
                if nl.nodes = null
                    return 0
                if nl.prefix = null
                    return 0
                let m nl.nodes.get_length() as int
                let pb nl.prefix.get_buffer()
                if nl.start >= *(pb + m)
                    return 0
                let k ELObj.locate_member(pb, m, nl.start)
                return nl.start - *(pb + k)
            }
            else
                return 0
        0
    }

    ; --- sosofos (Inc 4 value model + Inc 5 process kinds) ------------------
    ; an append sosofo (AppendSosofoObj): the ordered concatenation of `parts`.
    function make_sosofo(host: pointer[Page], parts: pointer[Array[pointer[ELObj]]]) returns pointer[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(SOSO_APPEND, parts, null))
        p
    }

    ; the empty sosofo = an append of zero parts (EmptySosofoObj).
    function make_empty_sosofo(host: pointer[Page]) returns pointer[ELObj]
    {
        let parts Array[pointer[ELObj]]^host()
        ELObj.make_sosofo(host, parts)
    }

    ; LiteralSosofoObj — emits the characters of `str_obj` (a StringObj), held in aux.
    function make_literal_sosofo(host: pointer[Page], str_obj: pointer[ELObj]) returns pointer[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(SOSO_LITERAL, null, str_obj))
        p
    }

    ; ProcessChildren[Trim]SosofoObj — processes the current node's children in
    ; `mode` (the reference captures context.processingMode; with-mode changes
    ; it). SosofoObj is locked at kind + two pointers, so the mode rides in the
    ; otherwise-unused `parts` slot as an opaque pointer — only ProcessContext
    ; casts it back; null = the processing mode at process time (pre-with-mode
    ; behavior).
    function make_process_children_sosofo(host: pointer[Page], trim: bool, mode: pointer[void]) returns pointer[ELObj]
    {
        var k SOSO_PROCESS_CHILDREN
        if trim
            set k: SOSO_PROCESS_CHILDREN_TRIM
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(k, mode as pointer[Array[pointer[ELObj]]], null))
        p
    }

    ; ProcessNodeListSosofoObj — processes every node of the node-list held in
    ; aux (captured mode in the parts slot, see above).
    function make_process_node_list_sosofo(host: pointer[Page], node_list: pointer[ELObj], mode: pointer[void]) returns pointer[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(SOSO_PROCESS_NODE_LIST, mode as pointer[Array[pointer[ELObj]]], node_list))
        p
    }

    ; ProcessNodeSosofoObj — processes one node (wrapped as a node-singleton in
    ; aux; captured mode in the parts slot, see above).
    function make_process_node_sosofo(host: pointer[Page], node: pointer[GroveNode], mode: pointer[void]) returns pointer[ELObj]
    {
        let nl ELObj.make_node_singleton(host, node)
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(SOSO_PROCESS_NODE, mode as pointer[Array[pointer[ELObj]]], nl))
        p
    }

    ; NextMatchSosofoObj — re-enters findMatch at the next lower-specificity rule.
    function make_next_match_sosofo(host: pointer[Page]) returns pointer[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
