; the MATH family (installFlowObjs' `// math` block, FlowObj.cxx:1708-2115).
; All twelve are CompoundFlowObjs. Six of them have non-principal PORTS and
; therefore a SerialFOTBuilder decomposition: `fraction` (numerator/
; denominator), `script` (six), `mark` (over/under), `fence` (open/close),
; `radical` (degree) and `math-operator` (operator/lower-limit/upper-limit).
; ★`fraction` is the only one that pushes its ports with connectable-level 0 —
; it has NO principal port, so its own content is discarded; the other five
; pass 1 and keep theirs. Only three carry characteristics: `radical`
; (a sosofo), `grid` and `grid-cell` (two positive integers each). The styled
; range's upper bound is FOC_GRID_CELL until the layout-composite block below.
define FOC_MATH_SEQUENCE: int 37
define FOC_FRACTION: int 38
define FOC_UNMATH: int 39
define FOC_SUPERSCRIPT: int 40
define FOC_SUBSCRIPT: int 41
define FOC_SCRIPT: int 42
define FOC_MARK: int 43
define FOC_FENCE: int 44
define FOC_RADICAL: int 45
define FOC_MATH_OPERATOR: int 46
