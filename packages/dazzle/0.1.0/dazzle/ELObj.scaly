; the ONLINE family (installFlowObjs' `// online` block, next to link and
; scroll): MarginaliaFlowObj is a bare compound bracket; MultiModeFlowObj is
; the only class in the whole port whose PORTS are decided at run time — its
; `multi-modes:` characteristic names them (FlowObj.cxx:952-1060). The styled
; range's upper bound is FOC_MULTI_MODE until the page/column block below.
define FOC_MARGINALIA: int 54
define FOC_MULTI_MODE: int 55
; the PAGE/COLUMN MODEL (installFlowObjs, FlowObj.cxx:2996-2998, right after
; simple-page-sequence): PageSequenceFlowObj (style/PageSequence.cxx) and
; ColumnSetSequenceFlowObj (style/ColumnSetSequence.cxx). The last two classes
; of the reference's registry. Both are plain CompoundFlowObjs with NO ports —
; one start*/end* bracket around the content, decomposed by SerialFOTBuilder
; into the *Serial pair that only the fot backend overrides.
; ★`page-sequence` has NO hasNonInheritedC at all: every one of its six
; characteristics (`page-category` `force-last-page` `force-first-page`
; `first-page-type` `justify-spread?` `binding-edge`) is an INHERITED one, so
; they arrive through the ics buffer and any other keyword is unknown.
; `column-set-sequence` carries a bare DisplayNIC, exactly like
; `aligned-column`. The styled range's upper bound is
; FOC_COLUMN_SET_SEQUENCE from here on.
define FOC_PAGE_SEQUENCE: int 56
define FOC_COLUMN_SET_SEQUENCE: int 57
define FOC_UNKNOWN: int 58
; MacroFlowObj (style/MacroFlowObj.cxx) — the class a
; `declare-flow-object-macro` binds. Not a backend class at all: its `make`
; binds the declared characteristics (plus, with `#!contents`, the content
; sosofo) as frame variables and evaluates the declaration's BODY, whose
; sosofo is then processed inside a startSequence/endSequence bracket. It sits
; OUTSIDE the styled FOC_PARAGRAPH..FOC_COLUMN_SET_SEQUENCE range but is styled
; all the same (the reference runs StyleExpression::compile for every make), so
; every dispatch that tests that range names it explicitly.
define FOC_MACRO: int 59

; Identifier — a top-level name cell (ELObj.cs class Identifier : Named). Inc-1
; carried the bare name; Inc 3 adds the definition/lazy-eval machinery: a value
; or an uncompiled Expression that computeValue compiles-and-runs on demand,
; plus the syntactic-key tag. The inheritedC / flowObj slots are later
; increments and are not carried yet.
define Identifier
(
    name: StringC
    value: ref[ELObj]?
    expr: ref[Expression]?
    insn: ref[Insn]?
    def_part: u32
    def_loc: Location
    is_defined: bool
    evaluated_flag: bool
    being_computed: bool
    syn_key: int
    inherited_c: ref[InheritedC]?
    builtin: ref[Identifier]?
    ; Identifier::charNIC_ / inheritedCPart_ / inheritedCLoc_ — the char-NIC
    ; registration a `declare-char-characteristic+property` leaves behind. The
    ; reference REUSES the inherited-characteristic part/loc pair for it (and
    ; setCharNIC nulls inheritedC_ at the same time); this port keeps the
    ; inherited part/loc inside the InheritedC object, so the char NIC gets its
    ; own two slots. Equivalent: the only writer of either pair is a
    ; declaration, and each declaration's duplicate gate refuses the other's
    ; name before it can overwrite.
    char_nic: bool
    char_nic_part: u32
    char_nic_loc: Location
)
{
    function make(host: ref[Page], name: StringC) returns ref[Identifier]
    {
        let ident host.allocate(sizeof Identifier, alignof Identifier) as pointer[Identifier]
        set ident.name: StringC^host(name.data_ptr(), name.get_size())
        set ident.value: null
        set ident.expr: null
        set ident.insn: null
        set ident.def_part: 0
        set ident.def_loc: Location()
        set ident.is_defined: false
        set ident.evaluated_flag: false
        set ident.being_computed: false
        set ident.syn_key: SK_NOTKEY
        set ident.inherited_c: null
        set ident.builtin: null
        set ident.char_nic: false
        set ident.char_nic_part: 0
        set ident.char_nic_loc: Location()
        ident
    }

    function get_name(this: Identifier) returns StringC
        name

    ; the eagerly-set value (set_definition), without triggering lazy compute —
    ; parse_make reads a flow-object-class binding here at parse time.
    function get_value_raw(this: Identifier) returns ref[ELObj]?
        value

    function set_syntactic_key(this: ref[Identifier], key: int)
        set this.syn_key: key

    ; syntacticKey(out key) returns synKey != notKey; callers read syn_key().
    function syntactic_key(this: Identifier) returns int
        syn_key

    ; Identifier::inheritedC — the inherited-characteristic prototype this
    ; name denotes (null = not a characteristic).
    function get_inherited_c(this: Identifier) returns ref[InheritedC]?
        inherited_c

    function set_inherited_c(this: ref[Identifier], ic: ref[InheritedC]?)
        set this.inherited_c: ic

    ; Identifier::setCharNIC(part, loc) — what installExtensionCharNIC writes.
    ; ★It also CLEARS the inherited characteristic: after this the name is a
    ; non-inherited characteristic of `character` and nothing else, so a later
    ; declare-flow-object-class (which gates on inheritedCDefined) sees a free
    ; name while a later declare-characteristic (which gates on charNICDefined
    ; FIRST) does not.
    procedure set_char_nic(this: ref[Identifier], part: u32, loc: Location)
    {
        set this.char_nic: true
        set this.inherited_c: null
        set this.char_nic_part: part
        set this.char_nic_loc: loc
    }

    ; Identifier::charNICDefined(part, loc).
    function char_nic_defined(this: Identifier, part: ref[u32], loc: ref[Location]) returns bool
    {
        if char_nic = false
            return false
        set part: char_nic_part
        set loc: char_nic_loc
        true
    }

    function is_syntactic_key(this: Identifier) returns bool
        syn_key <> SK_NOTKEY

    function is_def(this: Identifier) returns bool
        is_defined

    function get_def_part(this: Identifier) returns u32
        def_part

    function get_def_loc(this: Identifier) returns Location
        def_loc

    function evaluated(this: Identifier) returns bool
        evaluated_flag

    ; Identifier::maybeSaveBuiltin (Interpreter.cxx:1742). The FIRST
    ; redefinition of a name whose current definition came from the builtins
    ; part (def_part = -1) snapshots that definition into a shadow Identifier.
    ; Its ONLY consumer is compute_builtin_value, i.e. the operator of a query
    ; form: `(there-exists? …)` must reach the BUILTIN node-list-some? even in
    ; a stylesheet that has redefined the name — while a direct call to that
    ; name reaches the redefinition. No recursion: the shadow is fresh, so its
    ; own def_part is 0 and its setter returns at the first guard.
    function maybe_save_builtin(this: ref[Identifier])
    {
        if this.def_part <> 0xFFFFFFFF
            return
        if this.builtin <> null
            return
        FrameMark.store(this as pointer[void])
        let host Page.get(this as pointer[void])
        let b Identifier.make(host, this.name)
        if this.value <> null
            b.set_definition(this.def_part, this.def_loc, this.value)
        else
            b.set_expression(this.expr, this.def_part, this.def_loc)
        set this.builtin: b
    }

    ; computeBuiltinValue(force). The reference flips a static preferBuiltin_
    ; around computeValue; with the shadow held on the Identifier the flag
    ; reduces to this one branch. A name never redefined has no shadow and
    ; answers with its own value.
    function compute_builtin_value(this: ref[Identifier], force: bool, interp: ref[Interpreter]) returns ref[ELObj]?
    {
        if this.builtin <> null
            return this.builtin.compute_value(force, interp)
        this.compute_value(force, interp)
    }

    ; setDefinition(part, loc, value): a ready value (primitive/flow-obj install).
    function set_definition(this: ref[Identifier], part: u32, loc: Location, value: ref[ELObj]?)
    {
        this.maybe_save_builtin()
        set this.def_part: part
        set this.def_loc: loc
        set this.value: value
        set this.is_defined: true
        set this.evaluated_flag: value <> null
    }

    ; setExpression(expr, part, loc): a top-level (define ...) — compiled
    ; lazily. Clears a ready value (reference setDefinition's `value_ = 0`) —
    ; a user define must displace an installed builtin's value.
    function set_expression(this: ref[Identifier], expr: ref[Expression]?, part: u32, loc: Location)
    {
        this.maybe_save_builtin()
        set this.def_part: part
        set this.def_loc: loc
        set this.expr: expr
        set this.value: null
        set this.is_defined: true
        set this.evaluated_flag: false
    }

    function get_expression(this: Identifier) returns ref[Expression]?
        expr

    ; computeValue(force): value if known; else compile the expression and, if
    ; forced or compile-time-evaluable, run it on a fresh VM. beingComputed
    ; guards a self-referential definition loop.
    function compute_value(this: ref[Identifier], force: bool, interp: ref[Interpreter]) returns ref[ELObj]?
    {
        if this.is_defined = false
            return null
        if this.value <> null
            return this.value
        if this.expr = null
            return null
        if this.being_computed
        {
            if force
            {
                ; identifierLoop (Interpreter.cxx:1795) — a definition whose
                ; value refers to itself. Reported only when FORCED: an
                ; unforced probe just leaves the value unknown.
                interp.set_next_location(this.def_loc)
                interp.message1(InterpreterMessages.identifierLoop(), this.name)
                set this.value: interp.make_error()
            }
            return this.value
        }
        set this.being_computed: true
        ; makePermanent semantics: the computed value (and its insn) is cached
        ; on the Identifier and read by every later eval — it must build on
        ; the run page, never on the eval scratch region a TopRefInsn forcing
        ; may be running under. Clear the region for the computation.
        let saved_region interp.get_eval_region()
        interp.set_eval_region(null)
        let host interp.get_host()
        if this.insn = null
        {
            let env Environment.make(host)
            set this.insn: Expression.optimize_compile(this.expr, interp, env, 0, null)
        }
        if force or this.expr.can_eval(false, interp)
        {
            let vm VM.make(host, interp)
            set this.value: vm.eval(this.insn, null, null)
        }
        interp.set_eval_region(saved_region)
        set this.being_computed: false
        this.value
    }
}

; --- arm records -----------------------------------------------------------
; The five data-less singletons. The Interpreter (Inc 3) allocates exactly
; one of each per run; eqv? on them is pointer identity for free.
define ErrorObj ()
define UnspecifiedObj ()
define NilObj ()
define TrueObj ()
define FalseObj ()

define SymbolObj (name: StringC, c_value: int)
{
    init(name: StringC)
    {
        set this.name: name
        set this.c_value: 0
    }
}

define KeywordObj (ident: ref[Identifier]?)
{
    init(ident: ref[Identifier])
        set this.ident: ident
}

define PairObj (car: ref[ELObj]?, cdr: ref[ELObj]?)
{
    init(car: ref[ELObj]?, cdr: ref[ELObj]?)
    {
        set this.car: car
        set this.cdr: cdr
    }
}

; C++ VectorObj is a raw ELObj** + size; ported as a page-hosted buffer.
; Scheme vectors are fixed-size after creation, element-settable.
define VectorObj (elems: pointer[pointer[ELObj]], n: size_t)
{
    init(elems: pointer[pointer[ELObj]], n: size_t)
    {
        set this.elems: elems
        set this.n: n
    }
}

define CharObj (ch: u32)
{
    init(ch: u32)
        set this.ch: ch
}

define StringObj (str: StringC)
{
    init(str: StringC)
        set this.str: str
}

; StrCatObj — a lazy string-concatenation node (rope). string-append over a
; large total builds one of these (parts = the argument objects: Str/Chr/
; nested StrCat) instead of materializing; the flat buffer is produced once
; on first consumption (string_data) and the node is overwritten in place
; with the Str arm (memoized — same union slot, no growth). This is an
; allocation-seam deviation of the same kind as the RBMM arena itself: the
; reference materializes every append and lets the GC reclaim the
; intermediates; without a GC the nested appends of the generator corpus
; retained O(depth × bytes) in the eval region. Value semantics identical
; (strings are immutable; string-append returns a fresh object either way).
define StrCatObj (parts: ref[Array[ref[ELObj]?]]?, size: size_t)
{
    init(parts: ref[Array[ref[ELObj]?]]?, size: size_t)
    {
        set this.parts: parts
        set this.size: size
    }
}

define IntegerObj (n: int)
{
    init(n: int)
        set this.n: n
}

define RealObj (n: double)
{
    init(n: double)
        set this.n: n
}

; A length in internal units (unitsPerInch per run, Interpreter state).
define LengthObj (n: int)
{
    init(n: int)
        set this.n: n
}

; A dimensioned inexact quantity (val * length^dim).
define QuantityObj (val: double, dim: int)
{
    init(val: double, dim: int)
    {
        set this.val: val
        set this.dim: dim
    }
}

; A length whose unit is not yet computed: val * 10^val_exp of `unit`
; (convertNumber's exact-mantissa path; resolveQuantities resolves it).
define UnresolvedLengthObj (val: int, val_exp: int, unit: ref[Unit])
{
    init(val: int, val_exp: int, unit: ref[Unit])
    {
        set this.val: val
        set this.val_exp: val_exp
        set this.unit: unit
    }
}

; An inexact quantity in a not-yet-computed unit: val * unit^unit_exp.
define UnresolvedQuantityObj (val: double, unit: ref[Unit], unit_exp: int)
{
    init(val: double, unit: ref[Unit], unit_exp: int)
    {
        set this.val: val
        set this.unit: unit
        set this.unit_exp: unit_exp
    }
}

; An AFII glyph identifier (FOTBuilder::GlyphId: public id + suffix). The
; C++ compares publicId by POINTER (storePublicId interns); content
; equality is the same relation over interned strings.
define GlyphIdObj (pubid: StringC, suffix: int)
{
    init(pubid: StringC, suffix: int)
    {
        set this.pubid: pubid
        set this.suffix: suffix
    }
}

; FOTBuilder::Address — the link destination value: a type tag, the node
; (the RESOLVED node for resolvedNode, the CURRENT node for the address
; forms that resolve later) and the reference's `StringC params[3]`.
; `node` is a ref[GroveNode]? — Clark's Address holds a typed NodePtr, and
; SaveFOTBuilder/NumberCache already spell such a slot out. The Style ADDR_* codes name the eight types; this module is
; declared BEFORE Style, so the tag arrives as a plain int.
define AddressRec (addr_type: int, node: ref[GroveNode]?, p0: StringC, p1: StringC, p2: StringC)
{
    function make(host: ref[Page], addr_type: int, node: ref[GroveNode]?) returns ref[AddressRec]
    {
        let r host.allocate(sizeof AddressRec, alignof AddressRec) as pointer[AddressRec]
        set r.addr_type: addr_type
        set r.node: node
        set r.p0: StringC()
        set r.p1: StringC()
        set r.p2: StringC()
        r
    }
}

; AddressObj — the ELObj wrapper. The reference holds the Address behind an
; `Owner<FOTBuilder::Address>` (ELObj.h:410), i.e. BY POINTER; this port does
; the same, because inlining five fields into the arm would widen the whole
; ELObj union from 24 to 64 payload bytes for every value in the engine.
define AddressObj (addr: ref[AddressRec])
{
    init(addr: ref[AddressRec])
    {
        set this.addr: addr
    }
}

; FOTBuilder::GlyphSubstTable — a glyph substitution table: the backend-dump
; unique id plus the flattened old/new GlyphId pair sequence (pairs[2i] ->
; pairs[2i+1]; each element a GlyphId-arm ELObj). Built by the
; glyph-subst-table primitive; referenced by GlyphSubstTableObj wrappers.
define GlyphSubstTableRec (unique_id: int, pairs: ref[Array[ref[ELObj]?]])
{
    function make(host: ref[Page], unique_id: int) returns ref[GlyphSubstTableRec]
    {
        let t host.allocate(sizeof GlyphSubstTableRec, alignof GlyphSubstTableRec) as pointer[GlyphSubstTableRec]
        set t.unique_id: unique_id
        set t.pairs: Array[ref[ELObj]?]^host()
        t
    }

    function get_unique_id(this: GlyphSubstTableRec) returns int
        unique_id

    function get_pairs(this: GlyphSubstTableRec) returns ref[Array[ref[ELObj]?]]
        pairs

    ; GlyphSubstTable::subst — the substitute for `gid` (gid itself when no
    ; pair matches; GlyphId equality = public id content + suffix).
    function subst(this: ref[GlyphSubstTableRec], gid: ref[ELObj]) returns ref[ELObj]
    {
        let n this.pairs.get_length()
        var i: size_t 0
        while i < n
        {
            let op this.pairs.get(i)
            if op <> null
            {
                let old *op
                if old.is_equal(gid)
                {
                    let np this.pairs.get(i + 1)
                    if np <> null
                        return *np as ref[ELObj]
                }
            }
            set i: i + 2
        }
        gid
    }
}

; GlyphSubstTableObj — wraps a GlyphSubstTableRec (the reference holds the
; table by ConstPtr; value() rewraps the same table in a fresh object).
define GlyphSubstTableObj (table: ref[GlyphSubstTableRec]?)
{
    init(table: ref[GlyphSubstTableRec]?)
        set this.table: table
}

; --- callable / mutable-cell arms (Inc 3: FunctionObj.cs) ------------------
; A mutable cell (set!/letrec/shared-capture boxing). read_only guards the
; letrec pre-init phase.
define BoxObj (value: ref[ELObj]?, read_only: bool)
{
    init(value: ref[ELObj]?)
    {
        set this.value: value
        set this.read_only: false
    }
}

; A user closure: compiled body + captured display (may be null). The display
; is a buffer of display_len+1 slots (C++ null-terminates for the Collector;
; we keep the terminator for shape fidelity though the arena needs no trace).
; ★`sig` is held BY POINTER, and that is a size decision about the whole
; value model rather than about closures. `ELObj` is a flat union, so every
; value costs its largest arm — and ClosureObj and PrimitiveObj were the
; largest at 56 bytes, both only because they embedded the 40-byte `Signature`
; by value. Measured 2026-08-06 (tests/dazzle/primprof): a styling run boxes
; 1 292 125 integers, each paying 64 bytes for 8 bytes of payload, while
; PrimitiveObj is allocated 226 times in the whole run and ClosureMk fires
; ~32 700 times. Two arms nobody allocates set the price of every value.
define ClosureObj (sig: ref[Signature], code: ref[Insn]?, display: pointer[pointer[ELObj]])
{
    init(sig: ref[Signature], code: ref[Insn]?, display: pointer[pointer[ELObj]])
    {
        set this.sig: sig
        set this.code: code
        set this.display: display
    }
}

; A built-in: signature + a prim_id selecting the Primitive.dispatch arm.
define PrimitiveObj (sig: ref[Signature], prim_id: int, ident: ref[Identifier]?)
{
    init(sig: ref[Signature], prim_id: int)
    {
        set this.sig: sig
        set this.prim_id: prim_id
        set this.ident: null
    }
}

; An escape-only continuation (call/cc). Zero corpus users; the variant
; exists for shape fidelity, call semantics land when something needs it.
define ContinuationObj (stack_size: int, control_stack_size: int, live: bool, read_only: bool)
{
    init()
    {
        set this.stack_size: 0
        set this.control_stack_size: 0
        set this.live: true
        set this.read_only: false
    }
}

; apply and call-with-current-continuation are FunctionObj subclasses with
; custom call/tailCall (not PrimitiveObj); dataless arms here.
define ApplyFnObj ()
define CallCCFnObj ()

; A DSSSL node-list (Grove Inc 4): an ordered view over a node buffer from
; `start`. A single node is a length-1 node-list; the empty node-list has
; start == the buffer length. node-list-rest bumps `start` (cheap views).
;
; LAZY CHARACTER EXPANSION. The child/descendant/sibling axes hand out one node
; PER CHARACTER of a data run (Grove's chunk/view split), which as a flat array
; costs a pointer per character — the reference pays nothing because
; NodeListObj::nodeListChunkRest iterates LAZILY and skips a whole chunk in one
; step. `prefix` is that protocol in random-access form: when it is non-null the
; buffer holds CHUNK-LEVEL members and prefix[k] is the flat position of member
; k's first character (prefix has one extra sentinel entry, the total). Then
; `start` and the index of node_list_node are flat CHARACTER positions, resolved
; by binary search, and a char view is materialized only when a caller actually
; asks for that position. prefix == null keeps the plain one-node-per-slot
; representation every other producer builds.
;
; ★★★INLINE SINGLETON. `single` holds the node of a ONE-node list directly,
; with `nodes` null — the reference's NodePtrNodeListObj (style/ELObj.h:441),
; which keeps its `NodePtr node_` inline and allocates exactly one collector
; object. Ours used to build an `Array` plus its buffer plus the ELObj: THREE
; region allocations for one node, on the hottest path the engine has.
; Measured 2026-08-06 with tests/dazzle/primprof, styling run: `current-node`
; (708 313 calls) is nothing but a getter plus that construction and cost
; 88.6 ns against the reference's 4.8 ns — 18x, where `+` (one allocation) is
; only 2.5x. The whole node-list family carried the same factor
; (`node-list-first` 26x, `gi` 15x).
;
; The invariant is narrow on purpose: `single <> null` implies `nodes`,
; `prefix` and `gen` are all null, so every accessor answers it with one
; branch and node-list-rest just carries the field along (`start` past 0 makes
; it empty, exactly as `start` past the buffer length does). A producer that
; needs any of the other three keeps building a buffer.
;
; NAMED node lists (NamedNodeList / BaseNamedNodeList) are the same buffer with
; a name-lookup protocol on top, so they ride in this record as `named` rather
; than in an arm of their own — every one of the ten node-list `choose` sites
; would otherwise need a second arm, and a MISSED arm returns 0 in silence.
; The value is NamedNodeList::Type (grove/Node.h:421), which decides BOTH things
; the reference's subclasses vary: the SUBSTITUTION TABLE the lookup normalizes
; through (entitySubstTable for the entity lists, generalSubstTable for every
; other) and WHICH PROPERTY of a member serves as its name — NamedNodeList::
; nodeName dispatches on (list type, node class): an element in an `elements`
; list answers with its ID, an element-type with its GI, everything else with
; its `name` (grove/Node.cxx:691 NodeNameNodeVisitor).
; A DERIVED list (node-list-rest and friends) is a plain node-list in the
; reference too — NamedNodeList is not a NodeList subclass, its `nodeList()`
; hands out an ordinary one — so every deriving constructor leaves this 0.
define NNL_NONE: int 0
define NNL_ELEMENTS: int 1
define NNL_ATTRIBUTES: int 2
define NNL_ENTITIES: int 3
define NNL_NOTATIONS: int 4
define NNL_DOCTYPES_AND_LINKTYPES: int 5
define NNL_ELEMENT_TYPES: int 6
define NNL_ATTRIBUTE_DEFS: int 7
; ★one value BEYOND the reference's enum: the sgml-document class's `entities`
; list is a DocEntitiesNamedNodeList, whose namedNode falls back to the grove's
; defaulted-entity table for a name its own members do not hold. The reference
; distinguishes that by SUBCLASS while carrying type `entities`; here the extra
; value carries it (it behaves as NNL_ENTITIES everywhere else).
define NNL_DOC_ENTITIES: int 8

; LAZY FILTERING (SelectElementsNodeListObj, style/primitive.cxx:5602). The
; reference does not materialize a filtered node-list at all: select-elements
; returns a view that runs the pattern in nodeListFirst / nodeListRest, so a
; caller asking only whether anything matches walks to the FIRST match and
; stops. Ported here as an incremental generator behind the same buffer: `out`
; IS the node-list's `nodes` array, `cursor` the next member of `src` still to
; test, and every accessor extends the buffer just far enough for what it was
; asked (ELObj.force_select). Measured on the DocBook print stylesheets: the
; same 3732 calls step over 0.56 M source members instead of 1.70 M and run
; 1952 pattern matches instead of 3037 — 2.0 % of the styling run's
; instructions, and O(first match) instead of O(n) for the callers that only
; ask whether anything matched.
; `host` is the page the node-list itself lives on, so the deferred matches
; land in exactly the region the eager version used; `src` is a value the
; primitive received, hence never in a region younger than that page.
; The lazy node-list views, all driven through ELObj.force_gen.
; GEN_SELECT: `select-elements` — SelectElementsNodeListObj, `pat` filters `src`.
; GEN_CONCAT: `(node-list a b …)` — the reference's PairNodeListObj (ELObj.cxx
;   :1201), which is a two-pointer cell and copies NOTHING. `src`/`src2` are the
;   two operands; `pat` is unused.
;
; The four AXIS views below are the same mechanism over the four axes that used
; to materialize a full array at construction time. The reference has a lazy
; object for each (style/primitive.cxx): DescendantsNodeListObj for
; `descendants`, SiblingNodeListObj for `preced`/`follow`, and the child axis
; comes straight off the node. `node-list-first` or `node-list-empty?` on one of
; them cost O(1) here instead of O(width of the sibling group), which is what
; the nsweep complexity screen measured as a port defect
; (tests/dazzle/nsweep/README.md: four rows at x3.9 per doubling against the
; reference's x2).
;
; ★All four map over the MEMBERS of their source node-list exactly as the eager
; versions did (the reference wraps itself in a MapNodeListObj for a
; non-singleton argument), so `cursor` is the position in `src` and the
; per-source-node walk state sits in `cur`/`walk`/`sub`/`sub2`/`stop`/`path`.
; ★★A child axis this narrow is cheaper MATERIALIZED than viewed, and the
; number is measured rather than guessed: on the heaviest real-world codegen
; the four axes are asked 11 525 091 times and answer 21 797 328 members —
; 1.9 per call. At that size the generator record and the memo-hosted buffer
; cost more than the members, and the buffer is worse than that: the memo seam
; puts it on the RUN arena, so a view that dies immediately is never given
; back (measured with the frame mark on: +28 % peak). The bound is what keeps
; the asymptotics — anything wider stays lazy, so the complexity screen's rows
; are unaffected (they run 500 to 4000 siblings).
define AXIS_EAGER_MAX: int 8

define GEN_SELECT: int 0
define GEN_CONCAT: int 1
define GEN_CHILDREN: int 2
define GEN_DESCENDANTS: int 3
define GEN_PRECED: int 4
define GEN_FOLLOW: int 5

; A lazy node-list generator. Both kinds live in ONE record rather than in two
; ELObj union arms on purpose: the union's arm size is paid by EVERY ELObj
; allocation in the engine (see the note on SosofoObj), while this record is
; only allocated for a list that actually is a view.
define SelectGen
(
    kind: int
    src: ref[ELObj]
    src2: ref[ELObj]?
    pat: ref[Pattern]?
    interp: ref[Interpreter]
    host: ref[Page]
    out: ref[Array[ref[GroveNode]?]]
    cursor: int
    prefix: ref[Array[int]]?
    total: int
    cur: ref[GroveNode]?
    walk: ref[GroveNode]?
    sub: int
    sub2: int
    stop: int
    path: ref[Array[int]]?
    depth: int
)
{
    ; The record has NO `init` and every construction goes through `make`,
    ; which writes all eighteen fields by name — the shape MacroDef and
    ; GroveNode use. Why not an init: an init is selected by argument COUNT,
    ; and a construction that misses one compiles in silence with garbage in
    ; the field. The 8-field version of this record already paid that once —
    ; because `out` is a local bound to `Array[…]^host()`, the construction did
    ; not resolve to an init at all (the local carries the VALUE type, the
    ; parameter is a pointer), the planner emitted a positional TUPLE over the
    ; fields, and three of four sites got a random cursor and answered "no
    ; matches" (tests/dazzle/grove axis1; fixed 2026-08-02 in
    ; Planner.region_value_matches_pointer, and diagnosed loudly since).
    ;
    ; The walk state, per generator kind:
    ;   SELECT/CONCAT  cursor = the next member of `src` still to test
    ;   every AXIS     cursor = the next flat position of `src` to expand,
    ;                  `cur`  = the source node being expanded (null: fetch the
    ;                           next one), `prefix`/`total` the character-
    ;                           expansion index grown in lockstep with `out`
    ;   CHILDREN       sub    = the next child index of `cur`
    ;   DESCENDANTS    walk   = the last node emitted (null: not started),
    ;                  path/depth = the child index at each level of the walk
    ;   PRECED/FOLLOW  sub    = the next index in the sibling group,
    ;                  stop   = the group's end, walk = the member HOLDING the
    ;                  node, sub2 = the character cursor inside it
    function make(host: ref[Page], kind: int, src: ref[ELObj], src2: ref[ELObj]?, pat: ref[Pattern]?, interp: ref[Interpreter], out: ref[Array[ref[GroveNode]?]], prefix: ref[Array[int]]?, path: ref[Array[int]]?) returns ref[SelectGen]
    {
        let g host.allocate(sizeof SelectGen, alignof SelectGen) as pointer[SelectGen]
        set g.kind: kind
        set g.src: src
        set g.src2: src2
        set g.pat: pat
        set g.interp: interp
        set g.host: host
        set g.out: out
        set g.cursor: 0
        set g.prefix: prefix
        set g.total: 0
        set g.cur: null
        set g.walk: null
        set g.sub: 0
        set g.sub2: 0
        set g.stop: 0
        set g.path: path
        set g.depth: 0
        g
    }
}

; ★FIELD ORDER IS LOAD-BEARING: `start` and `named` are adjacent i32s so that
; LLVM packs them into ONE word. This arm is the largest in the ELObj union
; since the signatures moved behind a pointer, so its width is the width of
; every value in the engine — 4.69 M ELObj allocations per styling run
; (measured, tests/dazzle/primprof), each paying the maximum arm.
define NodeListObj (nodes: ref[Array[ref[GroveNode]?]]?, start: i32, named: i32, prefix: ref[Array[int]]?, gen: ref[SelectGen]?, single: ref[GroveNode]?)
{
    ; ONE init, `gen` and `single` always explicit: a second, shorter overload
    ; would be picked apart by argument COUNT, and a construction that misses
    ; the last argument compiles silently with garbage in the field (CLAUDE.md,
    ; "a call with too many/too few arguments compiles silently"). The IR arity
    ; audit in tests/dazzle/build-cli.sh is the net under that.
    init(nodes: ref[Array[ref[GroveNode]?]]?, start: i32, named: i32, prefix: ref[Array[int]]?, gen: ref[SelectGen]?, single: ref[GroveNode]?)
    {
        set this.nodes: nodes
        set this.start: start
        set this.named: named
        set this.prefix: prefix
        set this.gen: gen
        set this.single: single
    }
}

; A sosofo (Specification Of a Sequence Of Flow Objects). SosofoObj.cxx is a
; class hierarchy (Append/Literal/ProcessChildren/ProcessNodeList/…); Scaly
; union arms don't subclass, so the arm carries a `kind` discriminator plus two
; slots: `parts` (APPEND's child list) and `aux`, a single ELObj slot reused per
; kind — LITERAL→the string, PROCESS_NODE_LIST→the node-list, PROCESS_NODE→a
; node-singleton node-list. children/trim/next-match carry no data (they use the
; process-time current node + mode). Kept to two pointers so the ELObj union
; does not grow past its other arms (a larger union multiplies every ELObj
; allocation's footprint — it tipped the test region over a page boundary).
; The Style engine (Inc 5) builds these; ProcessContext.process_sosofo walks them.
define SOSO_APPEND: int 0
define SOSO_LITERAL: int 1
define SOSO_PROCESS_CHILDREN: int 2
define SOSO_PROCESS_CHILDREN_TRIM: int 3
define SOSO_PROCESS_NODE_LIST: int 4
define SOSO_PROCESS_NODE: int 5
define SOSO_NEXT_MATCH: int 6
; SOSO_FLOWOBJ — a transform flow object built by `make`. To keep SosofoObj at
; two pointers (below), the characteristics ride in `aux` (a FlowObjBox) and the
; content sosofos in `parts` (like APPEND; empty for atomic flow objects).
define SOSO_FLOWOBJ: int 7
; PageNumberSosofoObj / CurrentNodePageNumberSosofoObj (SosofoObj.h): emit a
; page-number reference through the FOTBuilder (fot: <page-number/>). The
; current-node variant carries its node as a singleton node-list in aux.
define SOSO_PAGE_NUMBER: int 8
define SOSO_CURRENT_NODE_PAGE_NUMBER: int 9
; PageTypeSosofoObj (if-first-page / if-front-page): parts = [match, noMatch],
; aux = an IntegerObj carrying the HF page-type flag (firstHF=1 / frontHF=2).
; Processes nothing when no page type is in effect (outside header/footer).
define SOSO_PAGE_TYPE: int 10
; LabelSosofoObj — wraps a flow object that has a label: (the ctl record with
; the symbol + location rides in the parts slot, see SosofoCtlRec).
define SOSO_LABEL: int 11
; ContentMapSosofoObj — wraps a flow object's content with a content-map:.
define SOSO_CONTENT_MAP: int 12
; DiscardLabeledSosofoObj — the sosofo-discard-labeled primitive: a
; connectable with one port carrying the label and a sink that keeps nothing,
; so whatever inside connects to that label is dropped. The symbol rides in
; the parts slot (a ctl record, like SOSO_LABEL), the content in aux.
define SOSO_DISCARD_LABELED: int 13

; MacroDef — MacroFlowObj::Definition (style/MacroFlowObj.h): the SHARED half
; of a flow-object macro, built once by declare-flow-object-macro and pointed
; at by every FlowObj the macro's `make`s produce. `nics` are the declared
; characteristic names in declaration order, `inits` their default-value
; expressions (null = no default, which evaluates to #f), `contents_id` the
; `#!contents` variable (null = an ATOMIC macro: content is rejected), `body`
; the sosofo expression. `code` is compiled LAZILY on the first process (the
; reference compiles in Definition::process when code_ is null) — the whole
; part must be read before the body's identifiers resolve.
;
; It lives here, next to FlowObj, rather than in Expression: Identifier
; already forward-references Expression/Insn from this module, and FlowObj
; must be able to name the record by pointer.
define MacroDef
(
    nics: ref[Array[ref[Identifier]?]]?
    inits: ref[Array[ref[Expression]?]]
    contents_id: ref[Identifier]?
    body: ref[Expression]?
    code: ref[Insn]?
)
{
    function make(host: ref[Page], nics: ref[Array[ref[Identifier]?]], inits: ref[Array[ref[Expression]?]], contents_id: ref[Identifier]?, body: ref[Expression]?) returns ref[MacroDef]
    {
        let d host.allocate(sizeof MacroDef, alignof MacroDef) as pointer[MacroDef]
        set d.nics: nics
        set d.inits: inits
        set d.contents_id: contents_id
        set d.body: body
        set d.code: null
        d
    }

    ; Definition::isCompound — contentsId_ != 0.
    function is_compound(this: MacroDef) returns bool
        contents_id <> null

    function n_nics(this: MacroDef) returns int
    {
        if nics = null
            return 0
        nics.get_length() as int
    }

    ; MacroFlowObj::hasNonInheritedC — a declared characteristic name, by
    ; Identifier POINTER identity (the interning table gives one cell per
    ; name); -1 = not one of ours.
    function nic_index(this: MacroDef, ident: ref[Identifier]?) returns int
    {
        if nics = null
            return 0 - 1
        let n nics.get_length()
        let b nics.get_buffer()
        var i: size_t 0
        while i < n
        {
            if *(b + i) = ident
                return i as int
            set i: i + 1
        }
        0 - 1
    }

    function get_code(this: MacroDef) returns ref[Insn]?
        code

    function set_code(this: ref[MacroDef], c: ref[Insn])
        set this.code: c

    function get_body(this: MacroDef) returns ref[Expression]?
        body

    function get_inits(this: MacroDef) returns ref[Array[ref[Expression]?]]
        inits

    function get_nics(this: MacroDef) returns ref[Array[ref[Identifier]?]]
        nics as ref[Array[Option[ref[Identifier]]]]

    function get_contents_id(this: MacroDef) returns ref[Identifier]?
        contents_id
}

; FlowObj — a transform flow object's evaluated characteristics (the NIC set of
; jade's TransformFOTBuilder flow-object classes). Only the slots a given foc
; reads are meaningful; the rest stay empty. Page-hosted, referenced by pointer
; (NEVER an ELObj union arm — its StringC set would balloon every ELObj). `atts`
; is a flat name/value StringC list matching output_attributes' pairwise walk.
define FlowObj
(
    foc: int
    gi: StringC
    atts: ref[Array[StringC]]?
    system_id: StringC
    public_id: StringC
    name: StringC
    data: StringC
    path: StringC
    style: ref[ELObj]?
    dnic: ref[DisplayNIC]?
    hf: ref[Array[ref[ELObj]?]]?
    tnic: pointer[void]
    nic_code: ref[Insn]?
    macro_def: ref[MacroDef]?
    charic_vals: ref[Array[ref[ELObj]?]]?
)
{
    ; the atomic flow object classes (no asCompoundFlowObj in the reference):
    ; content is rejected (atomicContent) and there is no default content.
    function is_atomic_class(foc: int) returns bool
    {
        if foc = FOC_EMPTY_ELEMENT
            return true
        if foc = FOC_ENTITY_REF
            return true
        if foc = FOC_PROCESSING_INSTRUCTION
            return true
        if foc = FOC_DOCUMENT_TYPE
            return true
        if foc = FOC_FORMATTING_INSTRUCTION
            return true
        if foc = FOC_PARAGRAPH_BREAK
            return true
        if foc = FOC_TABLE_COLUMN
            return true
        if foc = FOC_TABLE_BORDER
            return true
        if foc = FOC_RULE
            return true
        if foc = FOC_EXTERNAL_GRAPHIC
            return true
        ; CharacterFlowObj / AlignmentPointFlowObj derive from FlowObj, not
        ; CompoundFlowObj — content is `atomicContent`. `anchor` is NOT here:
        ; AnchorFlowObj IS a CompoundFlowObj (so content passes the check) and
        ; then throws the content away in processInner.
        if foc = FOC_CHARACTER
            return true
        if foc = FOC_ALIGNMENT_POINT
            return true
        false
    }

    function make(host: ref[Page], foc: int) returns ref[FlowObj]
    {
        let f host.allocate(sizeof FlowObj, alignof FlowObj) as pointer[FlowObj]
        set f.foc: foc
        set f.gi: StringC()
        set f.atts: null
        set f.system_id: StringC()
        set f.public_id: StringC()
        set f.name: StringC()
        set f.data: StringC()
        set f.path: StringC()
        set f.style: null
        set f.dnic: null
        set f.hf: null
        set f.tnic: null
        set f.nic_code: null
        set f.macro_def: null
        set f.charic_vals: null
        f
    }

    ; a macro flow object's seed (MacroFlowObj's constructor): the shared
    ; definition plus one null characteristic slot per declared NIC. A null
    ; slot is what TestNullInsn reads to fall back on the declared default.
    function make_macro(host: ref[Page], def: ref[MacroDef]) returns ref[FlowObj]
    {
        let f FlowObj.make(host, FOC_MACRO)
        set f.macro_def: def
        let vals Array[ref[ELObj]?]^host()
        let n def.n_nics()
        var i 0
        while i < n
        {
            vals.add(null)
            set i: i + 1
        }
        set f.charic_vals: vals
        f
    }

    function get_macro_def(this: FlowObj) returns ref[MacroDef]?
        macro_def

    function get_charic_vals(this: FlowObj) returns ref[Array[ref[ELObj]?]]?
        charic_vals

    ; MacroFlowObj::setNonInheritedC — store the value in the slot of the
    ; named characteristic. No conversion, no diagnostic: a macro NIC takes
    ; whatever the value expression produced.
    function set_charic(this: ref[FlowObj], ident: ref[Identifier]?, value: ref[ELObj]?)
    {
        if this.macro_def = null
            return
        if this.charic_vals = null
            return
        let idx this.macro_def.nic_index(ident)
        if idx < 0
            return
        this.charic_vals.put(idx as size_t, value)
    }

    ; MacroFlowObj's copy constructor: the definition is SHARED, the
    ; characteristic slots are copied element-wise (a per-make copy must not
    ; write through to the compile-time prototype).
    function macro_copy(this: ref[FlowObj], host: ref[Page]) returns ref[FlowObj]
    {
        let f FlowObj.make(host, FOC_MACRO)
        set f.macro_def: this.macro_def
        if this.charic_vals <> null
        {
            let vals Array[ref[ELObj]?]^host()
            let n this.charic_vals.get_length()
            let b this.charic_vals.get_buffer()
            var i: size_t 0
            while i < n
            {
                vals.add(*(b + i))
                set i: i + 1
            }
            set f.charic_vals: vals
        }
        f
    }

    ; the shallow half of FlowObj::copy — the NIC payloads (dnic/tnic/hf) stay
    ; NULL; the caller (ProcessContext.resolve_nics) deep-copies them per
    ; class (it can see the Style record types).
    function shallow_copy(this: ref[FlowObj], host: ref[Page]) returns ref[FlowObj]
    {
        let f FlowObj.make(host, this.foc)
        set f.gi: this.gi
        set f.atts: this.atts
        set f.system_id: this.system_id
        set f.public_id: this.public_id
        set f.name: this.name
        set f.data: this.data
        set f.path: this.path
        set f.style: this.style
        ; the macro halves travel with the copy — resolve_nics evaluates the
        ; lazy characteristic values against THIS copy (MacroFlowObj::copy
        ; shares the definition and copies the value slots).
        if this.macro_def <> null
        {
            let m this.macro_copy(host)
            set f.macro_def: m.get_macro_def()
            set f.charic_vals: m.get_charic_vals()
        }
        f
    }

    ; the lazy non-inherited-characteristics code (an Insn chain, opaque —
    ; SetNonInheritedCsSosofoObj's code_): evaluated per process against a
    ; fresh copy (ProcessContext.resolve_nics).
    function get_nic_code(this: FlowObj) returns ref[Insn]?
        nic_code
    function set_nic_code(this: ref[FlowObj], c: ref[Insn]?)
        set this.nic_code: c

    function get_foc(this: FlowObj) returns int
        foc
    function get_gi(this: FlowObj) returns StringC
        gi
    function get_atts(this: FlowObj) returns ref[Array[StringC]]?
        atts
    function get_system_id(this: FlowObj) returns StringC
        system_id
    function get_public_id(this: FlowObj) returns StringC
        public_id
    function get_name(this: FlowObj) returns StringC
        name
    function get_data(this: FlowObj) returns StringC
        data
    function get_path(this: FlowObj) returns StringC
        path

    ; setNonInheritedC seam: map a characteristic key name to the right slot.
    ; The value StringC is copied onto `host` (the run region) so it outlives the
    ; frame that built the make (the sosofo is walked later by ProcessContext).
    function set_char(this: ref[FlowObj], host: ref[Page], key: StringC, value: StringC)
    {
        let v StringC^host(value.data_ptr(), value.get_size())
        if key.equals(StringC("gi"))
            set this.gi: v
        else if key.equals(StringC("system-id"))
            set this.system_id: v
        else if key.equals(StringC("public-id"))
            set this.public_id: v
        else if key.equals(StringC("name"))
            set this.name: v
        else if key.equals(StringC("data"))
            set this.data: v
        else if key.equals(StringC("path"))
            set this.path: v
    }

    function set_atts(this: ref[FlowObj], atts: ref[Array[StringC]])
        set this.atts: atts

    ; the attached style (a Style-arm ELObj built by the make insn) and the
    ; display NIC record (Style.DisplayNIC, opaque here). Inc 8.
    function get_style(this: FlowObj) returns ref[ELObj]?
        style
    function set_style(this: ref[FlowObj], s: ref[ELObj])
        set this.style: s
    function get_dnic(this: FlowObj) returns ref[DisplayNIC]?
        dnic
    function set_dnic(this: ref[FlowObj], n: ref[DisplayNIC]?)
        set this.dnic: n

    ; the table-family NIC record (Style.TableNICRec / TableColumnNICRec /
    ; TableCellNICRec by foc; opaque here).
    function get_tnic(this: FlowObj) returns pointer[void]
        tnic
    function set_tnic(this: ref[FlowObj], n: pointer[void])
        set this.tnic: n

    ; simple-page-sequence header/footer parts (SimplePageSequenceFlowObj's
    ; hf_->part[6]): j = (sideHF | headerHF) >> 2 — left-footer 0, left-header
    ; 1, center-footer 2, center-header 3, right-footer 4, right-header 5.
    function set_hf(this: ref[FlowObj], host: ref[Page], part: int, sosofo: ref[ELObj]?)
    {
        if this.hf = null
        {
            let parts Array[ref[ELObj]?]^host()
            var i 0
            while i < 6
            {
                parts.add(null)
                set i: i + 1
            }
            set this.hf: parts
        }
        this.hf.put(part as size_t, sosofo)
    }

    function get_hf(this: FlowObj, part: int) returns ref[ELObj]?
    {
        if hf = null
            return null
        let pp hf.get(part as size_t)
        if pp = null
            return null
        *pp
    }
}

; SosofoObj MUST stay `kind` + exactly two pointers (parts, aux): a third field
; corrupts the run region (port history — the sosofo union was deliberately kept
; to two pointers). SOSO_FLOWOBJ reuses both: parts = content, aux = FlowObjBox.
define SosofoObj (kind: int, parts: ref[Array[ref[ELObj]?]]?, aux: ref[ELObj]?)
{
    init(kind: int, parts: ref[Array[ref[ELObj]?]]?, aux: ref[ELObj]?)
    {
        set this.kind: kind
        set this.parts: parts
        set this.aux: aux
    }
}

; SosofoCtlRec — the payload of a SOSO_LABEL / SOSO_CONTENT_MAP sosofo: the
; label symbol (or content-map value) plus the wrap location (badConnection /
; badContentMap anchor). SosofoObj is locked at two pointers, so the record
; rides in the otherwise-unused `parts` slot as an opaque pointer (the
; process-children mode-smuggling precedent); the content sosofo sits in aux.
define SosofoCtlRec (obj: ref[ELObj]?, loc: Location)
{
    function make(host: ref[Page], obj: ref[ELObj]?, loc: Location) returns ref[SosofoCtlRec]
    {
        let r host.allocate(sizeof SosofoCtlRec, alignof SosofoCtlRec) as pointer[SosofoCtlRec]
        set r.obj: obj
        set r.loc: loc
        r
    }

    function get_loc(this: ref[SosofoCtlRec]) returns Location
        this.loc
}

; FlowObjBox — a one-pointer ELObj arm carrying a FlowObj by reference. It backs
; both a flow-object-class binding (declare-flow-object-class sets an
; identifier's value to one) and a SOSO_FLOWOBJ's `aux` characteristics slot.
define FlowObjBox (fo: ref[FlowObj]?)
{
    init(fo: ref[FlowObj]?)
        set this.fo: fo
}

; LanguageObj — a define-language value. The tables themselves (case maps and
; the whole collation machinery) live in dazzle.LangObj; this arm is the
; ELObj-side handle, so the union stays one pointer wide.
define LanguageObj (lang: ref[LangObj])
{
    init(lang: ref[LangObj])
        set this.lang: lang
}

; StyleObj — a VarStyleObj (Style.h): an ordered spec vector plus the use:
; chain. Inc 8; the force-spec
; vector and MergeStyleObj arrive with the style language/DSSSL2 features.
; `merged` is non-null only for a MergeStyleObj (the merge-style primitive):
; a style with no specifications of its own that expands to its parts IN
; ORDER when the style stack walks it, so the FIRST part wins.
define StyleObjRec (spec: ref[VarStyleRec]?, use_chain: ref[ELObj]?, merged: ref[Array[ref[ELObj]?]]?)
{
    init(spec: ref[VarStyleRec]?, use_chain: ref[ELObj]?, merged: ref[Array[ref[ELObj]?]]?)
    {
        set this.spec: spec
        set this.use_chain: use_chain
        set this.merged: merged
    }
}

; --- length-spec / space / color arm records (Inc 8, Family-B front) --------
; The style-engine LengthSpec (ELObj.h): a 3-vector of doubles — v0 = length
; in units, v1 = display-size factor, v2 = table-unit factor. Arithmetic is
; component-wise (operator+=/-=/*=//=); conversion to a FOTBuilder LengthSpec
; rounds v0 and carries v1 (the TableLengthSpec variant also carries v2).
define EngLenSpec (v0: double, v1: double, v2: double)
{
    function make(host: ref[Page], v0: double, v1: double, v2: double) returns ref[EngLenSpec]
    {
        let p host.allocate(sizeof EngLenSpec, alignof EngLenSpec) as pointer[EngLenSpec]
        set p.v0: v0
        set p.v1: v1
        set p.v2: v2
        p
    }
}

; LengthSpecObj — wraps an engine length-spec (display-size / table-unit
; values and their arithmetic results).
define LengthSpecObj (ls: ref[EngLenSpec])
{
    init(ls: ref[EngLenSpec])
        set this.ls: ls
}

; DisplaySpaceObj — wraps a Style.DisplaySpace, as Clark's DisplaySpaceObj
; holds an Owner<FOTBuilder::DisplaySpace>.
define DisplaySpaceObj (ds: ref[DisplaySpace]?)
{
    init(ds: ref[DisplaySpace]?)
        set this.ds: ds
}

; InlineSpaceObj — wraps a Style.InlineSpace (see DisplaySpaceObj).
define InlineSpaceObj (sp: ref[InlineSpace]?)
{
    init(sp: ref[InlineSpace]?)
        set this.sp: sp
}

; ColorObjRec — a DeviceRGBColorObj (every reference color space's makeColor
; produces device RGB; the CIE spaces convert on construction).
define ColorObjRec (r: int, g: int, b: int)
{
    init(r: int, g: int, b: int)
    {
        set this.r: r
        set this.g: g
        set this.b: b
    }
}

; the CIE color-space data (XYZData + the per-kind extras, one flat record;
; every pointer is a host-allocated double/ELObj* buffer of the noted size).
define CieData
(
    xyz: pointer[double]              ; 14: white[3], white_u, white_v, M[9]
    range: pointer[double]            ; 6 (LUV/LAB)
    range_abc: pointer[double]        ; 6
    decode_abc: pointer[pointer[ELObj]] ; 3 (null entries = identity)
    matrix_abc: pointer[double]       ; 9
    range_lmn: pointer[double]        ; 6
    decode_lmn: pointer[pointer[ELObj]] ; 3
    matrix_lmn: pointer[double]       ; 9
    range_a: pointer[double]          ; 2
    decode_a: ref[ELObj]?
    matrix_a: pointer[double]         ; 3
)
{
    function make(host: ref[Page]) returns ref[CieData]
    {
        let d host.allocate(sizeof CieData, alignof CieData) as pointer[CieData]
        set d.xyz: null
        set d.range: null
        set d.range_abc: null
        set d.decode_abc: null
        set d.matrix_abc: null
        set d.range_lmn: null
        set d.decode_lmn: null
        set d.matrix_lmn: null
        set d.range_a: null
        set d.decode_a: null
        set d.matrix_a: null
        d
    }
}

; ColorSpaceObjRec — kind + the CIE data record. Kind codes in Primitive
; (CS_*); the reference splits these into ColorSpaceObj subclasses that hold
; the data as typed members (Style.h:186-234).
define ColorSpaceObjRec (kind: int, data: ref[CieData]?)
{
    init(kind: int, data: ref[CieData]?)
    {
        set this.kind: kind
        set this.data: data
    }
}

; --- the union -------------------------------------------------------------
define ELObj union
(
    Error: ErrorObj
    Unspecified: UnspecifiedObj
    Nil: NilObj
    True: TrueObj
    False: FalseObj
    Symbol: SymbolObj
    Keyword: KeywordObj
    Pair: PairObj
    Vec: VectorObj
    Chr: CharObj
    Str: StringObj
    StrCat: StrCatObj
    Int: IntegerObj
    Real: RealObj
    Length: LengthObj
    Quantity: QuantityObj
    UnresolvedLength: UnresolvedLengthObj
    UnresolvedQuantity: UnresolvedQuantityObj
    GlyphId: GlyphIdObj
    Gst: GlyphSubstTableObj
    Box: BoxObj
    Closure: ClosureObj
    Primitive: PrimitiveObj
    Continuation: ContinuationObj
    ApplyFn: ApplyFnObj
    CallCCFn: CallCCFnObj
    NodeList: NodeListObj
    Sosofo: SosofoObj
    FlowObjBox: FlowObjBox
    Language: LanguageObj
    Style: StyleObjRec
    LenSpec: LengthSpecObj
    DispSpace: DisplaySpaceObj
    InlSpace: InlineSpaceObj
    Color: ColorObjRec
    ColorSpace: ColorSpaceObjRec
    Addr: AddressObj
)
{
    ; --- constructors (Collector::allocateObject seam: run-page make) ------
    function make_error(host: ref[Page]) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Error(ErrorObj())
        p
    }

    function make_unspecified(host: ref[Page]) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Unspecified(UnspecifiedObj())
        p
    }

    function make_nil(host: ref[Page]) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Nil(NilObj())
        p
    }

    function make_true(host: ref[Page]) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.True(TrueObj())
        p
    }

    function make_false(host: ref[Page]) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.False(FalseObj())
        p
    }

    ; Deep-copies the name onto the host page (transient-buffer trap).
    function make_symbol(host: ref[Page], name: StringC) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Symbol(SymbolObj(StringC^host(name.data_ptr(), name.get_size())))
        p
    }

    function make_keyword(host: ref[Page], ident: ref[Identifier]) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Keyword(KeywordObj(ident))
        p
    }

    function make_pair(host: ref[Page], car: ref[ELObj]?, cdr: ref[ELObj]?) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Pair(PairObj(car, cdr))
        p
    }

    ; make-vector: n slots, all `fill` (may be null while under construction).
    function make_vector(host: ref[Page], n: size_t, fill: ref[ELObj]) returns ref[ELObj]
    {
        var elems: pointer[pointer[ELObj]] null
        if n > 0
        {
            set elems: host.allocate(n * (sizeof pointer[ELObj]), alignof pointer[ELObj]) as pointer[pointer[ELObj]]
            var i: size_t 0
            while i < n
            {
                set *(elems + i): fill
                set i: i + 1
            }
        }
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Vec(VectorObj(elems, n))
        p
    }

    ; a vector over an existing element list (the datum reader's #(...) path)
    function make_vector_of(host: ref[Page], buf: pointer[pointer[ELObj]], n: size_t) returns ref[ELObj]
    {
        var elems: pointer[pointer[ELObj]] null
        if n > 0
        {
            set elems: host.allocate(n * (sizeof pointer[ELObj]), alignof pointer[ELObj]) as pointer[pointer[ELObj]]
            var i: size_t 0
            while i < n
            {
                set *(elems + i): *(buf + i)
                set i: i + 1
            }
        }
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Vec(VectorObj(elems, n))
        p
    }

    function make_char(host: ref[Page], ch: u32) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Chr(CharObj(ch))
        p
    }

    ; Deep-copies the text onto the host page (C# StringObj(StringC) makes a
    ; copy for the same reason: the parser reuses its buffer).
    function make_string(host: ref[Page], str: StringC) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Str(StringObj(StringC^host(str.data_ptr(), str.get_size())))
        p
    }

    ; make_string for a buffer that ALREADY lives on `host`: the StringC adopts
    ; it instead of copying. `make_string` copies because most of its 61 call
    ; sites hand it a StringC whose buffer may sit on a dying page or be a
    ; stack temporary — that copy is load-bearing and stays.
    ;
    ; ★Precondition, and the only reason this is safe: `chars` must be
    ; region-allocated on `host` and never written again. The reference has no
    ; equivalent because `convertGeneralName` normalizes IN PLACE into one
    ; StringC (style/primitive.cxx:2868) — our chain allocated a scratch
    ; buffer, copied it into a StringC and copied THAT into the ELObj, i.e.
    ; three copies of the characters where the reference makes one. Measured
    ; 2026-08-06: `general-name-normalize` at 178.7 B/call was 29.8 % of all
    ; bytes primitives allocate on a styling run (tests/dazzle/primprof).
    function make_string_adopt(host: ref[Page], chars: pointer[u32], n: size_t) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        var sc StringC()
        set sc.data: chars
        set sc.size: n
        set *p: ELObj.Str(StringObj(sc))
        p
    }

    ; a rope node over already-string-valued parts; `size` = total chars.
    function make_strcat(host: ref[Page], parts: ref[Array[ref[ELObj]?]], size: size_t) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.StrCat(StrCatObj(parts, size))
        p
    }

    function make_integer(host: ref[Page], n: int) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Int(IntegerObj(n))
        p
    }

    function make_real(host: ref[Page], n: double) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Real(RealObj(n))
        p
    }

    function make_length(host: ref[Page], n: int) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Length(LengthObj(n))
        p
    }

    function make_unresolved_length(host: ref[Page], val: int, val_exp: int, unit: ref[Unit]) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.UnresolvedLength(UnresolvedLengthObj(val, val_exp, unit))
        p
    }

    function make_unresolved_quantity(host: ref[Page], val: double, unit: ref[Unit], unit_exp: int) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.UnresolvedQuantity(UnresolvedQuantityObj(val, unit, unit_exp))
        p
    }

    function make_glyph_id(host: ref[Page], pubid: StringC, suffix: int) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.GlyphId(GlyphIdObj(pubid, suffix))
        p
    }

    function make_glyph_subst_table(host: ref[Page], table: ref[GlyphSubstTableRec]?) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Gst(GlyphSubstTableObj(table))
        p
    }

    ; AddressObj — the link destination value (addr_type: the Style ADDR_*
    ; codes; node: a pointer[GroveNode]). The AddressRec is allocated on the
    ; same page as the ELObj, the seam of the reference's collector-owned
    ; `Owner<Address>`.
    function make_address(host: ref[Page], addr_type: int, node: ref[GroveNode]?) returns ref[ELObj]
    {
        let a AddressRec.make(host, addr_type, node)
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Addr(AddressObj(a))
        p
    }

    ; the AddressObj(type, node, p0) form — idref-address / entity-address.
    function make_address1(host: ref[Page], addr_type: int, node: ref[GroveNode]?, p0: StringC) returns ref[ELObj]
    {
        let p ELObj.make_address(host, addr_type, node)
        let a p.address_rec()
        set a.p0: p0
        p
    }

    ; the AddressObj(type, node, p0, p1) form — sgml-document-address.
    function make_address2(host: ref[Page], addr_type: int, node: ref[GroveNode]?, p0: StringC, p1: StringC) returns ref[ELObj]
    {
        let p ELObj.make_address(host, addr_type, node)
        let a p.address_rec()
        set a.p0: p0
        set a.p1: p1
        p
    }

    ; ELObj::asAddress()
    function is_address_p(this: ref[ELObj]) returns bool
    {
        choose this
            when a: Addr
                return true
            else
                return false
        false
    }

    ; AddressObj::address() — null for a non-address.
    function address_rec(this: ref[ELObj]) returns ref[AddressRec]?
    {
        choose this
            when a: Addr
                return a.addr
            else
                return null
        null
    }

    function address_type(this: ref[ELObj]) returns int
    {
        let a this.address_rec()
        if a = null
            return 0
        a.addr_type
    }

    function address_node(this: ref[ELObj]) returns pointer[void]
    {
        let a this.address_rec()
        if a = null
            return null
        a.node
    }

    ; ELObj::glyphId() — true only for a GlyphId arm.
    function is_glyph_id_p(this: ref[ELObj]) returns bool
    {
        choose this
            when g: GlyphId
                return true
            else
                return false
        false
    }

    function glyph_pubid(this: ref[ELObj]) returns StringC
    {
        choose this
            when g: GlyphId
                return g.pubid
            else
                return StringC()
        StringC()
    }

    function glyph_suffix(this: ref[ELObj]) returns int
    {
        choose this
            when g: GlyphId
                return g.suffix
            else
                return 0
        0
    }

    ; asGlyphSubstTable — the table payload (null otherwise).
    function as_glyph_subst_table(this: ref[ELObj]) returns ref[GlyphSubstTableRec]?
    {
        choose this
            when t: Gst
                return t.table
            else
                return null
        null
    }

    function make_quantity(host: ref[Page], val: double, dim: int) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Quantity(QuantityObj(val, dim))
        p
    }

    function make_length_spec(host: ref[Page], v0: double, v1: double, v2: double) returns ref[ELObj]
    {
        let e EngLenSpec.make(host, v0, v1, v2)
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.LenSpec(LengthSpecObj(e))
        p
    }

    ; ds points to a Style.DisplaySpace record on `host`.
    function make_display_space(host: ref[Page], ds: ref[DisplaySpace]?) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.DispSpace(DisplaySpaceObj(ds))
        p
    }

    ; sp points to a Style.InlineSpace record on `host`.
    function make_inline_space(host: ref[Page], sp: ref[InlineSpace]?) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.InlSpace(InlineSpaceObj(sp))
        p
    }

    function make_color(host: ref[Page], r: int, g: int, b: int) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Color(ColorObjRec(r, g, b))
        p
    }

    function make_color_space(host: ref[Page], kind: int, data: ref[CieData]?) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.ColorSpace(ColorSpaceObjRec(kind, data))
        p
    }

    ; ELObj::lengthSpec() — the engine 3-vector, null unless a LengthSpecObj.
    function length_spec(this: ref[ELObj]) returns ref[EngLenSpec]?
    {
        choose this
            when l: LenSpec
                return l.ls
            else
                return null
        null
    }

    ; asDisplaySpace — the opaque Style.DisplaySpace payload (null otherwise).
    function as_display_space(this: ref[ELObj]) returns ref[DisplaySpace]?
    {
        choose this
            when d: DispSpace
                return d.ds
            else
                return null
        null
    }

    ; asInlineSpace — the opaque Style.InlineSpace payload (null otherwise).
    function as_inline_space(this: ref[ELObj]) returns ref[InlineSpace]?
    {
        choose this
            when s: InlSpace
                return s.sp
            else
                return null
        null
    }

    function is_color_p(this: ref[ELObj]) returns bool
    {
        choose this
            when c: Color
                return true
            else
                return false
        false
    }

    ; the device-RGB components packed 0xRRGGBB (-1 unless a color).
    function color_rgb(this: ref[ELObj]) returns int
    {
        choose this
            when c: Color
                return (c.r << 16) | (c.g << 8) | c.b
            else
                return 0 - 1
        0 - 1
    }

    function is_color_space_p(this: ref[ELObj]) returns bool
    {
        choose this
            when c: ColorSpace
                return true
            else
                return false
        false
    }

    function color_space_kind(this: ref[ELObj]) returns int
    {
        choose this
            when c: ColorSpace
                return c.kind
            else
                return 0 - 1
        0 - 1
    }

    function color_space_data(this: ref[ELObj]) returns ref[CieData]?
    {
        choose this
            when c: ColorSpace
                return c.data
            else
                return null
        null
    }

    ; --- predicates --------------------------------------------------------
    ; SymbolObj::name() — the interning tables key on it.
    function symbol_name(this: ref[ELObj]) returns StringC
    {
        choose this
            when s: Symbol
                return s.name
            else
                return StringC()
        StringC()
    }

    ; SymbolObj::cValue — the FOTBuilder::Symbol code (0 = none/false); set at
    ; install time for the 120 FOT symbols (Interpreter.install_c_value_symbols).
    function symbol_c_value(this: ref[ELObj]) returns int
    {
        choose this
            when s: Symbol
                return s.c_value
            else
                return 0
        0
    }

    ; arm rebuild in place (the set_car idiom) — eq?-identity unchanged.
    function set_symbol_c_value(this: ref[ELObj], code: int)
    {
        choose this
            when s: Symbol
            {
                var rebuilt SymbolObj(s.name)
                set rebuilt.c_value: code
                set this: ELObj.Symbol(rebuilt)
            }
    }

    ; --- callable / box constructors (Inc 3) -------------------------------
    function make_box(host: ref[Page], value: ref[ELObj]?) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Box(BoxObj(value))
        p
    }

    ; The by-value `sig` parameters stay: every caller has a Signature VALUE
    ; (an install-time literal, or a ClosureMk insn's field), and copying it
    ; onto `host` once here is cheaper than threading a pointer through the
    ; compiler. 226 copies per run for primitives, ~32 700 for closures — see
    ; the note on ClosureObj for why that trade is lopsided in our favour.
    function make_closure(host: ref[Page], sig: Signature, code: ref[Insn]?, display: pointer[pointer[ELObj]]) returns ref[ELObj]
    {
        let sp host.allocate(sizeof Signature, alignof Signature) as pointer[Signature]
        set *sp: sig
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Closure(ClosureObj(sp, code, display))
        p
    }

    function make_primitive(host: ref[Page], sig: Signature, prim_id: int) returns ref[ELObj]
    {
        let sp host.allocate(sizeof Signature, alignof Signature) as pointer[Signature]
        set *sp: sig
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Primitive(PrimitiveObj(sp, prim_id))
        p
    }


    function make_apply_fn(host: ref[Page]) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.ApplyFn(ApplyFnObj())
        p
    }

    function make_callcc_fn(host: ref[Page]) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.CallCCFn(CallCCFnObj())
        p
    }

    function make_continuation(host: ref[Page]) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Continuation(ContinuationObj())
        p
    }

    ; --- node lists (Grove Inc 4) ------------------------------------------
    function make_node_list(host: ref[Page], nodes: ref[Array[ref[GroveNode]?]]?, start: int) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.NodeList(NodeListObj(nodes, start as i32, NNL_NONE, null, null, null))
        p
    }

    ; a node-list over an existing (members, prefix) pair — node-list-rest and
    ; friends carry the prefix along when they bump `start`.
    function make_node_list_prefix(host: ref[Page], nodes: ref[Array[ref[GroveNode]?]], start: int, prefix: ref[Array[int]]?) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.NodeList(NodeListObj(nodes, start as i32, NNL_NONE, prefix, null, null))
        p
    }

    ; a NAMED node-list (NamedNodeList): the same buffer plus which substitution
    ; table `named-node` / `named-node-list-normalize` fold the query through.
    function make_named_node_list(host: ref[Page], nodes: ref[Array[ref[GroveNode]?]], named: int) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.NodeList(NodeListObj(nodes, 0, named as i32, null, null, null))
        p
    }

    ; NNL_NONE unless this list is a named one (named-node-list?)
    function node_list_named(this: ref[ELObj]) returns int
    {
        choose this
            when nl: NodeList
                return (nl.named as int)
            else
                return NNL_NONE
        NNL_NONE
    }

    ; a CHARACTER-EXPANDED node-list over chunk-level members: builds the prefix
    ; index (one int per member plus the total sentinel) instead of one pointer
    ; per character. Members whose span is 1 make this identical in meaning to
    ; the plain form, so producers may pass any mix.
    function make_node_list_expanded(host: ref[Page], members: ref[Array[ref[GroveNode]?]], start: int) returns ref[ELObj]
    {
        let m members.get_length() as int
        let prefix Array[int]^host()
        var total 0
        var k 0
        while k < m
        {
            prefix.add(total)
            let node members[k]
            set total: total + GroveNode.member_span(node as ref[GroveNode])
            set k: k + 1
        }
        prefix.add(total)
        ELObj.make_node_list_prefix(host, members, start, prefix)
    }

    ; --- the lazy select-elements view (SelectElementsNodeListObj) ----------
    ; select-elements' result: an empty buffer plus the generator that fills it
    ; on demand. Nothing is matched here — DEFPRIMITIVE(SelectElements) only
    ; converts the pattern and wraps the source list.
    function make_select_node_list(host: ref[Page], interp: ref[Interpreter], src: ref[ELObj], pat: ref[Pattern]) returns ref[ELObj]
    {
        ; the array force_select fills is MEMO storage, so its host is the memo
        ; seam's (Interpreter.memo_host) rather than the view's own region — see
        ; that function for why the region end is the wrong home for it
        let mh Interpreter.memo_host(host)
        let out Array[ref[GroveNode]?]^mh()
        let g SelectGen.make(host, GEN_SELECT, src, null, pat, interp, out, null, null)
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.NodeList(NodeListObj(out, 0, NNL_NONE, null, g, null))
        p
    }

    ; (node-list a b) — PairNodeListObj: a two-pointer cell, no copy. The
    ; reference walks the pair tree through nodeListFirst/Rest and never
    ; materializes an array; our node-list protocol is random-access
    ; (node_list_node/count), so the pair materializes ONCE, on the first
    ; access that needs members, and memoizes into `out` — the same
    ; flatten-once-in-place shape StrCatObj uses for a string rope.
    ;
    ; ★What makes that O(n) instead of O(n²): concat_fill recurses into a
    ; nested, still-unforced CONCAT view DIRECTLY instead of asking it for its
    ; members, so the intermediate levels of a fold never build an array of
    ; their own. That is what the eager version got wrong — `node-list-filter`
    ; (dsssl/builtins.dsl) folds `(node-list result snl)` per member, which
    ; copied result's whole prefix every step: n(n+1)/2 members for n matches,
    ; measured 177.7 M copies / 4814 MB on the heaviest codegen.
    function make_concat_node_list(host: ref[Page], interp: ref[Interpreter], a: ref[ELObj], b: ref[ELObj]) returns ref[ELObj]
    {
        let mh Interpreter.memo_host(host)
        let out Array[ref[GroveNode]?]^mh()
        let g SelectGen.make(host, GEN_CONCAT, a, b, null, interp, out, null, null)
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.NodeList(NodeListObj(out, 0, NNL_NONE, null, g, null))
        p
    }

    ; append every node of `list` (flat positions, from its own start) to `out`,
    ; recursing straight through an unforced CONCAT view. The `start = 0` guard
    ; is what keeps the shortcut sound: a view that node-list-rest has already
    ; advanced must be read through the flat accessor, which honours `start`.
    procedure concat_fill(list: ref[ELObj]?, out: ref[Array[ref[GroveNode]?]])
    {
        if list = null
            return
        FrameMark.store(out as pointer[void])
        choose *list
            when nl: NodeList
            {
                let g nl.gen
                if g <> null
                {
                    if g.kind = GEN_CONCAT
                    {
                        if (nl.start as int) = 0
                        {
                            if g.cursor = 0
                            {
                                ELObj.concat_fill(g.src, out)
                                ELObj.concat_fill(g.src2, out)
                                return
                            }
                        }
                    }
                }
            }
            else
                return
        let n list.node_list_count()
        var j 0
        while j < n
        {
            let node list.node_list_node(j)
            if node <> null
                out.add(node)
            set j: j + 1
        }
    }

    ; Extend a select view's buffer until it holds `need` matches, or until the
    ; source is exhausted (need < 0 forces to the end). `cursor` < 0 marks an
    ; exhausted source, so a repeated full force costs one compare.
    ;
    ; The walk steps over MEMBERS, not character positions: an element pattern
    ; can never match a data-char or PI node (Element::matches bails on the
    ; class), and a node-list over mixed content is mostly characters. That is
    ; the reference's chunk skip (nodeListChunkRest steps over a whole data
    ; chunk at once) — a data run costs one step here instead of one
    ; Pattern.matches call, hence one region, per character. Elements always
    ; span one position, so the member walk and the flat walk agree on
    ; everything this primitive can select.
    function force_select(g: ref[SelectGen], need: int)
    {
        if g.cursor < 0
            return
        ; `out.add` grows an Array allocated WITH the view, and the growth
        ; lands at the region's end — inside the running frame's span
        FrameMark.store(g.out as pointer[void])
        ; a CONCAT view materializes in one pass — its operands are fixed, so
        ; there is nothing to gain from stopping early, and the eager version it
        ; replaces built the whole thing at construction time anyway.
        if g.kind = GEN_CONCAT
        {
            let out2 g.out
            ELObj.concat_fill(g.src, out2)
            ELObj.concat_fill(g.src2, out2)
            set g.cursor: 0 - 1
            return
        }
        let src g.src
        let pat g.pat
        let interp g.interp
        let host g.host
        let out g.out
        var i g.cursor
        repeat
        {
            if need >= 0
            {
                if (out.get_length() as int) >= need
                    break
            }
            let node src.node_list_member(i)
            if node = null
            {
                set g.cursor: 0 - 1
                return
            }
            set i: i + 1
            if node.get_class() = GN_ELEMENT
            {
                if pat.matches(host, interp, node)
                    out.add(node)
            }
        }
        set g.cursor: i
    }

    ; --- the lazy AXIS views (children / descendants / preced / follow) -----
    ;
    ; One constructor per axis, all the same shape: an EMPTY member buffer, a
    ; prefix index holding just its sentinel, and the generator that extends
    ; both on demand. `src` is the node-list the primitive was handed, and the
    ; view maps over its members exactly as the eager array did.
    ;
    ; ★Where the storage lives is the load-bearing part. `out`/`prefix`/`path`
    ; are MEMO storage — they are extended by whatever frame first asks a
    ; question, which is normally NOT the frame that built the view — so they
    ; go on the memo seam's host (Interpreter.memo_host), like the select and
    ; concat views. Hosting them at the view's own region END would put them
    ; above every live frame mark and make the mark unsound; with the mark off
    ; the seam answers with the region itself and nothing changes. Each fill
    ; additionally hooks FrameMark.store, because publication is a property of
    ; the STORE and not of the primitive.
    function make_axis_node_list(host: ref[Page], interp: ref[Interpreter], src: ref[ELObj], kind: int) returns ref[ELObj]
    {
        ; a narrow child axis is materialized instead of viewed, see
        ; AXIS_EAGER_MAX. Only `children` takes this path: it is the one axis
        ; whose answer size is known in O(1) before anything is walked.
        if kind = GEN_CHILDREN
        {
            if ELObj.children_fit_eager(src)
                return ELObj.make_children_eager(host, src)
        }
        let mh Interpreter.memo_host(host)
        let out Array[ref[GroveNode]?]^mh()
        ; ★no expansion index — see gen_make_prefix. A view whose members all
        ; stand for exactly one position needs none at all, and that is almost
        ; all of them (measured on the heaviest real-world codegen: ONE view of
        ; 11 525 091 ever grew one). The eager form this replaces allocated the
        ; array for every single view.
        var path: ref[Array[int]]? null
        ; only the descendants walk keeps a stack, and it is one int per level
        ; of the subtree, not one per member
        if kind = GEN_DESCENDANTS
            set path: Array[int]^mh()
        let g SelectGen.make(host, kind, src, null, null, interp, out, null, path)
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.NodeList(NodeListObj(out, 0, NNL_NONE, null, g, null))
        p
    }

    ; Whether the whole child axis of `src` is at most AXIS_EAGER_MAX members.
    ; Asked only of a source that is already materialized — asking a lazy one
    ; would force it, which is the opposite of the point.
    ;
    ; ★The count runs over MEMBERS rather than flat positions, and the two
    ; agree here: only an element has a child axis, and an element is always a
    ; one-position member. Walking flat positions would materialize a character
    ; view per character of a data source to ask it for children it cannot
    ; have.
    function children_fit_eager(src: ref[ELObj]) returns bool
    {
        choose src
            when nl: NodeList
            {
                if nl.gen <> null
                    return false
            }
            else
                return false
        let c src.node_list_member_count()
        if c > AXIS_EAGER_MAX
            return false
        var total 0
        var i 0
        while i < c
        {
            let node src.node_list_member(i)
            if node <> null
                set total: total + node.axis_child_count()
            if total > AXIS_EAGER_MAX
                return false
            set i: i + 1
        }
        true
    }

    ; the child axis of a source node-list, materialized — with the same rule
    ; about the expansion index as the lazy form: no array at all unless some
    ; member stands for more than one position.
    function make_children_eager(host: ref[Page], src: ref[ELObj]) returns ref[ELObj]
    {
        let out Array[ref[GroveNode]?]^host()
        var prefix: ref[Array[int]]? null
        var total 0
        var j 0
        let c src.node_list_member_count()
        var i 0
        while i < c
        {
            let node src.node_list_member(i)
            if node <> null
            {
                let m node.axis_child_count()
                var k 0
                while k < m
                {
                    let ch node.axis_child_at(k)
                    out.add(ch)
                    let sp GroveNode.member_span(ch as ref[GroveNode])
                    set total: total + sp
                    if prefix = null
                    {
                        if sp > 1
                        {
                            let p Array[int]^host()
                            var q 0
                            while q <= j
                            {
                                p.add(q)
                                set q: q + 1
                            }
                            set prefix: p
                            p.add(total)
                        }
                    }
                    else
                        prefix.add(total)
                    set j: j + 1
                    set k: k + 1
                }
            }
            set i: i + 1
        }
        ELObj.make_node_list_prefix(host, out, 0, prefix)
    }

    ; the CHUNK a node-list member stands for, and the member's character
    ; offset — a character VIEW stands for one character of its chunk, every
    ; other node for itself. The sibling views need both to truncate the one
    ; member that HOLDS the node.
    function member_chunk(node: ref[GroveNode]) returns ref[GroveNode]
    {
        if node.get_class() <> GN_DATA
            return node
        node.data_chunk()
    }

    function member_offset(node: ref[GroveNode]) returns int
    {
        if node.get_class() <> GN_DATA
            return 0
        node.get_char_index()
    }

    ; The single entry point every accessor goes through. `need_flat` is a
    ; count of FLAT (character-expanded) positions, `need_members` a count of
    ; buffer MEMBERS; -1 on either means "to the end". A caller states the one
    ; it knows and passes 0 for the other, which is why the two cannot be
    ; folded into one number: on an expanded view a member may stand for a
    ; whole data run, so "enough characters" does not imply "enough members".
    ; The select and concat views have no expansion — one member is one
    ; position — so for them the larger of the two IS the old single `need`.
    function force_gen(g: ref[SelectGen], need_flat: int, need_members: int)
    {
        if g.kind >= GEN_CHILDREN
        {
            ELObj.force_axis(g, need_flat, need_members)
            return
        }
        var need need_flat
        if need_members > need
            set need: need_members
        if need_flat < 0
            set need: 0 - 1
        ELObj.force_select(g, need)
    }

    function gen_satisfied(g: ref[SelectGen], need_flat: int, need_members: int) returns bool
    {
        if need_flat < 0
            return false
        if g.total < need_flat
            return false
        if need_members < 0
            return false
        let out g.out
        if (out.get_length() as int) < need_members
            return false
        true
    }

    ; Extend an axis view until it holds `need_flat` character positions and
    ; `need_members` members, or until the axis is exhausted. `cursor` < 0
    ; marks exhaustion, so a repeated full force costs one compare.
    function force_axis(g: ref[SelectGen], need_flat: int, need_members: int)
    {
        if g.cursor < 0
            return
        ; ★the satisfied test comes BEFORE the hooks: an accessor that is already
        ; covered must cost one compare, not two frame-mark probes. The lazy
        ; form is asked far more often than the eager array was written.
        if ELObj.gen_satisfied(g, need_flat, need_members)
            return
        ; ★★GEOMETRIC over-forcing, and it is what makes a full WALK of a lazy
        ; view as cheap as the array it replaced. A caller stepping member by
        ; member (force_select over a source list, node-list-rest) pays the
        ; whole entry path per member otherwise — measured at +20 % on the
        ; select-elements row of the complexity screen. Doubling keeps the
        ; total work O(members) while the FIRST question still forces exactly
        ; what it asked (2 x 0 = 0), so `node-list-first` stays O(1) — that is
        ; the whole point of the view and must not be traded away.
        ; ★Only the AXIS views do this: producing an axis member is a pointer
        ; step, while a select view's step runs a PATTERN, and "stop at the
        ; first match" is that view's documented contract.
        var nf need_flat
        var nm need_members
        if nf >= 0
        {
            let d g.total * 2
            if d > nf
                set nf: d
        }
        if nm >= 0
        {
            let out0 g.out
            let l (out0.get_length() as int) * 2
            if l > nm
                set nm: l
        }
        ; both arrays grow at their region's end, which is inside the running
        ; frame's span whenever the memo seam hands back the view's own region
        FrameMark.store(g.out as pointer[void])
        FrameMark.store(g.prefix as pointer[void])
        ; ★The child axis gets its own loop rather than going through the
        ; generic driver, and that is a MEASUREMENT, not taste: the guardrail
        ; row (`node-list-length (children …)`, where the port is 27x cheaper
        ; than openjade and must stay so) paid +54 % for three calls per member
        ; through axis_next/axis_emit/emit_child plus an axis_child_count per
        ; step. Lifting the dispatch out of the loop and hoisting the count
        ; into `stop` gave it back — the same lesson as the eval loop's
        ; switches.
        if g.kind = GEN_CHILDREN
        {
            ELObj.fill_children(g, nf, nm)
            return
        }
        ; a full force needs no per-member test at all
        let all nf < 0
        repeat
        {
            if all = false
            {
                if ELObj.gen_satisfied(g, nf, nm)
                    return
            }
            let node ELObj.axis_next(g)
            if node = null
            {
                set g.cursor: 0 - 1
                return
            }
            ELObj.gen_append(g, node)
        }
    }

    ; one member: the buffer plus its slot in the character-expansion index.
    ; `prefix` holds one entry per member plus the total sentinel, so appending
    ; the new total keeps that invariant at every point a caller can observe.
    procedure gen_append(g: ref[SelectGen], node: ref[GroveNode])
    {
        let out g.out
        out.add(node)
        let span GroveNode.member_span(node)
        set g.total: g.total + span
        var prefix g.prefix
        if prefix = null
        {
            if span = 1
                return
            set prefix: ELObj.gen_make_prefix(g, out.get_length() as int)
        }
        prefix.add(g.total)
    }

    ; The character-expansion index, built the moment a member arrives that
    ; stands for more than one position. Everything appended before it spanned
    ; exactly one, so those entries are 0, 1, 2, … and the caller appends the
    ; new total as the sentinel. `m` is the buffer length INCLUDING the member
    ; being appended.
    ;
    ; ★A null prefix and a prefix of all-ones mean exactly the same thing to
    ; every accessor (the invariant make_node_list_expanded already states:
    ; "Members whose span is 1 make this identical in meaning to the plain
    ; form"), which is what lets the array be skipped rather than deferred.
    ; ★Its home is the memo seam's, like `out` — it is grown by whichever frame
    ; asks first, not by the one that built the view.
    function gen_make_prefix(g: ref[SelectGen], m: int) returns ref[Array[int]]
    {
        let mh Interpreter.memo_host(g.host)
        let p Array[int]^mh()
        FrameMark.store(p as pointer[void])
        var k 0
        while k < m
        {
            p.add(k)
            set k: k + 1
        }
        set g.prefix: p
        p
    }

    ; the expansion index of a node-list: the GENERATOR's whenever there is
    ; one, because a lazy view may grow one after the ELObj was built (and
    ; node_list_rest hands the generator, not the array, to its tail).
    function prefix_of(gen: ref[SelectGen]?, own: ref[Array[int]]?) returns ref[Array[int]]?
    {
        if gen <> null
            return gen.prefix
        own
    }

    ; the CHILDREN AXIS (Node::firstChild), not the structural child list:
    ; `children` of the sgml-document node is EMPTY in the reference (the class
    ; has no children property at all — its subnodes are prolog /
    ; document-element / epilog).
    function fill_children(g: ref[SelectGen], need_flat: int, need_members: int)
    {
        let all need_flat < 0
        let out g.out
        var prefix g.prefix
        repeat
        {
            if all = false
            {
                if ELObj.gen_satisfied(g, need_flat, need_members)
                    return
            }
            if g.cur = null
            {
                if ELObj.axis_begin(g) = false
                {
                    set g.cursor: 0 - 1
                    return
                }
            }
            ; ★the walk state moves into LOCALS for the run over one source
            ; node's children. Left in the generator record it is reloaded and
            ; stored per member — nothing can prove `out.add` does not touch
            ; it — and that alone was the guardrail row's remaining +35 %
            ; against the eager array it replaced.
            let node g.cur
            let m g.stop
            var j g.sub
            var total g.total
            while j < m
            {
                let c node.axis_child_at(j)
                out.add(c)
                let sp GroveNode.member_span(c as ref[GroveNode])
                set total: total + sp
                if prefix = null
                {
                    if sp > 1
                    {
                        set prefix: ELObj.gen_make_prefix(g, out.get_length() as int)
                        prefix.add(total)
                    }
                }
                else
                    prefix.add(total)
                set j: j + 1
                if all = false
                {
                    if total >= need_flat
                    {
                        if (out.get_length() as int) >= need_members
                            break
                    }
                }
            }
            set g.sub: j
            set g.total: total
            if j >= m
                set g.cur: null
        }
    }

    ; the next member of the axis, or null when every source node is spent
    function axis_next(g: ref[SelectGen]) returns ref[GroveNode]?
    {
        repeat
        {
            if g.cur = null
            {
                if ELObj.axis_begin(g) = false
                    return null
            }
            let node ELObj.axis_emit(g)
            if node <> null
                return node
            set g.cur: null
        }
        null
    }

    ; move to the next source node and initialize the per-node walk state
    function axis_begin(g: ref[SelectGen]) returns bool
    {
        let src g.src
        let node src.node_list_node(g.cursor)
        if node = null
            return false
        set g.cursor: g.cursor + 1
        set g.cur: node
        set g.sub: 0
        set g.sub2: 0 - 1
        set g.stop: 0
        set g.walk: null
        set g.depth: 0
        if g.kind = GEN_CHILDREN
            set g.stop: node.axis_child_count()
        else if g.kind >= GEN_PRECED
        {
            ; the sibling group, with its own root rule (Grove.sibling_range_*):
            ; the document element has none, and each prolog/epilog PI group is
            ; siblings among itself. A node with no structural parent has no
            ; group at all — the eager collect_expanded_siblings returned early
            ; there, and an empty [0, 0) range says the same thing.
            if node.get_parent() <> null
            {
                set g.sub: node.sibling_range_begin()
                set g.stop: node.sibling_range_end()
            }
            let tc ELObj.member_chunk(node)
            set g.walk: tc
            ; ★`follow` starts AT the node's own member — the reference's
            ; nextChunkSibling — instead of scanning the group for it, which is
            ; what made it O(position) per call and quadratic over the group.
            ; `preced` keeps the scan: it has to visit every member before the
            ; node anyway, and so does the reference.
            if g.kind = GEN_FOLLOW
            {
                let i0 tc.group_index()
                if i0 >= g.sub
                {
                    if i0 < g.stop
                        set g.sub: i0
                }
            }
        }
        true
    }

    function axis_emit(g: ref[SelectGen]) returns ref[GroveNode]?
    {
        if g.kind = GEN_DESCENDANTS
            return ELObj.emit_descendant(g)
        if g.kind = GEN_PRECED
            return ELObj.emit_preced(g)
        ELObj.emit_follow(g)
    }

    ; DescendantsNodeListObj::advance (style/primitive.cxx:5400): descend into
    ; the first child, else step to the next sibling, else climb until one
    ; exists — the same pre-order walk the eager collect_descendants recursed,
    ; and the children AXIS too, so `descendants` of the sgml-document node is
    ; empty. The reference's `depth` counter is a stack here because its nodes
    ; know their next sibling and ours do not: `path` carries the child index
    ; at every level, so the climb is O(1) per step rather than a search.
    function emit_descendant(g: ref[SelectGen]) returns ref[GroveNode]?
    {
        var cur g.walk
        if cur = null
        {
            let root g.cur
            if root.axis_child_count() = 0
                return null
            ELObj.path_push(g, 0)
            let c root.axis_child_at(0)
            set g.walk: c
            return c
        }
        ; a DATA chunk is a member but never a parent (collect_descendants
        ; recursed on everything else, and everything else without a child axis
        ; answers 0 anyway)
        if cur.get_class() <> GN_DATA
        {
            if cur.axis_child_count() > 0
            {
                ELObj.path_push(g, 0)
                let c cur.axis_child_at(0)
                set g.walk: c
                return c
            }
        }
        repeat
        {
            if g.depth = 0
                return null
            let par cur.get_parent()
            if par = null
                return null
            let path g.path
            let idx (g.depth - 1) as size_t
            let i path[idx] + 1
            if i < par.axis_child_count()
            {
                path.put(idx, i)
                let c par.axis_child_at(i)
                set g.walk: c
                return c
            }
            set g.depth: g.depth - 1
            set cur: par
        }
        null
    }

    ; push one level of the descendants walk. The stack never shrinks — a pop
    ; only lowers `depth` — so a deep subtree pays its levels once.
    procedure path_push(g: ref[SelectGen], v: int)
    {
        let path g.path
        FrameMark.store(path as pointer[void])
        if (g.depth as size_t) < path.get_length()
            path.put(g.depth as size_t, v)
        else
            path.add(v)
        set g.depth: g.depth + 1
    }

    ; SiblingNodeListObj from firstSibling up to the node (DEFPRIMITIVE Preced).
    ; The members are chunk-level; only the member HOLDING the node is
    ; truncated, and only that one materializes character views — a prefix
    ; index cannot express a partial trailing member.
    ;
    ; DOCUMENTED DEVIATION: with a CHAR NODE as the argument the reference
    ; ABORTS (SiblingNodeListObj::nodeListChunkRest hits CANNOT_HAPPEN,
    ; style/primitive.cxx:5695, because nextChunkSibling fails on a mid-chunk
    ; node). Aborting a library call is not worth reproducing, so we answer the
    ; consistent count: the characters before it in its chunk plus the expanded
    ; siblings before that chunk. See COMPLETENESS.md.
    function emit_preced(g: ref[SelectGen]) returns ref[GroveNode]?
    {
        let node g.cur
        let tc g.walk
        if g.sub2 >= 0
        {
            ; inside the truncated member: its characters before the node
            if g.sub2 >= ELObj.member_offset(node as ref[GroveNode])
                return null
            let v GroveNode.char_view(tc, g.sub2)
            set g.sub2: g.sub2 + 1
            return v
        }
        if g.sub >= g.stop
            return null
        let s node.sibling_group_at(g.sub)
        ; the member holding the node ends the walk — it contributes only the
        ; characters before the node, and nothing after it does
        if s = tc
        {
            set g.sub2: 0
            return ELObj.emit_preced(g)
        }
        set g.sub: g.sub + 1
        s
    }

    ; BaseNode::follow — the FOLLOWING siblings, the exact mirror of preced
    ; (nextSibling, then a SiblingNodeList from there). `sub2` runs -1 (still
    ; looking for the member holding the node) -> >= 0 (emitting that member's
    ; character tail) -> -2 (everything after it).
    function emit_follow(g: ref[SelectGen]) returns ref[GroveNode]?
    {
        let node g.cur
        let tc g.walk
        if g.sub2 >= 0
        {
            if g.sub2 < tc.chunk_char_count()
            {
                let v GroveNode.char_view(tc, g.sub2)
                set g.sub2: g.sub2 + 1
                return v
            }
            set g.sub2: 0 - 2
            set g.sub: g.sub + 1
        }
        repeat
        {
            if g.sub >= g.stop
                return null
            let s node.sibling_group_at(g.sub)
            if g.sub2 = (0 - 2)
            {
                set g.sub: g.sub + 1
                return s
            }
            if s = tc
            {
                if s.get_class() = GN_DATA
                {
                    set g.sub2: ELObj.member_offset(node as ref[GroveNode]) + 1
                    return ELObj.emit_follow(g)
                }
                ; the member holding the node is never itself a member of
                ; `follow`; everything after it is
                set g.sub2: 0 - 2
                set g.sub: g.sub + 1
                return ELObj.emit_follow(g)
            }
            set g.sub: g.sub + 1
        }
        null
    }

    ; a singleton node-list over one node
    function make_node_singleton(host: ref[Page], node: ref[GroveNode]?) returns ref[ELObj]
    {
        ; the inline form — ONE allocation, no Array and no buffer (see the
        ; INLINE SINGLETON paragraph on NodeListObj). A null node keeps the
        ; empty-list meaning it always had: `single` null is "not a singleton",
        ; and with `nodes` null every accessor answers empty.
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.NodeList(NodeListObj(null, 0, NNL_NONE, null, null, node))
        p
    }

    function is_node_list_p(this: ref[ELObj]) returns bool
    {
        choose this
            when nl: NodeList
                return true
            else
                return false
        false
    }

    ; count of nodes from `start` to the end of the buffer — for an expanded
    ; list, of CHARACTER positions (the prefix sentinel holds the total).
    function node_list_count(this: ref[ELObj]) returns int
    {
        choose this
            when nl: NodeList
            {
                if nl.gen <> null
                    ELObj.force_gen(nl.gen, 0 - 1, 0 - 1)
                if nl.nodes = null
                {
                    ; ★the inline singleton rides INSIDE the null-buffer test
                    ; every accessor already had, so the buffer path pays
                    ; nothing for it. Measured: as a leading test of its own it
                    ; gave back half the win (2026-08-06). It is a one-element
                    ; buffer with no prefix, so this is `m - start` with m = 1
                    ; (negative past the end, exactly as the buffer form says).
                    if nl.single <> null
                        return 1 - (nl.start as int)
                    return 0
                }
                let m nl.nodes.get_length() as int
                let pfx ELObj.prefix_of(nl.gen, nl.prefix)
                if pfx = null
                    return m - (nl.start as int)
                return pfx[m] - (nl.start as int)
            }
            else
                return 0
        0
    }

    function node_list_start(this: ref[ELObj]) returns int
    {
        choose this
            when nl: NodeList
                return (nl.start as int)
            else
                return 0
        0
    }

    ; the i-th node from `start` (null if out of range). On an expanded list the
    ; position is resolved through the prefix index and the char view is
    ; materialized only here — a caller that merely counts, or that walks
    ; members (node_list_member*), never touches a per-character node.
    function node_list_node(this: ref[ELObj], i: int) returns ref[GroveNode]?
    {
        choose this
            when nl: NodeList
            {
                let idx (nl.start as int) + i
                if idx < 0
                    return null
                ; ★the coverage test is INLINE here and in node_list_member,
                ; and it is not premature: a walk over a lazy view asks once
                ; per member and the answer is normally "already there", so the
                ; force path is three calls of pure overhead — measured at
                ; +4.6 % on the complexity screen's select-elements row, which
                ; walks a children view member by member.
                if nl.gen <> null
                {
                    var have nl.nodes.get_length() as int
                    let p0 nl.gen.prefix
                    if p0 <> null
                        set have: p0[have]
                    if have <= idx
                        ELObj.force_gen(nl.gen as ref[SelectGen], idx + 1, 0)
                }
                if nl.nodes = null
                {
                    if (nl.single <> null) and (idx < 1)
                        return nl.single
                    return null
                }
                let m nl.nodes.get_length() as int
                let pfx ELObj.prefix_of(nl.gen, nl.prefix)
                if pfx = null
                {
                    if idx >= m
                        return null
                    return nl.nodes[idx]
                }
                let pb pfx.get_buffer()
                if idx >= *(pb + m)
                    return null
                let k ELObj.locate_member(pb, m, idx)
                let node nl.nodes[k]
                if GroveNode.member_span(node as ref[GroveNode]) = 1
                    return node
                return GroveNode.char_view(node, idx - *(pb + k))
            }
            else
                return null
        null
    }

    ; the member of an expanded buffer covering flat position `p`: the largest k
    ; in [0, m) with prefix[k] <= p. Zero-span members (empty data chunks) are
    ; skipped by taking the LARGEST such k. Caller guarantees 0 <= p < total.
    function locate_member(pb: pointer[int], m: int, p: int) returns int
    {
        var lo 0
        var hi m - 1
        while lo < hi
        {
            let mid (lo + hi + 1) / 2
            if *(pb + mid) <= p
                set lo: mid
            else
                set hi: mid - 1
        }
        lo
    }

    ; ★`node_list_buffer` lived here and was REMOVED with the inline singleton
    ; (2026-08-06). It had no caller anywhere in packages/ or tests/, and its
    ; contract — hand out the raw `Array` — is one an inline singleton cannot
    ; meet: it would have to answer null, i.e. "empty", which is the silent
    ; wrong answer this record's design note warns about. Anything that needs a
    ; buffer should walk `node_list_member`/`node_list_node` instead.

    ; node-list-rest: the same view one node further in. A select view hands its
    ; generator to the tail (SelectElementsNodeListObj::nodeListRest returns
    ; another select list over the rest of the source), so walking a filtered
    ; list one node at a time keeps matching on demand. A named list loses its
    ; name protocol here, as in the reference — a derived list is a plain one.
    function node_list_rest(host: ref[Page], list: ref[ELObj]) returns ref[ELObj]?
    {
        choose list
            when nl: NodeList
            {
                var st (nl.start as int)
                if list.node_list_is_empty() = false
                    set st: st + 1
                let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
                set *p: ELObj.NodeList(NodeListObj(nl.nodes, st as i32, NNL_NONE, nl.prefix, nl.gen, nl.single))
                return p
            }
            else
                return ELObj.make_node_list(host, null, 0)
        null
    }

    ; whether the list has no node at all (nodeListFirst == 0). Exactly
    ; `node_list_count() = 0`, but a select view is only forced far enough to
    ; answer it — that is the whole point of the lazy form: the caller asking
    ; "does anything match?" stops at the first match instead of at the end.
    function node_list_is_empty(this: ref[ELObj]) returns bool
    {
        choose this
            when nl: NodeList
            {
                ; `start` nodes are already consumed, so the question is whether
                ; match number start+1 exists — forcing just 1 would call a
                ; half-walked list empty as soon as node-list-rest moved on.
                if nl.gen <> null
                    ELObj.force_gen(nl.gen, (nl.start as int) + 1, 0)
                if nl.nodes = null
                {
                    if nl.single <> null
                        return (1 - (nl.start as int)) = 0
                    return true
                }
                let m nl.nodes.get_length() as int
                let pfx ELObj.prefix_of(nl.gen, nl.prefix)
                if pfx = null
                    return (m - (nl.start as int)) = 0
                return (pfx[m] - (nl.start as int)) = 0
            }
            else
                return true
        true
    }

    function node_list_prefix(this: ref[ELObj]) returns ref[Array[int]]?
    {
        choose this
            when nl: NodeList
                return ELObj.prefix_of(nl.gen, nl.prefix)
            else
                return null
        null
    }

    ; --- member-level walk (the reference's nodeListChunkRest) --------------
    ; A consumer that does not care about per-character identity iterates
    ; MEMBERS: whole data runs in one step, no view materialized. Positions are
    ; still flat, so `start` may sit INSIDE the first member — node_list_member_
    ; skip reports how many of its characters are already consumed.

    ; number of members from the one holding `start` to the end of the buffer.
    function node_list_member_count(this: ref[ELObj]) returns int
    {
        choose this
            when nl: NodeList
            {
                if nl.gen <> null
                    ELObj.force_gen(nl.gen, 0 - 1, 0 - 1)
                if nl.nodes = null
                {
                    if (nl.single <> null) and ((nl.start as int) < 1)
                        return 1 - (nl.start as int)
                    return 0
                }
                let m nl.nodes.get_length() as int
                let pfx ELObj.prefix_of(nl.gen, nl.prefix)
                if pfx = null
                {
                    if (nl.start as int) >= m
                        return 0
                    return m - (nl.start as int)
                }
                let pb pfx.get_buffer()
                if (nl.start as int) >= *(pb + m)
                    return 0
                return m - ELObj.locate_member(pb, m, (nl.start as int))
            }
            else
                return 0
        0
    }

    ; the k-th member from the one holding `start` (null out of range).
    function node_list_member(this: ref[ELObj], k: int) returns ref[GroveNode]?
    {
        choose this
            when nl: NodeList
            {
                if nl.gen <> null
                {
                    let need (nl.start as int) + k + 1
                    if (nl.nodes.get_length() as int) < need
                        ELObj.force_gen(nl.gen as ref[SelectGen], 0, need)
                }
                if nl.nodes = null
                {
                    let idx (nl.start as int) + k
                    if (nl.single <> null) and (idx = 0)
                        return nl.single
                    return null
                }
                let m nl.nodes.get_length() as int
                var base (nl.start as int)
                let pfx ELObj.prefix_of(nl.gen, nl.prefix)
                if pfx <> null
                {
                    let pb pfx.get_buffer()
                    if (nl.start as int) >= *(pb + m)
                        return null
                    set base: ELObj.locate_member(pb, m, (nl.start as int))
                }
                let idx base + k
                if (idx < 0) or (idx >= m)
                    return null
                return nl.nodes[idx]
            }
            else
                return null
        null
    }

    ; characters of member 0 already consumed by `start` (always 0 for a plain
    ; list, where a member IS one node).
    function node_list_member_skip(this: ref[ELObj]) returns int
    {
        choose this
            when nl: NodeList
            {
                ; an inline singleton has no prefix either, so the existing
                ; null-buffer test already answers it
                if nl.nodes = null
                    return 0
                let pfx ELObj.prefix_of(nl.gen, nl.prefix)
                if pfx = null
                    return 0
                let m nl.nodes.get_length() as int
                let pb pfx.get_buffer()
                if (nl.start as int) >= *(pb + m)
                    return 0
                let k ELObj.locate_member(pb, m, (nl.start as int))
                return (nl.start as int) - *(pb + k)
            }
            else
                return 0
        0
    }

    ; --- sosofos (Inc 4 value model + Inc 5 process kinds) ------------------
    ; an append sosofo (AppendSosofoObj): the ordered concatenation of `parts`.
    function make_sosofo(host: ref[Page], parts: ref[Array[ref[ELObj]?]]) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(SOSO_APPEND, parts, null))
        p
    }

    ; the empty sosofo = an append of zero parts (EmptySosofoObj).
    function make_empty_sosofo(host: ref[Page]) returns ref[ELObj]
    {
        let parts Array[ref[ELObj]?]^host()
        ELObj.make_sosofo(host, parts)
    }

    ; LiteralSosofoObj — emits the characters of `str_obj` (a StringObj), held in aux.
    function make_literal_sosofo(host: ref[Page], str_obj: ref[ELObj]) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(SOSO_LITERAL, null, str_obj))
        p
    }

    ; ProcessChildren[Trim]SosofoObj — processes the current node's children in
    ; `mode` (the reference captures context.processingMode; with-mode changes
    ; it). SosofoObj is locked at kind + two pointers, so the mode rides in the
    ; otherwise-unused `parts` slot — a SLOT PUN, not a module-visibility
    ; workaround: the parameter names ProcessingMode, and only the store into
    ; `parts` casts. Only ProcessContext casts it back; null = the processing
    ; mode at process time (pre-with-mode behavior).
    function make_process_children_sosofo(host: ref[Page], trim: bool, mode: ref[ProcessingMode]?) returns ref[ELObj]
    {
        var k SOSO_PROCESS_CHILDREN
        if trim
            set k: SOSO_PROCESS_CHILDREN_TRIM
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(k, mode as ref[Array[ref[ELObj]?]], null))
        p
    }

    ; ProcessNodeListSosofoObj — processes every node of the node-list held in
    ; aux (captured mode in the parts slot, see above).
    function make_process_node_list_sosofo(host: ref[Page], node_list: ref[ELObj], mode: ref[ProcessingMode]?) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(SOSO_PROCESS_NODE_LIST, mode as ref[Array[ref[ELObj]?]], node_list))
        p
    }

    ; ProcessNodeSosofoObj — processes one node (wrapped as a node-singleton in
    ; aux; captured mode in the parts slot, see above).
    function make_process_node_sosofo(host: ref[Page], node: ref[GroveNode]?, mode: ref[ProcessingMode]?) returns ref[ELObj]
    {
        let nl ELObj.make_node_singleton(host, node)
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(SOSO_PROCESS_NODE, mode as ref[Array[ref[ELObj]?]], nl))
        p
    }

    ; NextMatchSosofoObj — re-enters findMatch at the next lower-specificity rule.
    function make_next_match_sosofo(host: ref[Page]) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(SOSO_NEXT_MATCH, null, null))
        p
    }

    ; PageNumberSosofoObj — fotb.pageNumber() at process time.
    function make_page_number_sosofo(host: ref[Page]) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(SOSO_PAGE_NUMBER, null, null))
        p
    }

    ; CurrentNodePageNumberSosofoObj — fotb.currentNodePageNumber(node); the
    ; node rides as a singleton node-list in aux.
    function make_current_node_page_number_sosofo(host: ref[Page], node: ref[GroveNode]) returns ref[ELObj]
    {
        let nl ELObj.make_node_singleton(host, node)
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(SOSO_CURRENT_NODE_PAGE_NUMBER, null, nl))
        p
    }

    ; PageTypeSosofoObj — processes match/noMatch depending on the page-type
    ; flags in effect (if-first-page / if-front-page).
    function make_page_type_sosofo(host: ref[Page], flag: int, matched: ref[ELObj], no_match: ref[ELObj]) returns ref[ELObj]
    {
        let parts Array[ref[ELObj]?]^host()
        parts.add(matched)
        parts.add(no_match)
        let flag_obj ELObj.make_integer(host, flag)
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(SOSO_PAGE_TYPE, parts, flag_obj))
        p
    }

    ; a FlowObjBox ELObj wrapping a FlowObj (a flow-object-class binding value).
    function make_flowobj_box(host: ref[Page], fo: ref[FlowObj]?) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.FlowObjBox(FlowObjBox(fo))
        p
    }

    ; --- style values (Inc 8) -----------------------------------------------
    ; a VarStyleObj: spec = Style's Array[pointer[InheritedC]] (opaque),
    ; use = the chained style (or null).
    function make_style(host: ref[Page], spec: ref[VarStyleRec]?, use_chain: ref[ELObj]?) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Style(StyleObjRec(spec, use_chain, null))
        p
    }

    ; MergeStyleObj — no specifications of its own, only the parts it
    ; expands to (merge-style).
    function make_merge_style(host: ref[Page], parts: ref[Array[ref[ELObj]?]]) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Style(StyleObjRec(null, null, parts))
        p
    }

    function style_merged(this: ref[ELObj]) returns ref[Array[ref[ELObj]?]]?
    {
        choose this
            when s: Style
                return s.merged
            else
                return null
        null
    }

    function is_style_p(this: ref[ELObj]) returns bool
    {
        choose this
            when s: Style
                return true
            else
                return false
        false
    }

    function style_spec(this: ref[ELObj]) returns ref[VarStyleRec]?
    {
        choose this
            when s: Style
                return s.spec
            else
                return null
        null
    }

    function style_use(this: ref[ELObj]) returns ref[ELObj]?
    {
        choose this
            when s: Style
                return s.use_chain
            else
                return null
        null
    }

    ; --- language values (define-language) ----------------------------------
    function make_language(host: ref[Page], lang: ref[LangObj]) returns ref[ELObj]
    {
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Language(LanguageObj(lang))
        p
    }

    ; the LangObj behind a language value — null for anything else
    ; (ELObj::asLanguage).
    function as_language(this: ref[ELObj]) returns ref[LangObj]?
    {
        choose this
            when l: Language
                return l.lang
            else
                return null
        null
    }

    function is_language_p(this: ref[ELObj]) returns bool
    {
        choose this
            when l: Language
                return true
            else
                return false
        false
    }

    ; LangObj::toUpper / toLower — the language's case map, miss = identity.
    function language_case(this: ref[ELObj], c: u32, up: bool) returns u32
    {
        choose this
            when l: Language
            {
                let lo l.lang
                if up
                    return lo.to_upper(c)
                return lo.to_lower(c)
            }
            else
                return c
        c
    }

    ; SOSO_FLOWOBJ — a transform flow object (MakeExpression result). parts = the
    ; content sosofos (null/empty for atomic); aux = a FlowObjBox wrapping the
    ; FlowObj characteristics (keeps SosofoObj at two pointers).
    function make_flowobj_sosofo(host: ref[Page], fo: ref[FlowObj]?, content: ref[Array[ref[ELObj]?]]?) returns ref[ELObj]
    {
        let box ELObj.make_flowobj_box(host, fo)
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(SOSO_FLOWOBJ, content, box))
        p
    }

    ; LabelSosofoObj — wraps a labeled flow object (label: sym). The content
    ; (the flow-object sosofo) sits in aux; the ctl record (symbol + location)
    ; is smuggled through parts.
    function make_label_sosofo(host: ref[Page], sym: ref[ELObj]?, loc: Location, content: ref[ELObj]?) returns ref[ELObj]
    {
        let ctl SosofoCtlRec.make(host, sym, loc)
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(SOSO_LABEL, ctl as pointer[Array[ref[ELObj]?]], content))
        p
    }

    ; DiscardLabeledSosofoObj — sosofo-discard-labeled. No location is
    ; needed (the reference's ctor takes none), but the ctl record is reused
    ; so the symbol travels the same slot as SOSO_LABEL's.
    function make_discard_labeled_sosofo(host: ref[Page], sym: ref[ELObj], content: ref[ELObj]) returns ref[ELObj]
    {
        let ctl SosofoCtlRec.make(host, sym, Location())
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(SOSO_DISCARD_LABELED, ctl as pointer[Array[ref[ELObj]?]], content))
        p
    }

    ; ContentMapSosofoObj — wraps a flow object's content with a content-map:
    ; value (the ctl record carries the map + location, content in aux).
    function make_content_map_sosofo(host: ref[Page], map: ref[ELObj]?, loc: Location, content: ref[ELObj]?) returns ref[ELObj]
    {
        let ctl SosofoCtlRec.make(host, map, loc)
        let p host.allocate(sizeof ELObj, alignof ELObj) as pointer[ELObj]
        set *p: ELObj.Sosofo(SosofoObj(SOSO_CONTENT_MAP, ctl as pointer[Array[ref[ELObj]?]], content))
        p
    }

    ; the ctl record of a SOSO_LABEL / SOSO_CONTENT_MAP sosofo (parts slot).
    function sosofo_ctl(this: ref[ELObj]) returns ref[SosofoCtlRec]?
    {
        choose this
            when s: Sosofo
                return s.parts as ref[SosofoCtlRec]
            else
                return null
        null
    }

    function is_sosofo_p(this: ref[ELObj]) returns bool
    {
        choose this
            when s: Sosofo
                return true
            else
                return false
        false
    }

    function sosofo_parts(this: ref[ELObj]) returns ref[Array[ref[ELObj]?]]?
    {
        choose this
            when s: Sosofo
                return s.parts
            else
                return null
        null
    }

    function sosofo_kind(this: ref[ELObj]) returns int
    {
        choose this
            when s: Sosofo
                return s.kind
            else
                return 0 - 1
        0 - 1
    }

    ; the kind-specific ELObj payload (string / node-list / node-singleton).
    function sosofo_aux(this: ref[ELObj]) returns ref[ELObj]?
    {
        choose this
            when s: Sosofo
                return s.aux
            else
                return null
        null
    }

    ; the flow-object characteristics of a SOSO_FLOWOBJ sosofo (the FlowObjBox
    ; wrapped in the `aux` slot).
    function sosofo_flowobj(this: ref[ELObj]) returns ref[FlowObj]?
    {
        choose this
            when s: Sosofo
            {
                if s.aux = null
                    return null
                return s.aux.flowobj_box_ref()
            }
            else
                return null
        null
    }

    ; the FlowObj pointer inside a FlowObjBox (null if not a box).
    function flowobj_box_ref(this: ref[ELObj]) returns ref[FlowObj]?
    {
        choose this
            when b: FlowObjBox
                return b.fo
            else
                return null
        null
    }

    ; --- continuation state (call/cc) --------------------------------------
    ; ContinuationObj::set(stackSize, controlStackSize) — record the capture.
    function continuation_set(this: ref[ELObj], ss: int, css: int)
    {
        choose this
            when k: Continuation
            {
                var nk k
                set nk.stack_size: ss
                set nk.control_stack_size: css
                set this: ELObj.Continuation(nk)
            }
            else
                return
    }

    function continuation_kill(this: ref[ELObj])
    {
        choose this
            when k: Continuation
            {
                var nk k
                set nk.live: false
                set this: ELObj.Continuation(nk)
            }
            else
                return
    }

    function continuation_live(this: ref[ELObj]) returns bool
    {
        choose this
            when k: Continuation
                return k.live
            else
                return false
        false
    }

    function continuation_read_only(this: ref[ELObj]) returns bool
    {
        choose this
            when k: Continuation
                return k.read_only
            else
                return false
        false
    }

    function continuation_stack_size(this: ref[ELObj]) returns int
    {
        choose this
            when k: Continuation
                return k.stack_size
            else
                return 0
        0
    }

    function continuation_control_stack_size(this: ref[ELObj]) returns int
    {
        choose this
            when k: Continuation
                return k.control_stack_size
            else
                return 0
        0
    }

    ; --- box accessors -----------------------------------------------------
    function box_value(this: ref[ELObj]) returns ref[ELObj]?
    {
        choose this
            when b: Box
                return b.value
            else
                return null
        null
    }

    function box_set_value(this: ref[ELObj], v: ref[ELObj]?)
    {
        choose this
            when b: Box
                set this: ELObj.Box(BoxObj(v, b.read_only))
    }

    function box_is_read_only(this: ref[ELObj]) returns bool
    {
        choose this
            when b: Box
                return b.read_only
            else
                return false
        false
    }

    ; --- function protocol -------------------------------------------------
    ; asFunction != null: a Closure/Primitive/Continuation/apply/cc.
    function is_function(this: ref[ELObj]) returns bool
    {
        choose this
            when c: Closure
                return true
            when p: Primitive
                return true
            when k: Continuation
                return true
            when a: ApplyFn
                return true
            when cc: CallCCFn
                return true
            else
                return false
        false
    }

    function signature_of(this: ref[ELObj]) returns Signature
    {
        choose this
            when c: Closure
                return c.sig
            when p: Primitive
                return p.sig
            when k: Continuation
                return Signature(1, 0, false)
            when a: ApplyFn
                return Signature(2, 0, true)
            when cc: CallCCFn
                return Signature(1, 0, false)
            else
                return Signature(0, 0, false)
        Signature(0, 0, false)
    }

    function n_required_args(this: ref[ELObj]) returns int
        this.signature_of().n_required

    function n_optional_args(this: ref[ELObj]) returns int
        this.signature_of().n_optional

    function n_key_args(this: ref[ELObj]) returns int
        this.signature_of().n_key

    function has_rest_arg(this: ref[ELObj]) returns bool
        this.signature_of().rest_arg

    function primitive_set_ident(this: ref[ELObj], ident: ref[Identifier])
    {
        choose this
            when p: Primitive
                set this: ELObj.Primitive(PrimitiveObj(p.sig, p.prim_id, ident))
    }

    ; makeCallInsn / makeTailCallInsn: primitives compile to a PrimitiveCallInsn
    ; (direct dispatch), everything else to a FunctionCallInsn.
    function make_call_insn(this: ref[ELObj], n_args: int, interp: ref[Interpreter], loc: Location, next: ref[Insn]?) returns ref[Insn]?
    {
        let host interp.get_host()
        choose this
            when p: Primitive
                return Insn.make_primitive_call(host, n_args, this, loc, next)
            else
                return Insn.make_function_call(host, n_args, this, loc, next)
        null
    }

    function make_tail_call_insn(this: ref[ELObj], n_args: int, interp: ref[Interpreter], loc: Location, n_caller_args: int) returns ref[Insn]
        Insn.make_function_tail_call(interp.get_host(), n_args, this, loc, n_caller_args)

    ; primitiveCall dispatch for the Primitive arm.
    function prim_call(this: ref[ELObj], n_args: int, args: pointer[pointer[ELObj]], ctx: ref[VM], interp: ref[Interpreter], loc: Location) returns ref[ELObj]
    {
        choose this
            when p: Primitive
            {
                ; the IDENTIFIER, not a materialised name: dispatch only needs
                ; it to name the primitive in a diagnostic, and building a
                ; StringC here cost a `get_name` plus a 16-byte-wide parameter
                ; on every primitive call in the engine (measured 3.8 % of a
                ; styling run in ELObj::prim_call alone).
                return Primitive.dispatch(p.prim_id, p.ident, n_args, args, ctx, interp, loc)
            }
            else
                return interp.make_error()
        interp.make_error()
    }

    ; FunctionObj::call — dispatch a call to this callable (VM.cs/FunctionObj.cs).
    function call(this: ref[ELObj], vm: ref[VM], loc: Location, next: ref[Insn]?) returns ref[Insn]?
    {
        choose this
            when c: Closure
            {
                vm.need_stack(1)
                let naa vm.get_n_actual_args()
                vm.push_frame(next, naa)
                vm.set_frame_start(vm.get_sp() - naa)
                vm.set_closure(c.display)
                vm.set_protect_closure(this)
                vm.set_closure_loc(loc)
                return c.code
            }
            when p: Primitive
                return this.prim_call_return(vm, loc, next)
            when a: ApplyFn
                return this.apply_call(vm, loc, next, false, 0)
            when cc: CallCCFn
                return this.callcc_call(vm, loc, next, false, 0)
            when k: Continuation
                return this.continuation_call(vm, loc)
            else
            {
                return vm.fail()
            }
        null
    }

    ; CallWithCurrentContinuationPrimitiveObj::call/tailCall — replace the sole
    ; argument (the receiver proc) with a fresh Continuation, invoke it, then
    ; (for closures) record the continuation in its frame via setArgToCC.
    ; ★★★THE `?` ON THIS RETURN IS NOT FREE, AND THE PRICE IS A LINK ERROR.
    ; Measured 2026-08-26 and again 2026-08-28: an NPO return falls through to
    ; `body_may_allocate`, so with the `?` AND an allocating body this function
    ; takes the caller's page, `tail_call` and `call` inherit it, and
    ; `jit_apply` / `jit_function_tail_call` -- which call them -- come out as
    ; `_Z9jit_applyPN4scaly6memory4PageEPvPv` while `&jit_apply` still mangles
    ; the page-LESS name, because the address-of path asks whether a page was
    ; DECLARED, not whether one is needed. `ld: symbol(s) not found` is the
    ; only evidence, and the 2026-08-26 reading of it ("their bodies are
    ; silently dropped") was wrong: the bodies are emitted, under a name
    ; nothing references. The two are pinned to a (void*, void*) C ABI by the
    ; code the JIT generates, so the page would be an ABI break even if the
    ; names agreed -- the link error is the guard.
    ; ★So the `?` is affordable only while the body ALLOCATES NOTHING, which
    ; is why the report below lives in `callcc_not_proc`. Verify the symbol
    ; after touching either: `grep _Z9jit_apply` on the emitted dazzle.ll must
    ; show `PvPv`, not `PN4scaly6memory4PageE`.
    function callcc_call(this: ref[ELObj], vm: ref[VM], loc: Location, next: ref[Insn]?, tail: bool, n_caller_args: int) returns ref[Insn]?
    {
        let f vm.stack_ref(vm.get_sp() - 1)
        if (f = null) or (f.is_function() = false)
        {
            ELObj.callcc_not_proc(vm, loc, f)
            return vm.fail()
        }
        let host vm.get_host()
        let k ELObj.make_continuation(host)
        vm.stack_set(vm.get_sp() - 1, k)
        var insn: ref[Insn]? null
        if tail
            set insn: f.tail_call(vm, loc, n_caller_args)
        else
            set insn: f.call(vm, loc, next)
        f.set_arg_to_cc(vm, k)
        insn
    }

    ; notAProcedure with the primitive's own name, the ordinal 1 and the
    ; printed object (Insn.cxx:1443) — the same MessageType3 shape as
    ; PrimitiveObj::argError, which is why it goes through message3.
    ; ★It is a separate function because reporting ALLOCATES and `callcc_call`
    ; must not -- see the pin above.
    function callcc_not_proc(vm: ref[VM], loc: Location, f: ref[ELObj]?)
    {
        let itp vm.get_interp()
        itp.set_next_location(loc)
        let ihost itp.get_host()
        let os OutputCharStream.make(ihost)
        var printed StringC()
        if f <> null
        {
            f.print(os, itp.get_units_per_inch())
            set printed: os.to_string_c(ihost)
        }
        let nm Interpreter.ascii_string_c(ihost, "call-with-current-continuation")
        itp.message3(InterpreterMessages.notAProcedure(), nm, 1, printed)
    }

    ; FunctionObj::setArgToCC — only a Closure records the continuation.
    function set_arg_to_cc(this: ref[ELObj], vm: ref[VM], k: ref[ELObj])
    {
        choose this
            when c: Closure
                vm.set_closure_arg_to_cc(k)
            else
                return
    }

    ; ContinuationObj::call — restore the captured stack + control stack and
    ; resume with the supplied result (an escape-only, one-shot continuation).
    function continuation_call(this: ref[ELObj], vm: ref[VM], loc: Location) returns ref[Insn]?
    {
        if (this.continuation_live() = false) or this.continuation_read_only()
        {
            ; ContinuationObj::call (Insn.cxx:810) — an escape continuation
            ; invoked after its extent has ended, or a read-only one.
            let itp vm.get_interp()
            itp.set_next_location(loc)
            itp.message0(InterpreterMessages.continuationDead())
            return vm.fail()
        }
        let result vm.stack_ref(vm.get_sp() - 1)
        vm.unwind_control_stack(this.continuation_control_stack_size())
        vm.set_sp(this.continuation_stack_size() - 1)
        FrameMark.pop_unknown()
        let nxt vm.pop_frame()
        vm.need_stack(1)
        let sp2 vm.get_sp()
        vm.stack_set(sp2, result)
        vm.set_sp(sp2 + 1)
        nxt
    }

    function tail_call(this: ref[ELObj], vm: ref[VM], loc: Location, n_caller_args: int) returns ref[Insn]?
    {
        choose this
            when c: Closure
            {
                vm.need_stack(1)
                let n_args vm.get_n_actual_args()
                if n_caller_args > 0
                {
                    let old_frame vm.get_sp() - n_args
                    let new_frame old_frame - n_caller_args
                    var i 0
                    while i < n_args
                    {
                        vm.stack_set(new_frame + i, vm.stack_ref(old_frame + i))
                        set i: i + 1
                    }
                    vm.set_frame_start(new_frame)
                    vm.set_sp(new_frame + n_args)
                }
                else
                    vm.set_frame_start(vm.get_sp() - n_args)
                vm.set_closure(c.display)
                vm.set_protect_closure(this)
                vm.set_closure_loc(loc)
                return c.code
            }
            when p: Primitive
                return this.prim_tail_call(vm, loc, n_caller_args)
            when a: ApplyFn
                return this.apply_call(vm, loc, null, true, n_caller_args)
            when cc: CallCCFn
                return this.callcc_call(vm, loc, null, true, n_caller_args)
            when k: Continuation
                return this.continuation_call(vm, loc)
            else
            {
                return vm.fail()
            }
        null
    }

    ; PrimitiveObj::call — gather args, dispatch, push result.
    function prim_call_return(this: ref[ELObj], vm: ref[VM], loc: Location, next: ref[Insn]?) returns ref[Insn]?
    {
        let naa vm.get_n_actual_args()
        if naa = 0
            vm.need_stack(1)
        let argp vm.get_sp() - naa
        let result this.prim_call(naa, vm.sbase_at(argp), vm, vm.get_interp(), loc)
        vm.stack_set(argp, result)
        vm.set_sp(argp + 1)
        if vm.get_interp().is_error(result)
        {
            return vm.fail()
        }
        next
    }

    ; PrimitiveObj::tailCall — dispatch, pop frame, push result.
    function prim_tail_call(this: ref[ELObj], vm: ref[VM], loc: Location, n_caller_args: int) returns ref[Insn]?
    {
        let naa vm.get_n_actual_args()
        let argp vm.get_sp() - naa
        let result this.prim_call(naa, vm.sbase_at(argp), vm, vm.get_interp(), loc)
        if vm.get_interp().is_error(result)
        {
            return vm.fail()
        }
        vm.set_sp(argp - n_caller_args)
        FrameMark.pop(vm.get_csp(), result as pointer[void])
        let nxt vm.pop_frame()
        vm.need_stack(1)
        vm.stack_set(vm.get_sp(), result)
        vm.set_sp(vm.get_sp() + 1)
        nxt
    }

    ; ApplyPrimitiveObj::call/tailCall — shuffle the arg list onto the stack,
    ; then run an (Tail)Apply against the extracted function.
    function apply_call(this: ref[ELObj], vm: ref[VM], loc: Location, next: ref[Insn]?, tail: bool, n_caller_args: int) returns ref[Insn]?
    {
        if vm.apply_shuffle(loc) = false
            return null
        if tail
            return Insn.exec_tail_apply(vm, n_caller_args, vm.get_n_actual_args(), loc)
        Insn.exec_apply(vm, vm.get_n_actual_args(), loc, next)
    }

    function is_nil(this: ref[ELObj]) returns bool
    {
        choose this
            when n: Nil
                return true
            else
                return false
        false
    }

    function is_pair(this: ref[ELObj]) returns bool
    {
        choose this
            when p: Pair
                return true
            else
                return false
        false
    }

    ; KeywordObj::identifier() — the interned Identifier, or null if not a keyword.
    function keyword_ident(this: ref[ELObj]) returns ref[Identifier]?
    {
        choose this
            when k: Keyword
                return k.ident
            else
                return null
        null
    }

    ; --- type predicates (Primitive.cs) ------------------------------------
    ; ★There is no separate isNumber in the reference: `number?` (IsNumber),
    ; `real?` (IsReal), `number->string` and the scale-NIC conversion are all
    ; literally `realValue(d)` — and realValue is overridden ONLY by
    ; IntegerObj, RealObj and QuantityObj (dimensionless), never by LengthObj
    ; or the unresolved arms. So a LENGTH is not a number: `(number? 1pt)`,
    ; `(number? (* 1pt 1pt))` and `(number->string 1pt)` are #f / #f / an
    ; error. This used to answer true for every numeric-looking arm.
    function is_number(this: ref[ELObj]) returns bool
        this.is_real()

    function is_integer_p(this: ref[ELObj]) returns bool
    {
        choose this
            when i: Int
                return true
            else
                return false
        false
    }

    function is_string_p(this: ref[ELObj]) returns bool
    {
        choose this
            when s: Str
                return true
            when sc: StrCat
                return true
            else
                return false
        false
    }

    function is_symbol_p(this: ref[ELObj]) returns bool
    {
        choose this
            when s: Symbol
                return true
            else
                return false
        false
    }

    function is_char_p(this: ref[ELObj]) returns bool
    {
        choose this
            when c: Chr
                return true
            else
                return false
        false
    }

    function is_keyword_p(this: ref[ELObj]) returns bool
    {
        choose this
            when k: Keyword
                return true
            else
                return false
        false
    }

    function is_vector_p(this: ref[ELObj]) returns bool
    {
        choose this
            when v: Vec
                return true
            else
                return false
        false
    }

    ; VectorObj::size() — element count (0 for a non-vector).
    function vector_length(this: ref[ELObj]) returns size_t
    {
        choose this
            when v: Vec
                return v.n
            else
                return 0 as size_t
        0 as size_t
    }

    ; VectorObj::operator[] read — caller must bounds-check first.
    function vector_elem(this: ref[ELObj], i: size_t) returns ref[ELObj]?
    {
        choose this
            when v: Vec
                return *(v.elems + i)
            else
                return null
        null
    }

    ; VectorObj::operator[] write (vector-set!).
    function vector_set_elem(this: ref[ELObj], i: size_t, val: ref[ELObj]?)
    {
        choose this
            when v: Vec
                set *(v.elems + i): val
            else
                return
    }

    ; KeywordObj::name() — the interned Identifier's name.
    function keyword_name(this: ref[ELObj]) returns StringC
    {
        let id this.keyword_ident()
        if id = null
            return StringC()
        id.get_name()
    }

    ; #t and #f are the only booleans.
    function is_boolean_p(this: ref[ELObj]) returns bool
    {
        choose this
            when t: True
                return true
            when f: False
                return true
            else
                return false
        false
    }

    ; NilObj: true; PairObj: walks the cdr chain; everything else: false.
    function is_list(this: ref[ELObj]) returns bool
    {
        choose this
            when n: Nil
                return true
            when pr: Pair
            {
                var p pr.cdr
                while p <> null
                {
                    choose *p
                        when n2: Nil
                            return true
                        when p2: Pair
                            set p: p2.cdr
                        else
                            return false
                }
                return true
            }
            else
                return false
        false
    }

    ; Everything is true except #f.
    function is_true(this: ref[ELObj]) returns bool
    {
        choose this
            when f: False
                return false
            else
                return true
        true
    }

    function is_false(this: ref[ELObj]) returns bool
    {
        choose this
            when f: False
                return true
            else
                return false
        false
    }

    ; --- accessors (NULL-sentinel, the opensp lookup convention) -----------
    function get_car(this: ref[ELObj]) returns ref[ELObj]?
    {
        choose this
            when pr: Pair
                return pr.car
            else
                return null
        null
    }

    function get_cdr(this: ref[ELObj]) returns ref[ELObj]?
    {
        choose this
            when pr: Pair
                return pr.cdr
            else
                return null
        null
    }

    ; Arm rebuild in place — the union address (eq?-identity) is unchanged.
    function set_car(this: ref[ELObj], v: ref[ELObj])
    {
        choose this
            when pr: Pair
                set this: ELObj.Pair(PairObj(v, pr.cdr))
    }

    function set_cdr(this: ref[ELObj], v: ref[ELObj]?)
    {
        choose this
            when pr: Pair
                set this: ELObj.Pair(PairObj(pr.car, v))
    }

    ; charValue: the codepoint, or -1 (no codepoint is negative).
    function char_value(this: ref[ELObj]) returns int
    {
        choose this
            when c: Chr
                return c.ch as int
            else
                return 0 - 1
        0 - 1
    }

    ; stringData: chars and strings have it (a char is a 1-char string).
    function has_string_data(this: ref[ELObj]) returns bool
    {
        choose this
            when c: Chr
                return true
            when s: Str
                return true
            when sc: StrCat
                return true
            else
                return false
        false
    }

    ; The string data as a StringC (Chr allocates its 1-char buffer on host;
    ; Str returns a shallow view of its page-resident buffer).
    function string_data(this: ref[ELObj], host: ref[Page]) returns StringC
    {
        choose this
            when c: Chr
            {
                var buf u32[1]
                set *(buf as pointer[u32]): c.ch
                return StringC^host(buf as pointer[u32], 1)
            }
            when s: Str
                return s.str
            when sc: StrCat
            {
                ; flatten once and memoize in place. The scratch fill buffer
                ; goes on the caller's host (transient); the final buffer on
                ; the rope's OWN page — the memoized Str must live exactly as
                ; long as the object itself, and callers pass shorter-lived
                ; hosts (a deeper eval scratch region).
                let n sc.size
                if n = 0
                {
                    set this: ELObj.Str(StringObj(StringC()))
                    return StringC()
                }
                ; the memoised Str goes on the MEMO host: `Page.get(this)`
                ; protects it against BRACKET granularity but not against a frame
                ; mark, because within one region that resolves to the region's
                ; END. With the memo on the run arena the store is a pointer to
                ; something OLDER than this object and needs no publication.
                if Interpreter.memo_is_perm() = false
                    FrameMark.store(this as pointer[void])
                let tmp host.allocate(n * (sizeof u32), alignof u32) as pointer[u32]
                this.strcat_fill(tmp, 0)
                let own Interpreter.memo_host_rope(Page.get(this as pointer[void]))
                let flat StringC^own(tmp, n)
                set this: ELObj.Str(StringObj(flat))
                return flat
            }
            else
                return StringC()
        StringC()
    }

    ; stringData total WITHOUT flattening a rope (string-append/string-length
    ; fast path). Negative when the object carries no string data.
    function string_size(this: ref[ELObj]) returns i64
    {
        choose this
            when c: Chr
                return 1 as i64
            when s: Str
                return s.str.get_size() as i64
            when sc: StrCat
                return sc.size as i64
            else
                return (0 - 1) as i64
        (0 - 1) as i64
    }

    ; flatten walk: write this object's string data at buf+off, return the
    ; advanced offset.
    function strcat_fill(this: ref[ELObj], buf: pointer[u32], off: size_t) returns size_t
    {
        choose this
            when c: Chr
            {
                set *(buf + off): c.ch
                return off + 1
            }
            when s: Str
            {
                let m s.str.get_size()
                var k: size_t 0
                while k < m
                {
                    set *(buf + off + k): s.str.get(k)
                    set k: k + 1
                }
                return off + m
            }
            when sc: StrCat
            {
                let ps sc.parts
                let n ps.get_length()
                let b ps.get_buffer()
                var o off
                var i: size_t 0
                while i < n
                {
                    let part *(b + i)
                    if part <> null
                        set o: part.strcat_fill(buf, o)
                    set i: i + 1
                }
                return o
            }
            else
                return off
        off
    }

    ; collapse a rope in place (consumers that pattern-match the Str arm
    ; directly — printer, is_equal — normalize first).
    procedure normalize_string(this: ref[ELObj])
    {
        choose this
            when sc: StrCat
            {
                ; the object's own region stays the TRANSIENT host here — the
                ; flattened result picks the memo host inside string_data, and
                ; sending the scratch buffer to the run arena too would retain it
                ; for nothing
                let own Page.get(this as pointer[void])
                this.string_data(own)
            }
            else
                return
    }

    function is_exact_integer(this: ref[ELObj]) returns bool
    {
        choose this
            when i: Int
                return true
            else
                return false
        false
    }

    function exact_integer_value(this: ref[ELObj]) returns int
    {
        choose this
            when i: Int
                return i.n
            else
                return 0
        0
    }

    ; realValue: integers and reals; quantities only when dimensionless.
    function is_real(this: ref[ELObj]) returns bool
    {
        choose this
            when i: Int
                return true
            when r: Real
                return true
            when q: Quantity
                return q.dim = 0
            else
                return false
        false
    }

    function real_value(this: ref[ELObj]) returns double
    {
        choose this
            when i: Int
                return i.n as double
            when r: Real
                return r.n
            when q: Quantity
                return q.val
            else
                return 0.0
        0.0
    }

    ; inexactRealValue: reals and dimensionless quantities, NOT integers.
    function is_inexact_real(this: ref[ELObj]) returns bool
    {
        choose this
            when r: Real
                return true
            when q: Quantity
                return q.dim = 0
            else
                return false
        false
    }

    function is_length(this: ref[ELObj]) returns bool
    {
        choose this
            when l: Length
                return true
            else
                return false
        false
    }

    function length_value(this: ref[ELObj]) returns int
    {
        choose this
            when l: Length
                return l.n
            else
                return 0
        0
    }

    ; quantityValue — Int: long dim 0; Real: double dim 0; Length: long
    ; dim 1; Quantity: double with its dim; everything else noQuantity.
    function quantity_value(this: ref[ELObj]) returns QuantityValue
    {
        var qtype QT_NONE
        var lval 0
        var dval 0.0
        var dim 0
        choose this
            when i: Int
            {
                set qtype: QT_LONG
                set lval: i.n
            }
            when r: Real
            {
                set qtype: QT_DOUBLE
                set dval: r.n
            }
            when l: Length
            {
                set qtype: QT_LONG
                set lval: l.n
                set dim: 1
            }
            when q: Quantity
            {
                set qtype: QT_DOUBLE
                set dval: q.val
                set dim: q.dim
            }
        QuantityValue(qtype, lval, dval, dim)
    }

    ; ELObj *resolveQuantities(bool force, Interpreter &, const Location &):
    ; the unresolved-quantity arms resolve through their unit (undefined
    ; unit -> undefinedQuantity + error); everything else IS resolved.
    ; ★A `jit_resolve_quantities` mirrors this function for the JIT's pinned
    ; (void*, void*) C ABI, referenced only by ADDRESS. Changing this
    ; declaration drops that helper from emission SILENTLY -- rc 0, no
    ; diagnostic, and `ld: symbol(s) not found` is the only evidence.
    function resolve_quantities(this: ref[ELObj], force: bool, interp: ref[Interpreter], loc: Location) returns ref[ELObj]?
    {
        choose this
            when ul: UnresolvedLength
            {
                let u ul.unit
                ; the reference gate is Unit::defined (a definition
                ; EXPRESSION counts, not just a computed value — a redefined
                ; builtin sits notComputed until tryCompute).
                var dp: u32 0
                var dl Location()
                if u.defined(&dp, &dl) = false
                {
                    interp.set_next_location(loc)
                    interp.message1(InterpreterMessages.undefinedQuantity(), u.get_name())
                    return interp.make_error()
                }
                return u.resolve_quantity_long(force, interp, ul.val, ul.val_exp)
            }
            when uq: UnresolvedQuantity
            {
                let u uq.unit
                var dp: u32 0
                var dl Location()
                if u.defined(&dp, &dl) = false
                {
                    interp.set_next_location(loc)
                    interp.message1(InterpreterMessages.undefinedQuantity(), u.get_name())
                    return interp.make_error()
                }
                return u.resolve_quantity_double(force, interp, uq.val, uq.unit_exp)
            }
            else
                return this
        this
    }

    ; convertToString: strings themselves, symbols their name, chars their
    ; 1-char string; null otherwise.
    function convert_to_string(this: ref[ELObj], host: ref[Page]) returns ref[ELObj]?
    {
        choose this
            when s: Str
                return this
            when sc: StrCat
                return this
            when sym: Symbol
                return ELObj.make_string(host, sym.name)
            when c: Chr
            {
                var buf u32[1]
                set *(buf as pointer[u32]): c.ch
                let s StringC^host(buf as pointer[u32], 1)
                return ELObj.make_string(host, s)
            }
            else
                return null
        null
    }

    ; --- printer -----------------------------------------------------------
    ; ELObj::print(Interpreter&, OutputCharStream&). Of the Interpreter the
    ; printer only consults unitsPerInch() (Length/Quantity); it is threaded
    ; as a scalar until Inc 3 lands the Interpreter record.
    function print(this: ref[ELObj], os: ref[OutputCharStream], units_per_inch: int)
    {
        this.normalize_string()
        choose this
            when e: Error
                os.put_ascii("#<error>")
            when u: Unspecified
                os.put_ascii("#v")
            when n: Nil
                os.put_ascii("()")
            when t: True
                os.put_ascii("#t")
            when f: False
                os.put_ascii("#f")
            when sym: Symbol
                os.write( Slice[u32](sym.name.data_ptr(), sym.name.get_size()))
            when k: Keyword
            {
                let name k.ident.get_name()
                os.write( Slice[u32](name.data_ptr(), name.get_size()))
                os.put_ascii(":")
            }
            when pr: Pair
            {
                os.put_ascii("(")
                if pr.car <> null
                    pr.car.print(os, units_per_inch)
                var p pr.cdr
                var done false
                while done = false
                {
                    if p = null
                    {
                        os.put_ascii(")")
                        set done: true
                    }
                    else
                    {
                        choose *p
                            when n2: Nil
                            {
                                os.put_ascii(")")
                                set done: true
                            }
                            when p2: Pair
                            {
                                os.put_ascii(" ")
                                if p2.car <> null
                                    p2.car.print(os, units_per_inch)
                                set p: p2.cdr
                            }
                            else
                            {
                                os.put_ascii(" . ")
                                p.print(os, units_per_inch)
                                os.put_ascii(")")
                                set done: true
                            }
                    }
                }
            }
            when v: Vec
            {
                ; the reference's cycle guard: null the slot while printing
                ; it, restore after; a null slot prints #<cycle>.
                os.put_ascii("#(")
                var i: size_t 0
                while i < v.n
                {
                    if i > 0
                        os.put_ascii(" ")
                    let e *(v.elems + i)
                    if e = null
                        os.put_ascii("#<cycle>")
                    if e <> null
                    {
                        set *(v.elems + i): null
                        e.print(os, units_per_inch)
                        set *(v.elems + i): e
                    }
                    set i: i + 1
                }
                os.put_ascii(")")
            }
            when c: Chr
            {
                os.put_ascii("#\\")
                os.put(c.ch)
            }
            when s: Str
            {
                os.put_ascii("\"")
                var i: size_t 0
                let n s.str.get_size()
                while i < n
                {
                    let ch s.str.get(i)
                    if ch = 0x5C
                        os.put_ascii("\\")
                    if ch = 0x22
                        os.put_ascii("\\")
                    os.put(ch)
                    set i: i + 1
                }
                os.put_ascii("\"")
            }
            when i2: Int
                ELObj.print_integer(os, i2.n, 10)
            when r: Real
                ELObj.print_double(os, r.n)
            when l: Length
            {
                ELObj.print_double(os, (l.n as double) * 72.0 / (units_per_inch as double))
                os.put_ascii("pt")
            }
            when q: Quantity
            {
                ELObj.print_double(os, q.val * pow(72.0 / (units_per_inch as double), q.dim as double))
                os.put_ascii("pt")
                ELObj.print_integer(os, q.dim, 10)
            }
            else
            {
                ; ELObj::print default: "#<unknown object <addr>>" — the
                ; unresolved-quantity and glyph-id arms have no printed form.
                os.put_ascii("#<unknown object ")
                ELObj.print_integer(os, (this as size_t) as int, 10)
                os.put_ascii(">")
            }
    }

    ; print(interp, os, radix) — only integers honor the radix.
    function print_radix(this: ref[ELObj], os: ref[OutputCharStream], radix: u32, units_per_inch: int)
    {
        choose this
            when i: Int
                ELObj.print_integer(os, i.n, radix)
            else
                this.print(os, units_per_inch)
    }

    ; IntegerObj::print — magnitude via unsigned wrap (covers INT64_MIN).
    function print_integer(os: ref[OutputCharStream], n: int, radix: u32)
    {
        if n = 0
        {
            os.put_ascii("0")
            return
        }
        var m: size_t 0
        if n < 0
        {
            os.put_ascii("-")
            set m: 0 - (n as size_t)
        }
        if n > 0
            set m: n as size_t
        var buf u8[64]
        var i 0
        let r radix as size_t
        while m <> 0
        {
            let d (m % r) as int
            var c 0x30 + d
            if d >= 10
                set c: 0x61 + d - 10
            set *((buf as pointer[u8]) + i): c as u8
            set i: i + 1
            set m: m / r
        }
        while i > 0
        {
            set i: i - 1
            os.put((*((buf as pointer[u8]) + i)) as u32)
        }
    }

    ; RealObj::print is C's %g (precision 6, trailing zeros stripped,
    ; scientific when exp < -4 or >= 6). Reimplemented here; the corpus
    ; differential gate validates byte-fidelity against the reference.
    function print_double(os: ref[OutputCharStream], x_in: double)
    {
        var x x_in
        if x < 0.0
        {
            os.put_ascii("-")
            set x: 0.0 - x
        }
        if x = 0.0
        {
            os.put_ascii("0")
            return
        }
        ; 6 significant digits: m in [100000, 999999] and decimal exponent e
        var e (floor(log10(x))) as int
        var m (floor((x / pow(10.0, (e - 5) as double)) + 0.5)) as int
        if m >= 1000000
        {
            set m: m / 10
            set e: e + 1
        }
        ; the six digits, most significant first
        var digits u8[6]
        var i 6
        while i > 0
        {
            set i: i - 1
            set *((digits as pointer[u8]) + i): (0x30 + (m % 10)) as u8
            set m: m / 10
        }
        ; strip trailing zeros -> k significant digits (k >= 1)
        var k 6
        while k > 1
        {
            if (*((digits as pointer[u8]) + (k - 1))) <> 0x30
                break
            set k: k - 1
        }
        var use_sci false
        if e < (0 - 4)
            set use_sci: true
        if e >= 6
            set use_sci: true
        if use_sci
        {
            os.put((*(digits as pointer[u8])) as u32)
            if k > 1
            {
                os.put_ascii(".")
                var j 1
                while j < k
                {
                    os.put((*((digits as pointer[u8]) + j)) as u32)
                    set j: j + 1
                }
            }
            os.put_ascii("e")
            var ea e
            if ea < 0
            {
                os.put_ascii("-")
                set ea: 0 - ea
            }
            if ea >= 0
            {
                if e >= 0
                    os.put_ascii("+")
            }
            if ea < 10
                os.put_ascii("0")
            ELObj.print_integer(os, ea, 10)
            return
        }
        if e >= 0
        {
            ; point after e+1 digits; zero-pad when all digits are integral
            var j 0
            while j <= e
            {
                if j < k
                    os.put((*((digits as pointer[u8]) + j)) as u32)
                if j >= k
                    os.put_ascii("0")
                set j: j + 1
            }
            if k > (e + 1)
            {
                os.put_ascii(".")
                while j < k
                {
                    os.put((*((digits as pointer[u8]) + j)) as u32)
                    set j: j + 1
                }
            }
            return
        }
        ; e < 0: 0.<zeros><digits>
        os.put_ascii("0.")
        var z 0 - e - 1
        while z > 0
        {
            os.put_ascii("0")
            set z: z - 1
        }
        var j2 0
        while j2 < k
        {
            os.put((*((digits as pointer[u8]) + j2)) as u32)
            set j2: j2 + 1
        }
    }

    ; --- equality ----------------------------------------------------------
    ; ELObj::equal — pointer identity, then structural isEqual.
    function equal(a: ref[ELObj]?, b: ref[ELObj]?) returns bool
    {
        if a = b
            return true

        ELObj.is_equal(a as ref[ELObj], b as ref[ELObj])
    }

    ; ELObj::eqv — pointer identity, then isEquiv (default: isEqual; Pair
    ; recurses with eqv, Vec is never equivalent).
    function eqv(a: ref[ELObj]?, b: ref[ELObj]?) returns bool
    {
        if a = b
            return true
        ; ★a `choose` SUBJECT may not be an Option -- the arms are the union's
        ; and the wrapper hides them ("unknown variant: Pair"). The identity
        ; test above has already answered the both-null case, so a null here
        ; is simply not equal; the unwrap that follows cannot fire.
        if a = null
            return false
        if b = null
            return false

        choose (a as ref[ELObj])
            when pr: Pair
            {
                choose (b as ref[ELObj])
                    when pb: Pair
                    {
                        if ELObj.eqv(pr.car, pb.car)
                            return ELObj.eqv(pr.cdr, pb.cdr)
                        return false
                    }
                    else
                        return false
                return false
            }
            when v: Vec
                return false
            else
                return ELObj.is_equal(a, b)
        false
    }

    function is_equal(a: ref[ELObj], b: ref[ELObj]) returns bool
    {
        a.normalize_string()
        b.normalize_string()
        choose a
            when k: Keyword
            {
                choose b
                    when kb: Keyword
                        return k.ident = kb.ident
                    else
                        return false
                return false
            }
            when pr: Pair
            {
                ; the reference's recursive FIXME, ported as-is
                choose b
                    when pb: Pair
                    {
                        if ELObj.equal(pr.car, pb.car)
                            return ELObj.equal(pr.cdr, pb.cdr)
                        return false
                    }
                    else
                        return false
                return false
            }
            when v: Vec
            {
                choose b
                    when vb: Vec
                    {
                        if v.n <> vb.n
                            return false
                        var i: size_t 0
                        while i < v.n
                        {
                            if ELObj.equal(*(v.elems + i), *(vb.elems + i)) = false
                                return false
                            set i: i + 1
                        }
                        return true
                    }
                    else
                        return false
                return false
            }
            when c: Chr
            {
                choose b
                    when cb: Chr
                        return c.ch = cb.ch
                    else
                        return false
                return false
            }
            when s: Str
            {
                ; accepts anything with stringData (char or string)
                if b.has_string_data() = false
                    return false
                choose b
                    when sb: Str
                        return s.str.equals(sb.str)
                    when cb: Chr
                    {
                        if s.str.get_size() <> 1
                            return false
                        return s.str.get(0) = cb.ch
                    }
                    else
                        return false
                return false
            }
            when i: Int
            {
                choose b
                    when ib: Int
                        return i.n = ib.n
                    else
                        return false
                return false
            }
            when r: Real
            {
                ; RealObj: other.inexactRealValue == n_
                if b.is_inexact_real() = false
                    return false
                return b.real_value() = r.n
            }
            when l: Length
            {
                let qv b.quantity_value()
                if qv.qtype = QT_LONG
                {
                    if qv.dim = 1
                        return qv.lval = l.n
                    return false
                }
                if qv.qtype = QT_DOUBLE
                {
                    if qv.dim = 1
                        return qv.dval = (l.n as double)
                    return false
                }
                return false
            }
            when q: Quantity
            {
                let qv b.quantity_value()
                if qv.qtype = QT_LONG
                {
                    if qv.dim = q.dim
                        return (qv.lval as double) = q.val
                    return false
                }
                if qv.qtype = QT_DOUBLE
                {
                    if qv.dim = q.dim
                        return qv.dval = q.val
                    return false
                }
                return false
            }
            when g: GlyphId
            {
                ; GlyphIdObj::isEqual — same public id and suffix
                choose b
                    when gb: GlyphId
                    {
                        if g.suffix <> gb.suffix
                            return false
                        return g.pubid.equals(gb.pubid)
                    }
                    else
                        return false
                return false
            }
            else
                return false
        false
    }

    ; --- self-test ---------------------------------------------------------
    function test() returns int
    {
        ; bootstrap the run region (the established test idiom)
        let anchor StringC("x")
        let host Page.get(anchor.data_ptr() as pointer[void])

        ; singletons print
        let nil ELObj.make_nil(host)
        var os OutputCharStream.make(host)
        nil.print(os, 72000)
        if os.is_ascii("()") = false
            return -1

        let t ELObj.make_true(host)
        set os: OutputCharStream.make(host)
        t.print(os, 72000)
        if os.is_ascii("#t") = false
            return -2

        let f ELObj.make_false(host)
        set os: OutputCharStream.make(host)
        f.print(os, 72000)
        if os.is_ascii("#f") = false
            return -3

        if f.is_true()
            return -4

        if t.is_true() = false
            return -5

        let unspec ELObj.make_unspecified(host)
        set os: OutputCharStream.make(host)
        unspec.print(os, 72000)
        if os.is_ascii("#v") = false
            return -6

        ; integers
        let i42 ELObj.make_integer(host, 42)
        set os: OutputCharStream.make(host)
        i42.print(os, 72000)
        if os.is_ascii("42") = false
            return -7

        let neg ELObj.make_integer(host, 0 - 7)
        set os: OutputCharStream.make(host)
        neg.print(os, 72000)
        if os.is_ascii("-7") = false
            return -8

        set os: OutputCharStream.make(host)
        let i255 ELObj.make_integer(host, 255)
        i255.print_radix(os, 16, 72000)
        if os.is_ascii("ff") = false
            return -9

        ; char
        let ca ELObj.make_char(host, 0x41)
        set os: OutputCharStream.make(host)
        ca.print(os, 72000)
        if os.is_ascii("#\\A") = false
            return -10

        if ca.char_value() <> 0x41
            return -11

        if i42.char_value() <> (0 - 1)
            return -12

        ; string with escapes: a"b prints as "a\"b"
        var sbuf u32[3]
        set *(sbuf as pointer[u32]): 0x61
        set *((sbuf as pointer[u32]) + 1): 0x22
        set *((sbuf as pointer[u32]) + 2): 0x62
        let sc StringC(sbuf as pointer[u32], 3)
        let str ELObj.make_string(host, sc)
        set os: OutputCharStream.make(host)
        str.print(os, 72000)
        if os.is_ascii("\"a\\\"b\"") = false
            return -13

        ; symbol + keyword
        let sym ELObj.make_symbol(host, StringC("foo"))
        set os: OutputCharStream.make(host)
        sym.print(os, 72000)
        if os.is_ascii("foo") = false
            return -14

        let ident Identifier.make(host, StringC("use"))
        let kw ELObj.make_keyword(host, ident)
        set os: OutputCharStream.make(host)
        kw.print(os, 72000)
        if os.is_ascii("use:") = false
            return -15

        ; pairs: (1 2), (1 . 2), improper tail
        let one ELObj.make_integer(host, 1)
        let two ELObj.make_integer(host, 2)
        let l2 ELObj.make_pair(host, two, nil)
        let l12 ELObj.make_pair(host, one, l2)
        set os: OutputCharStream.make(host)
        l12.print(os, 72000)
        if os.is_ascii("(1 2)") = false
            return -16

        let dotted ELObj.make_pair(host, one, two)
        set os: OutputCharStream.make(host)
        dotted.print(os, 72000)
        if os.is_ascii("(1 . 2)") = false
            return -17

        if l12.is_list() = false
            return -18

        if dotted.is_list()
            return -19

        if nil.is_list() = false
            return -20

        ; car/cdr + set_car (eq-stable arm rebuild)
        if l12.get_car() <> one
            return -21

        if l12.get_cdr() <> l2
            return -22

        let l12b l12
        l12.set_car(two)
        if l12 <> l12b
            return -23

        if l12.get_car() <> two
            return -24

        l12.set_car(one)

        ; vector print + cycle guard
        let vec ELObj.make_vector(host, 2, nil)
        set os: OutputCharStream.make(host)
        vec.print(os, 72000)
        if os.is_ascii("#(() ())") = false
            return -25

        ; equal? / eqv?
        ; the tail shares the ONE nil — the reference relies on singleton
        ; identity (NilObj has no isEqual; Interpreter.makeNil is unique)
        let l12c ELObj.make_pair(host, one, ELObj.make_pair(host, two, nil))
        if ELObj.equal(l12, l12c) = false
            return -26

        if ELObj.equal(l12, dotted)
            return -27

        if ELObj.eqv(l12, l12) = false
            return -28

        ; reference semantics: PairObj.isEquiv recurses, so structurally
        ; equal pairs of eqv leaves ARE eqv
        if ELObj.eqv(l12, l12c) = false
            return -29

        ; strings: equal? by content, and the char/string asymmetry
        let strb ELObj.make_string(host, sc)
        if ELObj.equal(str, strb) = false
            return -30

        var abuf u32[1]
        set *(abuf as pointer[u32]): 0x41
        let sa ELObj.make_string(host, StringC(abuf as pointer[u32], 1))
        if ELObj.equal(sa, ca) = false
            return -31

        if ELObj.equal(ca, sa)
            return -32

        ; numbers: 2 = 2.0 across is_equal? IntegerObj.isEqual demands Int
        let r2 ELObj.make_real(host, 2.0)
        if ELObj.equal(two, r2)
            return -33

        ; RealObj.isEqual: inexactRealValue of b — integer b has none
        if ELObj.equal(r2, two)
            return -34

        ; reals print (%g)
        set os: OutputCharStream.make(host)
        let r25 ELObj.make_real(host, 2.5)
        r25.print(os, 72000)
        if os.is_ascii("2.5") = false
            return -35

        set os: OutputCharStream.make(host)
        let r3 ELObj.make_real(host, 3.0)
        r3.print(os, 72000)
        if os.is_ascii("3") = false
            return -36

        set os: OutputCharStream.make(host)
        let rml ELObj.make_real(host, 0.001)
        rml.print(os, 72000)
        if os.is_ascii("0.001") = false
            return -37

        set os: OutputCharStream.make(host)
        let rbig ELObj.make_real(host, 10000000000.0)
        rbig.print(os, 72000)
        if os.is_ascii("1e+10") = false
            return -38

        set os: OutputCharStream.make(host)
        let rn ELObj.make_real(host, 0.0 - 123456789.0)
        rn.print(os, 72000)
        if os.is_ascii("-1.23457e+08") = false
            return -39

        ; lengths and quantities: 144000 units at 72000/inch = 144pt
        let len ELObj.make_length(host, 144000)
        set os: OutputCharStream.make(host)
        len.print(os, 72000)
        if os.is_ascii("144pt") = false
            return -40

        let q ELObj.make_quantity(host, 2.0, 2)
        set os: OutputCharStream.make(host)
        q.print(os, 72000)
        if os.is_ascii("2e-06pt2") = false
            return -41

        ; length equality via quantityValue
        let len2 ELObj.make_length(host, 144000)
        let qvd len.quantity_value()
        if qvd.qtype <> QT_LONG
            return -60
        if qvd.lval <> 144000
            return -62
        if qvd.dim <> 1
            return -61
        if ELObj.equal(len, len2) = false
            return -42

        if ELObj.equal(len, two)
            return -43

        ; convertToString
        let cs sym.convert_to_string(host)
        if cs = null
            return -44

        set os: OutputCharStream.make(host)
        cs.print(os, 72000)
        if os.is_ascii("\"foo\"") = false
            return -45

        let cs2 str.convert_to_string(host)
        if cs2 <> str
            return -46

        if sym.has_string_data()
            return -47

        0
    }
}
