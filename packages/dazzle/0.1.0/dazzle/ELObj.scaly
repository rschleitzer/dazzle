; ELObj — the expression-language value model (Style/ELObj.cs, upstream
; ELObj.cxx). The C++ single-inheritance hierarchy (~40 subclasses under
; ELObj) is flattened into ONE union per the established opensp pattern
; (Entity, CodingSystem): arms are standalone records, dispatch is `choose`,
; never casts. Virtual-method dispatch becomes union functions.
;
; Inc-1 scope: the core objects (singletons, symbol, keyword, pair, vector,
; char, string, integer, real, length, quantity), the printer, equal?/eqv?.
; NodeListObj and SosofoObj sub-hierarchies join the union in later
; increments (they need the grove / the style machinery); FunctionObj joins
; with Insn/VM. The interning tables (SymbolObj/KeywordObj identity) live in
; the Interpreter (Inc 3) — Identifier here is the minimal seed it extends.
;
; Reference semantics preserved deliberately:
; - eqv? on strings falls back to content-equality (C# ELObj.isEquiv default
;   delegates to isEqual and StringObj does not override) — NOT R4RS
;   identity; the reference decides.
; - PairObj is_equal/is_equiv recurse (C# carries the same FIXME).
; - StringObj.is_equal accepts a char (stringData), CharObj.is_equal only a
;   char — the asymmetry is the reference's.
; - CharObj print is the raw "#\<char>" (the C# FIXME: no character names).

; libm — fixed-prototype, non-variadic C calls: direct externs per the
; containment rule (no shim needed).
function log10(x: double) returns double extern
function pow(x: double, y: double) returns double extern
function floor(x: double) returns double extern

; ELObj.QuantityType
define QT_NONE: int 0
define QT_LONG: int 1
define QT_DOUBLE: int 2

; quantityValue's three out-params as a small struct (built EXACTLY ONCE per
; return path — emitter constraint on small-struct helpers).
define QuantityValue (qtype: int, lval: int, dval: double, dim: int)
{
    init(qtype: int, lval: int, dval: double, dim: int)
    {
        set this.qtype: qtype
        set this.lval: lval
        set this.dval: dval
        set this.dim: dim
    }

    ; accessors (cross-module reads go through these, per the port field rule).
    function get_qtype(this: QuantityValue) returns int
        qtype

    function get_lval(this: QuantityValue) returns int
        lval

    function get_dval(this: QuantityValue) returns double
        dval

    function get_dim(this: QuantityValue) returns int
        dim
}

; OutputCharStream — Inc-1 minimal: the Str arm only (StrOutputCharStream
; semantics: accumulate Chars in memory). The file/encoding sinks arrive
; with the FOTBuilder increment and write through opensp's CodingSystemKit.
define OutputCharStream (buf: ref[Array[u32]])
{
    function make(host: ref[Page]) returns ref[OutputCharStream]
    {
        let os host.allocate(sizeof OutputCharStream, alignof OutputCharStream) as pointer[OutputCharStream]
        set os.buf: Array[u32]^host()
        os
    }

    function put(this: ref[OutputCharStream], ch: u32)
        this.buf.add(ch)

    function write(this: ref[OutputCharStream], data: Slice[u32])
    {
        var i: size_t 0
        while i < data.length
        {
            this.buf.add(data[i])
            set i: i + 1
        }
    }

    ; Widen an ASCII literal into the sink (print's fixed text).
    function put_ascii(this: ref[OutputCharStream], s: pointer[const_char])
    {
        var p s as pointer[u8]
        while (*p) <> 0
        {
            this.buf.add((*p) as u32)
            set p: p + 1
        }
    }

    function size(this: ref[OutputCharStream]) returns size_t
        this.buf.get_length()

    ; Content comparison against an ASCII literal (test harness).
    function is_ascii(this: ref[OutputCharStream], s: pointer[const_char]) returns bool
    {
        var p s as pointer[u8]
        var i: size_t 0
        let n this.buf.get_length()
        while (*p) <> 0
        {
            if i >= n
                return false

            if (*(this.buf.get_buffer() + i)) <> ((*p) as u32)
                return false

            set p: p + 1
            set i: i + 1
        }
        i = n
    }

    function to_string_c(this: ref[OutputCharStream], host: ref[Page]) returns StringC
        StringC^host(this.buf.get_buffer(), this.buf.get_length())
}

