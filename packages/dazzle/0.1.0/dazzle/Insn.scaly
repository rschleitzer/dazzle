use scaly.memory.Page
use scaly.containers.Array
use opensp.Location.Location
use opensp.StringC.StringC
use dazzle.Escape.Escape
use dazzle.FrameMark.FrameMark
use dazzle.ELObj.ELObj
use dazzle.ELObj.Identifier
use dazzle.ELObj.FlowObj
use dazzle.ELObj.MacroDef
use dazzle.ELObj.OutputCharStream
use dazzle.VM.VM
use dazzle.Interpreter.Interpreter
use dazzle.InterpreterMessages.InterpreterMessages
use dazzle.Style.InheritedC
use dazzle.Style.Convert
use dazzle.Style.DisplayNIC
use dazzle.Style.VarStyleRec
use dazzle.Style.TableNICRec
use dazzle.Style.TableColumnNICRec
use dazzle.Style.TableCellNICRec
use dazzle.Style.RuleNICRec
use dazzle.Style.CharacterNICRec
use dazzle.Grove.GroveNode
use dazzle.Primitive.Primitive
use dazzle.Grove.CN_CHAR

; Insn — the threaded-code instruction set (Style/Insn.cxx, Insn2.cxx). Each
; instruction's execute(vm) mutates the VM stacks and returns its successor
; (null ends the run). The C++ single-inheritance Insn hierarchy is flattened
; into one union per the opensp pattern; dispatch is `choose`. InsnPtr's
; ref-counting is dropped — everything lives on the run arena. The style /
; sosofo / mode instructions (Insn2.cxx: PushMode, SetStyle, SosofoAppend, ...)
; join in later increments; this is the pure-eval core.
;
; Cross-module rule: VM state is reached only through VM's accessors.

; Signature — a callable's argument shape (Insn.cs). keys is the keyword-arg
; Identifier table (null unless nKey > 0).
define Signature
(
    n_required: int
    n_optional: int
    rest_arg: bool
    n_key: int
    keys: pointer[pointer[Identifier]]
)
{
    init(n_required: int, n_optional: int, rest_arg: bool)
    {
        set this.n_required: n_required
        set this.n_optional: n_optional
        set this.rest_arg: rest_arg
        set this.n_key: 0
        set this.keys: null
    }
}

; --- instruction arm records -----------------------------------------------
define ErrorInsn ()
define CondFailInsn (loc: Location)
define CaseFailInsn (loc: Location)
define ConstantInsn (value: pointer[ELObj], next: pointer[Insn])
define ResolveQuantitiesInsn (loc: Location, next: pointer[Insn])
define TestInsn (consequent: pointer[Insn], alternative: pointer[Insn])
define OrInsn (next_test: pointer[Insn], next: pointer[Insn])
define AndInsn (next_test: pointer[Insn], next: pointer[Insn])
define CaseInsn (obj: pointer[ELObj], matched: pointer[Insn], fail: pointer[Insn])
define PopInsn (next: pointer[Insn])
define ConsInsn (next: pointer[Insn])
define AppendInsn (loc: Location, next: pointer[Insn])
define ApplyInsn (n_args: int, loc: Location, next: pointer[Insn])
define TailApplyInsn (n_caller_args: int, n_args: int, loc: Location)
define FrameRefInsn (index: int, next: pointer[Insn])
define StackRefInsn (index: int, frame_index: int, next: pointer[Insn])
define ClosureRefInsn (index: int, next: pointer[Insn])
define TopRefInsn (ident: pointer[Identifier], next: pointer[Insn])
define PopBindingsInsn (n: int, next: pointer[Insn])
define ReturnInsn (total_args: int)
define PrimitiveCallInsn (n_args: int, prim: pointer[ELObj], loc: Location, next: pointer[Insn])
define ClosureInsn (sig: Signature, code: pointer[Insn], display_length: int, next: pointer[Insn])
define FunctionCallInsn (n_args: int, func: pointer[ELObj], loc: Location, next: pointer[Insn])
define FunctionTailCallInsn (n_args: int, func: pointer[ELObj], loc: Location, n_caller_args: int)
define VarargsInsn (sig: Signature, entry_points: pointer[pointer[Insn]], n_entry: int, loc: Location)
define SetKeyArgInsn (offset: int, next: pointer[Insn])
define TestNullInsn (offset: int, if_null: pointer[Insn], if_not_null: pointer[Insn])
define BoxInsn (next: pointer[Insn])
define BoxArgInsn (n: int, next: pointer[Insn])
define BoxStackInsn (n: int, next: pointer[Insn])
define UnboxInsn (next: pointer[Insn])
define SetBoxInsn (n: int, next: pointer[Insn])
define SetImmediateInsn (n: int, next: pointer[Insn])
define CheckInitInsn (ident: pointer[Identifier], loc: Location, next: pointer[Insn])
define StackSetBoxInsn (index: int, frame_index: int, loc: Location, next: pointer[Insn])
define StackSetInsn (index: int, frame_index: int, next: pointer[Insn])
define ClosureSetBoxInsn (index: int, loc: Location, next: pointer[Insn])
define VectorInsn (n: int, next: pointer[Insn])
define ListToVectorInsn (next: pointer[Insn])
; MakeFlowObjInsn — the collapsed `make` (MakeExpression::compile). The value
; stack holds one value per SLOTTED key (KEY_USE/KEY_IGNORE),
; then n_content content sosofos, then n_bound captured display vars (the
; VarStyleInsn capture for lazy IC codes); execute pops them, builds a FlowObj
; + content array, and pushes the SOSO_FLOWOBJ result. Transform classes keep
; the original collapsed shape (key_class null: keys map to the flat FlowObj
; fields). For styled classes (Inc 8) key_class/key_ic carry the compile-time
; keyword classification (Style.KEY_*): NICs convert into the DisplayNIC;
; IC entries live in the prebuilt force_specs/specs arrays (constants +
; VarInheritedC codes, StyleExpression::compile) — KEY_IC_CONST keys have no
; slot; use: chains a style value (CheckStyleInsn semantics inline).
define MakeFlowObjInsn (foc: int, keys: pointer[Array[pointer[Identifier]]], key_class: pointer[Array[int]], nic_code: pointer[void], tnic: pointer[void], dnic: pointer[void], hf_proto: pointer[Array[pointer[ELObj]]], force_specs: pointer[Array[pointer[InheritedC]]], specs: pointer[Array[pointer[InheritedC]]], n_bound: int, n_content: int, has_cm: bool, cm_loc: Location, loc: Location, next: pointer[Insn])
; LabelSosofoInsn (Insn.cxx): stack = [flow-obj sosofo, label value]; a
; non-symbol label is a hard labelNotASymbol error, else the sosofo is
; wrapped in a SOSO_LABEL.
define LabelSosofoInsn (loc: Location, next: pointer[Insn])
; SetNicInsn / SetPseudoNonInheritedCInsn (Insn.cxx): pop a value and set it
; as non-inherited characteristic `ident` on the flow object at the stack top
; (a FlowObjBox during the lazy resolve, the SOSO_FLOWOBJ result on the main
; chain for the cell pseudo NICs). `part` >= 0 = a header/footer sosofo slot;
; `reset_deps` = the SetNonInheritedCInsn actual-deps reset (pseudo skips it).
define SetNicInsn (ident: pointer[Identifier], part: int, reset_deps: bool, loc: Location, next: pointer[Insn])
; MakeStyleInsn — the pure `(style key: val …)` form (VarStyleInsn): stack =
; [use value if any][n_bound display vars]; specs prebuilt like the make.
define MakeStyleInsn (keys: pointer[Array[pointer[Identifier]]], key_class: pointer[Array[int]], force_specs: pointer[Array[pointer[InheritedC]]], specs: pointer[Array[pointer[InheritedC]]], n_bound: int, loc: Location, next: pointer[Insn])
; PushModeInsn / PopModeInsn — with-mode brackets (Insn.cxx): save the VM's
; EvalContext processingMode, switch to `mode` (a ProcessingMode carried as
; pointer[void] — the VM keeps no ProcessingMode import), restore on pop.
define PushModeInsn (mode: pointer[void], next: pointer[Insn])
define PopModeInsn (next: pointer[Insn])
; CheckSosofoInsn (Insn.cxx:1132): the value on top of the stack must be a
; sosofo — otherwise `this context requires a sosofo` at `loc` and the whole
; eval unwinds (sp = 0, no successor), which makes the enclosing construction
; rule an error and hands the node to process-children. The reference wraps
; EVERY content expression of a make in one, and the body of a flow-object
; macro.
define CheckSosofoInsn (loc: Location, next: pointer[Insn])
; UnpackMacroFlowObjInsn (MacroFlowObj.cxx:146) — the entry point of a
; macro's compiled body: pop the macro flow object and push its characteristic
; values as frame slots, then (for a compound macro) its content sosofo. A
; characteristic never set stays NULL, which is what the TestNullInsn chain
; behind this insn reads to substitute the declared default.
define UnpackMacroFlowObjInsn (next: pointer[Insn])

define Insn union
(
    Error: ErrorInsn
    CondFail: CondFailInsn
    CaseFail: CaseFailInsn
    Constant: ConstantInsn
    ResolveQuantities: ResolveQuantitiesInsn
    Test: TestInsn
    Or: OrInsn
    And: AndInsn
    Case: CaseInsn
    Pop: PopInsn
    Cons: ConsInsn
    Append: AppendInsn
    Apply: ApplyInsn
    TailApply: TailApplyInsn
    FrameRef: FrameRefInsn
    StackRef: StackRefInsn
    ClosureRef: ClosureRefInsn
    TopRef: TopRefInsn
    PopBindings: PopBindingsInsn
    Return: ReturnInsn
    PrimitiveCall: PrimitiveCallInsn
    ClosureMk: ClosureInsn
    FunctionCall: FunctionCallInsn
    FunctionTailCall: FunctionTailCallInsn
    Varargs: VarargsInsn
    SetKeyArg: SetKeyArgInsn
    TestNull: TestNullInsn
    Box: BoxInsn
    BoxArg: BoxArgInsn
    BoxStack: BoxStackInsn
    Unbox: UnboxInsn
    SetBox: SetBoxInsn
    SetImmediate: SetImmediateInsn
    CheckInit: CheckInitInsn
    StackSetBox: StackSetBoxInsn
    StackSet: StackSetInsn
    ClosureSetBox: ClosureSetBoxInsn
    Vector: VectorInsn
    ListToVector: ListToVectorInsn
    MakeFlowObj: MakeFlowObjInsn
    LabelSosofo: LabelSosofoInsn
    SetNic: SetNicInsn
    MakeStyle: MakeStyleInsn
    PushMode: PushModeInsn
    PopMode: PopModeInsn
    CheckSosofo: CheckSosofoInsn
    UnpackMacroFlowObj: UnpackMacroFlowObjInsn
)
{
    ; --- isReturn / isPopBindings peephole predicates ----------------------
    function is_return(this: pointer[Insn]) returns bool
    {
        choose *this
            when r: Return
                return true
            else
                return false
        false
    }

    function return_n(this: pointer[Insn]) returns int
    {
        choose *this
            when r: Return
                return r.total_args
            else
                return 0
        0
    }

    function is_pop_bindings(this: pointer[Insn]) returns bool
    {
        choose *this
            when p: PopBindings
                return true
            else
                return false
        false
    }

    function pop_bindings_n(this: pointer[Insn]) returns int
    {
        choose *this
            when p: PopBindings
                return p.n
            else
                return 0
        0
    }

    function pop_bindings_next(this: pointer[Insn]) returns pointer[Insn]
    {
        choose *this
            when p: PopBindings
                return p.next
            else
                return null
        null
    }

    ; --- constructors (arena-hosted) ---------------------------------------
    function alloc(host: pointer[Page]) returns pointer[Insn]
        host.allocate(sizeof Insn, alignof Insn) as pointer[Insn]

    function make_error(host: pointer[Page]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.Error(ErrorInsn())
        p
    }

    function make_cond_fail(host: pointer[Page], loc: Location) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.CondFail(CondFailInsn(loc))
        p
    }

    function make_case_fail(host: pointer[Page], loc: Location) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.CaseFail(CaseFailInsn(loc))
        p
    }

    function make_constant(host: pointer[Page], value: pointer[ELObj], next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.Constant(ConstantInsn(value, next))
        p
    }

    function make_resolve_quantities(host: pointer[Page], loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.ResolveQuantities(ResolveQuantitiesInsn(loc, next))
        p
    }

    function make_test(host: pointer[Page], consequent: pointer[Insn], alternative: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.Test(TestInsn(consequent, alternative))
        p
    }

    function make_or(host: pointer[Page], next_test: pointer[Insn], next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.Or(OrInsn(next_test, next))
        p
    }

    function make_and(host: pointer[Page], next_test: pointer[Insn], next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.And(AndInsn(next_test, next))
        p
    }

    function make_case(host: pointer[Page], obj: pointer[ELObj], matched: pointer[Insn], fail: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.Case(CaseInsn(obj, matched, fail))
        p
    }

    function make_pop(host: pointer[Page], next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.Pop(PopInsn(next))
        p
    }

    function make_cons(host: pointer[Page], next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.Cons(ConsInsn(next))
        p
    }

    function make_append(host: pointer[Page], loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.Append(AppendInsn(loc, next))
        p
    }

    function make_apply(host: pointer[Page], n_args: int, loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.Apply(ApplyInsn(n_args, loc, next))
        p
    }

    function make_tail_apply(host: pointer[Page], n_caller_args: int, n_args: int, loc: Location) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.TailApply(TailApplyInsn(n_caller_args, n_args, loc))
        p
    }

    function make_frame_ref(host: pointer[Page], index: int, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.FrameRef(FrameRefInsn(index, next))
        p
    }

    function make_stack_ref(host: pointer[Page], index: int, frame_index: int, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.StackRef(StackRefInsn(index, frame_index, next))
        p
    }

    function make_closure_ref(host: pointer[Page], index: int, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.ClosureRef(ClosureRefInsn(index, next))
        p
    }

    function make_top_ref(host: pointer[Page], ident: pointer[Identifier], next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.TopRef(TopRefInsn(ident, next))
        p
    }

    function make_return(host: pointer[Page], total_args: int) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.Return(ReturnInsn(total_args))
        p
    }

    function raw_pop_bindings(host: pointer[Page], n: int, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.PopBindings(PopBindingsInsn(n, next))
        p
    }

    ; PopBindingsInsn::make — the peephole: fold into a following Return or
    ; PopBindings so the two never chain.
    function make_pop_bindings(host: pointer[Page], n: int, next: pointer[Insn]) returns pointer[Insn]
    {
        if next <> null
        {
            if next.is_return()
                return Insn.make_return(host, n + next.return_n())
            if next.is_pop_bindings()
                return Insn.make_pop_bindings(host, n + next.pop_bindings_n(), next.pop_bindings_next())
        }
        Insn.raw_pop_bindings(host, n, next)
    }

    function make_primitive_call(host: pointer[Page], n_args: int, prim: pointer[ELObj], loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.PrimitiveCall(PrimitiveCallInsn(n_args, prim, loc, next))
        p
    }

    function make_closure_insn(host: pointer[Page], sig: Signature, code: pointer[Insn], display_length: int, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.ClosureMk(ClosureInsn(sig, code, display_length, next))
        p
    }

    function make_function_call(host: pointer[Page], n_args: int, func: pointer[ELObj], loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.FunctionCall(FunctionCallInsn(n_args, func, loc, next))
        p
    }

    function make_function_tail_call(host: pointer[Page], n_args: int, func: pointer[ELObj], loc: Location, n_caller_args: int) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.FunctionTailCall(FunctionTailCallInsn(n_args, func, loc, n_caller_args))
        p
    }

    function make_varargs(host: pointer[Page], sig: Signature, entry_points: pointer[pointer[Insn]], n_entry: int, loc: Location) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.Varargs(VarargsInsn(sig, entry_points, n_entry, loc))
        p
    }

    function make_set_key_arg(host: pointer[Page], offset: int, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.SetKeyArg(SetKeyArgInsn(offset, next))
        p
    }

    function make_test_null(host: pointer[Page], offset: int, if_null: pointer[Insn], if_not_null: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.TestNull(TestNullInsn(offset, if_null, if_not_null))
        p
    }

    function make_box(host: pointer[Page], next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.Box(BoxInsn(next))
        p
    }

    function make_box_arg(host: pointer[Page], n: int, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.BoxArg(BoxArgInsn(n, next))
        p
    }

    function make_box_stack(host: pointer[Page], n: int, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.BoxStack(BoxStackInsn(n, next))
        p
    }

    function make_unbox(host: pointer[Page], next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.Unbox(UnboxInsn(next))
        p
    }

    function make_set_box(host: pointer[Page], n: int, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.SetBox(SetBoxInsn(n, next))
        p
    }

    function make_set_immediate(host: pointer[Page], n: int, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.SetImmediate(SetImmediateInsn(n, next))
        p
    }

    function make_check_init(host: pointer[Page], ident: pointer[Identifier], loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.CheckInit(CheckInitInsn(ident, loc, next))
        p
    }

    function make_stack_set_box(host: pointer[Page], index: int, frame_index: int, loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.StackSetBox(StackSetBoxInsn(index, frame_index, loc, next))
        p
    }

    function make_stack_set(host: pointer[Page], index: int, frame_index: int, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.StackSet(StackSetInsn(index, frame_index, next))
        p
    }

    function make_closure_set_box(host: pointer[Page], index: int, loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.ClosureSetBox(ClosureSetBoxInsn(index, loc, next))
        p
    }

    function make_vector(host: pointer[Page], n: int, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.Vector(VectorInsn(n, next))
        p
    }

    function make_list_to_vector(host: pointer[Page], next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.ListToVector(ListToVectorInsn(next))
        p
    }

    function make_flow_obj(host: pointer[Page], foc: int, keys: pointer[Array[pointer[Identifier]]], key_class: pointer[Array[int]], nic_code: pointer[void], tnic: pointer[void], dnic: pointer[void], hf_proto: pointer[Array[pointer[ELObj]]], force_specs: pointer[Array[pointer[InheritedC]]], specs: pointer[Array[pointer[InheritedC]]], n_bound: int, n_content: int, has_cm: bool, cm_loc: Location, loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.MakeFlowObj(MakeFlowObjInsn(foc, keys, key_class, nic_code, tnic, dnic, hf_proto, force_specs, specs, n_bound, n_content, has_cm, cm_loc, loc, next))
        p
    }

    function make_check_sosofo(host: pointer[Page], loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.CheckSosofo(CheckSosofoInsn(loc, next))
        p
    }

    function make_unpack_macro(host: pointer[Page], next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.UnpackMacroFlowObj(UnpackMacroFlowObjInsn(next))
        p
    }

    function make_label_sosofo_insn(host: pointer[Page], loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.LabelSosofo(LabelSosofoInsn(loc, next))
        p
    }

    function make_set_nic(host: pointer[Page], ident: pointer[Identifier], part: int, reset_deps: bool, loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.SetNic(SetNicInsn(ident, part, reset_deps, loc, next))
        p
    }

    function make_style_insn(host: pointer[Page], keys: pointer[Array[pointer[Identifier]]], key_class: pointer[Array[int]], force_specs: pointer[Array[pointer[InheritedC]]], specs: pointer[Array[pointer[InheritedC]]], n_bound: int, loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.MakeStyle(MakeStyleInsn(keys, key_class, force_specs, specs, n_bound, loc, next))
        p
    }

    function make_push_mode(host: pointer[Page], mode: pointer[void], next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.PushMode(PushModeInsn(mode, next))
        p
    }

    function make_pop_mode(host: pointer[Page], next: pointer[Insn]) returns pointer[Insn]
    {
        let p Insn.alloc(host)
        set *p: Insn.PopMode(PopModeInsn(next))
        p
    }

    ; --- ApplyBaseInsn::decodeArgs -----------------------------------------
    ; Pop the function off the top, validate the arg count against its
    ; signature, and return the function (null on error, having set sp = -1).
    function decode_args(vm: pointer[VM], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let func vm.stack_ref(vm.get_sp() - 1)
        vm.set_sp(vm.get_sp() - 1)
        let itp vm.get_interp()
        if (func = null) or (func.is_function() = false)
        {
            itp.set_next_location(loc)
            if func <> null
            {
                ; callNonFunction with the object printed (ELObjMessageArg)
                let host itp.get_host()
                let os OutputCharStream.make(host)
                func.print(os, itp.get_units_per_inch())
                itp.message1(InterpreterMessages.callNonFunction(), os.to_string_c(host))
            }
            vm.set_sp(0 - 1)
            return null
        }
        let n_req func.n_required_args()
        if n_args < n_req
        {
            itp.set_next_location(loc)
            itp.message0(InterpreterMessages.missingArg())
            vm.set_sp(0 - 1)
            return null
        }
        if n_args - n_req > func.n_optional_args()
        {
            if func.n_key_args() > 0
            {
                if ((n_args - n_req - func.n_optional_args()) % 2) = 1
                {
                    itp.set_next_location(loc)
                    itp.message0(InterpreterMessages.oddKeyArgs())
                    vm.set_sp(vm.get_sp() - ((n_args - n_req) - func.n_optional_args()))
                }
            }
            else if func.has_rest_arg() = false
            {
                itp.set_next_location(loc)
                itp.message0(InterpreterMessages.tooManyArgs())
                vm.set_sp(vm.get_sp() - ((n_args - n_req) - func.n_optional_args()))
            }
        }
        func
    }

    ; ApplyInsn::execute / TailApplyInsn::execute, factored so ApplyFn can
    ; reuse them.
    function exec_apply(vm: pointer[VM], n_args: int, loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        let func Insn.decode_args(vm, n_args, loc)
        vm.set_n_actual_args(n_args)
        if func <> null
            return func.call(vm, loc, next)
        null
    }

    function exec_tail_apply(vm: pointer[VM], n_caller_args: int, n_args: int, loc: Location) returns pointer[Insn]
    {
        let func Insn.decode_args(vm, n_args, loc)
        vm.set_n_actual_args(n_args)
        if func <> null
            return func.tail_call(vm, loc, n_caller_args)
        null
    }

    ; --- the execution loop body -------------------------------------------
    function execute(this: pointer[Insn], vm: pointer[VM]) returns pointer[Insn]
    {
        choose *this
            when e: Error
            {
                vm.set_sp(0 - 1)
                return null
            }
            when cf: CondFail
            {
                ; CondFailInsn::execute: report at the cond expression, then die.
                let itp vm.get_interp()
                itp.set_next_location(cf.loc)
                itp.message0(InterpreterMessages.condFail())
                vm.set_sp(0 - 1)
                return null
            }
            when csf: CaseFail
            {
                ; CaseFailInsn::execute: report the unmatched key (printed via
                ; ELObjMessageArg — a string key renders with its own quotes
                ; inside the formatter's, `""addhistory""`).
                let itp vm.get_interp()
                itp.set_next_location(csf.loc)
                let sp vm.get_sp()
                let k vm.stack_ref(sp - 1)
                let host itp.get_host()
                let os OutputCharStream.make(host)
                k.print(os, itp.get_units_per_inch())
                let ks os.to_string_c(host)
                itp.message1(InterpreterMessages.caseFail(), ks)
                vm.set_sp(0 - 1)
                return null
            }
            when co: Constant
            {
                vm.need_stack(1)
                vm.stack_set(vm.get_sp(), co.value)
                vm.set_sp(vm.get_sp() + 1)
                return co.next
            }
            when rq: ResolveQuantities
            {
                let sp vm.get_sp()
                let top vm.stack_ref(sp - 1)
                let itp vm.get_interp()
                let tem top.resolve_quantities(true, itp, rq.loc)
                if itp.is_error(tem)
                {
                    vm.set_sp(0 - 1)
                    return null
                }
                vm.stack_set(sp - 1, tem)
                return rq.next
            }
            when ti: Test
            {
                let was_true vm.stack_ref(vm.get_sp() - 1).is_true()
                vm.set_sp(vm.get_sp() - 1)
                if was_true
                    return ti.consequent
                return ti.alternative
            }
            when oi: Or
            {
                if vm.stack_ref(vm.get_sp() - 1).is_true()
                    return oi.next
                vm.set_sp(vm.get_sp() - 1)
                return oi.next_test
            }
            when an: And
            {
                if vm.stack_ref(vm.get_sp() - 1).is_true() = false
                    return an.next
                vm.set_sp(vm.get_sp() - 1)
                return an.next_test
            }
            when ca: Case
            {
                if ELObj.eqv(vm.stack_ref(vm.get_sp() - 1), ca.obj)
                {
                    vm.set_sp(vm.get_sp() - 1)
                    return ca.matched
                }
                return ca.fail
            }
            when po: Pop
            {
                vm.set_sp(vm.get_sp() - 1)
                return po.next
            }
            when cn: Cons
            {
                let sp vm.get_sp()
                let a vm.stack_ref(sp - 1)
                let d vm.stack_ref(sp - 2)
                let hp vm.get_host()
                Escape.tick(this, vm.get_interp())
                let pr ELObj.make_pair(hp, a, d)
                Escape.tock(vm.get_interp())
                vm.stack_set(sp - 2, pr)
                vm.set_sp(sp - 1)
                return cn.next
            }
            when ap: Append
                return this.exec_append(vm, ap.loc, ap.next)
            when ai: Apply
                return Insn.exec_apply(vm, ai.n_args, ai.loc, ai.next)
            when ta: TailApply
                return Insn.exec_tail_apply(vm, ta.n_caller_args, ta.n_args, ta.loc)
            when fr: FrameRef
            {
                vm.need_stack(1)
                vm.stack_set(vm.get_sp(), vm.stack_ref(vm.get_frame_start() + fr.index))
                vm.set_sp(vm.get_sp() + 1)
                return fr.next
            }
            when sr: StackRef
            {
                vm.need_stack(1)
                vm.stack_set(vm.get_sp(), vm.stack_ref(vm.get_sp() + sr.index))
                vm.set_sp(vm.get_sp() + 1)
                return sr.next
            }
            when cr: ClosureRef
            {
                vm.need_stack(1)
                vm.stack_set(vm.get_sp(), vm.closure_ref(cr.index))
                vm.set_sp(vm.get_sp() + 1)
                return cr.next
            }
            when tr: TopRef
            {
                let tem tr.ident.compute_value(true, vm.get_interp())
                let itp vm.get_interp()
                if (tem = null) or itp.is_error(tem)
                {
                    vm.set_sp(0 - 1)
                    return null
                }
                vm.need_stack(1)
                vm.stack_set(vm.get_sp(), tem)
                vm.set_sp(vm.get_sp() + 1)
                return tr.next
            }
            when pb: PopBindings
            {
                vm.set_sp(vm.get_sp() - pb.n)
                vm.stack_set(vm.get_sp() - 1, vm.stack_ref(vm.get_sp() + pb.n - 1))
                return pb.next
            }
            when ri: Return
            {
                let result vm.stack_ref(vm.get_sp() - 1)
                vm.set_sp(vm.get_sp() - 1 - ri.total_args)
                FrameMark.pop(vm.get_csp(), result as pointer[void])
                let nxt vm.pop_frame()
                vm.stack_set(vm.get_sp(), result)
                vm.set_sp(vm.get_sp() + 1)
                return nxt
            }
            when pc: PrimitiveCall
            {
                if pc.n_args = 0
                    vm.need_stack(1)
                let argp vm.get_sp() - pc.n_args
                ; DAZZLE_ESCAPE_STATS: weigh this site's static verdict by the
                ; bytes the dispatch actually allocates (a no-op otherwise).
                Escape.tick(this, vm.get_interp())
                let result pc.prim.prim_call(pc.n_args, vm.sbase_at(argp), vm, vm.get_interp(), pc.loc)
                Escape.tock(vm.get_interp())
                vm.stack_set(argp, result)
                vm.set_sp(argp + 1)
                if vm.get_interp().is_error(result)
                {
                    vm.set_sp(0 - 1)
                    return null
                }
                return pc.next
            }
            when ci: ClosureMk
                return this.exec_closure(vm, ci.sig, ci.code, ci.display_length, ci.next)
            when fc: FunctionCall
            {
                vm.set_n_actual_args(fc.n_args)
                return fc.func.call(vm, fc.loc, fc.next)
            }
            when ft: FunctionTailCall
            {
                vm.set_n_actual_args(ft.n_args)
                return ft.func.tail_call(vm, ft.loc, ft.n_caller_args)
            }
            when va: Varargs
                return this.exec_varargs(vm, va.sig, va.entry_points, va.n_entry, va.loc)
            when sk: SetKeyArg
            {
                let val vm.stack_ref(vm.get_sp() - 1)
                vm.set_sp(vm.get_sp() - 1)
                vm.stack_set(vm.get_sp() + sk.offset, val)
                return sk.next
            }
            when tn: TestNull
            {
                if vm.stack_ref(vm.get_sp() + tn.offset) = null
                    return tn.if_null
                return tn.if_not_null
            }
            when bx: Box
            {
                vm.stack_set(vm.get_sp() - 1, ELObj.make_box(vm.get_host(), vm.stack_ref(vm.get_sp() - 1)))
                return bx.next
            }
            when ba: BoxArg
            {
                let idx vm.get_sp() + ba.n - vm.get_n_actual_args()
                vm.stack_set(idx, ELObj.make_box(vm.get_host(), vm.stack_ref(idx)))
                return ba.next
            }
            when bs: BoxStack
            {
                let idx vm.get_sp() + bs.n
                vm.stack_set(idx, ELObj.make_box(vm.get_host(), vm.stack_ref(idx)))
                return bs.next
            }
            when ub: Unbox
            {
                vm.stack_set(vm.get_sp() - 1, vm.stack_ref(vm.get_sp() - 1).box_value())
                return ub.next
            }
            when sbx: SetBox
            {
                vm.set_sp(vm.get_sp() - 1)
                let box vm.stack_ref(vm.get_sp() - sbx.n)
                ; a box can belong to any enclosing frame
                FrameMark.publish()
                box.box_set_value(vm.stack_ref(vm.get_sp()))
                return sbx.next
            }
            when si: SetImmediate
            {
                vm.set_sp(vm.get_sp() - 1)
                vm.stack_set(vm.get_sp() - si.n, vm.stack_ref(vm.get_sp()))
                return si.next
            }
            when ck: CheckInit
            {
                if vm.stack_ref(vm.get_sp() - 1) = null
                {
                    vm.get_interp().set_next_location(ck.loc)
                    vm.set_sp(0 - 1)
                    return null
                }
                return ck.next
            }
            when ssb: StackSetBox
            {
                let box vm.stack_ref(vm.get_sp() + ssb.index)
                if box.box_is_read_only()
                {
                    vm.get_interp().set_next_location(ssb.loc)
                    vm.set_sp(0 - 1)
                    return null
                }
                let tem box.box_value()
                FrameMark.publish()
                box.box_set_value(vm.stack_ref(vm.get_sp() - 1))
                vm.stack_set(vm.get_sp() - 1, tem)
                return ssb.next
            }
            when ss: StackSet
            {
                let tem vm.stack_ref(vm.get_sp() + ss.index)
                vm.stack_set(vm.get_sp() + ss.index, vm.stack_ref(vm.get_sp() - 1))
                vm.stack_set(vm.get_sp() - 1, tem)
                return ss.next
            }
            when cs: ClosureSetBox
            {
                let box vm.closure_ref(cs.index)
                if box.box_is_read_only()
                {
                    vm.get_interp().set_next_location(cs.loc)
                    vm.set_sp(0 - 1)
                    return null
                }
                let tem box.box_value()
                FrameMark.publish()
                box.box_set_value(vm.stack_ref(vm.get_sp() - 1))
                vm.stack_set(vm.get_sp() - 1, tem)
                return cs.next
            }
            when ve: Vector
                return this.exec_vector(vm, ve.n, ve.next)
            when lv: ListToVector
                return this.exec_list_to_vector(vm, lv.next)
            when mf: MakeFlowObj
            {
                if mf.key_class <> null
                    return this.exec_make_styled_flow_obj(vm, mf.foc, mf.keys, mf.key_class, mf.nic_code, mf.tnic, mf.dnic, mf.hf_proto, mf.force_specs, mf.specs, mf.n_bound, mf.n_content, mf.has_cm, mf.cm_loc, mf.loc, mf.next)
                if (mf.foc >= FOC_PARAGRAPH) and (mf.foc <= FOC_COLUMN_SET_SEQUENCE)
                    return this.exec_make_styled_flow_obj(vm, mf.foc, mf.keys, mf.key_class, mf.nic_code, mf.tnic, mf.dnic, mf.hf_proto, mf.force_specs, mf.specs, mf.n_bound, mf.n_content, mf.has_cm, mf.cm_loc, mf.loc, mf.next)
                ; a keyless macro make still needs the styled path — that is
                ; where the definition and the characteristic slots are copied
                ; off the compile-time prototype.
                if mf.foc = FOC_MACRO
                    return this.exec_make_styled_flow_obj(vm, mf.foc, mf.keys, mf.key_class, mf.nic_code, mf.tnic, mf.dnic, mf.hf_proto, mf.force_specs, mf.specs, mf.n_bound, mf.n_content, mf.has_cm, mf.cm_loc, mf.loc, mf.next)
                return this.exec_make_flow_obj(vm, mf.foc, mf.keys, mf.n_content, mf.loc, mf.next)
            }
            when lsi: LabelSosofo
                return this.exec_label_sosofo(vm, lsi.loc, lsi.next)
            when sn: SetNic
                return this.exec_set_nic(vm, sn.ident, sn.part, sn.reset_deps, sn.loc, sn.next)
            when ms: MakeStyle
                return this.exec_make_style(vm, ms.keys, ms.key_class, ms.force_specs, ms.specs, ms.n_bound, ms.loc, ms.next)
            when pm: PushMode
            {
                vm.push_mode(pm.mode)
                return pm.next
            }
            when qm: PopMode
            {
                vm.pop_mode()
                return qm.next
            }
            when cs2: CheckSosofo
            {
                let top vm.stack_ref(vm.get_sp() - 1)
                var ok false
                if top <> null
                {
                    if top.is_sosofo_p()
                        set ok: true
                }
                if ok = false
                {
                    vm.set_sp(0 - 1)
                    let interp vm.get_interp()
                    interp.set_next_location(cs2.loc)
                    interp.message0(InterpreterMessages.sosofoContext())
                    return null
                }
                return cs2.next
            }
            when um: UnpackMacroFlowObj
                return this.exec_unpack_macro(vm, um.next)
            else
                return null
        null
    }

    ; MakeFlowObjInsn::execute — the transform `make`. The value stack holds the
    ; n_key characteristic values followed by n_content content sosofos; build a
    ; FlowObj from the characteristics, collect the content into an array, and
    ; push a SOSO_FLOWOBJ result. (No inherited-C / style machinery — extension
    ; flow objects only, the transform backend's whole surface.)
    function exec_make_flow_obj(this: pointer[Insn], vm: pointer[VM], foc: int, keys: pointer[Array[pointer[Identifier]]], n_content: int, loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        let host vm.get_host()
        var n_key 0
        if keys <> null
            set n_key: keys.get_length() as int
        let total n_key + n_content
        if total = 0
            vm.need_stack(1)
        let base vm.get_sp() - total

        ; characteristics: base .. base+n_key-1
        let fo: pointer[FlowObj] FlowObj.make(host, foc)
        var i 0
        while i < n_key
        {
            let kp keys.get(i as size_t)
            let val vm.stack_ref(base + i)
            if kp <> null
            {
                let ki *kp
                let key ki.get_name()
                if key.equals(StringC("attributes"))
                {
                    let al Insn.flow_obj_atts(host, val)
                    fo.set_atts(al)
                }
                else
                {
                    if val <> null
                    {
                        let vs val.string_data(host)
                        fo.set_char(host, key, vs)
                    }
                }
            }
            set i: i + 1
        }

        ; content sosofos: base+n_key .. base+total-1
        var content: pointer[Array[pointer[ELObj]]] null
        if n_content > 0
        {
            set content: Array[pointer[ELObj]]^host()
            var j 0
            while j < n_content
            {
                content.add(vm.stack_ref(base + n_key + j))
                set j: j + 1
            }
        }
        else
        {
            ; SetDefaultContentInsn — a compound flow object with no content
            ; defaults to (process-children) in the current processing mode;
            ; outside processing that is a hard error.
            if FlowObj.is_atomic_class(foc) = false
            {
                let interp vm.get_interp()
                let pmode vm.get_processing_mode()
                if pmode = null
                {
                    interp.set_next_location(loc)
                    interp.message0(InterpreterMessages.noCurrentProcessingMode())
                    vm.set_sp(0 - 1)
                    return null
                }
                set content: Array[pointer[ELObj]]^host()
                content.add(ELObj.make_process_children_sosofo(host, false, pmode))
            }
        }

        vm.stack_set(base, ELObj.make_flowobj_sosofo(host, fo, content))
        vm.set_sp(base + 1)
        next
    }

    ; the styled `make` (Inc 8): keywords were classified at compile
    ; (Style.KEY_*). Stack = one slot per use:/ignored key (key order),
    ; n_content sosofos, then n_bound captured display vars (the VarStyleInsn
    ; capture, shared by the lazy VarInheritedC codes AND the lazy NIC code).
    ; Constant NIC values were baked into the dnic/tnic/hf prototypes at
    ; compile (applyConstNonInheritedCs); non-constant ones live in nic_code,
    ; evaluated per process by ProcessContext.resolve_nics on a fresh copy.
    ; use: attaches a style chain (CheckStyleInsn: a non-style value is a hard
    ; styleContext error).
    function exec_make_styled_flow_obj(this: pointer[Insn], vm: pointer[VM], foc: int, keys: pointer[Array[pointer[Identifier]]], key_class: pointer[Array[int]], nic_code: pointer[void], tnic_proto: pointer[void], dnic_proto: pointer[void], hf_proto: pointer[Array[pointer[ELObj]]], force_specs: pointer[Array[pointer[InheritedC]]], specs: pointer[Array[pointer[InheritedC]]], n_bound: int, n_content: int, has_cm: bool, cm_loc: Location, loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        let host vm.get_host()
        let interp vm.get_interp()
        var n_key 0
        if keys <> null
            set n_key: keys.get_length() as int
        var n_slots 0
        var k 0
        while k < n_key
        {
            if key_class <> null
            {
                let cp0 key_class.get(k as size_t)
                if cp0 <> null
                {
                    if Insn.key_has_slot(*cp0)
                        set n_slots: n_slots + 1
                }
            }
            set k: k + 1
        }
        ; stack layout: [slots][content][content-map value][bound vars].
        var n_cm 0
        if has_cm
            set n_cm: 1
        let total n_slots + n_content + n_cm + n_bound
        if total = 0
            vm.need_stack(1)
        let base vm.get_sp() - total
        let display Insn.capture_display(vm, host, base + n_slots + n_content + n_cm, n_bound)

        ; a macro make COPIES the compile-time prototype (MacroFlowObj's copy
        ; constructor: shared definition, copied characteristic slots — the
        ; constant values were baked into the prototype by
        ; applyConstNonInheritedCs). For FOC_MACRO the tnic slot of the insn
        ; carries that prototype.
        var fo: pointer[FlowObj] null
        if foc = FOC_MACRO
        {
            let proto tnic_proto as pointer[FlowObj]
            if proto <> null
                set fo: proto.macro_copy(host)
            else
                set fo: FlowObj.make(host, foc)
        }
        else
            set fo: FlowObj.make(host, foc)
        ; the table-family NIC record: a fresh per-exec copy of the compile
        ; prototype (constant keys baked in), or defaults — exec/resolve-time
        ; sets must never mutate the shared insn state.
        if foc = FOC_TABLE
        {
            if tnic_proto <> null
            {
                let tp tnic_proto as pointer[TableNICRec]
                fo.set_tnic(tp.copy(host) as pointer[void])
            }
            else
                fo.set_tnic(TableNICRec.make(host) as pointer[void])
        }
        if foc = FOC_TABLE_COLUMN
        {
            if tnic_proto <> null
            {
                let cp2 tnic_proto as pointer[TableColumnNICRec]
                fo.set_tnic(cp2.copy(host) as pointer[void])
            }
            else
                fo.set_tnic(TableColumnNICRec.make(host) as pointer[void])
        }
        if foc = FOC_TABLE_CELL
        {
            if tnic_proto <> null
            {
                let ep tnic_proto as pointer[TableCellNICRec]
                fo.set_tnic(ep.copy(host) as pointer[void])
            }
            else
                fo.set_tnic(TableCellNICRec.make(host) as pointer[void])
        }
        if foc = FOC_RULE
        {
            if tnic_proto <> null
            {
                let rp2 tnic_proto as pointer[RuleNICRec]
                fo.set_tnic(rp2.copy(host) as pointer[void])
            }
            else
                fo.set_tnic(RuleNICRec.make(host) as pointer[void])
        }
        if ((foc >= FOC_LINK) and (foc <= FOC_COLUMN_SET_SEQUENCE)) or (foc = FOC_LINE_FIELD)
            fo.set_tnic(Convert.copy_fo_nic(foc, tnic_proto, host))
        ; SetImplicitCharInsn (Insn.cxx:1318) — a `character` make takes its
        ; char from the CURRENT NODE's `char` property when no `char:`
        ; characteristic specified one. The reference emits this insn for every
        ; character make (compileNonInheritedCs: gotOne = isCharacter()), right
        ; before the deferred NIC chain. ★No reachable construction rule has a
        ; data-char node as its current node — ProcessContext::processNode
        ; answers charChunk BEFORE it looks for a rule — so this fires only if
        ; some future axis puts one there; it is ported because the class's
        ; whole default behaviour hangs off it.
        if foc = FOC_CHARACTER
        {
            let cnode vm.get_current_node()
            if cnode <> null
            {
                ; (accessOK is the only outcome that yields a value here —
                ; the nonsgml class answers accessNull with a null object.)
                var access 0
                let cv Primitive.node_property_value(host, interp, cnode, CN_CHAR, false, &access)
                if cv <> null
                {
                    let cn fo.get_tnic() as pointer[CharacterNICRec]
                    if cn <> null
                    {
                        let cident interp.lookup(StringC("char"))
                        Convert.set_implicit_char(cn, cv, cident, loc, interp, host)
                    }
                }
            }
        }
        if dnic_proto <> null
        {
            let dp dnic_proto as pointer[DisplayNIC]
            fo.set_dnic(dp.copy(host) as pointer[void])
        }
        if hf_proto <> null
        {
            var hi 0
            while hi < 6
            {
                let hp hf_proto.get(hi as size_t)
                if hp <> null
                {
                    if *hp <> null
                        fo.set_hf(host, hi, *hp)
                }
                set hi: hi + 1
            }
        }
        fo.set_nic_code(nic_code)
        var use_style: pointer[ELObj] null
        var slot 0
        var i 0
        while i < n_key
        {
            var cls KEY_IC_CONST
            if key_class <> null
            {
                let cp key_class.get(i as size_t)
                if cp <> null
                    set cls: *cp
            }
            var val: pointer[ELObj] null
            if Insn.key_has_slot(cls)
            {
                set val: vm.stack_ref(base + slot)
                set slot: slot + 1
            }
            if cls = KEY_USE
            {
                if (val <> null) and val.is_style_p()
                    set use_style: val
                else
                {
                    interp.set_next_location(loc)
                    interp.message0(InterpreterMessages.styleContext())
                    vm.set_sp(0 - 1)
                    return null
                }
            }
            set i: i + 1
        }
        ; the reference make ALWAYS attaches a style (StyleExpression::compile
        ; + SetStyleInsn run unconditionally) — table row/column styles rely
        ; on the non-nullness (a covered cell wraps in <sequence> even for an
        ; empty style).
        let rec VarStyleRec.make(host, force_specs, specs, display, vm.get_current_node() as pointer[void])
        fo.set_style(ELObj.make_style(host, rec as pointer[void], use_style))

        var content: pointer[Array[pointer[ELObj]]] null
        if n_content > 0
        {
            set content: Array[pointer[ELObj]]^host()
            var j 0
            while j < n_content
            {
                content.add(vm.stack_ref(base + n_slots + j))
                set j: j + 1
            }
        }
        else
        {
            ; SetDefaultContentInsn / MakeDefaultContentInsn — a compound flow
            ; object with no content defaults to (process-children) in the
            ; current processing mode; outside processing that is a hard error.
            ; A macro is compound exactly when it declared `#!contents`
            ; (MacroFlowObj::asCompoundFlowObj).
            var compound FlowObj.is_atomic_class(foc) = false
            if foc = FOC_MACRO
            {
                set compound: false
                let mdef fo.get_macro_def()
                if mdef <> null
                    set compound: mdef.is_compound()
            }
            if compound
            {
                let pmode vm.get_processing_mode()
                if pmode = null
                {
                    interp.set_next_location(loc)
                    interp.message0(InterpreterMessages.noCurrentProcessingMode())
                    vm.set_sp(0 - 1)
                    return null
                }
                set content: Array[pointer[ELObj]]^host()
                content.add(ELObj.make_process_children_sosofo(host, false, pmode))
            }
        }
        ; content-map: wraps the (single) content sosofo in a SOSO_CONTENT_MAP
        ; (ContentMapSosofoInsn; the map value evaluated right after the
        ; content, sitting above it on the stack).
        if has_cm
        {
            if content <> null
            {
                let map_val vm.stack_ref(base + n_slots + n_content)
                var inner: pointer[ELObj] null
                if content.get_length() = 1
                {
                    let ip content.get(0)
                    if ip <> null
                        set inner: *ip
                }
                if inner = null
                    set inner: ELObj.make_sosofo(host, content)
                let wrapped ELObj.make_content_map_sosofo(host, map_val, cm_loc, inner)
                set content: Array[pointer[ELObj]]^host()
                content.add(wrapped)
            }
        }

        vm.stack_set(base, ELObj.make_flowobj_sosofo(host, fo, content))
        vm.set_sp(base + 1)
        next
    }

    function key_has_slot(cls: int) returns bool
    {
        if cls = KEY_USE
            return true
        if cls = KEY_IGNORE
            return true
        false
    }

    ; SetNicInsn::execute — pop the value, set it as non-inherited
    ; characteristic on the flow object below it (a FlowObjBox seed during the
    ; lazy resolve; the SOSO_FLOWOBJ make result for the cell pseudo NICs).
    ; Conversion failures message (at the value location) and continue; only
    ; an error VALUE (already unwound by the value code) aborts.
    function exec_set_nic(this: pointer[Insn], vm: pointer[VM], ident: pointer[Identifier], part: int, reset_deps: bool, loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        let host vm.get_host()
        let interp vm.get_interp()
        let sp vm.get_sp()
        let val vm.stack_ref(sp - 1)
        let target vm.stack_ref(sp - 2)
        var fo target.flowobj_box_ref()
        if fo = null
            set fo: target.sosofo_flowobj()
        if reset_deps
            ; SetNonInheritedCInsn resets the actual-* dependency record
            ; before each characteristic.
            vm.reset_actual_deps()
        if fo <> null
        {
            if part >= 0
            {
                ; a header/footer sosofo NIC (SimplePageSequenceFlowObj).
                var ok false
                if val <> null
                {
                    if val.is_sosofo_p()
                        set ok: true
                }
                if ok
                    fo.set_hf(host, part, val)
                else
                    Convert.invalid_value(interp, ident, loc)
            }
            else if fo.get_foc() = FOC_MACRO
            {
                ; MacroFlowObj::setNonInheritedC — straight into the named
                ; characteristic's slot, no conversion and no diagnostic.
                fo.set_charic(ident, val)
            }
            else
            {
                let foc fo.get_foc()
                let sk ident.syntactic_key()
                if Convert.is_transform_nic_name(foc, ident.get_name())
                {
                    ; the SGML-transformation classes' setNIC: `attributes`
                    ; converts a list of ("name" "value") pairs, every other
                    ; name a plain string, straight into its slot. Neither
                    ; conversion diagnoses in the reference
                    ; (value.convertString / convertStringPairList discard
                    ; their result).
                    if ident.get_name().equals(StringC("attributes"))
                        fo.set_atts(Insn.flow_obj_atts(host, val))
                    else
                    {
                        if val <> null
                            fo.set_char(host, ident.get_name(), val.string_data(host))
                    }
                }
                else if Convert.is_table_nic_key(foc, sk)
                {
                    var t fo.get_tnic()
                    Convert.apply_table_nic(foc, &t, sk, val, ident, loc, interp, host)
                    fo.set_tnic(t)
                }
                else if Convert.is_rule_nic_key(foc, sk)
                {
                    var rt fo.get_tnic()
                    Convert.apply_rule_nic(&rt, sk, val, ident, loc, interp, host)
                    fo.set_tnic(rt)
                }
                else if Convert.is_fo_nic_ident(foc, sk, ident)
                {
                    var ft fo.get_tnic()
                    Convert.apply_fo_nic(foc, &ft, sk, val, ident, loc, interp, host)
                    fo.set_tnic(ft)
                }
                else if sk = SK_COALESCE_ID
                {
                    var dn fo.get_dnic() as pointer[DisplayNIC]
                    if dn = null
                    {
                        set dn: DisplayNIC.make(host)
                        fo.set_dnic(dn as pointer[void])
                    }
                    var s StringC()
                    if Convert.convert_string(host, val, &s)
                    {
                        set dn.has_coalesce_id: true
                        set dn.coalesce_id: s
                    }
                    else
                        Convert.invalid_value(interp, ident, loc)
                }
                else
                {
                    var dn2 fo.get_dnic() as pointer[DisplayNIC]
                    if dn2 = null
                    {
                        set dn2: DisplayNIC.make(host)
                        fo.set_dnic(dn2 as pointer[void])
                    }
                    Convert.set_display_nic(dn2, sk, val, ident, loc, interp, host)
                }
            }
        }
        vm.set_sp(sp - 1)
        next
    }

    ; LabelSosofoInsn::execute — stack = [flow-obj sosofo, label value]; a
    ; non-symbol label is a hard labelNotASymbol error (unwind), else the
    ; sosofo is wrapped in a SOSO_LABEL carrying the symbol + location.
    function exec_label_sosofo(this: pointer[Insn], vm: pointer[VM], loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        let host vm.get_host()
        let interp vm.get_interp()
        let sp vm.get_sp()
        let val vm.stack_ref(sp - 1)
        var ok false
        if val <> null
        {
            if val.is_symbol_p()
                set ok: true
        }
        if ok = false
        {
            interp.set_next_location(loc)
            interp.message0(InterpreterMessages.labelNotASymbol())
            vm.set_sp(0 - 1)
            return null
        }
        let target vm.stack_ref(sp - 2)
        let wrapped ELObj.make_label_sosofo(host, val, loc, target)
        vm.stack_set(sp - 2, wrapped)
        vm.set_sp(sp - 1)
        next
    }

    ; VarStyleInsn's display capture: the top n_bound stack values into a
    ; null-terminated array (same shape as a closure display).
    function capture_display(vm: pointer[VM], host: pointer[Page], from: int, n_bound: int) returns pointer[pointer[ELObj]]
    {
        if n_bound <= 0
            return null
        let disp host.allocate(((n_bound + 1) as size_t) * sizeof pointer[ELObj], alignof pointer[ELObj]) as pointer[pointer[ELObj]]
        var i 0
        while i < n_bound
        {
            set *(disp + i): vm.stack_ref(from + i)
            set i: i + 1
        }
        set *(disp + n_bound): null
        disp
    }

    ; MakeStyleInsn::execute — build the style value (VarStyleInsn): stack =
    ; [use value if any][n_bound display vars]; specs prebuilt at compile.
    function exec_make_style(this: pointer[Insn], vm: pointer[VM], keys: pointer[Array[pointer[Identifier]]], key_class: pointer[Array[int]], force_specs: pointer[Array[pointer[InheritedC]]], specs: pointer[Array[pointer[InheritedC]]], n_bound: int, loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        let host vm.get_host()
        let interp vm.get_interp()
        var n_key 0
        if keys <> null
            set n_key: keys.get_length() as int
        var n_slots 0
        var k 0
        while k < n_key
        {
            let cp0 key_class.get(k as size_t)
            if cp0 <> null
            {
                if Insn.key_has_slot(*cp0)
                    set n_slots: n_slots + 1
            }
            set k: k + 1
        }
        let total n_slots + n_bound
        if total = 0
            vm.need_stack(1)
        let base vm.get_sp() - total
        let display Insn.capture_display(vm, host, base + n_slots, n_bound)
        var use_style: pointer[ELObj] null
        var slot 0
        var i 0
        while i < n_key
        {
            var cls KEY_IC_CONST
            let cp key_class.get(i as size_t)
            if cp <> null
                set cls: *cp
            var val: pointer[ELObj] null
            if Insn.key_has_slot(cls)
            {
                set val: vm.stack_ref(base + slot)
                set slot: slot + 1
            }
            if cls = KEY_USE
            {
                if (val <> null) and val.is_style_p()
                    set use_style: val
                else
                {
                    interp.set_next_location(loc)
                    interp.message0(InterpreterMessages.styleContext())
                    vm.set_sp(0 - 1)
                    return null
                }
            }
            set i: i + 1
        }
        var rec: pointer[VarStyleRec] null
        if (specs <> null) or (force_specs <> null)
            set rec: VarStyleRec.make(host, force_specs, specs, display, vm.get_current_node() as pointer[void])
        vm.stack_set(base, ELObj.make_style(host, rec as pointer[void], use_style))
        vm.set_sp(base + 1)
        next
    }

    ; convertStringPairList: a list of ("name" "value") pairs -> a flat StringC
    ; list [name, value, name, value, …] (output_attributes' pairwise walk).
    function flow_obj_atts(host: pointer[Page], val: pointer[ELObj]) returns pointer[Array[StringC]]
    {
        let atts Array[StringC]^host()
        if val = null
            return atts
        var cur val
        while (cur <> null) and (cur.is_nil() = false)
        {
            if cur.is_pair() = false
                break
            let pair cur.get_car()
            if (pair <> null) and pair.is_pair()
            {
                let name_obj pair.get_car()
                var val_obj: pointer[ELObj] null
                let rest pair.get_cdr()
                if (rest <> null) and rest.is_pair()
                    set val_obj: rest.get_car()
                if name_obj <> null
                {
                    let ns name_obj.string_data(host)
                    atts.add(StringC^host(ns.data_ptr(), ns.get_size()))
                }
                else
                    atts.add(StringC())
                if val_obj <> null
                {
                    let vs val_obj.string_data(host)
                    atts.add(StringC^host(vs.data_ptr(), vs.get_size()))
                }
                else
                    atts.add(StringC())
            }
            set cur: cur.get_cdr()
        }
        atts
    }

    ; AppendInsn::execute — splice the list at [sp-1] onto [sp-2].
    function exec_append(this: pointer[Insn], vm: pointer[VM], loc: Location, next: pointer[Insn]) returns pointer[Insn]
    {
        var source vm.stack_ref(vm.get_sp() - 1)
        if (source <> null) and (source.is_nil() = false)
        {
            if source.is_pair() = false
            {
                vm.get_interp().set_next_location(loc)
                vm.set_sp(0 - 1)
                return null
            }
            let host vm.get_host()
            let car0 source.get_car()
            let head ELObj.make_pair(host, car0, null)
            var tail head
            set source: source.get_cdr()
            while (source <> null) and (source.is_nil() = false)
            {
                if source.is_pair() = false
                {
                    vm.get_interp().set_next_location(loc)
                    vm.set_sp(0 - 1)
                    return null
                }
                let carn source.get_car()
                let new_tail ELObj.make_pair(host, carn, null)
                tail.set_cdr(new_tail)
                set tail: new_tail
                set source: source.get_cdr()
            }
            let rest vm.stack_ref(vm.get_sp() - 2)
            tail.set_cdr(rest)
            vm.stack_set(vm.get_sp() - 2, head)
        }
        vm.set_sp(vm.get_sp() - 1)
        next
    }

    ; ClosureInsn::execute — capture the display and build a closure.
    function exec_closure(this: pointer[Insn], vm: pointer[VM], sig: Signature, code: pointer[Insn], display_length: int, next: pointer[Insn]) returns pointer[Insn]
    {
        let host vm.get_host()
        var disp: pointer[pointer[ELObj]] null
        var tem vm.get_sp() - display_length
        if display_length > 0
        {
            set disp: host.allocate(((display_length + 1) as size_t) * sizeof pointer[ELObj], alignof pointer[ELObj]) as pointer[pointer[ELObj]]
            var i 0
            while i < display_length
            {
                set *(disp + i): vm.stack_ref(tem + i)
                set i: i + 1
            }
            set *(disp + display_length): null
        }
        else
        {
            vm.need_stack(1)
            set tem: vm.get_sp()
        }
        vm.stack_set(tem, ELObj.make_closure(host, sig, code, disp))
        vm.set_sp(tem + 1)
        next
    }

    ; UnpackMacroFlowObjInsn::execute + MacroFlowObj::unpack. The seed on the
    ; stack is the macro's SOSO_FLOWOBJ sosofo (this port keeps a flow
    ; object's content in the sosofo, not on the FlowObj, so the seed carries
    ; both halves); it is POPPED and replaced by one frame slot per declared
    ; characteristic plus, for a compound macro, the content sosofo. Several
    ; content sosofos fold into one SOSO_APPEND (the reference's SetContentInsn
    ; already appended them into a single SosofoObj).
    function exec_unpack_macro(this: pointer[Insn], vm: pointer[VM], next: pointer[Insn]) returns pointer[Insn]
    {
        let host vm.get_host()
        let base vm.get_sp() - 1
        let seed vm.stack_ref(base)
        vm.set_sp(base)
        if seed = null
            return next
        let fo seed.sosofo_flowobj()
        if fo = null
            return next
        let def fo.get_macro_def()
        if def = null
            return next
        let n def.n_nics()
        var extra 0
        if def.is_compound()
            set extra: 1
        vm.need_stack(n + extra)
        let vals fo.get_charic_vals()
        var i 0
        while i < n
        {
            var v: pointer[ELObj] null
            if vals <> null
            {
                let vp vals.get(i as size_t)
                if vp <> null
                    set v: *vp
            }
            vm.stack_set(vm.get_sp(), v)
            vm.set_sp(vm.get_sp() + 1)
            set i: i + 1
        }
        if def.is_compound()
        {
            var content: pointer[ELObj] null
            let parts seed.sosofo_parts()
            if parts <> null
            {
                let np parts.get_length()
                if np = 1
                {
                    let p0 parts.get(0)
                    if p0 <> null
                        set content: *p0
                }
                else if np > 1
                    set content: ELObj.make_sosofo(host, parts)
            }
            ; MacroFlowObj::unpack's own fallback — unreachable through a
            ; make (SetDefaultContentInsn already substituted process-children
            ; in the CURRENT mode), kept because the reference has it: the
            ; INITIAL mode, not the current one.
            if content = null
                set content: ELObj.make_process_children_sosofo(host, false, vm.get_interp().initial_processing_mode_ptr())
            vm.stack_set(vm.get_sp(), content)
            vm.set_sp(vm.get_sp() + 1)
        }
        next
    }

    ; VectorInsn::execute — build a vector from the top n stack slots.
    function exec_vector(this: pointer[Insn], vm: pointer[VM], n: int, next: pointer[Insn]) returns pointer[Insn]
    {
        let host vm.get_host()
        if n = 0
        {
            vm.need_stack(1)
            vm.stack_set(vm.get_sp(), ELObj.make_vector_of(host, null, 0))
            vm.set_sp(vm.get_sp() + 1)
            return next
        }
        let buf host.allocate((n as size_t) * sizeof pointer[ELObj], alignof pointer[ELObj]) as pointer[pointer[ELObj]]
        let base vm.get_sp() - n
        var i 0
        while i < n
        {
            set *(buf + i): vm.stack_ref(base + i)
            set i: i + 1
        }
        vm.stack_set(base, ELObj.make_vector_of(host, buf, n as size_t))
        vm.set_sp(base + 1)
        next
    }

    ; ListToVectorInsn::execute — collect a proper list into a vector.
    function exec_list_to_vector(this: pointer[Insn], vm: pointer[VM], next: pointer[Insn]) returns pointer[Insn]
    {
        let host vm.get_host()
        var count 0
        var p vm.stack_ref(vm.get_sp() - 1)
        while (p <> null) and (p.is_nil() = false)
        {
            set count: count + 1
            set p: p.get_cdr()
        }
        var buf: pointer[pointer[ELObj]] null
        if count > 0
            set buf: host.allocate((count as size_t) * sizeof pointer[ELObj], alignof pointer[ELObj]) as pointer[pointer[ELObj]]
        var i 0
        set p: vm.stack_ref(vm.get_sp() - 1)
        while (p <> null) and (p.is_nil() = false)
        {
            set *(buf + i): p.get_car()
            set i: i + 1
            set p: p.get_cdr()
        }
        vm.stack_set(vm.get_sp() - 1, ELObj.make_vector_of(host, buf, count as size_t))
        next
    }

    ; VarargsInsn::execute — dispatch to the entry point for the actual arg
    ; count, consing rest args and matching keywords when the signature has
    ; a rest or key tail.
    function exec_varargs(this: pointer[Insn], vm: pointer[VM], sig: Signature, entry_points: pointer[pointer[Insn]], n_entry: int, loc: Location) returns pointer[Insn]
    {
        let host vm.get_host()
        let n vm.get_n_actual_args() - sig.n_required
        if (sig.rest_arg or (sig.n_key > 0)) and (n > n_entry - 2)
        {
            var rest vm.get_interp().make_nil()
            var i n - (n_entry - 2)
            while i > 0
            {
                vm.set_sp(vm.get_sp() - 1)
                set rest: ELObj.make_pair(host, vm.stack_ref(vm.get_sp()), rest)
                set i: i - 1
            }
            var extra 0
            if sig.rest_arg
                set extra: 1
            vm.need_stack(sig.n_key + extra)
            if sig.rest_arg
            {
                vm.stack_set(vm.get_sp(), rest)
                vm.set_sp(vm.get_sp() + 1)
            }
            if sig.n_key > 0
            {
                var j 0
                while j < sig.n_key
                {
                    vm.stack_set(vm.get_sp() + j, null)
                    set j: j + 1
                }
                var tem rest
                var m n - (n_entry - 2)
                while m > 0
                {
                    let k tem.get_car().keyword_ident()
                    set tem: tem.get_cdr()
                    if k <> null
                    {
                        var jj 0
                        var matched false
                        while jj < sig.n_key
                        {
                            if matched = false
                            {
                                if *(sig.keys + jj) = k
                                {
                                    if vm.stack_ref(vm.get_sp() + jj) = null
                                        vm.stack_set(vm.get_sp() + jj, tem.get_car())
                                    set matched: true
                                }
                            }
                            set jj: jj + 1
                        }
                        ; a keyword the signature doesn't declare is an error
                        ; unless a rest arg swallows it (reference VarargsInsn)
                        if (matched = false) and (sig.rest_arg = false)
                        {
                            let itp vm.get_interp()
                            itp.set_next_location(loc)
                            itp.message1(InterpreterMessages.invalidKeyArg(), k.get_name())
                        }
                    }
                    else
                    {
                        let itp vm.get_interp()
                        itp.set_next_location(loc)
                        itp.message0(InterpreterMessages.keyArgsNotKey())
                    }
                    set tem: tem.get_cdr()
                    set m: m - 2
                }
                vm.set_sp(vm.get_sp() + sig.n_key)
            }
            return *(entry_points + (n_entry - 1))
        }
        *(entry_points + n)
    }
}
