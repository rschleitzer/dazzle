use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.Vector
use scaly.containers.String
use scaly.containers.StringBuilder
use dazzle.Llvm.Llvm
use dazzle.Insn.*
use dazzle.Escape.Escape
use dazzle.FrameMark.FrameMark
use dazzle.VM.VM
use dazzle.ELObj.ELObj
use dazzle.ELObj.ClosureObj
; the hot-arm helpers below reach these three: the identifier a TopRef resolves,
; the interpreter that answers is_error / carries the next location, and the
; Location a primitive call is reported at.
use dazzle.ELObj.Identifier
use dazzle.Interpreter.Interpreter
use opensp.Location.Location

; Jit — Stage 6b: native code generation for the DSSSL engine.
;
; ============================ THE SEAM ====================================
; The engine's evaluator is `VM.eval(insn, display, arg)`, a threaded-code loop
; over the `Insn` graph that `Expression.compile` produces. The JIT does not
; replace that graph — it LOWERS it. The Insn graph is already the engine's
; intermediate representation: stack positions are assigned, boxing decisions
; are made, closures are laid out, and every control transfer is explicit. A
; second front end over `Expression` would have to reproduce all of
; `Expression.compile`'s semantics (varargs entry points, keyword arguments,
; letrec boxing, the 800-line `make`/`style` lowering) and would mean debugging
; port bugs and lowering bugs at once — the sequencing mistake ROADMAP-dazzle.md
; warns about twice. Lowering the IR that already exists is what a JIT backend
; does, and the Insn classes are what that roadmap calls "the best available
; spec for the closure/TCO semantics the JIT must reproduce".
;
; ======================== THE RETURN PROTOCOL =============================
; Every compiled region is
;
;     i64 region(ptr vm)
;
; and answers THE NEXT INSN TO EXECUTE as an integer — exactly what
; `Insn.execute` answers, 0 for "done or failed". One convention, and it carries
; the whole design:
;
;   * ★ an insn arm the code generator does not lower natively is not a hole.
;     It is emitted as `call jit_execute(<that insn>, vm)` followed by a compare
;     against the arm's statically known successors: equal means the interpreter
;     did the step and the region CONTINUES natively at that successor. So a
;     region covers a whole code body from the start, and native lowering of an
;     individual arm is a pure optimisation on top of a correct baseline. That
;     is the only way to land a code generator against a 469-entry ESIS corpus
;     and twelve golden suites: byte-identity does not depend on coverage;
;   * anything the compare does not recognise is RETURNED unchanged — a call
;     into another body, a tail call, a call/cc unwind, an error. The
;     trampoline in `VM.eval` then continues there, in the interpreter's own
;     state. No unwind protocol of our own, and escape-only continuations keep
;     working;
;   * a DSSSL tail call therefore never grows the native stack: it leaves the
;     region, and the trampoline re-enters at the callee. A named-let loop over
;     a node list — THE idiom of these stylesheets — runs in bounded stack
;     without the code generator knowing what a loop is.
;
; What still costs a trampoline turn is a CALL and its RETURN (a hash lookup and
; an indirect call each, ~11 insns per region entry measured). Lowering a
; statically known closure call to a native call, with the callee's answer
; compared against the continuation the caller pushed, is the next rung and needs
; no new protocol — the compare above IS that protocol.
;
; ★ Region entry takes the insn as a second parameter and switches on it, so ANY
; insn of a body is a valid entry: see build_entry for why that is what made the
; JIT worth defaulting to, and note_entry for why only SOME insns get a case.
;
; ========================= CALLING BACK IN ================================
; Generated code reaches this binary's runtime through inttoptr CONSTANTS: the
; address comes from `&helper` in Scaly (widened to any arity 2026-08-06,
; `tests/regress/fn_ptr_nary.scaly`) and is baked into the IR as a literal.
; Resolution by symbol NAME was rejected on purpose: the shipped binary is
; linked with whole-program LTO and `hidden` visibility (tools/link-lto.sh), so
; its Scaly symbols are not dynamically resolvable — a name-based seam would
; work in a debug build and fail in exactly the configuration we ship. Taking
; the address in Scaly also keeps LTO from deleting the helper.
;
; ★ Every helper is a module-level FREE function in this file (a concept method
;   has no address to take) and takes/returns only pointers and integers, so its
;   emitted signature is exactly what the generated `call` declares. A helper
;   that needed a caller page would gain a hidden leading parameter and every
;   argument would shift one slot — silently. `Jit.check_helper_abi` calls ONE
;   helper (`jit_selftest_double`) through the generated signature at session
;   start: the hazard is a property of the CONVENTION, not of an individual
;   helper, so one call through it proves that a module-level free function of
;   pointers and integers still arrives with its arguments in place.
;
; ============================ VM LAYOUT ===================================
; The generated code reads and writes the VM's own fields (sp, sbase, slim,
; frame_start, closure, n_actual_args). Their offsets are MEASURED at session
; start from a probe VM via `&probe.field`, never written down as numbers: a
; field added to `VM` in six months must not silently move the JIT's idea of
; `sp`. `Jit.check_layout` additionally asserts that the measured offsets are
; 8-aligned and inside the struct.
;
; ============================== MEMORY ====================================
; This slice moves the DISPATCH into native code with the value model unchanged
; — the documented 6b entry state ("boxed ELObj values"). The generated code
; allocates nothing of its own: it works on the VM's arena-hosted stacks and
; calls the same helpers the interpreter calls. The frame-as-mini-region rung
; (ROADMAP-dazzle.md, "Memory model") sits on top of this landing.

; ===========================================================================
; Runtime state
;
; `shared`, not `mutable`: the established dazzle convention for a cell written
; once while single-threaded (see GROVE_MGR, and the note there about a
; thread-local global aborting under a JIT-materialised TLV).
; ===========================================================================

; The active session, or null when the engine runs on the interpreter. This is
; the ONLY switch: `--interp` simply never opens a session, so the interpreter
; path is not a mode with its own code — it is the absence of this pointer.
shared JIT_SESSION: pointer[void] null

; Statistics (`--jit-stats`). Counted in the trampoline and the compiler.
shared JIT_N_REGIONS: int 0
shared JIT_N_MODULES: int 0
shared JIT_N_INSNS: int 0
shared JIT_N_NATIVE_INSNS: int 0
; entry points cached on top of the roots (rung 1) — every one of these is a
; region that did NOT have to be compiled a second time.
shared JIT_N_ENTRY_POINTS: int 0
; ★ CPU microseconds spent inside compile_queue (IR building + pass pipeline +
; ORC materialisation). Measured rather than estimated on purpose: the whole
; 2026-08-06 landing hinged on the split between "LLVM is slow" and "the
; generated code is slow", and the first estimate of the per-module cost was
; wrong by 5x. `--jit-stats` prints it, so the split is one run away.
shared JIT_COMPILE_USEC: int 0
shared JIT_N_ENTRIES: int 0
shared JIT_N_INTERP_STEPS: int 0
shared JIT_N_REJECTED: int 0
shared JIT_DUMP: bool false
; ★ The two counters above are PER INSN, i.e. a read-modify-write of a process
; global on the hottest path in the engine — worth measuring, not worth paying
; for when nobody asked. `--jit-stats` turns them on; without it the flag test is
; a load and a not-taken branch.
shared JIT_STATS: bool false

; ★★★ HotSpot threshold: how many times a code body must be ENTERED before it is
; worth compiling. This is THE number of the whole JIT, and it is derived from a
; break-even calculation, not chosen (measured 2026-08-06, after the two rungs):
;
;   * compiling one body costs ~4 ms of LLVM (see JIT_CODEGEN_LEVEL);
;   * the compiled body then runs ~11 % faster than the interpreter — that is the
;     honest size of the dispatch win with the value model unchanged;
;   * so a body pays for itself only after ~4 ms / 0.11 = ~36 ms of interpreted
;     time in it, i.e. a few million insns, i.e. tens of thousands of entries.
;
; Measured against both ends of the range, byte-identical in every row:
;
;   threshold |  a 0.53 s styling run   |  a 13.7 s codegen run
;   ----------|-------------------------|------------------------
;        200  |  0.75 s  (172 regions)  |  13.84 s  (412 regions)
;       5000  |     —                   |  12.73 s  (161 regions)
;      20000  |  0.55 s   (14 regions)  |  12.49 s   (81 regions)
;      50000  |     —                   |  12.58 s   (57 regions)
;
; 20000 is where the short run costs ~4 % and the long run gains ~9 %. A LOWER
; threshold is not "more JIT", it is more LLVM: at 200 the long run compiles five
; times as much code for a WORSE total. Same doctrine as the self-scaling `for`
; driver, which also defers and promotes per site rather than committing on first
; sight — and the same lesson, that the cost of deciding to optimise is part of
; the optimisation.
shared JIT_THRESHOLD: int 20000

; ★★ How many hot bodies go into ONE module. DEFAULT 1 — i.e. no batching — and
; that stays the default even now that rung 1 has made batching SAFE, because the
; premise batching rested on turned out to be false.
;
; The premise was "the LLVM cost is per MODULE and nearly independent of its
; size", from which 540 modules at ~5 ms each explained the whole 2026-08-06 gap.
; Once compile time was actually measured instead of inferred (JIT_COMPILE_USEC),
; the cost turned out to be per FUNCTION: 172 bodies in 172 modules cost 783 ms,
; and the same 128 bodies in ONE module cost 520 ms — 4.6 ms vs 4.1 ms per body.
; Batching buys ~19 %, not 5x. ★The lesson is the older one from this file's own
; history: a per-unit cost inferred from a total is a guess; instrument it.
;
; What DID move the number was rung 1 (see build_entry/queue_body): 540 roots
; became 172 for the same run, because a mid-body insn is now found compiled
; instead of counted and recompiled as a root of its own. That is also what makes
; batch > 1 correct rather than catastrophic — the measured 540 → 2560 root
; explosion at batch 32 is gone. It is simply not worth much.
;
; And batch > 1 keeps one real defect: a partly filled queue is never flushed, so
; a run that never accumulates a full batch compiles NOTHING (measured: batch 32
; at threshold 5000 compiled 0 bodies). With the threshold now at 20000 that is
; the common case, which settles it. The knob stays for measurement.
shared JIT_BATCH: int 1

; The pass pipeline run over each generated module — null means the built-in
; one, which compile_region substitutes. A string literal cannot be a global
; INITIALIZER (only integer constants can), and a function must not RETURN a
; `pointer[const_char]` literal either (CLAUDE.md: it segfaults at first use),
; so the default lives at the one place that uses it. DAZZLE_JIT_PIPELINE
; overrides it (measurement hook).
shared JIT_PIPELINE: pointer[const_char] null

; ★ The LLVM BACKEND opt level for the JIT'd modules (LLVMCodeGenOptLevel);
; DAZZLE_JIT_CODEGEN overrides it. 2 = LLJIT's own default, and it is the right
; default here for a reason worth writing down, because the cheap-looking option
; is a trap. Measured 2026-08-06, per compiled body:
;
;   level 0:  ~1.4 ms of LLVM, generated code ~4 % faster than the interpreter
;   level 2:  ~4.1 ms of LLVM, generated code ~11 % faster
;
; On a SHORT run level 0 wins (less LLVM to amortise), and on the styling
; workload it looked like a 0.72 s vs 1.01 s landslide. On a long run it loses
; outright: the 13.7 s codegen case is 12.5 s at level 2 and 13.2 s at level 0,
; because 7 % of thirteen seconds dwarfs 2.7 ms times eighty bodies. A JIT is for
; the long run — level 0 optimises the case where the JIT should not have engaged
; at all, which is what the HotSpot threshold is for.
shared JIT_CODEGEN_LEVEL: i32 2

; ★ Let a statically known callee PULL its body into the calling region
; (rejoin_callee), so the call becomes a native branch instead of a trampoline
; turn. Measured 2026-08-06 on the 1804-file real-world codegen: 30 % fewer
; trampoline turns (187 M -> 130 M) for 2.2x the IR (1353 -> 3011 insns lowered)
; and 1.75x the LLVM time (230 -> 403 ms) — NET −0.7 % on top of the native arms'
; −0.5 %, i.e. **−1.2 % together**, medians of 7 interleaved runs whose spreads
; barely overlap. On the 0.53 s styling run it is neutral in both directions
; (few enough bodies that neither the turns nor the IR matter).
;
; ★★That is the whole size of it, and the profile says why: `sample` over the
; long run puts the ENTIRE trampoline (`Jit.region_for` + `Jit.step`) at 3.5 %
; and the arm helpers at 4.3 %, against 32 % memory management. Amdahl on 30 %
; of 3.5 % is 1 %. Restricting the rejoin to bodies ALREADY in the region was
; tried and removes the win completely — the static callees here are other
; top-level bodies, not self-recursion (a named let's callee is a runtime
; closure value, so its insn carries no compile-time object at all).
; DAZZLE_JIT_INLINE_CALLEE=0 turns it off, which is how those numbers were taken.
shared JIT_INLINE_CALLEE: bool true

; ===========================================================================
; Runtime helpers called from generated code.
;
; ★ Every one of these must be a module-level FREE function taking and returning
;   only pointers and integers — see the CALLING BACK IN note above. A concept
;   method has no address to take, and anything needing a caller page would shift
;   every argument by one slot silently.
; ===========================================================================

; The universal fallback: run ONE interpreter instruction and answer its
; successor. This is what makes partial coverage correct rather than merely
; incomplete.
function jit_execute(insn: pointer[void], vm: pointer[void]) returns pointer[void]
{
    let i insn as pointer[Insn]
    let v vm as pointer[VM]
    if JIT_STATS
        Jit.count_generic(i)
    i.execute(v, true) as pointer[void]
}

; VM::needStack — may reallocate the value stack, so generated code reloads
; `sbase` after any call to it.
procedure jit_need_stack(vm: pointer[void], n: i64)
{
    let v vm as pointer[VM]
    v.need_stack(n as int)
}

; ELObj::isTrue / eqv as 0/1 integers. i64 rather than the language's `bool`
; (which emits i1) so the generated declaration cannot disagree with the
; emitted one over how a one-bit value travels in a register.
function jit_is_true(v: pointer[void]) returns i64
{
    if v = null
        return 0
    let o v as pointer[ELObj]
    if o.is_true()
        return 1
    0
}

function jit_eqv(a: pointer[void], b: pointer[void]) returns i64
{
    let x a as pointer[ELObj]
    let y b as pointer[ELObj]
    if ELObj.eqv(x, y)
        return 1
    0
}

; BoxInsn / UnboxInsn / ConsInsn: allocation on the VM's host page. None of
; these can fail, so generated code calls them without an error check.
function jit_box(vm: pointer[void], v: pointer[void]) returns pointer[void]
{
    let m vm as pointer[VM]
    ELObj.make_box(m.get_host(), v as pointer[ELObj]) as pointer[void]
}

function jit_box_value(v: pointer[void]) returns pointer[void]
{
    let o v as pointer[ELObj]
    o.box_value() as pointer[void]
}

; ★The insn travels along so the escape analysis' site accounting sees the
; NATIVE path too. Without it the measurement silently covers only the
; interpreted steps — and under the JIT (the default since 2026-08-06) the hot
; bodies are exactly the ones whose bytes matter.
function jit_cons(insn: pointer[void], vm: pointer[void], a: pointer[void], d: pointer[void]) returns pointer[void]
{
    let m vm as pointer[VM]
    let itp m.get_interp()
    Escape.tick(insn as pointer[Insn], itp)
    let r ELObj.make_pair(m.get_host(), a as pointer[ELObj], d as pointer[ELObj]) as pointer[void]
    Escape.tock(itp)
    r
}

; `--jit-stats` is reported from an atexit hook so it covers EVERY exit of the
; CLI (each backend returns from its own tail) and cannot drift out of sync with
; a new one. Declared here with the same signature the stdlib uses
; (`scaly/memory/root_pages.scaly`) rather than reached across the package
; boundary — two declarations of one C function must agree at the ABI level, and
; tests/abi/run.sh checks exactly that.
procedure atexit(cb: pointer[void]) returns i32 extern

; CPU time in MICROSECONDS, through the ctime shim rather than a direct
; `clock()` extern. The old declaration was right for the targets it named and
; said so itself ("1 000 000 on every target this builds for") — Windows breaks
; all three of its assumptions at once: `clock_t` is `long`, i.e. 32-bit there,
; so the value wraps after ~35 minutes; CLOCKS_PER_SEC is 1000, not 1 000 000,
; so the raw number is milliseconds; and clock() measures WALL time since
; process start rather than CPU time. The shim settles width and unit for every
; target; the semantic half is stage 7's, and its state is written down at the
; function in scaly/time/ctime.c rather than left to be rediscovered.
function scaly_time_cpu_usec() returns int extern

procedure jit_stats_atexit()
    Jit.print_stats()

; ===========================================================================
; The HOT-ARM helpers (rung 2, 2026-08-06). Each one is the body of an
; `Insn.execute` arm minus the parts the code generator emits natively, and each
; exists for one reason: an arm reached through `jit_execute` costs TWO calls
; plus the 46-way dispatch (generated code → jit_execute → Insn.execute →
; jump table → arm), while these cost ONE. Measured, the five arms below are
; 57 % of the lowered insns.
;
; ★ Read each against the matching `when` arm of `Insn.execute` — they are
;   transcriptions, and the arm is the specification. The stack arithmetic and
;   the successor comparison stay in the generated code (see emit_native), so
;   what is left here is exactly the part that cannot be expressed in IR: a
;   virtual dispatch on an ELObj, or a message through the Interpreter.
; ===========================================================================

; ReturnInsn's frame pop (VM::popFrame). Everything else in that arm — reading
; the result, the two sp updates, writing the result back — is native.
; ★ The result travels as a second ARGUMENT rather than through an extra
; call: the native Return lowering already has it in a register before it
; calls this, so the frame mark costs nothing here.
function jit_pop_frame(vm: pointer[void], result: pointer[void]) returns pointer[void]
{
    let v vm as pointer[VM]
    FrameMark.pop(v.get_csp(), result)
    v.pop_frame() as pointer[void]
}

; PrimitiveCallInsn::execute, whole. The primitive itself dwarfs the arm's
; bookkeeping, so there is nothing to win by splitting it — the win is the call
; and the dispatch that no longer happen in front of it.
function jit_prim_call(insn: pointer[void], vm: pointer[void]) returns pointer[void]
{
    let i insn as pointer[Insn]
    let v vm as pointer[VM]
    choose *i
        when pc: PrimitiveCall
        {
            if pc.n_args = 0
                v.need_stack(1)
            let argp v.get_sp() - pc.n_args
            let itp v.get_interp()
            Escape.tick(i, itp)
            let result pc.prim.prim_call(pc.n_args, v.sbase_at(argp), v, itp, pc.loc)
            Escape.tock(itp)
            v.stack_set(argp, result)
            v.set_sp(argp + 1)
            if itp.is_error(result)
            {
                return v.fail()
            }
            return pc.next as pointer[void]
        }
        else
            return null
    null
}

; FunctionCallInsn::execute minus `setNActualArgs`, which is one native store.
function jit_function_call(insn: pointer[void], vm: pointer[void]) returns pointer[void]
{
    let i insn as pointer[Insn]
    let v vm as pointer[VM]
    choose *i
        when fc: FunctionCall
            return fc.func.call(v, fc.loc, fc.next) as pointer[void]
        else
            return null
    null
}

; TopRefInsn::execute's value computation. null means "the arm failed" — which
; folds both of the interpreter's failure tests (a null value and an error
; object) into the one comparison the generated code already has to make.
function jit_top_ref_value(insn: pointer[void], vm: pointer[void]) returns pointer[void]
{
    let i insn as pointer[Insn]
    let v vm as pointer[VM]
    choose *i
        when tr: TopRef
        {
            let itp v.get_interp()
            let tem tr.ident.compute_value(true, itp)
            if tem = null
                return null
            if itp.is_error(tem)
                return null
            return tem as pointer[void]
        }
        else
            return null
    null
}

; CheckInitInsn::execute's FAILURE tail only — the test itself is a native
; compare against null, so this is called on the path that ends the run.
function jit_check_init_fail(insn: pointer[void], vm: pointer[void]) returns pointer[void]
{
    let i insn as pointer[Insn]
    let v vm as pointer[VM]
    choose *i
        when ck: CheckInit
            return Insn.check_init_fail(v, ck.ident, ck.loc) as pointer[void]
        else
        {
        }
    v.fail() as pointer[void]
}

; ===========================================================================
; The four arms the DYNAMIC distribution named (rung 3, 2026-08-06). The static
; count said 319 of 1353 lowered insns still took an interpreter step; the
; per-arm histogram (`--jit-stats`) said something else entirely — on the
; 1804-file real-world codegen those steps happen 212 M times and FOUR arms are
; 94 % of them:
;
;     ResolveQuantities 37 %   FunctionTailCall 33 %   Apply 16 %   TailApply 8 %
;
; None of them was lowered, so each cost the full generic path: generated code →
; jit_execute → Insn.execute → the 46-way jump table → the arm. These helpers
; are the same transcription the five hot arms got — the arm's body verbatim,
; reached with ONE call and no jump table.
;
; ★ Why THESE four and not the ones the static count ranks: a body compiled once
; contributes one static insn no matter how often it runs. The static ranking
; measures the code generator's coverage; only the dynamic one measures time.
; ===========================================================================

; ResolveQuantitiesInsn::execute, whole. Cannot transfer control anywhere: it
; answers `next` or fails, which is why its successor is NOT noted as an entry
; point (see emit_native) — one case fewer, one block more dominated.
function jit_resolve_quantities(insn: pointer[void], vm: pointer[void]) returns pointer[void]
{
    let i insn as pointer[Insn]
    let v vm as pointer[VM]
    choose *i
        when rq: ResolveQuantities
        {
            let sp v.get_sp()
            let top v.stack_ref(sp - 1)
            let itp v.get_interp()
            let tem top.resolve_quantities(true, itp, rq.loc)
            if itp.is_error(tem)
            {
                return v.fail()
            }
            v.stack_set(sp - 1, tem)
            return rq.next as pointer[void]
        }
        else
            return null
    null
}

; FunctionTailCallInsn::execute minus `setNActualArgs`, which is one native
; store — the same split FunctionCall gets. A tail call always leaves the
; region, so there is nothing to rejoin: the trampoline re-enters at the callee,
; and that is exactly what keeps the native stack bounded.
function jit_function_tail_call(insn: pointer[void], vm: pointer[void]) returns pointer[void]
{
    let i insn as pointer[Insn]
    let v vm as pointer[VM]
    choose *i
        when ft: FunctionTailCall
            return ft.func.tail_call(v, ft.loc, ft.n_caller_args) as pointer[void]
        else
            return null
    null
}

; ApplyInsn::execute. `apply` hands control to the applied function, so its
; `next` IS a genuine re-entry point and stays a multiplexer case.
function jit_apply(insn: pointer[void], vm: pointer[void]) returns pointer[void]
{
    let i insn as pointer[Insn]
    let v vm as pointer[VM]
    choose *i
        when ap: Apply
            return Insn.exec_apply(v, ap.n_args, ap.loc, ap.next) as pointer[void]
        else
            return null
    null
}

; TailApplyInsn::execute — no successor of its own, like every tail transfer.
function jit_tail_apply(insn: pointer[void], vm: pointer[void]) returns pointer[void]
{
    let i insn as pointer[Insn]
    let v vm as pointer[VM]
    choose *i
        when ta: TailApply
            return Insn.exec_tail_apply(v, ta.n_caller_args, ta.n_args, ta.loc) as pointer[void]
        else
            return null
    null
}

; Selftest helper — the one call the ORC round trip is proved with. Kept
; permanently: it is the difference between "the JIT is wired up" and "the JIT
; silently produced a module nobody executed".
function jit_selftest_double(x: i64) returns i64
    x + x

define Jit
{
    ; --- limits ----------------------------------------------------------
    ; A region stops growing at this many insns. Not a correctness bound (the
    ; leftover successors become their own regions on first use) but a bound on
    ; one module's compile time.
    function max_region_insns() returns int
        3000

    ; ======================================================================
    ; PtrMap — open-addressed u64 -> u64, the insn-keyed tables (region cache
    ; and the per-compile block map). Key 0 is the empty slot: an Insn address
    ; is never 0.
    ; ======================================================================
    define PtrMap
    (
        host: pointer[Page]
        keys: pointer[u64]
        vals: pointer[u64]
        cap: size_t
        used: size_t
    )
    {
        init(host: pointer[Page], cap: size_t)
        {
            set this.host: host
            set this.cap: cap
            set this.used: 0
            set this.keys: host.allocate(cap * sizeof u64, alignof u64) as pointer[u64]
            set this.vals: host.allocate(cap * sizeof u64, alignof u64) as pointer[u64]
            var i: size_t 0
            while i < cap
            {
                set *(this.keys + i): 0
                set *(this.vals + i): 0
                set i: i + 1
            }
        }
    }

    function map_make(host: pointer[Page], cap: size_t) returns ref[PtrMap]
        PtrMap^host(host, cap)

    ; Fibonacci-ish scramble of the pointer, then linear probing. Insn records
    ; are arena-allocated and 8-aligned, so the low bits are dead weight.
    function map_slot(m: ref[PtrMap], key: u64) returns size_t
    {
        var h key
        set h: h >> 3
        set h: h * 0x9E3779B97F4A7C15
        set h: h >> 40
        (h as size_t) & (m.cap - 1)
    }

    ; Returns the slot holding `key`, or the first free slot for it.
    function map_probe(m: ref[PtrMap], key: u64) returns size_t
    {
        var i Jit.map_slot(m, key)
        while true
        {
            let k *(m.keys + i)
            if k = key
                return i
            if k = 0
                return i
            set i: (i + 1) & (m.cap - 1)
        }
        0
    }

    ; The value for `key`, or `missing` when absent.
    function map_get(m: ref[PtrMap], key: u64, missing: u64) returns u64
    {
        let i Jit.map_probe(m, key)
        if *(m.keys + i) = key
            return *(m.vals + i)
        missing
    }

    function map_put(m: ref[PtrMap], key: u64, val: u64)
    {
        ; Grow at half load. Rehashing needs a fresh pair of buffers; the old
        ; ones stay on the arena (they die with the run, like everything here).
        if (m.used + m.used) >= m.cap
            Jit.map_grow(m)
        let i Jit.map_probe(m, key)
        if *(m.keys + i) <> key
        {
            set *(m.keys + i): key
            set m.used: m.used + 1
        }
        set *(m.vals + i): val
    }

    function map_grow(m: ref[PtrMap])
    {
        let old_keys m.keys
        let old_vals m.vals
        let old_cap m.cap
        let new_cap old_cap + old_cap
        let h m.host
        set m.cap: new_cap
        set m.used: 0
        set m.keys: h.allocate(new_cap * sizeof u64, alignof u64) as pointer[u64]
        set m.vals: h.allocate(new_cap * sizeof u64, alignof u64) as pointer[u64]
        var i: size_t 0
        while i < new_cap
        {
            set *(m.keys + i): 0
            set *(m.vals + i): 0
            set i: i + 1
        }
        set i: 0
        while i < old_cap
        {
            let k *(old_keys + i)
            if k <> 0
            {
                let s Jit.map_probe(m, k)
                set *(m.keys + s): k
                set *(m.vals + s): *(old_vals + i)
                set m.used: m.used + 1
            }
            set i: i + 1
        }
    }

    ; ======================================================================
    ; Session
    ; ======================================================================
    define Session
    (
        host: pointer[Page]
        tsc: pointer[void]
        ctx: pointer[void]
        jit: pointer[void]
        jd: pointer[void]
        ; region cache: insn address -> native address, or one of the small
        ; sentinels (see cache_rejected)
        regions: ref[PtrMap]?
        ; bodies that crossed the threshold and are waiting for a batch
        queue: pointer[Array[pointer[Insn]]]
        ; every insn marked `queued` while its body waits for the batch, so the
        ; marks can be lifted again from whatever the compile did not cover
        marks: pointer[Array[pointer[Insn]]]
        ; measured VM field offsets
        off_sp: i64
        off_sbase: i64
        off_slim: i64
        off_frame_start: i64
        off_closure: i64
        off_naa: i64
        ; ★ per-ARM histograms (`--jit-stats` only), N_ARMS slots each. The
        ; static count of lowered insns is not the ranking — what an
        ; optimisation is worth is decided by the DYNAMIC distribution, and
        ; these three populations are the three different questions:
        ;   arm_entry  — the arm the trampoline RE-ENTERS a compiled region at.
        ;                That is what a native call to a known callee removes.
        ;   arm_generic— the arm a compiled region takes an interpreter step
        ;                for (`jit_execute`). That is the "more arms native"
        ;                ranking.
        ;   arm_interp — the arm an insn OUTSIDE any compiled region takes.
        ;                Nothing in the code generator touches those.
        arm_entry: pointer[u64]
        arm_generic: pointer[u64]
        arm_interp: pointer[u64]
        n_modules: int
        ok: bool
    )
    {
        init(host: pointer[Page])
        {
            set this.host: host
            set this.tsc: null
            set this.ctx: null
            set this.jit: null
            set this.jd: null
            set this.regions: null
            set this.queue: null
            set this.marks: null
            set this.off_sp: 0
            set this.off_sbase: 0
            set this.off_slim: 0
            set this.off_frame_start: 0
            set this.off_closure: 0
            set this.off_naa: 0
            set this.arm_entry: null
            set this.arm_generic: null
            set this.arm_interp: null
            set this.n_modules: 0
            set this.ok: false
        }
    }

    ; The region cache encodes three states in one u64 value, which keeps the
    ; hot path to a single probe:
    ;   0        absent
    ;   2        rejected — compilation failed once, never try again
    ;   4        queued — hot, waiting for the next batch, interpreted meanwhile
    ;   odd      an entry COUNT, as 2*count+1 (below the HotSpot threshold)
    ;   other even  the native code address
    ; Code addresses are at least 4-byte aligned on every target we build for,
    ; so "odd" can never collide with one; an odd address would be refused.
    ; ======================================================================
    ; Per-arm histograms — the DYNAMIC distribution (`--jit-stats` only).
    ; ======================================================================

    ; One more than the largest index arm_index answers.
    function n_arms() returns int
        48

    function make_hist(host: pointer[Page]) returns pointer[u64]
    {
        let p host.allocate((Jit.n_arms() as size_t) * sizeof u64, alignof u64) as pointer[u64]
        var i 0
        while i < Jit.n_arms()
        {
            set *(p + i): 0
            set i: i + 1
        }
        p
    }

    procedure bump(h: pointer[u64], i: ref[Insn])
    {
        if h = null
            return
        let k Jit.arm_index(i)
        set *(h + k): *(h + k) + 1
    }

    ; The insn's arm as a histogram slot. The numbering is this function's OWN
    ; (it used to follow `define Insn union`, which is now ordered for the
    ; interpreter's jump table instead); all it has to agree with is `arm_name`,
    ; and both are source-level `choose`es, so the union may be reordered freely.
    ; A 48-way dispatch to count one event — which is why every caller is behind
    ; `JIT_STATS`.
    function arm_index(i: ref[Insn]) returns int
    {
        choose *i
            when a: Error
                return 0
            when a: CondFail
                return 1
            when a: CaseFail
                return 2
            when a: Constant
                return 3
            when a: ResolveQuantities
                return 4
            when a: Test
                return 5
            when a: Or
                return 6
            when a: And
                return 7
            when a: Case
                return 8
            when a: Pop
                return 9
            when a: Cons
                return 10
            when a: Append
                return 11
            when a: Apply
                return 12
            when a: TailApply
                return 13
            when a: FrameRef
                return 14
            when a: StackRef
                return 15
            when a: ClosureRef
                return 16
            when a: TopRef
                return 17
            when a: PopBindings
                return 18
            when a: Return
                return 19
            when a: PrimitiveCall
                return 20
            when a: ClosureMk
                return 21
            when a: FunctionCall
                return 22
            when a: FunctionTailCall
                return 23
            when a: Varargs
                return 24
            when a: SetKeyArg
                return 25
            when a: TestNull
                return 26
            when a: Box
                return 27
            when a: BoxArg
                return 28
            when a: BoxStack
                return 29
            when a: Unbox
                return 30
            when a: SetBox
                return 31
            when a: SetImmediate
                return 32
            when a: CheckInit
                return 33
            when a: StackSetBox
                return 34
            when a: StackSet
                return 35
            when a: ClosureSetBox
                return 36
            when a: Vector
                return 37
            when a: ListToVector
                return 38
            when a: MakeFlowObj
                return 39
            when a: LabelSosofo
                return 40
            when a: SetNic
                return 41
            when a: MakeStyle
                return 42
            when a: PushMode
                return 43
            when a: PopMode
                return 44
            when a: CheckSosofo
                return 45
            when a: UnpackMacroFlowObj
                return 46
            else
                return 47
        47
    }

    function cache_rejected() returns u64
        2

    function cache_queued() returns u64
        4

    ; ----------------------------------------------------------------------
    ; Open a session. Returns null when the JIT cannot be brought up, and the
    ; engine then stays on the interpreter: a missing or broken backend must
    ; degrade, never abort — the whole point of keeping `--interp` is that the
    ; engine has a path that does not depend on LLVM.
    ; ----------------------------------------------------------------------
    function open(host: pointer[Page]) returns pointer[Session]
    {
        if Jit.check_helper_abi() = false
        {
            scaly_eputs "dazzle JIT: helper ABI check failed, staying on the interpreter\n"
            return null
        }
        Llvm.init_native_target()
        let s Session^host(host)
        let tsc LLVMOrcCreateNewThreadSafeContext()
        if tsc = null
        {
            scaly_eputs "dazzle JIT: no thread-safe context\n"
            return null
        }
        set s.tsc: tsc
        set s.ctx: LLVMOrcThreadSafeContextGetContext(tsc)
        var jit: pointer[void] null
        ; ★ An LLJIT built on OUR TargetMachine, so the backend runs at the opt
        ; level Jit.codegen_level names — see the note in Llvm.scaly. A null
        ; builder (the default LLJIT) runs the backend aggressively, which
        ; measured 2026-08-06 is most of the JIT's whole cost. `build_lljit_opts`
        ; answers null when the host cannot be detected, and then this falls back
        ; to the default builder rather than refusing to open a session.
        let bld Jit.build_lljit_builder()
        let err LLVMOrcCreateLLJIT(&jit, bld)
        if Llvm.failed(err, "could not create LLJIT")
            return null
        if jit = null
            return null
        set s.jit: jit
        set s.jd: LLVMOrcLLJITGetMainJITDylib(jit)
        set s.regions: Jit.map_make(host, 1024)
        set s.queue: Array[pointer[Insn]]^host()
        set s.marks: Array[pointer[Insn]]^host()
        set s.arm_entry: Jit.make_hist(host)
        set s.arm_generic: Jit.make_hist(host)
        set s.arm_interp: Jit.make_hist(host)
        if Jit.measure_layout(s) = false
        {
            scaly_eputs "dazzle JIT: VM layout probe failed, staying on the interpreter\n"
            return null
        }
        set s.ok: true
        s
    }

    ; ----------------------------------------------------------------------
    ; The LLJITBuilder that pins the BACKEND opt level, or null to let LLJIT
    ; pick its own (which is the aggressive default). Every failure on the way
    ; answers null: a JIT with a slower backend is a performance question, a JIT
    ; that refuses to open is a functional one.
    ; ----------------------------------------------------------------------
    function build_lljit_builder() returns pointer[void]
    {
        let triple LLVMGetDefaultTargetTriple()
        if triple = null
            return null
        let triple_c triple as pointer[const_char]
        var target: pointer[void] null
        var terr: pointer[char] null
        if LLVMGetTargetFromTriple(triple_c, &target, &terr) <> 0
            return null
        if target = null
            return null
        let cpu LLVMGetHostCPUName()
        let feat LLVMGetHostCPUFeatures()
        var cpu_c: pointer[const_char] null
        var feat_c: pointer[const_char] null
        if cpu <> null
            set cpu_c: cpu as pointer[const_char]
        if feat <> null
            set feat_c: feat as pointer[const_char]
        let tm LLVMCreateTargetMachine(target, triple_c, cpu_c, feat_c, JIT_CODEGEN_LEVEL, LLVM_RELOC_PIC, LLVM_CODE_MODEL_JIT_DEFAULT)
        if tm = null
            return null
        let tmb LLVMOrcJITTargetMachineBuilderCreateFromTargetMachine(tm)
        if tmb = null
            return null
        let bld LLVMOrcCreateLLJITBuilder()
        if bld = null
            return null
        LLVMOrcLLJITBuilderSetJITTargetMachineBuilder(bld, tmb)
        bld
    }

    ; ----------------------------------------------------------------------
    ; Measure the VM field offsets from a probe instance. Never hardcode
    ; these: a field inserted into `VM` would otherwise move `sp` under the
    ; generated code and corrupt the value stack silently.
    ; ----------------------------------------------------------------------
    function measure_layout(s: ref[Session]) returns bool
    {
        ; ★ Measured by SENTINEL SEARCH, not by `&probe.field`. Address-of a
        ;   member answers the field's ADDRESS for a scalar field but the field's
        ;   VALUE for a POINTER-typed one (measured 2026-08-06: `sp` came out 24
        ;   and `sbase` came out `0 - page_base`, the same wrong answer as
        ;   `closure`) — the same family as the `&arr[i]` no-op fixed 2026-08-04,
        ;   and noted in the wish list. Writing a unique value through the field
        ;   and finding it in the struct's bytes needs no language guarantee at
        ;   all, and it PROVES the offset instead of trusting it: a sentinel that
        ;   turns up twice, or not at all, is rejected.
        let probe VM.make(s.host, null)
        let size (sizeof VM) as i64
        let pv probe as pointer[void]

        set probe.sp: 0x51A5A5A5A5A50001
        set probe.slim: 0x51A5A5A5A5A50002
        set probe.frame_start: 0x51A5A5A5A5A50003
        set probe.n_actual_args: 0x51A5A5A5A5A50004
        set probe.sbase: 0x51A5A5A5A5A50005 as pointer[pointer[ELObj]]
        set probe.closure: 0x51A5A5A5A5A50006 as pointer[pointer[ELObj]]

        set s.off_sp: Jit.find_field(pv, size, 0x51A5A5A5A5A50001)
        set s.off_slim: Jit.find_field(pv, size, 0x51A5A5A5A5A50002)
        set s.off_frame_start: Jit.find_field(pv, size, 0x51A5A5A5A5A50003)
        set s.off_naa: Jit.find_field(pv, size, 0x51A5A5A5A5A50004)
        set s.off_sbase: Jit.find_field(pv, size, 0x51A5A5A5A5A50005)
        set s.off_closure: Jit.find_field(pv, size, 0x51A5A5A5A5A50006)

        if Jit.check_layout(s)
            return true
        ; ★ Report what was measured. A guard that only says "failed" would send
        ; the next reader into the code generator; the numbers say immediately
        ; whether the probe found the fields at all.
        ; Each value is bound first: a cast or a parenthesised expression as the
        ; argument of a PARENLESS call mis-parses (CLAUDE.md, "Calls &
        ; operands"), and here that would be a diagnostic about the diagnostic.
        let vm_size size as int
        let o_sp s.off_sp as int
        let o_sbase s.off_sbase as int
        let o_slim s.off_slim as int
        let o_frame s.off_frame_start as int
        let o_closure s.off_closure as int
        let o_naa s.off_naa as int
        var sb StringBuilder()
        sb.append "dazzle JIT: VM layout probe rejected: size "
        sb.append vm_size
        sb.append " sp "
        sb.append o_sp
        sb.append " sbase "
        sb.append o_sbase
        sb.append " slim "
        sb.append o_slim
        sb.append " frame_start "
        sb.append o_frame
        sb.append " closure "
        sb.append o_closure
        sb.append " n_actual_args "
        sb.append o_naa
        sb.append "\n"
        let line sb.to_string()
        let line_c line.to_c_string()
        scaly_eputs line_c
        false
    }

    ; The unique 8-aligned offset at which `sentinel` sits inside the struct, or
    ; -1 when it is absent or appears more than once.
    function find_field(base: pointer[void], size: i64, sentinel: u64) returns i64
    {
        let words base as pointer[u64]
        var i: i64 0
        var found: i64 0 - 1
        var count 0
        let n size / 8
        while i < n
        {
            if *(words + i) = sentinel
            {
                set found: i * 8
                set count: count + 1
            }
            set i: i + 1
        }
        if count = 1
            return found
        0 - 1
    }

    function check_layout(s: ref[Session]) returns bool
    {
        let lim (sizeof VM) as i64
        if Jit.off_ok(s.off_sp, lim) = false
            return false
        if Jit.off_ok(s.off_sbase, lim) = false
            return false
        if Jit.off_ok(s.off_slim, lim) = false
            return false
        if Jit.off_ok(s.off_frame_start, lim) = false
            return false
        if Jit.off_ok(s.off_closure, lim) = false
            return false
        if Jit.off_ok(s.off_naa, lim) = false
            return false
        ; every one of them is a distinct slot
        if s.off_sp = s.off_slim
            return false
        if s.off_sp = s.off_frame_start
            return false
        if s.off_sbase = s.off_closure
            return false
        true
    }

    function off_ok(off: i64, lim: i64) returns bool
    {
        if off < 0
            return false
        if off >= lim
            return false
        if (off % 8) <> 0
            return false
        true
    }

    ; ----------------------------------------------------------------------
    ; Helper ABI guard — see the header. Calls a helper exactly the way
    ; generated code will: through its address, with the generated signature.
    ; ----------------------------------------------------------------------
    function check_helper_abi() returns bool
    {
        let addr &jit_selftest_double
        if addr = null
            return false
        let fp addr as pointer[void]
        let r fp(21 as i64)
        if r <> 42
            return false
        let r2 fp(0 as i64)
        if r2 <> 0
            return false
        true
    }

    ; ======================================================================
    ; Cg — the per-region code-generation context.
    ;
    ; Constructed field-by-field on purpose: an `init` with 30 positional
    ; parameters is the shape that silently degenerates into a positional tuple
    ; when a single argument does not match (CLAUDE.md, "no matching
    ; initializer"), and a field left holding stack garbage here would be an
    ; LLVM handle.
    ; ======================================================================
    define Cg
    (
        s: ref[Session]
        b: pointer[void]
        fn: pointer[void]
        vm: pointer[void]
        ; the entry multiplexer of the function being built: parameter 1 (the
        ; insn the trampoline entered with) and the `switch` over it. A case is
        ; added by block_for the moment a block appears, so the multiplexer is
        ; complete by construction.
        insn_p: pointer[void]
        sw: pointer[void]
        i8t: pointer[void]
        i64t: pointer[void]
        ptrt: pointer[void]
        voidt: pointer[void]
        nullp: pointer[void]
        ; function types of the helpers, in helper order
        ty_exec: pointer[void]
        ty_need: pointer[void]
        ty_i64_p: pointer[void]
        ty_i64_pp: pointer[void]
        ty_p_p: pointer[void]
        ty_p_pp: pointer[void]
        ty_p_ppp: pointer[void]
        ty_p_pppp: pointer[void]
        ; inttoptr constants of the helpers
        p_exec: pointer[void]
        p_need: pointer[void]
        p_is_true: pointer[void]
        p_eqv: pointer[void]
        p_box: pointer[void]
        p_box_value: pointer[void]
        p_cons: pointer[void]
        p_pop_frame: pointer[void]
        p_prim_call: pointer[void]
        p_function_call: pointer[void]
        p_top_ref: pointer[void]
        p_check_init_fail: pointer[void]
        p_resolve_q: pointer[void]
        p_function_tail_call: pointer[void]
        p_apply: pointer[void]
        p_tail_apply: pointer[void]
        blocks: ref[PtrMap]?
        pending: pointer[Array[pointer[Insn]]]
        ; the insns of THIS function the trampoline can arrive at — see note_entry
        entry_set: ref[PtrMap]?
        ; the batch: every code body this module gets a function for, and the
        ; set that keeps a body from being added twice
        roots: pointer[Array[pointer[Insn]]]
        root_set: ref[PtrMap]?
        ; ★ Rung 1's registry: every insn that got a BLOCK, and the root whose
        ; function that block lives in. After the ORC lookup, each of these is
        ; cached as an entry point of its function — that is what stops a
        ; mid-body insn from ever crossing the threshold on its own and being
        ; compiled a second time as a root of its own.
        cur_root: ref[Insn]?
        all_insns: pointer[Array[pointer[Insn]]]
        all_roots: pointer[Array[pointer[Insn]]]
        n_insns: int
        n_native: int
    )
    {
        init(s: ref[Session])
        {
            set this.s: s
            set this.b: null
            set this.fn: null
            set this.vm: null
            set this.insn_p: null
            set this.sw: null
            set this.i8t: null
            set this.i64t: null
            set this.ptrt: null
            set this.voidt: null
            set this.nullp: null
            set this.ty_exec: null
            set this.ty_need: null
            set this.ty_i64_p: null
            set this.ty_i64_pp: null
            set this.ty_p_p: null
            set this.ty_p_pp: null
            set this.ty_p_ppp: null
            set this.ty_p_pppp: null
            set this.p_exec: null
            set this.p_need: null
            set this.p_is_true: null
            set this.p_eqv: null
            set this.p_box: null
            set this.p_box_value: null
            set this.p_cons: null
            set this.p_pop_frame: null
            set this.p_prim_call: null
            set this.p_function_call: null
            set this.p_top_ref: null
            set this.p_check_init_fail: null
            set this.p_resolve_q: null
            set this.p_function_tail_call: null
            set this.p_apply: null
            set this.p_tail_apply: null
            set this.blocks: null
            set this.pending: null
            set this.entry_set: null
            set this.roots: null
            set this.root_set: null
            set this.cur_root: null
            set this.all_insns: null
            set this.all_roots: null
            set this.n_insns: 0
            set this.n_native: 0
        }
    }

    ; ======================================================================
    ; IR building helpers
    ; ======================================================================

    function c64(cg: ref[Cg], v: i64) returns pointer[void]
        LLVMConstInt(cg.i64t, v as u64, 0)

    ; A runtime address as an IR pointer constant. This is the whole callback
    ; mechanism: `&helper as u64` on one side, inttoptr on the other.
    function cptr(cg: ref[Cg], addr: u64) returns pointer[void]
        LLVMConstIntToPtr(LLVMConstInt(cg.i64t, addr, 0), cg.ptrt)

    ; A one-element LLVMValueRef array without allocating: the fixed-size stack
    ; array decays to a pointer, which is exactly what the C API wants.
    function gep_i8(cg: ref[Cg], base: pointer[void], off: i64) returns pointer[void]
    {
        var ibuf u8[16]
        let ip ibuf as pointer[pointer[void]]
        set *ip: Jit.c64(cg, off)
        LLVMBuildInBoundsGEP2(cg.b, cg.i8t, base, ip, 1, "")
    }

    ; --- VM fields --------------------------------------------------------
    function ld_i64(cg: ref[Cg], off: i64) returns pointer[void]
        LLVMBuildLoad2(cg.b, cg.i64t, Jit.gep_i8(cg, cg.vm, off), "")

    function st_i64(cg: ref[Cg], off: i64, v: pointer[void])
    {
        let a Jit.gep_i8(cg, cg.vm, off)
        LLVMBuildStore(cg.b, v, a)
    }

    function ld_field_ptr(cg: ref[Cg], off: i64) returns pointer[void]
        LLVMBuildLoad2(cg.b, cg.ptrt, Jit.gep_i8(cg, cg.vm, off), "")

    function ld_sp(cg: ref[Cg]) returns pointer[void]
        Jit.ld_i64(cg, cg.s.off_sp)

    function st_sp(cg: ref[Cg], v: pointer[void])
        Jit.st_i64(cg, cg.s.off_sp, v)

    function ld_sbase(cg: ref[Cg]) returns pointer[void]
        Jit.ld_field_ptr(cg, cg.s.off_sbase)

    ; --- value stack ------------------------------------------------------
    ; slot(sbase, i) — &sbase[i]; the element type is a pointer, so the GEP
    ; stride is one slot.
    function slot(cg: ref[Cg], sbase: pointer[void], idx: pointer[void]) returns pointer[void]
    {
        var ibuf u8[16]
        let ip ibuf as pointer[pointer[void]]
        set *ip: idx
        LLVMBuildInBoundsGEP2(cg.b, cg.ptrt, sbase, ip, 1, "")
    }

    function ld_slot(cg: ref[Cg], sbase: pointer[void], idx: pointer[void]) returns pointer[void]
        LLVMBuildLoad2(cg.b, cg.ptrt, Jit.slot(cg, sbase, idx), "")

    function st_slot(cg: ref[Cg], sbase: pointer[void], idx: pointer[void], v: pointer[void])
    {
        let a Jit.slot(cg, sbase, idx)
        LLVMBuildStore(cg.b, v, a)
    }

    function add64(cg: ref[Cg], a: pointer[void], b: i64) returns pointer[void]
    {
        if b = 0
            return a
        LLVMBuildAdd(cg.b, a, Jit.c64(cg, b), "")
    }

    ; --- calls ------------------------------------------------------------
    function call1(cg: ref[Cg], ty: pointer[void], f: pointer[void], a0: pointer[void]) returns pointer[void]
    {
        var abuf u8[16]
        let ap abuf as pointer[pointer[void]]
        set *ap: a0
        LLVMBuildCall2(cg.b, ty, f, ap, 1, "")
    }

    function call2(cg: ref[Cg], ty: pointer[void], f: pointer[void], a0: pointer[void], a1: pointer[void]) returns pointer[void]
    {
        var abuf u8[24]
        let ap abuf as pointer[pointer[void]]
        set *ap: a0
        set *(ap + 1): a1
        LLVMBuildCall2(cg.b, ty, f, ap, 2, "")
    }

    function call4(cg: ref[Cg], ty: pointer[void], f: pointer[void], a0: pointer[void], a1: pointer[void], a2: pointer[void], a3: pointer[void]) returns pointer[void]
    {
        var abuf u8[40]
        let ap abuf as pointer[pointer[void]]
        set *ap: a0
        set *(ap + 1): a1
        set *(ap + 2): a2
        set *(ap + 3): a3
        LLVMBuildCall2(cg.b, ty, f, ap, 4, "")
    }

    function call3(cg: ref[Cg], ty: pointer[void], f: pointer[void], a0: pointer[void], a1: pointer[void], a2: pointer[void]) returns pointer[void]
    {
        var abuf u8[32]
        let ap abuf as pointer[pointer[void]]
        set *ap: a0
        set *(ap + 1): a1
        set *(ap + 2): a2
        LLVMBuildCall2(cg.b, ty, f, ap, 3, "")
    }

    ; VM::needStack, inline: the call happens only when the stack is actually
    ; short, exactly as the interpreter's `if this.sp + n > this.slim` does.
    ; The builder is left positioned in the continuation block, and every caller
    ; loads `sbase` AFTER this — growing reallocates it.
    function need_stack(cg: ref[Cg], n: i64)
    {
        let sp Jit.ld_sp(cg)
        let slim Jit.ld_i64(cg, cg.s.off_slim)
        let want Jit.add64(cg, sp, n)
        let short LLVMBuildICmp(cg.b, LLVM_INT_SGT, want, slim, "")
        let grow_bb LLVMAppendBasicBlockInContext(cg.s.ctx, cg.fn, "grow")
        let cont_bb LLVMAppendBasicBlockInContext(cg.s.ctx, cg.fn, "cont")
        LLVMBuildCondBr(cg.b, short, grow_bb, cont_bb)
        LLVMPositionBuilderAtEnd(cg.b, grow_bb)
        Jit.call2(cg, cg.ty_need, cg.p_need, cg.vm, Jit.c64(cg, n))
        LLVMBuildBr(cg.b, cont_bb)
        LLVMPositionBuilderAtEnd(cg.b, cont_bb)
    }

    ; --- the entry multiplexer --------------------------------------------
    ; ★ RUNG 1 (2026-08-06). A compiled body is entered at whichever insn the
    ; trampoline arrives with, not only at the body's first one:
    ;
    ;     i64 f(ptr vm, ptr insn) {
    ;     entry: switch (i64)insn [ <insn1> -> %i1, <insn2> -> %i2, ... ]
    ;     deflt: ret (i64)jit_execute(insn, vm)      ; unreachable in practice
    ;
    ; Why this is the shape that matters, measured 2026-08-06: with a single
    ; fixed entry, every insn REACHED from the trampoline (a call's continuation,
    ; a return point) accumulated its own entry count, crossed the threshold on
    ; its own, and was compiled a SECOND time as the root of a duplicate region.
    ; That is what made batching backfire — a body waiting for its batch turned
    ; into dozens of roots (540 -> 2560 with batch 32). With the multiplexer,
    ; compile_queue caches EVERY insn of the body against this function, so a
    ; mid-body insn is found compiled instead of counted, and batching becomes
    ; the lever it looked like all along.
    ;
    ; The default arm cannot be reached through the cache (only insns that got a
    ; case are cached against this function), so it is pure defence — and it is
    ; a SAFE default: one interpreter step, then the successor, which guarantees
    ; progress. Answering `insn` unchanged would spin the trampoline forever.
    function build_entry(cg: ref[Cg])
    {
        let entry_bb LLVMAppendBasicBlockInContext(cg.s.ctx, cg.fn, "entry")
        let deflt_bb LLVMAppendBasicBlockInContext(cg.s.ctx, cg.fn, "deflt")
        LLVMPositionBuilderAtEnd(cg.b, deflt_bb)
        let r Jit.call2(cg, cg.ty_exec, cg.p_exec, cg.insn_p, cg.vm)
        Jit.ret_ptr(cg, r)
        LLVMPositionBuilderAtEnd(cg.b, entry_bb)
        let key LLVMBuildPtrToInt(cg.b, cg.insn_p, cg.i64t, "")
        set cg.sw: LLVMBuildSwitch(cg.b, key, deflt_bb, 16)
    }

    ; --- blocks -----------------------------------------------------------
    ; The block for an insn inside this region, created (and queued for
    ; lowering) on first mention.
    function block_for(cg: ref[Cg], i: ref[Insn]) returns pointer[void]
    {
        let key i as u64
        let found Jit.map_get(cg.blocks, key, 0)
        if found <> 0
            return found as pointer[void]
        let bb LLVMAppendBasicBlockInContext(cg.s.ctx, cg.fn, "i")
        Jit.map_put(cg.blocks, key, bb as u64)
        cg.pending.add i
        bb
    }

    ; ★ Note that the trampoline can arrive at `i`, so `i` must become a case of
    ; the entry multiplexer (rung 1).
    ;
    ; ★★ NOT every block — measured 2026-08-06, and this is the whole difference
    ; between rung 1 helping and rung 1 hurting. A case makes its block reachable
    ; from `entry`, so the block is no longer DOMINATED by the root and the
    ; optimizer can forward nothing into it: with a case per block the pass
    ; pipeline was worth exactly 0 ms of run time (183 ms of compile time for
    ; nothing), because every insn had to reload `sp` and `sbase` from the VM.
    ; With only the real re-entry points as cases, the straight-line stretches
    ; between calls are dominated again and the loads fold.
    ;
    ; The real re-entry points are: the body's own root (a call into it), and the
    ; CONTINUATION of any arm that can hand control to another body — a call
    ; arm's `next`, which is what the callee's Return answers. An insn that is
    ; only ever reached from inside the region needs no case; and missing one is
    ; not a correctness question (the default arm handles any insn, and an insn
    ; with no case simply becomes its own root later) — only a missed
    ; opportunity.
    procedure note_entry(cg: ref[Cg], i: ref[Insn])
    {
        if i = null
            return
        Jit.map_put(cg.entry_set, i as u64, 1)
    }

    ; Wire the noted entry points into the multiplexer, once the blocks exist.
    procedure wire_entries(cg: ref[Cg])
    {
        var i: size_t 0
        while i < cg.pending.get_length()
        {
            let ipp cg.pending.get i
            if ipp <> null
            {
                let ins *ipp
                let key ins as u64
                if Jit.map_get(cg.entry_set, key, 0) <> 0
                {
                    let bb Jit.map_get(cg.blocks, key, 0)
                    if bb <> 0
                    {
                        LLVMAddCase(cg.sw, Jit.c64(cg, key as i64), bb as pointer[void])
                        cg.all_insns.add ins
                        cg.all_roots.add cg.cur_root
                    }
                }
            }
            set i: i + 1
        }
    }

    ; The branch target for a successor that may be null. A null successor means
    ; "the interpreter loop would end here", i.e. answer 0.
    function target_block(cg: ref[Cg], i: ref[Insn]) returns pointer[void]
    {
        if i <> null
            return Jit.block_for(cg, i)
        let bb LLVMAppendBasicBlockInContext(cg.s.ctx, cg.fn, "done")
        let save LLVMGetInsertBlock(cg.b)
        LLVMPositionBuilderAtEnd(cg.b, bb)
        LLVMBuildRet(cg.b, Jit.c64(cg, 0))
        LLVMPositionBuilderAtEnd(cg.b, save)
        bb
    }

    ; Leave the region, answering `r` (an Insn pointer value) to the trampoline.
    function ret_ptr(cg: ref[Cg], r: pointer[void])
    {
        let n LLVMBuildPtrToInt(cg.b, r, cg.i64t, "")
        LLVMBuildRet(cg.b, n)
    }

    ; Branch to `i`, or leave the region when it has no block yet and the region
    ; is already at its size cap.
    function goto_insn(cg: ref[Cg], i: ref[Insn])
    {
        if i = null
        {
            LLVMBuildRet(cg.b, Jit.c64(cg, 0))
            return
        }
        if cg.n_insns >= Jit.max_region_insns()
        {
            let key i as u64
            if Jit.map_get(cg.blocks, key, 0) = 0
            {
                Jit.ret_ptr(cg, Jit.cptr(cg, key))
                return
            }
        }
        LLVMBuildBr(cg.b, Jit.block_for(cg, i))
    }

    ; ======================================================================
    ; Static successors of an insn — the ONLY thing the generic lowering needs
    ; to know about an arm it does not understand.
    ;
    ; "Static" means: a successor the Insn record itself names. A call arm names
    ; its `next` (which is where a PRIMITIVE callee returns to), never the
    ; callee's body — so a closure call simply leaves the region. Arms that
    ; transfer control through the VM alone (Return, tail calls, Varargs) name
    ; nothing.
    ; ======================================================================
    function insn_successors(i: ref[Insn], s0: pointer[pointer[Insn]], s1: pointer[pointer[Insn]]) returns int
    {
        set *s0: null
        set *s1: null
        choose *i
            when a: Constant
            {
                set *s0: a.next
                return 1
            }
            when a: ResolveQuantities
            {
                set *s0: a.next
                return 1
            }
            when a: Test
            {
                set *s0: a.consequent
                set *s1: a.alternative
                return 2
            }
            when a: Or
            {
                set *s0: a.next
                set *s1: a.next_test
                return 2
            }
            when a: And
            {
                set *s0: a.next
                set *s1: a.next_test
                return 2
            }
            when a: Case
            {
                set *s0: a.matched
                set *s1: a.fail
                return 2
            }
            when a: Pop
            {
                set *s0: a.next
                return 1
            }
            when a: Cons
            {
                set *s0: a.next
                return 1
            }
            when a: Append
            {
                set *s0: a.next
                return 1
            }
            when a: Apply
            {
                set *s0: a.next
                return 1
            }
            when a: FrameRef
            {
                set *s0: a.next
                return 1
            }
            when a: StackRef
            {
                set *s0: a.next
                return 1
            }
            when a: ClosureRef
            {
                set *s0: a.next
                return 1
            }
            when a: TopRef
            {
                set *s0: a.next
                return 1
            }
            when a: PopBindings
            {
                set *s0: a.next
                return 1
            }
            when a: PrimitiveCall
            {
                set *s0: a.next
                return 1
            }
            when a: ClosureMk
            {
                set *s0: a.next
                return 1
            }
            when a: FunctionCall
            {
                set *s0: a.next
                return 1
            }
            when a: SetKeyArg
            {
                set *s0: a.next
                return 1
            }
            when a: TestNull
            {
                set *s0: a.if_null
                set *s1: a.if_not_null
                return 2
            }
            when a: Box
            {
                set *s0: a.next
                return 1
            }
            when a: BoxArg
            {
                set *s0: a.next
                return 1
            }
            when a: BoxStack
            {
                set *s0: a.next
                return 1
            }
            when a: Unbox
            {
                set *s0: a.next
                return 1
            }
            when a: SetBox
            {
                set *s0: a.next
                return 1
            }
            when a: SetImmediate
            {
                set *s0: a.next
                return 1
            }
            when a: CheckInit
            {
                set *s0: a.next
                return 1
            }
            when a: StackSetBox
            {
                set *s0: a.next
                return 1
            }
            when a: StackSet
            {
                set *s0: a.next
                return 1
            }
            when a: ClosureSetBox
            {
                set *s0: a.next
                return 1
            }
            when a: Vector
            {
                set *s0: a.next
                return 1
            }
            when a: ListToVector
            {
                set *s0: a.next
                return 1
            }
            when a: MakeFlowObj
            {
                set *s0: a.next
                return 1
            }
            when a: LabelSosofo
            {
                set *s0: a.next
                return 1
            }
            when a: SetNic
            {
                set *s0: a.next
                return 1
            }
            when a: MakeStyle
            {
                set *s0: a.next
                return 1
            }
            when a: PushMode
            {
                set *s0: a.next
                return 1
            }
            when a: PopMode
            {
                set *s0: a.next
                return 1
            }
            when a: CheckSosofo
            {
                set *s0: a.next
                return 1
            }
            when a: UnpackMacroFlowObj
            {
                set *s0: a.next
                return 1
            }
            else
                return 0
        0
    }

    ; ======================================================================
    ; ★ The STATICALLY KNOWN CALLEE (rung 4, 2026-08-06).
    ;
    ; `FunctionCallInsn` and `FunctionTailCallInsn` name their callee ELObj at
    ; COMPILE time — `Expression.compile` resolved it. When that object is a
    ; Closure, `ELObj.call` / `ELObj.tail_call` answer its `code` after setting
    ; up the frame, so the insn the region will continue at is known before the
    ; call is even emitted.
    ;
    ; That makes the callee a successor like any other, and it needs NO new
    ; protocol: the compare `emit_rejoin` already emits IS the protocol. A
    ; static guess is only a HINT — if the answer is anything else (the object
    ; was rebuilt, a continuation intervened, the callee errored) the compare
    ; misses and the region returns to the trampoline exactly as before. That is
    ; also why nothing here has to reason about whether an ELObj can be mutated
    ; in place: correctness never depends on the guess being right.
    ;
    ; For a TAIL call this turns a trampoline turn into a native BRANCH, and a
    ; SELF tail call — the named-let-over-node-list idiom of these stylesheets —
    ; into a plain loop inside one function. The native stack cannot grow: a
    ; branch is not a call, so the bounded-stack property the whole design rests
    ; on is untouched.
    ; ======================================================================
    function static_callee_code(func: ref[ELObj]) returns pointer[Insn]
    {
        if func = null
            return null
        choose *func
            when c: Closure
                return c.code
            else
                return null
        null
    }

    ; The callee to rejoin at, or null. ★ Only a body ALREADY in this region:
    ; `block_for` would otherwise pull the callee's whole body in behind the
    ; rejoin, and measured that costs more LLVM than the saved trampoline turns
    ; are worth (the region grew 2.2x and compile time went 230 ms -> 403 ms for
    ; the same work). What survives the restriction is the case that matters and
    ; costs nothing: a SELF tail call, whose target is this body's own root — the
    ; named-let-over-node-list loop, which becomes a plain branch.
    ; JIT_INLINE_CALLEE lifts the restriction, which is how the 2.2x was
    ; measured; it is off because that measurement said so.
    function rejoin_callee(cg: ref[Cg], func: ref[ELObj]) returns pointer[Insn]
    {
        let cc Jit.static_callee_code(func)
        if cc = null
            return null
        if JIT_INLINE_CALLEE
            return cc
        if Jit.map_get(cg.blocks, cc as u64, 0) = 0
            return null
        cc
    }

    ; ======================================================================
    ; The generic lowering: let the interpreter perform the step, then rejoin
    ; native code at whichever static successor it answered.
    ; ======================================================================
    function emit_generic(cg: ref[Cg], i: ref[Insn])
    {
        let r Jit.call2(cg, cg.ty_exec, cg.p_exec, Jit.cptr(cg, i as u64), cg.vm)
        var succ0: pointer[Insn] null
        var succ1: pointer[Insn] null
        let n Jit.insn_successors(i, &succ0, &succ1)
        ; An arm we do not lower is an arm whose behaviour we do not model, so
        ; assume its successors CAN be re-entered from outside (Apply and the
        ; primitive-driven arms genuinely are).
        if n > 0
            Jit.note_entry(cg, succ0)
        if n > 1
            Jit.note_entry(cg, succ1)
        if n > 0
            Jit.emit_rejoin(cg, r, succ0)
        if n > 1
            Jit.emit_rejoin(cg, r, succ1)
        ; Anything else — a call into another body, a tail call, an unwind, an
        ; error — goes back to the trampoline unchanged.
        Jit.ret_ptr(cg, r)
    }

    ; `if r = succ: continue there` — and the builder is left in the block that
    ; runs when it was not.
    function emit_rejoin(cg: ref[Cg], r: pointer[void], succ: ref[Insn])
    {
        if succ = null
            return
        if cg.n_insns >= Jit.max_region_insns()
        {
            ; At the cap, only rejoin a successor that is already in the region.
            if Jit.map_get(cg.blocks, succ as u64, 0) = 0
                return
        }
        let eq LLVMBuildICmp(cg.b, LLVM_INT_EQ, r, Jit.cptr(cg, succ as u64), "")
        let hit Jit.block_for(cg, succ)
        let miss LLVMAppendBasicBlockInContext(cg.s.ctx, cg.fn, "chk")
        LLVMBuildCondBr(cg.b, eq, hit, miss)
        LLVMPositionBuilderAtEnd(cg.b, miss)
    }

    ; ======================================================================
    ; Native lowering of the hot arms.
    ;
    ; Every one of these is a literal transcription of the matching arm of
    ; `Insn.execute` — read them side by side. They are what the JIT actually
    ; buys: the interpreter pays a call plus a 46-way dispatch per instruction
    ; to do what these do in three or four machine instructions.
    ;
    ; Returns false when the arm is not lowered here; the caller then emits the
    ; generic form, which is equally correct.
    ; ======================================================================
    function emit_native(cg: ref[Cg], i: ref[Insn]) returns bool
    {
        choose *i
            when a: Constant
            {
                Jit.need_stack(cg, 1)
                let sb Jit.ld_sbase(cg)
                let sp Jit.ld_sp(cg)
                Jit.st_slot(cg, sb, sp, Jit.cptr(cg, a.value as u64))
                Jit.st_sp(cg, Jit.add64(cg, sp, 1))
                Jit.goto_insn(cg, a.next)
                return true
            }
            when a: Pop
            {
                let sp Jit.ld_sp(cg)
                Jit.st_sp(cg, Jit.add64(cg, sp, 0 - 1))
                Jit.goto_insn(cg, a.next)
                return true
            }
            when a: FrameRef
            {
                Jit.need_stack(cg, 1)
                let sb Jit.ld_sbase(cg)
                let sp Jit.ld_sp(cg)
                let fs Jit.ld_i64(cg, cg.s.off_frame_start)
                let v Jit.ld_slot(cg, sb, Jit.add64(cg, fs, a.index as i64))
                Jit.st_slot(cg, sb, sp, v)
                Jit.st_sp(cg, Jit.add64(cg, sp, 1))
                Jit.goto_insn(cg, a.next)
                return true
            }
            when a: StackRef
            {
                Jit.need_stack(cg, 1)
                let sb Jit.ld_sbase(cg)
                let sp Jit.ld_sp(cg)
                let v Jit.ld_slot(cg, sb, Jit.add64(cg, sp, a.index as i64))
                Jit.st_slot(cg, sb, sp, v)
                Jit.st_sp(cg, Jit.add64(cg, sp, 1))
                Jit.goto_insn(cg, a.next)
                return true
            }
            when a: ClosureRef
            {
                Jit.need_stack(cg, 1)
                let sb Jit.ld_sbase(cg)
                let sp Jit.ld_sp(cg)
                let cl Jit.ld_field_ptr(cg, cg.s.off_closure)
                let v Jit.ld_slot(cg, cl, Jit.c64(cg, a.index as i64))
                Jit.st_slot(cg, sb, sp, v)
                Jit.st_sp(cg, Jit.add64(cg, sp, 1))
                Jit.goto_insn(cg, a.next)
                return true
            }
            when a: PopBindings
            {
                ; sp -= n; sbase[sp-1] = sbase[sp+n-1]
                let sb Jit.ld_sbase(cg)
                let sp0 Jit.ld_sp(cg)
                let sp1 Jit.add64(cg, sp0, 0 - (a.n as i64))
                Jit.st_sp(cg, sp1)
                let v Jit.ld_slot(cg, sb, Jit.add64(cg, sp1, (a.n as i64) - 1))
                Jit.st_slot(cg, sb, Jit.add64(cg, sp1, 0 - 1), v)
                Jit.goto_insn(cg, a.next)
                return true
            }
            when a: SetImmediate
            {
                let sb Jit.ld_sbase(cg)
                let sp0 Jit.ld_sp(cg)
                let sp1 Jit.add64(cg, sp0, 0 - 1)
                Jit.st_sp(cg, sp1)
                let v Jit.ld_slot(cg, sb, sp1)
                Jit.st_slot(cg, sb, Jit.add64(cg, sp1, 0 - (a.n as i64)), v)
                Jit.goto_insn(cg, a.next)
                return true
            }
            when a: SetKeyArg
            {
                let sb Jit.ld_sbase(cg)
                let sp0 Jit.ld_sp(cg)
                let val Jit.ld_slot(cg, sb, Jit.add64(cg, sp0, 0 - 1))
                let sp1 Jit.add64(cg, sp0, 0 - 1)
                Jit.st_sp(cg, sp1)
                Jit.st_slot(cg, sb, Jit.add64(cg, sp1, a.offset as i64), val)
                Jit.goto_insn(cg, a.next)
                return true
            }
            when a: StackSet
            {
                let sb Jit.ld_sbase(cg)
                let sp Jit.ld_sp(cg)
                let at Jit.add64(cg, sp, a.index as i64)
                let top Jit.add64(cg, sp, 0 - 1)
                let tem Jit.ld_slot(cg, sb, at)
                let v Jit.ld_slot(cg, sb, top)
                Jit.st_slot(cg, sb, at, v)
                Jit.st_slot(cg, sb, top, tem)
                Jit.goto_insn(cg, a.next)
                return true
            }
            when a: Unbox
            {
                let sb Jit.ld_sbase(cg)
                let sp Jit.ld_sp(cg)
                let top Jit.add64(cg, sp, 0 - 1)
                let v Jit.ld_slot(cg, sb, top)
                let nv Jit.call1(cg, cg.ty_p_p, cg.p_box_value, v)
                Jit.st_slot(cg, sb, top, nv)
                Jit.goto_insn(cg, a.next)
                return true
            }
            when a: Box
            {
                let sb Jit.ld_sbase(cg)
                let sp Jit.ld_sp(cg)
                let top Jit.add64(cg, sp, 0 - 1)
                let v Jit.ld_slot(cg, sb, top)
                let nv Jit.call2(cg, cg.ty_p_pp, cg.p_box, cg.vm, v)
                Jit.st_slot(cg, sb, top, nv)
                Jit.goto_insn(cg, a.next)
                return true
            }
            when a: BoxStack
            {
                let sb Jit.ld_sbase(cg)
                let sp Jit.ld_sp(cg)
                let at Jit.add64(cg, sp, a.n as i64)
                let v Jit.ld_slot(cg, sb, at)
                let nv Jit.call2(cg, cg.ty_p_pp, cg.p_box, cg.vm, v)
                Jit.st_slot(cg, sb, at, nv)
                Jit.goto_insn(cg, a.next)
                return true
            }
            when a: BoxArg
            {
                ; idx = sp + n - nActualArgs
                let sb Jit.ld_sbase(cg)
                let sp Jit.ld_sp(cg)
                let naa Jit.ld_i64(cg, cg.s.off_naa)
                let base Jit.add64(cg, sp, a.n as i64)
                let at LLVMBuildSub(cg.b, base, naa, "")
                let v Jit.ld_slot(cg, sb, at)
                let nv Jit.call2(cg, cg.ty_p_pp, cg.p_box, cg.vm, v)
                Jit.st_slot(cg, sb, at, nv)
                Jit.goto_insn(cg, a.next)
                return true
            }
            when a: Cons
            {
                let sb Jit.ld_sbase(cg)
                let sp Jit.ld_sp(cg)
                let car Jit.ld_slot(cg, sb, Jit.add64(cg, sp, 0 - 1))
                let cdr_at Jit.add64(cg, sp, 0 - 2)
                let cdr Jit.ld_slot(cg, sb, cdr_at)
                let pr Jit.call4(cg, cg.ty_p_pppp, cg.p_cons, Jit.cptr(cg, i as u64), cg.vm, car, cdr)
                Jit.st_slot(cg, sb, cdr_at, pr)
                Jit.st_sp(cg, Jit.add64(cg, sp, 0 - 1))
                Jit.goto_insn(cg, a.next)
                return true
            }
            when a: Test
            {
                let sb Jit.ld_sbase(cg)
                let sp Jit.ld_sp(cg)
                let top Jit.add64(cg, sp, 0 - 1)
                let v Jit.ld_slot(cg, sb, top)
                Jit.st_sp(cg, top)
                let t Jit.call1(cg, cg.ty_i64_p, cg.p_is_true, v)
                let c LLVMBuildICmp(cg.b, LLVM_INT_NE, t, Jit.c64(cg, 0), "")
                let yes Jit.target_block(cg, a.consequent)
                let no Jit.target_block(cg, a.alternative)
                LLVMBuildCondBr(cg.b, c, yes, no)
                return true
            }
            when a: Or
            {
                ; true keeps the value and goes to next; false pops and retests
                let sb Jit.ld_sbase(cg)
                let sp Jit.ld_sp(cg)
                let v Jit.ld_slot(cg, sb, Jit.add64(cg, sp, 0 - 1))
                let t Jit.call1(cg, cg.ty_i64_p, cg.p_is_true, v)
                let c LLVMBuildICmp(cg.b, LLVM_INT_NE, t, Jit.c64(cg, 0), "")
                let yes Jit.target_block(cg, a.next)
                let pop_bb LLVMAppendBasicBlockInContext(cg.s.ctx, cg.fn, "orpop")
                LLVMBuildCondBr(cg.b, c, yes, pop_bb)
                LLVMPositionBuilderAtEnd(cg.b, pop_bb)
                let sp2 Jit.ld_sp(cg)
                Jit.st_sp(cg, Jit.add64(cg, sp2, 0 - 1))
                Jit.goto_insn(cg, a.next_test)
                return true
            }
            when a: And
            {
                ; false keeps the value and goes to next; true pops and retests
                let sb Jit.ld_sbase(cg)
                let sp Jit.ld_sp(cg)
                let v Jit.ld_slot(cg, sb, Jit.add64(cg, sp, 0 - 1))
                let t Jit.call1(cg, cg.ty_i64_p, cg.p_is_true, v)
                let c LLVMBuildICmp(cg.b, LLVM_INT_EQ, t, Jit.c64(cg, 0), "")
                let no Jit.target_block(cg, a.next)
                let pop_bb LLVMAppendBasicBlockInContext(cg.s.ctx, cg.fn, "andpop")
                LLVMBuildCondBr(cg.b, c, no, pop_bb)
                LLVMPositionBuilderAtEnd(cg.b, pop_bb)
                let sp2 Jit.ld_sp(cg)
                Jit.st_sp(cg, Jit.add64(cg, sp2, 0 - 1))
                Jit.goto_insn(cg, a.next_test)
                return true
            }
            when a: Case
            {
                let sb Jit.ld_sbase(cg)
                let sp Jit.ld_sp(cg)
                let v Jit.ld_slot(cg, sb, Jit.add64(cg, sp, 0 - 1))
                let t Jit.call2(cg, cg.ty_i64_pp, cg.p_eqv, v, Jit.cptr(cg, a.obj as u64))
                let c LLVMBuildICmp(cg.b, LLVM_INT_NE, t, Jit.c64(cg, 0), "")
                let hit_bb LLVMAppendBasicBlockInContext(cg.s.ctx, cg.fn, "casehit")
                let miss Jit.target_block(cg, a.fail)
                LLVMBuildCondBr(cg.b, c, hit_bb, miss)
                LLVMPositionBuilderAtEnd(cg.b, hit_bb)
                let sp2 Jit.ld_sp(cg)
                Jit.st_sp(cg, Jit.add64(cg, sp2, 0 - 1))
                Jit.goto_insn(cg, a.matched)
                return true
            }
            when a: TestNull
            {
                let sb Jit.ld_sbase(cg)
                let sp Jit.ld_sp(cg)
                let v Jit.ld_slot(cg, sb, Jit.add64(cg, sp, a.offset as i64))
                let c LLVMBuildICmp(cg.b, LLVM_INT_EQ, v, cg.nullp, "")
                let yes Jit.target_block(cg, a.if_null)
                let no Jit.target_block(cg, a.if_not_null)
                LLVMBuildCondBr(cg.b, c, yes, no)
                return true
            }
            ; ==================================================================
            ; The five HOT arms (rung 2, 2026-08-06). Each replaces two calls
            ; plus the interpreter's jump table with ONE call to the helper of
            ; the same name, and lowers everything around it — the stack
            ; arithmetic, the null tests, the branch to the static successor —
            ; into IR. CheckInit's fast path ends up with no call at all.
            ; ==================================================================
            when a: Return
            {
                ; ReturnInsn::execute. `jit_pop_frame` reads the VM's sp (that
                ; is where the restored frame_start comes from), so sp is stored
                ; BEFORE the call; it does not touch sbase, so the pointer
                ; loaded before the call stays valid after it.
                let sb Jit.ld_sbase(cg)
                let sp Jit.ld_sp(cg)
                let result Jit.ld_slot(cg, sb, Jit.add64(cg, sp, 0 - 1))
                let sp1 Jit.add64(cg, sp, (0 - 1) - (a.total_args as i64))
                Jit.st_sp(cg, sp1)
                let nxt Jit.call2(cg, cg.ty_p_pp, cg.p_pop_frame, cg.vm, result)
                Jit.st_slot(cg, sb, sp1, result)
                Jit.st_sp(cg, Jit.add64(cg, sp1, 1))
                ; The successor is the frame's, i.e. dynamic: a Return always
                ; leaves the region and the trampoline re-enters at the caller's
                ; continuation — which rung 1 makes a valid native entry.
                Jit.ret_ptr(cg, nxt)
                return true
            }
            when a: PrimitiveCall
            {
                ; a primitive can push a frame and hand control to a closure
                ; (ELObj.prim_call_return), so its continuation is re-enterable
                Jit.note_entry(cg, a.next)
                let r Jit.call2(cg, cg.ty_p_pp, cg.p_prim_call, Jit.cptr(cg, i as u64), cg.vm)
                Jit.emit_rejoin(cg, r, a.next)
                Jit.ret_ptr(cg, r)
                return true
            }
            when a: FunctionCall
            {
                ; VM::setNActualArgs is one store; the dispatch on the callee
                ; object is what the helper is for.
                ; THE re-entry point of the whole design: the callee's Return
                ; answers exactly this insn, so it must be a multiplexer case.
                Jit.note_entry(cg, a.next)
                Jit.st_i64(cg, cg.s.off_naa, Jit.c64(cg, a.n_args as i64))
                let r Jit.call2(cg, cg.ty_p_pp, cg.p_function_call, Jit.cptr(cg, i as u64), cg.vm)
                ; rung 4: for a statically known Closure callee the helper's
                ; answer IS its body, so try that compare FIRST — `a.next` is
                ; only what a PRIMITIVE or a continuation answers here. This
                ; removes the outbound trampoline turn of a call; the inbound
                ; one stays, because a Return's target is the frame's, i.e.
                ; dynamic.
                let cc Jit.rejoin_callee(cg, a.func)
                if cc <> null
                {
                    Jit.note_entry(cg, cc)
                    Jit.emit_rejoin(cg, r, cc)
                }
                Jit.emit_rejoin(cg, r, a.next)
                Jit.ret_ptr(cg, r)
                return true
            }
            when a: TopRef
            {
                let v Jit.call2(cg, cg.ty_p_pp, cg.p_top_ref, Jit.cptr(cg, i as u64), cg.vm)
                let bad LLVMBuildICmp(cg.b, LLVM_INT_EQ, v, cg.nullp, "")
                let err_bb LLVMAppendBasicBlockInContext(cg.s.ctx, cg.fn, "trerr")
                let ok_bb LLVMAppendBasicBlockInContext(cg.s.ctx, cg.fn, "trok")
                LLVMBuildCondBr(cg.b, bad, err_bb, ok_bb)
                LLVMPositionBuilderAtEnd(cg.b, err_bb)
                Jit.st_sp(cg, Jit.c64(cg, 0 - 1))
                LLVMBuildRet(cg.b, Jit.c64(cg, 0))
                LLVMPositionBuilderAtEnd(cg.b, ok_bb)
                ; the value computation can evaluate a top-level definition,
                ; which grows the value stack — so sbase is loaded AFTER it.
                Jit.need_stack(cg, 1)
                let sb Jit.ld_sbase(cg)
                let sp Jit.ld_sp(cg)
                Jit.st_slot(cg, sb, sp, v)
                Jit.st_sp(cg, Jit.add64(cg, sp, 1))
                Jit.goto_insn(cg, a.next)
                return true
            }
            ; ==================================================================
            ; The four arms the DYNAMIC step histogram named (rung 3). Each is
            ; the generic shape with `jit_execute` replaced by the arm's own
            ; helper — one call instead of two plus the 46-way jump table. See
            ; the helper block at the top of this file for the measurement.
            ; ==================================================================
            when a: ResolveQuantities
            {
                ; ★ NO note_entry: this arm answers `next` or fails, so the
                ; trampoline can never arrive at `next` through it. One case
                ; fewer is one block more dominated (see note_entry).
                let r Jit.call2(cg, cg.ty_p_pp, cg.p_resolve_q, Jit.cptr(cg, i as u64), cg.vm)
                Jit.emit_rejoin(cg, r, a.next)
                Jit.ret_ptr(cg, r)
                return true
            }
            when a: FunctionTailCall
            {
                Jit.st_i64(cg, cg.s.off_naa, Jit.c64(cg, a.n_args as i64))
                let r Jit.call2(cg, cg.ty_p_pp, cg.p_function_tail_call, Jit.cptr(cg, i as u64), cg.vm)
                ; rung 4: a statically known Closure callee is a native branch,
                ; and a SELF tail call is then a loop in one function.
                let cc Jit.rejoin_callee(cg, a.func)
                if cc <> null
                {
                    Jit.note_entry(cg, cc)
                    Jit.emit_rejoin(cg, r, cc)
                }
                Jit.ret_ptr(cg, r)
                return true
            }
            when a: Apply
            {
                Jit.note_entry(cg, a.next)
                let r Jit.call2(cg, cg.ty_p_pp, cg.p_apply, Jit.cptr(cg, i as u64), cg.vm)
                Jit.emit_rejoin(cg, r, a.next)
                Jit.ret_ptr(cg, r)
                return true
            }
            when a: TailApply
            {
                let r Jit.call2(cg, cg.ty_p_pp, cg.p_tail_apply, Jit.cptr(cg, i as u64), cg.vm)
                Jit.ret_ptr(cg, r)
                return true
            }
            when a: CheckInit
            {
                let sb Jit.ld_sbase(cg)
                let sp Jit.ld_sp(cg)
                let v Jit.ld_slot(cg, sb, Jit.add64(cg, sp, 0 - 1))
                let bad LLVMBuildICmp(cg.b, LLVM_INT_EQ, v, cg.nullp, "")
                let err_bb LLVMAppendBasicBlockInContext(cg.s.ctx, cg.fn, "ckerr")
                let ok_bb LLVMAppendBasicBlockInContext(cg.s.ctx, cg.fn, "ckok")
                LLVMBuildCondBr(cg.b, bad, err_bb, ok_bb)
                LLVMPositionBuilderAtEnd(cg.b, err_bb)
                Jit.call2(cg, cg.ty_p_pp, cg.p_check_init_fail, Jit.cptr(cg, i as u64), cg.vm)
                LLVMBuildRet(cg.b, Jit.c64(cg, 0))
                LLVMPositionBuilderAtEnd(cg.b, ok_bb)
                Jit.goto_insn(cg, a.next)
                return true
            }
            else
                return false
        false
    }


    ; ======================================================================
    ; Batch collection.
    ;
    ; ★ WHY BATCHES EXIST, measured 2026-08-06: a module per code body cost
    ;   ~3.6 ms in ORC materialisation plus ~0.9 ms in the pass pipeline —
    ;   540 hot bodies of the DocBook print stylesheets came to 2.5 s of LLVM
    ;   time against a 0.5 s interpreter run, i.e. the ENTIRE gap between the two
    ;   modes was module setup. The cost is per MODULE and almost independent of
    ;   its size, so the answer is to put many bodies in one.
    ;
    ; A batch is simply the bodies that crossed the HotSpot threshold since the
    ; last module was built — `s.queue`. Nothing else is pulled in: an earlier
    ; attempt to batch the transitive closure of the trigger body over the
    ; ClosureMk/varargs/call edges compiled 25 104 bodies in 126 s, because
    ; amortising the module cost is worthless when the batch is full of code that
    ; never runs. What made the simple form work is rung 1, not a bigger batch:
    ; see queue_body and build_entry.
    ; ----------------------------------------------------------------------
    function note_root(cg: ref[Cg], i: ref[Insn])
    {
        if i = null
            return
        let key i as u64
        if Jit.map_get(cg.root_set, key, 0) <> 0
            return
        if cg.roots.get_length() >= Jit.max_batch_roots()
            return
        Jit.map_put(cg.root_set, key, 1)
        cg.roots.add i
    }

    function max_batch_roots() returns size_t
        512

    ; ======================================================================
    ; Queueing a hot body (rung 1's other half).
    ;
    ; ★ The reason this exists: between crossing the threshold and being
    ;   compiled, a body keeps being interpreted one insn at a time — so without
    ;   marking, every insn inside it accumulates its OWN entry count, crosses
    ;   the threshold on its own, and arrives in the same batch as the root of a
    ;   duplicate region. That is the whole mechanism behind the measured
    ;   540 -> 2560 root explosion at batch 32 (PERFORMANCE.md). Marking the
    ;   statically reachable set as `queued` when the root is queued stops the
    ;   counting; compile_queue then replaces each mark with the function's
    ;   address, and clear_marks lifts whatever the region walk did not cover
    ;   (the size cap can cut it short) so those insns start counting again.
    ; ======================================================================
    procedure queue_body(s: ref[Session], root: ref[Insn])
    {
        let h s.host
        let work Array[pointer[Insn]]^h()
        Jit.mark_queued(s, work, root)
        var cursor: size_t 0
        while cursor < work.get_length()
        {
            if work.get_length() >= (Jit.max_region_insns() as size_t)
                break
            let pp work.get cursor
            set cursor: cursor + 1
            if pp <> null
            {
                let ins *pp
                var succ0: pointer[Insn] null
                var succ1: pointer[Insn] null
                let n Jit.insn_successors(ins, &succ0, &succ1)
                if n > 0
                    Jit.mark_queued(s, work, succ0)
                if n > 1
                    Jit.mark_queued(s, work, succ1)
            }
        }
        s.queue.add root
    }

    ; Mark one insn as queued, unless it already has a real address, is rejected,
    ; or is already marked. Marked insns are remembered for clear_marks.
    procedure mark_queued(s: ref[Session], work: pointer[Array[pointer[Insn]]], i: ref[Insn])
    {
        if i = null
            return
        let key i as u64
        let v Jit.map_get(s.regions, key, 0)
        if v = Jit.cache_queued()
            return
        if v = Jit.cache_rejected()
            return
        if v <> 0
            if (v & 1) = 0
                return
        Jit.map_put(s.regions, key, Jit.cache_queued())
        s.marks.add i
        work.add i
    }

    ; Lift every mark the compile did not turn into an entry point. Value 0 in
    ; the cache reads as absent, so the insn simply starts counting again.
    procedure clear_marks(s: ref[Session])
    {
        var i: size_t 0
        while i < s.marks.get_length()
        {
            let pp s.marks.get i
            if pp <> null
            {
                let ins *pp
                let key ins as u64
                if Jit.map_get(s.regions, key, 0) = Jit.cache_queued()
                    Jit.map_put(s.regions, key, 0)
            }
            set i: i + 1
        }
        let h s.host
        set s.marks: Array[pointer[Insn]]^h()
    }

    ; ======================================================================
    ; The batch compiler: one LLVM module, one function per queued code body.
    ; ======================================================================
    ; Compile every queued body into ONE module. Nothing is added to the batch
    ; that has not crossed the threshold on its own.
    ;
    ; The wrapper exists only to time the whole thing, including every early
    ; return — see JIT_COMPILE_USEC.
    procedure compile_queue(s: ref[Session])
    {
        let t0 scaly_time_cpu_usec()
        Jit.compile_queue_inner(s)
        set JIT_COMPILE_USEC: JIT_COMPILE_USEC + (scaly_time_cpu_usec() - t0)
    }

    procedure compile_queue_inner(s: ref[Session])
    {
        let ctx s.ctx
        let h s.host
        let batch s.n_modules
        set s.n_modules: batch + 1
        set JIT_N_MODULES: JIT_N_MODULES + 1

        ; module name: dazzle_jit_bN, function names dazzle_jit_bN_rK
        var mb StringBuilder()
        mb.append "dazzle_jit_b"
        mb.append batch
        let mname mb.to_string()
        let mname_c mname.to_c_string()

        let mod LLVMModuleCreateWithNameInContext(mname_c, ctx)
        if mod = null
            return
        let dl LLVMOrcLLJITGetDataLayoutStr(s.jit)
        if dl <> null
            LLVMSetDataLayout(mod, dl)

        let i8t LLVMInt8TypeInContext(ctx)
        let i64t LLVMInt64TypeInContext(ctx)
        let ptrt LLVMPointerTypeInContext(ctx, 0)
        let voidt LLVMVoidTypeInContext(ctx)

        ; the type buffers: at most three parameters anywhere in this file
        ; four slots: the 4-pointer signature (jit_cons, which takes its insn)
        ; reads the fourth
        var tbuf u8[40]
        let tp tbuf as pointer[pointer[void]]
        set *tp: ptrt
        set *(tp + 1): ptrt
        set *(tp + 2): ptrt
        set *(tp + 3): ptrt
        let ty_p_p LLVMFunctionType(ptrt, tp, 1, 0)
        let ty_p_pp LLVMFunctionType(ptrt, tp, 2, 0)
        let ty_p_ppp LLVMFunctionType(ptrt, tp, 3, 0)
        let ty_p_pppp LLVMFunctionType(ptrt, tp, 4, 0)
        let ty_i64_p LLVMFunctionType(i64t, tp, 1, 0)
        let ty_i64_pp LLVMFunctionType(i64t, tp, 2, 0)
        ; ★ Rung 1: the region signature is `i64 f(ptr vm, ptr insn)`. The second
        ; parameter is the entry multiplexer's selector — see build_entry.
        let ty_region LLVMFunctionType(i64t, tp, 2, 0)
        ; void(ptr, i64)
        var tbuf2 u8[32]
        let tp2 tbuf2 as pointer[pointer[void]]
        set *tp2: ptrt
        set *(tp2 + 1): i64t
        let ty_need LLVMFunctionType(voidt, tp2, 2, 0)

        let b LLVMCreateBuilderInContext(ctx)
        let cg Cg^h(s)
        set cg.b: b
        set cg.i8t: i8t
        set cg.i64t: i64t
        set cg.ptrt: ptrt
        set cg.voidt: voidt
        set cg.ty_exec: ty_p_pp
        set cg.ty_need: ty_need
        set cg.ty_i64_p: ty_i64_p
        set cg.ty_i64_pp: ty_i64_pp
        set cg.ty_p_p: ty_p_p
        set cg.ty_p_pp: ty_p_pp
        set cg.ty_p_ppp: ty_p_ppp
        set cg.ty_p_pppp: ty_p_pppp
        set cg.nullp: LLVMConstIntToPtr(LLVMConstInt(i64t, 0, 0), ptrt)
        set cg.p_exec: Jit.const_addr(cg, &jit_execute)
        set cg.p_need: Jit.const_addr(cg, &jit_need_stack)
        set cg.p_is_true: Jit.const_addr(cg, &jit_is_true)
        set cg.p_eqv: Jit.const_addr(cg, &jit_eqv)
        set cg.p_box: Jit.const_addr(cg, &jit_box)
        set cg.p_box_value: Jit.const_addr(cg, &jit_box_value)
        set cg.p_cons: Jit.const_addr(cg, &jit_cons)
        set cg.p_pop_frame: Jit.const_addr(cg, &jit_pop_frame)
        set cg.p_prim_call: Jit.const_addr(cg, &jit_prim_call)
        set cg.p_function_call: Jit.const_addr(cg, &jit_function_call)
        set cg.p_top_ref: Jit.const_addr(cg, &jit_top_ref_value)
        set cg.p_check_init_fail: Jit.const_addr(cg, &jit_check_init_fail)
        set cg.p_resolve_q: Jit.const_addr(cg, &jit_resolve_quantities)
        set cg.p_function_tail_call: Jit.const_addr(cg, &jit_function_tail_call)
        set cg.p_apply: Jit.const_addr(cg, &jit_apply)
        set cg.p_tail_apply: Jit.const_addr(cg, &jit_tail_apply)
        set cg.roots: Array[pointer[Insn]]^h()
        set cg.root_set: Jit.map_make(h, 1024)
        set cg.all_insns: Array[pointer[Insn]]^h()
        set cg.all_roots: Array[pointer[Insn]]^h()
        var qi: size_t 0
        while qi < s.queue.get_length()
        {
            let qpp s.queue.get qi
            if qpp <> null
            {
                let q *qpp
                Jit.note_root(cg, q)
            }
            set qi: qi + 1
        }
        ; the queue is consumed; a fresh one collects the next batch (Array does
        ; not shrink, and these live on the run arena anyway)
        set s.queue: Array[pointer[Insn]]^h()

        ; One function per root. The roots list grows while we walk it — a
        ; lambda body found inside root K becomes root K+n and lands in this same
        ; module, which is the entire point of the batch.
        var ri: size_t 0
        while ri < cg.roots.get_length()
        {
            let rpp cg.roots.get ri
            if rpp <> null
            {
                let rt *rpp
                let fname Jit.region_fn_name(h, batch, ri)
                let fn LLVMAddFunction(mod, fname, ty_region)
                set cg.fn: fn
                set cg.vm: LLVMGetParam(fn, 0)
                set cg.insn_p: LLVMGetParam(fn, 1)
                set cg.blocks: Jit.map_make(h, 256)
                set cg.pending: Array[pointer[Insn]]^h()
                set cg.entry_set: Jit.map_make(h, 64)
                set cg.cur_root: rt
                set cg.n_insns: 0
                Jit.build_entry(cg)
                ; the root is always an entry: that is how a call into this body
                ; arrives. Every other case is noted while lowering (note_entry).
                Jit.note_entry(cg, rt)
                Jit.block_for(cg, rt)

                ; Worklist over the pending blocks. `block_for` appends while we
                ; walk, which IS the graph traversal — a cursor, because Array
                ; does not shrink.
                var cursor: size_t 0
                while cursor < cg.pending.get_length()
                {
                    let ipp cg.pending.get cursor
                    set cursor: cursor + 1
                    if ipp <> null
                    {
                        let ins *ipp
                        let key ins as u64
                        let bb Jit.map_get(cg.blocks, key, 0)
                        if bb <> 0
                        {
                            LLVMPositionBuilderAtEnd(b, bb as pointer[void])
                            set cg.n_insns: cg.n_insns + 1
                            set JIT_N_INSNS: JIT_N_INSNS + 1
                            if Jit.emit_native(cg, ins)
                            {
                                set cg.n_native: cg.n_native + 1
                                set JIT_N_NATIVE_INSNS: JIT_N_NATIVE_INSNS + 1
                            }
                            else
                                Jit.emit_generic(cg, ins)
                        }
                    }
                }
                ; the multiplexer's cases, once every block of this function
                ; exists and every arm has said where it can be re-entered
                Jit.wire_entries(cg)
            }
            set ri: ri + 1
        }
        LLVMDisposeBuilder(b)

        ; ★ The literal is passed DIRECTLY at the call. Binding it to a
        ;   `pointer[const_char]` local first produced GARBAGE — LLVM answered
        ;   `unknown pass name ' \xd6j'` and the pipeline silently did nothing
        ;   (measured 2026-08-06). Same family as "a function must not RETURN a
        ;   pointer[const_char] literal"; passing a literal into a call works.
        ;   Without the pipeline the lowering's per-insn loads and stores of
        ;   `sp`/`sbase` all survive into machine code.
        let pb_opts LLVMCreatePassBuilderOptions()
        var opt_err: pointer[void] null
        if JIT_PIPELINE = null
            set opt_err: LLVMRunPasses(mod, "function(sroa,early-cse,instcombine,simplifycfg,gvn,instcombine,simplifycfg)", null as pointer[void], pb_opts)
        else
            set opt_err: LLVMRunPasses(mod, JIT_PIPELINE, null as pointer[void], pb_opts)
        LLVMDisposePassBuilderOptions(pb_opts)
        if opt_err <> null
        {
            ; Not fatal — ORC gets the unoptimised module — but LOUD: a silently
            ; skipped pipeline is a JIT that quietly runs slower than the
            ; interpreter, which is what the pipeline exists to prevent.
            Llvm.failed(opt_err, "pass pipeline failed")
        }

        if JIT_DUMP
        {
            let ir LLVMPrintModuleToString(mod)
            if ir <> null
            {
                let ir_c ir as pointer[const_char]
                scaly_eputs ir_c
                LLVMDisposeMessage(ir)
            }
        }

        ; ★ Verify every module. A malformed region is OUR bug, and an
        ;   unverified module handed to ORC is a crash somewhere else entirely.
        var vmsg: pointer[char] null
        if LLVMVerifyModule(mod, LLVM_VERIFIER_RETURN_STATUS, &vmsg) <> 0
        {
            scaly_eputs "dazzle JIT: generated module does not verify: "
            if vmsg <> null
            {
                let vmsg_c vmsg as pointer[const_char]
                scaly_eputs vmsg_c
                LLVMDisposeMessage(vmsg)
            }
            scaly_eputs "\n"
            Jit.reject_batch(s, cg)
            return
        }

        let tsm LLVMOrcCreateNewThreadSafeModule(mod, s.tsc)
        if tsm = null
        {
            Jit.reject_batch(s, cg)
            return
        }
        let add_err LLVMOrcLLJITAddLLVMIRModule(s.jit, s.jd, tsm)
        if Llvm.failed(add_err, "could not add region module")
        {
            Jit.reject_batch(s, cg)
            return
        }

        ; Resolve every function of the batch. The addresses go into a map of
        ; their own first: the second pass reads them while WRITING the region
        ; cache, and a root that is also a mid-body insn of another function
        ; would otherwise be read back after being overwritten.
        let addrs Jit.map_make(h, 1024)
        var rj: size_t 0
        while rj < cg.roots.get_length()
        {
            let rpp2 cg.roots.get rj
            if rpp2 <> null
            {
                let rt2 *rpp2
                let fname2 Jit.region_fn_name(h, batch, rj)
                var addr: u64 0
                let look_err LLVMOrcLLJITLookup(s.jit, &addr, fname2)
                var ok false
                if look_err <> null
                    Llvm.failed(look_err, "region lookup failed")
                else
                {
                    if addr <> 0
                        if (addr & 1) = 0
                            set ok: true
                }
                if ok
                {
                    Jit.map_put(addrs, rt2 as u64, addr)
                    Jit.map_put(s.regions, rt2 as u64, addr)
                    set JIT_N_REGIONS: JIT_N_REGIONS + 1
                }
                else
                {
                    ; never try this body again — it stays interpreted
                    Jit.map_put(s.regions, rt2 as u64, Jit.cache_rejected())
                    set JIT_N_REJECTED: JIT_N_REJECTED + 1
                }
            }
            set rj: rj + 1
        }

        ; ★ Rung 1: cache every insn that got a block as an entry of its
        ; function. The first mapping wins — an insn covered by two functions of
        ; this batch is a valid entry of both, and picking one is enough.
        var ai: size_t 0
        while ai < cg.all_insns.get_length()
        {
            let ipp2 cg.all_insns.get ai
            let rpp3 cg.all_roots.get ai
            if ipp2 <> null
            {
                if rpp3 <> null
                {
                    let ins2 *ipp2
                    let own *rpp3
                    let a2 Jit.map_get(addrs, own as u64, 0)
                    if a2 <> 0
                    {
                        let had Jit.map_get(s.regions, ins2 as u64, 0)
                        var take true
                        if had <> 0
                            if (had & 1) = 0
                                if had <> Jit.cache_queued()
                                    set take: false
                        if take
                        {
                            Jit.map_put(s.regions, ins2 as u64, a2)
                            set JIT_N_ENTRY_POINTS: JIT_N_ENTRY_POINTS + 1
                        }
                    }
                }
            }
            set ai: ai + 1
        }
        Jit.clear_marks(s)
    }

    ; A batch that could not be built leaves every one of its bodies on the
    ; interpreter, permanently — never queued again, so a broken module cannot
    ; turn into an endless compile loop.
    procedure reject_batch(s: ref[Session], cg: ref[Cg])
    {
        var i: size_t 0
        while i < cg.roots.get_length()
        {
            let rpp cg.roots.get i
            if rpp <> null
            {
                let rt *rpp
                Jit.map_put(s.regions, rt as u64, Jit.cache_rejected())
                set JIT_N_REJECTED: JIT_N_REJECTED + 1
            }
            set i: i + 1
        }
        ; the bodies stay interpreted, so their insns must count again rather
        ; than sit marked `queued` forever
        Jit.clear_marks(s)
    }

    ; dazzle_jit_b<batch>_r<index> — on the caller's page, so the c-string
    ; outlives the call that consumes it.
    function region_fn_name(host: pointer[Page], batch: int, index: size_t) returns pointer[const_char]
    {
        var sb StringBuilder()
        sb.append "dazzle_jit_b"
        sb.append batch
        sb.append "_r"
        sb.append index
        let nm sb.to_string()
        nm.to_c_string()
    }

    ; A Scaly function address as an IR pointer constant.
    function const_addr(cg: ref[Cg], fp: pointer[void]) returns pointer[void]
        Jit.cptr(cg, fp as u64)

    ; ======================================================================
    ; The trampoline seam
    ; ======================================================================

    ; Called from `jit_execute`, i.e. from inside a compiled region: the arm the
    ; code generator did not lower natively.
    procedure count_generic(i: ref[Insn])
    {
        let sess JIT_SESSION
        if sess = null
            return
        let s sess as pointer[Session]
        Jit.bump(s.arm_generic, i)
    }

    ; The native region for `i`, or 0 when the caller should interpret this
    ; step — because the body is still cold, or because compiling it failed.
    ; ★ ONE probe for the whole hot path, read and updated in place. This runs on
    ; EVERY insn the interpreter executes while a session is open, and measured
    ; 2026-08-06 that cost alone was 0.11 s on a 0.51 s run — 21 %, and the
    ; single biggest obstacle to the JIT ever being the default. The earlier
    ; shape called map_get and then map_put, i.e. hashed and probed the table
    ; TWICE per interpreted insn.
    function region_for(s: ref[Session], i: ref[Insn]) returns u64
    {
        let m s.regions
        let key i as u64
        var slot Jit.map_probe(m, key)
        ; entries INCLUDING this one; a threshold of 1 queues on first sight.
        var count: u64 1
        if *(m.keys + slot) = key
        {
            let v *(m.vals + slot)
            if (v & 1) = 0
            {
                if v = Jit.cache_rejected()
                    return 0
                if v = Jit.cache_queued()
                    return 0
                ; 0 is a slot whose mark was lifted again (clear_marks) — it
                ; reads as absent, so counting restarts at 1.
                if v <> 0
                    return v
            }
            else
                set count: (v >> 1) + 1
        }
        else
        {
            ; first sight of this insn: claim the slot. Growing rehashes, so the
            ; slot has to be found again afterwards.
            if (m.used + m.used) >= m.cap
            {
                Jit.map_grow(m)
                set slot: Jit.map_probe(m, key)
            }
            set *(m.keys + slot): key
            set m.used: m.used + 1
        }
        let limit JIT_THRESHOLD as u64
        if count < limit
        {
            set *(m.vals + slot): (count + count) + 1
            return 0
        }
        ; Hot. Queue it — together with every insn statically reachable from it,
        ; so nothing inside the body becomes a root of its own while it waits —
        ; and compile the whole queue once it is worth a module.
        Jit.queue_body(s, i)
        if s.queue.get_length() < (JIT_BATCH as size_t)
            return 0
        Jit.compile_queue(s)
        ; compile_queue fills the cache; this body is hot from here on.
        let after Jit.map_get(s.regions, key, 0)
        if after = 4
            return 0
        if after = 2
            return 0
        if (after & 1) <> 0
            return 0
        after
    }

    ; Advance from `i` as far as native code can, and answer where the
    ; interpreter should continue. This is the ONE function `VM.eval` calls; with
    ; no session open it is the interpreter's own step, which is why `--interp`
    ; needs no second loop.
    function step(i: ref[Insn], vm: ref[VM]) returns ref[Insn]
    {
        let sess JIT_SESSION
        if sess = null
            return i.execute(vm, true)
        let s sess as pointer[Session]
        let addr Jit.region_for(s, i)
        if addr = 0
        {
            if JIT_STATS
            {
                set JIT_N_INTERP_STEPS: JIT_N_INTERP_STEPS + 1
                Jit.bump(s.arm_interp, i)
            }
            return i.execute(vm, true)
        }
        if JIT_STATS
        {
            set JIT_N_ENTRIES: JIT_N_ENTRIES + 1
            Jit.bump(s.arm_entry, i)
        }
        let fp addr as pointer[void]
        ; the insn IS the entry selector — the multiplexer in the compiled body
        ; switches on it (rung 1)
        let r fp(vm as pointer[void], i as pointer[void])
        r as pointer[Insn]
    }

    function enabled() returns bool
    {
        if JIT_SESSION = null
            return false
        true
    }

    ; Open the session for this run. False means the engine stays on the
    ; interpreter — reported by the caller, never fatal.
    function enable(host: pointer[Page]) returns bool
    {
        if JIT_SESSION <> null
            return true
        let s Jit.open(host)
        if s = null
            return false
        set JIT_SESSION: s as pointer[void]
        true
    }

    procedure set_dump(on: bool)
        set JIT_DUMP: on

    ; DAZZLE_JIT_THRESHOLD overrides the HotSpot threshold; 0 means "compile on
    ; first sight". Present so the threshold is a MEASURED number and not a
    ; guess that nobody can re-check.
    procedure set_threshold(n: int)
        set JIT_THRESHOLD: n

    procedure set_pipeline(p: pointer[const_char])
        set JIT_PIPELINE: p

    ; DAZZLE_JIT_CODEGEN=0..3 — the backend opt level (measurement hook; 0 is the
    ; measured default).
    procedure set_codegen_level(n: int)
    {
        if n < 0
            return
        if n > 3
            return
        set JIT_CODEGEN_LEVEL: n as i32
    }

    ; DAZZLE_JIT_INLINE_CALLEE=1 — measurement hook; see JIT_INLINE_CALLEE.
    procedure set_inline_callee(on: bool)
        set JIT_INLINE_CALLEE: on

    ; DAZZLE_JIT_BATCH overrides the batch size; 1 compiles each hot body on its
    ; own, which is the shape to compare any batching against.
    procedure set_batch(n: int)
    {
        if n < 1
            return
        set JIT_BATCH: n
    }

    ; Ask for the `--jit-stats` line at exit. This also switches on the two
    ; per-insn counters — so a `--jit-stats` run is measurably slower than the
    ; run it measures, which is exactly the right trade for a diagnostic.
    procedure request_stats()
    {
        set JIT_STATS: true
        atexit(&jit_stats_atexit)
    }

    ; ======================================================================
    ; --jit-stats
    ; ======================================================================
    procedure print_stats()
    {
        var sb StringBuilder()
        sb.append "dazzle JIT: "
        if JIT_SESSION = null
            sb.append "interpreter (no session)"
        else
        {
            let n_regions JIT_N_REGIONS
            let n_insns JIT_N_INSNS
            let n_native JIT_N_NATIVE_INSNS
            let n_stepped JIT_N_INSNS - JIT_N_NATIVE_INSNS
            let n_entries JIT_N_ENTRIES
            let n_interp JIT_N_INTERP_STEPS
            let n_rejected JIT_N_REJECTED
            let n_modules JIT_N_MODULES
            let n_entry_points JIT_N_ENTRY_POINTS
            sb.append n_regions
            sb.append " regions, "
            sb.append n_insns
            sb.append " insns lowered ("
            sb.append n_native
            sb.append " native, "
            sb.append n_stepped
            sb.append " via the interpreter step), "
            sb.append n_entries
            sb.append " region entries, "
            sb.append n_interp
            sb.append " interpreted steps, "
            sb.append n_rejected
            sb.append " rejected roots, "
            sb.append n_modules
            sb.append " modules, "
            sb.append n_entry_points
            sb.append " extra entry points, "
            let ms JIT_COMPILE_USEC / 1000
            sb.append ms
            sb.append " ms compiling"
        }
        sb.append "\n"
        let line sb.to_string()
        let line_c line.to_c_string()
        scaly_eputs line_c
        if JIT_SESSION <> null
        {
            let s JIT_SESSION as pointer[Session]
            Jit.print_hist("  entries at   ", s.arm_entry)
            Jit.print_hist("  generic step ", s.arm_generic)
            Jit.print_hist("  interp step  ", s.arm_interp)
        }
    }

    ; One histogram line per population: the arms in descending count, down to
    ; 1 % of the total. Selection sort by repeated max scan — 48 slots, printed
    ; once at exit.
    procedure print_hist(title: pointer[const_char], h: pointer[u64])
    {
        if h = null
            return
        var total: u64 0
        var i 0
        while i < Jit.n_arms()
        {
            set total: total + *(h + i)
            set i: i + 1
        }
        if total = 0
            return
        scaly_eputs title
        var sb StringBuilder()
        sb.append total
        let head sb.to_string()
        let head_c head.to_c_string()
        scaly_eputs head_c
        scaly_eputs ":"
        var shown 0
        let cutoff total / 100
        var more true
        while more
        {
            if shown >= 14
                set more: false
            if more
            {
                var best 0 - 1
                var best_n: u64 0
                set i: 0
                while i < Jit.n_arms()
                {
                    let v *(h + i)
                    if v > best_n
                    {
                        set best_n: v
                        set best: i
                    }
                    set i: i + 1
                }
                if best < 0
                    set more: false
                if best_n <= cutoff
                    set more: false
                if more
                {
                    scaly_eputs " "
                    Jit.eput_arm_name(best)
                    let pct (best_n * 100) / total
                    var nb StringBuilder()
                    nb.append " "
                    nb.append pct
                    nb.append "%"
                    let ns nb.to_string()
                    let ns_c ns.to_c_string()
                    scaly_eputs ns_c
                    set *(h + best): 0
                    set shown: shown + 1
                }
            }
        }
        scaly_eputs "\n"
    }

    ; The arm names, as literals passed STRAIGHT into the call — a
    ; `pointer[const_char]` bound to a variable first arrives as garbage
    ; (CLAUDE.md, "Calls & operands"). Flat `if`s rather than an `else if`
    ; chain: 48 nested arms would be ~700 KB of planner stack for nothing.
    procedure eput_arm_name(k: int)
    {
        if k = 0
            scaly_eputs "Error"
        if k = 1
            scaly_eputs "CondFail"
        if k = 2
            scaly_eputs "CaseFail"
        if k = 3
            scaly_eputs "Constant"
        if k = 4
            scaly_eputs "ResolveQuantities"
        if k = 5
            scaly_eputs "Test"
        if k = 6
            scaly_eputs "Or"
        if k = 7
            scaly_eputs "And"
        if k = 8
            scaly_eputs "Case"
        if k = 9
            scaly_eputs "Pop"
        if k = 10
            scaly_eputs "Cons"
        if k = 11
            scaly_eputs "Append"
        if k = 12
            scaly_eputs "Apply"
        if k = 13
            scaly_eputs "TailApply"
        if k = 14
            scaly_eputs "FrameRef"
        if k = 15
            scaly_eputs "StackRef"
        if k = 16
            scaly_eputs "ClosureRef"
        if k = 17
            scaly_eputs "TopRef"
        if k = 18
            scaly_eputs "PopBindings"
        if k = 19
            scaly_eputs "Return"
        if k = 20
            scaly_eputs "PrimitiveCall"
        if k = 21
            scaly_eputs "ClosureMk"
        if k = 22
            scaly_eputs "FunctionCall"
        if k = 23
            scaly_eputs "FunctionTailCall"
        if k = 24
            scaly_eputs "Varargs"
        if k = 25
            scaly_eputs "SetKeyArg"
        if k = 26
            scaly_eputs "TestNull"
        if k = 27
            scaly_eputs "Box"
        if k = 28
            scaly_eputs "BoxArg"
        if k = 29
            scaly_eputs "BoxStack"
        if k = 30
            scaly_eputs "Unbox"
        if k = 31
            scaly_eputs "SetBox"
        if k = 32
            scaly_eputs "SetImmediate"
        if k = 33
            scaly_eputs "CheckInit"
        if k = 34
            scaly_eputs "StackSetBox"
        if k = 35
            scaly_eputs "StackSet"
        if k = 36
            scaly_eputs "ClosureSetBox"
        if k = 37
            scaly_eputs "Vector"
        if k = 38
            scaly_eputs "ListToVector"
        if k = 39
            scaly_eputs "MakeFlowObj"
        if k = 40
            scaly_eputs "LabelSosofo"
        if k = 41
            scaly_eputs "SetNic"
        if k = 42
            scaly_eputs "MakeStyle"
        if k = 43
            scaly_eputs "PushMode"
        if k = 44
            scaly_eputs "PopMode"
        if k = 45
            scaly_eputs "CheckSosofo"
        if k = 46
            scaly_eputs "UnpackMacroFlowObj"
        if k = 47
            scaly_eputs "?"
    }

    ; ======================================================================
    ; Self-test: build one module, JIT it, call it, and let the generated code
    ; call back into this binary. Proves the whole chain everything else rests
    ; on — context, module, inttoptr callback, ORC add, lookup, and the n-ary
    ; indirect call back from Scaly.
    ;
    ; Generated:  i64 @dazzle_jit_selftest(i64 %x) { ret i64 (double(%x) + 1) }
    ; ======================================================================
    function selftest(host: pointer[Page]) returns int
    {
        if Jit.check_helper_abi() = false
            return 1
        let s Jit.open(host)
        if s = null
            return 2
        let ctx s.ctx
        let mod LLVMModuleCreateWithNameInContext("dazzle_jit_selftest_mod", ctx)
        if mod = null
            return 3
        let dl LLVMOrcLLJITGetDataLayoutStr(s.jit)
        if dl <> null
            LLVMSetDataLayout(mod, dl)

        let i64t LLVMInt64TypeInContext(ctx)
        let ptrt LLVMPointerTypeInContext(ctx, 0)
        var tbuf u8[16]
        let tp tbuf as pointer[pointer[void]]
        set *tp: i64t
        let fn_ty LLVMFunctionType(i64t, tp, 1, 0)
        let fn LLVMAddFunction(mod, "dazzle_jit_selftest", fn_ty)
        let entry_bb LLVMAppendBasicBlockInContext(ctx, fn, "entry")
        let b LLVMCreateBuilderInContext(ctx)
        LLVMPositionBuilderAtEnd(b, entry_bb)

        let helper_addr &jit_selftest_double
        let helper_c LLVMConstInt(i64t, helper_addr as u64, 0)
        let helper_p LLVMConstIntToPtr(helper_c, ptrt)
        var abuf u8[16]
        let ap abuf as pointer[pointer[void]]
        set *ap: LLVMGetParam(fn, 0)
        let doubled LLVMBuildCall2(b, fn_ty, helper_p, ap, 1, "dbl")
        let one LLVMConstInt(i64t, 1, 0)
        let sum LLVMBuildAdd(b, doubled, one, "sum")
        LLVMBuildRet(b, sum)
        LLVMDisposeBuilder(b)

        var vmsg: pointer[char] null
        if LLVMVerifyModule(mod, LLVM_VERIFIER_RETURN_STATUS, &vmsg) <> 0
        {
            scaly_eputs "dazzle JIT selftest: module does not verify\n"
            return 4
        }
        let tsm LLVMOrcCreateNewThreadSafeModule(mod, s.tsc)
        if tsm = null
            return 5
        let add_err LLVMOrcLLJITAddLLVMIRModule(s.jit, s.jd, tsm)
        if Llvm.failed(add_err, "could not add selftest module")
            return 6
        var addr: u64 0
        let look_err LLVMOrcLLJITLookup(s.jit, &addr, "dazzle_jit_selftest")
        if Llvm.failed(look_err, "selftest symbol lookup failed")
            return 7
        if addr = 0
            return 8
        let entry_fn addr as pointer[void]
        let answer entry_fn(20 as i64)
        if answer <> 41
            return 9
        let answer2 entry_fn(0 as i64)
        if answer2 <> 1
            return 10
        ; and the layout probe, which the code generator depends on
        if Jit.check_layout(s) = false
            return 11
        0
    }
}
