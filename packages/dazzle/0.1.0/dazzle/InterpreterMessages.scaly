    ; 160
    function badAddCharProperty() returns MessageType
        MessageType(MessageFragment(160 as u32, StringC("error in character property declaration")), Severity.Error)

    ; 161
    function duplicateCharPropertyDecl() returns MessageType
        MessageType(MessageFragment(161 as u32, StringC("duplicate definition for character property %1")), Severity.Error)

    ; 162 (auxiliary fragment of duplicateCharPropertyDecl)
    function duplicateCharPropertyDecl_aux() returns MessageFragment
        MessageFragment(162 as u32, StringC("first definition was here"))

    ; 163
    function duplicateAddCharProperty() returns MessageType
        MessageType(MessageFragment(163 as u32, StringC("duplicate character property declaration %1 for character %2")), Severity.Error)

    ; 164
    function returnNotSosofo() returns MessageType
        MessageType(MessageFragment(164 as u32, StringC("value returned by procedure was not a sosofo")), Severity.Error)

    ; 165
    function varCharPropertyExprUnsupported() returns MessageType
        MessageType(MessageFragment(165 as u32, StringC("variable expressions for character property values currently not supported")), Severity.Error)

    ; --- RtfMessages (module offset 4000 in the reference) ------------------
    ; 4000
    function nestedTable() returns MessageType
        MessageType(MessageFragment(4000 as u32, StringC("nested tables are not allowed in RTF")), Severity.Error)

    ; 4001
    function systemIdNotFilename() returns MessageType
        MessageType(MessageFragment(4001 as u32, StringC("could not convert system identifier %1 to a single filename")), Severity.Error)

}
