        this.iic("justify-glyph-space-max-add", IC_LENGTH_SPEC, "justify-glyph-space-max-add", 38)
        this.iic("justify-glyph-space-max-remove", IC_LENGTH_SPEC, "justify-glyph-space-max-remove", 39)
        this.iicn("table-corner-radius", IC_LENGTH_SPEC, "table-corner-radius", 40, 3 * this.units_per_inch / 72)
        this.iicn("box-corner-radius", IC_LENGTH_SPEC, "box-corner-radius", 41, 3 * this.units_per_inch / 72)
        this.iic("marginalia-sep", IC_LENGTH_SPEC, "marginalia-sep", 42)
        this.iic("inhibit-line-breaks?", IC_BOOL, "inhibit-line-breaks?", 43)
