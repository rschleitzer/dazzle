        this.iicn("hyphenation-remain-char-count", IC_INT, "hyphenation-remain-char-count", 101, 2)
        this.iicn("hyphenation-push-char-count", IC_INT, "hyphenation-push-char-count", 102, 2)
        this.iicn("widow-count", IC_INT, "widow-count", 103, 2)
        this.iicn("orphan-count", IC_INT, "orphan-count", 104, 2)
        this.iic("background-tile", IC_PUBLIC_ID, "background-tile", 105)
        this.iic("line-breaking-method", IC_PUBLIC_ID, "line-breaking-method", 106)
        this.iic("line-composition-method", IC_PUBLIC_ID, "line-composition-method", 107)
        this.iic("implicit-bidi-method", IC_PUBLIC_ID, "implicit-bidi-method", 108)
        this.iic("glyph-subst-method", IC_PUBLIC_ID, "glyph-subst-method", 109)
        this.iic("glyph-reorder-method", IC_PUBLIC_ID, "glyph-reorder-method", 110)
        this.iic("hyphenation-method", IC_PUBLIC_ID, "hyphenation-method", 111)
        this.iic("table-auto-width-method", IC_PUBLIC_ID, "table-auto-width-method", 112)
        this.iic("font-name", IC_PUBLIC_ID, "font-name", 113)
        this.iic("page-category", IC_SYMBOL, "page-category", 114)
        this.iic("force-last-page", IC_SYMBOL, "force-last-page", 115)
        this.iic("force-first-page", IC_SYMBOL, "force-first-page", 116)
        this.iic("first-page-type", IC_SYMBOL, "first-page-type", 117)
        this.iic("justify-spread?", IC_BOOL, "jystify-spread", 118)
        this.iic("binding-edge", IC_SYMBOL, "binding-edge", 119)
        this.iic("anchor-keep-with-previous?", IC_BOOL, "anchor-keep-with-previous", 120)
        this.iic("contents-alignment", IC_SYMBOL, "contents-alignment", 121)
        this.iic("overflow-action", IC_SYMBOL, "overflow-action", 122)
        this.iic("annotation-glyph-placement", IC_SYMBOL, "annotation-glyph-placement", 123)
        this.iic("annotation-glyph-style", IC_PUBLIC_ID, "annotation-glyph-style", 124)
        this.iicn("inline-note-line-count", IC_INT, "inline-note-line-count", 125, 2)
        this.iic("inline-note-style", IC_PUBLIC_ID, "inline-note-style", 126)
        this.iic("mark-distribution", IC_SYMBOL, "mark-distribution", 127)
        this.iic("mark-style", IC_PUBLIC_ID, "mark-style", 128)
        this.iic("side-by-side-overlap-control", IC_SYMBOL, "side-by-side-overlap-control", 129)
        this.iic("side-by-side-pre-align", IC_SYMBOL, "side-by-side-pre-align", 130)
        this.iic("side-by-side-post-align", IC_SYMBOL, "side-by-side-post-align", 131)
        this.iic("language", IC_LETTER2, "language", 132)
        this.iic("country", IC_LETTER2, "country", 133)
        ; #f or strictly positive integer
        this.iicn("expand-tabs?", IC_MAYBE_INT, "expand-tabs", 134, 8)
        this.iicn("hyphenation-ladder-count", IC_MAYBE_INT, "hyphenation-ladder-count", 135, 0)
        ; ignored characteristics (IgnoredC — accepted, never rendered)
        this.iicobj("line-miter-limit", "line-miter-limit", 136, ELObj.make_integer(host, 10))
        this.iicobj("alignment-point-offset", "alignment-point-offset", 137, ELObj.make_integer(host, 50))
        this.iicobj("hyphenation-char", "hyphenation-char", 138, ELObj.make_char(host, 0x2D))
        this.iicobj("asis-truncate-char", "asis-truncate-char", 139, this.make_false())
        this.iicobj("asis-wrap-char", "asis-wrap-char", 140, this.make_false())
        this.iicobj("first-line-align", "first-line-align", 141, this.make_false())
        this.iicobj("hyphenation-exceptions", "hyphenation-exceptions", 142, ELObj.make_nil(host))
        this.iicobj("box-corner-rounded", "box-corner-rounded", 143, this.make_false())
        this.iicobj("table-corner-rounded", "table-corner-rounded", 144, this.make_false())
        this.iicobj("line-dash", "line-dash", 145, ELObj.make_pair(host, ELObj.make_length(host, 0), ELObj.make_nil(host)))
        this.iicobj("allowed-ligatures", "allowed-ligatures", 146, ELObj.make_nil(host))
        this.iicobj("line-number", "line-number", 147, this.make_false())
        this.iicobj("line-spacing-priority", "line-spacing-priority", 148, ELObj.make_integer(host, 0))
        this.iicobj("char-map", "char-map", 149, this.make_false())
        ; the border characteristics (BorderC) + the canned styles boolean
        ; border values resolve to (makeBorderStyle: one border-present? spec,
        ; the index of the entry installed above).
        set this.border_true_style_obj: this.make_border_style(true)
        set this.border_false_style_obj: this.make_border_style(false)
        this.iicborder("table-border", 150)
        this.iicborder("cell-before-row-border", 151)
        this.iicborder("cell-after-row-border", 152)
        this.iicborder("cell-before-column-border", 153)
        this.iicborder("cell-after-column-border", 154)
        ; color (ColorC, initial device-RGB black) + background-color
        ; (BackgroundColorC, initial #f).
        let color_ic this.make_proto_ic("color", IC_COLOR, "color", 155)
        set color_ic.obj: ELObj.make_color(host, 0, 0, 0)
        this.finish_ic(color_ic)
        let bg_ic this.make_proto_ic("background-color", IC_OPT_COLOR, "background-color", 156)
        this.finish_ic(bg_ic)
        ; #f or length-spec (GenericOptLengthSpecInheritedC; initial #f).
        let mpre this.make_proto_ic("min-pre-line-spacing", IC_OPT_LENGTH_SPEC, "min-pre-line-spacing", 157)
        set mpre.bval: true
        this.finish_ic(mpre)
        let mpost this.make_proto_ic("min-post-line-spacing", IC_OPT_LENGTH_SPEC, "min-post-line-spacing", 158)
        set mpost.bval: true
        this.finish_ic(mpost)
        let mlead this.make_proto_ic("min-leading", IC_OPT_LENGTH_SPEC, "min-leading", 159)
        set mlead.bval: true
        this.finish_ic(mlead)
        ; inline spaces (GenericInlineSpaceInheritedC; initial zero space).
        let esb this.make_proto_ic("escapement-space-before", IC_INLINE_SPACE, "escapement-space-before", 160)
        let esb_sp InlineSpace.make(host)
        set esb.obj: ELObj.make_inline_space(host, esb_sp as pointer[void])
        this.finish_ic(esb)
        let esa this.make_proto_ic("escapement-space-after", IC_INLINE_SPACE, "escapement-space-after", 161)
        let esa_sp InlineSpace.make(host)
        set esa.obj: ELObj.make_inline_space(host, esa_sp as pointer[void])
        this.finish_ic(esa)
        ; #f or inline-space (GenericOptInlineSpaceInheritedC; initial #f).
        let iss this.make_proto_ic("inline-space-space", IC_OPT_INLINE_SPACE, "inline-space-space", 162)
        this.finish_ic(iss)
        ; fraction-bar (RuleC; initial = the rule flow-object class binding —
        ; install_flow_objs runs first, reference order).
        let fb this.make_proto_ic("fraction-bar", IC_RULE, "fraction-bar", 163)
        let rident this.lookup(StringC("rule"))
        set fb.obj: rident.get_value_raw()
        this.finish_ic(fb)
        ; #f or glyph-subst-table (GlyphSubstTableC; initial #f = empty).
        let gst_ic this.make_proto_ic("glyph-subst-table", IC_GST, "glyph-subst-table", 164)
        set gst_ic.gst: Array[pointer[GlyphSubstTableRec]]^host()
        this.finish_ic(gst_ic)
        ; nInheritedC_ continues past the registry for declare-characteristic.
        set this.next_ic_index: 165
    }

    ; Identifier::setInheritedC(ic, part, loc) — the definition record the
    ; duplicate gates of declare-characteristic / declare-flow-object-class /
    ; declare-flow-object-macro consult. Only a declare-characteristic writes
    ; it; a BUILT-IN characteristic keeps the -1 part its prototype was made
    ; with, which is what keeps `(declare-flow-object-macro font-size …)`
    ; legal.
    function stamp_inherited_c_def(this: pointer[Interpreter], ident: pointer[Identifier], part: u32, loc: Location)
    {
        let ic ident.get_inherited_c() as pointer[InheritedC]
        if ic = null
            return
        set ic.def_part: part
        set ic.def_loc: loc
    }

    ; inheritedCDefined(part, loc) — true when the name carries a
    ; characteristic prototype; the part/loc come back through the pointers.
    function inherited_c_defined(this: pointer[Interpreter], ident: pointer[Identifier], part: pointer[u32], loc: pointer[Location]) returns bool
    {
        let ic ident.get_inherited_c() as pointer[InheritedC]
        if ic = null
            return false
        set *part: ic.def_part
        set *loc: ic.def_loc
        true
    }

    ; Interpreter::installExtensionCharNIC (Interpreter.cxx:2381) — the whole
    ; body is `ident->setCharNIC(currentPartIndex(), loc)`. ★The public
    ; identifier is PARSED and then DROPPED: unlike declare-characteristic
    ; (which resolves the pubid against the backend's extension table) a char
    ; NIC is never handed to a backend — the `character` flow object reads it
    ; off the Identifier by name. The parameter stays for the reference's
    ; shape.
    procedure install_extension_char_nic(this: pointer[Interpreter], ident: pointer[Identifier], pubid: StringC, loc: Location)
    {
        ident.set_char_nic(this.current_part_index(), loc)
    }

    ; Interpreter::installExtensionInheritedC — resolve the public id against
    ; the backend's extension table. Under -t rtf the 12-entry RtfFOTBuilder
    ; table applies (typed ICs carrying an ext-setter id, dispatched in
    ; RtfFOTBuilder.set_extension_ic); fot/transform have no table, so every
    ; declared characteristic takes the reference's fallback: an IgnoredC —
    ; accepted anywhere, renders nothing, value slot #f.
    function install_extension_inherited_c(this: pointer[Interpreter], ident: pointer[Identifier], pubid: StringC, loc: Location)
    {
        let host this.host
        let nm ident.get_name()
        let pn StringC^host(nm.data_ptr(), nm.get_size())
        if this.rtf_extensions
        {
            var kind IC_IGNORED
            var ext 0
            this.match_rtf_extension(pubid, &kind, &ext)
            if ext <> 0
            {
                let eic InheritedC.make(host, kind, ident, this.next_ic_index, pn)
                set this.next_ic_index: this.next_ic_index + 1
                set eic.ext_setter: ext
                this.finish_ic(eic)
                return
            }
        }
        if this.html_extensions
        {
            ; the jade.cxx HtmlFOTBuilder extension table: one entry.
            if pubid.equals(StringC("UNREGISTERED::James Clark//Characteristic::scroll-title"))
            {
                let hic InheritedC.make(host, IC_STRING, ident, this.next_ic_index, pn)
                set this.next_ic_index: this.next_ic_index + 1
                set hic.ext_setter: 1
                this.finish_ic(hic)
                return
            }
        }
        if this.mif_extensions
        {
            ; the jade.cxx makeMifFOTBuilder extension table: three
            ; characteristics (the index-entry flow object class is bound in
            ; install_extension_flow_object_class).
            var mkind IC_IGNORED
            var mext 0
            let mprefix StringC("UNREGISTERED::James Clark//Characteristic::")
            let mplen mprefix.get_size()
            if pubid.get_size() > mplen
            {
                let mhead pubid.substr(0, mplen)
                if mhead.equals(mprefix)
                {
                    let mtail pubid.substr(mplen, pubid.get_size() - mplen)
                    if mtail.equals(StringC("page-n-columns"))
                    {
                        set mkind: IC_INT
                        set mext: 1
                    }
                    else if mtail.equals(StringC("page-column-sep"))
                    {
                        set mkind: IC_LENGTH
                        set mext: 2
                    }
                    else if mtail.equals(StringC("page-balance-columns?"))
                    {
                        set mkind: IC_BOOL
                        set mext: 3
                    }
                }
            }
            if mext <> 0
            {
                let mic InheritedC.make(host, mkind, ident, this.next_ic_index, pn)
                set this.next_ic_index: this.next_ic_index + 1
                set mic.ext_setter: mext
                this.finish_ic(mic)
                return
            }
        }
        if this.tex_extensions
        {
            var kind IC_IGNORED
            var ext 0
            this.match_tex_extension(pubid, &kind, &ext)
            if ext <> 0
            {
                let eic InheritedC.make(host, kind, ident, this.next_ic_index, pn)
                set this.next_ic_index: this.next_ic_index + 1
                set eic.ext_setter: ext
                this.finish_ic(eic)
                return
            }
        }
        let ic InheritedC.make(host, IC_IGNORED, ident, this.next_ic_index, pn)
        set this.next_ic_index: this.next_ic_index + 1
        set ic.obj: this.make_false()
        this.finish_ic(ic)
    }

    ; the jade.cxx RtfFOTBuilder extension table: pubid suffix after
    ; "UNREGISTERED::James Clark//Characteristic::" -> (value kind, setter id)
    function match_rtf_extension(this: pointer[Interpreter], pubid: StringC, kind: pointer[int], ext: pointer[int])
    {
        let prefix StringC("UNREGISTERED::James Clark//Characteristic::")
        let plen prefix.get_size()
        if pubid.get_size() <= plen
            return
        let head pubid.substr(0, plen)
        if head.equals(prefix) = false
            return
        let tail pubid.substr(plen, pubid.get_size() - plen)
        if tail.equals(StringC("page-number-format"))
        {
            set *kind: IC_STRING
            set *ext: 1
        }
        else if tail.equals(StringC("page-number-restart?"))
        {
            set *kind: IC_BOOL
            set *ext: 2
        }
        else if tail.equals(StringC("page-n-columns"))
        {
            set *kind: IC_INT
            set *ext: 3
        }
        else if tail.equals(StringC("page-column-sep"))
        {
            set *kind: IC_LENGTH
            set *ext: 4
        }
        else if tail.equals(StringC("page-balance-columns?"))
        {
            set *kind: IC_BOOL
            set *ext: 5
        }
        else if tail.equals(StringC("subscript-depth"))
        {
            set *kind: IC_LENGTH
            set *ext: 6
        }
        else if tail.equals(StringC("over-mark-height"))
        {
            set *kind: IC_LENGTH
            set *ext: 7
        }
        else if tail.equals(StringC("under-mark-depth"))
        {
            set *kind: IC_LENGTH
            set *ext: 8
        }
        else if tail.equals(StringC("superscript-height"))
        {
            set *kind: IC_LENGTH
            set *ext: 9
        }
        else if tail.equals(StringC("grid-row-sep"))
        {
            set *kind: IC_LENGTH
            set *ext: 10
        }
        else if tail.equals(StringC("grid-column-sep"))
        {
            set *kind: IC_LENGTH
            set *ext: 11
        }
        else if tail.equals(StringC("heading-level"))
        {
            set *kind: IC_INT
            set *ext: 12
        }
    }

    ; the jade.cxx TeXFOTBuilder extension table (makeTeXFOTBuilder): the 15
    ; characteristics it registers. Ids 1-12 share the RTF numbering where the
    ; characteristics coincide; 13-15 are TeX-only (page-two-side?,
    ; two-side-start-on-right?, preserve-sdata?) — note the OpenJade-prefixed
    ; public ids for the two-side pair.
    function match_tex_extension(this: pointer[Interpreter], pubid: StringC, kind: pointer[int], ext: pointer[int])
    {
        let jc StringC("UNREGISTERED::James Clark//Characteristic::")
        let oj StringC("UNREGISTERED::OpenJade//Characteristic::")
        let jn jc.get_size()
        let on oj.get_size()
        if pubid.get_size() > on
        {
            let head2 pubid.substr(0, on)
            if head2.equals(oj)
            {
                let tail2 pubid.substr(on, pubid.get_size() - on)
                if tail2.equals(StringC("page-two-side?"))
                {
                    set *kind: IC_BOOL
                    set *ext: 13
                    return
                }
                if tail2.equals(StringC("two-side-start-on-right?"))
                {
                    set *kind: IC_BOOL
                    set *ext: 14
                    return
                }
            }
        }
        if pubid.get_size() <= jn
            return
        let head pubid.substr(0, jn)
        if head.equals(jc) = false
            return
        let tail pubid.substr(jn, pubid.get_size() - jn)
        if tail.equals(StringC("page-number-format"))
        {
            set *kind: IC_STRING
            set *ext: 1
        }
        else if tail.equals(StringC("page-number-restart?"))
        {
            set *kind: IC_BOOL
            set *ext: 2
        }
        else if tail.equals(StringC("page-n-columns"))
        {
            set *kind: IC_INT
            set *ext: 3
        }
        else if tail.equals(StringC("page-column-sep"))
        {
            set *kind: IC_LENGTH
            set *ext: 4
        }
        else if tail.equals(StringC("page-balance-columns?"))
        {
            set *kind: IC_BOOL
            set *ext: 5
        }
        else if tail.equals(StringC("subscript-depth"))
        {
            set *kind: IC_LENGTH
            set *ext: 6
        }
        else if tail.equals(StringC("over-mark-height"))
        {
            set *kind: IC_LENGTH
            set *ext: 7
        }
        else if tail.equals(StringC("under-mark-depth"))
        {
            set *kind: IC_LENGTH
            set *ext: 8
        }
        else if tail.equals(StringC("superscript-height"))
        {
            set *kind: IC_LENGTH
            set *ext: 9
        }
        else if tail.equals(StringC("grid-row-sep"))
        {
            set *kind: IC_LENGTH
            set *ext: 10
        }
        else if tail.equals(StringC("grid-column-sep"))
        {
            set *kind: IC_LENGTH
            set *ext: 11
        }
        else if tail.equals(StringC("heading-level"))
        {
            set *kind: IC_INT
            set *ext: 12
        }
        else if tail.equals(StringC("preserve-sdata?"))
        {
            set *kind: IC_BOOL
            set *ext: 15
        }
    }

    procedure set_rtf_extensions(this: pointer[Interpreter], b: bool)
        set this.rtf_extensions: b

    procedure set_tex_extensions(this: pointer[Interpreter], b: bool)
        set this.tex_extensions: b

    procedure set_html_extensions(this: pointer[Interpreter], b: bool)
        set this.html_extensions: b

    procedure set_mif_extensions(this: pointer[Interpreter], b: bool)
        set this.mif_extensions: b

    ; Interpreter::installInitialValue — collect (ident, expr); a same-part
    ; re-declaration is duplicateInitialValue with the first one as aux line.
    function install_initial_value(this: pointer[Interpreter], ident: pointer[Identifier], expr: pointer[Expression])
    {
        let names this.initial_value_names
        let n names.get_length()
        var i: size_t 0
        while i < n
        {
            if *(names.get_buffer() + i) = ident
            {
                if (i as int) >= this.current_part_first_initial_value
                {
                    let prev *(this.initial_value_exprs.get_buffer() + i)
                    this.set_next_location(expr.location())
                    this.message1(InterpreterMessages.duplicateInitialValue(), ident.get_name())
                    this.emit_aux(InterpreterMessages.duplicateInitialValue_aux(), prev.location())
                }
                return
            }
            set i: i + 1
        }
        names.add(ident)
        this.initial_value_exprs.add(expr)
    }

    ; Interpreter::compileInitialValues — each declared value becomes a
    ; constant IC (via the per-kind conversion) or a VarInheritedC; together
    ; they form the initial style ProcessContext::process pushes around the
    ; whole run.
    function compile_initial_values(this: pointer[Interpreter])
    {
        let names this.initial_value_names
        let n names.get_length()
        if n = 0
            return
        let host this.host
        let ics Array[pointer[InheritedC]]^host()
        var i: size_t 0
        while i < n
        {
            let ident *(names.get_buffer() + i)
            let expr *(this.initial_value_exprs.get_buffer() + i)
            let proto ident.get_inherited_c() as pointer[InheritedC]
            if proto <> null
            {
                let env Environment.make(host)
                let oexpr expr.optimize(this, env)
                let val oexpr.constant_value()
                if val <> null
                {
                    let cic Convert.ic_from_value(host, proto, val, oexpr.location(), this)
                    if cic <> null
                        ics.add(cic)
                }
                else
                {
                    let code oexpr.compile(this, env, 0, null)
                    ics.add(InheritedC.make_var(host, proto, code as pointer[void], oexpr.location()))
                }
            }
            set i: i + 1
        }
        if ics.get_length() > 0
        {
            let rec VarStyleRec.make(host, null, ics, null, null)
            set this.initial_style_obj: ELObj.make_style(host, rec as pointer[void], null)
        }
    }

    function initial_style(this: Interpreter) returns pointer[ELObj]
        initial_style_obj

    function make_border_style(this: pointer[Interpreter], b: bool) returns pointer[ELObj]
    {
        let host this.host
        let bp this.lookup(StringC("border-present?"))
        let proto bp.get_inherited_c() as pointer[InheritedC]
        let ic InheritedC.make(host, IC_BOOL, bp, proto.get_index(), proto.print_name)
        set ic.bval: b
        let specs Array[pointer[InheritedC]]^host()
        specs.add(ic)
        let rec VarStyleRec.make(host, null, specs, null, null)
        ELObj.make_style(host, rec as pointer[void], null)
    }

    function border_true_style(this: pointer[Interpreter]) returns pointer[ELObj]
        border_true_style_obj

    function border_false_style(this: pointer[Interpreter]) returns pointer[ELObj]
        border_false_style_obj

    ; a BorderC registry entry (initial value #f; print name unused — set()
    ; renders nothing).
    function iicborder(this: pointer[Interpreter], name: pointer[const_char], index: int)
    {
        let ic this.make_proto_ic(name, IC_BORDER, name, index)
        set ic.obj: this.make_false()
        this.finish_ic(ic)
    }

    function set_extensions_on(on: bool)
        set xt_extensions_on: on

    ; installFlowObjs — the standard flow-object classes of this slice
    ; (reference installs all ~45 unconditionally; the rest land with their
    ; SgmlFOTBuilder methods).
    function install_flow_objs(this: pointer[Interpreter])
    {
        this.bind_flow_object_class(this.lookup(StringC("paragraph")), FOC_PARAGRAPH)
        this.bind_flow_object_class(this.lookup(StringC("paragraph-break")), FOC_PARAGRAPH_BREAK)
        this.bind_flow_object_class(this.lookup(StringC("display-group")), FOC_DISPLAY_GROUP)
        this.bind_flow_object_class(this.lookup(StringC("line-field")), FOC_LINE_FIELD)
        this.bind_flow_object_class(this.lookup(StringC("simple-page-sequence")), FOC_SIMPLE_PAGE_SEQUENCE)
        this.bind_flow_object_class(this.lookup(StringC("table")), FOC_TABLE)
        this.bind_flow_object_class(this.lookup(StringC("table-part")), FOC_TABLE_PART)
        this.bind_flow_object_class(this.lookup(StringC("table-column")), FOC_TABLE_COLUMN)
        this.bind_flow_object_class(this.lookup(StringC("table-row")), FOC_TABLE_ROW)
        this.bind_flow_object_class(this.lookup(StringC("table-cell")), FOC_TABLE_CELL)
        this.bind_flow_object_class(this.lookup(StringC("table-border")), FOC_TABLE_BORDER)
        this.bind_flow_object_class(this.lookup(StringC("rule")), FOC_RULE)
        this.bind_flow_object_class(this.lookup(StringC("link")), FOC_LINK)
        this.bind_flow_object_class(this.lookup(StringC("external-graphic")), FOC_EXTERNAL_GRAPHIC)
        this.bind_flow_object_class(this.lookup(StringC("leader")), FOC_LEADER)
        this.bind_flow_object_class(this.lookup(StringC("box")), FOC_BOX)
        this.bind_flow_object_class(this.lookup(StringC("score")), FOC_SCORE)
        this.bind_flow_object_class(this.lookup(StringC("scroll")), FOC_SCROLL)
        ; the INLINE/MARK family (reference order: character and the two
        ; inline marks sit with the print classes, the three Universitat-
        ; Politecnica additions after the page/column model).
        this.bind_flow_object_class(this.lookup(StringC("character")), FOC_CHARACTER)
        this.bind_flow_object_class(this.lookup(StringC("alignment-point")), FOC_ALIGNMENT_POINT)
        this.bind_flow_object_class(this.lookup(StringC("sideline")), FOC_SIDELINE)
        this.bind_flow_object_class(this.lookup(StringC("anchor")), FOC_ANCHOR)
        this.bind_flow_object_class(this.lookup(StringC("glyph-annotation")), FOC_GLYPH_ANNOTATION)
        this.bind_flow_object_class(this.lookup(StringC("emphasizing-mark")), FOC_EMPHASIZING_MARK)
        ; the MATH family (installFlowObjs' `// math` block, in its order).
        this.bind_flow_object_class(this.lookup(StringC("math-sequence")), FOC_MATH_SEQUENCE)
        this.bind_flow_object_class(this.lookup(StringC("fraction")), FOC_FRACTION)
        this.bind_flow_object_class(this.lookup(StringC("unmath")), FOC_UNMATH)
        this.bind_flow_object_class(this.lookup(StringC("superscript")), FOC_SUPERSCRIPT)
        this.bind_flow_object_class(this.lookup(StringC("subscript")), FOC_SUBSCRIPT)
        this.bind_flow_object_class(this.lookup(StringC("script")), FOC_SCRIPT)
        this.bind_flow_object_class(this.lookup(StringC("mark")), FOC_MARK)
        this.bind_flow_object_class(this.lookup(StringC("fence")), FOC_FENCE)
        this.bind_flow_object_class(this.lookup(StringC("radical")), FOC_RADICAL)
        this.bind_flow_object_class(this.lookup(StringC("math-operator")), FOC_MATH_OPERATOR)
        this.bind_flow_object_class(this.lookup(StringC("grid")), FOC_GRID)
        this.bind_flow_object_class(this.lookup(StringC("grid-cell")), FOC_GRID_CELL)
        ; the LAYOUT-COMPOSITE family (installFlowObjs binds them between the
        ; page/column model and the tables, in this order).
        this.bind_flow_object_class(this.lookup(StringC("embedded-text")), FOC_EMBEDDED_TEXT)
        this.bind_flow_object_class(this.lookup(StringC("included-container-area")), FOC_INCLUDED_CONTAINER_AREA)
        this.bind_flow_object_class(this.lookup(StringC("side-by-side")), FOC_SIDE_BY_SIDE)
        this.bind_flow_object_class(this.lookup(StringC("side-by-side-item")), FOC_SIDE_BY_SIDE_ITEM)
        this.bind_flow_object_class(this.lookup(StringC("aligned-column")), FOC_ALIGNED_COLUMN)
        ; the ONLINE family (installFlowObjs binds them right after `scroll`).
        this.bind_flow_object_class(this.lookup(StringC("marginalia")), FOC_MARGINALIA)
        this.bind_flow_object_class(this.lookup(StringC("multi-mode")), FOC_MULTI_MODE)
        ; the PAGE/COLUMN MODEL — the reference binds these two immediately
        ; after `simple-page-sequence` (FlowObj.cxx:2996-2998), the last two
        ; entries of the registry that were still missing here.
        this.bind_flow_object_class(this.lookup(StringC("page-sequence")), FOC_PAGE_SEQUENCE)
        this.bind_flow_object_class(this.lookup(StringC("column-set-sequence")), FOC_COLUMN_SET_SEQUENCE)
    }

    ; allocGlyphSubstTableUniqueId — the fot dump's gst<n> id counter.
    function alloc_gst_unique_id(this: pointer[Interpreter]) returns int
    {
        let n this.next_gst_unique_id
        set this.next_gst_unique_id: n + 1
        n
    }

    ; bind an identifier's VALUE to a FlowObjBox carrying `foc` (the DSSSL flow-
    ; object-class binding; NOT a new Identifier field — see ELObj FOC note).
    function bind_flow_object_class(this: pointer[Interpreter], ident: pointer[Identifier], foc: int)
    {
        let fo FlowObj.make(this.host, foc)
        let box ELObj.make_flowobj_box(this.host, fo)
        ident.set_definition(0xFFFFFFFF, Location(), box)
    }

    ; declare-flow-object-macro's binding: a FlowObjBox carrying the macro
    ; seed (FOC_MACRO + the shared definition + one empty characteristic slot
    ; per declared name). Every `make` of the name copies that seed.
    function bind_flow_object_macro(this: pointer[Interpreter], ident: pointer[Identifier], def: pointer[MacroDef])
    {
        let fo FlowObj.make_macro(this.host, def)
        let box ELObj.make_flowobj_box(this.host, fo)
        ident.set_definition(0xFFFFFFFF, Location(), box)
    }

    ; installExtensionFlowObjectClass — bind an identifier to a transform flow
    ; object class keyed on its public id (the jade/dazzle-net extension table).
    ; The active backend decides whether the extension table is present
    ; (jade.cxx: only the transform backends pass extensions): with extensions
    ; off (-t fot), every id except the always-available formatting-instruction
    ; binds the reference's UnknownFlowObj (key-swallowing, content-
    ; transparent). An unrecognised id under the transform backends keeps the
    ; historical FOC_SEQUENCE fallback (corpus-validated).
    function install_extension_flow_object_class(this: pointer[Interpreter], ident: pointer[Identifier], public_id: StringC)
    {
        if xt_extensions_on = false
        {
            var xfoc FOC_UNKNOWN
            if public_id.equals(StringC("UNREGISTERED::James Clark//Flow Object Class::formatting-instruction"))
                set xfoc: FOC_FORMATTING_INSTRUCTION
            ; the TeX backend's own two extension classes (jade.cxx passes
            ; them in the makeTeXFOTBuilder extension table).
            if this.tex_extensions
            {
                if public_id.equals(StringC("UNREGISTERED::Sebastian Rahtz//Flow Object Class::page-float"))
                    set xfoc: FOC_PAGE_FLOAT
                if public_id.equals(StringC("UNREGISTERED::Sebastian Rahtz//Flow Object Class::page-footnote"))
                    set xfoc: FOC_PAGE_FOOTNOTE
            }
            ; the MIF backend's own extension class (jade.cxx passes it in the
            ; makeMifFOTBuilder extension table).
            if this.mif_extensions
            {
                if public_id.equals(StringC("UNREGISTERED::ISOGEN//Flow Object Class::index-entry"))
                    set xfoc: FOC_INDEX_ENTRY
            }
            this.bind_flow_object_class(ident, xfoc)
            return
        }
        var foc FOC_SEQUENCE
        if public_id.equals(StringC("UNREGISTERED::James Clark//Flow Object Class::element"))
            set foc: FOC_ELEMENT
        else if public_id.equals(StringC("UNREGISTERED::James Clark//Flow Object Class::empty-element"))
            set foc: FOC_EMPTY_ELEMENT
        else if public_id.equals(StringC("UNREGISTERED::James Clark//Flow Object Class::entity"))
            set foc: FOC_ENTITY
        else if public_id.equals(StringC("UNREGISTERED::James Clark//Flow Object Class::entity-ref"))
            set foc: FOC_ENTITY_REF
        else if public_id.equals(StringC("UNREGISTERED::James Clark//Flow Object Class::processing-instruction"))
            set foc: FOC_PROCESSING_INSTRUCTION
        else if public_id.equals(StringC("UNREGISTERED::James Clark//Flow Object Class::document-type"))
            set foc: FOC_DOCUMENT_TYPE
        else if public_id.equals(StringC("UNREGISTERED::James Clark//Flow Object Class::formatting-instruction"))
            set foc: FOC_FORMATTING_INSTRUCTION
        else if public_id.equals(StringC("UNREGISTERED::Dazzle//Flow Object Class::directory"))
            set foc: FOC_DIRECTORY
        this.bind_flow_object_class(ident, foc)
    }

    ; --- primitives --------------------------------------------------------
    function install_primitive(this: pointer[Interpreter], name: pointer[const_char], prim_id: int, sig: Signature)
    {
        let ident this.lookup(StringC(name))
        let prim ELObj.make_primitive(this.host, sig, prim_id)
        prim.primitive_set_ident(ident)
        ident.set_definition(0xFFFFFFFF, Location(), prim)
        ; every standard primitive is reachable via external-procedure under
        ; its ISO public id (reference installPrimitive).
        this.register_external_proc("ISO/IEC 10179:1996//Procedure::", name, prim)
    }

    ; The PRIMITIVE2 macro (primitive.cxx:5333): `if (dsssl2())
    ; installPrimitive(...)`. Without the `-2` flag these eleven names are
    ; UNDEFINED VARIABLES in the reference, not procedures — measured against
    ; the reference binary, which reports `reference to undefined variable
    ; "vector?"` and friends. This port used to install them unconditionally.
    function install_primitive2(this: pointer[Interpreter], name: pointer[const_char], prim_id: int, sig: Signature)
    {
        if this.dsssl2
            this.install_primitive(name, prim_id, sig)
    }

    ; installXPrimitive — an extension primitive: NOT bound to its identifier
    ; (only external-procedure reaches it), registered under prefix+name.
    function install_x_primitive(this: pointer[Interpreter], prefix: pointer[const_char], name: pointer[const_char], prim_id: int, sig: Signature)
    {
        let ident this.lookup(StringC(name))
        let prim ELObj.make_primitive(this.host, sig, prim_id)
        prim.primitive_set_ident(ident)
        this.register_external_proc(prefix, name, prim)
    }

    function register_external_proc(this: pointer[Interpreter], prefix: pointer[const_char], name: pointer[const_char], value: pointer[ELObj])
    {
        let host this.host
        let buf Array[u32]^host()
        var i: size_t 0
        while true
        {
            let b *((prefix as pointer[u8]) + i)
            if b = 0
                break
            buf.add(b as u32)
            set i: i + 1
        }
        set i: 0
        while true
        {
            let b *((name as pointer[u8]) + i)
            if b = 0
                break
            buf.add(b as u32)
            set i: i + 1
        }
        let pubid StringC^host(buf.get_buffer(), buf.get_length())
        this.external_proc_table.add(ExternalProc.make(host, pubid, value))
    }

    ; lookupExternalProc — external-procedure's table probe; null = unknown.
    function lookup_external_proc(this: pointer[Interpreter], pubid: StringC) returns pointer[ELObj]
    {
        let n this.external_proc_table.get_length()
        var i: size_t 0
        while i < n
        {
            let ep this.external_proc_table.get(i)
            if ep <> null
            {
                let e *ep
                if e.pubid.equals(pubid)
                    return e.value
            }
            set i: i + 1
        }
        null
    }

    ; installPrimitives (Interpreter.cs). Inc-3 starter batch: the pure-ELObj
    ; primitives. String/char/vector and grove/sosofo/style primitives join
    ; with their machinery.
    function install_primitives(this: pointer[Interpreter])
    {
        this.install_primitive("cons", PRIM_CONS, Signature(2, 0, false))
        this.install_primitive("list", PRIM_LIST, Signature(0, 0, true))
        this.install_primitive("car", PRIM_CAR, Signature(1, 0, false))
        this.install_primitive("cdr", PRIM_CDR, Signature(1, 0, false))
        this.install_primitive("null?", PRIM_IS_NULL, Signature(1, 0, false))
        this.install_primitive("pair?", PRIM_IS_PAIR, Signature(1, 0, false))
        this.install_primitive("list?", PRIM_IS_LIST, Signature(1, 0, false))
        this.install_primitive("length", PRIM_LENGTH, Signature(1, 0, false))
        this.install_primitive("append", PRIM_APPEND, Signature(0, 0, true))
        this.install_primitive("reverse", PRIM_REVERSE, Signature(1, 0, false))
        this.install_primitive("list-ref", PRIM_LIST_REF, Signature(2, 0, false))
        this.install_primitive2("memv", PRIM_MEMV, Signature(2, 0, false))
        this.install_primitive("member", PRIM_MEMBER, Signature(2, 0, false))
        this.install_primitive("equal?", PRIM_IS_EQUAL, Signature(2, 0, false))
        this.install_primitive2("eqv?", PRIM_IS_EQV, Signature(2, 0, false))
        this.install_primitive("not", PRIM_NOT, Signature(1, 0, false))
        this.install_primitive("+", PRIM_PLUS, Signature(0, 0, true))
        this.install_primitive("-", PRIM_MINUS, Signature(1, 0, true))
        this.install_primitive("*", PRIM_TIMES, Signature(0, 0, true))
        this.install_primitive("/", PRIM_DIVIDE, Signature(1, 0, true))
        this.install_primitive("=", PRIM_NUM_EQ, Signature(0, 0, true))
        this.install_primitive("<", PRIM_LESS, Signature(0, 0, true))
        this.install_primitive(">", PRIM_GREATER, Signature(0, 0, true))
        this.install_primitive("<=", PRIM_LESS_EQ, Signature(0, 0, true))
        this.install_primitive(">=", PRIM_GREATER_EQ, Signature(0, 0, true))
        this.install_primitive("zero?", PRIM_IS_ZERO, Signature(1, 0, false))
        this.install_primitive("positive?", PRIM_IS_POSITIVE, Signature(1, 0, false))
        this.install_primitive("negative?", PRIM_IS_NEGATIVE, Signature(1, 0, false))
        this.install_primitive("odd?", PRIM_IS_ODD, Signature(1, 0, false))
        this.install_primitive("even?", PRIM_IS_EVEN, Signature(1, 0, false))
        this.install_primitive("abs", PRIM_ABS, Signature(1, 0, false))
        this.install_primitive("modulo", PRIM_MODULO, Signature(2, 0, false))
        this.install_primitive("round", PRIM_ROUND, Signature(1, 0, false))
        this.install_primitive("remainder", PRIM_REMAINDER, Signature(2, 0, false))
        this.install_primitive("quotient", PRIM_QUOTIENT, Signature(2, 0, false))
        this.install_primitive("number?", PRIM_IS_NUMBER, Signature(1, 0, false))
        this.install_primitive("integer?", PRIM_IS_INTEGER, Signature(1, 0, false))
        this.install_primitive("real?", PRIM_IS_REAL, Signature(1, 0, false))
        this.install_primitive("string?", PRIM_IS_STRING, Signature(1, 0, false))
        this.install_primitive("symbol?", PRIM_IS_SYMBOL, Signature(1, 0, false))
        this.install_primitive("char?", PRIM_IS_CHAR, Signature(1, 0, false))
        this.install_primitive("boolean?", PRIM_IS_BOOLEAN, Signature(1, 0, false))
        this.install_primitive("procedure?", PRIM_IS_PROCEDURE, Signature(1, 0, false))
        this.install_primitive2("vector?", PRIM_IS_VECTOR, Signature(1, 0, false))
        this.install_primitive("keyword?", PRIM_IS_KEYWORD, Signature(1, 0, false))
        ; --- string / char / symbol / keyword / vector --------------------
        this.install_primitive("symbol->string", PRIM_SYMBOL_TO_STRING, Signature(1, 0, false))
        this.install_primitive("string->symbol", PRIM_STRING_TO_SYMBOL, Signature(1, 0, false))
        this.install_primitive("keyword->string", PRIM_KEYWORD_TO_STRING, Signature(1, 0, false))
        this.install_primitive("string->keyword", PRIM_STRING_TO_KEYWORD, Signature(1, 0, false))
        this.install_primitive("string-append", PRIM_STRING_APPEND, Signature(0, 0, true))
        this.install_primitive("string-length", PRIM_STRING_LENGTH, Signature(1, 0, false))
        this.install_primitive("string-ref", PRIM_STRING_REF, Signature(2, 0, false))
        this.install_primitive("substring", PRIM_SUBSTRING, Signature(3, 0, false))
        this.install_primitive("string", PRIM_STRING, Signature(0, 0, true))
        this.install_primitive("string=?", PRIM_STRING_EQUAL, Signature(2, 0, false))
        this.install_primitive("string<?", PRIM_STRING_LESS, Signature(2, 0, false))
        this.install_primitive("string<=?", PRIM_STRING_LESS_EQ, Signature(2, 0, false))
        this.install_primitive("string->list", PRIM_STRING_TO_LIST, Signature(1, 0, false))
        this.install_primitive("list->string", PRIM_LIST_TO_STRING, Signature(1, 0, false))
        this.install_primitive("string->number", PRIM_STRING_TO_NUMBER, Signature(1, 1, false))
        this.install_primitive("number->string", PRIM_NUMBER_TO_STRING, Signature(1, 1, false))
        this.install_primitive("char<?", PRIM_CHAR_LESS, Signature(2, 0, false))
        this.install_primitive("char<=?", PRIM_CHAR_LESS_EQ, Signature(2, 0, false))
        this.install_primitive("char=?", PRIM_CHAR_EQUAL, Signature(2, 0, false))
        this.install_primitive("char-upcase", PRIM_CHAR_UPCASE, Signature(1, 0, false))
        this.install_primitive("char-downcase", PRIM_CHAR_DOWNCASE, Signature(1, 0, false))
        ; the vector family is PRIMITIVE2 throughout (primitive.h:180-187)
        this.install_primitive2("make-vector", PRIM_MAKE_VECTOR, Signature(1, 1, false))
        this.install_primitive2("vector", PRIM_VECTOR, Signature(0, 0, true))
