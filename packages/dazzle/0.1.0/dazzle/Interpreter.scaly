        this.install_primitive("language?", PRIM_IS_LANGUAGE, Signature(1, 0, false))
        this.install_primitive("current-language", PRIM_CURRENT_LANGUAGE, Signature(0, 0, false))
        this.install_primitive("with-language", PRIM_WITH_LANGUAGE, Signature(2, 0, false))
        this.install_primitive("string-equiv?", PRIM_STRING_EQUIV, Signature(3, 0, false))
        this.install_x_primitive("UNREGISTERED::OpenJade//Procedure::", "language", PRIM_LANGUAGE, Signature(2, 0, false))
        ; character properties
        this.install_primitive("char-property", PRIM_CHAR_PROPERTY, Signature(2, 1, false))
        this.install_primitive("char-script-case", PRIM_CHAR_SCRIPT_CASE, Signature(1, 0, true))
        ; the time family (primitive.h:58-59, 216-219) — `time->string` is the
        ; only one with an optional argument, and the four comparisons take
        ; exactly two.
        this.install_primitive("time", PRIM_TIME, Signature(0, 0, false))
        this.install_primitive("time->string", PRIM_TIME_TO_STRING, Signature(1, 1, false))
        this.install_primitive("time<?", PRIM_TIME_LESS, Signature(2, 0, false))
        this.install_primitive("time>?", PRIM_TIME_GREATER, Signature(2, 0, false))
        this.install_primitive("time<=?", PRIM_TIME_LESS_EQ, Signature(2, 0, false))
        this.install_primitive("time>=?", PRIM_TIME_GREATER_EQ, Signature(2, 0, false))
        ; apply and call/cc are FunctionObj subclasses (custom call/tailCall),
        ; not PrimitiveObj — install the dedicated arms. `apply` is
        ; unconditional; call/cc and the string->quantity alias are the tail
        ; of installPrimitives, both gated on dsssl2().
        this.install_apply()
        if this.dsssl2
        {
            this.install_call_cc()
            ; `string->quantity` IS `string->number`: the reference copies the
            ; identifier's computed value rather than installing a primitive.
            let src this.lookup(StringC("string->number"))
            let dst this.lookup(StringC("string->quantity"))
            let v src.compute_value(false, this)
            dst.set_definition(0xFFFFFFFF, Location(), v)
        }
    }

    ; ApplyPrimitiveObj / CallWithCurrentContinuationPrimitiveObj — bound as
    ; the ApplyFn / CallCCFn ELObj arms whose call() reshuffles / captures.
    function install_apply(this: pointer[Interpreter])
    {
        let ident this.lookup(StringC("apply"))
        let fn ELObj.make_apply_fn(this.host)
        ident.set_definition(0xFFFFFFFF, Location(), fn)
    }

    ; ★Only the long name: the reference installs no `call/cc` abbreviation
    ; (this port used to bind one), and this whole procedure is dsssl2-only.
    function install_call_cc(this: pointer[Interpreter])
    {
        let fn ELObj.make_callcc_fn(this.host)
        let id1 this.lookup(StringC("call-with-current-continuation"))
        id1.set_definition(0xFFFFFFFF, Location(), fn)
    }

    ; --- named characters --------------------------------------------------
    function lookup_char_entry(t: pointer[Array[pointer[CharPart]]], name: StringC) returns pointer[CharPart]
    {
        let n t.get_length()
        let buf t.get_buffer()
        var i: size_t 0
        while i < n
        {
            let p *(buf + i)
            if p.name.equals(name)
                return p
            set i: i + 1
        }
        null
    }

    function insert_char_entry(this: pointer[Interpreter], t: pointer[Array[pointer[CharPart]]], name: StringC, c: u32, def_part: u32)
    {
        let existing Interpreter.lookup_char_entry(t, name)
        if existing <> null
        {
            set existing.c: c
            set existing.def_part: def_part
            return
        }
        let host this.host
        let e host.allocate(sizeof CharPart, alignof CharPart) as pointer[CharPart]
        set e.name: StringC^host(name.data_ptr(), name.get_size())
        set e.c: c
        set e.def_part: def_part
        t.add(e)
    }

    ; the generated CharNames/Sdata tables install through these (defPart -1)
    function def_char(this: pointer[Interpreter], name: pointer[const_char], c: u32)
        this.insert_char_entry(this.named_char_table, StringC(name), c, 0xFFFFFFFF)

    function def_sdata_char(this: pointer[Interpreter], name: pointer[const_char], c: u32)
        this.insert_char_entry(this.sdata_entity_name_table, StringC(name), c, 0xFFFFFFFF)

    ; bool convertCharName(const StringC &str, Char &c)
    function convert_char_name(this: Interpreter, str: StringC, c: pointer[u32]) returns bool
    {
        let cp Interpreter.lookup_char_entry(named_char_table, str)
        if cp <> null
        {
            set *c: cp.c
            return true
        }
        Interpreter.convert_unicode_char_name(str, c)
    }

    ; Interpreter::sdataMap (style/Interpreter.cxx:590) — the SdataMapper the
    ; grove's SdataNode::charChunk consults, and therefore the ONE character an
    ; SDATA entity reference contributes to any backend. Four steps, in order:
    ; the entity NAME table (the built-in sdata.h names plus map-sdata-entity
    ; declarations), the entity TEXT table (map-sdata-entity only), a U-XXXX
    ; name, and finally defaultChar. ★It NEVER fails — the reference returns 1
    ; on the fallback too, deliberately ("at least it makes preserve-sdata work
    ; with unknown SDATA entities"), so an sdata node's `char` is always
    ; accessOK.
    function sdata_map(this: Interpreter, name: StringC, text: StringC) returns u32
    {
        let byname Interpreter.lookup_char_entry(sdata_entity_name_table, name)
        if byname <> null
            return byname.c
        let bytext Interpreter.lookup_char_entry(sdata_entity_text_table, text)
        if bytext <> null
            return bytext.c
        var uc: u32 0
        if Interpreter.convert_unicode_char_name(name, &uc)
            return uc
        DEFAULT_CHAR as u32
    }

    ; static bool convertUnicodeCharName(const StringC &str, Char &c): U-XXXX
    function convert_unicode_char_name(str: StringC, c: pointer[u32]) returns bool
    {
        if str.get_size() <> 6
            return false
        if str.get(0) <> 0x55
            return false
        if str.get(1) <> 0x2D
            return false
        var value: u32 0
        var i: size_t 2
        while i < 6
        {
            let ch str.get(i)
            set value: value << (4 as u32)
            if (ch >= 0x30) and (ch <= 0x39)
                set value: value | (ch - 0x30)
            else if (ch >= 0x41) and (ch <= 0x46)
                set value: value | (10 + (ch - 0x41))
            else
                return false
            set i: i + 1
        }
        set *c: value
        true
    }

    ; --- declaration hooks (style-specification declaration elements) ------
    ; void setCharRepertoire(const StringC &pubid)
    function set_char_repertoire(this: pointer[Interpreter], pubid: StringC)
    {
        if pubid.equals(StringC("UNREGISTERED::OpenJade//Character Repertoire::OpenJade"))
        {
            if this.strict_mode
            {
                CharNames.install(this)
                Sdata.install(this)
                this.lex_category_table.set_range(127, 0xFFFF, LEX_ADD_NAME_START as u8)
                set this.strict_mode: false
            }
        }
        else
            this.message1(InterpreterMessages.unsupportedCharRepertoire(), pubid)
    }

    ; void addStandardChar(const StringC &name, const StringC &num)
    function add_standard_char(this: pointer[Interpreter], name: StringC, num: StringC)
    {
        var n 0
        var i: size_t 0
        if Interpreter.scan_sign_digits(num, &i, &n) = false
        {
            this.message1(InterpreterMessages.invalidCharNumber(), num)
            return
        }
        let def Interpreter.lookup_char_entry(this.named_char_table, name)
        if def <> null
        {
            if this.d_part_index < def.def_part
                this.insert_char_entry(this.named_char_table, name, n as u32, this.d_part_index)
            else if (def.def_part = this.d_part_index) and (def.c <> (n as u32))
                this.message1(InterpreterMessages.duplicateCharName(), name)
        }
        else
            this.insert_char_entry(this.named_char_table, name, n as u32, this.d_part_index)
    }

    ; void addNameChar(const StringC &name)
    function add_name_char(this: pointer[Interpreter], name: StringC)
    {
        let cp Interpreter.lookup_char_entry(this.named_char_table, name)
        if cp = null
        {
            this.message1(InterpreterMessages.badCharName(), name)
            return
        }
        if (this.lex_category_table.get(cp.c as i32) as int) <> LEX_OTHER
        {
            this.message0(InterpreterMessages.badDeclaration())
            return
        }
        this.lex_category_table.set_char(cp.c, LEX_ADD_NAME_START as u8)
    }

    ; void addSeparatorChar(const StringC &name)
    function add_separator_char(this: pointer[Interpreter], name: StringC)
    {
        let cp Interpreter.lookup_char_entry(this.named_char_table, name)
        if cp = null
        {
            this.message1(InterpreterMessages.badCharName(), name)
            return
        }
        if (this.lex_category_table.get(cp.c as i32) as int) <> LEX_OTHER
        {
            this.message0(InterpreterMessages.badDeclaration())
            return
        }
        this.lex_category_table.set_char(cp.c, LEX_ADD_WHITESPACE as u8)
    }

    ; void addSdataEntity(const StringC &ename, const StringC &etext, const StringC &name)
    function add_sdata_entity(this: pointer[Interpreter], ename: StringC, etext: StringC, name: StringC)
    {
        let cp Interpreter.lookup_char_entry(this.named_char_table, name)
        if cp = null
        {
            this.message1(InterpreterMessages.badCharName(), name)
            return
        }
        if ename.get_size() > 0
        {
            let def Interpreter.lookup_char_entry(this.sdata_entity_name_table, ename)
            if def <> null
            {
                if this.d_part_index < def.def_part
                    this.insert_char_entry(this.sdata_entity_name_table, ename, cp.c, this.d_part_index)
                else if (def.def_part = this.d_part_index) and (def.c <> cp.c)
                    this.message1(InterpreterMessages.duplicateSdataEntityName(), ename)
            }
            else
                this.insert_char_entry(this.sdata_entity_name_table, ename, cp.c, this.d_part_index)
        }
        if etext.get_size() > 0
        {
            let def Interpreter.lookup_char_entry(this.sdata_entity_text_table, etext)
            if def <> null
            {
                if this.d_part_index < def.def_part
                    this.insert_char_entry(this.sdata_entity_text_table, etext, cp.c, this.d_part_index)
                else if (def.def_part = this.d_part_index) and (def.c <> cp.c)
                    this.message1(InterpreterMessages.duplicateSdataEntityText(), etext)
            }
            else
                this.insert_char_entry(this.sdata_entity_text_table, etext, cp.c, this.d_part_index)
        }
    }

    ; --- the `-2` string leniency ------------------------------------------
    ; ELObj *convertFromString(ELObj *, unsigned hints, const Location &)
    ; (Interpreter.cxx:1095). Under `-2` EVERY characteristic value passes
    ; through here before its converter, so a STRING may stand in for the
    ; number, symbol or boolean the converter wants. Without `-2` — and for
    ; anything that is not a string — it returns the object unchanged.
    ;
    ; ★The hints belong to the CONVERTER, not to the key: convertLengthC
    ; allows a number only, convertEnumC a symbol or a boolean. A union over
    ; all three would be wrong, because it would reinterpret the value of a
    ; genuine STRING characteristic (`entity-system-id: "5"` is the string
    ; "5", never the number 5).
    ;
    ; ★The number arm resolves quantities: convertNumber answers an
    ; UnresolvedLengthObj for "3pt", which is only a length once its unit is
    ; resolved — and an undefined unit messages at `loc`.
    function convert_from_string(this: pointer[Interpreter], obj: pointer[ELObj], hints: int, loc: Location) returns pointer[ELObj]
    {
        ; FIXME fold to lower case  (the reference's own comment)
        if this.dsssl2 = false
            return obj
        if obj.is_string_p() = false
            return obj
        let host this.host
        let str obj.string_data(host)
        if (hints & CONVERT_ALLOW_NUMBER) <> 0
        {
            let tem this.convert_number(str)
            if tem <> null
                return tem.resolve_quantities(true, this, loc)
        }
        if (hints & CONVERT_ALLOW_SYMBOL) <> 0
        {
            ; ★a LOOKUP, not makeSymbol: a name that is no symbol yet must
            ; not be interned here — and a symbol without a c-value (one that
            ; no characteristic ever names) does not convert either.
            let sym this.lookup_symbol(str)
            if sym <> null
            {
                if sym.symbol_c_value() <> SYM_FALSE
                    return sym
            }
        }
        if (hints & CONVERT_ALLOW_BOOLEAN) <> 0
        {
            let n str.get_size()
            if n = 2
            {
                if Interpreter.equals_ascii(str, "no")
                    return ELObj.make_false(host)
            }
            else if n = 3
            {
                if Interpreter.equals_ascii(str, "yes")
                    return ELObj.make_true(host)
            }
            else if n = 4
            {
                if Interpreter.equals_ascii(str, "true")
                    return ELObj.make_true(host)
            }
            else if n = 5
            {
                if Interpreter.equals_ascii(str, "false")
                    return ELObj.make_false(host)
            }
        }
        obj
    }

    ; static bool equal(const Char *s1, const char *s2, size_t n)
    ; (Interpreter.cxx:1086) — the byte compare of the boolean arm.
    function equals_ascii(str: StringC, lit: pointer[const_char]) returns bool
    {
        let b lit as pointer[u8]
        var i: size_t 0
        while i < str.get_size()
        {
            let c *(b + i)
            if c = 0
                return false
            if str.get(i) <> (c as u32)
                return false
            set i: i + 1
        }
        *(b + i) = 0
    }

    ; SymbolObj *symbolTable_.lookup(const StringC &) — the lookup half of
    ; makeSymbol, WITHOUT the interning: convertFromString may not create a
    ; symbol for a string that names none.
    function lookup_symbol(this: pointer[Interpreter], str: StringC) returns pointer[ELObj]
    {
        let hit this.symbol_index.lookup(str)
        if hit = null
            return null
        hit as pointer[ELObj]
    }

    ; --- number conversion -------------------------------------------------
    ; static bool scanSignDigits(const StringC &, size_t &i, int &n)
    function scan_sign_digits(str: StringC, i: pointer[size_t], n: pointer[int]) returns bool
    {
        var negative false
        if *i < str.get_size()
        {
            if str.get(*i) = 0x2D
            {
                set *i: *i + 1
                set negative: true
            }
            else if str.get(*i) = 0x2B
                set *i: *i + 1
        }
        let j *i
        var v 0
        while *i < str.get_size()
        {
            let ch str.get(*i)
            if (ch < 0x30) or (ch > 0x39)
                break
            if negative
                set v: v * 10 - ((ch - 0x30) as int)
            else
                set v: v * 10 + ((ch - 0x30) as int)
            set *i: *i + 1
        }
        set *n: v
        *i <> j
    }

    ; ELObj *convertNumber(const StringC &str, int radix = 10)
    function convert_number(this: pointer[Interpreter], str: StringC) returns pointer[ELObj]
        this.convert_number_radix(str, 10)

    function convert_number_radix(this: pointer[Interpreter], str: StringC, radix_in: int) returns pointer[ELObj]
    {
        var radix radix_in
        if str.get_size() = 0
            return null
        var i: size_t 0
        if str.get(0) = 0x23
        {
            ; '#' radix prefix: #d #x #o #b
            if str.get_size() < 2
                return null
            let r str.get(1)
            if r = 0x64
                set radix: 10
            else if r = 0x78
                set radix: 16
            else if r = 0x6F
                set radix: 8
            else if r = 0x62
                set radix: 2
            else
                return null
            set i: i + 2
        }
        if i >= str.get_size()
            return null
        var negative false
        if str.get(i) = 0x2D
        {
            set negative: true
            set i: i + 1
        }
        else
        {
            if str.get(i) = 0x2B
                set i: i + 1
        }
        var had_decimal_point false
        var had_digit false
        var n 0
        var exp 0
        let long_max 0x7FFFFFFFFFFFFFFF
        while i < str.get_size()
        {
            let c str.get(i)
            var weight 0 - 1
            if (c >= 0x30) and (c <= 0x39)
                set weight: (c - 0x30) as int
            else if (c >= 0x61) and (c <= 0x66)
                set weight: ((c - 0x61) as int) + 10
            if (weight >= 0) and (weight < radix)
            {
                set had_digit: true
                if negative
                {
                    ; -(unsigned long)n > (-(unsigned long)LONG_MIN - weight)/radix
                    let neg_n 0 - (n as u64)
                    let neg_min (long_max as u64) + 1
                    if neg_n > (neg_min - (weight as u64)) / (radix as u64)
                    {
                        if radix <> 10
                            return null
                        return this.convert_number_float(str)
                    }
                    set n: n * radix - weight
                }
                else
                {
                    if n > (long_max - weight) / radix
                    {
                        if radix <> 10
                            return null
                        return this.convert_number_float(str)
                    }
                    set n: n * radix + weight
                }
                if had_decimal_point
                    set exp: exp - 1
            }
            else if (c = 0x2E) and (radix = 10)
            {
                if had_decimal_point
                    return null
                set had_decimal_point: true
            }
            else
                break
            set i: i + 1
        }
        if had_digit = false
            return null
        if (radix <> 10) and (i < str.get_size())
            return null
        if (i + 1) < str.get_size()
        {
            if str.get(i) = 0x65
            {
                ; 'e' exponent — but not when a letter follows ("1em" is a
                ; quantity in the em unit)
                if (this.lex_category_table.get(str.get(i + 1) as i32) as int) <> LEX_LETTER
                {
                    set had_decimal_point: true
                    set i: i + 1
                    var e 0
                    if Interpreter.scan_sign_digits(str, &i, &e) = false
                        return null
                    set exp: exp + e
                }
            }
        }
        if i < str.get_size()
        {
            var unit_exp 0
            let unit this.scan_unit(str, i, &unit_exp)
            if unit = null
                return null
            if unit_exp = 1
                return ELObj.make_unresolved_length(this.host, n, exp, unit)
            return this.convert_number_float(str)
        }
        if had_decimal_point
            return this.convert_number_float(str)
        ELObj.make_integer(this.host, n)
    }

    ; ELObj *convertNumberFloat(const StringC &str)
    function convert_number_float(this: pointer[Interpreter], str: StringC) returns pointer[ELObj]
    {
        ; omit an optional #d radix prefix
        var i0: size_t 0
        if str.get_size() > 1
        {
            if (str.get(0) = 0x23) and (str.get(1) = 0x64)
                set i0: 2
        }
        let host this.host
        let cap (str.get_size() + 1) - i0
        let buf host.allocate(cap, 1) as pointer[u8]
        var w: size_t 0
        var i i0
        while i < str.get_size()
        {
            let c str.get(i)
            if (c > 127) or (c = 0)
                return null
            ; 'E' is a valid exponent marker for C but not for us
            if c = 0x45
                break
            set *(buf + w): c as u8
            set w: w + 1
            set i: i + 1
        }
        set *(buf + w): 0
        var endp: pointer[u8] null
        let val strtod(buf as pointer[const_char], &endp)
        let consumed (endp as size_t) - (buf as size_t)
        if consumed = (str.get_size() - i0)
            return ELObj.make_real(host, val)
        if consumed = 0
            return null
        var unit_exp 0
        let unit this.scan_unit(str, consumed + i0, &unit_exp)
        if unit = null
            return null
        ELObj.make_unresolved_quantity(host, val, unit, unit_exp)
    }

    ; Unit *scanUnit(const StringC &str, size_t i, int &unitExp) — null on error.
    function scan_unit(this: pointer[Interpreter], str: StringC, i_in: size_t, unit_exp: pointer[int]) returns pointer[Unit]
    {
        let host this.host
        var i i_in
        let name_chars Array[u32]^host()
        while i < str.get_size()
        {
            let c str.get(i)
            if (c = 0x2D) or (c = 0x2B) or ((c >= 0x30) and (c <= 0x39))
                break
            name_chars.add(c)
            set i: i + 1
        }
        if i >= str.get_size()
            set *unit_exp: 1
        else
        {
            var e 0
            var neg false
            if (str.get(i) = 0x2D) or (str.get(i) = 0x2B)
            {
                if str.get(i) = 0x2D
                    set neg: true
                set i: i + 1
                if i >= str.get_size()
                    return null
            }
            while i < str.get_size()
            {
                let c str.get(i)
                if (c < 0x30) or (c > 0x39)
                    return null
                set e: e * 10
                if neg
                    set e: e - ((c - 0x30) as int)
                else
                    set e: e + ((c - 0x30) as int)
                set i: i + 1
            }
            set *unit_exp: e
        }
        let unit_name StringC^host(name_chars.get_buffer(), name_chars.get_length())
        this.lookup_unit(unit_name)
    }

    ; --- Messenger seam ----------------------------------------------------
    function set_next_location(this: pointer[Interpreter], loc: Location)
        set this.next_loc: loc

    function get_error_count(this: Interpreter) returns int
        error_count

    function message0(this: pointer[Interpreter], mt: MessageType)
    {
        let args Vector[MessageArg]()
        this.emit(mt, args)
    }

    function message1(this: pointer[Interpreter], mt: MessageType, a1: StringC)
    {
        var args Vector[MessageArg](1)
        set *(args.get(0)): MessageArg.Str(a1)
        this.emit(mt, args)
    }

    function message2(this: pointer[Interpreter], mt: MessageType, a1: StringC, a2: StringC)
    {
        var args Vector[MessageArg](2)
        set *(args.get(0)): MessageArg.Str(a1)
        set *(args.get(1)): MessageArg.Str(a2)
        this.emit(mt, args)
    }

    ; NumberMessageArg shape (stackTraceEllipsis's omitted-call count): %1
    ; renders unquoted.
    function message_num(this: pointer[Interpreter], mt: MessageType, n: u64)
    {
        var args Vector[MessageArg](1)
        set *(args.get(0)): MessageArg.Num(n)
        this.emit(mt, args)
    }

    function get_debug_mode(this: Interpreter) returns bool
        debug_mode

    ; MessageType3 shape of PrimitiveObj::argError: %1 primitive name,
    ; %2 ordinal, %3 printed object.
    function message3(this: pointer[Interpreter], mt: MessageType, a1: StringC, ord2: u64, a3: StringC)
    {
        var args Vector[MessageArg](3)
        set *(args.get(0)): MessageArg.Str(a1)
        set *(args.get(1)): MessageArg.Ord(ord2)
        set *(args.get(2)): MessageArg.Str(a3)
        this.emit(mt, args)
    }

    ; --- self-test ---------------------------------------------------------
    function test() returns int
    {
        let anchor StringC("x")
        let host Page.get(anchor.data_ptr() as pointer[void])
        ; jade's default: twips (20*72 units per inch)
        let interp Interpreter.make(host, 1440, false, false, false)

        ; integer conversion incl. radix prefixes
        let a interp.convert_number(StringC("42"))
        if a = null
            return 1
        if a.exact_integer_value() <> 42
            return 2
        let b interp.convert_number(StringC("-17"))
        if b.exact_integer_value() <> (0 - 17)
            return 3
        let c interp.convert_number(StringC("#x1a"))
        if c.exact_integer_value() <> 26
            return 4
        let d interp.convert_number(StringC("#b101"))
        if d.exact_integer_value() <> 5
            return 5
        let e interp.convert_number(StringC("#o17"))
        if e.exact_integer_value() <> 15
            return 6
        let f interp.convert_number(StringC("+5"))
        if f.exact_integer_value() <> 5
            return 7

        ; reals
        let g interp.convert_number(StringC("1.5"))
        if g.is_inexact_real() = false
            return 8
        if g.real_value() <> 1.5
            return 9
        let h interp.convert_number(StringC("1.5e2"))
        if h.real_value() <> 150.0
            return 10

        ; malformed
        if interp.convert_number(StringC("1.2.3")) <> null
            return 11
        if interp.convert_number(StringC("#xg")) <> null
            return 12

        ; quantities: builtin units are precomputed from unitsPerInch, so
        ; resolve_quantities completes without the VM
        let q interp.convert_number(StringC("2in"))
        if q = null
            return 13
        let rq q.resolve_quantities(false, interp, Location())
        if rq.is_length() = false
            return 14
        if rq.length_value() <> 2880
            return 15
        let q2 interp.convert_number(StringC("3pt"))
        let rq2 q2.resolve_quantities(false, interp, Location())
        if rq2.length_value() <> 60
            return 16

        ; char names: the generated table + U-XXXX
        var ch: u32 0
        if interp.convert_char_name(StringC("space"), &ch) = false
            return 17
        if ch <> 0x20
            return 18
        if interp.convert_char_name(StringC("U-0041"), &ch) = false
            return 19
        if ch <> 0x41
            return 20
        if interp.convert_char_name(StringC("no-such-name"), &ch)
            return 21

        ; interning: one Identifier / SymbolObj per name; keywords are fresh
        ; objects equal through their interned Identifier
        let i1 interp.lookup(StringC("foo"))
        let i2 interp.lookup(StringC("foo"))
        if i1 <> i2
            return 22
        let s1 interp.make_symbol(StringC("bar"))
        let s2 interp.make_symbol(StringC("bar"))
        if s1 <> s2
            return 23
        let k1 interp.make_keyword(StringC("baz"))
        let k2 interp.make_keyword(StringC("baz"))
        if k1 = k2
            return 24
        if ELObj.equal(k1, k2) = false
            return 25

        ; lexical categories
        if interp.lex_category(0x41) <> LEX_LETTER
            return 26
        if interp.lex_category(0x28) <> LEX_DELIMITER
            return 27
        if interp.lex_category(0 - 1) <> LEX_DELIMITER
            return 28
        if interp.lex_category(0x2B) <> LEX_OTHER_NUMBER_START
            return 29

        if interp.get_error_count() <> 0
            return 30

        0
    }

    ; the CLI driver's argv0 — the MessageReporter prefix. Unset, messages keep
    ; the historical package prefix `dazzle` (unit tests / --jit suite).
    function set_msg_prog(prog: pointer[const_char])
        set msg_prog: prog

    ; render one diagnostic line to stderr, byte-identical to the reference
    ; MessageReporter::dispatchMessage the style Interpreter reports through:
    ;   <prog>:[<file>:<line>[:<col>]:]<sev>: <formatted text>\n
    ; The location is the Messenger's next-location (setNextLocation), CONSUMED
    ; by this message (initMessage clears it). A null-origin location renders
    ; no location segment at all (`<prog>:I: called from here`); a non-null
    ; origin whose chain names no real backing source renders the reference's
    ; "(invalid location)". Errors count; Info (stack traces) does not.
    function emit(this: pointer[Interpreter], mt: MessageType, args: Vector[MessageArg])
    {
        let loc this.next_loc
        set this.next_loc: Location()

        var buf u32[2048]
        let bp buf as pointer[u32]
        let cap: size_t 2048
        var p: size_t 0

        ; program name (raw ASCII bytes) + ':'
        if msg_prog <> null
        {
            let pb msg_prog as pointer[u8]
            var pi: size_t 0
            while (*(pb + pi)) <> 0
            {
                set p: ParserState.put_char(bp, cap, p, (*(pb + pi)) as u32)
                set pi: pi + 1
            }
        }
        else
        {
            set p: ParserState.put_char(bp, cap, p, 0x64)
            set p: ParserState.put_char(bp, cap, p, 0x61)
            set p: ParserState.put_char(bp, cap, p, 0x7A)
            set p: ParserState.put_char(bp, cap, p, 0x7A)
            set p: ParserState.put_char(bp, cap, p, 0x6C)
            set p: ParserState.put_char(bp, cap, p, 0x65)
        }
        set p: ParserState.put_char(bp, cap, p, 0x3A)

        if loc.get_origin() <> null
        {
            var line: u32 0
            var col: u32 0
            var ridx: size_t 0
            let resolved Origin.resolve_chain(loc, false, &line, &col, &ridx)
            ; a chain that names no real backing source prints NO location
            ; segment at all — MessageReporter::dispatchMessage skips
            ; printLocation when locationHeader returns null (the builtins
            ; prolog's InputSourceOrigin::make() has no external info).
            if resolved <> null
            {
                ; file name + ':' + line ':' [col ':'] — the same rendering
                ; rules as ParserState.emit_message (printLocation).
                let fname resolved.file_name_at(ridx)
                var fi: size_t 0
                while fi < fname.get_size()
                {
                    set p: ParserState.put_char(bp, cap, p, fname.get(fi))
                    set fi: fi + 1
                }
                set p: ParserState.put_char(bp, cap, p, 0x3A)
                set p: ParserState.put_dec(bp, cap, p, line as u64)
                set p: ParserState.put_char(bp, cap, p, 0x3A)
                var omit_col false
                if (loc.get_index() = 0) and (line = 1) and (col = 0)
                {
                    if resolved.get_buf_length() > 0
                        set omit_col: true
                }
                if resolved.on_segment_leading_rs(ridx)
                    set omit_col: true
                if col = MSG_COL_OMITTED
                    set omit_col: true
                if omit_col = false
                {
                    set p: ParserState.put_dec(bp, cap, p, col as u64)
                    set p: ParserState.put_char(bp, cap, p, 0x3A)
                }
            }
        }

        set p: ParserState.put_char(bp, cap, p, mt.severity_char())
        set p: ParserState.put_char(bp, cap, p, 0x3A)
        set p: ParserState.put_char(bp, cap, p, 0x20)
        let fmt MessageFormatter()
        ; get_text() is the raw literal template now (opensp.Message.MessageFragment)
        let added fmt.format(StringC(mt.get_text()), args, bp + p, cap - p, false)
        set p: p + added
        set p: ParserState.put_char(bp, cap, p, 0x0A)
        ParserState.write_stderr(bp, p, true, 2)
        if mt.is_error()
            set this.error_count: this.error_count + 1
    }

    ; an auxiliary message line (`<prog>:<file>:<line>:<col>: <text>` — no
    ; severity char; the reference MessageReporter's auxiliary fragment, e.g.
    ; duplicateDefinition's "first definition was here").
    function emit_aux(this: pointer[Interpreter], mt: MessageType, loc: Location)
    {
        ; ★MessageReporter::dispatchMessage prints the AUXILIARY fragment only
        ; when `message.auxLoc.origin()` is non-null (MessageReporter.cxx:99).
        ; Every caller so far handed over a location that had one; a BUILT-IN
        ; characteristic does not — its definition record was never stamped by
        ; a declaration — so `(declare-char-characteristic+property font-size
        ; … )` reports the duplicate with NO "first definition was here".
        if loc.get_origin() = null
            return
        var buf u32[1024]
        let bp buf as pointer[u32]
        let cap: size_t 1024
        var p: size_t 0
        if msg_prog <> null
        {
            let pb msg_prog as pointer[u8]
            var pi: size_t 0
            while (*(pb + pi)) <> 0
            {
                set p: ParserState.put_char(bp, cap, p, (*(pb + pi)) as u32)
                set pi: pi + 1
            }
        }
        else
        {
            set p: ParserState.put_char(bp, cap, p, 0x64)
            set p: ParserState.put_char(bp, cap, p, 0x61)
            set p: ParserState.put_char(bp, cap, p, 0x7A)
            set p: ParserState.put_char(bp, cap, p, 0x7A)
            set p: ParserState.put_char(bp, cap, p, 0x6C)
            set p: ParserState.put_char(bp, cap, p, 0x65)
        }
        set p: ParserState.put_char(bp, cap, p, 0x3A)
        if loc.get_origin() <> null
        {
            var line: u32 0
            var col: u32 0
            var ridx: size_t 0
            let resolved Origin.resolve_chain(loc, false, &line, &col, &ridx)
            if resolved <> null
            {
                let fname resolved.file_name_at(ridx)
                var fi: size_t 0
                while fi < fname.get_size()
                {
                    set p: ParserState.put_char(bp, cap, p, fname.get(fi))
                    set fi: fi + 1
                }
                set p: ParserState.put_char(bp, cap, p, 0x3A)
                set p: ParserState.put_dec(bp, cap, p, line as u64)
                set p: ParserState.put_char(bp, cap, p, 0x3A)
                var omit_col false
                if (loc.get_index() = 0) and (line = 1) and (col = 0)
                {
                    if resolved.get_buf_length() > 0
                        set omit_col: true
                }
                if resolved.on_segment_leading_rs(ridx)
                    set omit_col: true
                if col = MSG_COL_OMITTED
                    set omit_col: true
                if omit_col = false
                {
                    set p: ParserState.put_dec(bp, cap, p, col as u64)
                    set p: ParserState.put_char(bp, cap, p, 0x3A)
                }
            }
        }
        set p: ParserState.put_char(bp, cap, p, 0x20)
        let fmt MessageFormatter()
        let args Vector[MessageArg]()
        ; get_text() is the raw literal template now (opensp.Message.MessageFragment)
        let added fmt.format(StringC(mt.get_text()), args, bp + p, cap - p, false)
        set p: p + added
        set p: ParserState.put_char(bp, cap, p, 0x0A)
        ParserState.write_stderr(bp, p, true, 2)
    }
}
