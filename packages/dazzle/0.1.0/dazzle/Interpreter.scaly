; Interpreter — the style-language interpreter (style/Interpreter.cxx).
; Inc-2 scope: the READER seam the SchemeParser datum reader needs — the
; lexical-category table, symbol/keyword/identifier interning, number
; conversion (convertNumber family incl. quantities and units), character
; names (charNames.h table + U-XXXX), sdata entity mapping, and the
; standard-chars / add-name-chars / add-separator-chars / map-sdata-entity
; declaration hooks. The evaluation half (syntactic keys, primitives,
; processing modes, Insn/VM) lands with Inc 3 per DESIGN.md.
;
; Messages: text/severity sourced from the generated InterpreterMessages
; table (InterpreterMessages.msg). Rendering here is the package-level seam
; (`dazzle:<severity>: <text>` on stderr + error count); the full
; file:line:col MessageReporter prefix is the CLI driver's job and lands
; with Inc 7 (DssslApp/CmdLineApp port), like the reference where the app
; object IS the Messenger.

; The eval scratch region (Collector seam, RBMM shape): while ProcessContext
; evaluates a construction rule, get_host() returns this region instead of
; the run page, so every eval-transient (intermediate ELObjs, sosofo trees,
; per-call insns, fresh VMs) dies with the node's bracket instead of
; retaining until run end — the reference reclaims the same objects with
; Clark's GC. null outside processing (load/compile allocate on the run
; page as before). Interning (symbols/identifiers/units) and Identifier
; value forcing go to the PERM host explicitly (makePermanent semantics).
; A module global, not an Interpreter field: growing a heap-hosted struct
; in the dazzle run region trips the page-boundary RBMM fragility (S62).
; `shared`, not `mutable`: a thread-local in a dep package aborts under
; --jit (_tlv_bootstrap_error — the ORC AddObjectFile path doesn't wire
; MachO TLV). Race discipline: the style engine is single-threaded per
; run; a self-scaling `for` never promotes a loop that touches a mutable
; global, so no promoted loop can race this cell.
shared eval_region: pointer[Page] null

; The run arena page, as a cell, so the MEMO host seam below can be reached
; without an Interpreter in hand — a lazy flatten deep in ELObj has the object
; and a transient host, not the interpreter. One Interpreter per run, set in
; `make`, same race discipline as `eval_region`.
shared perm_cell: pointer[Page] null
; 0 = not asked yet, 1 = the run arena, 2 = the object's own region (default)
shared memo_perm: int 0
; which memo FAMILY the run-arena host applies to — DZ_MEMO_SITES=n|r|nr. Only
; for bisecting a difference to one of the two; the shipped setting is both.
shared memo_sites_nl: bool true
shared memo_sites_rope: bool true

; argv0 for the MessageReporter prefix (`<argv0>:<file>:<line>:<col>:<sev>: …`,
; exactly the reference where the app object IS the Messenger). The CLI driver
; sets this once before processing; unset (unit tests, --jit suite) the prefix
; stays the historical package name `dazzle`. A `shared` module global, not an
; Interpreter field — growing a heap-hosted struct in the dazzle run region
; trips the page-boundary RBMM fragility (S62), and `mutable` (TLS) in a dep
; package aborts under --jit.
shared msg_prog: pointer[const_char] null

; whether the active backend provides the transform extension flow-object
; classes (jade.cxx passes an extension table only for -t sgml/xml); the CLI
; clears it for -t fot. A `shared` module global by the S62 rule (no
; Interpreter field growth); single-threaded CLI setup writes it once.
shared xt_extensions_on: bool true

; MessageReporter's column-omission sentinel (opensp.Location COL_OMITTED —
; module-level consts are not cross-package-visible; mirrored here).
define MSG_COL_OMITTED: u32 0xFFFFFFFF

; Interpreter::LexCategory
define LEX_LETTER: int 0            ; a-z A-Z
define LEX_OTHER_NAME_START: int 1  ; !$%&*/<=>?~_^:
define LEX_ADD_NAME_START: int 2
define LEX_DIGIT: int 3             ; 0-9
define LEX_OTHER_NUMBER_START: int 4 ; -+.
define LEX_OTHER: int 5
define LEX_DELIMITER: int 6         ; ();"
define LEX_WHITESPACE: int 7
define LEX_ADD_WHITESPACE: int 8

; the printer's replacement char for unknown character names
define DEFAULT_CHAR: int 0xFFFD

; Unit::computed_ states
define UNIT_NOT_COMPUTED: int 0
define UNIT_BEING_COMPUTED: int 1
define UNIT_COMPUTED_EXACT: int 2
define UNIT_COMPUTED_INEXACT: int 3
define UNIT_COMPUTED_ERROR: int 4

; strtod(3) — fixed-prototype, non-variadic, errno-free use: direct extern
; per the containment rule.
function strtod(s: pointer[const_char], endp: pointer[pointer[u8]]) returns double extern

; the memo-host seam's one switch (DZ_MEMO_PERM)
function getenv(name: pointer[const_char]) returns pointer[const_char] extern

; A named-character-table entry (Interpreter::CharPart): the char plus the
; index of the defining part (unsigned(-1) = predefined).
define CharPart (name: StringC, c: u32, def_part: u32)
{
    init(name: StringC, c: u32, def_part: u32)
    {
        set this.name: name
        set this.c: c
        set this.def_part: def_part
    }
}

; CharProp (Interpreter.h) — one character property: a DEFAULT value plus a
; per-character map. The reference's map is a full CharMap<ELObjPart> whose
; unset slot is a null object; here it is an ordered list of
; [first, last] -> value entries searched BACKWARD, so a later
; add-char-properties overrides an earlier install exactly as setChar over
; setRange does. `def_part` carries the spec part that supplied the default,
; which is what the duplicate-declaration rule compares.
; ★`part` is the ELObjPart half of the reference's CharMap<ELObjPart>
; (Interpreter.cxx:2347): a per-character value remembers WHICH PART set it,
; because that is what decides between overwrite, silence and a duplicate
; diagnostic.
define CharPropRange (first: u32, last: u32, obj: pointer[ELObj], part: u32)
{
    init(first: u32, last: u32, obj: pointer[ELObj], part: u32)
    {
        set this.first: first
        set this.last: last
        set this.obj: obj
        set this.part: part
    }
}

define CharProp (name: StringC, def: pointer[ELObj], def_part: u32, loc: Location, ranges: pointer[Array[CharPropRange]])
{
    function make(host: pointer[Page], name: StringC, def: pointer[ELObj], def_part: u32) returns pointer[CharProp]
    {
        let p host.allocate(sizeof CharProp, alignof CharProp) as pointer[CharProp]
        set p.name: name
        set p.def: def
        set p.def_part: def_part
        set p.loc: Location()
        set p.ranges: Array[CharPropRange]^host()
        p
    }

    ; CharMap::setRange — a later entry wins, so the lookup walks BACKWARD.
    procedure set_range(this: pointer[CharProp], first: u32, last: u32, obj: pointer[ELObj], part: u32)
        this.ranges.add(CharPropRange(first, last, obj, part))

    ; the part that last set this character's own value; 0xFFFFFFFF when it
    ; has none (the reference's ELObjPart(0, unsigned(-1)) default).
    function lookup_part(this: CharProp, c: u32) returns u32
    {
        let n ranges.get_length()
        var i n
        while i > 0
        {
            set i: i - 1
            let rp ranges.get(i)
            if rp <> null
            {
                let r *rp
                if (c >= r.first) and (c <= r.last)
                    return r.part
            }
        }
        0xFFFFFFFF
    }

    ; (*cp->map)[c].obj — null when the character has no value of its own.
    function lookup(this: CharProp, c: u32) returns pointer[ELObj]
    {
        let n ranges.get_length()
        var i n
        while i > 0
        {
            set i: i - 1
            let rp ranges.get(i)
            if rp <> null
            {
                let r *rp
                if (c >= r.first) and (c <= r.last)
                    return r.obj
            }
        }
        null
    }
}

; Unit — a named measurement unit (Interpreter.h class Unit : Named).
; Builtin units get their value from unitsPerInch in installUnits (setValue
; marks them computedExact/Inexact); define-unit bodies arrive via
; setDefinition and compute lazily in tryCompute (canEval-gated without
; force, exactly the reference's eager-top-level shape).
define Unit (name: StringC, computed: int, exact: int, inexact: double, dim: int, def_part: u32, def_expr: pointer[Expression], def_insn: pointer[Insn], def_loc: Location)
{
    function make(host: pointer[Page], name: StringC) returns pointer[Unit]
    {
        let u host.allocate(sizeof Unit, alignof Unit) as pointer[Unit]
        set u.name: StringC^host(name.data_ptr(), name.get_size())
        set u.computed: UNIT_NOT_COMPUTED
        set u.exact: 0
        set u.inexact: 0.0
        set u.dim: 0
        set u.def_part: 0xFFFFFFFF
        set u.def_expr: null
        set u.def_insn: null
        set u.def_loc: Location()
        u
    }

    ; void setDefinition(Owner<Expression> &, unsigned part, const Location &)
    ; — the define-unit body; computed resets so the next resolve recomputes.
    function set_definition(this: pointer[Unit], expr: pointer[Expression], part: u32, loc: Location)
    {
        set this.def_expr: expr
        set this.def_part: part
        set this.def_loc: loc
        set this.computed: UNIT_NOT_COMPUTED
    }

    ; bool defined(unsigned &part, Location &loc)
    function defined(this: pointer[Unit], part_out: pointer[u32], loc_out: pointer[Location]) returns bool
    {
        if this.def_expr = null
        {
            if this.computed = UNIT_NOT_COMPUTED
                return false
        }
        set *part_out: this.def_part
        set *loc_out: this.def_loc
        true
    }

    function get_name(this: Unit) returns StringC
        name

    ; void setValue(long)
    function set_value_long(this: pointer[Unit], n: int)
    {
        set this.computed: UNIT_COMPUTED_EXACT
        set this.exact: n
        set this.dim: 1
        set this.def_part: 0xFFFFFFFF
    }

    ; void setValue(double)
    function set_value_double(this: pointer[Unit], n: double)
    {
        set this.computed: UNIT_COMPUTED_INEXACT
        set this.inexact: n
        set this.dim: 1
        set this.def_part: 0xFFFFFFFF
    }

    ; bool defined(unsigned &part, Location &loc) — Inc-2 subset: no def_
    ; expression yet, so defined <=> a computed value exists (the out-params
    ; feed doDefineUnit's duplicate diagnostics, Inc 3).
    function is_defined(this: Unit) returns bool
        computed <> UNIT_NOT_COMPUTED

    ; static bool scale(long val, int valExp, long factor, long &result):
    ; result = val * 10^valExp * factor, 0 on overflow.
    function scale(val: int, val_exp_in: int, factor_in: int, result: pointer[int]) returns bool
    {
        var val_exp val_exp_in
        var factor factor_in
        let long_max 0x7FFFFFFFFFFFFFFF
        if factor <= 0
            return false
        while val_exp > 0
        {
            if factor > long_max / 10
                return false
            set val_exp: val_exp - 1
            set factor: factor * 10
        }
        if val >= 0
        {
            if val > long_max / factor
                return false
        }
        else
        {
            ; -(unsigned long)val > -(unsigned long)LONG_MIN/factor
            let neg_val 0 - (val as u64)
            let neg_min (long_max as u64) + 1
            if neg_val > neg_min / (factor as u64)
                return false
        }
        var r val * factor
        while val_exp < 0
        {
            set r: r / 10
            set val_exp: val_exp + 1
        }
        set *result: r
        true
    }

    ; ELObj *resolveQuantity(bool force, Interpreter &, long val, int valExp)
    ; (val * 10^valExp of this unit; the unit's own exponent is 1).
    function resolve_quantity_long(this: pointer[Unit], force: bool, interp: pointer[Interpreter], val: int, val_exp_in: int) returns pointer[ELObj]
    {
        this.try_compute(force, interp)
        if this.computed = UNIT_COMPUTED_EXACT
        {
            var result 0
            if Unit.scale(val, val_exp_in, this.exact, &result)
                return ELObj.make_length(interp.host, result)
        }
        var val_exp val_exp_in
        var x val as double
        while val_exp > 0
        {
            set x: x * 10.0
            set val_exp: val_exp - 1
        }
        while val_exp < 0
        {
            set x: x / 10.0
            set val_exp: val_exp + 1
        }
        this.resolve_quantity_double(force, interp, x, 1)
    }

    ; ELObj *resolveQuantity(bool force, Interpreter &, double val, int unitExp)
    function resolve_quantity_double(this: pointer[Unit], force: bool, interp: pointer[Interpreter], val: double, unit_exp_in: int) returns pointer[ELObj]
    {
        this.try_compute(force, interp)
        var factor 0.0
        if this.computed = UNIT_COMPUTED_EXACT
            set factor: this.exact as double
        else if this.computed = UNIT_COMPUTED_INEXACT
            set factor: this.inexact
        else if this.computed = UNIT_COMPUTED_ERROR
            return interp.make_error()
        else
            return null
        var unit_exp unit_exp_in
        var result_dim 0
        var result_val val
        while unit_exp > 0
        {
            set result_dim: result_dim + this.dim
            set result_val: result_val * factor
            set unit_exp: unit_exp - 1
        }
        while unit_exp < 0
        {
            set result_dim: result_dim - this.dim
            set result_val: result_val / factor
            set unit_exp: unit_exp + 1
        }
        if result_dim = 0
            return ELObj.make_real(interp.host, result_val)
        ELObj.make_quantity(interp.host, result_val, result_dim)
    }

    ; void tryCompute(bool force, Interpreter &) — evaluate the define-unit
    ; body (compiled once); without force only a canEval body computes (the
    ; reference's lazy top-level shape); a recursive resolve is the unitLoop
    ; error; a non-quantity result is badUnitDefinition at the definition.
    function try_compute(this: pointer[Unit], force: bool, interp: pointer[Interpreter])
    {
        if this.computed = UNIT_NOT_COMPUTED
        {
            if this.def_expr = null
                return
            set this.computed: UNIT_BEING_COMPUTED
            let host interp.get_host()
            if this.def_insn = null
            {
                let env Environment.make(host)
                set this.def_insn: Expression.optimize_compile(this.def_expr, interp, env, 0, null)
            }
            var run force
            if run = false
                set run: this.def_expr.can_eval(false, interp)
            if run
            {
                let vm VM.make(host, interp)
                let v vm.eval(this.def_insn, null, null)
                let qv v.quantity_value()
                let qt qv.get_qtype()
                if qt = QT_NONE
                {
                    if interp.is_error(v) = false
                    {
                        interp.set_next_location(this.def_loc)
                        interp.message1(InterpreterMessages.badUnitDefinition(), this.name)
                    }
                    set this.computed: UNIT_COMPUTED_ERROR
                }
                else if qt = QT_LONG
                {
                    set this.exact: qv.get_lval()
                    set this.dim: qv.get_dim()
                    set this.computed: UNIT_COMPUTED_EXACT
                }
                else
                {
                    set this.inexact: qv.get_dval()
                    set this.dim: qv.get_dim()
                    set this.computed: UNIT_COMPUTED_INEXACT
                }
            }
            if this.computed = UNIT_BEING_COMPUTED
                set this.computed: UNIT_NOT_COMPUTED
        }
        else if this.computed = UNIT_BEING_COMPUTED
        {
            interp.set_next_location(this.def_loc)
            interp.message1(InterpreterMessages.unitLoop(), this.name)
            set this.computed: UNIT_COMPUTED_ERROR
        }
    }
}

; externalProcTable_ entry: a public identifier -> primitive value binding
; (Interpreter::installPrimitive / installXPrimitive; external-procedure
; resolves against it). Linear array, insertion order.
define ExternalProc (pubid: StringC, value: pointer[ELObj])
{
    function make(host: pointer[Page], pubid: StringC, value: pointer[ELObj]) returns pointer[ExternalProc]
    {
        let e host.allocate(sizeof ExternalProc, alignof ExternalProc) as pointer[ExternalProc]
        set e.pubid: StringC^host(pubid.data_ptr(), pubid.get_size())
        set e.value: value
        e
    }
}

define Interpreter
(
    host: pointer[Page]
    units_per_inch: int
    debug_mode: bool
    dsssl2: bool
    strict_mode: bool
    part_index: u32
    d_part_index: u32
    ; the permanent singletons (one per run; eqv? = identity)
    nil_obj: pointer[ELObj]
    true_obj: pointer[ELObj]
    false_obj: pointer[ELObj]
    error_obj: pointer[ELObj]
    unspecified_obj: pointer[ELObj]
    ; interning tables. The Array holds the objects in insertion order (the
    ; reference's NamedTable owns its entries the same way); the NameTable
    ; beside it is the hash index that answers a lookup — see the module
    ; header there for why the linear scan had to go.
    symbol_table: pointer[Array[pointer[ELObj]]]
    ident_table: pointer[Array[pointer[Identifier]]]
    symbol_index: pointer[NameTable]
    ident_index: pointer[NameTable]
    unit_table: pointer[Array[pointer[Unit]]]
    named_char_table: pointer[Array[pointer[CharPart]]]
    sdata_entity_name_table: pointer[Array[pointer[CharPart]]]
    sdata_entity_text_table: pointer[Array[pointer[CharPart]]]
    lex_category_table: pointer[XcharMap]
    ; Messenger seam (see header note): counts + prints; the driver owns
    ; the full location-prefixed rendering (Inc 7).
    error_count: int
    next_loc: Location
    ; processing modes (Style/Interpreter.cxx): the unnamed initial mode plus
    ; every named mode (mode NAME …). Rules register here; compile() finalises.
    initial_mode: pointer[ProcessingMode]
    processing_mode_table: pointer[Array[pointer[ProcessingMode]]]
    ; declare-default-language: the declaration expression (evaluated by
    ; compile(), like the reference compileDefaultLanguage) and the resulting
    ; language value char-upcase/downcase consult.
    default_language_def: pointer[Expression]
    default_language_part: int
    default_language_loc: Location
    default_language: pointer[ELObj]
    ; NumberCache — the reference DERIVES Interpreter from it
    ; (style/Interpreter.h:303), so `element-number` reaches it as a method on
    ; the interpreter. One per run; the grove-order vector it steps along hangs
    ; off the grove, not off this.
    number_cache: pointer[NumberCache]
    ; charProperties_ — the character-property table (installCharProperties +
    ; declare-char-property + add-char-properties).
    char_property_table: pointer[Array[pointer[CharProp]]]
    ; externalProcTable_ — public id -> FunctionObj (external-procedure).
    external_proc_table: pointer[Array[pointer[ExternalProc]]]
    ; the canned border styles (a single border-present? spec; table borders
    ; specified as booleans resolve to these).
    border_true_style_obj: pointer[ELObj]
    border_false_style_obj: pointer[ELObj]
    ; nextGlyphSubstTableUniqueId_ — the fot dump's gst<n> ids.
    next_gst_unique_id: int
    ; nInheritedC_ — the next fresh IC index (registry entries end at 164;
    ; declare-characteristic extensions allocate from here).
    next_ic_index: int
    ; the backend extension characteristic table selector: true under -t rtf
    ; (jade.cxx passes the RtfFOTBuilder extension table; fot/transform have
    ; none in this port — the IgnoredC fallback).
    rtf_extensions: bool
    tex_extensions: bool
    html_extensions: bool
    mif_extensions: bool
    ; declared initial values (declare-initial-value / declare-characteristic):
    ; parallel ident/expr arrays, compiled into initialStyle_ by compile().
    initial_value_names: pointer[Array[pointer[Identifier]]]
    initial_value_exprs: pointer[Array[pointer[Expression]]]
    current_part_first_initial_value: int
    initial_style_obj: pointer[ELObj]
    ; nodePropertyTable_ — the grove ComponentName metamodel (both the RCS and
    ; the SDQL spelling of all 107 component names).
    component_names: pointer[ComponentName]
    ; Pattern::MatchContext — the reference's Interpreter IS the match context,
    ; and these are its two vectors: the attribute names that carry a CLASS and
    ; an ID, filled by declare-class-attribute / declare-id-attribute (both
    ; dsssl2-only forms). The class qualifier can match NOTHING while the class
    ; list is empty; the id qualifier still has the grove's own ID attribute.
    class_attribute_names: pointer[Array[pointer[StringC]]]
    id_attribute_names: pointer[Array[pointer[StringC]]]
)
{
    function make(host: pointer[Page], units_per_inch: int, debug_mode: bool, dsssl2: bool, strict_mode: bool) returns pointer[Interpreter]
    {
        let interp host.allocate(sizeof Interpreter, alignof Interpreter) as pointer[Interpreter]
        set interp.host: host
        set perm_cell: host
        set interp.units_per_inch: units_per_inch
        set interp.debug_mode: debug_mode
        set interp.dsssl2: dsssl2
        set interp.strict_mode: strict_mode
        set interp.part_index: 0
        set interp.d_part_index: 1
        set interp.nil_obj: ELObj.make_nil(host)
        set interp.true_obj: ELObj.make_true(host)
        set interp.false_obj: ELObj.make_false(host)
        set interp.error_obj: ELObj.make_error(host)
        set interp.unspecified_obj: ELObj.make_unspecified(host)
        set interp.symbol_table: Array[pointer[ELObj]]^host()
        set interp.ident_table: Array[pointer[Identifier]]^host()
        ; sized for a stylesheet of the DocBook class (~5 000 identifiers,
        ; ~1 500 symbols) — the table grows on its own past that.
        set interp.symbol_index: NameTable.make(host, 2048)
        set interp.ident_index: NameTable.make(host, 8192)
        set interp.unit_table: Array[pointer[Unit]]^host()
        set interp.named_char_table: Array[pointer[CharPart]]^host()
        set interp.sdata_entity_name_table: Array[pointer[CharPart]]^host()
        set interp.sdata_entity_text_table: Array[pointer[CharPart]]^host()
        set interp.error_count: 0
        set interp.next_loc: Location()
        set interp.processing_mode_table: null
        set interp.default_language_def: null
        set interp.default_language_part: 0 - 1
        set interp.default_language_loc: Location()
        set interp.default_language: null
        set interp.number_cache: NumberCache.make(host)
        set interp.char_property_table: Array[pointer[CharProp]]^host()
        set interp.external_proc_table: Array[pointer[ExternalProc]]^host()
        set interp.border_true_style_obj: null
        set interp.border_false_style_obj: null
        set interp.next_gst_unique_id: 0
        set interp.next_ic_index: 0
        set interp.rtf_extensions: false
        set interp.tex_extensions: false
        set interp.html_extensions: false
        set interp.mif_extensions: false
        set interp.initial_value_names: Array[pointer[Identifier]]^host()
        set interp.initial_value_exprs: Array[pointer[Expression]]^host()
        set interp.current_part_first_initial_value: 0
        set interp.initial_style_obj: null
        set interp.initial_mode: ProcessingMode.make(host, StringC(), null)
        interp.initial_mode.set_defined()
        set interp.class_attribute_names: Array[pointer[StringC]]^host()
        set interp.id_attribute_names: Array[pointer[StringC]]^host()

        ; installNodeProperties — the grove component-name table (both name
        ; spellings), the oracle behind node-property and select-by-class.
        set interp.component_names: ComponentName.make(host)

        interp.install_units()
        interp.install_syntactic_keys()
        interp.install_c_value_symbols()
        ; flow objects BEFORE the inherited Cs (reference order — fraction-
        ; bar's initial value is the rule class binding).
        interp.install_flow_objs()
        interp.install_inherited_cs()
        interp.install_primitives()
        if strict_mode = false
        {
            CharNames.install(interp)
            Sdata.install(interp)
        }
        ; installCharProperties runs unconditionally — every built-in
        ; property EXISTS under -s, only its table stays empty.
        CharProps.install(interp, strict_mode)

        ; the lexical-category table (constructor tail, Interpreter.cxx:107)
        let lex XcharMap.make(host, LEX_OTHER as u8)
        set interp.lex_category_table: lex
        lex.set_ee(LEX_DELIMITER as u8)
        Interpreter.set_lex_ascii(lex, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz", LEX_LETTER as u8)
        Interpreter.set_lex_ascii(lex, "!$%&*/<=>?~_^:", LEX_OTHER_NAME_START as u8)
        Interpreter.set_lex_ascii(lex, "0123456789", LEX_DIGIT as u8)
        Interpreter.set_lex_ascii(lex, "-+.", LEX_OTHER_NUMBER_START as u8)
        Interpreter.set_lex_ascii(lex, "();\"", LEX_DELIMITER as u8)
        Interpreter.set_lex_ascii(lex, " \t\r\n", LEX_WHITESPACE as u8)
        lex.set_char(0x0C, LEX_WHITESPACE as u8)  ; \f
        ; #',@[\]`{|} stay lexOther: not allowed in names. Chars >= 127 are
        ; name-start in the non-strict repertoire (XcharMap's dense range
        ; covers the BMP; higher planes clamp to the default — the XcharMap
        ; port's documented scope).
        if strict_mode = false
            lex.set_range(127, 0xFFFF, LEX_ADD_NAME_START as u8)

        interp
    }

    function set_lex_ascii(lex: pointer[XcharMap], s: pointer[const_char], cat: u8)
    {
        var p s as pointer[u8]
        while (*p) <> 0
        {
            lex.set_char((*p) as u32, cat)
            set p: p + 1
        }
    }

    ; LexCategory lexCategory(Xchar c)
    function lex_category(this: Interpreter, c: i32) returns int
        lex_category_table.get(c) as int

    ; the allocation page (Collector seam) — cross-module allocation sites
    ; reach it through this accessor: the eval scratch region while a
    ; construction rule evaluates, the run arena page otherwise.
    function get_host(this: Interpreter) returns pointer[Page]
    {
        if eval_region <> null
            return eval_region
        host
    }

    ; the run arena page unconditionally — for allocations that must outlive
    ; the eval bracket (interning, forced Identifier values).
    function get_perm_host(this: Interpreter) returns pointer[Page]
        host

    ; --- the LAZY MEMO host (DZ_MEMO_PERM) ----------------------------------
    ;
    ; ★★★Where a lazy MEMOISATION puts its storage: the array a node-list view
    ; fills on demand, the flattened buffer of a string rope. Until now that was
    ; `Page.get(the object)` — the END of the object's own region — with the
    ; documented reason that the memo must live exactly as long as the object,
    ; and a caller's host can be shorter-lived. Right against BRACKET
    ; granularity, and the class that shaped both the frame mark's store sweep
    ; and the escape audit: within ONE region the region's end is above every
    ; live frame mark, so the memo of an outer frame's object is younger than the
    ; object. Two consequences, both measured: memoisation PUBLISHES under the
    ; mark (10.5 M frames blocked), and every node-list and string-rope primitive
    ; has to stay conservative in the escape analysis (its 8.8x gate).
    ;
    ; This makes the choice a seam instead of an idiom: on the RUN arena the memo
    ; is older than every frame and every bracket, so neither problem can arise —
    ; at the price of memo storage that outlives the bracket it was filled in.
    ; The elements stored are grove nodes (permanent) or the rope's own flattened
    ; buffer, so nothing here can create a pointer from the run arena into a
    ; shorter-lived region.
    ;
    ; ★★★It FOLLOWS THE MARK (see memo_setup), because the two only make sense
    ; together. With the mark it is a large win, because memoisation stops
    ; PUBLISHING: 18.9 M publications become 1.4 M, 4.1 M more frames are
    ; rewound, 10.03 -> 17.22 GB reclaimed, peak footprint 3911 -> 3463 MB
    ; (-11.5 %). Without the mark the same change is pure retention and costs
    ; +18 % peak (5966 -> 7047 MB), so alone it is never right.
    ;
    ; ★★★And the reason this stood OFF for a day is the most valuable thing the
    ; seam produced: with the mark it made 3 of the 48 real-world codegens write
    ; garbage. It was not this placement — mark + memo on the object's region was
    ; identical, and memo on the run arena WITHOUT the mark was identical too. It
    ; was the extra REWINDS: removing 17.5 M publications took away a blanket
    ; protection nobody had meant as one, and exposed a hole in the mark's rule.
    ; The hole is condition 6 (BACKFILL) in `FrameMark.scaly`, and it was not a
    ; missing store hook at all — `Page.allocate` serves from the page it is
    ; CALLED ON, so the region head kept handing out small objects BELOW every
    ; live mark. With that condition in place this configuration is 48/48
    ; byte-identical, which is why the seam is armed.
    ;
    ; `DZ_MEMO_PERM=0|1` still forces either side, and `DZ_MEMO_SITES=n|r`
    ; narrows to the node-list or the string-rope family — that is how the two
    ; halves get bisected against each other if this class ever recurs.
    function memo_host(own: pointer[Page]) returns pointer[Page]
    {
        if memo_perm = 0
            Interpreter.memo_setup()
        if memo_perm = 1
        {
            if memo_sites_nl
            {
                if perm_cell <> null
                    return perm_cell
            }
        }
        own
    }

    ; the string rope's flattened buffer — same seam, separate switch so a
    ; difference can be attributed to ONE of the two families
    function memo_host_rope(own: pointer[Page]) returns pointer[Page]
    {
        if memo_perm = 0
            Interpreter.memo_setup()
        if memo_perm = 1
        {
            if memo_sites_rope
            {
                if perm_cell <> null
                    return perm_cell
            }
        }
        own
    }

    ; A memo that lives on the run arena needs no publication hook: the store
    ; puts an OLDER pointer into a younger object, which no frame mark has to
    ; hear about. Call sites whose target is the memoised object itself (the
    ; rope) ask this before hooking.
    function memo_is_perm() returns bool
    {
        if memo_perm = 0
            Interpreter.memo_setup()
        if memo_perm <> 1
            return false
        if memo_sites_rope = false
            return false
        perm_cell <> null
    }

    procedure memo_setup()
    {
        ; The seam FOLLOWS THE MARK. On its own the run-arena host is pure
        ; retention (+18 % peak, measured); together with the mark it is a large
        ; win, because memoisation stops publishing. So the default is exactly
        ; the mark's state, and DZ_MEMO_PERM overrides it in either direction
        ; (0 = the object's own region, anything else = the run arena) so the two
        ; halves can still be bisected against each other.
        if FrameMark.on()
            set memo_perm: 1
        else
            set memo_perm: 2
        let e getenv("DZ_MEMO_PERM")
        if e = null
            return
        if (*e as u32) = 0
            return
        let zero "0" as char
        if (*e as u32) = (zero as u32)
        {
            set memo_perm: 2
            return
        }
        set memo_perm: 1
        let w getenv("DZ_MEMO_SITES")
        if w <> null
        {
            let n "n" as char
            let r "r" as char
            var have_n false
            var have_r false
            var q w as pointer[u8]
            while (*q) <> 0
            {
                if (*q as u32) = (n as u32)
                    set have_n: true
                if (*q as u32) = (r as u32)
                    set have_r: true
                set q: q + 1
            }
            set memo_sites_nl: have_n
            set memo_sites_rope: have_r
        }
    }

    ; the run arena as a static — FrameMark's referrer scan needs it and has no
    ; Interpreter in hand
    function perm_page() returns pointer[Page]
        perm_cell

    function get_eval_region(this: Interpreter) returns pointer[Page]
        eval_region

    procedure set_eval_region(this: pointer[Interpreter], p: pointer[Page])
    {
        ; the region under every live frame mark changes with the bracket
        FrameMark.region(p)
        set eval_region: p
    }

    function is_dsssl2(this: Interpreter) returns bool
        dsssl2

    ; Interpreter::addClassAttributeName / addIdAttributeName (Interpreter.h:742)
    ; — the MatchContext vectors the class and id pattern qualifiers read. The
    ; name is stored as declared; matchAttribute normalizes on the way in.
    procedure add_class_attribute_name(this: pointer[Interpreter], name: pointer[StringC])
        this.class_attribute_names.add(name)

    procedure add_id_attribute_name(this: pointer[Interpreter], name: pointer[StringC])
        this.id_attribute_names.add(name)

    function get_class_attribute_names(this: Interpreter) returns pointer[Array[pointer[StringC]]]
        class_attribute_names

    function get_id_attribute_names(this: Interpreter) returns pointer[Array[pointer[StringC]]]
        id_attribute_names

    ; ★The grove ID index, the governing DTD and the fold table used to live
    ; here as interpreter state — right only while exactly one grove could
    ; exist. They are GroveInfo fields now, one record per grove, and every
    ; consumer reaches its own through Node::getGroveRoot (dazzle/Grove.scaly).

    function get_units_per_inch(this: Interpreter) returns int
        units_per_inch

    ; --- singletons --------------------------------------------------------
    function make_nil(this: Interpreter) returns pointer[ELObj]
        nil_obj

    function make_true(this: Interpreter) returns pointer[ELObj]
        true_obj

    function make_false(this: Interpreter) returns pointer[ELObj]
        false_obj

    ; #t / #f from a Scaly bool (Primitive predicate results).
    function make_bool(this: Interpreter, b: bool) returns pointer[ELObj]
    {
        if b
            return true_obj
        false_obj
    }

    function make_error(this: Interpreter) returns pointer[ELObj]
        error_obj

    function make_unspecified(this: Interpreter) returns pointer[ELObj]
        unspecified_obj

    function is_error(this: Interpreter, obj: pointer[ELObj]) returns bool
        obj = error_obj

    ; endPart(): the next specification part (later parts' defines lose to
    ; earlier ones — doDefine's defPart gate).
    function end_part(this: pointer[Interpreter])
    {
        set this.part_index: this.part_index + 1
        ; endPart: the duplicate-initial-value window closes with the part.
        set this.current_part_first_initial_value: this.initial_value_names.get_length() as int
    }

    ; installBuiltins brackets the builtins parse with part index -1 (so any
    ; user define overrides a builtin), then endPart wraps back to 0.
    function set_part_index(this: pointer[Interpreter], n: u32)
        set this.part_index: n

    ; --- processing modes --------------------------------------------------
    function current_part_index(this: Interpreter) returns u32
        part_index

    function initial_processing_mode(this: Interpreter) returns pointer[ProcessingMode]
        initial_mode

    ; the same cell for modules that do not import ProcessingMode (Insn) —
    ; a mode travels through the VM as an opaque pointer anyway.
    function initial_processing_mode_ptr(this: Interpreter) returns pointer[void]
        initial_mode as pointer[void]

    ; lookupProcessingMode(name): the named mode, created (with the initial mode
    ; as fall-through parent) on first reference.
    function lookup_processing_mode(this: pointer[Interpreter], str: StringC) returns pointer[ProcessingMode]
    {
        ; the table is allocated lazily — a stylesheet with no named modes (the
        ; common case) never grabs its exclusive page.
        if this.processing_mode_table = null
        {
            let hp this.host
            set this.processing_mode_table: Array[pointer[ProcessingMode]]^hp()
        }
        let tbl this.processing_mode_table
        let n tbl.get_length()
        let buf tbl.get_buffer()
        var i: size_t 0
        while i < n
        {
            let m *(buf + i)
            if m.get_name().equals(str)
                return m
            set i: i + 1
        }
        let m ProcessingMode.make(this.host, str, this.initial_mode)
        tbl.add(m)
        m
    }

    ; WithModeExpression::compile's defined() gate — the Expression module
    ; carries the mode as pointer[void] (importing ProcessingMode there would
    ; cycle), so the check + undefinedMode message live on this seam.
    function check_mode_defined(this: pointer[Interpreter], mode: pointer[void], loc: Location)
    {
        let m mode as pointer[ProcessingMode]
        if m = null
            return
        if m.defined()
            return
        this.set_next_location(loc)
        this.message1(InterpreterMessages.undefinedMode(), m.get_name())
    }

    ; compile(): finalise every mode's rules (Interpreter::compile). Top-level
    ; definitions used by rule bodies compute lazily via TopRefInsn at eval.
    ; The sorted element-rule scan order is built HERE (not lazily on the
    ; first find_match): during processing get_host() is the eval scratch
    ; region, and a lazily-built sorted array would dangle after the bracket.
    function compile(this: pointer[Interpreter])
    {
        ; reference order: compileInitialValues runs FIRST (Interpreter::
        ; compile), before the modes.
        this.compile_initial_values()
        this.compile_default_language()
        this.initial_mode.compile(this)
        this.initial_mode.build_sorted(this.host)
        if this.processing_mode_table = null
            return
        let tbl this.processing_mode_table
        var i: size_t 0
        while i < tbl.get_length()
        {
            let m *(tbl.get_buffer() + i)
            m.compile(this)
            m.build_sorted(this.host)
            set i: i + 1
        }
    }

    ; --- declare-default-language (Interpreter::compileDefaultLanguage) -----
    ; --- character properties (Interpreter.cxx:2064-2380) -------------------

    function lookup_char_property(this: pointer[Interpreter], nm: StringC) returns pointer[CharProp]
    {
        let t this.char_property_table
        let n t.get_length()
        var i: size_t 0
        while i < n
        {
            let pp t.get(i)
            if pp <> null
            {
                let p *pp
                if p.name.equals(nm)
                    return p
            }
            set i: i + 1
        }
        null
    }

    ; the installCharProperties helper: a fresh property with `def` as its
    ; default and defPart -1 (predefined).
    ;
    ; ★The name is widened onto the HOST page, not built with `StringC(nm)`:
    ; that init allocates its buffer through `Page.get(this)`, and for a
    ; temporary the compiler may place on the stack the resulting `data`
    ; pointer is garbage. The name then compares unequal to everything and
    ; every property reads back as unknown — measured, and invisible until
    ; the first lookup.
    function new_char_property(this: pointer[Interpreter], nm: pointer[const_char], def: pointer[ELObj]) returns pointer[CharProp]
    {
        let host this.host
        let p CharProp.make(host, Interpreter.ascii_string_c(host, nm), def, 0xFFFFFFFF)
        this.char_property_table.add(p)
        p
    }

    ; widen an ASCII literal onto `host` — the safe replacement for a bound
    ; or passed `StringC(<cstring>)` (see new_char_property).
    function ascii_string_c(host: pointer[Page], s: pointer[const_char]) returns StringC
    {
        let b s as pointer[u8]
        let buf Array[u32]^host()
        var i: size_t 0
        while (*(b + i)) <> 0
        {
            buf.add((*(b + i)) as u32)
            set i: i + 1
        }
        StringC^host(buf.get_buffer(), buf.get_length())
    }

    ; Interpreter::charProperty — the `char-property` primitive's engine.
    ; An unknown NAME is a hard diagnostic; a character with no value of its
    ; own falls back to the caller's default argument if there is one, else
    ; to the property's own default.
    function char_property(this: pointer[Interpreter], prop: StringC, c: u32, loc: Location, def: pointer[ELObj]) returns pointer[ELObj]
    {
        let cp this.lookup_char_property(prop)
        if cp = null
        {
            this.set_next_location(loc)
            this.message1(InterpreterMessages.unknownCharProperty(), prop)
            return this.make_error()
        }
        let p *cp
        let v p.lookup(c)
        if v <> null
            return v
        if def <> null
            return def
        p.def
    }

    ; Interpreter::addCharProperty — declare-char-property. The default must
    ; be a CONSTANT (a variable expression is varCharPropertyExprUnsupported);
    ; re-declaring in the SAME spec part with a different value is
    ; duplicateCharPropertyDecl, while an EARLIER part simply wins.
    procedure add_char_property(this: pointer[Interpreter], ident: pointer[Identifier], val: pointer[ELObj], loc: Location)
    {
        if val = null
        {
            this.set_next_location(loc)
            this.message0(InterpreterMessages.varCharPropertyExprUnsupported())
            return
        }
        let nm ident.get_name()
        let cp this.lookup_char_property(nm)
        if cp = null
        {
            let host this.host
            let p CharProp.make(host, nm, val, this.part_index)
            set p.loc: loc
            this.char_property_table.add(p)
            return
        }
        let p *cp
        if this.part_index < p.def_part
        {
            set p.def: val
            set p.def_part: this.part_index
            set p.loc: loc
            return
        }
        if this.part_index = p.def_part
        {
            if ELObj.eqv(val, p.def) = false
            {
                this.set_next_location(loc)
                this.message1(InterpreterMessages.duplicateCharPropertyDecl(), nm)
                this.emit_aux(InterpreterMessages.duplicateCharPropertyDecl_aux(), p.loc)
            }
        }
    }

    ; Interpreter::setCharProperty — one (property, character) cell from
    ; add-char-properties. An unknown property name is the same diagnostic
    ; the primitive gives.
    procedure set_char_property(this: pointer[Interpreter], ident: pointer[Identifier], c: u32, val: pointer[ELObj], loc: Location)
    {
        let nm ident.get_name()
        let cp this.lookup_char_property(nm)
        if cp = null
        {
            this.set_next_location(loc)
            this.message1(InterpreterMessages.unknownCharProperty(), nm)
            return
        }
        if val = null
        {
            this.set_next_location(loc)
            this.message0(InterpreterMessages.varCharPropertyExprUnsupported())
            return
        }
        let p *cp
        ; Interpreter::addCharProperty's part arbitration (Interpreter.cxx:2347).
        ; A character that already has a value of its own is overwritten only by
        ; an EARLIER part; the same part sets it twice differently is a
        ; duplicate diagnostic; a LATER part is ignored in silence.
        let part this.current_part_index()
        let def_part p.lookup_part(c)
        let def p.lookup(c)
        if def <> null
        {
            if part < def_part
            {
                p.set_range(c, c, val, part)
                return
            }
            if part = def_part
            {
                if ELObj.eqv(val, def) = false
                {
                    this.set_next_location(loc)
                    ; the character itself is the second argument — a one-char
                    ; StringC, built on the run page (never a stack temporary:
                    ; StringC's copying init allocates through Page.get(this)).
                    let hp this.host
                    var ch c
                    let cs StringC^hp(&ch, 1)
                    this.message2(InterpreterMessages.duplicateAddCharProperty(), nm, *cs)
                }
                return
            }
            return
        }
        p.set_range(c, c, val, part)
    }

    ; ★the PART matters: the reference keeps the FIRST declaration seen in
    ; this part or an earlier one and refuses to overwrite it
    ; (SchemeParser.cxx:2101), so the part index is state, not a formality.
    function set_default_language_def(this: pointer[Interpreter], expr: pointer[Expression], part: int, loc: Location)
    {
        set this.default_language_def: expr
        set this.default_language_part: part
        set this.default_language_loc: loc
    }

    function default_language_is_set(this: Interpreter) returns bool
        default_language_def <> null

    function get_default_language_part(this: Interpreter) returns int
        default_language_part

    function get_default_language_loc(this: Interpreter) returns Location
        default_language_loc

    function get_default_language(this: Interpreter) returns pointer[ELObj]
        default_language

    function compile_default_language(this: pointer[Interpreter])
    {
        if this.default_language_def = null
            return
        let host this.host
        let env Environment.make(host)
        let insn Expression.optimize_compile(this.default_language_def, this, env, 0, null)
        let vm VM.make(host, this)
        let obj vm.eval(insn, null, null)
        if obj = null
            return
        if obj.is_language_p() = false
        {
            if this.is_error(obj) = false
            {
                let os OutputCharStream.make(host)
                obj.print(os, this.units_per_inch)
                let printed os.to_string_c(host)
                this.set_next_location(this.default_language_loc)
                this.message1(InterpreterMessages.defLangDeclRequiresLanguage(), printed)
            }
            return
        }
        set this.default_language: obj
    }

    ; --- interning ---------------------------------------------------------
    ; Identifier *lookup(const StringC &): one Identifier per name.
    function lookup(this: pointer[Interpreter], str: StringC) returns pointer[Identifier]
    {
        let hit this.ident_index.lookup(str)
        if hit <> null
            return hit as pointer[Identifier]
        let ident Identifier.make(this.host, str)
        this.ident_table.add(ident)
        ; the key is the Identifier's OWN name — a StringC over the arena copy
        ; Identifier.make just took, not the caller's (possibly stack-built)
        ; argument.
        let key ident.get_name()
        this.ident_index.insert(this.host, key, ident as pointer[void])
        ident
    }

    ; SymbolObj *makeSymbol(const StringC &): one SymbolObj per name.
    function make_symbol(this: pointer[Interpreter], str: StringC) returns pointer[ELObj]
    {
        let hit this.symbol_index.lookup(str)
        if hit <> null
            return hit as pointer[ELObj]
        let host this.host
        let name StringC^host(str.data_ptr(), str.get_size())
        let sym ELObj.make_symbol(host, name)
        this.symbol_table.add(sym)
        let key sym.symbol_name()
        this.symbol_index.insert(host, key, sym as pointer[void])
        sym
    }

    ; --- NumberCache seam --------------------------------------------------
    ; The reference DERIVES Interpreter from NumberCache (style/Interpreter.h:303),
    ; so the numbering primitives call `interp.elementNumber(node, gi)`. Same
    ; seam here, one cache per run.
    function element_number(this: pointer[Interpreter], node: pointer[GroveNode], gi: StringC) returns int
        this.number_cache.element_number(this.host, node, gi)

    function element_number_after(this: pointer[Interpreter], node: pointer[GroveNode], gi: StringC, reset_gi: StringC) returns int
        this.number_cache.element_number_after(this.host, node, gi, reset_gi)

    function child_number(this: pointer[Interpreter], node: pointer[GroveNode], gi: StringC) returns int
        this.number_cache.child_number(this.host, node, gi)

    ; KeywordObj *makeKeyword(const StringC &): a fresh KeywordObj whose
    ; identity is the interned Identifier.
    function make_keyword(this: pointer[Interpreter], str: StringC) returns pointer[ELObj]
    {
        let ident this.lookup(str)
        ELObj.make_keyword(this.host, ident)
    }

    ; --- grove component names ---------------------------------------------
    ; bool lookupNodeProperty(const StringC &, ComponentName::Id &) — either
    ; spelling, case-insensitively; CN_NO_ID when the name is not a component.
    function lookup_node_property(this: pointer[Interpreter], name: StringC) returns int
        this.component_names.lookup(name)

    ; the name a component-name VALUE renders as (ELObjPropertyValue::set —
    ; rcs? picks the short RCS name, otherwise the SDQL name).
    function component_name(this: pointer[Interpreter], id: int, want_rcs: bool) returns StringC
        this.component_names.name_of(id, want_rcs)

    ; --- units -------------------------------------------------------------
    ; Unit *lookupUnit(const StringC &): create on demand.
    function lookup_unit(this: pointer[Interpreter], name: StringC) returns pointer[Unit]
    {
        let n this.unit_table.get_length()
        let buf this.unit_table.get_buffer()
        var i: size_t 0
        while i < n
        {
            let p *(buf + i)
            if p.get_name().equals(name)
                return p
            set i: i + 1
        }
        let u Unit.make(this.host, name)
        this.unit_table.add(u)
        u
    }

    ; void installUnits(): builtin units valued from unitsPerInch; "pc" is
    ; the DSSSL2 addition.
    function install_units(this: pointer[Interpreter])
    {
        this.install_unit("m", 5000, 127)
        this.install_unit("cm", 50, 127)
        this.install_unit("mm", 5, 127)
        this.install_unit("in", 1, 1)
        this.install_unit("pt", 1, 72)
        this.install_unit("pica", 1, 6)
        if this.dsssl2
            this.install_unit("pc", 1, 6)
    }

    function install_unit(this: pointer[Interpreter], name: pointer[const_char], numer: int, denom: int)
    {
        let u this.lookup_unit(StringC(name))
        let n this.units_per_inch * numer
        if n % denom = 0
            u.set_value_long(n / denom)
        else
            u.set_value_double((n as double) / (denom as double))
    }

    ; --- syntactic keys ----------------------------------------------------
    function install_syntactic_key(this: pointer[Interpreter], name: pointer[const_char], key: int)
    {
        let ident this.lookup(StringC(name))
        ident.set_syntactic_key(key)
        ; ★installSyntacticKeys' dsssl2 alias (Interpreter.cxx:388): a key
        ; whose name ends in `?` is ALSO bound without the `?` under -2, so
        ; `keep-with-previous:` is a valid make keyword there and an error
        ; without the flag. Measured against the reference binary.
        ; ★the name is scanned as RAW BYTES, not bound as a StringC: that
        ; init allocates through `Page.get(this)`, which is a bogus page for
        ; a stack-bound value (see CharProps.script_value).
        if this.dsssl2
        {
            let b name as pointer[u8]
            var n: size_t 0
            while (*(b + n)) <> 0
                set n: n + 1
            if n > 0
            {
                if (*(b + (n - 1))) = 0x3F
                {
                    let host this.host
                    let sbuf Array[u32]^host()
                    var i: size_t 0
                    while i < (n - 1)
                    {
                        sbuf.add((*(b + i)) as u32)
                        set i: i + 1
                    }
                    let id2 this.lookup(StringC^host(sbuf.get_buffer(), sbuf.get_length()))
                    id2.set_syntactic_key(key)
                }
            }
        }
    }

    ; the `keys2[]` table (Interpreter.cxx:377) — installed ONLY under -2.
    ; Without the flag `begin` and `set!` are undefined variables and
    ; `or-element` an unknown top-level form; all three measured.
    function install_syntactic_key2(this: pointer[Interpreter], name: pointer[const_char], key: int)
    {
        if this.dsssl2
            this.install_syntactic_key(name, key)
    }

    ; installSyntacticKey batch (Interpreter ctor). Inc-3 subset: the eval-core
    ; forms; the style/grove top-level keys (element/root/mode/declare-*) join
    ; with those increments, though the tags are reserved here.
    function install_syntactic_keys(this: pointer[Interpreter])
    {
        this.install_syntactic_key("define", SK_DEFINE)
        this.install_syntactic_key("define-unit", SK_DEFINE_UNIT)
        this.install_syntactic_key("quote", SK_QUOTE)
        this.install_syntactic_key("quasiquote", SK_QUASIQUOTE)
        this.install_syntactic_key("unquote", SK_UNQUOTE)
        this.install_syntactic_key("unquote-splicing", SK_UNQUOTE_SPLICING)
        this.install_syntactic_key("if", SK_IF)
        this.install_syntactic_key("cond", SK_COND)
        this.install_syntactic_key("case", SK_CASE)
        this.install_syntactic_key("and", SK_AND)
        this.install_syntactic_key("or", SK_OR)
        this.install_syntactic_key("let", SK_LET)
        this.install_syntactic_key("let*", SK_LET_STAR)
        this.install_syntactic_key("letrec", SK_LETREC)
        this.install_syntactic_key("lambda", SK_LAMBDA)
        this.install_syntactic_key2("begin", SK_BEGIN)
        this.install_syntactic_key2("set!", SK_SET)
        ; the DSSSL QUERY LANGUAGE forms. keys[], so UNCONDITIONAL — what -2
        ; adds is only the `?`-less alias above, which makes `there-exists`
        ; and `for-all` the same keys. They are pure syntax over four
        ; builtins.dsl procedures; see SchemeParser.parse_special_query.
        this.install_syntactic_key("there-exists?", SK_THERE_EXISTS)
        this.install_syntactic_key("for-all?", SK_FOR_ALL)
        this.install_syntactic_key("select-each", SK_SELECT_EACH)
        this.install_syntactic_key("union-for-each", SK_UNION_FOR_EACH)
        ; `query` is in the reference's keys[] as well, but keyQuery sits
        ; above lastSyntacticKey (so it is no expression key) and no
        ; top-level form dispatches it — installing it is measurably
        ; indistinguishable from leaving it out. Here for table fidelity.
        this.install_syntactic_key("query", SK_QUERY)
        this.install_syntactic_key("else", SK_ELSE)
        this.install_syntactic_key("=>", SK_ARROW)
        ; construction/style rule top-level forms (Inc 5)
        this.install_syntactic_key("element", SK_ELEMENT)
        this.install_syntactic_key2("or-element", SK_OR_ELEMENT)
        ; keys with a deliberately SILENT top-level skip in the reference
        this.install_syntactic_key("declare-reference-value-type", SK_DECLARE_REFERENCE_VALUE_TYPE)
        this.install_syntactic_key("define-page-model", SK_DEFINE_PAGE_MODEL)
        this.install_syntactic_key("define-column-set-model", SK_DEFINE_COLUMN_SET_MODEL)
        this.install_syntactic_key("declare-char-property", SK_DECLARE_CHAR_PROPERTY)
        this.install_syntactic_key("add-char-properties", SK_ADD_CHAR_PROPERTIES)
        this.install_syntactic_key("declare-char-characteristic+property", SK_DECLARE_CHAR_CHARACTERISTIC_AND_PROPERTY)
        ; the five built-in char-property names the reference also keys. They
        ; are above lastSyntacticKey, hence inert until the `character` flow
        ; object arrives with CharacterFlowObj::hasNonInheritedC — pinned as
        ; inert by the ccp1 fixture, which still uses `space?` as an ordinary
        ; procedure name.
        this.install_syntactic_key("space?", SK_IS_SPACE)
        this.install_syntactic_key("record-end?", SK_IS_RECORD_END)
        this.install_syntactic_key("input-tab?", SK_IS_INPUT_TAB)
        this.install_syntactic_key("input-whitespace?", SK_IS_INPUT_WHITESPACE)
        this.install_syntactic_key("punct?", SK_IS_PUNCT)
        ; the PATTERN QUALIFIER keys — the keyword half of convertToPattern is
        ; itself dsssl2-only, but the KEYS are installed unconditionally, so a
        ; qualifier keyword without `-2` is `cannot occur in a pattern` and
        ; never `unknown pattern qualifier`.
        this.install_syntactic_key("attributes", SK_ATTRIBUTES)
        this.install_syntactic_key("children", SK_CHILDREN)
        this.install_syntactic_key("repeat", SK_REPEAT)
        this.install_syntactic_key("position", SK_POSITION)
        this.install_syntactic_key("only", SK_ONLY)
        this.install_syntactic_key("class", SK_CLASS)
        this.install_syntactic_key("importance", SK_IMPORTANCE)
        ; sgml-parse's keyword arguments (a loud stub here; keys all the same).
        ; `architecture` is the third, and belongs to the OpenJade EXTENSION
        ; sgml-parse alone (XXPRIMITIVE XSgmlParse) — the ISO one takes only
        ; active:/parent:.
        this.install_syntactic_key("parent", SK_PARENT)
        this.install_syntactic_key("active", SK_ACTIVE)
        this.install_syntactic_key("architecture", SK_ARCHITECTURE)
        ; keys2[] — the class/id attribute declarations and the flow-object
        ; macro, dsssl2-only
        this.install_syntactic_key2("declare-class-attribute", SK_DECLARE_CLASS_ATTRIBUTE)
        this.install_syntactic_key2("declare-id-attribute", SK_DECLARE_ID_ATTRIBUTE)
        this.install_syntactic_key2("declare-flow-object-macro", SK_DECLARE_FLOW_OBJECT_MACRO)
        this.install_syntactic_key("default", SK_DEFAULT)
        this.install_syntactic_key("root", SK_ROOT)
        this.install_syntactic_key("id", SK_ID)
        this.install_syntactic_key("mode", SK_MODE)
        this.install_syntactic_key("with-mode", SK_WITH_MODE)
        this.install_syntactic_key("make", SK_MAKE)
        this.install_syntactic_key("style", SK_STYLE)
        this.install_syntactic_key("use", SK_KEY_USE)
        this.install_syntactic_key("label", SK_KEY_LABEL)
        this.install_syntactic_key("content-map", SK_KEY_CONTENT_MAP)
        this.install_syntactic_key("declare-initial-value", SK_DECLARE_INITIAL_VALUE)
        this.install_syntactic_key("declare-characteristic", SK_DECLARE_CHARACTERISTIC)
        this.install_syntactic_key("declare-flow-object-class", SK_DECLARE_FLOW_OBJECT_CLASS)
        this.install_syntactic_key("define-language", SK_DEFINE_LANGUAGE)
        this.install_syntactic_key("declare-default-language", SK_DECLARE_DEFAULT_LANGUAGE)
        ; the clause keywords of define-language. `element` and `position` are
        ; keys already (they double as a top-level form and a NIC name) — the
        ; collate clause reuses them, which is why the whole form dispatches
        ; on keys and never on spelling.
        this.install_syntactic_key("collate", SK_COLLATE)
        this.install_syntactic_key("toupper", SK_TOUPPER)
        this.install_syntactic_key("tolower", SK_TOLOWER)
        this.install_syntactic_key("symbol", SK_SYMBOL)
        this.install_syntactic_key("order", SK_ORDER)
        this.install_syntactic_key("forward", SK_FORWARD)
        this.install_syntactic_key("backward", SK_BACKWARD)
        ; display/inline NIC keywords (FlowObj::isDisplayNIC family, Inc 8)
        this.install_syntactic_key("position-preference", SK_POSITION_PREFERENCE)
        this.install_syntactic_key("keep-with-previous?", SK_KEEP_WITH_PREVIOUS)
        this.install_syntactic_key("keep-with-next?", SK_KEEP_WITH_NEXT)
        this.install_syntactic_key("keep", SK_KEEP)
        this.install_syntactic_key("break-before", SK_BREAK_BEFORE)
        this.install_syntactic_key("break-after", SK_BREAK_AFTER)
        this.install_syntactic_key("may-violate-keep-before?", SK_MAY_VIOLATE_KEEP_BEFORE)
        this.install_syntactic_key("may-violate-keep-after?", SK_MAY_VIOLATE_KEEP_AFTER)
        this.install_syntactic_key("space-before", SK_SPACE_BEFORE)
        this.install_syntactic_key("space-after", SK_SPACE_AFTER)
        this.install_syntactic_key("coalesce-id", SK_COALESCE_ID)
        this.install_syntactic_key("break-before-priority", SK_BREAK_BEFORE_PRIORITY)
        this.install_syntactic_key("break-after-priority", SK_BREAK_AFTER_PRIORITY)
        ; simple-page-sequence header/footer sosofo NICs
        this.install_syntactic_key("left-header", SK_LEFT_HEADER)
        this.install_syntactic_key("center-header", SK_CENTER_HEADER)
        this.install_syntactic_key("right-header", SK_RIGHT_HEADER)
        this.install_syntactic_key("left-footer", SK_LEFT_FOOTER)
        this.install_syntactic_key("center-footer", SK_CENTER_FOOTER)
        this.install_syntactic_key("right-footer", SK_RIGHT_FOOTER)
        ; table-family NIC keywords
        this.install_syntactic_key("before-row-border", SK_BEFORE_ROW_BORDER)
        this.install_syntactic_key("after-row-border", SK_AFTER_ROW_BORDER)
        this.install_syntactic_key("before-column-border", SK_BEFORE_COLUMN_BORDER)
        this.install_syntactic_key("after-column-border", SK_AFTER_COLUMN_BORDER)
        this.install_syntactic_key("table-width", SK_TABLE_WIDTH)
        this.install_syntactic_key("column-number", SK_COLUMN_NUMBER)
        this.install_syntactic_key("n-columns-spanned", SK_N_COLUMNS_SPANNED)
        this.install_syntactic_key("n-rows-spanned", SK_N_ROWS_SPANNED)
        this.install_syntactic_key("width", SK_WIDTH)
        this.install_syntactic_key("starts-row?", SK_IS_STARTS_ROW)
        this.install_syntactic_key("ends-row?", SK_IS_ENDS_ROW)
        ; display-space / inline-space keyword args
        this.install_syntactic_key("min", SK_MIN)
        this.install_syntactic_key("max", SK_MAX)
        this.install_syntactic_key("conditional?", SK_IS_CONDITIONAL)
        this.install_syntactic_key("priority", SK_PRIORITY)
        ; CIE color-space keyword args
        this.install_syntactic_key("white-point", SK_WHITE_POINT)
        this.install_syntactic_key("black-point", SK_BLACK_POINT)
        this.install_syntactic_key("range", SK_RANGE)
        this.install_syntactic_key("range-abc", SK_RANGE_ABC)
        this.install_syntactic_key("range-lmn", SK_RANGE_LMN)
        this.install_syntactic_key("range-a", SK_RANGE_A)
        this.install_syntactic_key("decode-abc", SK_DECODE_ABC)
        this.install_syntactic_key("decode-lmn", SK_DECODE_LMN)
        this.install_syntactic_key("decode-a", SK_DECODE_A)
        this.install_syntactic_key("matrix-abc", SK_MATRIX_ABC)
        this.install_syntactic_key("matrix-lmn", SK_MATRIX_LMN)
        this.install_syntactic_key("matrix-a", SK_MATRIX_A)
        ; rule NIC keywords
        this.install_syntactic_key("orientation", SK_ORIENTATION)
        this.install_syntactic_key("length", SK_LENGTH)
        this.install_syntactic_key("destination", SK_DESTINATION)
        this.install_syntactic_key("display?", SK_IS_DISPLAY)
        this.install_syntactic_key("scale", SK_SCALE)
        this.install_syntactic_key("max-width", SK_MAX_WIDTH)
        this.install_syntactic_key("max-height", SK_MAX_HEIGHT)
        this.install_syntactic_key("entity-system-id", SK_ENTITY_SYSTEM_ID)
        this.install_syntactic_key("notation-system-id", SK_NOTATION_SYSTEM_ID)
        this.install_syntactic_key("position-point-x", SK_POSITION_POINT_X)
        this.install_syntactic_key("position-point-y", SK_POSITION_POINT_Y)
        this.install_syntactic_key("escapement-direction", SK_ESCAPEMENT_DIRECTION)
        this.install_syntactic_key("type", SK_TYPE)
        this.install_syntactic_key("placement", SK_PLACEMENT)
        ; the ISOGEN index-entry NICs (reachable only under -t mif)
        this.install_syntactic_key("components", SK_COMPONENTS)
        this.install_syntactic_key("page-number?", SK_PAGE_NUMBER_P)
        this.install_syntactic_key("sort-string", SK_SORT_STRING)
        this.install_syntactic_key("starts-page-range?", SK_STARTS_PAGE_RANGE)
        this.install_syntactic_key("ends-page-range?", SK_ENDS_PAGE_RANGE)
        ; the INLINE/MARK family's NIC keywords. The `character` class owns all
        ; but the last (its other five — space?/record-end?/input-tab?/
        ; input-whitespace?/punct? — are the char-property keys installed
        ; above, one identifier serving both roles); `mark` is
        ; emphasizing-mark's.
        this.install_syntactic_key("char", SK_CHAR)
        this.install_syntactic_key("glyph-id", SK_GLYPH_ID)
        this.install_syntactic_key("drop-after-line-break?", SK_IS_DROP_AFTER_LINE_BREAK)
        this.install_syntactic_key("drop-unless-before-line-break?", SK_IS_DROP_UNLESS_BEFORE_LINE_BREAK)
        this.install_syntactic_key("math-class", SK_MATH_CLASS)
        this.install_syntactic_key("math-font-posture", SK_MATH_FONT_POSTURE)
        this.install_syntactic_key("script", SK_SCRIPT)
        this.install_syntactic_key("stretch-factor", SK_STRETCH_FACTOR)
        this.install_syntactic_key("mark", SK_MARK)
        ; the NIC names of the MATH classes. ★`column-number` (grid-cell's
        ; other one) is installed with the table family above — the reference
        ; shares the key, not just the spelling.
        this.install_syntactic_key("radical", SK_RADICAL)
        this.install_syntactic_key("grid-n-columns", SK_GRID_N_COLUMNS)
        this.install_syntactic_key("grid-n-rows", SK_GRID_N_ROWS)
        this.install_syntactic_key("row-number", SK_ROW_NUMBER)
        ; the NIC names of the LAYOUT-COMPOSITE classes. ★Only three are new:
        ; `direction` (embedded-text's one characteristic) plus `height` and
        ; `contents-rotation` (two of included-container-area's); its other
        ; eight names are keys the external-graphic and inline families already
        ; installed, shared exactly as the reference shares them.
        this.install_syntactic_key("direction", SK_DIRECTION)
        this.install_syntactic_key("height", SK_HEIGHT)
        this.install_syntactic_key("contents-rotation", SK_CONTENTS_ROTATION)
        ; `multi-modes` — the ONE characteristic of the online multi-mode class.
        this.install_syntactic_key("multi-modes", SK_MULTI_MODES)
        ; ★the last four keys[] names this port had never installed. None of
        ; them is a NIC of the page/column model — `data` belongs to
        ; `formatting-instruction`, `open`/`close` to the commented-out
        ; `multi-line-inline-note`, and `null` is a keyword argument of
        ; `node-property`. All four are reached by NAME on this side, so the
        ; keys are inert; they are installed because the table itself is a
        ; contract (see the SK_ block in ELObj).
        this.install_syntactic_key("data", SK_DATA)
        this.install_syntactic_key("null", SK_NULL)
        this.install_syntactic_key("open", SK_OPEN)
        this.install_syntactic_key("close", SK_CLOSE)
        ; the built-in `sequence` flow object (no declare needed).
        let seq this.lookup(StringC("sequence"))
        this.bind_flow_object_class(seq, FOC_SEQUENCE)
    }


    ; --- Inc 8: FOT symbols, inherited characteristics, standard flow objects --
    ; installCValueSymbols — the 120-code FOTBuilder::Symbol table (codes 0/1
    ; are #f/#t; 2.. follow the enum order; faithful quirk: symbolBevel's name
    ; is "join"). Symbols are interned with their c-value so convert_enum can
    ; validate any characteristic symbol value.
    function install_c_value_symbols(this: pointer[Interpreter])
    {
        let names StringC("not-applicable ultra-condensed extra-condensed condensed semi-condensed ultra-light extra-light light semi-light medium semi-expanded expanded extra-expanded ultra-expanded semi-bold bold extra-bold ultra-bold upright oblique back-slanted-oblique italic back-slanted-italic start end center justify spread-inside spread-outside page-inside page-outside wrap asis asis-wrap asis-truncate none before through after top-to-bottom left-to-right bottom-to-top right-to-left inside outside horizontal vertical escapement line-progression math ordinary operator binary relation opening closing punctuation inner space page page-region column-set column max max-uniform miter round join butt square loose normal kern tight touch preserve collapse ignore relative display inline border background both base font top bottom spread solid outline with against force independent pile sup-out sub-out lead-edge trail-edge explicit row-major column-major front back parent right left centered shouldered glyph even indent final truncate error repeat initial")
        var code 2
        let n names.get_size()
        var start: size_t 0
        var i: size_t 0
        while i <= n
        {
            var at_sep false
            if i = n
                set at_sep: true
            else
            {
                if names.get(i) = 0x20
                    set at_sep: true
            }
            if at_sep
            {
                if i > start
                {
                    let tok StringC(names.data_ptr() + start, i - start)
                    let sym this.make_symbol(tok)
                    sym.set_symbol_c_value(code)
                    set code: code + 1
                }
                set start: i + 1
            }
            set i: i + 1
        }
    }

    ; one inherited-characteristic registry entry: intern the identifier and
    ; hang the prototype IC off it (Identifier::setInheritedC). `print_name`
    ; is the exact fot attribute name (reference quirks preserved). The
    ; prototype carries the characteristic's INITIAL value (the inherited-*
    ; fallback when nothing is pushed). iic = all-zero defaults (#f / 0 /
    ; empty); iicn / iicsym / iicstr / iicobj set non-zero initials.
    function iic(this: pointer[Interpreter], name: pointer[const_char], kind: int, print_name: pointer[const_char], index: int)
    {
        let ic this.make_proto_ic(name, kind, print_name, index)
        this.finish_ic(ic)
    }

    ; numeric initial: length/length-spec/integer/maybe-integer/bool kinds.
    function iicn(this: pointer[Interpreter], name: pointer[const_char], kind: int, print_name: pointer[const_char], index: int, n: int)
    {
        let ic this.make_proto_ic(name, kind, print_name, index)
        if kind = IC_LENGTH_SPEC
        {
            var ls LengthSpec()
            set ls.length: n
            set ic.ls: ls
        }
        else if kind = IC_BOOL
            set ic.bval: n <> 0
        else
            set ic.lval: n
        this.finish_ic(ic)
    }

    ; symbol initial (GenericSymbolInheritedC's non-default entries); the
    ; symbol table (install_c_value_symbols) runs first, so the interned
    ; symbol already carries its c-value code.
    function iicsym(this: pointer[Interpreter], name: pointer[const_char], print_name: pointer[const_char], index: int, sym_name: pointer[const_char])
    {
        let host this.host
        let ic this.make_proto_ic(name, IC_SYMBOL, print_name, index)
        let symobj this.make_symbol(StringC(sym_name))
        var s FotSym()
        set s.code: symobj.symbol_c_value()
        set s.name: symobj.symbol_name()
        set ic.sym: s
        this.finish_ic(ic)
    }

    function iicstr(this: pointer[Interpreter], name: pointer[const_char], print_name: pointer[const_char], index: int, s: pointer[const_char])
    {
        let host this.host
        let ic this.make_proto_ic(name, IC_STRING, print_name, index)
        let lit StringC(s)
        set ic.sval: StringC^host(lit.data_ptr(), lit.get_size())
        this.finish_ic(ic)
    }

    ; an ignored characteristic (IgnoredC): initial value is an arbitrary
    ; ELObj; set() renders nothing.
    function iicobj(this: pointer[Interpreter], name: pointer[const_char], print_name: pointer[const_char], index: int, val: pointer[ELObj])
    {
        let ic this.make_proto_ic(name, IC_IGNORED, print_name, index)
        set ic.obj: val
        this.finish_ic(ic)
    }

    function make_proto_ic(this: pointer[Interpreter], name: pointer[const_char], kind: int, print_name: pointer[const_char], index: int) returns pointer[InheritedC]
    {
        let host this.host
        let ident this.lookup(StringC(name))
        let pn_lit StringC(print_name)
        let pn StringC^host(pn_lit.data_ptr(), pn_lit.get_size())
        InheritedC.make(host, kind, ident, index, pn)
    }

    ; installInheritedC's tail: bind the prototype and install the
    ; inherited-*/actual-* primitives. (The reference's trailing-'?' alias is
    ; gated on dsssl2(), which is default-OFF — the `-2` flag is not ported.)
    function finish_ic(this: pointer[Interpreter], ic: pointer[InheritedC])
    {
        let ident ic.ident
        ident.set_inherited_c(ic as pointer[void])
        this.install_inherited_c_proc(ident)
    }

    ; installInheritedCProc — bind `inherited-<name>` / `actual-<name>` to
    ; zero-arg primitives reading the style stack (NOT registered as external
    ; procedures — the reference binds the value only).
    function install_inherited_c_proc(this: pointer[Interpreter], ident: pointer[Identifier])
    {
        this.install_prefixed_prim("inherited-", ident, PRIM_INHERITED_C)
        this.install_prefixed_prim("actual-", ident, PRIM_ACTUAL_C)
    }

    function install_prefixed_prim(this: pointer[Interpreter], prefix: pointer[const_char], base: pointer[Identifier], prim_id: int)
    {
        let host this.host
        let buf Array[u32]^host()
        var i: size_t 0
        while true
        {
            let b *((prefix as pointer[u8]) + i)
            if b = 0
                break
            buf.add(b as u32)
            set i: i + 1
        }
        let nm base.get_name()
        let n nm.get_size()
        set i: 0
        while i < n
        {
            buf.add(nm.get(i))
            set i: i + 1
        }
        let pident this.lookup(StringC(buf.get_buffer(), buf.get_length()))
        let prim ELObj.make_primitive(host, Signature(0, 0, false), prim_id)
        prim.primitive_set_ident(pident)
        pident.set_definition(0xFFFFFFFF, Location(), prim)
    }

    ; installInheritedCs — the generic entries of the reference registry
    ; (InheritedC.cxx) incl. the ignored characteristics (IgnoredC) and the
    ; maybe-integers; initial values transcribed at upi=72000. The full
    ; reference registry is installed (incl. color/background-color, the
    ; border and rule specials, glyph-subst-table, the opt-length-spec and
    ; inline-space entries).
    function install_inherited_cs(this: pointer[Interpreter])
    {
        let host this.host
        this.iicn("font-size", IC_LENGTH, "font-size", 0, (this.units_per_inch * 10) / 72)
        this.iicstr("font-family-name", "font-family-name", 1, "iso-serif")
        this.iicsym("font-weight", "font-weight", 2, "medium")
        this.iicsym("font-posture", "font-posture", 3, "upright")
        this.iicsym("quadding", "quadding", 4, "start")
        this.iicsym("display-alignment", "display-alignment", 5, "start")
        this.iicsym("field-align", "field-align", 6, "start")
        this.iicsym("lines", "lines", 7, "wrap")
        this.iic("start-indent", IC_LENGTH_SPEC, "start-indent", 8)
        this.iic("first-line-start-indent", IC_LENGTH_SPEC, "first-line-start-indent", 9)
        this.iic("end-indent", IC_LENGTH_SPEC, "end-indent", 10)
        this.iic("last-line-end-indent", IC_LENGTH_SPEC, "last-line-end-indent", 11)
        this.iicn("line-spacing", IC_LENGTH_SPEC, "line-spacing", 12, this.units_per_inch * 12 / 72)
        this.iic("field-width", IC_LENGTH_SPEC, "field-width", 13)
        this.iic("left-margin", IC_LENGTH, "left-margin", 14)
