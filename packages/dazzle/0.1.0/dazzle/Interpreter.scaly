use dazzle.NameTable.NameTable
use dazzle.NumberCache.NumberCache
use dazzle.Grove.GroveNode
use dazzle.Grove.IdEntry
use dazzle.Grove.ComponentName
use dazzle.ELObj.ELObj
use dazzle.ELObj.Identifier
use dazzle.ELObj.FlowObj
use dazzle.ELObj.MacroDef
