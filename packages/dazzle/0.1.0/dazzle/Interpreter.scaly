        this.iicn("page-height", IC_LENGTH, "page-height", 21, this.units_per_inch * 11)
        this.iicn("border-present?", IC_BOOL, "border-present", 22, 1)
        this.iicn("line-thickness", IC_LENGTH, "line-thickness", 23, this.units_per_inch / 72)
        this.iic("cell-before-row-margin", IC_LENGTH, "cell-before-row-margin", 24)
