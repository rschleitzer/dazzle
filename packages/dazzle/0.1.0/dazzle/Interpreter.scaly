        this.iicn("box-size-after", IC_LENGTH, "box-size-after", 30, 4 * this.units_per_inch / 72)
        this.iic("position-point-shift", IC_LENGTH_SPEC, "position-point-shift", 31)
        this.iic("start-margin", IC_LENGTH_SPEC, "start-margin", 32)
        this.iic("end-margin", IC_LENGTH_SPEC, "end-margin", 33)
