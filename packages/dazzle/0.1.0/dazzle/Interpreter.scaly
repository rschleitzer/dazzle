        this.iic("principal-mode-simultaneous?", IC_BOOL, "principal-mode-simultaneous", 62)
        this.iic("marginalia-keep-with-previous?", IC_BOOL, "marginalia-keep-with-previous", 63)
        this.iic("grid-equidistant-rows?", IC_BOOL, "grid-equidistant-rows", 64)
        this.iic("grid-equidistant-columns?", IC_BOOL, "grid-equidistant-columns", 65)
        this.iicsym("line-join", "line-join", 66, "miter")
        this.iicsym("line-cap", "line-cap", 67, "butt")
        this.iicsym("line-number-side", "line-number-side", 68, "start")
        this.iicsym("kern-mode", "kern-mode", 69, "normal")
