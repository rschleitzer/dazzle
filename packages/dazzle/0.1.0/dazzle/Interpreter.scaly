use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.Vector
use opensp.StringC.StringC
use opensp.Location.Location
use opensp.Location.Origin
use opensp.XcharMap.XcharMap
use opensp.Message.MessageType
use opensp.Message.MessageArg
use opensp.Message.MessageFormatter
use opensp.ParserState.ParserState
use dazzle.Grove.GroveNode
use dazzle.Grove.IdEntry
use dazzle.ELObj.ELObj
use dazzle.ELObj.Identifier
use dazzle.ELObj.FlowObj
use dazzle.ELObj.GlyphSubstTableRec
use dazzle.ELObj.OutputCharStream
use dazzle.Style.InheritedC
use dazzle.Style.LengthSpec
use dazzle.Style.FotSym
use dazzle.Style.VarStyleRec
use dazzle.Style.InlineSpace
use dazzle.Expression.Expression
use dazzle.Expression.Environment
use dazzle.VM.VM
use dazzle.Insn.Signature
use dazzle.ProcessingMode.ProcessingMode
use dazzle.InterpreterMessages.InterpreterMessages
use dazzle.CharNames.CharNames
use dazzle.Sdata.Sdata

; Interpreter — the style-language interpreter (style/Interpreter.cxx).
; Inc-2 scope: the READER seam the SchemeParser datum reader needs — the
; lexical-category table, symbol/keyword/identifier interning, number
; conversion (convertNumber family incl. quantities and units), character
; names (charNames.h table + U-XXXX), sdata entity mapping, and the
; standard-chars / add-name-chars / add-separator-chars / map-sdata-entity
; declaration hooks. The evaluation half (syntactic keys, primitives,
; processing modes, Insn/VM) lands with Inc 3 per DESIGN.md.
;
; Messages: text/severity sourced from the generated InterpreterMessages
; table (InterpreterMessages.msg). Rendering here is the package-level seam
; (`dazzle:<severity>: <text>` on stderr + error count); the full
; file:line:col MessageReporter prefix is the CLI driver's job and lands
; with Inc 7 (DssslApp/CmdLineApp port), like the reference where the app
; object IS the Messenger.

; The eval scratch region (Collector seam, RBMM shape): while ProcessContext
; evaluates a construction rule, get_host() returns this region instead of
; the run page, so every eval-transient (intermediate ELObjs, sosofo trees,
; per-call insns, fresh VMs) dies with the node's bracket instead of
; retaining until run end — the reference reclaims the same objects with
; Clark's GC. null outside processing (load/compile allocate on the run
; page as before). Interning (symbols/identifiers/units) and Identifier
; value forcing go to the PERM host explicitly (makePermanent semantics).
; A module global, not an Interpreter field: growing a heap-hosted struct
; in the dazzle run region trips the page-boundary RBMM fragility (S62).
; `shared`, not `mutable`: a thread-local in a dep package aborts under
; --jit (_tlv_bootstrap_error — the ORC AddObjectFile path doesn't wire
; MachO TLV). Race discipline: the style engine is single-threaded per
; run; a self-scaling `for` never promotes a loop that touches a mutable
; global, so no promoted loop can race this cell.
shared eval_region: pointer[Page] null

; argv0 for the MessageReporter prefix (`<argv0>:<file>:<line>:<col>:<sev>: …`,
; exactly the reference where the app object IS the Messenger). The CLI driver
; sets this once before processing; unset (unit tests, --jit suite) the prefix
; stays the historical package name `dazzle`. A `shared` module global, not an
; Interpreter field — growing a heap-hosted struct in the dazzle run region
; trips the page-boundary RBMM fragility (S62), and `mutable` (TLS) in a dep
; package aborts under --jit.
shared msg_prog: pointer[const_char] null

; whether the active backend provides the transform extension flow-object
; classes (jade.cxx passes an extension table only for -t sgml/xml); the CLI
; clears it for -t fot. A `shared` module global by the S62 rule (no
; Interpreter field growth); single-threaded CLI setup writes it once.
shared xt_extensions_on: bool true

; MessageReporter's column-omission sentinel (opensp.Location COL_OMITTED —
; module-level consts are not cross-package-visible; mirrored here).
define MSG_COL_OMITTED: u32 0xFFFFFFFF

; Interpreter::LexCategory
define LEX_LETTER: int 0            ; a-z A-Z
define LEX_OTHER_NAME_START: int 1  ; !$%&*/<=>?~_^:
define LEX_ADD_NAME_START: int 2
define LEX_DIGIT: int 3             ; 0-9
define LEX_OTHER_NUMBER_START: int 4 ; -+.
define LEX_OTHER: int 5
define LEX_DELIMITER: int 6         ; ();"
define LEX_WHITESPACE: int 7
define LEX_ADD_WHITESPACE: int 8

; the printer's replacement char for unknown character names
define DEFAULT_CHAR: int 0xFFFD

; Unit::computed_ states
define UNIT_NOT_COMPUTED: int 0
define UNIT_BEING_COMPUTED: int 1
define UNIT_COMPUTED_EXACT: int 2
define UNIT_COMPUTED_INEXACT: int 3
define UNIT_COMPUTED_ERROR: int 4

; strtod(3) — fixed-prototype, non-variadic, errno-free use: direct extern
; per the containment rule.
function strtod(s: pointer[const_char], endp: pointer[pointer[u8]]) returns double extern

; A named-character-table entry (Interpreter::CharPart): the char plus the
; index of the defining part (unsigned(-1) = predefined).
define CharPart (name: StringC, c: u32, def_part: u32)
{
    init(name: StringC, c: u32, def_part: u32)
    {
        set this.name: name
        set this.c: c
        set this.def_part: def_part
    }
}

; Unit — a named measurement unit (Interpreter.h class Unit : Named).
; Inc-2 carries the computed-value half (builtin units get their value from
; unitsPerInch in installUnits; setValue marks them computedExact/Inexact).
; The define-unit expression path (def_/insn_, tryCompute's VM evaluation)
; lands with Inc 3 — until then computed_ stays notComputed for user units
; and resolveQuantity returns null (exactly the reference's "can't be done
; yet" answer for an uncomputed unit without force).
define Unit (name: StringC, computed: int, exact: int, inexact: double, dim: int, def_part: u32)
{
    function make(host: pointer[Page], name: StringC) returns pointer[Unit]
    {
        let u host.allocate(sizeof Unit, alignof Unit) as pointer[Unit]
        set u.name: StringC^host(name.data_ptr(), name.get_size())
        set u.computed: UNIT_NOT_COMPUTED
        set u.exact: 0
        set u.inexact: 0.0
        set u.dim: 0
        set u.def_part: 0xFFFFFFFF as u32
        u
    }

    function get_name(this: Unit) returns StringC
        name

    ; void setValue(long)
    function set_value_long(this: pointer[Unit], n: int)
    {
        set this.computed: UNIT_COMPUTED_EXACT
        set this.exact: n
        set this.dim: 1
        set this.def_part: 0xFFFFFFFF as u32
    }

    ; void setValue(double)
    function set_value_double(this: pointer[Unit], n: double)
    {
        set this.computed: UNIT_COMPUTED_INEXACT
        set this.inexact: n
        set this.dim: 1
        set this.def_part: 0xFFFFFFFF as u32
    }

    ; bool defined(unsigned &part, Location &loc) — Inc-2 subset: no def_
    ; expression yet, so defined <=> a computed value exists (the out-params
    ; feed doDefineUnit's duplicate diagnostics, Inc 3).
    function is_defined(this: Unit) returns bool
        computed <> UNIT_NOT_COMPUTED

    ; static bool scale(long val, int valExp, long factor, long &result):
    ; result = val * 10^valExp * factor, 0 on overflow.
    function scale(val: int, val_exp_in: int, factor_in: int, result: pointer[int]) returns bool
    {
        var val_exp val_exp_in
        var factor factor_in
        let long_max 0x7FFFFFFFFFFFFFFF
        if factor <= 0
            return false
        while val_exp > 0
        {
            if factor > long_max / 10
                return false
            set val_exp: val_exp - 1
            set factor: factor * 10
        }
        if val >= 0
        {
            if val > long_max / factor
                return false
        }
        else
        {
            ; -(unsigned long)val > -(unsigned long)LONG_MIN/factor
            let neg_val (0 as u64) - (val as u64)
            let neg_min (long_max as u64) + (1 as u64)
            if neg_val > neg_min / (factor as u64)
                return false
        }
        var r val * factor
        while val_exp < 0
        {
            set r: r / 10
            set val_exp: val_exp + 1
        }
        set *result: r
        true
    }

    ; ELObj *resolveQuantity(bool force, Interpreter &, long val, int valExp)
    ; (val * 10^valExp of this unit; the unit's own exponent is 1).
    function resolve_quantity_long(this: pointer[Unit], force: bool, interp: pointer[Interpreter], val: int, val_exp_in: int) returns pointer[ELObj]
    {
        this.try_compute(force, interp)
        if this.computed = UNIT_COMPUTED_EXACT
        {
            var result 0
            if Unit.scale(val, val_exp_in, this.exact, &result)
                return ELObj.make_length(interp.host, result)
        }
        var val_exp val_exp_in
        var x val as double
        while val_exp > 0
        {
            set x: x * 10.0
            set val_exp: val_exp - 1
        }
        while val_exp < 0
        {
            set x: x / 10.0
            set val_exp: val_exp + 1
        }
        this.resolve_quantity_double(force, interp, x, 1)
    }

    ; ELObj *resolveQuantity(bool force, Interpreter &, double val, int unitExp)
    function resolve_quantity_double(this: pointer[Unit], force: bool, interp: pointer[Interpreter], val: double, unit_exp_in: int) returns pointer[ELObj]
    {
        this.try_compute(force, interp)
        var factor 0.0
        if this.computed = UNIT_COMPUTED_EXACT
            set factor: this.exact as double
        else if this.computed = UNIT_COMPUTED_INEXACT
            set factor: this.inexact
        else if this.computed = UNIT_COMPUTED_ERROR
            return interp.make_error()
        else
            return null
        var unit_exp unit_exp_in
        var result_dim 0
        var result_val val
        while unit_exp > 0
        {
            set result_dim: result_dim + this.dim
            set result_val: result_val * factor
            set unit_exp: unit_exp - 1
        }
        while unit_exp < 0
        {
            set result_dim: result_dim - this.dim
            set result_val: result_val / factor
            set unit_exp: unit_exp + 1
        }
        if result_dim = 0
            return ELObj.make_real(interp.host, result_val)
        ELObj.make_quantity(interp.host, result_val, result_dim)
    }

    ; void tryCompute(bool force, Interpreter &): Inc-2 subset — a unit
    ; without a computed value has no definition expression yet (define-unit
    ; parsing is Inc 3), so notComputed simply stays notComputed; the
    ; beingComputed/unitLoop and VM-evaluation branches land with Inc 3.
    function try_compute(this: pointer[Unit], force: bool, interp: pointer[Interpreter])
    {
    }
}

; externalProcTable_ entry: a public identifier -> primitive value binding
; (Interpreter::installPrimitive / installXPrimitive; external-procedure
; resolves against it). Linear array, insertion order.
define ExternalProc (pubid: StringC, value: pointer[ELObj])
{
    function make(host: pointer[Page], pubid: StringC, value: pointer[ELObj]) returns pointer[ExternalProc]
    {
        let e host.allocate(sizeof ExternalProc, alignof ExternalProc) as pointer[ExternalProc]
        set e.pubid: StringC^host(pubid.data_ptr(), pubid.get_size())
        set e.value: value
        e
    }
}

define Interpreter
(
    host: pointer[Page]
    units_per_inch: int
    debug_mode: bool
    dsssl2: bool
    strict_mode: bool
    part_index: u32
    d_part_index: u32
    ; the permanent singletons (one per run; eqv? = identity)
    nil_obj: pointer[ELObj]
    true_obj: pointer[ELObj]
    false_obj: pointer[ELObj]
    error_obj: pointer[ELObj]
    unspecified_obj: pointer[ELObj]
    ; interning tables (NamedTable port shape: linear Array, insertion order)
    symbol_table: pointer[Array[pointer[ELObj]]]
    ident_table: pointer[Array[pointer[Identifier]]]
    unit_table: pointer[Array[pointer[Unit]]]
    named_char_table: pointer[Array[pointer[CharPart]]]
    sdata_entity_name_table: pointer[Array[pointer[CharPart]]]
    sdata_entity_text_table: pointer[Array[pointer[CharPart]]]
    lex_category_table: pointer[XcharMap]
    ; Messenger seam (see header note): counts + prints; the driver owns
    ; the full location-prefixed rendering (Inc 7).
    error_count: int
    next_loc: Location
    ; processing modes (Style/Interpreter.cxx): the unnamed initial mode plus
    ; every named mode (mode NAME …). Rules register here; compile() finalises.
    initial_mode: pointer[ProcessingMode]
    processing_mode_table: pointer[Array[pointer[ProcessingMode]]]
    ; grove ID index (element-with-id); set by the driver after the grove is
    ; built. Null until then -> element-with-id yields the empty node-list.
    grove_id_index: pointer[Array[pointer[IdEntry]]]
    ; declare-default-language: the declaration expression (evaluated by
    ; compile(), like the reference compileDefaultLanguage) and the resulting
    ; language value char-upcase/downcase consult.
    default_language_def: pointer[Expression]
    default_language_loc: Location
    default_language: pointer[ELObj]
    ; externalProcTable_ — public id -> FunctionObj (external-procedure).
    external_proc_table: pointer[Array[pointer[ExternalProc]]]
    ; the canned border styles (a single border-present? spec; table borders
    ; specified as booleans resolve to these).
    border_true_style_obj: pointer[ELObj]
    border_false_style_obj: pointer[ELObj]
    ; nextGlyphSubstTableUniqueId_ — the fot dump's gst<n> ids.
    next_gst_unique_id: int
)
{
    function make(host: pointer[Page], units_per_inch: int, debug_mode: bool, dsssl2: bool, strict_mode: bool) returns pointer[Interpreter]
    {
        let interp host.allocate(sizeof Interpreter, alignof Interpreter) as pointer[Interpreter]
        set interp.host: host
        set interp.units_per_inch: units_per_inch
        set interp.debug_mode: debug_mode
        set interp.dsssl2: dsssl2
        set interp.strict_mode: strict_mode
        set interp.part_index: 0 as u32
        set interp.d_part_index: 1 as u32
        set interp.nil_obj: ELObj.make_nil(host)
        set interp.true_obj: ELObj.make_true(host)
        set interp.false_obj: ELObj.make_false(host)
        set interp.error_obj: ELObj.make_error(host)
        set interp.unspecified_obj: ELObj.make_unspecified(host)
        set interp.symbol_table: Array[pointer[ELObj]]^host()
        set interp.ident_table: Array[pointer[Identifier]]^host()
        set interp.unit_table: Array[pointer[Unit]]^host()
        set interp.named_char_table: Array[pointer[CharPart]]^host()
        set interp.sdata_entity_name_table: Array[pointer[CharPart]]^host()
        set interp.sdata_entity_text_table: Array[pointer[CharPart]]^host()
        set interp.error_count: 0
        set interp.next_loc: Location()
        set interp.processing_mode_table: null
        set interp.grove_id_index: null
        set interp.default_language_def: null
        set interp.default_language_loc: Location()
        set interp.default_language: null
        set interp.external_proc_table: Array[pointer[ExternalProc]]^host()
        set interp.border_true_style_obj: null
        set interp.border_false_style_obj: null
        set interp.next_gst_unique_id: 0
        set interp.initial_mode: ProcessingMode.make(host, StringC(), null)
        interp.initial_mode.set_defined()

        interp.install_units()
        interp.install_syntactic_keys()
        interp.install_c_value_symbols()
        ; flow objects BEFORE the inherited Cs (reference order — fraction-
        ; bar's initial value is the rule class binding).
        interp.install_flow_objs()
        interp.install_inherited_cs()
        interp.install_primitives()
        if strict_mode = false
        {
            CharNames.install(interp)
            Sdata.install(interp)
        }

        ; the lexical-category table (constructor tail, Interpreter.cxx:107)
        let lex XcharMap.make(host, LEX_OTHER as u8)
        set interp.lex_category_table: lex
        lex.set_ee(LEX_DELIMITER as u8)
        Interpreter.set_lex_ascii(lex, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz", LEX_LETTER as u8)
        Interpreter.set_lex_ascii(lex, "!$%&*/<=>?~_^:", LEX_OTHER_NAME_START as u8)
        Interpreter.set_lex_ascii(lex, "0123456789", LEX_DIGIT as u8)
        Interpreter.set_lex_ascii(lex, "-+.", LEX_OTHER_NUMBER_START as u8)
        Interpreter.set_lex_ascii(lex, "();\"", LEX_DELIMITER as u8)
        Interpreter.set_lex_ascii(lex, " \t\r\n", LEX_WHITESPACE as u8)
        lex.set_char(0x0C as u32, LEX_WHITESPACE as u8)  ; \f
        ; #',@[\]`{|} stay lexOther: not allowed in names. Chars >= 127 are
        ; name-start in the non-strict repertoire (XcharMap's dense range
        ; covers the BMP; higher planes clamp to the default — the XcharMap
        ; port's documented scope).
        if strict_mode = false
            lex.set_range(127 as u32, 0xFFFF as u32, LEX_ADD_NAME_START as u8)

        interp
    }

    function set_lex_ascii(lex: pointer[XcharMap], s: pointer[const_char], cat: u8)
    {
        var p s as pointer[u8]
        while (*p) <> (0 as u8)
        {
            lex.set_char((*p) as u32, cat)
            set p: p + 1
        }
    }

    ; LexCategory lexCategory(Xchar c)
    function lex_category(this: Interpreter, c: i32) returns int
        lex_category_table.get(c) as int

    ; the allocation page (Collector seam) — cross-module allocation sites
    ; reach it through this accessor: the eval scratch region while a
    ; construction rule evaluates, the run arena page otherwise.
    function get_host(this: Interpreter) returns pointer[Page]
    {
        if eval_region <> null
            return eval_region
        host
    }

    ; the run arena page unconditionally — for allocations that must outlive
    ; the eval bracket (interning, forced Identifier values).
    function get_perm_host(this: Interpreter) returns pointer[Page]
        host

    function get_eval_region(this: Interpreter) returns pointer[Page]
        eval_region

    procedure set_eval_region(this: pointer[Interpreter], p: pointer[Page])
        set eval_region: p

    function is_dsssl2(this: Interpreter) returns bool
        dsssl2

    ; grove ID index (element-with-id): the driver installs it after building
    ; the grove; lookup returns the element for an ID value or null.
    function set_grove_id_index(this: pointer[Interpreter], index: pointer[Array[pointer[IdEntry]]])
        set this.grove_id_index: index

    function lookup_element_by_id(this: Interpreter, id: StringC) returns pointer[GroveNode]
    {
        let index this.grove_id_index
        if index = null
            return null
        let n index.get_length()
        let buf index.get_buffer()
        var i: size_t 0
        while i < n
        {
            let e *(buf + i)
            if e.id.equals(id)
                return e.node
            set i: i + 1
        }
        null
    }

    function get_units_per_inch(this: Interpreter) returns int
        units_per_inch

    ; --- singletons --------------------------------------------------------
    function make_nil(this: Interpreter) returns pointer[ELObj]
        nil_obj

    function make_true(this: Interpreter) returns pointer[ELObj]
        true_obj

    function make_false(this: Interpreter) returns pointer[ELObj]
        false_obj

    ; #t / #f from a Scaly bool (Primitive predicate results).
    function make_bool(this: Interpreter, b: bool) returns pointer[ELObj]
    {
        if b
            return true_obj
        false_obj
    }

    function make_error(this: Interpreter) returns pointer[ELObj]
        error_obj

    function make_unspecified(this: Interpreter) returns pointer[ELObj]
        unspecified_obj

    function is_error(this: Interpreter, obj: pointer[ELObj]) returns bool
        obj = error_obj

    ; endPart(): the next specification part (later parts' defines lose to
    ; earlier ones — doDefine's defPart gate).
    function end_part(this: pointer[Interpreter])
        set this.part_index: this.part_index + (1 as u32)

    ; installBuiltins brackets the builtins parse with part index -1 (so any
    ; user define overrides a builtin), then endPart wraps back to 0.
    function set_part_index(this: pointer[Interpreter], n: u32)
        set this.part_index: n

    ; --- processing modes --------------------------------------------------
    function current_part_index(this: Interpreter) returns u32
        part_index

    function initial_processing_mode(this: Interpreter) returns pointer[ProcessingMode]
        initial_mode

    ; lookupProcessingMode(name): the named mode, created (with the initial mode
    ; as fall-through parent) on first reference.
    function lookup_processing_mode(this: pointer[Interpreter], str: StringC) returns pointer[ProcessingMode]
    {
        ; the table is allocated lazily — a stylesheet with no named modes (the
        ; common case) never grabs its exclusive page.
        if this.processing_mode_table = null
        {
            let hp this.host
            set this.processing_mode_table: Array[pointer[ProcessingMode]]^hp()
        }
        let tbl this.processing_mode_table
        let n tbl.get_length()
        let buf tbl.get_buffer()
        var i: size_t 0
        while i < n
        {
            let m *(buf + i)
            if m.get_name().equals(str)
                return m
            set i: i + 1
        }
        let m ProcessingMode.make(this.host, str, this.initial_mode)
        tbl.add(m)
        m
    }

    ; WithModeExpression::compile's defined() gate — the Expression module
    ; carries the mode as pointer[void] (importing ProcessingMode there would
    ; cycle), so the check + undefinedMode message live on this seam.
    function check_mode_defined(this: pointer[Interpreter], mode: pointer[void], loc: Location)
    {
        let m mode as pointer[ProcessingMode]
        if m = null
            return
        if m.defined()
            return
        this.set_next_location(loc)
        this.message1(InterpreterMessages.undefinedMode(), m.get_name())
    }

    ; compile(): finalise every mode's rules (Interpreter::compile). Top-level
    ; definitions used by rule bodies compute lazily via TopRefInsn at eval.
    ; The sorted element-rule scan order is built HERE (not lazily on the
    ; first find_match): during processing get_host() is the eval scratch
    ; region, and a lazily-built sorted array would dangle after the bracket.
    function compile(this: pointer[Interpreter])
    {
        this.compile_default_language()
        this.initial_mode.compile(this)
        this.initial_mode.build_sorted(this.host)
        if this.processing_mode_table = null
            return
        let tbl this.processing_mode_table
        var i: size_t 0
        while i < tbl.get_length()
        {
            let m *(tbl.get_buffer() + i)
            m.compile(this)
            m.build_sorted(this.host)
            set i: i + 1
        }
    }

    ; --- declare-default-language (Interpreter::compileDefaultLanguage) -----
    function set_default_language_def(this: pointer[Interpreter], expr: pointer[Expression], loc: Location)
    {
        set this.default_language_def: expr
        set this.default_language_loc: loc
    }

    function get_default_language(this: Interpreter) returns pointer[ELObj]
        default_language

    function compile_default_language(this: pointer[Interpreter])
    {
        if this.default_language_def = null
            return
        let host this.host
        let env Environment.make(host)
        let insn Expression.optimize_compile(this.default_language_def, this, env, 0, null)
        let vm VM.make(host, this)
        let obj vm.eval(insn, null, null)
        if obj = null
            return
        if obj.is_language_p() = false
        {
            if this.is_error(obj) = false
            {
                let os OutputCharStream.make(host)
                obj.print(os, this.units_per_inch)
                let printed os.to_string_c(host)
                this.set_next_location(this.default_language_loc)
                this.message1(InterpreterMessages.defLangDeclRequiresLanguage(), printed)
            }
            return
        }
        set this.default_language: obj
    }

    ; --- interning ---------------------------------------------------------
    ; Identifier *lookup(const StringC &): one Identifier per name.
    function lookup(this: pointer[Interpreter], str: StringC) returns pointer[Identifier]
    {
        let n this.ident_table.get_length()
        let buf this.ident_table.get_buffer()
        var i: size_t 0
        while i < n
        {
            let p *(buf + i)
            if p.get_name().equals(str)
                return p
            set i: i + 1
        }
        let ident Identifier.make(this.host, str)
        this.ident_table.add(ident)
        ident
    }

    ; SymbolObj *makeSymbol(const StringC &): one SymbolObj per name.
    function make_symbol(this: pointer[Interpreter], str: StringC) returns pointer[ELObj]
    {
        let n this.symbol_table.get_length()
        let buf this.symbol_table.get_buffer()
        var i: size_t 0
        while i < n
        {
            let p *(buf + i)
            let sn p.symbol_name()
            if sn.equals(str)
                return p
            set i: i + 1
        }
        let host this.host
        let name StringC^host(str.data_ptr(), str.get_size())
        let sym ELObj.make_symbol(host, name)
        this.symbol_table.add(sym)
        sym
    }

    ; KeywordObj *makeKeyword(const StringC &): a fresh KeywordObj whose
    ; identity is the interned Identifier.
    function make_keyword(this: pointer[Interpreter], str: StringC) returns pointer[ELObj]
    {
        let ident this.lookup(str)
        ELObj.make_keyword(this.host, ident)
    }

    ; --- units -------------------------------------------------------------
    ; Unit *lookupUnit(const StringC &): create on demand.
    function lookup_unit(this: pointer[Interpreter], name: StringC) returns pointer[Unit]
    {
        let n this.unit_table.get_length()
        let buf this.unit_table.get_buffer()
        var i: size_t 0
        while i < n
        {
            let p *(buf + i)
            if p.get_name().equals(name)
                return p
            set i: i + 1
        }
        let u Unit.make(this.host, name)
        this.unit_table.add(u)
        u
    }

    ; void installUnits(): builtin units valued from unitsPerInch; "pc" is
    ; the DSSSL2 addition.
    function install_units(this: pointer[Interpreter])
    {
        this.install_unit("m", 5000, 127)
        this.install_unit("cm", 50, 127)
        this.install_unit("mm", 5, 127)
        this.install_unit("in", 1, 1)
        this.install_unit("pt", 1, 72)
        this.install_unit("pica", 1, 6)
        if this.dsssl2
            this.install_unit("pc", 1, 6)
    }

    function install_unit(this: pointer[Interpreter], name: pointer[const_char], numer: int, denom: int)
    {
        let u this.lookup_unit(StringC(name))
        let n this.units_per_inch * numer
        if n % denom = 0
            u.set_value_long(n / denom)
        else
            u.set_value_double((n as double) / (denom as double))
    }

    ; --- syntactic keys ----------------------------------------------------
    function install_syntactic_key(this: pointer[Interpreter], name: pointer[const_char], key: int)
    {
        let ident this.lookup(StringC(name))
        ident.set_syntactic_key(key)
    }

    ; installSyntacticKey batch (Interpreter ctor). Inc-3 subset: the eval-core
    ; forms; the style/grove top-level keys (element/root/mode/declare-*) join
    ; with those increments, though the tags are reserved here.
    function install_syntactic_keys(this: pointer[Interpreter])
    {
        this.install_syntactic_key("define", SK_DEFINE)
        this.install_syntactic_key("define-unit", SK_DEFINE_UNIT)
        this.install_syntactic_key("quote", SK_QUOTE)
        this.install_syntactic_key("quasiquote", SK_QUASIQUOTE)
        this.install_syntactic_key("unquote", SK_UNQUOTE)
        this.install_syntactic_key("unquote-splicing", SK_UNQUOTE_SPLICING)
        this.install_syntactic_key("if", SK_IF)
        this.install_syntactic_key("cond", SK_COND)
        this.install_syntactic_key("case", SK_CASE)
        this.install_syntactic_key("and", SK_AND)
        this.install_syntactic_key("or", SK_OR)
        this.install_syntactic_key("let", SK_LET)
        this.install_syntactic_key("let*", SK_LET_STAR)
        this.install_syntactic_key("letrec", SK_LETREC)
        this.install_syntactic_key("lambda", SK_LAMBDA)
        this.install_syntactic_key("begin", SK_BEGIN)
        this.install_syntactic_key("set!", SK_SET)
        this.install_syntactic_key("else", SK_ELSE)
        this.install_syntactic_key("=>", SK_ARROW)
        ; construction/style rule top-level forms (Inc 5)
        this.install_syntactic_key("element", SK_ELEMENT)
        this.install_syntactic_key("or-element", SK_OR_ELEMENT)
        this.install_syntactic_key("default", SK_DEFAULT)
        this.install_syntactic_key("root", SK_ROOT)
        this.install_syntactic_key("id", SK_ID)
        this.install_syntactic_key("mode", SK_MODE)
        this.install_syntactic_key("with-mode", SK_WITH_MODE)
        this.install_syntactic_key("make", SK_MAKE)
        this.install_syntactic_key("style", SK_STYLE)
        this.install_syntactic_key("use", SK_KEY_USE)
        this.install_syntactic_key("label", SK_KEY_LABEL)
        this.install_syntactic_key("content-map", SK_KEY_CONTENT_MAP)
        this.install_syntactic_key("declare-flow-object-class", SK_DECLARE_FLOW_OBJECT_CLASS)
        this.install_syntactic_key("define-language", SK_DEFINE_LANGUAGE)
        this.install_syntactic_key("declare-default-language", SK_DECLARE_DEFAULT_LANGUAGE)
        ; display/inline NIC keywords (FlowObj::isDisplayNIC family, Inc 8)
        this.install_syntactic_key("position-preference", SK_POSITION_PREFERENCE)
        this.install_syntactic_key("keep-with-previous?", SK_KEEP_WITH_PREVIOUS)
        this.install_syntactic_key("keep-with-next?", SK_KEEP_WITH_NEXT)
        this.install_syntactic_key("keep", SK_KEEP)
        this.install_syntactic_key("break-before", SK_BREAK_BEFORE)
        this.install_syntactic_key("break-after", SK_BREAK_AFTER)
        this.install_syntactic_key("may-violate-keep-before?", SK_MAY_VIOLATE_KEEP_BEFORE)
        this.install_syntactic_key("may-violate-keep-after?", SK_MAY_VIOLATE_KEEP_AFTER)
        this.install_syntactic_key("space-before", SK_SPACE_BEFORE)
        this.install_syntactic_key("space-after", SK_SPACE_AFTER)
        this.install_syntactic_key("coalesce-id", SK_COALESCE_ID)
        this.install_syntactic_key("break-before-priority", SK_BREAK_BEFORE_PRIORITY)
        this.install_syntactic_key("break-after-priority", SK_BREAK_AFTER_PRIORITY)
        ; simple-page-sequence header/footer sosofo NICs
        this.install_syntactic_key("left-header", SK_LEFT_HEADER)
        this.install_syntactic_key("center-header", SK_CENTER_HEADER)
        this.install_syntactic_key("right-header", SK_RIGHT_HEADER)
        this.install_syntactic_key("left-footer", SK_LEFT_FOOTER)
        this.install_syntactic_key("center-footer", SK_CENTER_FOOTER)
        this.install_syntactic_key("right-footer", SK_RIGHT_FOOTER)
        ; table-family NIC keywords
        this.install_syntactic_key("before-row-border", SK_BEFORE_ROW_BORDER)
        this.install_syntactic_key("after-row-border", SK_AFTER_ROW_BORDER)
        this.install_syntactic_key("before-column-border", SK_BEFORE_COLUMN_BORDER)
        this.install_syntactic_key("after-column-border", SK_AFTER_COLUMN_BORDER)
        this.install_syntactic_key("table-width", SK_TABLE_WIDTH)
        this.install_syntactic_key("column-number", SK_COLUMN_NUMBER)
        this.install_syntactic_key("n-columns-spanned", SK_N_COLUMNS_SPANNED)
        this.install_syntactic_key("n-rows-spanned", SK_N_ROWS_SPANNED)
        this.install_syntactic_key("width", SK_WIDTH)
        this.install_syntactic_key("starts-row?", SK_IS_STARTS_ROW)
        this.install_syntactic_key("ends-row?", SK_IS_ENDS_ROW)
        ; display-space / inline-space keyword args
        this.install_syntactic_key("min", SK_MIN)
        this.install_syntactic_key("max", SK_MAX)
        this.install_syntactic_key("conditional?", SK_IS_CONDITIONAL)
        this.install_syntactic_key("priority", SK_PRIORITY)
        ; CIE color-space keyword args
        this.install_syntactic_key("white-point", SK_WHITE_POINT)
        this.install_syntactic_key("black-point", SK_BLACK_POINT)
        this.install_syntactic_key("range", SK_RANGE)
        this.install_syntactic_key("range-abc", SK_RANGE_ABC)
        this.install_syntactic_key("range-lmn", SK_RANGE_LMN)
        this.install_syntactic_key("range-a", SK_RANGE_A)
        this.install_syntactic_key("decode-abc", SK_DECODE_ABC)
        this.install_syntactic_key("decode-lmn", SK_DECODE_LMN)
        this.install_syntactic_key("decode-a", SK_DECODE_A)
        this.install_syntactic_key("matrix-abc", SK_MATRIX_ABC)
        this.install_syntactic_key("matrix-lmn", SK_MATRIX_LMN)
        this.install_syntactic_key("matrix-a", SK_MATRIX_A)
        ; rule NIC keywords
        this.install_syntactic_key("orientation", SK_ORIENTATION)
        this.install_syntactic_key("length", SK_LENGTH)
        ; the built-in `sequence` flow object (no declare needed).
        let seq this.lookup(StringC("sequence"))
        this.bind_flow_object_class(seq, FOC_SEQUENCE)
    }


    ; --- Inc 8: FOT symbols, inherited characteristics, standard flow objects --
    ; installCValueSymbols — the 120-code FOTBuilder::Symbol table (codes 0/1
    ; are #f/#t; 2.. follow the enum order; faithful quirk: symbolBevel's name
    ; is "join"). Symbols are interned with their c-value so convert_enum can
    ; validate any characteristic symbol value.
    function install_c_value_symbols(this: pointer[Interpreter])
    {
        let names StringC("not-applicable ultra-condensed extra-condensed condensed semi-condensed ultra-light extra-light light semi-light medium semi-expanded expanded extra-expanded ultra-expanded semi-bold bold extra-bold ultra-bold upright oblique back-slanted-oblique italic back-slanted-italic start end center justify spread-inside spread-outside page-inside page-outside wrap asis asis-wrap asis-truncate none before through after top-to-bottom left-to-right bottom-to-top right-to-left inside outside horizontal vertical escapement line-progression math ordinary operator binary relation opening closing punctuation inner space page page-region column-set column max max-uniform miter round join butt square loose normal kern tight touch preserve collapse ignore relative display inline border background both base font top bottom spread solid outline with against force independent pile sup-out sub-out lead-edge trail-edge explicit row-major column-major front back parent right left centered shouldered glyph even indent final truncate error repeat initial")
        var code 2
        let n names.get_size()
        var start: size_t 0
        var i: size_t 0
        while i <= n
        {
            var at_sep false
            if i = n
                set at_sep: true
            else
            {
                if names.get(i) = (0x20 as u32)
                    set at_sep: true
            }
            if at_sep
            {
                if i > start
                {
                    let tok StringC(names.data_ptr() + start, i - start)
                    let sym this.make_symbol(tok)
                    sym.set_symbol_c_value(code)
                    set code: code + 1
                }
                set start: i + (1 as size_t)
            }
            set i: i + (1 as size_t)
        }
    }

    ; one inherited-characteristic registry entry: intern the identifier and
    ; hang the prototype IC off it (Identifier::setInheritedC). `print_name`
    ; is the exact fot attribute name (reference quirks preserved). The
    ; prototype carries the characteristic's INITIAL value (the inherited-*
    ; fallback when nothing is pushed). iic = all-zero defaults (#f / 0 /
    ; empty); iicn / iicsym / iicstr / iicobj set non-zero initials.
    function iic(this: pointer[Interpreter], name: pointer[const_char], kind: int, print_name: pointer[const_char], index: int)
    {
        let ic this.make_proto_ic(name, kind, print_name, index)
        this.finish_ic(ic)
    }

    ; numeric initial: length/length-spec/integer/maybe-integer/bool kinds.
    function iicn(this: pointer[Interpreter], name: pointer[const_char], kind: int, print_name: pointer[const_char], index: int, n: int)
    {
        let ic this.make_proto_ic(name, kind, print_name, index)
        if kind = IC_LENGTH_SPEC
        {
            var ls LengthSpec()
            set ls.length: n
            set ic.ls: ls
        }
        else if kind = IC_BOOL
            set ic.bval: n <> 0
        else
            set ic.lval: n
        this.finish_ic(ic)
    }

    ; symbol initial (GenericSymbolInheritedC's non-default entries); the
    ; symbol table (install_c_value_symbols) runs first, so the interned
    ; symbol already carries its c-value code.
    function iicsym(this: pointer[Interpreter], name: pointer[const_char], print_name: pointer[const_char], index: int, sym_name: pointer[const_char])
    {
        let host this.host
        let ic this.make_proto_ic(name, IC_SYMBOL, print_name, index)
        let symobj this.make_symbol(StringC(sym_name))
        var s FotSym()
        set s.code: symobj.symbol_c_value()
        set s.name: symobj.symbol_name()
        set ic.sym: s
        this.finish_ic(ic)
    }

    function iicstr(this: pointer[Interpreter], name: pointer[const_char], print_name: pointer[const_char], index: int, s: pointer[const_char])
    {
        let host this.host
        let ic this.make_proto_ic(name, IC_STRING, print_name, index)
        let lit StringC(s)
        set ic.sval: StringC^host(lit.data_ptr(), lit.get_size())
        this.finish_ic(ic)
    }

    ; an ignored characteristic (IgnoredC): initial value is an arbitrary
    ; ELObj; set() renders nothing.
    function iicobj(this: pointer[Interpreter], name: pointer[const_char], print_name: pointer[const_char], index: int, val: pointer[ELObj])
    {
        let ic this.make_proto_ic(name, IC_IGNORED, print_name, index)
        set ic.obj: val
        this.finish_ic(ic)
    }

    function make_proto_ic(this: pointer[Interpreter], name: pointer[const_char], kind: int, print_name: pointer[const_char], index: int) returns pointer[InheritedC]
    {
        let host this.host
        let ident this.lookup(StringC(name))
        let pn_lit StringC(print_name)
        let pn StringC^host(pn_lit.data_ptr(), pn_lit.get_size())
        InheritedC.make(host, kind, ident, index, pn)
    }

    ; installInheritedC's tail: bind the prototype and install the
    ; inherited-*/actual-* primitives. (The reference's trailing-'?' alias is
    ; gated on dsssl2(), which is default-OFF — the `-2` flag is not ported.)
    function finish_ic(this: pointer[Interpreter], ic: pointer[InheritedC])
    {
        let ident ic.ident
        ident.set_inherited_c(ic as pointer[void])
        this.install_inherited_c_proc(ident)
    }

    ; installInheritedCProc — bind `inherited-<name>` / `actual-<name>` to
    ; zero-arg primitives reading the style stack (NOT registered as external
    ; procedures — the reference binds the value only).
    function install_inherited_c_proc(this: pointer[Interpreter], ident: pointer[Identifier])
    {
        this.install_prefixed_prim("inherited-", ident, PRIM_INHERITED_C)
        this.install_prefixed_prim("actual-", ident, PRIM_ACTUAL_C)
    }

    function install_prefixed_prim(this: pointer[Interpreter], prefix: pointer[const_char], base: pointer[Identifier], prim_id: int)
    {
        let host this.host
        let buf Array[u32]^host()
        var i: size_t 0
        while true
        {
            let b *((prefix as pointer[u8]) + i)
            if b = (0 as u8)
                break
            buf.add(b as u32)
            set i: i + 1
        }
        let nm base.get_name()
        let n nm.get_size()
        set i: 0
        while i < n
        {
            buf.add(nm.get(i))
            set i: i + (1 as size_t)
        }
        let pident this.lookup(StringC(buf.get_buffer(), buf.get_length()))
        let prim ELObj.make_primitive(host, Signature(0, 0, false), prim_id)
        prim.primitive_set_ident(pident)
        pident.set_definition(0xFFFFFFFF as u32, Location(), prim)
    }

    ; installInheritedCs — the generic entries of the reference registry
    ; (InheritedC.cxx) incl. the ignored characteristics (IgnoredC) and the
    ; maybe-integers; initial values transcribed at upi=72000. The full
    ; reference registry is installed (incl. color/background-color, the
    ; border and rule specials, glyph-subst-table, the opt-length-spec and
    ; inline-space entries).
    function install_inherited_cs(this: pointer[Interpreter])
    {
        let host this.host
        this.iicn("font-size", IC_LENGTH, "font-size", 0, 10000)
        this.iicstr("font-family-name", "font-family-name", 1, "iso-serif")
        this.iicsym("font-weight", "font-weight", 2, "medium")
        this.iicsym("font-posture", "font-posture", 3, "upright")
        this.iicsym("quadding", "quadding", 4, "start")
        this.iicsym("display-alignment", "display-alignment", 5, "start")
        this.iicsym("field-align", "field-align", 6, "start")
        this.iicsym("lines", "lines", 7, "wrap")
        this.iic("start-indent", IC_LENGTH_SPEC, "start-indent", 8)
        this.iic("first-line-start-indent", IC_LENGTH_SPEC, "first-line-start-indent", 9)
        this.iic("end-indent", IC_LENGTH_SPEC, "end-indent", 10)
        this.iic("last-line-end-indent", IC_LENGTH_SPEC, "last-line-end-indent", 11)
        this.iicn("line-spacing", IC_LENGTH_SPEC, "line-spacing", 12, 12000)
        this.iic("field-width", IC_LENGTH_SPEC, "field-width", 13)
        this.iic("left-margin", IC_LENGTH, "left-margin", 14)
        this.iic("right-margin", IC_LENGTH, "right-margin", 15)
        this.iic("top-margin", IC_LENGTH, "top-margin", 16)
        this.iic("bottom-margin", IC_LENGTH, "bottom-margin", 17)
        this.iic("header-margin", IC_LENGTH, "header-margin", 18)
        this.iic("footer-margin", IC_LENGTH, "footer-margin", 19)
        this.iicn("page-width", IC_LENGTH, "page-width", 20, 612000)
        this.iicn("page-height", IC_LENGTH, "page-height", 21, 792000)
        this.iicn("border-present?", IC_BOOL, "border-present", 22, 1)
        this.iicn("line-thickness", IC_LENGTH, "line-thickness", 23, 1000)
        this.iic("cell-before-row-margin", IC_LENGTH, "cell-before-row-margin", 24)
        this.iic("cell-after-row-margin", IC_LENGTH, "cell-after-row-margin", 25)
        this.iic("cell-before-column-margin", IC_LENGTH, "cell-before-column-margin", 26)
        this.iic("cell-after-column-margin", IC_LENGTH, "cell-after-column-margin", 27)
        this.iicn("line-sep", IC_LENGTH, "line-sep", 28, 1000)
        this.iicn("box-size-before", IC_LENGTH, "box-size-before", 29, 8000)
        this.iicn("box-size-after", IC_LENGTH, "box-size-after", 30, 4000)
        this.iic("position-point-shift", IC_LENGTH_SPEC, "position-point-shift", 31)
        this.iic("start-margin", IC_LENGTH_SPEC, "start-margin", 32)
        this.iic("end-margin", IC_LENGTH_SPEC, "end-margin", 33)
        this.iicn("sideline-sep", IC_LENGTH_SPEC, "sideline-sep", 34, 4000)
        this.iic("asis-wrap-indent", IC_LENGTH_SPEC, "asis-wrap-indent", 35)
        this.iic("line-number-sep", IC_LENGTH_SPEC, "line-number-sep", 36)
        this.iic("last-line-justify-limit", IC_LENGTH_SPEC, "last-line-justify-limit", 37)
        this.iic("justify-glyph-space-max-add", IC_LENGTH_SPEC, "justify-glyph-space-max-add", 38)
        this.iic("justify-glyph-space-max-remove", IC_LENGTH_SPEC, "justify-glyph-space-max-remove", 39)
        this.iicn("table-corner-radius", IC_LENGTH_SPEC, "table-corner-radius", 40, 3000)
        this.iicn("box-corner-radius", IC_LENGTH_SPEC, "box-corner-radius", 41, 3000)
        this.iic("marginalia-sep", IC_LENGTH_SPEC, "marginalia-sep", 42)
        this.iic("inhibit-line-breaks?", IC_BOOL, "inhibit-line-breaks?", 43)
        this.iic("hyphenate?", IC_BOOL, "hyphenate", 44)
        this.iic("kern?", IC_BOOL, "kern", 45)
        this.iic("ligature?", IC_BOOL, "ligature", 46)
        this.iic("score-spaces?", IC_BOOL, "score-spaces", 47)
        this.iic("float-out-sidelines?", IC_BOOL, "float-out-sidelines", 48)
        this.iic("float-out-marginalia?", IC_BOOL, "float-out-marginalia", 49)
        this.iic("float-out-line-numbers?", IC_BOOL, "float-out-line-numbers", 50)
        this.iic("cell-background?", IC_BOOL, "cell-background", 51)
        this.iic("span-weak?", IC_BOOL, "span-weak", 52)
        this.iic("ignore-record-end?", IC_BOOL, "ignore-record-end", 53)
        this.iicn("numbered-lines?", IC_BOOL, "numbered-lines", 54, 1)
        this.iic("hanging-punct?", IC_BOOL, "hanging-punct", 55)
        this.iic("box-open-end?", IC_BOOL, "box-open-end", 56)
        this.iic("truncate-leader?", IC_BOOL, "truncate-leader", 57)
        this.iicn("align-leader?", IC_BOOL, "align-leader", 58, 1)
        this.iic("table-part-omit-middle-header?", IC_BOOL, "table-part-omit-middle-header", 59)
        this.iic("table-part-omit-middle-footer?", IC_BOOL, "table-part-omit-middle-footer", 60)
        this.iic("border-omit-at-break?", IC_BOOL, "border-omit-at-break", 61)
        this.iic("principal-mode-simultaneous?", IC_BOOL, "principal-mode-simultaneous", 62)
        this.iic("marginalia-keep-with-previous?", IC_BOOL, "marginalia-keep-with-previous", 63)
        this.iic("grid-equidistant-rows?", IC_BOOL, "grid-equidistant-rows", 64)
        this.iic("grid-equidistant-columns?", IC_BOOL, "grid-equidistant-columns", 65)
        this.iicsym("line-join", "line-join", 66, "miter")
        this.iicsym("line-cap", "line-cap", 67, "butt")
        this.iicsym("line-number-side", "line-number-side", 68, "start")
        this.iicsym("kern-mode", "kern-mode", 69, "normal")
        this.iicsym("input-whitespace-treatment", "input-whitespace-treatment", 70, "preserve")
        this.iicsym("filling-direction", "filling-direction", 71, "top-to-bottom")
        this.iicsym("writing-mode", "writing-mode", 72, "left-to-right")
        this.iicsym("last-line-quadding", "last-line-quadding", 73, "relative")
        this.iicsym("math-display-mode", "math-display-mode", 74, "display")
        this.iicsym("script-pre-align", "script-pre-align", 75, "independent")
        this.iicsym("script-post-align", "script-post-align", 76, "independent")
        this.iicsym("script-mid-sup-align", "script-mid-sup-align", 77, "center")
        this.iicsym("script-mid-sub-align", "script-mid-sub-align", 78, "center")
        this.iicsym("numerator-align", "numerator-align", 79, "center")
        this.iicsym("denominator-align", "denominator-align", 80, "center")
        this.iicsym("grid-position-cell-type", "grid-position-cell-type", 81, "row-major")
        this.iicsym("grid-column-alignment", "grid-column-alignment", 82, "center")
        this.iicsym("grid-row-alignment", "grid-row-alignment", 83, "center")
        this.iicsym("box-type", "box-type", 84, "border")
        this.iicsym("glyph-alignment-mode", "glyph-alignment-mode", 85, "font")
        this.iicsym("box-border-alignment", "box-border-alignment", 86, "outside")
        this.iicsym("cell-row-alignment", "cell-row-alignment", 87, "start")
        this.iicsym("border-alignment", "border-alignment", 88, "center")
        this.iicsym("sideline-side", "sideline-side", 89, "start")
        this.iic("hyphenation-keep", IC_SYMBOL, "hyphenation-keep", 90)
        this.iicsym("font-structure", "font-structure", 91, "solid")
        this.iicsym("font-proportionate-width", "font-proportionate-width", 92, "medium")
        this.iic("cell-crossed", IC_SYMBOL, "cell-crossed", 93)
        this.iicsym("marginalia-side", "marginalia-side", 94, "start")
        this.iic("layer", IC_INT, "layer", 95)
        this.iicn("background-layer", IC_INT, "background-layer", 96, 0 - 1)
        this.iic("border-priority", IC_INT, "border-priority", 97)
        this.iicn("line-repeat", IC_INT, "line-repeat", 98, 1)
        this.iicn("span", IC_INT, "span", 99, 1)
        this.iicn("min-leader-repeat", IC_INT, "min-leader-repeat", 100, 1)
        this.iicn("hyphenation-remain-char-count", IC_INT, "hyphenation-remain-char-count", 101, 2)
        this.iicn("hyphenation-push-char-count", IC_INT, "hyphenation-push-char-count", 102, 2)
        this.iicn("widow-count", IC_INT, "widow-count", 103, 2)
        this.iicn("orphan-count", IC_INT, "orphan-count", 104, 2)
        this.iic("background-tile", IC_PUBLIC_ID, "background-tile", 105)
        this.iic("line-breaking-method", IC_PUBLIC_ID, "line-breaking-method", 106)
        this.iic("line-composition-method", IC_PUBLIC_ID, "line-composition-method", 107)
        this.iic("implicit-bidi-method", IC_PUBLIC_ID, "implicit-bidi-method", 108)
        this.iic("glyph-subst-method", IC_PUBLIC_ID, "glyph-subst-method", 109)
        this.iic("glyph-reorder-method", IC_PUBLIC_ID, "glyph-reorder-method", 110)
        this.iic("hyphenation-method", IC_PUBLIC_ID, "hyphenation-method", 111)
        this.iic("table-auto-width-method", IC_PUBLIC_ID, "table-auto-width-method", 112)
        this.iic("font-name", IC_PUBLIC_ID, "font-name", 113)
        this.iic("page-category", IC_SYMBOL, "page-category", 114)
        this.iic("force-last-page", IC_SYMBOL, "force-last-page", 115)
        this.iic("force-first-page", IC_SYMBOL, "force-first-page", 116)
        this.iic("first-page-type", IC_SYMBOL, "first-page-type", 117)
        this.iic("justify-spread?", IC_BOOL, "jystify-spread", 118)
        this.iic("binding-edge", IC_SYMBOL, "binding-edge", 119)
        this.iic("anchor-keep-with-previous?", IC_BOOL, "anchor-keep-with-previous", 120)
        this.iic("contents-alignment", IC_SYMBOL, "contents-alignment", 121)
        this.iic("overflow-action", IC_SYMBOL, "overflow-action", 122)
        this.iic("annotation-glyph-placement", IC_SYMBOL, "annotation-glyph-placement", 123)
        this.iic("annotation-glyph-style", IC_PUBLIC_ID, "annotation-glyph-style", 124)
        this.iicn("inline-note-line-count", IC_INT, "inline-note-line-count", 125, 2)
        this.iic("inline-note-style", IC_PUBLIC_ID, "inline-note-style", 126)
        this.iic("mark-distribution", IC_SYMBOL, "mark-distribution", 127)
        this.iic("mark-style", IC_PUBLIC_ID, "mark-style", 128)
        this.iic("side-by-side-overlap-control", IC_SYMBOL, "side-by-side-overlap-control", 129)
        this.iic("side-by-side-pre-align", IC_SYMBOL, "side-by-side-pre-align", 130)
        this.iic("side-by-side-post-align", IC_SYMBOL, "side-by-side-post-align", 131)
        this.iic("language", IC_LETTER2, "language", 132)
        this.iic("country", IC_LETTER2, "country", 133)
        ; #f or strictly positive integer
        this.iicn("expand-tabs?", IC_MAYBE_INT, "expand-tabs", 134, 8)
        this.iicn("hyphenation-ladder-count", IC_MAYBE_INT, "hyphenation-ladder-count", 135, 0)
        ; ignored characteristics (IgnoredC — accepted, never rendered)
        this.iicobj("line-miter-limit", "line-miter-limit", 136, ELObj.make_integer(host, 10))
        this.iicobj("alignment-point-offset", "alignment-point-offset", 137, ELObj.make_integer(host, 50))
        this.iicobj("hyphenation-char", "hyphenation-char", 138, ELObj.make_char(host, 0x2D as u32))
        this.iicobj("asis-truncate-char", "asis-truncate-char", 139, this.make_false())
        this.iicobj("asis-wrap-char", "asis-wrap-char", 140, this.make_false())
        this.iicobj("first-line-align", "first-line-align", 141, this.make_false())
        this.iicobj("hyphenation-exceptions", "hyphenation-exceptions", 142, ELObj.make_nil(host))
        this.iicobj("box-corner-rounded", "box-corner-rounded", 143, this.make_false())
        this.iicobj("table-corner-rounded", "table-corner-rounded", 144, this.make_false())
        this.iicobj("line-dash", "line-dash", 145, ELObj.make_pair(host, ELObj.make_length(host, 0), ELObj.make_nil(host)))
        this.iicobj("allowed-ligatures", "allowed-ligatures", 146, ELObj.make_nil(host))
        this.iicobj("line-number", "line-number", 147, this.make_false())
        this.iicobj("line-spacing-priority", "line-spacing-priority", 148, ELObj.make_integer(host, 0))
        this.iicobj("char-map", "char-map", 149, this.make_false())
        ; the border characteristics (BorderC) + the canned styles boolean
        ; border values resolve to (makeBorderStyle: one border-present? spec,
        ; the index of the entry installed above).
        set this.border_true_style_obj: this.make_border_style(true)
        set this.border_false_style_obj: this.make_border_style(false)
        this.iicborder("table-border", 150)
        this.iicborder("cell-before-row-border", 151)
        this.iicborder("cell-after-row-border", 152)
        this.iicborder("cell-before-column-border", 153)
        this.iicborder("cell-after-column-border", 154)
        ; color (ColorC, initial device-RGB black) + background-color
        ; (BackgroundColorC, initial #f).
        let color_ic this.make_proto_ic("color", IC_COLOR, "color", 155)
        set color_ic.obj: ELObj.make_color(host, 0, 0, 0)
        this.finish_ic(color_ic)
        let bg_ic this.make_proto_ic("background-color", IC_OPT_COLOR, "background-color", 156)
        this.finish_ic(bg_ic)
        ; #f or length-spec (GenericOptLengthSpecInheritedC; initial #f).
        let mpre this.make_proto_ic("min-pre-line-spacing", IC_OPT_LENGTH_SPEC, "min-pre-line-spacing", 157)
        set mpre.bval: true
        this.finish_ic(mpre)
        let mpost this.make_proto_ic("min-post-line-spacing", IC_OPT_LENGTH_SPEC, "min-post-line-spacing", 158)
        set mpost.bval: true
        this.finish_ic(mpost)
        let mlead this.make_proto_ic("min-leading", IC_OPT_LENGTH_SPEC, "min-leading", 159)
        set mlead.bval: true
        this.finish_ic(mlead)
        ; inline spaces (GenericInlineSpaceInheritedC; initial zero space).
        let esb this.make_proto_ic("escapement-space-before", IC_INLINE_SPACE, "escapement-space-before", 160)
        let esb_sp InlineSpace.make(host)
        set esb.obj: ELObj.make_inline_space(host, esb_sp as pointer[void])
        this.finish_ic(esb)
        let esa this.make_proto_ic("escapement-space-after", IC_INLINE_SPACE, "escapement-space-after", 161)
        let esa_sp InlineSpace.make(host)
        set esa.obj: ELObj.make_inline_space(host, esa_sp as pointer[void])
        this.finish_ic(esa)
        ; #f or inline-space (GenericOptInlineSpaceInheritedC; initial #f).
        let iss this.make_proto_ic("inline-space-space", IC_OPT_INLINE_SPACE, "inline-space-space", 162)
        this.finish_ic(iss)
        ; fraction-bar (RuleC; initial = the rule flow-object class binding —
        ; install_flow_objs runs first, reference order).
        let fb this.make_proto_ic("fraction-bar", IC_RULE, "fraction-bar", 163)
        let rident this.lookup(StringC("rule"))
        set fb.obj: rident.get_value_raw()
        this.finish_ic(fb)
        ; #f or glyph-subst-table (GlyphSubstTableC; initial #f = empty).
        let gst_ic this.make_proto_ic("glyph-subst-table", IC_GST, "glyph-subst-table", 164)
        set gst_ic.gst: Array[pointer[GlyphSubstTableRec]]^host()
        this.finish_ic(gst_ic)
    }

    function make_border_style(this: pointer[Interpreter], b: bool) returns pointer[ELObj]
    {
        let host this.host
        let bp this.lookup(StringC("border-present?"))
        let proto bp.get_inherited_c() as pointer[InheritedC]
        let ic InheritedC.make(host, IC_BOOL, bp, proto.get_index(), proto.print_name)
        set ic.bval: b
        let specs Array[pointer[InheritedC]]^host()
        specs.add(ic)
        let rec VarStyleRec.make(host, null, specs, null, null)
        ELObj.make_style(host, rec as pointer[void], null)
    }

    function border_true_style(this: pointer[Interpreter]) returns pointer[ELObj]
        border_true_style_obj

    function border_false_style(this: pointer[Interpreter]) returns pointer[ELObj]
        border_false_style_obj

    ; a BorderC registry entry (initial value #f; print name unused — set()
    ; renders nothing).
    function iicborder(this: pointer[Interpreter], name: pointer[const_char], index: int)
    {
        let ic this.make_proto_ic(name, IC_BORDER, name, index)
        set ic.obj: this.make_false()
        this.finish_ic(ic)
    }

    function set_extensions_on(on: bool)
        set xt_extensions_on: on

    ; installFlowObjs — the standard flow-object classes of this slice
    ; (reference installs all ~45 unconditionally; the rest land with their
    ; SgmlFOTBuilder methods).
    function install_flow_objs(this: pointer[Interpreter])
    {
        this.bind_flow_object_class(this.lookup(StringC("paragraph")), FOC_PARAGRAPH)
        this.bind_flow_object_class(this.lookup(StringC("paragraph-break")), FOC_PARAGRAPH_BREAK)
        this.bind_flow_object_class(this.lookup(StringC("display-group")), FOC_DISPLAY_GROUP)
        this.bind_flow_object_class(this.lookup(StringC("line-field")), FOC_LINE_FIELD)
        this.bind_flow_object_class(this.lookup(StringC("simple-page-sequence")), FOC_SIMPLE_PAGE_SEQUENCE)
        this.bind_flow_object_class(this.lookup(StringC("table")), FOC_TABLE)
        this.bind_flow_object_class(this.lookup(StringC("table-part")), FOC_TABLE_PART)
        this.bind_flow_object_class(this.lookup(StringC("table-column")), FOC_TABLE_COLUMN)
        this.bind_flow_object_class(this.lookup(StringC("table-row")), FOC_TABLE_ROW)
        this.bind_flow_object_class(this.lookup(StringC("table-cell")), FOC_TABLE_CELL)
        this.bind_flow_object_class(this.lookup(StringC("table-border")), FOC_TABLE_BORDER)
        this.bind_flow_object_class(this.lookup(StringC("rule")), FOC_RULE)
    }

    ; allocGlyphSubstTableUniqueId — the fot dump's gst<n> id counter.
    function alloc_gst_unique_id(this: pointer[Interpreter]) returns int
    {
        let n this.next_gst_unique_id
        set this.next_gst_unique_id: n + 1
        n
    }

    ; bind an identifier's VALUE to a FlowObjBox carrying `foc` (the DSSSL flow-
    ; object-class binding; NOT a new Identifier field — see ELObj FOC note).
    function bind_flow_object_class(this: pointer[Interpreter], ident: pointer[Identifier], foc: int)
    {
        let fo FlowObj.make(this.host, foc)
        let box ELObj.make_flowobj_box(this.host, fo)
        ident.set_definition(0xFFFFFFFF as u32, Location(), box)
    }

    ; installExtensionFlowObjectClass — bind an identifier to a transform flow
    ; object class keyed on its public id (the jade/dazzle-net extension table).
    ; The active backend decides whether the extension table is present
    ; (jade.cxx: only the transform backends pass extensions): with extensions
    ; off (-t fot), every id except the always-available formatting-instruction
    ; binds the reference's UnknownFlowObj (key-swallowing, content-
    ; transparent). An unrecognised id under the transform backends keeps the
    ; historical FOC_SEQUENCE fallback (corpus-validated).
    function install_extension_flow_object_class(this: pointer[Interpreter], ident: pointer[Identifier], public_id: StringC)
    {
        if xt_extensions_on = false
        {
            var xfoc FOC_UNKNOWN
            if public_id.equals(StringC("UNREGISTERED::James Clark//Flow Object Class::formatting-instruction"))
                set xfoc: FOC_FORMATTING_INSTRUCTION
            this.bind_flow_object_class(ident, xfoc)
            return
        }
        var foc FOC_SEQUENCE
        if public_id.equals(StringC("UNREGISTERED::James Clark//Flow Object Class::element"))
            set foc: FOC_ELEMENT
        else if public_id.equals(StringC("UNREGISTERED::James Clark//Flow Object Class::empty-element"))
            set foc: FOC_EMPTY_ELEMENT
        else if public_id.equals(StringC("UNREGISTERED::James Clark//Flow Object Class::entity"))
            set foc: FOC_ENTITY
        else if public_id.equals(StringC("UNREGISTERED::James Clark//Flow Object Class::entity-ref"))
            set foc: FOC_ENTITY_REF
        else if public_id.equals(StringC("UNREGISTERED::James Clark//Flow Object Class::processing-instruction"))
            set foc: FOC_PROCESSING_INSTRUCTION
        else if public_id.equals(StringC("UNREGISTERED::James Clark//Flow Object Class::document-type"))
            set foc: FOC_DOCUMENT_TYPE
        else if public_id.equals(StringC("UNREGISTERED::James Clark//Flow Object Class::formatting-instruction"))
            set foc: FOC_FORMATTING_INSTRUCTION
        else if public_id.equals(StringC("UNREGISTERED::Dazzle//Flow Object Class::directory"))
            set foc: FOC_DIRECTORY
        this.bind_flow_object_class(ident, foc)
    }

    ; --- primitives --------------------------------------------------------
    function install_primitive(this: pointer[Interpreter], name: pointer[const_char], prim_id: int, sig: Signature)
    {
        let ident this.lookup(StringC(name))
        let prim ELObj.make_primitive(this.host, sig, prim_id)
        prim.primitive_set_ident(ident)
        ident.set_definition(0xFFFFFFFF as u32, Location(), prim)
        ; every standard primitive is reachable via external-procedure under
        ; its ISO public id (reference installPrimitive).
        this.register_external_proc("ISO/IEC 10179:1996//Procedure::", name, prim)
    }

    ; installXPrimitive — an extension primitive: NOT bound to its identifier
    ; (only external-procedure reaches it), registered under prefix+name.
    function install_x_primitive(this: pointer[Interpreter], prefix: pointer[const_char], name: pointer[const_char], prim_id: int, sig: Signature)
    {
        let ident this.lookup(StringC(name))
        let prim ELObj.make_primitive(this.host, sig, prim_id)
        prim.primitive_set_ident(ident)
        this.register_external_proc(prefix, name, prim)
    }

    function register_external_proc(this: pointer[Interpreter], prefix: pointer[const_char], name: pointer[const_char], value: pointer[ELObj])
    {
        let host this.host
        let buf Array[u32]^host()
        var i: size_t 0
        while true
        {
            let b *((prefix as pointer[u8]) + i)
            if b = (0 as u8)
                break
            buf.add(b as u32)
            set i: i + 1
        }
        set i: 0
        while true
        {
            let b *((name as pointer[u8]) + i)
            if b = (0 as u8)
                break
            buf.add(b as u32)
            set i: i + 1
        }
        let pubid StringC^host(buf.get_buffer(), buf.get_length())
        this.external_proc_table.add(ExternalProc.make(host, pubid, value))
    }

    ; lookupExternalProc — external-procedure's table probe; null = unknown.
    function lookup_external_proc(this: pointer[Interpreter], pubid: StringC) returns pointer[ELObj]
    {
        let n this.external_proc_table.get_length()
        var i: size_t 0
        while i < n
        {
            let ep this.external_proc_table.get(i)
            if ep <> null
            {
                let e *ep
                if e.pubid.equals(pubid)
                    return e.value
            }
            set i: i + (1 as size_t)
        }
        null
    }

    ; installPrimitives (Interpreter.cs). Inc-3 starter batch: the pure-ELObj
    ; primitives. String/char/vector and grove/sosofo/style primitives join
    ; with their machinery.
    function install_primitives(this: pointer[Interpreter])
    {
        this.install_primitive("cons", PRIM_CONS, Signature(2, 0, false))
        this.install_primitive("list", PRIM_LIST, Signature(0, 0, true))
        this.install_primitive("car", PRIM_CAR, Signature(1, 0, false))
        this.install_primitive("cdr", PRIM_CDR, Signature(1, 0, false))
        this.install_primitive("null?", PRIM_IS_NULL, Signature(1, 0, false))
        this.install_primitive("pair?", PRIM_IS_PAIR, Signature(1, 0, false))
        this.install_primitive("list?", PRIM_IS_LIST, Signature(1, 0, false))
        this.install_primitive("length", PRIM_LENGTH, Signature(1, 0, false))
        this.install_primitive("append", PRIM_APPEND, Signature(0, 0, true))
        this.install_primitive("reverse", PRIM_REVERSE, Signature(1, 0, false))
        this.install_primitive("list-ref", PRIM_LIST_REF, Signature(2, 0, false))
        this.install_primitive("memq", PRIM_MEMQ, Signature(2, 0, false))
        this.install_primitive("memv", PRIM_MEMV, Signature(2, 0, false))
        this.install_primitive("member", PRIM_MEMBER, Signature(2, 0, false))
        this.install_primitive("assq", PRIM_ASSQ, Signature(2, 0, false))
        this.install_primitive("equal?", PRIM_IS_EQUAL, Signature(2, 0, false))
        this.install_primitive("eqv?", PRIM_IS_EQV, Signature(2, 0, false))
        this.install_primitive("not", PRIM_NOT, Signature(1, 0, false))
        this.install_primitive("+", PRIM_PLUS, Signature(0, 0, true))
        this.install_primitive("-", PRIM_MINUS, Signature(1, 0, true))
        this.install_primitive("*", PRIM_TIMES, Signature(0, 0, true))
        this.install_primitive("/", PRIM_DIVIDE, Signature(1, 0, true))
        this.install_primitive("=", PRIM_NUM_EQ, Signature(0, 0, true))
        this.install_primitive("<", PRIM_LESS, Signature(0, 0, true))
        this.install_primitive(">", PRIM_GREATER, Signature(0, 0, true))
        this.install_primitive("<=", PRIM_LESS_EQ, Signature(0, 0, true))
        this.install_primitive(">=", PRIM_GREATER_EQ, Signature(0, 0, true))
        this.install_primitive("zero?", PRIM_IS_ZERO, Signature(1, 0, false))
        this.install_primitive("positive?", PRIM_IS_POSITIVE, Signature(1, 0, false))
        this.install_primitive("negative?", PRIM_IS_NEGATIVE, Signature(1, 0, false))
        this.install_primitive("odd?", PRIM_IS_ODD, Signature(1, 0, false))
        this.install_primitive("even?", PRIM_IS_EVEN, Signature(1, 0, false))
        this.install_primitive("abs", PRIM_ABS, Signature(1, 0, false))
        this.install_primitive("modulo", PRIM_MODULO, Signature(2, 0, false))
        this.install_primitive("remainder", PRIM_REMAINDER, Signature(2, 0, false))
        this.install_primitive("quotient", PRIM_QUOTIENT, Signature(2, 0, false))
        this.install_primitive("number?", PRIM_IS_NUMBER, Signature(1, 0, false))
        this.install_primitive("integer?", PRIM_IS_INTEGER, Signature(1, 0, false))
        this.install_primitive("real?", PRIM_IS_REAL, Signature(1, 0, false))
        this.install_primitive("string?", PRIM_IS_STRING, Signature(1, 0, false))
        this.install_primitive("symbol?", PRIM_IS_SYMBOL, Signature(1, 0, false))
        this.install_primitive("char?", PRIM_IS_CHAR, Signature(1, 0, false))
        this.install_primitive("boolean?", PRIM_IS_BOOLEAN, Signature(1, 0, false))
        this.install_primitive("procedure?", PRIM_IS_PROCEDURE, Signature(1, 0, false))
        this.install_primitive("vector?", PRIM_IS_VECTOR, Signature(1, 0, false))
        this.install_primitive("keyword?", PRIM_IS_KEYWORD, Signature(1, 0, false))
        ; --- string / char / symbol / keyword / vector --------------------
        this.install_primitive("symbol->string", PRIM_SYMBOL_TO_STRING, Signature(1, 0, false))
        this.install_primitive("string->symbol", PRIM_STRING_TO_SYMBOL, Signature(1, 0, false))
        this.install_primitive("keyword->string", PRIM_KEYWORD_TO_STRING, Signature(1, 0, false))
        this.install_primitive("string->keyword", PRIM_STRING_TO_KEYWORD, Signature(1, 0, false))
        this.install_primitive("string-append", PRIM_STRING_APPEND, Signature(0, 0, true))
        this.install_primitive("string-length", PRIM_STRING_LENGTH, Signature(1, 0, false))
        this.install_primitive("string-ref", PRIM_STRING_REF, Signature(2, 0, false))
        this.install_primitive("substring", PRIM_SUBSTRING, Signature(3, 0, false))
        this.install_primitive("string", PRIM_STRING, Signature(0, 0, true))
        this.install_primitive("string=?", PRIM_STRING_EQUAL, Signature(2, 0, false))
        this.install_primitive("string<?", PRIM_STRING_LESS, Signature(2, 0, false))
        this.install_primitive("string<=?", PRIM_STRING_LESS_EQ, Signature(2, 0, false))
        this.install_primitive("string->list", PRIM_STRING_TO_LIST, Signature(1, 0, false))
        this.install_primitive("list->string", PRIM_LIST_TO_STRING, Signature(1, 0, false))
        this.install_primitive("string->number", PRIM_STRING_TO_NUMBER, Signature(1, 1, false))
        this.install_primitive("number->string", PRIM_NUMBER_TO_STRING, Signature(1, 1, false))
        this.install_primitive("char->integer", PRIM_CHAR_TO_INTEGER, Signature(1, 0, false))
        this.install_primitive("integer->char", PRIM_INTEGER_TO_CHAR, Signature(1, 0, false))
        this.install_primitive("char<?", PRIM_CHAR_LESS, Signature(2, 0, false))
        this.install_primitive("char<=?", PRIM_CHAR_LESS_EQ, Signature(2, 0, false))
        this.install_primitive("char=?", PRIM_CHAR_EQUAL, Signature(2, 0, false))
        this.install_primitive("char-upcase", PRIM_CHAR_UPCASE, Signature(1, 0, false))
        this.install_primitive("char-downcase", PRIM_CHAR_DOWNCASE, Signature(1, 0, false))
        this.install_primitive("make-vector", PRIM_MAKE_VECTOR, Signature(1, 1, false))
        this.install_primitive("vector", PRIM_VECTOR, Signature(0, 0, true))
        this.install_primitive("vector-ref", PRIM_VECTOR_REF, Signature(2, 0, false))
        this.install_primitive("vector-set!", PRIM_VECTOR_SET, Signature(3, 0, false))
        this.install_primitive("vector-length", PRIM_VECTOR_LENGTH, Signature(1, 0, false))
        this.install_primitive("vector->list", PRIM_VECTOR_TO_LIST, Signature(1, 0, false))
        this.install_primitive("list->vector", PRIM_LIST_TO_VECTOR, Signature(1, 0, false))
        this.install_primitive("list-tail", PRIM_LIST_TAIL, Signature(2, 0, false))
        ; --- grove / node-list (Inc 4) ------------------------------------
        this.install_primitive("node-list?", PRIM_IS_NODE_LIST, Signature(1, 0, false))
        this.install_primitive("node-list-empty?", PRIM_NODE_LIST_EMPTY, Signature(1, 0, false))
        this.install_primitive("node-list-length", PRIM_NODE_LIST_LENGTH, Signature(1, 0, false))
        this.install_primitive("node-list-first", PRIM_NODE_LIST_FIRST, Signature(1, 0, false))
        this.install_primitive("node-list-rest", PRIM_NODE_LIST_REST, Signature(1, 0, false))
        this.install_primitive("node-list-ref", PRIM_NODE_LIST_REF, Signature(2, 0, false))
        this.install_primitive("empty-node-list", PRIM_EMPTY_NODE_LIST, Signature(0, 0, false))
        this.install_primitive("node-list", PRIM_NODE_LIST, Signature(0, 0, true))
        this.install_primitive("children", PRIM_CHILDREN, Signature(1, 0, false))
        this.install_primitive("gi", PRIM_GI, Signature(1, 0, false))
        this.install_primitive("data", PRIM_DATA, Signature(1, 0, false))
        ; --- grove / property axis (Inc 4) --------------------------------
        this.install_primitive("parent", PRIM_PARENT, Signature(1, 0, false))
        this.install_primitive("attribute-string", PRIM_ATTRIBUTE_STRING, Signature(2, 0, false))
        this.install_primitive("ancestor", PRIM_ANCESTOR, Signature(2, 0, false))
        this.install_primitive("descendants", PRIM_DESCENDANTS, Signature(1, 0, false))
        this.install_primitive("sosofo?", PRIM_IS_SOSOFO, Signature(1, 0, false))
        this.install_primitive("empty-sosofo", PRIM_EMPTY_SOSOFO, Signature(0, 0, false))
        this.install_primitive("sosofo-append", PRIM_SOSOFO_APPEND, Signature(0, 0, true))
        this.install_primitive("process-children", PRIM_PROCESS_CHILDREN, Signature(0, 0, false))
        this.install_primitive("process-children-trim", PRIM_PROCESS_CHILDREN_TRIM, Signature(0, 0, false))
        this.install_primitive("process-node-list", PRIM_PROCESS_NODE_LIST, Signature(1, 0, false))
        this.install_primitive("current-node", PRIM_CURRENT_NODE, Signature(0, 0, false))
        this.install_primitive("literal", PRIM_LITERAL, Signature(1, 0, false))
        this.install_primitive("next-match", PRIM_NEXT_MATCH, Signature(0, 0, false))
        this.install_primitive("process-node", PRIM_PROCESS_NODE, Signature(1, 0, false))
        this.install_primitive("select-elements", PRIM_SELECT_ELEMENTS, Signature(2, 0, false))
        this.install_primitive("element-with-id", PRIM_ELEMENT_WITH_ID, Signature(1, 1, false))
        this.install_primitive("id", PRIM_ID, Signature(0, 1, false))
        this.install_primitive("first-sibling?", PRIM_IS_FIRST_SIBLING, Signature(0, 1, false))
        this.install_primitive("last-sibling?", PRIM_IS_LAST_SIBLING, Signature(0, 1, false))
        this.install_primitive("child-number", PRIM_CHILD_NUMBER, Signature(0, 1, false))
        this.install_primitive("node-list=?", PRIM_IS_NODE_LIST_EQUAL, Signature(2, 0, false))
        this.install_primitive("node-list-map", PRIM_NODE_LIST_MAP, Signature(2, 0, false))
        this.install_primitive("node-list-reverse", PRIM_NODE_LIST_REVERSE, Signature(1, 0, false))
        ; reference PRIMITIVE(NodeProperty, "node-property", 2, 0, 1) — the
        ; keyword args (default:/null:/rcs?) arrive through the rest slot.
        this.install_primitive("node-property", PRIM_NODE_PROPERTY, Signature(2, 0, true))
        this.install_primitive("page-number-sosofo", PRIM_PAGE_NUMBER_SOSOFO, Signature(0, 0, false))
        this.install_primitive("current-node-page-number-sosofo", PRIM_CURRENT_NODE_PAGE_NUMBER_SOSOFO, Signature(0, 0, false))
        this.install_primitive("format-number", PRIM_FORMAT_NUMBER, Signature(2, 0, false))
        this.install_primitive("format-number-list", PRIM_FORMAT_NUMBER_LIST, Signature(3, 0, false))
        this.install_primitive("external-procedure", PRIM_EXTERNAL_PROCEDURE, Signature(1, 0, false))
        ; length-spec / space / color (Family-B front)
        this.install_primitive("display-size", PRIM_DISPLAY_SIZE, Signature(0, 0, false))
        this.install_primitive("table-unit", PRIM_TABLE_UNIT, Signature(1, 0, false))
        this.install_primitive("display-space?", PRIM_IS_DISPLAY_SPACE, Signature(1, 0, false))
        this.install_primitive("display-space", PRIM_DISPLAY_SPACE, Signature(1, 0, true))
        this.install_primitive("inline-space?", PRIM_IS_INLINE_SPACE, Signature(1, 0, false))
        this.install_primitive("inline-space", PRIM_INLINE_SPACE, Signature(1, 0, true))
        this.install_primitive("color?", PRIM_IS_COLOR, Signature(1, 0, false))
        this.install_primitive("color-space?", PRIM_IS_COLOR_SPACE, Signature(1, 0, false))
        this.install_primitive("color", PRIM_COLOR, Signature(1, 0, true))
        this.install_primitive("color-space", PRIM_COLOR_SPACE, Signature(1, 0, true))
        ; glyph ids / glyph substitution tables
        this.install_primitive("glyph-id?", PRIM_IS_GLYPH_ID, Signature(1, 0, false))
        this.install_primitive("glyph-id", PRIM_GLYPH_ID, Signature(1, 0, false))
        this.install_primitive("glyph-subst-table?", PRIM_IS_GLYPH_SUBST_TABLE, Signature(1, 0, false))
        this.install_primitive("glyph-subst-table", PRIM_GLYPH_SUBST_TABLE, Signature(1, 0, false))
        this.install_primitive("glyph-subst", PRIM_GLYPH_SUBST, Signature(2, 0, false))
        ; XPRIMITIVEs — reachable only via external-procedure (Clark prefix).
        this.install_x_primitive("UNREGISTERED::James Clark//Procedure::", "if-first-page", PRIM_IF_FIRST_PAGE, Signature(2, 0, false))
        this.install_x_primitive("UNREGISTERED::James Clark//Procedure::", "if-front-page", PRIM_IF_FRONT_PAGE, Signature(2, 0, false))
        ; apply and call/cc are FunctionObj subclasses (custom call/tailCall),
        ; not PrimitiveObj — install the dedicated arms.
        this.install_apply()
        this.install_call_cc()
    }

    ; ApplyPrimitiveObj / CallWithCurrentContinuationPrimitiveObj — bound as
    ; the ApplyFn / CallCCFn ELObj arms whose call() reshuffles / captures.
    function install_apply(this: pointer[Interpreter])
    {
        let ident this.lookup(StringC("apply"))
        let fn ELObj.make_apply_fn(this.host)
        ident.set_definition(0xFFFFFFFF as u32, Location(), fn)
    }

    function install_call_cc(this: pointer[Interpreter])
    {
        let fn ELObj.make_callcc_fn(this.host)
        let id1 this.lookup(StringC("call-with-current-continuation"))
        id1.set_definition(0xFFFFFFFF as u32, Location(), fn)
        let id2 this.lookup(StringC("call/cc"))
        id2.set_definition(0xFFFFFFFF as u32, Location(), fn)
    }

    ; --- named characters --------------------------------------------------
    function lookup_char_entry(t: pointer[Array[pointer[CharPart]]], name: StringC) returns pointer[CharPart]
    {
        let n t.get_length()
        let buf t.get_buffer()
        var i: size_t 0
        while i < n
        {
            let p *(buf + i)
            if p.name.equals(name)
                return p
            set i: i + 1
        }
        null
    }

    function insert_char_entry(this: pointer[Interpreter], t: pointer[Array[pointer[CharPart]]], name: StringC, c: u32, def_part: u32)
    {
        let existing Interpreter.lookup_char_entry(t, name)
        if existing <> null
        {
            set existing.c: c
            set existing.def_part: def_part
            return
        }
        let host this.host
        let e host.allocate(sizeof CharPart, alignof CharPart) as pointer[CharPart]
        set e.name: StringC^host(name.data_ptr(), name.get_size())
        set e.c: c
        set e.def_part: def_part
        t.add(e)
    }

    ; the generated CharNames/Sdata tables install through these (defPart -1)
    function def_char(this: pointer[Interpreter], name: pointer[const_char], c: u32)
        this.insert_char_entry(this.named_char_table, StringC(name), c, 0xFFFFFFFF as u32)

    function def_sdata_char(this: pointer[Interpreter], name: pointer[const_char], c: u32)
        this.insert_char_entry(this.sdata_entity_name_table, StringC(name), c, 0xFFFFFFFF as u32)

    ; bool convertCharName(const StringC &str, Char &c)
    function convert_char_name(this: Interpreter, str: StringC, c: pointer[u32]) returns bool
    {
        let cp Interpreter.lookup_char_entry(named_char_table, str)
        if cp <> null
        {
            set *c: cp.c
            return true
        }
        Interpreter.convert_unicode_char_name(str, c)
    }

    ; static bool convertUnicodeCharName(const StringC &str, Char &c): U-XXXX
    function convert_unicode_char_name(str: StringC, c: pointer[u32]) returns bool
    {
        if str.get_size() <> (6 as size_t)
            return false
        if str.get(0 as size_t) <> (0x55 as u32)
            return false
        if str.get(1 as size_t) <> (0x2D as u32)
            return false
        var value: u32 0
        var i: size_t 2
        while i < (6 as size_t)
        {
            let ch str.get(i)
            set value: value << (4 as u32)
            if (ch >= (0x30 as u32)) and (ch <= (0x39 as u32))
                set value: value | (ch - (0x30 as u32))
            else if (ch >= (0x41 as u32)) and (ch <= (0x46 as u32))
                set value: value | ((10 as u32) + (ch - (0x41 as u32)))
            else
                return false
            set i: i + 1
        }
        set *c: value
        true
    }

    ; --- declaration hooks (style-specification declaration elements) ------
    ; void setCharRepertoire(const StringC &pubid)
    function set_char_repertoire(this: pointer[Interpreter], pubid: StringC)
    {
        if pubid.equals(StringC("UNREGISTERED::OpenJade//Character Repertoire::OpenJade"))
        {
            if this.strict_mode
            {
                CharNames.install(this)
                Sdata.install(this)
                this.lex_category_table.set_range(127 as u32, 0xFFFF as u32, LEX_ADD_NAME_START as u8)
                set this.strict_mode: false
            }
        }
        else
            this.message1(InterpreterMessages.unsupportedCharRepertoire(), pubid)
    }

    ; void addStandardChar(const StringC &name, const StringC &num)
    function add_standard_char(this: pointer[Interpreter], name: StringC, num: StringC)
    {
        var n 0
        var i: size_t 0
        if Interpreter.scan_sign_digits(num, &i, &n) = false
        {
            this.message1(InterpreterMessages.invalidCharNumber(), num)
            return
        }
        let def Interpreter.lookup_char_entry(this.named_char_table, name)
        if def <> null
        {
            if this.d_part_index < def.def_part
                this.insert_char_entry(this.named_char_table, name, n as u32, this.d_part_index)
            else if (def.def_part = this.d_part_index) and (def.c <> (n as u32))
                this.message1(InterpreterMessages.duplicateCharName(), name)
        }
        else
            this.insert_char_entry(this.named_char_table, name, n as u32, this.d_part_index)
    }

    ; void addNameChar(const StringC &name)
    function add_name_char(this: pointer[Interpreter], name: StringC)
    {
        let cp Interpreter.lookup_char_entry(this.named_char_table, name)
        if cp = null
        {
            this.message1(InterpreterMessages.badCharName(), name)
            return
        }
        if (this.lex_category_table.get(cp.c as i32) as int) <> LEX_OTHER
        {
            this.message0(InterpreterMessages.badDeclaration())
            return
        }
        this.lex_category_table.set_char(cp.c, LEX_ADD_NAME_START as u8)
    }

    ; void addSeparatorChar(const StringC &name)
    function add_separator_char(this: pointer[Interpreter], name: StringC)
    {
        let cp Interpreter.lookup_char_entry(this.named_char_table, name)
        if cp = null
        {
            this.message1(InterpreterMessages.badCharName(), name)
            return
        }
        if (this.lex_category_table.get(cp.c as i32) as int) <> LEX_OTHER
        {
            this.message0(InterpreterMessages.badDeclaration())
            return
        }
        this.lex_category_table.set_char(cp.c, LEX_ADD_WHITESPACE as u8)
    }

    ; void addSdataEntity(const StringC &ename, const StringC &etext, const StringC &name)
    function add_sdata_entity(this: pointer[Interpreter], ename: StringC, etext: StringC, name: StringC)
    {
        let cp Interpreter.lookup_char_entry(this.named_char_table, name)
        if cp = null
        {
            this.message1(InterpreterMessages.badCharName(), name)
            return
        }
        if ename.get_size() > (0 as size_t)
        {
            let def Interpreter.lookup_char_entry(this.sdata_entity_name_table, ename)
            if def <> null
            {
                if this.d_part_index < def.def_part
                    this.insert_char_entry(this.sdata_entity_name_table, ename, cp.c, this.d_part_index)
                else if (def.def_part = this.d_part_index) and (def.c <> cp.c)
                    this.message1(InterpreterMessages.duplicateSdataEntityName(), ename)
            }
            else
                this.insert_char_entry(this.sdata_entity_name_table, ename, cp.c, this.d_part_index)
        }
        if etext.get_size() > (0 as size_t)
        {
            let def Interpreter.lookup_char_entry(this.sdata_entity_text_table, etext)
            if def <> null
            {
                if this.d_part_index < def.def_part
                    this.insert_char_entry(this.sdata_entity_text_table, etext, cp.c, this.d_part_index)
                else if (def.def_part = this.d_part_index) and (def.c <> cp.c)
                    this.message1(InterpreterMessages.duplicateSdataEntityText(), etext)
            }
            else
                this.insert_char_entry(this.sdata_entity_text_table, etext, cp.c, this.d_part_index)
        }
    }

    ; --- number conversion -------------------------------------------------
    ; static bool scanSignDigits(const StringC &, size_t &i, int &n)
    function scan_sign_digits(str: StringC, i: pointer[size_t], n: pointer[int]) returns bool
    {
        var negative false
        if *i < str.get_size()
        {
            if str.get(*i) = (0x2D as u32)
            {
                set *i: *i + (1 as size_t)
                set negative: true
            }
            else if str.get(*i) = (0x2B as u32)
                set *i: *i + (1 as size_t)
        }
        let j *i
        var v 0
        while *i < str.get_size()
        {
            let ch str.get(*i)
            if (ch < (0x30 as u32)) or (ch > (0x39 as u32))
                break
            if negative
                set v: v * 10 - ((ch - (0x30 as u32)) as int)
            else
                set v: v * 10 + ((ch - (0x30 as u32)) as int)
            set *i: *i + (1 as size_t)
        }
        set *n: v
        *i <> j
    }

    ; ELObj *convertNumber(const StringC &str, int radix = 10)
    function convert_number(this: pointer[Interpreter], str: StringC) returns pointer[ELObj]
        this.convert_number_radix(str, 10)

    function convert_number_radix(this: pointer[Interpreter], str: StringC, radix_in: int) returns pointer[ELObj]
    {
        var radix radix_in
        if str.get_size() = (0 as size_t)
            return null
        var i: size_t 0
        if str.get(0 as size_t) = (0x23 as u32)
        {
            ; '#' radix prefix: #d #x #o #b
            if str.get_size() < (2 as size_t)
                return null
            let r str.get(1 as size_t)
            if r = (0x64 as u32)
                set radix: 10
            else if r = (0x78 as u32)
                set radix: 16
            else if r = (0x6F as u32)
                set radix: 8
            else if r = (0x62 as u32)
                set radix: 2
            else
                return null
            set i: i + (2 as size_t)
        }
        if i >= str.get_size()
            return null
        var negative false
        if str.get(i) = (0x2D as u32)
        {
            set negative: true
            set i: i + (1 as size_t)
        }
        else
        {
            if str.get(i) = (0x2B as u32)
                set i: i + (1 as size_t)
        }
        var had_decimal_point false
        var had_digit false
        var n 0
        var exp 0
        let long_max 0x7FFFFFFFFFFFFFFF
        while i < str.get_size()
        {
            let c str.get(i)
            var weight 0 - 1
            if (c >= (0x30 as u32)) and (c <= (0x39 as u32))
                set weight: (c - (0x30 as u32)) as int
            else if (c >= (0x61 as u32)) and (c <= (0x66 as u32))
                set weight: ((c - (0x61 as u32)) as int) + 10
            if (weight >= 0) and (weight < radix)
            {
                set had_digit: true
                if negative
                {
                    ; -(unsigned long)n > (-(unsigned long)LONG_MIN - weight)/radix
                    let neg_n (0 as u64) - (n as u64)
                    let neg_min (long_max as u64) + (1 as u64)
                    if neg_n > (neg_min - (weight as u64)) / (radix as u64)
                    {
                        if radix <> 10
                            return null
                        return this.convert_number_float(str)
                    }
                    set n: n * radix - weight
                }
                else
                {
                    if n > (long_max - weight) / radix
                    {
                        if radix <> 10
                            return null
                        return this.convert_number_float(str)
                    }
                    set n: n * radix + weight
                }
                if had_decimal_point
                    set exp: exp - 1
            }
            else if (c = (0x2E as u32)) and (radix = 10)
            {
                if had_decimal_point
                    return null
                set had_decimal_point: true
            }
            else
                break
            set i: i + (1 as size_t)
        }
        if had_digit = false
            return null
        if (radix <> 10) and (i < str.get_size())
            return null
        if (i + (1 as size_t)) < str.get_size()
        {
            if str.get(i) = (0x65 as u32)
            {
                ; 'e' exponent — but not when a letter follows ("1em" is a
                ; quantity in the em unit)
                if (this.lex_category_table.get(str.get(i + (1 as size_t)) as i32) as int) <> LEX_LETTER
                {
                    set had_decimal_point: true
                    set i: i + (1 as size_t)
                    var e 0
                    if Interpreter.scan_sign_digits(str, &i, &e) = false
                        return null
                    set exp: exp + e
                }
            }
        }
        if i < str.get_size()
        {
            var unit_exp 0
            let unit this.scan_unit(str, i, &unit_exp)
            if unit = null
                return null
            if unit_exp = 1
                return ELObj.make_unresolved_length(this.host, n, exp, unit)
            return this.convert_number_float(str)
        }
        if had_decimal_point
            return this.convert_number_float(str)
        ELObj.make_integer(this.host, n)
    }

    ; ELObj *convertNumberFloat(const StringC &str)
    function convert_number_float(this: pointer[Interpreter], str: StringC) returns pointer[ELObj]
    {
        ; omit an optional #d radix prefix
        var i0: size_t 0
        if str.get_size() > (1 as size_t)
        {
            if (str.get(0 as size_t) = (0x23 as u32)) and (str.get(1 as size_t) = (0x64 as u32))
                set i0: 2
        }
        let host this.host
        let cap (str.get_size() + (1 as size_t)) - i0
        let buf host.allocate(cap, 1 as size_t) as pointer[u8]
        var w: size_t 0
        var i i0
        while i < str.get_size()
        {
            let c str.get(i)
            if (c > (127 as u32)) or (c = (0 as u32))
                return null
            ; 'E' is a valid exponent marker for C but not for us
            if c = (0x45 as u32)
                break
            set *(buf + w): c as u8
            set w: w + (1 as size_t)
            set i: i + 1
        }
        set *(buf + w): 0 as u8
        var endp: pointer[u8] null
        let val strtod(buf as pointer[const_char], &endp)
        let consumed (endp as size_t) - (buf as size_t)
        if consumed = (str.get_size() - i0)
            return ELObj.make_real(host, val)
        if consumed = (0 as size_t)
            return null
        var unit_exp 0
        let unit this.scan_unit(str, consumed + i0, &unit_exp)
        if unit = null
            return null
        ELObj.make_unresolved_quantity(host, val, unit, unit_exp)
    }

    ; Unit *scanUnit(const StringC &str, size_t i, int &unitExp) — null on error.
    function scan_unit(this: pointer[Interpreter], str: StringC, i_in: size_t, unit_exp: pointer[int]) returns pointer[Unit]
    {
        let host this.host
        var i i_in
        let name_chars Array[u32]^host()
        while i < str.get_size()
        {
            let c str.get(i)
            if (c = (0x2D as u32)) or (c = (0x2B as u32)) or ((c >= (0x30 as u32)) and (c <= (0x39 as u32)))
                break
            name_chars.add(c)
            set i: i + 1
        }
        if i >= str.get_size()
            set *unit_exp: 1
        else
        {
            var e 0
            var neg false
            if (str.get(i) = (0x2D as u32)) or (str.get(i) = (0x2B as u32))
            {
                if str.get(i) = (0x2D as u32)
                    set neg: true
                set i: i + 1
                if i >= str.get_size()
                    return null
            }
            while i < str.get_size()
            {
                let c str.get(i)
                if (c < (0x30 as u32)) or (c > (0x39 as u32))
                    return null
                set e: e * 10
                if neg
                    set e: e - ((c - (0x30 as u32)) as int)
                else
                    set e: e + ((c - (0x30 as u32)) as int)
                set i: i + 1
            }
            set *unit_exp: e
        }
        let unit_name StringC^host(name_chars.get_buffer(), name_chars.get_length())
        this.lookup_unit(unit_name)
    }

    ; --- Messenger seam ----------------------------------------------------
    function set_next_location(this: pointer[Interpreter], loc: Location)
        set this.next_loc: loc

    function get_error_count(this: Interpreter) returns int
        error_count

    function message0(this: pointer[Interpreter], mt: MessageType)
    {
        let args Vector[MessageArg]()
        this.emit(mt, args)
    }

    function message1(this: pointer[Interpreter], mt: MessageType, a1: StringC)
    {
        var args Vector[MessageArg](1 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Str(a1)
        this.emit(mt, args)
    }

    function message2(this: pointer[Interpreter], mt: MessageType, a1: StringC, a2: StringC)
    {
        var args Vector[MessageArg](2 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Str(a1)
        set *(args.get(1 as size_t)): MessageArg.Str(a2)
        this.emit(mt, args)
    }

    ; NumberMessageArg shape (stackTraceEllipsis's omitted-call count): %1
    ; renders unquoted.
    function message_num(this: pointer[Interpreter], mt: MessageType, n: u64)
    {
        var args Vector[MessageArg](1 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Num(n)
        this.emit(mt, args)
    }

    function get_debug_mode(this: Interpreter) returns bool
        debug_mode

    ; MessageType3 shape of PrimitiveObj::argError: %1 primitive name,
    ; %2 ordinal, %3 printed object.
    function message3(this: pointer[Interpreter], mt: MessageType, a1: StringC, ord2: u64, a3: StringC)
    {
        var args Vector[MessageArg](3 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Str(a1)
        set *(args.get(1 as size_t)): MessageArg.Ord(ord2)
        set *(args.get(2 as size_t)): MessageArg.Str(a3)
        this.emit(mt, args)
    }

    ; --- self-test ---------------------------------------------------------
    function test() returns int
    {
        let anchor StringC("x")
        let host Page.get(anchor.data_ptr() as pointer[void])
        ; jade's default: twips (20*72 units per inch)
        let interp Interpreter.make(host, 1440, false, false, false)

        ; integer conversion incl. radix prefixes
        let a interp.convert_number(StringC("42"))
        if a = null
            return 1
        if a.exact_integer_value() <> 42
            return 2
        let b interp.convert_number(StringC("-17"))
        if b.exact_integer_value() <> (0 - 17)
            return 3
        let c interp.convert_number(StringC("#x1a"))
        if c.exact_integer_value() <> 26
            return 4
        let d interp.convert_number(StringC("#b101"))
        if d.exact_integer_value() <> 5
            return 5
        let e interp.convert_number(StringC("#o17"))
        if e.exact_integer_value() <> 15
            return 6
        let f interp.convert_number(StringC("+5"))
        if f.exact_integer_value() <> 5
            return 7

        ; reals
        let g interp.convert_number(StringC("1.5"))
        if g.is_inexact_real() = false
            return 8
        if g.real_value() <> 1.5
            return 9
        let h interp.convert_number(StringC("1.5e2"))
        if h.real_value() <> 150.0
            return 10

        ; malformed
        if interp.convert_number(StringC("1.2.3")) <> null
            return 11
        if interp.convert_number(StringC("#xg")) <> null
            return 12

        ; quantities: builtin units are precomputed from unitsPerInch, so
        ; resolve_quantities completes without the VM
        let q interp.convert_number(StringC("2in"))
        if q = null
            return 13
        let rq q.resolve_quantities(false, interp, Location())
        if rq.is_length() = false
            return 14
        if rq.length_value() <> 2880
            return 15
        let q2 interp.convert_number(StringC("3pt"))
        let rq2 q2.resolve_quantities(false, interp, Location())
        if rq2.length_value() <> 60
            return 16

        ; char names: the generated table + U-XXXX
        var ch: u32 0
        if interp.convert_char_name(StringC("space"), &ch) = false
            return 17
        if ch <> (0x20 as u32)
            return 18
        if interp.convert_char_name(StringC("U-0041"), &ch) = false
            return 19
        if ch <> (0x41 as u32)
            return 20
        if interp.convert_char_name(StringC("no-such-name"), &ch)
            return 21

        ; interning: one Identifier / SymbolObj per name; keywords are fresh
        ; objects equal through their interned Identifier
        let i1 interp.lookup(StringC("foo"))
        let i2 interp.lookup(StringC("foo"))
        if i1 <> i2
            return 22
        let s1 interp.make_symbol(StringC("bar"))
        let s2 interp.make_symbol(StringC("bar"))
        if s1 <> s2
            return 23
        let k1 interp.make_keyword(StringC("baz"))
        let k2 interp.make_keyword(StringC("baz"))
        if k1 = k2
            return 24
        if ELObj.equal(k1, k2) = false
            return 25

        ; lexical categories
        if interp.lex_category(0x41) <> LEX_LETTER
            return 26
        if interp.lex_category(0x28) <> LEX_DELIMITER
            return 27
        if interp.lex_category(0 - 1) <> LEX_DELIMITER
            return 28
        if interp.lex_category(0x2B) <> LEX_OTHER_NUMBER_START
            return 29

        if interp.get_error_count() <> 0
            return 30

        0
    }

    ; the CLI driver's argv0 — the MessageReporter prefix. Unset, messages keep
    ; the historical package prefix `dazzle` (unit tests / --jit suite).
    function set_msg_prog(prog: pointer[const_char])
        set msg_prog: prog

    ; render one diagnostic line to stderr, byte-identical to the reference
    ; MessageReporter::dispatchMessage the style Interpreter reports through:
    ;   <prog>:[<file>:<line>[:<col>]:]<sev>: <formatted text>\n
    ; The location is the Messenger's next-location (setNextLocation), CONSUMED
    ; by this message (initMessage clears it). A null-origin location renders
    ; no location segment at all (`<prog>:I: called from here`); a non-null
    ; origin whose chain names no real backing source renders the reference's
    ; "(invalid location)". Errors count; Info (stack traces) does not.
    function emit(this: pointer[Interpreter], mt: MessageType, args: Vector[MessageArg])
    {
        let loc this.next_loc
        set this.next_loc: Location()

        var buf u32[2048]
        let bp buf as pointer[u32]
        let cap 2048 as size_t
        var p: size_t 0

        ; program name (raw ASCII bytes) + ':'
        if msg_prog <> null
        {
            let pb msg_prog as pointer[u8]
            var pi: size_t 0
            while (*(pb + pi)) <> (0 as u8)
            {
                set p: ParserState.put_char(bp, cap, p, (*(pb + pi)) as u32)
                set pi: pi + 1
            }
        }
        else
        {
            set p: ParserState.put_char(bp, cap, p, 0x64 as u32)
            set p: ParserState.put_char(bp, cap, p, 0x61 as u32)
            set p: ParserState.put_char(bp, cap, p, 0x7A as u32)
            set p: ParserState.put_char(bp, cap, p, 0x7A as u32)
            set p: ParserState.put_char(bp, cap, p, 0x6C as u32)
            set p: ParserState.put_char(bp, cap, p, 0x65 as u32)
        }
        set p: ParserState.put_char(bp, cap, p, 0x3A as u32)

        if loc.get_origin() <> null
        {
            var line: u32 0
            var col: u32 0
            var ridx: size_t 0
            let resolved Origin.resolve_chain(loc, false, &line, &col, &ridx)
            ; a chain that names no real backing source prints NO location
            ; segment at all — MessageReporter::dispatchMessage skips
            ; printLocation when locationHeader returns null (the builtins
            ; prolog's InputSourceOrigin::make() has no external info).
            if resolved <> null
            {
                ; file name + ':' + line ':' [col ':'] — the same rendering
                ; rules as ParserState.emit_message (printLocation).
                let fname resolved.file_name_at(ridx)
                var fi: size_t 0
                while fi < fname.get_size()
                {
                    set p: ParserState.put_char(bp, cap, p, fname.get(fi))
                    set fi: fi + 1
                }
                set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
                set p: ParserState.put_dec(bp, cap, p, line as u64)
                set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
                var omit_col false
                if (loc.get_index() = (0 as u32)) and (line = (1 as u32)) and (col = (0 as u32))
                {
                    if resolved.get_buf_length() > (0 as size_t)
                        set omit_col: true
                }
                if resolved.on_segment_leading_rs(ridx)
                    set omit_col: true
                if col = MSG_COL_OMITTED
                    set omit_col: true
                if omit_col = false
                {
                    set p: ParserState.put_dec(bp, cap, p, col as u64)
                    set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
                }
            }
        }

        set p: ParserState.put_char(bp, cap, p, mt.severity_char())
        set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
        set p: ParserState.put_char(bp, cap, p, 0x20 as u32)
        let fmt MessageFormatter()
        let added fmt.format(mt.get_text(), args, bp + p, cap - p, false)
        set p: p + added
        set p: ParserState.put_char(bp, cap, p, 0x0A as u32)
        ParserState.write_stderr(bp, p, true, 2)
        if mt.is_error()
            set this.error_count: this.error_count + 1
    }

    ; an auxiliary message line (`<prog>:<file>:<line>:<col>: <text>` — no
    ; severity char; the reference MessageReporter's auxiliary fragment, e.g.
    ; duplicateDefinition's "first definition was here").
    function emit_aux(this: pointer[Interpreter], mt: MessageType, loc: Location)
    {
        var buf u32[1024]
        let bp buf as pointer[u32]
        let cap 1024 as size_t
        var p: size_t 0
        if msg_prog <> null
        {
            let pb msg_prog as pointer[u8]
            var pi: size_t 0
            while (*(pb + pi)) <> (0 as u8)
            {
                set p: ParserState.put_char(bp, cap, p, (*(pb + pi)) as u32)
                set pi: pi + 1
            }
        }
        else
        {
            set p: ParserState.put_char(bp, cap, p, 0x64 as u32)
            set p: ParserState.put_char(bp, cap, p, 0x61 as u32)
            set p: ParserState.put_char(bp, cap, p, 0x7A as u32)
            set p: ParserState.put_char(bp, cap, p, 0x7A as u32)
            set p: ParserState.put_char(bp, cap, p, 0x6C as u32)
            set p: ParserState.put_char(bp, cap, p, 0x65 as u32)
        }
        set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
        if loc.get_origin() <> null
        {
            var line: u32 0
            var col: u32 0
            var ridx: size_t 0
            let resolved Origin.resolve_chain(loc, false, &line, &col, &ridx)
            if resolved <> null
            {
                let fname resolved.file_name_at(ridx)
                var fi: size_t 0
                while fi < fname.get_size()
                {
                    set p: ParserState.put_char(bp, cap, p, fname.get(fi))
                    set fi: fi + 1
                }
                set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
                set p: ParserState.put_dec(bp, cap, p, line as u64)
                set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
                var omit_col false
                if (loc.get_index() = (0 as u32)) and (line = (1 as u32)) and (col = (0 as u32))
                {
                    if resolved.get_buf_length() > (0 as size_t)
                        set omit_col: true
                }
                if resolved.on_segment_leading_rs(ridx)
                    set omit_col: true
                if col = MSG_COL_OMITTED
                    set omit_col: true
                if omit_col = false
                {
                    set p: ParserState.put_dec(bp, cap, p, col as u64)
                    set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
                }
            }
        }
        set p: ParserState.put_char(bp, cap, p, 0x20 as u32)
        let fmt MessageFormatter()
        let args Vector[MessageArg]()
        let added fmt.format(mt.get_text(), args, bp + p, cap - p, false)
        set p: p + added
        set p: ParserState.put_char(bp, cap, p, 0x0A as u32)
        ParserState.write_stderr(bp, p, true, 2)
    }
}
