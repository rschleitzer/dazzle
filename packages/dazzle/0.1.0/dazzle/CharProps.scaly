define CharProps ()
{
    ; Interpreter::installCharProperties (Interpreter.cxx:2064). Thirteen
    ; properties in the reference's order. ★Every one of them is created
    ; even under -s; strict mode only leaves the TABLE empty, so a character
    ; falls through to the property's default.
    function install(interp: ref[Interpreter], strict: bool)
    {
        let host interp.get_host()
        let f interp.make_false()

        ; numeric-equiv: the ten ASCII digits map to their VALUE.
        let ne interp.new_char_property("numeric-equiv", f)
        if strict = false
        {
            var d 0
            while d < 10
            {
                let c (0x30 + d) as u32
                ne.set_range(c, c, ELObj.make_integer(host, d), 0xFFFFFFFF)
                set d: d + 1
            }
        }

        ; Each boolean table is indexed IN PLACE rather than through a
        ; shared helper taking `pointer[int]`: a const array global is an
        ; `[N x int]` VALUE, not a pointer, and the planner does not accept
        ; it in a pointer parameter (a standalone probe derails name
        ; resolution for the rest of the file). Six near-identical loops are
        ; the price.
        let t interp.make_true()
        let sp interp.new_char_property("space?", f)
        if strict = false
        {
            var i 0
            while i < 8
            {
                sp.set_range(CP_SPACE[i] as u32, CP_SPACE[i + 1] as u32, t, 0xFFFFFFFF)
                set i: i + 2
            }
        }
        let re interp.new_char_property("record-end?", f)
        if strict = false
        {
            var i 0
            while i < 2
            {
                re.set_range(CP_RECORD_END[i] as u32, CP_RECORD_END[i + 1] as u32, t, 0xFFFFFFFF)
                set i: i + 2
            }
        }
        let bl interp.new_char_property("blank?", f)
        if strict = false
        {
            var i 0
            while i < 12
            {
                bl.set_range(CP_BLANK[i] as u32, CP_BLANK[i + 1] as u32, t, 0xFFFFFFFF)
                set i: i + 2
            }
        }
        let it interp.new_char_property("input-tab?", f)
        if strict = false
        {
            var i 0
            while i < 2
            {
                it.set_range(CP_INPUT_TAB[i] as u32, CP_INPUT_TAB[i + 1] as u32, t, 0xFFFFFFFF)
                set i: i + 2
            }
        }
        let iw interp.new_char_property("input-whitespace?", f)
        if strict = false
        {
            var i 0
            while i < 12
            {
                iw.set_range(CP_INPUT_WHITESPACE[i] as u32, CP_INPUT_WHITESPACE[i + 1] as u32, t, 0xFFFFFFFF)
                set i: i + 2
            }
        }
        let pu interp.new_char_property("punct?", f)
        if strict = false
        {
            var i 0
            while i < 50
            {
                pu.set_range(CP_PUNCT[i] as u32, CP_PUNCT[i + 1] as u32, t, 0xFFFFFFFF)
                set i: i + 2
            }
        }

        ; script: the value is a STRING, the ISO public-identifier prefix
        ; plus the script name.
        let sc interp.new_char_property("script", f)
        if strict = false
        {
            var i 0
            while i < 114
            {
                let first CP_SCRIPT[i] as u32
                let last CP_SCRIPT[i + 1] as u32
                let ni CP_SCRIPT[i + 2]
                ; the value is bound FIRST: a static call handed straight in
                ; as an argument is the documented mis-parse trap.
                let v CharProps.script_value(host, interp, ni)
                sc.set_range(first, last, v, 0xFFFFFFFF)
                set i: i + 3
            }
        }

        ; three properties the reference creates EMPTY (their values only
        ; ever come from add-char-properties).
        interp.new_char_property("glyph-id", f)
        interp.new_char_property("drop-after-line-break?", f)
        interp.new_char_property("drop-unless-before-line-break?", f)

        ; break-before-priority / break-after-priority share one table and
        ; the same default 0.
        let zero ELObj.make_integer(host, 0)
        let bbp interp.new_char_property("break-before-priority", zero)
        let bap interp.new_char_property("break-after-priority", zero)
        if strict = false
        {
            var j 0
            while j < 2036
            {
                let first CP_BREAK[j] as u32
                let last CP_BREAK[j + 1] as u32
                bbp.set_range(first, last, ELObj.make_integer(host, CP_BREAK[j + 2]), 0xFFFFFFFF)
                bap.set_range(first, last, ELObj.make_integer(host, CP_BREAK[j + 3]), 0xFFFFFFFF)
                set j: j + 4
            }
        }

        ; ★math-class's default is the SYMBOL `ordinary`, not #f — the only
        ; built-in whose default is neither a boolean nor a number.
        interp.new_char_property("math-class", interp.make_symbol(Interpreter.ascii_string_c(host, "ordinary")))
        interp.new_char_property("math-font-posture", f)
    }

    ; the script names, indexed by the third column of CP_SCRIPT.
    ; ★Written as an APPENDER, not as a function returning the literal:
    ; returning a `pointer[const_char]` literal from a Scaly function does
    ; not survive (measured: SIGSEGV on the first use). Passing a literal
    ; straight into a call is fine.
    procedure append_script_name(buf: ref[Array[u32]], idx: int)
    {
        if idx = 0
        {
            CharProps.append_ascii(buf, "Latin")
            return
        }
        if idx = 1
        {
            CharProps.append_ascii(buf, "Greek")
            return
        }
        if idx = 2
        {
            CharProps.append_ascii(buf, "Cyrillic")
            return
        }
        if idx = 3
        {
            CharProps.append_ascii(buf, "Armenian")
            return
        }
        if idx = 4
        {
            CharProps.append_ascii(buf, "Hebrew")
            return
        }
        if idx = 5
        {
            CharProps.append_ascii(buf, "Arabic")
            return
        }
        if idx = 6
        {
            CharProps.append_ascii(buf, "Devanagari")
            return
        }
        if idx = 7
        {
            CharProps.append_ascii(buf, "Bengali")
            return
        }
        if idx = 8
        {
            CharProps.append_ascii(buf, "Gurmukhi")
            return
        }
        if idx = 9
        {
            CharProps.append_ascii(buf, "Gujarati")
            return
        }
        if idx = 10
        {
            CharProps.append_ascii(buf, "Oriya")
            return
        }
        if idx = 11
        {
            CharProps.append_ascii(buf, "Tamil")
            return
        }
        if idx = 12
        {
            CharProps.append_ascii(buf, "Telugu")
            return
        }
        if idx = 13
        {
            CharProps.append_ascii(buf, "Kannada")
            return
        }
        if idx = 14
        {
            CharProps.append_ascii(buf, "Malayalam")
            return
        }
        if idx = 15
        {
            CharProps.append_ascii(buf, "Sinhala")
            return
        }
        if idx = 16
        {
            CharProps.append_ascii(buf, "Thai")
            return
        }
        if idx = 17
        {
            CharProps.append_ascii(buf, "Lao")
            return
        }
        if idx = 18
        {
            CharProps.append_ascii(buf, "Tibetan")
            return
        }
        if idx = 19
        {
            CharProps.append_ascii(buf, "Georgian")
            return
        }
        if idx = 20
        {
            CharProps.append_ascii(buf, "Hangul")
            return
        }
        if idx = 21
        {
            CharProps.append_ascii(buf, "Ethiopian")
            return
        }
        if idx = 22
        {
            CharProps.append_ascii(buf, "Khmer")
            return
        }
        if idx = 23
        {
            CharProps.append_ascii(buf, "Mongolian")
            return
        }
        if idx = 24
        {
            CharProps.append_ascii(buf, "Punctuation")
            return
        }
        if idx = 25
        {
            CharProps.append_ascii(buf, "Symbol")
            return
        }
        if idx = 26
        {
            CharProps.append_ascii(buf, "Hiragana")
            return
        }
        if idx = 27
        {
            CharProps.append_ascii(buf, "Katakana")
            return
        }
        CharProps.append_ascii(buf, "Bopomofo")
    }

    ; "ISO/IEC 10179::1996//Script::" + the name at that index.
    ;
    ; ★The two literals are widened BYTE BY BYTE, never through
    ; `let x StringC(<cstring>)`: that init allocates its buffer with
    ; `Page.get(this)`, and for a STACK-bound value `this` is a stack
    ; address, so the "page" is bogus (measured: SIGSEGV during
    ; Interpreter.make). Passing `StringC(lit)` straight into a call is
    ; fine — only BINDING one is not.
    function script_value(host: pointer[Page], interp: ref[Interpreter], idx: int) returns ref[ELObj]
    {
        let buf Array[u32]^host()
        CharProps.append_ascii(buf, "ISO/IEC 10179::1996//Script::")
        CharProps.append_script_name(buf, idx)
        let full StringC^host(buf.get_buffer(), buf.get_length())
        ELObj.make_string(host, full)
    }

    procedure append_ascii(buf: ref[Array[u32]], s: pointer[const_char])
    {
        let b s as pointer[u8]
        var i: size_t 0
        while (*(b + i)) <> 0
        {
            buf.add((*(b + i)) as u32)
            set i: i + 1
        }
    }
}
