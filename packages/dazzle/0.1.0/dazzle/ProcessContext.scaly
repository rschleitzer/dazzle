            this.push_fo_style(fo)
            var rfo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set rfo: this.resolve_nics(fo)
            if rfo <> null
            {
                ; NIC absent == the reference's default-constructed record.
                var tnic_v rfo.get_tnic() as ref[LineFieldNICRec]?
                if tnic_v = null
                    set tnic_v: LineFieldNICRec.make(this.interp.get_host())
                sg.start_line_field(tnic_v)
                this.process_flow_obj_content(sosofo)
                sg.end_line_field()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_LINK
        {
            ; LinkFlowObj::processInner — startLink(address) + content.
            this.push_fo_style(fo)
            var rfo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
