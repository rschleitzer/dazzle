            if rfo <> null
            {
                ; NIC absent == the reference's default-constructed record.
                var dnic_v rfo.get_dnic()
                if dnic_v = null
                    set dnic_v: DisplayNIC.make(this.interp.get_host())
                sg.start_display_group(dnic_v)
                this.process_flow_obj_content(sosofo)
                sg.end_display_group()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_LINE_FIELD
        {
            ; the InlineNIC break priorities ride the tnic (the fot dump drops
