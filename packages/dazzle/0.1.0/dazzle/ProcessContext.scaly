            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_LEADER
        {
            this.push_fo_style(fo)
            var rfo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set rfo: this.resolve_nics(fo)
            if rfo <> null
            {
                ; NIC absent == the reference's default-constructed record.
                var tnic_v rfo.get_tnic() as ref[LeaderNICRec]?
                if tnic_v = null
                    set tnic_v: LeaderNICRec.make(this.interp.get_host())
                sg.start_leader(tnic_v)
                this.process_flow_obj_content(sosofo)
                sg.end_leader()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_BOX
        {
            this.push_fo_style(fo)
            var rfo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set rfo: this.resolve_nics(fo)
            if rfo <> null
            {
                ; NIC absent == the reference's default-constructed record.
                var tnic_v rfo.get_tnic() as ref[BoxNICRec]?
                if tnic_v = null
                    set tnic_v: BoxNICRec.make(this.interp.get_host())
                var dnic_v rfo.get_dnic()
                if dnic_v = null
                    set dnic_v: DisplayNIC.make(this.interp.get_host())
                sg.start_box(tnic_v, dnic_v)
                this.process_flow_obj_content(sosofo)
                sg.end_box()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_SCORE
        {
            ; ScoreFlowObj::processInner — no type: = a plain sequence pair.
            this.push_fo_style(fo)
            var rfo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set rfo: this.resolve_nics(fo)
            if rfo <> null
            {
                let snic rfo.get_tnic() as ref[ScoreNICRec]?
                var typed false
                if snic <> null
                {
                    if snic.kind <> SCORE_NONE
                        set typed: true
                }
                if typed
                {
                    sg.start_score(snic)
                    this.process_flow_obj_content(sosofo)
                    sg.end_score()
                }
                else
                {
                    sg.start_sequence()
                    this.process_flow_obj_content(sosofo)
                    sg.end_sequence()
                }
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_SEQUENCE
        {
            this.push_fo_style(fo)
            sg.start_sequence()
            this.process_flow_obj_content(sosofo)
            sg.end_sequence()
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_MACRO
        {
            ; MacroFlowObj::processInner — the body's sosofo inside a
            ; startSequence/endSequence bracket, under the macro make's own
            ; style (so `(make my-macro font-weight: 'bold …)` renders as a
            ; sequence carrying that characteristic).
            this.push_fo_style(fo)
            var rfo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set rfo: this.resolve_nics(fo)
            if rfo <> null
            {
                sg.start_sequence()
                this.process_macro(sosofo, rfo)
                sg.end_sequence()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_SCROLL
        {
            ; ScrollFlowObj::processInner — a plain compound bracket.
            this.push_fo_style(fo)
            sg.start_scroll()
            this.process_flow_obj_content(sosofo)
            sg.end_scroll()
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_PAGE_FLOAT
        {
            ; CompoundExtensionFlowObj::processInner — startExtension (no
            ; ports) + content + endExtension; the TeX builder's
            ; TeXCompoundExtensionFlowObj::start/end do the work.
            this.push_fo_style(fo)
            var rfo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set rfo: this.resolve_nics(fo)
            if rfo <> null
            {
                ; NIC absent == the reference's default-constructed record.
                var tnic_v rfo.get_tnic() as ref[PageFloatNICRec]?
                if tnic_v = null
                    set tnic_v: PageFloatNICRec.make(this.interp.get_host())
                sg.start_page_float(tnic_v)
                this.process_flow_obj_content(sosofo)
                sg.end_page_float()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_INDEX_ENTRY
        {
            ; ExtensionFlowObj::processInner — an ATOMIC flow object:
            ; currentFOTBuilder().extension(fo, currentNode). The MIF override
            ; does NOT call the base atomic(), so no format level is pushed.
            this.push_fo_style(fo)
            var ifo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set ifo: this.resolve_nics(fo)
            if ifo <> null
            {
                ; NIC absent == the reference's default-constructed record.
                var tnic_v ifo.get_tnic() as ref[IndexEntryNICRec]?
                if tnic_v = null
                    set tnic_v: IndexEntryNICRec.make(this.interp.get_host())
                sg.index_entry(tnic_v)
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_PAGE_FOOTNOTE
        {
            this.push_fo_style(fo)
            sg.start_page_footnote()
            this.process_flow_obj_content(sosofo)
            sg.end_page_footnote()
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_CHARACTER
        {
            ; CharacterFlowObj::processInner — atomic.
            this.push_fo_style(fo)
            var cfo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set cfo: this.resolve_nics(fo)
            if cfo <> null
            {
                ; NIC absent == the reference's default-constructed record.
                var tnic_v cfo.get_tnic() as ref[CharacterNICRec]?
                if tnic_v = null
                    set tnic_v: CharacterNICRec.make(this.interp.get_host())
                sg.character(tnic_v)
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_ALIGNMENT_POINT
        {
            ; AlignmentPointFlowObj::processInner — atomic, no NIC.
            this.push_fo_style(fo)
            sg.alignment_point()
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_SIDELINE
        {
            ; SidelineFlowObj::processInner — a plain compound bracket.
            this.push_fo_style(fo)
            sg.start_sideline()
            this.process_flow_obj_content(sosofo)
            sg.end_sideline()
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_ANCHOR
        {
            ; AnchorFlowObj::processInner (style/Anchor.cxx) — one atomic call.
            ; ★The class IS a CompoundFlowObj (so `(make anchor (literal …))`
            ; draws no atomicContent diagnostic) but processInner never calls
            ; the base, so the content is DISCARDED. Measured.
            this.push_fo_style(fo)
            var afo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set afo: this.resolve_nics(fo)
            if afo <> null
            {
                ; NIC absent == the reference's default-constructed record.
                var tnic_v afo.get_tnic() as ref[AnchorNICRec]?
                if tnic_v = null
                    set tnic_v: AnchorNICRec.make(this.interp.get_host())
                sg.anchor(tnic_v)
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_GLYPH_ANNOTATION
        {
            ; GlyphAnnotationFlowObj::processInner — a NIC-bearing compound
            ; bracket (the fot dump's start tag is SELF-CLOSING and then closed
            ; by endFlow — the reference's own quirk, reproduced).
            this.push_fo_style(fo)
            var gfo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set gfo: this.resolve_nics(fo)
            if gfo <> null
            {
                ; NIC absent == the reference's default-constructed record.
                var tnic_v gfo.get_tnic() as ref[GlyphAnnotationNICRec]?
                if tnic_v = null
                    set tnic_v: GlyphAnnotationNICRec.make(this.interp.get_host())
                sg.start_glyph_annotation(tnic_v)
                this.process_flow_obj_content(sosofo)
                sg.end_glyph_annotation()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_EMPHASIZING_MARK
        {
            ; EmphasizingMarkFlowObj::processInner + the SerialFOTBuilder
            ; decomposition: the `mark:` sosofo is processed into a save queue
            ; (the reference's one-element markfotb[] port, pushed as the
            ; PRINCIPAL port), replayed inside the mark bracket, and only then
            ; does the principal content follow.
            ; ★The reference binary CRASHES on every make of this class — its
            ; copy constructor leaves emphmark_ indeterminate
            ; (style/EmphasizingMark.h:28) and processInner dereferences it.
            ; This port carries the mark; the flowobj fixture documents the
            ; deviation.
            this.push_fo_style(fo)
            var efo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set efo: this.resolve_nics(fo)
            if efo <> null
            {
                ; A NIC is a VALUE in the reference -- `EmphasizingMarkNIC()`
                ; is default-constructible and `StartEmphasizingMarkCall` holds
                ; one BY VALUE, so `startEmphasizingMarkSerial(const
                ; EmphasizingMarkNIC &)` can never be handed nothing. Supply the
                ; default here, the way the table and table-column cases below
                ; already do; without it this was the ONE site that passed a
                ; null NIC on, and every builder's `if nic <> null` guard was
                ; load-bearing because of it.
                var erec efo.get_tnic() as ref[EmphasizingMarkNICRec]?
                if erec = null
                    set erec: EmphasizingMarkNICRec.make(this.interp.get_host())
                sg.start_emphasizing_mark_serial(erec)
                var mark: ref[ELObj]? null
                if erec <> null
                    set mark: erec.mark
                let phost this.interp.get_host()
                let msave SaveFOTBuilder.make(phost)
                if mark <> null
                {
                    this.push_principal_port(msave, phost)
                    this.process_sosofo(mark)
                    this.pop_principal_port()
                }
                sg.start_emphasizing_mark_mark()
                sg.emit_saved(msave)
                sg.end_emphasizing_mark_mark()
                sg.end_all_emphasizing_mark_mark()
                this.process_flow_obj_content(sosofo)
                sg.end_emphasizing_mark_serial()
            }
            this.pop_fo_style(fo)
            return
        }
        ; --- the MATH family (FlowObj.cxx:1708-2115) ---------------------------
        ; The four port-less brackets first: MathSequence / Unmath /
        ; Superscript / Subscript are plain CompoundFlowObjs.
        if foc = FOC_MATH_SEQUENCE
        {
            this.push_fo_style(fo)
            sg.start_math_sequence()
            this.process_flow_obj_content(sosofo)
            sg.end_math_sequence()
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_UNMATH
        {
            this.push_fo_style(fo)
            sg.start_unmath()
            this.process_flow_obj_content(sosofo)
            sg.end_unmath()
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_SUPERSCRIPT
        {
            this.push_fo_style(fo)
            sg.start_superscript()
            this.process_flow_obj_content(sosofo)
            sg.end_superscript()
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_SUBSCRIPT
        {
            this.push_fo_style(fo)
            sg.start_subscript()
            this.process_flow_obj_content(sosofo)
            sg.end_subscript()
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_FRACTION
        {
            ; FractionFlowObj::processInner + SerialFOTBuilder::start/endFraction.
            ; ★The FRACTION BAR sits between the serial bracket and the ports:
            ; the `fraction-bar` inherited characteristic's actual value is a
            ; rule sosofo whose style is pushed around the atomic bar call.
            ; ★And fraction is the ONE class that passes 0 for pushPorts'
            ; hasPrincipalPort flag — the reference IGNORES the argument
            ; ("FIXME deal with !hasPrincipalPort", ProcessContext.cxx:382), so
            ; unlabelled content still lands in the enclosing stream, directly
            ; after the bar and BEFORE the numerator port. Reproduced as
            ; measured, not as documented.
            this.push_fo_style(fo)
            sg.start_fraction_serial()
            let bar_style this.fraction_bar_style_actual()
            if bar_style <> null
                this.push_style_obj(bar_style)
            sg.fraction_bar()
            if bar_style <> null
            {
                let bss this.current_style_stack()
                bss.pop()
            }
            let fhost this.interp.get_host()
            let num_save SaveFOTBuilder.make(fhost)
            let den_save SaveFOTBuilder.make(fhost)
            let flabels Array[ref[ELObj]?]^fhost()
            flabels.add(this.interp.make_symbol(StringC("numerator")))
            flabels.add(this.interp.make_symbol(StringC("denominator")))
            let fsaves Array[ref[SaveFOTBuilder]?]^fhost()
            fsaves.add(num_save)
            fsaves.add(den_save)
            this.push_ports(flabels, fsaves, fhost)
            this.process_flow_obj_content(sosofo)
            this.pop_ports()
            sg.start_fraction_numerator()
            sg.emit_saved(num_save)
            sg.end_fraction_numerator()
            sg.start_fraction_denominator()
            sg.emit_saved(den_save)
            sg.end_fraction_denominator()
            sg.end_fraction_serial()
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_SCRIPT
        {
            ; ScriptFlowObj::processInner + SerialFOTBuilder::start/endScript —
            ; six ports, replayed in declaration order.
            this.push_fo_style(fo)
            sg.start_script_serial()
            let shost this.interp.get_host()
            let slabels Array[ref[ELObj]?]^shost()
            slabels.add(this.interp.make_symbol(StringC("pre-sup")))
            slabels.add(this.interp.make_symbol(StringC("pre-sub")))
            slabels.add(this.interp.make_symbol(StringC("post-sup")))
            slabels.add(this.interp.make_symbol(StringC("post-sub")))
            slabels.add(this.interp.make_symbol(StringC("mid-sup")))
            slabels.add(this.interp.make_symbol(StringC("mid-sub")))
            let ssaves Array[ref[SaveFOTBuilder]?]^shost()
            var si 0
            while si < 6
            {
                ssaves.add(SaveFOTBuilder.make(shost))
                set si: si + 1
            }
            this.push_ports(slabels, ssaves, shost)
            this.process_flow_obj_content(sosofo)
            this.pop_ports()
            sg.start_script_pre_sup()
            sg.emit_saved(*ssaves.get(0))
            sg.end_script_pre_sup()
            sg.start_script_pre_sub()
            sg.emit_saved(*ssaves.get(1))
            sg.end_script_pre_sub()
            sg.start_script_post_sup()
            sg.emit_saved(*ssaves.get(2))
            sg.end_script_post_sup()
            sg.start_script_post_sub()
            sg.emit_saved(*ssaves.get(3))
            sg.end_script_post_sub()
            sg.start_script_mid_sup()
            sg.emit_saved(*ssaves.get(4))
            sg.end_script_mid_sup()
            sg.start_script_mid_sub()
            sg.emit_saved(*ssaves.get(5))
            sg.end_script_mid_sub()
            sg.end_script_serial()
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_MARK
        {
            ; MarkFlowObj::processInner + SerialFOTBuilder::start/endMark.
            this.push_fo_style(fo)
            sg.start_mark_serial()
            let mhost this.interp.get_host()
            let over_save SaveFOTBuilder.make(mhost)
            let under_save SaveFOTBuilder.make(mhost)
            let mlabels Array[ref[ELObj]?]^mhost()
            mlabels.add(this.interp.make_symbol(StringC("over-mark")))
            mlabels.add(this.interp.make_symbol(StringC("under-mark")))
            let msaves Array[ref[SaveFOTBuilder]?]^mhost()
            msaves.add(over_save)
            msaves.add(under_save)
            this.push_ports(mlabels, msaves, mhost)
            this.process_flow_obj_content(sosofo)
            this.pop_ports()
            sg.start_mark_over()
            sg.emit_saved(over_save)
            sg.end_mark_over()
            sg.start_mark_under()
            sg.emit_saved(under_save)
            sg.end_mark_under()
            sg.end_mark_serial()
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_FENCE
        {
            ; FenceFlowObj::processInner + SerialFOTBuilder::start/endFence.
            this.push_fo_style(fo)
            sg.start_fence_serial()
            let nhost this.interp.get_host()
            let open_save SaveFOTBuilder.make(nhost)
            let close_save SaveFOTBuilder.make(nhost)
            let nlabels Array[ref[ELObj]?]^nhost()
            nlabels.add(this.interp.make_symbol(StringC("open")))
            nlabels.add(this.interp.make_symbol(StringC("close")))
            let nsaves Array[ref[SaveFOTBuilder]?]^nhost()
            nsaves.add(open_save)
            nsaves.add(close_save)
            this.push_ports(nlabels, nsaves, nhost)
            this.process_flow_obj_content(sosofo)
            this.pop_ports()
            sg.start_fence_open()
            sg.emit_saved(open_save)
            sg.end_fence_open()
            sg.start_fence_close()
            sg.emit_saved(close_save)
            sg.end_fence_close()
            sg.end_fence_serial()
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_RADICAL
        {
            ; RadicalFlowObj::processInner + SerialFOTBuilder::start/endRadical.
            ; ★The `radical:` sosofo is not processed — its CharacterNIC and
            ; style are EXTRACTED (SosofoObj::characterStyle) and handed to the
            ; backend as one atomic call; without one, radicalRadicalDefaulted.
            ; Both open the principal port in the fot backend.
            this.push_fo_style(fo)
            var rdfo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set rdfo: this.resolve_nics(fo)
            if rdfo <> null
            {
                sg.start_radical_serial()
                var rad: ref[ELObj]? null
                let rrec rdfo.get_tnic() as ref[RadicalNICRec]?
                if rrec <> null
                    set rad: rrec.radical
                var rnic: ref[CharacterNICRec]? null
                var rstyle: pointer[ELObj] null
                if rad <> null
                    set rnic: this.character_style_of(rad, &rstyle)
                if rnic <> null
                {
                    if rstyle <> null
                        this.push_style_obj(rstyle)
                    sg.radical_radical(rnic)
                    if rstyle <> null
                    {
                        let rss this.current_style_stack()
                        rss.pop()
                    }
                }
                else
                    sg.radical_radical_defaulted()
                let dhost this.interp.get_host()
                let deg_save SaveFOTBuilder.make(dhost)
                let dlabels Array[ref[ELObj]?]^dhost()
                dlabels.add(this.interp.make_symbol(StringC("degree")))
                let dsaves Array[ref[SaveFOTBuilder]?]^dhost()
                dsaves.add(deg_save)
                this.push_ports(dlabels, dsaves, dhost)
                this.process_flow_obj_content(sosofo)
                this.pop_ports()
                sg.start_radical_degree()
                sg.emit_saved(deg_save)
                sg.end_radical_degree()
                sg.end_radical_serial()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_MATH_OPERATOR
        {
            ; MathOperatorFlowObj::processInner + the three-port serial
            ; decomposition.
            this.push_fo_style(fo)
            sg.start_math_operator_serial()
            let ohost this.interp.get_host()
            let op_save SaveFOTBuilder.make(ohost)
            let lo_save SaveFOTBuilder.make(ohost)
            let up_save SaveFOTBuilder.make(ohost)
            let olabels Array[ref[ELObj]?]^ohost()
            olabels.add(this.interp.make_symbol(StringC("operator")))
            olabels.add(this.interp.make_symbol(StringC("lower-limit")))
            olabels.add(this.interp.make_symbol(StringC("upper-limit")))
            let osaves Array[ref[SaveFOTBuilder]?]^ohost()
            osaves.add(op_save)
            osaves.add(lo_save)
            osaves.add(up_save)
            this.push_ports(olabels, osaves, ohost)
            this.process_flow_obj_content(sosofo)
            this.pop_ports()
            sg.start_math_operator_operator()
            sg.emit_saved(op_save)
            sg.end_math_operator_operator()
            sg.start_math_operator_lower_limit()
            sg.emit_saved(lo_save)
            sg.end_math_operator_lower_limit()
            sg.start_math_operator_upper_limit()
            sg.emit_saved(up_save)
            sg.end_math_operator_upper_limit()
            sg.end_math_operator_serial()
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_GRID
        {
            ; GridFlowObj::processInner — a NIC-bearing compound bracket.
            this.push_fo_style(fo)
            var gfo2: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set gfo2: this.resolve_nics(fo)
            if gfo2 <> null
            {
                ; NIC absent == the reference's default-constructed record.
                var tnic_v gfo2.get_tnic() as ref[GridNICRec]?
                if tnic_v = null
                    set tnic_v: GridNICRec.make(this.interp.get_host())
                sg.start_grid(tnic_v)
                this.process_flow_obj_content(sosofo)
                sg.end_grid()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_GRID_CELL
        {
            ; GridCellFlowObj::processInner — likewise.
            this.push_fo_style(fo)
            var gcfo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set gcfo: this.resolve_nics(fo)
            if gcfo <> null
            {
                ; NIC absent == the reference's default-constructed record.
                var tnic_v gcfo.get_tnic() as ref[GridCellNICRec]?
                if tnic_v = null
                    set tnic_v: GridCellNICRec.make(this.interp.get_host())
                sg.start_grid_cell(tnic_v)
                this.process_flow_obj_content(sosofo)
                sg.end_grid_cell()
            }
            this.pop_fo_style(fo)
            return
        }
        ; --- the LAYOUT-COMPOSITE family --------------------------------------
        ; Five plain CompoundFlowObj brackets — no ports, no serial
        ; decomposition (style/{EmbeddedText,IncludedContainerArea,SideBySide,
        ; SideBySideItem,AlignedColumn}.cxx, each a three-line processInner).
        if foc = FOC_EMBEDDED_TEXT
        {
            this.push_fo_style(fo)
            var efo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set efo: this.resolve_nics(fo)
            if efo <> null
            {
                ; NIC absent == the reference's default-constructed record.
                var tnic_v efo.get_tnic() as ref[EmbeddedTextNICRec]?
                if tnic_v = null
                    set tnic_v: EmbeddedTextNICRec.make(this.interp.get_host())
                sg.start_embedded_text(tnic_v)
                this.process_flow_obj_content(sosofo)
                sg.end_embedded_text()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_INCLUDED_CONTAINER_AREA
        {
            ; the one class of the family whose NIC derives from DisplayNIC:
            ; its own record and the shared display record travel together.
            this.push_fo_style(fo)
            var ifo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set ifo: this.resolve_nics(fo)
            if ifo <> null
            {
                ; NIC absent == the reference's default-constructed record.
                var tnic_v ifo.get_tnic() as ref[IncludedContainerAreaNICRec]?
                if tnic_v = null
                    set tnic_v: IncludedContainerAreaNICRec.make(this.interp.get_host())
                var dnic_v ifo.get_dnic()
                if dnic_v = null
                    set dnic_v: DisplayNIC.make(this.interp.get_host())
                sg.start_included_container_area(tnic_v, dnic_v)
                this.process_flow_obj_content(sosofo)
                sg.end_included_container_area()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_SIDE_BY_SIDE
        {
            this.push_fo_style(fo)
            var bfo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set bfo: this.resolve_nics(fo)
            if bfo <> null
            {
                ; NIC absent == the reference's default-constructed record.
                var dnic_v bfo.get_dnic()
                if dnic_v = null
                    set dnic_v: DisplayNIC.make(this.interp.get_host())
                sg.start_side_by_side(dnic_v)
                this.process_flow_obj_content(sosofo)
                sg.end_side_by_side()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_SIDE_BY_SIDE_ITEM
        {
            ; SideBySideItemFlowObj has no hasNonInheritedC at all — every
            ; characteristic name is an unknown keyword.
            this.push_fo_style(fo)
            sg.start_side_by_side_item()
            this.process_flow_obj_content(sosofo)
            sg.end_side_by_side_item()
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_ALIGNED_COLUMN
        {
            this.push_fo_style(fo)
            var afo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set afo: this.resolve_nics(fo)
            if afo <> null
            {
                ; NIC absent == the reference's default-constructed record.
                var dnic_v afo.get_dnic()
                if dnic_v = null
                    set dnic_v: DisplayNIC.make(this.interp.get_host())
                sg.start_aligned_column(dnic_v)
                this.process_flow_obj_content(sosofo)
                sg.end_aligned_column()
            }
            this.pop_fo_style(fo)
            return
        }
        ; --- the ONLINE family ------------------------------------------------
        if foc = FOC_MARGINALIA
        {
            ; MarginaliaFlowObj::processInner — a bare bracket, no
            ; characteristics of its own (its four are inherited ones).
            this.push_fo_style(fo)
            sg.start_marginalia()
            this.process_flow_obj_content(sosofo)
            sg.end_marginalia()
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_MULTI_MODE
        {
            ; MultiModeFlowObj::processInner + SerialFOTBuilder::start/endMulti-
            ; Mode. ★The only class whose PORTS are decided at run time: the
            ; `multi-modes:` list names them, and each named mode becomes one
            ; port replayed inside its own start/endMultiModeMode bracket.
            ; ★Like `fraction`, the reference passes hasPrincipalMode to
            ; pushPorts and never reads it, so unlabelled content flows into
            ; the enclosing stream even when no principal mode was asked for.
            this.push_fo_style(fo)
            var mfo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set mfo: this.resolve_nics(fo)
            if mfo <> null
            {
                let mhost this.interp.get_host()
                let nic mfo.get_tnic() as ref[MultiModeNICRec]?
                var principal: ref[MultiModeRec]? null
                if nic <> null
                {
                    if nic.has_principal_mode
                    {
                        let pm MultiModeRec.make(mhost)
                        set pm.has_desc: nic.principal_has_desc
                        set pm.desc: nic.principal_desc
                        set principal: pm
                    }
                }
                sg.start_multi_mode_serial(principal)
                let mlabels Array[ref[ELObj]?]^mhost()
                let msaves Array[ref[SaveFOTBuilder]?]^mhost()
                var n_modes: size_t 0
                if nic <> null
                    set n_modes: nic.named.get_length()
                var mi: size_t 0
                while mi < n_modes
                {
                    let mp nic.named.get(mi)
                    if mp <> null
                    {
                        let md *mp
                        mlabels.add(this.interp.make_symbol(md.name))
                        msaves.add(SaveFOTBuilder.make(mhost))
                    }
                    set mi: mi + 1
                }
                this.push_ports(mlabels, msaves, mhost)
                this.process_flow_obj_content(sosofo)
                this.pop_ports()
                var mj: size_t 0
                while mj < msaves.get_length()
                {
                    let mp2 nic.named.get(mj)
                    let sp msaves.get(mj)
                    if (mp2 <> null) and (sp <> null)
                    {
                        sg.start_multi_mode_mode(*mp2)
                        sg.emit_saved(*sp)
                        sg.end_multi_mode_mode()
                    }
                    set mj: mj + 1
                }
                sg.end_multi_mode_serial()
            }
            this.pop_fo_style(fo)
            return
        }
        ; --- the PAGE/COLUMN MODEL --------------------------------------------
        ; Two plain CompoundFlowObj brackets (style/PageSequence.cxx:23 and
        ; style/ColumnSetSequence.cxx:10, each a three-line processInner) whose
        ; SerialFOTBuilder decomposition is a straight forward to the *Serial
        ; pair — no ports, no buffering.
        if foc = FOC_PAGE_SEQUENCE
        {
            ; PageSequenceFlowObj takes NO non-inherited characteristic at
            ; all: its six are inherited ones and reach the backend through
            ; the ics buffer, so there is nothing to resolve here.
            this.push_fo_style(fo)
            sg.start_page_sequence()
            this.process_flow_obj_content(sosofo)
            sg.end_page_sequence()
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_COLUMN_SET_SEQUENCE
        {
            this.push_fo_style(fo)
            var qfo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set qfo: this.resolve_nics(fo)
            if qfo <> null
            {
                ; NIC absent == the reference's default-constructed record.
                var dnic_v qfo.get_dnic()
                if dnic_v = null
                    set dnic_v: DisplayNIC.make(this.interp.get_host())
                sg.start_column_set_sequence(dnic_v)
                this.process_flow_obj_content(sosofo)
                sg.end_column_set_sequence()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_SIMPLE_PAGE_SEQUENCE
        {
            ; SimplePageSequenceFlowObj::processInner + the SerialFOTBuilder
            ; decomposition, collapsed: the reference buffers each of the 24
            ; header/footer parts in a SaveFOTBuilder and replays them in
            ; k = pageType | (part << 2) order into the hf string buffer;
            ; processing directly under the output redirect partitions the
            ; stream identically, so each part is extracted right after it
            ; is processed.
            this.push_fo_style(fo)
            var rfo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set rfo: this.resolve_nics(fo)
            if rfo <> null
            {
                sg.start_simple_page_sequence()
                var i 0
                while i < 4
                {
                    set this.have_page_type: true
                    set this.page_type: i
                    var j 0
                    while j < 6
                    {
                        let part rfo.get_hf(j)
                        sg.start_simple_page_sequence_header_footer(i | (j * 4))
                        if part <> null
                            this.process_sosofo(part)
                        sg.end_simple_page_sequence_header_footer(i | (j * 4))
                        set j: j + 1
                    }
                    set i: i + 1
                }
                sg.end_all_simple_page_sequence_header_footer()
                this.process_flow_obj_content(sosofo)
                sg.end_simple_page_sequence()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_TABLE
        {
            ; TableFlowObj::processInner: table state pushed, the four border
            ; flow objects (NIC style, else the table-border actual), content,
            ; the dangling row closed, spanned rows covered.
            this.push_fo_style(fo)
            var rfo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set rfo: this.resolve_nics(fo)
            if rfo <> null
            {
                set this.table_stack: TableRec.make(this.interp.get_host(), this.table_stack)
                var rec rfo.get_tnic() as ref[TableNICRec]?
                if rec = null
                    set rec: TableNICRec.make(this.interp.get_host())
                ; Same for the display NIC: `get_dnic` answers `pointer[void]`
                ; and may be null, so the non-optional cast was a claim the
                ; accessor does not support.
                var tdn rfo.get_dnic()
                if tdn = null
                    set tdn: DisplayNIC.make(this.interp.get_host())
                sg.start_table(rec, tdn)
                let fallback this.border_style_actual("table-border")
                this.emit_table_border(rec.before_row_border, fallback, 0)
                this.emit_table_border(rec.after_row_border, fallback, 1)
                this.emit_table_border(rec.before_column_border, fallback, 2)
                this.emit_table_border(rec.after_column_border, fallback, 3)
                this.process_flow_obj_content(sosofo)
                if this.in_table_row()
                    this.end_table_row()
                this.cover_spanned_rows()
                set this.table_stack: this.table_stack.prev
                sg.end_table()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_TABLE_PART
        {
            ; TablePartFlowObj::processInner + the SerialFOTBuilder header/
            ; footer decomposition: the header/footer ports (label:) capture
            ; into buffers replayed after the principal content.
            this.push_fo_style(fo)
            var rfo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set rfo: this.resolve_nics(fo)
            if rfo <> null
            {
                let t this.table_stack
                if t <> null
                {
                    set t.current_column: 0
                    set t.row_style: null
                    let h t.host
                    set t.column_styles: Array[ref[Array[ref[ELObj]?]]?]^h()
                    set t.covered: Array[int]^h()
                    set t.n_columns: 0
                }
                ; NIC absent == the reference's default-constructed record.
                var dnic_v rfo.get_dnic()
                if dnic_v = null
                    set dnic_v: DisplayNIC.make(this.interp.get_host())
                sg.start_table_part_serial(dnic_v)
                let phost this.interp.get_host()
                let hdr_save SaveFOTBuilder.make(phost)
                let ftr_save SaveFOTBuilder.make(phost)
                let hdr_sym this.interp.make_symbol(StringC("header"))
                let ftr_sym this.interp.make_symbol(StringC("footer"))
                let labels Array[ref[ELObj]?]^phost()
                labels.add(hdr_sym)
                labels.add(ftr_sym)
                let saves Array[ref[SaveFOTBuilder]?]^phost()
                saves.add(hdr_save)
                saves.add(ftr_save)
                this.push_ports(labels, saves, phost)
                this.process_flow_obj_content(sosofo)
                this.pop_ports()
                if this.in_table_row()
                    this.end_table_row()
                this.cover_spanned_rows()
                sg.start_table_part_header()
                sg.emit_saved(hdr_save)
                sg.end_table_part_header()
                sg.start_table_part_footer()
                sg.emit_saved(ftr_save)
                sg.end_table_part_footer()
                sg.end_table_part_serial()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_TABLE_COLUMN
        {
            this.push_fo_style(fo)
            var rfo: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set rfo: this.resolve_nics(fo)
            if rfo <> null
            {
                var rec2 rfo.get_tnic() as ref[TableColumnNICRec]?
                if rec2 = null
                    set rec2: TableColumnNICRec.make(this.interp.get_host())
                let col_fo_style fo.get_style()
                if rec2.has_column_number
                {
                    sg.table_column(rec2)
                    this.add_table_column(rec2.column_index, rec2.n_columns_spanned, col_fo_style)
                }
                else
                {
                    let rec3 rec2.copy(this.interp.get_host())
                    set rec3.column_index: this.current_table_column()
                    sg.table_column(rec3)
                    this.add_table_column(rec3.column_index, rec2.n_columns_spanned, col_fo_style)
                }
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_TABLE_ROW
        {
            ; TableRowFlowObj: pushStyle/popStyle are empty — the row style is
            ; stored and pushed per cell.
            if this.in_table() = false
            {
                this.interp.message0(InterpreterMessages.tableRowOutsideTable())
                this.process_flow_obj_content(sosofo)
                return
            }
            if this.in_table_row()
                this.end_table_row()
            let row_fo_style fo.get_style()
            this.start_table_row(row_fo_style)
            this.process_flow_obj_content(sosofo)
            if this.in_table_row()
                this.end_table_row()
            return
        }
        if foc = FOC_TABLE_CELL
        {
            var rec4 fo.get_tnic() as ref[TableCellNICRec]?
            if rec4 = null
                set rec4: TableCellNICRec.make(this.interp.get_host())
            let cell_fo_style fo.get_style()
            this.process_table_cell(rec4, cell_fo_style, sosofo, fo)
            return
        }
        ; TableBorderFlowObj::process is empty — a pure style carrier.
        if foc = FOC_TABLE_BORDER
            return
        ; --- the SGML-transformation extension classes -----------------------
        ; jade.cxx installs these only for `-t sgml`/`-t xml`, so under a print
        ; backend they bind as FOC_UNKNOWN and never arrive here; the one
        ; exception is formatting-instruction, which every backend installs and
        ; whose sink call dead-ends in the FOTBuilder base everywhere else.
        ; Each is an ExtensionFlowObj, hence still a FlowObj: the style push of
        ; FlowObj::process applies (its setters are the no-op base on the
        ; transform builder, but a lazy characteristic still EVALUATES there —
        ; measured).
        if foc = FOC_ELEMENT
        {
            this.push_fo_style(fo)
            var rel: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set rel: this.resolve_nics(fo)
            if rel <> null
            {
                let gi this.element_gi(rel)
                sg.start_element(gi, rel.get_atts())
                this.process_flow_obj_content(sosofo)
                sg.end_element()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_EMPTY_ELEMENT
        {
            this.push_fo_style(fo)
            var ree: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set ree: this.resolve_nics(fo)
            if ree <> null
            {
                let gi this.element_gi(ree)
                sg.empty_element(gi, ree.get_atts())
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_ENTITY
        {
            this.push_fo_style(fo)
            var ren: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set ren: this.resolve_nics(fo)
            if ren <> null
            {
                sg.start_entity(ren.get_system_id())
                ; A REGION PER GENERATED FILE (tests/dazzle/PERFORMANCE.md,
                ; lever 2), the eval half. process_node brackets a NODE's
                ; transients, but the content of an entity is evaluated inside
                ; whatever node's bracket emitted the entity — a rule that
                ; writes many files holds all of their transients until it
                ; returns. Here that content gets a region of its own, so it
                ; dies with the file. Measured on a 1804-file codegen: up to
                ; 40 MB per file, freed 1804 times.
                ; Nothing the content allocates outlives the file: what does —
                ; the output buffer, the filename, the directory stack — the
                ; sink builds on the run region (or, for the buffer, on the
                ; file's own region, released in end_entity).
                let saved_region this.interp.get_eval_region()
                let file_parent this.interp.get_host()
                let file_region file_parent.allocate_exclusive_page()
                this.interp.set_eval_region(file_region)
                this.process_flow_obj_content(sosofo)
                this.interp.set_eval_region(saved_region)
                file_parent.deallocate_exclusive_page(file_region)
                sg.end_entity()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_ENTITY_REF
        {
            this.push_fo_style(fo)
            var rer: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set rer: this.resolve_nics(fo)
            if rer <> null
                sg.entity_ref(rer.get_name())
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_PROCESSING_INSTRUCTION
        {
            this.push_fo_style(fo)
            var rpi: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set rpi: this.resolve_nics(fo)
            if rpi <> null
                sg.processing_instruction(rpi.get_data())
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_DOCUMENT_TYPE
        {
            this.push_fo_style(fo)
            var rdt: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set rdt: this.resolve_nics(fo)
            if rdt <> null
                sg.document_type(rdt.get_name(), rdt.get_public_id(), rdt.get_system_id())
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_DIRECTORY
        {
            this.push_fo_style(fo)
            var rdi: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set rdi: this.resolve_nics(fo)
            if rdi <> null
            {
                sg.start_directory(rdi.get_path())
                this.process_flow_obj_content(sosofo)
                sg.end_directory()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_FORMATTING_INSTRUCTION
        {
            this.push_fo_style(fo)
            var rfi: ref[FlowObj]? fo
            if fo.get_nic_code() <> null
                set rfi: this.resolve_nics(fo)
            if rfi <> null
                sg.formatting_instruction(rfi.get_data())
            this.pop_fo_style(fo)
            return
        }
        ; FOC_UNKNOWN and anything unported: content only.
        this.process_flow_obj_content(sosofo)
    }

    ; the element GI: the explicit `gi:` characteristic, else the current node's
    ; generic identifier (ElementFlowObj's default-to-node behaviour).
    function element_gi(this: ref[ProcessContext], fo: ref[FlowObj]) returns StringC
    {
        let gi fo.get_gi()
        if gi.get_size() > 0
            return gi
        let node this.vm.get_current_node()
        if node <> null
            return node.get_gi()
        gi
    }
}
