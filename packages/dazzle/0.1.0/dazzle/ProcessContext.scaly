; ProcessContext — drives a grove through a mode's construction rules,
; emitting a flow-object sequence into a FOTBuilder (Style/ProcessContext.cxx +
; SosofoObj::process). process(root) walks the tree: each node is matched, its
; rule evaluated to a sosofo, and the sosofo processed — process-children
; recurses, literal emits characters, and so on.
;
; Inc 5a scope (Konstruktionsregeln-Kern): construction rules driving the real
; transform FOTBuilder (Inc 5b slice A) with the `make` special form wired in
; (slice B). Deferred (the print/connection machinery): style stacks,
; connections/ports, tables, page types, inherited characteristics — Inc 9
; (print path). process-children-trim approximates to plain process-children
; (whitespace trimming lands with the trim rules).

use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use dazzle.Grove.GroveNode
use dazzle.ELObj.ELObj
use dazzle.ELObj.FlowObj
use dazzle.ELObj.SosofoCtlRec
use dazzle.VM.VM
use dazzle.Interpreter.Interpreter
use dazzle.ProcessingMode.ProcessingMode
use dazzle.ProcessingMode.Rule
use dazzle.ProcessingMode.Specificity
use dazzle.TransformFOTBuilder.TransformFOTBuilder
use dazzle.SgmlFOTBuilder.SgmlFOTBuilder
use dazzle.ELObj.Identifier
use dazzle.Style.StyleStack
use dazzle.Style.InheritedC
use dazzle.Style.InheritedCInfo
use dazzle.Style.DisplayNIC
use dazzle.Style.Convert
use dazzle.Style.TableNICRec
use dazzle.Style.TableColumnNICRec
use dazzle.Style.TableCellNICRec
use dazzle.Style.RuleNICRec
use dazzle.Style.VarStyleRec
use dazzle.Insn.Insn
use dazzle.InterpreterMessages.InterpreterMessages
use opensp.Location.Location

; ProcessContext::Table — the per-table state (row/column styles, the covered
; rowspan tracker). Lives on the eval region CURRENT AT startTable (the table
; node's bracket, which outlives all row/cell child brackets); every internal
; allocation must use `host`, never the (deeper) region current at add time.
; NOTE (RBMM hazard, documented): a column/row STYLE made by a DESCENDANT
; node's rule lives on that descendant's bracket and dangles once its bracket
; pops — the reference-faithful common shape (columns made in the table's own
; rule, row styles used only while the row processes) is safe.
define TableRec
(
    prev: pointer[TableRec]
    host: pointer[Page]
    row_style: pointer[ELObj]
    current_column: int
    in_row: bool
    n_columns: int
    ; the connectable level current when the row started (Table::
    ; rowConnectableLevel) — endConnection closes a row it opened.
    row_connectable_level: int
    covered: pointer[Array[int]]
    column_styles: pointer[Array[pointer[Array[pointer[ELObj]]]]]
)
{
    function make(host: pointer[Page], prev: pointer[TableRec]) returns pointer[TableRec]
    {
        let t host.allocate(sizeof TableRec, alignof TableRec) as pointer[TableRec]
        set t.prev: prev
        set t.host: host
        set t.row_style: null
        set t.current_column: 0
        set t.in_row: false
        set t.n_columns: 0
        set t.row_connectable_level: 0
        set t.covered: Array[int]^host()
        set t.column_styles: Array[pointer[Array[pointer[ELObj]]]]^host()
        t
    }
}

; ProcessContext::Port — a named connection target of a flow object with
; non-principal ports (table-part header/footer). `buf` is the port's sink
; (the byte-level SaveFOTBuilder the owner replays); over-connections while
; `connected` queue their own buffers, flushed into `buf` in order when the
; count drops to zero. All allocations live on the OWNER's region (`host`,
; the region current at push_ports — it outlives the deeper node brackets
; that connect).
define PortRec
(
    labels: pointer[Array[pointer[ELObj]]]
    buf: pointer[Array[u32]]
    save_queue: pointer[Array[pointer[Array[u32]]]]
    connected: int
    host: pointer[Page]
)
{
    function make(host: pointer[Page], lbl: pointer[ELObj], buf: pointer[Array[u32]]) returns pointer[PortRec]
    {
        let p host.allocate(sizeof PortRec, alignof PortRec) as pointer[PortRec]
        let labels Array[pointer[ELObj]]^host()
        labels.add(lbl)
        set p.labels: labels
        set p.buf: buf
        set p.save_queue: Array[pointer[Array[u32]]]^host()
        set p.connected: 0
        set p.host: host
        p
    }
}

; ProcessContext::Connectable — a flow object that can be connected to
; (push_ports), or the portless carrier startMapContent synthesizes for
; principal-port relabeling. Carries a style-stack SNAPSHOT (ported content
; inherits through the port, not from its lexical position).
define ConnectableRec
(
    prev: pointer[ConnectableRec]
    ports: pointer[Array[pointer[PortRec]]]
    principal_port_labels: pointer[Array[pointer[ELObj]]]
    style_stack: pointer[StyleStack]
    flow_obj_level: int
    host: pointer[Page]
)
{
    function make(host: pointer[Page], style_stack: pointer[StyleStack], flow_obj_level: int, prev: pointer[ConnectableRec]) returns pointer[ConnectableRec]
    {
        let c host.allocate(sizeof ConnectableRec, alignof ConnectableRec) as pointer[ConnectableRec]
        set c.prev: prev
        set c.ports: Array[pointer[PortRec]]^host()
        set c.principal_port_labels: Array[pointer[ELObj]]^host()
        set c.style_stack: style_stack
        set c.flow_obj_level: flow_obj_level
        set c.host: host
        c
    }
}

; ProcessContext::Connection — a label: connection between a flow object and
; its flow parent. `buf` = the output target (null = the base stream);
; `style_stack` = the connection's own copy of the connectable's snapshot
; (null on the base connection = the ProcessContext's stack). n_bad_follow
; counts startConnection failures so the matching endConnection pops nothing.
define ConnectionRec
(
    prev: pointer[ConnectionRec]
    buf: pointer[Array[u32]]
    style_stack: pointer[StyleStack]
    port: pointer[PortRec]
    connectable_level: int
    n_bad_follow: int
)
{
    function make(host: pointer[Page], buf: pointer[Array[u32]], style_stack: pointer[StyleStack], port: pointer[PortRec], connectable_level: int, prev: pointer[ConnectionRec]) returns pointer[ConnectionRec]
    {
        let c host.allocate(sizeof ConnectionRec, alignof ConnectionRec) as pointer[ConnectionRec]
        set c.prev: prev
        set c.buf: buf
        set c.style_stack: style_stack
        set c.port: port
        set c.connectable_level: connectable_level
        set c.n_bad_follow: 0
        c
    }
}

; principalPortSaveQueues_ — buffers of principal-restored connections made
; at a DEEPER flow-obj level than their connectable; flushed (and the record
; unlinked) when the level unwinds back to `level`. Lives on the
; connectable's region — flush + unlink always precede that bracket's death.
define PrincipalQueueRec
(
    prev: pointer[PrincipalQueueRec]
    level: int
    bufs: pointer[Array[pointer[Array[u32]]]]
    host: pointer[Page]
)
{
    function make(host: pointer[Page], level: int, prev: pointer[PrincipalQueueRec]) returns pointer[PrincipalQueueRec]
    {
        let q host.allocate(sizeof PrincipalQueueRec, alignof PrincipalQueueRec) as pointer[PrincipalQueueRec]
        set q.prev: prev
        set q.level: level
        set q.bufs: Array[pointer[Array[u32]]]^host()
        set q.host: host
        q
    }
}

define ProcessContext (vm: pointer[VM], interp: pointer[Interpreter], fotb: pointer[TransformFOTBuilder], match_spec: Specificity, mode: pointer[ProcessingMode], sgml_fotb: pointer[void], style_stack: pointer[void], have_page_type: bool, page_type: int, table_stack: pointer[TableRec], connection_stack: pointer[ConnectionRec], connectable_stack: pointer[ConnectableRec], connectable_level: int, flow_obj_level: int, principal_queues: pointer[PrincipalQueueRec])
{
    function make(host: pointer[Page], interp: pointer[Interpreter], fotb: pointer[TransformFOTBuilder]) returns pointer[ProcessContext]
    {
        let pc host.allocate(sizeof ProcessContext, alignof ProcessContext) as pointer[ProcessContext]
        set pc.vm: VM.make(host, interp)
        set pc.interp: interp
        set pc.fotb: fotb
        set pc.match_spec: Specificity()
        set pc.mode: null
        set pc.sgml_fotb: null
        set pc.style_stack: null
        set pc.have_page_type: false
        set pc.page_type: 0
        set pc.table_stack: null
        set pc.connection_stack: ConnectionRec.make(host, null, null, null, 0, null)
        set pc.connectable_stack: null
        set pc.connectable_level: 0
        set pc.flow_obj_level: 0
        set pc.principal_queues: null
        pc
    }

    function get_fotb(this: ProcessContext) returns pointer[TransformFOTBuilder]
        fotb

    ; the fot-backend constructor: the SgmlFOTBuilder sink + a style stack
    ; (the transform path never pushes styles — its reference setters are
    ; no-ops; see DESIGN.md Inc 8).
    function make_fot(host: pointer[Page], interp: pointer[Interpreter], sgml: pointer[SgmlFOTBuilder]) returns pointer[ProcessContext]
    {
        let pc host.allocate(sizeof ProcessContext, alignof ProcessContext) as pointer[ProcessContext]
        set pc.vm: VM.make(host, interp)
        set pc.interp: interp
        set pc.fotb: null
        set pc.match_spec: Specificity()
        set pc.mode: null
        set pc.sgml_fotb: sgml as pointer[void]
        set pc.style_stack: StyleStack.make(host) as pointer[void]
        set pc.connection_stack: ConnectionRec.make(host, null, null, null, 0, null)
        set pc.connectable_stack: null
        set pc.connectable_level: 0
        set pc.flow_obj_level: 0
        set pc.principal_queues: null
        set pc.have_page_type: false
        set pc.page_type: 0
        set pc.table_stack: null
        pc
    }

    function sgml_sink(this: ProcessContext) returns pointer[SgmlFOTBuilder]
        sgml_fotb as pointer[SgmlFOTBuilder]

    ; --- connections & ports (label:/content-map:, ProcessContext.cxx) -------

    ; currentStyleStack — the top connection's stack (its copy of the
    ; connectable's snapshot), else the base stack.
    function current_style_stack(this: pointer[ProcessContext]) returns pointer[StyleStack]
    {
        let c this.connection_stack
        if c <> null
        {
            if c.style_stack <> null
                return c.style_stack
        }
        this.style_stack as pointer[StyleStack]
    }

    ; route the fot sink at the top connection's buffer (null = base stream).
    procedure apply_conn_target(this: pointer[ProcessContext])
    {
        let sg this.sgml_sink()
        if sg = null
            return
        var buf: pointer[Array[u32]] null
        if this.connection_stack <> null
            set buf: this.connection_stack.buf
        sg.set_conn_target(buf)
    }

    procedure append_buf(dst: pointer[Array[u32]], src: pointer[Array[u32]])
    {
        if dst = null
            return
        if src = null
            return
        let n src.get_length()
        var i: size_t 0
        while i < n
        {
            let p src.get(i)
            if p <> null
                dst.add(*p)
            set i: i + (1 as size_t)
        }
    }

    ; FlowObj::process's flow-object-level bracket.
    procedure start_flow_obj(this: pointer[ProcessContext])
        set this.flow_obj_level: this.flow_obj_level + 1

    ; endFlowObj — unwind the level; flush (and unlink) the principal-port
    ; save queue parked at the new level into the current output.
    procedure end_flow_obj(this: pointer[ProcessContext])
    {
        set this.flow_obj_level: this.flow_obj_level - 1
        var q this.principal_queues
        var prev_q: pointer[PrincipalQueueRec] null
        while q <> null
        {
            if q.level = this.flow_obj_level
            {
                let sg this.sgml_sink()
                let n q.bufs.get_length()
                var i: size_t 0
                while i < n
                {
                    let bp q.bufs.get(i)
                    if bp <> null
                    {
                        if sg <> null
                            sg.emit_captured(*bp)
                    }
                    set i: i + (1 as size_t)
                }
                if prev_q = null
                    set this.principal_queues: q.prev
                else
                    set prev_q.prev: q.prev
                return
            }
            set prev_q: q
            set q: q.prev
        }
    }

    ; pushPorts — a flow object with named ports (table-part header/footer):
    ; snapshot the current style stack, install the ports, bump the level.
    procedure push_ports(this: pointer[ProcessContext], labels: pointer[Array[pointer[ELObj]]], bufs: pointer[Array[pointer[Array[u32]]]], host: pointer[Page])
    {
        var css: pointer[StyleStack] null
        let cur this.current_style_stack()
        if cur <> null
            set css: cur.copy(host)
        let c ConnectableRec.make(host, css, this.flow_obj_level, this.connectable_stack)
        let n labels.get_length()
        var i: size_t 0
        while i < n
        {
            let lp labels.get(i)
            let bp bufs.get(i)
            if (lp <> null) and (bp <> null)
            {
                let port PortRec.make(host, *lp, *bp)
                c.ports.add(port)
            }
            set i: i + (1 as size_t)
        }
        set this.connectable_stack: c
        set this.connectable_level: this.connectable_level + 1
    }

    procedure pop_ports(this: pointer[ProcessContext])
    {
        set this.connectable_level: this.connectable_level - 1
        if this.connectable_stack <> null
            set this.connectable_stack: this.connectable_stack.prev
    }

    ; startConnection — walk the connectable stack for a port (or principal
    ; label) carrying `label`; no match is a badConnection error and the
    ; content follows into the current output (nBadFollow).
    procedure start_connection(this: pointer[ProcessContext], lbl: pointer[ELObj], loc: Location)
    {
        var conn_level this.connectable_level
        var c this.connectable_stack
        while c <> null
        {
            let np c.ports.get_length()
            var i: size_t 0
            while i < np
            {
                let pp c.ports.get(i)
                if pp <> null
                {
                    let port *pp
                    let nl port.labels.get_length()
                    var j: size_t 0
                    while j < nl
                    {
                        let lp port.labels.get(j)
                        if lp <> null
                        {
                            ; symbols are interned — identity compare.
                            if *lp = lbl
                            {
                                this.restore_connection_port(c, port, conn_level)
                                return
                            }
                        }
                        set j: j + (1 as size_t)
                    }
                }
                set i: i + (1 as size_t)
            }
            let npl c.principal_port_labels.get_length()
            var k: size_t 0
            while k < npl
            {
                let plp c.principal_port_labels.get(k)
                if plp <> null
                {
                    if *plp = lbl
                    {
                        this.restore_connection_principal(c, conn_level)
                        return
                    }
                }
                set k: k + (1 as size_t)
            }
            set c: c.prev
            set conn_level: conn_level - 1
        }
        this.interp.set_next_location(loc)
        this.interp.message1(InterpreterMessages.badConnection(), lbl.symbol_name())
        let head this.connection_stack
        if head <> null
            set head.n_bad_follow: head.n_bad_follow + 1
    }

    ; restoreConnection, port case: first connection writes the port's buffer
    ; directly; concurrent ones queue their own (flushed at last end).
    procedure restore_connection_port(this: pointer[ProcessContext], c: pointer[ConnectableRec], port: pointer[PortRec], conn_level: int)
    {
        let host this.interp.get_host()
        var buf: pointer[Array[u32]] null
        if port.connected > 0
        {
            set port.connected: port.connected + 1
            let ch c.host
            set buf: Array[u32]^ch()
            port.save_queue.add(buf)
        }
        else
        {
            set buf: port.buf
            set port.connected: 1
        }
        var css: pointer[StyleStack] null
        if c.style_stack <> null
            set css: c.style_stack.copy(host)
        let cn ConnectionRec.make(host, buf, css, port, conn_level, this.connection_stack)
        set this.connection_stack: cn
        this.apply_conn_target()
        this.connection_start_node()
    }

    ; restoreConnection, principal case ((label #f) content-map entries): at
    ; the connectable's own flow-obj level the content joins the current
    ; output; from deeper levels it buffers until the level unwinds.
    procedure restore_connection_principal(this: pointer[ProcessContext], c: pointer[ConnectableRec], conn_level: int)
    {
        let host this.interp.get_host()
        var buf: pointer[Array[u32]] null
        if c.flow_obj_level = this.flow_obj_level
        {
            let head this.connection_stack
            if head <> null
                set buf: head.buf
        }
        else
        {
            let ch c.host
            set buf: Array[u32]^ch()
            var q this.principal_queues
            var found: pointer[PrincipalQueueRec] null
            while q <> null
            {
                if q.level = c.flow_obj_level
                {
                    set found: q
                    break
                }
                set q: q.prev
            }
            if found = null
            {
                set found: PrincipalQueueRec.make(ch, c.flow_obj_level, this.principal_queues)
                set this.principal_queues: found
            }
            found.bufs.add(buf)
        }
        var css: pointer[StyleStack] null
        if c.style_stack <> null
            set css: c.style_stack.copy(host)
        let cn ConnectionRec.make(host, buf, css, null, conn_level, this.connection_stack)
        set this.connection_stack: cn
        this.apply_conn_target()
        this.connection_start_node()
    }

    ; the startNode a restored connection emits (pending-anchor bookkeeping).
    procedure connection_start_node(this: pointer[ProcessContext])
    {
        let sg this.sgml_sink()
        if sg = null
            return
        let node this.vm.get_current_node()
        var mname StringC()
        if this.mode <> null
            set mname: this.mode.get_name()
        sg.start_node(node, mname)
    }

    procedure end_connection(this: pointer[ProcessContext])
    {
        ; a table row opened under this connection's connectable closes here.
        if this.in_table_row()
        {
            let t this.table_stack
            if t.row_connectable_level = this.connectable_level
                this.end_table_row()
        }
        let head this.connection_stack
        if head = null
            return
        if head.n_bad_follow > 0
        {
            set head.n_bad_follow: head.n_bad_follow - 1
            return
        }
        let sg this.sgml_sink()
        if sg <> null
            sg.end_node()
        let port head.port
        if port <> null
        {
            set port.connected: port.connected - 1
            if port.connected = 0
            {
                let n port.save_queue.get_length()
                var i: size_t 0
                while i < n
                {
                    let bp port.save_queue.get(i)
                    if bp <> null
                        ProcessContext.append_buf(port.buf, *bp)
                    set i: i + (1 as size_t)
                }
                let ph port.host
                set port.save_queue: Array[pointer[Array[u32]]]^ph()
            }
        }
        set this.connection_stack: head.prev
        this.apply_conn_target()
    }

    procedure bad_content_map(this: pointer[ProcessContext], flagged: pointer[bool], loc: Location)
    {
        if *flagged
            return
        set *flagged: true
        this.interp.set_next_location(loc)
        this.interp.message0(InterpreterMessages.badContentMap())
    }

    ; startMapContent — rebind the port labels of the nearest connectable at
    ; this flow-obj level (synthesizing a portless one if needed) from a
    ; ((label port|#f) ...) list; #f targets the principal port.
    procedure start_map_content(this: pointer[ProcessContext], map_in: pointer[ELObj], loc: Location)
    {
        let interp this.interp
        let host interp.get_host()
        var need false
        if this.connectable_stack = null
            set need: true
        else
        {
            if this.connectable_stack.flow_obj_level <> this.flow_obj_level
                set need: true
        }
        if need
        {
            var css: pointer[StyleStack] null
            let cur this.current_style_stack()
            if cur <> null
                set css: cur.copy(host)
            let nc ConnectableRec.make(host, css, this.flow_obj_level, this.connectable_stack)
            ; NOTE: no connectable_level bump (reference startMapContent).
            set this.connectable_stack: nc
        }
        let conn this.connectable_stack
        ; snapshot each port's current (first) label, then clear the labels.
        let np conn.ports.get_length()
        let port_names Array[pointer[ELObj]]^host()
        var i: size_t 0
        while i < np
        {
            let pp conn.ports.get(i)
            if pp <> null
            {
                let port *pp
                var nm: pointer[ELObj] null
                if port.labels.get_length() > (0 as size_t)
                {
                    let l0 port.labels.get(0 as size_t)
                    if l0 <> null
                        set nm: *l0
                }
                port_names.add(nm)
                let ph port.host
                set port.labels: Array[pointer[ELObj]]^ph()
            }
            else
                port_names.add(null)
            set i: i + (1 as size_t)
        }
        var bad false
        var m map_in
        while true
        {
            if m = null
                break
            if m.is_nil()
                break
            if m.is_pair() = false
            {
                this.bad_content_map(&bad, loc)
                break
            }
            let entry m.get_car()
            set m: m.get_cdr()
            if entry.is_pair() = false
            {
                this.bad_content_map(&bad, loc)
                continue
            }
            let lbl entry.get_car()
            if lbl.is_symbol_p() = false
            {
                this.bad_content_map(&bad, loc)
                continue
            }
            let rest entry.get_cdr()
            if rest.is_pair() = false
            {
                this.bad_content_map(&bad, loc)
                continue
            }
            let port_val rest.get_car()
            if port_val.is_symbol_p()
            {
                var found false
                var pi: size_t 0
                while pi < np
                {
                    if found = false
                    {
                        let nmp port_names.get(pi)
                        if nmp <> null
                        {
                            if *nmp = port_val
                            {
                                let pp2 conn.ports.get(pi)
                                if pp2 <> null
                                {
                                    let port2 *pp2
                                    port2.labels.add(lbl)
                                }
                                set found: true
                            }
                        }
                    }
                    set pi: pi + (1 as size_t)
                }
                if found = false
                {
                    interp.set_next_location(loc)
                    interp.message1(InterpreterMessages.contentMapBadPort(), port_val.symbol_name())
                }
            }
            else
            {
                if port_val = interp.make_false()
                    conn.principal_port_labels.add(lbl)
                else
                    this.bad_content_map(&bad, loc)
            }
            if rest.get_cdr().is_nil() = false
                this.bad_content_map(&bad, loc)
        }
    }

    procedure end_map_content(this: pointer[ProcessContext])
    {
        let c this.connectable_stack
        if c <> null
        {
            if c.ports.get_length() = (0 as size_t)
                set this.connectable_stack: c.prev
        }
    }

    ; characters dispatch — the two sinks (exactly one is non-null).
    function emit_characters(this: pointer[ProcessContext], s: pointer[u32], n: size_t)
    {
        let sg this.sgml_sink()
        if sg <> null
        {
            sg.characters(s, n)
            return
        }
        if this.fotb <> null
            this.fotb.characters(s, n)
    }

    function emit_characters_node(this: pointer[ProcessContext], node: pointer[GroveNode], s: pointer[u32], n: size_t)
    {
        let sg this.sgml_sink()
        if sg <> null
        {
            sg.characters_from_node(node, s, n)
            return
        }
        if this.fotb <> null
            this.fotb.characters_from_node(node, s, n)
    }

    ; process(root): the entry point (StyleEngine::process). No initial style in
    ; Inc 5a; go straight to processNode in the initial mode.
    function process(this: pointer[ProcessContext], node: pointer[GroveNode])
    {
        let m this.interp.initial_processing_mode()
        this.process_node(node, m)
    }

    ; processNode: characters flow straight through; element/document nodes are
    ; matched and their rule evaluated to a sosofo. currentNode + match cursor +
    ; mode are saved and restored around the (possibly nested) eval.
    function process_node(this: pointer[ProcessContext], node: pointer[GroveNode], mode: pointer[ProcessingMode])
    {
        if node = null
            return
        let cls node.get_class()
        if cls = GN_DATA
        {
            let c node.get_chars()
            this.emit_characters_node(node, c.data_ptr(), c.get_size())
            return
        }
        if cls = GN_PI
            return
        ; eval bracket (the Collector seam, RBMM shape): a fresh scratch
        ; region per node — the rule eval's transients (intermediate values,
        ; the sosofo tree, per-call insns) die when the node is done, where
        ; the reference reclaims them with the GC. Brackets nest with the
        ; recursion; inner regions may point into outer ones, never back.
        ; Everything that must survive is copied out (FOT output) or built
        ; on the perm host (interning, forced Identifier values).
        let saved_region this.interp.get_eval_region()
        let parent this.interp.get_host()
        let scratch parent.allocate_exclusive_page()
        this.interp.set_eval_region(scratch)
        let host this.interp.get_host()
        let save_node this.vm.get_current_node()
        let save_spec this.match_spec
        let save_mode this.mode
        let save_vm_mode this.vm.get_processing_mode()
        this.vm.set_current_node(node)
        set this.match_spec: Specificity()
        set this.mode: mode
        ; EvalContext.processingMode — the process-* primitives capture it,
        ; with-mode brackets rebind it during the eval.
        this.vm.set_processing_mode(mode as pointer[void])
        ; fot: the pending-anchor bracket (ProcessContext.cxx startNode/endNode)
        let sg0 this.sgml_sink()
        if sg0 <> null
            sg0.start_node(node, mode.get_name())
        let rule: pointer[Rule] mode.find_match(node, host, &this.match_spec)
        if rule = null
            this.process_children(mode)
        else
        {
            let insn rule.get_rule_insn()
            let obj this.vm.eval(insn, null, null)
            if this.interp.is_error(obj)
            {
                ; initial (unnamed) mode falls back to processing children.
                if mode.get_name().get_size() = (0 as size_t)
                    this.process_children(mode)
            }
            else
                this.process_sosofo(obj)
        }
        if sg0 <> null
            sg0.end_node()
        this.vm.set_current_node(save_node)
        set this.match_spec: save_spec
        set this.mode: save_mode
        this.vm.set_processing_mode(save_vm_mode)
        this.interp.set_eval_region(saved_region)
        parent.deallocate_exclusive_page(scratch)
    }

    ; processChildren: process each child of the current node in `mode`. If the
    ; current node has no children but is the grove root, descend to the
    ; document element (mirrors getDocumentElement).
    function process_children(this: pointer[ProcessContext], mode: pointer[ProcessingMode])
    {
        let node this.vm.get_current_node()
        if node = null
            return
        let n node.child_count()
        if n = 0
        {
            if node.get_class() = GN_DOCUMENT
            {
                var k 0
                while k < node.child_count()
                {
                    this.process_node(node.child_at(k), mode)
                    set k: k + 1
                }
            }
            return
        }
        var i 0
        while i < n
        {
            this.process_node(node.child_at(i), mode)
            set i: i + 1
        }
    }

    ; nextMatch: resume the current node's rule scan at the next lower rule.
    function next_match(this: pointer[ProcessContext])
    {
        let host this.interp.get_host()
        let node this.vm.get_current_node()
        let save_spec this.match_spec
        let rule: pointer[Rule] this.mode.find_match(node, host, &this.match_spec)
        if rule = null
            this.process_children(this.mode)
        else
        {
            let obj this.vm.eval(rule.get_rule_insn(), null, null)
            if this.interp.is_error(obj)
                this.process_children(this.mode)
            else
                this.process_sosofo(obj)
        }
        set this.match_spec: save_spec
    }

    ; processNodeList: process every node of a node-list value (ProcessNodeList
    ; SosofoObj::process). currentNode is saved/restored per node by processNode.
    function process_node_list(this: pointer[ProcessContext], nl: pointer[ELObj], mode: pointer[ProcessingMode])
    {
        if nl = null
            return
        if nl.is_node_list_p() = false
            return
        let n nl.node_list_count()
        var i 0
        while i < n
        {
            let node nl.node_list_node(i)
            if node <> null
                this.process_node(node, mode)
            set i: i + 1
        }
    }

    ; the mode a process-* sosofo captured at eval time (stashed in the parts
    ; slot as an opaque pointer — see ELObj); null falls back to the context's
    ; current mode.
    function sosofo_mode(this: pointer[ProcessContext], sosofo: pointer[ELObj]) returns pointer[ProcessingMode]
    {
        let m sosofo.sosofo_parts() as pointer[ProcessingMode]
        if m = null
            return this.mode
        m
    }

    ; SosofoObj::process — the sosofo interpreter. Dispatches on kind.
    function process_sosofo(this: pointer[ProcessContext], sosofo: pointer[ELObj])
    {
        if sosofo = null
            return
        if sosofo.is_sosofo_p() = false
            return
        let kind sosofo.sosofo_kind()
        if kind = SOSO_APPEND
        {
            let parts sosofo.sosofo_parts()
            if parts = null
                return
            let n parts.get_length()
            let b parts.get_buffer()
            var i: size_t 0
            while i < n
            {
                this.process_sosofo(*(b + i))
                set i: i + 1
            }
            return
        }
        if kind = SOSO_LITERAL
        {
            let str_obj sosofo.sosofo_aux()
            if str_obj = null
                return
            let host this.interp.get_host()
            let s str_obj.string_data(host)
            this.emit_characters(s.data_ptr(), s.get_size())
            return
        }
        if kind = SOSO_PROCESS_CHILDREN
        {
            this.process_children(this.sosofo_mode(sosofo))
            return
        }
        if kind = SOSO_PROCESS_CHILDREN_TRIM
        {
            this.process_children(this.sosofo_mode(sosofo))
            return
        }
        if kind = SOSO_PROCESS_NODE_LIST
        {
            this.process_node_list(sosofo.sosofo_aux(), this.sosofo_mode(sosofo))
            return
        }
        if kind = SOSO_PROCESS_NODE
        {
            let nl sosofo.sosofo_aux()
            if nl <> null
            {
                let nd nl.node_list_node(0)
                if nd <> null
                    this.process_node(nd, this.sosofo_mode(sosofo))
            }
            return
        }
        if kind = SOSO_NEXT_MATCH
        {
            this.next_match()
            return
        }
        if kind = SOSO_PAGE_NUMBER
        {
            ; FOTBuilder::pageNumber is a no-op outside the fot backend.
            let sg this.sgml_sink()
            if sg <> null
                sg.page_number()
            return
        }
        if kind = SOSO_CURRENT_NODE_PAGE_NUMBER
        {
            let sg this.sgml_sink()
            if sg <> null
            {
                let nl sosofo.sosofo_aux()
                if nl <> null
                {
                    let nd nl.node_list_node(0)
                    if nd <> null
                        sg.current_node_page_number(nd)
                }
            }
            return
        }
        if kind = SOSO_PAGE_TYPE
        {
            ; PageTypeSosofoObj::process — nothing outside a header/footer.
            if this.have_page_type
            {
                let parts sosofo.sosofo_parts()
                let flag_obj sosofo.sosofo_aux()
                if (parts <> null) and (flag_obj <> null)
                {
                    var pick 1
                    if (this.page_type & flag_obj.exact_integer_value()) <> 0
                        set pick: 0
                    let pp parts.get(pick as size_t)
                    if pp <> null
                        this.process_sosofo(*pp)
                }
            }
            return
        }
        if kind = SOSO_LABEL
        {
            ; LabelSosofoObj::process — connect, process, disconnect.
            let ctl: pointer[SosofoCtlRec] sosofo.sosofo_ctl()
            let content sosofo.sosofo_aux()
            if ctl <> null
            {
                let cloc ctl.get_loc()
                this.start_connection(ctl.obj, cloc)
            }
            this.process_sosofo(content)
            if ctl <> null
                this.end_connection()
            return
        }
        if kind = SOSO_CONTENT_MAP
        {
            ; ContentMapSosofoObj::process.
            let ctl2: pointer[SosofoCtlRec] sosofo.sosofo_ctl()
            let content2 sosofo.sosofo_aux()
            if ctl2 <> null
            {
                let mloc ctl2.get_loc()
                this.start_map_content(ctl2.obj, mloc)
            }
            this.process_sosofo(content2)
            if ctl2 <> null
                this.end_map_content()
            return
        }
        if kind = SOSO_FLOWOBJ
            this.process_flow_obj(sosofo)
    }

    ; process a flow object's content sosofos (held in the `parts` slot).
    function process_flow_obj_content(this: pointer[ProcessContext], sosofo: pointer[ELObj])
    {
        let parts sosofo.sosofo_parts()
        if parts = null
            return
        let n parts.get_length()
        let b parts.get_buffer()
        var i: size_t 0
        while i < n
        {
            this.process_sosofo(*(b + i))
            set i: i + 1
        }
    }

    ; SOSO_FLOWOBJ — dispatch a transform flow object to the FOTBuilder callbacks
    ; (jade/TransformFOTBuilder flow-object classes). Compound flow objects
    ; (element/entity/directory/sequence) bracket their content with start/end;
    ; atomic ones emit a single callback. An element with an empty gi
    ; characteristic falls back to the current node's GI (ElementFlowObj).
    function process_flow_obj(this: pointer[ProcessContext], sosofo: pointer[ELObj])
    {
        let fo: pointer[FlowObj] sosofo.sosofo_flowobj()
        if fo = null
            return
        let foc fo.get_foc()
        ; FlowObj::process — the flow-object-level bracket (the principal-port
        ; save queues flush as the level unwinds).
        this.start_flow_obj()
        if this.sgml_sink() <> null
            this.process_flow_obj_fot(sosofo, fo, foc)
        else
            this.process_flow_obj_transform(sosofo, fo, foc)
        this.end_flow_obj()
    }

    ; the transform backend's flow-object dispatch (jade/TransformFOTBuilder).
    function process_flow_obj_transform(this: pointer[ProcessContext], sosofo: pointer[ELObj], fo: pointer[FlowObj], foc: int)
    {
        if foc = FOC_ELEMENT
        {
            let gi this.element_gi(fo)
            let atts fo.get_atts()
            this.fotb.start_element(gi, atts)
            this.process_flow_obj_content(sosofo)
            this.fotb.end_element()
            return
        }
        if foc = FOC_EMPTY_ELEMENT
        {
            let gi this.element_gi(fo)
            let atts fo.get_atts()
            this.fotb.empty_element(gi, atts)
            return
        }
        if foc = FOC_ENTITY
        {
            this.fotb.start_entity(fo.get_system_id())
            this.process_flow_obj_content(sosofo)
            this.fotb.end_entity()
            return
        }
        if foc = FOC_ENTITY_REF
        {
            this.fotb.entity_ref(fo.get_name())
            return
        }
        if foc = FOC_PROCESSING_INSTRUCTION
        {
            this.fotb.processing_instruction(fo.get_data())
            return
        }
        if foc = FOC_DOCUMENT_TYPE
        {
            this.fotb.document_type(fo.get_name(), fo.get_public_id(), fo.get_system_id())
            return
        }
        if foc = FOC_FORMATTING_INSTRUCTION
        {
            this.fotb.formatting_instruction(fo.get_data())
            return
        }
        if foc = FOC_DIRECTORY
        {
            this.fotb.start_directory(fo.get_path())
            this.process_flow_obj_content(sosofo)
            this.fotb.end_directory()
            return
        }
        ; FOC_SEQUENCE (and any unknown class): just process the content.
        this.process_flow_obj_content(sosofo)
    }

    ; --- the fot path (Inc 8) -------------------------------------------------
    ; FlowObj::process — push the attached style (emitting set_ic for every
    ; spec pushed at this level), emit the flow object, process content, pop.
    function push_fo_style(this: pointer[ProcessContext], fo: pointer[FlowObj])
    {
        let ss this.current_style_stack()
        let style fo.get_style()
        if style = null
        {
            ss.push_empty()
            return
        }
        this.push_style_obj(style)
    }

    ; StyleStack::push(style, vm, fotb) — the raw style push (borders, table
    ; column/row styles): push + render this level's specs through set_ic.
    function push_style_obj(this: pointer[ProcessContext], style: pointer[ELObj])
    {
        let ss this.current_style_stack()
        let scratch this.interp.get_host()
        ss.push_start(scratch)
        ss.push_continue(style, scratch)
        ; pushEnd: re-push outer actual-*-depending specs whose dependencies
        ; changed at this level, then render the specs pushed at this level in
        ; push order (VarInheritedC codes evaluate + cache here; a spec whose
        ; evaluation recorded dependencies keeps depending at this level).
        ss.push_end_prologue(scratch)
        let sg this.sgml_sink()
        let list ss.current_specs()
        if list <> null
        {
            let n list.get_length()
            var i: size_t 0
            while i < n
            {
                let indp list.get(i)
                if indp <> null
                {
                    let info ss.info_at(*indp)
                    if info <> null
                    {
                        let cic VM.resolve_set(ss, info, this.interp)
                        if cic <> null
                            sg.set_ic(cic)
                        if info.dependencies.get_length() > (0 as size_t)
                            ss.note_depending(*indp)
                    }
                }
                set i: i + (1 as size_t)
            }
        }
    }

    function pop_fo_style(this: pointer[ProcessContext], fo: pointer[FlowObj])
    {
        let ss this.current_style_stack()
        if fo.get_style() = null
        {
            ss.pop_empty()
            return
        }
        ss.pop()
    }

    ; --- tables (ProcessContext.cxx Table machinery + Table*FlowObj) ---------
    function in_table(this: pointer[ProcessContext]) returns bool
        table_stack <> null

    function in_table_row(this: pointer[ProcessContext]) returns bool
    {
        if this.table_stack = null
            return false
        this.table_stack.in_row
    }

    function current_table_column(this: pointer[ProcessContext]) returns int
    {
        if this.table_stack = null
            return 0
        this.table_stack.current_column
    }

    function table_row_style(this: pointer[ProcessContext]) returns pointer[ELObj]
    {
        if this.table_stack = null
            return null
        this.table_stack.row_style
    }

    ; ProcessContext::addTableColumn — per-column styles indexed [column][span-1].
    procedure add_table_column(this: pointer[ProcessContext], column_index: int, span: int, style: pointer[ELObj])
    {
        let t this.table_stack
        if t = null
            return
        set t.current_column: column_index + span
        while t.column_styles.get_length() <= (column_index as size_t)
            t.column_styles.add(null)
        var tem: pointer[Array[pointer[ELObj]]] null
        let tp t.column_styles.get(column_index as size_t)
        if tp <> null
            set tem: *tp
        if tem = null
        {
            let h t.host
            set tem: Array[pointer[ELObj]]^h()
            t.column_styles.put(column_index as size_t, tem)
        }
        if span > 0
        {
            while tem.get_length() < (span as size_t)
                tem.add(null)
            tem.put((span - 1) as size_t, style)
        }
    }

    function table_column_style(this: pointer[ProcessContext], column_index: int, span: int) returns pointer[ELObj]
    {
        let t this.table_stack
        if t = null
            return null
        if (column_index as size_t) >= t.column_styles.get_length()
            return null
        let tp t.column_styles.get(column_index as size_t)
        if tp = null
            return null
        let tem *tp
        if tem = null
            return null
        if span <= 0
            return null
        if (span as size_t) > tem.get_length()
            return null
        let sp tem.get((span - 1) as size_t)
        if sp = null
            return null
        *sp
    }

    ; ProcessContext::noteTableCell — record coverage (rowspan countdown).
    procedure note_table_cell(this: pointer[ProcessContext], column_index: int, colspan: int, rowspan: int)
    {
        let t this.table_stack
        if t = null
            return
        set t.current_column: column_index + colspan
        while t.covered.get_length() < ((column_index + colspan) as size_t)
            t.covered.add(0)
        var i 0
        while i < colspan
        {
            t.covered.put((column_index + i) as size_t, rowspan)
            set i: i + 1
        }
        if column_index + colspan > t.n_columns
            set t.n_columns: column_index + colspan
    }

    procedure start_table_row(this: pointer[ProcessContext], style: pointer[ELObj])
    {
        let t this.table_stack
        if t <> null
        {
            set t.row_style: style
            set t.current_column: 0
            set t.in_row: true
            var rcl 0
            let head this.connection_stack
            if head <> null
                set rcl: head.connectable_level
            set t.row_connectable_level: rcl
        }
        this.sgml_sink().start_table_row()
    }

    ; ProcessContext::endTableRow — fill uncovered columns with synthesized
    ; cells (the trailing one is the "missing" dummy), then count down the
    ; rowspans.
    procedure end_table_row(this: pointer[ProcessContext])
    {
        let t this.table_stack
        if t <> null
        {
            var i 0
            while i < t.n_columns + 1
            {
                var cov 0
                if (i as size_t) < t.covered.get_length()
                {
                    let cp t.covered.get(i as size_t)
                    if cp <> null
                        set cov: *cp
                }
                if cov = 0
                {
                    set t.current_column: i
                    let scratch this.interp.get_host()
                    let rec TableCellNICRec.make(scratch)
                    if i >= t.n_columns
                        set rec.missing: true
                    this.process_table_cell(rec, null, null, null)
                }
                if i < t.n_columns
                {
                    let cp2 t.covered.get(i as size_t)
                    if cp2 <> null
                        t.covered.put(i as size_t, *cp2 - 1)
                }
                set i: i + 1
            }
            set t.in_row: false
        }
        this.sgml_sink().end_table_row()
    }

    ; ProcessContext::coverSpannedRows — synthesize empty rows until every
    ; vertical span is covered (each end_table_row fills + counts down).
    procedure cover_spanned_rows(this: pointer[ProcessContext])
    {
        let t this.table_stack
        if t = null
            return
        var n 0
        let len t.covered.get_length()
        var i: size_t 0
        while i < len
        {
            let cp t.covered.get(i)
            if cp <> null
            {
                if *cp > n
                    set n: *cp
            }
            set i: i + (1 as size_t)
        }
        while n > 0
        {
            this.start_table_row(null)
            this.end_table_row()
            set n: n - 1
        }
    }

    ; the actual value of a border characteristic resolved to the style to
    ; push (Table*FlowObj::border): #f/#t -> the canned border-present styles,
    ; a table-border sosofo -> its style, anything else -> null.
    function border_style_actual(this: pointer[ProcessContext], name: pointer[const_char]) returns pointer[ELObj]
    {
        let ident this.interp.lookup(StringC(name))
        let proto ident.get_inherited_c() as pointer[InheritedC]
        if proto = null
            return null
        let scratch this.interp.get_host()
        let deps Array[int]^scratch()
        let ss this.current_style_stack()
        let obj VM.stack_actual(ss, proto, Location(), this.interp, deps)
        if obj = null
            return null
        if this.interp.is_error(obj)
            return null
        if obj = this.interp.make_false()
            return this.interp.border_false_style()
        if obj = this.interp.make_true()
            return this.interp.border_true_style()
        if Convert.is_table_border_sosofo(obj)
            return obj.sosofo_flowobj().get_style()
        null
    }

    ; TableFlowObj::border — push the NIC style (or the table-border
    ; fallback), emit the atomic border element, pop.
    procedure emit_table_border(this: pointer[ProcessContext], style_in: pointer[ELObj], fallback: pointer[ELObj], which: int)
    {
        var style style_in
        if style = null
            set style: fallback
        if style <> null
            this.push_style_obj(style)
        let sg this.sgml_sink()
        if which = 0
            sg.table_before_row_border()
        if which = 1
            sg.table_after_row_border()
        if which = 2
            sg.table_before_column_border()
        if which = 3
            sg.table_after_column_border()
        if style <> null
        {
            let ss this.current_style_stack()
            ss.pop()
        }
    }

    ; TableCellFlowObj::border — always from the cell-*-border actual value.
    procedure emit_cell_border(this: pointer[ProcessContext], which: int)
    {
        var style: pointer[ELObj] null
        if which = 0
            set style: this.border_style_actual("cell-before-row-border")
        if which = 1
            set style: this.border_style_actual("cell-after-row-border")
        if which = 2
            set style: this.border_style_actual("cell-before-column-border")
        if which = 3
            set style: this.border_style_actual("cell-after-column-border")
        if style <> null
            this.push_style_obj(style)
        let sg this.sgml_sink()
        if which = 0
            sg.table_cell_before_row_border()
        if which = 1
            sg.table_cell_after_row_border()
        if which = 2
            sg.table_cell_before_column_border()
        if which = 3
            sg.table_cell_after_column_border()
        if style <> null
        {
            let ss this.current_style_stack()
            ss.pop()
        }
    }

    ; SetNonInheritedCsSosofoObj::resolve — evaluate a flow object's lazy NIC
    ; code against a fresh copy (NIC payloads deep-copied — the chain mutates
    ; the copy only), the CURRENT style stack at its post-push level
    ; (inherited-*/actual-* in NIC values read the pushed context) and the
    ; make-time display vars + current node. Returns null when a value
    ; expression yields an error (the FO then emits nothing; its style
    ; push/pop still happened — reference semantics).
    function resolve_nics(this: pointer[ProcessContext], fo: pointer[FlowObj]) returns pointer[FlowObj]
    {
        let interp this.interp
        let host interp.get_host()
        let copy fo.shallow_copy(host)
        let dn fo.get_dnic() as pointer[DisplayNIC]
        if dn <> null
            copy.set_dnic(dn.copy(host) as pointer[void])
        let foc fo.get_foc()
        if foc = FOC_TABLE
        {
            let tp fo.get_tnic() as pointer[TableNICRec]
            if tp <> null
                copy.set_tnic(tp.copy(host) as pointer[void])
        }
        if foc = FOC_TABLE_COLUMN
        {
            let cp fo.get_tnic() as pointer[TableColumnNICRec]
            if cp <> null
                copy.set_tnic(cp.copy(host) as pointer[void])
        }
        if foc = FOC_TABLE_CELL
        {
            let ep fo.get_tnic() as pointer[TableCellNICRec]
            if ep <> null
                copy.set_tnic(ep.copy(host) as pointer[void])
        }
        if foc = FOC_RULE
        {
            let rp fo.get_tnic() as pointer[RuleNICRec]
            if rp <> null
                copy.set_tnic(rp.copy(host) as pointer[void])
        }
        var hj 0
        while hj < 6
        {
            let hv fo.get_hf(hj)
            if hv <> null
                copy.set_hf(host, hj, hv)
            set hj: hj + 1
        }
        let vm VM.make(host, interp)
        var disp: pointer[pointer[ELObj]] null
        let style fo.get_style()
        if style <> null
        {
            let rec style.style_spec() as pointer[VarStyleRec]
            if rec <> null
            {
                vm.set_current_node(rec.node as pointer[GroveNode])
                set disp: rec.display
            }
        }
        let ss this.current_style_stack()
        set vm.style_stack: ss
        set vm.spec_level: ss.get_level()
        let deps Array[int]^host()
        set vm.actual_deps: deps
        let seed ELObj.make_flowobj_box(host, copy)
        let ret vm.eval(fo.get_nic_code() as pointer[Insn], disp, seed)
        if ret = null
            return null
        if interp.is_error(ret)
            return null
        copy
    }

    ; TableCellFlowObj::pushStyle + processInner + popStyle — shared by real
    ; cells (rec/style from the FO) and the synthesized fillers (defaults,
    ; null style, no content). `fo` non-null = a real cell whose lazy NICs
    ; (n-rows-spanned) resolve after the style pushes; a failed resolve skips
    ; the cell's emission but keeps the push/pop bracket.
    procedure process_table_cell(this: pointer[ProcessContext], rec: pointer[TableCellNICRec], style: pointer[ELObj], sosofo: pointer[ELObj], fo: pointer[FlowObj])
    {
        let sg this.sgml_sink()
        let ss this.current_style_stack()
        if this.in_table_row()
        {
            if rec.starts_row
            {
                this.end_table_row()
                this.start_table_row(null)
            }
        }
        else
            this.start_table_row(null)
        var colnum rec.column_index
        if rec.has_column_number = false
            set colnum: this.current_table_column()
        var n_push 0
        let col_style this.table_column_style(colnum, rec.n_columns_spanned)
        if col_style <> null
        {
            this.push_style_obj(col_style)
            sg.start_sequence()
            set n_push: n_push + 1
        }
        let row_style this.table_row_style()
        if row_style <> null
        {
            this.push_style_obj(row_style)
            sg.start_sequence()
            set n_push: n_push + 1
        }
        if style <> null
            this.push_style_obj(style)
        else
            ss.push_empty()
        ; the lazy NICs (n-rows-spanned) resolve AFTER the pushes; a failed
        ; resolve skips processInner (the push/pop bracket still closes).
        var skip false
        var xrec rec
        if fo <> null
        {
            if fo.get_nic_code() <> null
            {
                let rfo this.resolve_nics(fo)
                if rfo = null
                    set skip: true
                else
                {
                    let nrec rfo.get_tnic() as pointer[TableCellNICRec]
                    if nrec <> null
                        set xrec: nrec
                }
            }
        }
        if skip = false
        {
            if this.in_table() = false
            {
                this.interp.message0(InterpreterMessages.tableCellOutsideTable())
                if sosofo <> null
                    this.process_flow_obj_content(sosofo)
            }
            else
            {
                var erec xrec
                if xrec.has_column_number = false
                {
                    set erec: xrec.copy(this.interp.get_host())
                    set erec.column_index: colnum
                }
                sg.start_table_cell(erec)
                if xrec.missing = false
                    this.note_table_cell(colnum, xrec.n_columns_spanned, xrec.n_rows_spanned)
                this.emit_cell_border(0)
                this.emit_cell_border(1)
                this.emit_cell_border(2)
                this.emit_cell_border(3)
                if sosofo <> null
                    this.process_flow_obj_content(sosofo)
                sg.end_table_cell()
            }
        }
        if style <> null
            ss.pop()
        else
            ss.pop_empty()
        while n_push > 0
        {
            sg.end_sequence()
            ss.pop()
            set n_push: n_push - 1
        }
        if rec.ends_row
            this.end_table_row()
    }

    ; the fot flow-object dispatch (SgmlFOTBuilder's slice: sequence,
    ; paragraph, paragraph-break, display-group, line-field). Unknown classes
    ; (incl. the transform extensions bound as FOC_UNKNOWN under -t fot) are
    ; content-transparent; formatting-instruction is the base-class atomic
    ; no-op.
    function process_flow_obj_fot(this: pointer[ProcessContext], sosofo: pointer[ELObj], fo: pointer[FlowObj], foc: int)
    {
        let sg this.sgml_sink()
        if foc = FOC_PARAGRAPH
        {
            this.push_fo_style(fo)
            var rfo fo
            if fo.get_nic_code() <> null
                set rfo: this.resolve_nics(fo)
            if rfo <> null
            {
                sg.start_paragraph(rfo.get_dnic() as pointer[DisplayNIC])
                this.process_flow_obj_content(sosofo)
                sg.end_paragraph()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_PARAGRAPH_BREAK
        {
            this.push_fo_style(fo)
            var rfo fo
            if fo.get_nic_code() <> null
                set rfo: this.resolve_nics(fo)
            if rfo <> null
                sg.paragraph_break(rfo.get_dnic() as pointer[DisplayNIC])
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_RULE
        {
            ; RuleFlowObj::processInner — fotb.rule(nic); atomic (no content).
            this.push_fo_style(fo)
            var rfo fo
            if fo.get_nic_code() <> null
                set rfo: this.resolve_nics(fo)
            if rfo <> null
                sg.rule(rfo.get_tnic() as pointer[RuleNICRec], rfo.get_dnic() as pointer[DisplayNIC])
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_DISPLAY_GROUP
        {
            this.push_fo_style(fo)
            var rfo fo
            if fo.get_nic_code() <> null
                set rfo: this.resolve_nics(fo)
            if rfo <> null
            {
                sg.start_display_group(rfo.get_dnic() as pointer[DisplayNIC])
                this.process_flow_obj_content(sosofo)
                sg.end_display_group()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_LINE_FIELD
        {
            ; the lazy NICs (break-*-priority) resolve for their conversion
            ; diagnostics only — startLineField drops its NIC in the fot dump.
            this.push_fo_style(fo)
            var rfo fo
            if fo.get_nic_code() <> null
                set rfo: this.resolve_nics(fo)
            if rfo <> null
            {
                sg.start_line_field()
                this.process_flow_obj_content(sosofo)
                sg.end_line_field()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_SEQUENCE
        {
            this.push_fo_style(fo)
            sg.start_sequence()
            this.process_flow_obj_content(sosofo)
            sg.end_sequence()
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_SIMPLE_PAGE_SEQUENCE
        {
            ; SimplePageSequenceFlowObj::processInner + the SerialFOTBuilder
            ; decomposition, collapsed: the reference buffers each of the 24
            ; header/footer parts in a SaveFOTBuilder and replays them in
            ; k = pageType | (part << 2) order into the hf string buffer;
            ; processing directly under the output redirect partitions the
            ; stream identically, so each part is extracted right after it
            ; is processed.
            this.push_fo_style(fo)
            var rfo fo
            if fo.get_nic_code() <> null
                set rfo: this.resolve_nics(fo)
            if rfo <> null
            {
                sg.start_simple_page_sequence()
                var i 0
                while i < 4
                {
                    set this.have_page_type: true
                    set this.page_type: i
                    var j 0
                    while j < 6
                    {
                        let part rfo.get_hf(j)
                        if part <> null
                            this.process_sosofo(part)
                        sg.end_simple_page_sequence_header_footer(i | (j * 4))
                        set j: j + 1
                    }
                    set i: i + 1
                }
                sg.end_all_simple_page_sequence_header_footer()
                this.process_flow_obj_content(sosofo)
                sg.end_simple_page_sequence()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_TABLE
        {
            ; TableFlowObj::processInner: table state pushed, the four border
            ; flow objects (NIC style, else the table-border actual), content,
            ; the dangling row closed, spanned rows covered.
            this.push_fo_style(fo)
            var rfo fo
            if fo.get_nic_code() <> null
                set rfo: this.resolve_nics(fo)
            if rfo <> null
            {
                set this.table_stack: TableRec.make(this.interp.get_host(), this.table_stack)
                var rec rfo.get_tnic() as pointer[TableNICRec]
                if rec = null
                    set rec: TableNICRec.make(this.interp.get_host())
                let tdn rfo.get_dnic() as pointer[DisplayNIC]
                sg.start_table(rec, tdn)
                let fallback this.border_style_actual("table-border")
                this.emit_table_border(rec.before_row_border, fallback, 0)
                this.emit_table_border(rec.after_row_border, fallback, 1)
                this.emit_table_border(rec.before_column_border, fallback, 2)
                this.emit_table_border(rec.after_column_border, fallback, 3)
                this.process_flow_obj_content(sosofo)
                if this.in_table_row()
                    this.end_table_row()
                this.cover_spanned_rows()
                set this.table_stack: this.table_stack.prev
                sg.end_table()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_TABLE_PART
        {
            ; TablePartFlowObj::processInner + the SerialFOTBuilder header/
            ; footer decomposition: the header/footer ports (label:) capture
            ; into buffers replayed after the principal content.
            this.push_fo_style(fo)
            var rfo fo
            if fo.get_nic_code() <> null
                set rfo: this.resolve_nics(fo)
            if rfo <> null
            {
                let t this.table_stack
                if t <> null
                {
                    set t.current_column: 0
                    set t.row_style: null
                    let h t.host
                    set t.column_styles: Array[pointer[Array[pointer[ELObj]]]]^h()
                    set t.covered: Array[int]^h()
                    set t.n_columns: 0
                }
                sg.start_table_part_serial(rfo.get_dnic() as pointer[DisplayNIC])
                let phost this.interp.get_host()
                let hdr_buf Array[u32]^phost()
                let ftr_buf Array[u32]^phost()
                let hdr_sym this.interp.make_symbol(StringC("header"))
                let ftr_sym this.interp.make_symbol(StringC("footer"))
                let labels Array[pointer[ELObj]]^phost()
                labels.add(hdr_sym)
                labels.add(ftr_sym)
                let bufs Array[pointer[Array[u32]]]^phost()
                bufs.add(hdr_buf)
                bufs.add(ftr_buf)
                this.push_ports(labels, bufs, phost)
                this.process_flow_obj_content(sosofo)
                this.pop_ports()
                if this.in_table_row()
                    this.end_table_row()
                this.cover_spanned_rows()
                sg.start_table_part_header()
                sg.emit_captured(hdr_buf)
                sg.end_table_part_header()
                sg.start_table_part_footer()
                sg.emit_captured(ftr_buf)
                sg.end_table_part_footer()
                sg.end_table_part_serial()
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_TABLE_COLUMN
        {
            this.push_fo_style(fo)
            var rfo fo
            if fo.get_nic_code() <> null
                set rfo: this.resolve_nics(fo)
            if rfo <> null
            {
                var rec2 rfo.get_tnic() as pointer[TableColumnNICRec]
                if rec2 = null
                    set rec2: TableColumnNICRec.make(this.interp.get_host())
                let col_fo_style fo.get_style()
                if rec2.has_column_number
                {
                    sg.table_column(rec2)
                    this.add_table_column(rec2.column_index, rec2.n_columns_spanned, col_fo_style)
                }
                else
                {
                    let rec3 rec2.copy(this.interp.get_host())
                    set rec3.column_index: this.current_table_column()
                    sg.table_column(rec3)
                    this.add_table_column(rec3.column_index, rec2.n_columns_spanned, col_fo_style)
                }
            }
            this.pop_fo_style(fo)
            return
        }
        if foc = FOC_TABLE_ROW
        {
            ; TableRowFlowObj: pushStyle/popStyle are empty — the row style is
            ; stored and pushed per cell.
            if this.in_table() = false
            {
                this.interp.message0(InterpreterMessages.tableRowOutsideTable())
                this.process_flow_obj_content(sosofo)
                return
            }
            if this.in_table_row()
                this.end_table_row()
            let row_fo_style fo.get_style()
            this.start_table_row(row_fo_style)
            this.process_flow_obj_content(sosofo)
            if this.in_table_row()
                this.end_table_row()
            return
        }
        if foc = FOC_TABLE_CELL
        {
            var rec4 fo.get_tnic() as pointer[TableCellNICRec]
            if rec4 = null
                set rec4: TableCellNICRec.make(this.interp.get_host())
            let cell_fo_style fo.get_style()
            this.process_table_cell(rec4, cell_fo_style, sosofo, fo)
            return
        }
        ; TableBorderFlowObj::process is empty — a pure style carrier.
        if foc = FOC_TABLE_BORDER
            return
        if foc = FOC_FORMATTING_INSTRUCTION
            return
        ; FOC_UNKNOWN and anything unported: content only.
        this.process_flow_obj_content(sosofo)
    }

    ; the element GI: the explicit `gi:` characteristic, else the current node's
    ; generic identifier (ElementFlowObj's default-to-node behaviour).
    function element_gi(this: pointer[ProcessContext], fo: pointer[FlowObj]) returns StringC
    {
        let gi fo.get_gi()
        if gi.get_size() > (0 as size_t)
            return gi
        let node this.vm.get_current_node()
        if node <> null
            return node.get_gi()
        gi
    }
}
