    function end_all_emphasizing_mark_mark(this: ref[TeXFOTBuilder])
    {
    }

    ; --- the MATH family ---------------------------------------------------------
    ; The TeX backend overrides every math bracket EXCEPT `fraction-bar`, so an
    ; overridden method emits only its group scaffolding — the base
    ; start()/end() format bracket that SerialFOTBuilder would have run is gone
    ; with the override — `fraction-bar` included (it is an `\insertFractionBar`
    ; atomic, TeXFOTBuilder.cxx:2227).
    procedure start_math_sequence(mutable this: ref[TeXFOTBuilder])
    {
        set this.in_math: this.in_math + 1
        this.group_start("MathSeq")
    }

    procedure end_math_sequence(mutable this: ref[TeXFOTBuilder])
    {
        this.group_end("MathSeq")
        ; ★The reference INCREMENTS here too (`inMath_++` in endMathSequence,
        ; TeXFOTBuilder.cxx) — plainly a typo for `--`, but `inMath_` only
        ; gates the math-italic correction in characters(), so the effect is
        ; that math mode never switches off again once a math-sequence has been
        ; seen. Reproduced, not repaired.
        set this.in_math: this.in_math + 1
    }

    procedure start_fraction_serial(mutable this: ref[TeXFOTBuilder])
        this.group_start("FractionSerial")

    procedure end_fraction_serial(mutable this: ref[TeXFOTBuilder])
        this.group_end("FractionSerial")

