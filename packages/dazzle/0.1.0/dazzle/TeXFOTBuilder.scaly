    ; --- score ---------------------------------------------------------------------
    procedure start_score(mutable this: ref[TeXFOTBuilder], nic: ref[ScoreNIC])
    {
        this.fo_start()
        if nic.kind = 1
        {
            this.def_open("ScoreCharacter")
            let b this.sout
            TeXFOTBuilder.b_udec(b, nic.ch as int)
            this.def_close()
        }
        else if nic.kind = 2
            this.set_lenspec("ScoreLength", nic.length)
        else if nic.kind = 3
            this.set_sym("ScoreType", nic.sym.code)
        this.group_start("Score")
    }

    procedure end_score(mutable this: ref[TeXFOTBuilder])
    {
        this.group_end("Score")
        this.fo_end()
    }

    ; --- leader ---------------------------------------------------------------------
    procedure start_leader(mutable this: ref[TeXFOTBuilder], nic: ref[LeaderNIC])
    {
        this.fo_start()
        this.set_inline_nic(nic.break_before_priority, nic.break_after_priority)
        if nic.has_length
            this.set_lenspec("Length", nic.length)
        this.group_start("Leader")
    }

    procedure end_leader(mutable this: ref[TeXFOTBuilder])
    {
        this.group_end("Leader")
        this.fo_end()
    }

    ; --- box -------------------------------------------------------------------------
    procedure start_box(mutable this: ref[TeXFOTBuilder], nic: ref[BoxNIC], dnic: ref[DisplayNIC]?)
    {
        var is_display false
        set is_display: nic.is_display
        if is_display
        {
            let d this.dbl_len as size_t
            if d < this.dbl.get_length()
                this.dbl.put(d, this.fmt_depth)
            else
                this.dbl.add(this.fmt_depth)
            set this.dbl_len: this.dbl_len + 1
        }
        this.fo_start()
        this.set_display_nic(dnic as ref[DisplayNIC])
        this.set_inline_nic(nic.break_before_priority, nic.break_after_priority)
        if nic.is_display
            this.set_bool("IsDisplay", true)
        this.group_start("BOX")
    }

    procedure end_box(mutable this: ref[TeXFOTBuilder])
    {
        this.group_end("BOX")
        this.fo_end()
        if this.dbl_len > 0
        {
            let slotp this.dbl.get((this.dbl_len - 1) as size_t)
            if *slotp = this.fmt_depth
                set this.dbl_len: this.dbl_len - 1
        }
    }

    ; --- rule / external graphic / page numbers ------------------------------------
    procedure rule(mutable this: ref[TeXFOTBuilder], nic: ref[RuleNIC], dnic: ref[DisplayNIC]?)
    {
        this.set_display_nic(dnic as ref[DisplayNIC])
        this.set_inline_nic(nic.break_before_priority, nic.break_after_priority)
        this.set_sym("Orientation", nic.orientation.code)
        if nic.has_length
            this.set_lenspec("Length", nic.length)
        this.insert_atomic("Rule")
    }

    procedure external_graphic(mutable this: ref[TeXFOTBuilder], nic: ref[ExternalGraphicNIC], dnic: ref[DisplayNIC]?)
    {
        this.set_display_nic(dnic as ref[DisplayNIC])
        this.set_inline_nic(nic.break_before_priority, nic.break_after_priority)
        if nic.is_display
            this.set_bool("IsDisplay", true)
        ; symbolMaxUniform = 66 is the NIC default
        if nic.scale_type.code <> 66
            this.set_sym("ScaleType", nic.scale_type.code)
        if nic.scale_type.code = 0
        {
            this.set_double("ScaleX", nic.scale_x)
            this.set_double("ScaleY", nic.scale_y)
        }
        this.set_stringc("EntitySystemId", nic.entity_system_id)
        this.set_stringc("NotationSystemId", nic.notation_system_id)
        if nic.has_max_width
            this.set_lenspec("MaxWidth", nic.max_width)
        if nic.has_max_height
            this.set_lenspec("MaxHeight", nic.max_height)
        if nic.is_display = false
        {
            this.set_sym("EscapementDirection", nic.escapement_direction.code)
            this.set_lenspec("PositionPointX", nic.position_point_x)
            this.set_lenspec("PositionPointY", nic.position_point_y)
        }
        this.insert_atomic("ExternalGraphic")
    }

    procedure page_number(mutable this: ref[TeXFOTBuilder])
        this.insert_atomic("PageNumber")

    procedure current_node_page_number(mutable this: ref[TeXFOTBuilder], node: ref[GroveNode]?)
    {
        if node = null
        {
            this.msg_w("TeX backend does not currently support references to page numbers of nodes other than elements")
            return
        }
        let id node.get_id()
        if id.get_size() > 0
            this.set_stringc("Label", id)
        else
        {
            let ei node.element_index
            if ei >= 0
            {
                this.def_open("Element")
                let b this.sout
                TeXFOTBuilder.b_udec(b, ei)
                this.def_close()
            }
            else
            {
                this.msg_w("TeX backend does not currently support references to page numbers of nodes other than elements")
                return
            }
        }
        this.set_grove_index(node)
        this.insert_atomic("CurrentNodePageNumber")
    }

    ; --- page-float / page-footnote (extension flow objects) -----------------------
    procedure start_page_float(mutable this: ref[TeXFOTBuilder], nic: ref[PageFloatNIC])
    {
        this.set_stringc("placement", nic.placement)
        this.group_start("PageFloat")
    }

    procedure end_page_float(mutable this: ref[TeXFOTBuilder])
        this.group_end("PageFloat")

    procedure start_page_footnote(mutable this: ref[TeXFOTBuilder])
        this.brace_start("PageFootnote")

    procedure end_page_footnote(mutable this: ref[TeXFOTBuilder])
        this.brace_end()

    ; --- simple page sequence -------------------------------------------------------
    procedure start_simple_page_sequence(mutable this: ref[TeXFOTBuilder])
    {
        let ncols this.next_format.page_n_columns
        set this.next_format.cur_display_size: (this.next_format.page_width - this.next_format.left_margin - this.next_format.right_margin - (this.next_format.page_column_sep * (ncols - 1))) / ncols
        this.fo_start()
        this.group_start("SpS")
        ; capture the header/footer parts (they stream live from
        ; ProcessContext; the reference collects them in SaveFOTBuilders and
        ; replays at the same point in the byte stream)
        this.hf_capture.clear()
        this.os_push(this.hf_capture)
        set this.in_hf: true
    }

    procedure end_simple_page_sequence_header_footer(mutable this: ref[TeXFOTBuilder], flags: int)
    {
        this.os_pop()
        let b this.cur_os()
        TeXFOTBuilder.b_raw(b, "\n\\SpS")
        if (flags & 1) <> 0
            TeXFOTBuilder.b_raw(b, "First")
        else
            TeXFOTBuilder.b_raw(b, "Other")
        if (flags & 2) <> 0
            TeXFOTBuilder.b_raw(b, "Front")
        else
            TeXFOTBuilder.b_raw(b, "Back")
        let lcr flags & 24
        if lcr = 0
            TeXFOTBuilder.b_raw(b, "Left")
        else if lcr = 8
            TeXFOTBuilder.b_raw(b, "Center")
        else if lcr = 16
            TeXFOTBuilder.b_raw(b, "Right")
        if (flags & 4) <> 0
            TeXFOTBuilder.b_raw(b, "Header")
        else
            TeXFOTBuilder.b_raw(b, "Footer")
        TeXFOTBuilder.b_raw(b, "%\n{")
        TeXFOTBuilder.b_buf(b, this.hf_capture)
        b.put(0x7D)
        this.hf_capture.clear()
        this.os_push(this.hf_capture)
    }

    procedure end_all_simple_page_sequence_header_footer(mutable this: ref[TeXFOTBuilder])
    {
        this.os_pop()
        set this.in_hf: false
    }

    procedure end_simple_page_sequence(mutable this: ref[TeXFOTBuilder])
    {
        this.group_end("SpS")
        this.fo_end()
    }

    ; --- FotElement open/close (the os + state bracket) -------------------------
    procedure el_open(mutable this: ref[TeXFOTBuilder], mutable el: ref[TexFotEl])
    {
        ; Cell/Table push their own FotElementState first
        if el.tag = TEX_EL_CELL
            this.state_push()
        if el.tag = TEX_EL_TABLE
            this.state_push()
        ; FotElement::open
        let st this.cur_state()
        set st.is_open: true
        if el.parent <> null
            el.parent.child_just_opened(el)
        if st.ni_prolog.size() > 0
        {
            el.ni_prolog.clear()
            TeXFOTBuilder.b_buf(el.ni_prolog, st.ni_prolog)
            st.ni_prolog.clear()
        }
        ; CompoundFotElement::open — the content stream
        this.os_push(el.pre_content)
        if el.tag = TEX_EL_CELL
        {
            this.os_push(el.content)
            set st.enforcing: false
        }
        if el.tag = TEX_EL_TABLE
            set st.enforcing: true
    }

    procedure el_close(mutable this: ref[TeXFOTBuilder], mutable el: ref[TexFotEl])
    {
        if el.tag = TEX_EL_CELL
            this.os_pop()
        ; CompoundFotElement::close
        this.os_pop()
        if el.parent <> null
            el.parent.child_just_closed(el)
        else
        {
            let st this.cur_state()
            set st.is_open: false
        }
        if el.tag = TEX_EL_CELL
            this.state_pop()
        if el.tag = TEX_EL_TABLE
            this.state_pop()
    }

    ; --- Border ------------------------------------------------------------------
    procedure border_from_fot(this: ref[TeXFOTBuilder], mutable b: ref[TexFotEl])
    {
        let f this.cur_format()
        set b.b_priority: f.border_priority
        set b.b_present: f.border_present
        set b.b_thickness: f.line_thickness
        set b.b_repeat: f.line_repeat
        set b.b_sep: f.line_sep
    }

    ; Border::resolve(adjacent)
    procedure border_resolve(mutable b: ref[TexFotEl], mutable adj: ref[TexFotEl])
    {
        var take false
        if adj.b_priority > b.b_priority
            set take: true
        else if adj.b_priority = b.b_priority
        {
            if adj.is_cell_border() = false
            {
                if adj.b_present
                    set take: true
            }
        }
        if take = false
            return
        set b.b_thickness: adj.b_thickness
        set b.b_present: adj.b_present
        set b.b_repeat: adj.b_repeat
        set b.b_sep: adj.b_sep
        if adj.is_cell_border()
            set adj.b_present: false
    }

    ; --- the four single*BorderPresent predicates --------------------------------
    procedure cell_single_row_before(c: ref[TexFotEl]) returns bool
    {
        let oc c.overlapping
        if oc = null
            TeXFOTBuilder.trap("singleRowBeforeRowBorderPresent: no overlapping cell")
        if oc.tex_row_idx = c.tex_row_idx
            return oc.br_border.b_present
        false
    }

    procedure cell_single_row_after(c: ref[TexFotEl]) returns bool
    {
        let oc c.overlapping
        if oc = null
            TeXFOTBuilder.trap("singleRowAfterRowBorderPresent: no overlapping cell")
        if (oc.tex_row_idx + oc.n_rows_spanned) = (c.tex_row_idx + 1)
            return oc.ar_border.b_present
        false
    }

    procedure cell_single_col_before(c: ref[TexFotEl]) returns bool
    {
        let oc c.overlapping
        if oc = null
            TeXFOTBuilder.trap("singleColumnBeforeColumnBorderPresent: no overlapping cell")
        if oc.tex_col_idx = c.tex_col_idx
            return oc.bc_border.b_present
        false
    }

    procedure cell_single_col_after(c: ref[TexFotEl]) returns bool
    {
        let oc c.overlapping
        if oc = null
            TeXFOTBuilder.trap("singleColumnAfterColumnBorderPresent: no overlapping cell")
        if (oc.tex_col_idx + oc.n_cols_spanned) = (c.tex_col_idx + 1)
            return oc.ac_border.b_present
        false
    }

    ; --- row-vector helpers --------------------------------------------------------
    function rows_at(rows: ref[Array[ref[TexFotEl]?]], i: int) returns ref[TexFotEl]?
        rows[i]

    function cells_at(row: ref[TexFotEl], i: int) returns ref[TexFotEl]
        row.cells[i] as ref[TexFotEl]

    function cols_at(part: ref[TexFotEl], i: int) returns ref[TexColumn]
        part.columns[i] as ref[TexColumn]

    ; Vector<Cell>::resize — fresh default cells with their sibling index
    procedure cells_resize(mutable this: ref[TeXFOTBuilder], mutable row: ref[TexFotEl], n: int)
    {
        let host this.host
        var cur row.cells.get_length() as int
        while cur < n
        {
            let c TexFotEl.make_cell(host)
            set c.sibling_idx: cur
            row.cells.add(c)
            set cur: cur + 1
        }
    }

    procedure cols_resize(mutable this: ref[TeXFOTBuilder], mutable part: ref[TexFotEl], n: int)
    {
        let host this.host
        var cur part.columns.get_length() as int
        while cur < n
        {
            part.columns.add(TexColumn.make(host))
            set cur: cur + 1
        }
    }

    ; --- TablePart::processColumns -------------------------------------------------
    procedure part_process_columns(this: ref[TeXFOTBuilder], mutable part: ref[TexFotEl])
    {
        let table part.parent
        var total_nonprop 0
        var total_prop 0.0
        var n_nowidth 0
        let ncols part.columns.get_length() as int
        var i 0
        while i < ncols
        {
            let col TeXFOTBuilder.cols_at(part, i)
            if col.has_width
            {
                if col.width_tuf <> 0.0
                    set total_prop: total_prop + col.width_tuf
                else
                {
                    set col.computed_width: this.compute_length_spec(col.width)
                    set total_nonprop: total_nonprop + col.computed_width
                }
            }
            else
                set n_nowidth: n_nowidth + 1
            set i: i + 1
        }
        if total_prop > 0.0
            set total_prop: total_prop + (n_nowidth as double)
        var prop_unit 0.0
        if total_prop <> 0.0
            set prop_unit: ((table.table_width - total_nonprop) as double) / total_prop
        set i: 0
        while i < ncols
        {
            let col TeXFOTBuilder.cols_at(part, i)
            if col.has_width
            {
                if col.width_tuf <> 0.0
                    set col.computed_width: (prop_unit * col.width_tuf) as int
            }
            else if total_prop > 0.0
                set col.computed_width: prop_unit as int
            set i: i + 1
        }
        set i: 0
        while i < ncols
        {
            let col TeXFOTBuilder.cols_at(part, i)
            if col.computed_width > 0
            {
                set col.display_size: col.computed_width
                if col.default_before_margin <> TEX_LEN_UNSPEC
                    set col.display_size: col.display_size - col.default_before_margin
                if col.default_after_margin <> TEX_LEN_UNSPEC
                    set col.display_size: col.display_size - col.default_after_margin
            }
            set i: i + 1
        }
        set part.columns_processed: true
    }

    ; --- Cell computations ----------------------------------------------------------
    procedure cell_effective_margins(mutable c: ref[TexFotEl], part: ref[TexFotEl]?)
    {
        let col TeXFOTBuilder.cols_at(part as ref[TexFotEl], c.tex_col_idx)
        if c.before_col_margin <> TEX_LEN_UNSPEC
            set c.eff_before_col_margin: c.before_col_margin
        else
            set c.eff_before_col_margin: col.default_before_margin
        if c.eff_before_col_margin <> TEX_LEN_UNSPEC
        {
            if (col.default_before_margin <> c.eff_before_col_margin) or (c.n_cols_spanned > 1)
                set c.needs_override: true
        }
        if c.after_col_margin <> TEX_LEN_UNSPEC
            set c.eff_after_col_margin: c.after_col_margin
        else
            set c.eff_after_col_margin: col.default_after_margin
        if c.eff_after_col_margin <> TEX_LEN_UNSPEC
        {
            if (col.default_after_margin <> c.eff_after_col_margin) or (c.n_cols_spanned > 1)
                set c.needs_override: true
        }
    }

    procedure cell_effective_width(mutable c: ref[TexFotEl], part: ref[TexFotEl])
    {
        set c.display_size: 0
        let ncols part.columns.get_length() as int
        var i 0
        while i < c.n_cols_spanned
        {
            let idx c.tex_col_idx + i
            if idx < ncols
            {
                let col TeXFOTBuilder.cols_at(part, idx)
                set c.display_size: c.display_size + col.computed_width
            }
            set i: i + 1
        }
        if c.display_size <> 0
            set c.display_size: c.display_size - (c.eff_before_col_margin + c.eff_after_col_margin)
    }

    ; computeOverridingTeXColumnBorders — appends to the cell characteristics
    procedure cell_override_borders(mutable c: ref[TexFotEl], part: ref[TexFotEl])
    {
        let lcol TeXFOTBuilder.cols_at(part, c.tex_col_idx)
        let b c.characteristics
        var lb 0
        if c.bc_border.b_present
            set lb: 1
        if lcol.default_left_border <> lb
        {
            TeXFOTBuilder.b_raw(b, "\\def\\TeXTableCellBeforeColumnBorder{")
            TeXFOTBuilder.b_udec(b, lb)
            b.put(0x7D)
        }
        let ridx c.tex_col_idx + c.n_cols_spanned - 1
        let rcol TeXFOTBuilder.cols_at(part, ridx)
        var rb 0
        if c.ac_border.b_present
            set rb: 1
        if rcol.default_right_border <> rb
        {
            TeXFOTBuilder.b_raw(b, "\\def\\TeXTableCellAfterColumnBorder{")
            TeXFOTBuilder.b_udec(b, rb)
            b.put(0x7D)
        }
    }

    procedure cell_row_span_filler(mutable c: ref[TexFotEl])
    {
        if c.is_overlapped() = false
            return
        let oc c.overlapping
        if oc = null
            return
        if oc.n_rows_spanned <= 1
            return
        let b c.characteristics
        TeXFOTBuilder.b_raw(b, "\\def\\ColumnIndex{")
        TeXFOTBuilder.b_long(b, c.tex_col_idx)
        b.put(0x7D)
        TeXFOTBuilder.b_raw(b, "\\def\\TeXRowSpanFiller{1}")
    }

    ; --- Table::resolveBorders ------------------------------------------------------
    procedure table_resolve_borders(mutable t: ref[TexFotEl], mutable preceding: ref[Array[ref[TexFotEl]?]]?, mutable rows: ref[Array[ref[TexFotEl]?]], starting_row_idx: int, has_first_table_row: bool, has_last_table_row: bool)
    {
        let nrows rows.get_length() as int
        var r 0
        while r < nrows
        {
            let row TeXFOTBuilder.rows_at(rows, r)
            let ncells (row.cells.get_length() as int) - 1
            var c 0
            while c < ncells
            {
                let cell TeXFOTBuilder.cells_at(row as ref[TexFotEl], c)
                if cell.overlapping = null
                {
                    var rr r
                    while rr < (r + cell.n_rows_spanned)
                    {
                        if rr < nrows
                        {
                            let row2 TeXFOTBuilder.rows_at(rows, rr)
                            let n2 row2.cells.get_length() as int
                            var cc c
                            while cc < (c + cell.n_cols_spanned)
                            {
                                if cc < n2
                                {
                                    let cell2 TeXFOTBuilder.cells_at(row2 as ref[TexFotEl], cc)
                                    set cell2.overlapping: cell
                                    set cell2.tex_row_idx: rr + starting_row_idx
                                    set cell2.tex_col_idx: cc
                                }
                                set cc: cc + 1
                            }
                        }
                        set rr: rr + 1
                    }
                }
                set c: c + 1
            }
            set r: r + 1
        }
        set r: 0
        while r < nrows
        {
            let row TeXFOTBuilder.rows_at(rows, r)
            let ncells (row.cells.get_length() as int) - 1
            var c 0
            while c < ncells
            {
                let cell TeXFOTBuilder.cells_at(row as ref[TexFotEl], c)
                if cell.overlapping = cell
                {
                    var rr r
                    var top_edge true
                    while rr < (r + cell.n_rows_spanned)
                    {
                        var is_first_row false
                        if rr = 0
                            set is_first_row: true
                        var is_last_row false
                        if rr = (nrows - 1)
                            set is_last_row: true
                        var row2 row
                        if rr < nrows
                            set row2: TeXFOTBuilder.rows_at(rows, rr)
                        let n2 row2.cells.get_length() as int
                        var cc c
                        var left_edge true
                        while cc < (c + cell.n_cols_spanned)
                        {
                            var is_first_col false
                            if cc = 0
                                set is_first_col: true
                            var is_last_col false
                            if cc = (n2 - 2)
                                set is_last_col: true
                            if left_edge
                            {
                                if is_first_col
                                    TeXFOTBuilder.border_resolve(cell.bc_border as ref[TexFotEl], t.t_bc_border as ref[TexFotEl])
                                else
                                {
                                    if (cc - 1) < n2
                                    {
                                        let left TeXFOTBuilder.cells_at(row2 as ref[TexFotEl], cc - 1)
                                        if left.overlapping <> null
                                            TeXFOTBuilder.border_resolve(cell.bc_border as ref[TexFotEl], left.overlapping.ac_border as ref[TexFotEl])
                                    }
                                }
                            }
                            if top_edge
                            {
                                if is_first_row and has_first_table_row
                                    TeXFOTBuilder.border_resolve(cell.br_border as ref[TexFotEl], t.t_br_border as ref[TexFotEl])
                                else if is_first_row = false
                                {
                                    let up TeXFOTBuilder.rows_at(rows, rr - 1)
                                    if cc < (up.cells.get_length() as int)
                                    {
                                        let upc TeXFOTBuilder.cells_at(up as ref[TexFotEl], cc)
                                        if upc.overlapping <> null
                                            TeXFOTBuilder.border_resolve(cell.br_border as ref[TexFotEl], upc.overlapping.ar_border as ref[TexFotEl])
                                    }
                                }
                                else if preceding <> null
                                {
                                    let pn preceding.get_length() as int
                                    if pn <= 0
                                        TeXFOTBuilder.trap("resolveBorders: empty preceding rows")
                                    let last TeXFOTBuilder.rows_at(preceding, pn - 1)
                                    if cc < (last.cells.get_length() as int)
                                    {
                                        let lc TeXFOTBuilder.cells_at(last as ref[TexFotEl], cc)
                                        if lc.overlapping <> null
                                            TeXFOTBuilder.border_resolve(cell.br_border as ref[TexFotEl], lc.overlapping.ar_border as ref[TexFotEl])
                                    }
                                }
                            }
                            if is_last_col
                                TeXFOTBuilder.border_resolve(cell.ac_border as ref[TexFotEl], t.t_ac_border as ref[TexFotEl])
                            if is_last_row and has_last_table_row
                                TeXFOTBuilder.border_resolve(cell.ar_border as ref[TexFotEl], t.t_ar_border as ref[TexFotEl])
                            set left_edge: false
                            set cc: cc + 1
                        }
                        set top_edge: false
                        set rr: rr + 1
                    }
                }
                set c: c + 1
            }
            set r: r + 1
        }
    }

    ; --- TablePart::normalizeRows ----------------------------------------------------
    procedure part_normalize_rows(mutable this: ref[TeXFOTBuilder], mutable part: ref[TexFotEl])
    {
        var max_cells (part.columns.get_length() as int) + 1
        var step 0
        while step < 2
        {
            var rt 0
            while rt < 3
            {
                var rows part.body_rows
                if rt = 0
                    set rows: part.header_rows
                if rt = 2
                    set rows: part.footer_rows
                let nrows rows.get_length() as int
                var r 0
                while r < nrows
                {
                    let row TeXFOTBuilder.rows_at(rows as ref[Array[Option[ref[TexFotEl]]]], r)
                    if step = 0
                    {
                        if (row.cells.get_length() as int) > 1
                        {
                            let last_idx (row.cells.get_length() as int) - 2
                            let last TeXFOTBuilder.cells_at(row as ref[TexFotEl], last_idx)
                            if last.missing = false
                            {
                                if (last_idx + last.n_cols_spanned + 1) > max_cells
                                    set max_cells: last_idx + last.n_cols_spanned + 1
                            }
                        }
                    }
                    else if (row.cells.get_length() as int) < max_cells
                        this.cells_resize(row as ref[TexFotEl], max_cells)
                    set r: r + 1
                }
                set rt: rt + 1
            }
            set step: step + 1
        }
    }

    ; --- TablePart::computeOverridingTeXCharacteristics ------------------------------
    procedure part_compute_overriding(mutable this: ref[TeXFOTBuilder], mutable part: ref[TexFotEl])
    {
        var step 0
        while step < 3
        {
            var rows part.body_rows
            if step = 0
                set rows: part.header_rows
            if step = 2
                set rows: part.footer_rows
            let nrows rows.get_length() as int
            var r 0
            while r < nrows
            {
                let row TeXFOTBuilder.rows_at(rows as ref[Array[Option[ref[TexFotEl]]]], r)
                let ncells (row.cells.get_length() as int) - 1
                if ncells > (part.columns.get_length() as int)
                    this.cols_resize(part, ncells)
                var c 0
                while c < ncells
                {
                    let cell TeXFOTBuilder.cells_at(row as ref[TexFotEl], c)
                    let col TeXFOTBuilder.cols_at(part, c)
                    if TeXFOTBuilder.cell_single_col_before(cell)
                        set col.default_left_border: col.default_left_border + 1
                    if TeXFOTBuilder.cell_single_col_after(cell)
                        set col.default_right_border: col.default_right_border + 1
                    set c: c + 1
                }
                set r: r + 1
            }
            set step: step + 1
        }
        let n_tex_rows (part.header_rows.get_length() + part.body_rows.get_length() + part.footer_rows.get_length()) as int
        let ncols part.columns.get_length() as int
        var i 0
        while i < ncols
        {
            let col TeXFOTBuilder.cols_at(part, i)
            if (col.default_left_border * 2) >= n_tex_rows
                set col.default_left_border: 1
            else
                set col.default_left_border: 0
            if (col.default_right_border * 2) >= n_tex_rows
                set col.default_right_border: 1
            else
                set col.default_right_border: 0
            set i: i + 1
        }
        set step: 0
        while step < 3
        {
            var rows part.body_rows
            if step = 0
                set rows: part.header_rows
            if step = 2
                set rows: part.footer_rows
            let nrows rows.get_length() as int
            var r 0
            while r < nrows
            {
                let row TeXFOTBuilder.rows_at(rows as ref[Array[Option[ref[TexFotEl]]]], r)
                let ncells (row.cells.get_length() as int) - 1
                var c 0
                while c < ncells
                {
                    let cell TeXFOTBuilder.cells_at(row as ref[TexFotEl], c)
                    if cell.is_overlapped() = false
                        TeXFOTBuilder.cell_override_borders(cell, part)
                    else
                        TeXFOTBuilder.cell_row_span_filler(cell)
                    set c: c + 1
                }
                set r: r + 1
            }
            set step: step + 1
        }
    }

    ; --- Table::end -------------------------------------------------------------------
    procedure table_end_compute(mutable this: ref[TeXFOTBuilder], mutable t: ref[TexFotEl])
    {
        let nparts t.parts.get_length() as int
        var i 0
        while i < nparts
        {
            var first_part false
            if i = 0
                set first_part: true
            var last_part false
            if i = (nparts - 1)
                set last_part: true
            let part t.parts[i]
            this.part_normalize_rows(part as ref[TexFotEl])
            var has_header false
            if part.header_rows.get_length() > 0
                set has_header: true
            var has_body false
            if part.body_rows.get_length() > 0
                set has_body: true
            var has_footer false
            if part.footer_rows.get_length() > 0
                set has_footer: true
            if has_header
                TeXFOTBuilder.table_resolve_borders(t, null, part.header_rows as ref[Array[Option[ref[TexFotEl]]]], 0, first_part, false)
            var pre_body: ref[Array[ref[TexFotEl]?]]? null
            if has_header
                set pre_body: part.header_rows
            var body_first false
            if has_header = false
                set body_first: true
            var body_last false
            if has_footer = false
                set body_last: true
            TeXFOTBuilder.table_resolve_borders(t, pre_body, part.body_rows as ref[Array[Option[ref[TexFotEl]]]], part.header_rows.get_length() as int, body_first, body_last)
            if has_footer
            {
                var pre_footer: ref[Array[ref[TexFotEl]?]]? null
                if has_body
                    set pre_footer: part.body_rows
                let start (part.header_rows.get_length() + part.body_rows.get_length()) as int
                TeXFOTBuilder.table_resolve_borders(t, pre_footer, part.footer_rows as ref[Array[Option[ref[TexFotEl]]]], start, false, last_part)
            }
            if part.needs_col_reproc
                this.part_process_columns(part as ref[TexFotEl])
            this.part_compute_overriding(part as ref[TexFotEl])
            set i: i + 1
        }
    }

    ; --- emission ---------------------------------------------------------------------
    ; "%.2f" of a 0..1 colour component
    procedure b_f2(mutable b: ref[TexBuf], x: double)
    {
        var v ((x * 100.0) + 0.5) as int
        if v < 0
            set v: 0
        TeXFOTBuilder.b_udec(b, v / 100)
        b.put(0x2E)
        TeXFOTBuilder.b_udec(b, (v / 10) % 10)
        TeXFOTBuilder.b_udec(b, v % 10)
    }

    ; CompoundFotElement::outProlog / outEpilog
    procedure el_out_prolog(el: ref[TexFotEl], mutable s: ref[TexBuf])
    {
        TeXFOTBuilder.b_buf(s, el.ni_prolog)
        s.put(0x5C)
        TeXFOTBuilder.b_raw(s, el.el_name())
        TeXFOTBuilder.b_raw(s, "%\n{")
        TeXFOTBuilder.b_buf(s, el.characteristics)
        s.put(0x7D)
        TeXFOTBuilder.b_buf(s, el.pre_content as ref[TexBuf])
    }

    procedure el_out_epilog(el: ref[TexFotEl], mutable s: ref[TexBuf])
    {
        TeXFOTBuilder.b_raw(s, "\\end")
        TeXFOTBuilder.b_raw(s, el.el_name())
        TeXFOTBuilder.b_raw(s, "{}")
        TeXFOTBuilder.b_buf(s, el.ni_epilog)
        TeXFOTBuilder.b_raw(s, "%\n")
    }

    ; Cell::outProlog — the \TeXTableCell column override, then the compound
    ; prolog
    procedure cell_out(c: ref[TexFotEl], mutable s: ref[TexBuf])
    {
        var wrap false
        if c.n_cols_spanned > 1
            set wrap: true
        if c.needs_override
            set wrap: true
        if c.row_alignment <> 2
        {
            if c.row_alignment <> 25
                set wrap: true
        }
        if c.cell_background
            set wrap: true
        if wrap
        {
            TeXFOTBuilder.b_raw(s, "\\TeXTableCell{")
            TeXFOTBuilder.b_udec(s, c.n_cols_spanned)
            TeXFOTBuilder.b_raw(s, "}{")
            if c.bc_border.b_present
                s.put(0x7C)
            if c.display_size <> 0
            {
                let al TeXFOTBuilder.cell_alignment_char(c)
                s.put(al)
                s.put(0x7B)
                TeXFOTBuilder.b_pts(s, c.eff_before_col_margin)
                TeXFOTBuilder.b_raw(s, "}{")
                TeXFOTBuilder.b_pts(s, c.display_size)
                TeXFOTBuilder.b_raw(s, "}{")
                TeXFOTBuilder.b_pts(s, c.eff_after_col_margin)
                s.put(0x7D)
                if c.cell_background
                    TeXFOTBuilder.cell_color_buf(c, s)
            }
            else
            {
                TeXFOTBuilder.b_raw(s, "@{\\hspace{")
                TeXFOTBuilder.b_pts(s, c.eff_before_col_margin)
                TeXFOTBuilder.b_raw(s, "}}")
                if c.cell_background
                {
                    TeXFOTBuilder.b_raw(s, ">{\\columncolor[rgb]")
                    TeXFOTBuilder.cell_color_buf(c, s)
                    s.put(0x7D)
                }
                if (c.row_alignment = 46) or (c.row_alignment = 26)
                    s.put(0x72)
                else if c.row_alignment = 27
                    s.put(0x63)
                else
                    s.put(0x6C)
                TeXFOTBuilder.b_raw(s, "@{\\hspace{")
                TeXFOTBuilder.b_pts(s, c.eff_after_col_margin)
                TeXFOTBuilder.b_raw(s, "}}")
            }
            if c.ac_border.b_present
                s.put(0x7C)
            TeXFOTBuilder.b_raw(s, "}%\n{%\n")
        }
        TeXFOTBuilder.el_out_prolog(c, s)
        ; Cell::outContent — the buffered content, unless overlapped
        if c.is_overlapped() = false
            TeXFOTBuilder.b_buf(s, c.content as ref[TexBuf])
        TeXFOTBuilder.el_out_epilog(c, s)
        if wrap
            TeXFOTBuilder.b_raw(s, "}%\n")
    }

    ; "{%.2f, %.2f, %.2f}" of the cell background colour
    procedure cell_color_buf(c: ref[TexFotEl], mutable s: ref[TexBuf])
    {
        s.put(0x7B)
        TeXFOTBuilder.b_f2(s, (c.bg_r as double) / 255.0)
        TeXFOTBuilder.b_raw(s, ", ")
        TeXFOTBuilder.b_f2(s, (c.bg_g as double) / 255.0)
        TeXFOTBuilder.b_raw(s, ", ")
        TeXFOTBuilder.b_f2(s, (c.bg_b as double) / 255.0)
        s.put(0x7D)
    }

    ; the effective/row alignment matrix (background variants are digits)
    function cell_alignment_char(c: ref[TexFotEl]) returns u8
    {
        let ea c.eff_alignment
        let ra c.row_alignment
        var ra_class 2
        if (ra = 46) or (ra = 26)
            set ra_class: 0
        else if ra = 27
            set ra_class: 1
        if (ea = 46) or (ea = 26)
        {
            if ra_class = 0
            {
                if c.cell_background
                    return 0x33 as u8
                return 0x4D as u8
            }
            if ra_class = 1
            {
                if c.cell_background
                    return 0x36 as u8
                return 0x4A as u8
            }
            if c.cell_background
                return 0x39 as u8
            return 0x55 as u8
        }
        if ea = 27
        {
            if ra_class = 0
            {
                if c.cell_background
                    return 0x32 as u8
                return 0x4E as u8
            }
            if ra_class = 1
            {
                if c.cell_background
                    return 0x35 as u8
                return 0x48 as u8
            }
            if c.cell_background
                return 0x38 as u8
            return 0x59 as u8
        }
        if ra_class = 0
        {
            if c.cell_background
                return 0x31 as u8
            return 0x42 as u8
        }
        if ra_class = 1
        {
            if c.cell_background
                return 0x34 as u8
            return 0x47 as u8
        }
        if c.cell_background
            return 0x37 as u8
        0x54 as u8
    }

    ; Row::outContent + the compound bracket
    procedure row_out(row: ref[TexFotEl], mutable s: ref[TexBuf])
    {
        TeXFOTBuilder.el_out_prolog(row, s)
        var first true
        let n row.cells.get_length() as int
        var i 0
        while (i + 1) < n
        {
            let cell TeXFOTBuilder.cells_at(row, i)
            var output_cell false
            if cell.is_overlapped() = false
                set output_cell: true
            else
            {
                let oc cell.overlapping
                if oc <> null
                {
                    if oc.n_rows_spanned > 1
                    {
                        if oc.tex_col_idx = i
                            set output_cell: true
                    }
                }
            }
            if first = false
            {
                if output_cell
                    s.put(0x26)
            }
            else
                set first: false
            if output_cell
                TeXFOTBuilder.cell_out(cell, s)
            set i: i + 1
        }
        TeXFOTBuilder.el_out_epilog(row, s)
    }

    ; Row::outVerticalBorders — \Hline / \Cline runs between two rows
    procedure row_vertical_borders(upper: ref[TexFotEl]?, lower: ref[TexFotEl]?, mutable s: ref[TexBuf])
    {
        if (upper = null) and (lower = null)
            TeXFOTBuilder.trap("outVerticalBorders with no rows")
        var col_num 0
        if upper <> null
            set col_num: (upper.cells.get_length() as int) - 1
        else
            set col_num: (lower.cells.get_length() as int) - 1
        var border_start 0 - 1
        var border_end 0
        var i 0
        while i < col_num
        {
            var present false
            if upper <> null
            {
                if i < ((upper.cells.get_length() as int) - 1)
                {
                    if TeXFOTBuilder.cell_single_row_after(TeXFOTBuilder.cells_at(upper, i))
                        set present: true
                }
            }
            if lower <> null
            {
                if i < ((lower.cells.get_length() as int) - 1)
                {
                    if TeXFOTBuilder.cell_single_row_before(TeXFOTBuilder.cells_at(lower, i))
                        set present: true
                }
            }
            var emit false
            if present
            {
                if border_start < 0
                    set border_start: i
                if i = (col_num - 1)
                {
                    set border_end: i
                    set emit: true
                }
            }
            else if border_start > (0 - 1)
            {
                set border_end: i - 1
                set emit: true
            }
            if emit
            {
                if (border_start = 0) and (i = (col_num - 1))
                    TeXFOTBuilder.b_raw(s, "\\Hline%\n")
                else
                {
                    TeXFOTBuilder.b_raw(s, "\\Cline{")
                    TeXFOTBuilder.b_long(s, border_start + 1)
                    s.put(0x2D)
                    TeXFOTBuilder.b_long(s, border_end + 1)
                    TeXFOTBuilder.b_raw(s, "}%\n")
                }
                set border_start: 0 - 1
            }
            set i: i + 1
        }
    }

    ; TablePart::outContent — the \TeXTable preamble, then header/body/footer
    procedure part_out(part: ref[TexFotEl], mutable s: ref[TexBuf])
    {
        if part.is_explicit
            TeXFOTBuilder.el_out_prolog(part, s)
        let t part.parent
        TeXFOTBuilder.b_raw(s, "\\TeXTable%\n{")
        TeXFOTBuilder.b_pts(s, t.table_width)
        TeXFOTBuilder.b_raw(s, "}{")
        TeXFOTBuilder.b_udec(s, part.columns.get_length() as int)
        TeXFOTBuilder.b_raw(s, "}{")
        let ncols part.columns.get_length() as int
        var i 0
        while i < ncols
        {
            let col TeXFOTBuilder.cols_at(part, i)
            if i = 0
            {
                if col.default_left_border <> 0
                    s.put(0x7C)
            }
            if col.computed_width > 0
            {
                var al: u8 0x54
                if (col.display_alignment = 46) or (col.display_alignment = 26)
                    set al: 0x55
                else if col.display_alignment = 27
                    set al: 0x59
                s.put(al)
                s.put(0x7B)
                TeXFOTBuilder.b_pts(s, col.default_before_margin)
                TeXFOTBuilder.b_raw(s, "}{")
                TeXFOTBuilder.b_pts(s, col.display_size)
                TeXFOTBuilder.b_raw(s, "}{")
                TeXFOTBuilder.b_pts(s, col.default_after_margin)
                s.put(0x7D)
            }
            else
            {
                TeXFOTBuilder.b_raw(s, "@{\\hspace{")
                TeXFOTBuilder.b_pts(s, col.default_before_margin)
                TeXFOTBuilder.b_raw(s, "}}")
                if (col.display_alignment = 46) or (col.display_alignment = 26)
                    s.put(0x72)
                else if col.display_alignment = 27
                    s.put(0x63)
                else
                    s.put(0x6C)
                TeXFOTBuilder.b_raw(s, "@{\\hspace{")
                TeXFOTBuilder.b_pts(s, col.default_after_margin)
                TeXFOTBuilder.b_raw(s, "}}")
            }
            if col.default_right_border <> 0
                s.put(0x7C)
            set i: i + 1
        }
        TeXFOTBuilder.b_raw(s, "}%\n")
        TeXFOTBuilder.b_buf(s, part.header_prolog as ref[TexBuf])
        var recent: ref[TexFotEl]? null
        let nh part.header_rows.get_length() as int
        var r 0
        while r < nh
        {
            let row TeXFOTBuilder.rows_at(part.header_rows as ref[Array[Option[ref[TexFotEl]]]], r)
            TeXFOTBuilder.row_vertical_borders(recent, row, s)
            TeXFOTBuilder.row_out(row as ref[TexFotEl], s)
            set recent: row
            set r: r + 1
        }
        TeXFOTBuilder.b_buf(s, part.header_epilog as ref[TexBuf])
        let nb part.body_rows.get_length() as int
        set r: 0
        while r < nb
        {
            let row TeXFOTBuilder.rows_at(part.body_rows as ref[Array[Option[ref[TexFotEl]]]], r)
            TeXFOTBuilder.row_vertical_borders(recent, row, s)
            TeXFOTBuilder.row_out(row as ref[TexFotEl], s)
            set recent: row
            set r: r + 1
        }
        TeXFOTBuilder.b_buf(s, part.footer_prolog as ref[TexBuf])
        let nf part.footer_rows.get_length() as int
        set r: 0
        while r < nf
        {
            let row TeXFOTBuilder.rows_at(part.footer_rows as ref[Array[Option[ref[TexFotEl]]]], r)
            TeXFOTBuilder.row_vertical_borders(recent, row, s)
            TeXFOTBuilder.row_out(row as ref[TexFotEl], s)
            set recent: row
            set r: r + 1
        }
        TeXFOTBuilder.b_buf(s, part.footer_epilog as ref[TexBuf])
        if recent <> null
            TeXFOTBuilder.row_vertical_borders(recent, null, s)
        TeXFOTBuilder.b_raw(s, "\\endTeXTable{}%\n")
        if part.is_explicit
            TeXFOTBuilder.el_out_epilog(part, s)
    }

    procedure table_out(t: ref[TexFotEl], mutable s: ref[TexBuf])
    {
        TeXFOTBuilder.el_out_prolog(t, s)
        let n t.parts.get_length() as int
        var i 0
        while i < n
        {
            TeXFOTBuilder.part_out((t.parts[i]) as ref[TexFotEl], s)
            set i: i + 1
        }
        TeXFOTBuilder.el_out_epilog(t, s)
    }

    ; --- table flow objects -------------------------------------------------------------
    procedure part_begin(mutable part: ref[TexFotEl], mutable t: ref[TexFotEl])
    {
        set part.columns_processed: false
        set part.needs_col_reproc: false
        set t.cur_rows_sel: 1
        set t.cur_part: part
    }

    procedure start_table(mutable this: ref[TeXFOTBuilder], tnic: ref[TableNIC], dnic: ref[DisplayNIC]?)
    {
        let t this.table_push()
        this.fo_start()
        ; setTableNIC
        this.set_display_nic(dnic as ref[DisplayNIC])
        if tnic.width_type = 0
            this.set_stringc("TableWidth", StringC("full"))
        else if tnic.width_type = 1
            this.set_stringc("TableWidth", StringC("minimum"))
        else
            this.set_lenspec("TableWidth", tnic.width)
        let f this.cur_format()
        let cur_start_indent this.compute_length_spec(f.start_indent_spec)
        set t.start_indent: cur_start_indent
        this.capture_into(t)
        this.el_open(t)
        ; Table::begin
        let host this.host
        let part TexFotEl.make_part(host)
        set part.sibling_idx: 0
        set part.parent: t
        set t.cur_cell: null
        set t.no_parts_seen: true
        t.parts.add(part)
        TeXFOTBuilder.part_begin(part, t)
        let f2 this.cur_format()
        if f2.display_alignment <> 2
            set t.t_display_alignment: f2.display_alignment
        if tnic.width_type = 2
            set t.table_width: this.compute_length_spec(tnic.width)
        else
            set t.table_width: f2.cur_display_size - cur_start_indent - this.compute_length_spec(f2.end_indent_spec)
        this.el_open(t.cur_part as ref[TexFotEl])
    }

    procedure end_table(mutable this: ref[TeXFOTBuilder])
    {
        let t this.cur_table()
        if t.no_parts_seen
        {
            this.el_close(t.cur_part as ref[TexFotEl])
            set t.cur_part.is_explicit: false
        }
        this.table_end_compute(t)
        this.el_close(t)
        let s this.cur_os()
        TeXFOTBuilder.table_out(t, s)
        this.fo_end()
        set this.table_depth: this.table_depth - 1
    }

    procedure table_before_row_border(mutable this: ref[TeXFOTBuilder])
    {
        let t this.cur_table()
        this.fo_start()
        this.border_from_fot(t.t_br_border as ref[TexFotEl])
        this.capture_into(t.t_br_border as ref[TexFotEl])
        this.fo_end()
    }

    procedure table_after_row_border(mutable this: ref[TeXFOTBuilder])
    {
        let t this.cur_table()
        this.fo_start()
        this.border_from_fot(t.t_ar_border as ref[TexFotEl])
        this.capture_into(t.t_ar_border as ref[TexFotEl])
        this.fo_end()
    }

    procedure table_before_column_border(mutable this: ref[TeXFOTBuilder])
    {
        let t this.cur_table()
        this.fo_start()
        this.border_from_fot(t.t_bc_border as ref[TexFotEl])
        this.capture_into(t.t_bc_border as ref[TexFotEl])
        this.fo_end()
    }

    procedure table_after_column_border(mutable this: ref[TeXFOTBuilder])
    {
        let t this.cur_table()
        this.fo_start()
        this.border_from_fot(t.t_ac_border as ref[TexFotEl])
        this.capture_into(t.t_ac_border as ref[TexFotEl])
        this.fo_end()
    }

    procedure table_cell_before_row_border(mutable this: ref[TeXFOTBuilder])
    {
        let t this.cur_table()
        let c t.cur_cell
        if c = null
            TeXFOTBuilder.trap("tableCellBeforeRowBorder without a current cell")
        this.fo_start()
        this.border_from_fot(c.br_border as ref[TexFotEl])
        this.capture_into(c.br_border as ref[TexFotEl])
        this.fo_end()
    }

    procedure table_cell_after_row_border(mutable this: ref[TeXFOTBuilder])
    {
        let t this.cur_table()
        let c t.cur_cell
        if c = null
            TeXFOTBuilder.trap("tableCellAfterRowBorder without a current cell")
        this.fo_start()
        this.border_from_fot(c.ar_border as ref[TexFotEl])
        this.capture_into(c.ar_border as ref[TexFotEl])
        this.fo_end()
    }

    procedure table_cell_before_column_border(mutable this: ref[TeXFOTBuilder])
    {
        let t this.cur_table()
        let c t.cur_cell
        if c = null
            TeXFOTBuilder.trap("tableCellBeforeColumnBorder without a current cell")
        this.fo_start()
        this.border_from_fot(c.bc_border as ref[TexFotEl])
        this.capture_into(c.bc_border as ref[TexFotEl])
        this.fo_end()
    }

    procedure table_cell_after_column_border(mutable this: ref[TeXFOTBuilder])
    {
        let t this.cur_table()
        let c t.cur_cell
        if c = null
            TeXFOTBuilder.trap("tableCellAfterColumnBorder without a current cell")
        this.fo_start()
        this.border_from_fot(c.ac_border as ref[TexFotEl])
        this.capture_into(c.ac_border as ref[TexFotEl])
        this.fo_end()
    }

    procedure start_table_part_serial(mutable this: ref[TeXFOTBuilder], dnic: ref[DisplayNIC]?)
    {
        let t this.cur_table()
        this.fo_start()
        this.set_display_nic(dnic as ref[DisplayNIC])
        if t.no_parts_seen
            set t.no_parts_seen: false
        else
        {
            let host this.host
            let part TexFotEl.make_part(host)
            set part.sibling_idx: t.parts.get_length() as int
            set part.parent: t
            t.parts.add(part)
            TeXFOTBuilder.part_begin(part, t)
            this.el_open(part)
        }
        this.capture_into(t.cur_part as ref[TexFotEl])
    }

    procedure end_table_part_serial(mutable this: ref[TeXFOTBuilder])
    {
        let t this.cur_table()
        this.el_close(t.cur_part as ref[TexFotEl])
        set t.cur_part: null
        this.fo_end()
    }

    procedure start_table_part_header(mutable this: ref[TeXFOTBuilder])
    {
        let t this.cur_table()
        set t.cur_rows_sel: 0
        this.group_start_out("TablePartHeader", t.cur_part.header_prolog as ref[TexBuf])
    }

    procedure end_table_part_header(mutable this: ref[TeXFOTBuilder])
    {
        let t this.cur_table()
        set t.cur_rows_sel: 1
        this.group_end_out("TablePartHeader", t.cur_part.header_epilog)
    }

    procedure start_table_part_footer(mutable this: ref[TeXFOTBuilder])
    {
        let t this.cur_table()
        set t.cur_rows_sel: 2
        this.group_start_out("TablePartFooter", t.cur_part.footer_prolog as ref[TexBuf])
    }

    procedure end_table_part_footer(mutable this: ref[TeXFOTBuilder])
    {
        let t this.cur_table()
        set t.cur_rows_sel: 1
        this.group_end_out("TablePartFooter", t.cur_part.footer_epilog)
    }

    procedure start_table_row(mutable this: ref[TeXFOTBuilder])
    {
        let t this.cur_table()
        let host this.host
        let rows t.cur_rows()
        let row TexFotEl.make_row(host)
        set row.sibling_idx: rows.get_length() as int
        set row.parent: t.cur_part
        rows.add(row)
        this.capture_into(row)
        this.el_open(row)
    }

    procedure end_table_row(mutable this: ref[TeXFOTBuilder])
    {
        let t this.cur_table()
        let rows t.cur_rows()
        let n rows.get_length() as int
        let row TeXFOTBuilder.rows_at(rows, n - 1)
        this.el_close(row as ref[TexFotEl])
    }

    procedure table_column(mutable this: ref[TeXFOTBuilder], nic: ref[TableColumnNIC])
    {
        ; setTableColumnNIC
        if nic.column_index <> 0
            this.set_long("ColumnIndex", nic.column_index)
        if nic.n_columns_spanned <> 1
            this.set_long("NColumnsSpanned", nic.n_columns_spanned)
        if nic.has_width
            this.set_lenspec("Width", nic.width)
        let t this.cur_table()
        let part t.cur_part
        if part = null
            TeXFOTBuilder.trap("tableColumn outside a table part")
        if nic.column_index >= (part.columns.get_length() as int)
            this.cols_resize(part as ref[TexFotEl], nic.column_index + 1)
        let col TeXFOTBuilder.cols_at(part as ref[TexFotEl], nic.column_index)
        set col.is_explicit: true
        set col.has_width: nic.has_width
        if nic.has_width
        {
            set col.width: nic.width
            set col.width_tuf: nic.width_tfactor
        }
        let f this.cur_format()
        if f.display_alignment <> 2
            set col.display_alignment: f.display_alignment
        if f.cell_before_col_margin <> TEX_LEN_UNSPEC
            set col.default_before_margin: f.cell_before_col_margin
        if f.cell_after_col_margin <> TEX_LEN_UNSPEC
            set col.default_after_margin: f.cell_after_col_margin
        this.insert_atomic("TableColumn")
    }

    procedure start_table_cell(mutable this: ref[TeXFOTBuilder], nic: ref[TableCellNIC])
    {
        let t this.cur_table()
        var col_index 0
        var n_cols 1
        var n_rows 1
        var missing false
        set col_index: nic.column_index
        set n_cols: nic.n_columns_spanned
        set n_rows: nic.n_rows_spanned
        set missing: nic.missing
        ; setTableCellNIC
        if nic.column_index <> 0
            this.set_long("ColumnIndex", nic.column_index)
        if nic.n_columns_spanned <> 1
            this.set_long("NColumnsSpanned", nic.n_columns_spanned)
        if nic.n_rows_spanned <> 1
            this.set_long("NRowsSpanned", nic.n_rows_spanned)
        let part t.cur_part
        if part = null
            TeXFOTBuilder.trap("tableCell outside a table part")
        if part.columns_processed = false
            this.part_process_columns(part as ref[TexFotEl])
        let rows t.cur_rows()
        let nr rows.get_length() as int
        if nr <= 0
            TeXFOTBuilder.trap("tableCell outside a table row")
        let row TeXFOTBuilder.rows_at(rows, nr - 1)
        if col_index >= (row.cells.get_length() as int)
            this.cells_resize(row as ref[TexFotEl], col_index + 1)
        let cell TeXFOTBuilder.cells_at(row as ref[TexFotEl], col_index)
        set t.cur_cell: cell
        set cell.missing: missing
        set cell.parent: row
        if n_cols <> 1
            set cell.n_cols_spanned: n_cols
        if n_rows <> 1
            set cell.n_rows_spanned: n_rows
        var i col_index
        while i < (col_index + n_cols)
        {
            if i >= (part.columns.get_length() as int)
            {
                if missing = false
                {
                    this.cols_resize(part as ref[TexFotEl], (part.columns.get_length() as int) + 1)
                    set part.columns_processed: false
                }
            }
            set i: i + 1
        }
        if part.columns_processed = false
            this.part_process_columns(part as ref[TexFotEl])
        if missing = false
        {
            if this.next_format.cell_row_alignment <> 2
                set cell.row_alignment: this.next_format.cell_row_alignment
            if this.next_format.cell_before_col_margin <> TEX_LEN_UNSPEC
                set cell.before_col_margin: this.next_format.cell_before_col_margin
            if this.next_format.cell_after_col_margin <> TEX_LEN_UNSPEC
                set cell.after_col_margin: this.next_format.cell_after_col_margin
            if this.next_format.cell_background
            {
                set cell.cell_background: true
                set cell.bg_r: this.next_format.bg_r
                set cell.bg_g: this.next_format.bg_g
                set cell.bg_b: this.next_format.bg_b
            }
            set cell.tex_col_idx: col_index
            let col TeXFOTBuilder.cols_at(part as ref[TexFotEl], col_index)
            set cell.eff_alignment: col.display_alignment
            TeXFOTBuilder.cell_effective_margins(cell, part)
            TeXFOTBuilder.cell_effective_width(cell, part as ref[TexFotEl])
            set this.next_format.cur_display_size: cell.display_size
        }
        this.element_start(TEX_OC_CELL)
        this.capture_into(cell)
        this.el_open(cell)
    }

    procedure end_table_cell(mutable this: ref[TeXFOTBuilder])
    {
        let t this.cur_table()
        let c t.cur_cell
        if c = null
            TeXFOTBuilder.trap("endTableCell without a current cell")
        this.el_close(c as ref[TexFotEl])
        set t.cur_cell: null
        this.fo_end()
    }
}
