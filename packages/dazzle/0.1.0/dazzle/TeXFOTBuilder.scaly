; TeXFOTBuilder — the `-t tex` backend: David Megginson's generic TeX macro
; stream (jadetex input). Ported from ~/repos/dazzle/jade/TeXFOTBuilder.cxx
; (C++ oracle, openjade 1.3.3-pre1; the build defines OUTLINES and leaves
; TEXDEBUG/NDEBUG undefined — reference asserts are live and port as loud
; exit-17 traps). The C# mirror has no TeX backend; the C++ is the only
; source.
;
; Output model: byte streams. Every characteristic setter renders
; "\def\Name%\n{value}" into the pending string stream (stringout_); the
; next flow-object group start dumps it inside its brace group. Groups are
; "\Name%\n{...}" ... "\endName{}"; atomic flow objects are
; "\insertName%\n{...}". Numbers print in printf %g form; setlength values
; pass through FLOAT precision (the reference casts to float before
; streaming — port via the f32 round-trip). Chars stream as single bytes
; (C++ char truncation); chars > 255 become \Character{N}.
;
; Tables buffer into a FotElement tree (Table/TablePart/Row/Cell/Border
; records with prolog/characteristics/content byte buffers) and emit at
; endTable after border resolution and column processing — a faithful port
; of the Marszalek table machinery including its quirks (the row-separator
; "&" emission clears `first` even for suppressed cells; the trailing dummy
; cell; LengthInPoints losing the sign of -0.x values).
;
; The simple-page-sequence header/footer parts arrive live from
; ProcessContext (part content, then end_simple_page_sequence_header_footer
; with the reference's k = pageType | (part << 2) flags); the sink captures
; each part in a reused buffer and wraps it retroactively in the
; "\n\SpS<First|Other><Front|Back><Left|Center|Right><Header|Footer>%\n{...}"
; bracket — byte-equivalent to the reference SerialFOTBuilder replay.
;
; RBMM: everything lives on the builder's page (the run arena); the pending
; stream, HF capture and heading-text buffers are cursor-reused (TexBuf),
; stacks are slot-reused pointer arrays with depth cursors. Table trees
; allocate fresh per table (few, bounded by the document).

use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use dazzle.Grove.GroveNode
use dazzle.Grove.GroveInfo
use dazzle.ELObj.ELObj
use dazzle.Style.InheritedC
use dazzle.Style.LengthSpec
use dazzle.Style.DisplaySpace
use dazzle.Style.InlineSpace
use dazzle.Style.FotSym
use dazzle.Style.DisplayNIC
use dazzle.Style.RuleNIC
use dazzle.Style.LinkNIC
use dazzle.Style.ExternalGraphicNIC
use dazzle.Style.LeaderNIC
use dazzle.Style.BoxNIC
use dazzle.Style.ScoreNIC
use dazzle.Style.TableNIC
use dazzle.Style.TableColumnNIC
use dazzle.Style.TableCellNIC
use dazzle.Style.PageFloatNIC
use dazzle.Style.LineFieldNIC
use dazzle.Style.CharacterNIC
use dazzle.Style.AnchorNIC
use dazzle.Style.GlyphAnnotationNIC
use dazzle.Style.EmphasizingMarkNIC
use dazzle.Style.GridNIC
use dazzle.Style.GridCellNIC
use dazzle.Style.EmbeddedTextNIC
use dazzle.Style.IncludedContainerAreaNIC
use dazzle.Style.MultiModeRec
use dazzle.Style.MultiModeNIC

; --- constants ---------------------------------------------------------------
; FotObjectClassType
define TEX_OC_UNKNOWN: int 0
define TEX_OC_CELL: int 1

; lengthUnspecified = LONG_MAX (LP64)
define TEX_LEN_UNSPEC: int 0x7FFFFFFFFFFFFFFF

; FotElement tags
define TEX_EL_BORDER: int 0
define TEX_EL_CELL: int 1
define TEX_EL_ROW: int 2
define TEX_EL_PART: int 3
define TEX_EL_TABLE: int 4

; border kinds (0-3 cell borders, 4-7 table borders)
define TEX_B_CELL_BEFORE_ROW: int 0
define TEX_B_CELL_AFTER_ROW: int 1
define TEX_B_CELL_BEFORE_COL: int 2
define TEX_B_CELL_AFTER_COL: int 3
define TEX_B_TABLE_BEFORE_ROW: int 4
define TEX_B_TABLE_AFTER_ROW: int 5
define TEX_B_TABLE_BEFORE_COL: int 6
define TEX_B_TABLE_AFTER_COL: int 7

; --- TexBuf: a cursor-reused byte buffer (StrOutputByteStream/String<char>) --
define TexBuf (arr: ref[Array[u8]]?, len: size_t)
{
    function make(host: ref[Page]) returns ref[TexBuf]
    {
        let b &TexBuf^host(Array[u8]^host(), 0)
        b
    }

    procedure put(mutable this: ref[TexBuf], c: u8)
    {
        if this.len < this.arr.get_length()
            this.arr.put(this.len, c)
        else
            this.arr.add(c)
        set this.len: this.len + 1
    }

    procedure clear(mutable this: ref[TexBuf])
        set this.len: 0

    function size(this: ref[TexBuf]) returns size_t
        len
}

; --- Format: the inherited-characteristic snapshot the table/page machinery
; consults (reference struct Format; ctor defaults preserved) ----------------
define TexFormat
(
    cur_display_size: int
    line_thickness: int
    line_cap: int
    border_priority: int
    border_present: bool
    line_repeat: int
    line_sep: int
    lines_sym: int
    display_alignment: int
    cell_row_alignment: int
    start_indent_spec: LengthSpec
    end_indent_spec: LengthSpec
    left_margin: int
    right_margin: int
    page_width: int
    page_n_columns: int
    page_column_sep: int
    span_count: int
    cell_background: bool
    bg_r: int
    bg_g: int
    bg_b: int
    cell_before_col_margin: int
    cell_after_col_margin: int
    object_class: int
)
{
    init()
    {
        set this.cur_display_size: 0
        set this.line_thickness: 1000
        ; symbolButt = 70
        set this.line_cap: 70
        set this.border_priority: 0
        set this.border_present: true
        set this.line_repeat: 1
        set this.line_sep: 1000
        ; symbolWrap = 33
        set this.lines_sym: 33
        ; symbolNotApplicable = 2
        set this.display_alignment: 2
        set this.cell_row_alignment: 2
        set this.start_indent_spec: LengthSpec()
        set this.end_indent_spec: LengthSpec()
        set this.left_margin: 1
        set this.right_margin: 1
        set this.page_width: 72000 * 8
        set this.page_n_columns: 1
        set this.page_column_sep: 72000 / 2
        set this.span_count: 1
        set this.cell_background: false
        set this.bg_r: 0
        set this.bg_g: 0
        set this.bg_b: 0
        set this.cell_before_col_margin: TEX_LEN_UNSPEC
        set this.cell_after_col_margin: TEX_LEN_UNSPEC
        set this.object_class: TEX_OC_UNKNOWN
    }
}

; --- FotElementState ---------------------------------------------------------
define TexFoState (enforcing: bool, is_open: bool, ni_prolog: ref[TexBuf])
{
}

; --- OUTLINES ParHead --------------------------------------------------------
define TexParHead (is_headed: bool, level: int, heading_text: ref[TexBuf], previous: int)
{
}

; --- Column ------------------------------------------------------------------
define TexColumn
(
    is_explicit: bool
    has_width: bool
    width: LengthSpec
    width_tuf: double
    computed_width: int
    display_size: int
    display_alignment: int
    default_left_border: int
    default_right_border: int
    default_before_margin: int
    default_after_margin: int
)
{
    function make(host: ref[Page]) returns ref[TexColumn]
    {
        let c &TexColumn^host(false, false, LengthSpec(), 0.0, 0, 0, 25, 0, 0, 0, 0)
        c
    }
}

; --- FotElement: one tagged record covers Border/Cell/Row/TablePart/Table ----
define TexFotEl
(
    tag: int
    parent: ref[TexFotEl]?
    sibling_idx: int
    characteristics: ref[TexBuf]
    ni_prolog: ref[TexBuf]
    ni_epilog: ref[TexBuf]
    ; compound state
    cur_open_child: int
    last_closed_child: int
    pre_content: ref[TexBuf]?
    ; border payload
    border_kind: int
    b_priority: int
    b_thickness: int
    b_present: bool
    b_repeat: int
    b_sep: int
    ; cell payload
    missing: bool
    tex_row_idx: int
    tex_col_idx: int
    n_cols_spanned: int
    n_rows_spanned: int
    br_border: ref[TexFotEl]?
    ar_border: ref[TexFotEl]?
    bc_border: ref[TexFotEl]?
    ac_border: ref[TexFotEl]?
    needs_override: bool
    before_col_margin: int
    eff_before_col_margin: int
    after_col_margin: int
    eff_after_col_margin: int
    row_alignment: int
    eff_alignment: int
    display_size: int
    cell_background: bool
    bg_r: int
    bg_g: int
    bg_b: int
    overlapping: ref[TexFotEl]?
    content: ref[TexBuf]?
    ; row payload
    cells: ref[Array[ref[TexFotEl]?]]?
    ; table-part payload
    columns: ref[Array[ref[TexColumn]?]]?
    header_rows: ref[Array[ref[TexFotEl]?]]?
    body_rows: ref[Array[ref[TexFotEl]?]]?
    footer_rows: ref[Array[ref[TexFotEl]?]]?
    header_prolog: ref[TexBuf]?
    header_epilog: ref[TexBuf]?
    footer_prolog: ref[TexBuf]?
    footer_epilog: ref[TexBuf]?
    columns_processed: bool
    needs_col_reproc: bool
    is_explicit: bool
    ; table payload
    parts: ref[Array[ref[TexFotEl]?]]?
    t_br_border: ref[TexFotEl]?
    t_ar_border: ref[TexFotEl]?
    t_bc_border: ref[TexFotEl]?
    t_ac_border: ref[TexFotEl]?
    table_width: int
    t_display_alignment: int
    start_indent: int
    cur_part: ref[TexFotEl]?
    cur_cell: ref[TexFotEl]?
    ; which row vector CurRows points at: 0 header, 1 body, 2 footer
    cur_rows_sel: int
    no_parts_seen: bool
)
{
    ; every field explicit — define-header defaults do NOT apply (S79 trap).
    function make(host: ref[Page], tag: int) returns ref[TexFotEl]
    {
        let e &TexFotEl^host(tag, null, 0 - 1, TexBuf.make(host), TexBuf.make(host), TexBuf.make(host), 0 - 1, 0 - 1, null, 0, 0, 0, false, 0, 0, false, 0 - 1, 0 - 1, 1, 1, null, null, null, null, false, TEX_LEN_UNSPEC, TEX_LEN_UNSPEC, TEX_LEN_UNSPEC, TEX_LEN_UNSPEC, 2, 25, 0, false, 0, 0, 0, null, null, null, null, null, null, null, null, null, null, null, false, false, true, null, null, null, null, null, 0, 25, 0, null, null, 1, true)
        e
    }

    function make_border(host: ref[Page], kind: int) returns ref[TexFotEl]
    {
        let e TexFotEl.make(host, TEX_EL_BORDER)
        set e.border_kind: kind
        e
    }

    function make_cell(host: ref[Page]) returns ref[TexFotEl]
    {
        let e TexFotEl.make(host, TEX_EL_CELL)
        set e.pre_content: TexBuf.make(host)
        set e.content: TexBuf.make(host)
        set e.br_border: TexFotEl.make_border(host, TEX_B_CELL_BEFORE_ROW)
        set e.ar_border: TexFotEl.make_border(host, TEX_B_CELL_AFTER_ROW)
        set e.bc_border: TexFotEl.make_border(host, TEX_B_CELL_BEFORE_COL)
        set e.ac_border: TexFotEl.make_border(host, TEX_B_CELL_AFTER_COL)
        e
    }

    function make_row(host: ref[Page]) returns ref[TexFotEl]
    {
        let e TexFotEl.make(host, TEX_EL_ROW)
        set e.pre_content: TexBuf.make(host)
        set e.cells: Array[ref[TexFotEl]?]^host()
        e
    }

    function make_part(host: ref[Page]) returns ref[TexFotEl]
    {
        let e TexFotEl.make(host, TEX_EL_PART)
        set e.pre_content: TexBuf.make(host)
        set e.columns: Array[ref[TexColumn]?]^host()
        set e.header_rows: Array[ref[TexFotEl]?]^host()
        set e.body_rows: Array[ref[TexFotEl]?]^host()
        set e.footer_rows: Array[ref[TexFotEl]?]^host()
        set e.header_prolog: TexBuf.make(host)
        set e.header_epilog: TexBuf.make(host)
        set e.footer_prolog: TexBuf.make(host)
        set e.footer_epilog: TexBuf.make(host)
        e
    }

    function make_table(host: ref[Page]) returns ref[TexFotEl]
    {
        let e TexFotEl.make(host, TEX_EL_TABLE)
        set e.pre_content: TexBuf.make(host)
        set e.parts: Array[ref[TexFotEl]?]^host()
        set e.t_br_border: TexFotEl.make_border(host, TEX_B_TABLE_BEFORE_ROW)
        set e.t_ar_border: TexFotEl.make_border(host, TEX_B_TABLE_AFTER_ROW)
        set e.t_bc_border: TexFotEl.make_border(host, TEX_B_TABLE_BEFORE_COL)
        set e.t_ac_border: TexFotEl.make_border(host, TEX_B_TABLE_AFTER_COL)
        e
    }

    ; the macro name of this element
    function el_name(this: ref[TexFotEl]) returns Slice[char]
    {
        if tag = TEX_EL_CELL
            return "TableCell"
        if tag = TEX_EL_ROW
            return "TableRow"
        if tag = TEX_EL_PART
            return "TablePart"
        if tag = TEX_EL_TABLE
            return "Table"
        if border_kind = TEX_B_CELL_BEFORE_ROW
            return "TableCellBeforeRowBorder"
        if border_kind = TEX_B_CELL_AFTER_ROW
            return "TableCellAfterRowBorder"
        if border_kind = TEX_B_CELL_BEFORE_COL
            return "TableCellBeforeColumnBorder"
        if border_kind = TEX_B_CELL_AFTER_COL
            return "TableCellAfterColumnBorder"
        if border_kind = TEX_B_TABLE_BEFORE_ROW
            return "TableBeforeRowBorder"
        if border_kind = TEX_B_TABLE_AFTER_ROW
            return "TableAfterRowBorder"
        if border_kind = TEX_B_TABLE_BEFORE_COL
            return "TableBeforeColumnBorder"
        "TableAfterColumnBorder"
    }

    function is_cell_border(this: ref[TexFotEl]) returns bool
        border_kind < TEX_B_TABLE_BEFORE_ROW

    ; Cell::isOverlapped — NULL OverlappingCell counts as overlapped (the
    ; reference's `OverlappingCell == this ? false : true`).
    function is_overlapped(this: ref[TexFotEl]) returns bool
    {
        if overlapping = (this as ref[TexFotEl])
            return false
        true
    }

    ; TablePart child(): header rows, then body, then footer — with the
    ; reference's missing body-size subtraction quirk preserved (idx into the
    ; footer is offset by the body size only, after subtracting the header).
    function part_child(this: ref[TexFotEl], idx_in: int) returns ref[TexFotEl]?
    {
        var idx idx_in
        let hn header_rows.get_length() as int
        if idx < hn
            return header_rows[idx]
        set idx: idx - hn
        let bn body_rows.get_length() as int
        if idx < bn
            return body_rows[idx]
        set idx: idx - bn
        footer_rows[idx]
    }

    procedure child(this: ref[TexFotEl], idx: int) returns ref[TexFotEl]?
    {
        if tag = TEX_EL_TABLE
            return parts[idx]
        if tag = TEX_EL_PART
            return this.part_child(idx)
        if tag = TEX_EL_ROW
            return cells[idx]
        ; Cell::child asserts in the reference
        TeXFOTBuilder.trap("TexFotEl.child on a leaf")
        null
    }

    ; CompoundFotElement::currentlyOpen_ / lastClosed_
    procedure currently_open(this: ref[TexFotEl]) returns ref[TexFotEl]
    {
        if tag = TEX_EL_BORDER
            return this as ref[TexFotEl]
        if cur_open_child > (0 - 1)
        {
            let c this.child(cur_open_child)
            return c.currently_open()
        }
        this as ref[TexFotEl]
    }

    procedure last_closed(this: ref[TexFotEl]) returns ref[TexFotEl]?
    {
        if tag = TEX_EL_BORDER
        {
            if parent <> null
                return parent.last_closed()
            return null
        }
        if last_closed_child > (0 - 1)
            return this.child(last_closed_child)
        if parent <> null
            return parent.last_closed()
        null
    }

    procedure child_just_opened(mutable this: ref[TexFotEl], c: ref[TexFotEl])
        set this.cur_open_child: c.sibling_idx

    procedure child_just_closed(mutable this: ref[TexFotEl], c: ref[TexFotEl])
    {
        set this.cur_open_child: 0 - 1
        set this.last_closed_child: c.sibling_idx
    }

    ; the row vector CurRows selects
    function cur_rows(this: ref[TexFotEl]) returns ref[Array[ref[TexFotEl]?]]
    {
        let part cur_part
        if cur_rows_sel = 0
            return part.header_rows as ref[Array[Option[ref[TexFotEl]]]]
        if cur_rows_sel = 2
            return part.footer_rows as ref[Array[Option[ref[TexFotEl]]]]
        part.body_rows as ref[Array[Option[ref[TexFotEl]]]]
    }
}

; libc + shim externs (prototypes type-match the other roots').
function log10(x: double) returns double extern
function pow(x: double, y: double) returns double extern
function floor(x: double) returns double extern
function exit(code: i32) extern
procedure scaly_eputs(s: pointer[const_char]) extern
procedure scaly_eputnl() extern

; argv0 for backend messages (TeXMessages warnings, W0 severity: the
; reference renders `<argv0>:W: <text>` through CmdLineApp::message). The CLI
; driver sets it once; a `shared` module global, like tfb_prog.
shared tex_prog: pointer[const_char] null

; --- the builder -------------------------------------------------------------
define TeXFOTBuilder
(
    ; fileout_ + the osStack_ (top = current output target)
    out: ref[TexBuf]
    os_stack: ref[Array[ref[TexBuf]?]]
    os_depth: int
    ; stringout_ (the pending \def stream)
    sout: ref[TexBuf]
    ; FormatStack + NextFormat
    fmt_stack: ref[Array[ref[TexFormat]?]]
    fmt_depth: int
    next_format: TexFormat
    ; FotElementStateStack_
    state_stack: ref[Array[ref[TexFoState]?]]
    state_depth: int
    ; TableStack
    table_stack: ref[Array[ref[TexFotEl]?]]?
    table_depth: int
    ; DisplayBoxLevels
    dbl: ref[Array[int]]
    dbl_len: int
    preserve_sdata: bool
    in_math: int
    ; OUTLINES machinery
    heading_set: bool
    in_heading: bool
    last_headed: int
    par_stack: ref[Array[ref[TexParHead]?]]
    par_depth: int
    ; simple-page-sequence header/footer part capture
    hf_capture: ref[TexBuf]
    in_hf: bool
    host: ref[Page]
)
{
    function make(host: ref[Page]) returns ref[TeXFOTBuilder]
    {
        let f &TeXFOTBuilder^host(TexBuf.make(host), Array[ref[TexBuf]?]^host(), 0, TexBuf.make(host), Array[ref[TexFormat]?]^host(), 0, TexFormat(), Array[ref[TexFoState]?]^host(), 0, Array[ref[TexFotEl]?]^host(), 0, Array[int]^host(), 0, true, 0, false, false, 0, Array[ref[TexParHead]?]^host(), 0, TexBuf.make(host), false, host)
        ; ctor: NextFormat.FotCurDisplaySize = INITIAL_PAGE_SIZE, one base
        ; format level, one base FotElementState, fileout on the os stack,
        ; then the FOT prolog.
        set f.next_format.cur_display_size: 72000 * 8
        f.fmt_push()
        f.state_push()
        f.os_push(f.out)
        f.w_raw("\\FOT{3}")
        f
    }

    ; the reference destructor
    procedure finish(mutable this: ref[TeXFOTBuilder])
        this.w_raw("\\endFOT{}")

    function output(this: ref[TeXFOTBuilder]) returns ref[TexBuf]
        out

    ; --- loud assert (reference asserts are live) -----------------------------
    procedure trap(what: Slice[char])
    {
        if tex_prog <> null
            scaly_eputs(tex_prog)
        scaly_eputs ":E: TeXFOTBuilder invariant violated: "
        write(2, what.data as pointer[void], what.length)
        scaly_eputnl()
        exit(17)
    }

    procedure set_prog_name(prog: pointer[const_char]) mutable tex_prog
        set tex_prog: prog

    ; TeXMessages warnings (W0 severity, no location): `<prog>:W: <text>`.
    procedure msg_w(this: ref[TeXFOTBuilder], text: Slice[char])
    {
        if tex_prog <> null
            scaly_eputs(tex_prog)
        scaly_eputs ":W: "
        write(2, text.data as pointer[void], text.length)
        scaly_eputnl()
    }

    ; --- stacks ---------------------------------------------------------------
    procedure os_push(mutable this: ref[TeXFOTBuilder], b: ref[TexBuf]?)
    {
        let d this.os_depth as size_t
        if d < this.os_stack.get_length()
            this.os_stack.put(d, b)
        else
            this.os_stack.add(b)
        set this.os_depth: this.os_depth + 1
    }

    procedure os_pop(mutable this: ref[TeXFOTBuilder])
    {
        if this.os_depth <= 0
            TeXFOTBuilder.trap("popOs on empty stack")
        set this.os_depth: this.os_depth - 1
    }

    function cur_os(this: ref[TeXFOTBuilder]) returns ref[TexBuf]
    {
        let slotp this.os_stack.get((this.os_depth - 1) as size_t)
        *slotp as ref[TexBuf]
    }

    procedure copy_fmt(mutable dst: ref[TexFormat], src: ref[TexFormat])
    {
        set dst.cur_display_size: src.cur_display_size
        set dst.line_thickness: src.line_thickness
        set dst.line_cap: src.line_cap
        set dst.border_priority: src.border_priority
        set dst.border_present: src.border_present
        set dst.line_repeat: src.line_repeat
        set dst.line_sep: src.line_sep
        set dst.lines_sym: src.lines_sym
        set dst.display_alignment: src.display_alignment
        set dst.cell_row_alignment: src.cell_row_alignment
        set dst.start_indent_spec: src.start_indent_spec
        set dst.end_indent_spec: src.end_indent_spec
        set dst.left_margin: src.left_margin
        set dst.right_margin: src.right_margin
        set dst.page_width: src.page_width
        set dst.page_n_columns: src.page_n_columns
        set dst.page_column_sep: src.page_column_sep
        set dst.span_count: src.span_count
        set dst.cell_background: src.cell_background
        set dst.bg_r: src.bg_r
        set dst.bg_g: src.bg_g
        set dst.bg_b: src.bg_b
        set dst.cell_before_col_margin: src.cell_before_col_margin
        set dst.cell_after_col_margin: src.cell_after_col_margin
        set dst.object_class: src.object_class
    }

    ; FormatStack.push_back(NextFormat)
    procedure fmt_push(mutable this: ref[TeXFOTBuilder])
    {
        let d this.fmt_depth as size_t
        if d < this.fmt_stack.get_length()
        {
            let slotp this.fmt_stack.get(d)
            if slotp <> null
                TeXFOTBuilder.copy_fmt((*slotp) as ref[TexFormat], &this.next_format)
        }
        else
        {
            let host this.host
            let rec host.allocate(sizeof TexFormat, alignof TexFormat) as pointer[TexFormat]
            TeXFOTBuilder.copy_fmt(rec, &this.next_format)
            this.fmt_stack.add(rec)
        }
        set this.fmt_depth: this.fmt_depth + 1
    }

    procedure cur_format(this: ref[TeXFOTBuilder]) returns ref[TexFormat]
    {
        if this.fmt_depth <= 0
            TeXFOTBuilder.trap("curFormat on empty FormatStack")
        let slotp this.fmt_stack.get((this.fmt_depth - 1) as size_t)
        *slotp as ref[TexFormat]
    }

    ; start()/elementStart()/end() — the FOTBuilder format bracket
    procedure fo_start(mutable this: ref[TeXFOTBuilder])
    {
        set this.next_format.object_class: TEX_OC_UNKNOWN
        this.fmt_push()
    }

    procedure element_start(mutable this: ref[TeXFOTBuilder], oc: int)
    {
        set this.next_format.object_class: oc
        this.fmt_push()
    }

    procedure fo_end(mutable this: ref[TeXFOTBuilder])
    {
        if this.fmt_depth <= 1
            TeXFOTBuilder.trap("end() underflow")
        set this.fmt_depth: this.fmt_depth - 1
        let slotp this.fmt_stack.get((this.fmt_depth - 1) as size_t)
        TeXFOTBuilder.copy_fmt(&this.next_format, (*slotp) as ref[TexFormat])
    }

    ; FotElementState stack
    procedure state_push(mutable this: ref[TeXFOTBuilder])
    {
        let d this.state_depth as size_t
        if d < this.state_stack.get_length()
        {
            let slotp this.state_stack.get(d)
            let st *slotp
            set st.enforcing: true
            set st.is_open: false
            st.ni_prolog.clear()
        }
        else
        {
            let host this.host
            let st &TexFoState^host(true, false, TexBuf.make(host))
            this.state_stack.add(st)
        }
        set this.state_depth: this.state_depth + 1
    }

    procedure state_pop(mutable this: ref[TeXFOTBuilder])
    {
        if this.state_depth <= 0
            TeXFOTBuilder.trap("popFotElementState underflow")
        set this.state_depth: this.state_depth - 1
    }

    procedure cur_state(this: ref[TeXFOTBuilder]) returns ref[TexFoState]
    {
        if this.state_depth <= 0
            TeXFOTBuilder.trap("curFotElementState on empty stack")
        let slotp this.state_stack.get((this.state_depth - 1) as size_t)
        *slotp as ref[TexFoState]
    }

    procedure enforcing_structure(this: ref[TeXFOTBuilder]) returns bool
    {
        let st this.cur_state()
        if st.is_open
            return st.enforcing
        false
    }

    ; TableStack
    procedure table_push(mutable this: ref[TeXFOTBuilder]) returns ref[TexFotEl]
    {
        let host this.host
        let t TexFotEl.make_table(host)
        let d this.table_depth as size_t
        if d < this.table_stack.get_length()
            this.table_stack.put(d, t)
        else
            this.table_stack.add(t)
        set this.table_depth: this.table_depth + 1
        t
    }

    procedure cur_table(this: ref[TeXFOTBuilder]) returns ref[TexFotEl]
    {
        if this.table_depth <= 0
            TeXFOTBuilder.trap("curTable on empty TableStack")
        let slotp this.table_stack.get((this.table_depth - 1) as size_t)
        *slotp as ref[TexFotEl]
    }

    ; ParHead stack (OUTLINES)
    procedure par_push(mutable this: ref[TeXFOTBuilder], is_headed: bool, level: int)
    {
        let d this.par_depth as size_t
        if d < this.par_stack.get_length()
        {
            let slotp this.par_stack.get(d)
            let p *slotp
            set p.is_headed: is_headed
            set p.level: level
            p.heading_text.clear()
            set p.previous: 0
        }
        else
        {
            let host this.host
            let p &TexParHead^host(is_headed, level, TexBuf.make(host), 0)
            this.par_stack.add(p)
        }
        set this.par_depth: this.par_depth + 1
    }

    procedure par_pop(mutable this: ref[TeXFOTBuilder])
    {
        if this.par_depth <= 0
            TeXFOTBuilder.trap("pop on empty parStack")
        set this.par_depth: this.par_depth - 1
    }

    procedure par_top(this: ref[TeXFOTBuilder]) returns ref[TexParHead]
    {
        if this.par_depth <= 0
            TeXFOTBuilder.trap("top on empty parStack")
        let slotp this.par_stack.get((this.par_depth - 1) as size_t)
        *slotp as ref[TexParHead]
    }

    function par_at(this: ref[TeXFOTBuilder], i: int) returns ref[TexParHead]
    {
        let slotp this.par_stack.get(i as size_t)
        *slotp as ref[TexParHead]
    }

    ; --- low-level writers (current os) ---------------------------------------
    procedure w_byte(mutable this: ref[TeXFOTBuilder], c: u8)
    {
        let b this.cur_os()
        b.put(c)
    }

    procedure w_raw(mutable this: ref[TeXFOTBuilder], s: Slice[char])
    {
        let b this.cur_os()
        TeXFOTBuilder.b_raw(b, s)
    }

    ; --- low-level writers (explicit buffer) -----------------------------------
    procedure b_raw(mutable b: ref[TexBuf], s: Slice[char])
    {
        var i: size_t 0
        while i < s.length
        {
            b.put(s[i] as u8)
            set i: i + 1
        }
    }

    ; StringC -> bytes (C++ char truncation)
    procedure b_stringc(mutable b: ref[TexBuf], s: StringC)
    {
        let n s.get_size()
        var i: size_t 0
        while i < n
        {
            let c s.get(i)
            b.put((c & 0xFF) as u8)
            set i: i + 1
        }
    }

    ; unsigned decimal (n >= 0)
    procedure b_udec(mutable b: ref[TexBuf], n_in: int)
    {
        var n n_in
        if n = 0
        {
            b.put(0x30)
            return
        }
        var digits u8[24]
        var k 0
        while n > 0
        {
            set digits[k]: ((n % 10) + 0x30) as u8
            set n: n / 10
            set k: k + 1
        }
        while k > 0
        {
            set k: k - 1
            b.put(digits[k])
        }
    }

    ; signed long decimal
    procedure b_long(mutable b: ref[TexBuf], n: int)
    {
        if n < 0
        {
            b.put(0x2D)
            TeXFOTBuilder.b_udec(b, 0 - n)
            return
        }
        TeXFOTBuilder.b_udec(b, n)
    }

    ; printf %g (6 significant digits, trailing zeros stripped, e-form with
    ; signed two-digit exponent outside [1e-4, 1e6))
    procedure b_g(mutable b: ref[TexBuf], x_in: double)
    {
        var x x_in
        if x < 0.0
        {
            b.put(0x2D)
            set x: 0.0 - x
        }
        if x = 0.0
        {
            b.put(0x30)
            return
        }
        var e (floor(log10(x))) as int
        var m (floor((x / pow(10.0, (e - 5) as double)) + 0.5)) as int
        if m >= 1000000
        {
            set m: m / 10
            set e: e + 1
        }
        var digits u8[6]
        var i 6
        while i > 0
        {
            set i: i - 1
            set digits[i]: (0x30 + (m % 10)) as u8
            set m: m / 10
        }
        var k 6
        while k > 1
        {
            if (digits[(k - 1)]) <> 0x30
                break
            set k: k - 1
        }
        var use_sci false
        if e < (0 - 4)
            set use_sci: true
        if e >= 6
            set use_sci: true
        if use_sci
        {
            b.put(*(digits as pointer[u8]))
            if k > 1
            {
                b.put(0x2E)
                var j 1
                while j < k
                {
                    b.put(digits[j])
                    set j: j + 1
                }
            }
            b.put(0x65)
            var ea e
            if ea < 0
            {
                b.put(0x2D)
                set ea: 0 - ea
            }
            else
                b.put(0x2B)
            if ea < 10
                b.put(0x30)
            TeXFOTBuilder.b_udec(b, ea)
            return
        }
        if e >= 0
        {
            ; digits before the point: e+1
            var j 0
            while j <= e
            {
                if j < k
                    b.put(digits[j])
                else
                    b.put(0x30)
                set j: j + 1
            }
            if k > (e + 1)
            {
                b.put(0x2E)
                while j < k
                {
                    b.put(digits[j])
                    set j: j + 1
                }
            }
            return
        }
        ; 0.<zeros><digits>
        b.put(0x30)
        b.put(0x2E)
        var z 0 - (e + 1)
        while z > 0
        {
            b.put(0x30)
            set z: z - 1
        }
        var j 0
        while j < k
        {
            b.put(digits[j])
            set j: j + 1
        }
    }

    ; %g of a value squeezed through FLOAT precision (the reference streams
    ; `float(...)` through operator<<(double))
    procedure b_gf(mutable b: ref[TexBuf], x: double)
    {
        let xf ((x as f32) as double)
        TeXFOTBuilder.b_g(b, xf)
    }

    ; LengthInPoints: "%li.%.3i" of l/1000 and |l%1000|, trailing zeros (and a
    ; bare point) stripped, then "\p@". Sign of -0.x values is lost (faithful).
    procedure b_pts(mutable b: ref[TexBuf], l: int)
    {
        var buf u8[40]
        var len 0
        let whole l / 1000
        var rem l % 1000
        if rem < 0
            set rem: 0 - rem
        if whole < 0
        {
            set buf[len]: 0x2D
            set len: len + 1
        }
        var wmag whole
        if wmag < 0
            set wmag: 0 - wmag
        ; whole magnitude digits
        var tmp u8[24]
        var k 0
        if wmag = 0
        {
            set *((tmp as pointer[u8])): 0x30
            set k: 1
        }
        else
        {
            while wmag > 0
            {
                set tmp[k]: ((wmag % 10) + 0x30) as u8
                set wmag: wmag / 10
                set k: k + 1
            }
        }
        while k > 0
        {
            set k: k - 1
            set buf[len]: tmp[k]
            set len: len + 1
        }
        set buf[len]: 0x2E
        set len: len + 1
        set buf[len]: ((rem / 100) + 0x30) as u8
        set len: len + 1
        set buf[len]: (((rem / 10) % 10) + 0x30) as u8
        set len: len + 1
        set buf[len]: ((rem % 10) + 0x30) as u8
        set len: len + 1
        ; strip trailing zeros, then a bare point
        var i len - 1
        while (buf[i]) = 0x30
            set i: i - 1
        if (buf[i]) = 0x2E
            set i: i - 1
        var m 0
        while m <= i
        {
            b.put(buf[m])
            set m: m + 1
        }
        TeXFOTBuilder.b_raw(b, "\\p@")
    }

    ; append buffer to buffer (TmpOutputByteStream::commit)
    procedure b_buf(mutable dst: ref[TexBuf], src: ref[TexBuf])
    {
        let n src.size()
        var i: size_t 0
        while i < n
        {
            dst.put(src.arr[i])
            set i: i + 1
        }
    }

    ; --- the Symbol -> TeX name table (reference switch; enum order codes) ----
    function sym_name(code: int) returns Slice[char]
    {
        if code = 0
            return "false"
        if code = 1
            return "true"
        if code = 2
            return "notapplicable"
        if code = 3
            return "ultracondensed"
        if code = 4
            return "extracondensed"
        if code = 5
            return "condensed"
        if code = 6
            return "semicondensed"
        if code = 7
            return "ultralight"
        if code = 8
            return "extralight"
        if code = 9
            return "light"
        if code = 10
            return "semilight"
        if code = 11
            return "medium"
        if code = 12
            return "semiexpanded"
        if code = 13
            return "expanded"
        if code = 14
            return "extraexpanded"
        if code = 15
            return "ultraexpanded"
        if code = 16
            return "semibold"
        if code = 17
            return "bold"
        if code = 18
            return "extrabold"
        if code = 19
            return "ultrabold"
        if code = 20
            return "upright"
        if code = 21
            return "oblique"
        if code = 22
            return "backslantedoblique"
        if code = 23
            return "italic"
        if code = 24
            return "backslanteditalic"
        if code = 25
            return "start"
        if code = 26
            return "end"
        if code = 27
            return "center"
        if code = 28
            return "justify"
        if code = 29
            return "spreadinside"
        if code = 30
            return "spreadoutside"
        if code = 31
            return "pageinside"
        if code = 32
            return "pageoutside"
        if code = 33
            return "wrap"
        if code = 34
            return "asis"
        if code = 35
            return "asiswrap"
        if code = 36
            return "asistruncate"
        if code = 37
            return "none"
        if code = 38
            return "before"
        if code = 39
            return "through"
        if code = 40
            return "after"
        if code = 41
            return "toptobottom"
        if code = 42
            return "lefttoright"
        if code = 43
            return "bottomtotop"
        if code = 44
            return "righttoleft"
        if code = 45
            return "inside"
        if code = 46
            return "outside"
        if code = 47
            return "horizontal"
        if code = 48
            return "vertical"
        if code = 49
            return "escapement"
        if code = 50
            return "lineprogression"
        if code = 51
            return "math"
        if code = 52
            return "ordinary"
        if code = 53
            return "operator"
        if code = 54
            return "binary"
        if code = 55
            return "relation"
        if code = 56
            return "opening"
        if code = 57
            return "closing"
        if code = 58
            return "punctuation"
        if code = 59
            return "inner"
        if code = 60
            return "space"
        if code = 61
            return "page"
        if code = 62
            return "pageregion"
        if code = 63
            return "columnset"
        if code = 64
            return "column"
        if code = 65
            return "max"
        if code = 66
            return "maxuniform"
        if code = 67
            return "miter"
        if code = 68
            return "round"
        if code = 69
            return "bevel"
        if code = 70
            return "butt"
        if code = 71
            return "square"
        if code = 72
            return "loose"
        if code = 73
            return "normal"
        if code = 74
            return "kern"
        if code = 75
            return "tight"
        if code = 76
            return "touch"
        if code = 77
            return "preserve"
        if code = 78
            return "collapse"
        if code = 79
            return "ignore"
        if code = 80
            return "relative"
        if code = 81
            return "display"
        if code = 82
            return "inline"
        if code = 83
            return "border"
        if code = 84
            return "background"
        if code = 85
            return "both"
        if code = 86
            return "base"
        if code = 87
            return "font"
        if code = 88
            return "top"
        if code = 89
            return "bottom"
        if code = 90
            return "spread"
        if code = 91
            return "solid"
        if code = 92
            return "outline"
        if code = 93
            return "with"
        if code = 94
            return "against"
        if code = 95
            return "force"
        if code = 96
            return "independent"
        if code = 97
            return "pile"
        if code = 98
            return "supout"
        if code = 99
            return "subout"
        if code = 100
            return "leadedge"
        if code = 101
            return "trailedge"
        if code = 102
            return "explicit"
        if code = 103
            return "rowmajor"
        if code = 104
            return "columnmajor"
        ""
    }

    ; --- characteristic set helpers (all render into stringout_) --------------
    procedure def_open(mutable this: ref[TeXFOTBuilder], name: Slice[char])
    {
        let b this.sout
        TeXFOTBuilder.b_raw(b, "\\def\\")
        TeXFOTBuilder.b_raw(b, name)
        TeXFOTBuilder.b_raw(b, "%\n{")
    }

    procedure def_close(mutable this: ref[TeXFOTBuilder])
    {
        let b this.sout
        b.put(0x7D)
    }

    ; setlength — float(size/1000.0) + \p@
    procedure set_len(mutable this: ref[TeXFOTBuilder], name: Slice[char], l: int)
    {
        this.def_open(name)
        let b this.sout
        TeXFOTBuilder.b_gf(b, (l as double) / 1000.0)
        TeXFOTBuilder.b_raw(b, "\\p@")
        this.def_close()
    }

    procedure set_sym(mutable this: ref[TeXFOTBuilder], name: Slice[char], code: int)
    {
        this.def_open(name)
        let b this.sout
        let nm TeXFOTBuilder.sym_name(code)
        TeXFOTBuilder.b_raw(b, nm)
        this.def_close()
    }

    ; `unsigned long g = node->groveIndex(); if (g) set("GroveIndex", g);` —
    ; emitted only for a NON-document grove, which is exactly what sgml-parse
    ; can produce.
    procedure set_grove_index(mutable this: ref[TeXFOTBuilder], node: ref[GroveNode]?)
    {
        let g GroveInfo.index_of(node)
        if g = 0
            return
        this.def_open("GroveIndex")
        let b this.sout
        TeXFOTBuilder.b_udec(b, g)
        this.def_close()
    }

    procedure set_stringc(mutable this: ref[TeXFOTBuilder], name: Slice[char], s: StringC)
    {
        this.def_open(name)
        let b this.sout
        TeXFOTBuilder.b_stringc(b, s)
        this.def_close()
    }

    ; set(name, PublicId) — the id bytes. A #f id is a NULL const char* in the
    ; reference, and its operator<<(const char *) dereferences unguarded: the
    ; reference SIGSEGVs. We render an empty value (documented divergence; no
    ; corpus stylesheet sets a public-id characteristic to #f).
    procedure set_pubid(mutable this: ref[TeXFOTBuilder], name: Slice[char], ic: ref[InheritedC])
    {
        this.def_open(name)
        if ic.bval = false
        {
            let b this.sout
            TeXFOTBuilder.b_stringc(b, ic.sval)
        }
        this.def_close()
    }

    ; set(name, LengthSpec) — float length + \p@, then the Factor def (%g)
    procedure set_lenspec(mutable this: ref[TeXFOTBuilder], name: Slice[char], ls: LengthSpec)
    {
        this.def_open(name)
        let b this.sout
        TeXFOTBuilder.b_gf(b, (ls.length as double) / 1000.0)
        TeXFOTBuilder.b_raw(b, "\\p@")
        this.def_close()
        TeXFOTBuilder.b_raw(b, "\\def\\")
        TeXFOTBuilder.b_raw(b, name)
        TeXFOTBuilder.b_raw(b, "Factor%\n{")
        TeXFOTBuilder.b_g(b, ls.factor)
        this.def_close()
    }

    procedure set_double(mutable this: ref[TeXFOTBuilder], name: Slice[char], d: double)
    {
        this.def_open(name)
        let b this.sout
        TeXFOTBuilder.b_g(b, d)
        this.def_close()
    }

    procedure set_long(mutable this: ref[TeXFOTBuilder], name: Slice[char], n: int)
    {
        this.def_open(name)
        let b this.sout
        TeXFOTBuilder.b_long(b, n)
        this.def_close()
    }

    procedure set_bool(mutable this: ref[TeXFOTBuilder], name: Slice[char], f: bool)
    {
        this.def_open(name)
        let b this.sout
        if f
            b.put(0x31)
        else
            b.put(0x30)
        this.def_close()
    }

    ; setletter2 — the two code bytes verbatim; a #f characteristic is
    ; Letter2 0, i.e. TWO NUL BYTES in the stream (reference-verified).
    procedure set_letter2(mutable this: ref[TeXFOTBuilder], name: Slice[char], ic: ref[InheritedC])
    {
        this.def_open(name)
        let b this.sout
        if ic.bval or (ic.sval.get_size() < 2)
        {
            b.put(0)
            b.put(0)
        }
        else
        {
            b.put((ic.sval.get(0) & 0xFF) as u8)
            b.put((ic.sval.get(1) & 0xFF) as u8)
        }
        this.def_close()
    }

    ; set(name, DeviceRGBColor) — Red/Green/Blue defs
    procedure set_color(mutable this: ref[TeXFOTBuilder], name: Slice[char], r: int, g: int, b_in: int)
    {
        let b this.sout
        TeXFOTBuilder.b_raw(b, "\\def\\")
        TeXFOTBuilder.b_raw(b, name)
        TeXFOTBuilder.b_raw(b, "Red%\n{")
        TeXFOTBuilder.b_long(b, r)
        b.put(0x7D)
        TeXFOTBuilder.b_raw(b, "\\def\\")
        TeXFOTBuilder.b_raw(b, name)
        TeXFOTBuilder.b_raw(b, "Green%\n{")
        TeXFOTBuilder.b_long(b, g)
        b.put(0x7D)
        TeXFOTBuilder.b_raw(b, "\\def\\")
        TeXFOTBuilder.b_raw(b, name)
        TeXFOTBuilder.b_raw(b, "Blue%\n{")
        TeXFOTBuilder.b_long(b, b_in)
        b.put(0x7D)
    }

    ; one member of the DisplaySpace/InlineSpace family: NAME+suffix def with a
    ; PLAIN double length (no float squeeze — reference streams the division)
    procedure set_space_part(mutable this: ref[TeXFOTBuilder], name: Slice[char], suffix: Slice[char], v: double, pts: bool)
    {
        let b this.sout
        TeXFOTBuilder.b_raw(b, "\\def\\")
        TeXFOTBuilder.b_raw(b, name)
        TeXFOTBuilder.b_raw(b, suffix)
        TeXFOTBuilder.b_raw(b, "%\n{")
        TeXFOTBuilder.b_g(b, v)
        if pts
            TeXFOTBuilder.b_raw(b, "\\p@")
        b.put(0x7D)
    }

    procedure set_display_space(mutable this: ref[TeXFOTBuilder], name: Slice[char], ds: DisplaySpace)
    {
        var any false
        if ds.nominal.length <> 0
            set any: true
        if ds.min.length <> 0
            set any: true
        if ds.max.length <> 0
            set any: true
        if any = false
            return
        this.set_space_part(name, "Nom", (ds.nominal.length as double) / 1000.0, true)
        if ds.nominal.factor <> 0.0
            this.set_space_part(name, "NomFactor", ds.nominal.factor, false)
        if ds.min.length <> 0
            this.set_space_part(name, "Min", (ds.min.length as double) / 1000.0, true)
        if ds.min.factor <> 0.0
            this.set_space_part(name, "MinFactor", ds.min.factor, false)
        if ds.max.length <> 0
            this.set_space_part(name, "Max", (ds.max.length as double) / 1000.0, true)
        if ds.max.factor <> 0.0
            this.set_space_part(name, "MaxFactor", ds.max.factor, false)
        if ds.priority <> 0
        {
            let b this.sout
            TeXFOTBuilder.b_raw(b, "\\def\\")
            TeXFOTBuilder.b_raw(b, name)
            TeXFOTBuilder.b_raw(b, "Priority%\n{")
            TeXFOTBuilder.b_long(b, ds.priority)
            b.put(0x7D)
        }
        if ds.conditional
        {
            let b this.sout
            TeXFOTBuilder.b_raw(b, "\\def\\")
            TeXFOTBuilder.b_raw(b, name)
            TeXFOTBuilder.b_raw(b, "Conditional%\n{1}")
        }
        if ds.force
        {
            let b this.sout
            TeXFOTBuilder.b_raw(b, "\\def\\")
            TeXFOTBuilder.b_raw(b, name)
            TeXFOTBuilder.b_raw(b, "Force%\n{1}")
        }
    }

    procedure set_inline_space(mutable this: ref[TeXFOTBuilder], name: Slice[char], sp: ref[InlineSpace])
    {
        var any false
        if sp.nominal.length <> 0
            set any: true
        if sp.min.length <> 0
            set any: true
        if sp.max.length <> 0
            set any: true
        if any = false
            return
        this.set_space_part(name, "Nom", (sp.nominal.length as double) / 1000.0, true)
        if sp.nominal.factor <> 0.0
            this.set_space_part(name, "NomFactor", sp.nominal.factor, false)
        if sp.min.length <> 0
            this.set_space_part(name, "Min", (sp.min.length as double) / 1000.0, true)
        if sp.min.factor <> 0.0
            this.set_space_part(name, "MinFactor", sp.min.factor, false)
        if sp.max.length <> 0
            this.set_space_part(name, "Max", (sp.max.length as double) / 1000.0, true)
        if sp.max.factor <> 0.0
            this.set_space_part(name, "MaxFactor", sp.max.factor, false)
    }

    ; dumpInherited — flush the pending defs into the current os
    procedure dump_inherited(mutable this: ref[TeXFOTBuilder])
    {
        let b this.cur_os()
        TeXFOTBuilder.b_buf(b, this.sout)
        this.sout.clear()
    }

    ; stringout_.extractString(target) — REPLACES the target
    procedure extract_into(mutable this: ref[TeXFOTBuilder], mutable dst: ref[TexBuf])
    {
        dst.clear()
        TeXFOTBuilder.b_buf(dst, this.sout)
        this.sout.clear()
    }

    ; --- group scaffolding -----------------------------------------------------
    procedure group_start(mutable this: ref[TeXFOTBuilder], name: Slice[char])
    {
        let b this.cur_os()
        b.put(0x5C)
        TeXFOTBuilder.b_raw(b, name)
        TeXFOTBuilder.b_raw(b, "%\n{")
        this.dump_inherited()
        let b2 this.cur_os()
        b2.put(0x7D)
    }

    ; startGroup(name, output) — "\Name%\n{<extract>}" APPENDED to output
    procedure group_start_out(mutable this: ref[TeXFOTBuilder], name: Slice[char], mutable dst: ref[TexBuf])
    {
        dst.put(0x5C)
        TeXFOTBuilder.b_raw(dst, name)
        TeXFOTBuilder.b_raw(dst, "%\n{")
        TeXFOTBuilder.b_buf(dst, this.sout)
        this.sout.clear()
        dst.put(0x7D)
    }

    procedure group_end(mutable this: ref[TeXFOTBuilder], name: Slice[char])
    {
        let b this.cur_os()
        TeXFOTBuilder.b_raw(b, "\\end")
        TeXFOTBuilder.b_raw(b, name)
        TeXFOTBuilder.b_raw(b, "{}")
    }

    procedure group_end_out(this: ref[TeXFOTBuilder], name: Slice[char], mutable dst: ref[TexBuf]?)
    {
        TeXFOTBuilder.b_raw(dst as ref[TexBuf], "\\end")
        TeXFOTBuilder.b_raw(dst as ref[TexBuf], name)
        TeXFOTBuilder.b_raw(dst as ref[TexBuf], "{}")
    }

    procedure simple_group_start(mutable this: ref[TeXFOTBuilder])
    {
        let b this.cur_os()
        TeXFOTBuilder.b_raw(b, "%\n{")
        this.dump_inherited()
    }

    procedure simple_group_end(mutable this: ref[TeXFOTBuilder])
    {
        let b this.cur_os()
        b.put(0x7D)
    }

    procedure closeopen_brace(mutable this: ref[TeXFOTBuilder])
    {
        let b this.cur_os()
        TeXFOTBuilder.b_raw(b, "}{")
        this.dump_inherited()
    }

    procedure brace_start(mutable this: ref[TeXFOTBuilder], name: Slice[char])
    {
        let b this.cur_os()
        b.put(0x5C)
        TeXFOTBuilder.b_raw(b, name)
        TeXFOTBuilder.b_raw(b, "%\n{")
        this.dump_inherited()
        let b2 this.cur_os()
        TeXFOTBuilder.b_raw(b2, "}{")
    }

    procedure brace_end(mutable this: ref[TeXFOTBuilder])
    {
        let b this.cur_os()
        b.put(0x7D)
    }

    procedure insert_atomic(mutable this: ref[TeXFOTBuilder], name: Slice[char])
    {
        let b this.cur_os()
        TeXFOTBuilder.b_raw(b, "\\insert")
        TeXFOTBuilder.b_raw(b, name)
        TeXFOTBuilder.b_raw(b, "%\n{")
        this.dump_inherited()
        let b2 this.cur_os()
        b2.put(0x7D)
    }

    ; startGroup(FotElement&)/insertAtomic(FotElement&) — capture the pending
    ; defs as the element's characteristics
    procedure capture_into(mutable this: ref[TeXFOTBuilder], mutable el: ref[TexFotEl])
        this.extract_into(el.characteristics)

    ; --- the characteristic dispatch (reference setters by registry index) ----
    procedure set_ic(mutable this: ref[TeXFOTBuilder], ic: ref[InheritedC])
    {
        let ext ic.ext_setter
        if ext <> 0
        {
            this.set_extension_ic(ext, ic)
            return
        }
        let index ic.get_index()
        if index = 0
            this.set_len("fSize", ic.lval)
        else if index = 1
            this.set_font_family_name(ic.sval)
        else if index = 2
            this.set_sym("fWeight", ic.sym.code)
        else if index = 3
            this.set_sym("fPosture", ic.sym.code)
        else if index = 4
            this.set_sym("Quadding", ic.sym.code)
        else if index = 5
        {
            set this.next_format.display_alignment: ic.sym.code
            this.set_sym("DisplayAlignment", ic.sym.code)
        }
        else if index = 6
            this.set_sym("FieldAlign", ic.sym.code)
        else if index = 7
        {
            set this.next_format.lines_sym: ic.sym.code
            this.set_sym("Lines", ic.sym.code)
        }
        else if index = 8
        {
            set this.next_format.start_indent_spec: ic.ls
            this.set_lenspec("StartIndent", ic.ls)
        }
        else if index = 9
            this.set_lenspec("FirstLineStartIndent", ic.ls)
        else if index = 10
        {
            set this.next_format.end_indent_spec: ic.ls
            this.set_lenspec("EndIndent", ic.ls)
        }
        else if index = 11
            this.set_lenspec("LastLineEndIndent", ic.ls)
        else if index = 12
            this.set_lenspec("LineSpacing", ic.ls)
        else if index = 13
            this.set_lenspec("FieldWidth", ic.ls)
        else if index = 14
        {
            set this.next_format.left_margin: ic.lval
            this.set_len("LeftMargin", ic.lval)
        }
        else if index = 15
        {
            set this.next_format.right_margin: ic.lval
            this.set_len("RightMargin", ic.lval)
        }
        else if index = 16
            this.set_len("TopMargin", ic.lval)
        else if index = 17
            this.set_len("BottomMargin", ic.lval)
        else if index = 18
            this.set_len("HeaderMargin", ic.lval)
        else if index = 19
            this.set_len("FooterMargin", ic.lval)
        else if index = 20
        {
            set this.next_format.page_width: ic.lval
            this.set_len("PageWidth", ic.lval)
        }
        else if index = 21
            this.set_len("PageHeight", ic.lval)
        else if index = 22
        {
            set this.next_format.border_present: ic.bval
            this.set_bool("BorderPresent", ic.bval)
        }
        else if index = 23
        {
            set this.next_format.line_thickness: ic.lval
            this.set_len("LineThickness", ic.lval)
        }
        else if index = 24
            this.set_len("CellBeforeRowMargin", ic.lval)
        else if index = 25
            this.set_len("CellAfterRowMargin", ic.lval)
        else if index = 26
        {
            set this.next_format.cell_before_col_margin: ic.lval
            this.set_len("CellBeforeColumnMargin", ic.lval)
        }
        else if index = 27
        {
            set this.next_format.cell_after_col_margin: ic.lval
            this.set_len("CellAfterColumnMargin", ic.lval)
        }
        else if index = 28
        {
            set this.next_format.line_sep: ic.lval
            this.set_len("LineSep", ic.lval)
        }
        else if index = 29
            this.set_len("BoxSizeBefore", ic.lval)
        else if index = 30
            this.set_len("BoxSizeAfter", ic.lval)
        else if index = 31
            this.set_lenspec("PositionPointShift", ic.ls)
        else if index = 32
            this.set_lenspec("StartMargin", ic.ls)
        else if index = 33
            this.set_lenspec("EndMargin", ic.ls)
        else if index = 34
            this.set_lenspec("SidelineSep", ic.ls)
        else if index = 35
            this.set_lenspec("AsisWrapIndent", ic.ls)
        else if index = 36
            this.set_lenspec("LineNumberSep", ic.ls)
        else if index = 37
            this.set_lenspec("LastLineJustifyLimit", ic.ls)
        else if index = 38
            this.set_lenspec("JustifyGlyphSpaceMaxAdd", ic.ls)
        else if index = 39
            this.set_lenspec("JustifyGlyphSpaceMaxRemove", ic.ls)
        else if index = 40
            this.set_lenspec("TableCornerRadius", ic.ls)
        else if index = 41
            this.set_lenspec("BoxCornerRadius", ic.ls)
        else if index = 42
            this.set_lenspec("MarginaliaSep", ic.ls)
        else if index = 43
            this.set_bool("InhibitLineBreaks", ic.bval)
        else if index = 44
            this.set_bool("Hyphenate", ic.bval)
        else if index = 45
            this.set_bool("Kern", ic.bval)
        else if index = 46
            this.set_bool("Ligature", ic.bval)
        else if index = 47
            this.set_bool("ScoreSpaces", ic.bval)
        else if index = 48
            this.set_bool("FloatOutSidelines", ic.bval)
        else if index = 49
            this.set_bool("FloatOutMarginalia", ic.bval)
        else if index = 50
            this.set_bool("FloatOutLineNumbers", ic.bval)
        else if index = 51
        {
            set this.next_format.cell_background: ic.bval
            this.set_bool("CellBackground", ic.bval)
        }
        else if index = 52
            this.set_bool("SpanWeak", ic.bval)
        else if index = 53
            this.set_bool("IgnoreRecordEnd", ic.bval)
        else if index = 54
            this.set_bool("NumberedLines", ic.bval)
        else if index = 55
            this.set_bool("HangingPunct", ic.bval)
        else if index = 56
            this.set_bool("BoxOpenEnd", ic.bval)
        else if index = 57
            this.set_bool("TruncateLeader", ic.bval)
        else if index = 58
            this.set_bool("AlignLeader", ic.bval)
        else if index = 59
            this.set_bool("TablePartOmitMiddleHeader", ic.bval)
        else if index = 60
            this.set_bool("TablePartOmitMiddleFooter", ic.bval)
        else if index = 61
            this.set_bool("BorderOmitAtBreak", ic.bval)
        else if index = 62
            this.set_bool("PrincipalModeSimultaneous", ic.bval)
        else if index = 63
            this.set_bool("MarginaliaKeepWithPrevious", ic.bval)
        else if index = 64
            this.set_bool("GridEquidistantRows", ic.bval)
        else if index = 65
            this.set_bool("GridEquidistantColumns", ic.bval)
        else if index = 66
            this.set_sym("LineJoin", ic.sym.code)
        else if index = 67
        {
            set this.next_format.line_cap: ic.sym.code
            this.set_sym("LineCap", ic.sym.code)
        }
        else if index = 68
            this.set_sym("LineNumberSide", ic.sym.code)
        else if index = 69
            this.set_sym("KernMode", ic.sym.code)
        else if index = 70
            this.set_sym("InputWhitespaceTreatment", ic.sym.code)
        else if index = 71
            this.set_sym("FillingDirection", ic.sym.code)
        else if index = 72
            this.set_sym("WritingMode", ic.sym.code)
        else if index = 73
            this.set_sym("LastLineQuadding", ic.sym.code)
        else if index = 74
            this.set_sym("MathDisplayMode", ic.sym.code)
        else if index = 75
            this.set_sym("ScriptPreAlign", ic.sym.code)
        else if index = 76
            this.set_sym("ScriptPostAlign", ic.sym.code)
        else if index = 77
            this.set_sym("ScriptMidSupAlign", ic.sym.code)
        else if index = 78
            this.set_sym("ScriptMidSubAlign", ic.sym.code)
        else if index = 79
            this.set_sym("NumeratorAlign", ic.sym.code)
        else if index = 80
            this.set_sym("DenominatorAlign", ic.sym.code)
        else if index = 81
            this.set_sym("GridPositionCellType", ic.sym.code)
        else if index = 82
            this.set_sym("GridColumnAlignment", ic.sym.code)
        else if index = 83
            this.set_sym("GridRowAlignment", ic.sym.code)
        else if index = 84
            this.set_sym("BoxType", ic.sym.code)
        else if index = 85
            this.set_sym("GlyphAlignmentMode", ic.sym.code)
        else if index = 86
            this.set_sym("BoxBorderAlignment", ic.sym.code)
        else if index = 87
        {
            set this.next_format.cell_row_alignment: ic.sym.code
            this.set_sym("CellRowAlignment", ic.sym.code)
        }
        else if index = 88
            this.set_sym("BorderAlignment", ic.sym.code)
        else if index = 89
            this.set_sym("SidelineSide", ic.sym.code)
        else if index = 90
            this.set_sym("HyphenationKeep", ic.sym.code)
        else if index = 91
            this.set_sym("fStructure", ic.sym.code)
        else if index = 92
            this.set_sym("fProportionateWidth", ic.sym.code)
        else if index = 93
            this.set_sym("CellCrossed", ic.sym.code)
        else if index = 94
            this.set_sym("MarginaliaSide", ic.sym.code)
        else if index = 95
            this.set_long("Layer", ic.lval)
        else if index = 96
            this.set_long("BackgroundLayer", ic.lval)
        else if index = 97
        {
            set this.next_format.border_priority: ic.lval
            this.set_long("BorderPriority", ic.lval)
        }
        else if index = 98
        {
            set this.next_format.line_repeat: ic.lval
            this.set_long("LineRepeat", ic.lval)
        }
        else if index = 99
        {
            set this.next_format.span_count: ic.lval
            set this.next_format.cur_display_size: this.next_format.page_width - this.next_format.left_margin - this.next_format.right_margin
            this.set_long("Span", ic.lval)
        }
        else if index = 100
            this.set_long("MinLeaderRepeat", ic.lval)
        else if index = 101
            this.set_long("HyphenationRemainCharCount", ic.lval)
        else if index = 102
            this.set_long("HyphenationPushCharCount", ic.lval)
        else if index = 103
            this.set_long("WidowCount", ic.lval)
        else if index = 104
            this.set_long("OrphanCount", ic.lval)
        else if index = 105
            this.set_pubid("BackgroundTile", ic)
        else if index = 106
            this.set_pubid("LineBreakingMethod", ic)
        else if index = 107
            this.set_pubid("LineCompositionMethod", ic)
        else if index = 108
            this.set_pubid("ImplicitBidiMethod", ic)
        else if index = 109
            this.set_pubid("GlyphSubstMethod", ic)
        else if index = 110
            this.set_pubid("GlyphReorderMethod", ic)
        else if index = 111
            this.set_pubid("HyphenationMethod", ic)
        else if index = 112
            this.set_pubid("TableAutoWidthMethod", ic)
        else if index = 113
            this.set_pubid("fName", ic)
        else if index = 132
            this.set_letter2("Language", ic)
        else if index = 133
            this.set_letter2("Country", ic)
        else if index = 134
            this.set_long("ExpandTabs", ic.lval)
        else if index = 135
            this.set_long("HyphenationLadderCount", ic.lval)
        else if index = 155
        {
            let rgb ic.obj.color_rgb()
            this.set_color("Color", (rgb >> 16) & 0xFF, (rgb >> 8) & 0xFF, rgb & 0xFF)
        }
        else if index = 156
        {
            if ic.obj = null
                this.set_sym("BackgroundColor", 0)
            else
            {
                let rgb ic.obj.color_rgb()
                let r (rgb >> 16) & 0xFF
                let g (rgb >> 8) & 0xFF
                let bb rgb & 0xFF
                set this.next_format.bg_r: r
                set this.next_format.bg_g: g
                set this.next_format.bg_b: bb
                this.set_color("BackgroundColor", r, g, bb)
            }
        }
        else if index = 157
        {
            if ic.bval = false
                this.set_lenspec("MinPreLineSpacing", ic.ls)
        }
        else if index = 158
        {
            if ic.bval = false
                this.set_lenspec("MinPostLineSpacing", ic.ls)
        }
        else if index = 159
        {
            if ic.bval = false
                this.set_lenspec("MinLeading", ic.ls)
        }
        else if index = 160
        {
            let sp ic.obj.as_inline_space()
            if sp <> null
                this.set_inline_space("EscapementSpaceBefore", sp)
        }
        else if index = 161
        {
            let sp ic.obj.as_inline_space()
            if sp <> null
                this.set_inline_space("EscapementSpaceAfter", sp)
        }
        else if index = 162
        {
            if ic.obj <> null
            {
                let sp ic.obj.as_inline_space()
                if sp <> null
                    this.set_inline_space("InlineSpaceSpace", sp)
            }
        }
        else if index = 164
            this.msg_w("TeX backend does not currently support glyph substitution tables")
        ; 114-131, 136-154, 163: no reference TeXFOTBuilder override — no-ops.
    }

    ; setFontFamilyName — spaces become '-'
    procedure set_font_family_name(mutable this: ref[TeXFOTBuilder], name: StringC)
    {
        let b this.sout
        TeXFOTBuilder.b_raw(b, "\\def\\fFamName{")
        let n name.get_size()
        var i: size_t 0
        while i < n
        {
            let c name.get(i)
            if c = 0x20
                b.put(0x2D)
            else
                b.put((c & 0xFF) as u8)
            set i: i + 1
        }
        b.put(0x7D)
    }

    ; the jade.cxx TeX extension characteristics (makeTeXFOTBuilder table)
    procedure set_extension_ic(mutable this: ref[TeXFOTBuilder], ext: int, ic: ref[InheritedC])
    {
        if ext = 1
            this.set_stringc("PageNumberFormat", ic.sval)
        else if ext = 2
            this.set_bool("PageNumberRestart", ic.bval)
        else if ext = 3
        {
            set this.next_format.page_n_columns: ic.lval
            this.set_long("PageNColumns", ic.lval)
        }
        else if ext = 4
        {
            set this.next_format.page_column_sep: ic.lval
            this.set_len("PageColumnSep", ic.lval)
        }
        else if ext = 5
            this.set_bool("PageBalanceColumns", ic.bval)
        else if ext = 6
            this.set_len("SubScriptDepth", ic.lval)
        else if ext = 7
            this.set_len("OverMarkHeight", ic.lval)
        else if ext = 8
            this.set_len("UnderMarkDepth", ic.lval)
        else if ext = 9
            this.set_len("SuperscriptHeight", ic.lval)
        else if ext = 10
            this.set_len("GridRowsep", ic.lval)
        else if ext = 11
            this.set_len("GridColumnSep", ic.lval)
        else if ext = 12
            this.set_heading_level(ic.lval)
        else if ext = 13
            this.set_bool("PageTwoSide", ic.bval)
        else if ext = 14
            this.set_bool("TwoSideStartOnRight", ic.bval)
        else if ext = 15
            set this.preserve_sdata: ic.bval
    }

    ; setHeadingLevel (OUTLINES): 1..9 arms the next paragraph as a heading
    procedure set_heading_level(mutable this: ref[TeXFOTBuilder], n: int)
    {
        if n >= 1
        {
            if n <= 9
            {
                this.par_push(true, n)
                set this.heading_set: true
                this.set_long("HeadingLevel", n)
            }
        }
    }

    ; --- computeLengthSpec -----------------------------------------------------
    procedure compute_length_spec(this: ref[TeXFOTBuilder], ls: LengthSpec) returns int
    {
        if ls.factor = 0.0
            return ls.length
        let f this.cur_format()
        let tem (f.cur_display_size as double) * ls.factor
        if tem >= 0.0
            return ls.length + ((tem + 0.5) as int)
        ls.length + ((tem - 0.5) as int)
    }

    ; --- characters ------------------------------------------------------------
    procedure add_headed_byte(mutable this: ref[TeXFOTBuilder], c: u8)
    {
        let top this.par_top()
        if top.is_headed
        {
            top.heading_text.put(c)
            return
        }
        let ph this.par_at(top.previous)
        ph.heading_text.put(c)
    }

    procedure characters(mutable this: ref[TeXFOTBuilder], s: Slice[u32])
    {
        var i: size_t 0
        while i < s.length
        {
            let c s[i]
            if c > 255
            {
                let b this.cur_os()
                TeXFOTBuilder.b_raw(b, "\\Character{")
                TeXFOTBuilder.b_udec(b, c as int)
                b.put(0x7D)
            }
            else if (c = 0x20) or (c = 0x09)
            {
                let b this.cur_os()
                ; symbolAsis = 34
                if this.next_format.lines_sym = 34
                    b.put(0x7E)
                else
                    b.put(c as u8)
                if this.in_heading
                    this.add_headed_byte(c as u8)
            }
            else if (c = 0x5C) or (c = 0x5E) or (c = 0x5F) or (c = 0x7E)
            {
                let b this.cur_os()
                TeXFOTBuilder.b_raw(b, "\\char")
                TeXFOTBuilder.b_udec(b, c as int)
                TeXFOTBuilder.b_raw(b, "{}")
                if this.in_heading
                    this.add_headed_byte(c as u8)
            }
            else if (c = 0x7B) or (c = 0x7D) or (c = 0x24) or (c = 0x26) or (c = 0x23) or (c = 0x25)
            {
                let b this.cur_os()
                b.put(0x5C)
                b.put(c as u8)
                if this.in_heading
                {
                    ; protectedChar_: "\<c>"
                    this.add_headed_byte(0x5C)
                    this.add_headed_byte(c as u8)
                }
            }
            else if c = 0x0D
            {
                let b this.cur_os()
                b.put(0x0A)
                if this.in_heading
                    this.add_headed_byte(0x0A)
            }
            else if c = 0x0A
            {
                ; dropped
            }
            else if (c = 0x2D) or (c = 0x3C) or (c = 0x3E)
            {
                let b this.cur_os()
                b.put(c as u8)
                if this.in_math = 0
                    TeXFOTBuilder.b_raw(b, "\\/")
            }
            else
            {
                let b this.cur_os()
                b.put(c as u8)
                if this.in_heading
                    this.add_headed_byte(c as u8)
            }
            set i: i + 1
        }
    }

    ; charactersFromNode — the reference emits \Entity{name} for a preserved
    ; single-char SDATA entity node; our grove carries no entity-name axis on
    ; data nodes (the documented SDATA=data-char gap, S78), so every call
    ; falls through to characters().
    procedure characters_from_node(mutable this: ref[TeXFOTBuilder], node: ref[GroveNode]?, s: Slice[u32])
        this.characters(s)

    ; formattingInstruction — raw pass-through
    procedure formatting_instruction(mutable this: ref[TeXFOTBuilder], instr: StringC)
    {
        let b this.cur_os()
        TeXFOTBuilder.b_stringc(b, instr)
    }

    ; --- node bracket ----------------------------------------------------------
    procedure start_node(mutable this: ref[TeXFOTBuilder], node: ref[GroveNode]?, mode_name: StringC)
    {
        if node <> null
        {
            let id node.get_id()
            if id.get_size() > 0
                this.set_stringc("Label", id)
            else
            {
                let ei node.element_index
                if ei >= 0
                {
                    this.def_open("Element")
                    let b this.sout
                    TeXFOTBuilder.b_udec(b, ei)
                    this.def_close()
                }
            }
        }
        this.set_grove_index(node)
        if mode_name.get_size() > 0
            this.set_stringc("ProcessingMode", mode_name)
        if this.enforcing_structure()
        {
            let st this.cur_state()
            this.group_start_out("Node", st.ni_prolog)
        }
        else
            this.group_start("Node")
    }

    procedure end_node(mutable this: ref[TeXFOTBuilder])
    {
        if this.enforcing_structure()
        {
            let st this.cur_state()
            st.ni_prolog.clear()
            let t this.cur_table()
            let open_el t.currently_open()
            let lc open_el.last_closed()
            if lc <> null
                this.group_end_out("Node", lc.ni_epilog)
        }
        else
            this.group_end("Node")
    }

    ; --- link ------------------------------------------------------------------
    procedure start_link(mutable this: ref[TeXFOTBuilder], nic: ref[LinkNIC])
    {
        ; TeXFOTBuilder::startLink switches over the FULL Address enum — the
        ; five unsupported types each get their own warning (TeXMessages.msg:7-12).
        ; `tei` and `html` are unreachable (no primitive of the reference
        ; produces them) but present for the same reason they are there.
        if nic.addr_type = ADDR_RESOLVED_NODE
        {
            let node nic.node
            if node <> null
            {
                let id node.get_id()
                if id.get_size() > 0
                    this.set_stringc("Label", id)
                else
                {
                    let ei node.element_index
                    if ei >= 0
                    {
                        this.def_open("Element")
                        let b this.sout
                        TeXFOTBuilder.b_udec(b, ei)
                        this.def_close()
                    }
                    else
                        this.msg_w("TeX backend does not currently support links to nodes other than elements")
                }
            }
        }
        else if nic.addr_type = ADDR_IDREF
        {
            ; `// just the first IDREF for now` is a comment on an
            ; intention, not on the code: the reference sets the label to
            ; the WHOLE params[0], spaces and all.
            this.set_stringc("Label", nic.p0)
        }
        else if nic.addr_type = ADDR_ENTITY
            this.msg_w("TeX backend does not currently support links to entities")
        else if nic.addr_type = ADDR_SGML_DOCUMENT
            this.msg_w("TeX backend does not currently support links to other SGML documents")
        else if nic.addr_type = ADDR_HYTIME_LINKEND
            this.msg_w("TeX backend does not currently support HyTime linkends")
        else if nic.addr_type = ADDR_TEI
            this.msg_w("TeX backend does not currently support TEI links")
        else if nic.addr_type = ADDR_HTML
            this.msg_w("TeX backend does not currently support HTML links")
        ; `if (addr.node) { g = groveIndex(); if (g) set("GroveIndex", g); }`
        let lnode nic.node
        if lnode <> null
            this.set_grove_index(lnode)
        this.group_start("Link")
    }

    procedure end_link(mutable this: ref[TeXFOTBuilder])
        this.group_end("Link")

    ; --- sequence --------------------------------------------------------------
    procedure start_sequence(mutable this: ref[TeXFOTBuilder])
    {
        this.fo_start()
        if this.enforcing_structure() = false
            this.group_start("Seq")
    }

    procedure end_sequence(mutable this: ref[TeXFOTBuilder])
    {
        if this.enforcing_structure() = false
            this.group_end("Seq")
        this.fo_end()
    }

    ; --- line field ------------------------------------------------------------
    procedure start_line_field(mutable this: ref[TeXFOTBuilder], nic: ref[LineFieldNIC])
    {
        this.fo_start()
        this.set_inline_nic(nic.break_before_priority, nic.break_after_priority)
        this.group_start("LineField")
    }

    procedure end_line_field(mutable this: ref[TeXFOTBuilder])
    {
        this.group_end("LineField")
        this.fo_end()
    }

    ; --- NIC renderers ----------------------------------------------------------
    procedure set_display_nic(mutable this: ref[TeXFOTBuilder], nic: ref[DisplayNIC])
    {
        var r: ref[DisplayNIC]? nic
        if r = null
            return
        this.set_display_space("sb", r.space_before)
        this.set_display_space("sa", r.space_after)
        if r.position_preference.code <> 0
            this.set_sym("PositionPreference", r.position_preference.code)
        if r.keep.code <> 0
            this.set_sym("Keep", r.keep.code)
        if r.break_before.code <> 0
            this.set_sym("BreakBefore", r.break_before.code)
        if r.break_after.code <> 0
            this.set_sym("BreakAfter", r.break_after.code)
        if r.keep_with_previous
            this.set_bool("KeepWithPrevious", true)
        if r.keep_with_next
            this.set_bool("KeepWithNext", true)
        if r.may_violate_keep_before
            this.set_bool("MayViolateKeepBefore", true)
        if r.may_violate_keep_after
            this.set_bool("MayViolateKeepAfter", true)
    }

    procedure set_inline_nic(mutable this: ref[TeXFOTBuilder], bbp: int, bap: int)
    {
        if bbp <> 0
            this.set_long("BreakBeforePriority", bbp)
        if bap <> 0
            this.set_long("BreakAfterPriority", bap)
    }

    ; --- paragraph (OUTLINES) ----------------------------------------------------
    procedure start_paragraph(mutable this: ref[TeXFOTBuilder], nic: ref[DisplayNIC]?)
    {
        this.fo_start()
        this.set_display_nic(nic as ref[DisplayNIC])
        if this.heading_set
        {
            this.group_start("HeadPar")
            set this.heading_set: false
            set this.in_heading: true
            let top this.par_top()
            set top.previous: this.last_headed
            set this.last_headed: this.par_depth - 1
        }
        else
        {
            this.group_start("Par")
            this.par_push(false, 0)
            let top this.par_top()
            set top.previous: this.last_headed
        }
    }

    procedure end_paragraph(mutable this: ref[TeXFOTBuilder])
    {
        let top this.par_top()
        if top.is_headed
        {
            let b this.cur_os()
            TeXFOTBuilder.b_raw(b, "\\def\\HeadingText{%\n")
            TeXFOTBuilder.b_buf(b, top.heading_text)
            TeXFOTBuilder.b_raw(b, "}%\n")
            this.group_end("HeadPar")
            set this.in_heading: false
        }
        else
            this.group_end("Par")
        set this.last_headed: top.previous
        this.par_pop()
        this.fo_end()
    }

    procedure paragraph_break(mutable this: ref[TeXFOTBuilder], nic: ref[DisplayNIC]?)
    {
        this.set_display_nic(nic as ref[DisplayNIC])
        this.insert_atomic("ParagraphBreak")
    }

    ; --- display group ------------------------------------------------------------
    procedure start_display_group(mutable this: ref[TeXFOTBuilder], nic: ref[DisplayNIC])
    {
        this.fo_start()
        this.set_display_nic(nic)
        if nic.has_coalesce_id
            this.set_stringc("CoalesceId", nic.coalesce_id)
        this.group_start("DisplayGroup")
    }

    procedure end_display_group(mutable this: ref[TeXFOTBuilder])
    {
        this.group_end("DisplayGroup")
        this.fo_end()
    }

    ; --- the INLINE/MARK family -------------------------------------------------
    ; setCharacterNIC (TeXFOTBuilder.cxx:4609, the live `#if 1` branch): under
    ; `valid` it dumps thirteen defs in THIS order — and BreakAfterPriority is
    ; not among them (only the disabled `#else` branch has it). StretchFactor
    ; follows through MAYBESET (omitted when it is 1.0).
    procedure set_character_nic(mutable this: ref[TeXFOTBuilder], nic: ref[CharacterNIC])
    {
        if nic.valid
        {
            this.set_long("Ch", nic.ch as int)
            this.set_glyph_id("GlyphId", nic.glyph_id)
            this.set_long("BreakBeforePriority", nic.break_before_priority)
            this.set_sym("MathClass", nic.math_class.code)
            this.set_sym("MathFontPosture", nic.math_font_posture.code)
            ; ★`stringout_ << … << nic.script+29 << …`: the backend strips the
            ; 29-byte prefix "ISO/IEC 10179::1996//Script::" off the script's
            ; public identifier by POINTER ARITHMETIC, so `\Script` carries the
            ; bare script name. A shorter (or null) id runs off the end in the
            ; reference; here it renders empty.
            this.def_open("Script")
            let b this.sout
            let n nic.script.get_size()
            var si: size_t 29
            while si < n
            {
                b.put((nic.script.get(si) & 0xFF) as u8)
                set si: si + 1
            }
            this.def_close()
            this.set_bool("IsDropAfterLineBreak", nic.is_drop_after_line_break)
            this.set_bool("IsDropUnlessBeforeLineBreak", nic.is_drop_unless_before_line_break)
            this.set_bool("IsPunct", nic.is_punct)
            this.set_bool("IsInputWhiteSpace", nic.is_input_whitespace)
            this.set_bool("IsInputTab", nic.is_input_tab)
            this.set_bool("IsRecordEnd", nic.is_record_end)
            this.set_bool("IsSpace", nic.is_space)
        }
        if nic.stretch_factor <> 1.0
            this.set_double("StretchFactor", nic.stretch_factor)
    }

    ; set(name, const GlyphId &) — the public id plus "::<suffix>" when the
    ; suffix is nonzero; an id-less glyph id renders an EMPTY value (no
    ; "false" here, unlike the fot dump).
    procedure set_glyph_id(mutable this: ref[TeXFOTBuilder], name: Slice[char], gid: ref[ELObj]?)
    {
        this.def_open(name)
        if gid <> null
        {
            let pubid gid.glyph_pubid()
            if pubid.get_size() <> 0
            {
                let b this.sout
                TeXFOTBuilder.b_stringc(b, pubid)
                let suffix gid.glyph_suffix()
                if suffix <> 0
                {
                    TeXFOTBuilder.b_raw(b, "::")
                    TeXFOTBuilder.b_long(b, suffix)
                }
            }
        }
        this.def_close()
    }

    ; TeXFOTBuilder::character — ★no start()/end() bracket at all (the class
    ; overrides the base, which would emit the character as text and push an
    ; atomic level): the defs, then `\Character{<code>}`.
    procedure character(mutable this: ref[TeXFOTBuilder], nic: ref[CharacterNIC])
    {
        this.set_character_nic(nic)
        this.dump_inherited()
        let b this.cur_os()
        TeXFOTBuilder.b_raw(b, "\\Character{")
        var ch 0
        set ch: nic.ch as int
        TeXFOTBuilder.b_long(b, ch)
        b.put(0x7D)
    }

    procedure alignment_point(mutable this: ref[TeXFOTBuilder])
        this.insert_atomic("AlignmentPoint")

    procedure start_sideline(mutable this: ref[TeXFOTBuilder])
    {
        this.fo_start()
        this.group_start("SideLine")
    }

    procedure end_sideline(mutable this: ref[TeXFOTBuilder])
    {
        this.group_end("SideLine")
        this.fo_end()
    }

    ; anchor / glyph-annotation / emphasizing-mark: NOT overridden by the
    ; reference TeX backend — the plain FOTBuilder brackets apply (atomic for
    ; the anchor, start/end for the other two; the emphasizing-mark's mark
    ; hooks are the SerialFOTBuilder defaults, which are start()/end() around
    ; the replayed mark and nothing for the "all" hook).
    procedure anchor(mutable this: ref[TeXFOTBuilder], nic: ref[AnchorNIC])
    {
        this.fo_start()
        this.fo_end()
    }

    procedure start_glyph_annotation(mutable this: ref[TeXFOTBuilder], nic: ref[GlyphAnnotationNIC])
        this.fo_start()

    procedure end_glyph_annotation(mutable this: ref[TeXFOTBuilder])
