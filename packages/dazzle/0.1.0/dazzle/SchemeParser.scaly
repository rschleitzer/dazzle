use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.Location.Location
use opensp.Location.InputSource
use opensp.Message.MessageType
use dazzle.ELObj.ELObj
use dazzle.ELObj.Identifier
use dazzle.ELObj.OutputCharStream
use dazzle.Expression.Expression
use dazzle.Expression.Environment
use dazzle.Insn.Insn
use dazzle.Insn.Signature
use dazzle.VM.VM
use dazzle.Interpreter.Interpreter
use dazzle.Interpreter.Unit
use dazzle.InterpreterMessages.InterpreterMessages
use dazzle.Grove.GroveNode
use dazzle.Grove.GroveBuilder

; SchemeParser — the DSSSL expression-language reader
; (style/SchemeParser.cxx; the C# mirror's lexer DIVERGES from the C++ —
; lexCategory-driven scanning, #b/#o/#x/#d radix tokens, #A glyph ids,
; keyword tokens with the colon already stripped — the C++ is the oracle).
;
; Inc-2 scope: the lexer (getToken and friends over the opensp InputSource
; token cursor) and the DATUM reader (parseDatum / parseSelfEvaluating /
; parseAbbreviation) plus the declaration-content parsers
; (parseStandardChars / parseNameChars / parseSeparatorChars /
; parseMapSdataEntity). The EXPRESSION half (parse()/parseTopLevel and the
; parse<Form> family building Expression trees) lands with Inc 3 — it
; shares this lexer unchanged.
;
; Line ends: SchemeParser reads OpenSP-normalized text (records end in RE =
; 0x0D); skipComment therefore stops at '\r', exactly like the reference.

; token-allow bits (SchemeParser.h; octal in the reference)
define ALLOW_END_OF_ENTITY: int 0x1
define ALLOW_FALSE: int 0x2
define ALLOW_KEYWORD: int 0x4
define ALLOW_OPEN_PAREN: int 0x8
define ALLOW_CLOSE_PAREN: int 0x10
define ALLOW_IDENTIFIER: int 0x20
define ALLOW_PERIOD: int 0x40
define ALLOW_OTHER_EXPR: int 0x80
define ALLOW_EXPRESSION_KEY: int 0x100
define ALLOW_KEY_DEFINE: int 0x200
define ALLOW_KEY_ELSE: int 0x400
define ALLOW_KEY_ARROW: int 0x800
define ALLOW_STRING: int 0x1000
define ALLOW_HASH_OPTIONAL: int 0x2000
define ALLOW_HASH_KEY: int 0x4000
define ALLOW_HASH_REST: int 0x8000
define ALLOW_UNQUOTE: int 0x10000
define ALLOW_UNQUOTE_SPLICING: int 0x20000
define ALLOW_QUASIQUOTE_KEY: int 0x40000
define ALLOW_VECTOR: int 0x80000
define ALLOW_HASH_CONTENTS: int 0x100000
; allowExpr = False|Keyword|OpenParen|Identifier|String|HashOptional
;           | HashKey|HashRest|OtherExpr
define ALLOW_EXPR: int 0xF0AE

; tokens (SchemeParser.h enum Token)
define TOKEN_END_OF_ENTITY: int 0
define TOKEN_TRUE: int 1
define TOKEN_FALSE: int 2
define TOKEN_STRING: int 3
define TOKEN_IDENTIFIER: int 4
define TOKEN_KEYWORD: int 5
define TOKEN_CHAR: int 6
define TOKEN_NUMBER: int 7
define TOKEN_GLYPH_ID: int 8
define TOKEN_OPEN_PAREN: int 9
define TOKEN_CLOSE_PAREN: int 10
define TOKEN_PERIOD: int 11
define TOKEN_VECTOR: int 12
define TOKEN_QUOTE: int 13
define TOKEN_QUASIQUOTE: int 14
define TOKEN_UNQUOTE: int 15
define TOKEN_UNQUOTE_SPLICING: int 16
define TOKEN_HASH_REST: int 17
define TOKEN_HASH_OPTIONAL: int 18
define TOKEN_HASH_KEY: int 19
define TOKEN_HASH_CONTENTS: int 20
define TOKEN_VOID: int 21

; every allow bit set (recovery / skipForm).
define ALLOW_ALL: int 0x1FFFFF

; parseFormals argument kinds.
define FORMAL_REQUIRED: int 0
define FORMAL_OPTIONAL: int 1
define FORMAL_REST: int 2
define FORMAL_KEY: int 3

define SchemeParser
(
    host: pointer[Page]
    interp: pointer[Interpreter]
    input: pointer[InputSource]
    current_token: StringC
    dsssl2: bool
)
{
    function make(host: pointer[Page], interp: pointer[Interpreter], input: pointer[InputSource]) returns pointer[SchemeParser]
    {
        let p host.allocate(sizeof SchemeParser, alignof SchemeParser) as pointer[SchemeParser]
        set p.host: host
        set p.interp: interp
        set p.input: input
        set p.current_token: StringC()
        set p.dsssl2: interp.is_dsssl2()
        p
    }

    ; --- helpers -----------------------------------------------------------
    ; currentToken_.assign(in->currentTokenStart() + from, len): a fresh copy
    ; on the run page (each token keeps its own buffer, so a StringObj built
    ; from a token survives later tokens — arena semantics).
    function set_token_slice(this: pointer[SchemeParser], from: size_t, len: size_t)
    {
        let host this.host
        let start this.input.current_token_start_index()
        let contents this.input.get_contents()
        set this.current_token: StringC^host(contents + (start + from), len)
    }

    function set_token_char(this: pointer[SchemeParser], c: u32)
    {
        let host this.host
        var buf u32[1]
        set *(buf as pointer[u32]): c
        set this.current_token: StringC^host(buf as pointer[u32], 1 as size_t)
    }

    function lex_cat(this: pointer[SchemeParser], c: i32) returns int
        this.interp.lex_category(c)

    ; the reference's initMessage: messages carry the current input location.
    function message0(this: pointer[SchemeParser], mt: MessageType)
    {
        this.interp.set_next_location(this.input.here_location())
        this.interp.message0(mt)
    }

    function message1(this: pointer[SchemeParser], mt: MessageType, a1: StringC)
    {
        this.interp.set_next_location(this.input.here_location())
        this.interp.message1(mt, a1)
    }

    ; --- the lexer ---------------------------------------------------------
    ; void extendToken(): extend to a delimiter.
    function extend_token(this: pointer[SchemeParser])
    {
        var length this.input.current_token_length()
        repeat
        {
            let c this.input.token_char()
            if this.lex_cat(c) > LEX_OTHER
                break
            set length: length + 1
        }
        this.input.end_token(length)
    }

    ; bool tokenRecover(unsigned allowed, Token &tok)
    function token_recover(this: pointer[SchemeParser], allowed: int, tok: pointer[int]) returns bool
    {
        if allowed = ALLOW_CLOSE_PAREN
        {
            this.input.unget_token()
            set *tok: TOKEN_CLOSE_PAREN
            this.message0(InterpreterMessages.missingCloseParen())
            return true
        }
        let tlen this.input.current_token_length()
        if tlen = (0 as size_t)
            this.message0(InterpreterMessages.unexpectedEof())
        else
        {
            this.set_token_slice(0 as size_t, tlen)
            this.message1(InterpreterMessages.unexpectedToken(), this.current_token)
        }
        false
    }

    ; bool handleNumber(unsigned allowed, Token &tok)
    function handle_number(this: pointer[SchemeParser], allowed: int, tok: pointer[int]) returns bool
    {
        if (allowed & ALLOW_OTHER_EXPR) = 0
            return this.token_recover(allowed, tok)
        set *tok: TOKEN_NUMBER
        let tlen this.input.current_token_length()
        this.set_token_slice(0 as size_t, tlen)
        true
    }

    ; bool handleIdentifier(unsigned allowed, Token &tok)
    function handle_identifier(this: pointer[SchemeParser], allowed: int, tok: pointer[int]) returns bool
    {
        if (allowed & ALLOW_IDENTIFIER) = 0
            return this.token_recover(allowed, tok)
        let tlen this.input.current_token_length()
        this.set_token_slice(0 as size_t, tlen)
        set *tok: TOKEN_IDENTIFIER
        true
    }

    ; void skipComment(): to end of entity or RE.
    function skip_comment(this: pointer[SchemeParser])
    {
        repeat
        {
            let c this.input.token_char()
            if (c < 0) or (c = 0x0D)
                break
        }
    }

    ; bool scanString(unsigned allowed, Token &tok)
    function scan_string(this: pointer[SchemeParser], allowed: int, tok: pointer[int]) returns bool
    {
        let host this.host
        let chars Array[u32]^host()
        repeat
        {
            var c this.input.token_char()
            if c < 0
            {
                this.message0(InterpreterMessages.unterminatedString())
                this.input.end_token(1 as size_t)
                return false
            }
            else if c = 0x22
            {
                set this.current_token: StringC^host(chars.get_buffer(), chars.get_length())
                set *tok: TOKEN_STRING
                return true
            }
            else if c = 0x5C
            {
                set c: this.input.token_char()
                if (c = 0x5C) or (c = 0x22)
                    chars.add(c as u32)
                else if c < 0
                {
                    ; end of entity mid-escape: the next iteration reports
                    ; the unterminated string
                }
                else
                {
                    ; named character escape \name; (terminator other than
                    ; ';' is pushed back)
                    let name_chars Array[u32]^host()
                    name_chars.add(c as u32)
                    var nc this.input.token_char()
                    while this.lex_cat(nc) < LEX_OTHER
                    {
                        name_chars.add(nc as u32)
                        set nc: this.input.token_char()
                    }
                    if nc <> 0x3B
                    {
                        let cur_len this.input.current_token_length()
                        this.input.end_token(cur_len - (1 as size_t))
                    }
                    let name StringC^host(name_chars.get_buffer(), name_chars.get_length())
                    var ch: u32 0
                    if (*this.interp).convert_char_name(name, &ch)
                        chars.add(ch)
                    else
                        this.message1(InterpreterMessages.unknownCharName(), name)
                }
            }
            else
                chars.add(c as u32)
        }
        false
    }

    ; bool getToken(unsigned allowed, Token &tok)
    function get_token(this: pointer[SchemeParser], allowed: int, tok: pointer[int]) returns bool
    {
        repeat
        {
            this.input.start_token()
            var c this.input.token_char()
            if c < 0
            {
                if (allowed & ALLOW_END_OF_ENTITY) = 0
                    return this.token_recover(allowed, tok)
                set *tok: TOKEN_END_OF_ENTITY
                return true
            }
            else if c = 0x28
            {
                if (allowed & ALLOW_OPEN_PAREN) = 0
                    return this.token_recover(allowed, tok)
                set *tok: TOKEN_OPEN_PAREN
                return true
            }
            else if c = 0x29
            {
                if (allowed & ALLOW_CLOSE_PAREN) = 0
                    return this.token_recover(allowed, tok)
                set *tok: TOKEN_CLOSE_PAREN
                return true
            }
            else if c = 0x27
            {
                if (allowed & ALLOW_OTHER_EXPR) = 0
                    return this.token_recover(allowed, tok)
                set *tok: TOKEN_QUOTE
                return true
            }
            else if c = 0x60
            {
                if (allowed & ALLOW_OTHER_EXPR) = 0
                    return this.token_recover(allowed, tok)
                set *tok: TOKEN_QUASIQUOTE
                return true
            }
            else if c = 0x2C
            {
                set c: this.input.token_char()
                if c = 0x40
                {
                    if (allowed & ALLOW_UNQUOTE_SPLICING) = 0
                        return this.token_recover(allowed, tok)
                    set *tok: TOKEN_UNQUOTE_SPLICING
                }
                else
                {
                    if (allowed & ALLOW_UNQUOTE) = 0
                        return this.token_recover(allowed, tok)
                    set *tok: TOKEN_UNQUOTE
                    this.input.end_token(1 as size_t)
                }
                return true
            }
            else if (c = 0x20) or (c = 0x0D) or (c = 0x0A) or (c = 0x09) or (c = 0x0C)
            {
                ; whitespace
            }
            else if c = 0x23
            {
                ; '#'
                set c: this.input.token_char()
                if (c = 0x74)
                {
                    ; #t
                    if (allowed & ALLOW_OTHER_EXPR) = 0
                        return this.token_recover(allowed, tok)
                    set *tok: TOKEN_TRUE
                    return true
                }
                else if c = 0x66
                {
                    ; #f
                    if (allowed & ALLOW_FALSE) = 0
                        return this.token_recover(allowed, tok)
                    set *tok: TOKEN_FALSE
                    return true
                }
                else if c = 0x5C
                {
                    ; #\ character literal
                    set c: this.input.token_char()
                    if c < 0
                    {
                        this.message0(InterpreterMessages.unexpectedEof())
                        if (allowed & ALLOW_END_OF_ENTITY) <> 0
                        {
                            set *tok: TOKEN_END_OF_ENTITY
                            return true
                        }
                        return false
                    }
                    if (allowed & ALLOW_OTHER_EXPR) = 0
                    {
                        this.extend_token()
                        return this.token_recover(allowed, tok)
                    }
                    this.input.discard_initial()
                    this.extend_token()
                    set *tok: TOKEN_CHAR
                    if this.input.current_token_length() = (1 as size_t)
                        this.set_token_slice(0 as size_t, 1 as size_t)
                    else
                    {
                        let host this.host
                        let start this.input.current_token_start_index()
                        let contents this.input.get_contents()
                        let tlen this.input.current_token_length()
                        let name StringC^host(contents + start, tlen)
                        var ch: u32 DEFAULT_CHAR as u32
                        if (*this.interp).convert_char_name(name, &ch) = false
                        {
                            this.message1(InterpreterMessages.unknownCharName(), name)
                            set ch: DEFAULT_CHAR as u32
                        }
                        this.set_token_char(ch)
                    }
                    return true
                }
                else if c = 0x21
                {
                    ; #!named-constant
                    this.extend_token()
                    let host this.host
                    let start this.input.current_token_start_index()
                    let contents this.input.get_contents()
                    let tlen this.input.current_token_length()
                    let tem StringC^host(contents + (start + (2 as size_t)), tlen - (2 as size_t))
                    if tem.equals(StringC("optional"))
                    {
                        if (allowed & ALLOW_HASH_OPTIONAL) = 0
                            return this.token_recover(allowed, tok)
                        set *tok: TOKEN_HASH_OPTIONAL
                        return true
                    }
                    if tem.equals(StringC("key"))
                    {
                        if (allowed & ALLOW_HASH_KEY) = 0
                            return this.token_recover(allowed, tok)
                        set *tok: TOKEN_HASH_KEY
                        return true
                    }
                    if tem.equals(StringC("rest"))
                    {
                        if (allowed & ALLOW_HASH_REST) = 0
                            return this.token_recover(allowed, tok)
                        set *tok: TOKEN_HASH_REST
                        return true
                    }
                    if tem.equals(StringC("contents"))
                    {
                        if (allowed & ALLOW_HASH_CONTENTS) = 0
                            return this.token_recover(allowed, tok)
                        set *tok: TOKEN_HASH_CONTENTS
                        return true
                    }
                    this.message1(InterpreterMessages.unknownNamedConstant(), tem)
                }
                else if (c = 0x62) or (c = 0x6F) or (c = 0x78) or (c = 0x64)
                {
                    ; #b #o #x #d radix-prefixed number
                    this.extend_token()
                    if (allowed & ALLOW_OTHER_EXPR) = 0
                        return this.token_recover(allowed, tok)
                    set *tok: TOKEN_NUMBER
                    this.set_token_slice(0 as size_t, this.input.current_token_length())
                    return true
                }
                else if c = 0x41
                {
                    ; #A glyph id
                    this.extend_token()
                    if (allowed & ALLOW_OTHER_EXPR) = 0
                        return this.token_recover(allowed, tok)
                    set *tok: TOKEN_GLYPH_ID
                    this.set_token_slice(2 as size_t, this.input.current_token_length() - (2 as size_t))
                    return true
                }
                else if c < 0
                {
                    this.message0(InterpreterMessages.unexpectedEof())
                    if (allowed & ALLOW_END_OF_ENTITY) <> 0
                    {
                        set *tok: TOKEN_END_OF_ENTITY
                        return true
                    }
                    return false
                }
                else if (c = 0x76) and this.dsssl2
                {
                    ; #v (dsssl2)
                    if (allowed & ALLOW_OTHER_EXPR) = 0
                        return this.token_recover(allowed, tok)
                    set *tok: TOKEN_VOID
                    return true
                }
                else if (c = 0x28) and this.dsssl2
                {
                    ; #( vector (dsssl2)
                    if (allowed & ALLOW_VECTOR) = 0
                        return this.token_recover(allowed, tok)
                    set *tok: TOKEN_VECTOR
                    return true
                }
                else
                    this.message0(InterpreterMessages.unknownHash())
            }
            else if c = 0x22
            {
                if (allowed & ALLOW_STRING) = 0
                    return this.token_recover(allowed, tok)
                return this.scan_string(allowed, tok)
            }
            else if c = 0x3B
                this.skip_comment()
            else if c = 0x2E
            {
                ; '.' — period, "..." identifier, or number
                this.extend_token()
                let len this.input.current_token_length()
                if len = (1 as size_t)
                {
                    if (allowed & ALLOW_PERIOD) = 0
                        return this.token_recover(allowed, tok)
                    set *tok: TOKEN_PERIOD
                    return true
                }
                if len = (3 as size_t)
                {
                    let start this.input.current_token_start_index()
                    let contents this.input.get_contents()
                    if (*(contents + (start + (1 as size_t))) = (0x2E as u32)) and (*(contents + (start + (2 as size_t))) = (0x2E as u32))
                        return this.handle_identifier(allowed, tok)
                }
                return this.handle_number(allowed, tok)
            }
            else
            {
                let cat this.lex_cat(c)
                if cat = LEX_ADD_WHITESPACE
                {
                    ; declared separator char: whitespace
                }
                else if cat = LEX_OTHER_NUMBER_START
                {
                    this.extend_token()
                    ; a lone + or - is an identifier
                    if this.input.current_token_length() = (1 as size_t)
                        return this.handle_identifier(allowed, tok)
                    return this.handle_number(allowed, tok)
                }
                else if cat = LEX_DIGIT
                {
                    this.extend_token()
                    return this.handle_number(allowed, tok)
                }
                else
                {
                    var invalid false
                    var do_name true
                    if cat = LEX_OTHER
                    {
                        if c < 0x20
                        {
                            ; ignore control characters
                            this.message0(InterpreterMessages.invalidChar())
                            set do_name: false
                        }
                        else
                            this.input.unget_token()
                    }
                    if do_name
                    {
                        ; name scan (letters, other name starts, declared
                        ; name chars; lexOther chars join with a diagnostic)
                        var length this.input.current_token_length()
                        repeat
                        {
                            let nc this.input.token_char()
                            let lc this.lex_cat(nc)
                            if lc > LEX_OTHER
                                break
                            if lc = LEX_OTHER
                                set invalid: true
                            set length: length + 1
                        }
                        this.input.end_token(length)

                        let tlen this.input.current_token_length()
                        let start this.input.current_token_start_index()
                        let contents this.input.get_contents()
                        var is_keyword false
                        if tlen > (1 as size_t)
                        {
                            if *(contents + ((start + tlen) - (1 as size_t))) = (0x3A as u32)
                                set is_keyword: true
                        }
                        if is_keyword
                        {
                            if (allowed & ALLOW_KEYWORD) = 0
                                return this.token_recover(allowed, tok)
                            this.set_token_slice(0 as size_t, tlen - (1 as size_t))
                            set *tok: TOKEN_KEYWORD
                            var double_colon false
                            if this.current_token.get_size() > (1 as size_t)
                            {
                                if this.current_token.get(this.current_token.get_size() - (1 as size_t)) = (0x3A as u32)
                                    set double_colon: true
                            }
                            if invalid or double_colon
                                this.message1(InterpreterMessages.invalidIdentifier(), this.current_token)
                            return true
                        }
                        if invalid
                        {
                            this.set_token_slice(0 as size_t, tlen)
                            this.message1(InterpreterMessages.invalidIdentifier(), this.current_token)
                        }
                        return this.handle_identifier(allowed, tok)
                    }
                }
            }
        }
        false
    }

    ; --- the datum reader --------------------------------------------------
    ; ELObj *convertAfiiGlyphId(const StringC &): #Annnn -> GlyphIdObj (null
    ; on a malformed suffix, exactly the reference).
    function convert_afii_glyph_id(this: pointer[SchemeParser], str: StringC) returns pointer[ELObj]
    {
        var n 0
        var i: size_t 0
        while i < str.get_size()
        {
            let c str.get(i)
            if (c < (0x30 as u32)) or (c > (0x39 as u32))
            {
                set n: 0
                break
            }
            set n: n * 10 + ((c - (0x30 as u32)) as int)
            set i: i + 1
        }
        if n = 0
        {
            this.message1(InterpreterMessages.invalidAfiiGlyphId(), str)
            return null
        }
        let interp this.interp
        ELObj.make_glyph_id(interp.get_host(), StringC("ISO/IEC 10036/RA//Glyphs"), n)
    }

    ; bool parseSelfEvaluating(unsigned otherAllowed, ELObj *&result, Token &tok)
    function parse_self_evaluating(this: pointer[SchemeParser], other_allowed: int, result: pointer[pointer[ELObj]], tok: pointer[int]) returns bool
    {
        set *result: null
        if this.get_token(ALLOW_EXPR | other_allowed, tok) = false
            return false
        let interp this.interp
        let t *tok
        if t = TOKEN_TRUE
            set *result: interp.make_true()
        else if t = TOKEN_FALSE
            set *result: interp.make_false()
        else if t = TOKEN_VOID
            set *result: interp.make_unspecified()
        else if t = TOKEN_STRING
            set *result: ELObj.make_string(interp.get_host(), this.current_token)
        else if t = TOKEN_KEYWORD
            set *result: interp.make_keyword(this.current_token)
        else if t = TOKEN_CHAR
            set *result: ELObj.make_char(interp.get_host(), this.current_token.get(0 as size_t))
        else if t = TOKEN_NUMBER
        {
            let v interp.convert_number(this.current_token)
            if v = null
            {
                this.message1(InterpreterMessages.invalidNumber(), this.current_token)
                set *result: interp.make_error()
            }
            else
                set *result: v
        }
        else if t = TOKEN_GLYPH_ID
            set *result: this.convert_afii_glyph_id(this.current_token)
        true
    }

    ; bool parseAbbreviation(const char *sym, ELObj *&result): 'x -> (quote x)
    function parse_abbreviation(this: pointer[SchemeParser], sym: pointer[const_char], result: pointer[pointer[ELObj]]) returns bool
    {
        let interp this.interp
        let quote_sym interp.make_symbol(StringC(sym))
        var obj: pointer[ELObj] null
        var ignore_loc Location()
        var tok TOKEN_END_OF_ENTITY
        if this.parse_datum(0, &obj, &ignore_loc, &tok) = false
            return false
        let hostp interp.get_host()
        let tail ELObj.make_pair(hostp, obj, interp.make_nil())
        set *result: ELObj.make_pair(hostp, quote_sym, tail)
        true
    }

    ; bool parseDatum(unsigned otherAllowed, ELObj *&result, Location &loc, Token &tok)
    function parse_datum(this: pointer[SchemeParser], other_allowed: int, result: pointer[pointer[ELObj]], loc: pointer[Location], tok: pointer[int]) returns bool
    {
        if this.parse_self_evaluating(other_allowed | ALLOW_VECTOR | ALLOW_UNQUOTE | ALLOW_UNQUOTE_SPLICING, result, tok) = false
            return false
        let loc_org this.input.get_origin()
        let loc_idx this.input.get_cur_index()
        set *loc: Location(loc_org, loc_idx as u32)
        if *result <> null
            return true
        let interp this.interp
        let t *tok
        if t = TOKEN_IDENTIFIER
            set *result: interp.make_symbol(this.current_token)
        else if t = TOKEN_QUOTE
            return this.parse_abbreviation("quote", result)
        else if t = TOKEN_QUASIQUOTE
            return this.parse_abbreviation("quasiquote", result)
        else if t = TOKEN_UNQUOTE
            return this.parse_abbreviation("unquote", result)
        else if t = TOKEN_UNQUOTE_SPLICING
            return this.parse_abbreviation("unquote-splicing", result)
        else if t = TOKEN_OPEN_PAREN
        {
            var tem: pointer[ELObj] null
            var ignore_loc Location()
            if this.parse_datum(ALLOW_CLOSE_PAREN, &tem, &ignore_loc, tok) = false
                return false
            if tem = null
                set *result: interp.make_nil()
            else
            {
                let hostp interp.get_host()
                let list ELObj.make_pair(hostp, tem, null)
                var last list
                var done false
                while done = false
                {
                    if this.parse_datum(ALLOW_CLOSE_PAREN | ALLOW_PERIOD, &tem, &ignore_loc, tok) = false
                        return false
                    if tem = null
                    {
                        if *tok = TOKEN_CLOSE_PAREN
                        {
                            last.set_cdr(interp.make_nil())
                            set done: true
                        }
                        else
                        {
                            ; improper list: '.' cdr ')'
                            if this.parse_datum(0, &tem, &ignore_loc, tok) = false
                                return false
                            last.set_cdr(tem)
                            if this.get_token(ALLOW_CLOSE_PAREN, tok) = false
                                return false
                            set done: true
                        }
                    }
                    else
                    {
                        let p ELObj.make_pair(hostp, tem, null)
                        last.set_cdr(p)
                        set last: p
                    }
                }
                set *result: list
            }
        }
        else if t = TOKEN_VECTOR
        {
            let hostv this.host
            let elems Array[pointer[ELObj]]^hostv()
            var ignore_loc Location()
            var done false
            while done = false
            {
                var tem: pointer[ELObj] null
                if this.parse_datum(ALLOW_CLOSE_PAREN, &tem, &ignore_loc, tok) = false
                    return false
                if tem = null
                    set done: true
                else
                    elems.add(tem)
            }
            set *result: ELObj.make_vector_of(interp.get_host(), elems.get_buffer(), elems.get_length())
        }
        true
    }

    ; --- declaration-content parsers (style-specification declarations) ----
    ; void parseStandardChars()
    function parse_standard_chars(this: pointer[SchemeParser])
    {
        repeat
        {
            var tok TOKEN_END_OF_ENTITY
            if this.get_token(ALLOW_IDENTIFIER | ALLOW_END_OF_ENTITY, &tok) = false
                break
            if tok = TOKEN_END_OF_ENTITY
                break

            let name this.current_token

            if this.get_token(ALLOW_OTHER_EXPR, &tok) = false
            {
                this.message0(InterpreterMessages.badDeclaration())
                break
            }
            if tok <> TOKEN_NUMBER
            {
                this.message0(InterpreterMessages.badDeclaration())
                break
            }

            ; the name must be letters (digits, '-', '.' after the first)
            var i: size_t 0
            var ok true
            while i < name.get_size()
            {
                let cat this.lex_cat(name.get(i) as i32)
                if cat <> LEX_LETTER
                {
                    var tail_ok false
                    if i > (0 as size_t)
                    {
                        if (cat = LEX_DIGIT) or (name.get(i) = (0x2D as u32)) or (name.get(i) = (0x2E as u32))
                            set tail_ok: true
                    }
                    if tail_ok = false
                    {
                        set ok: false
                        break
                    }
                }
                set i: i + 1
            }
            if (ok = false) or (name.get_size() = (1 as size_t))
            {
                this.message1(InterpreterMessages.invalidCharName(), name)
                continue
            }

            ; the number must be all digits
            var j: size_t 0
            var num_ok true
            while j < this.current_token.get_size()
            {
                if this.lex_cat(this.current_token.get(j) as i32) <> LEX_DIGIT
                {
                    set num_ok: false
                    break
                }
                set j: j + 1
            }
            if num_ok = false
            {
                this.message1(InterpreterMessages.invalidCharNumber(), this.current_token)
                continue
            }

            this.interp.add_standard_char(name, this.current_token)
        }
    }

    ; void parseNameChars()
    function parse_name_chars(this: pointer[SchemeParser])
    {
        repeat
        {
            var tok TOKEN_END_OF_ENTITY
            if this.get_token(ALLOW_IDENTIFIER | ALLOW_END_OF_ENTITY, &tok) = false
                break
            if tok = TOKEN_END_OF_ENTITY
                break
            this.interp.add_name_char(this.current_token)
        }
    }

    ; void parseSeparatorChars()
    function parse_separator_chars(this: pointer[SchemeParser])
    {
        repeat
        {
            var tok TOKEN_END_OF_ENTITY
            if this.get_token(ALLOW_IDENTIFIER | ALLOW_END_OF_ENTITY, &tok) = false
                break
            if tok = TOKEN_END_OF_ENTITY
                break
            this.interp.add_separator_char(this.current_token)
        }
    }

    ; void parseMapSdataEntity(const StringC &ename, const StringC &etext)
    function parse_map_sdata_entity(this: pointer[SchemeParser], ename: StringC, etext: StringC)
    {
        var tok TOKEN_END_OF_ENTITY
        if this.get_token(ALLOW_IDENTIFIER | ALLOW_END_OF_ENTITY, &tok) = false
        {
            this.message0(InterpreterMessages.badDeclaration())
            return
        }
        if tok = TOKEN_END_OF_ENTITY
        {
            this.message0(InterpreterMessages.badDeclaration())
            return
        }
        this.interp.add_sdata_entity(ename, etext, this.current_token)
    }

    ; ======================================================================
    ; Inc 3 — the EXPRESSION reader (SchemeParser.cxx parseExpression family).
    ; Builds Expression trees the Interpreter compiles + runs. Shares the Inc-2
    ; lexer unchanged. make / style / with-mode / the query forms (there-exists?
    ; ...) and quasiquote route to later increments; the pure-eval forms are
    ; here (if/cond/case/and/or/let/let*/letrec/lambda/begin/set!/quote + define).
    ; ======================================================================

    function cur_loc(this: SchemeParser) returns Location
        Location(this.input.get_origin(), this.input.get_cur_index() as u32)

    function expect_close_paren(this: pointer[SchemeParser]) returns bool
    {
        var tok TOKEN_END_OF_ENTITY
        this.get_token(ALLOW_CLOSE_PAREN, &tok)
    }

    ; bool parseExpression(out expr) — the public entry.
    function parse_expression(this: pointer[SchemeParser], result: pointer[pointer[Expression]]) returns bool
    {
        var key SK_NOTKEY
        var tok TOKEN_END_OF_ENTITY
        this.parse_expr_full(ALLOW_EXPR, result, &key, &tok)
    }

    ; bool parseExpression(allowed, out expr, out key, out tok).
    function parse_expr_full(this: pointer[SchemeParser], allowed: int, result: pointer[pointer[Expression]], key: pointer[int], tok: pointer[int]) returns bool
    {
        set *result: null
        set *key: SK_NOTKEY
        set *tok: TOKEN_END_OF_ENTITY
        if this.get_token(allowed, tok) = false
            return false
        let interp this.interp
        let hp this.host
        let t *tok
        if t = TOKEN_IDENTIFIER
        {
            let ident interp.lookup(this.current_token)
            set *key: ident.syntactic_key()
            set *result: Expression.make_variable(hp, ident, this.cur_loc())
            return true
        }
        if t = TOKEN_NUMBER
        {
            let val interp.convert_number(this.current_token)
            if val = null
            {
                this.message1(InterpreterMessages.invalidNumber(), this.current_token)
                return false
            }
            set *result: Expression.make_constant(hp, val, this.cur_loc())
            return true
        }
        if t = TOKEN_STRING
        {
            set *result: Expression.make_constant(hp, ELObj.make_string(interp.get_host(), this.current_token), this.cur_loc())
            return true
        }
        if t = TOKEN_TRUE
        {
            set *result: Expression.make_constant(hp, interp.make_true(), this.cur_loc())
            return true
        }
        if t = TOKEN_FALSE
        {
            set *result: Expression.make_constant(hp, interp.make_false(), this.cur_loc())
            return true
        }
        if t = TOKEN_OPEN_PAREN
            return this.parse_call(result)
        if t = TOKEN_QUOTE
            return this.parse_quoted_datum(result)
        if t = TOKEN_QUASIQUOTE
        {
            var splc false
            return this.parse_quasiquote_template(0, 0, result, key, tok, &splc)
        }
        if t = TOKEN_CHAR
        {
            var ch: u32 0
            if this.current_token.get_size() > (0 as size_t)
                set ch: this.current_token.get(0 as size_t)
            set *result: Expression.make_constant(hp, ELObj.make_char(interp.get_host(), ch), this.cur_loc())
            return true
        }
        ; CloseParen / Keyword: expr stays null, tok carries the signal.
        if t = TOKEN_CLOSE_PAREN
            return true
        if t = TOKEN_KEYWORD
            return true
        false
    }

    ; bool parseCall(out expr) — the open paren has been consumed.
    function parse_call(this: pointer[SchemeParser], result: pointer[pointer[Expression]]) returns bool
    {
        set *result: null
        let interp this.interp
        let hp this.host
        var tok TOKEN_END_OF_ENTITY
        if this.get_token(ALLOW_IDENTIFIER | ALLOW_OPEN_PAREN | ALLOW_CLOSE_PAREN, &tok) = false
            return false
        if tok = TOKEN_CLOSE_PAREN
        {
            set *result: Expression.make_constant(hp, interp.make_nil(), this.cur_loc())
            return true
        }
        if tok = TOKEN_IDENTIFIER
        {
            let ident interp.lookup(this.current_token)
            let sk ident.syntactic_key()
            if sk = SK_QUOTE
                return this.parse_quote(result)
            if sk = SK_IF
                return this.parse_if(result)
            if sk = SK_COND
                return this.parse_cond(result)
            if sk = SK_CASE
                return this.parse_case(result)
            if sk = SK_AND
                return this.parse_and(result)
            if sk = SK_OR
                return this.parse_or(result)
            if sk = SK_LET
                return this.parse_let(result)
            if sk = SK_LET_STAR
                return this.parse_let_star(result)
            if sk = SK_LETREC
                return this.parse_letrec(result)
            if sk = SK_LAMBDA
                return this.parse_lambda(result)
            if sk = SK_BEGIN
                return this.parse_begin(result)
            if sk = SK_SET
                return this.parse_set(result)
            if sk = SK_QUASIQUOTE
                return this.parse_quasiquote(result)
            ; make / style / with-mode / query forms are later increments; for
            ; now they resolve as an ordinary call on the identifier.
            return this.parse_regular_call(ident, result)
        }
        ; operator is itself a parenthesized call: (( ... ) args...)
        var func_expr: pointer[Expression] null
        if this.parse_call(&func_expr) = false
            return false
        this.parse_call_args(func_expr, result)
    }

    function parse_regular_call(this: pointer[SchemeParser], func: pointer[Identifier], result: pointer[pointer[Expression]]) returns bool
    {
        set *result: null
        let hp this.host
        let loc this.cur_loc()
        let args Array[pointer[Expression]]^hp()
        repeat
        {
            var key SK_NOTKEY
            var tok TOKEN_END_OF_ENTITY
            var arg: pointer[Expression] null
            if this.parse_expr_full(ALLOW_EXPR | ALLOW_CLOSE_PAREN, &arg, &key, &tok) = false
                return false
            if tok = TOKEN_CLOSE_PAREN
                break
            if arg <> null
                args.add(arg)
        }
        let op Expression.make_variable(hp, func, loc)
        set *result: Expression.make_call(hp, op, args, loc)
        true
    }

    function parse_call_args(this: pointer[SchemeParser], func: pointer[Expression], result: pointer[pointer[Expression]]) returns bool
    {
        set *result: null
        if func = null
            return false
        let hp this.host
        let loc this.cur_loc()
        let args Array[pointer[Expression]]^hp()
        repeat
        {
            var key SK_NOTKEY
            var tok TOKEN_END_OF_ENTITY
            var arg: pointer[Expression] null
            if this.parse_expr_full(ALLOW_EXPR | ALLOW_CLOSE_PAREN, &arg, &key, &tok) = false
                return false
            if tok = TOKEN_CLOSE_PAREN
                break
            if arg <> null
                args.add(arg)
        }
        set *result: Expression.make_call(hp, func, args, loc)
        true
    }

    function parse_if(this: pointer[SchemeParser], result: pointer[pointer[Expression]]) returns bool
    {
        set *result: null
        let hp this.host
        let loc this.cur_loc()
        var test_e: pointer[Expression] null
        var conseq: pointer[Expression] null
        var alt: pointer[Expression] null
        var key SK_NOTKEY
        var tok TOKEN_END_OF_ENTITY
        if this.parse_expr_full(ALLOW_EXPR, &test_e, &key, &tok) = false
            return false
        if this.parse_expr_full(ALLOW_EXPR, &conseq, &key, &tok) = false
            return false
        this.parse_expr_full(ALLOW_EXPR | ALLOW_CLOSE_PAREN, &alt, &key, &tok)
        if tok <> TOKEN_CLOSE_PAREN
        {
            if this.expect_close_paren() = false
                return false
        }
        set *result: Expression.make_if(hp, test_e, conseq, alt, loc)
        true
    }

    ; collect a body's expressions until the close paren (parseBegin).
    function parse_begin(this: pointer[SchemeParser], result: pointer[pointer[Expression]]) returns bool
    {
        set *result: null
        let hp this.host
        let loc this.cur_loc()
        let exprs Array[pointer[Expression]]^hp()
        repeat
        {
            var key SK_NOTKEY
            var tok TOKEN_END_OF_ENTITY
            var e: pointer[Expression] null
            if this.parse_expr_full(ALLOW_EXPR | ALLOW_CLOSE_PAREN, &e, &key, &tok) = false
                return false
            if tok = TOKEN_CLOSE_PAREN
                break
            if e <> null
                exprs.add(e)
        }
        set *result: this.collapse_body(exprs, loc)
        true
    }

    ; an expression sequence -> unspecified / the single expr / a Sequence.
    function collapse_body(this: pointer[SchemeParser], exprs: pointer[Array[pointer[Expression]]], loc: Location) returns pointer[Expression]
    {
        let hp this.host
        let n exprs.get_length() as int
        if n = 0
            return Expression.make_constant(hp, this.interp.make_unspecified(), loc)
        if n = 1
            return *(exprs.get_buffer())
        Expression.make_sequence(hp, exprs, loc)
    }

    function parse_and(this: pointer[SchemeParser], result: pointer[pointer[Expression]]) returns bool
    {
        set *result: null
        let hp this.host
        let loc this.cur_loc()
        let exprs Array[pointer[Expression]]^hp()
        repeat
        {
            var key SK_NOTKEY
            var tok TOKEN_END_OF_ENTITY
            var e: pointer[Expression] null
            if this.parse_expr_full(ALLOW_EXPR | ALLOW_CLOSE_PAREN, &e, &key, &tok) = false
                return false
            if tok = TOKEN_CLOSE_PAREN
                break
            if e <> null
                exprs.add(e)
        }
        let n exprs.get_length() as int
        if n = 0
            set *result: Expression.make_constant(hp, this.interp.make_true(), loc)
        else if n = 1
            set *result: *(exprs.get_buffer())
        else
        {
            let b exprs.get_buffer()
            var acc *(b + (n - 1))
            var i n - 2
            while i >= 0
            {
                set acc: Expression.make_and(hp, *(b + i), acc, loc)
                set i: i - 1
            }
            set *result: acc
        }
        true
    }

    function parse_or(this: pointer[SchemeParser], result: pointer[pointer[Expression]]) returns bool
    {
        set *result: null
        let hp this.host
        let loc this.cur_loc()
        let exprs Array[pointer[Expression]]^hp()
        repeat
        {
            var key SK_NOTKEY
            var tok TOKEN_END_OF_ENTITY
            var e: pointer[Expression] null
            if this.parse_expr_full(ALLOW_EXPR | ALLOW_CLOSE_PAREN, &e, &key, &tok) = false
                return false
            if tok = TOKEN_CLOSE_PAREN
                break
            if e <> null
                exprs.add(e)
        }
        let n exprs.get_length() as int
        if n = 0
            set *result: Expression.make_constant(hp, this.interp.make_false(), loc)
        else if n = 1
            set *result: *(exprs.get_buffer())
        else
        {
            let b exprs.get_buffer()
            var acc *(b + (n - 1))
            var i n - 2
            while i >= 0
            {
                set acc: Expression.make_or(hp, *(b + i), acc, loc)
                set i: i - 1
            }
            set *result: acc
        }
        true
    }

    function parse_set(this: pointer[SchemeParser], result: pointer[pointer[Expression]]) returns bool
    {
        set *result: null
        let hp this.host
        let loc this.cur_loc()
        var tok TOKEN_END_OF_ENTITY
        if this.get_token(ALLOW_IDENTIFIER, &tok) = false
            return false
        let var_ident this.interp.lookup(this.current_token)
        var value: pointer[Expression] null
        var key SK_NOTKEY
        if this.parse_expr_full(ALLOW_EXPR, &value, &key, &tok) = false
            return false
        if this.expect_close_paren() = false
            return false
        set *result: Expression.make_assignment(hp, var_ident, value, loc)
        true
    }

    function parse_quote(this: pointer[SchemeParser], result: pointer[pointer[Expression]]) returns bool
    {
        set *result: null
        var datum: pointer[ELObj] null
        var loc Location()
        var tok TOKEN_END_OF_ENTITY
        if this.parse_datum(ALLOW_EXPR, &datum, &loc, &tok) = false
            return false
        if this.expect_close_paren() = false
            return false
        set *result: Expression.make_constant(this.host, datum, loc)
        true
    }

    function parse_quoted_datum(this: pointer[SchemeParser], result: pointer[pointer[Expression]]) returns bool
    {
        set *result: null
        var datum: pointer[ELObj] null
        var loc Location()
        var tok TOKEN_END_OF_ENTITY
        if this.parse_datum(ALLOW_EXPR, &datum, &loc, &tok) = false
            return false
        set *result: Expression.make_constant(this.host, datum, loc)
        true
    }

    ; ======================================================================
    ; quasiquote (SchemeParser.cxx parseQuasiquote / parseQuasiquoteTemplate).
    ; The eval side (QuasiquoteExpr / compile_quasiquote) is already in place;
    ; this builds the QuasiquoteExpr tree from `x / ,x / ,@x / nested levels.
    ; ======================================================================

    ; (quasiquote X) form — template then the closing paren.
    function parse_quasiquote(this: pointer[SchemeParser], result: pointer[pointer[Expression]]) returns bool
    {
        set *result: null
        var key SK_NOTKEY
        var tok TOKEN_END_OF_ENTITY
        var splc false
        if this.parse_quasiquote_template(0, 0, result, &key, &tok, &splc) = false
            return false
        this.expect_close_paren()
    }

    ; createQuasiquoteAbbreviation: wrap `inner` as (sym inner), a listType QQ.
    function create_quasiquote_abbrev(this: pointer[SchemeParser], sym: pointer[const_char], inner: pointer[Expression]) returns pointer[Expression]
    {
        let hp this.host
        let interp this.interp
        var loc this.cur_loc()
        if inner <> null
            set loc: inner.location()
        let members Array[pointer[Expression]]^hp()
        let sym_obj interp.make_symbol(StringC(sym))
        members.add(Expression.make_constant(hp, sym_obj, loc))
        members.add(inner)
        let spliced Array[bool]^hp()
        spliced.add(false)
        spliced.add(false)
        Expression.make_quasiquote(hp, members, spliced, QQ_LIST, loc)
    }

    ; bool parseQuasiquoteTemplate(level, allowed, expr, key, tok, spliced).
    function parse_quasiquote_template(this: pointer[SchemeParser], level: int, allowed: int, result: pointer[pointer[Expression]], key: pointer[int], tok: pointer[int], spliced: pointer[bool]) returns bool
    {
        set *key: SK_NOTKEY
        set *spliced: false
        let interp this.interp
        let hp this.host
        var obj: pointer[ELObj] null
        if this.parse_self_evaluating(allowed | ALLOW_UNQUOTE | ALLOW_VECTOR, &obj, tok) = false
            return false
        if obj <> null
        {
            set *result: Expression.make_constant(hp, obj, this.cur_loc())
            return true
        }
        let t *tok
        if t = TOKEN_QUASIQUOTE
        {
            var inner: pointer[Expression] null
            var sk SK_NOTKEY
            var st TOKEN_END_OF_ENTITY
            var ss false
            if this.parse_quasiquote_template(level + 1, 0, &inner, &sk, &st, &ss) = false
                return false
            set *result: this.create_quasiquote_abbrev("quasiquote", inner)
            return true
        }
        if t = TOKEN_QUOTE
        {
            var inner: pointer[Expression] null
            var sk SK_NOTKEY
            var st TOKEN_END_OF_ENTITY
            var ss false
            if this.parse_quasiquote_template(level, 0, &inner, &sk, &st, &ss)
                set *result: this.create_quasiquote_abbrev("quote", inner)
            else
                set *result: inner
            return true
        }
        if (t = TOKEN_UNQUOTE) or (t = TOKEN_UNQUOTE_SPLICING)
        {
            if level = 0
            {
                set *spliced: t = TOKEN_UNQUOTE_SPLICING
                return this.parse_expr_full(0, result, key, tok)
            }
            var inner: pointer[Expression] null
            var sk SK_NOTKEY
            var st TOKEN_END_OF_ENTITY
            var ss false
            if this.parse_quasiquote_template(level - 1, 0, &inner, &sk, &st, &ss)
            {
                if t = TOKEN_UNQUOTE
                    set *result: this.create_quasiquote_abbrev("unquote", inner)
                else
                    set *result: this.create_quasiquote_abbrev("unquote-splicing", inner)
            }
            else
                set *result: inner
            return true
        }
        if (t = TOKEN_OPEN_PAREN) or (t = TOKEN_VECTOR)
            return this.parse_quasiquote_list(level, t, result, key, tok, spliced)
        if t = TOKEN_IDENTIFIER
        {
            if (allowed & ALLOW_QUASIQUOTE_KEY) <> 0
            {
                let ident interp.lookup(this.current_token)
                let sk ident.syntactic_key()
                if (sk = SK_UNQUOTE_SPLICING) or (sk = SK_UNQUOTE) or (sk = SK_QUASIQUOTE)
                {
                    set *key: sk
                    return true
                }
            }
            set obj: interp.make_symbol(this.current_token)
        }
        ; default: a self-quoting/symbol datum, or a bare signalling token
        if obj <> null
            set *result: Expression.make_constant(hp, obj, this.cur_loc())
        true
    }

    ; the tokenOpenParen / tokenVector arm of parseQuasiquoteTemplate.
    function parse_quasiquote_list(this: pointer[SchemeParser], level: int, open_tok: int, result: pointer[pointer[Expression]], key: pointer[int], tok: pointer[int], spliced: pointer[bool]) returns bool
    {
        set *result: null
        let hp this.host
        let interp this.interp
        let loc this.cur_loc()
        var qtype QQ_LIST
        if open_tok = TOKEN_VECTOR
            set qtype: QQ_VECTOR
        let members Array[pointer[Expression]]^hp()
        let spl Array[bool]^hp()
        ; --- first element (recognises leading key / empty list) -----------
        var first: pointer[Expression] null
        var temspl false
        if this.parse_quasiquote_template(level, ALLOW_CLOSE_PAREN | ALLOW_QUASIQUOTE_KEY | ALLOW_UNQUOTE_SPLICING, &first, key, tok, &temspl) = false
            return false
        if first = null
        {
            let k *key
            if k = SK_QUASIQUOTE
            {
                var inner: pointer[Expression] null
                var sk SK_NOTKEY
                if this.parse_quasiquote_template(level + 1, 0, &inner, &sk, tok, spliced) = false
                    return false
                set *result: this.create_quasiquote_abbrev("quasiquotation", inner)
                return this.expect_close_paren()
            }
            if (k = SK_UNQUOTE) or (k = SK_UNQUOTE_SPLICING)
            {
                var was_splice k = SK_UNQUOTE_SPLICING
                if was_splice
                    set *spliced: true
                if level = 0
                {
                    var sk SK_NOTKEY
                    if this.parse_expr_full(0, result, &sk, tok) = false
                        return false
                }
                else
                {
                    var inner: pointer[Expression] null
                    var sk SK_NOTKEY
                    var ss false
                    if this.parse_quasiquote_template(level - 1, 0, &inner, &sk, tok, &ss) = false
                        return false
                    if was_splice
                        set *result: this.create_quasiquote_abbrev("unquote-splicing", inner)
                    else
                        set *result: this.create_quasiquote_abbrev("unquote", inner)
                    set *spliced: false
                }
                return this.expect_close_paren()
            }
            ; empty list -> nil
            set *result: Expression.make_constant(hp, interp.make_nil(), loc)
            return true
        }
        members.add(first)
        spl.add(temspl)
        ; --- remaining elements --------------------------------------------
        var done false
        while done = false
        {
            var extra 0
            if qtype <> QQ_VECTOR
                set extra: ALLOW_PERIOD
            var tem: pointer[Expression] null
            var ts false
            if this.parse_quasiquote_template(level, ALLOW_CLOSE_PAREN | ALLOW_UNQUOTE_SPLICING | extra, &tem, key, tok, &ts) = false
                return false
            if tem = null
            {
                if *tok = TOKEN_CLOSE_PAREN
                {
                    set done: true
                }
                else
                {
                    ; period -> improper list: parse the tail, expect ')'
                    set qtype: QQ_IMPROPER
                    var tail: pointer[Expression] null
                    var sk SK_NOTKEY
                    var ss false
                    if this.parse_quasiquote_template(level, 0, &tail, &sk, tok, &ss) = false
                        return false
                    if this.expect_close_paren() = false
                        return false
                    members.add(tail)
                    spl.add(false)
                    set done: true
                }
            }
            else
            {
                members.add(tem)
                spl.add(ts)
            }
        }
        set *result: Expression.make_quasiquote(hp, members, spl, qtype, loc)
        true
    }

    ; (cond (test expr...) ... (else expr...)) -> nested ifs.
    function parse_cond(this: pointer[SchemeParser], result: pointer[pointer[Expression]]) returns bool
    {
        set *result: null
        let hp this.host
        let loc this.cur_loc()
        let tests Array[pointer[Expression]]^hp()
        let results Array[pointer[Expression]]^hp()
        let is_else_arr Array[bool]^hp()
        var tok TOKEN_END_OF_ENTITY
        repeat
        {
            if this.get_token(ALLOW_OPEN_PAREN | ALLOW_CLOSE_PAREN, &tok) = false
                return false
            if tok = TOKEN_CLOSE_PAREN
                break
            var test_e: pointer[Expression] null
            var key SK_NOTKEY
            if this.parse_expr_full(ALLOW_EXPR | ALLOW_KEY_ELSE, &test_e, &key, &tok) = false
                return false
            var is_else false
            if key = SK_ELSE
                set is_else: true
            let res_exprs Array[pointer[Expression]]^hp()
            repeat
            {
                var r: pointer[Expression] null
                if this.parse_expr_full(ALLOW_EXPR | ALLOW_CLOSE_PAREN, &r, &key, &tok) = false
                    return false
                if tok = TOKEN_CLOSE_PAREN
                    break
                if r <> null
                    res_exprs.add(r)
            }
            var conseq: pointer[Expression] null
            if (res_exprs.get_length() as int) = 0
                set conseq: test_e
            else
                set conseq: this.collapse_body(res_exprs, loc)
            tests.add(test_e)
            results.add(conseq)
            is_else_arr.add(is_else)
            if is_else
                break
        }
        var alternate Expression.make_cond_fail(hp, loc)
        let n tests.get_length() as int
        let tb tests.get_buffer()
        let rb results.get_buffer()
        let eb is_else_arr.get_buffer()
        var i n - 1
        while i >= 0
        {
            if *(eb + i)
                set alternate: *(rb + i)
            else
                set alternate: Expression.make_if(hp, *(tb + i), *(rb + i), alternate, loc)
            set i: i - 1
        }
        set *result: alternate
        true
    }

    ; (case key ((d...) expr...) ... (else expr...)).
    function parse_case(this: pointer[SchemeParser], result: pointer[pointer[Expression]]) returns bool
    {
        set *result: null
        let hp this.host
        let loc this.cur_loc()
        var key_expr: pointer[Expression] null
        var key SK_NOTKEY
        var tok TOKEN_END_OF_ENTITY
        if this.parse_expr_full(ALLOW_EXPR, &key_expr, &key, &tok) = false
            return false
        let datums Array[pointer[ELObj]]^hp()
        let case_starts Array[int]^hp()
        let results Array[pointer[Expression]]^hp()
        var else_expr: pointer[Expression] null
        repeat
        {
            if this.get_token(ALLOW_OPEN_PAREN | ALLOW_CLOSE_PAREN, &tok) = false
                return false
            if tok = TOKEN_CLOSE_PAREN
                break
            if this.get_token(ALLOW_OPEN_PAREN | ALLOW_IDENTIFIER, &tok) = false
                return false
            if tok = TOKEN_IDENTIFIER
            {
                let ident this.interp.lookup(this.current_token)
                if ident.syntactic_key() = SK_ELSE
                {
                    if this.parse_begin(&else_expr) = false
                        return false
                    continue
                }
                return false
            }
            ; datum list
            case_starts.add(datums.get_length() as int)
            repeat
            {
                var d: pointer[ELObj] null
                var dloc Location()
                if this.parse_datum(ALLOW_EXPR | ALLOW_CLOSE_PAREN, &d, &dloc, &tok) = false
                    return false
                if tok = TOKEN_CLOSE_PAREN
                    break
                datums.add(d)
            }
            var res: pointer[Expression] null
            if this.parse_begin(&res) = false
                return false
            results.add(res)
        }
        set *result: Expression.make_case(hp, key_expr, datums, case_starts, results, else_expr, loc)
        true
    }

    ; --- let family --------------------------------------------------------
    ; parse `(var init) ...)` — the bindings-list open paren already consumed.
    function parse_bindings(this: pointer[SchemeParser], vars: pointer[Array[pointer[Identifier]]], inits: pointer[Array[pointer[Expression]]]) returns bool
    {
        var tok TOKEN_END_OF_ENTITY
        repeat
        {
            if this.get_token(ALLOW_OPEN_PAREN | ALLOW_CLOSE_PAREN, &tok) = false
                return false
            if tok = TOKEN_CLOSE_PAREN
                break
            if this.get_token(ALLOW_IDENTIFIER, &tok) = false
                return false
            vars.add(this.interp.lookup(this.current_token))
            var init_e: pointer[Expression] null
            var key SK_NOTKEY
            if this.parse_expr_full(ALLOW_EXPR, &init_e, &key, &tok) = false
                return false
            inits.add(init_e)
            if this.expect_close_paren() = false
                return false
        }
        true
    }

    function parse_let(this: pointer[SchemeParser], result: pointer[pointer[Expression]]) returns bool
    {
        set *result: null
        let hp this.host
        let loc this.cur_loc()
        let vars Array[pointer[Identifier]]^hp()
        let inits Array[pointer[Expression]]^hp()
        var body: pointer[Expression] null
        var tok TOKEN_END_OF_ENTITY
        if this.get_token(ALLOW_OPEN_PAREN | ALLOW_IDENTIFIER, &tok) = false
            return false
        var name: pointer[Identifier] null
        if tok = TOKEN_IDENTIFIER
        {
            set name: this.interp.lookup(this.current_token)
            ; the bindings list open paren follows.
            if this.get_token(ALLOW_OPEN_PAREN, &tok) = false
                return false
            if this.parse_bindings(vars, inits) = false
                return false
            if this.parse_begin(&body) = false
                return false
        }
        else
        {
            ; regular let — the bindings-list open paren is the tok we just read.
            if this.parse_bindings(vars, inits) = false
                return false
            if this.parse_begin(&body) = false
                return false
        }
        if name <> null
        {
            ; named let -> ((letrec ((name (lambda (vars) body))) name) inits...)
            let loop_formal Array[pointer[Identifier]]^hp()
            loop_formal.add(name)
            let empty_inits Array[pointer[Expression]]^hp()
            let lam_sig Signature((vars.get_length() as int), 0, false, 0, null)
            let lambda Expression.make_lambda(hp, vars, empty_inits, lam_sig, body, loc)
            let loop_init Array[pointer[Expression]]^hp()
            loop_init.add(lambda)
            let loop_ref Expression.make_variable(hp, name, loc)
            let letrec Expression.make_letrec(hp, loop_formal, loop_init, loop_ref, loc)
            set *result: Expression.make_call(hp, letrec, inits, loc)
        }
        else
            set *result: Expression.make_let(hp, vars, inits, body, loc)
        true
    }

    function parse_let_star(this: pointer[SchemeParser], result: pointer[pointer[Expression]]) returns bool
    {
        set *result: null
        let hp this.host
        let loc this.cur_loc()
        let vars Array[pointer[Identifier]]^hp()
        let inits Array[pointer[Expression]]^hp()
        var body: pointer[Expression] null
        var tok TOKEN_END_OF_ENTITY
        if this.get_token(ALLOW_OPEN_PAREN, &tok) = false
            return false
        if this.parse_bindings(vars, inits) = false
            return false
        if this.parse_begin(&body) = false
            return false
        set *result: Expression.make_let_star(hp, vars, inits, body, loc)
        true
    }

    function parse_letrec(this: pointer[SchemeParser], result: pointer[pointer[Expression]]) returns bool
    {
        set *result: null
        let hp this.host
        let loc this.cur_loc()
        let vars Array[pointer[Identifier]]^hp()
        let inits Array[pointer[Expression]]^hp()
        var body: pointer[Expression] null
        var tok TOKEN_END_OF_ENTITY
        if this.get_token(ALLOW_OPEN_PAREN, &tok) = false
            return false
        if this.parse_bindings(vars, inits) = false
            return false
        if this.parse_begin(&body) = false
            return false
        set *result: Expression.make_letrec(hp, vars, inits, body, loc)
        true
    }

    function parse_lambda(this: pointer[SchemeParser], result: pointer[pointer[Expression]]) returns bool
    {
        set *result: null
        let hp this.host
        let loc this.cur_loc()
        let formals Array[pointer[Identifier]]^hp()
        let defaults Array[pointer[Expression]]^hp()
        var n_required 0
        var has_rest false
        var n_key 0
        var tok TOKEN_END_OF_ENTITY
        if this.get_token(ALLOW_OPEN_PAREN | ALLOW_IDENTIFIER, &tok) = false
            return false
        if tok = TOKEN_IDENTIFIER
        {
            ; (lambda x body) — a single rest parameter.
            formals.add(this.interp.lookup(this.current_token))
            set has_rest: true
        }
        else
        {
            if this.parse_formals(formals, defaults, &n_required, &has_rest, &n_key) = false
                return false
        }
        var body: pointer[Expression] null
        if this.parse_begin(&body) = false
            return false
        var rest_slot 0
        if has_rest
            set rest_slot: 1
        let n_optional (formals.get_length() as int) - n_required - n_key - rest_slot
        let sig this.build_signature(formals, n_required, n_optional, has_rest, n_key)
        set *result: Expression.make_lambda(hp, formals, defaults, sig, body, loc)
        true
    }

    ; assemble a Signature, materializing the keyword-arg identifier table.
    function build_signature(this: pointer[SchemeParser], formals: pointer[Array[pointer[Identifier]]], n_required: int, n_optional: int, has_rest: bool, n_key: int) returns Signature
    {
        var keys: pointer[pointer[Identifier]] null
        if n_key > 0
        {
            let hp this.host
            set keys: hp.allocate((n_key as size_t) * sizeof pointer[Identifier], alignof pointer[Identifier]) as pointer[pointer[Identifier]]
            let fb formals.get_buffer()
            let base (formals.get_length() as int) - n_key
            var i 0
            while i < n_key
            {
                set *(keys + i): *(fb + (base + i))
                set i: i + 1
            }
        }
        Signature(n_required, n_optional, has_rest, n_key, keys)
    }

    ; bool parseFormals(formals, inits, out nRequired, out hasRest, out nKey).
    function parse_formals(this: pointer[SchemeParser], formals: pointer[Array[pointer[Identifier]]], inits: pointer[Array[pointer[Expression]]], n_required: pointer[int], has_rest: pointer[bool], n_key: pointer[int]) returns bool
    {
        set *n_required: 0
        set *has_rest: false
        set *n_key: 0
        var kind FORMAL_REQUIRED
        var allowed ALLOW_CLOSE_PAREN | ALLOW_IDENTIFIER | ALLOW_HASH_OPTIONAL | ALLOW_HASH_REST | ALLOW_HASH_KEY
        var c_req 0
        var c_opt 0
        var c_rest 0
        var c_key 0
        var tok TOKEN_END_OF_ENTITY
        repeat
        {
            if this.get_token(allowed, &tok) = false
                return false
            if tok = TOKEN_HASH_OPTIONAL
            {
                set allowed: ALLOW_OPEN_PAREN | ALLOW_CLOSE_PAREN | ALLOW_IDENTIFIER | ALLOW_HASH_REST | ALLOW_HASH_KEY
                set kind: FORMAL_OPTIONAL
            }
            else if tok = TOKEN_HASH_REST
            {
                set allowed: ALLOW_IDENTIFIER
                set kind: FORMAL_REST
            }
            else if tok = TOKEN_HASH_KEY
            {
                set allowed: ALLOW_OPEN_PAREN | ALLOW_CLOSE_PAREN | ALLOW_IDENTIFIER
                set kind: FORMAL_KEY
            }
            else if tok = TOKEN_OPEN_PAREN
            {
                if this.get_token(ALLOW_IDENTIFIER, &tok) = false
                    return false
                formals.add(this.interp.lookup(this.current_token))
                if kind = FORMAL_OPTIONAL
                    set c_opt: c_opt + 1
                else
                    set c_key: c_key + 1
                var init_e: pointer[Expression] null
                var key SK_NOTKEY
                if this.parse_expr_full(ALLOW_EXPR, &init_e, &key, &tok) = false
                    return false
                this.pad_inits(inits, c_opt + c_key)
                set *(inits.get_buffer() + ((c_opt + c_key) - 1)): init_e
                if this.get_token(ALLOW_CLOSE_PAREN, &tok) = false
                    return false
            }
            else if tok = TOKEN_IDENTIFIER
            {
                formals.add(this.interp.lookup(this.current_token))
                if kind = FORMAL_REQUIRED
                    set c_req: c_req + 1
                else if kind = FORMAL_OPTIONAL
                {
                    set c_opt: c_opt + 1
                    this.pad_inits(inits, c_opt + c_key)
                }
                else if kind = FORMAL_REST
                {
                    set c_rest: c_rest + 1
                    set allowed: ALLOW_HASH_KEY | ALLOW_CLOSE_PAREN
                }
                else
                {
                    set c_key: c_key + 1
                    this.pad_inits(inits, c_opt + c_key)
                }
            }
            else if tok = TOKEN_CLOSE_PAREN
                break
            else
                return false
        }
        set *n_required: c_req
        set *n_key: c_key
        if c_rest > 0
            set *has_rest: true
        this.pad_inits(inits, c_opt + c_key)
        true
    }

    ; grow inits with null defaults up to n entries.
    function pad_inits(this: pointer[SchemeParser], inits: pointer[Array[pointer[Expression]]], n: int)
    {
        while (inits.get_length() as int) < n
            inits.add(null)
    }

    ; --- top level ---------------------------------------------------------
    ; the reader loop (SchemeParser::parse) — one top-level form per iteration.
    function parse(this: pointer[SchemeParser])
    {
        var recovering false
        repeat
        {
            var allowed ALLOW_OPEN_PAREN | ALLOW_END_OF_ENTITY
            if recovering
                set allowed: ALLOW_ALL
            var tok TOKEN_END_OF_ENTITY
            if this.get_token(allowed, &tok) = false
            {
                set recovering: true
                continue
            }
            if tok = TOKEN_END_OF_ENTITY
                break
            if tok <> TOKEN_OPEN_PAREN
            {
                set recovering: true
                continue
            }
            let success this.parse_top_level()
            if success = false
                this.skip_form()
            set recovering: success = false
        }
    }

    function parse_top_level(this: pointer[SchemeParser]) returns bool
    {
        var tok TOKEN_END_OF_ENTITY
        if this.get_token(ALLOW_IDENTIFIER | ALLOW_KEY_DEFINE, &tok) = false
            return false
        if tok = TOKEN_IDENTIFIER
        {
            let ident this.interp.lookup(this.current_token)
            if ident.syntactic_key() = SK_DEFINE
                return this.do_define()
            ; element / root / mode / declare-* etc. are style/grove increments;
            ; skip them cleanly for the eval core.
            return this.skip_form()
        }
        this.skip_form()
    }

    function do_define(this: pointer[SchemeParser]) returns bool
    {
        let hp this.host
        var tok TOKEN_END_OF_ENTITY
        if this.get_token(ALLOW_IDENTIFIER | ALLOW_OPEN_PAREN, &tok) = false
            return false
        if tok = TOKEN_IDENTIFIER
        {
            ; (define var expr)
            let ident this.interp.lookup(this.current_token)
            var expr: pointer[Expression] null
            var key SK_NOTKEY
            if this.parse_expr_full(ALLOW_EXPR, &expr, &key, &tok) = false
                return false
            if this.expect_close_paren() = false
                return false
            ident.set_expression(expr, 0 as u32, this.cur_loc())
            return true
        }
        ; (define (name formals) body)
        if this.get_token(ALLOW_IDENTIFIER, &tok) = false
            return false
        let name this.interp.lookup(this.current_token)
        let formals Array[pointer[Identifier]]^hp()
        let defaults Array[pointer[Expression]]^hp()
        var n_required 0
        var has_rest false
        var n_key 0
        if this.parse_formals(formals, defaults, &n_required, &has_rest, &n_key) = false
            return false
        var body: pointer[Expression] null
        if this.parse_begin(&body) = false
            return false
        let loc this.cur_loc()
        var rest_slot 0
        if has_rest
            set rest_slot: 1
        let n_optional (formals.get_length() as int) - n_required - n_key - rest_slot
        let sig this.build_signature(formals, n_required, n_optional, has_rest, n_key)
        let lambda Expression.make_lambda(hp, formals, defaults, sig, body, loc)
        name.set_expression(lambda, 0 as u32, loc)
        true
    }

    ; skip a form to its matching close paren (recovery / unhandled forms).
    function skip_form(this: pointer[SchemeParser]) returns bool
    {
        var depth 1
        var tok TOKEN_END_OF_ENTITY
        repeat
        {
            if this.get_token(ALLOW_ALL, &tok) = false
                return true
            if tok = TOKEN_END_OF_ENTITY
                return true
            if (tok = TOKEN_OPEN_PAREN) or (tok = TOKEN_VECTOR)
                set depth: depth + 1
            else if tok = TOKEN_CLOSE_PAREN
            {
                set depth: depth - 1
                if depth = 0
                    break
            }
        }
        true
    }

    ; --- self-test ---------------------------------------------------------
    ; parse one datum from an ASCII snippet and print it; empty result means
    ; parse failure. (Line ends in snippets are RE = \r, the OpenSP record
    ; convention this reader lives on.)
    function dump_one(this: pointer[SchemeParser], os: pointer[OutputCharStream]) returns bool
    {
        var datum: pointer[ELObj] null
        var loc Location()
        var tok TOKEN_END_OF_ENTITY
        if this.parse_datum(ALLOW_END_OF_ENTITY, &datum, &loc, &tok) = false
            return false
        if datum = null
            return false
        let interp this.interp
        let resolved datum.resolve_quantities(false, interp, loc)
        resolved.print(os, 1440)
        true
    }

    function check(host: pointer[Page], interp: pointer[Interpreter], src: pointer[const_char], expect: pointer[const_char]) returns bool
    {
        let text StringC(src)
        let src_in InputSource.make(host, null, text.data_ptr(), text.get_size())
        let sp SchemeParser.make(host, interp, src_in)
        let os OutputCharStream.make(host)
        if sp.dump_one(os) = false
            return false
        os.is_ascii(expect)
    }

    function test() returns int
    {
        let anchor StringC("x")
        let host Page.get(anchor.data_ptr() as pointer[void])
        let interp Interpreter.make(host, 1440, false, false, false)

        ; atoms
        if SchemeParser.check(host, interp, "42", "42") = false
            return 1
        if SchemeParser.check(host, interp, "-17", "-17") = false
            return 2
        if SchemeParser.check(host, interp, "#x1a", "26") = false
            return 3
        if SchemeParser.check(host, interp, "1.5", "1.5") = false
            return 4
        if SchemeParser.check(host, interp, ".5", "0.5") = false
            return 5
        if SchemeParser.check(host, interp, "#t", "#t") = false
            return 6
        if SchemeParser.check(host, interp, "#f", "#f") = false
            return 7
        if SchemeParser.check(host, interp, "foo", "foo") = false
            return 8
        if SchemeParser.check(host, interp, "list->string", "list->string") = false
            return 9
        if SchemeParser.check(host, interp, "...", "...") = false
            return 10
        if SchemeParser.check(host, interp, "-", "-") = false
            return 11
        if SchemeParser.check(host, interp, "foo:", "foo:") = false
            return 12

        ; strings (named character escapes, not C escapes)
        if SchemeParser.check(host, interp, "\"hi\"", "\"hi\"") = false
            return 13
        if SchemeParser.check(host, interp, "\"a\\U-0041;b\"", "\"aAb\"") = false
            return 14
        if SchemeParser.check(host, interp, "\"q\\\"w\"", "\"q\\\"w\"") = false
            return 15

        ; characters
        if SchemeParser.check(host, interp, "#\\a", "#\\a") = false
            return 16
        if SchemeParser.check(host, interp, "#\\space", "#\\ ") = false
            return 17

        ; quantities resolve through the builtin units
        if SchemeParser.check(host, interp, "2in", "144pt") = false
            return 18

        ; lists
        if SchemeParser.check(host, interp, "()", "()") = false
            return 19
        if SchemeParser.check(host, interp, "(a b c)", "(a b c)") = false
            return 20
        if SchemeParser.check(host, interp, "(a . b)", "(a . b)") = false
            return 21
        if SchemeParser.check(host, interp, "(a (b c) d)", "(a (b c) d)") = false
            return 22

        ; abbreviations
        if SchemeParser.check(host, interp, "'foo", "(quote foo)") = false
            return 23
        if SchemeParser.check(host, interp, "\`(a ,b ,@c)", "(quasiquote (a (unquote b) (unquote-splicing c)))") = false
            return 24

        ; comments end at RE (\r), the OpenSP record convention
        if SchemeParser.check(host, interp, "; note\r42", "42") = false
            return 25

        ; vectors are dsssl2-gated
        if SchemeParser.check(host, interp, "#(1 2)", "#(1 2)")
            return 26
        let interp2 Interpreter.make(host, 1440, false, true, false)
        if SchemeParser.check(host, interp2, "#(1 2)", "#(1 2)") = false
            return 27

        ; ================= Inc 3: the evaluator =============================
        let ei Interpreter.make(host, 1440, false, false, false)

        ; arithmetic + comparison
        if SchemeParser.eval_int(host, ei, "(+ 1 2)") <> 3
            return 30
        if SchemeParser.eval_int(host, ei, "(* 6 7)") <> 42
            return 31
        if SchemeParser.eval_int(host, ei, "(- 10 3 2)") <> 5
            return 32
        if SchemeParser.eval_int(host, ei, "(+ 1 (* 2 3) (- 8 4))") <> 11
            return 33
        if SchemeParser.eval_bool(host, ei, "(< 1 2 3)") = false
            return 34
        if SchemeParser.eval_bool(host, ei, "(= 5 5)") = false
            return 35

        ; if / and / or / begin
        if SchemeParser.eval_int(host, ei, "(if #t 11 22)") <> 11
            return 36
        if SchemeParser.eval_int(host, ei, "(if #f 11 22)") <> 22
            return 37
        if SchemeParser.eval_int(host, ei, "(begin 1 2 3)") <> 3
            return 38

        ; lambda application + closures
        if SchemeParser.eval_int(host, ei, "((lambda (x) (* x x)) 5)") <> 25
            return 39
        if SchemeParser.eval_int(host, ei, "((lambda (x y) (+ x y)) 3 4)") <> 7
            return 40

        ; let / let* / letrec
        if SchemeParser.eval_int(host, ei, "(let ((a 3) (b 4)) (+ a b))") <> 7
            return 41
        if SchemeParser.eval_int(host, ei, "(let* ((a 3) (b (* a 2))) (+ a b))") <> 9
            return 42

        ; named let — TCO: 100k tail calls must not grow the stack
        if SchemeParser.eval_int(host, ei, "(let loop ((i 0) (s 0)) (if (= i 100000) s (loop (+ i 1) (+ s i))))") <> 4999950000
            return 43

        ; list ops
        if SchemeParser.eval_int(host, ei, "(car (cdr (list 1 2 3)))") <> 2
            return 44
        if SchemeParser.eval_int(host, ei, "(length (list 1 2 3 4))") <> 4
            return 45

        ; cond
        if SchemeParser.eval_int(host, ei, "(cond (#f 1) (#t 2) (else 3))") <> 2
            return 46

        ; top-level define + non-tail recursion (control stack)
        SchemeParser.run_program(host, ei, "(define (fact n) (if (= n 0) 1 (* n (fact (- n 1)))))")
        if SchemeParser.eval_int(host, ei, "(fact 5)") <> 120
            return 47

        ; top-level mutual recursion via lazy top-level refs
        SchemeParser.run_program(host, ei, "(define (my-even? n) (if (= n 0) #t (my-odd? (- n 1))))")
        SchemeParser.run_program(host, ei, "(define (my-odd? n) (if (= n 0) #f (my-even? (- n 1))))")
        if SchemeParser.eval_bool(host, ei, "(my-even? 10)") = false
            return 48
        if SchemeParser.eval_bool(host, ei, "(my-even? 7)")
            return 49

        ; --- string primitives --------------------------------------------
        if SchemeParser.eval_int(host, ei, "(string-length \"hello\")") <> 5
            return 50
        if SchemeParser.eval_str_eq(host, ei, "(string-append \"ab\" \"cd\" \"ef\")", "abcdef") = false
            return 51
        if SchemeParser.eval_str_eq(host, ei, "(substring \"hello\" 1 4)", "ell") = false
            return 52
        if SchemeParser.eval_int(host, ei, "(char->integer (string-ref \"abc\" 1))") <> 98
            return 53
        if SchemeParser.eval_bool(host, ei, "(string=? \"abc\" \"abc\")") = false
            return 54
        if SchemeParser.eval_bool(host, ei, "(string<? \"abc\" \"abd\")") = false
            return 55
        if SchemeParser.eval_bool(host, ei, "(string<=? \"abc\" \"abc\")") = false
            return 56
        if SchemeParser.eval_int(host, ei, "(length (string->list \"abcd\"))") <> 4
            return 57
        if SchemeParser.eval_int(host, ei, "(string-length (list->string (list (integer->char 120) (integer->char 121))))") <> 2
            return 58

        ; --- number <-> string --------------------------------------------
        if SchemeParser.eval_str_eq(host, ei, "(number->string 42)", "42") = false
            return 59
        if SchemeParser.eval_str_eq(host, ei, "(number->string 255 16)", "ff") = false
            return 60
        if SchemeParser.eval_int(host, ei, "(string->number \"42\")") <> 42
            return 61
        if SchemeParser.eval_int(host, ei, "(string->number \"ff\" 16)") <> 255
            return 62
        if SchemeParser.eval_bool(host, ei, "(string->number \"abc\")")
            return 63

        ; --- char primitives ----------------------------------------------
        if SchemeParser.eval_int(host, ei, "(char->integer (integer->char 65))") <> 65
            return 64
        if SchemeParser.eval_bool(host, ei, "(char<? (integer->char 97) (integer->char 98))") = false
            return 65
        if SchemeParser.eval_int(host, ei, "(char->integer (char-upcase (integer->char 97)))") <> 65
            return 66
        if SchemeParser.eval_int(host, ei, "(char->integer (char-downcase (integer->char 90)))") <> 122
            return 67

        ; --- symbol / keyword <-> string -----------------------------------
        if SchemeParser.eval_str_eq(host, ei, "(symbol->string (string->symbol \"greta\"))", "greta") = false
            return 68
        if SchemeParser.eval_bool(host, ei, "(eqv? (string->symbol \"x\") (string->symbol \"x\"))") = false
            return 69

        ; --- vector primitives ---------------------------------------------
        if SchemeParser.eval_int(host, ei, "(vector-ref (vector 10 20 30) 1)") <> 20
            return 70
        if SchemeParser.eval_int(host, ei, "(vector-length (make-vector 5 0))") <> 5
            return 71
        if SchemeParser.eval_int(host, ei, "(vector-ref (list->vector (list 7 8 9)) 2)") <> 9
            return 72
        if SchemeParser.eval_int(host, ei, "(length (vector->list (vector 1 2 3 4)))") <> 4
            return 73
        if SchemeParser.eval_int(host, ei, "(let ((v (make-vector 3 0))) (begin (vector-set! v 1 99) (vector-ref v 1)))") <> 99
            return 74

        ; --- list-tail -----------------------------------------------------
        if SchemeParser.eval_int(host, ei, "(car (list-tail (list 1 2 3 4) 2))") <> 3
            return 75

        ; --- quasiquote ----------------------------------------------------
        ; The QuasiquoteExpr parser + eval are ported faithfully; these forms
        ; run green. NB a threaded-code VM miscompile (same class as the
        ; (*ptr).method() bug — see the memory) breaks quasiquote when it is
        ; DIRECTLY a call argument or carries a computed unquote ,(expr) / ,@;
        ; the value must be let-bound before use. TODO: Planner/Emitter fix.
        if SchemeParser.eval_int(host, ei, "(let ((x \`(1 2 3))) (car x))") <> 1
            return 76
        if SchemeParser.eval_int(host, ei, "(let ((x \`(1 2 3 4))) (length x))") <> 4
            return 77
        if SchemeParser.eval_int(host, ei, "(let ((x \`(10 20 30))) (car (cdr x)))") <> 20
            return 78
        if SchemeParser.eval_int(host, ei, "(let ((x \`(1 . 2))) (cdr x))") <> 2
            return 79
        ; nested quasiquote: ``(a b) = (quasiquote (a b)) — a 2-element list
        if SchemeParser.eval_int(host, ei, "(let ((x \`\`(a b))) (length x))") <> 2
            return 80

        ; --- apply ---------------------------------------------------------
        if SchemeParser.eval_int(host, ei, "(apply + (list 1 2 3 4))") <> 10
            return 81
        if SchemeParser.eval_int(host, ei, "(apply + 1 2 (list 3 4))") <> 10
            return 82
        if SchemeParser.eval_int(host, ei, "(apply * (list 2 3 4))") <> 24
            return 83
        SchemeParser.run_program(host, ei, "(define (add3 a b c) (+ a b c))")
        if SchemeParser.eval_int(host, ei, "(apply add3 (list 10 20 30))") <> 60
            return 84

        ; --- call-with-current-continuation --------------------------------
        ; escape: (k 42) discards the enclosing (+ 1 ...) -> 42
        if SchemeParser.eval_int(host, ei, "(call-with-current-continuation (lambda (k) (+ 1 (k 42))))") <> 42
            return 85
        ; non-escaping: the continuation is never invoked -> 5 + 10
        if SchemeParser.eval_int(host, ei, "(+ 5 (call/cc (lambda (k) 10)))") <> 15
            return 86
        ; escape past an intermediate frame -> 1 + 100
        if SchemeParser.eval_int(host, ei, "(+ 1 (call/cc (lambda (k) (+ 2 (k 100)))))") <> 101
            return 87

        ; --- grove / node-list (Inc 4) -------------------------------------
        ; bind `root` to a singleton node-list over a hand-built grove:
        ;   document > para > ["Hello", emph > "world"]
        let doc GroveBuilder.build_test_grove(host)
        let root_nl ELObj.make_node_singleton(host, doc)
        let rid ei.lookup(StringC("root"))
        rid.set_definition(0 as u32, Location(), root_nl)
        if SchemeParser.eval_bool(host, ei, "(node-list? root)") = false
            return 88
        if SchemeParser.eval_bool(host, ei, "(node-list-empty? root)")
            return 89
        if SchemeParser.eval_bool(host, ei, "(node-list-empty? (empty-node-list))") = false
            return 90
        ; document has one child (para)
        if SchemeParser.eval_int(host, ei, "(node-list-length (children root))") <> 1
            return 91
        ; the para element's GI
        if SchemeParser.eval_str_eq(host, ei, "(gi (node-list-first (children root)))", "para") = false
            return 92
        ; para has two children (the data + the emph element)
        if SchemeParser.eval_int(host, ei, "(node-list-length (children (node-list-first (children root))))") <> 2
            return 93
        ; the emph element's GI (second child of para)
        if SchemeParser.eval_str_eq(host, ei, "(gi (node-list-ref (children (node-list-first (children root))) 1))", "emph") = false
            return 94
        ; data string value = all descendant chars joined
        if SchemeParser.eval_str_eq(host, ei, "(data root)", "Helloworld") = false
            return 95

        ; --- sosofos (Inc 4 foundation) ------------------------------------
        if SchemeParser.eval_bool(host, ei, "(sosofo? (empty-sosofo))") = false
            return 96
        if SchemeParser.eval_bool(host, ei, "(sosofo? 5)")
            return 97
        if SchemeParser.eval_bool(host, ei, "(sosofo? (sosofo-append (empty-sosofo) (empty-sosofo)))") = false
            return 98

        0
    }

    ; --- eval-test helpers -------------------------------------------------
    ; parse ONE expression from src, compile it, run it on a fresh VM.
    function eval_str(host: pointer[Page], interp: pointer[Interpreter], src: pointer[const_char]) returns pointer[ELObj]
    {
        let text StringC(src)
        let src_in InputSource.make(host, null, text.data_ptr(), text.get_size())
        let sp SchemeParser.make(host, interp, src_in)
        var expr: pointer[Expression] null
        if sp.parse_expression(&expr) = false
            return interp.make_error()
        if expr = null
            return interp.make_error()
        let env Environment.make(host)
        let insn Expression.optimize_compile(expr, interp, env, 0, null)
        let vm VM.make(host, interp)
        vm.eval(insn, null, null)
    }

    ; run a whole program (its top-level defines register on interp).
    function run_program(host: pointer[Page], interp: pointer[Interpreter], src: pointer[const_char])
    {
        let text StringC(src)
        let src_in InputSource.make(host, null, text.data_ptr(), text.get_size())
        let sp SchemeParser.make(host, interp, src_in)
        sp.parse()
    }

    function eval_int(host: pointer[Page], interp: pointer[Interpreter], src: pointer[const_char]) returns int
    {
        let v SchemeParser.eval_str(host, interp, src)
        if v = null
            return 0 - 999999
        if v.is_exact_integer() = false
            return 0 - 999998
        v.exact_integer_value()
    }

    function eval_bool(host: pointer[Page], interp: pointer[Interpreter], src: pointer[const_char]) returns bool
    {
        let v SchemeParser.eval_str(host, interp, src)
        if v = null
            return false
        v.is_true()
    }

    ; eval src and compare the resulting string to an ASCII expected value.
    function eval_str_eq(host: pointer[Page], interp: pointer[Interpreter], src: pointer[const_char], expected: pointer[const_char]) returns bool
    {
        let v SchemeParser.eval_str(host, interp, src)
        if v = null
            return false
        if v.has_string_data() = false
            return false
        let s v.string_data(host)
        let e StringC(expected)
        s.equals(e)
    }
}
