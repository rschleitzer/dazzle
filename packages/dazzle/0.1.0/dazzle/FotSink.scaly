            return
        }
        if tag = SV_END_MULTI_MODE_SERIAL
        {
            this.end_multi_mode_serial()
            return
        }
        if tag = SV_START_MULTI_MODE_MODE
        {
            this.start_multi_mode_mode(r.nic as pointer[MultiModeRec])
            return
        }
        if tag = SV_END_MULTI_MODE_MODE
        {
            this.end_multi_mode_mode()
            return
        }
        if tag = SV_START_PAGE_SEQUENCE
        {
            this.start_page_sequence()
            return
        }
        if tag = SV_END_PAGE_SEQUENCE
        {
            this.end_page_sequence()
            return
        }
        if tag = SV_START_COLUMN_SET_SEQUENCE
        {
            this.start_column_set_sequence(r.dnic)
            return
        }
        if tag = SV_END_COLUMN_SET_SEQUENCE
        {
            this.end_column_set_sequence()
            return
        }
        ; the transform backend's eleven
        if tag = SV_START_ELEMENT
        {
            let er r.nic as pointer[SaveElementRec]
            this.start_element(er.gi, er.atts)
            return
        }
        if tag = SV_END_ELEMENT
        {
            this.end_element()
            return
        }
        if tag = SV_EMPTY_ELEMENT
        {
            let er r.nic as pointer[SaveElementRec]
            this.empty_element(er.gi, er.atts)
            return
        }
        if tag = SV_START_ENTITY
        {
            this.start_entity(r.str)
            return
        }
        if tag = SV_END_ENTITY
        {
            this.end_entity()
            return
        }
        if tag = SV_ENTITY_REF
        {
            this.entity_ref(r.str)
            return
        }
        if tag = SV_PROCESSING_INSTRUCTION
        {
            this.processing_instruction(r.str)
            return
        }
        if tag = SV_DOCUMENT_TYPE
        {
            let dr r.nic as pointer[SaveDocTypeRec]
            this.document_type(dr.name, dr.public_id, dr.system_id)
            return
        }
        if tag = SV_FORMATTING_INSTRUCTION
        {
            this.formatting_instruction(r.str)
            return
        }
        if tag = SV_START_DIRECTORY
        {
            this.start_directory(r.str)
            return
        }
        if tag = SV_END_DIRECTORY
        {
            this.end_directory()
            return
        }
    }

