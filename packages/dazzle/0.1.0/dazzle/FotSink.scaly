; FotSink — the styled-backend dispatch seam (design note "RtfFOTBuilder
; (`-t rtf`)"). ProcessContext's styled call sites talk to exactly one sink;
; this record tags which backend is live (fot's SgmlFOTBuilder or the
; RtfFOTBuilder) and forwards each call once. The transform backend keeps its
; own separate slot in ProcessContext (untouched — Family A byte-safety).
;
; Port/connection capture happens HERE (the reference currentFOTBuilder()
; seam): while `save` is set, every call is recorded onto that queue instead
; of reaching the backend (SaveFOTBuilder.scaly). emit_saved replays a queue
; through the sink — if the sink is capturing at replay time the calls simply
; re-record onto the outer queue (the reference emit-into-SaveFOTBuilder
; splice). emit_saved_into targets a specific queue (endConnection's
; save-queue flush into the port's builder).

use scaly.memory.Page
use opensp.StringC.StringC
use dazzle.Grove.GroveNode
use dazzle.Style.InheritedC
use dazzle.Style.DisplayNIC
use dazzle.Style.RuleNICRec
use dazzle.Style.LinkNICRec
use dazzle.Style.GraphicNICRec
use dazzle.Style.LeaderNICRec
use dazzle.Style.BoxNICRec
use dazzle.Style.ScoreNICRec
use dazzle.Style.TableNICRec
use dazzle.Style.TableColumnNICRec
use dazzle.Style.TableCellNICRec
use dazzle.SgmlFOTBuilder.SgmlFOTBuilder
use dazzle.RtfFOTBuilder.RtfFOTBuilder
use dazzle.SaveFOTBuilder.SaveFOTBuilder
use dazzle.SaveFOTBuilder.SaveCallRec

define FotSink (sgml: pointer[SgmlFOTBuilder], rtf: pointer[RtfFOTBuilder], save: pointer[SaveFOTBuilder])
{
    function make_sgml(host: pointer[Page], sgml: pointer[SgmlFOTBuilder]) returns pointer[FotSink]
    {
        let s host.allocate(sizeof FotSink, alignof FotSink) as pointer[FotSink]
        set s.sgml: sgml
        set s.rtf: null
        set s.save: null
        s
    }

    function make_rtf(host: pointer[Page], rtf: pointer[RtfFOTBuilder]) returns pointer[FotSink]
    {
        let s host.allocate(sizeof FotSink, alignof FotSink) as pointer[FotSink]
        set s.sgml: null
        set s.rtf: rtf
        set s.save: null
        s
    }

    ; --- the capture seam ----------------------------------------------------
    procedure set_save(this: pointer[FotSink], q: pointer[SaveFOTBuilder])
        set this.save: q

    function get_save(this: pointer[FotSink]) returns pointer[SaveFOTBuilder]
        save

    ; replay a recorded queue through this sink (SaveFOTBuilder::emit). The
    ; ctor-node form wraps the replay in startNode/endNode on the TARGET —
    ; recorded again if the sink is currently capturing (reference splice
    ; semantics).
    procedure emit_saved(this: pointer[FotSink], q: pointer[SaveFOTBuilder])
    {
        if q = null
            return
        if q.node <> null
            this.start_node(q.node, q.mode_name)
        var r q.head
        while r <> null
        {
            this.emit_one(r)
            set r: r.next
        }
        if q.node <> null
            this.end_node()
    }

    ; replay a queue INTO another queue (endConnection: saved->emit(*port->fotb)).
    procedure emit_saved_into(this: pointer[FotSink], q: pointer[SaveFOTBuilder], dst: pointer[SaveFOTBuilder])
    {
        let old this.save
        set this.save: dst
        this.emit_saved(q)
        set this.save: old
    }

    procedure emit_one(this: pointer[FotSink], r: pointer[SaveCallRec])
    {
        let tag r.tag
        if tag = SV_SET_IC
        {
            this.set_ic(r.ic)
            return
        }
        if tag = SV_CHARACTERS
        {
            this.characters(r.data, r.n)
            return
        }
        if tag = SV_CHARS_FROM_NODE
        {
            this.characters_from_node(r.node, r.data, r.n)
            return
        }
        if tag = SV_START_NODE
        {
            this.start_node(r.node, r.str)
            return
        }
        if tag = SV_END_NODE
        {
            this.end_node()
            return
        }
        if tag = SV_START_SEQUENCE
        {
            this.start_sequence()
            return
        }
        if tag = SV_END_SEQUENCE
        {
            this.end_sequence()
            return
        }
        if tag = SV_START_PARAGRAPH
        {
            this.start_paragraph(r.dnic)
            return
        }
        if tag = SV_END_PARAGRAPH
        {
            this.end_paragraph()
            return
        }
        if tag = SV_PARAGRAPH_BREAK
        {
            this.paragraph_break(r.dnic)
            return
        }
        if tag = SV_START_DISPLAY_GROUP
        {
            this.start_display_group(r.dnic)
            return
        }
        if tag = SV_END_DISPLAY_GROUP
        {
            this.end_display_group()
            return
        }
        if tag = SV_START_LINE_FIELD
        {
            this.start_line_field()
            return
        }
        if tag = SV_END_LINE_FIELD
        {
            this.end_line_field()
            return
        }
        if tag = SV_START_LEADER
        {
            this.start_leader(r.nic as pointer[LeaderNICRec])
            return
        }
        if tag = SV_END_LEADER
        {
            this.end_leader()
            return
        }
        if tag = SV_START_LINK
        {
            this.start_link(r.nic as pointer[LinkNICRec])
            return
        }
        if tag = SV_END_LINK
        {
            this.end_link()
            return
        }
        if tag = SV_START_SCORE
        {
            this.start_score(r.nic as pointer[ScoreNICRec])
            return
        }
        if tag = SV_END_SCORE
        {
            this.end_score()
            return
        }
        if tag = SV_START_BOX
        {
            this.start_box(r.nic as pointer[BoxNICRec], r.dnic)
            return
        }
        if tag = SV_END_BOX
        {
            this.end_box()
            return
        }
        if tag = SV_RULE
        {
            this.rule(r.nic as pointer[RuleNICRec], r.dnic)
            return
        }
        if tag = SV_EXTERNAL_GRAPHIC
        {
            this.external_graphic(r.nic as pointer[GraphicNICRec], r.dnic)
            return
        }
        if tag = SV_PAGE_NUMBER
        {
            this.page_number()
            return
        }
        if tag = SV_CUR_NODE_PAGE_NUMBER
        {
            this.current_node_page_number(r.node)
            return
        }
        if tag = SV_START_SPS
        {
            this.start_simple_page_sequence()
            return
        }
        if tag = SV_END_SPS_HF
        {
            this.end_simple_page_sequence_header_footer(r.flags)
            return
        }
        if tag = SV_END_ALL_SPS_HF
        {
            this.end_all_simple_page_sequence_header_footer()
            return
        }
        if tag = SV_END_SPS
        {
            this.end_simple_page_sequence()
            return
        }
        if tag = SV_START_TABLE
        {
            this.start_table(r.nic as pointer[TableNICRec], r.dnic)
            return
        }
        if tag = SV_END_TABLE
        {
            this.end_table()
            return
        }
        if tag = SV_START_TP_SERIAL
        {
            this.start_table_part_serial(r.dnic)
            return
        }
        if tag = SV_END_TP_SERIAL
        {
            this.end_table_part_serial()
            return
        }
        if tag = SV_START_TP_HEADER
        {
            this.start_table_part_header()
            return
        }
        if tag = SV_END_TP_HEADER
        {
            this.end_table_part_header()
            return
        }
        if tag = SV_START_TP_FOOTER
        {
            this.start_table_part_footer()
            return
        }
        if tag = SV_END_TP_FOOTER
        {
            this.end_table_part_footer()
            return
        }
        if tag = SV_TABLE_COLUMN
        {
            this.table_column(r.nic as pointer[TableColumnNICRec])
            return
        }
        if tag = SV_START_TABLE_ROW
        {
            this.start_table_row()
            return
        }
        if tag = SV_END_TABLE_ROW
        {
            this.end_table_row()
            return
        }
        if tag = SV_START_TABLE_CELL
        {
            this.start_table_cell(r.nic as pointer[TableCellNICRec])
            return
        }
        if tag = SV_END_TABLE_CELL
        {
            this.end_table_cell()
            return
        }
        if tag = SV_TABLE_BEFORE_ROW_BORDER
        {
            this.table_before_row_border()
            return
        }
        if tag = SV_TABLE_AFTER_ROW_BORDER
        {
            this.table_after_row_border()
            return
        }
        if tag = SV_TABLE_BEFORE_COLUMN_BORDER
        {
            this.table_before_column_border()
            return
        }
        if tag = SV_TABLE_AFTER_COLUMN_BORDER
        {
            this.table_after_column_border()
            return
        }
        if tag = SV_CELL_BEFORE_ROW_BORDER
        {
            this.table_cell_before_row_border()
            return
        }
        if tag = SV_CELL_AFTER_ROW_BORDER
        {
            this.table_cell_after_row_border()
            return
        }
        if tag = SV_CELL_BEFORE_COLUMN_BORDER
        {
            this.table_cell_before_column_border()
            return
        }
        if tag = SV_CELL_AFTER_COLUMN_BORDER
        {
            this.table_cell_after_column_border()
            return
        }
    }

    ; --- the forwarded surface -------------------------------------------------
    function set_ic(this: pointer[FotSink], ic: pointer[InheritedC])
    {
        if this.save <> null
        {
            this.save.record_set_ic(ic)
            return
        }
        if this.sgml <> null
            this.sgml.set_ic(ic)
        else
            this.rtf.set_ic(ic)
    }

    function characters(this: pointer[FotSink], s: pointer[u32], n: size_t)
    {
        if this.save <> null
        {
            this.save.record_characters(s, n)
            return
        }
        if this.sgml <> null
            this.sgml.characters(s, n)
        else
            this.rtf.characters(s, n)
    }

    function characters_from_node(this: pointer[FotSink], node: pointer[GroveNode], s: pointer[u32], n: size_t)
    {
        if this.save <> null
        {
            this.save.record_chars_from_node(node, s, n)
            return
        }
        if this.sgml <> null
            this.sgml.characters_from_node(node, s, n)
        else
            this.rtf.characters_from_node(node, s, n)
    }

    function start_node(this: pointer[FotSink], node: pointer[GroveNode], mode_name: StringC)
    {
        if this.save <> null
        {
            this.save.record_start_node(node, mode_name)
            return
        }
        if this.sgml <> null
            this.sgml.start_node(node, mode_name)
        else
            this.rtf.start_node(node, mode_name)
    }

    function end_node(this: pointer[FotSink])
    {
        if this.save <> null
        {
            this.save.record0(SV_END_NODE)
            return
        }
        if this.sgml <> null
            this.sgml.end_node()
        else
            this.rtf.end_node()
    }

    function start_sequence(this: pointer[FotSink])
    {
        if this.save <> null
        {
            this.save.record0(SV_START_SEQUENCE)
            return
        }
        if this.sgml <> null
            this.sgml.start_sequence()
        else
            this.rtf.start_sequence()
    }

    function end_sequence(this: pointer[FotSink])
    {
        if this.save <> null
        {
            this.save.record0(SV_END_SEQUENCE)
            return
        }
        if this.sgml <> null
            this.sgml.end_sequence()
        else
            this.rtf.end_sequence()
