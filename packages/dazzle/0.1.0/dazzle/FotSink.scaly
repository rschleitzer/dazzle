    ; --- the TRANSFORM backend's own leaf calls --------------------------------
    ; The eleven methods TransformFOTBuilder overrides that no print backend
    ; declares at all. In the reference these are the SGML-transformation
    ; extension flow objects (TransformFOTBuilder.cxx:203-215); under `-t fot`
    ; and friends their classes bind as UnknownFlowObj, so a print sink can
    ; never reach one — and if it did, the FOTBuilder base would do nothing,
    ; which is exactly what these do with all five print slots null.
    function start_element(this: ref[FotSink], gi: StringC, atts: pointer[Array[StringC]])
    {
        if this.save <> null
        {
            this.save.record_element(SV_START_ELEMENT, gi, atts)
            return
        }
        if this.transform <> null
            this.transform.start_element(gi, atts)
    }

    function end_element(this: ref[FotSink])
    {
        if this.save <> null
        {
            this.save.record0(SV_END_ELEMENT)
            return
        }
        if this.transform <> null
            this.transform.end_element()
    }

    function empty_element(this: ref[FotSink], gi: StringC, atts: pointer[Array[StringC]])
    {
        if this.save <> null
        {
            this.save.record_element(SV_EMPTY_ELEMENT, gi, atts)
            return
        }
        if this.transform <> null
            this.transform.empty_element(gi, atts)
    }

