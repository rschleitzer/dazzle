    ; the per-part header/footer bracket OPEN (SerialFOTBuilder::
    ; startSimplePageSequenceHeaderFooter(k) — start() in the base, a no-op in
    ; the fot/rtf/tex ports whose part handling is driven by the close hook).
    function start_simple_page_sequence_header_footer(this: ref[FotSink], flags: int)
    {
        if this.save <> null
        {
            this.save.record_flags(SV_START_SPS_HF, flags)
            return
        }
        if this.html <> null
            this.html.start_simple_page_sequence_header_footer(flags)
        else if this.mif <> null
            this.mif.start_simple_page_sequence_header_footer(flags)
    }

    ; --- the INLINE/MARK family -------------------------------------------------
    ; Only the fot dump and (for the first three) the TeX backend override
    ; these; rtf/html/mif/transform inherit the FOTBuilder base, whose
    ; `character` ALSO EMITS THE CHARACTER as text before the atomic bracket
    ; (FOTBuilder.cxx:174 — measured: `-t rtf` and `-t sgml` both render
    ; `(make character char: #\A)` as an "A"). rtf/html/mif spell that base out
    ; in their own `character`; the transform arm does it here.
    function character(this: ref[FotSink], nic: ref[CharacterNICRec])
    {
        if this.save <> null
        {
            this.save.record_character(nic)
            return
        }
        if this.sgml <> null
            this.sgml.character(nic)
        else if this.tex <> null
            this.tex.character(nic)
        else if this.rtf <> null
            this.rtf.character(nic)
        else if this.html <> null
            this.html.character(nic)
        else if this.mif <> null
            this.mif.character(nic)
        else if this.transform <> null
        {
            if nic <> null
            {
                if nic.valid
                {
                    var cbuf u32[1]
                    set *(cbuf as pointer[u32]): nic.ch
                    this.transform.characters(cbuf as pointer[u32], 1)
                }
            }
        }
    }

