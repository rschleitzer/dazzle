    {
        if this.save <> null
        {
            this.save.record_document_type(name, public_id, system_id)
            return
        }
        if this.transform <> null
            this.transform.document_type(name, public_id, system_id)
    }

    ; `formatting-instruction` is the ONE extension class jade.cxx installs for
    ; every backend, so a print sink really can reach this — and there the
    ; FOTBuilder base is a no-op (measured: `-t fot` renders nothing for it).
    function formatting_instruction(this: ref[FotSink], data: StringC)
    {
        if this.save <> null
        {
            this.save.record_str(SV_FORMATTING_INSTRUCTION, data)
            return
        }
        if this.transform <> null
            this.transform.formatting_instruction(data)
    }

    function start_directory(this: ref[FotSink], path: StringC)
    {
        if this.save <> null
        {
            this.save.record_str(SV_START_DIRECTORY, path)
            return
        }
        if this.transform <> null
            this.transform.start_directory(path)
    }

    function end_directory(this: ref[FotSink])
    {
        if this.save <> null
        {
            this.save.record0(SV_END_DIRECTORY)
            return
        }
        if this.transform <> null
            this.transform.end_directory()
    }

}
