; FotSink — the backend dispatch seam (design note "RtfFOTBuilder
; (`-t rtf`)"). ProcessContext's call sites talk to exactly one sink; this
; record tags which backend is live and forwards each call once.
;
; ALL SIX backends live here, the TransformFOTBuilder included (work package
; 23). The reference has no seam at all — `TransformFOTBuilder` is a plain
; `SerialFOTBuilder` subclass like the other five, so `FlowObj::process` runs
; ONE dispatch for every backend and the ports, connections, style stack and
; serial decomposition all apply to `-t sgml`/`-t xml` exactly as they do to
; the print backends. Only the LEAF calls differ, and the transform builder
; overrides just nineteen of them (TransformFOTBuilder.cxx:203-221); everything
; else is the FOTBuilder base, i.e. nothing. That is why every forwarding chain
; below ends in `else if this.mif <> null` rather than a bare `else`: a
; transform-only sink must be a silent no-op wherever the reference base class
; is one.
;
; Port/connection capture happens HERE (the reference currentFOTBuilder()
; seam): while `save` is set, every call is recorded onto that queue instead
; of reaching the backend (SaveFOTBuilder.scaly). emit_saved replays a queue
; through the sink — if the sink is capturing at replay time the calls simply
; re-record onto the outer queue (the reference emit-into-SaveFOTBuilder
; splice). emit_saved_into targets a specific queue (endConnection's
; save-queue flush into the port's builder).

use scaly.memory.Page
use opensp.StringC.StringC
use dazzle.Grove.GroveNode
use dazzle.Style.InheritedC
use dazzle.Style.DisplayNIC
use dazzle.Style.RuleNICRec
use dazzle.Style.LinkNICRec
use dazzle.Style.GraphicNICRec
use dazzle.Style.LeaderNICRec
use dazzle.Style.BoxNICRec
use dazzle.Style.ScoreNICRec
use dazzle.Style.TableNICRec
use dazzle.Style.TableColumnNICRec
use dazzle.Style.TableCellNICRec
use dazzle.SgmlFOTBuilder.SgmlFOTBuilder
use dazzle.RtfFOTBuilder.RtfFOTBuilder
use dazzle.TeXFOTBuilder.TeXFOTBuilder
use dazzle.HtmlFOTBuilder.HtmlFOTBuilder
use dazzle.MifFOTBuilder.MifFOTBuilder
use dazzle.TransformFOTBuilder.TransformFOTBuilder
use scaly.containers.Array
use dazzle.Style.PageFloatNICRec
use dazzle.Style.IndexEntryNICRec
use dazzle.Style.LineFieldNICRec
use dazzle.Style.CharacterNICRec
use dazzle.Style.AnchorNICRec
use dazzle.Style.GlyphAnnotationNICRec
use dazzle.Style.EmphasizingMarkNICRec
use dazzle.Style.GridNICRec
use dazzle.Style.GridCellNICRec
use dazzle.Style.EmbeddedTextNICRec
use dazzle.Style.IncludedContainerAreaNICRec
use dazzle.Style.MultiModeRec
use dazzle.Style.MultiModeNICRec
use dazzle.SaveFOTBuilder.SaveFOTBuilder
use dazzle.SaveFOTBuilder.SaveCallRec
use dazzle.SaveFOTBuilder.SaveElementRec
use dazzle.SaveFOTBuilder.SaveDocTypeRec

define FotSink (sgml: ref[SgmlFOTBuilder]?, rtf: ref[RtfFOTBuilder]?, tex: ref[TeXFOTBuilder]?, html: ref[HtmlFOTBuilder]?, mif: ref[MifFOTBuilder]?, transform: ref[TransformFOTBuilder]?, save: ref[SaveFOTBuilder]?)
{
    function make_sgml(host: pointer[Page], sgml: ref[SgmlFOTBuilder]) returns ref[FotSink]
    {
        let s host.allocate(sizeof FotSink, alignof FotSink) as pointer[FotSink]
        set s.sgml: sgml
        set s.rtf: null
        set s.tex: null
        set s.html: null
        set s.mif: null
        set s.transform: null
        set s.save: null
        s
    }

    function make_rtf(host: pointer[Page], rtf: ref[RtfFOTBuilder]) returns ref[FotSink]
    {
        let s host.allocate(sizeof FotSink, alignof FotSink) as pointer[FotSink]
        set s.sgml: null
        set s.rtf: rtf
        set s.tex: null
        set s.html: null
        set s.mif: null
        set s.transform: null
        set s.save: null
        s
    }

    function make_tex(host: pointer[Page], tex: ref[TeXFOTBuilder]) returns ref[FotSink]
    {
        let s host.allocate(sizeof FotSink, alignof FotSink) as pointer[FotSink]
        set s.sgml: null
        set s.rtf: null
        set s.tex: tex
        set s.html: null
        set s.mif: null
        set s.transform: null
        set s.save: null
        s
    }

    function make_html(host: pointer[Page], html: ref[HtmlFOTBuilder]) returns ref[FotSink]
    {
        let s host.allocate(sizeof FotSink, alignof FotSink) as pointer[FotSink]
        set s.sgml: null
        set s.rtf: null
        set s.tex: null
        set s.html: html
        set s.mif: null
        set s.transform: null
        set s.save: null
        s
    }

    function make_mif(host: pointer[Page], mif: ref[MifFOTBuilder]) returns ref[FotSink]
    {
        let s host.allocate(sizeof FotSink, alignof FotSink) as pointer[FotSink]
        set s.sgml: null
        set s.rtf: null
        set s.tex: null
        set s.html: null
        set s.mif: mif
        set s.transform: null
        set s.save: null
        s
    }

    ; the transform backend (`-t sgml` / `-t xml`). It answers only the
    ; nineteen calls TransformFOTBuilder overrides; every other method finds
    ; all five print slots null and does nothing, which IS the FOTBuilder base.
    function make_transform(host: pointer[Page], transform: ref[TransformFOTBuilder]) returns ref[FotSink]
    {
        let s host.allocate(sizeof FotSink, alignof FotSink) as pointer[FotSink]
        set s.sgml: null
        set s.rtf: null
        set s.tex: null
        set s.html: null
        set s.mif: null
        set s.transform: transform
        set s.save: null
        s
    }

    ; --- the capture seam ----------------------------------------------------
    procedure set_save(this: ref[FotSink], q: ref[SaveFOTBuilder])
        set this.save: q

    function get_save(this: ref[FotSink]) returns ref[SaveFOTBuilder]
        save

    ; replay a recorded queue through this sink (SaveFOTBuilder::emit). The
    ; ctor-node form wraps the replay in startNode/endNode on the TARGET —
    ; recorded again if the sink is currently capturing (reference splice
    ; semantics).
    procedure emit_saved(this: ref[FotSink], q: ref[SaveFOTBuilder])
    {
        if q = null
            return
        if q.node <> null
            this.start_node(q.node, q.mode_name)
        var r q.head
        while r <> null
        {
            this.emit_one(r)
            set r: r.next
        }
        if q.node <> null
            this.end_node()
    }

    ; replay a queue INTO another queue (endConnection: saved->emit(*port->fotb)).
    procedure emit_saved_into(this: ref[FotSink], q: ref[SaveFOTBuilder], dst: ref[SaveFOTBuilder])
    {
        let old this.save
        set this.save: dst
        this.emit_saved(q)
        set this.save: old
    }

    procedure emit_one(this: ref[FotSink], r: ref[SaveCallRec])
    {
        let tag r.tag
        if tag = SV_SET_IC
        {
            this.set_ic(r.ic)
            return
        }
        if tag = SV_CHARACTERS
        {
            this.characters(r.data, r.n)
            return
        }
        if tag = SV_CHARS_FROM_NODE
        {
            this.characters_from_node(r.node, r.data, r.n)
            return
        }
        if tag = SV_START_NODE
        {
            this.start_node(r.node, r.str)
            return
        }
        if tag = SV_END_NODE
        {
            this.end_node()
            return
        }
        if tag = SV_START_SEQUENCE
        {
            this.start_sequence()
            return
        }
        if tag = SV_END_SEQUENCE
        {
            this.end_sequence()
            return
        }
        if tag = SV_START_PARAGRAPH
        {
            this.start_paragraph(r.dnic)
