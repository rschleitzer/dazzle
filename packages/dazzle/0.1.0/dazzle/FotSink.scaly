        if tag = SV_START_SCROLL
        {
            this.start_scroll()
            return
        }
        if tag = SV_END_SCROLL
        {
            this.end_scroll()
            return
        }
        if tag = SV_START_SPS_HF
        {
            this.start_simple_page_sequence_header_footer(r.flags)
            return
        }
        if tag = SV_START_PAGE_FLOAT
        {
            this.start_page_float(r.nic as pointer[PageFloatNICRec])
