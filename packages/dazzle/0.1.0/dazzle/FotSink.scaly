; FotSink — the styled-backend dispatch seam (design note "RtfFOTBuilder
; (`-t rtf`)"). ProcessContext's styled call sites talk to exactly one sink;
; this record tags which backend is live (fot's SgmlFOTBuilder or the
; RtfFOTBuilder) and forwards each call once. The transform backend keeps its
; own separate slot in ProcessContext (untouched — Family A byte-safety).

use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use dazzle.Grove.GroveNode
use dazzle.Style.InheritedC
use dazzle.Style.DisplayNIC
use dazzle.Style.RuleNICRec
use dazzle.Style.LinkNICRec
use dazzle.Style.GraphicNICRec
use dazzle.Style.LeaderNICRec
use dazzle.Style.BoxNICRec
use dazzle.Style.ScoreNICRec
use dazzle.Style.TableNICRec
use dazzle.Style.TableColumnNICRec
use dazzle.Style.TableCellNICRec
use dazzle.SgmlFOTBuilder.SgmlFOTBuilder
use dazzle.RtfFOTBuilder.RtfFOTBuilder

define FotSink (sgml: pointer[SgmlFOTBuilder], rtf: pointer[RtfFOTBuilder])
{
    function make_sgml(host: pointer[Page], sgml: pointer[SgmlFOTBuilder]) returns pointer[FotSink]
    {
        let s host.allocate(sizeof FotSink, alignof FotSink) as pointer[FotSink]
        set s.sgml: sgml
        set s.rtf: null
        s
    }

    function make_rtf(host: pointer[Page], rtf: pointer[RtfFOTBuilder]) returns pointer[FotSink]
    {
        let s host.allocate(sizeof FotSink, alignof FotSink) as pointer[FotSink]
        set s.sgml: null
        set s.rtf: rtf
        s
    }

    function set_ic(this: pointer[FotSink], ic: pointer[InheritedC])
    {
        if this.sgml <> null
            this.sgml.set_ic(ic)
        else
            this.rtf.set_ic(ic)
    }

    procedure set_conn_target(this: pointer[FotSink], buf: pointer[Array[u32]])
    {
        if this.sgml <> null
            this.sgml.set_conn_target(buf)
        else
            this.rtf.set_conn_target(buf)
    }

    function get_conn_target(this: pointer[FotSink]) returns pointer[Array[u32]]
    {
        if this.sgml <> null
            return this.sgml.get_conn_target()
        this.rtf.get_conn_target()
    }

    procedure emit_captured(this: pointer[FotSink], buf: pointer[Array[u32]])
    {
        if this.sgml <> null
            this.sgml.emit_captured(buf)
        else
            this.rtf.emit_captured(buf)
    }

    function characters(this: pointer[FotSink], s: pointer[u32], n: size_t)
    {
        if this.sgml <> null
            this.sgml.characters(s, n)
        else
            this.rtf.characters(s, n)
    }

    function characters_from_node(this: pointer[FotSink], node: pointer[GroveNode], s: pointer[u32], n: size_t)
    {
        if this.sgml <> null
            this.sgml.characters_from_node(node, s, n)
        else
            this.rtf.characters_from_node(node, s, n)
    }

    function start_node(this: pointer[FotSink], node: pointer[GroveNode], mode_name: StringC)
    {
        if this.sgml <> null
            this.sgml.start_node(node, mode_name)
        else
            this.rtf.start_node(node, mode_name)
    }

    function end_node(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.end_node()
        else
            this.rtf.end_node()
    }

    function start_sequence(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.start_sequence()
        else
            this.rtf.start_sequence()
    }

    function end_sequence(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.end_sequence()
        else
            this.rtf.end_sequence()
    }

    function start_paragraph(this: pointer[FotSink], nic: pointer[DisplayNIC])
    {
        if this.sgml <> null
            this.sgml.start_paragraph(nic)
        else
            this.rtf.start_paragraph(nic)
    }

    function end_paragraph(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.end_paragraph()
        else
            this.rtf.end_paragraph()
    }

    function paragraph_break(this: pointer[FotSink], nic: pointer[DisplayNIC])
    {
        if this.sgml <> null
            this.sgml.paragraph_break(nic)
        else
            this.rtf.paragraph_break(nic)
    }

    function start_display_group(this: pointer[FotSink], nic: pointer[DisplayNIC])
    {
        if this.sgml <> null
            this.sgml.start_display_group(nic)
        else
            this.rtf.start_display_group(nic)
    }

    function end_display_group(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.end_display_group()
        else
            this.rtf.end_display_group()
    }

    function start_line_field(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.start_line_field()
        else
            this.rtf.start_line_field()
    }

    function end_line_field(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.end_line_field()
        else
            this.rtf.end_line_field()
    }

    function start_leader(this: pointer[FotSink], nic: pointer[LeaderNICRec])
    {
        if this.sgml <> null
            this.sgml.start_leader(nic)
        else
            this.rtf.start_leader(nic)
    }

    function end_leader(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.end_leader()
        else
            this.rtf.end_leader()
    }

    function start_link(this: pointer[FotSink], nic: pointer[LinkNICRec])
    {
        if this.sgml <> null
            this.sgml.start_link(nic)
        else
            this.rtf.start_link(nic)
    }

    function end_link(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.end_link()
        else
            this.rtf.end_link()
    }

    function start_score(this: pointer[FotSink], nic: pointer[ScoreNICRec])
    {
        if this.sgml <> null
            this.sgml.start_score(nic)
        else
            this.rtf.start_score(nic)
    }

    function end_score(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.end_score()
        else
            this.rtf.end_score()
    }

    function start_box(this: pointer[FotSink], nic: pointer[BoxNICRec], dnic: pointer[DisplayNIC])
    {
        if this.sgml <> null
            this.sgml.start_box(nic, dnic)
        else
            this.rtf.start_box(nic, dnic)
    }

    function end_box(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.end_box()
        else
            this.rtf.end_box()
    }

    function rule(this: pointer[FotSink], nic: pointer[RuleNICRec], dnic: pointer[DisplayNIC])
    {
        if this.sgml <> null
            this.sgml.rule(nic, dnic)
        else
            this.rtf.rule(nic, dnic)
    }

    function external_graphic(this: pointer[FotSink], nic: pointer[GraphicNICRec], dnic: pointer[DisplayNIC])
    {
        if this.sgml <> null
            this.sgml.external_graphic(nic, dnic)
        else
            this.rtf.external_graphic(nic, dnic)
    }

    function page_number(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.page_number()
        else
            this.rtf.page_number()
    }

    function current_node_page_number(this: pointer[FotSink], node: pointer[GroveNode])
    {
        if this.sgml <> null
            this.sgml.current_node_page_number(node)
        else
            this.rtf.current_node_page_number(node)
    }

    function start_simple_page_sequence(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.start_simple_page_sequence()
        else
            this.rtf.start_simple_page_sequence()
    }

    function end_simple_page_sequence_header_footer(this: pointer[FotSink], flags: int)
    {
        if this.sgml <> null
            this.sgml.end_simple_page_sequence_header_footer(flags)
        else
            this.rtf.end_simple_page_sequence_header_footer(flags)
    }

    function end_all_simple_page_sequence_header_footer(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.end_all_simple_page_sequence_header_footer()
        else
            this.rtf.end_all_simple_page_sequence_header_footer()
    }

    function end_simple_page_sequence(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.end_simple_page_sequence()
        else
            this.rtf.end_simple_page_sequence()
    }

    function start_table(this: pointer[FotSink], tnic: pointer[TableNICRec], dnic: pointer[DisplayNIC])
    {
        if this.sgml <> null
            this.sgml.start_table(tnic, dnic)
        else
            this.rtf.start_table(tnic, dnic)
    }

    function end_table(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.end_table()
        else
            this.rtf.end_table()
    }

    function start_table_part_serial(this: pointer[FotSink], dnic: pointer[DisplayNIC])
    {
        if this.sgml <> null
            this.sgml.start_table_part_serial(dnic)
        else
            this.rtf.start_table_part_serial(dnic)
    }

    function end_table_part_serial(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.end_table_part_serial()
        else
            this.rtf.end_table_part_serial()
    }

    function start_table_part_header(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.start_table_part_header()
        else
            this.rtf.start_table_part_header()
    }

    function end_table_part_header(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.end_table_part_header()
        else
            this.rtf.end_table_part_header()
    }

    function start_table_part_footer(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.start_table_part_footer()
        else
            this.rtf.start_table_part_footer()
    }

    function end_table_part_footer(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.end_table_part_footer()
        else
            this.rtf.end_table_part_footer()
    }

    function table_column(this: pointer[FotSink], nic: pointer[TableColumnNICRec])
    {
        if this.sgml <> null
            this.sgml.table_column(nic)
        else
            this.rtf.table_column(nic)
    }

    function start_table_row(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.start_table_row()
        else
            this.rtf.start_table_row()
    }

    function end_table_row(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.end_table_row()
        else
            this.rtf.end_table_row()
    }

    function start_table_cell(this: pointer[FotSink], nic: pointer[TableCellNICRec])
    {
        if this.sgml <> null
            this.sgml.start_table_cell(nic)
        else
            this.rtf.start_table_cell(nic)
    }

    function end_table_cell(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.end_table_cell()
        else
            this.rtf.end_table_cell()
    }

    function table_before_row_border(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.table_before_row_border()
        else
            this.rtf.table_before_row_border()
    }

    function table_after_row_border(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.table_after_row_border()
        else
            this.rtf.table_after_row_border()
    }

    function table_before_column_border(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.table_before_column_border()
        else
            this.rtf.table_before_column_border()
    }

    function table_after_column_border(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.table_after_column_border()
        else
            this.rtf.table_after_column_border()
    }

    function table_cell_before_row_border(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.table_cell_before_row_border()
        else
            this.rtf.table_cell_before_row_border()
    }

    function table_cell_after_row_border(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.table_cell_after_row_border()
        else
            this.rtf.table_cell_after_row_border()
    }

    function table_cell_before_column_border(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.table_cell_before_column_border()
        else
            this.rtf.table_cell_before_column_border()
    }

    function table_cell_after_column_border(this: pointer[FotSink])
    {
        if this.sgml <> null
            this.sgml.table_cell_after_column_border()
        else
            this.rtf.table_cell_after_column_border()
    }
}
