    function start_grid(this: ref[MifFOTBuilder], nic: ref[GridNICRec])
        this.mif_start()

    function end_grid(this: ref[MifFOTBuilder])
        this.mif_end()

    function start_grid_cell(this: ref[MifFOTBuilder], nic: ref[GridCellNICRec])
        this.mif_start()

    function end_grid_cell(this: ref[MifFOTBuilder])
        this.mif_end()


    ; --- the LAYOUT-COMPOSITE family --------------------------------------------
    ; The MIF backend overrides none of the five, so the plain FOTBuilder
    ; brackets apply: every start*/end* pair is start()/end().
    function start_embedded_text(this: ref[MifFOTBuilder], nic: ref[EmbeddedTextNICRec])
        this.mif_start()

    function end_embedded_text(this: ref[MifFOTBuilder])
        this.mif_end()

    function start_included_container_area(this: ref[MifFOTBuilder], nic: ref[IncludedContainerAreaNICRec], dnic: ref[DisplayNIC])
        this.mif_start()

    function end_included_container_area(this: ref[MifFOTBuilder])
        this.mif_end()

    function start_side_by_side(this: ref[MifFOTBuilder], dnic: ref[DisplayNIC])
        this.mif_start()

    function end_side_by_side(this: ref[MifFOTBuilder])
        this.mif_end()

    function start_side_by_side_item(this: ref[MifFOTBuilder])
        this.mif_start()

    function end_side_by_side_item(this: ref[MifFOTBuilder])
