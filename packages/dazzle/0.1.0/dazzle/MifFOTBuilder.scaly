    function copy(this: ref[MifCrossRefInfo], host: ref[Page]) returns ref[MifCrossRefInfo]
        MifCrossRefInfo.make(host, this.cri_type, this.grove_index, this.element_index, this.tag_indent, this.sgml_id)
}

