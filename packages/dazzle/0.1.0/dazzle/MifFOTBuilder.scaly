; --- MifOS: MifOutputByteStream — a byte sink plus the CurTagIndent cursor.
; Several MifOS views can share one byte array (the reference constructs a
; fresh MifOutputByteStream with indent 0 over a stream at commit time). ----
define MifOS (b: ref[Array[u8]], ind: int)
{
    function make(host: ref[Page], b: ref[Array[u8]], ind: int) returns ref[MifOS]
    {
        let o host.allocate(sizeof MifOS, alignof MifOS) as pointer[MifOS]
        set o.b: b
        set o.ind: ind
        o
    }

    procedure put(this: ref[MifOS], c: u8)
        this.b.add(c)

    procedure raw(this: ref[MifOS], s: pointer[const_char])
    {
        var i: size_t 0
        while true
        {
            let c *((s as pointer[u8]) + i)
            if c = 0
                break
            this.b.add(c)
            set i: i + 1
        }
    }

    ; the raw bytes of a String<char>-valued property (T_keyword prints bare)
    procedure str(this: ref[MifOS], s: String)
    {
        let n s.get_length()
        if n = 0
            return
        let p s.get_buffer()
        var i: size_t 0
        while i < n
        {
            this.b.add(*(p + i))
            set i: i + 1
        }
    }

    ; T_string / T_tagstring / T_pathname: backtick + bytes + apostrophe
    procedure tstr(this: ref[MifOS], s: String)
    {
        this.b.add(0x60)
        this.str(s)
        this.b.add(0x27)
    }

    procedure indent(this: ref[MifOS])
        set this.ind: this.ind + 2

    procedure undent(this: ref[MifOS])
        set this.ind: this.ind - 2

    ; `os << '\n' << MifOutputByteStream::INDENT`
    procedure nlind(this: ref[MifOS])
    {
        this.b.add(0x0A)
        var k this.ind
        while k > 0
        {
            this.b.add(0x20)
            set k: k - 1
        }
    }

    procedure udec(this: ref[MifOS], n_in: int)
    {
        var n n_in
        if n = 0
        {
            this.b.add(0x30)
            return
        }
        var digits u8[24]
        var k 0
        while n > 0
        {
            set *((digits as pointer[u8]) + k): ((n % 10) + 0x30) as u8
            set n: n / 10
            set k: k + 1
        }
        while k > 0
        {
            set k: k - 1
            this.b.add(*((digits as pointer[u8]) + k))
        }
    }

    procedure num(this: ref[MifOS], n: int)
    {
        if n < 0
        {
            this.b.add(0x2D)
            this.udec(0 - n)
            return
        }
        this.udec(n)
    }

    ; T_dimension: sprintf("%li.%.3i", d/1000, abs(d%1000)) with the trailing
    ; zeros (and a bare trailing '.') stripped, then "pt". Values in
    ; (-1000, 0) lose their sign because the integer part prints as 0 —
    ; faithful to the reference.
    procedure dim(this: ref[MifOS], d: int)
    {
        var buf u8[48]
        var n 0
        var q d / 1000
        var r d % 1000
        if r < 0
            set r: 0 - r
        if q < 0
        {
            set *((buf as pointer[u8]) + n): 0x2D
            set n: n + 1
            set q: 0 - q
        }
        if q = 0
        {
            set *((buf as pointer[u8]) + n): 0x30
            set n: n + 1
        }
        else
        {
            var tmp u8[24]
            var k 0
            var qq q
            while qq > 0
            {
                set *((tmp as pointer[u8]) + k): ((qq % 10) + 0x30) as u8
                set qq: qq / 10
                set k: k + 1
            }
            while k > 0
            {
                set k: k - 1
                set *((buf as pointer[u8]) + n): *((tmp as pointer[u8]) + k)
                set n: n + 1
            }
        }
        set *((buf as pointer[u8]) + n): 0x2E
        set n: n + 1
        set *((buf as pointer[u8]) + n): (((r / 100) % 10) + 0x30) as u8
        set n: n + 1
        set *((buf as pointer[u8]) + n): (((r / 10) % 10) + 0x30) as u8
        set n: n + 1
        set *((buf as pointer[u8]) + n): ((r % 10) + 0x30) as u8
        set n: n + 1
        var i n - 1
        while *((buf as pointer[u8]) + i) = 0x30
            set i: i - 1
        if *((buf as pointer[u8]) + i) = 0x2E
            set i: i - 1
        var j 0
        while j <= i
        {
            this.b.add(*((buf as pointer[u8]) + j))
            set j: j + 1
        }
        this.raw("pt")
    }

    ; T_percentage: sprintf("%.6f")
    procedure pct(this: ref[MifOS], x: double)
    {
        var v x
        var neg false
        if v < 0.0
        {
            set neg: true
            set v: 0.0 - v
        }
        var ip v as int
        let frac v - (ip as double)
        var f6 ((frac * 1000000.0) + 0.5) as int
        if f6 >= 1000000
        {
            set f6: f6 - 1000000
            set ip: ip + 1
        }
        if neg
            this.b.add(0x2D)
        this.udec(ip)
        this.b.add(0x2E)
        var div 100000
        var k 0
        while k < 6
        {
            this.b.add((((f6 / div) % 10) + 0x30) as u8)
            set div: div / 10
            set k: k + 1
        }
    }

    procedure boolyn(this: ref[MifOS], v: bool)
    {
        if v
            this.raw("Yes")
        else
            this.raw("No")
    }

    procedure sp(this: ref[MifOS])
        this.b.add(0x20)

    procedure ltrb(this: ref[MifOS], l: int, t: int, r: int, b2: int)
    {
        this.dim(l)
        this.sp()
        this.dim(t)
        this.sp()
        this.dim(r)
        this.sp()
        this.dim(b2)
    }

    procedure two(this: ref[MifOS], a: int, b2: int)
    {
        this.dim(a)
        this.sp()
        this.dim(b2)
    }

    ; `<Name ` … `>` at the current indent
    procedure open_prop(this: ref[MifOS], name: pointer[const_char])
    {
        this.nlind()
        this.b.add(0x3C)
        this.raw(name)
        this.b.add(0x20)
    }

    procedure close_prop(this: ref[MifOS])
        this.b.add(0x3E)

    procedure p_dim(this: ref[MifOS], name: pointer[const_char], v: int)
    {
        this.open_prop(name)
        this.dim(v)
        this.close_prop()
    }

    procedure p_num(this: ref[MifOS], name: pointer[const_char], v: int)
    {
        this.open_prop(name)
        this.num(v)
        this.close_prop()
    }

    procedure p_udec(this: ref[MifOS], name: pointer[const_char], v: int)
    {
        this.open_prop(name)
        this.udec(v)
        this.close_prop()
    }

    procedure p_kw(this: ref[MifOS], name: pointer[const_char], v: String)
    {
        this.open_prop(name)
        this.str(v)
        this.close_prop()
    }

    procedure p_tstr(this: ref[MifOS], name: pointer[const_char], v: String)
    {
        this.open_prop(name)
        this.tstr(v)
        this.close_prop()
    }

    procedure p_bool(this: ref[MifOS], name: pointer[const_char], v: bool)
    {
        this.open_prop(name)
        this.boolyn(v)
        this.close_prop()
    }

    procedure p_pct(this: ref[MifOS], name: pointer[const_char], v: double)
    {
        this.open_prop(name)
        this.pct(v)
        this.close_prop()
    }

    procedure p_ltrb(this: ref[MifOS], name: pointer[const_char], l: int, t: int, r: int, b2: int)
    {
        this.open_prop(name)
        this.ltrb(l, t, r, b2)
        this.close_prop()
    }

    procedure p_two(this: ref[MifOS], name: pointer[const_char], a: int, b2: int)
    {
        this.open_prop(name)
        this.two(a, b2)
        this.close_prop()
    }

    ; `<Name ` … open a nested statement and indent
    procedure begin_stmt(this: ref[MifOS], name: pointer[const_char])
    {
        this.nlind()
        this.b.add(0x3C)
        this.raw(name)
        this.b.add(0x20)
        this.indent()
    }

    procedure end_stmt(this: ref[MifOS])
    {
        this.undent()
        this.nlind()
        this.b.add(0x3E)
    }
}

; --- MifTmp: MifTmpOutputByteStream — the per-tag-stream content buffer ----
define MifTmp (b: ref[Array[u8]], os: ref[MifOS])
{
    function make(host: ref[Page], ind: int) returns ref[MifTmp]
    {
        let t host.allocate(sizeof MifTmp, alignof MifTmp) as pointer[MifTmp]
        let bytes Array[u8]^host()
        set t.b: bytes
        set t.os: MifOS.make(host, bytes, ind)
        t
    }

    function is_empty(this: ref[MifTmp]) returns bool
        b.get_length() = 0
}

; --- MifTabStop ------------------------------------------------------------
define MifTabStop (set_props: int, tsx: int, ts_type: String, ts_leader: String, ts_decimal: int)
{
    function make(host: ref[Page], ts_type: String, tsx: int, leader: String) returns ref[MifTabStop]
    {
        let t host.allocate(sizeof MifTabStop, alignof MifTabStop) as pointer[MifTabStop]
        set t.tsx: tsx
        set t.ts_type: ts_type
        set t.ts_decimal: 0
        set t.set_props: MIF_TS_TYPE | MIF_TS_X
        set t.ts_leader: leader
        set t.set_props: t.set_props | MIF_TS_LEADERSTR
        t
    }

    procedure out(this: ref[MifTabStop], os: ref[MifOS])
    {
        os.begin_stmt("TabStop")
        if (this.set_props & MIF_TS_X) <> 0
            os.p_dim("TSX", this.tsx)
        if (this.set_props & MIF_TS_TYPE) <> 0
            os.p_kw("TSType", this.ts_type)
        if (this.set_props & MIF_TS_LEADERSTR) <> 0
            os.p_tstr("TSLeaderStr", this.ts_leader)
        if (this.set_props & MIF_TS_DECIMALCHAR) <> 0
            os.p_num("TSDecimalChar", this.ts_decimal)
        os.end_stmt()
    }
}

; --- MifFormat: FontFormat + ParagraphFormat + MifFOTBuilder::Format -------
define MifFormat
(
    ff_set: int
    f_family: String
    f_angle: String
    f_weight: String
    f_var: String
    f_size: int
    f_color: String
    f_underlining: String
    f_overline: bool
    f_strike: bool
    f_position: String
    f_pair_kern: bool
    f_case: String
    f_dx: double
    f_dy: double
    f_dw: double
    pf_set: int
    pgf_tag: String
    pgf_findent: int
    pgf_lindent: int
    pgf_rindent: int
    pgf_alignment: String
    pgf_sp_before: int
    pgf_sp_after: int
    pgf_line_spacing: String
    pgf_leading: int
    pgf_num_tabs: int
    tab_stops: ref[Array[ref[MifTabStop]?]]
    pgf_placement: String
    pgf_placement_style: String
    pgf_with_prev: bool
    pgf_with_next: bool
    pgf_block_size: int
    pgf_auto_num: bool
    pgf_num_format: String
    pgf_number_font: String
    pgf_hyphenate: bool
    hyphen_max_lines: int
    hyphen_min_prefix: int
    hyphen_min_suffix: int
    hyphen_min_word: int
    pgf_letter_space: bool
    pgf_language: String
    pgf_cell_alignment: String
    pgf_cm_l: int
    pgf_cm_t: int
    pgf_cm_r: int
    pgf_cm_b: int
    pgf_cell_l_fixed: bool
    pgf_cell_t_fixed: bool
    pgf_cell_r_fixed: bool
    pgf_cell_b_fixed: bool
    ; --- MifFOTBuilder::Format: the FOT-side snapshot -----------------------
    fot_first_line_start_indent: LengthSpec
    fot_start_indent: LengthSpec
    fot_end_indent: LengthSpec
    fot_line_spacing: LengthSpec
    fot_position_point_shift: LengthSpec
    fot_field_width: LengthSpec
    fot_min_leading_has: bool
    fot_cur_display_size: int
    fot_line_thickness: int
    fot_line_cap: int
    fot_border_priority: int
    fot_border_present: bool
    fot_line_repeat: int
    fot_line_sep: int
    fot_display_alignment: int
    fot_left_margin: int
    fot_right_margin: int
    fot_top_margin: int
    fot_bottom_margin: int
    fot_header_margin: int
    fot_footer_margin: int
    fot_page_width: int
    fot_page_height: int
    fot_field_align: int
    fot_input_whitespace: int
    fot_lines: int
    fot_page_n_columns: int
    fot_page_column_sep: int
    fot_span: int
    fot_page_balance: bool
    fot_cell_background: bool
    mif_background_color: String
    fot_language: int
    fot_country: int
)
{
    ; the reference Format ctor's member initialiser list
    function make(host: ref[Page]) returns ref[MifFormat]
    {
        let f host.allocate(sizeof MifFormat, alignof MifFormat) as pointer[MifFormat]
        set f.ff_set: 0
        set f.f_family: String()
        set f.f_angle: String()
        set f.f_weight: String()
        set f.f_var: String()
        set f.f_size: 0
        set f.f_color: String()
        set f.f_underlining: String()
        set f.f_overline: false
        set f.f_strike: false
        set f.f_position: String()
        set f.f_pair_kern: false
        set f.f_case: String()
        set f.f_dx: 0.0
        set f.f_dy: 0.0
        set f.f_dw: 0.0
        set f.pf_set: 0
        set f.pgf_tag: String()
        set f.pgf_findent: 0
        set f.pgf_lindent: 0
        set f.pgf_rindent: 0
        set f.pgf_alignment: String()
        set f.pgf_sp_before: 0
        set f.pgf_sp_after: 0
        set f.pgf_line_spacing: String()
        set f.pgf_leading: 0
        set f.pgf_num_tabs: 0
        set f.tab_stops: Array[ref[MifTabStop]?]^host()
        set f.pgf_placement: String()
        set f.pgf_placement_style: String()
        set f.pgf_with_prev: false
        set f.pgf_with_next: false
        set f.pgf_block_size: 0
        set f.pgf_auto_num: false
        set f.pgf_num_format: String()
        set f.pgf_number_font: String()
        set f.pgf_hyphenate: false
        set f.hyphen_max_lines: 0
        set f.hyphen_min_prefix: 0
        set f.hyphen_min_suffix: 0
        set f.hyphen_min_word: 0
        set f.pgf_letter_space: false
        set f.pgf_language: String()
        set f.pgf_cell_alignment: String()
        set f.pgf_cm_l: 0
        set f.pgf_cm_t: 0
        set f.pgf_cm_r: 0
        set f.pgf_cm_b: 0
        set f.pgf_cell_l_fixed: false
        set f.pgf_cell_t_fixed: false
        set f.pgf_cell_r_fixed: false
        set f.pgf_cell_b_fixed: false
        set f.fot_first_line_start_indent: LengthSpec()
        set f.fot_start_indent: LengthSpec()
        set f.fot_end_indent: LengthSpec()
        var lsp LengthSpec()
        set lsp.length: 12000
        set f.fot_line_spacing: lsp
        set f.fot_position_point_shift: LengthSpec()
        set f.fot_field_width: LengthSpec()
        set f.fot_min_leading_has: false
        set f.fot_cur_display_size: 0
        set f.fot_line_thickness: 1000
        set f.fot_line_cap: MIF_SYM_BUTT
        set f.fot_border_priority: 0
        set f.fot_border_present: true
        set f.fot_line_repeat: 1
        set f.fot_line_sep: 1000
        set f.fot_display_alignment: MIF_SYM_START
        set f.fot_left_margin: 1
        set f.fot_right_margin: 1
        set f.fot_top_margin: 0
        set f.fot_bottom_margin: 0
        set f.fot_header_margin: 0
        set f.fot_footer_margin: 0
        set f.fot_page_width: 72000 * 8
        set f.fot_page_height: (72000 * 23) / 2
        set f.fot_field_align: MIF_SYM_START
        set f.fot_input_whitespace: MIF_SYM_PRESERVE
        set f.fot_lines: MIF_SYM_WRAP
        set f.fot_page_n_columns: 1
        set f.fot_page_column_sep: 72000 / 2
        set f.fot_span: 1
        set f.fot_page_balance: false
        set f.fot_cell_background: false
        set f.mif_background_color: String()
        set f.fot_language: 0
        set f.fot_country: 0
        f
    }

    ; the FontFormat + ParagraphFormat slice (`ParagraphFormat = Format`)
    procedure copy_pf(host: ref[Page], dst: ref[MifFormat], src: ref[MifFormat])
    {
        set dst.ff_set: src.ff_set
        set dst.f_family: src.f_family
        set dst.f_angle: src.f_angle
        set dst.f_weight: src.f_weight
        set dst.f_var: src.f_var
        set dst.f_size: src.f_size
        set dst.f_color: src.f_color
        set dst.f_underlining: src.f_underlining
        set dst.f_overline: src.f_overline
        set dst.f_strike: src.f_strike
        set dst.f_position: src.f_position
        set dst.f_pair_kern: src.f_pair_kern
        set dst.f_case: src.f_case
        set dst.f_dx: src.f_dx
        set dst.f_dy: src.f_dy
        set dst.f_dw: src.f_dw
        set dst.pf_set: src.pf_set
        set dst.pgf_tag: src.pgf_tag
        set dst.pgf_findent: src.pgf_findent
        set dst.pgf_lindent: src.pgf_lindent
        set dst.pgf_rindent: src.pgf_rindent
        set dst.pgf_alignment: src.pgf_alignment
        set dst.pgf_sp_before: src.pgf_sp_before
        set dst.pgf_sp_after: src.pgf_sp_after
        set dst.pgf_line_spacing: src.pgf_line_spacing
        set dst.pgf_leading: src.pgf_leading
        set dst.pgf_num_tabs: src.pgf_num_tabs
        ; Vector<TabStop> is a VALUE member: every copy owns its own list
        let fresh Array[ref[MifTabStop]?]^host()
        let n src.tab_stops.get_length()
        var i: size_t 0
        while i < n
        {
            let sp src.tab_stops.get(i)
            if sp <> null
                fresh.add(*sp)
            set i: i + 1
        }
        set dst.tab_stops: fresh
        set dst.pgf_placement: src.pgf_placement
        set dst.pgf_placement_style: src.pgf_placement_style
        set dst.pgf_with_prev: src.pgf_with_prev
        set dst.pgf_with_next: src.pgf_with_next
        set dst.pgf_block_size: src.pgf_block_size
        set dst.pgf_auto_num: src.pgf_auto_num
        set dst.pgf_num_format: src.pgf_num_format
        set dst.pgf_number_font: src.pgf_number_font
        set dst.pgf_hyphenate: src.pgf_hyphenate
        set dst.hyphen_max_lines: src.hyphen_max_lines
        set dst.hyphen_min_prefix: src.hyphen_min_prefix
        set dst.hyphen_min_suffix: src.hyphen_min_suffix
        set dst.hyphen_min_word: src.hyphen_min_word
        set dst.pgf_letter_space: src.pgf_letter_space
        set dst.pgf_language: src.pgf_language
        set dst.pgf_cell_alignment: src.pgf_cell_alignment
        set dst.pgf_cm_l: src.pgf_cm_l
        set dst.pgf_cm_t: src.pgf_cm_t
        set dst.pgf_cm_r: src.pgf_cm_r
        set dst.pgf_cm_b: src.pgf_cm_b
        set dst.pgf_cell_l_fixed: src.pgf_cell_l_fixed
        set dst.pgf_cell_t_fixed: src.pgf_cell_t_fixed
        set dst.pgf_cell_r_fixed: src.pgf_cell_r_fixed
        set dst.pgf_cell_b_fixed: src.pgf_cell_b_fixed
    }

    ; the full Format copy (`new Format(nextFormat)` / `nextFormat = *head`)
    procedure copy_all(host: ref[Page], dst: ref[MifFormat], src: ref[MifFormat])
    {
        MifFormat.copy_pf(host, dst, src)
        set dst.fot_first_line_start_indent: src.fot_first_line_start_indent
        set dst.fot_start_indent: src.fot_start_indent
        set dst.fot_end_indent: src.fot_end_indent
        set dst.fot_line_spacing: src.fot_line_spacing
        set dst.fot_position_point_shift: src.fot_position_point_shift
        set dst.fot_field_width: src.fot_field_width
        set dst.fot_min_leading_has: src.fot_min_leading_has
        set dst.fot_cur_display_size: src.fot_cur_display_size
        set dst.fot_line_thickness: src.fot_line_thickness
        set dst.fot_line_cap: src.fot_line_cap
        set dst.fot_border_priority: src.fot_border_priority
        set dst.fot_border_present: src.fot_border_present
        set dst.fot_line_repeat: src.fot_line_repeat
        set dst.fot_line_sep: src.fot_line_sep
        set dst.fot_display_alignment: src.fot_display_alignment
        set dst.fot_left_margin: src.fot_left_margin
        set dst.fot_right_margin: src.fot_right_margin
        set dst.fot_top_margin: src.fot_top_margin
        set dst.fot_bottom_margin: src.fot_bottom_margin
        set dst.fot_header_margin: src.fot_header_margin
        set dst.fot_footer_margin: src.fot_footer_margin
        set dst.fot_page_width: src.fot_page_width
        set dst.fot_page_height: src.fot_page_height
        set dst.fot_field_align: src.fot_field_align
        set dst.fot_input_whitespace: src.fot_input_whitespace
        set dst.fot_lines: src.fot_lines
        set dst.fot_page_n_columns: src.fot_page_n_columns
        set dst.fot_page_column_sep: src.fot_page_column_sep
        set dst.fot_span: src.fot_span
        set dst.fot_page_balance: src.fot_page_balance
        set dst.fot_cell_background: src.fot_cell_background
        set dst.mif_background_color: src.mif_background_color
        set dst.fot_language: src.fot_language
        set dst.fot_country: src.fot_country
    }

    procedure set_dsssl_defaults(this: ref[MifFormat], mc: ref[MifConsts])
    {
        ; FontFormat::setDSSSLDefaults
        set this.f_family: mc.s_times_new_roman
        set this.f_angle: mc.s_regular
        set this.f_weight: mc.s_regular
        set this.f_var: mc.s_regular
        set this.f_size: 10000
        set this.f_color: mc.s_black
        set this.f_underlining: mc.s_fno_underlining
        set this.f_overline: false
        set this.f_strike: false
        set this.f_position: mc.s_fnormal
        set this.f_pair_kern: false
        set this.f_case: mc.s_fastyped
        set this.f_dx: 0.0
        set this.f_dy: 0.0
        set this.f_dw: 0.0
        set this.ff_set: this.ff_set | MIF_FF_FAMILY | MIF_FF_ANGLE | MIF_FF_WEIGHT | MIF_FF_VAR | MIF_FF_SIZE | MIF_FF_COLOR | MIF_FF_UNDERLINING | MIF_FF_OVERLINE | MIF_FF_STRIKE | MIF_FF_POSITION | MIF_FF_PAIRKERN | MIF_FF_CASE | MIF_FF_DX | MIF_FF_DY | MIF_FF_DW
        ; ParagraphFormat::setDSSSLDefaults
        set this.pgf_findent: 0
        set this.pgf_lindent: 0
        set this.pgf_rindent: 0
        set this.pgf_alignment: mc.s_left
        set this.pgf_sp_before: 0
        set this.pgf_sp_after: 0
        set this.pgf_line_spacing: mc.s_fixed
        set this.pgf_leading: 0
        set this.pgf_num_tabs: 0
        set this.pgf_with_prev: false
        set this.pgf_with_next: false
        set this.pgf_block_size: 2
        set this.pgf_auto_num: false
        set this.pgf_hyphenate: false
        set this.hyphen_max_lines: 999
        set this.hyphen_min_prefix: 2
        set this.hyphen_min_suffix: 2
        set this.hyphen_min_word: 2
        set this.pgf_letter_space: false
        set this.pgf_language: mc.s_no_language
        set this.pgf_cell_alignment: mc.s_top
        set this.pgf_cm_l: 0
        set this.pgf_cm_t: 0
        set this.pgf_cm_r: 0
        set this.pgf_cm_b: 0
        set this.pgf_cell_l_fixed: true
        set this.pgf_cell_t_fixed: true
        set this.pgf_cell_r_fixed: true
        set this.pgf_cell_b_fixed: true
        set this.pgf_placement: mc.s_anywhere
        set this.pgf_placement_style: mc.s_normal
        set this.pf_set: this.pf_set | MIF_PF_FINDENT | MIF_PF_LINDENT | MIF_PF_RINDENT | MIF_PF_ALIGNMENT | MIF_PF_SPBEFORE | MIF_PF_SPAFTER | MIF_PF_LINESPACING | MIF_PF_LEADING | MIF_PF_NUMTABS | MIF_PF_WITHPREV | MIF_PF_WITHNEXT | MIF_PF_BLOCKSIZE | MIF_PF_AUTONUM | MIF_PF_HYPHENATE | MIF_PF_HMAXLINES | MIF_PF_HMINPREFIX | MIF_PF_HMINSUFFIX | MIF_PF_HMINWORD | MIF_PF_LETTERSPACE | MIF_PF_LANGUAGE | MIF_PF_CELLALIGN | MIF_PF_CELLMARGINS | MIF_PF_CELLLFIXED | MIF_PF_CELLTFIXED | MIF_PF_CELLRFIXED | MIF_PF_CELLBFIXED | MIF_PF_PLACEMENT | MIF_PF_PLACEMENTSTYLE
    }

    ; FontFormat::compare
    function ff_compare(a: ref[MifFormat], b2: ref[MifFormat]) returns int
    {
        var d 0
        if a.f_family.equals(b2.f_family) = false
            set d: d | MIF_FF_FAMILY
        if a.f_angle.equals(b2.f_angle) = false
            set d: d | MIF_FF_ANGLE
        if a.f_weight.equals(b2.f_weight) = false
            set d: d | MIF_FF_WEIGHT
        if a.f_var.equals(b2.f_var) = false
            set d: d | MIF_FF_VAR
        if a.f_size <> b2.f_size
            set d: d | MIF_FF_SIZE
        if a.f_color.equals(b2.f_color) = false
            set d: d | MIF_FF_COLOR
        if a.f_underlining.equals(b2.f_underlining) = false
            set d: d | MIF_FF_UNDERLINING
        if a.f_overline <> b2.f_overline
            set d: d | MIF_FF_OVERLINE
        if a.f_strike <> b2.f_strike
            set d: d | MIF_FF_STRIKE
        if a.f_position.equals(b2.f_position) = false
            set d: d | MIF_FF_POSITION
        if a.f_pair_kern <> b2.f_pair_kern
            set d: d | MIF_FF_PAIRKERN
        if a.f_case.equals(b2.f_case) = false
            set d: d | MIF_FF_CASE
        if a.f_dx <> b2.f_dx
            set d: d | MIF_FF_DX
        if a.f_dy <> b2.f_dy
            set d: d | MIF_FF_DY
        if a.f_dw <> b2.f_dw
            set d: d | MIF_FF_DW
        d
    }

    ; FontFormat::setFrom
    procedure ff_set_from(dst: ref[MifFormat], src: ref[MifFormat], props: int)
    {
        if (props & MIF_FF_FAMILY) <> 0
            set dst.f_family: src.f_family
        if (props & MIF_FF_ANGLE) <> 0
            set dst.f_angle: src.f_angle
        if (props & MIF_FF_WEIGHT) <> 0
            set dst.f_weight: src.f_weight
        if (props & MIF_FF_VAR) <> 0
            set dst.f_var: src.f_var
        if (props & MIF_FF_SIZE) <> 0
            set dst.f_size: src.f_size
        if (props & MIF_FF_COLOR) <> 0
            set dst.f_color: src.f_color
        if (props & MIF_FF_UNDERLINING) <> 0
            set dst.f_underlining: src.f_underlining
        if (props & MIF_FF_OVERLINE) <> 0
            set dst.f_overline: src.f_overline
        if (props & MIF_FF_STRIKE) <> 0
            set dst.f_strike: src.f_strike
        if (props & MIF_FF_POSITION) <> 0
            set dst.f_position: src.f_position
        if (props & MIF_FF_PAIRKERN) <> 0
            set dst.f_pair_kern: src.f_pair_kern
        if (props & MIF_FF_CASE) <> 0
            set dst.f_case: src.f_case
        if (props & MIF_FF_DX) <> 0
            set dst.f_dx: src.f_dx
        if (props & MIF_FF_DY) <> 0
            set dst.f_dy: src.f_dy
        if (props & MIF_FF_DW) <> 0
            set dst.f_dw: src.f_dw
    }

    procedure ff_update_from(dst: ref[MifFormat], src: ref[MifFormat])
    {
        let d MifFormat.ff_compare(dst, src)
        MifFormat.ff_set_from(dst, src, d)
        set dst.ff_set: d
    }

    ; ParagraphFormat::compare
    function pf_compare(a: ref[MifFormat], b2: ref[MifFormat]) returns int
    {
        var d 0
        if a.pgf_tag.equals(b2.pgf_tag) = false
            set d: d | MIF_PF_TAG
        if a.pgf_language.equals(b2.pgf_language) = false
            set d: d | MIF_PF_LANGUAGE
        if a.pgf_findent <> b2.pgf_findent
            set d: d | MIF_PF_FINDENT
        if a.pgf_lindent <> b2.pgf_lindent
            set d: d | MIF_PF_LINDENT
        if a.pgf_rindent <> b2.pgf_rindent
            set d: d | MIF_PF_RINDENT
        if a.pgf_alignment.equals(b2.pgf_alignment) = false
            set d: d | MIF_PF_ALIGNMENT
        if a.pgf_sp_before <> b2.pgf_sp_before
            set d: d | MIF_PF_SPBEFORE
        if a.pgf_sp_after <> b2.pgf_sp_after
            set d: d | MIF_PF_SPAFTER
        if a.pgf_line_spacing.equals(b2.pgf_line_spacing) = false
            set d: d | MIF_PF_LINESPACING
        if a.pgf_leading <> b2.pgf_leading
            set d: d | MIF_PF_LEADING
        if a.pgf_num_tabs <> b2.pgf_num_tabs
            set d: d | MIF_PF_NUMTABS
        if a.pgf_placement.equals(b2.pgf_placement) = false
            set d: d | MIF_PF_PLACEMENT
        if a.pgf_placement_style.equals(b2.pgf_placement_style) = false
            set d: d | MIF_PF_PLACEMENTSTYLE
        if a.pgf_with_prev <> b2.pgf_with_prev
            set d: d | MIF_PF_WITHPREV
        if a.pgf_with_next <> b2.pgf_with_next
            set d: d | MIF_PF_WITHNEXT
        if a.pgf_block_size <> b2.pgf_block_size
            set d: d | MIF_PF_BLOCKSIZE
        if a.pgf_auto_num <> b2.pgf_auto_num
            set d: d | MIF_PF_AUTONUM
        if a.pgf_num_format.equals(b2.pgf_num_format) = false
            set d: d | MIF_PF_NUMFORMAT
        if a.pgf_number_font.equals(b2.pgf_number_font) = false
            set d: d | MIF_PF_NUMBERFONT
        if a.pgf_hyphenate <> b2.pgf_hyphenate
            set d: d | MIF_PF_HYPHENATE
        if a.hyphen_max_lines <> b2.hyphen_max_lines
            set d: d | MIF_PF_HMAXLINES
        if a.hyphen_min_prefix <> b2.hyphen_min_prefix
            set d: d | MIF_PF_HMINPREFIX
        if a.hyphen_min_suffix <> b2.hyphen_min_suffix
            set d: d | MIF_PF_HMINSUFFIX
        if a.hyphen_min_word <> b2.hyphen_min_word
            set d: d | MIF_PF_HMINWORD
        if a.pgf_letter_space <> b2.pgf_letter_space
            set d: d | MIF_PF_LETTERSPACE
        if a.pgf_cell_alignment.equals(b2.pgf_cell_alignment) = false
            set d: d | MIF_PF_CELLALIGN
        var margins_differ false
        if a.pgf_cm_l <> b2.pgf_cm_l
            set margins_differ: true
        if a.pgf_cm_t <> b2.pgf_cm_t
            set margins_differ: true
        if a.pgf_cm_r <> b2.pgf_cm_r
            set margins_differ: true
        if a.pgf_cm_b <> b2.pgf_cm_b
            set margins_differ: true
        if margins_differ
            set d: d | MIF_PF_CELLMARGINS
        if a.pgf_cell_l_fixed <> b2.pgf_cell_l_fixed
            set d: d | MIF_PF_CELLLFIXED
        if a.pgf_cell_t_fixed <> b2.pgf_cell_t_fixed
            set d: d | MIF_PF_CELLTFIXED
        if a.pgf_cell_r_fixed <> b2.pgf_cell_r_fixed
            set d: d | MIF_PF_CELLRFIXED
        if a.pgf_cell_b_fixed <> b2.pgf_cell_b_fixed
            set d: d | MIF_PF_CELLBFIXED
        d
    }

    ; ParagraphFormat::setFrom
    procedure pf_set_from(dst: ref[MifFormat], src: ref[MifFormat], props: int, fprops: int)
    {
        if (props & MIF_PF_TAG) <> 0
            set dst.pgf_tag: src.pgf_tag
        if (props & MIF_PF_LANGUAGE) <> 0
            set dst.pgf_language: src.pgf_language
        if (props & MIF_PF_FINDENT) <> 0
            set dst.pgf_findent: src.pgf_findent
        if (props & MIF_PF_LINDENT) <> 0
            set dst.pgf_lindent: src.pgf_lindent
        if (props & MIF_PF_RINDENT) <> 0
            set dst.pgf_rindent: src.pgf_rindent
        if (props & MIF_PF_ALIGNMENT) <> 0
            set dst.pgf_alignment: src.pgf_alignment
        if (props & MIF_PF_SPBEFORE) <> 0
            set dst.pgf_sp_before: src.pgf_sp_before
        if (props & MIF_PF_SPAFTER) <> 0
            set dst.pgf_sp_after: src.pgf_sp_after
        if (props & MIF_PF_LINESPACING) <> 0
            set dst.pgf_line_spacing: src.pgf_line_spacing
        if (props & MIF_PF_LEADING) <> 0
            set dst.pgf_leading: src.pgf_leading
        if (props & MIF_PF_NUMTABS) <> 0
            set dst.pgf_num_tabs: src.pgf_num_tabs
        if (props & MIF_PF_PLACEMENT) <> 0
            set dst.pgf_placement: src.pgf_placement
        if (props & MIF_PF_PLACEMENTSTYLE) <> 0
            set dst.pgf_placement_style: src.pgf_placement_style
        if (props & MIF_PF_WITHPREV) <> 0
            set dst.pgf_with_prev: src.pgf_with_prev
        if (props & MIF_PF_WITHNEXT) <> 0
            set dst.pgf_with_next: src.pgf_with_next
        if (props & MIF_PF_BLOCKSIZE) <> 0
            set dst.pgf_block_size: src.pgf_block_size
        if (props & MIF_PF_AUTONUM) <> 0
            set dst.pgf_auto_num: src.pgf_auto_num
        if (props & MIF_PF_NUMFORMAT) <> 0
            set dst.pgf_num_format: src.pgf_num_format
        if (props & MIF_PF_NUMBERFONT) <> 0
            set dst.pgf_number_font: src.pgf_number_font
        if (props & MIF_PF_HYPHENATE) <> 0
            set dst.pgf_hyphenate: src.pgf_hyphenate
        if (props & MIF_PF_HMAXLINES) <> 0
            set dst.hyphen_max_lines: src.hyphen_max_lines
        if (props & MIF_PF_HMINPREFIX) <> 0
            set dst.hyphen_min_prefix: src.hyphen_min_prefix
        if (props & MIF_PF_HMINSUFFIX) <> 0
            set dst.hyphen_min_suffix: src.hyphen_min_suffix
        if (props & MIF_PF_HMINWORD) <> 0
            set dst.hyphen_min_word: src.hyphen_min_word
        if (props & MIF_PF_LETTERSPACE) <> 0
            set dst.pgf_letter_space: src.pgf_letter_space
        if (props & MIF_PF_CELLALIGN) <> 0
            set dst.pgf_cell_alignment: src.pgf_cell_alignment
        if (props & MIF_PF_CELLMARGINS) <> 0
        {
            set dst.pgf_cm_l: src.pgf_cm_l
            set dst.pgf_cm_t: src.pgf_cm_t
            set dst.pgf_cm_r: src.pgf_cm_r
            set dst.pgf_cm_b: src.pgf_cm_b
        }
        if (props & MIF_PF_CELLLFIXED) <> 0
            set dst.pgf_cell_l_fixed: src.pgf_cell_l_fixed
        if (props & MIF_PF_CELLTFIXED) <> 0
            set dst.pgf_cell_t_fixed: src.pgf_cell_t_fixed
        if (props & MIF_PF_CELLRFIXED) <> 0
            set dst.pgf_cell_r_fixed: src.pgf_cell_r_fixed
        if (props & MIF_PF_CELLBFIXED) <> 0
            set dst.pgf_cell_b_fixed: src.pgf_cell_b_fixed
        MifFormat.ff_set_from(dst, src, fprops)
    }

    procedure pf_update_from(dst: ref[MifFormat], src: ref[MifFormat])
    {
        MifFormat.ff_update_from(dst, src)
        let d MifFormat.pf_compare(dst, src)
        MifFormat.pf_set_from(dst, src, d, 0)
        set dst.pf_set: d
    }

    procedure clear_set_props(this: ref[MifFormat])
    {
        set this.pf_set: 0
        set this.ff_set: 0
    }

    ; FontFormat::out — `is_pgf_font` picks the statement name
    procedure ff_out(this: ref[MifFormat], os: ref[MifOS], props: int, is_pgf_font: bool)
    {
        if props = 0
            return
        if is_pgf_font
            os.begin_stmt("PgfFont")
        else
            os.begin_stmt("Font")
        if (props & MIF_FF_FAMILY) <> 0
            os.p_tstr("FFamily", this.f_family)
        if (props & MIF_FF_ANGLE) <> 0
            os.p_tstr("FAngle", this.f_angle)
        if (props & MIF_FF_WEIGHT) <> 0
            os.p_tstr("FWeight", this.f_weight)
        if (props & MIF_FF_VAR) <> 0
            os.p_tstr("FVar", this.f_var)
        if (props & MIF_FF_SIZE) <> 0
            os.p_dim("FSize", this.f_size)
        if (props & MIF_FF_COLOR) <> 0
            os.p_tstr("FColor", this.f_color)
        if (props & MIF_FF_UNDERLINING) <> 0
            os.p_kw("FUnderlining", this.f_underlining)
        if (props & MIF_FF_OVERLINE) <> 0
            os.p_bool("FOverline", this.f_overline)
        if (props & MIF_FF_STRIKE) <> 0
            os.p_bool("FStrike", this.f_strike)
        if (props & MIF_FF_POSITION) <> 0
            os.p_kw("FPosition", this.f_position)
        if (props & MIF_FF_PAIRKERN) <> 0
            os.p_bool("FPairKern", this.f_pair_kern)
        if (props & MIF_FF_CASE) <> 0
            os.p_kw("FCase", this.f_case)
        if (props & MIF_FF_DX) <> 0
            os.p_pct("FDX", this.f_dx)
        if (props & MIF_FF_DY) <> 0
            os.p_pct("FDY", this.f_dy)
        if (props & MIF_FF_DW) <> 0
            os.p_pct("FDW", this.f_dw)
        os.end_stmt()
    }
}

; --- MifTagStream: TagStream / TextFlow / Cell / Para in one tagged record --
define MifTagStream
(
    ts_class: int
    content: ref[MifTmp]
    fmt: ref[MifFormat]
    initial_pgf_tag: String
    pgf_tag_used: bool
    ; TextFlow
    tf_set: int
    tf_tag: String
    tf_auto_connect: bool
    text_rect_id: int
    text_rect_id_used: bool
    ; Para
    para_set: int
    para_pgf_tag: String
    leader_tabs_set: bool
    cur_fmt: ref[MifFormat]
    ; Cell
    cell_set: int
    cell_fill: int
    cell_color: String
    cell_l_ruling: String
    cell_b_ruling: String
    cell_r_ruling: String
    cell_t_ruling: String
    cell_columns: int
    cell_rows: int
)
{
    function make(host: ref[Page], ts_class: int, ind: int, mc: ref[MifConsts]) returns ref[MifTagStream]
    {
        let t host.allocate(sizeof MifTagStream, alignof MifTagStream) as pointer[MifTagStream]
        set t.ts_class: ts_class
        set t.content: MifTmp.make(host, ind)
        set t.fmt: MifFormat.make(host)
        set t.initial_pgf_tag: mc.s_default_pgf_format
        set t.pgf_tag_used: false
        set t.tf_set: 0
        set t.tf_tag: String()
        set t.tf_auto_connect: false
        set t.text_rect_id: 0
        set t.text_rect_id_used: false
        set t.para_set: 0
        set t.para_pgf_tag: String()
        set t.leader_tabs_set: false
        set t.cur_fmt: MifFormat.make(host)
        set t.cell_set: 0
        set t.cell_color: String()
        set t.cell_fill: 0
        set t.cell_l_ruling: String()
        set t.cell_b_ruling: String()
        set t.cell_r_ruling: String()
        set t.cell_t_ruling: String()
        set t.cell_columns: 0
        set t.cell_rows: 0
        t
    }

    ; Para(T_indent osIndent = 2): setProperties = fParagraphFormat
    function make_para(host: ref[Page], ind: int, mc: ref[MifConsts]) returns ref[MifTagStream]
    {
        let t MifTagStream.make(host, MIF_TS_PARA, ind, mc)
        set t.para_set: MIF_PARA_FORMAT
        t
    }

    function make_cell(host: ref[Page], mc: ref[MifConsts]) returns ref[MifTagStream]
        MifTagStream.make(host, MIF_TS_CELL, 12, mc)
}

; --- MifObject: PolyLine / ImportObject / Frame / TextRect ------------------
define MifObject
(
    tag: int
    set_props: int
    id: int
    pen: int
    fill: int
    pen_width: int
    ob_color: String
    ; PolyLine
    head_cap: String
    tail_cap: String
    points_x: ref[Array[int]]?
    points_y: ref[Array[int]]?
    ; ImportObject
    import_file: String
    bitmap_dpi: int
    fixed_size: bool
    native_x: int
    native_y: int
    ; Frame + ImportObject + TextRect share the shape rect
    shape_l: int
    shape_t: int
    shape_w: int
    shape_h: int
    frame_type: String
    ns_offset: int
    bl_offset: int
    anchor_align: String
    objects: ref[Array[ref[MifObject]?]]?
    ; TextRect
    tr_num_columns: int
    tr_column_gap: int
    tr_column_balance: bool
)
{
    ; Object(pen=15, fill=15, penWidth=0, obColor=sBlack) — one global ID
    ; counter across every object of the run (the reference static IDCnt).
    function make(host: ref[Page], tag: int, id: int, mc: ref[MifConsts]) returns ref[MifObject]
    {
        let o host.allocate(sizeof MifObject, alignof MifObject) as pointer[MifObject]
        set o.tag: tag
        set o.id: id
        set o.pen: 15
        set o.fill: 15
        set o.pen_width: 0
        set o.ob_color: mc.s_black
        set o.set_props: MIF_OB_ID | MIF_OB_PEN | MIF_OB_FILL | MIF_OB_PENWIDTH | MIF_OB_OBCOLOR
        set o.head_cap: String()
        set o.tail_cap: String()
        set o.points_x: null
        set o.points_y: null
        set o.import_file: String()
        set o.bitmap_dpi: 0
        set o.fixed_size: false
        set o.native_x: 0
        set o.native_y: 0
        set o.shape_l: 0
        set o.shape_t: 0
        set o.shape_w: 0
        set o.shape_h: 0
        set o.frame_type: String()
        set o.ns_offset: 0
        set o.bl_offset: 0
        set o.anchor_align: String()
        set o.objects: null
        set o.tr_num_columns: 0
        set o.tr_column_gap: 0
        set o.tr_column_balance: false
        o
    }

    procedure out_object_properties(this: ref[MifObject], os: ref[MifOS])
    {
        if (this.set_props & MIF_OB_ID) <> 0
            os.p_num("ID", this.id)
        if (this.set_props & MIF_OB_PEN) <> 0
            os.p_num("Pen", this.pen)
        if (this.set_props & MIF_OB_FILL) <> 0
            os.p_num("Fill", this.fill)
        if (this.set_props & MIF_OB_PENWIDTH) <> 0
            os.p_dim("PenWidth", this.pen_width)
        if (this.set_props & MIF_OB_OBCOLOR) <> 0
            os.p_tstr("ObColor", this.ob_color)
    }

    procedure out(this: ref[MifObject], os: ref[MifOS])
    {
        let tag this.tag
        if tag = MIF_OBJ_POLYLINE
        {
            os.begin_stmt("PolyLine")
            this.out_object_properties(os)
            if (this.set_props & MIF_PL_HEADCAP) <> 0
                os.p_kw("HeadCap", this.head_cap)
            if (this.set_props & MIF_PL_TAILCAP) <> 0
                os.p_kw("TailCap", this.tail_cap)
            let n this.points_x.get_length()
            var i: size_t 0
            while i < n
            {
                let xp this.points_x.get(i)
                let yp this.points_y.get(i)
                os.p_two("Point", *xp, *yp)
                set i: i + 1
            }
            os.end_stmt()
            return
        }
        if tag = MIF_OBJ_IMPORT
        {
            os.begin_stmt("ImportObject")
            this.out_object_properties(os)
            if (this.set_props & MIF_IM_FILEDI) <> 0
                os.p_tstr("ImportObFileDI", this.import_file)
            if (this.set_props & MIF_IM_DPI) <> 0
                os.p_num("BitMapDpi", this.bitmap_dpi)
            if (this.set_props & MIF_IM_SHAPERECT) <> 0
                os.p_ltrb("ShapeRect", this.shape_l, this.shape_t, this.shape_w, this.shape_h)
            if (this.set_props & MIF_IM_FIXEDSIZE) <> 0
                os.p_bool("ImportObFixedSize", this.fixed_size)
            if (this.set_props & MIF_IM_NATIVEORIGIN) <> 0
                os.p_two("NativeOrigin", this.native_x, this.native_y)
            os.end_stmt()
            return
        }
        if tag = MIF_OBJ_FRAME
        {
            os.begin_stmt("Frame")
            this.out_object_properties(os)
            if (this.set_props & MIF_FR_SHAPERECT) <> 0
                os.p_ltrb("ShapeRect", this.shape_l, this.shape_t, this.shape_w, this.shape_h)
            if (this.set_props & MIF_FR_TYPE) <> 0
                os.p_kw("FrameType", this.frame_type)
            if (this.set_props & MIF_FR_NSOFFSET) <> 0
                os.p_dim("NSOffset", this.ns_offset)
            if (this.set_props & MIF_FR_BLOFFSET) <> 0
                os.p_dim("BLOffset", this.bl_offset)
            if (this.set_props & MIF_FR_ANCHORALIGN) <> 0
                os.p_kw("AnchorAlign", this.anchor_align)
            let n this.objects.get_length()
            var i: size_t 0
            while i < n
            {
                let op this.objects.get(i)
                let o2 *op
                if o2 <> null
                    o2.out(os)
                set i: i + 1
            }
            os.end_stmt()
            return
        }
        os.begin_stmt("TextRect")
        this.out_object_properties(os)
        if (this.set_props & MIF_TR_SHAPERECT) <> 0
            os.p_ltrb("ShapeRect", this.shape_l, this.shape_t, this.shape_w, this.shape_h)
        if (this.set_props & MIF_TR_NUMCOLUMNS) <> 0
            os.p_num("TRNumColumns", this.tr_num_columns)
        if (this.set_props & MIF_TR_COLUMNGAP) <> 0
            os.p_dim("TRColumnGap", this.tr_column_gap)
        if (this.set_props & MIF_TR_COLUMNBALANCE) <> 0
            os.p_bool("TRColumnBalance", this.tr_column_balance)
        os.end_stmt()
    }
}

; --- MifPage ---------------------------------------------------------------
define MifPage (set_props: int, page_type: String, page_tag: String, page_background: String, text_rects: ref[Array[ref[MifObject]?]])
{
    function make(host: ref[Page], page_type: String, page_tag: String, page_background: String, mc: ref[MifConsts]) returns ref[MifPage]
    {
        let p host.allocate(sizeof MifPage, alignof MifPage) as pointer[MifPage]
        set p.page_type: page_type
        set p.page_tag: page_tag
        set p.page_background: page_background
        ; the reference ctor seeds fPageType | fPageTag unconditionally
        var sp MIF_PG_TYPE | MIF_PG_TAG
        if page_tag.equals(mc.s_none) = false
            set sp: sp | MIF_PG_TAG
        if page_background.equals(mc.s_none) = false
            set sp: sp | MIF_PG_BACKGROUND
        set p.set_props: sp
        set p.text_rects: Array[ref[MifObject]?]^host()
        p
    }

    procedure out(this: ref[MifPage], os: ref[MifOS])
    {
        os.begin_stmt("Page")
        if (this.set_props & MIF_PG_TYPE) <> 0
            os.p_kw("PageType", this.page_type)
        if (this.set_props & MIF_PG_TAG) <> 0
            os.p_tstr("PageTag", this.page_tag)
        if (this.set_props & MIF_PG_BACKGROUND) <> 0
            os.p_tstr("PageBackground", this.page_background)
        let n this.text_rects.get_length()
        var i: size_t 0
        while i < n
        {
            let tp this.text_rects.get(i)
            let t *tp
            if t <> null
                t.out(os)
            set i: i + 1
        }
        os.end_stmt()
    }
}

; --- MifTblColumn / MifTblFormat / MifRow / MifTbl -------------------------
define MifTblColumn (set_props: int, num: int, width: int)
{
    function make(host: ref[Page], num: int, width: int) returns ref[MifTblColumn]
    {
        let c host.allocate(sizeof MifTblColumn, alignof MifTblColumn) as pointer[MifTblColumn]
        set c.num: num
        set c.width: width
        set c.set_props: MIF_TBLC_NUM | MIF_TBLC_WIDTH
        c
    }

    ; NOTE: the reference prints a TblColumn as `<TblFormat …>` (a bug that
    ; is part of the byte stream).
    procedure out(this: ref[MifTblColumn], os: ref[MifOS])
    {
        os.begin_stmt("TblFormat")
        if (this.set_props & MIF_TBLC_NUM) <> 0
            os.p_num("TblColumnNum", this.num)
        if (this.set_props & MIF_TBLC_WIDTH) <> 0
            os.p_dim("TblColumnWidth", this.width)
        os.end_stmt()
    }
}

define MifTblFormat
(
    set_props: int
    tbl_tag: String
    lindent: int
    rindent: int
    sp_before: int
    sp_after: int
    alignment: String
    cm_l: int
    cm_t: int
    cm_r: int
    cm_b: int
    title_placement: String
    width: int
    columns: ref[Array[ref[MifTblColumn]?]]?
)
{
    function make(host: ref[Page]) returns ref[MifTblFormat]
    {
        let f host.allocate(sizeof MifTblFormat, alignof MifTblFormat) as pointer[MifTblFormat]
        set f.set_props: 0
        set f.tbl_tag: String()
        set f.lindent: 0
        set f.rindent: 0
        set f.sp_before: 0
        set f.sp_after: 0
        set f.alignment: String()
        set f.cm_l: 0
        set f.cm_t: 0
        set f.cm_r: 0
        set f.cm_b: 0
        set f.title_placement: String()
        set f.width: 0
        set f.columns: Array[ref[MifTblColumn]?]^host()
        f
    }

    procedure set_dsssl_defaults(this: ref[MifTblFormat], mc: ref[MifConsts])
    {
        set this.lindent: 0
        set this.rindent: 0
        set this.sp_before: 0
        set this.sp_after: 0
        set this.alignment: mc.s_left
        set this.cm_l: 0
        set this.cm_t: 0
        set this.cm_r: 0
        set this.cm_b: 0
        set this.title_placement: mc.s_none_kw
        set this.set_props: this.set_props | MIF_TBLF_LINDENT | MIF_TBLF_RINDENT | MIF_TBLF_SPBEFORE | MIF_TBLF_SPAFTER | MIF_TBLF_ALIGNMENT | MIF_TBLF_CELLMARGINS | MIF_TBLF_TITLEPLACEMENT
    }

    procedure out(this: ref[MifTblFormat], os: ref[MifOS])
    {
        os.begin_stmt("TblFormat")
        if (this.set_props & MIF_TBLF_TAG) <> 0
            os.p_tstr("TblTag", this.tbl_tag)
        if (this.set_props & MIF_TBLF_LINDENT) <> 0
            os.p_dim("TblLIndent", this.lindent)
        if (this.set_props & MIF_TBLF_RINDENT) <> 0
            os.p_dim("TblRIndent", this.rindent)
        if (this.set_props & MIF_TBLF_SPBEFORE) <> 0
            os.p_dim("TblSpBefore", this.sp_before)
        if (this.set_props & MIF_TBLF_SPAFTER) <> 0
            os.p_dim("TblSpAfter", this.sp_after)
        if (this.set_props & MIF_TBLF_ALIGNMENT) <> 0
            os.p_kw("TblAlignment", this.alignment)
        if (this.set_props & MIF_TBLF_CELLMARGINS) <> 0
            os.p_ltrb("TblCellMargins", this.cm_l, this.cm_t, this.cm_r, this.cm_b)
        if (this.set_props & MIF_TBLF_TITLEPLACEMENT) <> 0
            os.p_kw("TblTitlePlacement", this.title_placement)
        if (this.set_props & MIF_TBLF_WIDTH) <> 0
            os.p_dim("TblWidth", this.width)
        let n this.columns.get_length()
        var i: size_t 0
        while i < n
        {
            let cp this.columns.get(i)
            let c *cp
            if c <> null
                c.out(os)
            set i: i + 1
        }
        os.end_stmt()
    }
}

define MifRow (cells: ref[Array[ref[MifTagStream]?]]?)
{
    function make(host: ref[Page]) returns ref[MifRow]
    {
        let r host.allocate(sizeof MifRow, alignof MifRow) as pointer[MifRow]
        set r.cells: Array[ref[MifTagStream]?]^host()
        r
    }
}

define MifTbl
(
    set_props: int
    tbl_id: int
    tbl_tag: String
    id_used: bool
    fmt: ref[MifTblFormat]
    num_columns: int
    col_widths: ref[Array[int]]
    tblh: ref[Array[ref[MifRow]?]]
    tblbody: ref[Array[ref[MifRow]?]]
    tblf: ref[Array[ref[MifRow]?]]
)
{
    function make(host: ref[Page], id: int, mc: ref[MifConsts]) returns ref[MifTbl]
    {
        let t host.allocate(sizeof MifTbl, alignof MifTbl) as pointer[MifTbl]
        set t.tbl_id: id
        set t.tbl_tag: mc.s_default_tbl_format
        set t.set_props: MIF_TBL_ID | MIF_TBL_TAG
        set t.id_used: false
        set t.fmt: MifTblFormat.make(host)
        set t.num_columns: 0
        set t.col_widths: Array[int]^host()
        set t.tblh: Array[ref[MifRow]?]^host()
        set t.tblbody: Array[ref[MifRow]?]^host()
        set t.tblf: Array[ref[MifRow]?]^host()
        t
    }
}

; --- MifRuling / MifColor / MifXRefFormat ----------------------------------
define MifRuling (set_props: int, tag: String, pen_width: int, gap: int, color: String, pen: int, lines: int, key: String)
{
    function make(host: ref[Page]) returns ref[MifRuling]
    {
        let r host.allocate(sizeof MifRuling, alignof MifRuling) as pointer[MifRuling]
        set r.set_props: 0
        set r.tag: String()
        set r.pen_width: 1000
        set r.gap: 1000
        set r.color: String()
        set r.pen: 0
        set r.lines: 1
        set r.key: String()
        r
    }

    procedure out(this: ref[MifRuling], os: ref[MifOS])
    {
        os.begin_stmt("Ruling")
        if (this.set_props & MIF_RUL_TAG) <> 0
            os.p_tstr("RulingTag", this.tag)
        if (this.set_props & MIF_RUL_PENWIDTH) <> 0
            os.p_dim("RulingPenWidth", this.pen_width)
        if (this.set_props & MIF_RUL_GAP) <> 0
            os.p_dim("RulingGap", this.gap)
        if (this.set_props & MIF_RUL_COLOR) <> 0
            os.p_tstr("RulingColor", this.color)
        if (this.set_props & MIF_RUL_PEN) <> 0
            os.p_num("RulingPen", this.pen)
        if (this.set_props & MIF_RUL_LINES) <> 0
            os.p_num("RulingLines", this.lines)
        os.end_stmt()
    }
}

define MifColor (set_props: int, tag: String, cyan: double, magenta: double, yellow: double, black: double)
{
    procedure out(this: ref[MifColor], os: ref[MifOS])
    {
        os.begin_stmt("Color")
        if (this.set_props & MIF_COL_TAG) <> 0
            os.p_tstr("ColorTag", this.tag)
        if (this.set_props & MIF_COL_CYAN) <> 0
            os.p_pct("ColorCyan", this.cyan)
        if (this.set_props & MIF_COL_MAGENTA) <> 0
            os.p_pct("ColorMagenta", this.magenta)
        if (this.set_props & MIF_COL_YELLOW) <> 0
            os.p_pct("ColorYellow", this.yellow)
        if (this.set_props & MIF_COL_BLACK) <> 0
            os.p_pct("ColorBlack", this.black)
        os.end_stmt()
    }
}

define MifXRefFormat (set_props: int, name: String, def: String)
{
    procedure out(this: ref[MifXRefFormat], os: ref[MifOS])
    {
        os.begin_stmt("XRefFormat")
        if (this.set_props & MIF_XRF_NAME) <> 0
            os.p_tstr("XRefName", this.name)
        if (this.set_props & MIF_XRF_DEF) <> 0
            os.p_tstr("XRefDef", this.def)
        os.end_stmt()
    }
}

