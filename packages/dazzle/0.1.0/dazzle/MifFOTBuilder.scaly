    {
    }

    function end_multi_mode_mode(this: ref[MifFOTBuilder])
    {
    }

    ; --- the PAGE/COLUMN MODEL ----------------------------------------------------
    ; Not overridden here either, so both are the plain start()/end() brackets.
    function start_page_sequence(this: ref[MifFOTBuilder])
        this.mif_start()

    function end_page_sequence(this: ref[MifFOTBuilder])
        this.mif_end()

    function start_column_set_sequence(this: ref[MifFOTBuilder], dnic: ref[DisplayNIC])
