; --- MifConsts: the reference's `CONST_STRING` block, interned once on the
; run page (a String is a one-pointer handle, so passing them by value is
; free; every one of them is compared bytewise by the delta-format code) ----
define MifConsts
(
    s_none: String
    s_space: String
    s_default_tbl_format: String
    s_default_pgf_format: String
    s_times_new_roman: String
    s_page_num_xref_format_name: String
