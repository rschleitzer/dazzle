    function start_aligned_column(this: ref[MifFOTBuilder], dnic: ref[DisplayNIC])
        this.mif_start()

    function end_aligned_column(this: ref[MifFOTBuilder])
        this.mif_end()


    ; --- the ONLINE family ------------------------------------------------------
    ; The MIF backend overrides neither class, so the base brackets apply:
    ; marginalia and the multi-mode SERIAL pair are start()/end(); the per-mode
    ; bracket is empty (its content still flows through).
    function start_marginalia(this: ref[MifFOTBuilder])
        this.mif_start()

    function end_marginalia(this: ref[MifFOTBuilder])
        this.mif_end()

    function start_multi_mode_serial(this: ref[MifFOTBuilder], mode: ref[MultiModeRec])
        this.mif_start()

    function end_multi_mode_serial(this: ref[MifFOTBuilder])
        this.mif_end()

