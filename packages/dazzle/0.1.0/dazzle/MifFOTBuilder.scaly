; --- MifBookComponent (the Document struct is inlined) ---------------------
define MifBookComponent
(
    file_name: String
    xref_formats: ref[Array[ref[MifXRefFormat]?]]
    doc_set: int
    d_margin_l: int
    d_margin_t: int
    d_margin_r: int
    d_margin_b: int
    d_columns: int
    d_column_gap: int
    d_page_w: int
    d_page_h: int
    d_start_page: int
    d_page_num_style: String
    d_two_sides: bool
    d_parity: String
    color_slots: ref[Array[ref[MifColor]?]]
    color_used: int
    color_limit: int
    pgf_catalog: ref[Array[ref[MifFormat]?]]
    tbl_catalog: ref[Array[ref[MifTblFormat]?]]
    ruling_slots: ref[Array[ref[MifRuling]?]]
    ruling_used: int
    ruling_limit: int
    aframes: ref[Array[ref[MifObject]?]]
    tbls: ref[Array[ref[MifTbl]?]]
    pages: ref[Array[ref[MifPage]?]]
    text_flows: ref[Array[ref[MifTagStream]?]]
    pgnum_xref_generated: bool
    epilog_os: ref[MifTmp]?
)
{
    function make(host: ref[Page], epilog_os: ref[MifTmp]?) returns ref[MifBookComponent]
    {
        let b host.allocate(sizeof MifBookComponent, alignof MifBookComponent) as pointer[MifBookComponent]
        set b.file_name: String()
        set b.xref_formats: Array[ref[MifXRefFormat]?]^host()
        set b.doc_set: 0
        set b.d_margin_l: 0
        set b.d_margin_t: 0
        set b.d_margin_r: 0
        set b.d_margin_b: 0
        set b.d_columns: 0
        set b.d_column_gap: 0
        set b.d_page_w: 0
        set b.d_page_h: 0
        set b.d_start_page: 0
        set b.d_page_num_style: String()
        set b.d_two_sides: false
        set b.d_parity: String()
        set b.color_slots: Array[ref[MifColor]?]^host()
        set b.color_used: 0
        set b.color_limit: 0
        set b.pgf_catalog: Array[ref[MifFormat]?]^host()
        set b.tbl_catalog: Array[ref[MifTblFormat]?]^host()
        set b.ruling_slots: Array[ref[MifRuling]?]^host()
        set b.ruling_used: 0
        set b.ruling_limit: 0
        set b.aframes: Array[ref[MifObject]?]^host()
        set b.tbls: Array[ref[MifTbl]?]^host()
        set b.pages: Array[ref[MifPage]?]^host()
        set b.text_flows: Array[ref[MifTagStream]?]^host()
        set b.pgnum_xref_generated: false
        set b.epilog_os: epilog_os
        b
    }

    procedure out_document(this: ref[MifBookComponent], os: ref[MifOS])
    {
        os.begin_stmt("Document")
        if (this.doc_set & MIF_DOC_MARGINS) <> 0
            os.p_ltrb("DMargins", this.d_margin_l, this.d_margin_t, this.d_margin_r, this.d_margin_b)
        if (this.doc_set & MIF_DOC_COLUMNS) <> 0
            os.p_num("DColumns", this.d_columns)
        if (this.doc_set & MIF_DOC_COLUMNGAP) <> 0
            os.p_dim("DColumnGap", this.d_column_gap)
        if (this.doc_set & MIF_DOC_PAGESIZE) <> 0
            os.p_two("DPageSize", this.d_page_w, this.d_page_h)
        if (this.doc_set & MIF_DOC_STARTPAGE) <> 0
            os.p_num("DStartPage", this.d_start_page)
        if (this.doc_set & MIF_DOC_PAGENUMSTYLE) <> 0
            os.p_kw("DPageNumStyle", this.d_page_num_style)
        if (this.doc_set & MIF_DOC_TWOSIDES) <> 0
            os.p_bool("DTwoSides", this.d_two_sides)
        if (this.doc_set & MIF_DOC_PARITY) <> 0
            os.p_kw("DParity", this.d_parity)
        os.end_stmt()
    }
}

; --- the FOT-side table machinery ------------------------------------------
define MifBorder (border_priority: int, line_thickness: int, border_present: bool, line_repeat: int, line_sep: int, cell_border: bool, color: String)
{
    function make(host: ref[Page], cell_border: bool) returns ref[MifBorder]
    {
        let b host.allocate(sizeof MifBorder, alignof MifBorder) as pointer[MifBorder]
        set b.border_priority: 0
        set b.line_thickness: 0
        set b.border_present: false
        set b.line_repeat: 0
        set b.line_sep: 0
        set b.cell_border: cell_border
        set b.color: String()
        b
    }

    ; Border::resolve — mutates BOTH borders
    procedure resolve(this: ref[MifBorder], adj: ref[MifBorder])
    {
        var take false
        if adj.border_priority > this.border_priority
            set take: true
        if adj.border_priority = this.border_priority
        {
            if (adj.cell_border = false) and adj.border_present
                set take: true
        }
        if take = false
            return
        set this.line_thickness: adj.line_thickness
        set this.border_present: adj.border_present
        set this.line_repeat: adj.line_repeat
        set this.line_sep: adj.line_sep
        set this.color: adj.color
        if adj.cell_border
            set adj.border_present: false
    }
}

define MifColumn (has_width: bool, width: LengthSpec, tuf: double)
{
    function make(host: ref[Page]) returns ref[MifColumn]
    {
        let c host.allocate(sizeof MifColumn, alignof MifColumn) as pointer[MifColumn]
        set c.has_width: false
        set c.width: LengthSpec()
        set c.tuf: 0.0
        c
    }
}

define MifFotCell
(
    missing: bool
    n_cols_spanned: int
    n_rows_spanned: int
    before_row_border: ref[MifBorder]
    after_row_border: ref[MifBorder]
    before_column_border: ref[MifBorder]
    after_column_border: ref[MifBorder]
    display_size: int
    overlapping: ref[MifFotCell]?
    mif_cell: ref[MifTagStream]
)
{
    function make(host: ref[Page], mc: ref[MifConsts]) returns ref[MifFotCell]
    {
        let c host.allocate(sizeof MifFotCell, alignof MifFotCell) as pointer[MifFotCell]
        set c.missing: false
        set c.n_cols_spanned: 1
        set c.n_rows_spanned: 1
        set c.before_row_border: MifBorder.make(host, true)
        set c.after_row_border: MifBorder.make(host, true)
        set c.before_column_border: MifBorder.make(host, true)
        set c.after_column_border: MifBorder.make(host, true)
        set c.display_size: 0
        set c.overlapping: null
        set c.mif_cell: MifTagStream.make_cell(host, mc)
        c
    }
}

define MifFotRow (cells: ref[Array[ref[MifFotCell]?]]?)
{
    function make(host: ref[Page]) returns ref[MifFotRow]
    {
        let r host.allocate(sizeof MifFotRow, alignof MifFotRow) as pointer[MifFotRow]
        set r.cells: Array[ref[MifFotCell]?]^host()
        r
    }
}

define MifTablePart
(
    columns: ref[Array[ref[MifColumn]?]]?
    header: ref[Array[ref[MifFotRow]?]]
    body: ref[Array[ref[MifFotRow]?]]?
    footer: ref[Array[ref[MifFotRow]?]]
    mif_table_num: int
    columns_processed: bool
    needs_col_reproc: bool
)
{
    function make(host: ref[Page]) returns ref[MifTablePart]
    {
        let p host.allocate(sizeof MifTablePart, alignof MifTablePart) as pointer[MifTablePart]
        set p.columns: Array[ref[MifColumn]?]^host()
        set p.header: Array[ref[MifFotRow]?]^host()
        set p.body: Array[ref[MifFotRow]?]^host()
        set p.footer: Array[ref[MifFotRow]?]^host()
        set p.mif_table_num: 0
        set p.columns_processed: false
        set p.needs_col_reproc: false
        p
    }
}

define MifTable
(
    parts: ref[Array[ref[MifTablePart]?]]?
    before_row_border: ref[MifBorder]
    after_row_border: ref[MifBorder]
    before_column_border: ref[MifBorder]
    after_column_border: ref[MifBorder]
    table_width: int
    display_alignment: int
    start_indent: int
    cur_part: ref[MifTablePart]?
    cur_cell: ref[MifFotCell]?
    ; Table::CurRows — a DIRECT pointer, as in the reference: it survives a
    ; table's end and a stray table-row then appends to the stale (but live)
    ; row list instead of asserting.
    cur_rows: ref[Array[ref[MifFotRow]?]]?
    default_tblfmt_generated: bool
    no_parts_seen: bool
)
{
    function make(host: ref[Page]) returns ref[MifTable]
    {
        let t host.allocate(sizeof MifTable, alignof MifTable) as pointer[MifTable]
        set t.parts: Array[ref[MifTablePart]?]^host()
        set t.before_row_border: MifBorder.make(host, false)
        set t.after_row_border: MifBorder.make(host, false)
        set t.before_column_border: MifBorder.make(host, false)
        set t.after_column_border: MifBorder.make(host, false)
        set t.table_width: 0
        set t.display_alignment: 0
        set t.start_indent: 0
        set t.cur_part: null
        set t.cur_cell: null
        set t.cur_rows: null
        set t.default_tblfmt_generated: false
        set t.no_parts_seen: true
        t
    }
}

