)
{
    function make(host: ref[Page]) returns ref[MifConsts]
    {
        let c host.allocate(sizeof MifConsts, alignof MifConsts) as pointer[MifConsts]
        set c.s_none: String()
        set c.s_space: String^host(" ")
        set c.s_default_tbl_format: String^host("Default Tbl Format")
