use scaly.memory.Page
use scaly.containers.Array
use opensp.Location.Location
use opensp.StringC.StringC
use dazzle.ELObj.ELObj
use dazzle.ELObj.GlyphSubstTableRec
; Identifier is reached only through `ic.ident.get_name()` below, and without
; this line the method did not resolve at all: lookup_concept answers null for
; an invisible concept, so the hop became an unresolved placeholder and the
; emitter's lenient extractvalue-at-field-0 recovery read `name` — which is
; exactly what get_name() returns, so the program was right by accident. Found
; by the member-not-found trap once the placeholder started recording the
; UNWRAPPED parent type (see Planner.resolve_member_access#).
use dazzle.ELObj.Identifier
use dazzle.ELObj.OutputCharStream
use dazzle.FrameMark.FrameMark
use dazzle.Grove.GroveNode
use dazzle.Insn.Insn
use dazzle.Interpreter.Interpreter
use dazzle.InterpreterMessages.InterpreterMessages
use dazzle.Style.StyleStack
use dazzle.Style.InheritedCInfo
use dazzle.Style.InheritedC
use dazzle.Style.VarStyleRec
use dazzle.Style.Convert
use dazzle.Style.FotSym
use dazzle.Style.LengthSpec
use dazzle.ProcessingMode.ProcessingMode

; VM — the threaded-code virtual machine (Style/VM.cxx). The evaluation loop
; is `while (insn) insn = insn->execute(this)`; each Insn advances the value
; stack (sbase/sp) and returns its successor. Frames and closures live on the
; control stack (csbase/csp). Error is signalled by driving sp negative (the
; C++ sp==NULL; C# sp==-1). One arena page per run: the stacks grow by
; allocating a fresh, larger buffer on the host and copying — never freed.
;
; Cross-module rule (port history S52): other modules reach VM state ONLY
; through the accessors below, never by direct field access.

; ControlStackEntry (VM.cs): a saved frame for popFrame to restore.
define ControlStackEntry
(
    var closure: pointer[pointer[ELObj]]
    var protect_closure: ref[ELObj]?
    var next: ref[Insn]?
    var frame_size: int
    var closure_loc: Location
    var continuation: ref[ELObj]?
)
{
    init()
    {
        this.closure := null
        this.protect_closure := null
        this.next := null
        this.frame_size := 0
        this.closure_loc := Location()
        this.continuation := null
    }
}

define VM
(
    interp: ref[Interpreter]?
    host: ref[Page]
    var sbase: pointer[pointer[ELObj]]
    var sp: int
    var slim: int
    var frame_start: int
    var closure: pointer[pointer[ELObj]]
    var protect_closure: ref[ELObj]?
    var closure_loc: Location
    var csbase: pointer[ControlStackEntry]
    var csp: int
    var cslim: int
    var n_actual_args: int
    ; EvalContext (VM.cxx base) — the node being processed by the enclosing
    ; construction rule. The `current-node` primitive reads it; ProcessContext
    ; sets it around each processNode eval (S6a Inc 5).
    var current_node: ref[GroveNode]?
    ; EvalContext.processingMode — the mode the process-* sosofo primitives
    ; capture; with-mode pushes/pops it (PushModeInsn/PopModeInsn). This was a
    ; pointer[void] on the stated ground that naming ProcessingMode here would
    ; cycle: MEASURED FALSE. A `use` cycle between modules of one package is
    ; not an error — dazzle already carries 19 mutual pairs, Insn <-> VM among
    ; them — and only a module-level `define` CONSTANT is order-sensitive.
    var processing_mode: ref[ProcessingMode]?
    ; grow-only save stack with a cursor (Array cannot shrink) — the open_count
    ; idiom.
    var mode_stack: ref[Array[ref[ProcessingMode]?]]?
    var mode_sp: size_t
    ; EvalContext.styleStack/specLevel/actualDependencies — non-null only while
    ; an inherited-characteristic value is being evaluated (style push,
    ; inherited-*/actual-*). spec_level -1 = the C++ unsigned(-1) sentinel.
    var style_stack: ref[StyleStack]?
    var spec_level: int
    var actual_deps: ref[Array[int]]?
    ; EvalContext.currentLanguage — what `with-language` binds and
    ; `current-language` reads; null means fall back to the interpreter's
    ; declare-default-language value (which is itself #f by default).
    var current_language: ref[ELObj]?
    ; the interpreter's frame-mark state block (null: the mark is off), kept
    ; here because the frame hooks run on the VM's hot path
    frame_mark: pointer[i64]
)
{
    function make(host: ref[Page], interp: ref[Interpreter]?) returns ref[VM]
    {
        var fm: pointer[i64] null
        if interp <> null
            fm := interp.frame_mark
        let vm &VM^host(interp, host, null, 0, 0, 0, null, null, Location(), null, 0, 0, 0, null, null, null, 0, null, 0 - 1, null, null, fm)
        ; Both stacks at their first size, HERE. Left to the first push they
        ; were two stores into a VM that existed already -- which is what the
        ; frame mark must take for a publication (grow_stack) -- and a
        ; primitive that evaluates a procedure makes a VM per call: measured
        ; 2026-10-07 on a production generator, 208 000 VMs, each raising the
        ; epoch twice, and 232 MB of frames around them never given back.
        let stack0 host.allocate((64 as size_t) * sizeof pointer[ELObj], alignof pointer[ELObj]) as pointer[pointer[ELObj]]
        vm.sbase := stack0
        vm.slim := 64
        let control0 host.allocate((8 as size_t) * sizeof ControlStackEntry, alignof ControlStackEntry) as pointer[ControlStackEntry]
        vm.csbase := control0
        vm.cslim := 8
        vm
    }

    function get_style_stack(this: VM) returns ref[StyleStack]?
        style_stack

    function get_spec_level(this: VM) returns int
        spec_level

    function get_actual_deps(this: VM) returns ref[Array[int]]
        actual_deps as ref[Array[int]]

    ; SetNonInheritedCInsn's per-characteristic dependency reset (the record
    ; is a sink during the NIC resolve — replaced, never truncated in place).
    procedure reset_actual_deps(mutable this: ref[VM])
    {
        if this.actual_deps <> null
        {
            let h this.host
            this.actual_deps := Array[int]^h()
        }
    }

    ; --- EvalContext current node (cross-module accessors) ------------------
    function get_current_node(this: VM) returns ref[GroveNode]?
        current_node

    function get_current_language(this: VM) returns ref[ELObj]?
        current_language

    procedure set_current_language(mutable this: ref[VM], l: ref[ELObj]?)
        this.current_language := l

    procedure set_current_node(mutable this: ref[VM], n: ref[GroveNode]?)
        this.current_node := n

    ; --- EvalContext processing mode (with-mode / process-* capture) --------
    function get_processing_mode(this: VM) returns ref[ProcessingMode]?
        processing_mode

    procedure set_processing_mode(mutable this: ref[VM], m: ref[ProcessingMode]?)
        this.processing_mode := m

    ; PushModeInsn: save the current mode, switch to `m`.
    procedure push_mode(mutable this: ref[VM], m: ref[ProcessingMode]?)
    {
        if this.mode_stack = null
        {
            let hp this.host
            this.mode_stack := Array[ref[ProcessingMode]?]^hp()
        }
        if this.mode_sp < this.mode_stack.get_length()
            this.mode_stack.put(this.mode_sp, this.processing_mode)
        else
            this.mode_stack.add(this.processing_mode)
        this.mode_sp := this.mode_sp + 1
        this.processing_mode := m
    }

    ; PopModeInsn: restore the saved mode.
    procedure pop_mode(mutable this: ref[VM])
    {
        if this.mode_sp = 0
            return
        this.mode_sp := this.mode_sp - 1
        this.processing_mode := this.mode_stack[this.mode_sp]
    }

    ; --- accessors (cross-module surface) ----------------------------------
    function get_sp(this: VM) returns int
        sp

    procedure set_sp(mutable this: ref[VM], n: int)
        this.sp := n

    ; ★★★THE ERROR SIGNAL, and it is the ONLY writer of a negative `sp` in the
    ; whole engine (`grep -rn "set_sp(0 - 1)\|set this.sp: 0 -"` must find
    ; nothing outside this file). It answers `null` so that a raising arm reads
    ; `return vm.fail()` and cannot set the flag without also ending the insn
    ; chain — which is exactly what lets `VM.eval`'s inner loop drop the
    ; `sp < 0` test it used to run after EVERY step (22 M times on the
    ; single-file codegen; the reference has no such test either and reads the
    ; failure after the loop, `if (sp)` in Insn.cxx:153). One deliberate
    ; two-hop exception, and only one: `VM.apply_shuffle` returns `false` and
    ; its single caller `ELObj.apply_call` turns that into `null`. Adding a
    ; site that raises WITHOUT ending the chain would let the loop run on with
    ; sp = -1 and store through `sbase - 1`.
    procedure fail(mutable this: ref[VM]) returns ref[Insn]?
    {
        this.sp := 0 - 1
        null
    }

    ; ★The UNWRAP is a claim, and the claim is true: `interp` is nullable only
    ; because `Jit.measure_layout` builds a throwaway VM to find the field
    ; offsets by sentinel search, and that VM never executes an instruction --
    ; every VM that runs is made with a real Interpreter. Confining the Option
    ; to `make` and this one line is deliberate: widening the ACCESSOR instead
    ; would push it onto 37 call sites, 26 of them in Insn.scaly's dispatch.
    function get_interp(this: VM) returns ref[Interpreter]
        interp as ref[Interpreter]

    ; value allocations during eval go through here — eval-scratch-aware via
    ; the Interpreter seam. The VM's OWN stacks keep growing on this.host
    ; directly (they persist across evals; scratch-hosted stacks would dangle).
    function get_host(this: VM) returns ref[Page]
        interp.get_host()

    function get_frame_start(this: VM) returns int
        frame_start

    procedure set_frame_start(mutable this: ref[VM], n: int)
        this.frame_start := n

    function get_closure(this: VM) returns pointer[pointer[ELObj]]
        closure

    procedure set_closure(mutable this: ref[VM], d: pointer[pointer[ELObj]])
        this.closure := d

    procedure set_protect_closure(mutable this: ref[VM], c: ref[ELObj])
        this.protect_closure := c

    procedure set_closure_loc(mutable this: ref[VM], loc: Location)
        this.closure_loc := loc

    function get_n_actual_args(this: VM) returns int
        n_actual_args

    procedure set_n_actual_args(mutable this: ref[VM], n: int)
        this.n_actual_args := n

    ; value-stack element access (sbase[i]).
    function stack_ref(this: VM, i: int) returns ref[ELObj]?
        *(sbase + i)

    procedure stack_set(mutable this: ref[VM], i: int, v: ref[ELObj]?)
        *(this.sbase + i) := v

    ; a raw pointer into the value stack at index i (arg slices for primitives).
    function sbase_at(this: VM, i: int) returns pointer[pointer[ELObj]]
        sbase + i

    ; closure-display element (closure[i]).
    function closure_ref(this: VM, i: int) returns ref[ELObj]
        *(closure + i)

    ; --- stack growth ------------------------------------------------------
    procedure need_stack(mutable this: ref[VM], n: int)
    {
        if this.sp + n > this.slim
            this.grow_stack(n)
    }

    ; The TEST half of need_stack, on its own. An arm that must stay call-free
    ; asks this and tail-calls out when it answers true (Insn.execute_grow) —
    ; calling `need_stack` instead drags the inlined `grow_stack`, and with it
    ; `Page.allocate`, into the caller, which costs that caller a stack frame.
    function needs_grow(this: VM, n: int) returns bool
        sp + n > slim

    procedure grow_stack(mutable this: ref[VM], n: int)
    {
        var new_size this.sp
        if n > new_size
            new_size := new_size + (((n + 15) / 16) * 16)
        else
            new_size := new_size + new_size
        if new_size < 64
            new_size := 64
        let buf this.host.allocate((new_size as size_t) * sizeof pointer[ELObj], alignof pointer[ELObj]) as pointer[pointer[ELObj]]
        var i 0
        while i < this.sp
        {
            *(buf + i) := *(this.sbase + i)
            i := i + 1
        }
        this.slim := new_size
        this.sbase := buf
        this.closure := this.closure
        ; ★The new buffer lies at the END of the host's region, and this VM
        ; keeps it: where the VM itself lives in the region the frame mark
        ; rewinds, below the running frame's mark, the buffer would go back
        ; with that frame while `sbase` still points at it. A store into a
        ; pre-existing object, in FrameMark's sense -- the hook decides by the
        ; target. (Found 2026-10-05 on the control stack below.)
        FrameMark.store(this.frame_mark, this as pointer[void])
    }

    ; --- control stack -----------------------------------------------------
    procedure push_frame(mutable this: ref[VM], next: ref[Insn]?, args_pushed: int)
    {
        if this.csp >= this.cslim
        {
            var new_size 8
            if this.cslim > 0
                new_size := this.cslim * 2
            let nb this.host.allocate((new_size as size_t) * sizeof ControlStackEntry, alignof ControlStackEntry) as pointer[ControlStackEntry]
            var i 0
            while i < this.csp
            {
                *(nb + i) := *(this.csbase + i)
                i := i + 1
            }
            this.cslim := new_size
            this.csbase := nb
            ; ★As in grow_stack#: the VM keeps a buffer that was allocated
            ; while a marked frame ran. Without this hook the frame's pop
            ; released the control stack itself, and the next pop_frame read
            ; its entry out of freed memory -- the DocBook HTML stylesheets
            ; over a 12-chapter book, the first input that nested deeper than
            ; the stack's size inside one marked frame (2026-10-05; the
            ; output was right with DAZZLE_FRAME_MARK=0).
            FrameMark.store(this.frame_mark, this as pointer[void])
        }
        let e this.csbase + this.csp
        e.closure := this.closure
        e.protect_closure := this.protect_closure
        e.next := next
        e.frame_size := this.sp - this.frame_start - args_pushed
        e.closure_loc := this.closure_loc
        e.continuation := null
        this.csp := this.csp + 1
        ; the frame mark is taken here and honoured at the matching pop
        FrameMark.push(this.frame_mark, this.csp)
    }

    procedure pop_frame(mutable this: ref[VM]) returns ref[Insn]?
    {
        this.csp := this.csp - 1
        let e this.csbase + this.csp
        if e.continuation <> null
            e.continuation.continuation_kill()
        this.closure := e.closure
        this.protect_closure := e.protect_closure
        this.frame_start := this.sp - e.frame_size
        this.closure_loc := e.closure_loc
        e.next
    }

    ; --- call/cc control-stack helpers -------------------------------------
    function get_csp(this: VM) returns int
        csp

    ; VM::setClosureArgToCC — record the continuation (the closure's sole arg,
    ; now at sp[-1]) in the just-pushed frame and stamp its captured sizes.
    procedure set_closure_arg_to_cc(mutable this: ref[VM], mutable k: ref[ELObj])
    {
        let e this.csbase + (this.csp - 1)
        e.continuation := k
        k.continuation_set(this.sp, this.csp)
    }

    ; ContinuationObj::call unwind: pop the control stack down to target_csp,
    ; killing any continuations captured above it.
    procedure unwind_control_stack(mutable this: ref[VM], target_csp: int)
    {
        ; a call/cc unwind drops frames without a Return, so nothing above
        ; any live mark can be trusted afterwards
        if this.csp > target_csp
            FrameMark.publish(this.frame_mark)
        while this.csp > target_csp
        {
            this.csp := this.csp - 1
            let e this.csbase + this.csp
            if e.continuation <> null
                e.continuation.continuation_kill()
        }
    }

    procedure init_stack(mutable this: ref[VM])
    {
        this.sp := 0
        this.frame_start := 0
        this.csp := 0
    }

    ; --- eval loop (VM::eval) ----------------------------------------------
    ; An evaluation may run INSIDE another one -- a primitive that calls a
    ; procedure does it on a VM of its own, which counts its frames from 1.
    ; Its frames take the columns AFTER the innermost live frame's
    ; (FrameMark.nest_under), and the base and the innermost frame are put
    ; back when it is over: before, the inner frames wrote over the columns of
    ; the live ones, and left the mark believing no frame was live at all, so
    ; that every later store was a publication.
    procedure eval(mutable this: ref[VM], mutable insn_in: ref[Insn]?, display: pointer[pointer[ELObj]], arg: ref[ELObj]?) returns ref[ELObj]?
    {
        let fmk this.frame_mark
        let fm_base FrameMark.nest_state(fmk, FM_BASE)
        let fm_top FrameMark.nest_state(fmk, FM_TOP)
        ; (eval_run counts this VM's frames from 1: init_stack)
        FrameMark.nest_under(fmk, 0)
        let answer this.eval_run(insn_in, display, arg)
        FrameMark.nest_back(fmk, fm_base, fm_top)
        answer
    }

    procedure eval_run(mutable this: ref[VM], mutable insn_in: ref[Insn]?, display: pointer[pointer[ELObj]], arg: ref[ELObj]?) returns ref[ELObj]?
    {
        this.init_stack()
        if arg <> null
        {
            this.need_stack(1)
            *(this.sbase + this.sp) := arg
            this.sp := this.sp + 1
        }
        this.closure := display
        this.protect_closure := null
        this.closure_loc := Location()

        ; ★★★The loop has NO per-step `sp < 0` test, and neither has the
        ; reference (`while (insn) insn = insn->execute(*this);`, Insn.cxx:150,
        ; which reads the failure afterwards as `if (sp)`). It cannot need one:
        ; `VM.fail` is the only writer of a negative `sp` and it answers the
        ; `null` that ends the chain, so a raise always leaves the loop by the
        ; condition it already has. The test used to run after EVERY step — a
        ; load and a branch, 22 M times on the single-file codegen. The
        ; invariant lives at `VM.fail`; do not re-add the test, ADD TO the
        ; invariant.
        var insn: ref[Insn]? insn_in
        while insn <> null
            insn := insn.execute(this)

        if this.sp >= 0
        {
            this.sp := this.sp - 1
            return *(this.sbase + this.sp)
        }
        ; -G (VM::eval's error tail): print where the error was raised from.
        if this.interp.get_debug_mode()
            this.stack_trace()
        this.interp.make_error()
    }

    ; VM::stackTrace — the `called from here` chain over the control stack's
    ; closure-call locations, newest first. Frame 5 elides the middle when
    ; more than 7 frames follow (`called from here...(%1 calls omitted)`),
    ; resuming with the OLDEST 6 frames — byte-exact Insn.cxx arithmetic.
    ; The currently executing closure (protect_closure) contributes the first
    ; line; the bottom control-stack entry is skipped when it is the eval
    ; root (no protecting closure).
    procedure stack_trace(mutable this: ref[VM])
    {
        let itp this.interp
        var count 0
        if this.protect_closure <> null
        {
            itp.set_next_location(this.closure_loc)
            itp.message0(InterpreterMessages.stackTrace())
            count := count + 1
        }
        var lim 0
        if this.csp <> 0
        {
            let bot this.csbase
            if bot.protect_closure = null
                lim := 1
        }
        var p this.csp
        while p <> lim
        {
            let e this.csbase + (p - 1)
            itp.set_next_location(e.closure_loc)
            count := count + 1
            if (count = 5) and ((p - lim) > 7)
            {
                itp.message_num(InterpreterMessages.stackTraceEllipsis(), (p - (lim + 6)) as u64)
                p := lim + 6
            }
            else
                itp.message0(InterpreterMessages.stackTrace())
            p := p - 1
        }
    }

    ; ApplyPrimitiveObj::shuffle — the (apply f a b list) argument reshuffle:
    ; drop f from under the args, splice the trailing list, push f on top.
    procedure apply_shuffle(mutable this: ref[VM], loc: Location) returns bool
    {
        let n_args this.n_actual_args
        let func *(this.sbase + (this.sp - n_args))
        var i n_args - 2
        while i > 0
        {
            *(this.sbase + (this.sp - i - 2)) := *(this.sbase + (this.sp - i - 1))
            i := i - 1
        }
        this.n_actual_args := n_args - 2
        var list *(this.sbase + (this.sp - 1))
        this.sp := this.sp - 2
        while (list <> null) and (list.is_nil() = false)
        {
            if list.is_pair() = false
            {
                ; notAList naming "apply", the ORIGINAL argument count as the
                ; ordinal and the printed offender (ApplyPrimitiveObj::shuffle,
                ; Insn.cxx:481). ★The ordinal is `n_args`, not the shuffled
                ; count — the reference reads it before the shuffle rewrote it.
                this.interp.set_next_location(loc)
                let ihost this.interp.get_host()
                let os OutputCharStream.make(ihost)
                var printed StringC()
                if list <> null
                {
                    list.print(os, this.interp.get_units_per_inch())
                    printed := os.to_string_c(ihost)
                }
                let nm Interpreter.ascii_string_c(ihost, "apply")
                this.interp.message3(InterpreterMessages.notAList(), nm, n_args as u64, printed)
                ; the ONE two-hop raise (see VM.fail): this answers `false` and
                ; `ELObj.apply_call` turns that into the `null` that ends the
                ; insn chain — never a `false` that is ignored.
                this.fail()
                return false
            }
            this.need_stack(1)
            this.n_actual_args := this.n_actual_args + 1
            *(this.sbase + this.sp) := list.get_car()
            this.sp := this.sp + 1
            list := list.get_cdr()
        }
        this.need_stack(1)
        *(this.sbase + this.sp) := func
        this.sp := this.sp + 1
        true
    }

    ; --- inherited-characteristics evaluation glue ---------------------------
    ; Ports InheritedC::value / VarInheritedC::set+value and StyleStack::
    ; inherited/actual (Style.cxx, InheritedC.cxx). It lives HERE because
    ; Style.scaly cannot evaluate code (Style importing VM would close the
    ; VM→Insn→Style cycle). Evaluation always runs in a FRESH VM (the
    ; reference's StyleStack::inherited does the same; pushEnd's reuse of the
    ; processing VM is not reentrancy-safe for our eval loop).

    ; InheritedC::value — the ELObj form of a CONSTANT spec's value.
    procedure ic_value_of(host: ref[Page], mutable interp: ref[Interpreter], ic: ref[InheritedC]) returns ref[ELObj]
    {
        let kind ic.get_kind()
        if kind = IC_BOOL
        {
            if ic.bval
                return interp.make_true()
            return interp.make_false()
        }
        if kind = IC_LENGTH
            return ELObj.make_length(host, ic.lval)
        if kind = IC_LENGTH_SPEC
        {
            ; Interpreter::makeLengthSpec: a display-size factor makes an
            ; engine length-spec, else a plain LengthObj.
            if ic.ls.factor <> 0.0
                return ELObj.make_length_spec(host, ic.ls.length as double, ic.ls.factor, 0.0)
            return ELObj.make_length(host, ic.ls.length)
        }
        if kind = IC_SYMBOL
        {
            if ic.sym.code = SYM_FALSE
                return interp.make_false()
            if ic.sym.code = SYM_TRUE
                return interp.make_true()
            return interp.make_symbol(ic.sym.name)
        }
        if kind = IC_STRING
            return ELObj.make_string(host, ic.sval)
        if kind = IC_INT
            return ELObj.make_integer(host, ic.lval)
        if kind = IC_MAYBE_INT
        {
            if ic.lval = 0
                return interp.make_false()
            return ELObj.make_integer(host, ic.lval)
        }
        if kind = IC_PUBLIC_ID
        {
            if ic.bval or (ic.sval.get_size() = 0)
                return interp.make_false()
            return ELObj.make_string(host, ic.sval)
        }
        if kind = IC_LETTER2
        {
            if ic.bval or (ic.sval.get_size() = 0)
                return interp.make_false()
            ; Letter2InheritedC::value quirk: the symbol name is the two
            ; letters PLUS an appended NUL char (reference `buf += 0`).
            var buf u32[3]
            *(buf as pointer[u32]) := ic.sval.get(0)
            buf[1] := ic.sval.get(1)
            buf[2] := 0
            let nul_name StringC(buf as pointer[u32], 3)
            return interp.make_symbol(nul_name)
        }
        if kind = IC_IGNORED
            return ic.obj as ref[ELObj]
        if kind = IC_BORDER
            return ic.obj as ref[ELObj]
        if kind = IC_COLOR
        {
            ; ColorC::value — the stored ColorObj (#f only if unset).
            if ic.obj = null
                return interp.make_false()
            return ic.obj as ref[ELObj]
        }
        if kind = IC_OPT_COLOR
        {
            if ic.obj = null
                return interp.make_false()
            return ic.obj as ref[ELObj]
        }
        if kind = IC_OPT_LENGTH_SPEC
        {
            ; OptLengthSpecInheritedC::value — #f, or makeLengthSpec.
            if ic.bval
                return interp.make_false()
            if ic.ls.factor <> 0.0
                return ELObj.make_length_spec(host, ic.ls.length as double, ic.ls.factor, 0.0)
            return ELObj.make_length(host, ic.ls.length)
        }
        if kind = IC_INLINE_SPACE
        {
            ; GenericInlineSpaceInheritedC::value — the inline-space object.
            if ic.obj = null
                return interp.make_false()
            return ic.obj as ref[ELObj]
        }
        if kind = IC_OPT_INLINE_SPACE
        {
            if ic.obj = null
                return interp.make_false()
            return ic.obj as ref[ELObj]
        }
        if kind = IC_GST
        {
            ; GlyphSubstTableC::value — rewrap the stored tables in fresh
            ; objects; bval = the list form (() and #f stay distinct).
            let tabs ic.gst
            if ic.bval
            {
                var list interp.make_nil()
                var i: size_t 0
                if tabs <> null
                    i := tabs.get_length()
                while i > 0
                {
                    let tp tabs.get(i - 1)
                    if tp <> null
                    {
                        let wrapped ELObj.make_glyph_subst_table(host, *tp)
                        list := ELObj.make_pair(host, wrapped, list)
                    }
                    i := i - 1
                }
                return list
            }
            if tabs = null
                return interp.make_false()
            if tabs.get_length() = 0
                return interp.make_false()
            let tp0 tabs.get(0)
            if tp0 = null
                return interp.make_false()
            return ELObj.make_glyph_subst_table(host, *tp0)
        }
        if kind = IC_RULE
            return ic.obj as ref[ELObj]
        interp.make_false()
    }

    ; evaluate a spec's value: VarInheritedC::value (fresh VM, the style's
    ; display + creation node, spec_level per caller) or the constant form.
    procedure eval_spec_value(mutable spec: ref[InheritedC], style: ref[VarStyleRec]?, ss: ref[StyleStack]?, spec_level: int, mutable interp: ref[Interpreter], deps: ref[Array[int]]) returns ref[ELObj]?
    {
        let host interp.get_host()
        if spec.is_var()
        {
            let vm VM.make(host, interp)
            vm.style_stack := ss
            vm.spec_level := spec_level
            vm.actual_deps := deps
            var disp: pointer[pointer[ELObj]] null
            if style <> null
            {
                vm.current_node := style.node
                disp := style.display
            }
            return vm.eval(spec.code as ref[Insn], disp, null)
        }
        VM.ic_value_of(host, interp, spec)
    }

    ; StyleStack::inherited — the value of `ic` as seen from a spec at
    ; `spec_level` (the level below its own specification).
    procedure stack_inherited(ss: ref[StyleStack], mutable ic: ref[InheritedC], spec_level: int, mutable interp: ref[Interpreter], deps: ref[Array[int]]) returns ref[ELObj]?
    {
        var spec ic
        var style: ref[VarStyleRec]? null
        var new_spec_level 0 - 1
        var p ss.info_at(ic.get_index())
        while p <> null
        {
            if p.spec_level < spec_level
                break
            p := p.prev
        }
        if p <> null
        {
            if p.cached_value <> null
            {
                ; the cached value holds only while none of the values it
                ; depended on was re-specified since it was computed.
                var cache_ok true
                let pd p.dependencies
                let nd pd.get_length()
                var i: size_t 0
                while i < nd
                {
                    let dp pd.get(i)
                    if dp <> null
                    {
                        let q ss.info_at(*dp)
                        if q <> null
                        {
                            if q.val_level > p.val_level
                                cache_ok := false
                        }
                    }
                    i := i + 1
                }
                if cache_ok
                    return p.cached_value
            }
            style := p.style
            spec := p.spec
            new_spec_level := p.spec_level
        }
        VM.eval_spec_value(spec, style, ss, new_spec_level, interp, deps)
    }

    ; StyleStack::actual — the actual (current-level) value of `ic`, with
    ; circularity detection over the accumulating dependency list.
    procedure stack_actual(ss: ref[StyleStack], mutable ic: ref[InheritedC], loc: Location, mutable interp: ref[Interpreter], mutable deps: ref[Array[int]]) returns ref[ELObj]?
    {
        let ind ic.get_index()
        let n deps.get_length()
        var i: size_t 0
        while i < n
        {
            let dp deps.get(i)
            if dp <> null
            {
                if *dp = ind
                {
                    interp.set_next_location(loc)
                    interp.message1(InterpreterMessages.actualLoop(), ic.ident.get_name())
                    return interp.make_error()
                }
            }
            i := i + 1
        }
        deps.add(ind)
        var spec ic
        var style: ref[VarStyleRec]? null
        let p ss.info_at(ind)
        if p <> null
        {
            if p.cached_value <> null
            {
                let pd p.dependencies
                let nd pd.get_length()
                var j: size_t 0
                while j < nd
                {
                    let ddp pd.get(j)
                    if ddp <> null
                        deps.add(*ddp)
                    j := j + 1
                }
                return p.cached_value
            }
            style := p.style
            spec := p.spec
        }
        VM.eval_spec_value(spec, style, ss, ss.get_level(), interp, deps)
    }

    ; pushEnd's per-spec body (VarInheritedC::set): resolve a pushed spec to
    ; the CONSTANT characteristic the sink renders — evaluating + caching a
    ; VarInheritedC's value on first use; null = invalid/error (nothing set).
    procedure resolve_set(ss: ref[StyleStack]?, mutable info: ref[InheritedCInfo], mutable interp: ref[Interpreter]) returns ref[InheritedC]?
    {
        let spec info.spec
        if spec.is_var() = false
            return spec
        if info.cached_value = null
            info.cached_value := VM.eval_spec_value(spec, info.style, ss, info.spec_level, interp, info.dependencies)
        let v info.cached_value
        if v = null
            return null
        if interp.is_error(v)
            return null
        Convert.ic_from_value(interp.get_host(), (spec.get_proto()) as ref[InheritedC], v, spec.loc, interp)
    }
}
