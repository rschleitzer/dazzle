; The scratch directory the package SELF-TESTS write their fixtures to.
;
; The self-tests of SchemeParser, DssslSpecEventHandler and TransformFOTBuilder
; write small documents to disk and parse them back (a grove from a real parse,
; a style sheet reached by file path, a FOT builder's directory output). Until
; 2026-09-20 every one of those paths was a literal `/tmp/...` — and on the
; Windows box a native program resolves `/tmp` against the current DRIVE root
; (`C:\tmp`, which does not exist), so `File.write_from_string` answered false
; and dazzle.test() returned -192 with nothing else wrong (tests/win32/
; WINDOWS-BOX.md §4a). The same `TMP` → `TEMP` → `/tmp` chain the compiler's
; own link driver uses (cli.scaly windows_scratch_dir): on POSIX neither
; variable is normally set, so the tests keep writing to /tmp exactly as before.
;
; A concept WITH a field on purpose: a define without fields is a namespace
; whose functions mangle without its name (CLAUDE.md, "Calls & operands").
;
; ★A PROCEDURE: reading the environment reaches outside the program.
use scaly.containers.String.String
use scaly.containers.StringBuilder.StringBuilder

define TestScratch (unused: int)
{
    ; ★Forward slashes, always: Windows spells TMP with backslashes, the Win32
    ; file API takes either, and the PORTED path logic (opensp's entity
    ; resolution, upstream's POSIX storage manager) splits a directory off at
    ; `/` only — a fixture reached through `C:\...\x.dsl` would resolve its
    ; relative system identifiers against nothing.
    procedure dir() returns String
    {
        var d getenv "TMP"
        if d = null
            set d: getenv("TEMP")
        if d = null
            return String("/tmp")
        let raw String(d)
        let n raw.get_length()
        if n = 0
            return String("/tmp")
        let bytes raw.as_slice()
        var sb StringBuilder()
        var i: size_t 0
        while i < n
        {
            ; TYPED: an untyped binding aliases the reference `at` answers, and
            ; `as char` on a reference casts the ADDRESS (root CLAUDE.md,
            ; "A `ref[T]` READS AND WRITES AS ITS POINTEE ... Does NOT fire: an
            ; `as` cast") — measured here as a path of rising byte values.
            let c: u8 bytes.at(i)
            if c = 0x5C
                sb.append("/" as char)
            else
                sb.append(c as char)
            set i: i + 1
        }
        sb.to_string()
    }

    ; <dir>/<leaf>
    procedure path(leaf: pointer[const_char]) returns String
    {
        var sb StringBuilder()
        sb.append(TestScratch.dir())
        sb.append "/"
        sb.append leaf
        sb.to_string()
    }
}

function getenv(name: pointer[const_char]) returns pointer[const_char] extern
