use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.Location.Location
use opensp.ElementType.ElementType
use opensp.AttributeList.AttributeList
use opensp.Attribute.AttributeValue
use opensp.Attribute.Text
use opensp.Event.Event
use opensp.ParserState.ParserState

; opensp Event.event_type discriminants — mirrored locally (cross-package
; module consts don't resolve via `use`, and the shared EVK_* mirror lives in
; DssslSpecEventHandler; these GEV_* mirror the same stable Event ABI).
define GEV_START_ELEMENT: int 0
define GEV_END_ELEMENT: int 1
define GEV_DATA: int 2
define GEV_PI: int 3
define GEV_SDATA: int 9

; Grove — the SGML property set (DSSSL grove). Inc-4 foundation: a Node tree
; built from the opensp Event stream (SPGrove/GroveBuilder), plus the
; node-list navigation the style primitives run over. This is the minimal
; grove — element/data/pi/document node classes, the child axis, gi + data +
; attribute-string accessors. The full property axis system (address-of,
; the named-property machinery, subgroves) is a later slice.

define GN_DOCUMENT: int 0
define GN_ELEMENT: int 1
define GN_DATA: int 2
define GN_PI: int 3

; A grove node. `children` is null for leaf (data/pi) nodes; element/document
; nodes carry the ordered child list. `chars` holds a data node's text.
define GroveNode (node_class: int, gi: StringC, chars: StringC, attributes: pointer[AttributeList], parent: pointer[GroveNode], children: pointer[Array[pointer[GroveNode]]])
{
    function make(host: pointer[Page], node_class: int) returns pointer[GroveNode]
    {
        let p host.allocate(sizeof GroveNode, alignof GroveNode) as pointer[GroveNode]
        set p.node_class: node_class
        set p.gi: StringC()
        set p.chars: StringC()
        set p.attributes: null
        set p.parent: null
        set p.children: Array[pointer[GroveNode]]^host()
        p
    }

    function get_class(this: GroveNode) returns int
        node_class

    function get_gi(this: GroveNode) returns StringC
        gi

    function get_chars(this: GroveNode) returns StringC
        chars

    function get_attributes(this: GroveNode) returns pointer[AttributeList]
        attributes

    function get_parent(this: GroveNode) returns pointer[GroveNode]
        parent

    function get_children(this: GroveNode) returns pointer[Array[pointer[GroveNode]]]
        children

    function child_count(this: GroveNode) returns int
    {
        if children = null
            return 0
        children.get_length() as int
    }

    function child_at(this: GroveNode, i: int) returns pointer[GroveNode]
    {
        if children = null
            return null
        *(children.get_buffer() + i)
    }

    function add_child(this: pointer[GroveNode], c: pointer[GroveNode])
        this.children.add(c)
}

; GroveBuilder — walk ps.events into a document node tree. Mirrors
; SPGrove's event-driven build: start pushes an element under the current
; node, end pops, data/sdata append a data leaf, pi appends a pi leaf.
; One entry of the grove ID index: an ID-attribute value and the element it
; identifies. See GroveBuilder.build_id_index.
define IdEntry (id: StringC, node: pointer[GroveNode])
{
}

define GroveBuilder
{
    function build(host: pointer[Page], ps: pointer[ParserState]) returns pointer[GroveNode]
    {
        let root GroveNode.make(host, GN_DOCUMENT)
        let events ps.get_events()
        if events = null
            return root
        var current root
        let n events.get_length()
        let buf events.get_buffer()
        var i: size_t 0
        while i < n
        {
            let ev *(buf + i)
            let t ev.get_type()
            if t = GEV_START_ELEMENT
            {
                let et ev.get_element_type()
                let node GroveNode.make(host, GN_ELEMENT)
                if et <> null
                {
                    let nm et.get_name()
                    set node.gi: StringC^host(nm.data_ptr(), nm.get_size())
                }
                set node.attributes: ev.get_attributes()
                set node.parent: current
                current.add_child(node)
                set current: node
            }
            else if t = GEV_END_ELEMENT
            {
                let p current.get_parent()
                if p <> null
                    set current: p
            }
            else if (t = GEV_DATA) or (t = GEV_SDATA)
            {
                let d ev.get_data()
                let node GroveNode.make(host, GN_DATA)
                set node.chars: StringC^host(d.data_ptr(), d.get_size())
                set node.parent: current
                current.add_child(node)
            }
            else if t = GEV_PI
            {
                let d ev.get_data()
                let node GroveNode.make(host, GN_PI)
                set node.chars: StringC^host(d.data_ptr(), d.get_size())
                set node.parent: current
                current.add_child(node)
            }
            set i: i + 1
        }
        root
    }

    ; build_id_index: walk the grove and collect (id-value -> element node) for
    ; every element carrying an ID-typed attribute (declared TYPE ID in the DTD;
    ; opensp flags it via AttributeList.id(i)). Backs element-with-id. Linear
    ; Array, matching the interpreter's NamedTable shape; lookup is by StringC
    ; value equality (opensp already normalizes ID/IDREF tokens consistently).
    function build_id_index(host: pointer[Page], root: pointer[GroveNode]) returns pointer[Array[pointer[IdEntry]]]
    {
        let index Array[pointer[IdEntry]]^host()
        GroveBuilder.collect_ids(host, root, index)
        index
    }

    function collect_ids(host: pointer[Page], node: pointer[GroveNode], index: pointer[Array[pointer[IdEntry]]])
    {
        if node.node_class = GN_ELEMENT
        {
            let atts node.attributes
            if atts <> null
            {
                let sz atts.size()
                var i: size_t 0
                while i < sz
                {
                    if atts.id(i)
                    {
                        let v atts.value(i)
                        if v <> null
                        {
                            let t v.get_text()
                            if t <> null
                            {
                                let e host.allocate(sizeof IdEntry, alignof IdEntry) as pointer[IdEntry]
                                let s t.string()
                                set e.id: StringC^host(s.data_ptr(), s.get_size())
                                set e.node: node
                                index.add(e)
                            }
                        }
                    }
                    set i: i + 1
                }
            }
        }
        let ch node.children
        if ch <> null
        {
            let cn ch.get_length()
            let cb ch.get_buffer()
            var j: size_t 0
            while j < cn
            {
                GroveBuilder.collect_ids(host, *(cb + j), index)
                set j: j + 1
            }
        }
    }

    ; A small hand-built grove for the node-list unit test:
    ;   document > para > ["Hello", emph > "world"]
    function build_test_grove(host: pointer[Page]) returns pointer[GroveNode]
    {
        let doc GroveNode.make(host, GN_DOCUMENT)
        let para GroveNode.make(host, GN_ELEMENT)
        set para.gi: StringC^host("para")
        set para.parent: doc
        doc.add_child(para)
        let d1 GroveNode.make(host, GN_DATA)
        set d1.chars: StringC^host("Hello")
        set d1.parent: para
        para.add_child(d1)
        let emph GroveNode.make(host, GN_ELEMENT)
        set emph.gi: StringC^host("emph")
        set emph.parent: para
        para.add_child(emph)
        let d2 GroveNode.make(host, GN_DATA)
        set d2.chars: StringC^host("world")
        set d2.parent: emph
        emph.add_child(d2)
        doc
    }
}
