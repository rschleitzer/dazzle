use scaly.memory.Page
use dazzle.FrameMark.FrameMark
use scaly.containers.Array
use dazzle.NameTable.NameTable
use opensp.StringC.StringC
use opensp.Location.Location
use opensp.Location.Origin
use opensp.ElementType.ElementType
use opensp.AttributeList.AttributeList
use opensp.Attribute.AttributeValue
use opensp.Attribute.AttributeDefinition
use opensp.Attribute.Text
use opensp.ElementType.ElementDefinition
use opensp.Entity.Entity
use opensp.Event.Event
use opensp.ParserState.ParserState
use opensp.Dtd.Dtd

; opensp Event.event_type discriminants — mirrored locally (cross-package
; module consts don't resolve via `use`, and the shared EVK_* mirror lives in
; DssslSpecEventHandler; these GEV_* mirror the same stable Event ABI).
define GEV_START_ELEMENT: int 0
define GEV_END_ELEMENT: int 1
define GEV_DATA: int 2
define GEV_PI: int 3
; ExternalDataEntityEvent (an NDATA entity reference in content) and
; SubdocEntityEvent — the grove's external-data and subdocument nodes. The
; port's parser names the subdoc event START_SUBDOC because the ESIS writer
; brackets its own sub-parse with it; under dazzle no sub-parse happens (see
; ParserState.app_parses_subdocs), so exactly one event arrives, as in the
; reference's GroveBuilderEventHandler::subdocEntity.
define GEV_ENTITY_REF: int 4
define GEV_START_SUBDOC: int 6
define GEV_END_PROLOG: int 8
define GEV_SDATA: int 9
; NonSgmlCharEvent — a numeric character reference to a character the SGML
; declaration does not describe.
define GEV_NONSGML: int 11
define GEV_APPINFO: int 5
define GEV_ENTITY_DEFAULTED: int 12

; opensp ElementType.DC_EMPTY — mirrored for the same reason.
define GDC_EMPTY: int 4

; Grove — the SGML property set (DSSSL grove): a Node tree built from the
; opensp Event stream (SPGrove/GroveBuilder), the axes the style primitives
; navigate, and the class metadata (ComponentName + ClassDef) that
; node-property answers from. All of the reference's node classes exist here —
; sgml-document, element, data-char, pi, the two attribute classes, the nine
; declaration classes and the ENTITY-REFERENCE branch (sdata, external-data,
; subdocument, non-sgml) — plus `message`, which is metadata only: its sole
; reference consumer is the Windows-only groveoa component, so no in-scope
; program can obtain such a node (tests/dazzle/COMPLETENESS.md). Still a later
; slice: addresses/subgroves.

define GN_DOCUMENT: int 0
define GN_ELEMENT: int 1
define GN_DATA: int 2
define GN_PI: int 3
; The ATTRIBUTE axis (AttributeAsgnNode / AttributeValueTokenNode). Like data
; nodes these are VIEWS, not built tree nodes: an assignment is
; (origin element, attribute index) and a value token adds the token index —
; exactly the reference's same2 identity — so `chunk` holds the origin, and
; `char_index` / `element_index` the two indices (see GroveNode.attr_view).
define GN_ATTR_ASSIGN: int 4
define GN_ATTR_TOKEN: int 5
; The DECLARATION node classes — the prolog's own grove, handed out by the
; named node lists (`entities`, `notations`, `element-types`, `attribute-defs`,
; `doctypes-and-linktypes`, …) and by the single-node properties around them.
;
; None of these is a BUILT node either: like the data and attribute views they
; are materialized per access over an opensp DECLARATION OBJECT, which the
; `decl` slot holds and which IS their identity (every same2 in the reference
; compares the underlying Entity / Notation / ElementType / ModelGroup /
; AttributeDefinitionList pointer, never the node object). `parent` holds the
; OWNER node — the chain an attribute-def / external-id / content token climbs to
; reach the sgml-document node for `grove-root` — while the parent AXIS is null
; for all of them (Node::getParent's default) and `origin` is answered per class
; (see Primitive.node_property_value), because the two differ: an ATTRIBUTE-DEF's
; origin is another attribute-def (AttributeDefNode::getOrigin builds one through
; makeOriginNode), and a DEFAULTED entity's origin is the grove root rather than
; its doctype.
define GN_ENTITY: int 6
define GN_NOTATION: int 7
define GN_DOCUMENT_TYPE: int 8
define GN_DEFAULT_ENTITY: int 9
define GN_EXTERNAL_ID: int 10
define GN_ELEMENT_TYPE: int 11
define GN_ATTRIBUTE_DEF: int 12
define GN_MODEL_GROUP: int 13
define GN_ELEMENT_TOKEN: int 14
define GN_PCDATA_TOKEN: int 15
define GN_SGML_CONSTANTS: int 16

; The ENTITY-REFERENCE branch — the content nodes an entity reference (or a
; non-SGML character reference) leaves behind. Like data and pi nodes these are
; CHUNK nodes: built by the builder, sitting in their element's child list with
; the ordinary parent / sibling axes; `decl` holds the referenced Entity (the
; reference's EntityRefChunk::entity, which `entity-name` and `entity` answer
; from) and `chars` its replacement text where there is one.
;
; ★A GN_SDATA node is NOT a data node: the reference keeps SdataNode its own
; class whose ONE character comes from the SdataMapper (Interpreter::sdataMap),
; never from the replacement text — `char`, `data` and everything a backend
; sees go through Primitive.sdata_char.
define GN_SDATA: int 17
define GN_EXTERNAL_DATA: int 18
define GN_SUBDOC: int 19
; ★NonSgmlNode and MessageNode are the reference's two FIXME classes
; (grove/Node.cxx:1420/1429): ClassDef::nonSgml and ClassDef::message declare
; noId as their class name and noProps for BOTH name lists, so `class-name` is
; the EMPTY symbol and `all-property-names` the empty list — measured, not
; guessed (tests/dazzle/grove/props5).
define GN_NONSGML: int 20
; `message` exists as class METADATA only. The reference builds MessageNodes
; from GroveImpl's message list, but the only code that reads that list is
; groveoa (the Windows OLE automation component, out of scope): no DSSSL
; primitive and no backend reaches getMessages/getSeverity, so no in-scope
; program can obtain a node of this class — here or in the reference.
define GN_MESSAGE: int 21

; ★The grove-wide tables that used to live here as `shared` driver cells
; (GROVE_SUBST / GROVE_DEFAULTED_ENTS / GROVE_ENTITY_DEFAULTED / GROVE_APPINFO,
; plus the interpreter's grove_dtd / grove_id_index) are now fields of
; `GroveInfo`, one record per grove, hanging off the sgml-document node — the
; reference's GroveImpl. A single cell was right only while `sgml-parse` was a
; stub and exactly one grove could exist; with the GroveManager a run holds any
; number, and every consumer reaches the right one through Node::getGroveRoot.

; GroveNode.flags — the element chunk's two decided-at-build-time booleans.
define GN_FLAG_INCLUDED: int 1
define GN_FLAG_MUST_OMIT_END_TAG: int 2

; --- ComponentName (grove/Node.h ComponentName::Id) -------------------------
;
; The grove's NAME metamodel: every component — a property name, a node class
; name, an enumerated property value — has one id and TWO names, the short RCS
; name and the long SDQL name (grove/Node.cxx rcsName/sdqlName). Both are
; installed in the interpreter's node-property table
; (Interpreter::installNodeProperties), so a stylesheet may address a property
; by either spelling, and `rcs?: #t` on node-property selects which of the two
; a component-name VALUE renders as. The ids ARE the enum's order — they index
; the two name arrays below.
define CN_ALL_PROPERTY_NAMES: int 0
define CN_AND: int 1
define CN_ANY: int 2
define CN_APPLICATION_INFO: int 3
define CN_ATTRIBUTE_ASSIGNMENT: int 4
define CN_ATTRIBUTE_DEF: int 5
define CN_ATTRIBUTE_DEFS: int 6
define CN_ATTRIBUTES: int 7
define CN_ATTRIBUTE_VALUE_TOKEN: int 8
define CN_CDATA: int 9
define CN_CHAR: int 10
define CN_CHILDREN_PROPERTY_NAME: int 11
define CN_CLASS_NAME: int 12
define CN_CONNECTOR: int 13
define CN_CONREF: int 14
define CN_CONTENT: int 15
define CN_CONTENT_TOKENS: int 16
define CN_CONTENT_TYPE: int 17
define CN_CURRENT: int 18
define CN_CURRENT_ATTRIBUTE_INDEX: int 19
define CN_CURRENT_GROUP: int 20
define CN_DATA_CHAR: int 21
define CN_DATA_PROPERTY_NAME: int 22
define CN_DATA_SEP_PROPERTY_NAME: int 23
define CN_DECL_VALUE_TYPE: int 24
define CN_DEFAULTED: int 25
define CN_DEFAULTED_ENTITIES: int 26
define CN_DEFAULT_ENTITY: int 27
define CN_DEFAULT_VALUE: int 28
define CN_DEFAULT_VALUE_TYPE: int 29
define CN_DOCTYPES_AND_LINKTYPES: int 30
define CN_DOCUMENT_ELEMENT: int 31
define CN_DOCUMENT_TYPE: int 32
define CN_ELEMENT: int 33
define CN_ELEMENTS: int 34
define CN_ELEMENT_TOKEN: int 35
define CN_ELEMENT_TYPE: int 36
define CN_ELEMENT_TYPES: int 37
define CN_EMPTY: int 38
define CN_ENTITIES: int 39
define CN_ENTITY: int 40
define CN_ENTITY_NAME: int 41
define CN_ENTITY_TYPE: int 42
define CN_EPILOG: int 43
define CN_EXCLUSIONS: int 44
define CN_EXTERNAL_DATA: int 45
define CN_EXTERNAL_ID: int 46
define CN_FIXED: int 47
define CN_GENERAL_ENTITIES: int 48
define CN_GENERATED_SYSTEM_ID: int 49
define CN_GI: int 50
define CN_GOVERNING: int 51
define CN_GOVERNING_DOCTYPE: int 52
define CN_GROVE_ROOT: int 53
define CN_ID: int 54
define CN_IDREF: int 55
define CN_IDREFS: int 56
define CN_IMPLIED: int 57
define CN_INCLUDED: int 58
define CN_INCLUSIONS: int 59
define CN_MODEL_GROUP: int 60
define CN_MUST_OMIT_END_TAG: int 61
define CN_NAME: int 62
define CN_NAMES: int 63
define CN_NDATA: int 64
define CN_NMTKGRP: int 65
define CN_NMTOKEN: int 66
define CN_NMTOKENS: int 67
define CN_NOTATION: int 68
define CN_NOTATION_NAME: int 69
define CN_NOTATIONS: int 70
define CN_NUMBER: int 71
define CN_NUMBERS: int 72
define CN_NUTOKEN: int 73
define CN_NUTOKENS: int 74
define CN_OCCURENCE_INDICATOR: int 75
define CN_OMIT_END_TAG: int 76
define CN_OMIT_START_TAG: int 77
define CN_OPT: int 78
define CN_OR: int 79
define CN_ORIGIN: int 80
define CN_ORIGIN_TO_SUBNODE_REL_PROPERTY_NAME: int 81
define CN_PARAMETER_ENTITIES: int 82
define CN_PARENT: int 83
define CN_PCDATA_TOKEN: int 84
define CN_PI: int 85
define CN_PLUS: int 86
define CN_PROLOG: int 87
define CN_PUBLIC_ID: int 88
define CN_RCDATA: int 89
define CN_REFERENT: int 90
define CN_REP: int 91
define CN_REQUIRED: int 92
define CN_SDATA: int 93
define CN_SEQ: int 94
define CN_SGML_CONSTANTS: int 95
define CN_SGML_DOCUMENT: int 96
define CN_SUBDOCUMENT: int 97
define CN_SUBNODE_PROPERTY_NAMES: int 98
define CN_SYSTEM_DATA: int 99
define CN_SYSTEM_ID: int 100
define CN_TEXT: int 101
define CN_TOKEN: int 102
define CN_TOKENS: int 103
define CN_TOKEN_SEP: int 104
define CN_TREE_ROOT: int 105
define CN_VALUE: int 106
define CN_N_IDS: int 107
define CN_NO_ID: int 0 - 1

; 26 letter buckets for the lookup index + one catch-all
define CN_N_BUCKETS: int 27

; the two name arrays, built once per run (the interpreter owns the instance),
; plus a first-letter bucket index over both spellings so a lookup compares a
; handful of names instead of all 214.
define ComponentName (rcs: ref[Array[StringC]], sdql: ref[Array[StringC]], buckets: ref[Array[ref[Array[int]]?]])
{
    function make(host: ref[Page]) returns ref[ComponentName]
    {
        let t host.allocate(sizeof ComponentName, alignof ComponentName) as pointer[ComponentName]
        set t.rcs: Array[StringC]^host()
        set t.sdql: Array[StringC]^host()
        ComponentName.add(host, t, "allpns", "all-property-names")
        ComponentName.add(host, t, "and", "and")
        ComponentName.add(host, t, "any", "any")
        ComponentName.add(host, t, "appinfo", "application-info")
        ComponentName.add(host, t, "attasgn", "attribute-assignment")
        ComponentName.add(host, t, "attdef", "attribute-def")
        ComponentName.add(host, t, "attdefs", "attribute-defs")
        ComponentName.add(host, t, "atts", "attributes")
        ComponentName.add(host, t, "attvaltk", "attribute-value-token")
        ComponentName.add(host, t, "cdata", "cdata")
        ComponentName.add(host, t, "char", "char")
        ComponentName.add(host, t, "childpn", "children-property-name")
        ComponentName.add(host, t, "classnm", "class-name")
        ComponentName.add(host, t, "connect", "connector")
        ComponentName.add(host, t, "conref", "conref")
        ComponentName.add(host, t, "content", "content")
        ComponentName.add(host, t, "tokens", "content-tokens")
        ComponentName.add(host, t, "contype", "content-type")
        ComponentName.add(host, t, "current", "current")
        ComponentName.add(host, t, "curattix", "current-attribute-index")
        ComponentName.add(host, t, "curgrp", "current-group")
        ComponentName.add(host, t, "datachar", "data-char")
        ComponentName.add(host, t, "datapn", "data-property-name")
        ComponentName.add(host, t, "dseppn", "data-sep-property-name")
        ComponentName.add(host, t, "dcltype", "decl-value-type")
        ComponentName.add(host, t, "dflted", "defaulted?")
        ComponentName.add(host, t, "dfltents", "defaulted-entities")
        ComponentName.add(host, t, "dfltent", "default-entity")
        ComponentName.add(host, t, "dfltval", "default-value")
        ComponentName.add(host, t, "dflttype", "default-value-type")
        ComponentName.add(host, t, "dtlts", "doctypes-and-linktypes")
        ComponentName.add(host, t, "docelem", "document-element")
        ComponentName.add(host, t, "doctype", "document-type")
        ComponentName.add(host, t, "element", "element")
        ComponentName.add(host, t, "elements", "elements")
        ComponentName.add(host, t, "elemtk", "element-token")
        ComponentName.add(host, t, "elemtype", "element-type")
        ComponentName.add(host, t, "elemtps", "element-types")
        ComponentName.add(host, t, "empty", "empty")
        ComponentName.add(host, t, "entities", "entities")
        ComponentName.add(host, t, "entity", "entity")
        ComponentName.add(host, t, "entname", "entity-name")
        ComponentName.add(host, t, "enttype", "entity-type")
        ComponentName.add(host, t, "epilog", "epilog")
        ComponentName.add(host, t, "excls", "exclusions")
        ComponentName.add(host, t, "extdata", "external-data")
        ComponentName.add(host, t, "extid", "external-id")
        ComponentName.add(host, t, "fixed", "fixed")
        ComponentName.add(host, t, "genents", "general-entities")
        ComponentName.add(host, t, "gensysid", "generated-system-id")
        ComponentName.add(host, t, "gi", "gi")
        ComponentName.add(host, t, "govrning", "governing?")
        ComponentName.add(host, t, "govdt", "governing-doctype")
        ComponentName.add(host, t, "grovroot", "grove-root")
        ComponentName.add(host, t, "id", "id")
        ComponentName.add(host, t, "idref", "idref")
        ComponentName.add(host, t, "idrefs", "idrefs")
        ComponentName.add(host, t, "implied", "implied?")
        ComponentName.add(host, t, "included", "included?")
        ComponentName.add(host, t, "incls", "inclusions")
        ComponentName.add(host, t, "modelgrp", "model-group")
        ComponentName.add(host, t, "momitend", "must-omit-end-tag?")
        ComponentName.add(host, t, "name", "name")
        ComponentName.add(host, t, "names", "names")
        ComponentName.add(host, t, "ndata", "ndata")
        ComponentName.add(host, t, "nmtkgrp", "name-token-group")
        ComponentName.add(host, t, "nmtoken", "nmtoken")
        ComponentName.add(host, t, "nmtokens", "nmtokens")
        ComponentName.add(host, t, "notation", "notation")
        ComponentName.add(host, t, "notname", "notation-name")
        ComponentName.add(host, t, "nots", "notations")
        ComponentName.add(host, t, "number", "number")
        ComponentName.add(host, t, "numbers", "numbers")
        ComponentName.add(host, t, "nutoken", "nutoken")
        ComponentName.add(host, t, "nutokens", "nutokens")
        ComponentName.add(host, t, "occur", "occur-indicator")
        ComponentName.add(host, t, "omitend", "omit-end-tag?")
        ComponentName.add(host, t, "omitstrt", "omit-start-tag?")
        ComponentName.add(host, t, "opt", "opt")
        ComponentName.add(host, t, "or", "or")
        ComponentName.add(host, t, "origin", "origin")
        ComponentName.add(host, t, "otsrelpn", "origin-to-subnode-rel-property-name")
        ComponentName.add(host, t, "parments", "parameter-entities")
        ComponentName.add(host, t, "parent", "parent")
        ComponentName.add(host, t, "pcdatatk", "pcdata-token")
        ComponentName.add(host, t, "pi", "pi")
        ComponentName.add(host, t, "plus", "plus")
        ComponentName.add(host, t, "prolog", "prolog")
        ComponentName.add(host, t, "pubid", "public-id")
        ComponentName.add(host, t, "rcdata", "rcdata")
        ComponentName.add(host, t, "referent", "referent")
        ComponentName.add(host, t, "rep", "rep")
        ComponentName.add(host, t, "required", "required")
        ComponentName.add(host, t, "sdata", "sdata")
        ComponentName.add(host, t, "seq", "seq")
        ComponentName.add(host, t, "sgmlcsts", "sgml-constants")
        ComponentName.add(host, t, "sgmldoc", "sgml-document")
        ComponentName.add(host, t, "subdoc", "subdocument")
        ComponentName.add(host, t, "subpns", "subnode-property-names")
        ComponentName.add(host, t, "sysdata", "system-data")
        ComponentName.add(host, t, "sysid", "system-id")
        ComponentName.add(host, t, "text", "text")
        ComponentName.add(host, t, "token", "token")
        ComponentName.add(host, t, "tokens", "tokens")
        ComponentName.add(host, t, "tokensep", "token-sep")
        ComponentName.add(host, t, "treeroot", "tree-root")
        ComponentName.add(host, t, "value", "value")
        set t.buckets: Array[ref[Array[int]]?]^host()
        var b 0
        while b < CN_N_BUCKETS
        {
            t.buckets.add(Array[int]^host())
            set b: b + 1
        }
        var id 0
        while id < CN_N_IDS
        {
            let i id as size_t
            let r *(t.rcs.get_buffer() + i)
            let s *(t.sdql.get_buffer() + i)
            let br ComponentName.bucket_of(r)
            ComponentName.bucket_add(t, br, id)
            let bs ComponentName.bucket_of(s)
            if bs <> br
                ComponentName.bucket_add(t, bs, id)
            set id: id + 1
        }
        t
    }

    procedure add(host: ref[Page], t: ref[ComponentName], r: pointer[const_char], s: pointer[const_char])
    {
        t.rcs.add(StringC^host(r))
        t.sdql.add(StringC^host(s))
    }

    procedure bucket_add(t: ref[ComponentName], b: int, id: int)
    {
        let bl *(t.buckets.get_buffer() + (b as size_t))
        bl.add(id)
    }

    ; a name's bucket: its ASCII-lowercased first letter, CN_N_BUCKETS - 1 for
    ; anything else (no table name starts outside a-z, but a QUERY may).
    function bucket_of(name: StringC) returns int
    {
        if name.get_size() = 0
            return CN_N_BUCKETS - 1
        var c name.get(0)
        if c >= 0x41
        {
            if c <= 0x5A
                set c: c + 0x20
        }
        if c < 0x61
            return CN_N_BUCKETS - 1
        if c > 0x7A
            return CN_N_BUCKETS - 1
        (c - 0x61) as int
    }

    function rcs_name(this: ComponentName, id: int) returns StringC
    {
        if id < 0
            return StringC()
        if id >= CN_N_IDS
            return StringC()
        rcs[(id as size_t)]
    }

    function sdql_name(this: ComponentName, id: int) returns StringC
    {
        if id < 0
            return StringC()
        if id >= CN_N_IDS
            return StringC()
        sdql[(id as size_t)]
    }

    ; the name a component-name VALUE renders as (ELObjPropertyValue::set:
    ; rcs? picks rcsName, otherwise sdqlName).
    function name_of(this: ComponentName, id: int, want_rcs: bool) returns StringC
    {
        if want_rcs
            return this.rcs_name(id)
        this.sdql_name(id)
    }

    ; Interpreter::lookupNodeProperty — either spelling to its id, CN_NO_ID if
    ; unknown. The reference retries an ASCII-lowercased key after the exact
    ; lookup; every table name is already lowercase, so that is exactly one
    ; case-insensitive pass. ★The LAST insertion wins (HashTable::insert
    ; replaces by default); the one duplicate is the RCS name "tokens", shared
    ; by content-tokens and tokens — which is why the reference has to
    ; special-case model-group nodes in the node-property primitive.
    function lookup(this: ComponentName, name: StringC) returns int
    {
        let b ComponentName.bucket_of(name)
        let bl buckets[(b as size_t)]
        let n name.get_size()
        var found CN_NO_ID
        let cnt bl.get_length()
        let buf bl.get_buffer()
        var k: size_t 0
        while k < cnt
        {
            let id *(buf + k)
            let i id as size_t
            let r rcs[i]
            if r.get_size() = n
            {
                if ComponentName.equals_lower(r, name)
                    set found: id
            }
            let s sdql[i]
            if s.get_size() = n
            {
                if ComponentName.equals_lower(s, name)
                    set found: id
            }
            set k: k + 1
        }
        found
    }

    ; a table name (already lowercase) against a query whose ASCII letters are
    ; lowercased on the fly — the reference's lowercase retry.
    function equals_lower(table: StringC, query: StringC) returns bool
    {
        let n table.get_size()
        var i: size_t 0
        while i < n
        {
            var q query.get(i)
            if q >= 0x41
            {
                if q <= 0x5A
                    set q: q + 0x20
            }
            if table.get(i) <> q
                return false
            set i: i + 1
        }
        true
    }
}


; --- ClassDef (grove/Node.cxx ClassDef::*) ----------------------------------
;
; The per-class metadata: the class name, the ordered property-name lists and
; the three distinguished property names. Our grove instantiates four of the
; reference's 21 node classes — sgml-document, element, data-char and pi — and
; these tables are transcribed from theirs INCLUDING the properties whose
; accessors are not ported yet: `all-property-names` is a TABLE, not a
; capability list, and the reference answers it from the same table.
define GroveClassDef
{
    ; ClassDef::className
    function class_name(node_class: int) returns int
    {
        if node_class = GN_ELEMENT
            return CN_ELEMENT
        if node_class = GN_DATA
            return CN_DATA_CHAR
        if node_class = GN_PI
            return CN_PI
        if node_class = GN_ATTR_ASSIGN
            return CN_ATTRIBUTE_ASSIGNMENT
        if node_class = GN_ATTR_TOKEN
            return CN_ATTRIBUTE_VALUE_TOKEN
        if node_class = GN_ENTITY
            return CN_ENTITY
        if node_class = GN_NOTATION
            return CN_NOTATION
        if node_class = GN_DOCUMENT_TYPE
            return CN_DOCUMENT_TYPE
        if node_class = GN_DEFAULT_ENTITY
            return CN_DEFAULT_ENTITY
        if node_class = GN_EXTERNAL_ID
            return CN_EXTERNAL_ID
        if node_class = GN_ELEMENT_TYPE
            return CN_ELEMENT_TYPE
        if node_class = GN_ATTRIBUTE_DEF
            return CN_ATTRIBUTE_DEF
        if node_class = GN_MODEL_GROUP
            return CN_MODEL_GROUP
        if node_class = GN_ELEMENT_TOKEN
            return CN_ELEMENT_TOKEN
        if node_class = GN_PCDATA_TOKEN
            return CN_PCDATA_TOKEN
        if node_class = GN_SGML_CONSTANTS
            return CN_SGML_CONSTANTS
        if node_class = GN_SDATA
            return CN_SDATA
        if node_class = GN_EXTERNAL_DATA
            return CN_EXTERNAL_DATA
        if node_class = GN_SUBDOC
            return CN_SUBDOCUMENT
        ; ClassDef::nonSgml / ClassDef::message carry ComponentName::noId as
        ; their class name (both marked FIXME in the reference), which renders
        ; as the empty symbol.
        if node_class = GN_NONSGML
            return CN_NO_ID
        if node_class = GN_MESSAGE
            return CN_NO_ID
        CN_SGML_DOCUMENT
    }

    ; ClassDef::childrenPropertyName — only the element class has children
    ; (which is what makes the CHILDREN AXIS class-specific, see
    ; GroveNode.has_child_axis).
    function children_property_name(node_class: int) returns int
    {
        if node_class = GN_ELEMENT
            return CN_CONTENT
        if node_class = GN_ATTR_ASSIGN
            return CN_VALUE
        CN_NO_ID
    }

    ; ClassDef::dataPropertyName
    function data_property_name(node_class: int) returns int
    {
        if node_class = GN_DATA
            return CN_CHAR
        if node_class = GN_ATTR_TOKEN
            return CN_TOKEN
        ; ClassDef::sdata declares `char` its data property, like data-char.
        if node_class = GN_SDATA
            return CN_CHAR
        CN_NO_ID
    }

    ; ClassDef::dataSepPropertyName — only attribute-assignment declares one
    ; (its tokens are separated by the token-sep character).
    function data_sep_property_name(node_class: int) returns int
    {
        if node_class = GN_ATTR_ASSIGN
            return CN_TOKEN_SEP
        CN_NO_ID
    }

    ; ClassDef::subnodePropertyNames
    procedure subnode_property_names(node_class: int, out: ref[Array[int]])
    {
        if node_class = GN_ELEMENT
        {
            out.add(CN_ATTRIBUTES)
            out.add(CN_CONTENT)
            return
        }
        if node_class = GN_ATTR_ASSIGN
        {
            out.add(CN_VALUE)
            return
        }
        if node_class = GN_ENTITY
        {
            out.add(CN_EXTERNAL_ID)
            out.add(CN_ATTRIBUTES)
            return
        }
        if node_class = GN_NOTATION
        {
            out.add(CN_EXTERNAL_ID)
            out.add(CN_ATTRIBUTE_DEFS)
            return
        }
        if node_class = GN_DEFAULT_ENTITY
        {
            out.add(CN_EXTERNAL_ID)
            out.add(CN_ATTRIBUTES)
            return
        }
        if node_class = GN_DOCUMENT_TYPE
        {
            out.add(CN_GENERAL_ENTITIES)
            out.add(CN_NOTATIONS)
            out.add(CN_ELEMENT_TYPES)
            out.add(CN_DEFAULT_ENTITY)
            out.add(CN_PARAMETER_ENTITIES)
            return
        }
        if node_class = GN_ELEMENT_TYPE
        {
            out.add(CN_ATTRIBUTE_DEFS)
            out.add(CN_MODEL_GROUP)
            return
        }
        if node_class = GN_ATTRIBUTE_DEF
        {
            out.add(CN_DEFAULT_VALUE)
            return
        }
        if node_class = GN_MODEL_GROUP
        {
            out.add(CN_CONTENT_TOKENS)
            return
        }
        if node_class = GN_DOCUMENT
        {
            out.add(CN_SGML_CONSTANTS)
            out.add(CN_PROLOG)
            out.add(CN_EPILOG)
            out.add(CN_DOCTYPES_AND_LINKTYPES)
            out.add(CN_DOCUMENT_ELEMENT)
            out.add(CN_DEFAULTED_ENTITIES)
        }
    }

    ; INTRINSIC_PROPS (grove/Node.cxx:1148) — the eleven every class carries.
    procedure intrinsic_property_names(out: ref[Array[int]])
    {
        out.add(CN_CLASS_NAME)
        out.add(CN_GROVE_ROOT)
        out.add(CN_SUBNODE_PROPERTY_NAMES)
        out.add(CN_ALL_PROPERTY_NAMES)
        out.add(CN_CHILDREN_PROPERTY_NAME)
        out.add(CN_DATA_PROPERTY_NAME)
        out.add(CN_DATA_SEP_PROPERTY_NAME)
        out.add(CN_PARENT)
        out.add(CN_TREE_ROOT)
        out.add(CN_ORIGIN)
        out.add(CN_ORIGIN_TO_SUBNODE_REL_PROPERTY_NAME)
    }

    ; ClassDef::allPropertyNames
    procedure all_property_names(node_class: int, out: ref[Array[int]])
    {
        ; ★ClassDef::sgmlConstants (grove/Node.cxx:1414) declares noProps for
        ; BOTH lists — that class carries not even the INTRINSIC props, so
        ; `all-property-names` is the empty list there (measured).
        if node_class = GN_SGML_CONSTANTS
            return
        ; ★ClassDef::nonSgml and ClassDef::message (grove/Node.cxx:1420/1429)
        ; are the reference's two FIXME tables: noProps for both lists, so not
        ; even the intrinsic names are listed.
        if node_class = GN_NONSGML
            return
        if node_class = GN_MESSAGE
            return
        GroveClassDef.intrinsic_property_names(out)
        if node_class = GN_ELEMENT
        {
            out.add(CN_GI)
            out.add(CN_ID)
            out.add(CN_ATTRIBUTES)
            out.add(CN_CONTENT)
            out.add(CN_INCLUDED)
            out.add(CN_MUST_OMIT_END_TAG)
            out.add(CN_ELEMENT_TYPE)
            return
        }
        if node_class = GN_DATA
        {
            out.add(CN_CHAR)
            return
        }
        if node_class = GN_PI
        {
            out.add(CN_SYSTEM_DATA)
            out.add(CN_ENTITY_NAME)
            out.add(CN_ENTITY)
            return
        }
        ; ClassDef::sdata (grove/Node.cxx:1381) — system-data BEFORE char.
        if node_class = GN_SDATA
        {
            out.add(CN_SYSTEM_DATA)
            out.add(CN_CHAR)
            out.add(CN_ENTITY_NAME)
            out.add(CN_ENTITY)
            return
        }
        ; ClassDef::externalData / ClassDef::subdocument — the bare entity pair.
        if node_class = GN_EXTERNAL_DATA
        {
            out.add(CN_ENTITY_NAME)
            out.add(CN_ENTITY)
            return
        }
        if node_class = GN_SUBDOC
        {
            out.add(CN_ENTITY_NAME)
            out.add(CN_ENTITY)
            return
        }
        if node_class = GN_ATTR_ASSIGN
        {
            out.add(CN_ATTRIBUTE_DEF)
            out.add(CN_VALUE)
            out.add(CN_NAME)
            out.add(CN_IMPLIED)
            out.add(CN_TOKEN_SEP)
            return
        }
        if node_class = GN_ATTR_TOKEN
        {
            out.add(CN_TOKEN)
            out.add(CN_ENTITY)
            out.add(CN_NOTATION)
            out.add(CN_REFERENT)
            return
        }
        if node_class = GN_ENTITY
        {
            out.add(CN_NAME)
            out.add(CN_ENTITY_TYPE)
            out.add(CN_TEXT)
            out.add(CN_EXTERNAL_ID)
            out.add(CN_ATTRIBUTES)
            out.add(CN_NOTATION_NAME)
            out.add(CN_NOTATION)
            out.add(CN_DEFAULTED)
            return
        }
        if node_class = GN_DEFAULT_ENTITY
        {
            ; ClassDef::defaultEntity — the entity list WITHOUT `defaulted?`
            ; (DefaultEntityNode does not implement getDefaulted).
            out.add(CN_NAME)
            out.add(CN_ENTITY_TYPE)
            out.add(CN_TEXT)
            out.add(CN_EXTERNAL_ID)
            out.add(CN_ATTRIBUTES)
            out.add(CN_NOTATION_NAME)
            out.add(CN_NOTATION)
            return
        }
        if node_class = GN_NOTATION
        {
            out.add(CN_NAME)
            out.add(CN_EXTERNAL_ID)
            out.add(CN_ATTRIBUTE_DEFS)
            return
        }
        if node_class = GN_DOCUMENT_TYPE
        {
            out.add(CN_NAME)
            out.add(CN_ELEMENT_TYPES)
            out.add(CN_GOVERNING)
            out.add(CN_GENERAL_ENTITIES)
            out.add(CN_NOTATIONS)
            out.add(CN_DEFAULT_ENTITY)
            out.add(CN_PARAMETER_ENTITIES)
            return
        }
        if node_class = GN_EXTERNAL_ID
        {
            out.add(CN_PUBLIC_ID)
            out.add(CN_SYSTEM_ID)
            out.add(CN_GENERATED_SYSTEM_ID)
            return
        }
        if node_class = GN_ELEMENT_TYPE
        {
            out.add(CN_ATTRIBUTE_DEFS)
            out.add(CN_CONTENT_TYPE)
            out.add(CN_EXCLUSIONS)
            out.add(CN_GI)
            out.add(CN_INCLUSIONS)
            out.add(CN_MODEL_GROUP)
            out.add(CN_OMIT_END_TAG)
            out.add(CN_OMIT_START_TAG)
            return
        }
        if node_class = GN_ATTRIBUTE_DEF
        {
            out.add(CN_CURRENT_ATTRIBUTE_INDEX)
            out.add(CN_CURRENT_GROUP)
            out.add(CN_DECL_VALUE_TYPE)
            out.add(CN_DEFAULT_VALUE_TYPE)
            out.add(CN_DEFAULT_VALUE)
            out.add(CN_NAME)
            out.add(CN_TOKENS)
            return
        }
        if node_class = GN_MODEL_GROUP
        {
            out.add(CN_CONNECTOR)
            out.add(CN_OCCURENCE_INDICATOR)
            out.add(CN_CONTENT_TOKENS)
            return
        }
        if node_class = GN_ELEMENT_TOKEN
        {
            out.add(CN_GI)
            out.add(CN_OCCURENCE_INDICATOR)
            return
        }
        if node_class = GN_PCDATA_TOKEN
            return
        out.add(CN_SGML_CONSTANTS)
        out.add(CN_APPLICATION_INFO)
        out.add(CN_PROLOG)
        out.add(CN_EPILOG)
        out.add(CN_GOVERNING_DOCTYPE)
        out.add(CN_DOCTYPES_AND_LINKTYPES)
        out.add(CN_DOCUMENT_ELEMENT)
        out.add(CN_ELEMENTS)
        out.add(CN_ENTITIES)
        out.add(CN_DEFAULTED_ENTITIES)
    }
}

; A grove node. `children` is null for leaf (data/pi) nodes; element/document
; nodes carry the ordered child list. `chars` holds a data node's text.
;
; DATA NODES — the chunk/view split (spgrove/GroveBuilder.cxx:586-635). The
; reference stores character data as a `DataChunk` (a run of Chars) and hands
; out `DataNode`s, which are (chunk, index) VIEWS — one grove node PER
; CHARACTER, of class `data-char`, without allocating any of them. A GN_DATA
; node here is that chunk (`flush_pending` = the DataChunk boundary); a VIEW is
; a GN_DATA node with `chunk` pointing at the chunk and `char_index` its offset.
; The chunk node itself IS the view at index 0.
;
; The TREE stays chunk-level: the builder, ProcessContext's content walk and
; every FOT backend iterate whole runs (the reference does the same through
; nextChunkSibling/charChunk). Views are materialized only where the reference's
; per-character node identity is OBSERVABLE — children/descendants/preced/follow
; and the node properties — see ELObj.NodeListObj (the prefix index) and DataNode::same2.

; --- the O(1) sibling step (the missing assignNextChunkSibling) -------------
;
; The reference steps siblings with `NodePtr::assignNextChunkSibling`, one
; pointer hop, because a chunk knows its successor. Our nodes carry a parent
; and the parent an array, so a node's own place in its group is a SCAN — and
; the primitives that need it (`last-sibling?`, `absolute-last-sibling?`, the
; `follow` axis) were therefore quadratic over a wide sibling group, which is
; what tests/dazzle/nsweep measured as cause A.
;
; What replaces the missing link is a one-entry memo: styling runs in document
; order, so the node asked about next is normally the next SLOT, and a scan
; that starts where the last one stopped finds it in one step. Same idea as
; NumberCache and the same discipline: the memo is a HINT and nothing more —
; the answer is still established by comparing the node against the group's
; members, so a stale or foreign hint costs one wrap around the group and can
; never produce a wrong index. Nothing here has to be invalidated.
;
; ★Identity is POINTER identity, deliberately: it is the identity of every scan
; this replaces (`s = node` in is_last_sibling and child_number), and a
; character VIEW is therefore NOT found in a group that holds its chunk — the
; callers rely on that (`absolute-last-sibling?` of a character node is #t
; because the scan never meets it).
mutable sib_hint_parent: ref[GroveNode]? null
mutable sib_hint_index: int 0

define GroveNode (node_class: int, gi: StringC, chars: StringC, attributes: ref[AttributeList]?, parent: ref[GroveNode]?, children: ref[Array[ref[GroveNode]?]]?, element_index: int, char_index: int, chunk: ref[GroveNode]?, views: ref[Array[ref[GroveNode]?]]?, flags: int, decl: pointer[void], loc: Location)
{
    function make(host: ref[Page], node_class: int) returns ref[GroveNode]
    {
        let p host.allocate(sizeof GroveNode, alignof GroveNode) as pointer[GroveNode]
        set p.node_class: node_class
        set p.gi: StringC()
        set p.chars: StringC()
        set p.attributes: null
        set p.parent: null
        set p.children: Array[ref[GroveNode]?]^host()
        set p.element_index: 0 - 1
        set p.char_index: 0
        set p.chunk: null
        set p.views: null
        set p.flags: 0
        set p.decl: null
        ; LocNode::getLocation — only the tree classes have one, and it is the
        ; START-ELEMENT event's (ElementNode::add's setLocOrigin). Views take
        ; their origin's below; everything else stays empty.
        set p.loc: Location()
        p
    }

    ; --- the declaration classes --------------------------------------------
    ;
    ; A declaration node over one opensp declaration object: `decl` is that
    ; object (and its identity), `parent` the OWNER node (the grove-root chain),
    ; `char_index` a within-owner index (an attribute-def's attIndex, a content
    ; token's member index). Built per access — the reference does the same
    ; (`new EntityNode(grove, entity)` on every property read).
    function make_decl(host: ref[Page], node_class: int, decl: pointer[void], owner: ref[GroveNode], index: int) returns ref[GroveNode]
    {
        let p host.allocate(sizeof GroveNode, alignof GroveNode) as pointer[GroveNode]
        set p.node_class: node_class
        set p.gi: StringC()
        set p.chars: StringC()
        set p.attributes: null
        set p.parent: owner
        set p.children: null
        set p.element_index: 0 - 1
        set p.char_index: index
        set p.chunk: null
        set p.views: null
        set p.flags: 0
        set p.decl: decl
        set p.loc: Location()
        p
    }

    function get_decl(this: GroveNode) returns pointer[void]
        decl

    ; --- the sdata node's mapped character -----------------------------------
    ;
    ; SdataNode keeps the character the SdataMapper resolved in the NODE
    ; (`Char c_`), and hands charChunk a pointer to it. Two reasons it cannot be
    ; anything shorter-lived here: the FOT SAVE builder RECORDS the character
    ; pointer without copying (SaveFOTBuilder.record_chars_from_node), so a
    ; caller-page or stack buffer would dangle; and the mapping cannot be done
    ; while BUILDING the grove, because the map is the interpreter's and the
    ; stylesheet has not been read yet. So it is memoized on first use, on the
    ; grove's OWN page — the `gi` slot, which no class but element /
    ; element-type / element-token uses (Primitive.node_has_gi is class-gated).
    function sdata_view(this: GroveNode) returns StringC
        gi

    procedure set_sdata_view(this: ref[GroveNode], c: u32)
    {
        var v c
        FrameMark.store(this as pointer[void])
        let gpage Page.get(this as pointer[void])
        set this.gi: StringC^gpage(&v, 1)
    }

    ; the two classes over an Entity — EntityNode and DefaultEntityNode share
    ; EntityNodeBase's accessors and differ only in origin, otsrelpn and
    ; `defaulted?`.
    function is_entity_class(this: GroveNode) returns bool
    {
        if node_class = GN_ENTITY
            return true
        node_class = GN_DEFAULT_ENTITY
    }

    ; is this one of the declaration classes? (they share every axis answer:
    ; no children, no siblings, no parent axis)
    function is_decl_class(this: GroveNode) returns bool
    {
        if node_class = GN_ENTITY
            return true
        if node_class = GN_NOTATION
            return true
        if node_class = GN_DOCUMENT_TYPE
            return true
        if node_class = GN_DEFAULT_ENTITY
            return true
        if node_class = GN_EXTERNAL_ID
            return true
        if node_class = GN_ELEMENT_TYPE
            return true
        if node_class = GN_ATTRIBUTE_DEF
            return true
        if node_class = GN_MODEL_GROUP
            return true
        if node_class = GN_ELEMENT_TOKEN
            return true
        if node_class = GN_PCDATA_TOKEN
            return true
        node_class = GN_SGML_CONSTANTS
    }

    ; --- data chunks and their per-character views ---------------------------

    ; the DataChunk this node belongs to (itself for a chunk node)
    function data_chunk(this: ref[GroveNode]) returns ref[GroveNode]
    {
        if this.chunk = null
            return this
        this.chunk as ref[GroveNode]
    }

    ; this view's character offset inside its chunk (0 for a chunk node)
    function get_char_index(this: GroveNode) returns int
        char_index

    ; the number of characters in this data node's chunk
    function chunk_char_count(this: ref[GroveNode]) returns int
    {
        let c this.data_chunk()
        let s c.get_chars()
        s.get_size() as int
    }

    ; DataNode(chunk, index) — a per-character view. The index-0 view IS the
    ; chunk node, so identity stays pointer-comparable for the common case.
    ;
    ; MEMOIZED ON THE CHUNK, and deliberately on the chunk's OWN page (the grove
    ; region, reached with Page.get — grove nodes are page-hosted), never on the
    ; caller's page: the callers are the axis primitives, whose per-node eval
    ; brackets release their scratch region, which would dangle every view.
    ; Building them once per chunk is also what keeps the cost sane — the
    ; reference pays nothing at all because its DataNodes are transient views,
    ; and re-materializing per `children` call cost 1.7x wall / 2.6x memory on
    ; the dsssl.xml fot run before this cache. Sharing the objects is sound
    ; because identity is (chunk, index) either way (DataNode::same2).
    function chunk_views(chunk: ref[GroveNode]) returns ref[Array[ref[GroveNode]?]]
    {
        let have chunk.views
        if have <> null
            return have as ref[Array[Option[ref[GroveNode]]]]
        FrameMark.store(chunk as pointer[void])
        let gpage Page.get(chunk as pointer[void])
        let arr Array[ref[GroveNode]?]^gpage()
        let s chunk.get_chars()
        let n s.get_size() as int
        var i 0
        while i < n
        {
            if i = 0
                arr.add(chunk)
            else
            {
                let p gpage.allocate(sizeof GroveNode, alignof GroveNode) as pointer[GroveNode]
                set p.node_class: GN_DATA
                set p.gi: StringC()
                set p.chars: s
                set p.attributes: null
                set p.parent: chunk.get_parent()
                set p.children: null
                set p.element_index: 0 - 1
                set p.char_index: i
                set p.chunk: chunk
                set p.views: null
                set p.flags: 0
                set p.decl: null
                set p.loc: chunk.loc
                arr.add(p)
            }
            set i: i + 1
        }
        set chunk.views: arr
        arr
    }

    ; the (chunk, index) view — no caller page is involved (chunk_views
    ; allocates on the chunk's OWN grove page), so this form is callable from
    ; ELObj.node_list_node, which materializes views lazily and has no host.
    function char_view(chunk: ref[GroveNode], index: int) returns ref[GroveNode]
    {
        if index = 0
            return chunk
        let arr GroveNode.chunk_views(chunk)
        if index >= (arr.get_length() as int)
            return chunk
        arr[index] as ref[GroveNode]
    }

    ; --- the ATTRIBUTE axis --------------------------------------------------
    ;
    ; ElementNode::getAttributes hands out ONE attribute-assignment per DECLARED
    ; attribute of the element — specified, defaulted or implied alike — in
    ; declaration order, and AttributeAsgnNode's identity is (origin, attIndex)
    ; (same2, GroveBuilder.cxx:3785). So these are VIEWS exactly like the data
    ; nodes: `chunk` is the origin element, `char_index` the attribute index,
    ; `attributes` the origin's AttributeList (so every property answer is a
    ; local lookup), and `parent` the element — the assignment's ORIGIN — while
    ; the parent AXIS stays null (see get_axis_parent).
    ;
    ; Memoized on the ELEMENT's `views` slot, on the element's OWN grove page
    ; (data chunks use theirs for character views; the two never collide because
    ; a node is either an element or a data chunk). The reason is the same as
    ; there: the callers are axis primitives whose per-node eval bracket releases
    ; its scratch region, which would dangle every view built on it.
    function attr_views(elem: ref[GroveNode]) returns ref[Array[ref[GroveNode]?]]
    {
        let have elem.views
        if have <> null
            return have as ref[Array[Option[ref[GroveNode]]]]
        FrameMark.store(elem as pointer[void])
        let gpage Page.get(elem as pointer[void])
        let arr Array[ref[GroveNode]?]^gpage()
        let atts elem.get_attributes()
        var n: size_t 0
        if atts <> null
            set n: atts.size()
        var i: size_t 0
        while i < n
        {
            let p gpage.allocate(sizeof GroveNode, alignof GroveNode) as pointer[GroveNode]
            set p.node_class: GN_ATTR_ASSIGN
            set p.gi: StringC()
            set p.chars: StringC()
            set p.attributes: atts
            set p.parent: elem
            set p.children: null
            set p.element_index: 0 - 1
            set p.char_index: i as int
            set p.chunk: elem
            set p.views: null
            set p.flags: 0
            set p.decl: null
            set p.loc: elem.loc
            arr.add(p)
            set i: i + 1
        }
        set elem.views: arr
        arr
    }

    ; the grove-wide tables moved to GroveInfo (see the note at the top of this
    ; module and `define GroveInfo` below).

    ; TokenizedAttributeValue::token, but copied onto an EXPLICIT page:
    ; AttributeValue.token's own `substr` allocates through Page.get(<the return
    ; slot>), which for a field store is a stack temporary — the bogus-page trap.
    function value_token(host: ref[Page], av: ref[AttributeValue], k: size_t) returns ref[StringC]
    {
        let s av.get_string()
        let si av.get_space_index()
        var start: size_t 0
        var stop s.get_size()
        if si <> null
        {
            let buf si.get_buffer()
            let ns si.get_length()
            if k <> 0
                set start: *(buf + (k - 1)) + 1
            if k < ns
                set stop: *(buf + k)
        }
        if stop < start
            set stop: start
        if start >= s.get_size()
            return StringC^host()
        StringC^host(s.data_ptr() + start, stop - start)
    }

    ; --- the attribute classes' own properties -------------------------------

    ; AttributeAsgnNode::getName — the DEFINITION's name, i.e. already
    ; normalized by the parse (upper-cased under NAMECASE GENERAL YES).
    function assign_name(this: GroveNode) returns StringC
    {
        let atts attributes
        if atts = null
            return StringC()
        atts.name(char_index as size_t)
    }

    ; the assignment's AttributeValue, null when the element has none
    function assign_value(this: GroveNode) returns ref[AttributeValue]?
    {
        let atts attributes
        if atts = null
            return null
        atts.value(char_index as size_t)
    }

    ; AttributeAsgnNode::getImplied — `value != 0 && value->text() == 0`: the
    ; #IMPLIED-with-no-value test, so a DEFAULTED attribute is #f. accessNull
    ; (out_ok false) when there is no value object at all.
    function assign_implied(this: GroveNode, out_ok: ref[bool]) returns bool
    {
        set out_ok: true
        let av this.assign_value()
        if av = null
            return false
        av.get_text() = null
    }

    ; AttributeAsgnNode::getTokenSep — accessNull unless the VALUE is tokenized
    ; with MORE THAN ONE token; then the character after token 0, which the
    ; parse normalized to a space.
    function assign_token_sep(this: GroveNode, out_ok: ref[bool]) returns u32
    {
        set out_ok: false
        let av this.assign_value()
        if av = null
            return 0 as u32
        if av.is_tokenized() = false
            return 0 as u32
        if av.n_tokens() <= 1
            return 0 as u32
        let si av.get_space_index()
        if si = null
            return 0 as u32
        if si.get_length() = 0
            return 0 as u32
        let s av.get_string()
        let at *(si.get_buffer())
        if at >= s.get_size()
            return 0 as u32
        set out_ok: true
        s.get(at)
    }

    ; AttributeAsgnNode::tokens — the WHOLE tokenized value string, separators
    ; included (accessNull for a CDATA or implied value). This is `nodeData`'s
    ; second step and the reason `(data <assignment>)` reads "ONE TWO".
    function assign_tokens(this: GroveNode, out_ok: ref[bool]) returns StringC
    {
        set out_ok: false
        let av this.assign_value()
        if av = null
            return StringC()
        if av.is_tokenized() = false
            return StringC()
        set out_ok: true
        av.get_string()
    }

    ; the attribute-assignment view for (element, attIndex), null out of range
    function attr_view(elem: ref[GroveNode], index: int) returns ref[GroveNode]?
    {
        let arr GroveNode.attr_views(elem)
        if index < 0
            return null
        if index >= (arr.get_length() as int)
            return null
        arr[index]
    }

    ; The VALUE of an assignment — `children` of the assignment node
    ; (AttributeAsgnNode::getValue is getChildren). Two shapes, decided by the
    ; attribute value's own kind (makeAttributeValueNodeList): a TOKENIZED value
    ; becomes one attribute-value-token per token, and everything else (CDATA)
    ; becomes a DATA CHUNK whose per-character views are the members — the
    ; reference's CdataAttributeValueNode is of class data-char, so `(node-list-ref
    ; (node-property 'value a) 0)` reports data-char and `data` gives one
    ; character. An IMPLIED value has no node at all (accessNull).
    ; Memoized on the assignment's own `views` slot, same page discipline.
    function attr_value_views(asgn: ref[GroveNode]) returns ref[Array[ref[GroveNode]?]]
    {
        let have asgn.views
        if have <> null
            return have as ref[Array[Option[ref[GroveNode]]]]
        FrameMark.store(asgn as pointer[void])
        let gpage Page.get(asgn as pointer[void])
        let arr Array[ref[GroveNode]?]^gpage()
        let atts asgn.get_attributes()
        let ai asgn.char_index as size_t
        if atts = null
        {
            set asgn.views: arr
            return arr
        }
        let av atts.value(ai)
        if av = null
        {
            set asgn.views: arr
            return arr
        }
        ; an IMPLIED value has no node at all — the reference's own test is
        ; `value->text() == 0` (getImplied), not the declared value's type.
        if av.get_text() = null
        {
            set asgn.views: arr
            return arr
        }
        ; ★the VALUE's own kind decides the shape, not the declared value — the
        ; reference tests `value->info(text, str) != tokenized` (getTokenSep,
        ; children) and never the attribute definition.
        if av.is_tokenized()
        {
            let nt av.n_tokens()
            var k: size_t 0
            while k < nt
            {
                let p gpage.allocate(sizeof GroveNode, alignof GroveNode) as pointer[GroveNode]
                set p.node_class: GN_ATTR_TOKEN
                set p.gi: StringC()
                set p.chars: GroveNode.value_token(gpage, av, k)
                set p.attributes: atts
                set p.parent: asgn
                set p.children: null
                set p.element_index: k as int
                set p.char_index: asgn.char_index
                set p.chunk: asgn.chunk
                set p.views: null
                set p.flags: 0
                set p.decl: null
                set p.loc: asgn.loc
                arr.add(p)
                set k: k + 1
            }
            set asgn.views: arr
            return arr
        }
        ; CDATA: one data chunk over the whole value; its character views are
        ; the node-list members (the same chunk/view split as document data).
        let t av.get_text()
        var s StringC()
        if t <> null
            set s: t.string()
        if s.get_size() > 0
        {
            let p gpage.allocate(sizeof GroveNode, alignof GroveNode) as pointer[GroveNode]
            set p.node_class: GN_DATA
            set p.gi: StringC()
            set p.chars: s
            set p.attributes: null
            set p.parent: asgn
            set p.children: null
            set p.element_index: 0 - 1
            set p.char_index: 0
            set p.chunk: null
            set p.views: null
            set p.flags: 0
            set p.decl: null
            set p.loc: asgn.loc
            arr.add(p)
        }
        set asgn.views: arr
        arr
    }

    ; How many per-character nodes this member of an EXPANDED node-list stands
    ; for — the weight the node-list's prefix index sums (ELObj.NodeListObj).
    ; A data CHUNK covers its whole run; everything else (elements, pis, and
    ; char VIEWS, which already are single characters) counts one.
    function member_span(node: ref[GroveNode]) returns int
    {
        if node.get_class() <> GN_DATA
            return 1
        if node.chunk <> null
            return 1
        node.chunk_char_count()
    }

    ; the single character this view stands for (0 when out of range) — the
    ; reference's `char` property / the one-character `data` of a DataNode.
    function view_char(this: ref[GroveNode]) returns u32
    {
        let s this.get_chars()
        let n s.get_size()
        let i this.char_index as size_t
        if i >= n
            return 0 as u32
        s.get(i)
    }

    ; DataNode::same2 — a data node is identified by (chunk, index), never by
    ; object identity (the reference reuses its DataNode objects); every other
    ; node class is identified by its single allocation.
    function node_same(a: ref[GroveNode]?, b: ref[GroveNode]?) returns bool
    {
        if a = b
            return true
        if a = null
            return false
        if b = null
            return false
        ; the DECLARATION classes: every same2 in the reference compares the
        ; underlying declaration OBJECT (Entity / Notation / ElementType /
        ; ModelGroup / ContentToken / Dtd), which is exactly this node's `decl`.
        ; An sgml-constants node has none — the reference's same2 is a pure class
        ; test there (one such node per grove). An ATTRIBUTE-DEF is
        ; (attributeOriginId, attIndex): its list pointer can be SHARED between
        ; element types declared in one group ATTLIST, so the OWNER node decides,
        ; and an EXTERNAL-ID is identified by its owner alone.
        if a.is_decl_class()
        {
            if a.node_class <> b.node_class
                return false
            if a.node_class = GN_SGML_CONSTANTS
                return true
            if a.node_class = GN_EXTERNAL_ID
                return GroveNode.node_same(a.parent, b.parent)
            if a.node_class = GN_ATTRIBUTE_DEF
            {
                if a.char_index <> b.char_index
                    return false
                return GroveNode.node_same(a.parent, b.parent)
            }
            return a.decl = b.decl
        }
        if b.is_decl_class()
            return false
        ; AttributeAsgnNode::same2 — (origin, attIndex); the views are memoized
        ; per element so this is pointer equality for an element origin, but an
        ; ENTITY origin is a declaration node built fresh per access, so the
        ; origins compare by their own same2.
        if a.get_class() = GN_ATTR_ASSIGN
        {
            if b.get_class() <> GN_ATTR_ASSIGN
                return false
            if a.char_index <> b.char_index
                return false
            return GroveNode.node_same(a.chunk, b.chunk)
        }
        ; AttributeValueTokenNode::same2 — (origin, attIndex, tokenIndex)
        if a.get_class() = GN_ATTR_TOKEN
        {
            if b.get_class() <> GN_ATTR_TOKEN
                return false
            if a.char_index <> b.char_index
                return false
            if a.element_index <> b.element_index
                return false
            return GroveNode.node_same(a.chunk, b.chunk)
        }
        if a.get_class() <> GN_DATA
            return false
        if b.get_class() <> GN_DATA
            return false
        if a.char_index <> b.char_index
            return false
        let ca a.data_chunk()
        let cb b.data_chunk()
        ca = cb
    }

    ; Node::elementIndex — the element's document-order ordinal (0-based,
    ; assigned by the builder at start-element; -1 on non-elements). The fot
    ; backend's numeric anchors print it.
    function get_element_index(this: GroveNode) returns int
        element_index

    ; Node::getId — the element's ID-typed attribute value (empty StringC if
    ; none); the same AttributeList walk as the element-with-id index.
    function get_id(this: GroveNode) returns StringC
    {
        let atts attributes
        if atts = null
            return StringC()
        let sz atts.size()
        var i: size_t 0
        while i < sz
        {
            if atts.id(i)
            {
                let v atts.value(i)
                if v <> null
                {
                    let t v.get_text()
                    if t <> null
                    {
                        let s t.string()
                        return s
                    }
                }
            }
            set i: i + 1
        }
        StringC()
    }

    function get_class(this: GroveNode) returns int
        node_class

    ; LocNode::getLocation (accessNull -> an empty Location) — the start-tag
    ; position of an element, inherited by its views.
    function get_loc(this: GroveNode) returns Location
        loc

    function get_gi(this: GroveNode) returns StringC
        gi

    function get_chars(this: GroveNode) returns StringC
        chars

    function get_attributes(this: GroveNode) returns ref[AttributeList]?
        attributes

    ; get_parent is the STRUCTURAL edge (Node::getOrigin): the node that
    ; contains this one, the grove root included. Sibling navigation,
    ; grove-root walks and ProcessingMode::findMatch (which uses getOrigin, not
    ; getParent) run over this one.
    function get_parent(this: GroveNode) returns ref[GroveNode]?
        parent

    ; get_axis_parent is the DSSSL PARENT AXIS — ChunkNode::getParent
    ; (spgrove/GroveBuilder.cxx:4978), which is deliberately NOT the structural
    ; edge: the reference returns accessNull for every node whose origin is the
    ; grove root, with the comment "This is needed because PiNodes in the prolog
    ; and epilog don't have a parent but do have an origin. Also for the
    ; document element." The sgml-document node is therefore NEVER reachable
    ; along the parent axis and every ancestor walk stops at the document
    ; element. Consumers are classified one by one in COMPLETENESS.md work
    ; package 1 — ancestor/numbering/pattern walks take the axis, siblings and
    ; grove-root walks keep get_parent.
    ; ★An ATTRIBUTE ASSIGNMENT answers the parent axis from `Node::getParent`,
    ; whose DEFAULT is accessNull (grove/Node.cxx:39) — it does not override it,
    ; so its parent is null even though its ORIGIN is the element. A VALUE TOKEN
    ; does override it (AttributeValueTokenNode::getParent,
    ; GroveBuilder.cxx:4096) and answers with its ASSIGNMENT, which is also its
    ; origin — measured, so the ordinary structural path below is right for it.
    function get_axis_parent(this: GroveNode) returns ref[GroveNode]?
    {
        if node_class = GN_ATTR_ASSIGN
            return null
        ; every DECLARATION class inherits Node::getParent's accessNull default
        ; (measured: `parent` is the empty node-list for all of them, and
        ; `tree-root` is therefore the node itself) — while their `parent` FIELD
        ; carries the owner chain that grove-root walks.
        if this.is_decl_class()
            return null
        let p parent
        if p = null
            return null
        if p.get_class() = GN_DOCUMENT
            return null
        p
    }

    ; --- the SIBLING axis (Chunk::getFirstSibling / nextChunkSibling) --------
    ;
    ; The sibling axis applies its OWN root rule, independent of the parent
    ; axis: `Chunk::getFirstSibling` (spgrove/GroveBuilder.cxx:5326) answers
    ; accessNotInClass when the node's origin is the grove root, so the DOCUMENT
    ; ELEMENT has no siblings at all — `preced`/`follow` are empty there and
    ; `first-sibling?`/`absolute-first-sibling?` are #f (their firstSibling call
    ; fails) while `last-sibling?`/`absolute-last-sibling?` are #t (nothing
    ; follows). The prolog and epilog PIs OVERRIDE it
    ; (PrologPiChunk/EpilogPiChunk::getFirstSibling -> root->prolog /
    ; root->epilog), so each PI group is siblings among itself and never across
    ; the document element.

    ; the node's own index among its structural parent's children, -1 if none
    function index_in_parent(this: ref[GroveNode]) returns int
    {
        let p this.parent
        if p = null
            return 0 - 1
        let n p.child_count()
        var i 0
        while i < n
        {
            let c p.child_at(i)
            if c = this
                return i
            set i: i + 1
        }
        0 - 1
    }

    ; the index of the document element among this (grove-root) node's children
    function document_element_index(this: GroveNode) returns int
    {
        let n this.child_count()
        var i 0
        while i < n
        {
            let c this.child_at(i)
            if c.get_class() = GN_ELEMENT
                return i
            set i: i + 1
        }
        0 - 1
    }

    ; SgmlDocumentNode::getProlog / getEpilog — the structural children before
    ; and after the document element. Both are accessOK with an EMPTY list when
    ; there is nothing there, and only the sgml-document class has them. An
    ; invalid document without a document element has no epilog (the reference
    ; never claims one either) and everything it holds is prolog.
    function prolog_end(this: GroveNode) returns int
    {
        let di this.document_element_index()
        if di < 0
            return this.child_count()
        di
    }

    function epilog_begin(this: GroveNode) returns int
    {
        let di this.document_element_index()
        if di < 0
            return this.child_count()
        di + 1
    }

    ; firstSibling succeeds? (false = accessNotInClass: no sibling axis)
    ; The attribute classes implement firstSibling themselves
    ; (AttributeAsgnNode / AttributeValueTokenNode: index 0 of their own group),
    ; so they always have one.
    function has_siblings(this: GroveNode) returns bool
    {
        if node_class = GN_ATTR_ASSIGN
            return true
        if node_class = GN_ATTR_TOKEN
            return true
        ; the declaration classes do not override BaseNode::firstSibling either
        ; (measured: preced/follow empty, first-sibling?/last-sibling? both #f) —
        ; note DocumentTypeNode::nextChunkSibling is accessNull for the same
        ; reason, so a doctype node is not a sibling of anything.
        if this.is_decl_class()
            return false
        let p parent
        if p = null
            return false
        if p.get_class() <> GN_DOCUMENT
            return true
        if node_class = GN_ELEMENT
            return false
        true
    }

    ; --- the sibling GROUP ---------------------------------------------------
    ;
    ; For a tree node the group is its structural parent's child list, addressed
    ; by the [begin, end) range below. The attribute classes have their OWN
    ; groups — an assignment's siblings are the origin's other ASSIGNMENTS
    ; (followSiblingRef walks attIndex, GroveBuilder.cxx:3694) and a value
    ; token's are the other TOKENS of the same value (it walks tokenIndex) — so
    ; every sibling walk asks the NODE for its group member rather than reaching
    ; through the parent's children.
    function sibling_group_at(this: ref[GroveNode], i: int) returns ref[GroveNode]?
    {
        if this.node_class = GN_ATTR_ASSIGN
            return GroveNode.attr_view(this.chunk, i)
        if this.node_class = GN_ATTR_TOKEN
        {
            let asgn this.parent
            if asgn = null
                return null
            let arr GroveNode.attr_value_views(asgn)
            if i >= (arr.get_length() as int)
                return null
            return arr[i]
        }
        let p this.parent
        if p = null
            return null
        ; a CDATA attribute value's data chunk hangs off the ASSIGNMENT, whose
        ; children are its value nodes (the axis), not a structural child list.
        if p.get_class() = GN_ATTR_ASSIGN
            return p.axis_child_at(i)
        p.child_at(i)
    }

    ; the half-open [begin, end) index range of this node's sibling group inside
    ; its structural parent's child list. For the document element the range is
    ; EMPTY and does not contain the node — which makes both the preced and the
    ; follow scans yield nothing, exactly as the reference does.
    function sibling_range_begin(this: ref[GroveNode]) returns int
    {
        if this.node_class = GN_ATTR_ASSIGN
            return 0
        if this.node_class = GN_ATTR_TOKEN
            return 0
        let p this.parent
        if p = null
            return 0
        if p.get_class() <> GN_DOCUMENT
            return 0
        if this.node_class = GN_ELEMENT
            return 0
        let di p.document_element_index()
        if di < 0
            return 0
        let mi this.index_in_parent()
        if mi < di
            return 0
        di + 1
    }

    ; the node's own index inside its sibling group, or -1 when the group does
    ; not contain it (an empty range, a character view, a node whose group is
    ; somebody else's). See the note above the concept for why the memo cannot
    ; make this wrong.
    function group_index(this: ref[GroveNode]) returns int
    {
        let begin this.sibling_range_begin()
        let end this.sibling_range_end()
        if begin >= end
            return 0 - 1
        var start begin
        if sib_hint_parent = this.parent
        {
            if sib_hint_index >= begin
            {
                if sib_hint_index < end
                    set start: sib_hint_index
            }
        }
        var i start
        repeat
        {
            if this.sibling_group_at(i) = this
            {
                set sib_hint_parent: this.parent
                set sib_hint_index: i
                return i
            }
            set i: i + 1
            if i >= end
                set i: begin
            if i = start
                return 0 - 1
        }
        0 - 1
    }

    function sibling_range_end(this: ref[GroveNode]) returns int
    {
        if this.node_class = GN_ATTR_ASSIGN
        {
            let arr GroveNode.attr_views(this.chunk)
            return arr.get_length() as int
        }
        if this.node_class = GN_ATTR_TOKEN
        {
            let asgn this.parent
            if asgn = null
                return 0
            let arr GroveNode.attr_value_views(asgn)
            return arr.get_length() as int
        }
        let p this.parent
        if p = null
            return 0
        if p.get_class() = GN_ATTR_ASSIGN
            return p.axis_child_count()
        let n p.child_count()
        if p.get_class() <> GN_DOCUMENT
            return n
        if this.node_class = GN_ELEMENT
            return 0
        let di p.document_element_index()
        if di < 0
            return n
        let mi this.index_in_parent()
        if mi < di
            return di
        n
    }

    function get_children(this: GroveNode) returns ref[Array[ref[GroveNode]?]]?
        children

    function child_count(this: GroveNode) returns int
    {
        if children = null
            return 0
        children.get_length() as int
    }

    function child_at(this: GroveNode, i: int) returns ref[GroveNode]?
    {
        if children = null
            return null
        children[i]
    }

    function add_child(this: ref[GroveNode], c: ref[GroveNode])
        this.children.add(c)

    ; --- the CHILDREN axis (Node::firstChild) -------------------------------
    ;
    ; `Node::firstChild` is accessNotInClass by default and is overridden ONLY
    ; by ElementNode (grove/Node.cxx:399, spgrove/GroveBuilder.cxx:2965) — the
    ; attribute-assignment class is the reference's other override and is
    ; unported. So the SGML-DOCUMENT node has NO children axis: `children`,
    ; `descendants` and `data` are all empty at the grove root, and
    ; processChildren falls back to getDocumentElement there. The STRUCTURAL
    ; child list (child_count/child_at) keeps carrying prolog PIs, document
    ; element and epilog PIs — that is what the builder, the sibling ranges,
    ; the prolog/epilog properties and the element-number walk read.
    function has_child_axis(this: GroveNode) returns bool
    {
        if node_class = GN_ATTR_ASSIGN
            return true
        node_class = GN_ELEMENT
    }

    function axis_child_count(this: ref[GroveNode]) returns int
    {
        if this.node_class = GN_ATTR_ASSIGN
        {
            let arr GroveNode.attr_value_views(this)
            return arr.get_length() as int
        }
        if this.node_class <> GN_ELEMENT
            return 0
        this.child_count()
    }

    function axis_child_at(this: ref[GroveNode], i: int) returns ref[GroveNode]?
    {
        if this.node_class = GN_ATTR_ASSIGN
        {
            let arr GroveNode.attr_value_views(this)
            if i < 0
                return null
            if i >= (arr.get_length() as int)
                return null
            return arr[i]
        }
        if this.node_class <> GN_ELEMENT
            return null
        this.child_at(i)
    }

    ; --- element flags (the chunk's included / mustOmitEndTag) --------------
    ;
    ; `included?` is the start-element event's inclusion flag
    ; (IncludedElementChunk::included) and `must-omit-end-tag?` is
    ; ElementChunk::mustOmitEndTag — declared content EMPTY, or a CONREF
    ; attribute specified WITH a value (AttElementChunk::mustOmitEndTag). Both
    ; are decided while the event is in hand and stored on the node.
    function get_included(this: GroveNode) returns bool
        (flags & GN_FLAG_INCLUDED) <> 0

    function get_must_omit_end_tag(this: GroveNode) returns bool
        (flags & GN_FLAG_MUST_OMIT_END_TAG) <> 0

    procedure set_flag(this: ref[GroveNode], f: int)
        set this.flags: this.flags | f

    ; ElementNode::getId — the value of this element's ID-typed attribute, the
    ; empty string when it has none (an ID value is a name token, so it can
    ; never legitimately be empty).
    function id_value(this: GroveNode) returns StringC
    {
        if node_class <> GN_ELEMENT
            return StringC()
        let atts attributes
        if atts = null
            return StringC()
        let sz atts.size()
        var i: size_t 0
        while i < sz
        {
            if atts.id(i)
            {
                let v atts.value(i)
                if v <> null
                {
                    let t v.get_text()
                    if t <> null
                        return t.string()
                }
            }
            set i: i + 1
        }
        StringC()
    }
}

; GroveBuilder — walk ps.events into a document node tree. Mirrors
; SPGrove's event-driven build: start pushes an element under the current
; node, end pops, data/sdata append a data leaf, pi appends a pi leaf.
; One entry of the grove ID index: an ID-attribute value and the element it
; identifies. See GroveBuilder.build_id_index.
define IdEntry (id: StringC, node: ref[GroveNode]?)
{
    ; the element this entry identifies — the sgml-document class's `elements`
    ; named node list is this table (see Primitive.node_property_value).
    function get_node(this: IdEntry) returns ref[GroveNode]?
        node
}

; GroveImpl (spgrove/GroveBuilder.cxx:163) — everything a grove owns BESIDE its
; node tree: the grove index, the governing DTD, the instance syntax's fold
; table, the defaulted-entity table, the ID table and the APPINFO literal. The
; record hangs off the sgml-document node's `decl` slot (the only node class
; that never uses it for a declaration object), so every consumer reaches its
; own grove's copy through Node::getGroveRoot — which is exactly how the
; reference spells each of these accesses.
;
; `dtd` stays untyped: opensp's Dtd must not enter this module's type graph
; (the ExternalDataEntity notation-field convention).
;
; GroveImpl's `sd_` / `prologSyntax_` / `instanceSyntax_` have NO counterpart
; here: their only reader is `SgmlDocumentNode::getSd`, whose only caller is the
; subdoc branch of DssslApp::load — dead in the reference (see the note in
; GroveManager.load). The instance syntax's contribution that IS live, its
; general fold table, is `subst`.
define GroveInfo (grove_index: int, sysid: StringC, subst: pointer[u32], dtd: ref[Dtd]?, defaulted_ents: ref[Array[ref[Entity]?]], entity_defaulted: ref[Array[ref[Entity]?]]?, appinfo: ref[StringC]?, id_index: ref[Array[ref[IdEntry]?]]?, id_table: ref[NameTable]?, elem_order: ref[Array[ref[GroveNode]?]]?)
{
    function make(host: ref[Page], grove_index: int) returns ref[GroveInfo]
    {
        let p host.allocate(sizeof GroveInfo, alignof GroveInfo) as pointer[GroveInfo]
        set p.grove_index: grove_index
        set p.sysid: StringC()
        set p.subst: null
        set p.dtd: null
        set p.defaulted_ents: Array[ref[Entity]?]^host()
        set p.entity_defaulted: null
        set p.appinfo: null
        set p.id_index: null
        set p.id_table: null
        set p.elem_order: null
        p
    }

    ; The document-order ELEMENT vector — the port's stand-in for the chunk
    ; chain the reference steps along in `NumberCache::advance`
    ; (NodePtr::assignNextChunkAfter). Built once per grove, on the first
    ; `element-number` of the run; null for a grove GroveBuilder never built
    ; (hand-made unit-test trees), where the caller falls back to the walk.
    ;
    ; ★The vector's POSITION is the node's `element_index` — GroveBuilder
    ; assigns that at every start tag, in document order, and the pre-order
    ; collection below visits the elements in exactly that order. `advance` is
    ; an index increment because of it, so the identity is VERIFIED here rather
    ; than assumed: one mismatch and the grove answers "no vector" for good.
    function elem_order_of(host: ref[Page], node: ref[GroveNode]) returns ref[Array[ref[GroveNode]?]]?
    {
        let info GroveInfo.of(node)
        if info = null
            return null
        if info.elem_order <> null
            return info.elem_order
        var root node
        var up root.get_parent()
        while up <> null
        {
            set root: up as ref[GroveNode]
            set up: root.get_parent()
        }
        let v Array[ref[GroveNode]?]^host()
        if GroveInfo.collect_elements(root, v) = false
            return null
        set info.elem_order: v
        v
    }

    function collect_elements(cur: ref[GroveNode], out: ref[Array[ref[GroveNode]?]]) returns bool
    {
        if cur.get_class() = GN_ELEMENT
        {
            if cur.get_element_index() <> (out.get_length() as int)
                return false
            out.add(cur)
        }
        let n cur.child_count()
        var i 0
        while i < n
        {
            let c cur.child_at(i)
            if GroveInfo.collect_elements(c, out) = false
                return false
            set i: i + 1
        }
        true
    }

    ; Node::getGroveRoot — the STRUCTURAL walk (not the DSSSL parent axis, which
    ; stops at the document element), then the sgml-document node's info. Null
    ; for a node that was never built by GroveBuilder (the unit tests' hand-made
    ; trees), where every accessor below degrades to "no table".
    function of(node: ref[GroveNode]?) returns ref[GroveInfo]?
    {
        if node = null
            return null
        var cur node
        var up cur.get_parent()
        while up <> null
        {
            set cur: up
            set up: cur.get_parent()
        }
        if cur.get_class() <> GN_DOCUMENT
            return null
        cur.get_decl() as ref[GroveInfo]
    }

    ; Node::groveIndex — 0 for the document grove, 1.. for every grove
    ; sgml-parse loads. `sameGrove` is the comparison of two of these.
    function index_of(node: ref[GroveNode]) returns int
    {
        let gi GroveInfo.of(node)
        if gi = null
            return 0
        gi.grove_index
    }

    ; GroveImpl::generalSubstTable — the instance syntax's 256-entry name-fold
    ; table the NAMED node lists normalize a query name through. Null = no
    ; folding.
    function subst_of(node: ref[GroveNode]) returns pointer[u32]
    {
        let gi GroveInfo.of(node)
        if gi = null
            return null
        gi.subst
    }

    ; GroveImpl::governingDtd
    function dtd_of(node: ref[GroveNode]) returns ref[Dtd]?
    {
        let gi GroveInfo.of(node)
        if gi = null
            return null
        gi.dtd
    }

    ; GroveImpl::idTable_ — the elements that have an ID, in document order.
    ; The Array carries the ORDER (the `elements` named node list walks it); the
    ; NameTable beside it carries the LOOKUP, which is what the reference's
    ; PointerTable<...,Hash,...> does. Null table = fall back to the scan (the
    ; hand-made unit-test groves never install one).
    function id_index_of(node: ref[GroveNode]) returns ref[Array[ref[IdEntry]?]]?
    {
        let gi GroveInfo.of(node)
        if gi = null
            return null
        gi.id_index
    }

    function id_table_of(node: ref[GroveNode]) returns ref[NameTable]?
    {
        let gi GroveInfo.of(node)
        if gi = null
            return null
        gi.id_table
    }

    ; GroveImpl::appinfo_ / haveAppinfo_ — the SGML declaration's APPINFO
    ; literal (accessNull under APPINFO NONE, where no AppinfoEvent fires).
    function appinfo_of(node: ref[GroveNode]) returns ref[StringC]?
    {
        let gi GroveInfo.of(node)
        if gi = null
            return null
        gi.appinfo
    }

    ; GroveImpl::defaultedEntityTable_ — the entities the INSTANCE resolved
    ; through ParserState's entity lookup (the reference fills this from every
    ; EntityDefaultedEvent, which fires for far more than actual defaulted
    ; copies — see ParserState.lookup_entity_pass_aware). Insertion order; the
    ; reference iterates it as a NamedTable, so the ORDER the
    ; `defaulted-entities` property hands out is hash-bucket order, re-derived
    ; at the property (like every other declaration table).
    function defaulted_ents_of(node: ref[GroveNode]) returns ref[Array[ref[Entity]?]]?
    {
        let gi GroveInfo.of(node)
        if gi = null
            return null
        gi.defaulted_ents
    }

    ; GroveImpl::lookupDefaultedEntity
    function lookup_defaulted_ent(node: ref[GroveNode], nm: StringC) returns ref[Entity]?
    {
        let list GroveInfo.defaulted_ents_of(node)
        if list = null
            return null
        let n list.get_length()
        let buf list.get_buffer()
        var i: size_t 0
        while i < n
        {
            let e *(buf + i)
            if e <> null
            {
                if e.get_name().equals(nm)
                    return e
            }
            set i: i + 1
        }
        null
    }

    ; NamedResourceTable::insert — a same-NAME entry is REPLACED in place, so
    ; repeated references to one entity leave a single member and the bucket
    ; sequence follows first-insertion order. Called with the BUILDER's info,
    ; which is why it takes the record and not a node.
    procedure add_defaulted_ent(info: ref[GroveInfo], ent: ref[Entity]?)
    {
        let list info.defaulted_ents
        if ent = null
            return
        let nm ent.get_name()
        let n list.get_length()
        let buf list.get_buffer()
        var i: size_t 0
        while i < n
        {
            let e *(buf + i)
            if e <> null
            {
                if e.get_name().equals(nm)
                {
                    list.put(i, ent)
                    return
                }
            }
            set i: i + 1
        }
        list.add(ent)
    }

    ; Entity::defaulted() — a side table in this port
    ; (ParserState.defaulted_entities), threaded in by whoever ran the parse.
    ; The `defaulted?` property and EntityNode::getOrigin's grove-root special
    ; case both read it.
    function entity_is_defaulted(node: ref[GroveNode], ent: ref[Entity]?) returns bool
    {
        let gi GroveInfo.of(node)
        if gi = null
            return false
        let list gi.entity_defaulted
        if list = null
            return false
        if ent = null
            return false
        let n list.get_length()
        let buf list.get_buffer()
        var i: size_t 0
        while i < n
        {
            if (*(buf + i)) = ent
                return true
            set i: i + 1
        }
        false
    }
}

; Incremental grove construction state — the streaming drain (opensp's
; do_content pump calling back into GroveBuilder.feed) consumes the event
; queue in chunks, so the builder can no longer be a one-shot walk. The
; pending-data fields mirror the reference's data COALESCING
; (GroveBuilder.cxx DataNode::add): consecutive data events whose location
; is contiguous (same origin, index continues the run) extend ONE data
; chunk; any other event — or a non-contiguous data event — flushes the
; pending chunk as a single data node. (The per-event data nodes the old
; walk produced were a port deviation: 3.4M nodes on a 5 MB parse.)
;
; The sim_* fields replicate GroveImpl's CHUNK ALLOCATOR byte-exactly —
; a data run also breaks where the reference's tryExtend fails (block
; exhausted), which is OBSERVABLE (one fot <text> per data chunk, chunk-
; stepped node lists). Geometry: blocks start at 8192 bytes and double
; every 20 blocks; each block reserves BlockHeader(8) + ForwardingChunk(24);
; chunk sizes are the reference build's C++ sizeofs (arm64 LP64, Char=4):
; SgmlDocumentChunk 56, ElementChunk 48, AttElementChunk 56+8*nAtts,
; LocOriginChunk 24, DataChunk/PiChunk header 32 (+4/char, 8-rounded),
; SdataChunk 32, ForwardingChunk 24. A LocOriginChunk lands when the event
; origin changes or 100 allocChunk calls have passed (setLocOrigin);
; finishProlog/finishDocumentElement add barrier ForwardingChunks.
define GroveBuildState (info: ref[GroveInfo], host: ref[Page], root: ref[GroveNode], current: ref[GroveNode], pend: ref[Array[u32]]?, pend_org: ref[Origin]?, pend_next: u32, n_elements: int, sim_n_free: size_t, sim_block_size: size_t, sim_blocks_this_size: int, sim_chunks_since_lo: int, sim_cur_lo: ref[Origin]?, sim_block_live: bool, doc_started: bool, prolog_chunk_added: bool, epilog_set: bool, tok_buf: ref[Array[u32]]?, tok_org: ref[Origin]?, tok_start: u32, tok_bound: u32)
{
}

; --- GroveImpl allocator simulation (sizes: reference build sizeofs) --------
define SIM_BLOCK_HEADER: int 8
define SIM_FORWARDING: int 24
define SIM_SGML_DOCUMENT: int 56
define SIM_ELEMENT: int 48
define SIM_ATT_ELEMENT: int 56
define SIM_LOC_ORIGIN: int 24
define SIM_CHARS_HEADER: int 32
; EntityRefChunk = LocChunk(vptr + origin + Index) + `const Entity *` = 32, and
; SdataChunk / ExternalDataChunk / SubdocChunk / PiEntityChunk all derive from
; it without adding a field (SdataNode keeps its mapped Char in the NODE).
define SIM_SDATA: int 32
; NonSgmlChunk = LocChunk + Char, which fits the tail padding.
define SIM_NONSGML: int 24
define SIM_INITIAL_BLOCK: int 8192
define SIM_MAX_BLOCKS_PER_SIZE: int 20
define SIM_MAX_CHUNKS_WITHOUT_LO: int 100

define GroveBuilder
{
    function begin(host: ref[Page], grove_index: int) returns ref[GroveBuildState]
    {
        let st host.allocate(sizeof GroveBuildState, alignof GroveBuildState) as pointer[GroveBuildState]
        set st.host: host
        let root GroveNode.make(host, GN_DOCUMENT)
        set st.root: root
        set st.current: root
        set st.pend: null
        set st.pend_org: null
        set st.pend_next: 0
        set st.n_elements: 0
        set st.sim_n_free: 0
        set st.sim_block_size: SIM_INITIAL_BLOCK as size_t
        set st.sim_blocks_this_size: 0
        set st.sim_chunks_since_lo: 0
        set st.sim_cur_lo: null
        set st.sim_block_live: false
        set st.doc_started: false
        set st.prolog_chunk_added: false
        set st.epilog_set: false
        set st.tok_buf: null
        set st.tok_org: null
        set st.tok_start: 0
        set st.tok_bound: 0
        ; GroveImpl ctor: root_ = new (allocChunk(sizeof(SgmlDocumentChunk)))
        GroveBuilder.sim_alloc_chunk(st, SIM_SGML_DOCUMENT as size_t)
        ; GroveImpl's tables that live BESIDE the node tree — the defaulted-entity
        ; table (fed from EntityDefaultedEvent below), the APPINFO literal, the
        ; DTD, the fold table and the ID index. They are the grove's, not the
        ; run's: the record hangs off the sgml-document node, and every property
        ; accessor reaches it through Node::getGroveRoot. Whoever ran the parse
        ; fills in the parser-side fields afterwards (fill_from_parse).
        let info GroveInfo.make(host, grove_index)
        set st.info: info
        set root.decl: info as pointer[void]
        st
    }

    ; CharsChunk::allocSize — header + 4 bytes/char, rounded to 8.
    function sim_chars_alloc_size(n_chars: size_t) returns size_t
        (((SIM_CHARS_HEADER as size_t) + n_chars * 4) + 7) & (0 - 8)

    ; GroveImpl::allocFinish — possibly double the block size, then open a
    ; fresh block reserving BlockHeader + a ForwardingChunk slot.
    procedure sim_alloc_finish(st: ref[GroveBuildState], n: size_t)
    {
        set st.sim_blocks_this_size: st.sim_blocks_this_size + 1
        if st.sim_blocks_this_size >= SIM_MAX_BLOCKS_PER_SIZE
        {
            set st.sim_block_size: st.sim_block_size * 2
            set st.sim_blocks_this_size: 0
        }
        let alloc_size n + ((SIM_FORWARDING + SIM_BLOCK_HEADER) as size_t)
        if alloc_size < st.sim_block_size
            set st.sim_n_free: st.sim_block_size - alloc_size
        else
            set st.sim_n_free: 0
        set st.sim_block_live: true
    }

    ; GroveImpl::allocChunk — bump within the block or finish into a new one.
    procedure sim_alloc_chunk(st: ref[GroveBuildState], n: size_t)
    {
        set st.sim_chunks_since_lo: st.sim_chunks_since_lo + 1
        if n <= st.sim_n_free
        {
            set st.sim_n_free: st.sim_n_free - n
            return
        }
        GroveBuilder.sim_alloc_finish(st, n)
    }

    ; GroveImpl::tryExtend
    function sim_try_extend(st: ref[GroveBuildState], n: size_t) returns bool
    {
        if n <= st.sim_n_free
        {
            set st.sim_n_free: st.sim_n_free - n
            return true
        }
        false
    }

    ; GroveImpl::setLocOrigin/storeLocOrigin — a LocOriginChunk lands when
    ; the origin changed or 100 allocChunk calls have passed.
    procedure sim_set_loc_origin(st: ref[GroveBuildState], org: ref[Origin])
    {
        var store false
        if org <> st.sim_cur_lo
            set store: true
        if st.sim_chunks_since_lo >= SIM_MAX_CHUNKS_WITHOUT_LO
            set store: true
        if store = false
            return
        GroveBuilder.sim_alloc_chunk(st, SIM_LOC_ORIGIN as size_t)
        set st.sim_chunks_since_lo: 0
        set st.sim_cur_lo: org
    }

    ; GroveImpl::addBarrier — a ForwardingChunk written into the block's
    ; reserved slot; a (nearly) full block dies.
    procedure sim_add_barrier(st: ref[GroveBuildState])
    {
        if st.sim_block_live = false
            return
        if st.sim_n_free <= (SIM_FORWARDING as size_t)
        {
            set st.sim_n_free: 0
            set st.sim_block_live: false
            return
        }
        set st.sim_n_free: st.sim_n_free - (SIM_FORWARDING as size_t)
    }

    ; appendSibling/push bookkeeping shared bits: prolog/epilog tracking for
    ; the finishProlog/finishDocumentElement barriers.
    procedure sim_note_append(st: ref[GroveBuildState])
    {
        if st.doc_started = false
        {
            set st.prolog_chunk_added: true
            return
        }
        ; back at root after the document element: first append claims epilog.
        if st.current = st.root
            set st.epilog_set: true
    }

    ; DataNode::add — ONE reference data event (a token): extend the pending
    ; chunk when the origin is current, the index continues the run AND the
    ; extension fits the reference's allocation block; else a fresh chunk
    ; (= a fresh grove data node).
    procedure data_add(st: ref[GroveBuildState], org: ref[Origin], idx: u32, chars: pointer[u32], n: size_t)
    {
        var extend false
        if st.pend <> null
        {
            if org = st.sim_cur_lo
            {
                if idx = st.pend_next
                {
                    let pb0 st.pend
                    let old_n pb0.get_length()
                    let delta GroveBuilder.sim_chars_alloc_size(old_n + n) - GroveBuilder.sim_chars_alloc_size(old_n)
                    if GroveBuilder.sim_try_extend(st, delta)
                        set extend: true
                }
            }
        }
        if extend = false
        {
            GroveBuilder.flush_pending(st)
            GroveBuilder.sim_set_loc_origin(st, org)
            GroveBuilder.sim_alloc_chunk(st, GroveBuilder.sim_chars_alloc_size(n))
            GroveBuilder.sim_note_append(st)
            let host st.host
            let fresh Array[u32]^host()
            set st.pend: fresh
            set st.pend_org: org
        }
        let pb st.pend
        var k: size_t 0
        while k < n
        {
            pb.add(*(chars + k))
            set k: k + 1
        }
        set st.pend_next: idx + (n as u32)
    }

    ; The first read-block boundary past `idx` in this origin's fill-bounds
    ; list (see Origin.set_fill_bounds) — u32 max when none (in-memory
    ; sources never refill).
    function next_fill_bound(org: ref[Origin]?, idx: u32) returns u32
    {
        if org = null
            return 0xFFFFFFFF as u32
        let fb org.get_fill_bounds()
        if fb = null
            return 0xFFFFFFFF as u32
        let n fb.get_length()
        let b fb.get_buffer()
        var lo: size_t 0
        var hi n
        while lo < hi
        {
            let mid lo + ((hi - lo) / 2)
            if (*(b + mid)) <= (idx as size_t)
                set lo: mid + 1
            else
                set hi: mid
        }
        if lo < n
            return (*(b + lo)) as u32
        0xFFFFFFFF as u32
    }

    ; Close the open re-grouped token: it becomes one reference data event.
    ; (The parser port emits content data PER CHARACTER; the reference's
    ; extendData batches a maximal run of normal chars into ONE
    ; ImmediateDataEvent, and the chunk-extension quantum is per EVENT —
    ; observable through where chunks break. Contiguous same-origin 1-char
    ; data events are regrouped here into that token; RE function-char
    ; events, origin changes and index gaps close it, as extendData's
    ; normal-map/buffer boundaries do. Caveat: a record longer than the
    ; reference's read block would split mid-record there — unmodeled.)
    procedure close_token(st: ref[GroveBuildState])
    {
        let tb st.tok_buf
        if tb = null
            return
        let n tb.get_length()
        if n > 0
            GroveBuilder.data_add(st, st.tok_org, st.tok_start, tb.get_buffer(), n)
        set st.tok_buf: null
        set st.tok_org: null
    }

    ; flush the pending coalesced data run as ONE data node (the reference's
    ; DataChunk boundary — GroveImpl::push/appendSibling flush pendingData_).
    function flush_pending(st: ref[GroveBuildState])
    {
        if st.pend = null
            return
        let host st.host
        let pb st.pend
        let node GroveNode.make(host, GN_DATA)
        set node.chars: StringC^host(pb.get_buffer(), pb.get_length())
        let cur st.current
        set node.parent: cur
        cur.add_child(node)
        set st.pend: null
        set st.pend_org: null
    }

    ; consume the queued events [ps.get_drained(), ps.n_events()) — called
    ; from the streaming drain callback (which then resets the event scratch
    ; region, so everything kept here is deep-copied; the borrowed
    ; AttributeList pointers live on the run page and survive).
    function feed(st: ref[GroveBuildState], ps: ref[ParserState])
    {
        let events ps.get_events()
        let host st.host
        let buf events.get_buffer()
        let n events.get_length()
        var i ps.get_drained()
        while i < n
        {
            let ev *(buf + i)
            let t ev.get_type()
            if t = GEV_START_ELEMENT
            {
                ; ElementNode::add: setLocOrigin, chunk alloc (plain or
                ; att-bearing), then push (which flushes pending data).
                GroveBuilder.close_token(st)
                let loc ev.get_loc()
                GroveBuilder.sim_set_loc_origin(st, loc.get_origin())
                let atts0 ev.get_attributes()
                var plain true
                if atts0 <> null
                {
                    if atts0.n_spec_of() > 0
                        set plain: false
                    if atts0.any_current()
                        set plain: false
                }
                if plain
                    GroveBuilder.sim_alloc_chunk(st, SIM_ELEMENT as size_t)
                else
                {
                    ; makeAttElementChunk: trailing unspecified/non-current
                    ; attributes are trimmed off the pointer array.
                    var n_atts atts0.size()
                    while n_atts > 0
                    {
                        let last n_atts - 1
                        if atts0.specified(last)
                            break
                        if atts0.current(last)
                            break
                        set n_atts: last
                    }
                    GroveBuilder.sim_alloc_chunk(st, (SIM_ATT_ELEMENT as size_t) + n_atts * 8)
                }
                GroveBuilder.flush_pending(st)
                if st.current = st.root
                {
                    ; push at root: the first element becomes the document
                    ; element; later ones append (claiming the epilog).
                    if st.doc_started
                        set st.epilog_set: true
                    else
                        set st.doc_started: true
                }
                let et ev.get_element_type()
                let node GroveNode.make(host, GN_ELEMENT)
                ; LocNode: the element's location is its START-TAG event's
                ; (ElementNode::add -> setLocOrigin + `chunk->locIndex =
                ; event.location().index()`). ★That is the event's MARKUP
                ; location here: the reference passes markupLocation() — the
                ; STAGO — as the StartElementEvent's location, while this
                ; port's Event carries the post-GI position in `loc` and the
                ; STAGO in `markup_loc`. The one diagnostic that reads it is
                ; ProcessingMode's ambiguousMatch.
                set node.loc: ev.get_markup_loc()
                set node.element_index: st.n_elements
                set st.n_elements: st.n_elements + 1
                if et <> null
                {
                    let nm et.get_name()
                    set node.gi: StringC^host(nm.data_ptr(), nm.get_size())
                }
                ; the element chunk's two booleans, decided while the event is
                ; in hand: included? = IncludedElementChunk::included (the
                ; event's inclusion flag), must-omit-end-tag? =
                ; ElementChunk::mustOmitEndTag (declared content EMPTY) or
                ; AttElementChunk::mustOmitEndTag (a CONREF attribute specified
                ; WITH a value).
                if ev.is_included()
                    node.set_flag(GN_FLAG_INCLUDED)
                if GroveBuilder.must_omit_end_tag(et, atts0)
                    node.set_flag(GN_FLAG_MUST_OMIT_END_TAG)
                set node.attributes: ev.get_attributes()
                let cur st.current
                set node.parent: cur
                cur.add_child(node)
                set st.current: node
            }
            else if t = GEV_END_ELEMENT
            {
                GroveBuilder.close_token(st)
                GroveBuilder.flush_pending(st)
                let cur st.current
                let p cur.get_parent()
                if p <> null
                    set st.current: p as ref[GroveNode]
                ; pop back to root: finishDocumentElement adds a barrier
                ; ForwardingChunk while the epilog is unclaimed.
                if st.current = st.root
                {
                    if st.epilog_set = false
                        GroveBuilder.sim_add_barrier(st)
                }
            }
            else if t = GEV_DATA
            {
                ; a zero-length event adds nothing; otherwise regroup the
                ; port's per-char data events into reference-sized tokens
                ; (see close_token) and run DataNode::add per token.
                let d ev.get_data()
                let dl d.get_size()
                if dl > 0
                {
                    let loc ev.get_loc()
                    let org loc.get_origin()
                    let idx loc.get_index()
                    let dp d.data_ptr()
                    ; an RE function char (emitted by the pending-RE
                    ; machinery) is its OWN reference data event, never
                    ; part of an extendData token. Content data can only
                    ; carry RE/RS values via char refs, which arrive with
                    ; an index gap and close the token anyway.
                    var re_like false
                    if dl = 1
                    {
                        let c0 *dp
                        if c0 = 0x0D
                            set re_like: true
                        if c0 = 0x0A
                            set re_like: true
                    }
                    var joins false
                    if st.tok_buf <> null
                    {
                        if re_like = false
                        {
                            if org = st.tok_org
                            {
                                let tb0 st.tok_buf
                                let tn tb0.get_length()
                                if idx = st.tok_start + (tn as u32)
                                {
                                    ; a token never crosses the reference's
                                    ; read-block edge (extendData stops at
                                    ; the decoded buffer end).
                                    if idx < st.tok_bound
                                        set joins: true
                                }
                            }
                        }
                    }
                    if joins = false
                        GroveBuilder.close_token(st)
                    if re_like
                        GroveBuilder.data_add(st, org, idx, dp, dl)
                    else
                    {
                        if st.tok_buf = null
                        {
                            let fresh_tok Array[u32]^host()
                            set st.tok_buf: fresh_tok
                            set st.tok_org: org
                            set st.tok_start: idx
                            set st.tok_bound: GroveBuilder.next_fill_bound(org, idx)
                        }
                        ; bind the pointer field — a method call through a
                        ; pointer-FIELD receiver mis-emits (the documented
                        ; deref-receiver class).
                        let tb st.tok_buf
                        var k: size_t 0
                        while k < dl
                        {
                            tb.add(*(dp + k))
                            set k: k + 1
                        }
                    }
                }
            }
            else if t = GEV_SDATA
            {
                ; SdataNode::add (spgrove/GroveBuilder.cxx:3480) — SDATA is its
                ; OWN node class, never coalesced into neighboring data, and it
                ; contributes ONE character: the one the SdataMapper resolves
                ; from the entity NAME (then its text, then a U-XXXX name, then
                ; defaultChar), never the replacement text, which is only the
                ; `system-data` property. Its loc origin is the entity
                ; REFERENCE's (the event origin's parent).
                GroveBuilder.close_token(st)
                let loc ev.get_loc()
                let par loc.parent()
                GroveBuilder.sim_set_loc_origin(st, par.get_origin())
                GroveBuilder.sim_alloc_chunk(st, SIM_SDATA as size_t)
                GroveBuilder.flush_pending(st)
                GroveBuilder.sim_note_append(st)
                let d ev.get_data()
                let node GroveNode.make(host, GN_SDATA)
                set node.chars: StringC^host(d.data_ptr(), d.get_size())
                set node.decl: ev.get_entity() as pointer[void]
                let cur st.current
                set node.parent: cur
                cur.add_child(node)
            }
            else if t = GEV_ENTITY_REF
            {
                ; ExternalDataNode::add (:3524) — an NDATA entity reference.
                GroveBuilder.close_token(st)
                let loc ev.get_loc()
                GroveBuilder.sim_set_loc_origin(st, loc.get_origin())
                GroveBuilder.sim_alloc_chunk(st, SIM_SDATA as size_t)
                GroveBuilder.flush_pending(st)
                GroveBuilder.sim_note_append(st)
                let node GroveNode.make(host, GN_EXTERNAL_DATA)
                set node.decl: ev.get_entity() as pointer[void]
                let cur st.current
                set node.parent: cur
                cur.add_child(node)
            }
            else if t = GEV_START_SUBDOC
            {
                ; SubdocNode::add (:3540). The grove NEVER sub-parses — the
                ; referenced document contributes no nodes at all (the parser
                ; suppresses the child parse for this app, see
                ; ParserState.app_parses_subdocs), so the END bracket the ESIS
                ; writer needs is not even queued.
                GroveBuilder.close_token(st)
                let loc ev.get_loc()
                GroveBuilder.sim_set_loc_origin(st, loc.get_origin())
                GroveBuilder.sim_alloc_chunk(st, SIM_SDATA as size_t)
                GroveBuilder.flush_pending(st)
                GroveBuilder.sim_note_append(st)
                let node GroveNode.make(host, GN_SUBDOC)
                set node.decl: ev.get_entity() as pointer[void]
                let cur st.current
                set node.parent: cur
                cur.add_child(node)
            }
            else if t = GEV_NONSGML
            {
                ; NonSgmlNode::add (:3515) — a character reference to a
                ; character the SGML declaration leaves UNUSED. It is a node in
                ; the content, but it answers no property (ClassDef::nonSgml is
                ; the reference's FIXME table) and its charChunk is accessNull,
                ; so it contributes nothing to any backend.
                GroveBuilder.close_token(st)
                let loc ev.get_loc()
                GroveBuilder.sim_set_loc_origin(st, loc.get_origin())
                GroveBuilder.sim_alloc_chunk(st, SIM_NONSGML as size_t)
                GroveBuilder.flush_pending(st)
                GroveBuilder.sim_note_append(st)
                let d ev.get_data()
                let node GroveNode.make(host, GN_NONSGML)
                set node.chars: StringC^host(d.data_ptr(), d.get_size())
                let cur st.current
                set node.parent: cur
                cur.add_child(node)
            }
            else if t = GEV_PI
            {
                GroveBuilder.close_token(st)
                let loc ev.get_loc()
                GroveBuilder.sim_set_loc_origin(st, loc.get_origin())
                let d ev.get_data()
                ; PiNode::add (:3418) branches on the event's ENTITY: a PI
                ; ENTITY reference builds a PiEntityNode instead — same pi
                ; class, but an EntityRefChunk (its data is the entity's text,
                ; not a copied char run) and non-null entity-name / entity,
                ; where a markup PI answers accessNull for both.
                let pe ev.get_entity()
                if pe = null
                    GroveBuilder.sim_alloc_chunk(st, GroveBuilder.sim_chars_alloc_size(d.get_size()))
                else
                    GroveBuilder.sim_alloc_chunk(st, SIM_SDATA as size_t)
                GroveBuilder.flush_pending(st)
                GroveBuilder.sim_note_append(st)
                let node GroveNode.make(host, GN_PI)
                set node.chars: StringC^host(d.data_ptr(), d.get_size())
                set node.decl: pe as pointer[void]
                let cur st.current
                set node.parent: cur
                cur.add_child(node)
            }
            else if t = GEV_END_PROLOG
            {
                GroveBuilder.close_token(st)
                ; finishProlog: a barrier if any prolog chunk was appended.
                if st.prolog_chunk_added
                    GroveBuilder.sim_add_barrier(st)
            }
            else if t = GEV_ENTITY_DEFAULTED
            {
                ; GroveBuilderEventHandler::entityDefaulted ->
                ; GroveImpl::addDefaultedEntity. NOT a chunk: the table is a
                ; NamedResourceTable beside the node tree, so the allocator
                ; simulation stays untouched.
                GroveInfo.add_defaulted_ent(st.info, ev.get_entity())
            }
            else if t = GEV_APPINFO
            {
                ; GroveBuilderEventHandler::appinfo -> GroveImpl::setAppinfo
                ; (only for a LITERAL appinfo — under APPINFO NONE the parser
                ; emits no event at all, which is the accessNull case).
                let d ev.get_data()
                let inf st.info
                set inf.appinfo: StringC^host(d.data_ptr(), d.get_size())
            }
            set i: i + 1
        }
    }

    function finish(st: ref[GroveBuildState]) returns ref[GroveNode]
    {
        GroveBuilder.close_token(st)
        GroveBuilder.flush_pending(st)
        st.root
    }

    function build(host: ref[Page], ps: ref[ParserState]) returns ref[GroveNode]
    {
        let st GroveBuilder.begin(host, 0)
        GroveBuilder.feed(st, ps)
        ; bind — returning the call directly trips the silent-stub trap
        let root GroveBuilder.finish(st)
        return root
    }

    ; build_id_index: walk the grove and collect (id-value -> element node) for
    ; every element carrying an ID-typed attribute (declared TYPE ID in the DTD;
    ; opensp flags it via AttributeList.id(i)). Backs element-with-id. Linear
    ; Array, matching the interpreter's NamedTable shape; lookup is by StringC
    ; value equality (opensp already normalizes ID/IDREF tokens consistently).
    ; ElementChunk::mustOmitEndTag (spgrove/GroveBuilder.cxx:3155) plus the
    ; att-bearing override (:3131): the declared content is EMPTY, or some
    ; CONREF attribute is specified WITH a value.
    function must_omit_end_tag(et: ref[ElementType]?, atts: ref[AttributeList]?) returns bool
    {
        if et <> null
        {
            let def et.get_definition()
            if def <> null
            {
                if def.get_declared_content() = GDC_EMPTY
                    return true
            }
        }
        if atts = null
            return false
        let sz atts.size()
        var i: size_t 0
        while i < sz
        {
            let d atts.definition(i)
            if d <> null
            {
                if d.is_conref()
                {
                    let v atts.value(i)
                    if v <> null
                    {
                        let t v.get_text()
                        if t <> null
                            return true
                    }
                }
            }
            set i: i + 1
        }
        false
    }

    function build_id_index(host: ref[Page], root: ref[GroveNode]) returns ref[Array[ref[IdEntry]?]]
    {
        let index Array[ref[IdEntry]?]^host()
        GroveBuilder.collect_ids(host, root, index)
        index
    }

    ; NamedNodeList::namedNode over the sgml-document `elements` list, folded
    ; through the instance syntax's general subst table — the same normalize
    ; step Primitive.nnl_normalize does for NNL_ELEMENTS. It lives here, not on
    ; the Interpreter, because HtmlFOTBuilder's idref link arm needs it and is
    ; declared long before the Interpreter module.
    ;
    ; ★The grove is the QUERIED NODE's, not the run's: `element-with-id` spells
    ; it `node->getGroveRoot(node) && node->getElements(elements)`, so with a
    ; second grove loaded the same id can name two different elements.
    function element_by_id(host: ref[Page], node: ref[GroveNode], id: StringC) returns ref[GroveNode]?
    {
        let index GroveInfo.id_index_of(node)
        let tab GroveInfo.subst_of(node)
        let tbl GroveInfo.id_table_of(node)
        GroveBuilder.lookup_element_by_id(host, index, tab, id, tbl)
    }

    ; the hashed companion of the id index: same keys (the entries' own arena
    ; StringC buffers), same winner on a duplicate id — PointerTable::insert
    ; defaults to replace=false and returns the EXISTING entry, so the FIRST
    ; occurrence in document order wins there exactly as it did in the scan.
    function build_id_table(host: ref[Page], index: ref[Array[ref[IdEntry]?]]?) returns ref[NameTable]?
    {
        if index = null
            return null
        let n index.get_length()
        let t NameTable.make(host, n * 2)
        let b index.get_buffer()
        var i: size_t 0
        while i < n
        {
            let e *(b + i)
            let key e.id
            if t.lookup(key) = null
                t.insert(host, key, e.node as pointer[void])
            set i: i + 1
        }
        t
    }

    function lookup_element_by_id(host: ref[Page], index: ref[Array[ref[IdEntry]?]]?, tab: pointer[u32], id: StringC, tbl: ref[NameTable]?) returns ref[GroveNode]?
    {
        if index = null
            return null
        let n id.get_size()
        ; the folded query lives on `host` — a StringC built as a STACK value
        ; would allocate its buffer through Page.get(<stack address>).
        var qp StringC^host(id.data_ptr(), n)
        if tab <> null
        {
            if n > 0
            {
                let buf host.allocate(n * (sizeof u32), alignof u32) as pointer[u32]
                var i: size_t 0
                while i < n
                {
                    let c id.get(i)
                    var f c
                    if c < 256
                        set f: *(tab + (c as size_t))
                    set *(buf + i): f
                    set i: i + 1
                }
                set qp: StringC^host(buf, n)
            }
        }
        let q *qp
        ; hashed path (the reference's idTable_.lookup). A stored node is never
        ; null, so a null value means "no such id".
        if tbl <> null
        {
            let v tbl.lookup(q)
            if v = null
                return null
            return v as ref[GroveNode]
        }
        let cnt index.get_length()
        let ib index.get_buffer()
        var k: size_t 0
        while k < cnt
        {
            let e *(ib + k)
            if e.id.equals(q)
                return e.node
            set k: k + 1
        }
        null
    }

    function collect_ids(host: ref[Page], node: ref[GroveNode], index: ref[Array[ref[IdEntry]?]])
    {
        if node.node_class = GN_ELEMENT
        {
            let atts node.attributes
            if atts <> null
            {
                let sz atts.size()
                var i: size_t 0
                while i < sz
                {
                    if atts.id(i)
                    {
                        let v atts.value(i)
                        if v <> null
                        {
                            let t v.get_text()
                            if t <> null
                            {
                                let e host.allocate(sizeof IdEntry, alignof IdEntry) as pointer[IdEntry]
                                let s t.string()
                                set e.id: StringC^host(s.data_ptr(), s.get_size())
                                set e.node: node
                                index.add(e)
                            }
                        }
                    }
                    set i: i + 1
                }
            }
        }
        let ch node.children
        if ch <> null
        {
            let cn ch.get_length()
            let cb ch.get_buffer()
            var j: size_t 0
            while j < cn
            {
                GroveBuilder.collect_ids(host, *(cb + j), index)
                set j: j + 1
            }
        }
    }

    ; A small hand-built grove for the node-list unit test:
    ;   document > para > ["Hello", emph > "world"]
    function build_test_grove(host: ref[Page]) returns ref[GroveNode]
    {
        let doc GroveNode.make(host, GN_DOCUMENT)
        let para GroveNode.make(host, GN_ELEMENT)
        set para.gi: StringC^host("para")
        set para.parent: doc
        doc.add_child(para)
        let d1 GroveNode.make(host, GN_DATA)
        set d1.chars: StringC^host("Hello")
        set d1.parent: para
        para.add_child(d1)
        let emph GroveNode.make(host, GN_ELEMENT)
        set emph.gi: StringC^host("emph")
        set emph.parent: para
        para.add_child(emph)
        let d2 GroveNode.make(host, GN_DATA)
        set d2.chars: StringC^host("world")
        set d2.parent: emph
        emph.add_child(d2)
        doc
    }
}
