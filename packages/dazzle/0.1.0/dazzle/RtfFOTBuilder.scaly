        this.end_reorder_flow_object_port()

    ; grid: every cell is captured into the matrix and the whole EQ \a array is
    ; written at endGrid.
    function grid_top(this: ref[RtfFOTBuilder]) returns ref[RtfGrid]
    {
        let gp this.grid_stack.get((this.grid_depth - 1) as size_t)
        *gp as ref[RtfGrid]
    }

    procedure start_grid(mutable this: ref[RtfFOTBuilder], nic: ref[GridNIC])
    {
        this.fo_start()
        this.inline_prepare()
        this.enter_math_mode()
        let host this.host
        let g RtfGrid.make(host)
        RtfFOTBuilder.copy_output_fmt(&g.save_out_fmt, &this.out_fmt)
        g.pos_type := this.spec.grid_pos_type
        if nic.n_columns <> 0
            g.n_columns := nic.n_columns
        if nic.n_rows <> 0
            g.n_rows := nic.n_rows
        let d this.grid_depth as size_t
        if d < this.grid_stack.get_length()
            this.grid_stack.put(d, g)
        else
            this.grid_stack.add(g)
        this.grid_depth := this.grid_depth + 1
        this.redirect_push()
    }

    procedure end_grid(mutable this: ref[RtfFOTBuilder])
    {
        let g this.grid_top()
        this.redirect_pop()
        this.grid_depth := this.grid_depth - 1
        let n_rows_used g.cells.get_length() as int
        var i 0
        while i < n_rows_used
        {
            let rp g.cells.get(i as size_t)
            let erow *rp
            let w erow.get_length() as int
            if w > g.n_columns
                g.n_columns := w
            i := i + 1
        }
        if n_rows_used > g.n_rows
            g.n_rows := n_rows_used
        this.raw("\\\\a\\\\hs")
        this.raw_int(this.spec.grid_column_sep)
        this.raw("\\\\vs")
        this.raw_int(this.spec.grid_row_sep)
        this.raw("\\\\a")
        this.put_c(this.spec.grid_column_alignment)
        this.raw("\\\\co")
        this.raw_int(g.n_columns)
        this.put_c(0x28)
        i := 0
        while i < n_rows_used
        {
            let rp2 g.cells.get(i as size_t)
            let row *rp2
            let w2 row.get_length() as int
            var j 0
            while j < w2
            {
                if (i <> 0) or (j <> 0)
                    this.put_c(this.eq_arg_sep)
                let cp row.get(j as size_t)
                this.raw_buf((*cp) as ref[Array[u8]])
                j := j + 1
            }
            ; ★an EMPTY row still consumes one separator slot (`if (!j) j++`)
            if j = 0
                j := 1
            while j < g.n_columns
            {
                this.put_c(this.eq_arg_sep)
                j := j + 1
            }
            i := i + 1
        }
        this.put_c(0x29)
        this.fo_end()
        this.exit_math_mode()
    }

    procedure start_grid_cell(mutable this: ref[RtfFOTBuilder], nic: ref[GridCellNIC])
    {
        if this.grid_depth > 0
        {
            this.put_c(0x7B)
            let g this.grid_top()
            g.cur_row := 0 - 1
            g.cur_col := 0 - 1
            var cn 0
            var rn 0
            cn := nic.column_number
            rn := nic.row_number
            if g.pos_type = RTF_GRIDPOS_EXPLICIT
            {
                if (rn > 0) and (cn > 0)
                {
                    ; ★the outer index is the COLUMN here — the reference's own
                    ; asymmetry, kept.
                    g.grow_rows(cn)
                    g.grow_row(cn - 1, rn)
                    g.cur_row := cn - 1
                    g.cur_col := rn - 1
                }
            }
            else if g.pos_type = RTF_GRIDPOS_ROW_MAJOR
            {
                var need_row false
                if g.cells.get_length() = 0
                    need_row := true
                else
                {
                    let lp g.cells.get(g.cells.get_length() - 1)
                    let lrow *lp
                    if (lrow.get_length() as int) >= g.n_columns
                        need_row := true
                }
                if need_row
                    g.grow_rows((g.cells.get_length() as int) + 1)
                let li (g.cells.get_length() as int) - 1
                let lp2 g.cells.get(li as size_t)
                let lrow2 *lp2
                g.grow_row(li, (lrow2.get_length() as int) + 1)
                g.cur_row := li
                g.cur_col := (lrow2.get_length() as int) - 1
            }
            else
            {
                ; column-major: cells[0] is the leading column; a new cell goes
                ; into the first row that is shorter than it.
                if (g.cells.get_length() as int) < g.n_rows
                    g.grow_rows(g.n_rows)
                let p0 g.cells.get(0)
                let row0 *p0
                let pl g.cells.get((g.n_rows - 1) as size_t)
                let rowl *pl
                if rowl.get_length() = row0.get_length()
                {
                    g.grow_row(0, (row0.get_length() as int) + 1)
                    g.cur_row := 0
                    g.cur_col := (row0.get_length() as int) - 1
                }
                else
                {
                    var k 1
                    while k < (g.cells.get_length() as int)
                    {
                        let pk g.cells.get(k as size_t)
                        let rowk *pk
                        if rowk.get_length() < row0.get_length()
                        {
                            g.grow_row(k, (rowk.get_length() as int) + 1)
                            g.cur_row := k
                            g.cur_col := (rowk.get_length() as int) - 1
                            break
                        }
                        k := k + 1
                    }
                }
            }
        }
        this.fo_start()
    }

    ; ★there is no per-cell buffer: a cell accumulates into the GRID's single
    ; buffer, and endGridCell extracts (and empties) the whole buffer into the
    ; addressed cell — a cell with no address discards it. The `{`…`}` braces
    ; are part of the captured content.
    procedure end_grid_cell(mutable this: ref[RtfFOTBuilder])
    {
        if this.grid_depth > 0
        {
            let g this.grid_top()
            this.put_c(0x7D)
            let captured this.redirect_top()
            let host this.host
            this.redirect.put((this.redirect_depth - 1) as size_t, Array[u8]^host())
            if (g.cur_row >= 0) and (g.cur_col >= 0)
            {
                let rp g.cells.get(g.cur_row as size_t)
                let crow *rp
                crow.put(g.cur_col as size_t, captured)
            }
            RtfFOTBuilder.copy_output_fmt(&this.out_fmt, &g.save_out_fmt)
        }
        this.fo_end()
    }

    ; --- the LAYOUT-COMPOSITE family --------------------------------------------
    ; The RTF backend overrides none of the five, so the plain FOTBuilder
    ; brackets apply: every start*/end* pair is start()/end().
    procedure start_embedded_text(mutable this: ref[RtfFOTBuilder], nic: ref[EmbeddedTextNIC])
        this.fo_start()

    procedure end_embedded_text(mutable this: ref[RtfFOTBuilder])
        this.fo_end()

    procedure start_included_container_area(mutable this: ref[RtfFOTBuilder], nic: ref[IncludedContainerAreaNIC], dnic: ref[DisplayNIC]?)
        this.fo_start()

    procedure end_included_container_area(mutable this: ref[RtfFOTBuilder])
        this.fo_end()

    procedure start_side_by_side(mutable this: ref[RtfFOTBuilder], dnic: ref[DisplayNIC]?)
        this.fo_start()

    procedure end_side_by_side(mutable this: ref[RtfFOTBuilder])
        this.fo_end()

    procedure start_side_by_side_item(mutable this: ref[RtfFOTBuilder])
        this.fo_start()

    procedure end_side_by_side_item(mutable this: ref[RtfFOTBuilder])
        this.fo_end()

    procedure start_aligned_column(mutable this: ref[RtfFOTBuilder], dnic: ref[DisplayNIC]?)
        this.fo_start()

    procedure end_aligned_column(mutable this: ref[RtfFOTBuilder])
        this.fo_end()


    ; --- the ONLINE family ------------------------------------------------------
    ; The RTF backend overrides neither class, so the base brackets apply:
    ; marginalia and the multi-mode SERIAL pair are start()/end(); the per-mode
    ; bracket is empty (its content still flows through).
    procedure start_marginalia(mutable this: ref[RtfFOTBuilder])
        this.fo_start()

    procedure end_marginalia(mutable this: ref[RtfFOTBuilder])
        this.fo_end()

    procedure start_multi_mode_serial(mutable this: ref[RtfFOTBuilder], mode: ref[MultiModeRec]?)
        this.fo_start()

    procedure end_multi_mode_serial(mutable this: ref[RtfFOTBuilder])
        this.fo_end()

    function start_multi_mode_mode(this: ref[RtfFOTBuilder], mode: ref[MultiModeRec]?)
    {
    }

    function end_multi_mode_mode(this: ref[RtfFOTBuilder])
    {
    }

    ; --- the PAGE/COLUMN MODEL ----------------------------------------------------
    ; Not overridden here either, so both are the plain start()/end() brackets.
    procedure start_page_sequence(mutable this: ref[RtfFOTBuilder])
        this.fo_start()

    procedure end_page_sequence(mutable this: ref[RtfFOTBuilder])
        this.fo_end()

    procedure start_column_set_sequence(mutable this: ref[RtfFOTBuilder], dnic: ref[DisplayNIC]?)
        this.fo_start()

    procedure end_column_set_sequence(mutable this: ref[RtfFOTBuilder])
        this.fo_end()

}
