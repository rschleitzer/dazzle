; --- format records (CommonFormat/ParaFormat/Format flattened; OutputFormat;
; PageFormat; DisplayInfo) ---------------------------------------------------

; what the RTF reader thinks the format is (OutputFormat : CommonFormat)
define RtfOutputFmt
(
    is_bold: bool
    is_italic: bool
    is_small_caps: bool
    underline: int
    is_strikethrough: bool
    font_family: int
    font_size: int
    color: int
    char_background_color: int
    position_point_shift: int
    language: int
    country: int
    kern: bool
    char_border: bool
    char_border_color: int
    char_border_thickness: int
    char_border_double: bool
    charset: int
    lang: int
    lang_charsets: int
)

; the specified format (Format : ParaFormat, CommonFormat — flattened)
define RtfFormat
(
    ; CommonFormat
    is_bold: bool
    is_italic: bool
    is_small_caps: bool
    underline: int
    is_strikethrough: bool
    font_family: int
    font_size: int
    color: int
    char_background_color: int
    position_point_shift: int
    language: int
    country: int
    kern: bool
    char_border: bool
    char_border_color: int
    char_border_thickness: int
    char_border_double: bool
    ; ParaFormat
    left_indent: int
    right_indent: int
    first_line_indent: int
    line_spacing: int
    line_spacing_at_least: bool
    quadding: int
    lines: int
    widow_orphan_control: int
    heading_level: int
    ; Format
    hyphenate: bool
    field_width: int
    field_align: int
    input_whitespace_treatment: int
    expand_tabs: int
    display_alignment: int
    line_thickness: int
    line_double: bool
    score_spaces: bool
    box_has_border: bool
    box_has_background: bool
    background_color: int
    border_present: bool
    border_omit_at_break: bool
    cell_background: bool
    border_priority: int
    cell_top_margin: int
    cell_bottom_margin: int
    cell_left_margin: int
    cell_right_margin: int
    cell_vertical_alignment: int
    math_posture: bool
    math_inline: bool
    grid_pos_type: int
    grid_column_alignment: int
    superscript_height: int
    subscript_depth: int
    over_mark_height: int
    under_mark_depth: int
    grid_row_sep: int
    grid_column_sep: int
    span: bool
    pps_spec: LengthSpec
    li_spec: LengthSpec
    ri_spec: LengthSpec
    fli_spec: LengthSpec
    ls_spec: LengthSpec
    fw_spec: LengthSpec
)

; the paragraph format in force (ParaFormat)
define RtfParaFmt
(
    left_indent: int
    right_indent: int
    first_line_indent: int
    line_spacing: int
    line_spacing_at_least: bool
    quadding: int
    lines: int
    widow_orphan_control: int
    heading_level: int
)

define RtfPageFmt
(
    page_width: int
    page_height: int
    left_margin: int
    right_margin: int
    header_margin: int
    footer_margin: int
    top_margin: int
    bottom_margin: int
    page_number_restart: bool
    page_number_format: int
    n_columns: int
    column_sep: int
    balance: bool
)

define RtfDisplayInfo
(
    space_after: int
    keep_with_next: bool
    save_keep: bool
    break_after: int
)

define RtfBorder
(
    priority: int
    flags: int
    thickness: int
    color: int
)
{
    function make(host: ref[Page]) returns ref[RtfBorder]
    {
        let b host.allocate(sizeof RtfBorder, alignof RtfBorder) as pointer[RtfBorder]
        set b.priority: 0
        set b.flags: 0
        set b.thickness: 0
        set b.color: 0
        b
    }
}

define RtfCell
(
    present: bool
    has_background: bool
    background_color: int
    valign: int
    span: int
    vspan: int
    content: ref[Array[u8]]?
    ; the four borders (top/bottom/left/right) as heap records — nested
    ; by-value border structs proved unreliable through address-of returns
    borders: ref[Array[ref[RtfBorder]?]]
)
{
    function make(host: ref[Page]) returns ref[RtfCell]
    {
        let c host.allocate(sizeof RtfCell, alignof RtfCell) as pointer[RtfCell]
        set c.present: false
        set c.has_background: false
        set c.background_color: 0
        set c.valign: 0x74
        set c.span: 1
        set c.vspan: 1
        set c.content: null
        let bs Array[ref[RtfBorder]?]^host()
        var k 0
        while k < 4
        {
            bs.add(RtfBorder.make(host))
            set k: k + 1
        }
        set c.borders: bs
        c
    }

    function border_at(this: ref[RtfCell], k: int) returns ref[RtfBorder]?
    {
        let p this.borders.get(k as size_t)
        if p = null
            return null
        *p
    }

    ; whole-cell copy (the reference Cell assignment in the row-resize fill)
    function assign_from(this: ref[RtfCell], src: ref[RtfCell])
    {
        set this.present: src.present
        set this.has_background: src.has_background
        set this.background_color: src.background_color
        set this.valign: src.valign
        set this.span: src.span
        set this.vspan: src.vspan
        set this.content: src.content
        var k 0
        while k < 4
        {
            let dp this.borders.get(k as size_t)
            let sp src.borders.get(k as size_t)
            if dp <> null
            {
                if sp <> null
                {
                    let d *dp
                    let s *sp
                    set d.priority: s.priority
                    set d.flags: s.flags
                    set d.thickness: s.thickness
                    set d.color: s.color
                }
            }
            set k: k + 1
        }
    }
}

define RtfColumn
(
    has_width: bool
    width: LengthSpec
    tfactor: double
)
{
    function make(host: ref[Page]) returns ref[RtfColumn]
    {
        let c host.allocate(sizeof RtfColumn, alignof RtfColumn) as pointer[RtfColumn]
        set c.has_width: false
        set c.width: LengthSpec()
        set c.tfactor: 0.0
        c
    }
}

; a fontFamilyNameTable_ item (OpenSP HashTable<StringC,int> entry)
define RtfFontEntry (key: StringC, value: int)
{
    function make(host: ref[Page], key: StringC, value: int) returns ref[RtfFontEntry]
    {
        let e host.allocate(sizeof RtfFontEntry, alignof RtfFontEntry) as pointer[RtfFontEntry]
        set e.key: StringC^host(key.data_ptr(), key.get_size())
        set e.value: value
        e
    }
}

; a fontFamilyCharsetsTable_ row: the rtf font number per charset (-1 unset)
define RtfFontCharsets
(
    n0: int
    n1: int
    n2: int
    n3: int
    n4: int
    n5: int
    n6: int
)
{
    function make(host: ref[Page]) returns ref[RtfFontCharsets]
    {
        let f host.allocate(sizeof RtfFontCharsets, alignof RtfFontCharsets) as pointer[RtfFontCharsets]
        set f.n0: 0 - 1
        set f.n1: 0 - 1
        set f.n2: 0 - 1
        set f.n3: 0 - 1
        set f.n4: 0 - 1
        set f.n5: 0 - 1
        set f.n6: 0 - 1
        f
    }

    function get_at(this: ref[RtfFontCharsets], i: int) returns int
    {
        if i = 0
            return this.n0
        if i = 1
            return this.n1
        if i = 2
            return this.n2
        if i = 3
            return this.n3
        if i = 4
            return this.n4
        if i = 5
            return this.n5
        this.n6
    }

    function set_at(this: ref[RtfFontCharsets], i: int, v: int)
    {
        if i = 0
        {
            set this.n0: v
            return
        }
        if i = 1
        {
            set this.n1: v
            return
        }
        if i = 2
        {
            set this.n2: v
            return
        }
        if i = 3
        {
            set this.n3: v
            return
        }
        if i = 4
        {
            set this.n4: v
            return
        }
        if i = 5
        {
            set this.n5: v
            return
        }
        set this.n6: v
    }
}

; RtfFOTBuilder::ReorderFlowObject (jade/RtfFOTBuilder.cxx:543) — the capture
; record of a math class whose ports are written to the RTF stream in a
; DIFFERENT order than they arrive (fraction is not one of these; radical,
; fence, math-operator, mark and script are). `streams` collects one captured
; buffer per port bracket, each still wrapped in its `{`…`}`, so the reference's
; `size() > 2` emptiness test carries over unchanged.
define RtfReorder
(
    streams: ref[Array[ref[Array[u8]]?]]
    save_out_fmt: RtfOutputFmt
)
{
    function make(host: ref[Page]) returns ref[RtfReorder]
    {
        let r host.allocate(sizeof RtfReorder, alignof RtfReorder) as pointer[RtfReorder]
        set r.streams: Array[ref[Array[u8]]?]^host()
        set r.save_out_fmt: RtfOutputFmt()
        RtfFOTBuilder.output_fmt_defaults(&r.save_out_fmt)
        r
    }
}

; RtfFOTBuilder::Grid (jade/RtfFOTBuilder.cxx:551) — the cell matrix of a
; `grid`. ★`cells` is indexed [i][j] and the three positioning modes disagree
; about which index is the row: explicit writes cells[column-1][row-1] while
; row-major appends to cells.back() as a ROW. Reproduced as measured.
; cur_row/cur_col address the cell being captured (-1 = none, the reference's
; null curCellPtr).
define RtfGrid
(
    cells: ref[Array[ref[Array[ref[Array[u8]]?]]?]]?
    n_columns: int
    n_rows: int
    pos_type: int
    cur_row: int
    cur_col: int
    save_out_fmt: RtfOutputFmt
    host: pointer[Page]
)
{
    function make(host: ref[Page]) returns ref[RtfGrid]
    {
        let g host.allocate(sizeof RtfGrid, alignof RtfGrid) as pointer[RtfGrid]
        set g.cells: Array[ref[Array[ref[Array[u8]]?]]?]^host()
        set g.n_columns: 1
        set g.n_rows: 1
        set g.pos_type: RTF_GRIDPOS_ROW_MAJOR
        set g.cur_row: 0 - 1
        set g.cur_col: 0 - 1
        set g.save_out_fmt: RtfOutputFmt()
        RtfFOTBuilder.output_fmt_defaults(&g.save_out_fmt)
        set g.host: host
        g
    }

    ; Vector<Vector<String> >::resize — grow the outer vector to `n` rows,
    ; each new row an empty vector.
    function grow_rows(this: ref[RtfGrid], n: int)
    {
        let h this.host
        while (this.cells.get_length() as int) < n
            this.cells.add(Array[ref[Array[u8]]?]^h())
    }

    function grow_row(this: ref[RtfGrid], i: int, n: int)
    {
        let h this.host
        let rp this.cells.get(i as size_t)
        let row *rp
        while (row.get_length() as int) < n
            row.add(Array[u8]^h())
    }
}

; --- the builder ------------------------------------------------------------
define RtfFOTBuilder
(
    ; output streams: the body temp buffer, header/footer, line-field and
    ; table-cell captures; cur_stream selects (the reference osp_ pointer),
    ; discard models the leader null stream.
    out: ref[Array[u8]]
    hfos: ref[Array[u8]]
    fieldos: ref[Array[u8]]
    cellos: ref[Array[u8]]
    cur_stream: int
    discard: bool
    ; inline/paragraph state
    inline_state: int
    continue_par: bool
    ; formats
    out_fmt: RtfOutputFmt
    save_out_fmt: RtfOutputFmt
    leader_save_out_fmt: RtfOutputFmt
    spec: RtfFormat
    para: RtfParaFmt
    page: RtfPageFmt
    ; stacks (slot-reused pointer arrays with depth cursors)
    spec_stack: ref[Array[ref[RtfFormat]?]]
    spec_depth: int
    para_stack: ref[Array[ref[RtfParaFmt]?]]
    para_depth: int
    page_stack: ref[Array[ref[RtfPageFmt]?]]
    page_depth: int
    display_stack: ref[Array[ref[RtfDisplayInfo]?]]
    display_depth: int
    display_box_levels: ref[Array[int]]
    dbl_len: int
    box_first_para: bool
    box_left_sep: int
    box_right_sep: int
    box_top_sep: int
    accum_space_box: int
    ; pending element bookmarks
    pending_elements: ref[Array[ref[GroveNode]?]]
    pending_levels: ref[Array[int]]
    pending_len: int
    n_pending_non_empty: int
    suppress_bookmarks: bool
    node_level: int
    ; fonts: the OpenSP HashTable<StringC,int> (open addressing, decrementing
    ; probe, slot-order iteration) + the per-family charset font numbers
    font_slots: ref[Array[ref[RtfFontEntry]?]]
    font_used: int
    font_used_limit: int
    ffcs: ref[Array[ref[RtfFontCharsets]?]]
    next_font_number: int
    ; spacing/keeps/breaks
    accum_space: int
    keep_with_next: bool
    hyphenate_suppressed: bool
    max_consec_hyphens: int
    do_break: int
    keep: bool
    had_par_in_keep: bool
    ; tables
    table_level: int
    table_width: int
    table_alignment: int
    table_display_size: int
    table_left_indent: int
    table_right_indent: int
    add_left_indent: int
    add_right_indent: int
    tborders: ref[Array[ref[RtfBorder]?]]
    cell_index: int
    rows: ref[Array[ref[Array[ref[RtfCell]?]]?]]
    in_table_header: bool
    n_header_rows: int
    columns: ref[Array[ref[RtfColumn]?]]?
    ; line fields
    field_tab_pos: int
    ; sections/pages
    display_size: int
    had_section: bool
    do_balance: bool
    span_display_levels: int
    current_cols: int
    in_simple_page_sequence: int
    hf_parts: ref[Array[ref[Array[u8]]?]]
    ; links
    link_depth: int
    pending_link: ref[LinkNICRec]?
    have_pending_link: bool
    ; colors
    color_table: ref[Array[int]]
    ; character state
    follow_whitespace_char: bool
    current_column: int
    char_table: ref[Array[u32]]
    ; element reference set (grove 0 only in practice; grove-indexed rows)
    elements_refed: ref[Array[ref[Array[bool]]?]]
    ; leaders
    leader_depth: int
    pre_leader_stream: int
    pre_leader_discard: bool
    rtf_version: int
    ; --- math (jade/RtfFOTBuilder.cxx) ---------------------------------------
    ; mathLevel_ counts nested math brackets (the RTF EQ field is opened once,
    ; at level 0→1); mathSpecial_ switches the escaping of `,`/`(`/`)`/`\` in
    ; characters(); eqArgSep_ is the field's argument separator. The reorder
    ; and grid stacks are the two output REDIRECTS the math classes use — both
    ; ride the shared `redirect` buffer stack so they nest correctly (the
    ; reference saves and restores its raw `osp_` pointer for the same reason).
    math_level: int
    math_special: int
    eq_arg_sep: int
    math_save_out_fmt: RtfOutputFmt
    redirect: ref[Array[ref[Array[u8]]?]]
    redirect_depth: int
    reorder_stack: ref[Array[ref[RtfReorder]?]]
    reorder_depth: int
    grid_stack: ref[Array[ref[RtfGrid]?]]
    grid_depth: int
    interp: ref[Interpreter]
    host: pointer[Page]
)
{
    function make(host: ref[Page], interp: ref[Interpreter]) returns ref[RtfFOTBuilder]
    {
        let f host.allocate(sizeof RtfFOTBuilder, alignof RtfFOTBuilder) as pointer[RtfFOTBuilder]
        set f.out: Array[u8]^host()
        set f.hfos: Array[u8]^host()
        set f.fieldos: Array[u8]^host()
        set f.cellos: Array[u8]^host()
        set f.cur_stream: RTF_ST_MAIN
        set f.discard: false
        set f.inline_state: RTF_INLINE_FIRST
        set f.continue_par: false
        set f.out_fmt: RtfOutputFmt()
        RtfFOTBuilder.output_fmt_defaults(&f.out_fmt)
        set f.save_out_fmt: RtfOutputFmt()
        RtfFOTBuilder.output_fmt_defaults(&f.save_out_fmt)
        set f.leader_save_out_fmt: RtfOutputFmt()
        RtfFOTBuilder.output_fmt_defaults(&f.leader_save_out_fmt)
        set f.math_level: 0
        set f.math_special: RTF_MATH_NORMAL
        set f.eq_arg_sep: 0x2C
        set f.math_save_out_fmt: RtfOutputFmt()
        RtfFOTBuilder.output_fmt_defaults(&f.math_save_out_fmt)
        set f.redirect: Array[ref[Array[u8]]?]^host()
        set f.redirect_depth: 0
        set f.reorder_stack: Array[ref[RtfReorder]?]^host()
        set f.reorder_depth: 0
        set f.grid_stack: Array[ref[RtfGrid]?]^host()
        set f.grid_depth: 0
        set f.spec: RtfFormat()
        RtfFOTBuilder.format_defaults(&f.spec)
        set f.para: RtfParaFmt()
        RtfFOTBuilder.para_defaults(&f.para)
        set f.page: RtfPageFmt()
        RtfFOTBuilder.page_defaults(&f.page)
        set f.spec_stack: Array[ref[RtfFormat]?]^host()
        set f.spec_depth: 0
        set f.para_stack: Array[ref[RtfParaFmt]?]^host()
        set f.para_depth: 0
        set f.page_stack: Array[ref[RtfPageFmt]?]^host()
        set f.page_depth: 0
        set f.display_stack: Array[ref[RtfDisplayInfo]?]^host()
        set f.display_depth: 0
        set f.display_box_levels: Array[int]^host()
        set f.dbl_len: 0
        set f.box_first_para: false
        set f.box_left_sep: 0
        set f.box_right_sep: 0
        set f.box_top_sep: 0
        set f.accum_space_box: 0
        set f.pending_elements: Array[ref[GroveNode]?]^host()
        set f.pending_levels: Array[int]^host()
        set f.pending_len: 0
        set f.n_pending_non_empty: 0
        set f.suppress_bookmarks: false
        set f.node_level: 0
        set f.font_slots: Array[ref[RtfFontEntry]?]^host()
        set f.font_used: 0
        set f.font_used_limit: 0
        set f.ffcs: Array[ref[RtfFontCharsets]?]^host()
        set f.next_font_number: 1
        set f.accum_space: 0
        set f.keep_with_next: false
        set f.hyphenate_suppressed: false
        set f.max_consec_hyphens: 0
        set f.do_break: RTF_BREAK_NONE
        set f.keep: false
        set f.had_par_in_keep: false
        set f.table_level: 0
        set f.table_width: 0
        set f.table_alignment: 0x6C
        set f.table_display_size: 0
        set f.table_left_indent: 0
        set f.table_right_indent: 0
        set f.add_left_indent: 0
        set f.add_right_indent: 0
        let tbs Array[ref[RtfBorder]?]^host()
        var tbk 0
        while tbk < 4
        {
            tbs.add(RtfBorder.make(host))
            set tbk: tbk + 1
        }
        set f.tborders: tbs
        set f.cell_index: 0
        set f.rows: Array[ref[Array[ref[RtfCell]?]]?]^host()
        set f.in_table_header: false
        set f.n_header_rows: 0
        set f.columns: Array[ref[RtfColumn]?]^host()
        set f.field_tab_pos: 0
        set f.display_size: 72 * 10 * 17
        set f.had_section: false
        set f.do_balance: false
        set f.span_display_levels: 0
        set f.current_cols: 1
        set f.in_simple_page_sequence: 0
        let hf Array[ref[Array[u8]]?]^host()
        var k 0
        while k < 24
        {
            hf.add(Array[u8]^host())
            set k: k + 1
        }
        set f.hf_parts: hf
        set f.link_depth: 0
        set f.pending_link: null
        set f.have_pending_link: false
        set f.color_table: Array[int]^host()
        set f.follow_whitespace_char: false
        set f.current_column: 0
        set f.elements_refed: Array[ref[Array[bool]]?]^host()
        set f.leader_depth: 0
        set f.pre_leader_stream: RTF_ST_MAIN
        set f.pre_leader_discard: false
        set f.rtf_version: 1
        set f.interp: interp
        set f.host: host
        ; ctor body: fontSize 20 half-points (10pt), the initial stack levels,
        ; "Times New Roman" as family 0, the char table from the charset and
        ; symbol-font mappings.
        set f.spec.font_size: 20
        f.push_spec()
        f.push_page()
        ; fontFamilyCharsetsTable_(1 + nSymbolFonts) = 4 zero rows; row 0
        ; charset 0 = font number 0.
        var r 0
        while r < 4
        {
            let row RtfFontCharsets.make(host)
            f.ffcs.add(row)
            set r: r + 1
        }
        var row0p f.ffcs.get(0)
        if row0p <> null
        {
            let row0 *row0p
            row0.set_at(0, 0)
        }
        f.font_insert(StringC("Times New Roman"), 0)
        ; charTable_: BMP-sized (chars beyond 0xFFFF stay 0 -> \uN fallback,
        ; the reference CharMap default)
        let ct Array[u32]^host()
        var ci 0
        while ci < 0x10000
        {
            ct.add(0)
            set ci: ci + 1
        }
        set f.char_table: ct
        var i 0
        while i < RTF_N_WIN_CHARSETS
        {
            var j 0
            while j < 128
            {
                let c *(RTF_WIN_CHARSET_MAP + ((i * 128) + j))
                if c <> 0
                {
                    let cur f.ct_get(c)
                    if cur = 0
                        f.ct_set(c, ((j + 0x80) | (1 << (i + RTF_CHAR_BITS))) as u32)
                    else
                    {
                        if (cur & (((1 << RTF_CHAR_BITS) - 1) as u32)) = ((j + 0x80) as u32)
                            f.ct_set(c, cur | ((1 << (i + RTF_CHAR_BITS)) as u32))
                    }
                }
                set j: j + 1
            }
            set i: i + 1
        }
        var sf 0
        while sf < RTF_N_SYMBOL_FONTS
        {
            var j2 0
            while j2 < 256
            {
                let c2 *(RTF_SYMBOL_FONT_MAP + ((sf * 256) + j2))
                if c2 <> 0
                {
                    if f.ct_get(c2) = 0
                        f.ct_set(c2, (j2 | (sf << RTF_CHAR_BITS) | RTF_SYMBOL_FLAG) as u32)
                }
                set j2: j2 + 1
            }
            ; the literal StringC stays frame-local; font_insert pins its copy
            if sf = 0
                f.font_insert(StringC("Symbol"), 1)
            else if sf = 1
                f.font_insert(StringC("Wingdings"), 2)
            else
                f.font_insert(StringC("ZapfDingbats"), 3)
            set sf: sf + 1
        }
        ; initJIS deferred (design note): JIS0208 rows affect only CJK
        ; codepoints; none of the corpus documents contain any.
        f
    }

    ; --- format defaults (the reference default constructors) ---------------
    function output_fmt_defaults(o: ref[RtfOutputFmt])
    {
        set o.is_bold: false
        set o.is_italic: false
        set o.is_small_caps: false
        set o.underline: RTF_UL_NONE
        set o.is_strikethrough: false
        set o.font_family: 0
        set o.font_size: 24
        set o.color: 0
        set o.char_background_color: 0
        set o.position_point_shift: 0
        set o.language: 0
        set o.country: 0
        set o.kern: false
        set o.char_border: false
        set o.char_border_color: 0
        set o.char_border_thickness: 0
        set o.char_border_double: false
        set o.charset: 0
        set o.lang: RTF_DEFAULT_LANG
        set o.lang_charsets: 0x1f
    }

    function format_defaults(s: ref[RtfFormat])
    {
        set s.is_bold: false
        set s.is_italic: false
        set s.is_small_caps: false
        set s.underline: RTF_UL_NONE
        set s.is_strikethrough: false
        set s.font_family: 0
        set s.font_size: 24
        set s.color: 0
        set s.char_background_color: 0
        set s.position_point_shift: 0
        set s.language: 0
        set s.country: 0
        set s.kern: false
        set s.char_border: false
        set s.char_border_color: 0
        set s.char_border_thickness: 0
        set s.char_border_double: false
        set s.left_indent: 0
        set s.right_indent: 0
        set s.first_line_indent: 0
        set s.line_spacing: 240
        set s.line_spacing_at_least: false
        set s.quadding: 0x6C
        set s.lines: RSYM_WRAP
        set s.widow_orphan_control: RTF_WIDOW_CONTROL | RTF_ORPHAN_CONTROL
        set s.heading_level: 0
        set s.hyphenate: false
        set s.field_width: 0
        set s.field_align: RSYM_START
        set s.input_whitespace_treatment: RSYM_PRESERVE
        set s.expand_tabs: 8
        set s.display_alignment: 0x6C
        set s.line_thickness: 20
        set s.line_double: false
        set s.score_spaces: true
        set s.box_has_border: true
        set s.box_has_background: false
        set s.background_color: 0
        set s.border_present: true
        set s.border_omit_at_break: false
        set s.cell_background: false
        set s.border_priority: 0
        set s.cell_top_margin: 0
        set s.cell_bottom_margin: 0
        set s.cell_left_margin: 0
        set s.cell_right_margin: 0
        set s.cell_vertical_alignment: 0x74
        set s.math_posture: false
        set s.math_inline: false
        set s.grid_pos_type: RTF_GRIDPOS_ROW_MAJOR
        set s.grid_column_alignment: 0x63
        set s.superscript_height: 5
        set s.subscript_depth: 3
        set s.over_mark_height: 10
        set s.under_mark_depth: 10
        set s.grid_row_sep: 2
        set s.grid_column_sep: 2
        set s.span: false
        var ls LengthSpec()
        set ls.length: 0
        set ls.factor: 0.0
        set s.pps_spec: ls
        set s.li_spec: ls
        set s.ri_spec: ls
        set s.fli_spec: ls
        var lss LengthSpec()
        set lss.length: 240
        set lss.factor: 0.0
        set s.ls_spec: lss
        set s.fw_spec: ls
    }

    function para_defaults(p: ref[RtfParaFmt])
    {
        set p.left_indent: 0
        set p.right_indent: 0
        set p.first_line_indent: 0
        set p.line_spacing: 240
        set p.line_spacing_at_least: false
        set p.quadding: 0x6C
        set p.lines: RSYM_WRAP
        set p.widow_orphan_control: RTF_WIDOW_CONTROL | RTF_ORPHAN_CONTROL
        set p.heading_level: 0
    }

    function page_defaults(p: ref[RtfPageFmt])
    {
        set p.page_width: 72 * 10 * 17
        set p.page_height: 72 * 20 * 11
        set p.left_margin: 0
        set p.right_margin: 0
        set p.header_margin: 0
        set p.footer_margin: 0
        set p.top_margin: 0
        set p.bottom_margin: 0
        set p.page_number_restart: false
        set p.page_number_format: RTF_PGN_DEC
        set p.n_columns: 1
        set p.column_sep: 72 * 10
        set p.balance: false
    }

    ; --- field-copy helpers --------------------------------------------------
    function copy_format(dst: ref[RtfFormat], src: ref[RtfFormat])
    {
        set dst.is_bold: src.is_bold
        set dst.is_italic: src.is_italic
        set dst.is_small_caps: src.is_small_caps
        set dst.underline: src.underline
        set dst.is_strikethrough: src.is_strikethrough
        set dst.font_family: src.font_family
        set dst.font_size: src.font_size
        set dst.color: src.color
        set dst.char_background_color: src.char_background_color
        set dst.position_point_shift: src.position_point_shift
        set dst.language: src.language
        set dst.country: src.country
        set dst.kern: src.kern
        set dst.char_border: src.char_border
        set dst.char_border_color: src.char_border_color
        set dst.char_border_thickness: src.char_border_thickness
        set dst.char_border_double: src.char_border_double
        set dst.left_indent: src.left_indent
        set dst.right_indent: src.right_indent
        set dst.first_line_indent: src.first_line_indent
        set dst.line_spacing: src.line_spacing
        set dst.line_spacing_at_least: src.line_spacing_at_least
        set dst.quadding: src.quadding
        set dst.lines: src.lines
        set dst.widow_orphan_control: src.widow_orphan_control
        set dst.heading_level: src.heading_level
        set dst.hyphenate: src.hyphenate
        set dst.field_width: src.field_width
        set dst.field_align: src.field_align
        set dst.input_whitespace_treatment: src.input_whitespace_treatment
        set dst.expand_tabs: src.expand_tabs
        set dst.display_alignment: src.display_alignment
        set dst.line_thickness: src.line_thickness
        set dst.line_double: src.line_double
        set dst.score_spaces: src.score_spaces
        set dst.box_has_border: src.box_has_border
        set dst.box_has_background: src.box_has_background
        set dst.background_color: src.background_color
        set dst.border_present: src.border_present
        set dst.border_omit_at_break: src.border_omit_at_break
        set dst.cell_background: src.cell_background
        set dst.border_priority: src.border_priority
        set dst.cell_top_margin: src.cell_top_margin
        set dst.cell_bottom_margin: src.cell_bottom_margin
        set dst.cell_left_margin: src.cell_left_margin
        set dst.cell_right_margin: src.cell_right_margin
        set dst.cell_vertical_alignment: src.cell_vertical_alignment
        set dst.math_posture: src.math_posture
        set dst.math_inline: src.math_inline
        set dst.grid_pos_type: src.grid_pos_type
        set dst.grid_column_alignment: src.grid_column_alignment
        set dst.superscript_height: src.superscript_height
        set dst.subscript_depth: src.subscript_depth
        set dst.over_mark_height: src.over_mark_height
        set dst.under_mark_depth: src.under_mark_depth
        set dst.grid_row_sep: src.grid_row_sep
        set dst.grid_column_sep: src.grid_column_sep
        set dst.span: src.span
        set dst.pps_spec: src.pps_spec
        set dst.li_spec: src.li_spec
        set dst.ri_spec: src.ri_spec
        set dst.fli_spec: src.fli_spec
        set dst.ls_spec: src.ls_spec
        set dst.fw_spec: src.fw_spec
    }

    function copy_para(dst: ref[RtfParaFmt], src: ref[RtfParaFmt])
    {
        set dst.left_indent: src.left_indent
        set dst.right_indent: src.right_indent
        set dst.first_line_indent: src.first_line_indent
        set dst.line_spacing: src.line_spacing
        set dst.line_spacing_at_least: src.line_spacing_at_least
        set dst.quadding: src.quadding
        set dst.lines: src.lines
        set dst.widow_orphan_control: src.widow_orphan_control
        set dst.heading_level: src.heading_level
    }

    ; paraFormat_ = specFormat_ (the C++ ParaFormat slice assignment)
    function para_from_spec(dst: ref[RtfParaFmt], src: ref[RtfFormat])
    {
        set dst.left_indent: src.left_indent
        set dst.right_indent: src.right_indent
        set dst.first_line_indent: src.first_line_indent
        set dst.line_spacing: src.line_spacing
        set dst.line_spacing_at_least: src.line_spacing_at_least
        set dst.quadding: src.quadding
        set dst.lines: src.lines
        set dst.widow_orphan_control: src.widow_orphan_control
        set dst.heading_level: src.heading_level
    }

    function copy_page(dst: ref[RtfPageFmt], src: ref[RtfPageFmt])
    {
        set dst.page_width: src.page_width
        set dst.page_height: src.page_height
        set dst.left_margin: src.left_margin
        set dst.right_margin: src.right_margin
        set dst.header_margin: src.header_margin
        set dst.footer_margin: src.footer_margin
        set dst.top_margin: src.top_margin
        set dst.bottom_margin: src.bottom_margin
        set dst.page_number_restart: src.page_number_restart
        set dst.page_number_format: src.page_number_format
        set dst.n_columns: src.n_columns
        set dst.column_sep: src.column_sep
        set dst.balance: src.balance
    }

    function copy_output_fmt(dst: ref[RtfOutputFmt], src: ref[RtfOutputFmt])
    {
        set dst.is_bold: src.is_bold
        set dst.is_italic: src.is_italic
        set dst.is_small_caps: src.is_small_caps
        set dst.underline: src.underline
        set dst.is_strikethrough: src.is_strikethrough
        set dst.font_family: src.font_family
        set dst.font_size: src.font_size
        set dst.color: src.color
        set dst.char_background_color: src.char_background_color
        set dst.position_point_shift: src.position_point_shift
        set dst.language: src.language
        set dst.country: src.country
        set dst.kern: src.kern
        set dst.char_border: src.char_border
        set dst.char_border_color: src.char_border_color
        set dst.char_border_thickness: src.char_border_thickness
        set dst.char_border_double: src.char_border_double
        set dst.charset: src.charset
        set dst.lang: src.lang
        set dst.lang_charsets: src.lang_charsets
    }

    ; --- stack machinery (slot reuse) ----------------------------------------
    function push_spec(this: ref[RtfFOTBuilder])
    {
        let d this.spec_depth as size_t
        if d < this.spec_stack.get_length()
        {
            let slotp this.spec_stack.get(d)
            if slotp <> null
                RtfFOTBuilder.copy_format(*slotp, &this.spec)
        }
        else
        {
            let host this.host
            let rec host.allocate(sizeof RtfFormat, alignof RtfFormat) as pointer[RtfFormat]
            RtfFOTBuilder.copy_format(rec, &this.spec)
            this.spec_stack.add(rec)
        }
        set this.spec_depth: this.spec_depth + 1
    }

    function pop_spec(this: ref[RtfFOTBuilder])
    {
        set this.spec_depth: this.spec_depth - 1
        let slotp this.spec_stack.get((this.spec_depth - 1) as size_t)
        if slotp <> null
            RtfFOTBuilder.copy_format(&this.spec, *slotp)
    }

    function spec_at(this: ref[RtfFOTBuilder], i: int) returns ref[RtfFormat]?
    {
        let slotp this.spec_stack.get(i as size_t)
        if slotp = null
            return null
        *slotp
    }

    function push_page(this: ref[RtfFOTBuilder])
    {
        let d this.page_depth as size_t
        if d < this.page_stack.get_length()
        {
            let slotp this.page_stack.get(d)
            if slotp <> null
                RtfFOTBuilder.copy_page(*slotp, &this.page)
        }
        else
        {
            let host this.host
            let rec host.allocate(sizeof RtfPageFmt, alignof RtfPageFmt) as pointer[RtfPageFmt]
            RtfFOTBuilder.copy_page(rec, &this.page)
            this.page_stack.add(rec)
        }
        set this.page_depth: this.page_depth + 1
    }

    function pop_page(this: ref[RtfFOTBuilder])
    {
        set this.page_depth: this.page_depth - 1
        let slotp this.page_stack.get((this.page_depth - 1) as size_t)
        if slotp <> null
            RtfFOTBuilder.copy_page(&this.page, *slotp)
    }

    ; endSimplePageSequenceSerial: pageFormat_ = pageFormatStack_.back()
    ; without popping.
    function page_from_back(this: ref[RtfFOTBuilder])
    {
        let slotp this.page_stack.get((this.page_depth - 1) as size_t)
        if slotp <> null
            RtfFOTBuilder.copy_page(&this.page, *slotp)
    }

    function push_para(this: ref[RtfFOTBuilder])
    {
        let d this.para_depth as size_t
        if d < this.para_stack.get_length()
        {
            let slotp this.para_stack.get(d)
            if slotp <> null
                RtfFOTBuilder.copy_para(*slotp, &this.para)
        }
        else
        {
            let host this.host
            let rec host.allocate(sizeof RtfParaFmt, alignof RtfParaFmt) as pointer[RtfParaFmt]
            RtfFOTBuilder.copy_para(rec, &this.para)
            this.para_stack.add(rec)
        }
        set this.para_depth: this.para_depth + 1
    }

    function pop_para(this: ref[RtfFOTBuilder])
    {
        set this.para_depth: this.para_depth - 1
        let slotp this.para_stack.get(this.para_depth as size_t)
        if slotp <> null
            RtfFOTBuilder.copy_para(&this.para, *slotp)
    }

    function push_display(this: ref[RtfFOTBuilder]) returns ref[RtfDisplayInfo]?
    {
        let d this.display_depth as size_t
        var rec: ref[RtfDisplayInfo]? null
        if d < this.display_stack.get_length()
        {
            let slotp this.display_stack.get(d)
            if slotp <> null
                set rec: *slotp
        }
        else
        {
            let host this.host
            set rec: host.allocate(sizeof RtfDisplayInfo, alignof RtfDisplayInfo) as pointer[RtfDisplayInfo]
            this.display_stack.add(rec)
        }
        set rec.space_after: 0
        set rec.keep_with_next: false
        set rec.save_keep: false
        set rec.break_after: RTF_BREAK_NONE
        set this.display_depth: this.display_depth + 1
        rec
    }

    function display_back(this: ref[RtfFOTBuilder]) returns ref[RtfDisplayInfo]?
    {
        let slotp this.display_stack.get((this.display_depth - 1) as size_t)
        if slotp = null
            return null
        *slotp
    }

    ; --- char table helpers ---------------------------------------------------
    function ct_get(this: ref[RtfFOTBuilder], c: u32) returns u32
    {
        if c >= 0x10000
            return 0 as u32
        let p this.char_table.get(c as size_t)
        if p = null
            return 0 as u32
        *p
    }

    function ct_set(this: ref[RtfFOTBuilder], c: u32, v: u32)
    {
        if c < 0x10000
            this.char_table.put(c as size_t, v)
    }

    ; NOTE: these helpers EMIT directly instead of returning the cstring
    ; literal — written around the cstring-literal-return compiler bug
    ; (2026-07-29). That bug is FIXED (dd18c0d7); the direct-emitting shape
    ; stays deliberately (reverting would be emission churn for no gain).
    function emit_charset_suffix(this: ref[RtfFOTBuilder], i: int)
    {
        if i = 1
            this.raw(" CE")
        else if i = 2
            this.raw(" CYR")
        else if i = 3
            this.raw(" Greek")
        else if i = 4
            this.raw(" TUR")
    }

    ; --- font family hash table (OpenSP PointerTable semantics) --------------
    function torek_hash(this: ref[RtfFOTBuilder], s: StringC) returns size_t
    {
        var h: size_t 0
        let n s.get_size()
        var i: size_t 0
        while i < n
        {
            set h: (h << 5) + h + (s.get(i) as size_t)
            set i: i + 1
        }
        h
    }

    function font_lookup(this: ref[RtfFOTBuilder], key: StringC) returns int
    {
        if this.font_used = 0
            return 0 - 1
        let size this.font_slots.get_length()
        var i (this.torek_hash(key) & ((size - 1) as size_t))
        while true
        {
            let slotp this.font_slots.get(i)
            if slotp = null
                return 0 - 1
            let e *slotp
            if e = null
                return 0 - 1
            if e.key.equals(key)
                return e.value
            if i = 0
                set i: size - 1
            else
                set i: i - 1
        }
        0 - 1
    }

    function font_insert(this: ref[RtfFOTBuilder], key: StringC, value: int)
    {
        let host this.host
        if this.font_slots.get_length() = 0
        {
            var z 0
            while z < 8
            {
                let np: ref[RtfFontEntry]? null
                this.font_slots.add(np)
                set z: z + 1
            }
            set this.font_used_limit: 4
        }
        var size this.font_slots.get_length()
        var i (this.torek_hash(key) & ((size - 1) as size_t))
        while true
        {
            let slotp this.font_slots.get(i)
            var e: ref[RtfFontEntry]? null
            if slotp <> null
                set e: *slotp
            if e = null
                break
            if e.key.equals(key)
                return
            if i = 0
                set i: size - 1
            else
                set i: i - 1
        }
        if this.font_used >= this.font_used_limit
        {
            ; rehash into a doubled table (PointerTable::insert)
            let old this.font_slots
            let old_size old.get_length()
            let fresh Array[ref[RtfFontEntry]?]^host()
            var z2: size_t 0
            while z2 < (old_size * 2)
            {
                let np2: ref[RtfFontEntry]? null
                fresh.add(np2)
                set z2: z2 + 1
            }
            set this.font_slots: fresh
            set size: fresh.get_length()
            set this.font_used_limit: (size / 2) as int
            var oi: size_t 0
            while oi < old_size
            {
                let op old.get(oi)
                var oe: ref[RtfFontEntry]? null
                if op <> null
                    set oe: *op
                if oe <> null
                {
                    var j (this.torek_hash(oe.key) & ((size - 1) as size_t))
                    while true
                    {
                        let sp fresh.get(j)
                        var cur: ref[RtfFontEntry]? null
                        if sp <> null
                            set cur: *sp
                        if cur = null
                            break
                        if j = 0
                            set j: size - 1
                        else
                            set j: j - 1
                    }
                    fresh.put(j, oe)
                }
                set oi: oi + 1
            }
            set i: (this.torek_hash(key) & ((size - 1) as size_t))
            while true
            {
                let sp2 this.font_slots.get(i)
                var cur2: ref[RtfFontEntry]? null
                if sp2 <> null
                    set cur2: *sp2
                if cur2 = null
                    break
                if i = 0
                    set i: size - 1
                else
                    set i: i - 1
            }
        }
        set this.font_used: this.font_used + 1
        let entry RtfFontEntry.make(host, key, value)
        this.font_slots.put(i, entry)
    }

    ; --- low-level output -----------------------------------------------------
    ; one byte into the current stream. The leader null stream discards;
    ; otherwise cur_stream selects the buffer (the reference osp_ pointer).
    function put(this: ref[RtfFOTBuilder], b: u8)
    {
        if this.discard
            return
        ; the math redirects (reorder / grid capture) outrank cur_stream — the
        ; reference simply repoints osp_ at the capture buffer.
        if this.redirect_depth > 0
        {
            let bp this.redirect.get((this.redirect_depth - 1) as size_t)
            let rbuf *bp
            rbuf.add(b)
            return
        }
        if this.cur_stream = RTF_ST_MAIN
        {
            this.out.add(b)
            return
        }
        if this.cur_stream = RTF_ST_HF
        {
            this.hfos.add(b)
            return
        }
        if this.cur_stream = RTF_ST_FIELD
        {
            this.fieldos.add(b)
            return
        }
        this.cellos.add(b)
    }

    function raw(this: ref[RtfFOTBuilder], s: pointer[const_char])
    {
        var i: size_t 0
        while true
        {
            let b *((s as pointer[u8]) + i)
            if b = 0
                break
            this.put(b)
            set i: i + 1
        }
    }

    function put_c(this: ref[RtfFOTBuilder], c: int)
        this.put(c as u8)

    function raw_stringc(this: ref[RtfFOTBuilder], s: StringC)
    {
        let n s.get_size()
        var i: size_t 0
        while i < n
        {
            this.put((s.get(i) & 0xFF) as u8)
            set i: i + 1
        }
    }

    function raw_uint(this: ref[RtfFOTBuilder], n_in: int)
    {
        var n n_in
        if n = 0
        {
            this.put(0x30)
            return
        }
        var digits u8[24]
        var k 0
        while n > 0
        {
            set *((digits as pointer[u8]) + k): ((n % 10) + 0x30) as u8
            set n: n / 10
            set k: k + 1
        }
        while k > 0
        {
            set k: k - 1
            this.put(*((digits as pointer[u8]) + k))
        }
    }

    function raw_int(this: ref[RtfFOTBuilder], n: int)
    {
        if n < 0
        {
            this.put(0x2D)
            this.raw_uint(0 - n)
        }
        else
            this.raw_uint(n)
    }

    ; a control word with a signed numeric parameter
    function cw_int(this: ref[RtfFOTBuilder], word: pointer[const_char], n: int)
    {
        this.raw(word)
        this.raw_int(n)
    }

    ; \'xx — lowercase hex escape
    function hex_char(this: ref[RtfFOTBuilder], code: int)
    {
        let digits "0123456789abcdef"
        this.raw("\\'")
        this.put(*((digits as pointer[u8]) + ((code >> 4) & 0xF)))
        this.put(*((digits as pointer[u8]) + (code & 0xF)))
    }

    ; big-endian 32-bit word (insertion payloads)
    function output_word(this: ref[RtfFOTBuilder], n: int)
    {
        this.put(((n >> 24) & 0xFF) as u8)
        this.put(((n >> 16) & 0xFF) as u8)
        this.put(((n >> 8) & 0xFF) as u8)
        this.put((n & 0xFF) as u8)
    }

    ; --- computeLengthSpec / displaySizeChanged -------------------------------
    function compute_length_spec(this: ref[RtfFOTBuilder], spec: LengthSpec) returns int
    {
        if spec.factor = 0.0
            return spec.length
        let tem (this.display_size as double) * spec.factor
        if tem >= 0.0
            return spec.length + ((tem + 0.5) as int)
        spec.length + ((tem - 0.5) as int)
    }

    function half_points(this: ref[RtfFOTBuilder], n: int) returns int
        n / 10

    function points_of(this: ref[RtfFOTBuilder], n: int) returns int
    {
        if n >= 0
            return (n + 10) / 20
        (n - 10) / 20
    }

    function display_size_changed(this: ref[RtfFOTBuilder])
    {
        set this.spec.position_point_shift: this.half_points(this.compute_length_spec(this.spec.pps_spec))
        set this.spec.left_indent: this.compute_length_spec(this.spec.li_spec)
        set this.spec.right_indent: this.compute_length_spec(this.spec.ri_spec)
        set this.spec.first_line_indent: this.compute_length_spec(this.spec.fli_spec)
        set this.spec.line_spacing: this.compute_length_spec(this.spec.ls_spec)
        set this.spec.field_width: this.compute_length_spec(this.spec.fw_spec)
    }

    ; --- language -------------------------------------------------------------
    ; convertLanguage (RtfFOTBuilder.cxx 3922-4160). Returns the RTF lang code;
    ; lang_charsets is returned through the out-pointer.
    function convert_language(this: ref[RtfFOTBuilder], language: int, country: int, lcs: ref[int]) returns int
    {
        if language = 0
        {
            set lcs: 0x1f
            return RTF_DEFAULT_LANG
        }
        ; SP_LETTER2('X','Y') = ('X' << 8) | 'Y'
        if language = 0x4247
        {
            set lcs: 0x4
            return 0x402
        }
        if language = 0x4341
        {
            set lcs: 0x3
            return 0x403
        }
        if language = 0x4353
        {
            set lcs: 0x13
            return 0x405
        }
        if language = 0x4441
        {
            set lcs: 0x13
            return 0x406
        }
        if language = 0x4445
        {
            set lcs: 0x13
            if country = 0x4445
                return 0x407
            if country = 0x4348
                return 0x807
            if country = 0x4154
                return 0xc07
            if country = 0x4C55
                return 0x1007
            if country = 0x4C49
                return 0x1407
            return 0x407
        }
        if language = 0x454C
        {
            set lcs: 0x8
            return 0x408
        }
        if language = 0x454E
        {
            set lcs: 0x1f
            if country = 0x5553
                return 0x409
            if country = 0x4742
                return 0x809
            if country = 0x4155
                return 0xc09
            if country = 0x4341
                return 0x1009
            if country = 0x4E5A
                return 0x1409
            if country = 0x4945
                return 0x1809
            if country = 0x5A41
                return 0x1c09
            if country = 0x4A4D
                return 0x2009
            if country = 0x4342
                return 0x2409
            if country = 0x425A
                return 0x2809
            if country = 0x5454
                return 0x2c09
            return 0x409
        }
        if language = 0x4553
        {
            set lcs: 0x13
            if country = 0x4553
                return 0x40a
            if country = 0x4D58
                return 0x80a
            if country = 0x4754
                return 0x100a
            if country = 0x4352
                return 0x140a
            if country = 0x5041
                return 0x180a
            if country = 0x444F
                return 0x1c0a
            if country = 0x5645
                return 0x200a
            if country = 0x434F
                return 0x240a
            if country = 0x5045
                return 0x280a
            if country = 0x4152
                return 0x2c0a
            if country = 0x4543
                return 0x300a
            if country = 0x434C
                return 0x340a
            if country = 0x5559
                return 0x380a
            if country = 0x5059
                return 0x3c0a
            if country = 0x424F
                return 0x400a
            if country = 0x5356
                return 0x440a
            if country = 0x484E
                return 0x480a
            if country = 0x4E49
                return 0x4c0a
            if country = 0x5052
                return 0x500a
            return 0x40a
        }
        if language = 0x4649
        {
            set lcs: 0x13
            return 0x40b
        }
        if language = 0x4652
        {
            set lcs: 0x13
            if country = 0x4652
                return 0x40c
            if country = 0x4245
                return 0x80c
            if country = 0x4341
                return 0xc0c
            if country = 0x4348
                return 0x100c
            if country = 0x4C55
                return 0x140c
            return 0x40c
        }
        if language = 0x4855
        {
            set lcs: 0x12
            return 0x40e
        }
        if language = 0x4953
        {
            set lcs: 0x3
            return 0x40f
        }
        if language = 0x4954
        {
            set lcs: 0x13
            if country = 0x4954
                return 0x410
            if country = 0x4348
                return 0x810
            return 0x410
        }
        if language = 0x4E4C
        {
            set lcs: 0x13
            if country = 0x4E4C
                return 0x413
            if country = 0x4245
                return 0x813
            return 0x413
        }
        if language = 0x4E4F
        {
            set lcs: 0x13
            return 0x414
        }
        if language = 0x504C
        {
            set lcs: 0x12
            return 0x415
        }
        if language = 0x5054
        {
            set lcs: 0x13
            if country = 0x4252
                return 0x416
            if country = 0x5054
                return 0x816
            return 0x416
        }
        if language = 0x524F
        {
            set lcs: 0x12
            return 0x418
        }
        if language = 0x5255
        {
            set lcs: 0x4
            return 0x419
        }
        if language = 0x4852
        {
            set lcs: 0x12
            if country = 0x4852
                return 0x41a
            if country = 0x5350
                return 0x81a
            return 0x41a
        }
        if language = 0x534B
        {
            set lcs: 0x12
            return 0x41b
        }
        if language = 0x5351
        {
            set lcs: 0x12
            return 0x41c
        }
        if language = 0x5356
        {
            set lcs: 0x13
            if country = 0x5345
                return 0x41d
            if country = 0x4649
                return 0x81d
            return 0x41d
        }
        if language = 0x5452
        {
            set lcs: 0x12
            return 0x41f
        }
        if language = 0x4944
        {
            set lcs: 0x13
            return 0x421
        }
        if language = 0x554B
        {
            set lcs: 0x4
            return 0x422
        }
        if language = 0x4245
        {
            set lcs: 0x4
            return 0x423
        }
        if language = 0x534C
        {
            set lcs: 0x12
            return 0x424
        }
        if language = 0x4554
        {
            set lcs: 0x12
            return 0x425
        }
        if language = 0x4C56
        {
            set lcs: 0x12
            return 0x426
        }
        if language = 0x4C54
        {
            set lcs: 0x12
            return 0x427
        }
        if language = 0x5649
        {
            set lcs: 0x13
            return 0x42a
        }
        if language = 0x4555
        {
            set lcs: 0x13
            return 0x42d
        }
        if language = 0x4146
        {
            set lcs: 0x1f
            return 0x436
        }
        if language = 0x464F
        {
            set lcs: 0x13
            return 0x438
        }
        if language = 0x4A41
        {
            set lcs: 1 << RTF_JIS_CHARSET
            return 0x411
        }
        set lcs: 0x1f
        return RTF_DEFAULT_LANG
    }

    ; --- character formatting -------------------------------------------------
    function sync_char_format(this: ref[RtfFOTBuilder])
    {
        var changed false
        if this.out_fmt.is_bold <> this.spec.is_bold
        {
            this.raw("\\b")
            if this.spec.is_bold = false
                this.put_c(0x30)
            set this.out_fmt.is_bold: this.spec.is_bold
            set changed: true
        }
        if this.out_fmt.is_italic <> this.spec.is_italic
        {
            this.raw("\\i")
            if this.spec.is_italic = false
                this.put_c(0x30)
            set this.out_fmt.is_italic: this.spec.is_italic
            set changed: true
        }
        if this.out_fmt.underline <> this.spec.underline
        {
            if this.spec.underline = RTF_UL_NONE
                this.raw("\\ul0")
            else if this.spec.underline = RTF_UL_SINGLE
                this.raw("\\ul")
            else if this.spec.underline = RTF_UL_DOUBLE
                this.raw("\\uldb")
            else
                this.raw("\\ulw")
            set this.out_fmt.underline: this.spec.underline
            set changed: true
        }
        if this.out_fmt.is_small_caps <> this.spec.is_small_caps
        {
            this.raw("\\scaps")
            if this.spec.is_small_caps = false
                this.put_c(0x30)
            set this.out_fmt.is_small_caps: this.spec.is_small_caps
            set changed: true
        }
        if this.out_fmt.is_strikethrough <> this.spec.is_strikethrough
        {
            this.raw("\\strike")
            if this.spec.is_strikethrough = false
                this.put_c(0x30)
            set this.out_fmt.is_strikethrough: this.spec.is_strikethrough
            set changed: true
        }
        if this.out_fmt.position_point_shift <> this.spec.position_point_shift
        {
            if this.spec.position_point_shift >= 0
                this.cw_int("\\up", this.spec.position_point_shift)
            else
                this.cw_int("\\dn", 0 - this.spec.position_point_shift)
            set this.out_fmt.position_point_shift: this.spec.position_point_shift
            set changed: true
        }
        if this.out_fmt.font_size <> this.spec.font_size
        {
            this.cw_int("\\fs", this.spec.font_size)
            set this.out_fmt.font_size: this.spec.font_size
            set changed: true
        }
        var lang_differs false
        if this.out_fmt.country <> this.spec.country
            set lang_differs: true
        if this.out_fmt.language <> this.spec.language
            set lang_differs: true
        if lang_differs
        {
            set this.out_fmt.country: this.spec.country
            set this.out_fmt.language: this.spec.language
            var lcs this.out_fmt.lang_charsets
            let lang this.convert_language(this.out_fmt.language, this.out_fmt.country, &lcs)
            set this.out_fmt.lang_charsets: lcs
            if lang <> this.out_fmt.lang
            {
                set this.out_fmt.lang: lang
                this.cw_int("\\lang", lang)
                set changed: true
            }
        }
        var charset_ok false
        if ((1 << this.out_fmt.charset) & this.out_fmt.lang_charsets) <> 0
            set charset_ok: true
        var family_differs false
        if this.out_fmt.font_family <> this.spec.font_family
            set family_differs: true
        if charset_ok = false
            set family_differs: true
        if family_differs
        {
            set this.out_fmt.font_family: this.spec.font_family
            if charset_ok = false
            {
                var cs 0
                while (this.out_fmt.lang_charsets & (1 << cs)) = 0
                    set cs: cs + 1
                set this.out_fmt.charset: cs
            }
            let rowp this.ffcs.get(this.out_fmt.font_family as size_t)
            if rowp <> null
            {
                let row *rowp
                var n row.get_at(this.out_fmt.charset)
                if n < 0
                {
                    set n: this.next_font_number
                    set this.next_font_number: this.next_font_number + 1
                    row.set_at(this.out_fmt.charset, n)
                }
                this.cw_int("\\f", n)
                set changed: true
            }
        }
        if this.out_fmt.color <> this.spec.color
        {
            this.cw_int("\\cf", this.spec.color)
            set this.out_fmt.color: this.spec.color
            set changed: true
        }
        if this.out_fmt.char_background_color <> this.spec.char_background_color
        {
            this.cw_int("\\highlight", this.spec.char_background_color)
            set this.out_fmt.char_background_color: this.spec.char_background_color
            set changed: true
        }
        if this.spec.char_border
        {
            var need false
            if this.out_fmt.char_border = false
                set need: true
            if this.spec.char_border_color <> this.out_fmt.char_border_color
                set need: true
            if this.spec.char_border_thickness <> this.out_fmt.char_border_thickness
                set need: true
            if this.spec.char_border_double <> this.out_fmt.char_border_double
                set need: true
            if need
            {
                set this.out_fmt.char_border: true
                this.raw("\\chbrdr")
                if this.spec.char_border_double
                    this.raw("\\brdrdb")
                else
                    this.raw("\\brdrs")
                this.cw_int("\\brdrw", this.spec.char_border_thickness)
                if this.spec.char_border_color <> 0
                    this.cw_int("\\brdrcf", this.spec.char_border_color)
                set changed: true
                set this.out_fmt.char_border_color: this.spec.char_border_color
                set this.out_fmt.char_border_thickness: this.spec.char_border_thickness
                set this.out_fmt.char_border_double: this.spec.char_border_double
            }
        }
        else
        {
            if this.out_fmt.char_border
            {
                this.raw("\\chbrdr")
                set changed: true
                set this.out_fmt.char_border: false
            }
        }
        if this.spec.hyphenate = false
            set this.hyphenate_suppressed: true
        if this.out_fmt.kern <> this.spec.kern
        {
            this.raw("\\kerning")
            if this.spec.kern
                this.put_c(0x31)
            else
                this.put_c(0x30)
            set this.out_fmt.kern: this.spec.kern
            set changed: true
        }
        if changed
            this.put_c(0x20)
    }

    function set_charset(this: ref[RtfFOTBuilder], cs: int)
    {
        set this.out_fmt.charset: cs
        let rowp this.ffcs.get(this.out_fmt.font_family as size_t)
        if rowp <> null
        {
            let row *rowp
            var n row.get_at(cs)
            if n < 0
            {
                set n: this.next_font_number
                set this.next_font_number: this.next_font_number + 1
                row.set_at(cs, n)
            }
            this.cw_int("\\f", n)
        }
    }

    function symbol_char(this: ref[RtfFOTBuilder], ff: int, code: int)
    {
        let rowp this.ffcs.get(ff as size_t)
        if rowp <> null
        {
            let row *rowp
            var n row.get_at(RTF_N_WIN_CHARSETS - 1)
            if n < 0
            {
                set n: this.next_font_number
                set this.next_font_number: this.next_font_number + 1
                row.set_at(RTF_N_WIN_CHARSETS - 1, n)
            }
            this.raw("{\\f")
            this.raw_int(n)
            this.hex_char(code)
            this.raw("}")
        }
    }

    ; \uN takes the SIGNED 16-bit reading of the code unit
    function u_signed16(this: ref[RtfFOTBuilder], c: u32) returns int
    {
        var v (c & 0xFFFF) as int
        if v >= 0x8000
            set v: v - 65536
        v
    }

    ; --- characters (the hot path; RtfFOTBuilder.cxx 1159-1355, math arms
    ; omitted — the engine has no math flow-object classes) -------------------
    function characters(this: ref[RtfFOTBuilder], s: pointer[u32], n_in: size_t)
    {
        var p s
        var n n_in
        ; ignore record ends at the start of continuation paragraphs
        var skip_res false
        if this.continue_par
        {
            if this.inline_state = RTF_INLINE_START
                set skip_res: true
            if this.inline_state = RTF_INLINE_FIRST
                set skip_res: true
        }
        if skip_res
        {
            if this.para.lines = RSYM_WRAP
            {
                while n > 0
                {
                    if *p <> 0x0D
                        break
                    set p: p + 1
                    set n: n - 1
                }
                if n = 0
                    return
            }
        }
        if this.inline_state <> RTF_INLINE_MIDDLE
            this.inline_prepare()
        else
            this.flush_fields()
        this.sync_char_format()
        ; ★inside an EQ field whose operator port is being written, the first
        ; character of the run selects the RTF integral/sum/product control
        ; word AND IS CONSUMED — the whole run is dropped for the integral
        ; sign, only the first character for the other two (the reference
        ; returns in all three cases).
        if this.math_level <> 0
        {
            if this.math_special = RTF_MATH_INTEGRAL
            {
                if n > 0
                {
                    let c0 *p
                    if c0 = 0x222B
                        return
                    if c0 = 0x2211
                    {
                        this.raw("\\\\su")
                        return
                    }
                    if c0 = 0x220F
                    {
                        this.raw("\\\\pr")
                        return
                    }
                    ; anything else is a plain operator glyph: the EQ field's
                    ; \vc box, and the run is then written normally.
                    this.raw("\\\\vc\\\\")
                }
            }
        }
        while n > 0
        {
            let c *p
            let prev_ws this.follow_whitespace_char
            set this.follow_whitespace_char: false
            set this.current_column: this.current_column + 1
            if c = 0x0A
            {
                set this.current_column: this.current_column - 1
                set this.follow_whitespace_char: prev_ws
            }
            else if c = 0x0D
            {
                set this.follow_whitespace_char: true
                var wrap_like false
                if this.para.lines = RSYM_NONE
                    set wrap_like: true
                if this.para.lines = RSYM_WRAP
                    set wrap_like: true
                if wrap_like
                {
                    if this.spec.input_whitespace_treatment = RSYM_IGNORE
                        set this.current_column: this.current_column - 1
                    else if this.spec.input_whitespace_treatment = RSYM_COLLAPSE
                    {
                        if prev_ws
                            set this.current_column: this.current_column - 1
                        else
                            this.put_c(0x20)
                    }
                    else
                        this.put_c(0x20)
                }
                else
                {
                    this.raw("\\sa0\\par\\fi0\\sb0\n")
                    set this.current_column: 0
                }
            }
            else if (c = 0x09) or (c = 0x20)
            {
                var expanded false
                if c = 0x09
                {
                    var can_expand false
                    if this.spec.expand_tabs <> 0
                    {
                        if this.spec.input_whitespace_treatment = RSYM_PRESERVE
                            set can_expand: true
                    }
                    if can_expand
                    {
                        set this.current_column: this.current_column - 1
                        var col this.current_column + this.spec.expand_tabs
                        set col: (col / this.spec.expand_tabs) * this.spec.expand_tabs
                        while this.current_column < col
                        {
                            this.put_c(0x20)
                            set this.current_column: this.current_column + 1
                        }
                        set this.follow_whitespace_char: true
                        set expanded: true
                    }
                }
                if expanded = false
                {
                    set this.follow_whitespace_char: true
                    if this.spec.input_whitespace_treatment = RSYM_IGNORE
                        set this.current_column: this.current_column - 1
                    else if this.spec.input_whitespace_treatment = RSYM_COLLAPSE
                    {
                        if prev_ws
                            set this.current_column: this.current_column - 1
                        else
                            this.put_c(0x20)
                    }
                    else
                        this.put_c(0x20)
                }
            }
            else if c = 0x2002
                this.raw("\\u8194\\'20")
            else if c = 0x2003
                this.raw("\\u8195\\'20")
            else if c = 0x2010
                this.put_c(0x2D)
            else if c = 0x2011
                this.raw("\\_")
            else if c = 0x200c
                this.raw("\\zwnj ")
            else if c = 0x200d
                this.raw("\\zwj ")
            else if c = 0xa0
                this.raw("\\~")
            else if c = 0xad
                this.raw("\\-")
            else if c = 0
            {
                ; nothing
            }
            else if (c = 0x3B) or (c = 0x2C)
            {
                ; `;` / `,` — the EQ field's argument separator has to be
                ; doubled inside math so it reaches the field as data.
                if this.math_level <> 0
                {
                    if (c as int) = this.eq_arg_sep
                    {
                        if this.math_special = RTF_MATH_NORMAL
                            this.raw("\\\\")
                    }
                }
                this.put((c & 0xFF) as u8)
            }
            else if (c = 0x28) or (c = 0x29)
            {
                ; `(` / `)` — likewise; a fence or integral port writes them
                ; raw because they are the field's own grouping there.
                if this.math_level <> 0
                {
                    if this.math_special = RTF_MATH_NORMAL
                        this.raw("\\\\")
                }
                this.put((c & 0xFF) as u8)
            }
            else if c = 0x5C
            {
                ; backslash: leave the JIS charset first (initJIS deferred,
                ; the charset can never be JIS — kept for shape fidelity)
                if this.out_fmt.charset = RTF_JIS_CHARSET
                    this.set_charset(0)
                var math_bs false
                if this.math_level <> 0
                {
                    if this.math_special = RTF_MATH_NORMAL
                        set math_bs: true
                }
                if math_bs
                {
                    ; quoted once for RTF, once for the field, once more for
                    ; the reference's own C++ literal — four bytes.
                    this.raw("\\\\\\\\")
                }
                else
                {
                    this.put_c(0x5C)
                    this.put_c(0x5C)
                }
            }
            else if (c = 0x7B) or (c = 0x7D)
            {
                this.put_c(0x5C)
                this.put((c & 0xFF) as u8)
            }
            else if (c = 0x7C) or (c = 0x7E)
            {
                if this.out_fmt.charset = RTF_JIS_CHARSET
                    this.set_charset(0)
                this.emit_plain_char(c)
            }
            else if c < 0x80
                this.emit_plain_char(c)
            else
            {
                let code this.ct_get(c)
                if (code & (RTF_SYMBOL_FLAG as u32)) <> 0
                {
                    let ff (((code & 0x7FFFFFFF) as int) >> RTF_CHAR_BITS) + 1
                    this.symbol_char(ff, (code & 0xFF) as int)
                }
                else if code <> 0
                {
                    if (code & ((1 << (this.out_fmt.charset + RTF_CHAR_BITS)) as u32)) = 0
                    {
                        ; choose a charset compatible with the language when
                        ; possible
                        var code2 code
                        if (code2 & ((this.out_fmt.lang_charsets << RTF_CHAR_BITS) as u32)) <> 0
                            set code2: code2 & (((this.out_fmt.lang_charsets << RTF_CHAR_BITS) | ((1 << RTF_CHAR_BITS) - 1)) as u32)
                        var i 0
                        var mask (1 << RTF_CHAR_BITS) as u32
                        while (code2 & mask) = 0
                        {
                            set mask: mask << (1 as u32)
                            set i: i + 1
                        }
                        this.set_charset(i)
                    }
                    if (code & (RTF_DB_FLAG as u32)) <> 0
                    {
                        ; doublebyte JIS — unreachable while initJIS is
                        ; deferred (no table rows carry the flag)
                        this.raw("{\\dbch\\uc2\\u")
                        this.raw_int(this.u_signed16(c))
                        this.hex_char(((code >> (8 as u32)) & 0xFF) as int)
                        this.hex_char((code & 0xFF) as int)
                        this.raw("}")
                    }
                    else
                        this.hex_char((code & 0xFF) as int)
                }
                else
                {
                    var in_symbol_page false
                    if c >= ((RTF_SYMBOL_FONT_PAGE + 0x20) as u32)
                    {
                        if c <= ((RTF_SYMBOL_FONT_PAGE + 0xff) as u32)
                            set in_symbol_page: true
                    }
                    if in_symbol_page
                        this.symbol_char(this.out_fmt.font_family, (c & 0xFF) as int)
                    else
                    {
                        this.raw("\\u")
                        this.raw_int(this.u_signed16(c))
                        this.hex_char(0x3F)
                    }
                }
            }
            set p: p + 1
            set n: n - 1
        }
    }

    ; a plain ASCII char, honoring the math-posture italic wrap
    function emit_plain_char(this: ref[RtfFOTBuilder], c: u32)
    {
        if this.spec.math_posture
        {
            var is_letter false
            if c >= 0x61
            {
                if c <= 0x7A
                    set is_letter: true
            }
            if c >= 0x41
            {
                if c <= 0x5A
                    set is_letter: true
            }
            if is_letter
            {
                this.raw("{\\i ")
                this.put((c & 0xFF) as u8)
                this.put_c(0x7D)
                return
            }
        }
        this.put((c & 0xFF) as u8)
    }

    function characters_from_node(this: ref[RtfFOTBuilder], node: ref[GroveNode], s: pointer[u32], n: size_t)
        this.characters(s, n)

    ; --- colors ---------------------------------------------------------------
    function make_color(this: ref[RtfFOTBuilder], rgb: int) returns int
    {
        let n this.color_table.get_length()
        var i: size_t 0
        while i < n
        {
            let p this.color_table.get(i)
            if p <> null
            {
                if *p = rgb
                    return (i as int) + 1
            }
            set i: i + 1
        }
        this.color_table.add(rgb)
        this.color_table.get_length() as int
    }

    ; --- the characteristic dispatch (the reference's ~66 virtual setters,
    ; keyed by the STABLE registry index; extension characteristics ride on
    ; InheritedC.ext_setter) ---------------------------------------------------
    function set_ic(this: ref[RtfFOTBuilder], ic: ref[InheritedC])
    {
        let ext ic.ext_setter
        if ext <> 0
        {
            this.set_extension_ic(ext, ic)
            return
        }
        let index ic.get_index()
        if index = 0
            set this.spec.font_size: this.half_points(ic.lval)
        else if index = 1
            this.set_font_family_name(ic.sval)
        else if index = 2
        {
            if ic.sym.code > RSYM_MEDIUM
                set this.spec.is_bold: true
            else
                set this.spec.is_bold: false
        }
        else if index = 3
        {
            let c ic.sym.code
            if (c = RSYM_OBLIQUE) or (c = RSYM_ITALIC)
            {
                set this.spec.is_italic: true
                set this.spec.math_posture: false
            }
            else if c = RSYM_MATH
            {
                set this.spec.is_italic: false
                set this.spec.math_posture: true
            }
            else
            {
                set this.spec.is_italic: false
                set this.spec.math_posture: false
            }
        }
        else if index = 4
        {
            let c ic.sym.code
            if c = RSYM_END
                set this.spec.quadding: 0x72
            else if c = RSYM_CENTER
                set this.spec.quadding: 0x63
            else if c = RSYM_JUSTIFY
                set this.spec.quadding: 0x6A
            else
                set this.spec.quadding: 0x6C
        }
        else if index = 5
        {
            let c ic.sym.code
            if c = RSYM_END
                set this.spec.display_alignment: 0x72
            else if c = RSYM_CENTER
                set this.spec.display_alignment: 0x63
            else
                set this.spec.display_alignment: 0x6C
        }
        else if index = 6
            set this.spec.field_align: ic.sym.code
        else if index = 7
            set this.spec.lines: ic.sym.code
        else if index = 8
        {
            set this.spec.li_spec: ic.ls
            set this.spec.left_indent: this.compute_length_spec(ic.ls)
        }
        else if index = 9
        {
            set this.spec.fli_spec: ic.ls
            set this.spec.first_line_indent: this.compute_length_spec(ic.ls)
        }
        else if index = 10
        {
            set this.spec.ri_spec: ic.ls
            set this.spec.right_indent: this.compute_length_spec(ic.ls)
        }
        else if index = 12
        {
            set this.spec.ls_spec: ic.ls
            set this.spec.line_spacing: this.compute_length_spec(ic.ls)
        }
        else if index = 13
        {
            set this.spec.fw_spec: ic.ls
            set this.spec.field_width: this.compute_length_spec(ic.ls)
        }
        else if index = 14
        {
            if this.in_simple_page_sequence = 0
                set this.page.left_margin: ic.lval
        }
        else if index = 15
        {
            if this.in_simple_page_sequence = 0
                set this.page.right_margin: ic.lval
        }
        else if index = 16
        {
            if this.in_simple_page_sequence = 0
                set this.page.top_margin: ic.lval
        }
        else if index = 17
        {
            if this.in_simple_page_sequence = 0
                set this.page.bottom_margin: ic.lval
        }
        else if index = 18
        {
            if this.in_simple_page_sequence = 0
                set this.page.header_margin: ic.lval
        }
        else if index = 19
        {
            if this.in_simple_page_sequence = 0
                set this.page.footer_margin: ic.lval
        }
        else if index = 20
        {
            if this.in_simple_page_sequence = 0
                set this.page.page_width: ic.lval
        }
        else if index = 21
        {
            if this.in_simple_page_sequence = 0
                set this.page.page_height: ic.lval
        }
        else if index = 22
            set this.spec.border_present: ic.bval
        else if index = 23
        {
            if ic.lval > 150
                set this.spec.line_thickness: 150
            else
                set this.spec.line_thickness: ic.lval
        }
        else if index = 24
            set this.spec.cell_top_margin: ic.lval
        else if index = 25
            set this.spec.cell_bottom_margin: ic.lval
        else if index = 26
            set this.spec.cell_left_margin: ic.lval
        else if index = 27
            set this.spec.cell_right_margin: ic.lval
        else if index = 31
        {
            set this.spec.pps_spec: ic.ls
            set this.spec.position_point_shift: this.half_points(this.compute_length_spec(ic.ls))
        }
        else if index = 44
            set this.spec.hyphenate: ic.bval
        else if index = 45
            set this.spec.kern: ic.bval
        else if index = 47
            set this.spec.score_spaces: ic.bval
        else if index = 51
            set this.spec.cell_background: ic.bval
        else if index = 61
            set this.spec.border_omit_at_break: ic.bval
        else if index = 70
            set this.spec.input_whitespace_treatment: ic.sym.code
        else if index = 84
        {
            let c ic.sym.code
            if c = RSYM_BORDER
            {
                set this.spec.box_has_border: true
                set this.spec.box_has_background: false
            }
            else if c = RSYM_BACKGROUND
            {
                set this.spec.box_has_border: false
                set this.spec.box_has_background: true
            }
            else if c = RSYM_BOTH
            {
                set this.spec.box_has_border: true
                set this.spec.box_has_background: true
            }
        }
        else if index = 74
        {
            ; setMathDisplayMode — anything but display/inline is ignored.
            let c ic.sym.code
            if c = RSYM_DISPLAY
                set this.spec.math_inline: false
            else if c = RSYM_INLINE
                set this.spec.math_inline: true
        }
        else if index = 81
        {
            ; setGridPositionCellType
            let c ic.sym.code
            if c = RSYM_ROW_MAJOR
                set this.spec.grid_pos_type: RTF_GRIDPOS_ROW_MAJOR
            else if c = RSYM_COLUMN_MAJOR
                set this.spec.grid_pos_type: RTF_GRIDPOS_COLUMN_MAJOR
            else if c = RSYM_EXPLICIT
                set this.spec.grid_pos_type: RTF_GRIDPOS_EXPLICIT
        }
        else if index = 82
        {
            ; setGridColumnAlignment — 'l'/'c'/'r' straight into the EQ \a.
            ; (setGridRowAlignment stays the FOTBuilder no-op: the reference
            ; Rtf backend declares it but never stores it.)
            let c ic.sym.code
            if c = RSYM_START
                set this.spec.grid_column_alignment: 0x6C
            else if c = RSYM_CENTER
                set this.spec.grid_column_alignment: 0x63
            else if c = RSYM_END
                set this.spec.grid_column_alignment: 0x72
        }
        else if index = 87
        {
            let c ic.sym.code
            if c = RSYM_START
                set this.spec.cell_vertical_alignment: 0x74
            else if c = RSYM_CENTER
                set this.spec.cell_vertical_alignment: 0x63
            else if c = RSYM_END
                set this.spec.cell_vertical_alignment: 0x62
        }
        else if index = 97
            set this.spec.border_priority: ic.lval
        else if index = 98
        {
            if ic.lval > 1
                set this.spec.line_double: true
            else
                set this.spec.line_double: false
        }
        else if index = 99
        {
            if ic.lval > 1
                set this.spec.span: true
            else
                set this.spec.span: false
        }
        else if index = 103
        {
            if ic.lval > 1
                set this.spec.widow_orphan_control: this.spec.widow_orphan_control | RTF_WIDOW_CONTROL
            else
                set this.spec.widow_orphan_control: this.spec.widow_orphan_control & RTF_ORPHAN_CONTROL
        }
        else if index = 104
        {
            if ic.lval > 1
                set this.spec.widow_orphan_control: this.spec.widow_orphan_control | RTF_ORPHAN_CONTROL
            else
                set this.spec.widow_orphan_control: this.spec.widow_orphan_control & RTF_WIDOW_CONTROL
        }
        else if index = 132
            set this.spec.language: this.letter2_of(ic)
        else if index = 133
            set this.spec.country: this.letter2_of(ic)
        else if index = 134
            set this.spec.expand_tabs: ic.lval
        else if index = 135
        {
            let nn ic.lval
            if nn > 0
            {
                var takes false
                if this.max_consec_hyphens = 0
                    set takes: true
                if nn < this.max_consec_hyphens
                    set takes: true
                if takes
                    set this.max_consec_hyphens: nn
            }
        }
        else if index = 155
        {
            if ic.obj <> null
                set this.spec.color: this.make_color(ic.obj.color_rgb())
        }
        else if index = 156
        {
            if ic.obj = null
                set this.spec.background_color: 0
            else
                set this.spec.background_color: this.make_color(ic.obj.color_rgb())
        }
        else if index = 159
        {
            ; setMinLeading: hasLength = the non-#f arm (bval marks #f)
            if ic.bval
                set this.spec.line_spacing_at_least: false
            else
                set this.spec.line_spacing_at_least: true
        }
        else if index = 164
            this.set_glyph_subst_table(ic.gst)
    }

    function letter2_of(this: ref[RtfFOTBuilder], ic: ref[InheritedC]) returns int
    {
        if ic.bval
            return 0
        if ic.sval.get_size() < 2
            return 0
        let c0 ic.sval.get(0) as int
        let c1 ic.sval.get(1) as int
        (c0 << 8) | c1
    }

    function set_font_family_name(this: ref[RtfFOTBuilder], name: StringC)
    {
        let existing this.font_lookup(name)
        if existing >= 0
        {
            set this.spec.font_family: existing
            return
        }
        let host this.host
        let idx this.ffcs.get_length() as int
        set this.spec.font_family: idx
        this.font_insert(name, idx)
        let row RtfFontCharsets.make(host)
        this.ffcs.add(row)
    }

    ; setGlyphSubstTable: detect the small-caps signature (a..z mapped to
    ; suffix + 0375<<8 under ISO/IEC 10036/RA//Glyphs)
    function set_glyph_subst_table(this: ref[RtfFOTBuilder], tabs: ref[Array[ref[GlyphSubstTableRec]?]]?)
    {
        set this.spec.is_small_caps: false
        if tabs = null
            return
        let n tabs.get_length()
        var i: size_t 0
        while i < n
        {
            let tp tabs.get(i)
            if tp <> null
            {
                let t *tp
                let pairs t.get_pairs()
                let np pairs.get_length()
                var j: size_t 0
                while (j + 1) < np
                {
                    let op pairs.get(j)
                    let vp pairs.get(j + 1)
                    var hit false
                    if op <> null
                    {
                        if vp <> null
                        {
                            let o *op
                            let v *vp
                            let osuf o.glyph_suffix()
                            let vsuf v.glyph_suffix()
                            if osuf + (0xFD << 8) = vsuf
                            {
                                if osuf >= 0x61
                                {
                                    if osuf <= 0x7A
                                    {
                                        let opub o.glyph_pubid()
                                        let vpub v.glyph_pubid()
                                        if opub.equals(vpub)
                                        {
                                            if opub.equals(StringC("ISO/IEC 10036/RA//Glyphs"))
                                                set hit: true
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if hit
                    {
                        set this.spec.is_small_caps: true
                        return
                    }
                    set j: j + 2
                }
            }
            set i: i + 1
        }
    }

    ; the 12-entry extension characteristic table (jade.cxx)
    function set_extension_ic(this: ref[RtfFOTBuilder], ext: int, ic: ref[InheritedC])
    {
        if ext = RTF_EXT_PAGE_NUMBER_FORMAT
        {
            if this.in_simple_page_sequence = 0
            {
                set this.page.page_number_format: RTF_PGN_DEC
                if ic.sval.get_size() = 1
                {
                    let c ic.sval.get(0)
                    if c = 0x41
                        set this.page.page_number_format: RTF_PGN_UCLTR
                    else if c = 0x61
                        set this.page.page_number_format: RTF_PGN_LCLTR
                    else if c = 0x49
                        set this.page.page_number_format: RTF_PGN_UCRM
                    else if c = 0x69
                        set this.page.page_number_format: RTF_PGN_LCRM
                }
            }
        }
        else if ext = RTF_EXT_PAGE_NUMBER_RESTART
        {
            if this.in_simple_page_sequence = 0
                set this.page.page_number_restart: ic.bval
        }
        else if ext = RTF_EXT_PAGE_N_COLUMNS
        {
            if this.in_simple_page_sequence = 0
            {
                if ic.lval > 0
                    set this.page.n_columns: ic.lval
                else
                    set this.page.n_columns: 1
            }
        }
        else if ext = RTF_EXT_PAGE_COLUMN_SEP
        {
            if this.in_simple_page_sequence = 0
            {
                if ic.lval >= 0
                    set this.page.column_sep: ic.lval
                else
                    set this.page.column_sep: 0
            }
        }
        else if ext = RTF_EXT_PAGE_BALANCE_COLUMNS
        {
            if this.in_simple_page_sequence = 0
                set this.page.balance: ic.bval
        }
        else if ext = RTF_EXT_SUBSCRIPT_DEPTH
            set this.spec.subscript_depth: this.points_of(ic.lval)
        else if ext = RTF_EXT_OVER_MARK_HEIGHT
            set this.spec.over_mark_height: this.points_of(ic.lval)
        else if ext = RTF_EXT_UNDER_MARK_DEPTH
            set this.spec.under_mark_depth: this.points_of(ic.lval)
        else if ext = RTF_EXT_SUPERSCRIPT_HEIGHT
            set this.spec.superscript_height: this.points_of(ic.lval)
        else if ext = RTF_EXT_GRID_ROW_SEP
            set this.spec.grid_row_sep: this.points_of(ic.lval)
        else if ext = RTF_EXT_GRID_COLUMN_SEP
            set this.spec.grid_column_sep: this.points_of(ic.lval)
        else if ext = RTF_EXT_HEADING_LEVEL
        {
            if (ic.lval >= 1) and (ic.lval <= 9)
                set this.spec.heading_level: ic.lval
            else
                set this.spec.heading_level: 0
        }
    }

    ; scroll: not overridden by the reference RtfFOTBuilder — the plain
    ; FOTBuilder start()/end() bracket applies.
    function start_scroll(this: ref[RtfFOTBuilder])
        this.fo_start()

    function end_scroll(this: ref[RtfFOTBuilder])
        this.fo_end()

    ; --- start/end/atomic (the FOTBuilder bracket) ----------------------------
    function fo_start(this: ref[RtfFOTBuilder])
    {
        set this.n_pending_non_empty: this.pending_len
        this.push_spec()
        if this.in_simple_page_sequence = 0
            this.push_page()
    }

    function fo_end(this: ref[RtfFOTBuilder])
    {
        this.pop_spec()
        if this.in_simple_page_sequence = 0
            this.pop_page()
    }

    function fo_atomic(this: ref[RtfFOTBuilder])
    {
        set this.n_pending_non_empty: this.pending_len
        let slotp this.spec_stack.get((this.spec_depth - 1) as size_t)
        if slotp <> null
            RtfFOTBuilder.copy_format(&this.spec, *slotp)
    }

    ; --- bookmarks / pending elements ----------------------------------------
    function elements_refed_add(this: ref[RtfFOTBuilder], grove_index: int, n: int)
    {
        let host this.host
        while this.elements_refed.get_length() <= (grove_index as size_t)
            this.elements_refed.add(Array[bool]^host())
        let rowp this.elements_refed.get(grove_index as size_t)
        if rowp <> null
        {
            let row *rowp
            while row.get_length() <= (n as size_t)
                row.add(false)
            row.put(n as size_t, true)
        }
    }

    function elements_refed_contains(this: ref[RtfFOTBuilder], grove_index: int, n: int) returns bool
    {
        if (grove_index as size_t) >= this.elements_refed.get_length()
            return false
        let rowp this.elements_refed.get(grove_index as size_t)
        if rowp = null
            return false
        let row *rowp
        if (n as size_t) >= row.get_length()
            return false
        let p row.get(n as size_t)
        if p = null
            return false
        *p
    }

    ; outputBookmarkName(groveIndex, chars): "ID[g]_" + alnum verbatim,
    ; everything else "_<code>_"
    function output_bookmark_name_id(this: ref[RtfFOTBuilder], grove_index: int, id: StringC)
    {
        this.raw("ID")
        if grove_index <> 0
            this.raw_int(grove_index)
        this.put_c(0x5F)
        let n id.get_size()
        var i: size_t 0
        while i < n
        {
            let c id.get(i)
            var ok false
            if c >= 0x30
            {
                if c <= 0x39
                    set ok: true
            }
            if c >= 0x61
            {
                if c <= 0x7A
                    set ok: true
            }
            if c >= 0x41
            {
                if c <= 0x5A
                    set ok: true
            }
            if ok
                this.put((c & 0xFF) as u8)
            else
            {
                this.put_c(0x5F)
                this.raw_uint(c as int)
                this.put_c(0x5F)
            }
            set i: i + 1
        }
    }

    ; outputBookmarkName(groveIndex, elementIndex): "_" [g "_"] n  (word97)
    function output_bookmark_name_index(this: ref[RtfFOTBuilder], grove_index: int, n: int)
    {
        this.raw("_")
        if grove_index <> 0
        {
            this.raw_int(grove_index)
            this.put_c(0x5F)
        }
        this.raw_int(n)
    }

    function flush_pending_elements(this: ref[RtfFOTBuilder])
    {
        var i 0
        while i < this.pending_len
        {
            let np this.pending_elements.get(i as size_t)
            if np <> null
            {
                let node *np
                let g GroveInfo.index_of(node)
                let id node.get_id()
                if id.get_size() > 0
                {
                    this.raw("{\\*\\bkmkstart ")
                    this.output_bookmark_name_id(g, id)
                    this.put_c(0x7D)
                    this.raw("{\\*\\bkmkend ")
                    this.output_bookmark_name_id(g, id)
                    this.put_c(0x7D)
                }
                else
                {
                    let ei node.element_index
                    if ei >= 0
                    {
                        ; INSERTION_CHAR 'b' groveIndex elementIndex — patched
                        ; in finish() against elements_refed
                        this.put(0)
                        this.put_c(0x62)
                        this.output_word(g)
                        this.output_word(ei)
                    }
                }
            }
            set i: i + 1
        }
        set this.n_pending_non_empty: 0
        set this.pending_len: 0
    }

    function flush_fields(this: ref[RtfFOTBuilder])
    {
        if this.suppress_bookmarks = false
            this.flush_pending_elements()
        if this.have_pending_link
        {
            set this.have_pending_link: false
            this.do_start_link(this.pending_link)
        }
    }

    function start_node(this: ref[RtfFOTBuilder], node: ref[GroveNode], mode_name: StringC)
    {
        set this.node_level: this.node_level + 1
        if mode_name.get_size() = 0
        {
            let d this.pending_len as size_t
            if d < this.pending_elements.get_length()
            {
                this.pending_elements.put(d, node)
                this.pending_levels.put(d, this.node_level)
            }
            else
            {
                this.pending_elements.add(node)
                this.pending_levels.add(this.node_level)
            }
            set this.pending_len: this.pending_len + 1
        }
    }

    function end_node(this: ref[RtfFOTBuilder])
    {
        if this.pending_len > 0
        {
            let lp this.pending_levels.get((this.pending_len - 1) as size_t)
            if lp <> null
            {
                if *lp = this.node_level
                {
                    if this.n_pending_non_empty < this.pending_len
                        set this.pending_len: this.pending_len - 1
                }
            }
        }
        set this.node_level: this.node_level - 1
    }

    ; --- paragraph machinery --------------------------------------------------
    function new_par(this: ref[RtfFOTBuilder], allow_space_before: bool)
    {
        if this.box_first_para
        {
            set this.box_first_para: false
            set this.box_left_sep: this.para.left_indent
            set this.box_right_sep: this.para.right_indent
            var i 1
            while i < this.dbl_len
            {
                let lp this.display_box_levels.get(i as size_t)
                if lp <> null
                {
                    let f this.spec_at(*lp)
                    if f <> null
                    {
                        set this.box_left_sep: this.box_left_sep + f.left_indent
                        set this.box_right_sep: this.box_right_sep + f.right_indent
                    }
                }
                set i: i + 1
            }
            set this.box_top_sep: this.accum_space
            set this.accum_space: this.accum_space_box
            set this.accum_space_box: 0
        }
        if this.inline_state <> RTF_INLINE_FIRST
        {
            if allow_space_before = false
            {
                this.cw_int("\\sa", this.accum_space)
                set this.accum_space: 0
            }
            if this.keep
            {
                if this.had_par_in_keep or this.continue_par
                    set this.keep_with_next: true
                set this.had_par_in_keep: true
            }
            if this.do_break = RTF_BREAK_NONE
            {
                if this.keep_with_next
                    this.raw("\\keepn")
            }
            set this.keep_with_next: false
            if this.hyphenate_suppressed
            {
                this.raw("\\hyphpar0")
                set this.hyphenate_suppressed: false
            }
            this.raw("\\par")
        }
        if this.do_break = RTF_BREAK_PAGE
        {
            this.raw("\\page")
            set this.do_break: RTF_BREAK_NONE
        }
        else if this.do_break = RTF_BREAK_COLUMN
        {
            this.raw("\\column")
            set this.do_break: RTF_BREAK_NONE
        }
        if this.current_cols > 1
        {
            if this.span_display_levels <> 0
            {
                this.raw("\\sect\\sbknone\\cols1")
                set this.current_cols: 1
            }
        }
        else
        {
            var enter_cols false
            if this.span_display_levels = 0
            {
                if this.current_cols = 1
                {
                    if this.page.n_columns > 1
                        set enter_cols: true
                }
            }
            if enter_cols
            {
                if this.inline_state <> RTF_INLINE_FIRST
                    this.raw("\\sect\\sbknone")
                this.cw_int("\\cols", this.page.n_columns)
                this.cw_int("\\colsx", this.page.column_sep)
                set this.current_cols: this.page.n_columns
            }
        }
        this.raw("\\pard")
        if this.table_level <> 0
            this.raw("\\intbl")
        if this.accum_space <> 0
        {
            this.cw_int("\\sb", this.accum_space)
            set this.accum_space: 0
        }
        if this.keep
            this.raw("\\keep")
        if this.para.widow_orphan_control = 0
            this.raw("\\nowidctlpar")
        if this.para.heading_level <> 0
            this.cw_int("\\s", this.para.heading_level)
        if this.dbl_len > 0
        {
            var box_fmt: ref[RtfFormat]? null
            let bl0 this.display_box_levels.get(0)
            if bl0 <> null
                set box_fmt: this.spec_at(*bl0)
            if box_fmt <> null
            {
                ; the four \brdr<t l b r> sides (the reference iterates "tlbr")
                var side 0
                while side < 4
                {
                    this.raw("\\brdr")
                    if side = 0
                        this.put_c(0x74)
                    else if side = 1
                        this.put_c(0x6C)
                    else if side = 2
                        this.put_c(0x62)
                    else
                        this.put_c(0x72)
                    if box_fmt.line_thickness > 75
                    {
                        this.raw("\\brdrth\\brdrw")
                        this.raw_int(box_fmt.line_thickness / 2)
                    }
                    else
                    {
                        if box_fmt.line_double
                            this.raw("\\brdrdb")
                        else
                            this.raw("\\brdrs")
                        this.cw_int("\\brdrw", box_fmt.line_thickness)
                    }
                    var sep 0
                    if side = 0
                        set sep: this.box_top_sep
                    else if side = 1
                        set sep: this.box_left_sep
                    else if side = 3
                        set sep: this.box_right_sep
                    this.cw_int("\\brsp", sep)
                    if box_fmt.color <> 0
                        this.cw_int("\\brdrcf", box_fmt.color)
                    let li this.box_left_sep + box_fmt.left_indent + this.add_left_indent
                    if li <> 0
                        this.cw_int("\\li", li)
                    let ri this.box_right_sep + box_fmt.right_indent + this.add_right_indent
                    if ri <> 0
                        this.cw_int("\\ri", ri)
                    set side: side + 1
                }
            }
        }
        else
        {
            var need_li false
            if this.para.left_indent <> 0
                set need_li: true
            if this.add_left_indent <> 0
                set need_li: true
            if need_li
                this.cw_int("\\li", this.para.left_indent + this.add_left_indent)
            var need_ri false
            if this.para.right_indent <> 0
                set need_ri: true
            if this.add_right_indent <> 0
                set need_ri: true
            if need_ri
                this.cw_int("\\ri", this.para.right_indent + this.add_right_indent)
        }
    }

    ; must be called before any inline flow object
    function inline_prepare(this: ref[RtfFOTBuilder])
    {
        set this.follow_whitespace_char: false
        var mid false
        if this.inline_state = RTF_INLINE_MIDDLE
            set mid: true
        if this.inline_state = RTF_INLINE_FIELD
            set mid: true
        if this.inline_state = RTF_INLINE_FIELD_END
            set mid: true
        if mid
        {
            this.flush_fields()
            return
        }
        this.new_par(true)
        if this.para.line_spacing_at_least
            this.cw_int("\\sl", this.para.line_spacing)
        else
            this.cw_int("\\sl", 0 - this.para.line_spacing)
        var fli 0
        if this.continue_par = false
            set fli: this.para.first_line_indent
        if fli <> 0
            this.cw_int("\\fi", fli)
        if this.para.quadding <> 0x6C
        {
            this.raw("\\q")
            this.put(this.para.quadding as u8)
        }
        set this.inline_state: RTF_INLINE_MIDDLE
        this.put_c(0x20)
        this.flush_fields()
    }

    ; --- displayed flow objects ------------------------------------------------
    function start_display(this: ref[RtfFOTBuilder], nic: ref[DisplayNIC])
    {
        if this.span_display_levels <> 0
            set this.span_display_levels: this.span_display_levels + 1
        else
        {
            var spans false
            if this.spec.span
            {
                if this.page.n_columns > 1
                {
                    if this.table_level = 0
                        set spans: true
                }
            }
            if spans
            {
                set this.span_display_levels: 1
                set this.display_size: this.page.page_width - this.page.left_margin - this.page.right_margin
                this.display_size_changed()
            }
        }
        var space_before 0
        var keep_with_previous false
        var keep_sym 0
        var break_before 0
        var break_after 0
        var space_after 0
        var keep_with_next false
        set space_before: this.compute_length_spec(nic.space_before.nominal)
        set keep_with_previous: nic.keep_with_previous
        set keep_sym: nic.keep.code
        set break_before: nic.break_before.code
        set break_after: nic.break_after.code
        set space_after: this.compute_length_spec(nic.space_after.nominal)
        set keep_with_next: nic.keep_with_next
        if space_before > this.accum_space
            set this.accum_space: space_before
        if keep_with_previous
            set this.keep_with_next: true
        if this.inline_state <> RTF_INLINE_FIRST
        {
            if this.inline_state <> RTF_INLINE_TABLE
                set this.inline_state: RTF_INLINE_START
        }
        set this.continue_par: false
        var bb_page false
        if break_before = RSYM_PAGE
            set bb_page: true
        if break_before = RSYM_PAGE_REGION
            set bb_page: true
        if break_before = RSYM_COLUMN_SET
            set bb_page: true
        if bb_page
            set this.do_break: RTF_BREAK_PAGE
        else if break_before = RSYM_COLUMN
        {
            if this.do_break <> RTF_BREAK_PAGE
                set this.do_break: RTF_BREAK_COLUMN
        }
        let info this.push_display()
        set info.space_after: space_after
        set info.keep_with_next: keep_with_next
        set info.save_keep: this.keep
        var keeps false
        if keep_sym = RSYM_TRUE
            set keeps: true
        if keep_sym = RSYM_PAGE
            set keeps: true
        if keep_sym = RSYM_COLUMN_SET
            set keeps: true
        if keep_sym = RSYM_COLUMN
            set keeps: true
        if keeps
        {
            if this.keep = false
            {
                set this.had_par_in_keep: false
                set this.keep: true
            }
        }
        var ba_page false
        if break_after = RSYM_PAGE
            set ba_page: true
        if break_after = RSYM_PAGE_REGION
            set ba_page: true
        if break_after = RSYM_COLUMN_SET
            set ba_page: true
        if ba_page
            set info.break_after: RTF_BREAK_PAGE
        else if break_after = RSYM_COLUMN
            set info.break_after: RTF_BREAK_COLUMN
        else
            set info.break_after: RTF_BREAK_NONE
    }

    function end_display(this: ref[RtfFOTBuilder])
    {
        let info this.display_back()
        if info <> null
        {
            set this.do_break: info.break_after
            set this.keep: info.save_keep
            if this.inline_state <> RTF_INLINE_TABLE
            {
                if this.inline_state <> RTF_INLINE_FIRST
                    set this.inline_state: RTF_INLINE_START
                set this.continue_par: true
            }
            if info.space_after > this.accum_space
                set this.accum_space: info.space_after
            if info.keep_with_next
                set this.keep_with_next: true
        }
        set this.display_depth: this.display_depth - 1
        if this.span_display_levels <> 0
        {
            set this.span_display_levels: this.span_display_levels - 1
            if this.span_display_levels = 0
            {
                var ds this.page.page_width - this.page.left_margin - this.page.right_margin
                set ds: ds - (this.page.column_sep * (this.page.n_columns - 1))
                set ds: ds / this.page.n_columns
                set this.display_size: ds
                this.display_size_changed()
            }
        }
    }

    function start_paragraph(this: ref[RtfFOTBuilder], nic: ref[DisplayNIC])
    {
        this.start_display(nic)
        this.fo_start()
        this.push_para()
        RtfFOTBuilder.para_from_spec(&this.para, &this.spec)
    }

    function end_paragraph(this: ref[RtfFOTBuilder])
    {
        this.pop_para()
        this.end_display_group()
    }

    function paragraph_break(this: ref[RtfFOTBuilder], nic: ref[DisplayNIC])
    {
        if this.para_depth > 0
        {
            this.end_display()
            this.start_display(nic)
            RtfFOTBuilder.para_from_spec(&this.para, &this.spec)
        }
        this.fo_atomic()
    }

    function start_display_group(this: ref[RtfFOTBuilder], nic: ref[DisplayNIC])
    {
        this.start_display(nic)
        this.fo_start()
    }

    function end_display_group(this: ref[RtfFOTBuilder])
    {
        this.fo_end()
        this.end_display()
    }

    function start_sequence(this: ref[RtfFOTBuilder])
        this.fo_start()

    function end_sequence(this: ref[RtfFOTBuilder])
        this.fo_end()

    ; --- boxes ------------------------------------------------------------------
    function start_box(this: ref[RtfFOTBuilder], nic: ref[BoxNICRec], dnic: ref[DisplayNIC])
    {
        var is_display false
        set is_display: nic.is_display
        if is_display
        {
            this.start_display(dnic)
            if this.dbl_len = 0
            {
                set this.accum_space_box: this.accum_space
                set this.accum_space: 0
                set this.box_first_para: true
            }
            let d this.dbl_len as size_t
            if d < this.display_box_levels.get_length()
                this.display_box_levels.put(d, this.spec_depth)
            else
                this.display_box_levels.add(this.spec_depth)
            set this.dbl_len: this.dbl_len + 1
        }
        else
        {
            if this.spec.box_has_background
            {
                if this.spec.background_color <> 0
                    set this.spec.char_background_color: this.spec.background_color
            }
            if this.spec.box_has_border
            {
                if this.spec.char_border = false
                {
                    set this.spec.char_border: true
                    set this.spec.char_border_color: this.spec.color
                    set this.spec.char_border_thickness: this.spec.line_thickness
                    set this.spec.char_border_double: this.spec.line_double
                }
            }
            this.inline_prepare()
        }
        this.fo_start()
    }

    function end_box(this: ref[RtfFOTBuilder])
    {
        var ending_display_box false
        if this.dbl_len > 0
        {
            let lp this.display_box_levels.get((this.dbl_len - 1) as size_t)
            if lp <> null
            {
                if (*lp) + 1 = this.spec_depth
                    set ending_display_box: true
            }
        }
        if ending_display_box
        {
            if this.dbl_len = 1
            {
                if this.box_first_para
                {
                    set this.box_first_para: false
                    set this.box_left_sep: 0
                    set this.box_right_sep: 0
                    set this.box_top_sep: 0
                    var box_height this.accum_space
                    if box_height <= 0
                        set box_height: 1
                    set this.accum_space: this.accum_space_box
                    this.new_par(true)
                    this.raw("\\sl-")
                    this.raw_uint(box_height)
                }
                else if this.accum_space <> 0
                {
                    let extra this.accum_space
                    set this.accum_space: 0
                    set this.keep_with_next: true
                    this.new_par(true)
                    this.raw("\\sl-")
                    this.raw_uint(extra)
                }
                else
                    set this.accum_space: 0
                set this.dbl_len: this.dbl_len - 1
                this.raw("\\keepn\\par\\pard\\sl-1")
                if this.table_level <> 0
                    this.raw("\\intbl")
            }
            else
                set this.dbl_len: this.dbl_len - 1
            this.fo_end()
            this.end_display()
        }
        else
            this.fo_end()
    }

    ; --- line fields -------------------------------------------------------------
    function start_line_field(this: ref[RtfFOTBuilder])
    {
        this.fo_start()
        var opens false
        if this.inline_state = RTF_INLINE_START
            set opens: true
        if this.inline_state = RTF_INLINE_FIRST
            set opens: true
        if opens
        {
            set this.field_tab_pos: this.spec.field_width + this.para.left_indent
            if this.continue_par = false
                set this.field_tab_pos: this.field_tab_pos + this.para.first_line_indent
            this.inline_prepare()
            set this.inline_state: RTF_INLINE_FIELD
            if this.spec.field_align = RSYM_END
            {
                set this.cur_stream: RTF_ST_FIELD
                set this.inline_state: RTF_INLINE_FIELD_END
            }
            else if this.spec.field_align = RSYM_CENTER
            {
                var sep this.spec.field_width / 2
                if sep < 26
                    set sep: 26
                this.raw("\\tqc\\tx")
                this.raw_int(this.field_tab_pos - sep)
                this.cw_int("\\tx", this.field_tab_pos)
                this.raw("\\tab ")
            }
            else
            {
                this.cw_int("\\tx", this.field_tab_pos)
                this.put_c(0x20)
            }
        }
    }

    function end_line_field(this: ref[RtfFOTBuilder])
    {
        if this.inline_state = RTF_INLINE_FIELD_END
        {
            ; extract the captured field, strip trailing spaces, place the
            ; right tab (the reference sets osp_ back to the MAIN stream
            ; unconditionally — mirrored)
            let host this.host
            let captured this.fieldos
            set this.fieldos: Array[u8]^host()
            set this.cur_stream: RTF_ST_MAIN
            var len captured.get_length()
            var stripped 0
            while len > 0
            {
                let bp captured.get(len - 1)
                var is_space false
                if bp <> null
                {
                    if *bp = 0x20
                        set is_space: true
                }
                if is_space = false
                    break
                set len: len - 1
                set stripped: stripped + 1
            }
            ; each stripped space is assumed .25 em
            var sep stripped * this.out_fmt.font_size * 5 / 2
            if sep < 26
                set sep: 26
            this.raw("\\tqr\\tx")
            this.raw_int(this.field_tab_pos - sep)
            this.cw_int("\\tx", this.field_tab_pos)
            this.raw("\\tab ")
            var i: size_t 0
            while i < len
            {
                let bp2 captured.get(i)
                if bp2 <> null
                    this.put(*bp2)
                set i: i + 1
            }
            this.raw("\\tab ")
        }
        else if this.inline_state = RTF_INLINE_FIELD
        {
            this.raw("\\tab ")
            set this.inline_state: RTF_INLINE_MIDDLE
        }
        this.fo_end()
    }

    ; --- leaders -------------------------------------------------------------------
    function start_leader(this: ref[RtfFOTBuilder], nic: ref[LeaderNICRec])
    {
        this.fo_start()
        this.inline_prepare()
        this.sync_char_format()
        if this.leader_depth = 0
        {
            RtfFOTBuilder.copy_output_fmt(&this.leader_save_out_fmt, &this.out_fmt)
            set this.pre_leader_stream: this.cur_stream
            set this.pre_leader_discard: this.discard
            set this.discard: true
        }
        set this.leader_depth: this.leader_depth + 1
    }

    function end_leader(this: ref[RtfFOTBuilder])
    {
        set this.leader_depth: this.leader_depth - 1
        if this.leader_depth = 0
        {
            RtfFOTBuilder.copy_output_fmt(&this.out_fmt, &this.leader_save_out_fmt)
            set this.cur_stream: this.pre_leader_stream
            set this.discard: this.pre_leader_discard
            this.raw("\\tqr\\tldot\\tx")
            this.raw_int(this.display_size - this.para.right_indent)
            this.raw("\\tab ")
        }
        this.fo_end()
    }

    ; --- links -----------------------------------------------------------------------
    function start_link(this: ref[RtfFOTBuilder], nic: ref[LinkNICRec])
    {
        this.fo_start()
        if this.link_depth = 0
        {
            if this.inline_state = RTF_INLINE_MIDDLE
                this.do_start_link(nic)
            else
            {
                set this.pending_link: nic
                set this.have_pending_link: true
            }
        }
        set this.link_depth: this.link_depth + 1
    }

    function do_start_link(this: ref[RtfFOTBuilder], nic: ref[LinkNICRec])
    {
        var handled false
        if nic.addr_type = ADDR_IDREF
        {
            ; RtfFOTBuilder::doStartLink's idref arm = idrefButton over the
            ; params[0] prefix up to the FIRST space ("If they use multiple
            ; IDREFs, they'll only get the first"). No elementsRefed_ entry:
            ; the bookmark is emitted by whoever declares that ID.
            let idfull nic.p0
            let ln idfull.get_size()
            var i: size_t 0
            while i < ln
            {
                if idfull.get(i) = 0x20
                    break
                set i: i + 1
            }
            ; ★NOT StringC.substr: its copying init allocates through
            ; Page.get(this), and `this` is the caller's STACK return
            ; slot — the cut string comes back as NULs. Build it on the
            ; builder's own page instead.
            let h this.host
            let idp StringC^h(idfull.data_ptr(), i)
            let id *idp
            let anode nic.node
            this.raw("{\\field")
            this.raw("{\\*\\fldinst   ")
            this.raw("HYPERLINK  \\\\l ")
            this.output_bookmark_name_id(GroveInfo.index_of(anode), id)
            this.raw("}{\\fldrslt")
            this.put_c(0x20)
            set handled: true
        }
        else if nic.addr_type = ADDR_RESOLVED_NODE
        {
            let node nic.node
            if node <> null
            {
                let g GroveInfo.index_of(node)
                let id node.get_id()
                if id.get_size() > 0
                {
                    this.raw("{\\field")
                    this.raw("{\\*\\fldinst   ")
                    this.raw("HYPERLINK  \\\\l ")
                    this.output_bookmark_name_id(g, id)
                    this.raw("}{\\fldrslt")
                    this.put_c(0x20)
                    set handled: true
                }
                else
                {
                    let ei node.element_index
                    if ei >= 0
                    {
                        this.raw("{\\field")
                        this.raw("{\\*\\fldinst   ")
                        this.raw("HYPERLINK  \\\\l ")
                        this.output_bookmark_name_index(g, ei)
                        this.put_c(0x20)
                        this.raw("}{\\fldrslt ")
                        this.elements_refed_add(g, ei)
                        set handled: true
                    }
                }
            }
        }
        if handled = false
            this.raw("{{")
        RtfFOTBuilder.copy_output_fmt(&this.save_out_fmt, &this.out_fmt)
    }

    function end_link(this: ref[RtfFOTBuilder])
    {
        set this.link_depth: this.link_depth - 1
        if this.link_depth = 0
        {
            if this.have_pending_link
                set this.have_pending_link: false
            else
            {
                this.raw("}}")
                RtfFOTBuilder.copy_output_fmt(&this.out_fmt, &this.save_out_fmt)
            }
        }
        this.fo_end()
    }

    ; --- score ------------------------------------------------------------------------
    function start_score(this: ref[RtfFOTBuilder], nic: ref[ScoreNICRec])
    {
        if nic.kind = 3
        {
            if nic.sym.code = RSYM_AFTER
            {
                if this.spec.line_double
                    set this.spec.underline: RTF_UL_DOUBLE
                else if this.spec.score_spaces = false
                    set this.spec.underline: RTF_UL_WORDS
                else
                    set this.spec.underline: RTF_UL_SINGLE
            }
            else if nic.sym.code = RSYM_THROUGH
                set this.spec.is_strikethrough: true
        }
        this.fo_start()
    }

    function end_score(this: ref[RtfFOTBuilder])
        this.fo_end()

    ; --- rule ---------------------------------------------------------------------------
    function rule(this: ref[RtfFOTBuilder], nic: ref[RuleNICRec], dnic: ref[DisplayNIC])
    {
        var orientation RSYM_HORIZONTAL
        set orientation: nic.orientation.code
        if orientation = RSYM_HORIZONTAL
        {
            var line_offset 0
            var line_length 0 - 1
            var has_explicit false
            if nic.has_length
            {
                set line_length: this.compute_length_spec(nic.length)
                if line_length >= 0
                    set has_explicit: true
            }
            if has_explicit
            {
                if this.spec.display_alignment = 0x63
                    set line_offset: (this.display_size + this.spec.left_indent - this.spec.right_indent - line_length) / 2
                else if this.spec.display_alignment = 0x72
                    set line_offset: this.display_size - this.spec.right_indent - line_length
                else
                    set line_offset: this.spec.left_indent
            }
            else
            {
                set line_offset: this.spec.left_indent
                set line_length: this.display_size - this.spec.left_indent - this.spec.right_indent
            }
            this.start_display(dnic)
            this.new_par(false)
            this.raw("\\sl-1{\\*\\do\\dobxcolumn\\dobypara\\dodhgt0\\dpline\\dpptx0\\dppty0")
            this.cw_int("\\dpptx", line_length)
            this.raw("\\dppty0")
            this.cw_int("\\dpx", line_offset)
            this.raw("\\dpy0")
            this.cw_int("\\dpxsize", line_length)
            this.raw("\\dpysize0")
            if this.spec.color <> 0
            {
                let cp this.color_table.get((this.spec.color - 1) as size_t)
                if cp <> null
                {
                    let n *cp
                    this.cw_int("\\dplinecor", (n >> 16) & 0xFF)
                    this.cw_int("\\dplinecog", (n >> 8) & 0xFF)
                    this.cw_int("\\dplinecob", n & 0xFF)
                }
            }
            this.cw_int("\\dplinew", this.spec.line_thickness)
            this.raw("}")
            this.end_display()
        }
        else if orientation = RSYM_VERTICAL
        {
            this.start_display(dnic)
            this.new_par(true)
            if nic.has_length
            {
                let line_length this.compute_length_spec(nic.length)
                if line_length > 0
                {
                    this.raw("\\sl-")
                    this.raw_uint(line_length)
                }
            }
            this.end_display()
        }
        else
            this.inline_prepare()
        this.fo_atomic()
    }

    ; --- external graphic ------------------------------------------------------------------
    function external_graphic(this: ref[RtfFOTBuilder], nic: ref[GraphicNICRec], dnic: ref[DisplayNIC])
    {
        var is_display false
        set is_display: nic.is_display
        if is_display
        {
            this.start_display(dnic)
            this.new_par(true)
            if this.spec.display_alignment <> 0x6C
            {
                this.raw("\\q")
                this.put(this.spec.display_alignment as u8)
            }
            this.flush_fields()
        }
        else
            this.inline_prepare()
        this.include_picture(nic)
        if is_display
            this.end_display()
        this.fo_atomic()
    }

    ; includePicture: the OSFILE storage id becomes an INCLUDEPICTURE field.
    ; (Design-note deviation: the reference round-trips the system id through
    ; the entity manager — for the corpus the id IS the OSFILE spec id; a
    ; missing file's "cannot open" stderr is not reproduced here.)
    function include_picture(this: ref[RtfFOTBuilder], nic: ref[GraphicNICRec])
    {
        var sysid nic.entity_system_id
        if sysid.get_size() = 0
        {
            this.interp.message1(InterpreterMessages.systemIdNotFilename(), sysid)
            return
        }
        ; strip a leading <OSFILE> storage-spec prefix
        if sysid.get_size() > 8
        {
            let prefix sysid.substr(0, 8)
            if prefix.equals(StringC("<OSFILE>"))
                set sysid: sysid.substr(8, sysid.get_size() - 8)
        }
        this.raw("{\\field\\flddirty{\\*\\fldinst INCLUDEPICTURE \"")
        let n sysid.get_size()
        var i: size_t 0
        while i < n
        {
            let c sysid.get(i)
            if c = 0x5C
                this.raw("\\\\\\\\")
            else
                this.put((c & 0xFF) as u8)
            set i: i + 1
        }
        this.raw("\" }{\\fldrslt }}")
    }

    ; --- page numbers -----------------------------------------------------------------------
    function page_number(this: ref[RtfFOTBuilder])
    {
        this.inline_prepare()
        this.sync_char_format()
        this.raw("\\chpgn ")
    }

    function current_node_page_number(this: ref[RtfFOTBuilder], node: ref[GroveNode]?)
    {
        this.inline_prepare()
        this.sync_char_format()
        if node = null
            return
        let g GroveInfo.index_of(node)
        let id node.get_id()
        if id.get_size() > 0
        {
            this.raw("{\\field\\flddirty{\\*\\fldinst PAGEREF ")
            this.output_bookmark_name_id(g, id)
            this.raw("}{\\fldrslt 000}}")
        }
        else
        {
            let ei node.element_index
            if ei >= 0
            {
                this.raw("{\\field\\flddirty{\\*\\fldinst PAGEREF ")
                this.output_bookmark_name_index(g, ei)
                this.elements_refed_add(g, ei)
                this.raw("}{\\fldrslt 000}}")
            }
        }
    }

    ; --- simple page sequence + header/footer ---------------------------------
    ; ProcessContext protocol: start_simple_page_sequence, then per page type
    ; i (0..3) and HF sosofo j (0..5) the part content processes against the
    ; sink followed by end_simple_page_sequence_header_footer(i | j*4), then
    ; end_all_..., the content, end_simple_page_sequence. The reference
    ; brackets each part with startSimplePageSequenceHeaderFooter /
    ; endSimplePageSequenceHeaderFooter(k); the fused equivalent arms the HF
    ; capture after the serial body and re-arms after each extraction.
    function arm_hf_capture(this: ref[RtfFOTBuilder])
    {
        set this.inline_state: RTF_INLINE_MIDDLE
        RtfFOTBuilder.output_fmt_defaults(&this.out_fmt)
        set this.cur_stream: RTF_ST_HF
    }

    function start_simple_page_sequence(this: ref[RtfFOTBuilder])
    {
        set this.in_simple_page_sequence: this.in_simple_page_sequence + 1
        this.fo_start()
        if this.do_balance
        {
            this.raw("\\sect\\sbknone")
            set this.do_balance: false
        }
        if this.had_section
            this.raw("\\sect")
        else
            set this.had_section: true
        if this.page.header_margin < RTF_HF_PRE_SPACE
            set this.page.header_margin: RTF_HF_PRE_SPACE
        if this.page.footer_margin < RTF_HF_POST_SPACE
            set this.page.footer_margin: RTF_HF_POST_SPACE
        ; Word 97 gets confused by top/bottom margins less than 12pt
        if this.page.top_margin < 240
            set this.page.top_margin: 240
        if this.page.bottom_margin < 240
            set this.page.bottom_margin: 240
        this.raw("\\sectd\\plain")
        if this.page.page_width > this.page.page_height
            this.raw("\\lndscpsxn")
        this.cw_int("\\pgwsxn", this.page.page_width)
        this.cw_int("\\pghsxn", this.page.page_height)
        this.cw_int("\\marglsxn", this.page.left_margin)
        this.cw_int("\\margrsxn", this.page.right_margin)
        this.cw_int("\\margtsxn", this.page.top_margin)
        this.cw_int("\\margbsxn", this.page.bottom_margin)
        this.raw("\\headery0\\footery0\\pgn")
        this.emit_pgn_name(this.page.page_number_format)
        if this.page.page_number_restart
            this.raw("\\pgnrestart")
        set this.display_size: this.page.page_width - this.page.left_margin - this.page.right_margin
        set this.current_cols: 1
        if this.page.n_columns > 1
        {
            set this.display_size: this.display_size - (this.page.column_sep * (this.page.n_columns - 1))
            set this.display_size: this.display_size / this.page.n_columns
        }
        if this.page.balance
            set this.do_balance: true
        this.display_size_changed()
        RtfFOTBuilder.output_fmt_defaults(&this.out_fmt)
        set this.do_break: RTF_BREAK_NONE
        set this.suppress_bookmarks: true
        set this.accum_space: 0
        ; save the output format once; the reference start/end HF brackets
        ; round-trip it per part
        RtfFOTBuilder.copy_output_fmt(&this.save_out_fmt, &this.out_fmt)
        this.arm_hf_capture()
    }

    function emit_pgn_name(this: ref[RtfFOTBuilder], fmt: int)
    {
        if fmt = RTF_PGN_UCLTR
            this.raw("ucltr")
        else if fmt = RTF_PGN_LCLTR
            this.raw("lcltr")
        else if fmt = RTF_PGN_UCRM
            this.raw("ucrm")
        else if fmt = RTF_PGN_LCRM
            this.raw("lcrm")
        else
            this.raw("dec")
    }

    function end_simple_page_sequence_header_footer(this: ref[RtfFOTBuilder], flags: int)
    {
        RtfFOTBuilder.copy_output_fmt(&this.out_fmt, &this.save_out_fmt)
        let host this.host
        let captured this.hfos
        set this.hfos: Array[u8]^host()
        set this.cur_stream: RTF_ST_MAIN
        this.hf_parts.put(flags as size_t, captured)
        this.arm_hf_capture()
    }

    function hf_equal(this: ref[RtfFOTBuilder], a: int, b: int) returns bool
    {
        let ap this.hf_parts.get(a as size_t)
        let bp this.hf_parts.get(b as size_t)
        if ap = null
            return bp = null
        if bp = null
            return false
        let av *ap
        let bv *bp
        let n av.get_length()
        if n <> bv.get_length()
            return false
        var i: size_t 0
        while i < n
        {
            let x av.get(i)
            let y bv.get(i)
            if x <> null
            {
                if y <> null
                {
                    if *x <> *y
                        return false
                }
            }
            set i: i + 1
        }
        true
    }

    function end_all_simple_page_sequence_header_footer(this: ref[RtfFOTBuilder])
    {
        ; undo the last arm
        set this.cur_stream: RTF_ST_MAIN
        RtfFOTBuilder.copy_output_fmt(&this.out_fmt, &this.save_out_fmt)
        ; firstHF=1 frontHF=2 headerHF=4 centerHF=8 rightHF=16; nHF=24
        var title_page false
        var i 0
        while i < 24
        {
            if this.hf_equal(i | 2 | 1, i | 2) = false
                set title_page: true
            if this.hf_equal(i | 1, i) = false
                set title_page: true
            if title_page
                break
            set i: i + 4
        }
        if title_page
        {
            this.raw("\\titlepg")
            this.output_header_footer("f", 2 | 1)
        }
        this.output_header_footer("l", 0)
        this.output_header_footer("r", 2)
        var k 0
        while k < 24
        {
            let host this.host
            this.hf_parts.put(k as size_t, Array[u8]^host())
            set k: k + 1
        }
        set this.inline_state: RTF_INLINE_FIRST
        set this.continue_par: false
        set this.suppress_bookmarks: false
    }

    function emit_hf_part(this: ref[RtfFOTBuilder], k: int)
    {
        let pp this.hf_parts.get(k as size_t)
        if pp = null
            return
        let part *pp
        let n part.get_length()
        var i: size_t 0
        while i < n
        {
            let bp part.get(i)
            if bp <> null
                this.put(*bp)
            set i: i + 1
        }
    }

    ; headerHF=4, footerHF=0; leftHF=0, centerHF=8, rightHF=16
    function output_header_footer(this: ref[RtfFOTBuilder], suffix: pointer[const_char], flags: int)
    {
        let hspan this.page.page_width - this.page.left_margin - this.page.right_margin
        this.raw("{\\header")
        this.raw(suffix)
        this.raw("\\pard\\sl")
        this.raw_int(0 - (RTF_HF_PRE_SPACE + RTF_HF_POST_SPACE))
        this.cw_int("\\sb", this.page.header_margin - RTF_HF_PRE_SPACE)
        this.cw_int("\\sa", this.page.top_margin - RTF_HF_POST_SPACE - this.page.header_margin)
        this.raw("\\plain\\tqc\\tx")
        this.raw_int(hspan / 2)
        this.cw_int("\\tqr\\tx", hspan)
        this.put_c(0x20)
        this.put_c(0x7B)
        this.emit_hf_part(flags | 4)
        this.put_c(0x7D)
        this.raw("\\tab ")
        this.put_c(0x7B)
        this.emit_hf_part(flags | 4 | 8)
        this.put_c(0x7D)
        this.raw("\\tab ")
        this.put_c(0x7B)
        this.emit_hf_part(flags | 4 | 16)
        this.put_c(0x7D)
        this.raw("\\par}")
        this.raw("{\\footer")
        this.raw(suffix)
        this.raw("\\pard\\sl")
        this.raw_int(0 - (RTF_HF_PRE_SPACE + RTF_HF_POST_SPACE))
        this.cw_int("\\sb", this.page.bottom_margin - RTF_HF_PRE_SPACE - this.page.footer_margin)
        this.cw_int("\\sa", this.page.footer_margin - RTF_HF_POST_SPACE)
        this.raw("\\plain\\tqc\\tx")
        this.raw_int(hspan / 2)
        this.cw_int("\\tqr\\tx", hspan)
        this.put_c(0x20)
        this.put_c(0x7B)
        this.emit_hf_part(flags)
        this.put_c(0x7D)
        this.raw("\\tab ")
        this.put_c(0x7B)
        this.emit_hf_part(flags | 8)
        this.put_c(0x7D)
        this.raw("\\tab ")
        this.put_c(0x7B)
        this.emit_hf_part(flags | 16)
        this.put_c(0x7D)
        this.raw("\\par}")
    }

    function end_simple_page_sequence(this: ref[RtfFOTBuilder])
    {
        if this.inline_state <> RTF_INLINE_FIRST
        {
            if this.hyphenate_suppressed
            {
                this.raw("\\hyphpar0")
                set this.hyphenate_suppressed: false
            }
            this.raw("\\par")
        }
        set this.inline_state: RTF_INLINE_FIRST
        set this.continue_par: false
        this.fo_end()
        set this.in_simple_page_sequence: this.in_simple_page_sequence - 1
        if this.in_simple_page_sequence = 0
            this.page_from_back()
        set this.do_break: RTF_BREAK_NONE
    }

    ; --- tables ------------------------------------------------------------------
    function start_table(this: ref[RtfFOTBuilder], tnic: ref[TableNICRec], dnic: ref[DisplayNIC])
    {
        this.start_display(dnic)
        this.fo_start()
        if this.table_level <> 0
        {
            set this.table_level: this.table_level + 1
            this.interp.message0(InterpreterMessages.nestedTable())
            return
        }
        set this.table_level: 1
        var explicit_width false
        if tnic.width_type = 2
            set explicit_width: true
        if explicit_width
            set this.table_width: this.compute_length_spec(tnic.width)
        else
            set this.table_width: this.display_size - this.spec.left_indent - this.spec.right_indent
        set this.table_display_size: this.display_size
        set this.table_left_indent: this.spec.left_indent
        set this.table_right_indent: this.spec.right_indent
        set this.table_alignment: this.spec.display_alignment
        if this.table_alignment = 0x72
        {
            if this.table_right_indent <> 0
            {
                set this.table_alignment: 0x6C
                set this.table_left_indent: this.table_display_size - this.table_width - this.table_right_indent
            }
        }
        else if this.table_alignment = 0x63
        {
            var off_center false
            if this.table_left_indent <> 0
                set off_center: true
            if this.table_right_indent <> 0
                set off_center: true
            if off_center
            {
                set this.table_alignment: 0x6C
                set this.table_left_indent: (this.table_display_size - this.table_width + this.table_left_indent - this.table_right_indent) / 2
            }
        }
    }

    function end_table(this: ref[RtfFOTBuilder])
    {
        set this.table_level: this.table_level - 1
        if this.table_level = 0
        {
            if this.rows.get_length() > 0
                this.output_table()
            if this.inline_state = RTF_INLINE_TABLE
            {
                RtfFOTBuilder.output_fmt_defaults(&this.out_fmt)
                this.raw("\\pard\\plain\\sl-1")
                set this.inline_state: RTF_INLINE_START
            }
            set this.display_size: this.table_display_size
        }
        this.fo_end()
        this.end_display()
    }

    function start_table_part_serial(this: ref[RtfFOTBuilder], dnic: ref[DisplayNIC])
    {
        this.start_display(dnic)
        this.fo_start()
    }

    function end_table_part_serial(this: ref[RtfFOTBuilder])
    {
        if this.table_level = 1
        {
            if this.rows.get_length() > 0
            {
                this.output_table()
                set this.n_header_rows: 0
            }
        }
        this.fo_end()
        this.end_display()
    }

    function start_table_part_header(this: ref[RtfFOTBuilder])
    {
        if this.table_level = 1
            set this.in_table_header: true
    }

    function end_table_part_header(this: ref[RtfFOTBuilder])
    {
        if this.table_level = 1
            set this.in_table_header: false
    }

    function start_table_part_footer(this: ref[RtfFOTBuilder])
    {
    }

    function end_table_part_footer(this: ref[RtfFOTBuilder])
    {
    }

    function ensure_columns(this: ref[RtfFOTBuilder], n: int)
    {
        let host this.host
        while this.columns.get_length() < (n as size_t)
            this.columns.add(RtfColumn.make(host))
    }

    function table_column(this: ref[RtfFOTBuilder], nic: ref[TableColumnNICRec])
    {
        if this.table_level = 1
        {
            if nic.n_columns_spanned = 1
            {
                this.ensure_columns(nic.column_index + 1)
                let cp this.columns.get(nic.column_index as size_t)
                if cp <> null
                {
                    let col *cp
                    set col.has_width: nic.has_width
                    if nic.has_width
                    {
                        set col.width: nic.width
                        set col.tfactor: nic.width_tfactor
                    }
                }
            }
        }
        this.fo_atomic()
    }

    function current_row(this: ref[RtfFOTBuilder]) returns ref[Array[ref[RtfCell]?]]?
    {
        let rp this.rows.get(this.rows.get_length() - 1)
        if rp = null
            return null
        *rp
    }

    function row_cell(this: ref[RtfFOTBuilder], row: ref[Array[ref[RtfCell]?]], j: int) returns ref[RtfCell]?
    {
        let cp row.get(j as size_t)
        if cp = null
            return null
        *cp
    }

    function ensure_row_cells(this: ref[RtfFOTBuilder], row: ref[Array[ref[RtfCell]?]], n: int)
    {
        let host this.host
        while row.get_length() < (n as size_t)
            row.add(RtfCell.make(host))
    }

    function start_table_row(this: ref[RtfFOTBuilder])
    {
        if this.table_level <> 1
        {
            this.fo_start()
            return
        }
        if this.inline_state = RTF_INLINE_START
        {
            if this.accum_space <> 0
                this.cw_int("\\sa", this.accum_space)
            if this.keep_with_next
                this.raw("\\keepn")
            this.raw("\\par")
        }
        set this.keep_with_next: false
        set this.accum_space: 0
        let host this.host
        this.rows.add(Array[ref[RtfCell]?]^host())
        this.fo_start()
    }

    function end_table_row(this: ref[RtfFOTBuilder])
    {
        if this.table_level <> 1
        {
            this.fo_end()
            return
        }
        if this.in_table_header
        {
            ; move the just-finished row up to the header block
            let n this.rows.get_length()
            let hp this.rows.get(n - 1)
            if hp <> null
            {
                let header_row *hp
                var i (n as int) - 1
                while i > this.n_header_rows
                {
                    let pp this.rows.get((i - 1) as size_t)
                    if pp <> null
                        this.rows.put(i as size_t, *pp)
                    set i: i - 1
                }
                this.rows.put(this.n_header_rows as size_t, header_row)
                set this.n_header_rows: this.n_header_rows + 1
            }
        }
        this.fo_end()
        set this.inline_state: RTF_INLINE_TABLE
    }

    function start_table_cell(this: ref[RtfFOTBuilder], nic: ref[TableCellNICRec])
    {
        if this.table_level <> 1
        {
            this.fo_start()
            return
        }
        let row this.current_row()
        if row = null
        {
            this.fo_start()
            return
        }
        this.ensure_row_cells(row, nic.column_index + 1)
        set this.cell_index: nic.column_index
        let cell this.row_cell(row, this.cell_index)
        if cell <> null
        {
            if nic.missing
                set cell.present: false
            else
                set cell.present: true
            set cell.span: nic.n_columns_spanned
            set cell.vspan: nic.n_rows_spanned
            set cell.has_background: this.spec.cell_background
            if this.spec.cell_background
                set cell.background_color: this.spec.background_color
            set cell.valign: this.spec.cell_vertical_alignment
        }
        ; guess the display size for the cell content
        var has_width true
        var new_display_size 0
        set this.display_size: this.table_display_size
        var i this.cell_index
        while i < (this.cell_index + nic.n_columns_spanned)
        {
            var col: ref[RtfColumn]? null
            if (i as size_t) < this.columns.get_length()
            {
                let cp2 this.columns.get(i as size_t)
                if cp2 <> null
                    set col: *cp2
            }
            var this_has false
            if col <> null
                set this_has: col.has_width
            if this_has = false
            {
                set has_width: false
                break
            }
            set new_display_size: new_display_size + this.compute_length_spec(col.width)
            set i: i + 1
        }
        if has_width = false
        {
            var ncols this.columns.get_length() as int
            if ncols = 0
                set ncols: 2
            set new_display_size: (this.table_width * nic.n_columns_spanned) / ncols
        }
        set this.cur_stream: RTF_ST_CELL
        set this.inline_state: RTF_INLINE_FIRST
        set this.continue_par: false
        set this.add_left_indent: this.spec.cell_left_margin
        set this.add_right_indent: this.spec.cell_right_margin
        set this.accum_space: this.spec.cell_top_margin
        set this.display_size: new_display_size
        this.display_size_changed()
        this.fo_start()
        this.raw("\\plain ")
        RtfFOTBuilder.output_fmt_defaults(&this.out_fmt)
    }

    function end_table_cell(this: ref[RtfFOTBuilder])
    {
        if this.table_level <> 1
        {
            this.fo_end()
            return
        }
        set this.accum_space: this.accum_space + this.spec.cell_bottom_margin
        if this.accum_space > 0
        {
            if this.inline_state = RTF_INLINE_FIRST
            {
                this.raw("\\pard\\intbl\\sl-")
                this.raw_uint(this.accum_space)
                this.raw("\\par")
            }
            else
                this.cw_int("\\sa", this.accum_space)
        }
        else
        {
            if this.inline_state = RTF_INLINE_FIRST
                this.raw("\\intbl")
        }
        set this.accum_space: 0
        ; extract the captured cell content
        let host this.host
        let captured this.cellos
        set this.cellos: Array[u8]^host()
        let row this.current_row()
        if row <> null
        {
            let cell this.row_cell(row, this.cell_index)
            if cell <> null
                set cell.content: captured
        }
        this.fo_end()
        set this.cur_stream: RTF_ST_MAIN
        set this.accum_space: 0
        set this.add_left_indent: 0
        set this.add_right_indent: 0
        set this.keep_with_next: false
    }

    ; --- table borders ----------------------------------------------------------
    function store_border(this: ref[RtfFOTBuilder], b: ref[RtfBorder])
    {
        set b.flags: 0
        if this.spec.border_present
        {
            set b.flags: RTF_BORDER_PRESENT
            set b.thickness: this.spec.line_thickness
            set b.color: this.spec.color
            if this.spec.line_double
                set b.flags: b.flags | RTF_BORDER_DOUBLE
        }
        if this.spec.border_omit_at_break
            set b.flags: b.flags | RTF_BORDER_OMIT
        set b.priority: this.spec.border_priority
        this.fo_atomic()
    }

    function table_before_row_border(this: ref[RtfFOTBuilder])
    {
        if this.table_level = 1
        {
            let tb0 this.table_border_at(0)
            this.store_border(tb0)
        }
    }

    function table_after_row_border(this: ref[RtfFOTBuilder])
    {
        if this.table_level = 1
        {
            let tb1 this.table_border_at(1)
            this.store_border(tb1)
        }
    }

    function table_before_column_border(this: ref[RtfFOTBuilder])
    {
        if this.table_level = 1
        {
            let tb2 this.table_border_at(2)
            this.store_border(tb2)
        }
    }

    function table_after_column_border(this: ref[RtfFOTBuilder])
    {
        if this.table_level = 1
        {
            let tb3 this.table_border_at(3)
            this.store_border(tb3)
        }
    }

    function cell_border_at(this: ref[RtfFOTBuilder], cell: ref[RtfCell], k: int) returns ref[RtfBorder]?
        cell.border_at(k)

    function table_border_at(this: ref[RtfFOTBuilder], k: int) returns ref[RtfBorder]?
    {
        let p this.tborders.get(k as size_t)
        if p = null
            return null
        *p
    }

    function table_cell_before_row_border(this: ref[RtfFOTBuilder])
    {
        if this.table_level = 1
            this.store_cell_border(0)
    }

    function table_cell_after_row_border(this: ref[RtfFOTBuilder])
    {
        if this.table_level = 1
            this.store_cell_border(1)
    }

    function table_cell_before_column_border(this: ref[RtfFOTBuilder])
    {
        if this.table_level = 1
            this.store_cell_border(2)
    }

    function table_cell_after_column_border(this: ref[RtfFOTBuilder])
    {
        if this.table_level = 1
            this.store_cell_border(3)
    }

    function store_cell_border(this: ref[RtfFOTBuilder], k: int)
    {
        let row this.current_row()
        if row = null
            return
        let cell this.row_cell(row, this.cell_index)
        if cell = null
            return
        let cbk this.cell_border_at(cell, k)
        this.store_border(cbk)
    }

    function border_assign(this: ref[RtfFOTBuilder], dst: ref[RtfBorder], src: ref[RtfBorder])
    {
        set dst.priority: src.priority
        set dst.flags: src.flags
        set dst.thickness: src.thickness
        set dst.color: src.color
    }

    function resolve_border(this: ref[RtfFOTBuilder], b1: ref[RtfBorder], b2: ref[RtfBorder])
    {
        if b1.priority <> b2.priority
        {
            if b1.priority > b2.priority
                this.border_assign(b2, b1)
            else
                this.border_assign(b1, b2)
        }
        else
        {
            ; bitwise XOR is the word operator (`^` is the lifetime sigil)
            if ((b1.flags xor b2.flags) & RTF_BORDER_PRESENT) <> 0
            {
                if (b1.flags & RTF_BORDER_PRESENT) <> 0
                    this.border_assign(b2, b1)
                else
                    this.border_assign(b1, b2)
            }
        }
    }

    function resolve_outside_border(this: ref[RtfFOTBuilder], cell_border: ref[RtfBorder], table_border: ref[RtfBorder])
    {
        var wins false
        if table_border.priority > cell_border.priority
            set wins: true
        if table_border.priority = cell_border.priority
        {
            if (table_border.flags & RTF_BORDER_PRESENT) <> 0
                set wins: true
        }
        if wins
            this.border_assign(cell_border, table_border)
    }

    function output_table_border(this: ref[RtfFOTBuilder], b: ref[RtfBorder])
    {
        if b.thickness > 75
        {
            this.raw("\\brdrth\\brdrw")
            this.raw_int(b.thickness / 2)
        }
        else if (b.flags & RTF_BORDER_DOUBLE) <> 0
            this.cw_int("\\brdrdb\\brdrw", b.thickness)
        else
            this.cw_int("\\brdrs\\brdrw", b.thickness)
        if b.color <> 0
            this.cw_int("\\brdrcf", b.color)
    }

    ; outputTable (RtfFOTBuilder.cxx 2740-2906)
    function output_table(this: ref[RtfFOTBuilder])
    {
        let host this.host
        let n_rows this.rows.get_length()
        ; ensure columns_ spans every row (the trailing cell is a dummy)
        var i: size_t 0
        while i < n_rows
        {
            let rp this.rows.get(i)
            if rp <> null
            {
                let row *rp
                var last_is_dummy false
                var j 0
                while (j as size_t) < row.get_length()
                {
                    let cell this.row_cell(row, j)
                    if cell = null
                        break
                    if cell.present
                        set last_is_dummy: false
                    else
                        set last_is_dummy: true
                    set j: j + cell.span
                }
                if last_is_dummy
                    set j: j - 1
                if (j as size_t) > this.columns.get_length()
                    this.ensure_columns(j)
            }
            set i: i + 1
        }
        ; resize every row to the column count (the reference resize SHRINKS
        ; rows carrying the trailing dummy cell and GROWS short rows,
        ; replicating a trailing non-present cell)
        let n_cols this.columns.get_length() as int
        set i: 0
        while i < n_rows
        {
            let rp2 this.rows.get(i)
            if rp2 <> null
            {
                let row *rp2
                let old_size row.get_length() as int
                if old_size > n_cols
                {
                    ; truncate (Array cannot shrink — rebuild)
                    let host2 this.host
                    let fresh Array[ref[RtfCell]?]^host2()
                    var t 0
                    while t < n_cols
                    {
                        let cpt row.get(t as size_t)
                        if cpt <> null
                            fresh.add(*cpt)
                        set t: t + 1
                    }
                    this.rows.put(i, fresh)
                }
                else if old_size < n_cols
                {
                    this.ensure_row_cells(row, n_cols)
                    if old_size > 0
                    {
                        let last this.row_cell(row, old_size - 1)
                        if last <> null
                        {
                            if last.present = false
                            {
                                var j2 old_size
                                while j2 < n_cols
                                {
                                    let c2 this.row_cell(row, j2)
                                    if c2 <> null
                                        c2.assign_from(last)
                                    set j2: j2 + 1
                                }
                            }
                        }
                    }
                }
            }
            set i: i + 1
        }
        ; vertical spanning: mark continuation cells, push the bottom border
        set i: 0
        while i < n_rows
        {
            let rp3 this.rows.get(i)
            if rp3 <> null
            {
                let row *rp3
                var j 0
                while (j as size_t) < row.get_length()
                {
                    let cell this.row_cell(row, j)
                    if cell = null
                        break
                    if cell.vspan > 1
                    {
                        if (i as int) + cell.vspan > (n_rows as int)
                            set cell.vspan: (n_rows as int) - (i as int)
                        var k 1
                        while k < cell.vspan
                        {
                            let rpk this.rows.get(i + (k as size_t))
                            var below: ref[RtfCell]? null
                            if rpk <> null
                                set below: this.row_cell(*rpk, j)
                            if below <> null
                            {
                                if below.present
                                {
                                    set cell.vspan: k
                                    break
                                }
                                set below.vspan: 0
                                set below.present: true
                                set below.span: cell.span
                                let vb1 this.cell_border_at(below, 2)
                                let vb2 this.cell_border_at(cell, 2)
                                this.border_assign(vb1, vb2)
                                let vb3 this.cell_border_at(below, 3)
                                let vb4 this.cell_border_at(cell, 3)
                                this.border_assign(vb3, vb4)
                            }
                            set k: k + 1
                        }
                        let rpl this.rows.get(i + ((cell.vspan - 1) as size_t))
                        if rpl <> null
                        {
                            let bottom this.row_cell(*rpl, j)
                            if bottom <> null
                            {
                                let vb5 this.cell_border_at(bottom, 1)
                                let vb6 this.cell_border_at(cell, 1)
                                this.border_assign(vb5, vb6)
                            }
                        }
                        let cbb this.cell_border_at(cell, 1)
                        set cbb.flags: 0
                    }
                    set j: j + cell.span
                }
            }
            set i: i + 1
        }
        ; column widths
        let widths Array[int]^host()
        var wi 0
        while wi < n_cols
        {
            widths.add(0)
            set wi: wi + 1
        }
        var n_explicit 0
        var total_explicit 0
        var total_table_units 0.0
        set this.display_size: this.table_display_size
        var ci 0
        while ci < n_cols
        {
            let cp this.columns.get(ci as size_t)
            if cp <> null
            {
                let col *cp
                if col.has_width
                {
                    let w this.compute_length_spec(col.width)
                    widths.put(ci as size_t, w)
                    set n_explicit: n_explicit + 1
                    set total_explicit: total_explicit + w
                    set total_table_units: total_table_units + col.tfactor
                }
            }
            set ci: ci + 1
        }
        var table_unit_width 0.0
        set total_table_units: total_table_units + ((n_cols - n_explicit) as double)
        if total_table_units <> 0.0
            set table_unit_width: ((this.table_width - total_explicit) as double) / total_table_units
        set ci: 0
        while ci < n_cols
        {
            let cp2 this.columns.get(ci as size_t)
            if cp2 <> null
            {
                let col *cp2
                if col.has_width = false
                    widths.put(ci as size_t, table_unit_width as int)
                else
                {
                    if col.tfactor > 0.0
                    {
                        let wp widths.get(ci as size_t)
                        if wp <> null
                            widths.put(ci as size_t, *wp + ((col.tfactor * table_unit_width) as int))
                    }
                }
            }
            set ci: ci + 1
        }
        ; outside borders on the first/last row
        if n_rows > 0
        {
            let frp this.rows.get(0)
            if frp <> null
            {
                let frow *frp
                var j3 0
                while (j3 as size_t) < frow.get_length()
                {
                    let c3 this.row_cell(frow, j3)
                    if c3 = null
                        break
                    let rb1 this.cell_border_at(c3, 0)
                    let rb2 this.table_border_at(0)
                    this.resolve_outside_border(rb1, rb2)
                    set j3: j3 + c3.span
                }
            }
            let lrp this.rows.get(n_rows - 1)
            if lrp <> null
            {
                let lrow *lrp
                var j4 0
                while (j4 as size_t) < lrow.get_length()
                {
                    let c4 this.row_cell(lrow, j4)
                    if c4 = null
                        break
                    let rb3 this.cell_border_at(c4, 1)
                    let rb4 this.table_border_at(1)
                    this.resolve_outside_border(rb3, rb4)
                    set j4: j4 + c4.span
                }
            }
        }
        ; per-row: resolve column borders, then adjacent-row borders, then emit
        set i: 0
        while i < n_rows
        {
            let rp4 this.rows.get(i)
            if rp4 = null
            {
                set i: i + 1
                continue
            }
            let row *rp4
            if row.get_length() > 0
            {
                let first this.row_cell(row, 0)
                if first <> null
                {
                    let rb5 this.cell_border_at(first, 2)
                    let rb6 this.table_border_at(2)
                    this.resolve_outside_border(rb5, rb6)
                    var prev 0
                    var j5 first.span
                    while (j5 as size_t) < row.get_length()
                    {
                        let cj this.row_cell(row, j5)
                        if cj = null
                            break
                        let cprev this.row_cell(row, prev)
                        if cprev <> null
                        {
                            let rb7 this.cell_border_at(cprev, 3)
                            let rb8 this.cell_border_at(cj, 2)
                            this.resolve_border(rb7, rb8)
                        }
                        set prev: j5
                        set j5: j5 + cj.span
                    }
                    if j5 = n_cols
                    {
                        let cprev2 this.row_cell(row, prev)
                        if cprev2 <> null
                        {
                            let rb9 this.cell_border_at(cprev2, 3)
                            let rb10 this.table_border_at(3)
                            this.resolve_outside_border(rb9, rb10)
                        }
                    }
                }
            }
            if (i + 1) < n_rows
            {
                let nrp this.rows.get(i + 1)
                if nrp <> null
                {
                    let nrow *nrp
                    var j2b 0
                    var j1 0
                    while (j1 as size_t) < row.get_length()
                    {
                        let c1 this.row_cell(row, j1)
                        if c1 = null
                            break
                        while j2b < j1
                        {
                            if (j2b as size_t) >= nrow.get_length()
                                break
                            let cb this.row_cell(nrow, j2b)
                            if cb = null
                                break
                            set j2b: j2b + cb.span
                        }
                        if j1 = j2b
                        {
                            if (j2b as size_t) < nrow.get_length()
                            {
                                let cb2 this.row_cell(nrow, j2b)
                                if cb2 <> null
                                {
                                    if c1.span = cb2.span
                                    {
                                        let rb11 this.cell_border_at(c1, 1)
                                        let rb12 this.cell_border_at(cb2, 0)
                                        this.resolve_border(rb11, rb12)
                                    }
                                }
                            }
                        }
                        set j1: j1 + c1.span
                    }
                }
            }
            this.raw("\\trowd")
            var trleft false
            if this.table_alignment = 0x6C
            {
                if this.table_left_indent <> 0
                    set trleft: true
            }
            if trleft
                this.cw_int("\\trleft", this.table_left_indent)
            else
            {
                this.raw("\\trq")
                this.put(this.table_alignment as u8)
            }
            if this.keep
                this.raw("\\trkeep")
            if (i as int) < this.n_header_rows
                this.raw("\\trhdr")
            this.put_c(0x20)
            var pos this.table_left_indent
            var j6 0
            while (j6 as size_t) < row.get_length()
            {
                let cell this.row_cell(row, j6)
                if cell = null
                    break
                if cell.vspan = 0
                    this.raw("\\clvmrg")
                else
                {
                    if cell.vspan > 1
                        this.raw("\\clvmgf")
                    this.raw("\\clvertal")
                    this.put(cell.valign as u8)
                }
                var k2 0
                while k2 < 4
                {
                    let b this.cell_border_at(cell, k2)
                    if (b.flags & RTF_BORDER_PRESENT) <> 0
                    {
                        this.raw("\\clbrdr")
                        if k2 = 0
                            this.put_c(0x74)
                        else if k2 = 1
                            this.put_c(0x62)
                        else if k2 = 2
                            this.put_c(0x6C)
                        else
                            this.put_c(0x72)
                        this.output_table_border(b)
                    }
                    set k2: k2 + 1
                }
                if cell.has_background
                {
                    if cell.background_color <> 0
                        this.cw_int("\\clshdng10000\\clcfpat", cell.background_color)
                }
                var k3 0
                while k3 < cell.span
                {
                    let wp2 widths.get((j6 + k3) as size_t)
                    if wp2 <> null
                        set pos: pos + *wp2
                    set k3: k3 + 1
                }
                this.cw_int("\\cellx", pos)
                set j6: j6 + cell.span
            }
            this.put_c(0x20)
            var j7 0
            while (j7 as size_t) < row.get_length()
            {
                let cell2 this.row_cell(row, j7)
                if cell2 = null
                    break
                var content_len: size_t 0
                if cell2.content <> null
                    set content_len: cell2.content.get_length()
                if content_len = 0
                {
                    if j7 = 0
                        this.raw("\\intbl")
                }
                else
                {
                    var bi: size_t 0
                    while bi < content_len
                    {
                        let bp cell2.content.get(bi)
                        if bp <> null
                            this.put(*bp)
                        set bi: bi + 1
                    }
                    if this.keep
                        this.raw("\\keepn")
                }
                this.raw("\\cell ")
                set j7: j7 + cell2.span
            }
            this.raw("\\row ")
            set i: i + 1
        }
        set this.columns: Array[ref[RtfColumn]?]^host()
        set this.rows: Array[ref[Array[ref[RtfCell]?]]?]^host()
    }

    ; --- finish: prolog + patched body ------------------------------------------
    ; The reference destructor. Returns the complete RTF document as a byte
    ; String for the CLI to write.
    function finish(this: ref[RtfFOTBuilder]) returns String
    {
        ; tail of the body (still the temp stream)
        if this.do_balance
        {
            this.raw("\\sect\\sbknone\\par")
            set this.do_balance: false
        }
        this.raw("}\n")
        let host this.host
        let body this.out
        set this.out: Array[u8]^host()
        set this.cur_stream: RTF_ST_MAIN
        ; prolog
        this.raw("{\\rtf1\\ansi\\deff0\n")
        this.raw("{\\fonttbl")
        ; fonttbl in HashTable iteration order (slot order)
        let n_slots this.font_slots.get_length()
        var si: size_t 0
        while si < n_slots
        {
            let sp this.font_slots.get(si)
            var e: ref[RtfFontEntry]? null
            if sp <> null
                set e: *sp
            if e <> null
            {
                let rowp this.ffcs.get(e.value as size_t)
                if rowp <> null
                {
                    let row *rowp
                    var cs 0
                    while cs < RTF_N_WIN_CHARSETS
                    {
                        let fn row.get_at(cs)
                        if fn >= 0
                        {
                            this.raw("{\\f")
                            this.raw_int(fn)
                            this.raw("\\fnil\\fcharset")
                            this.raw_int(*(RTF_WIN_CHARSET_CODES + cs))
                            this.put_c(0x20)
                            this.raw_stringc(e.key)
                            this.emit_charset_suffix(cs)
                            this.raw(";}\n")
                        }
                        set cs: cs + 1
                    }
                }
            }
            set si: si + 1
        }
        this.raw("}\n")
        this.raw("{\\colortbl;")
        let n_colors this.color_table.get_length()
        var ki: size_t 0
        while ki < n_colors
        {
            let cp this.color_table.get(ki)
            if cp <> null
            {
                let n *cp
                this.cw_int("\\red", (n >> 16) & 0xFF)
                this.cw_int("\\green", (n >> 8) & 0xFF)
                this.cw_int("\\blue", n & 0xFF)
                this.put_c(0x3B)
            }
            set ki: ki + 1
        }
        this.raw("}{\\stylesheet")
        this.raw("{\\s0 Normal;}")
        var hi 1
        while hi <= 9
        {
            this.raw("{\\s")
            this.raw_int(hi)
            this.raw(" Heading ")
            this.raw_int(hi)
            this.raw(";}")
            set hi: hi + 1
        }
        this.raw("}\n")
        if this.max_consec_hyphens > 0
            this.cw_int("\\hyphconsec", this.max_consec_hyphens)
        this.raw("\\deflang")
        this.raw_int(RTF_DEFAULT_LANG)
        this.raw("\\notabind\\facingp\\hyphauto1\\widowctrl\n")
        ; body copy with INSERTION_CHAR patching
        let blen body.get_length()
        var bi2: size_t 0
        while bi2 < blen
        {
            let bp2 body.get(bi2)
            var b: u8 0
            if bp2 <> null
                set b: *bp2
            if b = 0
            {
                ; kind byte + payload
                set bi2: bi2 + 1
                let kp body.get(bi2)
                var kind: u8 0
                if kp <> null
                    set kind: *kp
                if kind = 0x62
                {
                    var grovei 0
                    var ei 0
                    var w 0
                    while w < 4
                    {
                        set bi2: bi2 + 1
                        let wp3 body.get(bi2)
                        if wp3 <> null
                            set grovei: (grovei << 8) | ((*wp3) as int)
                        set w: w + 1
                    }
                    set w: 0
                    while w < 4
                    {
                        set bi2: bi2 + 1
                        let wp4 body.get(bi2)
                        if wp4 <> null
                            set ei: (ei << 8) | ((*wp4) as int)
                        set w: w + 1
                    }
                    if this.elements_refed_contains(grovei, ei)
                    {
                        this.raw("{\\*\\bkmkstart ")
                        this.output_bookmark_name_index(grovei, ei)
                        this.put_c(0x7D)
                        this.raw("{\\*\\bkmkend ")
                        this.output_bookmark_name_index(grovei, ei)
                        this.put_c(0x7D)
                    }
                }
            }
            else
                this.put(b)
            set bi2: bi2 + 1
        }
        ; the assembled document
        let result this.out
        String(result.get_buffer() as pointer[const_char], result.get_length())
    }
    ; --- the INLINE/MARK family -------------------------------------------------
    ; None of these six classes is overridden by the reference Rtf backend, so the
    ; plain FOTBuilder brackets apply. ★`character` is the interesting one: the
    ; base EMITS THE CHARACTER as text when the NIC is valid, then takes the
    ; atomic bracket (FOTBuilder.cxx:174) — measured (`-t rtf` renders
    ; `(make character char: #\A)` as an "A").
    function character(this: ref[RtfFOTBuilder], nic: ref[CharacterNICRec])
    {
        if nic.valid
        {
            var buf u32[1]
            set *(buf as pointer[u32]): nic.ch
            this.characters(buf as pointer[u32], 1)
        }
        this.fo_atomic()
    }

    function alignment_point(this: ref[RtfFOTBuilder])
        this.fo_atomic()

    function start_sideline(this: ref[RtfFOTBuilder])
        this.fo_start()

    function end_sideline(this: ref[RtfFOTBuilder])
        this.fo_end()

    function anchor(this: ref[RtfFOTBuilder], nic: ref[AnchorNICRec])
        this.fo_atomic()

    function start_glyph_annotation(this: ref[RtfFOTBuilder], nic: ref[GlyphAnnotationNICRec])
        this.fo_start()

    function end_glyph_annotation(this: ref[RtfFOTBuilder])
        this.fo_end()

    function start_emphasizing_mark_serial(this: ref[RtfFOTBuilder], nic: ref[EmphasizingMarkNICRec])
        this.fo_start()

    function end_emphasizing_mark_serial(this: ref[RtfFOTBuilder])
        this.fo_end()

    function start_emphasizing_mark_mark(this: ref[RtfFOTBuilder])
        this.fo_start()

    function end_emphasizing_mark_mark(this: ref[RtfFOTBuilder])
        this.fo_end()

    function end_all_emphasizing_mark_mark(this: ref[RtfFOTBuilder])
    {
    }

    ; --- the MATH family ---------------------------------------------------------
    ; RTF renders math as an EQ FIELD, so every math class opens the field once
    ; (enterMathMode at level 0) and writes control words INSIDE it. The five
    ; classes whose ports come out in a different order than they go in capture
    ; each port into a buffer and assemble the field afterwards.

    ; enterMathMode / exitMathMode (jade/RtfFOTBuilder.cxx:3157)
    function enter_math_mode(this: ref[RtfFOTBuilder])
    {
        let lvl this.math_level
        set this.math_level: lvl + 1
        if lvl = 0
        {
            RtfFOTBuilder.copy_output_fmt(&this.math_save_out_fmt, &this.out_fmt)
            this.raw("{\\field{\\*\\fldinst  EQ ")
        }
    }

    function exit_math_mode(this: ref[RtfFOTBuilder])
    {
        set this.math_level: this.math_level - 1
        if this.math_level = 0
        {
            this.raw("}{\\fldrslt}}")
            RtfFOTBuilder.copy_output_fmt(&this.out_fmt, &this.math_save_out_fmt)
        }
    }

    ; the shared output redirect (the reference's `osp_ = &buf` / restore)
    function redirect_push(this: ref[RtfFOTBuilder])
    {
        let host this.host
        let d this.redirect_depth as size_t
        if d < this.redirect.get_length()
            this.redirect.put(d, Array[u8]^host())
        else
            this.redirect.add(Array[u8]^host())
        set this.redirect_depth: this.redirect_depth + 1
    }

    function redirect_pop(this: ref[RtfFOTBuilder])
        set this.redirect_depth: this.redirect_depth - 1

    function redirect_top(this: ref[RtfFOTBuilder]) returns ref[Array[u8]]
    {
        let bp this.redirect.get((this.redirect_depth - 1) as size_t)
        *bp as ref[Array[u8]]
    }

    ; startReorderFlowObject / endReorderFlowObjectPort / endReorderFlowObject
    function start_reorder_flow_object(this: ref[RtfFOTBuilder])
    {
        let host this.host
        let r RtfReorder.make(host)
        RtfFOTBuilder.copy_output_fmt(&r.save_out_fmt, &this.out_fmt)
        let d this.reorder_depth as size_t
        if d < this.reorder_stack.get_length()
            this.reorder_stack.put(d, r)
        else
            this.reorder_stack.add(r)
        set this.reorder_depth: this.reorder_depth + 1
        this.redirect_push()
        this.put_c(0x7B)
    }

    function reorder_top(this: ref[RtfFOTBuilder]) returns ref[RtfReorder]
    {
        let rp this.reorder_stack.get((this.reorder_depth - 1) as size_t)
        *rp as ref[RtfReorder]
    }

    ; close the current port's capture, hand it to the record, open the next.
    function end_reorder_flow_object_port(this: ref[RtfFOTBuilder])
    {
        this.put_c(0x7D)
        let r this.reorder_top()
        r.streams.add(this.redirect_top())
        let host this.host
        this.redirect.put((this.redirect_depth - 1) as size_t, Array[u8]^host())
        this.put_c(0x7B)
        RtfFOTBuilder.copy_output_fmt(&this.out_fmt, &r.save_out_fmt)
    }

    ; ★the reference writes the assembled field into saveOsp BEFORE restoring
    ; osp_; popping first and writing after is the same stream, so every
    ; end*Serial below pops here and then emits.
    function end_reorder_flow_object(this: ref[RtfFOTBuilder])
    {
        this.redirect_pop()
        set this.reorder_depth: this.reorder_depth - 1
    }

    function raw_buf(this: ref[RtfFOTBuilder], b: ref[Array[u8]])
    {
        let n b.get_length()
        var i: size_t 0
        while i < n
        {
            let p b.get(i)
            this.put(*p)
            set i: i + 1
        }
    }

    ; a captured port stream is "{" + content + "}" — 2 bytes means empty.
    function reorder_stream(this: ref[RtfFOTBuilder], r: ref[RtfReorder], i: int) returns ref[Array[u8]]?
    {
        if (i as size_t) >= r.streams.get_length()
            return null
        let p r.streams.get(i as size_t)
        *p
    }

    function stream_nonempty(b: ref[Array[u8]]?) returns bool
    {
        if b = null
            return false
        b.get_length() > 2
    }

    function start_math_sequence(this: ref[RtfFOTBuilder])
    {
        this.fo_start()
        this.inline_prepare()
        this.enter_math_mode()
    }

    function end_math_sequence(this: ref[RtfFOTBuilder])
    {
        this.exit_math_mode()
        this.fo_end()
    }

    function start_fraction_serial(this: ref[RtfFOTBuilder])
    {
        this.fo_start()
        this.inline_prepare()
        this.enter_math_mode()
        this.raw("\\\\f")
    }

    function end_fraction_serial(this: ref[RtfFOTBuilder])
    {
        this.exit_math_mode()
        this.fo_end()
    }

    ; not overridden by the reference Rtf backend — FOTBuilder::fractionBar is
    ; atomic(), i.e. start()+end().
    function fraction_bar(this: ref[RtfFOTBuilder])
        this.fo_atomic()

    function start_fraction_numerator(this: ref[RtfFOTBuilder])
        this.put_c(0x28)

    function end_fraction_numerator(this: ref[RtfFOTBuilder])
    {
    }

    function start_fraction_denominator(this: ref[RtfFOTBuilder])
        this.put_c(this.eq_arg_sep)

    function end_fraction_denominator(this: ref[RtfFOTBuilder])
        this.put_c(0x29)

    ; unmath: not overridden — the plain FOTBuilder bracket.
    function start_unmath(this: ref[RtfFOTBuilder])
        this.fo_start()

    function end_unmath(this: ref[RtfFOTBuilder])
        this.fo_end()

    function start_superscript(this: ref[RtfFOTBuilder])
    {
        this.fo_start()
        this.inline_prepare()
        this.enter_math_mode()
        this.raw("\\\\s\\\\up")
        this.raw_int(this.spec.superscript_height)
        this.put_c(0x28)
    }

    function end_superscript(this: ref[RtfFOTBuilder])
    {
        this.put_c(0x29)
        this.exit_math_mode()
        this.fo_end()
    }

    function start_subscript(this: ref[RtfFOTBuilder])
    {
        this.fo_start()
        this.inline_prepare()
        this.enter_math_mode()
        this.raw("\\\\s\\\\do")
        this.raw_int(this.spec.subscript_depth)
        this.put_c(0x28)
    }

    function end_subscript(this: ref[RtfFOTBuilder])
    {
        this.put_c(0x29)
        this.exit_math_mode()
        this.fo_end()
    }

    ; script: SEVEN captured streams (the principal plus the six ports), then
    ; three overlaid \o groups — pre, mid, post.
    function start_script_serial(this: ref[RtfFOTBuilder])
    {
        this.fo_start()
        this.inline_prepare()
        this.enter_math_mode()
        this.start_reorder_flow_object()
    }

    function end_script_serial(this: ref[RtfFOTBuilder])
    {
        this.end_reorder_flow_object_port()
        let r this.reorder_top()
        let principal this.reorder_stream(r, 0)
        let pre_sup this.reorder_stream(r, 1)
        let pre_sub this.reorder_stream(r, 2)
        let post_sup this.reorder_stream(r, 3)
        let post_sub this.reorder_stream(r, 4)
        let mid_sup this.reorder_stream(r, 5)
        let mid_sub this.reorder_stream(r, 6)
        this.end_reorder_flow_object()
        this.raw("\\\\o(")
        if RtfFOTBuilder.stream_nonempty(pre_sup)
        {
            this.raw("\\\\s\\\\up")
            this.raw_int(this.spec.superscript_height)
            this.put_c(0x28)
            this.raw_buf(pre_sup)
            this.put_c(0x29)
        }
        this.put_c(this.eq_arg_sep)
        if RtfFOTBuilder.stream_nonempty(pre_sub)
        {
            this.raw("\\\\s\\\\do")
            this.raw_int(this.spec.subscript_depth)
            this.put_c(0x28)
            this.raw_buf(pre_sub)
            this.put_c(0x29)
        }
        this.put_c(0x29)
        this.raw("\\\\o(")
        if principal <> null
            this.raw_buf(principal)
        if RtfFOTBuilder.stream_nonempty(mid_sup)
        {
            this.put_c(this.eq_arg_sep)
            this.raw("\\\\s\\\\up")
            this.raw_int(this.spec.over_mark_height)
            this.put_c(0x28)
            this.raw_buf(mid_sup)
            this.put_c(0x29)
        }
        if RtfFOTBuilder.stream_nonempty(mid_sub)
        {
            this.put_c(this.eq_arg_sep)
            this.raw("\\\\s\\\\do")
            this.raw_int(this.spec.under_mark_depth)
            this.put_c(0x28)
            this.raw_buf(mid_sub)
            this.put_c(0x29)
        }
        this.put_c(0x29)
        this.raw("\\\\o(")
        if RtfFOTBuilder.stream_nonempty(post_sup)
        {
            this.raw("\\\\s\\\\up")
            this.raw_int(this.spec.superscript_height)
            this.put_c(0x28)
            this.raw_buf(post_sup)
            this.put_c(0x29)
        }
        this.put_c(this.eq_arg_sep)
        if RtfFOTBuilder.stream_nonempty(post_sub)
        {
            this.raw("\\\\s\\\\do")
            this.raw_int(this.spec.subscript_depth)
            this.put_c(0x28)
            this.raw_buf(post_sub)
            this.put_c(0x29)
        }
        this.put_c(0x29)
        this.fo_end()
        this.exit_math_mode()
    }

    function start_script_pre_sup(this: ref[RtfFOTBuilder])
        this.end_reorder_flow_object_port()

    function end_script_pre_sup(this: ref[RtfFOTBuilder])
    {
    }

    function start_script_pre_sub(this: ref[RtfFOTBuilder])
        this.end_reorder_flow_object_port()

    function end_script_pre_sub(this: ref[RtfFOTBuilder])
    {
    }

    function start_script_post_sup(this: ref[RtfFOTBuilder])
        this.end_reorder_flow_object_port()

    function end_script_post_sup(this: ref[RtfFOTBuilder])
    {
    }

    function start_script_post_sub(this: ref[RtfFOTBuilder])
        this.end_reorder_flow_object_port()

    function end_script_post_sub(this: ref[RtfFOTBuilder])
    {
    }

    function start_script_mid_sup(this: ref[RtfFOTBuilder])
        this.end_reorder_flow_object_port()

    function end_script_mid_sup(this: ref[RtfFOTBuilder])
    {
    }

    function start_script_mid_sub(this: ref[RtfFOTBuilder])
        this.end_reorder_flow_object_port()

    function end_script_mid_sub(this: ref[RtfFOTBuilder])
    {
    }

    function start_mark_serial(this: ref[RtfFOTBuilder])
    {
        this.fo_start()
        this.inline_prepare()
        this.enter_math_mode()
        this.start_reorder_flow_object()
    }

    function end_mark_serial(this: ref[RtfFOTBuilder])
    {
        let r this.reorder_top()
        let principal this.reorder_stream(r, 0)
        let over this.reorder_stream(r, 1)
        let under this.reorder_stream(r, 2)
        this.end_reorder_flow_object()
        this.raw("\\\\o(")
        if principal <> null
            this.raw_buf(principal)
        if RtfFOTBuilder.stream_nonempty(over)
        {
            this.put_c(this.eq_arg_sep)
            this.raw("\\\\s\\\\up")
            this.raw_int(this.spec.over_mark_height)
            this.put_c(0x28)
            this.raw_buf(over)
            this.put_c(0x29)
        }
        if RtfFOTBuilder.stream_nonempty(under)
        {
            this.put_c(this.eq_arg_sep)
            this.raw("\\\\s\\\\do")
            this.raw_int(this.spec.under_mark_depth)
            this.put_c(0x28)
            this.raw_buf(under)
            this.put_c(0x29)
        }
        this.put_c(0x29)
        this.fo_end()
        this.exit_math_mode()
    }

    function start_mark_over(this: ref[RtfFOTBuilder])
        this.end_reorder_flow_object_port()

    function end_mark_over(this: ref[RtfFOTBuilder])
        this.end_reorder_flow_object_port()

    function start_mark_under(this: ref[RtfFOTBuilder])
    {
    }

    function end_mark_under(this: ref[RtfFOTBuilder])
        this.end_reorder_flow_object_port()

    function start_fence_serial(this: ref[RtfFOTBuilder])
    {
        this.fo_start()
        this.inline_prepare()
        this.enter_math_mode()
        this.start_reorder_flow_object()
    }

    function end_fence_serial(this: ref[RtfFOTBuilder])
    {
        let r this.reorder_top()
        let principal this.reorder_stream(r, 0)
        let open_s this.reorder_stream(r, 1)
        let close_s this.reorder_stream(r, 2)
        this.end_reorder_flow_object()
        this.raw("\\\\b\\\\lc\\\\")
        if open_s <> null
            this.raw_buf(open_s)
        this.raw("\\\\rc\\\\")
        if close_s <> null
            this.raw_buf(close_s)
        this.put_c(0x28)
        if principal <> null
            this.raw_buf(principal)
        this.put_c(0x29)
        this.fo_end()
        this.exit_math_mode()
    }

    ; ★the fence delimiters are written to the field RAW (they are the field's
    ; own \lc/\rc arguments), so math_special suspends the escaping for them.
    function start_fence_open(this: ref[RtfFOTBuilder])
    {
        this.end_reorder_flow_object_port()
        set this.math_special: RTF_MATH_FENCE
    }

    function end_fence_open(this: ref[RtfFOTBuilder])
        this.end_reorder_flow_object_port()

    function start_fence_close(this: ref[RtfFOTBuilder])
    {
    }

    function end_fence_close(this: ref[RtfFOTBuilder])
    {
        this.end_reorder_flow_object_port()
        set this.math_special: RTF_MATH_NORMAL
    }

    function start_radical_serial(this: ref[RtfFOTBuilder])
    {
        this.fo_start()
        this.inline_prepare()
        this.enter_math_mode()
        this.start_reorder_flow_object()
    }

    function end_radical_serial(this: ref[RtfFOTBuilder])
    {
        let r this.reorder_top()
        let principal this.reorder_stream(r, 0)
        let degree this.reorder_stream(r, 1)
        this.end_reorder_flow_object()
        this.raw("\\\\r(")
        if degree <> null
            this.raw_buf(degree)
        this.put_c(this.eq_arg_sep)
        if principal <> null
            this.raw_buf(principal)
        this.put_c(0x29)
        this.fo_end()
        this.exit_math_mode()
    }

    ; the radical glyph itself is not overridden — FOTBuilder::radicalRadical is
    ; atomic(), radicalRadicalDefaulted is nothing.
    function radical_radical(this: ref[RtfFOTBuilder], nic: ref[CharacterNICRec])
        this.fo_atomic()

    function radical_radical_defaulted(this: ref[RtfFOTBuilder])
    {
    }

    function start_radical_degree(this: ref[RtfFOTBuilder])
        this.end_reorder_flow_object_port()

    function end_radical_degree(this: ref[RtfFOTBuilder])
        this.end_reorder_flow_object_port()

    function start_math_operator_serial(this: ref[RtfFOTBuilder])
    {
        this.fo_start()
        this.inline_prepare()
        this.enter_math_mode()
        this.raw("\\\\i")
        if this.spec.math_inline
            this.raw("\\\\in")
        this.start_reorder_flow_object()
    }

    function end_math_operator_serial(this: ref[RtfFOTBuilder])
    {
        let r this.reorder_top()
        let principal this.reorder_stream(r, 0)
        let oper this.reorder_stream(r, 1)
        let lower this.reorder_stream(r, 2)
        let upper this.reorder_stream(r, 3)
        this.end_reorder_flow_object()
        if oper <> null
            this.raw_buf(oper)
        this.put_c(0x28)
        if lower <> null
            this.raw_buf(lower)
        this.put_c(this.eq_arg_sep)
        if upper <> null
            this.raw_buf(upper)
        this.put_c(this.eq_arg_sep)
        if principal <> null
            this.raw_buf(principal)
        this.put_c(0x29)
        this.fo_end()
        this.exit_math_mode()
    }

    function start_math_operator_operator(this: ref[RtfFOTBuilder])
    {
        this.end_reorder_flow_object_port()
        set this.math_special: RTF_MATH_INTEGRAL
    }

    function end_math_operator_operator(this: ref[RtfFOTBuilder])
    {
        set this.math_special: RTF_MATH_NORMAL
        this.end_reorder_flow_object_port()
    }

    function start_math_operator_lower_limit(this: ref[RtfFOTBuilder])
    {
    }

    function end_math_operator_lower_limit(this: ref[RtfFOTBuilder])
        this.end_reorder_flow_object_port()

    function start_math_operator_upper_limit(this: ref[RtfFOTBuilder])
    {
    }

    function end_math_operator_upper_limit(this: ref[RtfFOTBuilder])
        this.end_reorder_flow_object_port()

    ; grid: every cell is captured into the matrix and the whole EQ \a array is
    ; written at endGrid.
    function grid_top(this: ref[RtfFOTBuilder]) returns ref[RtfGrid]
    {
        let gp this.grid_stack.get((this.grid_depth - 1) as size_t)
        *gp as ref[RtfGrid]
    }

    function start_grid(this: ref[RtfFOTBuilder], nic: ref[GridNICRec])
    {
        this.fo_start()
        this.inline_prepare()
        this.enter_math_mode()
        let host this.host
        let g RtfGrid.make(host)
        RtfFOTBuilder.copy_output_fmt(&g.save_out_fmt, &this.out_fmt)
        set g.pos_type: this.spec.grid_pos_type
        if nic.n_columns <> 0
            set g.n_columns: nic.n_columns
        if nic.n_rows <> 0
            set g.n_rows: nic.n_rows
        let d this.grid_depth as size_t
        if d < this.grid_stack.get_length()
            this.grid_stack.put(d, g)
        else
            this.grid_stack.add(g)
        set this.grid_depth: this.grid_depth + 1
        this.redirect_push()
    }

    function end_grid(this: ref[RtfFOTBuilder])
    {
        let g this.grid_top()
        this.redirect_pop()
        set this.grid_depth: this.grid_depth - 1
        let n_rows_used g.cells.get_length() as int
        var i 0
        while i < n_rows_used
        {
            let rp g.cells.get(i as size_t)
            let erow *rp
            let w erow.get_length() as int
            if w > g.n_columns
                set g.n_columns: w
            set i: i + 1
        }
        if n_rows_used > g.n_rows
            set g.n_rows: n_rows_used
        this.raw("\\\\a\\\\hs")
        this.raw_int(this.spec.grid_column_sep)
        this.raw("\\\\vs")
        this.raw_int(this.spec.grid_row_sep)
        this.raw("\\\\a")
        this.put_c(this.spec.grid_column_alignment)
        this.raw("\\\\co")
        this.raw_int(g.n_columns)
        this.put_c(0x28)
        set i: 0
        while i < n_rows_used
        {
            let rp2 g.cells.get(i as size_t)
            let row *rp2
            let w2 row.get_length() as int
            var j 0
            while j < w2
            {
                if (i <> 0) or (j <> 0)
                    this.put_c(this.eq_arg_sep)
                let cp row.get(j as size_t)
                this.raw_buf(*cp)
                set j: j + 1
            }
            ; ★an EMPTY row still consumes one separator slot (`if (!j) j++`)
            if j = 0
                set j: 1
            while j < g.n_columns
            {
                this.put_c(this.eq_arg_sep)
                set j: j + 1
            }
            set i: i + 1
        }
        this.put_c(0x29)
        this.fo_end()
        this.exit_math_mode()
    }

    function start_grid_cell(this: ref[RtfFOTBuilder], nic: ref[GridCellNICRec])
    {
        if this.grid_depth > 0
        {
            this.put_c(0x7B)
            let g this.grid_top()
            set g.cur_row: 0 - 1
            set g.cur_col: 0 - 1
            var cn 0
            var rn 0
            set cn: nic.column_number
            set rn: nic.row_number
            if g.pos_type = RTF_GRIDPOS_EXPLICIT
            {
                if (rn > 0) and (cn > 0)
                {
                    ; ★the outer index is the COLUMN here — the reference's own
                    ; asymmetry, kept.
                    g.grow_rows(cn)
                    g.grow_row(cn - 1, rn)
                    set g.cur_row: cn - 1
                    set g.cur_col: rn - 1
                }
            }
            else if g.pos_type = RTF_GRIDPOS_ROW_MAJOR
            {
                var need_row false
                if g.cells.get_length() = 0
                    set need_row: true
                else
                {
                    let lp g.cells.get(g.cells.get_length() - 1)
                    let lrow *lp
                    if (lrow.get_length() as int) >= g.n_columns
                        set need_row: true
                }
                if need_row
                    g.grow_rows((g.cells.get_length() as int) + 1)
                let li (g.cells.get_length() as int) - 1
                let lp2 g.cells.get(li as size_t)
                let lrow2 *lp2
                g.grow_row(li, (lrow2.get_length() as int) + 1)
                set g.cur_row: li
                set g.cur_col: (lrow2.get_length() as int) - 1
            }
            else
            {
                ; column-major: cells[0] is the leading column; a new cell goes
                ; into the first row that is shorter than it.
                if (g.cells.get_length() as int) < g.n_rows
                    g.grow_rows(g.n_rows)
                let p0 g.cells.get(0)
                let row0 *p0
                let pl g.cells.get((g.n_rows - 1) as size_t)
                let rowl *pl
                if rowl.get_length() = row0.get_length()
                {
                    g.grow_row(0, (row0.get_length() as int) + 1)
                    set g.cur_row: 0
                    set g.cur_col: (row0.get_length() as int) - 1
                }
                else
                {
                    var k 1
                    while k < (g.cells.get_length() as int)
                    {
                        let pk g.cells.get(k as size_t)
                        let rowk *pk
                        if rowk.get_length() < row0.get_length()
                        {
                            g.grow_row(k, (rowk.get_length() as int) + 1)
                            set g.cur_row: k
                            set g.cur_col: (rowk.get_length() as int) - 1
                            break
                        }
                        set k: k + 1
                    }
                }
            }
        }
        this.fo_start()
    }

    ; ★there is no per-cell buffer: a cell accumulates into the GRID's single
    ; buffer, and endGridCell extracts (and empties) the whole buffer into the
    ; addressed cell — a cell with no address discards it. The `{`…`}` braces
    ; are part of the captured content.
    function end_grid_cell(this: ref[RtfFOTBuilder])
    {
        if this.grid_depth > 0
        {
            let g this.grid_top()
            this.put_c(0x7D)
            let captured this.redirect_top()
            let host this.host
            this.redirect.put((this.redirect_depth - 1) as size_t, Array[u8]^host())
            if (g.cur_row >= 0) and (g.cur_col >= 0)
            {
                let rp g.cells.get(g.cur_row as size_t)
                let crow *rp
                crow.put(g.cur_col as size_t, captured)
            }
            RtfFOTBuilder.copy_output_fmt(&this.out_fmt, &g.save_out_fmt)
        }
        this.fo_end()
    }

    ; --- the LAYOUT-COMPOSITE family --------------------------------------------
    ; The RTF backend overrides none of the five, so the plain FOTBuilder
    ; brackets apply: every start*/end* pair is start()/end().
    function start_embedded_text(this: ref[RtfFOTBuilder], nic: ref[EmbeddedTextNICRec])
        this.fo_start()

    function end_embedded_text(this: ref[RtfFOTBuilder])
        this.fo_end()

    function start_included_container_area(this: ref[RtfFOTBuilder], nic: ref[IncludedContainerAreaNICRec], dnic: ref[DisplayNIC])
        this.fo_start()

    function end_included_container_area(this: ref[RtfFOTBuilder])
        this.fo_end()

    function start_side_by_side(this: ref[RtfFOTBuilder], dnic: ref[DisplayNIC])
        this.fo_start()

    function end_side_by_side(this: ref[RtfFOTBuilder])
        this.fo_end()

    function start_side_by_side_item(this: ref[RtfFOTBuilder])
        this.fo_start()

    function end_side_by_side_item(this: ref[RtfFOTBuilder])
        this.fo_end()

    function start_aligned_column(this: ref[RtfFOTBuilder], dnic: ref[DisplayNIC])
        this.fo_start()

    function end_aligned_column(this: ref[RtfFOTBuilder])
        this.fo_end()


    ; --- the ONLINE family ------------------------------------------------------
    ; The RTF backend overrides neither class, so the base brackets apply:
    ; marginalia and the multi-mode SERIAL pair are start()/end(); the per-mode
    ; bracket is empty (its content still flows through).
    function start_marginalia(this: ref[RtfFOTBuilder])
        this.fo_start()

    function end_marginalia(this: ref[RtfFOTBuilder])
        this.fo_end()

    function start_multi_mode_serial(this: ref[RtfFOTBuilder], mode: ref[MultiModeRec])
        this.fo_start()

    function end_multi_mode_serial(this: ref[RtfFOTBuilder])
        this.fo_end()

    function start_multi_mode_mode(this: ref[RtfFOTBuilder], mode: ref[MultiModeRec])
    {
    }

    function end_multi_mode_mode(this: ref[RtfFOTBuilder])
    {
    }

    ; --- the PAGE/COLUMN MODEL ----------------------------------------------------
    ; Not overridden here either, so both are the plain start()/end() brackets.
    function start_page_sequence(this: ref[RtfFOTBuilder])
        this.fo_start()

    function end_page_sequence(this: ref[RtfFOTBuilder])
        this.fo_end()

    function start_column_set_sequence(this: ref[RtfFOTBuilder], dnic: ref[DisplayNIC])
        this.fo_start()

    function end_column_set_sequence(this: ref[RtfFOTBuilder])
        this.fo_end()

}
