    procedure start_fence_serial(mutable this: ref[RtfFOTBuilder])
    {
        this.fo_start()
        this.inline_prepare()
        this.enter_math_mode()
        this.start_reorder_flow_object()
    }

    procedure end_fence_serial(mutable this: ref[RtfFOTBuilder])
    {
        let r this.reorder_top()
        let principal this.reorder_stream(r, 0)
        let open_s this.reorder_stream(r, 1)
        let close_s this.reorder_stream(r, 2)
        this.end_reorder_flow_object()
        this.raw("\\\\b\\\\lc\\\\")
        if open_s <> null
            this.raw_buf(open_s)
        this.raw("\\\\rc\\\\")
        if close_s <> null
            this.raw_buf(close_s)
        this.put_c(0x28)
        if principal <> null
            this.raw_buf(principal)
        this.put_c(0x29)
        this.fo_end()
        this.exit_math_mode()
    }

    ; ★the fence delimiters are written to the field RAW (they are the field's
    ; own \lc/\rc arguments), so math_special suspends the escaping for them.
    procedure start_fence_open(mutable this: ref[RtfFOTBuilder])
    {
        this.end_reorder_flow_object_port()
        this.math_special := RTF_MATH_FENCE
    }

    procedure end_fence_open(mutable this: ref[RtfFOTBuilder])
        this.end_reorder_flow_object_port()

    function start_fence_close(this: ref[RtfFOTBuilder])
    {
    }

    procedure end_fence_close(mutable this: ref[RtfFOTBuilder])
    {
        this.end_reorder_flow_object_port()
        this.math_special := RTF_MATH_NORMAL
    }

    procedure start_radical_serial(mutable this: ref[RtfFOTBuilder])
    {
        this.fo_start()
        this.inline_prepare()
        this.enter_math_mode()
        this.start_reorder_flow_object()
    }

    procedure end_radical_serial(mutable this: ref[RtfFOTBuilder])
    {
        let r this.reorder_top()
        let principal this.reorder_stream(r, 0)
        let degree this.reorder_stream(r, 1)
        this.end_reorder_flow_object()
        this.raw("\\\\r(")
        if degree <> null
            this.raw_buf(degree)
        this.put_c(this.eq_arg_sep)
        if principal <> null
            this.raw_buf(principal)
        this.put_c(0x29)
        this.fo_end()
        this.exit_math_mode()
    }

    ; the radical glyph itself is not overridden — FOTBuilder::radicalRadical is
