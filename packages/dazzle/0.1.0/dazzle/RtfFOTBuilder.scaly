define RTF_DB_FLAG: int 0x40000000
define RTF_SYMBOL_FONT_PAGE: int 0xf000
define RTF_DEFAULT_LANG: int 0x400
define RTF_HF_PRE_SPACE: int 190
define RTF_HF_POST_SPACE: int 50

; inline states
