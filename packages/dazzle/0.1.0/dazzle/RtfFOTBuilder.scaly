    procedure start_math_operator_serial(mutable this: ref[RtfFOTBuilder])
    {
        this.fo_start()
        this.inline_prepare()
        this.enter_math_mode()
        this.raw("\\\\i")
        if this.spec.math_inline
            this.raw("\\\\in")
        this.start_reorder_flow_object()
    }

    procedure end_math_operator_serial(mutable this: ref[RtfFOTBuilder])
    {
        let r this.reorder_top()
        let principal this.reorder_stream(r, 0)
        let oper this.reorder_stream(r, 1)
        let lower this.reorder_stream(r, 2)
        let upper this.reorder_stream(r, 3)
        this.end_reorder_flow_object()
        if oper <> null
            this.raw_buf(oper)
        this.put_c(0x28)
        if lower <> null
            this.raw_buf(lower)
        this.put_c(this.eq_arg_sep)
        if upper <> null
            this.raw_buf(upper)
        this.put_c(this.eq_arg_sep)
        if principal <> null
            this.raw_buf(principal)
        this.put_c(0x29)
        this.fo_end()
        this.exit_math_mode()
    }

    procedure start_math_operator_operator(mutable this: ref[RtfFOTBuilder])
    {
        this.end_reorder_flow_object_port()
        this.math_special := RTF_MATH_INTEGRAL
    }

    procedure end_math_operator_operator(mutable this: ref[RtfFOTBuilder])
    {
        this.math_special := RTF_MATH_NORMAL
        this.end_reorder_flow_object_port()
    }

