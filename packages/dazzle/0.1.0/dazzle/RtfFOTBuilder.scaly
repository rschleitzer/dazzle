    procedure start_mark_serial(mutable this: ref[RtfFOTBuilder])
    {
        this.fo_start()
        this.inline_prepare()
        this.enter_math_mode()
        this.start_reorder_flow_object()
    }

    procedure end_mark_serial(mutable this: ref[RtfFOTBuilder])
    {
        let r this.reorder_top()
        let principal this.reorder_stream(r, 0)
        let over this.reorder_stream(r, 1)
        let under this.reorder_stream(r, 2)
        this.end_reorder_flow_object()
        this.raw("\\\\o(")
        if principal <> null
            this.raw_buf(principal)
        if RtfFOTBuilder.stream_nonempty(over)
        {
            this.put_c(this.eq_arg_sep)
            this.raw("\\\\s\\\\up")
            this.raw_int(this.spec.over_mark_height)
            this.put_c(0x28)
            this.raw_buf(over as ref[Array[u8]])
            this.put_c(0x29)
        }
        if RtfFOTBuilder.stream_nonempty(under)
        {
            this.put_c(this.eq_arg_sep)
            this.raw("\\\\s\\\\do")
            this.raw_int(this.spec.under_mark_depth)
            this.put_c(0x28)
            this.raw_buf(under as ref[Array[u8]])
            this.put_c(0x29)
        }
        this.put_c(0x29)
        this.fo_end()
        this.exit_math_mode()
    }

    procedure start_mark_over(mutable this: ref[RtfFOTBuilder])
        this.end_reorder_flow_object_port()

    procedure end_mark_over(mutable this: ref[RtfFOTBuilder])
        this.end_reorder_flow_object_port()

