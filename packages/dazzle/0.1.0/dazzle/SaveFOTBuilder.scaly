; the PAGE/COLUMN MODEL — two plain brackets; `page-sequence` carries nothing
; (all six of its characteristics are inherited ones, already queued as
; setIc calls), `column-set-sequence` a bare DisplayNIC.
define SV_START_PAGE_SEQUENCE: int 147
define SV_END_PAGE_SEQUENCE: int 148
define SV_START_COLUMN_SET_SEQUENCE: int 149
define SV_END_COLUMN_SET_SEQUENCE: int 150

; the TRANSFORM backend's own eleven calls (work package 23). They reach a
; queue for exactly the same reason every other call does: `-t sgml` runs the
; same port/connection machinery as the print backends, so an `(make element)`
; inside a `label:`ed child is captured and replayed like anything else.
define SV_START_ELEMENT: int 151
define SV_END_ELEMENT: int 152
define SV_EMPTY_ELEMENT: int 153
define SV_START_ENTITY: int 154
define SV_END_ENTITY: int 155
define SV_ENTITY_REF: int 156
define SV_PROCESSING_INSTRUCTION: int 157
define SV_DOCUMENT_TYPE: int 158
define SV_FORMATTING_INSTRUCTION: int 159
define SV_START_DIRECTORY: int 160
define SV_END_DIRECTORY: int 161

; the two multi-field payloads of those calls, parked in the `nic` slot.
define SaveElementRec (gi: StringC, atts: pointer[Array[StringC]])
{
    function make(host: pointer[Page], gi: StringC, atts: pointer[Array[StringC]]) returns ref[SaveElementRec]
    {
        let r host.allocate(sizeof SaveElementRec, alignof SaveElementRec) as pointer[SaveElementRec]
        set r.gi: InheritedC.pin_string(host, gi)
        set r.atts: null
        if atts <> null
        {
            let c Array[StringC]^host()
            var i: size_t 0
            let n atts.get_length()
            while i < n
            {
                let s atts.get(i)
                c.add(InheritedC.pin_string(host, *s))
                set i: i + 1
            }
            set r.atts: c
        }
        r
    }
}

define SaveDocTypeRec (name: StringC, public_id: StringC, system_id: StringC)
{
    function make(host: pointer[Page], name: StringC, public_id: StringC, system_id: StringC) returns ref[SaveDocTypeRec]
    {
        let r host.allocate(sizeof SaveDocTypeRec, alignof SaveDocTypeRec) as pointer[SaveDocTypeRec]
        set r.name: InheritedC.pin_string(host, name)
        set r.public_id: InheritedC.pin_string(host, public_id)
        set r.system_id: InheritedC.pin_string(host, system_id)
        r
    }
}

; one recorded call: `tag` selects which payload slots are live (union by
; convention — every slot is initialized; the replay walker in FotSink casts
; `nic` per tag).
define SaveCallRec
(
    next: ref[SaveCallRec]?
    tag: int
    ic: ref[InheritedC]?
    node: ref[GroveNode]?
    str: StringC
    data: pointer[u32]
    n: size_t
    dnic: ref[DisplayNIC]?
    nic: pointer[void]
    flags: int
)
{
    function make(host: pointer[Page], tag: int) returns ref[SaveCallRec]
    {
        let r host.allocate(sizeof SaveCallRec, alignof SaveCallRec) as pointer[SaveCallRec]
        set r.next: null
        set r.tag: tag
        set r.ic: null
        set r.node: null
        set r.str: StringC()
        set r.data: null
        set r.n: 0
        set r.dnic: null
        set r.nic: null
        set r.flags: 0
        r
    }
}

define SaveFOTBuilder
(
    head: ref[SaveCallRec]?
    tail: ref[SaveCallRec]?
    node: ref[GroveNode]?
    mode_name: StringC
    host: pointer[Page]
)
{
    function make(host: pointer[Page]) returns ref[SaveFOTBuilder]
    {
        let q host.allocate(sizeof SaveFOTBuilder, alignof SaveFOTBuilder) as pointer[SaveFOTBuilder]
        set q.head: null
        set q.tail: null
        set q.node: null
        set q.mode_name: StringC()
        set q.host: host
        q
    }

    ; the reference SaveFOTBuilder(currentNode, processingMode) form — emit
    ; wraps the replay in startNode/endNode (over-connection save-queue and
    ; principal-queue entries).
    function make_node(host: pointer[Page], node: ref[GroveNode], mode_name: StringC) returns ref[SaveFOTBuilder]
    {
        let q SaveFOTBuilder.make(host)
        set q.node: node
        set q.mode_name: InheritedC.pin_string(host, mode_name)
        q
    }

    function append(this: ref[SaveFOTBuilder], r: ref[SaveCallRec])
    {
        if this.tail = null
        {
            set this.head: r
            set this.tail: r
            return
        }
        set this.tail.next: r
        set this.tail: r
    }

    function record0(this: ref[SaveFOTBuilder], tag: int)
    {
        let h this.host
        let r SaveCallRec.make(h, tag)
        this.append(r)
    }

    function record_set_ic(this: ref[SaveFOTBuilder], ic: ref[InheritedC])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_SET_IC)
        if ic <> null
            set r.ic: ic.copy_for_save(h)
        this.append(r)
    }

    function record_characters(this: ref[SaveFOTBuilder], s: pointer[u32], n: size_t)
    {
        let h this.host
        let r SaveCallRec.make(h, SV_CHARACTERS)
        if n > 0
        {
            let buf h.allocate(n * 4, 4) as pointer[u32]
            var i: size_t 0
            while i < n
            {
                set *(buf + i): *(s + i)
                set i: i + 1
            }
            set r.data: buf
        }
        set r.n: n
        this.append(r)
    }

    ; grove data is run-lived — keep the raw pointer (reference shape; the
    ; pointer feeds the fot sink's text-run regrouping).
    function record_chars_from_node(this: ref[SaveFOTBuilder], node: ref[GroveNode], s: pointer[u32], n: size_t)
    {
        let h this.host
        let r SaveCallRec.make(h, SV_CHARS_FROM_NODE)
        set r.node: node
        set r.data: s
        set r.n: n
        this.append(r)
    }

    function record_start_node(this: ref[SaveFOTBuilder], node: ref[GroveNode], mode_name: StringC)
    {
        let h this.host
        let r SaveCallRec.make(h, SV_START_NODE)
        set r.node: node
        set r.str: InheritedC.pin_string(h, mode_name)
        this.append(r)
    }

    ; --- the transform backend's calls ---------------------------------------
    function record_element(this: ref[SaveFOTBuilder], tag: int, gi: StringC, atts: pointer[Array[StringC]])
    {
        let h this.host
        let r SaveCallRec.make(h, tag)
        set r.nic: SaveElementRec.make(h, gi, atts) as pointer[void]
        this.append(r)
    }

    function record_str(this: ref[SaveFOTBuilder], tag: int, s: StringC)
    {
        let h this.host
        let r SaveCallRec.make(h, tag)
        set r.str: InheritedC.pin_string(h, s)
        this.append(r)
    }

    function record_document_type(this: ref[SaveFOTBuilder], name: StringC, public_id: StringC, system_id: StringC)
    {
        let h this.host
        let r SaveCallRec.make(h, SV_DOCUMENT_TYPE)
        set r.nic: SaveDocTypeRec.make(h, name, public_id, system_id) as pointer[void]
        this.append(r)
    }

    function pin_dnic(this: ref[SaveFOTBuilder], dnic: ref[DisplayNIC]) returns ref[DisplayNIC]?
    {
        if dnic = null
            return null
        let h this.host
        let c dnic.copy(h)
        set c.coalesce_id: InheritedC.pin_string(h, c.coalesce_id)
        c
    }

    function record_dnic(this: ref[SaveFOTBuilder], tag: int, dnic: ref[DisplayNIC])
    {
        let h this.host
        let r SaveCallRec.make(h, tag)
        let dc this.pin_dnic(dnic)
        set r.dnic: dc
        this.append(r)
    }

    function record_start_leader(this: ref[SaveFOTBuilder], nic: ref[LeaderNICRec])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_START_LEADER)
        if nic <> null
            set r.nic: nic.copy(h) as pointer[void]
        this.append(r)
    }

    function record_start_line_field(this: ref[SaveFOTBuilder], nic: ref[LineFieldNICRec])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_START_LINE_FIELD)
        if nic <> null
            set r.nic: nic.copy(h) as pointer[void]
        this.append(r)
    }

    function record_index_entry(this: ref[SaveFOTBuilder], nic: ref[IndexEntryNICRec])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_INDEX_ENTRY)
        if nic <> null
        {
            let c nic.copy(h)
            set c.sort_string: InheritedC.pin_string(h, c.sort_string)
            var i: size_t 0
            let n c.components.get_length()
            while i < n
            {
                let cp c.components.get(i)
                c.components.put(i, InheritedC.pin_string(h, *cp))
                set i: i + 1
            }
            set r.nic: c as pointer[void]
        }
        this.append(r)
    }

    function record_start_page_float(this: ref[SaveFOTBuilder], nic: ref[PageFloatNICRec])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_START_PAGE_FLOAT)
        if nic <> null
        {
            let c nic.copy(h)
            set c.placement: InheritedC.pin_string(h, c.placement)
            set r.nic: c as pointer[void]
        }
        this.append(r)
    }

    function record_start_link(this: ref[SaveFOTBuilder], nic: ref[LinkNICRec])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_START_LINK)
        if nic <> null
            set r.nic: nic.copy(h) as pointer[void]
        this.append(r)
    }

    function record_start_score(this: ref[SaveFOTBuilder], nic: ref[ScoreNICRec])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_START_SCORE)
        if nic <> null
        {
            let c nic.copy(h)
            set c.sym: InheritedC.pin_fotsym(h, c.sym)
            set r.nic: c as pointer[void]
        }
        this.append(r)
    }

    function record_start_box(this: ref[SaveFOTBuilder], nic: ref[BoxNICRec], dnic: ref[DisplayNIC])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_START_BOX)
        if nic <> null
            set r.nic: nic.copy(h) as pointer[void]
        let dc this.pin_dnic(dnic)
        set r.dnic: dc
        this.append(r)
    }

    function record_rule(this: ref[SaveFOTBuilder], nic: ref[RuleNICRec], dnic: ref[DisplayNIC])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_RULE)
        if nic <> null
        {
            let c nic.copy(h)
            set c.orientation: InheritedC.pin_fotsym(h, c.orientation)
            set r.nic: c as pointer[void]
        }
        let dc this.pin_dnic(dnic)
        set r.dnic: dc
        this.append(r)
    }

    function record_external_graphic(this: ref[SaveFOTBuilder], nic: ref[GraphicNICRec], dnic: ref[DisplayNIC])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_EXTERNAL_GRAPHIC)
        if nic <> null
        {
            let c nic.copy(h)
            set c.entity_system_id: InheritedC.pin_string(h, c.entity_system_id)
            set c.notation_system_id: InheritedC.pin_string(h, c.notation_system_id)
            set c.scale_type: InheritedC.pin_fotsym(h, c.scale_type)
            set c.escapement_direction: InheritedC.pin_fotsym(h, c.escapement_direction)
            set r.nic: c as pointer[void]
        }
        let dc this.pin_dnic(dnic)
        set r.dnic: dc
        this.append(r)
    }

    function record_node(this: ref[SaveFOTBuilder], tag: int, node: ref[GroveNode])
    {
        let h this.host
        let r SaveCallRec.make(h, tag)
        set r.node: node
        this.append(r)
    }

    function record_flags(this: ref[SaveFOTBuilder], tag: int, flags: int)
    {
        let h this.host
        let r SaveCallRec.make(h, tag)
        set r.flags: flags
        this.append(r)
    }

    function record_start_table(this: ref[SaveFOTBuilder], nic: ref[TableNICRec], dnic: ref[DisplayNIC])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_START_TABLE)
        if nic <> null
            set r.nic: nic.copy(h) as pointer[void]
        let dc this.pin_dnic(dnic)
        set r.dnic: dc
        this.append(r)
    }

    function record_table_column(this: ref[SaveFOTBuilder], nic: ref[TableColumnNICRec])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_TABLE_COLUMN)
        if nic <> null
            set r.nic: nic.copy(h) as pointer[void]
        this.append(r)
    }

    function record_start_table_cell(this: ref[SaveFOTBuilder], nic: ref[TableCellNICRec])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_START_TABLE_CELL)
        if nic <> null
            set r.nic: nic.copy(h) as pointer[void]
        this.append(r)
    }

    function record_character(this: ref[SaveFOTBuilder], nic: ref[CharacterNICRec])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_CHARACTER)
        if nic <> null
        {
            let c nic.copy(h)
            set c.script: InheritedC.pin_string(h, c.script)
            set c.math_class: InheritedC.pin_fotsym(h, c.math_class)
            set c.math_font_posture: InheritedC.pin_fotsym(h, c.math_font_posture)
            set r.nic: c as pointer[void]
        }
        this.append(r)
    }

    function record_anchor(this: ref[SaveFOTBuilder], nic: ref[AnchorNICRec])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_ANCHOR)
        if nic <> null
            set r.nic: nic.copy(h) as pointer[void]
        this.append(r)
    }

    function record_start_glyph_annotation(this: ref[SaveFOTBuilder], nic: ref[GlyphAnnotationNICRec])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_START_GLYPH_ANNOTATION)
        if nic <> null
            set r.nic: nic.copy(h) as pointer[void]
        this.append(r)
    }

    ; the emphasizing-mark serial open. The `mark:` sosofo has already been
    ; replayed into its own bracket by the time this is recorded, so only the
    ; two priorities need to survive.
    function record_start_em_serial(this: ref[SaveFOTBuilder], nic: ref[EmphasizingMarkNICRec])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_START_EM_SERIAL)
        if nic <> null
            set r.nic: nic.copy(h) as pointer[void]
        this.append(r)
    }

    ; the three math calls that carry a payload (everything else in the family
    ; is a bare bracket recorded with record0).
    function record_radical_radical(this: ref[SaveFOTBuilder], nic: ref[CharacterNICRec])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_RADICAL_RADICAL)
        if nic <> null
        {
            let c nic.copy(h)
            set c.script: InheritedC.pin_string(h, c.script)
            set c.math_class: InheritedC.pin_fotsym(h, c.math_class)
            set c.math_font_posture: InheritedC.pin_fotsym(h, c.math_font_posture)
            set r.nic: c as pointer[void]
        }
        this.append(r)
    }

    function record_start_grid(this: ref[SaveFOTBuilder], nic: ref[GridNICRec])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_START_GRID)
        if nic <> null
            set r.nic: nic.copy(h) as pointer[void]
        this.append(r)
    }

    function record_start_grid_cell(this: ref[SaveFOTBuilder], nic: ref[GridCellNICRec])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_START_GRID_CELL)
        if nic <> null
            set r.nic: nic.copy(h) as pointer[void]
        this.append(r)
    }

    ; the two NIC-bearing layout-composite opens (`side-by-side` and
    ; `aligned-column` carry a bare DisplayNIC and go through record_dnic).
    function record_start_embedded_text(this: ref[SaveFOTBuilder], nic: ref[EmbeddedTextNICRec])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_START_EMBEDDED_TEXT)
        if nic <> null
        {
            let c nic.copy(h)
            set c.direction: InheritedC.pin_fotsym(h, c.direction)
            set r.nic: c as pointer[void]
        }
        this.append(r)
    }

    function record_start_ica(this: ref[SaveFOTBuilder], nic: ref[IncludedContainerAreaNICRec], dnic: ref[DisplayNIC])
    {
        let h this.host
        let r SaveCallRec.make(h, SV_START_ICA)
        if nic <> null
        {
            let c nic.copy(h)
            set c.escapement_direction: InheritedC.pin_fotsym(h, c.escapement_direction)
            set c.scale_type: InheritedC.pin_fotsym(h, c.scale_type)
            set r.nic: c as pointer[void]
        }
        let dc this.pin_dnic(dnic)
        set r.dnic: dc
        this.append(r)
    }

    ; the two multi-mode brackets that carry a mode record (a null principal
    ; mode is the no-principal-port case and stays null).
    function record_multi_mode(this: ref[SaveFOTBuilder], tag: int, mode: ref[MultiModeRec])
    {
        let h this.host
        let r SaveCallRec.make(h, tag)
        if mode <> null
        {
            let c MultiModeRec.make(h)
            set c.has_desc: mode.has_desc
            set c.name: InheritedC.pin_string(h, mode.name)
            set c.desc: InheritedC.pin_string(h, mode.desc)
            set r.nic: c as pointer[void]
        }
        this.append(r)
    }
}
