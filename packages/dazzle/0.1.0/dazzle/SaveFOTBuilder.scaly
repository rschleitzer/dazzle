define SV_END_ALIGNED_COLUMN: int 140

; the ONLINE family. The multi-mode PORTS are already decomposed by
; ProcessContext before anything reaches a queue, so the two mode brackets
; carry only the mode record they print.
define SV_START_MARGINALIA: int 141
define SV_END_MARGINALIA: int 142
define SV_START_MULTI_MODE_SERIAL: int 143
define SV_END_MULTI_MODE_SERIAL: int 144
define SV_START_MULTI_MODE_MODE: int 145
