; ProcessingMode — the construction/style rule set of one mode (Style/
; ProcessingMode.{h,cxx}). Rules match grove nodes; findMatch returns the
; most-specific matching rule, resumably (next-match continues from the last
; match via the Specificity cursor).
;
; Inc 5a scope: construction rules only (styleRule needs InheritedC/StyleStack
; = the print path, deferred). Faithful simplification of the two-ruletype /
; initial-mode-chaining machinery: a single initial mode, one grove. The
; reference's per-GI GroveRules table is a lookup optimization; here element
; rules are kept in one list sorted by specificity and scanned with a GI/
; qualifier match filter — semantically the same first-(most-specific-)match.

use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.Location.Location
use dazzle.Grove.GroveNode
use dazzle.ELObj.ELObj
use dazzle.Expression.Expression
use dazzle.Expression.Environment
use dazzle.Insn.Insn
use dazzle.Pattern.Pattern
use dazzle.Interpreter.Interpreter

; The match cursor (ProcessingMode::Specificity). next_rule_index resumes a
; scan for next-match; found records whether the last findMatch succeeded.
define Specificity (next_rule_index: int, to_initial: bool)
{
    init()
    {
        set this.next_rule_index: 0
        ; 1 once the match fell through from a named processing mode to the
        ; initial mode (reference Specificity::toInitial_) — next-match
        ; resumes on the right side of the fallback boundary.
        set this.to_initial: false
    }
}

; ProcessingMode::Action — a rule body: the compiled Insn (evaluated to a
; sosofo at process time) + its source part/location.
define Action (expr: pointer[Expression], insn: pointer[Insn], part_index: u32, def_loc: Location)
{
    function make(host: pointer[Page], part_index: u32, expr: pointer[Expression], loc: Location) returns pointer[Action]
    {
        let a host.allocate(sizeof Action, alignof Action) as pointer[Action]
        set a.expr: expr
        set a.insn: null
        set a.part_index: part_index
        set a.def_loc: loc
        a
    }

    function compile(this: pointer[Action], interp: pointer[Interpreter])
    {
        if this.insn <> null
            return
        let host interp.get_host()
        let env Environment.make(host)
        set this.insn: Expression.optimize_compile(this.expr, interp, env, 0, null)
    }

    function get_insn(this: Action) returns pointer[Insn]
        insn

    function location(this: Action) returns Location
        def_loc
}

; A rule = an action + (for element rules) a matching pattern. Root rules have
; a null pattern (root nodes match by position, not by pattern).
define Rule (action: pointer[Action], pattern: pointer[Pattern])
{
    function make(host: pointer[Page], action: pointer[Action], pattern: pointer[Pattern]) returns pointer[Rule]
    {
        let r host.allocate(sizeof Rule, alignof Rule) as pointer[Rule]
        set r.action: action
        set r.pattern: pattern
        r
    }

    ; cross-module accessors (fields aren't reachable across modules — S52).
    function get_action(this: pointer[Rule]) returns pointer[Action]
        this.action

    function get_rule_insn(this: pointer[Rule]) returns pointer[Insn]
        this.action.get_insn()

    ; compareSpecificity: part index first (Rule::compareSpecificity), then
    ; pattern specificity (ElementRule::compareSpecificity). -1 => `this` sorts
    ; earlier (more specific / higher priority).
    function compare_specificity(this: Rule, host: pointer[Page], other: pointer[Rule]) returns int
    {
        let i1 this.action.part_index
        let i2 other.action.part_index
        if i1 <> i2
        {
            if i1 < i2
                return 0 - 1
            return 1
        }
        if (this.pattern = null) or (other.pattern = null)
            return 0
        Pattern.compare_specificity(host, this.pattern, other.pattern)
    }
}

define ProcessingMode (name: StringC, initial: pointer[ProcessingMode], defined_flag: bool, root_rules: pointer[Array[pointer[Rule]]], element_rules: pointer[Array[pointer[Rule]]], sorted_elements: pointer[Array[pointer[Rule]]], sorted_built: bool)
{
    function make(host: pointer[Page], name: StringC, initial: pointer[ProcessingMode]) returns pointer[ProcessingMode]
    {
        ; rule lists are allocated lazily (in add_rule) — an interpreter with no
        ; stylesheet (every eval-only run) never grabs their exclusive pages.
        let m host.allocate(sizeof ProcessingMode, alignof ProcessingMode) as pointer[ProcessingMode]
        set m.name: name
        set m.initial: initial
        set m.defined_flag: false
        set m.root_rules: null
        set m.element_rules: null
        set m.sorted_elements: null
        set m.sorted_built: false
        m
    }

    function get_name(this: ProcessingMode) returns StringC
        name

    function defined(this: ProcessingMode) returns bool
        defined_flag

    function set_defined(this: pointer[ProcessingMode])
        set this.defined_flag: true

    ; addRule: one Action shared by all patterns; each pattern -> an ElementRule;
    ; a root rule -> a pattern-less Rule inserted into root_rules by specificity.
    function add_rule(this: pointer[ProcessingMode], root: bool, patterns: pointer[Array[pointer[Pattern]]], expr: pointer[Expression], loc: Location, interp: pointer[Interpreter])
    {
        let host interp.get_host()
        if this.element_rules = null
            set this.element_rules: Array[pointer[Rule]]^host()
        if this.root_rules = null
            set this.root_rules: Array[pointer[Rule]]^host()
        let action Action.make(host, interp.current_part_index(), expr, loc)
        if patterns <> null
        {
            let n patterns.get_length()
            let b patterns.get_buffer()
            var i: size_t 0
            while i < n
            {
                let pat *(b + i)
                this.element_rules.add(Rule.make(host, action, pat))
                set i: i + 1
            }
        }
        set this.sorted_built: false
        if root = false
            return
        let r Rule.make(host, action, null)
        this.root_rules.add(r)
        ; keep root_rules sorted (bubble the new rule up while more specific).
        let rr this.root_rules
        var k (rr.get_length() as int) - 1
        while k > 0
        {
            let prev *(rr.get_buffer() + (k - 1))
            let curr *(rr.get_buffer() + k)
            if prev.compare_specificity(host, curr) <= 0
                break
            set *(rr.get_buffer() + (k - 1)): curr
            set *(rr.get_buffer() + k): prev
            set k: k - 1
        }
    }

    ; build the element-rule scan order once (selection sort by specificity;
    ; rule counts per stylesheet are small).
    function build_sorted(this: pointer[ProcessingMode], host: pointer[Page])
    {
        if this.sorted_built
            return
        if this.element_rules = null
        {
            set this.sorted_elements: Array[pointer[Rule]]^host()
            set this.sorted_built: true
            return
        }
        let src this.element_rules
        let n src.get_length()
        let sorted Array[pointer[Rule]]^host()
        var i: size_t 0
        while i < n
        {
            sorted.add(*(src.get_buffer() + i))
            set i: i + 1
        }
        let sb sorted.get_buffer()
        let ni n as int
        var a 0
        while a < ni
        {
            var best a
            var c a + 1
            while c < ni
            {
                let rc *(sb + c)
                let rbest *(sb + best)
                if rc.compare_specificity(host, rbest) < 0
                    set best: c
                set c: c + 1
            }
            if best <> a
            {
                let tmp *(sb + a)
                set *(sb + a): *(sb + best)
                set *(sb + best): tmp
            }
            set a: a + 1
        }
        set this.sorted_elements: sorted
        set this.sorted_built: true
    }

    ; findMatch: element node -> element rules; root node (no parent) -> root
    ; rules. Advances `spec` so a subsequent next-match resumes.
    function find_match(this: pointer[ProcessingMode], node: pointer[GroveNode], host: pointer[Page], spec: pointer[Specificity]) returns pointer[Rule]
    {
        if node = null
            return null
        if node.get_class() = GN_ELEMENT
            return this.find_element_match(node, host, spec)
        ; STRUCTURAL: ProcessingMode::findMatch tests `getOrigin`, NOT getParent
        ; — with the parent axis a prolog/epilog PI (axis parent null) would be
        ; misrouted to the root rules.
        if node.get_parent() = null
            return this.find_root_match(host, spec)
        null
    }

    ; one scan pass over THIS mode's sorted element rules from the spec cursor.
    function scan_element_rules(this: pointer[ProcessingMode], node: pointer[GroveNode], host: pointer[Page], spec: pointer[Specificity]) returns pointer[Rule]
    {
        this.build_sorted(host)
        let sorted this.sorted_elements
        let n sorted.get_length() as int
        let b sorted.get_buffer()
        var i spec.next_rule_index
        while i < n
        {
            let rule *(b + i)
            if rule.pattern.matches(node)
            {
                set spec.next_rule_index: i + 1
                return rule
            }
            set i: i + 1
        }
        set spec.next_rule_index: i
        null
    }

    ; A named mode's scan FALLS THROUGH to the initial mode's rules when it
    ; is exhausted (reference findElementMatch: specificity.toInitial_ — the
    ; cursor persists across the boundary so next-match resumes correctly).
    function find_element_match(this: pointer[ProcessingMode], node: pointer[GroveNode], host: pointer[Page], spec: pointer[Specificity]) returns pointer[Rule]
    {
        if spec.to_initial = false
        {
            let r this.scan_element_rules(node, host, spec)
            if r <> null
                return r
            if this.initial = null
                return null
            set spec.to_initial: true
            set spec.next_rule_index: 0
        }
        let m this.initial
        if m = null
            return null
        m.scan_element_rules(node, host, spec)
    }

    function scan_root_rules(this: pointer[ProcessingMode], spec: pointer[Specificity]) returns pointer[Rule]
    {
        if this.root_rules = null
            return null
        let rr this.root_rules
        let n rr.get_length() as int
        let i spec.next_rule_index
        if i < n
        {
            set spec.next_rule_index: i + 1
            return *(rr.get_buffer() + i)
        }
        set spec.next_rule_index: n
        null
    }

    function find_root_match(this: pointer[ProcessingMode], host: pointer[Page], spec: pointer[Specificity]) returns pointer[Rule]
    {
        if spec.to_initial = false
        {
            let r this.scan_root_rules(spec)
            if r <> null
                return r
            if this.initial = null
                return null
            set spec.to_initial: true
            set spec.next_rule_index: 0
        }
        let m this.initial
        if m = null
            return null
        m.scan_root_rules(spec)
    }

    ; compile every rule's action.
    function compile(this: pointer[ProcessingMode], interp: pointer[Interpreter])
    {
        if this.root_rules <> null
        {
            let rr this.root_rules
            var i: size_t 0
            while i < rr.get_length()
            {
                let r *(rr.get_buffer() + i)
                r.action.compile(interp)
                set i: i + 1
            }
        }
        if this.element_rules <> null
        {
            ; the reference elementRules_ is an IList whose insert PREPENDS —
            ; forward iteration there compiles rules in REVERSE file order
            ; (observable through compile-time diagnostics: constant NIC
            ; conversions, unknown make keywords).
            let er this.element_rules
            var j er.get_length() as int
            while j > 0
            {
                set j: j - 1
                let r *(er.get_buffer() + j)
                r.action.compile(interp)
            }
        }
    }
}
