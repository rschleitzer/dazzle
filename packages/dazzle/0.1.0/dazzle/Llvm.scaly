; Llvm — the LLVM-C surface dazzle's Stage-6b JIT needs, declared inside the
; dazzle package.
;
; Why here and not in the scaly stdlib: the bindings are pure `extern`
; declarations, so they cost nothing until something calls them — but a module
; in `packages/scaly` would put them in the runtime archive EVERY Scaly program
; links, and would make every seed refresh carry them. dazzle is the only
; consumer, and `packages/scalyc/…/LLVM.scaly` (the compiler's own, much larger
; binding set) is not reachable from here: dazzle depends on `scaly` and
; `opensp`, not on the compiler. So the two binding sets stay independent, the
; way `scaly/llvm/*` and the compiler's already are.
;
; ABI RULES THIS FILE MUST OBEY (tests/abi/run.sh gates them, and the
; 2026-08-05 audit found 84 wrong result types in the compiler's own LLVM
; bindings):
;   * a C `int`/`LLVMBool` RESULT is `i32`, never `int` — reading a 32-bit
;     result as a 64-bit Scaly `int` leaves the upper half unspecified, which
;     flips the sign of every `< 0` test;
;   * a C `unsigned` parameter is `u32`, never `int`;
;   * an enum parameter is `i32` (a C enum is an int);
;   * an opaque `…Ref` is a ONE-FIELD HANDLE STRUCT, the same form
;     `packages/scalyc/…/LLVM.scaly` uses. It is ABI-identical to the plain
;     pointer this file used until 2026-08-26 -- measured on the compiler's own
;     emission: a parameter lowers to a bare `ptr`, the handle itself is
;     `type { ptr }`, and a one-pointer composite is returned in x0/RAX under
;     both LP64 ABIs (the rosetta suite compiles the compiler on x86_64 with
;     these bindings). What it buys is the one thing `pointer[void]` cannot
;     give: a builder handed where a module belongs is a PLANNER error instead
;     of a silent LLVM abort. Cost is one `extractvalue` per argument, which
;     `opt -O2` folds away -- and this file's pipeline runs it
;     (tests/dazzle/build-cli.sh).
;
; LLVMOrcExecutorAddress is a bare u64 (a code address), NOT a handle — the
; lookup writes it through a `pointer[u64]`.
;
; Error convention: every function returning LLVMErrorRef returns null on
; success. A non-null error MUST be consumed (LLVMGetErrorMessage +
; LLVMConsumeError) or LLVM aborts at exit.

; ★★★THE PRICE OF THE HANDLE, AND IT IS SILENT: `h = null` / `h <> null` on a
; handle STRUCT is not a null test. It compiles, it is not diagnosed, and it
; answers the wrong thing -- ask `h.handle = null`, the way the compiler's
; Emitter does. It cost a debugging round on the 2026-08-26 conversion: one
; missed `if look_err <> null` in the ORC lookup took the error branch for
; every region, `Llvm.failed` then correctly said "no error" and printed
; nothing, and the JIT went from 12 regions / 0 rejected to 0 / 36 -- WITHOUT
; a single message. A bare `null` is likewise not a handle: construct it
; (`LLVMTargetMachineRef(null)`), and a `return null` from a handle-returning
; function needs the same. ★The tell for the whole class is a JIT that builds,
; links and runs while compiling NOTHING.
;
; ===========================================================================
; Opaque handle types
;
; In llvm-c each of these is a `typedef struct LLVMOpaque… *…Ref` -- a pointer
; to an incomplete type, so there is no struct body to port. The one-field
; wrapper reproduces the C type exactly while keeping the handles APART from
; each other inside Scaly.
; ===========================================================================
define LLVMContextRef(handle: pointer[void])
define LLVMModuleRef(handle: pointer[void])
define LLVMTypeRef(handle: pointer[void])
define LLVMValueRef(handle: pointer[void])
define LLVMBasicBlockRef(handle: pointer[void])
define LLVMBuilderRef(handle: pointer[void])
define LLVMTargetRef(handle: pointer[void])
define LLVMTargetMachineRef(handle: pointer[void])
define LLVMPassBuilderOptionsRef(handle: pointer[void])
define LLVMErrorRef(handle: pointer[void])

; ORC: the JIT session's own handles. LLVMOrcLLJITBuilderRef is NOT the
; LLVMBuilderRef above -- one builds a JIT, the other builds instructions, and
; keeping them apart is most of the point of this section.
define LLVMOrcThreadSafeContextRef(handle: pointer[void])
define LLVMOrcThreadSafeModuleRef(handle: pointer[void])
define LLVMOrcLLJITRef(handle: pointer[void])
define LLVMOrcLLJITBuilderRef(handle: pointer[void])
define LLVMOrcJITTargetMachineBuilderRef(handle: pointer[void])
define LLVMOrcJITDylibRef(handle: pointer[void])

; ===========================================================================
; Target registration
;
; LLVMInitializeNativeTarget and friends are static-inline helpers in
; llvm-c/Target.h — not real symbols — so the per-target entry points are
; called directly, exactly as scalyc's Emitter.write_object_to_file does.
; Both backends are registered so one seed serves arm64 and x86_64 hosts.
; ===========================================================================
procedure LLVMInitializeAArch64TargetInfo() extern
procedure LLVMInitializeAArch64Target() extern
procedure LLVMInitializeAArch64TargetMC() extern
procedure LLVMInitializeAArch64AsmPrinter() extern
procedure LLVMInitializeX86TargetInfo() extern
procedure LLVMInitializeX86Target() extern
procedure LLVMInitializeX86TargetMC() extern
procedure LLVMInitializeX86AsmPrinter() extern

; ===========================================================================
; Context, module
; ===========================================================================
function LLVMModuleCreateWithNameInContext(module_id: pointer[const_char], context: LLVMContextRef) returns LLVMModuleRef extern
procedure LLVMSetDataLayout(mod: LLVMModuleRef, layout: pointer[const_char]) extern
function LLVMPrintModuleToString(mod: LLVMModuleRef) returns pointer[char] extern
procedure LLVMDisposeMessage(message: pointer[char]) extern

; LLVMVerifyModule(mod, action, out_message) — action 2 = ReturnStatus (do not
; abort, hand back a message). Returns 1 when the module is BROKEN. The JIT
; runs this on every module it builds: a malformed region is our own bug and
; must be loud, not miscompiled.
function LLVMVerifyModule(mod: LLVMModuleRef, action: i32, out_message: pointer[pointer[char]]) returns i32 extern

; ===========================================================================
; Types
; ===========================================================================
function LLVMInt8TypeInContext(context: LLVMContextRef) returns LLVMTypeRef extern
function LLVMInt64TypeInContext(context: LLVMContextRef) returns LLVMTypeRef extern
function LLVMVoidTypeInContext(context: LLVMContextRef) returns LLVMTypeRef extern
function LLVMPointerTypeInContext(context: LLVMContextRef, address_space: u32) returns LLVMTypeRef extern
function LLVMFunctionType(return_type: LLVMTypeRef, param_types: pointer[LLVMTypeRef], param_count: u32, is_var_arg: i32) returns LLVMTypeRef extern

; ===========================================================================
; Values, constants, functions, blocks
; ===========================================================================
function LLVMConstInt(int_ty: LLVMTypeRef, n: u64, sign_extend: i32) returns LLVMValueRef extern
function LLVMConstIntToPtr(constant_val: LLVMValueRef, to_type: LLVMTypeRef) returns LLVMValueRef extern
function LLVMAddFunction(mod: LLVMModuleRef, name: pointer[const_char], function_ty: LLVMTypeRef) returns LLVMValueRef extern
function LLVMGetParam(fn: LLVMValueRef, index: u32) returns LLVMValueRef extern
function LLVMAppendBasicBlockInContext(context: LLVMContextRef, fn: LLVMValueRef, name: pointer[const_char]) returns LLVMBasicBlockRef extern

; ===========================================================================
; Builder
; ===========================================================================
function LLVMCreateBuilderInContext(context: LLVMContextRef) returns LLVMBuilderRef extern
procedure LLVMPositionBuilderAtEnd(builder: LLVMBuilderRef, block: LLVMBasicBlockRef) extern
function LLVMGetInsertBlock(builder: LLVMBuilderRef) returns LLVMBasicBlockRef extern
procedure LLVMDisposeBuilder(builder: LLVMBuilderRef) extern
function LLVMBuildRet(builder: LLVMBuilderRef, v: LLVMValueRef) returns LLVMValueRef extern
function LLVMBuildBr(builder: LLVMBuilderRef, dest: LLVMBasicBlockRef) returns LLVMValueRef extern
function LLVMBuildCondBr(builder: LLVMBuilderRef, cond: LLVMValueRef, then_block: LLVMBasicBlockRef, else_block: LLVMBasicBlockRef) returns LLVMValueRef extern
function LLVMBuildCall2(builder: LLVMBuilderRef, fn_ty: LLVMTypeRef, fn: LLVMValueRef, args: pointer[LLVMValueRef], num_args: u32, name: pointer[const_char]) returns LLVMValueRef extern
function LLVMBuildLoad2(builder: LLVMBuilderRef, ty: LLVMTypeRef, pointer_val: LLVMValueRef, name: pointer[const_char]) returns LLVMValueRef extern
function LLVMBuildStore(builder: LLVMBuilderRef, val: LLVMValueRef, ptr: LLVMValueRef) returns LLVMValueRef extern
function LLVMBuildInBoundsGEP2(builder: LLVMBuilderRef, ty: LLVMTypeRef, pointer_val: LLVMValueRef, indices: pointer[LLVMValueRef], num_indices: u32, name: pointer[const_char]) returns LLVMValueRef extern
function LLVMBuildAdd(builder: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: pointer[const_char]) returns LLVMValueRef extern
function LLVMBuildSub(builder: LLVMBuilderRef, lhs: LLVMValueRef, rhs: LLVMValueRef, name: pointer[const_char]) returns LLVMValueRef extern
function LLVMBuildICmp(builder: LLVMBuilderRef, predicate: i32, lhs: LLVMValueRef, rhs: LLVMValueRef, name: pointer[const_char]) returns LLVMValueRef extern
function LLVMBuildPtrToInt(builder: LLVMBuilderRef, val: LLVMValueRef, dest_ty: LLVMTypeRef, name: pointer[const_char]) returns LLVMValueRef extern

; The entry multiplexer of a compiled body (Jit.scaly, rung 1): one `switch`
; over the insn the trampoline entered with, so EVERY insn of a body is a valid
; entry point and no mid-body insn ever becomes a region root of its own.
; num_cases is only a capacity hint — LLVMAddCase may be called any number of
; times afterwards, which is what lets the cases be added as blocks appear.
function LLVMBuildSwitch(builder: LLVMBuilderRef, v: LLVMValueRef, else_block: LLVMBasicBlockRef, num_cases: u32) returns LLVMValueRef extern
procedure LLVMAddCase(switch_instr: LLVMValueRef, on_val: LLVMValueRef, dest: LLVMBasicBlockRef) extern

; LLVMIntPredicate values (llvm-c/Core.h) — a C enum, so i32 at the call.
define LLVM_INT_EQ: i32 32
define LLVM_INT_NE: i32 33
define LLVM_INT_SGT: i32 38

; LLVMVerifierFailureAction: 0 = AbortProcess, 1 = PrintMessage, 2 = ReturnStatus
define LLVM_VERIFIER_RETURN_STATUS: i32 2

; ===========================================================================
; The new-PM pass pipeline. The JIT runs it over every generated module before
; handing it to ORC: without it the code keeps every redundant load and store of
; the VM's `sp`/`sbase` that the per-insn lowering emits, and measured 2026-08-06
; that alone made generated code SLOWER than the interpreter it replaces.
; TM may be null — the pipeline we run needs no target information.
; ===========================================================================
function LLVMCreatePassBuilderOptions() returns LLVMPassBuilderOptionsRef extern
function LLVMRunPasses(mod: LLVMModuleRef, passes: pointer[const_char], tm: LLVMTargetMachineRef, options: LLVMPassBuilderOptionsRef) returns LLVMErrorRef extern
procedure LLVMDisposePassBuilderOptions(options: LLVMPassBuilderOptionsRef) extern

; ===========================================================================
; Errors
; ===========================================================================
function LLVMGetErrorMessage(err: LLVMErrorRef) returns pointer[char] extern
procedure LLVMDisposeErrorMessage(err_msg: pointer[char]) extern
procedure LLVMConsumeError(err: LLVMErrorRef) extern

; ===========================================================================
; ORC LLJIT
;
; The JIT'd code calls back into this binary through inttoptr CONSTANTS (the
; helper addresses come from `&fn` in Scaly), never by symbol name — so no
; process-symbol generator is installed here. That is deliberate: the dazzle
; binary is linked with whole-program LTO and `hidden` visibility
; (tools/link-lto.sh), so its Scaly symbols are NOT dynamically resolvable, and
; a name-based seam would break exactly in the shipping configuration while
; working in a debug build.
; ===========================================================================
; ★ The LLJIT's own TargetMachine, built explicitly so the BACKEND opt level can
; be chosen. Measured 2026-08-06 and it is the dominant cost of the whole JIT:
; ~3.3 ms of LLVM per compiled body, of which only ~1 ms is the IR pass pipeline
; — the rest is instruction selection, register allocation and object emission,
; all of which LLJIT runs at its default CodeGenOptLevel (aggressive) unless it
; is handed a TargetMachine that says otherwise. Our IR has already been through
; sroa/gvn/instcombine, so the backend's own optimisation has little left to find.
;
; The wiring is: detect the host triple/CPU/features -> LLVMCreateTargetMachine
; with the level we want -> wrap it in a JITTargetMachineBuilder -> hand that to
; an LLJITBuilder. PIC and JITDefault are not preferences: a JIT'd object must be
; position-independent, and the JIT code model is what keeps the emitted
; relocations in range of the process's address space.
function LLVMGetDefaultTargetTriple() returns pointer[char] extern
function LLVMGetHostCPUName() returns pointer[char] extern
function LLVMGetHostCPUFeatures() returns pointer[char] extern
function LLVMGetTargetFromTriple(triple: pointer[const_char], target: pointer[LLVMTargetRef], error_message: pointer[pointer[char]]) returns i32 extern
function LLVMCreateTargetMachine(target: LLVMTargetRef, triple: pointer[const_char], cpu: pointer[const_char], features: pointer[const_char], level: i32, reloc: i32, code_model: i32) returns LLVMTargetMachineRef extern

; LLVMCodeGenOptLevel: 0 None, 1 Less, 2 Default, 3 Aggressive.
; LLVMRelocMode:       2 PIC.   LLVMCodeModel: 1 JITDefault.
define LLVM_CODEGEN_LEVEL_NONE: i32 0
define LLVM_CODEGEN_LEVEL_LESS: i32 1
define LLVM_RELOC_PIC: i32 2
define LLVM_CODE_MODEL_JIT_DEFAULT: i32 1

function LLVMOrcCreateNewThreadSafeContext() returns LLVMOrcThreadSafeContextRef extern
function LLVMOrcThreadSafeContextGetContext(tsc: LLVMOrcThreadSafeContextRef) returns LLVMContextRef extern
function LLVMOrcCreateNewThreadSafeModule(mod: LLVMModuleRef, tsc: LLVMOrcThreadSafeContextRef) returns LLVMOrcThreadSafeModuleRef extern
function LLVMOrcCreateLLJIT(result: pointer[LLVMOrcLLJITRef], builder: LLVMOrcLLJITBuilderRef) returns LLVMErrorRef extern
function LLVMOrcCreateLLJITBuilder() returns LLVMOrcLLJITBuilderRef extern
procedure LLVMOrcDisposeLLJITBuilder(builder: LLVMOrcLLJITBuilderRef) extern
function LLVMOrcJITTargetMachineBuilderCreateFromTargetMachine(tm: LLVMTargetMachineRef) returns LLVMOrcJITTargetMachineBuilderRef extern
procedure LLVMOrcLLJITBuilderSetJITTargetMachineBuilder(builder: LLVMOrcLLJITBuilderRef, tmb: LLVMOrcJITTargetMachineBuilderRef) extern
function LLVMOrcLLJITGetMainJITDylib(j: LLVMOrcLLJITRef) returns LLVMOrcJITDylibRef extern
function LLVMOrcLLJITAddLLVMIRModule(j: LLVMOrcLLJITRef, jd: LLVMOrcJITDylibRef, tsm: LLVMOrcThreadSafeModuleRef) returns LLVMErrorRef extern
function LLVMOrcLLJITLookup(j: LLVMOrcLLJITRef, result: pointer[u64], name: pointer[const_char]) returns LLVMErrorRef extern
function LLVMOrcLLJITGetDataLayoutStr(j: LLVMOrcLLJITRef) returns pointer[const_char] extern

define Llvm
{
    ; Register the native backends once. Idempotent in LLVM (the registries
    ; guard themselves), but the flag keeps repeated JIT sessions cheap.
    function init_native_target()
    {
        LLVMInitializeAArch64TargetInfo()
        LLVMInitializeAArch64Target()
        LLVMInitializeAArch64TargetMC()
        LLVMInitializeAArch64AsmPrinter()
        LLVMInitializeX86TargetInfo()
        LLVMInitializeX86Target()
        LLVMInitializeX86TargetMC()
        LLVMInitializeX86AsmPrinter()
    }

    ; Consume an LLVMErrorRef and report it. Returns true when there WAS an
    ; error (so callers read `if Llvm.failed(err, "…") return …`). Consuming is
    ; mandatory — an unconsumed LLVMErrorRef aborts the process at exit, which
    ; would turn a JIT setup problem into a crash with no message.
    function failed(err: LLVMErrorRef, what: pointer[const_char]) returns bool
    {
        if err.handle = null
            return false
        let msg LLVMGetErrorMessage(err)
        scaly_eputs "dazzle JIT: "
        scaly_eputs what
        scaly_eputs ": "
        if msg <> null
        {
            ; bound first: a parenthesised cast as the argument of a PARENLESS
            ; call mis-parses and the call is DROPPED — which would make every
            ; JIT error message here silent (measured 2026-08-06).
            let msg_c msg as pointer[const_char]
            scaly_eputs msg_c
        }
        scaly_eputs "\n"
        if msg <> null
            LLVMDisposeErrorMessage(msg)
        true
    }
}
