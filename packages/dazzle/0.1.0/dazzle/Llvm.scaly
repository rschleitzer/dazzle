; Llvm — the LLVM-C surface dazzle's Stage-6b JIT needs, declared inside the
; dazzle package.
;
; Why here and not in the scaly stdlib: the bindings are pure `extern`
; declarations, so they cost nothing until something calls them — but a module
; in `packages/scaly` would put them in the runtime archive EVERY Scaly program
; links, and would make every seed refresh carry them. dazzle is the only
; consumer, and `packages/scalyc/…/LLVM.scaly` (the compiler's own, much larger
; binding set) is not reachable from here: dazzle depends on `scaly` and
; `opensp`, not on the compiler. So the two binding sets stay independent, the
; way `scaly/llvm/*` and the compiler's already are.
;
; ABI RULES THIS FILE MUST OBEY (tests/abi/run.sh gates them, and the
; 2026-08-05 audit found 84 wrong result types in the compiler's own LLVM
; bindings):
;   * a C `int`/`LLVMBool` RESULT is `i32`, never `int` — reading a 32-bit
;     result as a 64-bit Scaly `int` leaves the upper half unspecified, which
;     flips the sign of every `< 0` test;
;   * a C `unsigned` parameter is `u32`, never `int`;
;   * an enum parameter is `i32` (a C enum is an int);
;   * an opaque `…Ref` is `pointer[void]`. The compiler's bindings wrap each in
;     a one-field struct; a plain pointer has the same ABI and needs no casts
;     at the call sites here.
;
; LLVMOrcExecutorAddress is a bare u64 (a code address), NOT a handle — the
; lookup writes it through a `pointer[u64]`.
;
; Error convention: every function returning LLVMErrorRef returns null on
; success. A non-null error MUST be consumed (LLVMGetErrorMessage +
; LLVMConsumeError) or LLVM aborts at exit.

; ===========================================================================
; Target registration
;
; LLVMInitializeNativeTarget and friends are static-inline helpers in
; llvm-c/Target.h — not real symbols — so the per-target entry points are
; called directly, exactly as scalyc's Emitter.write_object_to_file does.
; Both backends are registered so one seed serves arm64 and x86_64 hosts.
; ===========================================================================
procedure LLVMInitializeAArch64TargetInfo() extern
procedure LLVMInitializeAArch64Target() extern
procedure LLVMInitializeAArch64TargetMC() extern
procedure LLVMInitializeAArch64AsmPrinter() extern
procedure LLVMInitializeX86TargetInfo() extern
procedure LLVMInitializeX86Target() extern
procedure LLVMInitializeX86TargetMC() extern
procedure LLVMInitializeX86AsmPrinter() extern

; ===========================================================================
; Context, module
; ===========================================================================
function LLVMModuleCreateWithNameInContext(module_id: pointer[const_char], context: pointer[void]) returns pointer[void] extern
procedure LLVMSetDataLayout(mod: pointer[void], layout: pointer[const_char]) extern
function LLVMPrintModuleToString(mod: pointer[void]) returns pointer[char] extern
procedure LLVMDisposeMessage(message: pointer[char]) extern

; LLVMVerifyModule(mod, action, out_message) — action 2 = ReturnStatus (do not
; abort, hand back a message). Returns 1 when the module is BROKEN. The JIT
; runs this on every module it builds: a malformed region is our own bug and
; must be loud, not miscompiled.
function LLVMVerifyModule(mod: pointer[void], action: i32, out_message: pointer[pointer[char]]) returns i32 extern

; ===========================================================================
; Types
; ===========================================================================
function LLVMInt8TypeInContext(context: pointer[void]) returns pointer[void] extern
function LLVMInt64TypeInContext(context: pointer[void]) returns pointer[void] extern
function LLVMVoidTypeInContext(context: pointer[void]) returns pointer[void] extern
function LLVMPointerTypeInContext(context: pointer[void], address_space: u32) returns pointer[void] extern
function LLVMFunctionType(return_type: pointer[void], param_types: pointer[pointer[void]], param_count: u32, is_var_arg: i32) returns pointer[void] extern

; ===========================================================================
; Values, constants, functions, blocks
; ===========================================================================
function LLVMConstInt(int_ty: pointer[void], n: u64, sign_extend: i32) returns pointer[void] extern
function LLVMConstIntToPtr(constant_val: pointer[void], to_type: pointer[void]) returns pointer[void] extern
function LLVMAddFunction(mod: pointer[void], name: pointer[const_char], function_ty: pointer[void]) returns pointer[void] extern
function LLVMGetParam(fn: pointer[void], index: u32) returns pointer[void] extern
function LLVMAppendBasicBlockInContext(context: pointer[void], fn: pointer[void], name: pointer[const_char]) returns pointer[void] extern

; ===========================================================================
; Builder
; ===========================================================================
function LLVMCreateBuilderInContext(context: pointer[void]) returns pointer[void] extern
procedure LLVMPositionBuilderAtEnd(builder: pointer[void], block: pointer[void]) extern
function LLVMGetInsertBlock(builder: pointer[void]) returns pointer[void] extern
procedure LLVMDisposeBuilder(builder: pointer[void]) extern
function LLVMBuildRet(builder: pointer[void], v: pointer[void]) returns pointer[void] extern
function LLVMBuildBr(builder: pointer[void], dest: pointer[void]) returns pointer[void] extern
function LLVMBuildCondBr(builder: pointer[void], cond: pointer[void], then_block: pointer[void], else_block: pointer[void]) returns pointer[void] extern
function LLVMBuildCall2(builder: pointer[void], fn_ty: pointer[void], fn: pointer[void], args: pointer[pointer[void]], num_args: u32, name: pointer[const_char]) returns pointer[void] extern
function LLVMBuildLoad2(builder: pointer[void], ty: pointer[void], pointer_val: pointer[void], name: pointer[const_char]) returns pointer[void] extern
function LLVMBuildStore(builder: pointer[void], val: pointer[void], ptr: pointer[void]) returns pointer[void] extern
function LLVMBuildInBoundsGEP2(builder: pointer[void], ty: pointer[void], pointer_val: pointer[void], indices: pointer[pointer[void]], num_indices: u32, name: pointer[const_char]) returns pointer[void] extern
function LLVMBuildAdd(builder: pointer[void], lhs: pointer[void], rhs: pointer[void], name: pointer[const_char]) returns pointer[void] extern
function LLVMBuildSub(builder: pointer[void], lhs: pointer[void], rhs: pointer[void], name: pointer[const_char]) returns pointer[void] extern
function LLVMBuildICmp(builder: pointer[void], predicate: i32, lhs: pointer[void], rhs: pointer[void], name: pointer[const_char]) returns pointer[void] extern
function LLVMBuildPtrToInt(builder: pointer[void], val: pointer[void], dest_ty: pointer[void], name: pointer[const_char]) returns pointer[void] extern

; LLVMIntPredicate values (llvm-c/Core.h) — a C enum, so i32 at the call.
define LLVM_INT_EQ: i32 32
define LLVM_INT_NE: i32 33
define LLVM_INT_SGT: i32 38

; LLVMVerifierFailureAction: 0 = AbortProcess, 1 = PrintMessage, 2 = ReturnStatus
define LLVM_VERIFIER_RETURN_STATUS: i32 2

; ===========================================================================
; The new-PM pass pipeline. The JIT runs it over every generated module before
; handing it to ORC: without it the code keeps every redundant load and store of
; the VM's `sp`/`sbase` that the per-insn lowering emits, and measured 2026-08-06
; that alone made generated code SLOWER than the interpreter it replaces.
; TM may be null — the pipeline we run needs no target information.
; ===========================================================================
function LLVMCreatePassBuilderOptions() returns pointer[void] extern
function LLVMRunPasses(mod: pointer[void], passes: pointer[const_char], tm: pointer[void], options: pointer[void]) returns pointer[void] extern
procedure LLVMDisposePassBuilderOptions(options: pointer[void]) extern

; ===========================================================================
; Errors
; ===========================================================================
function LLVMGetErrorMessage(err: pointer[void]) returns pointer[char] extern
procedure LLVMDisposeErrorMessage(err_msg: pointer[char]) extern
procedure LLVMConsumeError(err: pointer[void]) extern

; ===========================================================================
; ORC LLJIT
;
; The JIT'd code calls back into this binary through inttoptr CONSTANTS (the
; helper addresses come from `&fn` in Scaly), never by symbol name — so no
; process-symbol generator is installed here. That is deliberate: the dazzle
; binary is linked with whole-program LTO and `hidden` visibility
; (tools/link-lto.sh), so its Scaly symbols are NOT dynamically resolvable, and
; a name-based seam would break exactly in the shipping configuration while
; working in a debug build.
; ===========================================================================
function LLVMOrcCreateNewThreadSafeContext() returns pointer[void] extern
function LLVMOrcThreadSafeContextGetContext(tsc: pointer[void]) returns pointer[void] extern
function LLVMOrcCreateNewThreadSafeModule(mod: pointer[void], tsc: pointer[void]) returns pointer[void] extern
function LLVMOrcCreateLLJIT(result: pointer[pointer[void]], builder: pointer[void]) returns pointer[void] extern
function LLVMOrcLLJITGetMainJITDylib(j: pointer[void]) returns pointer[void] extern
function LLVMOrcLLJITAddLLVMIRModule(j: pointer[void], jd: pointer[void], tsm: pointer[void]) returns pointer[void] extern
function LLVMOrcLLJITLookup(j: pointer[void], result: pointer[u64], name: pointer[const_char]) returns pointer[void] extern
function LLVMOrcLLJITGetDataLayoutStr(j: pointer[void]) returns pointer[const_char] extern

define Llvm
{
    ; Register the native backends once. Idempotent in LLVM (the registries
    ; guard themselves), but the flag keeps repeated JIT sessions cheap.
    function init_native_target()
    {
        LLVMInitializeAArch64TargetInfo()
        LLVMInitializeAArch64Target()
        LLVMInitializeAArch64TargetMC()
        LLVMInitializeAArch64AsmPrinter()
        LLVMInitializeX86TargetInfo()
        LLVMInitializeX86Target()
        LLVMInitializeX86TargetMC()
        LLVMInitializeX86AsmPrinter()
    }

    ; Consume an LLVMErrorRef and report it. Returns true when there WAS an
    ; error (so callers read `if Llvm.failed(err, "…") return …`). Consuming is
    ; mandatory — an unconsumed LLVMErrorRef aborts the process at exit, which
    ; would turn a JIT setup problem into a crash with no message.
    function failed(err: pointer[void], what: pointer[const_char]) returns bool
    {
        if err = null
            return false
        let msg LLVMGetErrorMessage(err)
        scaly_eputs "dazzle JIT: "
        scaly_eputs what
        scaly_eputs ": "
        if msg <> null
        {
            ; bound first: a parenthesised cast as the argument of a PARENLESS
            ; call mis-parses and the call is DROPPED — which would make every
            ; JIT error message here silent (measured 2026-08-06).
            let msg_c msg as pointer[const_char]
            scaly_eputs msg_c
        }
        scaly_eputs "\n"
        if msg <> null
            LLVMDisposeErrorMessage(msg)
        true
    }
}
