define ICA_WIDTH_FULL: int 0
define ICA_WIDTH_MINIMUM: int 1
define ICA_WIDTH_EXPLICIT: int 2
define ICA_HEIGHT_FULL: int 0
define ICA_HEIGHT_MINIMUM: int 1
define ICA_HEIGHT_EXPLICIT: int 2

; FOTBuilder::IncludedContainerAreaNIC (FOTBuilder.h:377) — the one NIC record
; of this family that derives from BOTH DisplayNIC and InlineNIC. The display
; half travels in the shared DisplayNIC slot (the class is a display_foc), the
; two inline break priorities and the nine own fields live here.
; ★`scaleType` defaults to symbolMaxUniform, NOT symbolFalse — so an
; untouched included-container-area still prints scale="max-uniform", while a
; NUMERIC or PAIR scale sets the type to symbolFalse and prints scale-x/-y.
define IncludedContainerAreaNIC
(
    var escapement_direction: FotSym
    var is_display: bool
    var width_type: int
    var width: LengthSpec
    var height_type: int
    var height: LengthSpec
    var position_point_x: LengthSpec
    var position_point_y: LengthSpec
    var contents_rotation: int
    var scale_type: FotSym
    var scale_x: double
    var scale_y: double
    var break_before_priority: int
    var break_after_priority: int
)
{
    function make(host: ref[Page]) returns ref[IncludedContainerAreaNIC]
    {
        var st FotSym()
        set st.code: SYM_MAX_UNIFORM
        let r &IncludedContainerAreaNIC^host(FotSym(), false, ICA_WIDTH_FULL, LengthSpec(), ICA_HEIGHT_FULL, LengthSpec(), LengthSpec(), LengthSpec(), 0, st, 0.0, 0.0, 0, 0)
        r
    }

    function copy(this: ref[IncludedContainerAreaNIC], host: ref[Page]) returns ref[IncludedContainerAreaNIC]
    {
        let r IncludedContainerAreaNIC.make(host)
        set r.escapement_direction: this.escapement_direction
        set r.is_display: this.is_display
        set r.width_type: this.width_type
        set r.width: this.width
        set r.height_type: this.height_type
        set r.height: this.height
        set r.position_point_x: this.position_point_x
        set r.position_point_y: this.position_point_y
        set r.contents_rotation: this.contents_rotation
        set r.scale_type: this.scale_type
        set r.scale_x: this.scale_x
        set r.scale_y: this.scale_y
        set r.break_before_priority: this.break_before_priority
        set r.break_after_priority: this.break_after_priority
        r
    }
}

; FOTBuilder::MultiMode (FOTBuilder.h:426) — one entry of the multi-mode
; class's port list: a name (empty for the principal mode) and an optional
; description.
define MultiModeRec (var has_desc: bool, var name: StringC, var desc: StringC)
{
    function make(host: ref[Page]) returns ref[MultiModeRec]
    {
        let r &MultiModeRec^host(false, StringC(), StringC())
        r
    }
}

; MultiModeFlowObj::NIC (FlowObj.cxx:964) — the `multi-modes:` list, split
; into the optional PRINCIPAL mode and the named ones in declaration order.
; ★The named modes ARE the flow object's ports; no other class in the port
; decides its port list at run time.
define MultiModeNIC (var has_principal_mode: bool, var principal_has_desc: bool, var principal_desc: StringC, named: ref[Array[ref[MultiModeRec]?]])
{
    function make(host: ref[Page]) returns ref[MultiModeNIC]
    {
        let r &MultiModeNIC^host(false, false, StringC(), Array[ref[MultiModeRec]?]^host())
        r
    }

    function copy(this: ref[MultiModeNIC], host: ref[Page]) returns ref[MultiModeNIC]
    {
        let r MultiModeNIC.make(host)
        set r.has_principal_mode: this.has_principal_mode
        set r.principal_has_desc: this.principal_has_desc
        set r.principal_desc: InheritedC.pin_string(host, this.principal_desc)
        let n this.named.get_length()
        var i: size_t 0
        while i < n
        {
            let pp this.named.get(i)
            if pp <> null
            {
                let src *pp
                let m MultiModeRec.make(host)
                set m.has_desc: src.has_desc
                set m.name: InheritedC.pin_string(host, src.name)
                set m.desc: InheritedC.pin_string(host, src.desc)
                r.named.add(m)
            }
            set i: i + 1
        }
        r
    }
}

; TeXFOTBuilder::PageFloatNIC — the page-float extension flow object's one
; NIC (a string; hasNIC accepts only "placement").
; MifFOTBuilder::IndexEntryNIC — the ISOGEN index-entry extension flow
; object's non-inherited characteristics.
define IndexEntryNIC (components: ref[Array[StringC]], var sort_string: StringC, var page_number: bool, var starts_page_range: bool, var ends_page_range: bool)
{
    function make(host: ref[Page]) returns ref[IndexEntryNIC]
    {
        let r &IndexEntryNIC^host(Array[StringC]^host(), StringC(), true, false, false)
        r
    }

    function copy(this: ref[IndexEntryNIC], host: ref[Page]) returns ref[IndexEntryNIC]
    {
        let r IndexEntryNIC.make(host)
        let n this.components.get_length()
        var i: size_t 0
        while i < n
        {
            let cp this.components.get(i)
            r.components.add(*cp)
            set i: i + 1
        }
        set r.sort_string: this.sort_string
        set r.page_number: this.page_number
        set r.starts_page_range: this.starts_page_range
        set r.ends_page_range: this.ends_page_range
        r
    }
}

define PageFloatNIC (var placement: StringC)
{
