; FOTBuilder::RuleNIC minus the embedded DisplayNIC/InlineNIC bases (the
; display half rides in FlowObj.dnic as usual; the InlineNIC break
; priorities live here — the rule dump prints them for the non-display
; orientations). orientation defaults to horizontal (RuleNIC()).
define RuleNICRec
(
    orientation: FotSym
    has_length: bool
    length: LengthSpec
    break_before_priority: int
    break_after_priority: int
)
{
    function make(host: ref[Page]) returns ref[RuleNICRec]
    {
        ; the default name must be HOST-pinned (the copying StringC ctor as a
        ; temporary lands on the temporary's page — S70 trap).
        let tmp StringC("horizontal")
        var o FotSym()
        set o.code: SYM_HORIZONTAL
        set o.name: StringC^host(tmp.data_ptr(), tmp.get_size())
        let r &RuleNICRec^host(o, false, LengthSpec(), 0, 0)
        r
    }

    function copy(this: ref[RuleNICRec], host: ref[Page]) returns ref[RuleNICRec]
    {
        let r RuleNICRec.make(host)
        set r.orientation: this.orientation
        set r.has_length: this.has_length
        set r.length: this.length
        set r.break_before_priority: this.break_before_priority
        set r.break_after_priority: this.break_after_priority
        r
    }
}

; FOTBuilder::Address::Type — all eight, in the reference's enum order
; (FOTBuilder.h:433). `tei` and `html` are declared but no primitive of the
; reference ever produces them; they exist because TeXFOTBuilder::startLink
; switches over the full enum, and this port keeps both arms for the same
; reason.
define ADDR_NONE: int 0
define ADDR_RESOLVED_NODE: int 1
define ADDR_IDREF: int 2
define ADDR_ENTITY: int 3
define ADDR_SGML_DOCUMENT: int 4
define ADDR_HYTIME_LINKEND: int 5
define ADDR_TEI: int 6
define ADDR_HTML: int 7

; link NIC (destination:) — node is a ref[GroveNode]?, as Clark's Address is.
; FOTBuilder::LineFieldNIC — the InlineNIC break priorities of a line-field.
; The fot dump drops them (SgmlFOTBuilder::startLineField ignores its NIC) but
; the TeX backend prints them, so they ride the ordinary tnic machinery.
define LineFieldNICRec (break_before_priority: int, break_after_priority: int)
{
    function make(host: ref[Page]) returns ref[LineFieldNICRec]
    {
        let r &LineFieldNICRec^host(0, 0)
        r
    }

    function copy(this: ref[LineFieldNICRec], host: ref[Page]) returns ref[LineFieldNICRec]
    {
        let r LineFieldNICRec.make(host)
        set r.break_before_priority: this.break_before_priority
        set r.break_after_priority: this.break_after_priority
        r
    }
}

; the `specifiedC` bit indices of FOTBuilder::CharacterNIC (enum order — the
; fot dump renders in exactly this order, so the numbering is a contract).
define CNIC_IS_DROP_AFTER_LINE_BREAK: int 0
define CNIC_IS_DROP_UNLESS_BEFORE_LINE_BREAK: int 1
define CNIC_IS_PUNCT: int 2
define CNIC_IS_INPUT_WHITESPACE: int 3
define CNIC_IS_INPUT_TAB: int 4
define CNIC_IS_RECORD_END: int 5
define CNIC_IS_SPACE: int 6
define CNIC_CHAR: int 7
define CNIC_GLYPH_ID: int 8
define CNIC_SCRIPT: int 9
define CNIC_MATH_CLASS: int 10
define CNIC_MATH_FONT_POSTURE: int 11
define CNIC_BREAK_BEFORE_PRIORITY: int 12
define CNIC_BREAK_AFTER_PRIORITY: int 13

; the math-class / math-font-posture enum sets (FOTBuilder::Symbol codes).
define SYM_NOT_APPLICABLE: int 2
define SYM_UPRIGHT: int 20
define SYM_OBLIQUE: int 21
define SYM_BACK_SLANTED_OBLIQUE: int 22
define SYM_ITALIC: int 23
define SYM_BACK_SLANTED_ITALIC: int 24
define SYM_ORDINARY: int 52
define SYM_OPERATOR: int 53
define SYM_BINARY: int 54
define SYM_RELATION: int 55
define SYM_OPENING: int 56
define SYM_CLOSING: int 57
define SYM_PUNCTUATION: int 58
define SYM_INNER: int 59
define SYM_SPACE: int 60

; FOTBuilder::CharacterNIC — the `character` flow object's non-inherited
; characteristics. `specified` is the bit set above: the fot dump prints a
; field only when its bit is set, and setImplicitChar fills every UNSET field
; from the character properties of `ch`. `glyph_id` is a GlyphId-arm ELObj
; (null = the reference's id-less FOTBuilder::GlyphId(), which prints "false");
; `script` is a public identifier (empty = the reference's null PublicId).
; ★The reference ctor initializes only valid/specifiedC/stretchFactor — every
; other field is left indeterminate and is read only under `valid` or under
; its own specified bit, so zeroing here is observationally identical.
define CharacterNICRec
(
    valid: bool
    specified: int
    ch: u32
    glyph_id: ref[ELObj]?
    break_before_priority: int
    break_after_priority: int
    math_class: FotSym
    math_font_posture: FotSym
    script: StringC
    is_drop_after_line_break: bool
    is_drop_unless_before_line_break: bool
    is_punct: bool
    is_input_whitespace: bool
    is_input_tab: bool
    is_record_end: bool
    is_space: bool
    stretch_factor: double
)
{
    function make(host: ref[Page]) returns ref[CharacterNICRec]
    {
        let r &CharacterNICRec^host(false, 0, 0, null, 0, 0, FotSym(), FotSym(), StringC(), false, false, false, false, false, false, false, 1.0)
        r
    }

    function copy(this: ref[CharacterNICRec], host: ref[Page]) returns ref[CharacterNICRec]
    {
        let r CharacterNICRec.make(host)
        set r.valid: this.valid
        set r.specified: this.specified
        set r.ch: this.ch
        set r.glyph_id: this.glyph_id
        set r.break_before_priority: this.break_before_priority
        set r.break_after_priority: this.break_after_priority
        set r.math_class: this.math_class
        set r.math_font_posture: this.math_font_posture
        set r.script: this.script
        set r.is_drop_after_line_break: this.is_drop_after_line_break
        set r.is_drop_unless_before_line_break: this.is_drop_unless_before_line_break
        set r.is_punct: this.is_punct
        set r.is_input_whitespace: this.is_input_whitespace
        set r.is_input_tab: this.is_input_tab
        set r.is_record_end: this.is_record_end
        set r.is_space: this.is_space
        set r.stretch_factor: this.stretch_factor
        r
    }

    function is_specified(this: ref[CharacterNICRec], bit: int) returns bool
    {
        let m 1 << bit
        (this.specified & m) <> 0
    }

    procedure set_specified(this: ref[CharacterNICRec], bit: int)
        set this.specified: this.specified | (1 << bit)
}

; FOTBuilder::AnchorNIC (style/Anchor.cxx) — the inline break priorities plus
; the display? flag.
define AnchorNICRec (is_display: bool, break_before_priority: int, break_after_priority: int)
{
    function make(host: ref[Page]) returns ref[AnchorNICRec]
    {
        let r &AnchorNICRec^host(false, 0, 0)
        r
    }

    function copy(this: ref[AnchorNICRec], host: ref[Page]) returns ref[AnchorNICRec]
    {
        let r AnchorNICRec.make(host)
        set r.is_display: this.is_display
        set r.break_before_priority: this.break_before_priority
        set r.break_after_priority: this.break_after_priority
        r
    }
}

; FOTBuilder::GlyphAnnotationNIC (style/GlyphAnnotation.cxx) — two priorities.
define GlyphAnnotationNICRec (break_before_priority: int, break_after_priority: int)
{
    function make(host: ref[Page]) returns ref[GlyphAnnotationNICRec]
    {
        let r &GlyphAnnotationNICRec^host(0, 0)
        r
    }

    function copy(this: ref[GlyphAnnotationNICRec], host: ref[Page]) returns ref[GlyphAnnotationNICRec]
    {
        let r GlyphAnnotationNICRec.make(host)
        set r.break_before_priority: this.break_before_priority
        set r.break_after_priority: this.break_after_priority
