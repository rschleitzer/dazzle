; Style — the inherited-characteristics foundation (Stage 6a Inc 8, slice 1).
; Ported from ~/repos/dazzle/style/Style.{h,cxx} + InheritedC.cxx (C++ oracle;
; the C# mirror is openjade-net/src/OpenJade/Style). The reference models an
; InheritedC as a class hierarchy (six generic kinds + specials) whose set()
; drives a FOTBuilder setter; here it is one kind-tagged record whose set_ic
; renders through the SgmlFOTBuilder (the fot backend is the only IC consumer
; in this slice — the transform backend's setters are no-ops and its path never
; pushes styles).
;
; Lazy IC values (the reference design, replacing the slice-1 eager collapse):
; a non-constant IC value expression compiles to standalone code (VarInheritedC
; = a proto + code + loc record) evaluated at style-PUSH time against the
; style's captured display vars and creation node (VarStyleRec). The push
; machinery (InheritedCInfo cached_value/spec_level/dependencies, PopList
; depending_list) supports the inherited-*/actual-* primitives; the VM-facing
; evaluation glue lives in VM.scaly (Style cannot import VM — VM→Insn→Style).
;
; RBMM: prototype ICs + registry live on the interpreter's run page; per-make
; constant ICs + VarInheritedC records + spec arrays on the compile host (with
; the insn chain); push-time conversions and StyleStack push nodes
; (InheritedCInfo/PopList) on the current node's eval scratch region — they are
; popped inside the same bracket (inner→outer pointers only). The StyleStack
; record + its info array live on the run page.

use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use dazzle.ELObj.ELObj
use dazzle.ELObj.Identifier
use dazzle.ELObj.FlowObj
use dazzle.ELObj.QuantityValue
use dazzle.ELObj.EngLenSpec
use dazzle.ELObj.GlyphSubstTableRec
use dazzle.ELObj.AddressRec
use dazzle.Interpreter.Interpreter
use dazzle.ProcessingMode.Rule
use dazzle.ProcessingMode.Action
use dazzle.InterpreterMessages.InterpreterMessages
use opensp.Location.Location
use dazzle.Grove.GroveNode
use dazzle.Insn.Insn

; Interpreter::convertFromString hints (Interpreter.h:463) — which shapes a
; STRING may be reinterpreted as under `-2`; each converter names its own.
; ★They live in THIS module, not in Interpreter, because a module may only
; read the globals of a module declared BEFORE it (dazzle.scaly's order) —
; and read the wrong way round they do not merely fail to resolve: passed as
; a call ARGUMENT the whole call is silently dropped and the result is
; garbage (measured 2026-07-31, every gated characteristic then failing to
; convert). Beside a binary operator the same read is a hard diagnostic.
define CONVERT_ALLOW_BOOLEAN: int 1
define CONVERT_ALLOW_SYMBOL: int 2
define CONVERT_ALLOW_NUMBER: int 4

; --- InheritedC kinds (the generic classes of InheritedC.cxx) ---------------
define IC_BOOL: int 0
define IC_LENGTH: int 1
define IC_LENGTH_SPEC: int 2
define IC_SYMBOL: int 3
define IC_STRING: int 4
define IC_INT: int 5
define IC_PUBLIC_ID: int 6
define IC_LETTER2: int 7
; #f or strictly positive integer (GenericMaybeIntegerInheritedC); lval 0 = #f.
define IC_MAYBE_INT: int 8
; an ignored characteristic (IgnoredC): any value accepted, set() emits
; nothing, value() returns the stored ELObj.
define IC_IGNORED: int 9
; BorderC (table-border / cell-*-border): like IgnoredC (set() silent, value()
; = stored obj) but the value must be a table-border sosofo or a boolean
; (canonicalized to #t/#f).
define IC_BORDER: int 10
; ColorC: obj = a ColorObj ELObj (never null; initial device-RGB black).
define IC_COLOR: int 11
; BackgroundColorC: obj = a ColorObj or null (#f -> the no-arg
; setBackgroundColor).
define IC_OPT_COLOR: int 12
; GenericOptLengthSpecInheritedC: #f or a length-spec; bval true = #f
; (hasLength 0), else ls holds the value.
define IC_OPT_LENGTH_SPEC: int 13
; GenericInlineSpaceInheritedC: obj = an InlineSpaceObj ELObj (never null).
define IC_INLINE_SPACE: int 14
; GenericOptInlineSpaceInheritedC: obj = an InlineSpaceObj or null (#f).
; set() renders nothing in the fot backend (setInlineSpaceSpace is not
; overridden in the reference SgmlFOTBuilder).
define IC_OPT_INLINE_SPACE: int 15
; GlyphSubstTableC: gst holds the table payloads, bval distinguishes the
; list form from #f/single (inherited-glyph-subst-table rewraps).
define IC_GST: int 16
; RuleC (fraction-bar): like IgnoredC (set() silent, value() = stored obj)
; but the value must be a rule-FO sosofo (the rule class binding included).
define IC_RULE: int 17

; --- make-keyword classification (MakeExpression::compile split) ------------
define KEY_NIC: int 0
; an IC key, fully handled at compile (constant or VarInheritedC entry in the
; insn's prebuilt spec arrays) — no stack slot, nothing to do at exec.
define KEY_IC_CONST: int 1
; an unknown keyword (messaged at compile): the reference never compiles its
; value expression — no stack slot.
define KEY_DROP: int 2
define KEY_USE: int 3
; evaluated and dropped (label:/content-map:, line-field priorities).
define KEY_IGNORE: int 4
; HISTORICAL (Inc 8 slices 2-4): the simple-page-sequence header/footer sosofo
; NICs had their own slotted class; they now ride the NIC machinery (constants
; into the insn's hf prototype, non-constants into the lazy nic_code chain
; with a part index on the SetNic insn). The constant stays reserved.
define KEY_HF: int 5
; a NIC-family key with a CONSTANT value, fully converted at compile into the
; insn's prototype records (applyConstNonInheritedCs: display NIC, table NIC,
; header/footer sosofo) — no stack slot, nothing to do at exec.
define KEY_TABLE_CONST: int 6
; a table-cell pseudo NIC (column-number / n-columns-spanned / starts-row? /
; ends-row?) with a non-constant value: evaluated at CONSTRUCTION on the main
; insn chain (SetPseudoNonInheritedCInsn) — the cell's pushStyle needs them
; before the lazy NIC resolve.
define KEY_PSEUDO_NIC: int 7
; label: — the value expr compiles onto the post-make chain, a LabelSosofo
; insn wraps the finished flow object (no key slot).
define KEY_LABEL: int 8
; content-map: — the value expr evaluates right after the content sosofos;
; the make insn wraps the content with a SOSO_CONTENT_MAP (no key slot).
define KEY_CONTENT_MAP: int 9

; --- FOTBuilder::Symbol codes the NIC enum sets need ------------------------
; (full table installed as symbol c-values by Interpreter.install_c_value_
; symbols; codes = enum order in FOTBuilder.h)
define SYM_FALSE: int 0
define SYM_TRUE: int 1
define SYM_HORIZONTAL: int 47
define SYM_VERTICAL: int 48
define SYM_ESCAPEMENT: int 49
define SYM_LINE_PROGRESSION: int 50
define SYM_PAGE: int 61
define SYM_PAGE_REGION: int 62
define SYM_COLUMN_SET: int 63
define SYM_COLUMN: int 64
define SYM_TOP: int 88
define SYM_BOTTOM: int 89
define SYM_FORCE: int 95
define SYM_BEFORE: int 38
define SYM_THROUGH: int 39
define SYM_AFTER: int 40
define SYM_TOP_TO_BOTTOM: int 41
define SYM_LEFT_TO_RIGHT: int 42
define SYM_BOTTOM_TO_TOP: int 43
define SYM_RIGHT_TO_LEFT: int 44
define SYM_MAX_SCALE: int 65
define SYM_MAX_UNIFORM: int 66

; FOTBuilder::LengthSpec — length in units (millipoints at 72000 upi) plus a
; display-size factor (display-size-relative specs; slice 1 produces factors
; only through length-spec VALUES, not arithmetic — see DESIGN.md).
define LengthSpec (var length: int, factor: double)
{
    init()
    {
        set this.length: 0
        set this.factor: 0.0
    }

    function is_set(this: LengthSpec) returns bool
    {
        if length <> 0 or factor <> 0.0
            return true
        false
    }

    function differs(this: LengthSpec, other: LengthSpec) returns bool
    {
        if length <> other.length or factor <> other.factor
            return true
        false
    }
}

; FOTBuilder::DisplaySpace (defaults per its ctor: priority 0, conditional 1,
; force 0).
define DisplaySpace (var nominal: LengthSpec, var min: LengthSpec, var max: LengthSpec, var priority: int, var conditional: bool, var force: bool)
{
    init()
    {
        set this.nominal: LengthSpec()
        set this.min: LengthSpec()
        set this.max: LengthSpec()
        set this.priority: 0
        set this.conditional: true
        set this.force: false
    }

    function make(host: ref[Page]) returns ref[DisplaySpace]
    {
        let p &DisplaySpace^host()
        p
    }
}

; FOTBuilder::InlineSpace.
define InlineSpace (var nominal: LengthSpec, var min: LengthSpec, var max: LengthSpec)
{
    init()
    {
        set this.nominal: LengthSpec()
        set this.min: LengthSpec()
        set this.max: LengthSpec()
    }

    function make(host: ref[Page]) returns ref[InlineSpace]
    {
        let p &InlineSpace^host()
        p
    }
}

; a validated FOT symbol value: the c-value code plus the interned print name
; (code 0 = false, 1 = true; names render as "false"/"true").
define FotSym (code: int, name: StringC)
{
    init()
    {
        set this.code: SYM_FALSE
        set this.name: StringC()
    }
}

; The class-specific non-inherited characteristics of a flow object.
; Upstream gives every FlowObj subclass an `Owner<FOTBuilder::XNIC> nic_` of
; its own type; the port's single FlowObj record (tagged by `foc`) holds ONE
; of the twenty-two NIC records behind this pointer alias and reads it back
; under the class's type (`fo.get_nic() as ref[TableNIC]`). One declaration
; per opaque kind is the accepted form (CLAUDE.md, pointer[void]); a NICRef
; handed where a grove declaration or a page belongs is a planner error.
define NIC()
define NICRef pointer[NIC]

; FOTBuilder::DisplayNIC (+ DisplayGroupNIC's coalesce-id, carried flat).
define DisplayNIC
(
    var space_before: DisplaySpace
    var space_after: DisplaySpace
    var position_preference: FotSym
    var keep: FotSym
    var break_before: FotSym
    var break_after: FotSym
    var keep_with_previous: bool
    var keep_with_next: bool
    var may_violate_keep_before: bool
    var may_violate_keep_after: bool
    var has_coalesce_id: bool
    var coalesce_id: StringC
)
{
    function make(host: ref[Page]) returns ref[DisplayNIC]
    {
        let n &DisplayNIC^host(DisplaySpace(), DisplaySpace(), FotSym(), FotSym(), FotSym(), FotSym(), false, false, false, false, false, StringC())
        n
    }

    function copy(this: ref[DisplayNIC], host: ref[Page]) returns ref[DisplayNIC]
    {
        let n DisplayNIC.make(host)
        set n.space_before: this.space_before
        set n.space_after: this.space_after
        set n.position_preference: this.position_preference
        set n.keep: this.keep
        set n.break_before: this.break_before
        set n.break_after: this.break_after
        set n.keep_with_previous: this.keep_with_previous
        set n.keep_with_next: this.keep_with_next
        set n.may_violate_keep_before: this.may_violate_keep_before
        set n.may_violate_keep_after: this.may_violate_keep_after
        set n.has_coalesce_id: this.has_coalesce_id
        set n.coalesce_id: this.coalesce_id
        n
    }
}

; --- table-family NIC records (FOTBuilder.h TableNIC/TableColumnNIC/
; TableCellNIC + the FlowObj.cxx NIC extensions, flattened) -----------------
define TABLE_WIDTH_FULL: int 0
define TABLE_WIDTH_MINIMUM: int 1
define TABLE_WIDTH_EXPLICIT: int 2

; TableFlowObj::NIC: width + the four border styles (a style ELObj, resolved
; from a table-border sosofo or a boolean; null = unspecified -> the
; table-border IC fallback at process).
define TableNIC
(
    var width_type: int
    var width: LengthSpec
    var before_row_border: ref[ELObj]?
    var after_row_border: ref[ELObj]?
    var before_column_border: ref[ELObj]?
    var after_column_border: ref[ELObj]?
)
{
    function make(host: ref[Page]) returns ref[TableNIC]
    {
        let r &TableNIC^host(TABLE_WIDTH_FULL, LengthSpec(), null, null, null, null)
        r
    }

    function copy(this: ref[TableNIC], host: ref[Page]) returns ref[TableNIC]
    {
        let r TableNIC.make(host)
        set r.width_type: this.width_type
        set r.width: this.width
        set r.before_row_border: this.before_row_border
        set r.after_row_border: this.after_row_border
        set r.before_column_border: this.before_column_border
        set r.after_column_border: this.after_column_border
        r
    }
}

; TableColumnFlowObj::NIC (columnIndex zero-based; the width is a
; TableLengthSpec — the FOT LengthSpec plus the table-unit factor, flattened
; into width + width_tfactor).
define TableColumnNIC
(
    var column_index: int
    var n_columns_spanned: int
    var has_column_number: bool
    var has_width: bool
    var width: LengthSpec
    var width_tfactor: double
)
{
    function make(host: ref[Page]) returns ref[TableColumnNIC]
    {
        let r &TableColumnNIC^host(0, 1, false, false, LengthSpec(), 0.0)
        r
    }

    function copy(this: ref[TableColumnNIC], host: ref[Page]) returns ref[TableColumnNIC]
    {
        let r TableColumnNIC.make(host)
        set r.column_index: this.column_index
        set r.n_columns_spanned: this.n_columns_spanned
        set r.has_column_number: this.has_column_number
        set r.has_width: this.has_width
        set r.width: this.width
        set r.width_tfactor: this.width_tfactor
        r
    }
}

; TableCellFlowObj::NIC (missing marks the synthesized filler cells).
define TableCellNIC
(
    var missing: bool
    var column_index: int
    var n_columns_spanned: int
    var n_rows_spanned: int
    var has_column_number: bool
    var starts_row: bool
    var ends_row: bool
)
{
    function make(host: ref[Page]) returns ref[TableCellNIC]
    {
        let r &TableCellNIC^host(false, 0, 1, 1, false, false, false)
        r
    }

    function copy(this: ref[TableCellNIC], host: ref[Page]) returns ref[TableCellNIC]
