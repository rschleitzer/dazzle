; Style — the inherited-characteristics foundation (Stage 6a Inc 8, slice 1).
; Ported from ~/repos/dazzle/style/Style.{h,cxx} + InheritedC.cxx (C++ oracle;
; the C# mirror is openjade-net/src/OpenJade/Style). The reference models an
; InheritedC as a class hierarchy (six generic kinds + specials) whose set()
; drives a FOTBuilder setter; here it is one kind-tagged record whose set_ic
; renders through the SgmlFOTBuilder (the fot backend is the only IC consumer
; in this slice — the transform backend's setters are no-ops and its path never
; pushes styles).
;
; Lazy IC values (the reference design, replacing the slice-1 eager collapse):
; a non-constant IC value expression compiles to standalone code (VarInheritedC
; = a proto + code + loc record) evaluated at style-PUSH time against the
; style's captured display vars and creation node (VarStyleRec). The push
; machinery (InheritedCInfo cached_value/spec_level/dependencies, PopList
; depending_list) supports the inherited-*/actual-* primitives; the VM-facing
; evaluation glue lives in VM.scaly (Style cannot import VM — VM→Insn→Style).
;
; RBMM: prototype ICs + registry live on the interpreter's run page; per-make
; constant ICs + VarInheritedC records + spec arrays on the compile host (with
; the insn chain); push-time conversions and StyleStack push nodes
; (InheritedCInfo/PopList) on the current node's eval scratch region — they are
; popped inside the same bracket (inner→outer pointers only). The StyleStack
; record + its info array live on the run page.

use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use dazzle.ELObj.ELObj
use dazzle.ELObj.Identifier
use dazzle.ELObj.FlowObj
use dazzle.ELObj.QuantityValue
use dazzle.ELObj.EngLenSpec
use dazzle.Interpreter.Interpreter
use dazzle.InterpreterMessages.InterpreterMessages
use opensp.Location.Location

; --- InheritedC kinds (the generic classes of InheritedC.cxx) ---------------
define IC_BOOL: int 0
define IC_LENGTH: int 1
define IC_LENGTH_SPEC: int 2
define IC_SYMBOL: int 3
define IC_STRING: int 4
define IC_INT: int 5
define IC_PUBLIC_ID: int 6
define IC_LETTER2: int 7
; #f or strictly positive integer (GenericMaybeIntegerInheritedC); lval 0 = #f.
define IC_MAYBE_INT: int 8
; an ignored characteristic (IgnoredC): any value accepted, set() emits
; nothing, value() returns the stored ELObj.
define IC_IGNORED: int 9
; BorderC (table-border / cell-*-border): like IgnoredC (set() silent, value()
; = stored obj) but the value must be a table-border sosofo or a boolean
; (canonicalized to #t/#f).
define IC_BORDER: int 10
; ColorC: obj = a ColorObj ELObj (never null; initial device-RGB black).
define IC_COLOR: int 11
; BackgroundColorC: obj = a ColorObj or null (#f -> the no-arg
; setBackgroundColor).
define IC_OPT_COLOR: int 12
; GenericOptLengthSpecInheritedC: #f or a length-spec; bval true = #f
; (hasLength 0), else ls holds the value.
define IC_OPT_LENGTH_SPEC: int 13
; GenericInlineSpaceInheritedC: obj = an InlineSpaceObj ELObj (never null).
define IC_INLINE_SPACE: int 14
; GenericOptInlineSpaceInheritedC: obj = an InlineSpaceObj or null (#f).
; set() renders nothing in the fot backend (setInlineSpaceSpace is not
; overridden in the reference SgmlFOTBuilder).
define IC_OPT_INLINE_SPACE: int 15

; --- make-keyword classification (MakeExpression::compile split) ------------
define KEY_NIC: int 0
; an IC key, fully handled at compile (constant or VarInheritedC entry in the
; insn's prebuilt spec arrays) — no stack slot, nothing to do at exec.
define KEY_IC_CONST: int 1
; an unknown keyword (messaged at compile): the reference never compiles its
; value expression — no stack slot.
define KEY_DROP: int 2
define KEY_USE: int 3
; evaluated and dropped (label:/content-map:, line-field priorities).
define KEY_IGNORE: int 4
; HISTORICAL (Inc 8 slices 2-4): the simple-page-sequence header/footer sosofo
; NICs had their own slotted class; they now ride the NIC machinery (constants
; into the insn's hf prototype, non-constants into the lazy nic_code chain
; with a part index on the SetNic insn). The constant stays reserved.
define KEY_HF: int 5
; a NIC-family key with a CONSTANT value, fully converted at compile into the
; insn's prototype records (applyConstNonInheritedCs: display NIC, table NIC,
; header/footer sosofo) — no stack slot, nothing to do at exec.
define KEY_TABLE_CONST: int 6
; a table-cell pseudo NIC (column-number / n-columns-spanned / starts-row? /
; ends-row?) with a non-constant value: evaluated at CONSTRUCTION on the main
; insn chain (SetPseudoNonInheritedCInsn) — the cell's pushStyle needs them
; before the lazy NIC resolve.
define KEY_PSEUDO_NIC: int 7
; label: — the value expr compiles onto the post-make chain, a LabelSosofo
; insn wraps the finished flow object (no key slot).
define KEY_LABEL: int 8
; content-map: — the value expr evaluates right after the content sosofos;
; the make insn wraps the content with a SOSO_CONTENT_MAP (no key slot).
define KEY_CONTENT_MAP: int 9

; --- FOTBuilder::Symbol codes the NIC enum sets need ------------------------
; (full table installed as symbol c-values by Interpreter.install_c_value_
; symbols; codes = enum order in FOTBuilder.h)
define SYM_FALSE: int 0
define SYM_TRUE: int 1
define SYM_PAGE: int 61
define SYM_PAGE_REGION: int 62
define SYM_COLUMN_SET: int 63
define SYM_COLUMN: int 64
define SYM_TOP: int 88
define SYM_BOTTOM: int 89
define SYM_FORCE: int 95

; FOTBuilder::LengthSpec — length in units (millipoints at 72000 upi) plus a
; display-size factor (display-size-relative specs; slice 1 produces factors
; only through length-spec VALUES, not arithmetic — see DESIGN.md).
define LengthSpec (length: int, factor: double)
{
    init()
    {
        set this.length: 0
        set this.factor: 0.0
    }

    function is_set(this: LengthSpec) returns bool
    {
        if length <> 0
            return true
        if factor <> 0.0
            return true
        false
    }

    function differs(this: LengthSpec, other: LengthSpec) returns bool
    {
        if length <> other.length
            return true
        if factor <> other.factor
            return true
        false
    }
}

; FOTBuilder::DisplaySpace (defaults per its ctor: priority 0, conditional 1,
; force 0).
define DisplaySpace (nominal: LengthSpec, min: LengthSpec, max: LengthSpec, priority: int, conditional: bool, force: bool)
{
    init()
    {
        set this.nominal: LengthSpec()
        set this.min: LengthSpec()
        set this.max: LengthSpec()
        set this.priority: 0
        set this.conditional: true
        set this.force: false
    }

    function make(host: pointer[Page]) returns pointer[DisplaySpace]
    {
        let p host.allocate(sizeof DisplaySpace, alignof DisplaySpace) as pointer[DisplaySpace]
        set *p: DisplaySpace()
        p
    }
}

; FOTBuilder::InlineSpace.
define InlineSpace (nominal: LengthSpec, min: LengthSpec, max: LengthSpec)
{
    init()
    {
        set this.nominal: LengthSpec()
        set this.min: LengthSpec()
        set this.max: LengthSpec()
    }

    function make(host: pointer[Page]) returns pointer[InlineSpace]
    {
        let p host.allocate(sizeof InlineSpace, alignof InlineSpace) as pointer[InlineSpace]
        set *p: InlineSpace()
        p
    }
}

; a validated FOT symbol value: the c-value code plus the interned print name
; (code 0 = false, 1 = true; names render as "false"/"true").
define FotSym (code: int, name: StringC)
{
    init()
    {
        set this.code: SYM_FALSE
        set this.name: StringC()
    }
}

; FOTBuilder::DisplayNIC (+ DisplayGroupNIC's coalesce-id, carried flat).
define DisplayNIC
(
    space_before: DisplaySpace
    space_after: DisplaySpace
    position_preference: FotSym
    keep: FotSym
    break_before: FotSym
    break_after: FotSym
    keep_with_previous: bool
    keep_with_next: bool
    may_violate_keep_before: bool
    may_violate_keep_after: bool
    has_coalesce_id: bool
    coalesce_id: StringC
)
{
    function make(host: pointer[Page]) returns pointer[DisplayNIC]
    {
        let n host.allocate(sizeof DisplayNIC, alignof DisplayNIC) as pointer[DisplayNIC]
        set n.space_before: DisplaySpace()
        set n.space_after: DisplaySpace()
        set n.position_preference: FotSym()
        set n.keep: FotSym()
        set n.break_before: FotSym()
        set n.break_after: FotSym()
        set n.keep_with_previous: false
        set n.keep_with_next: false
        set n.may_violate_keep_before: false
        set n.may_violate_keep_after: false
        set n.has_coalesce_id: false
        set n.coalesce_id: StringC()
        n
    }

    function copy(this: pointer[DisplayNIC], host: pointer[Page]) returns pointer[DisplayNIC]
    {
        let n DisplayNIC.make(host)
        set n.space_before: this.space_before
        set n.space_after: this.space_after
        set n.position_preference: this.position_preference
        set n.keep: this.keep
        set n.break_before: this.break_before
        set n.break_after: this.break_after
        set n.keep_with_previous: this.keep_with_previous
        set n.keep_with_next: this.keep_with_next
        set n.may_violate_keep_before: this.may_violate_keep_before
        set n.may_violate_keep_after: this.may_violate_keep_after
        set n.has_coalesce_id: this.has_coalesce_id
        set n.coalesce_id: this.coalesce_id
        n
    }
}

; --- table-family NIC records (FOTBuilder.h TableNIC/TableColumnNIC/
; TableCellNIC + the FlowObj.cxx NIC extensions, flattened) -----------------
define TABLE_WIDTH_FULL: int 0
define TABLE_WIDTH_MINIMUM: int 1
define TABLE_WIDTH_EXPLICIT: int 2

; TableFlowObj::NIC: width + the four border styles (a style ELObj, resolved
; from a table-border sosofo or a boolean; null = unspecified -> the
; table-border IC fallback at process).
define TableNICRec
(
    width_type: int
    width: LengthSpec
    before_row_border: pointer[ELObj]
    after_row_border: pointer[ELObj]
    before_column_border: pointer[ELObj]
    after_column_border: pointer[ELObj]
)
{
    function make(host: pointer[Page]) returns pointer[TableNICRec]
    {
        let r host.allocate(sizeof TableNICRec, alignof TableNICRec) as pointer[TableNICRec]
        set r.width_type: TABLE_WIDTH_FULL
        set r.width: LengthSpec()
        set r.before_row_border: null
        set r.after_row_border: null
        set r.before_column_border: null
        set r.after_column_border: null
        r
    }

    function copy(this: pointer[TableNICRec], host: pointer[Page]) returns pointer[TableNICRec]
    {
        let r TableNICRec.make(host)
        set r.width_type: this.width_type
        set r.width: this.width
        set r.before_row_border: this.before_row_border
        set r.after_row_border: this.after_row_border
        set r.before_column_border: this.before_column_border
        set r.after_column_border: this.after_column_border
        r
    }
}

; TableColumnFlowObj::NIC (columnIndex zero-based; the width is a
; TableLengthSpec — the FOT LengthSpec plus the table-unit factor, flattened
; into width + width_tfactor).
define TableColumnNICRec
(
    column_index: int
    n_columns_spanned: int
    has_column_number: bool
    has_width: bool
    width: LengthSpec
    width_tfactor: double
)
{
    function make(host: pointer[Page]) returns pointer[TableColumnNICRec]
    {
        let r host.allocate(sizeof TableColumnNICRec, alignof TableColumnNICRec) as pointer[TableColumnNICRec]
        set r.column_index: 0
        set r.n_columns_spanned: 1
        set r.has_column_number: false
        set r.has_width: false
        set r.width: LengthSpec()
        set r.width_tfactor: 0.0
        r
    }

    function copy(this: pointer[TableColumnNICRec], host: pointer[Page]) returns pointer[TableColumnNICRec]
    {
        let r TableColumnNICRec.make(host)
        set r.column_index: this.column_index
        set r.n_columns_spanned: this.n_columns_spanned
        set r.has_column_number: this.has_column_number
        set r.has_width: this.has_width
        set r.width: this.width
        set r.width_tfactor: this.width_tfactor
        r
    }
}

; TableCellFlowObj::NIC (missing marks the synthesized filler cells).
define TableCellNICRec
(
    missing: bool
    column_index: int
    n_columns_spanned: int
    n_rows_spanned: int
    has_column_number: bool
    starts_row: bool
    ends_row: bool
)
{
    function make(host: pointer[Page]) returns pointer[TableCellNICRec]
    {
        let r host.allocate(sizeof TableCellNICRec, alignof TableCellNICRec) as pointer[TableCellNICRec]
        set r.missing: false
        set r.column_index: 0
        set r.n_columns_spanned: 1
        set r.n_rows_spanned: 1
        set r.has_column_number: false
        set r.starts_row: false
        set r.ends_row: false
        r
    }

    function copy(this: pointer[TableCellNICRec], host: pointer[Page]) returns pointer[TableCellNICRec]
    {
        let r TableCellNICRec.make(host)
        set r.missing: this.missing
        set r.column_index: this.column_index
        set r.n_columns_spanned: this.n_columns_spanned
        set r.n_rows_spanned: this.n_rows_spanned
        set r.has_column_number: this.has_column_number
        set r.starts_row: this.starts_row
        set r.ends_row: this.ends_row
        r
    }
}

; InheritedC — one record for the reference's class family. `kind` selects the
; payload; `slot` <> -1 marks a pending entry (value converted from the VM
; stack at make-exec); `proto` is the registry prototype a pending/converted
; entry derives from. `print_name` is the exact attribute name SgmlFOTBuilder
; emits (faithful quirks included: "inhibit-line-breaks?" keeps its '?',
; justify-spread? prints "jystify-spread").
define InheritedC
(
    kind: int
    ident: pointer[Identifier]
    index: int
    print_name: StringC
    bval: bool
    lval: int
    sym: FotSym
    sval: StringC
    ls: LengthSpec
    obj: pointer[ELObj]
    code: pointer[void]
    proto: pointer[InheritedC]
    loc: Location
)
{
    function make(host: pointer[Page], kind: int, ident: pointer[Identifier], index: int, print_name: StringC) returns pointer[InheritedC]
    {
        let ic host.allocate(sizeof InheritedC, alignof InheritedC) as pointer[InheritedC]
        set ic.kind: kind
        set ic.ident: ident
        set ic.index: index
        set ic.print_name: print_name
        set ic.bval: false
        set ic.lval: 0
        set ic.sym: FotSym()
        set ic.sval: StringC()
        set ic.ls: LengthSpec()
        set ic.obj: null
        set ic.code: null
        set ic.proto: null
        set ic.loc: Location()
        ic
    }

    function get_index(this: InheritedC) returns int
        index

    function get_kind(this: InheritedC) returns int
        kind

    function get_proto(this: InheritedC) returns pointer[InheritedC]
        proto

    ; VarInheritedC (Style.cxx): a non-constant spec — `code` (an Insn chain,
    ; typed void: Style cannot import Insn) evaluated at style-push against the
    ; owning style's display + node; `loc` anchors the invalid-value message.
    function make_var(host: pointer[Page], proto: pointer[InheritedC], code: pointer[void], loc: Location) returns pointer[InheritedC]
    {
        let ic InheritedC.make(host, proto.get_kind(), proto.ident, proto.get_index(), proto.print_name)
        set ic.code: code
        set ic.proto: proto
        set ic.loc: loc
        ic
    }

    function is_var(this: InheritedC) returns bool
        code <> null

}

; --- value conversions (Interpreter::convert*C, InheritedC.cxx make()) ------
define Convert
{
    procedure invalid_value(interp: pointer[Interpreter], ident: pointer[Identifier], loc: Location)
    {
        interp.set_next_location(loc)
        interp.message1(InterpreterMessages.invalidCharacteristicValue(), ident.get_name())
    }

    ; convertLengthC: an exact/inexact quantity of dimension 1.
    function convert_length(val: pointer[ELObj], out: pointer[int]) returns bool
    {
        let qv: QuantityValue val.quantity_value()
        if qv.get_qtype() = QT_LONG
        {
            if qv.get_dim() = 1
            {
                set *out: qv.get_lval()
                return true
            }
        }
        if qv.get_qtype() = QT_DOUBLE
        {
            if qv.get_dim() = 1
            {
                set *out: qv.get_dval() as int
                return true
            }
        }
        false
    }

    ; convertLengthSpec: a length quantity, or an engine length-spec
    ; (display-size / arithmetic results) — LengthSpec::convert rounds the
    ; length component and carries the display-size factor (the table-unit
    ; component is dropped; the TableLengthSpec variant keeps it).
    function convert_length_spec(val: pointer[ELObj], out: pointer[LengthSpec]) returns bool
    {
        var n 0
        if Convert.convert_length(val, &n)
        {
            var ls LengthSpec()
            set ls.length: n
            set *out: ls
            return true
        }
        let els val.length_spec()
        if els <> null
        {
            var ls LengthSpec()
            set ls.length: Convert.round_length(els.v0)
            set ls.factor: els.v1
            set *out: ls
            return true
        }
        false
    }

    ; long(v < 0 ? v - .5 : v + .5) — LengthSpec::convert's rounding.
    function round_length(v: double) returns int
    {
        if v < 0.0
            return (v - 0.5) as int
        (v + 0.5) as int
    }

    ; LengthSpec::convert(FOTBuilder::TableLengthSpec &) — like
    ; convert_length_spec but the table-unit factor survives.
    function convert_table_length_spec(val: pointer[ELObj], out: pointer[LengthSpec], out_tfactor: pointer[double]) returns bool
    {
        let els val.length_spec()
        if els <> null
        {
            var ls LengthSpec()
            set ls.length: Convert.round_length(els.v0)
            set ls.factor: els.v1
            set *out: ls
            set *out_tfactor: els.v2
            return true
        }
        set *out_tfactor: 0.0
        Convert.convert_length_spec(val, out)
    }

    ; convertBooleanC is STRICT: only the #t/#f singletons convert (is_true
    ; is truthiness — any non-#f object — and must NOT be used here; the
    ; dsssl2 string leniency is gated off with the unported -2 flag).
    function convert_boolean(val: pointer[ELObj], out: pointer[bool]) returns bool
    {
        if val.is_false()
        {
            set *out: false
            return true
        }
        if val.is_boolean_p()
        {
            set *out: true
            return true
        }
        false
    }

    ; convertEnumC (identifier-less overload): #f / #t / any symbol installed
    ; with a c-value.
    function convert_enum(val: pointer[ELObj], out: pointer[FotSym]) returns bool
    {
        var r FotSym()
        if val.is_false()
        {
            set *out: r
            return true
        }
        if val.is_symbol_p()
        {
            let code val.symbol_c_value()
            if code <> SYM_FALSE
            {
                set r.code: code
                set r.name: val.symbol_name()
                set *out: r
                return true
            }
            return false
        }
        if val.is_true()
        {
            set r.code: SYM_TRUE
            set *out: r
            return true
        }
        false
    }

    ; convertEnumC (allowed-set overload, the NIC form): the value must convert
    ; AND its code must be in `allowed` (codes array, n entries).
    function convert_enum_set(val: pointer[ELObj], allowed: pointer[int], n_allowed: int, out: pointer[FotSym]) returns bool
    {
        var r FotSym()
        if Convert.convert_enum(val, &r) = false
            return false
        var i 0
        while i < n_allowed
        {
            if *(allowed + i) = r.code
            {
                set *out: r
                return true
            }
            set i: i + 1
        }
        false
    }

    function convert_string(host: pointer[Page], val: pointer[ELObj], out: pointer[StringC]) returns bool
    {
        if val.is_string_p() = false
            return false
        let s val.string_data(host)
        set *out: StringC^host(s.data_ptr(), s.get_size())
        true
    }

    function convert_integer(val: pointer[ELObj], out: pointer[int]) returns bool
    {
        let qv: QuantityValue val.quantity_value()
        if qv.get_qtype() = QT_LONG
        {
            if qv.get_dim() = 0
            {
                set *out: qv.get_lval()
                return true
            }
        }
        false
    }

    ; convertPublicIdC: #f (empty) or a (possibly empty) string.
    function convert_public_id(host: pointer[Page], val: pointer[ELObj], out: pointer[StringC], out_false: pointer[bool]) returns bool
    {
        if val.is_false()
        {
            set *out_false: true
            return true
        }
        if val.is_string_p()
        {
            set *out_false: false
            let s val.string_data(host)
            set *out: StringC^host(s.data_ptr(), s.get_size())
            return true
        }
        false
    }

    ; convertLetter2C: #f clears; a STRING of exactly two UPPERCASE letters
    ; (the reference accepts no symbols and does not case-fold — "de" is an
    ; invalid value); the empty string also clears.
    function convert_letter2(host: pointer[Page], val: pointer[ELObj], out: pointer[StringC], out_false: pointer[bool]) returns bool
    {
        if val.is_false()
        {
            set *out_false: true
            return true
        }
        if val.is_string_p() = false
            return false
        let s val.string_data(host)
        if s.get_size() = (0 as size_t)
        {
            set *out_false: true
            return true
        }
        if s.get_size() <> (2 as size_t)
            return false
        var up u32[2]
        var i: size_t 0
        while i < (2 as size_t)
        {
            let c s.get(i)
            if c < (0x41 as u32)
                return false
            if c > (0x5A as u32)
                return false
            set *((up as pointer[u32]) + i): c
            set i: i + (1 as size_t)
        }
        set *out_false: false
        ; ^host, NOT the plain copying init: a plain StringC(ptr, n) temporary
        ; copies onto the TEMPORARY's page (Page.get(this)) — the record then
        ; stores a pointer into the dead frame region (bug found by the fot
        ; toy diff: language="DE" printed NULs).
        set *out: StringC^host(up as pointer[u32], 2 as size_t)
        true
    }

    ; InheritedC::make(value, loc, interp) — derive a constant IC from the
    ; prototype `proto` with the converted value; null + message on invalid.
    ; Quantities resolve first (a parse-time datum like 18pt is an
    ; UnresolvedLengthObj until forced — ResolveQuantitiesInsn's job on the
    ; eval path; the compile-time constant path forces here).
    function ic_from_value(host: pointer[Page], proto: pointer[InheritedC], val_in: pointer[ELObj], loc: Location, interp: pointer[Interpreter]) returns pointer[InheritedC]
    {
        var val val_in
        let resolved val.resolve_quantities(true, interp, loc)
        if resolved <> null
            set val: resolved
        let ic InheritedC.make(host, proto.get_kind(), proto.ident, proto.get_index(), proto.print_name)
        set ic.proto: proto
        set ic.loc: loc
        let kind proto.get_kind()
        var ok false
        if kind = IC_BOOL
        {
            var b false
            set ok: Convert.convert_boolean(val, &b)
            set ic.bval: b
        }
        else if kind = IC_LENGTH
        {
            var n 0
            set ok: Convert.convert_length(val, &n)
            set ic.lval: n
        }
        else if kind = IC_LENGTH_SPEC
        {
            var ls LengthSpec()
            set ok: Convert.convert_length_spec(val, &ls)
            set ic.ls: ls
        }
        else if kind = IC_SYMBOL
        {
            var sym FotSym()
            set ok: Convert.convert_enum(val, &sym)
            set ic.sym: sym
        }
        else if kind = IC_STRING
        {
            var s StringC()
            set ok: Convert.convert_string(host, val, &s)
            set ic.sval: s
        }
        else if kind = IC_INT
        {
            var n 0
            set ok: Convert.convert_integer(val, &n)
            set ic.lval: n
        }
        else if kind = IC_PUBLIC_ID
        {
            var s StringC()
            var was_false false
            set ok: Convert.convert_public_id(host, val, &s, &was_false)
            set ic.sval: s
            set ic.bval: was_false
        }
        else if kind = IC_LETTER2
        {
            var s StringC()
            var was_false false
            set ok: Convert.convert_letter2(host, val, &s, &was_false)
            set ic.sval: s
            set ic.bval: was_false
        }
        else if kind = IC_MAYBE_INT
        {
            ; convertOptPositiveIntegerC: #f -> 0, else a strictly positive
            ; exact integer.
            if val.is_false()
            {
                set ic.lval: 0
                set ok: true
            }
            else
            {
                var n 0
                if Convert.convert_integer(val, &n)
                {
                    if n > 0
                    {
                        set ic.lval: n
                        set ok: true
                    }
                }
            }
        }
        else if kind = IC_IGNORED
        {
            ; IgnoredC::make — any value is accepted and stored.
            set ic.obj: val
            set ok: true
        }
        else if kind = IC_BORDER
        {
            ; BorderC::make — a table-border sosofo is stored as-is; anything
            ; else must convert to a boolean (canonical #t/#f stored).
            if Convert.is_table_border_sosofo(val)
            {
                set ic.obj: val
                set ok: true
            }
            else
            {
                var b false
                if Convert.convert_boolean(val, &b)
                {
                    if b
                        set ic.obj: interp.make_true()
                    else
                        set ic.obj: interp.make_false()
                    set ok: true
                }
            }
        }
        else if kind = IC_COLOR
        {
            ; ColorC::make / convertColorC — the value must be a color.
            if val.is_color_p()
            {
                set ic.obj: val
                set ok: true
            }
        }
        else if kind = IC_OPT_COLOR
        {
            ; BackgroundColorC::make / convertOptColorC — a color or #f.
            if val.is_color_p()
            {
                set ic.obj: val
                set ok: true
            }
            else if val.is_false()
            {
                set ic.obj: null
                set ok: true
            }
        }
        else if kind = IC_OPT_LENGTH_SPEC
        {
            ; convertOptLengthSpecC: #f -> no length; else a length-spec.
            if val.is_false()
            {
                set ic.bval: true
                set ok: true
            }
            else
            {
                var ls LengthSpec()
                if Convert.convert_length_spec(val, &ls)
                {
                    set ic.ls: ls
                    set ic.bval: false
                    set ok: true
                }
            }
        }
        else if kind = IC_INLINE_SPACE
        {
            ; GenericInlineSpaceInheritedC::make — an inline-space object, or
            ; a length-spec (min = max = nominal).
            if val.as_inline_space() <> null
            {
                set ic.obj: val
                set ok: true
            }
            else
            {
                var ls LengthSpec()
                if Convert.convert_length_spec(val, &ls)
                {
                    let sp InlineSpace.make(host)
                    set sp.nominal: ls
                    set sp.min: ls
                    set sp.max: ls
                    set ic.obj: ELObj.make_inline_space(host, sp as pointer[void])
                    set ok: true
                }
            }
        }
        else if kind = IC_OPT_INLINE_SPACE
        {
            ; GenericOptInlineSpaceInheritedC::make — an inline-space, #f, or
            ; a length-spec (via convertOptLengthSpecC).
            if val.as_inline_space() <> null
            {
                set ic.obj: val
                set ok: true
            }
            else if val.is_false()
            {
                set ic.obj: null
                set ok: true
            }
            else
            {
                var ls LengthSpec()
                if Convert.convert_length_spec(val, &ls)
                {
                    let sp InlineSpace.make(host)
                    set sp.nominal: ls
                    set sp.min: ls
                    set sp.max: ls
                    set ic.obj: ELObj.make_inline_space(host, sp as pointer[void])
                    set ok: true
                }
            }
        }
        if ok = false
        {
            Convert.invalid_value(interp, proto.ident, loc)
            return null
        }
        ic
    }

    ; FlowObj::setDisplayNIC — returns true when `sk` is a display NIC key
    ; (value converted into `nic`; an invalid value messages and leaves the
    ; default, per the reference convert*C behaviour).
    function set_display_nic(nic: pointer[DisplayNIC], sk: int, val: pointer[ELObj], ident: pointer[Identifier], loc: Location, interp: pointer[Interpreter], host: pointer[Page]) returns bool
    {
        if sk = SK_POSITION_PREFERENCE
        {
            ; 3 x 8-byte int (an undersized buffer here overlaps the next
            ; allocation — the decode-key-args bug class).
            let allowed host.allocate(24, 8) as pointer[int]
            set *allowed: SYM_FALSE
            set *(allowed + 1): SYM_TOP
            set *(allowed + 2): SYM_BOTTOM
            var s FotSym()
            if Convert.convert_enum_set(val, allowed, 3, &s)
                set nic.position_preference: s
            else
                Convert.invalid_value(interp, ident, loc)
            return true
        }
        if sk = SK_KEEP_WITH_PREVIOUS
        {
            var b false
            if Convert.convert_boolean(val, &b)
                set nic.keep_with_previous: b
            else
                Convert.invalid_value(interp, ident, loc)
            return true
        }
        if sk = SK_KEEP_WITH_NEXT
        {
            var b false
            if Convert.convert_boolean(val, &b)
                set nic.keep_with_next: b
            else
                Convert.invalid_value(interp, ident, loc)
            return true
        }
        if sk = SK_KEEP
        {
            let allowed host.allocate(40, 8) as pointer[int]
            set *allowed: SYM_FALSE
            set *(allowed + 1): SYM_TRUE
            set *(allowed + 2): SYM_PAGE
            set *(allowed + 3): SYM_COLUMN_SET
            set *(allowed + 4): SYM_COLUMN
            var s FotSym()
            if Convert.convert_enum_set(val, allowed, 5, &s)
                set nic.keep: s
            else
                Convert.invalid_value(interp, ident, loc)
            return true
        }
        if (sk = SK_BREAK_BEFORE) or (sk = SK_BREAK_AFTER)
        {
            let allowed host.allocate(40, 8) as pointer[int]
            set *allowed: SYM_FALSE
            set *(allowed + 1): SYM_PAGE
            set *(allowed + 2): SYM_PAGE_REGION
            set *(allowed + 3): SYM_COLUMN_SET
            set *(allowed + 4): SYM_COLUMN
            var s FotSym()
            if Convert.convert_enum_set(val, allowed, 5, &s)
            {
                if sk = SK_BREAK_BEFORE
                    set nic.break_before: s
                else
                    set nic.break_after: s
            }
            else
                Convert.invalid_value(interp, ident, loc)
            return true
        }
        if sk = SK_MAY_VIOLATE_KEEP_BEFORE
        {
            var b false
            if Convert.convert_boolean(val, &b)
                set nic.may_violate_keep_before: b
            else
                Convert.invalid_value(interp, ident, loc)
            return true
        }
        if sk = SK_MAY_VIOLATE_KEEP_AFTER
        {
            var b false
            if Convert.convert_boolean(val, &b)
                set nic.may_violate_keep_after: b
            else
                Convert.invalid_value(interp, ident, loc)
            return true
        }
        if (sk = SK_SPACE_BEFORE) or (sk = SK_SPACE_AFTER)
        {
            ; FlowObj.cxx keySpaceBefore/After: a display-space object copies
            ; whole; else a length spec (min = max = nominal).
            let dsp val.as_display_space()
            if dsp <> null
            {
                let ds *(dsp as pointer[DisplaySpace])
                if sk = SK_SPACE_BEFORE
                    set nic.space_before: ds
                else
                    set nic.space_after: ds
                return true
            }
            var ls LengthSpec()
            if Convert.convert_length_spec(val, &ls)
            {
                var ds DisplaySpace()
                set ds.nominal: ls
                set ds.min: ls
                set ds.max: ls
                if sk = SK_SPACE_BEFORE
                    set nic.space_before: ds
                else
                    set nic.space_after: ds
            }
            else
                Convert.invalid_value(interp, ident, loc)
            return true
        }
        false
    }

    ; a (make table-border …) sosofo — the only sosofo with a border style
    ; (SosofoObj::tableBorderStyle).
    function is_table_border_sosofo(val: pointer[ELObj]) returns bool
    {
        if val.is_sosofo_p() = false
            return false
        if val.sosofo_kind() <> SOSO_FLOWOBJ
            return false
        let fo val.sosofo_flowobj()
        if fo = null
            return false
        fo.get_foc() = FOC_TABLE_BORDER
    }

    ; a border characteristic VALUE resolved to the style to push: a
    ; table-border sosofo's style, or a boolean -> the canned border-present
    ; styles; null = invalid (caller messages).
    function border_style_from(val: pointer[ELObj], interp: pointer[Interpreter]) returns pointer[ELObj]
    {
        if Convert.is_table_border_sosofo(val)
            return val.sosofo_flowobj().get_style()
        var b false
        if Convert.convert_boolean(val, &b)
        {
            if b
                return interp.border_true_style()
            return interp.border_false_style()
        }
        null
    }

    ; TableFlowObj::setNonInheritedC, the table-specific keys (the display
    ; NICs go through set_display_nic).
    procedure set_table_nic(rec: pointer[TableNICRec], sk: int, val: pointer[ELObj], ident: pointer[Identifier], loc: Location, interp: pointer[Interpreter])
    {
        if sk = SK_TABLE_WIDTH
        {
            if val.is_false()
            {
                set rec.width_type: TABLE_WIDTH_MINIMUM
                return
            }
            var ls LengthSpec()
            if Convert.convert_length_spec(val, &ls)
            {
                set rec.width: ls
                set rec.width_type: TABLE_WIDTH_EXPLICIT
            }
            else
                Convert.invalid_value(interp, ident, loc)
            return
        }
        let style Convert.border_style_from(val, interp)
        if style = null
        {
            Convert.invalid_value(interp, ident, loc)
            return
        }
        if sk = SK_BEFORE_ROW_BORDER
            set rec.before_row_border: style
        if sk = SK_AFTER_ROW_BORDER
            set rec.after_row_border: style
        if sk = SK_BEFORE_COLUMN_BORDER
            set rec.before_column_border: style
        if sk = SK_AFTER_COLUMN_BORDER
            set rec.after_column_border: style
    }

    ; TableColumnFlowObj::setNonInheritedC.
    procedure set_table_column_nic(rec: pointer[TableColumnNICRec], sk: int, val: pointer[ELObj], ident: pointer[Identifier], loc: Location, interp: pointer[Interpreter])
    {
        if sk = SK_WIDTH
        {
            ; width is a TableLengthSpec, not just a LengthSpec — the
            ; table-unit factor survives.
            var ls LengthSpec()
            var tf 0.0
            if Convert.convert_table_length_spec(val, &ls, &tf)
            {
                set rec.width: ls
                set rec.width_tfactor: tf
                set rec.has_width: true
            }
            else
                Convert.invalid_value(interp, ident, loc)
            return
        }
        var n 0
        var ok Convert.convert_integer(val, &n)
        if ok
        {
            if n <= 0
                set ok: false
        }
        if ok = false
        {
            Convert.invalid_value(interp, ident, loc)
            return
        }
        if sk = SK_COLUMN_NUMBER
        {
            set rec.column_index: n - 1
            set rec.has_column_number: true
        }
        if sk = SK_N_COLUMNS_SPANNED
            set rec.n_columns_spanned: n
    }

    ; TableCellFlowObj::setNonInheritedC.
    procedure set_table_cell_nic(rec: pointer[TableCellNICRec], sk: int, val: pointer[ELObj], ident: pointer[Identifier], loc: Location, interp: pointer[Interpreter])
    {
        if (sk = SK_IS_STARTS_ROW) or (sk = SK_IS_ENDS_ROW)
        {
            var b false
            if Convert.convert_boolean(val, &b)
            {
                if sk = SK_IS_STARTS_ROW
                    set rec.starts_row: b
                else
                    set rec.ends_row: b
            }
            else
                Convert.invalid_value(interp, ident, loc)
            return
        }
        var n 0
        var ok Convert.convert_integer(val, &n)
        if ok
        {
            if n <= 0
                set ok: false
        }
        if ok = false
        {
            Convert.invalid_value(interp, ident, loc)
            return
        }
        if sk = SK_COLUMN_NUMBER
        {
            set rec.column_index: n - 1
            set rec.has_column_number: true
        }
        if sk = SK_N_COLUMNS_SPANNED
            set rec.n_columns_spanned: n
        if sk = SK_N_ROWS_SPANNED
            set rec.n_rows_spanned: n
    }

    ; the table-family NIC key sets (Table*FlowObj::hasNonInheritedC +
    ; hasPseudoNonInheritedC — both classes route the same way here).
    function is_table_nic_key(foc: int, sk: int) returns bool
    {
        if foc = FOC_TABLE
        {
            if sk = SK_TABLE_WIDTH
                return true
            if sk = SK_BEFORE_ROW_BORDER
                return true
            if sk = SK_AFTER_ROW_BORDER
                return true
            if sk = SK_BEFORE_COLUMN_BORDER
                return true
            if sk = SK_AFTER_COLUMN_BORDER
                return true
            return false
        }
        if foc = FOC_TABLE_COLUMN
        {
            if sk = SK_COLUMN_NUMBER
                return true
            if sk = SK_N_COLUMNS_SPANNED
                return true
            if sk = SK_WIDTH
                return true
            return false
        }
        if foc = FOC_TABLE_CELL
        {
            if sk = SK_N_ROWS_SPANNED
                return true
            if sk = SK_COLUMN_NUMBER
                return true
            if sk = SK_N_COLUMNS_SPANNED
                return true
            if sk = SK_IS_STARTS_ROW
                return true
            if sk = SK_IS_ENDS_ROW
                return true
            return false
        }
        false
    }

    ; dispatch a table-family NIC key into the FO's record (created on demand
    ; on `host`); `tnic` is the in/out record slot.
    procedure apply_table_nic(foc: int, tnic: pointer[pointer[void]], sk: int, val: pointer[ELObj], ident: pointer[Identifier], loc: Location, interp: pointer[Interpreter], host: pointer[Page])
    {
        if foc = FOC_TABLE
        {
            if *tnic = null
                set *tnic: TableNICRec.make(host) as pointer[void]
            Convert.set_table_nic(*tnic as pointer[TableNICRec], sk, val, ident, loc, interp)
            return
        }
        if foc = FOC_TABLE_COLUMN
        {
            if *tnic = null
                set *tnic: TableColumnNICRec.make(host) as pointer[void]
            Convert.set_table_column_nic(*tnic as pointer[TableColumnNICRec], sk, val, ident, loc, interp)
            return
        }
        if foc = FOC_TABLE_CELL
        {
            if *tnic = null
                set *tnic: TableCellNICRec.make(host) as pointer[void]
            Convert.set_table_cell_nic(*tnic as pointer[TableCellNICRec], sk, val, ident, loc, interp)
        }
    }

    function is_display_nic_key(sk: int) returns bool
    {
        if sk = SK_POSITION_PREFERENCE
            return true
        if sk = SK_KEEP_WITH_PREVIOUS
            return true
        if sk = SK_KEEP_WITH_NEXT
            return true
        if sk = SK_KEEP
            return true
        if sk = SK_BREAK_BEFORE
            return true
        if sk = SK_BREAK_AFTER
            return true
        if sk = SK_MAY_VIOLATE_KEEP_BEFORE
            return true
        if sk = SK_MAY_VIOLATE_KEEP_AFTER
            return true
        if sk = SK_SPACE_BEFORE
            return true
        if sk = SK_SPACE_AFTER
            return true
        false
    }
}

; --- StyleStack (Style.cxx) --------------------------------------------------
; VarStyleObj's payload (the ELObj Style arm keeps its two-pointer shape: spec
; points here, use_chain stays in the arm). `display` is the captured closure
; vars of the style's VarInheritedC codes (null-terminated, like a closure
; display); `node` the current node at style creation (typed void: Style does
; not import Grove — only the VM glue dereferences it).
define VarStyleRec
(
    force_specs: pointer[Array[pointer[InheritedC]]]
    specs: pointer[Array[pointer[InheritedC]]]
    display: pointer[pointer[ELObj]]
    node: pointer[void]
)
{
    function make(host: pointer[Page], force_specs: pointer[Array[pointer[InheritedC]]], specs: pointer[Array[pointer[InheritedC]]], display: pointer[pointer[ELObj]], node: pointer[void]) returns pointer[VarStyleRec]
    {
        let r host.allocate(sizeof VarStyleRec, alignof VarStyleRec) as pointer[VarStyleRec]
        set r.force_specs: force_specs
        set r.specs: specs
        set r.display: display
        set r.node: node
        r
    }
}

; InheritedCInfo — one pushed spec for one characteristic index; `prev` chains
; to the spec shadowed at an outer level (restored by pop). `style` is the
; VarStyleRec the spec came from (display + node for VarInheritedC evaluation);
; `cached_value` the push-time evaluated value (valid only while none of
; `dependencies` — indices this value read via actual-*/inherited-* — changed).
define InheritedCInfo
(
    spec: pointer[InheritedC]
    prev: pointer[InheritedCInfo]
    val_level: int
    spec_level: int
    style: pointer[VarStyleRec]
    cached_value: pointer[ELObj]
    dependencies: pointer[Array[int]]
)
{
    function make(host: pointer[Page], spec: pointer[InheritedC], style: pointer[VarStyleRec], prev: pointer[InheritedCInfo], val_level: int, spec_level: int) returns pointer[InheritedCInfo]
    {
        let info host.allocate(sizeof InheritedCInfo, alignof InheritedCInfo) as pointer[InheritedCInfo]
        set info.spec: spec
        set info.prev: prev
        set info.val_level: val_level
        set info.spec_level: spec_level
        set info.style: style
        set info.cached_value: null
        set info.dependencies: Array[int]^host()
        info
    }
}

define PopList (list: pointer[Array[int]], depending_list: pointer[Array[int]], prev: pointer[PopList])
{
    function make(host: pointer[Page], prev: pointer[PopList]) returns pointer[PopList]
    {
        let pl host.allocate(sizeof PopList, alignof PopList) as pointer[PopList]
        set pl.list: Array[int]^host()
        set pl.depending_list: Array[int]^host()
        set pl.prev: prev
        pl
    }
}

define StyleStack (info: pointer[Array[pointer[InheritedCInfo]]], level: int, pop_list: pointer[PopList], host: pointer[Page])
{
    function make(host: pointer[Page]) returns pointer[StyleStack]
    {
        let ss host.allocate(sizeof StyleStack, alignof StyleStack) as pointer[StyleStack]
        set ss.info: Array[pointer[InheritedCInfo]]^host()
        set ss.level: 0
        set ss.pop_list: null
        set ss.host: host
        ss
    }

    function push_start(this: pointer[StyleStack], scratch: pointer[Page])
    {
        set this.level: this.level + 1
        set this.pop_list: PopList.make(scratch, this.pop_list)
    }

    ; the C++ StyleStack copy (Connectable/Connection snapshots): a shallow
    ; copy of the info vector (the InheritedCInfo chains are immutable and
    ; shared), same level, SHARED pop-list pointer — balanced push/pop on the
    ; copy builds and unwinds its own PopLists on top and never mutates the
    ; shared tail (push_end_prologue only READS prev's depending list).
    function copy(this: pointer[StyleStack], host: pointer[Page]) returns pointer[StyleStack]
    {
        let ss host.allocate(sizeof StyleStack, alignof StyleStack) as pointer[StyleStack]
        let info Array[pointer[InheritedCInfo]]^host()
        let n this.info.get_length()
        var i: size_t 0
        while i < n
        {
            let p this.info.get(i)
            if p <> null
                info.add(*p)
            else
                info.add(null)
            set i: i + (1 as size_t)
        }
        set ss.info: info
        set ss.level: this.level
        set ss.pop_list: this.pop_list
        set ss.host: host
        ss
    }

    ; grow the info vector to cover index `ind`.
    function info_at(this: pointer[StyleStack], ind: int) returns pointer[InheritedCInfo]
    {
        if (ind as size_t) >= this.info.get_length()
            return null
        let p this.info.get(ind as size_t)
        if p = null
            return null
        *p
    }

    function info_set(this: pointer[StyleStack], ind: int, v: pointer[InheritedCInfo])
    {
        while this.info.get_length() <= (ind as size_t)
            this.info.add(null)
        this.info.put(ind as size_t, v)
    }

    ; StyleStack::pushContinue — walk the style chain per VarStyleObj::
    ; appendIter: own force! specs, own specs, then the use chain (its force
    ; and normal specs at that point); first spec per characteristic wins
    ; within this level.
    function push_continue(this: pointer[StyleStack], style: pointer[ELObj], scratch: pointer[Page])
    {
        if style = null
            return
        let rec style.style_spec() as pointer[VarStyleRec]
        if rec <> null
        {
            this.push_spec_array(rec.force_specs, rec, scratch)
            this.push_spec_array(rec.specs, rec, scratch)
        }
        let u style.style_use()
        if u <> null
            this.push_continue(u, scratch)
    }

    function push_spec_array(this: pointer[StyleStack], arr: pointer[Array[pointer[InheritedC]]], rec: pointer[VarStyleRec], scratch: pointer[Page])
    {
        if arr = null
            return
        let n arr.get_length()
        var i: size_t 0
        while i < n
        {
            let icp arr.get(i)
            if icp <> null
            {
                let ic *icp
                if ic <> null
                    this.push_spec(ic, rec, scratch)
            }
            set i: i + (1 as size_t)
        }
    }

    function push_spec(this: pointer[StyleStack], spec: pointer[InheritedC], rec: pointer[VarStyleRec], scratch: pointer[Page])
    {
        let ind spec.get_index()
        let cur this.info_at(ind)
        if cur <> null
        {
            if cur.val_level = this.level
                return
        }
        this.pop_list.list.add(ind)
        this.info_set(ind, InheritedCInfo.make(scratch, spec, rec, cur, this.level, this.level))
    }

    ; StyleStack::pushEnd's prologue: a characteristic that DEPENDS (via
    ; actual-*) on another characteristic re-evaluates at this level when any
    ; of its dependencies was re-specified here — re-push it (keeping its
    ; original spec_level); otherwise it keeps depending at this level too.
    function push_end_prologue(this: pointer[StyleStack], scratch: pointer[Page])
    {
        let pl this.pop_list
        if pl = null
            return
        let old pl.prev
        if old = null
            return
        let n old.depending_list.get_length()
        var i: size_t 0
        while i < n
        {
            let dp old.depending_list.get(i)
            if dp <> null
            {
                let d *dp
                let info this.info_at(d)
                if info <> null
                {
                    if info.val_level <> this.level
                    {
                        var changed false
                        let deps info.dependencies
                        let nd deps.get_length()
                        var j: size_t 0
                        while j < nd
                        {
                            if changed = false
                            {
                                let ip deps.get(j)
                                if ip <> null
                                {
                                    let p this.info_at(*ip)
                                    if p <> null
                                    {
                                        if p.val_level = this.level
                                        {
                                            this.info_set(d, InheritedCInfo.make(scratch, info.spec, info.style, info, this.level, info.spec_level))
                                            pl.list.add(d)
                                            set changed: true
                                        }
                                    }
                                }
                            }
                            set j: j + (1 as size_t)
                        }
                        if changed = false
                            pl.depending_list.add(d)
                    }
                }
            }
            set i: i + (1 as size_t)
        }
    }

    ; pushEnd's per-spec epilogue: a spec whose evaluation recorded
    ; dependencies keeps re-evaluating at deeper levels (see prologue).
    function note_depending(this: pointer[StyleStack], ind: int)
    {
        if this.pop_list <> null
            this.pop_list.depending_list.add(ind)
    }

    function pop(this: pointer[StyleStack])
    {
        let pl this.pop_list
        if pl <> null
        {
            let n pl.list.get_length()
            var i: size_t 0
            while i < n
            {
                let indp pl.list.get(i)
                if indp <> null
                {
                    let ind *indp
                    let cur this.info_at(ind)
                    if cur <> null
                        this.info_set(ind, cur.prev)
                }
                set i: i + (1 as size_t)
            }
            set this.pop_list: pl.prev
        }
        set this.level: this.level - 1
    }

    function push_empty(this: pointer[StyleStack])
        set this.level: this.level + 1

    function pop_empty(this: pointer[StyleStack])
        set this.level: this.level - 1

    function get_level(this: pointer[StyleStack]) returns int
        level

    ; the specs pushed at the CURRENT level, in push order — the set* feed for
    ; pushEnd (the caller renders them through its sink).
    function current_specs(this: pointer[StyleStack]) returns pointer[Array[int]]
    {
        if this.pop_list = null
            return null
        this.pop_list.list
    }

}
