; InheritedC — one record for the reference's class family. `kind` selects the
; payload; `slot` <> -1 marks a pending entry (value converted from the VM
; stack at make-exec); `proto` is the registry prototype a pending/converted
; entry derives from. `print_name` is the exact attribute name SgmlFOTBuilder
; emits (faithful quirks included: "inhibit-line-breaks?" keeps its '?',
; justify-spread? prints "jystify-spread").
define InheritedC
(
    kind: int
    ident: ref[Identifier]?
    index: int
    print_name: StringC
    bval: bool
    lval: int
    sym: FotSym
    sval: StringC
    ls: LengthSpec
    obj: ref[ELObj]?
    gst: ref[Array[ref[GlyphSubstTableRec]?]]?
    code: ref[Insn]?
    proto: ref[InheritedC]?
    loc: Location
    ; rtf-backend extension characteristic setter id (0 = none; the 12-entry
    ; jade.cxx extension table, RtfFOTBuilder.set_extension_ic)
    ext_setter: int
    ; Identifier::inheritedCPart_ / inheritedCLoc_ (the reference keeps them on
    ; the Identifier; here they ride the prototype, the only cell a
    ; declare-characteristic install writes). -1 = a BUILT-IN characteristic,
    ; which is what makes `defPart <= currentPartIndex()` false for every
    ; builtin and true only for one the stylesheet declared itself.
    def_part: u32
    def_loc: Location
)
{
    function make(host: ref[Page], kind: int, ident: ref[Identifier]?, index: int, print_name: StringC) returns ref[InheritedC]
    {
        let ic &InheritedC^host(kind, ident, index, print_name, false, 0, FotSym(), StringC(), LengthSpec(), null, null, null, null, Location(), 0, 0xFFFFFFFF, Location())
        ic
    }

    ; InheritedC::identifier()->name() — the characteristic's name, which only
    ; the ambiguousStyle diagnostic needs.
    function get_ident_name(this: InheritedC) returns StringC
    {
        if ident = null
            return StringC()
        ident.get_name()
    }

    function get_index(this: InheritedC) returns int
        index

    function get_kind(this: InheritedC) returns int
        kind

    function get_proto(this: InheritedC) returns ref[InheritedC]?
        proto

    ; VarInheritedC (Style.cxx): a non-constant spec — `code` (an Insn chain,
    ; typed void: Style cannot import Insn) evaluated at style-push against the
    ; owning style's display + node; `loc` anchors the invalid-value message.
    function make_var(host: ref[Page], proto: ref[InheritedC], code: ref[Insn]?, loc: Location) returns ref[InheritedC]
    {
        let ic InheritedC.make(host, proto.get_kind(), proto.ident, proto.get_index(), proto.print_name)
        set ic.code: code
        set ic.proto: proto
        set ic.loc: loc
        set ic.ext_setter: proto.ext_setter
        ic
    }

    function is_var(this: InheritedC) returns bool
        code <> null

    ; pin a StringC's bytes onto `host` (empty stays empty) — the save-queue
    ; records outlive the eval bracket the conversion ran under.
    function pin_string(host: ref[Page], s: StringC) returns StringC
    {
        if s.get_size() = 0
            return StringC()
        StringC^host(s.data_ptr(), s.get_size())
    }

    function pin_fotsym(host: ref[Page], s: FotSym) returns FotSym
    {
        var r FotSym()
        set r.code: s.code
        set r.name: InheritedC.pin_string(host, s.name)
        r
    }

    ; the SaveFOTBuilder deep copy: everything set_ic reads at replay time
    ; must live on the queue's host (the reference Call records copy their
    ; args by value). Payload ELObjs are rematerialized for the kinds the
    ; sinks dereference (color / inline-space); other object payloads are
    ; consumed at capture time and dropped here.
    function copy_for_save(this: ref[InheritedC], host: ref[Page]) returns ref[InheritedC]
    {
        let pn: StringC InheritedC.pin_string(host, this.print_name)
        let c InheritedC.make(host, this.kind, this.ident, this.index, pn)
        set c.bval: this.bval
        set c.lval: this.lval
        set c.sym: InheritedC.pin_fotsym(host, this.sym)
        set c.sval: InheritedC.pin_string(host, this.sval)
        set c.ls: this.ls
        set c.proto: this.proto
        set c.loc: this.loc
        set c.ext_setter: this.ext_setter
        if this.obj <> null
        {
            if (this.kind = IC_COLOR) or (this.kind = IC_OPT_COLOR)
            {
                let rgb this.obj.color_rgb()
                if rgb >= 0
                    set c.obj: ELObj.make_color(host, (rgb >> 16) & 0xFF, (rgb >> 8) & 0xFF, rgb & 0xFF)
            }
            if (this.kind = IC_INLINE_SPACE) or (this.kind = IC_OPT_INLINE_SPACE)
            {
                let sp this.obj.as_inline_space()
                if sp <> null
                {
                    let np InlineSpace.make(host)
                    set np.nominal: sp.nominal
                    set np.min: sp.min
                    set np.max: sp.max
                    set c.obj: ELObj.make_inline_space(host, np)
                }
            }
        }
        if this.gst <> null
        {
            let tabs Array[ref[GlyphSubstTableRec]?]^host()
            let n this.gst.get_length()
            var i: size_t 0
            while i < n
            {
                let tp this.gst.get(i)
                if tp <> null
                    tabs.add(*tp)
                set i: i + 1
            }
            set c.gst: tabs
        }
        c
    }

}

; --- value conversions (Interpreter::convert*C, InheritedC.cxx make()) ------
define Convert
{
    ; ★The identifier is NULLABLE, in Primitive.arg_error#'s shape and for its
    ; reason: the characteristic's name is materialised HERE and nowhere else,
    ; the reference recovers it from a `const Identifier *`, and a value that
    ; has no identifier still has an invalid value to report. An empty name is
    ; what the reference's own message machinery prints for one.
    procedure invalid_value(interp: ref[Interpreter], ident: ref[Identifier]?, loc: Location)
    {
        interp.set_next_location(loc)
        var iv_name StringC()
        if ident <> null
            set iv_name: ident.get_name()
        interp.message1(InterpreterMessages.invalidCharacteristicValue(), iv_name)
    }

    ; convertLengthC: an exact/inexact quantity of dimension 1.
    function convert_length(val_in: ref[ELObj], out: ref[int], interp: ref[Interpreter], loc: Location) returns bool
    {
        let val interp.convert_from_string(val_in, CONVERT_ALLOW_NUMBER, loc)
        let qv: QuantityValue val.quantity_value()
        if qv.get_qtype() = QT_LONG
        {
            ; ★the out parameter is written even when the DIMENSION is wrong:
            ; the reference passes it straight into quantityValue
            ; (`obj->quantityValue(n, d, dim)`), which stores the exact value
            ; before anyone looks at the dimension. Measured: a dimensionless
            ; `space-before: 12` messages `invalid value` AND prints
            ; `.012pt,0pt,0pt` — 12 internal units in the nominal, nothing in
            ; min/max. The double arm does NOT write (quantityValue fills `d`).
            set out: qv.get_lval()
            if qv.get_dim() = 1
                return true
        }
        if qv.get_qtype() = QT_DOUBLE
        {
            if qv.get_dim() = 1
            {
                set out: qv.get_dval() as int
                return true
            }
        }
        false
    }

    ; convertLengthSpecC: the characteristic form — the `-2` string leniency
    ; first, then the raw conversion below. ★The two are separate in the
    ; reference too (Interpreter.h:388 declares the raw one on its own), and
    ; the difference is observable: the display-space/inline-space PRIMITIVES
    ; call the raw form, so a string argument stays invalid there even under
    ; `-2`.
    function convert_length_spec_c(val_in: ref[ELObj]?, out: ref[LengthSpec], interp: ref[Interpreter], loc: Location) returns bool
    {
        let val interp.convert_from_string(val_in as ref[ELObj], CONVERT_ALLOW_NUMBER, loc)
        Convert.convert_length_spec(val, out)
    }

    ; convertLengthSpec: a length quantity, or an engine length-spec
    ; (display-size / arithmetic results) — LengthSpec::convert rounds the
    ; length component and carries the display-size factor (the table-unit
    ; component is dropped; the TableLengthSpec variant keeps it).
    function convert_length_spec(val: ref[ELObj], out: ref[LengthSpec]) returns bool
    {
        ; unlike convertLengthC (truncates), convertLengthSpec ROUNDS its
        ; doubleQuantity arm (Interpreter.cxx: long(d < 0 ? d - .5 : d + .5))
        let qv: QuantityValue val.quantity_value()
        if qv.get_qtype() = QT_LONG
        {
            ; ★the LENGTH field is written even when the dimension is wrong
            ; (see convert_length) — and only that field: the reference hands
            ; `result.length` to quantityValue and never touches the factor.
            set out.length: qv.get_lval()
            if qv.get_dim() = 1
                return true
        }
        if qv.get_qtype() = QT_DOUBLE
        {
            if qv.get_dim() = 1
            {
                var ls LengthSpec()
                set ls.length: Convert.round_length(qv.get_dval())
                set out: ls
                return true
            }
        }
        let els val.length_spec()
        if els <> null
        {
            var ls LengthSpec()
            set ls.length: Convert.round_length(els.v0)
            set ls.factor: els.v1
            set out: ls
            return true
        }
        false
    }

    ; long(v < 0 ? v - .5 : v + .5) — LengthSpec::convert's rounding.
    function round_length(v: double) returns int
    {
        if v < 0.0
            return (v - 0.5) as int
        (v + 0.5) as int
    }

    ; LengthSpec::convert(FOTBuilder::TableLengthSpec &) — like
    ; convert_length_spec but the table-unit factor survives.
    function convert_table_length_spec(val: ref[ELObj], out: ref[LengthSpec], out_tfactor: ref[double], interp: ref[Interpreter], loc: Location) returns bool
    {
        let els val.length_spec()
        if els <> null
        {
            var ls LengthSpec()
            set ls.length: Convert.round_length(els.v0)
            set ls.factor: els.v1
            set out: ls
            set out_tfactor: els.v2
            return true
        }
        set out_tfactor: 0.0
        ; the reference falls back to convertLengthSpecC here (FlowObj.cxx:2354)
        Convert.convert_length_spec_c(val, out, interp, loc)
    }

    ; convertBooleanC is STRICT: only the #t/#f singletons convert (is_true
    ; is truthiness — any non-#f object — and must NOT be used here). Under
    ; `-2` the strings "yes"/"no"/"true"/"false" become those singletons
    ; first; every other string stays invalid.
    function convert_boolean(val_in: ref[ELObj]?, out: ref[bool], interp: ref[Interpreter], loc: Location) returns bool
    {
        let val interp.convert_from_string(val_in as ref[ELObj], CONVERT_ALLOW_BOOLEAN, loc)
        if val.is_false()
        {
            set out: false
            return true
        }
        if val.is_boolean_p()
        {
            set out: true
            return true
        }
        false
    }

    ; convertEnumC (identifier-less overload): #f / #t / any symbol installed
    ; with a c-value. Under `-2` a string may name one of them.
    function convert_enum(val_in: ref[ELObj]?, out: ref[FotSym], interp: ref[Interpreter], loc: Location) returns bool
    {
        let val interp.convert_from_string(val_in as ref[ELObj], (CONVERT_ALLOW_SYMBOL | CONVERT_ALLOW_BOOLEAN), loc)
        var r FotSym()
        if val.is_false()
        {
            set out: r
            return true
        }
        if val.is_symbol_p()
        {
            let code val.symbol_c_value()
            if code <> SYM_FALSE
            {
                set r.code: code
                set r.name: val.symbol_name()
                set out: r
                return true
            }
            return false
        }
        ; ★the reference tests IDENTITY with the #t singleton
        ; (`obj == makeTrue()`), not truthiness — `is_true` answers true for
        ; EVERY non-#f object, which used to let a length or a string through
        ; as symbolTrue (measured 2026-07-31 with
        ; `side-by-side-pre-align: 3pt`, which the reference rejects).
        if val.is_boolean_p()
        {
            set r.code: SYM_TRUE
            set out: r
            return true
        }
        false
    }

    ; convertEnumC (allowed-set overload, the NIC form): the value must convert
    ; AND its code must be in `allowed` (codes array, n entries).
    function convert_enum_set(val: ref[ELObj]?, allowed: Slice[int], out: ref[FotSym], interp: ref[Interpreter], loc: Location) returns bool
    {
        var r FotSym()
        if Convert.convert_enum(val, &r, interp, loc) = false
            return false
        var i 0
        while i < allowed.length
        {
            if allowed[i] = r.code
            {
                set out: r
                return true
            }
            set i: i + 1
        }
        false
    }

    function convert_string(host: ref[Page], val: ref[ELObj], out: ref[StringC]) returns bool
    {
        if val.is_string_p() = false
            return false
        let s val.string_data(host)
        set out: StringC^host(s.data_ptr(), s.get_size())
        true
    }

    ; ELObjExtensionFlowObjValue::convertStringList — a proper list of
    ; strings; a malformed tail keeps the prefix already collected and fails.
    function convert_string_list(host: ref[Page], val: ref[ELObj], out: ref[Array[StringC]]) returns bool
    {
        var obj: ref[ELObj]? val
        while true
        {
            if obj = null
                return false
            if obj.is_nil()
                return true
            if obj.is_pair() = false
                return false
            let car obj.get_car()
            if car = null
                return false
            if car.is_string_p() = false
                return false
            let sd car.string_data(host)
            out.add(StringC^host(sd.data_ptr(), sd.get_size()))
            set obj: obj.get_cdr()
        }
        false
    }

    function convert_integer(val_in: ref[ELObj]?, out: ref[int], interp: ref[Interpreter], loc: Location) returns bool
    {
        let val interp.convert_from_string(val_in as ref[ELObj], CONVERT_ALLOW_NUMBER, loc)
        let qv: QuantityValue val.quantity_value()
        if qv.get_qtype() = QT_LONG
        {
            if qv.get_dim() = 0
            {
                set out: qv.get_lval()
                return true
            }
        }
        false
    }

    ; convertPublicIdC: #f (empty) or a (possibly empty) string.
    function convert_public_id(host: ref[Page], val: ref[ELObj], out: ref[StringC], out_false: ref[bool]) returns bool
    {
        if val.is_false()
        {
            set out_false: true
            return true
        }
        if val.is_string_p()
        {
            set out_false: false
            let s val.string_data(host)
            set out: StringC^host(s.data_ptr(), s.get_size())
            return true
        }
        false
    }

    ; convertLetter2C: #f clears; a STRING of exactly two UPPERCASE letters
    ; (the reference accepts no symbols and does not case-fold — "de" is an
    ; invalid value); the empty string also clears.
    function convert_letter2(host: ref[Page], val: ref[ELObj], out: ref[StringC], out_false: ref[bool]) returns bool
    {
        ; convertLetter2C goes through convertToString — a SYMBOL ('EN, the
        ; docbook dsssl-language-code shape) converts like a string; #f is
        ; checked only when the conversion fails.
        let cs val.convert_to_string(host)
        if cs = null
        {
            if val.is_false()
            {
                set out_false: true
                return true
            }
            return false
        }
        let s cs.string_data(host)
        if s.get_size() = 0
        {
            set out_false: true
            return true
        }
        if s.get_size() <> 2
            return false
        var up u32[2]
        var i: size_t 0
        while i < 2
        {
            let c s.get(i)
            if c < 0x41
                return false
            if c > 0x5A
                return false
            set *((up as pointer[u32]) + i): c
            set i: i + 1
        }
        set out_false: false
        ; ^host, NOT the plain copying init: a plain StringC(ptr, n) temporary
        ; copies onto the TEMPORARY's page (Page.get(this)) — the record then
        ; stores a pointer into the dead frame region (bug found by the fot
        ; toy diff: language="DE" printed NULs).
        set out: StringC^host(up as pointer[u32], 2)
        true
    }

    ; InheritedC::make(value, loc, interp) — derive a constant IC from the
    ; prototype `proto` with the converted value; null + message on invalid.
    ; Quantities resolve first (a parse-time datum like 18pt is an
    ; UnresolvedLengthObj until forced — ResolveQuantitiesInsn's job on the
    ; eval path; the compile-time constant path forces here).
    function ic_from_value(host: ref[Page], proto: ref[InheritedC], val_in: ref[ELObj], loc: Location, interp: ref[Interpreter]) returns ref[InheritedC]?
    {
        var val val_in
        let resolved val.resolve_quantities(true, interp, loc)
        if resolved <> null
            set val: resolved as ref[ELObj]
        let ic InheritedC.make(host, proto.get_kind(), proto.ident, proto.get_index(), proto.print_name)
        set ic.proto: proto
        set ic.loc: loc
        set ic.ext_setter: proto.ext_setter
        let kind proto.get_kind()
        var ok false
        if kind = IC_BOOL
        {
            var b false
            set ok: Convert.convert_boolean(val, &b, interp, loc)
            set ic.bval: b
        }
        else if kind = IC_LENGTH
        {
            var n 0
            set ok: Convert.convert_length(val, &n, interp, loc)
            set ic.lval: n
        }
        else if kind = IC_LENGTH_SPEC
        {
            var ls LengthSpec()
            set ok: Convert.convert_length_spec_c(val, &ls, interp, loc)
            set ic.ls: ls
        }
        else if kind = IC_SYMBOL
        {
            var sym FotSym()
            set ok: Convert.convert_enum(val, &sym, interp, loc)
            set ic.sym: sym
        }
        else if kind = IC_STRING
        {
            var s StringC()
            set ok: Convert.convert_string(host, val, &s)
            set ic.sval: s
        }
        else if kind = IC_INT
        {
            var n 0
            set ok: Convert.convert_integer(val, &n, interp, loc)
            set ic.lval: n
        }
        else if kind = IC_PUBLIC_ID
        {
            var s StringC()
            var was_false false
            set ok: Convert.convert_public_id(host, val, &s, &was_false)
            set ic.sval: s
            set ic.bval: was_false
        }
        else if kind = IC_LETTER2
        {
            var s StringC()
            var was_false false
            set ok: Convert.convert_letter2(host, val, &s, &was_false)
            set ic.sval: s
            set ic.bval: was_false
        }
        else if kind = IC_MAYBE_INT
        {
            ; convertOptPositiveIntegerC: #f -> 0, else a strictly positive
            ; exact integer. ★Its `-2` leniency allows a number OR a boolean
            ; and is applied ONCE, before the #f test — so "no" reaches the
            ; #f arm, while convertIntegerC (number only) would reject it.
            let mval interp.convert_from_string(val, (CONVERT_ALLOW_NUMBER | CONVERT_ALLOW_BOOLEAN), loc)
            if mval.is_false()
            {
                set ic.lval: 0
                set ok: true
            }
            else
            {
                var n 0
                if Convert.convert_integer(mval, &n, interp, loc)
                {
                    if n > 0
                    {
                        set ic.lval: n
                        set ok: true
                    }
                }
            }
        }
        else if kind = IC_IGNORED
        {
            ; IgnoredC::make — any value is accepted and stored.
            set ic.obj: val
            set ok: true
        }
        else if kind = IC_BORDER
        {
            ; BorderC::make — a table-border sosofo is stored as-is; anything
            ; else must convert to a boolean (canonical #t/#f stored).
            if Convert.is_table_border_sosofo(val)
            {
                set ic.obj: val
                set ok: true
            }
            else
            {
                var b false
                if Convert.convert_boolean(val, &b, interp, loc)
                {
                    if b
                        set ic.obj: interp.make_true()
                    else
                        set ic.obj: interp.make_false()
                    set ok: true
                }
            }
        }
        else if kind = IC_COLOR
        {
            ; ColorC::make / convertColorC — the value must be a color.
            if val.is_color_p()
            {
                set ic.obj: val
                set ok: true
            }
        }
        else if kind = IC_OPT_COLOR
        {
            ; BackgroundColorC::make / convertOptColorC — a color or #f.
            if val.is_color_p()
            {
                set ic.obj: val
                set ok: true
            }
            else if val.is_false()
            {
                set ic.obj: null
                set ok: true
            }
        }
        else if kind = IC_OPT_LENGTH_SPEC
        {
            ; convertOptLengthSpecC: #f -> no length; else a length-spec.
            ; ★its own `-2` leniency (number OR boolean) runs BEFORE the #f
            ; test, so "no" selects the length-less form.
            let oval interp.convert_from_string(val, (CONVERT_ALLOW_NUMBER | CONVERT_ALLOW_BOOLEAN), loc)
            if oval.is_false()
            {
                set ic.bval: true
                set ok: true
            }
            else
            {
                var ls LengthSpec()
                if Convert.convert_length_spec_c(oval, &ls, interp, loc)
                {
                    set ic.ls: ls
                    set ic.bval: false
                    set ok: true
                }
            }
        }
        else if kind = IC_INLINE_SPACE
        {
            ; GenericInlineSpaceInheritedC::make — an inline-space object, or
            ; a length-spec (min = max = nominal).
            if val.as_inline_space() <> null
            {
                set ic.obj: val
                set ok: true
            }
            else
            {
                var ls LengthSpec()
                if Convert.convert_length_spec_c(val, &ls, interp, loc)
                {
                    let sp InlineSpace.make(host)
                    set sp.nominal: ls
                    set sp.min: ls
                    set sp.max: ls
                    set ic.obj: ELObj.make_inline_space(host, sp)
                    set ok: true
                }
            }
        }
        else if kind = IC_OPT_INLINE_SPACE
        {
            ; GenericOptInlineSpaceInheritedC::make — an inline-space, #f, or
            ; a length-spec (via convertOptLengthSpecC, whose leniency covers
            ; the #f test as well).
            if val.as_inline_space() <> null
            {
                set ic.obj: val
                set ok: true
            }
            else
            {
                let oval interp.convert_from_string(val, (CONVERT_ALLOW_NUMBER | CONVERT_ALLOW_BOOLEAN), loc)
                if oval.is_false()
                {
                    set ic.obj: null
                    set ok: true
                }
                else
                {
                    var ls LengthSpec()
                    if Convert.convert_length_spec_c(oval, &ls, interp, loc)
                    {
                        let sp InlineSpace.make(host)
                        set sp.nominal: ls
                        set sp.min: ls
                        set sp.max: ls
                        set ic.obj: ELObj.make_inline_space(host, sp)
                        set ok: true
                    }
                }
            }
        }
        else if kind = IC_GST
        {
            ; GlyphSubstTableC::make — #f (isList 0, empty), a single table
            ; (isList 0), or a proper list of tables (isList 1); bval = isList.
            let tabs Array[ref[GlyphSubstTableRec]?]^host()
            set ic.gst: tabs
            if val.is_false()
                set ok: true
            else
            {
                let single val.as_glyph_subst_table()
                if single <> null
                {
                    tabs.add(single)
                    set ok: true
                }
                else
                {
                    set ic.bval: true
                    var p val
                    var good true
                    var done false
                    while done = false
                    {
                        if p.is_nil()
                            set done: true
                        else if p.is_pair() = false
                        {
                            set good: false
                            set done: true
                        }
                        else
                        {
                            let car p.get_car()
                            var t: ref[GlyphSubstTableRec]? null
                            if car <> null
                                set t: car.as_glyph_subst_table()
                            if t = null
                            {
                                set good: false
                                set done: true
                            }
                            else
                            {
                                tabs.add(t)
                                set p: p.get_cdr() as ref[ELObj]
                            }
                        }
                    }
                    set ok: good
                }
            }
        }
        else if kind = IC_RULE
        {
            ; RuleC::make — the value must be a rule-FO sosofo (the rule
            ; class binding's FlowObj prototype counts: FlowObj isRule()).
            if Convert.is_rule_value(val)
            {
                set ic.obj: val
                set ok: true
            }
        }
        if ok = false
        {
            Convert.invalid_value(interp, proto.ident, loc)
            return null
        }
        ic
    }

    ; FlowObj::setDisplayNIC — returns true when `sk` is a display NIC key
    ; (value converted into `nic`; an invalid value messages and leaves the
    ; default, per the reference convert*C behaviour).
    function set_display_nic(nic: ref[DisplayNIC], sk: int, val: ref[ELObj], ident: ref[Identifier]?, loc: Location, interp: ref[Interpreter], host: ref[Page]) returns bool
    {
        if sk = SK_POSITION_PREFERENCE
        {
            ; 3 x 8-byte int (an undersized buffer here overlaps the next
            ; allocation — the decode-key-args bug class).
            let allowed host.allocate(24, 8) as pointer[int]
            set *allowed: SYM_FALSE
            set *(allowed + 1): SYM_TOP
            set *(allowed + 2): SYM_BOTTOM
            var s FotSym()
            if Convert.convert_enum_set(val, Slice[int](3, allowed), &s, interp, loc)
                set nic.position_preference: s
            else
                Convert.invalid_value(interp, ident, loc)
            return true
        }
        if sk = SK_KEEP_WITH_PREVIOUS
        {
            var b false
            if Convert.convert_boolean(val, &b, interp, loc)
                set nic.keep_with_previous: b
            else
                Convert.invalid_value(interp, ident, loc)
            return true
        }
        if sk = SK_KEEP_WITH_NEXT
        {
            var b false
            if Convert.convert_boolean(val, &b, interp, loc)
                set nic.keep_with_next: b
            else
                Convert.invalid_value(interp, ident, loc)
            return true
        }
        if sk = SK_KEEP
        {
            let allowed host.allocate(40, 8) as pointer[int]
            set *allowed: SYM_FALSE
            set *(allowed + 1): SYM_TRUE
            set *(allowed + 2): SYM_PAGE
            set *(allowed + 3): SYM_COLUMN_SET
            set *(allowed + 4): SYM_COLUMN
            var s FotSym()
            if Convert.convert_enum_set(val, Slice[int](5, allowed), &s, interp, loc)
                set nic.keep: s
            else
                Convert.invalid_value(interp, ident, loc)
            return true
        }
        if (sk = SK_BREAK_BEFORE) or (sk = SK_BREAK_AFTER)
        {
            let allowed host.allocate(40, 8) as pointer[int]
            set *allowed: SYM_FALSE
            set *(allowed + 1): SYM_PAGE
            set *(allowed + 2): SYM_PAGE_REGION
            set *(allowed + 3): SYM_COLUMN_SET
            set *(allowed + 4): SYM_COLUMN
            var s FotSym()
            if Convert.convert_enum_set(val, Slice[int](5, allowed), &s, interp, loc)
            {
                if sk = SK_BREAK_BEFORE
                    set nic.break_before: s
                else
                    set nic.break_after: s
            }
            else
                Convert.invalid_value(interp, ident, loc)
            return true
        }
        if sk = SK_MAY_VIOLATE_KEEP_BEFORE
        {
            var b false
            if Convert.convert_boolean(val, &b, interp, loc)
                set nic.may_violate_keep_before: b
            else
                Convert.invalid_value(interp, ident, loc)
            return true
        }
        if sk = SK_MAY_VIOLATE_KEEP_AFTER
        {
            var b false
            if Convert.convert_boolean(val, &b, interp, loc)
                set nic.may_violate_keep_after: b
            else
                Convert.invalid_value(interp, ident, loc)
            return true
        }
        if (sk = SK_SPACE_BEFORE) or (sk = SK_SPACE_AFTER)
        {
            ; FlowObj.cxx keySpaceBefore/After: a display-space object copies
            ; whole; else a length spec (min = max = nominal).
            let dsp val.as_display_space()
            if dsp <> null
            {
                let ds: DisplaySpace dsp as ref[DisplaySpace]
                if sk = SK_SPACE_BEFORE
                    set nic.space_before: ds
                else
                    set nic.space_after: ds
                return true
            }
            ; the reference converts STRAIGHT into the NIC's own
            ; `ds.nominal` (`convertLengthSpecC(obj, ident, loc, ds.nominal)`),
            ; so a conversion that fails on the DIMENSION still leaves its
            ; partial value in the NIC — `space-before: 12` messages AND
            ; prints `.012pt,0pt,0pt` (see convert_length_spec).
            var ds DisplaySpace()
            if sk = SK_SPACE_BEFORE
                set ds: nic.space_before
            else
                set ds: nic.space_after
            var ls ds.nominal
            let ok Convert.convert_length_spec_c(val, &ls, interp, loc)
            set ds.nominal: ls
            if ok
            {
                set ds.min: ls
                set ds.max: ls
            }
            else
                Convert.invalid_value(interp, ident, loc)
            if sk = SK_SPACE_BEFORE
                set nic.space_before: ds
            else
                set nic.space_after: ds
            return true
        }
        false
    }

    ; a (make table-border …) sosofo — the only sosofo with a border style
    ; (SosofoObj::tableBorderStyle).
    function is_table_border_sosofo(val: ref[ELObj]) returns bool
    {
        if val.is_sosofo_p() = false
            return false
        if val.sosofo_kind() <> SOSO_FLOWOBJ
            return false
        let fo val.sosofo_flowobj()
        if fo = null
            return false
        fo.get_foc() = FOC_TABLE_BORDER
    }

    ; RuleC::make's test — a rule-FO sosofo, or the rule class binding's
    ; FlowObj prototype itself (a FlowObj IS a sosofo in the reference;
    ; fraction-bar's initial value is lookup("rule")->flowObj()).
    function is_rule_value(val: ref[ELObj]) returns bool
    {
        let box val.flowobj_box_ref()
        if box <> null
            return box.get_foc() = FOC_RULE
        if val.is_sosofo_p() = false
            return false
        if val.sosofo_kind() <> SOSO_FLOWOBJ
            return false
        let fo val.sosofo_flowobj()
        if fo = null
            return false
        fo.get_foc() = FOC_RULE
    }

    ; a border characteristic VALUE resolved to the style to push: a
    ; table-border sosofo's style, or a boolean -> the canned border-present
    ; styles; null = invalid (caller messages).
    function border_style_from(val: ref[ELObj], interp: ref[Interpreter], loc: Location) returns ref[ELObj]?
    {
        if Convert.is_table_border_sosofo(val)
            return val.sosofo_flowobj().get_style()
        var b false
        if Convert.convert_boolean(val, &b, interp, loc)
        {
            if b
                return interp.border_true_style()
            return interp.border_false_style()
        }
        null
    }

    ; TableFlowObj::setNonInheritedC, the table-specific keys (the display
    ; NICs go through set_display_nic).
    procedure set_table_nic(rec: ref[TableNICRec], sk: int, val: ref[ELObj], ident: ref[Identifier]?, loc: Location, interp: ref[Interpreter])
    {
        if sk = SK_TABLE_WIDTH
        {
            if val.is_false()
            {
                set rec.width_type: TABLE_WIDTH_MINIMUM
                return
            }
            var ls LengthSpec()
            if Convert.convert_length_spec_c(val, &ls, interp, loc)
            {
                set rec.width: ls
                set rec.width_type: TABLE_WIDTH_EXPLICIT
            }
            else
                Convert.invalid_value(interp, ident, loc)
            return
        }
        let style Convert.border_style_from(val, interp, loc)
        if style = null
        {
            Convert.invalid_value(interp, ident, loc)
            return
        }
        if sk = SK_BEFORE_ROW_BORDER
            set rec.before_row_border: style
        if sk = SK_AFTER_ROW_BORDER
            set rec.after_row_border: style
        if sk = SK_BEFORE_COLUMN_BORDER
            set rec.before_column_border: style
        if sk = SK_AFTER_COLUMN_BORDER
            set rec.after_column_border: style
    }

    ; TableColumnFlowObj::setNonInheritedC.
    procedure set_table_column_nic(rec: ref[TableColumnNICRec], sk: int, val: ref[ELObj]?, ident: ref[Identifier]?, loc: Location, interp: ref[Interpreter])
    {
        if sk = SK_WIDTH
        {
            ; width is a TableLengthSpec, not just a LengthSpec — the
            ; table-unit factor survives.
            var ls LengthSpec()
            var tf 0.0
            if Convert.convert_table_length_spec(val as ref[ELObj], &ls, &tf, interp, loc)
            {
                set rec.width: ls
                set rec.width_tfactor: tf
                set rec.has_width: true
            }
            else
                Convert.invalid_value(interp, ident, loc)
            return
        }
        var n 0
        var ok Convert.convert_integer(val, &n, interp, loc)
        if ok
        {
            if n <= 0
                set ok: false
        }
        if ok = false
        {
            Convert.invalid_value(interp, ident, loc)
            return
        }
        if sk = SK_COLUMN_NUMBER
        {
            set rec.column_index: n - 1
            set rec.has_column_number: true
        }
        if sk = SK_N_COLUMNS_SPANNED
            set rec.n_columns_spanned: n
    }

    ; TableCellFlowObj::setNonInheritedC.
    procedure set_table_cell_nic(rec: ref[TableCellNICRec], sk: int, val: ref[ELObj]?, ident: ref[Identifier]?, loc: Location, interp: ref[Interpreter])
    {
        if (sk = SK_IS_STARTS_ROW) or (sk = SK_IS_ENDS_ROW)
        {
            var b false
            if Convert.convert_boolean(val, &b, interp, loc)
            {
                if sk = SK_IS_STARTS_ROW
                    set rec.starts_row: b
                else
                    set rec.ends_row: b
            }
            else
                Convert.invalid_value(interp, ident, loc)
            return
        }
        var n 0
        var ok Convert.convert_integer(val, &n, interp, loc)
        if ok
        {
            if n <= 0
                set ok: false
        }
        if ok = false
        {
            Convert.invalid_value(interp, ident, loc)
            return
        }
        if sk = SK_COLUMN_NUMBER
        {
            set rec.column_index: n - 1
            set rec.has_column_number: true
        }
        if sk = SK_N_COLUMNS_SPANNED
            set rec.n_columns_spanned: n
        if sk = SK_N_ROWS_SPANNED
            set rec.n_rows_spanned: n
    }

    ; the table-family NIC key sets (Table*FlowObj::hasNonInheritedC +
    ; hasPseudoNonInheritedC — both classes route the same way here).
    function is_table_nic_key(foc: int, sk: int) returns bool
    {
        if foc = FOC_TABLE
        {
            if sk = SK_TABLE_WIDTH
                return true
            if sk = SK_BEFORE_ROW_BORDER
                return true
            if sk = SK_AFTER_ROW_BORDER
                return true
            if sk = SK_BEFORE_COLUMN_BORDER
                return true
            if sk = SK_AFTER_COLUMN_BORDER
                return true
            return false
        }
        if foc = FOC_TABLE_COLUMN
        {
            if sk = SK_COLUMN_NUMBER
                return true
            if sk = SK_N_COLUMNS_SPANNED
                return true
            if sk = SK_WIDTH
                return true
            return false
        }
        if foc = FOC_TABLE_CELL
        {
            if sk = SK_N_ROWS_SPANNED
                return true
            if sk = SK_COLUMN_NUMBER
                return true
            if sk = SK_N_COLUMNS_SPANNED
                return true
            if sk = SK_IS_STARTS_ROW
                return true
            if sk = SK_IS_ENDS_ROW
                return true
            return false
        }
        false
    }

    ; dispatch a table-family NIC key into the FO's record (created on demand
    ; on `host`); `tnic` is the in/out record slot.
    procedure apply_table_nic(foc: int, tnic: pointer[pointer[void]], sk: int, val: ref[ELObj]?, ident: ref[Identifier]?, loc: Location, interp: ref[Interpreter], host: ref[Page])
    {
        if foc = FOC_TABLE
        {
            if *tnic = null
                set *tnic: TableNICRec.make(host) as pointer[void]
            Convert.set_table_nic(*tnic as ref[TableNICRec], sk, val as ref[ELObj], ident, loc, interp)
            return
        }
        if foc = FOC_TABLE_COLUMN
        {
            if *tnic = null
                set *tnic: TableColumnNICRec.make(host) as pointer[void]
            Convert.set_table_column_nic(*tnic as ref[TableColumnNICRec], sk, val, ident, loc, interp)
            return
        }
        if foc = FOC_TABLE_CELL
        {
            if *tnic = null
                set *tnic: TableCellNICRec.make(host) as pointer[void]
            Convert.set_table_cell_nic(*tnic as ref[TableCellNICRec], sk, val, ident, loc, interp)
        }
    }

    ; RuleFlowObj::hasNonInheritedC — the rule extras beyond the display NICs.
    function is_rule_nic_key(foc: int, sk: int) returns bool
    {
        if foc <> FOC_RULE
            return false
        if sk = SK_ORIENTATION
            return true
        if sk = SK_LENGTH
            return true
        if sk = SK_BREAK_BEFORE_PRIORITY
            return true
        if sk = SK_BREAK_AFTER_PRIORITY
            return true
        false
    }

    ; RuleFlowObj::setNonInheritedC (the non-display keys).
    procedure apply_rule_nic(rnic: pointer[pointer[void]], sk: int, val: ref[ELObj]?, ident: ref[Identifier]?, loc: Location, interp: ref[Interpreter], host: ref[Page])
    {
        if *rnic = null
            set *rnic: RuleNICRec.make(host) as pointer[void]
        let r *rnic as ref[RuleNICRec]
        if sk = SK_ORIENTATION
        {
            let allowed host.allocate(32, 8) as pointer[int]
            set *allowed: SYM_HORIZONTAL
            set *(allowed + 1): SYM_VERTICAL
            set *(allowed + 2): SYM_ESCAPEMENT
            set *(allowed + 3): SYM_LINE_PROGRESSION
            var s FotSym()
            if Convert.convert_enum_set(val, Slice[int](4, allowed), &s, interp, loc)
                set r.orientation: s
            else
                Convert.invalid_value(interp, ident, loc)
            return
        }
        if sk = SK_LENGTH
        {
            var ls LengthSpec()
            if Convert.convert_length_spec_c(val, &ls, interp, loc)
            {
                set r.length: ls
                set r.has_length: true
            }
            else
                Convert.invalid_value(interp, ident, loc)
            return
        }
        if (sk = SK_BREAK_BEFORE_PRIORITY) or (sk = SK_BREAK_AFTER_PRIORITY)
        {
            var n 0
            if Convert.convert_integer(val, &n, interp, loc)
            {
                if sk = SK_BREAK_BEFORE_PRIORITY
                    set r.break_before_priority: n
                else
                    set r.break_after_priority: n
            }
            else
                Convert.invalid_value(interp, ident, loc)
        }
    }

    ; the link/external-graphic/leader/box/score NIC keys (each class's
    ; hasNonInheritedC minus the display-NIC base, which rides the shared
    ; display_foc admission).
    function is_fo_nic_key(foc: int, sk: int) returns bool
    {
        if foc = FOC_LINK
            return sk = SK_DESTINATION
        if foc = FOC_EXTERNAL_GRAPHIC
        {
            if sk = SK_IS_DISPLAY
                return true
            if sk = SK_SCALE
                return true
            if sk = SK_MAX_WIDTH
                return true
            if sk = SK_MAX_HEIGHT
                return true
            if sk = SK_ENTITY_SYSTEM_ID
                return true
            if sk = SK_NOTATION_SYSTEM_ID
                return true
            if sk = SK_POSITION_POINT_X
                return true
            if sk = SK_POSITION_POINT_Y
                return true
            if sk = SK_ESCAPEMENT_DIRECTION
                return true
            if sk = SK_BREAK_BEFORE_PRIORITY
                return true
            if sk = SK_BREAK_AFTER_PRIORITY
                return true
            return false
        }
        if foc = FOC_BOX
        {
            if sk = SK_IS_DISPLAY
                return true
            if sk = SK_BREAK_BEFORE_PRIORITY
                return true
            if sk = SK_BREAK_AFTER_PRIORITY
                return true
            return false
        }
        if foc = FOC_LEADER
        {
            if sk = SK_LENGTH
                return true
            if sk = SK_BREAK_BEFORE_PRIORITY
                return true
            if sk = SK_BREAK_AFTER_PRIORITY
                return true
            return false
        }
        if foc = FOC_SCORE
            return sk = SK_TYPE
        if foc = FOC_PAGE_FLOAT
            return sk = SK_PLACEMENT
        if foc = FOC_INDEX_ENTRY
        {
            if sk = SK_COMPONENTS
                return true
            if sk = SK_PAGE_NUMBER_P
                return true
            if sk = SK_SORT_STRING
                return true
            if sk = SK_STARTS_PAGE_RANGE
                return true
            if sk = SK_ENDS_PAGE_RANGE
                return true
            return false
        }
        if foc = FOC_LINE_FIELD
        {
            if sk = SK_BREAK_BEFORE_PRIORITY
                return true
            if sk = SK_BREAK_AFTER_PRIORITY
                return true
            return false
        }
        ; CharacterFlowObj::hasNonInheritedC — the fifteen keyed names (the
        ; DECLARED char NICs come in through is_char_nic_ident below, which is
        ; the ident-aware wrapper every classification site uses).
        if foc = FOC_CHARACTER
        {
            if sk = SK_CHAR
                return true
            if sk = SK_GLYPH_ID
                return true
            if sk = SK_IS_SPACE
                return true
            if sk = SK_IS_RECORD_END
                return true
            if sk = SK_IS_INPUT_TAB
                return true
            if sk = SK_IS_INPUT_WHITESPACE
                return true
            if sk = SK_IS_PUNCT
                return true
            if sk = SK_IS_DROP_AFTER_LINE_BREAK
                return true
            if sk = SK_IS_DROP_UNLESS_BEFORE_LINE_BREAK
                return true
            if sk = SK_SCRIPT
                return true
            if sk = SK_MATH_CLASS
                return true
            if sk = SK_MATH_FONT_POSTURE
                return true
            if sk = SK_STRETCH_FACTOR
                return true
            if sk = SK_BREAK_BEFORE_PRIORITY
                return true
            if sk = SK_BREAK_AFTER_PRIORITY
                return true
            return false
        }
        if foc = FOC_ANCHOR
        {
            if sk = SK_IS_DISPLAY
                return true
            if sk = SK_BREAK_BEFORE_PRIORITY
                return true
            if sk = SK_BREAK_AFTER_PRIORITY
                return true
            return false
        }
        if foc = FOC_GLYPH_ANNOTATION
        {
            if sk = SK_BREAK_BEFORE_PRIORITY
                return true
            if sk = SK_BREAK_AFTER_PRIORITY
                return true
            return false
        }
        if foc = FOC_EMPHASIZING_MARK
        {
            if sk = SK_BREAK_BEFORE_PRIORITY
                return true
            if sk = SK_BREAK_AFTER_PRIORITY
                return true
            if sk = SK_MARK
                return true
            return false
        }
        ; the three MATH classes that carry characteristics at all
        ; (RadicalFlowObj / GridFlowObj / GridCellFlowObj::hasNonInheritedC).
        ; ★None of them admits the two break priorities — they are not
        ; InlineNIC-bearing classes.
        if foc = FOC_RADICAL
            return sk = SK_RADICAL
        if foc = FOC_GRID
        {
            if sk = SK_GRID_N_COLUMNS
                return true
            if sk = SK_GRID_N_ROWS
                return true
            return false
        }
        if foc = FOC_GRID_CELL
        {
            if sk = SK_COLUMN_NUMBER
                return true
            if sk = SK_ROW_NUMBER
                return true
            return false
        }
        ; the LAYOUT-COMPOSITE classes that carry characteristics beyond the
        ; display NIC (EmbeddedTextFlowObj / IncludedContainerAreaFlowObj;
        ; `side-by-side` and `aligned-column` are isDisplayNIC-only and
        ; `side-by-side-item` has no hasNonInheritedC at all — every keyword
        ; there is unknown).
        if foc = FOC_EMBEDDED_TEXT
            return sk = SK_DIRECTION
        if foc = FOC_INCLUDED_CONTAINER_AREA
        {
            if sk = SK_IS_DISPLAY
                return true
            if sk = SK_BREAK_BEFORE_PRIORITY
                return true
            if sk = SK_BREAK_AFTER_PRIORITY
                return true
            if sk = SK_SCALE
                return true
            if sk = SK_POSITION_POINT_X
                return true
            if sk = SK_POSITION_POINT_Y
                return true
            if sk = SK_HEIGHT
                return true
            if sk = SK_WIDTH
                return true
            if sk = SK_ESCAPEMENT_DIRECTION
                return true
            if sk = SK_CONTENTS_ROTATION
                return true
            return false
        }
        ; the ONLINE family: MultiModeFlowObj::hasNonInheritedC is exactly one
        ; key; MarginaliaFlowObj has no hasNonInheritedC at all.
        if foc = FOC_MULTI_MODE
            return sk = SK_MULTI_MODES
        false
    }

    ; the ident-aware admission: is_fo_nic_key plus the ONE case that is not a
    ; syntactic key at all — a name registered as a char NIC by
    ; `declare-char-characteristic+property` is a non-inherited characteristic
    ; of the `character` flow object (CharacterFlowObj::hasNonInheritedC's
    ; charNICDefined tail).
    function is_fo_nic_ident(foc: int, sk: int, ident: ref[Identifier]?) returns bool
    {
        if Convert.is_fo_nic_key(foc, sk)
            return true
        if foc <> FOC_CHARACTER
            return false
        if ident = null
            return false
        ident.char_nic
    }

    ; the SGML-transformation classes' hasNIC, by NAME (TransformFOTBuilder.cxx
    ; — an ExtensionFlowObj cannot extend the syntactic-key enum, so the
    ; reference compares strings: `name == "gi"`, `name == "attributes"`, …).
    ; Everything a class does NOT claim here is an ordinary inherited
    ; characteristic, exactly as for any other flow object; that is why these
    ; classes take the styled make path.
    function is_transform_nic_name(foc: int, name: StringC) returns bool
    {
        if (foc = FOC_ELEMENT) or (foc = FOC_EMPTY_ELEMENT)
        {
            if name.equals(StringC("gi"))
                return true
            return name.equals(StringC("attributes"))
        }
        if foc = FOC_ENTITY
            return name.equals(StringC("system-id"))
        if foc = FOC_ENTITY_REF
            return name.equals(StringC("name"))
        if foc = FOC_PROCESSING_INSTRUCTION
            return name.equals(StringC("data"))
        if foc = FOC_FORMATTING_INSTRUCTION
            return name.equals(StringC("data"))
        if foc = FOC_DOCUMENT_TYPE
        {
            if name.equals(StringC("name"))
                return true
            if name.equals(StringC("public-id"))
                return true
            return name.equals(StringC("system-id"))
        }
        ; the dazzle `directory` extension
        if foc = FOC_DIRECTORY
            return name.equals(StringC("path"))
        false
    }

    function is_transform_foc(foc: int) returns bool
    {
        if foc < FOC_ELEMENT
            return false
        foc <= FOC_DIRECTORY
    }

    function make_fo_nic(foc: int, host: ref[Page]) returns pointer[void]
    {
        if foc = FOC_LINK
            return LinkNICRec.make(host) as pointer[void]
        if foc = FOC_EXTERNAL_GRAPHIC
            return GraphicNICRec.make(host) as pointer[void]
        if foc = FOC_BOX
            return BoxNICRec.make(host) as pointer[void]
        if foc = FOC_LEADER
            return LeaderNICRec.make(host) as pointer[void]
        if foc = FOC_SCORE
            return ScoreNICRec.make(host) as pointer[void]
        if foc = FOC_PAGE_FLOAT
            return PageFloatNICRec.make(host) as pointer[void]
        if foc = FOC_INDEX_ENTRY
            return IndexEntryNICRec.make(host) as pointer[void]
        if foc = FOC_LINE_FIELD
            return LineFieldNICRec.make(host) as pointer[void]
        if foc = FOC_CHARACTER
            return CharacterNICRec.make(host) as pointer[void]
        if foc = FOC_ANCHOR
            return AnchorNICRec.make(host) as pointer[void]
        if foc = FOC_GLYPH_ANNOTATION
            return GlyphAnnotationNICRec.make(host) as pointer[void]
        if foc = FOC_EMPHASIZING_MARK
            return EmphasizingMarkNICRec.make(host) as pointer[void]
        if foc = FOC_RADICAL
            return RadicalNICRec.make(host) as pointer[void]
        if foc = FOC_GRID
            return GridNICRec.make(host) as pointer[void]
        if foc = FOC_GRID_CELL
            return GridCellNICRec.make(host) as pointer[void]
        if foc = FOC_EMBEDDED_TEXT
            return EmbeddedTextNICRec.make(host) as pointer[void]
        if foc = FOC_INCLUDED_CONTAINER_AREA
            return IncludedContainerAreaNICRec.make(host) as pointer[void]
        if foc = FOC_MULTI_MODE
            return MultiModeNICRec.make(host) as pointer[void]
        null
    }

    function copy_fo_nic(foc: int, p: pointer[void], host: ref[Page]) returns pointer[void]
    {
        if p = null
            return Convert.make_fo_nic(foc, host)
        if foc = FOC_LINK
        {
            let l p as ref[LinkNICRec]
            return l.copy(host) as pointer[void]
        }
        if foc = FOC_EXTERNAL_GRAPHIC
        {
            let g p as ref[GraphicNICRec]
            return g.copy(host) as pointer[void]
        }
        if foc = FOC_BOX
        {
            let b p as ref[BoxNICRec]
            return b.copy(host) as pointer[void]
        }
        if foc = FOC_LEADER
        {
            let d p as ref[LeaderNICRec]
            return d.copy(host) as pointer[void]
        }
        if foc = FOC_SCORE
        {
            let s p as ref[ScoreNICRec]
            return s.copy(host) as pointer[void]
        }
        if foc = FOC_PAGE_FLOAT
        {
            let f p as ref[PageFloatNICRec]
            return f.copy(host) as pointer[void]
        }
        if foc = FOC_INDEX_ENTRY
        {
            let ie p as ref[IndexEntryNICRec]
            return ie.copy(host) as pointer[void]
        }
        if foc = FOC_LINE_FIELD
        {
            let lf p as ref[LineFieldNICRec]
            return lf.copy(host) as pointer[void]
        }
        if foc = FOC_CHARACTER
        {
            let cn p as ref[CharacterNICRec]
            return cn.copy(host) as pointer[void]
        }
        if foc = FOC_ANCHOR
        {
            let an p as ref[AnchorNICRec]
            return an.copy(host) as pointer[void]
        }
        if foc = FOC_GLYPH_ANNOTATION
        {
            let ga p as ref[GlyphAnnotationNICRec]
            return ga.copy(host) as pointer[void]
        }
        if foc = FOC_EMPHASIZING_MARK
        {
            let em p as ref[EmphasizingMarkNICRec]
            return em.copy(host) as pointer[void]
        }
        if foc = FOC_RADICAL
        {
            let ra p as ref[RadicalNICRec]
            return ra.copy(host) as pointer[void]
        }
        if foc = FOC_GRID
        {
            let gr p as ref[GridNICRec]
            return gr.copy(host) as pointer[void]
        }
        if foc = FOC_GRID_CELL
        {
            let gc p as ref[GridCellNICRec]
            return gc.copy(host) as pointer[void]
        }
        if foc = FOC_EMBEDDED_TEXT
        {
            let et p as ref[EmbeddedTextNICRec]
            return et.copy(host) as pointer[void]
        }
        if foc = FOC_INCLUDED_CONTAINER_AREA
        {
            let ic p as ref[IncludedContainerAreaNICRec]
            return ic.copy(host) as pointer[void]
        }
        if foc = FOC_MULTI_MODE
        {
            let mm p as ref[MultiModeNICRec]
            return mm.copy(host) as pointer[void]
        }
        null
    }

    ; Link/ExternalGraphic/Box/Leader/Score FlowObj::setNonInheritedC.
    procedure apply_fo_nic(foc: int, nicp: pointer[pointer[void]], sk: int, val: ref[ELObj], ident: ref[Identifier]?, loc: Location, interp: ref[Interpreter], host: ref[Page])
    {
        if *nicp = null
            set *nicp: Convert.make_fo_nic(foc, host)
        if foc = FOC_LINK
        {
            ; LinkFlowObj: an address or #f (#f = Address::none; anything
            ; else is invalid).
            let r *nicp as ref[LinkNICRec]
            if val.is_address_p()
            {
                let a val.address_rec()
                set r.addr_type: a.addr_type
                set r.node: a.node
                ; the params outlive the value object (the NIC is replayed
                ; from a SaveFOTBuilder long after the eval region died), so
                ; pin them on the NIC's own page.
                set r.p0: InheritedC.pin_string(host, a.p0)
                set r.p1: InheritedC.pin_string(host, a.p1)
                set r.p2: InheritedC.pin_string(host, a.p2)
            }
            else
            {
                ; ★LinkFlowObj::setNonInheritedC assigns addressObj_ OUTSIDE
                ; its if/else (FlowObj.cxx:909): both #f and an invalid value
                ; end at Address::none — an invalid `destination:` therefore
                ; also DISCARDS a valid one set earlier in the same make.
                if val.is_false() = false
                    Convert.invalid_value(interp, ident, loc)
                set r.addr_type: ADDR_NONE
                set r.node: null
                set r.p0: StringC()
                set r.p1: StringC()
                set r.p2: StringC()
            }
            return
        }
        if foc = FOC_EXTERNAL_GRAPHIC
        {
            let r *nicp as ref[GraphicNICRec]
            if sk = SK_IS_DISPLAY
            {
                var b false
                if Convert.convert_boolean(val, &b, interp, loc)
                    set r.is_display: b
                else
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            if sk = SK_SCALE
            {
                ; a number (uniform x/y), the symbols max/max-uniform, or a
                ; two-number list.
                if val.is_number()
                {
                    var s FotSym()
                    set r.scale_type: s
                    set r.scale_x: val.real_value()
                    set r.scale_y: val.real_value()
                    return
                }
                if val.is_symbol_p()
                {
                    let allowed host.allocate(16, 8) as pointer[int]
                    set *allowed: SYM_MAX_SCALE
                    set *(allowed + 1): SYM_MAX_UNIFORM
                    var s FotSym()
                    if Convert.convert_enum_set(val, Slice[int](2, allowed), &s, interp, loc)
                        set r.scale_type: s
                    else
                        Convert.invalid_value(interp, ident, loc)
                    return
                }
                var ok false
                if val.is_pair()
                {
                    let x val.get_car()
                    let rest val.get_cdr()
                    if x.is_number() and rest.is_pair()
                    {
                        let y rest.get_car()
                        let tail rest.get_cdr()
                        if y.is_number() and tail.is_nil()
                        {
                            var s FotSym()
                            set r.scale_type: s
                            set r.scale_x: x.real_value()
                            set r.scale_y: y.real_value()
                            set ok: true
                        }
                    }
                }
                if ok = false
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            if sk = SK_MAX_WIDTH
            {
                var ls LengthSpec()
                if Convert.convert_length_spec_c(val, &ls, interp, loc)
                {
                    set r.max_width: ls
                    set r.has_max_width: true
                }
                else
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            if sk = SK_MAX_HEIGHT
            {
                var ls LengthSpec()
                if Convert.convert_length_spec_c(val, &ls, interp, loc)
                {
                    set r.max_height: ls
                    set r.has_max_height: true
                }
                else
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            if sk = SK_ENTITY_SYSTEM_ID
            {
                var s StringC()
                if Convert.convert_string(host, val, &s)
                    set r.entity_system_id: s
                else
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            if sk = SK_NOTATION_SYSTEM_ID
            {
                var s StringC()
                if Convert.convert_string(host, val, &s)
                    set r.notation_system_id: s
                else
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            if sk = SK_POSITION_POINT_X
            {
                var ls LengthSpec()
                if Convert.convert_length_spec_c(val, &ls, interp, loc)
                    set r.position_point_x: ls
                else
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            if sk = SK_POSITION_POINT_Y
            {
                var ls LengthSpec()
                if Convert.convert_length_spec_c(val, &ls, interp, loc)
                    set r.position_point_y: ls
                else
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            if sk = SK_ESCAPEMENT_DIRECTION
            {
                let allowed host.allocate(32, 8) as pointer[int]
                set *allowed: SYM_TOP_TO_BOTTOM
                set *(allowed + 1): SYM_LEFT_TO_RIGHT
                set *(allowed + 2): SYM_BOTTOM_TO_TOP
                set *(allowed + 3): SYM_RIGHT_TO_LEFT
                var s FotSym()
                if Convert.convert_enum_set(val, Slice[int](4, allowed), &s, interp, loc)
                    set r.escapement_direction: s
                else
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            if (sk = SK_BREAK_BEFORE_PRIORITY) or (sk = SK_BREAK_AFTER_PRIORITY)
            {
                var n 0
                if Convert.convert_integer(val, &n, interp, loc)
                {
                    if sk = SK_BREAK_BEFORE_PRIORITY
                        set r.break_before_priority: n
                    else
                        set r.break_after_priority: n
                }
                else
                    Convert.invalid_value(interp, ident, loc)
            }
            return
        }
        if foc = FOC_BOX
        {
            let r *nicp as ref[BoxNICRec]
            if sk = SK_IS_DISPLAY
            {
                var b false
                if Convert.convert_boolean(val, &b, interp, loc)
                    set r.is_display: b
                else
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            if (sk = SK_BREAK_BEFORE_PRIORITY) or (sk = SK_BREAK_AFTER_PRIORITY)
            {
                var n 0
                if Convert.convert_integer(val, &n, interp, loc)
                {
                    if sk = SK_BREAK_BEFORE_PRIORITY
                        set r.break_before_priority: n
                    else
                        set r.break_after_priority: n
                }
                else
                    Convert.invalid_value(interp, ident, loc)
            }
            return
        }
        if foc = FOC_LEADER
        {
            let r *nicp as ref[LeaderNICRec]
            if sk = SK_LENGTH
            {
                var ls LengthSpec()
                if Convert.convert_length_spec_c(val, &ls, interp, loc)
                {
                    set r.length: ls
                    set r.has_length: true
                }
                else
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            if (sk = SK_BREAK_BEFORE_PRIORITY) or (sk = SK_BREAK_AFTER_PRIORITY)
            {
                var n 0
                if Convert.convert_integer(val, &n, interp, loc)
                {
                    if sk = SK_BREAK_BEFORE_PRIORITY
                        set r.break_before_priority: n
                    else
                        set r.break_after_priority: n
                }
                else
                    Convert.invalid_value(interp, ident, loc)
            }
            return
        }
        if foc = FOC_SCORE
        {
            ; ScoreFlowObj::setNonInheritedC — char, then dim-1 quantity,
            ; then the before/through/after symbols.
            let r *nicp as ref[ScoreNICRec]
            let c val.char_value()
            if c >= 0
            {
                set r.kind: SCORE_CHAR
                set r.ch: c as u32
                return
            }
            let qv val.quantity_value()
            if qv.get_dim() = 1
            {
                if qv.get_qtype() = QT_LONG
                {
                    var ls LengthSpec()
                    set ls.length: qv.get_lval()
                    set r.kind: SCORE_LENGTH
                    set r.length: ls
                    return
                }
                if qv.get_qtype() = QT_DOUBLE
                {
                    var ls LengthSpec()
                    set ls.length: qv.get_dval() as int
                    set r.kind: SCORE_LENGTH
                    set r.length: ls
                    return
                }
            }
            let allowed host.allocate(24, 8) as pointer[int]
            set *allowed: SYM_BEFORE
            set *(allowed + 1): SYM_THROUGH
            set *(allowed + 2): SYM_AFTER
            var s FotSym()
            if Convert.convert_enum_set(val, Slice[int](3, allowed), &s, interp, loc)
            {
                set r.kind: SCORE_SYMBOL
                set r.sym: s
            }
            else
                Convert.invalid_value(interp, ident, loc)
            return
        }
        if foc = FOC_LINE_FIELD
        {
            ; LineFieldFlowObj::setNonInheritedC — convertIntegerC.
            let r *nicp as ref[LineFieldNICRec]
            var n 0
            if Convert.convert_integer(val, &n, interp, loc)
            {
                if sk = SK_BREAK_BEFORE_PRIORITY
                    set r.break_before_priority: n
                else
                    set r.break_after_priority: n
            }
            else
                Convert.invalid_value(interp, ident, loc)
            return
        }
        if foc = FOC_PAGE_FLOAT
        {
            ; PageFloatFlowObj::setNIC — value.convertString(placement); the
            ; ELObjExtensionFlowObjValue conversion is silent on failure
            ; (leaves the NIC untouched, no diagnostic).
            let r *nicp as ref[PageFloatNICRec]
            var str StringC()
            if Convert.convert_string(host, val, &str)
                set r.placement: str
            return
        }
        if foc = FOC_INDEX_ENTRY
        {
            ; MifFOTBuilder::IndexEntryFlowObj::setNIC over
            ; ELObjExtensionFlowObjValue: convertStringList / convertBoolean /
            ; (convertBoolean then convertString) — each reports
            ; invalidCharacteristicValue itself on failure.
            let r *nicp as ref[IndexEntryNICRec]
            if sk = SK_COMPONENTS
            {
                if Convert.convert_string_list(host, val, r.components) = false
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            if sk = SK_SORT_STRING
            {
                var has false
                if Convert.convert_boolean(val, &has, interp, loc) = false
                {
                    Convert.invalid_value(interp, ident, loc)
                    return
                }
                if has
                {
                    var ss StringC()
                    if Convert.convert_string(host, val, &ss)
                        set r.sort_string: ss
                    else
                        Convert.invalid_value(interp, ident, loc)
                }
                return
            }
            var bv false
            if Convert.convert_boolean(val, &bv, interp, loc) = false
            {
                Convert.invalid_value(interp, ident, loc)
                return
            }
            if sk = SK_PAGE_NUMBER_P
                set r.page_number: bv
            else if sk = SK_STARTS_PAGE_RANGE
                set r.starts_page_range: bv
            else if sk = SK_ENDS_PAGE_RANGE
                set r.ends_page_range: bv
            return
        }
        if foc = FOC_CHARACTER
        {
            Convert.set_character_nic(*nicp as ref[CharacterNICRec], sk, val, ident, loc, interp, host)
            return
        }
        if foc = FOC_ANCHOR
        {
            let r *nicp as ref[AnchorNICRec]
            if sk = SK_IS_DISPLAY
            {
                var b false
                if Convert.convert_boolean(val, &b, interp, loc)
                    set r.is_display: b
                else
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            var n 0
            if Convert.convert_integer(val, &n, interp, loc) = false
            {
                Convert.invalid_value(interp, ident, loc)
                return
            }
            if sk = SK_BREAK_BEFORE_PRIORITY
                set r.break_before_priority: n
            else if sk = SK_BREAK_AFTER_PRIORITY
                set r.break_after_priority: n
            return
        }
        if foc = FOC_GLYPH_ANNOTATION
        {
            let r *nicp as ref[GlyphAnnotationNICRec]
            var n 0
            if Convert.convert_integer(val, &n, interp, loc) = false
            {
                Convert.invalid_value(interp, ident, loc)
                return
            }
            if sk = SK_BREAK_BEFORE_PRIORITY
                set r.break_before_priority: n
            else if sk = SK_BREAK_AFTER_PRIORITY
                set r.break_after_priority: n
            return
        }
        if foc = FOC_EMPHASIZING_MARK
        {
            let r *nicp as ref[EmphasizingMarkNICRec]
            if sk = SK_MARK
            {
                ; EmphasizingMarkFlowObj::setNonInheritedC — any sosofo (no
                ; isCharacter demand, unlike radical:).
                if val.is_sosofo_p()
                    set r.mark: val
                else
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            var n 0
            if Convert.convert_integer(val, &n, interp, loc) = false
            {
                Convert.invalid_value(interp, ident, loc)
                return
            }
            if sk = SK_BREAK_BEFORE_PRIORITY
                set r.break_before_priority: n
            else if sk = SK_BREAK_AFTER_PRIORITY
                set r.break_after_priority: n
            return
        }
        if foc = FOC_RADICAL
        {
            ; RadicalFlowObj::setNonInheritedC — the value must be a sosofo
            ; that answers isCharacter, i.e. a `character` flow object.
            ; ★The reference STORES whatever asSosofo() gave (possibly null)
            ; and only then messages, so an invalid radical: leaves the slot
            ; overwritten — reproduced.
            let r *nicp as ref[RadicalNICRec]
            if val.is_sosofo_p()
                set r.radical: val
            else
                set r.radical: null
            if Convert.is_character_sosofo(r.radical) = false
                Convert.invalid_value(interp, ident, loc)
            return
        }
        if foc = FOC_GRID
        {
            ; GridFlowObj::setNonInheritedC — convertIntegerC, then a
            ; POSITIVITY gate that messages with the same diagnostic.
            let r *nicp as ref[GridNICRec]
            var n 0
            if Convert.convert_integer(val, &n, interp, loc) = false
            {
                Convert.invalid_value(interp, ident, loc)
                return
            }
            if n <= 0
            {
                Convert.invalid_value(interp, ident, loc)
                return
            }
            if sk = SK_GRID_N_COLUMNS
                set r.n_columns: n
            else if sk = SK_GRID_N_ROWS
                set r.n_rows: n
            return
        }
        if foc = FOC_GRID_CELL
        {
            let r *nicp as ref[GridCellNICRec]
            var n 0
            if Convert.convert_integer(val, &n, interp, loc) = false
            {
                Convert.invalid_value(interp, ident, loc)
                return
            }
            if n <= 0
            {
                Convert.invalid_value(interp, ident, loc)
                return
            }
            if sk = SK_COLUMN_NUMBER
                set r.column_number: n
            else if sk = SK_ROW_NUMBER
                set r.row_number: n
            return
        }
        if foc = FOC_EMBEDDED_TEXT
        {
            ; EmbeddedTextFlowObj::setNonInheritedC — one enum, and its allowed
            ; set deliberately omits symbolFalse (the reference's own comment:
            ; one of the two directions MUST be given), so `direction: #f` is
            ; an invalid value.
            let r *nicp as ref[EmbeddedTextNICRec]
            let allowed host.allocate(16, 8) as pointer[int]
            set *allowed: SYM_RIGHT_TO_LEFT
            set *(allowed + 1): SYM_LEFT_TO_RIGHT
            var s FotSym()
            if Convert.convert_enum_set(val, Slice[int](2, allowed), &s, interp, loc)
                set r.direction: s
            else
                Convert.invalid_value(interp, ident, loc)
            return
        }
        if foc = FOC_INCLUDED_CONTAINER_AREA
        {
            ; IncludedContainerAreaFlowObj::setNonInheritedC — the ten keys the
            ; class adds on top of the display NIC.
            let r *nicp as ref[IncludedContainerAreaNICRec]
            if sk = SK_IS_DISPLAY
            {
                var b false
                if Convert.convert_boolean(val, &b, interp, loc)
                    set r.is_display: b
                else
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            if (sk = SK_BREAK_BEFORE_PRIORITY) or (sk = SK_BREAK_AFTER_PRIORITY)
            {
                var n 0
                if Convert.convert_integer(val, &n, interp, loc)
                {
                    if sk = SK_BREAK_BEFORE_PRIORITY
                        set r.break_before_priority: n
                    else
                        set r.break_after_priority: n
                }
                else
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            if sk = SK_CONTENTS_ROTATION
            {
                var n 0
                if Convert.convert_integer(val, &n, interp, loc)
                    set r.contents_rotation: n
                else
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            if sk = SK_SCALE
            {
                ; a number (uniform), the symbols max/max-uniform, or a
                ; two-number list — the same three shapes external-graphic
                ; takes, but probed in the reference's own order (realValue
                ; first, then asSymbol, then the pair).
                if val.is_number()
                {
                    var s FotSym()
                    set r.scale_type: s
                    set r.scale_x: val.real_value()
                    set r.scale_y: val.real_value()
                    return
                }
                if val.is_symbol_p()
                {
                    let allowed host.allocate(16, 8) as pointer[int]
                    set *allowed: SYM_MAX_SCALE
                    set *(allowed + 1): SYM_MAX_UNIFORM
                    var s FotSym()
                    if Convert.convert_enum_set(val, Slice[int](2, allowed), &s, interp, loc)
                        set r.scale_type: s
                    else
                        Convert.invalid_value(interp, ident, loc)
                    return
                }
                var ok false
                if val.is_pair()
                {
                    let x val.get_car()
                    let rest val.get_cdr()
                    if x.is_number() and rest.is_pair()
                    {
                        let y rest.get_car()
                        let tail rest.get_cdr()
                        if y.is_number() and tail.is_nil()
                        {
                            var s FotSym()
                            set r.scale_type: s
                            set r.scale_x: x.real_value()
                            set r.scale_y: y.real_value()
                            set ok: true
                        }
                    }
                }
                if ok = false
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            if sk = SK_POSITION_POINT_X
            {
                var ls LengthSpec()
                if Convert.convert_length_spec_c(val, &ls, interp, loc)
                    set r.position_point_x: ls
                else
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            if sk = SK_POSITION_POINT_Y
            {
                var ls LengthSpec()
                if Convert.convert_length_spec_c(val, &ls, interp, loc)
                    set r.position_point_y: ls
                else
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            if (sk = SK_WIDTH) or (sk = SK_HEIGHT)
            {
                ; ★#f is the MINIMUM form (not an invalid value); anything else
                ; must convert, and a failed conversion leaves the type alone
                ; after the conversion's own diagnostic.
                if val.is_false()
                {
                    if sk = SK_WIDTH
                        set r.width_type: ICA_WIDTH_MINIMUM
                    else
                        set r.height_type: ICA_HEIGHT_MINIMUM
                    return
                }
                var ls LengthSpec()
                if Convert.convert_length_spec_c(val, &ls, interp, loc)
                {
                    if sk = SK_WIDTH
                    {
                        set r.width: ls
                        set r.width_type: ICA_WIDTH_EXPLICIT
                    }
                    else
                    {
                        set r.height: ls
                        set r.height_type: ICA_HEIGHT_EXPLICIT
                    }
                }
                else
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            if sk = SK_ESCAPEMENT_DIRECTION
            {
                let allowed host.allocate(32, 8) as pointer[int]
                set *allowed: SYM_TOP_TO_BOTTOM
                set *(allowed + 1): SYM_BOTTOM_TO_TOP
                set *(allowed + 2): SYM_RIGHT_TO_LEFT
                set *(allowed + 3): SYM_LEFT_TO_RIGHT
                var s FotSym()
                if Convert.convert_enum_set(val, Slice[int](4, allowed), &s, interp, loc)
                    set r.escapement_direction: s
                else
                    Convert.invalid_value(interp, ident, loc)
                return
            }
            return
        }
        if foc = FOC_MULTI_MODE
        {
            ; MultiModeFlowObj::setNonInheritedC — a proper list whose members
            ; are handled one by one; the FIRST member that is not one of the
            ; four accepted shapes messages and STOPS (the prefix already
            ; collected stays).
            let r *nicp as ref[MultiModeNICRec]
            var cur val
            while cur.is_nil() = false
            {
                if cur.is_pair() = false
                {
                    Convert.invalid_value(interp, ident, loc)
                    return
                }
                if Convert.multi_modes_member(r, (cur.get_car()) as ref[ELObj], host) = false
                {
                    Convert.invalid_value(interp, ident, loc)
                    return
                }
                set cur: cur.get_cdr() as ref[ELObj]
            }
            return
        }
    }

    ; MultiModeFlowObj::handleMultiModesMember — the four accepted shapes of a
    ; `multi-modes:` member: `#f` (the principal mode), a symbol (a named
    ; mode), `(#f "desc")` and `(sym "desc")`.
    function multi_modes_member(r: ref[MultiModeNICRec], obj: ref[ELObj], host: ref[Page]) returns bool
    {
        if obj.is_false()
        {
            set r.has_principal_mode: true
            return true
        }
        if obj.is_symbol_p()
        {
            let m MultiModeRec.make(host)
            let nm obj.symbol_name()
            set m.name: StringC^host(nm.data_ptr(), nm.get_size())
            r.named.add(m)
            return true
        }
        if obj.is_pair() = false
            return false
        let spec obj.get_car()
        let rest obj.get_cdr()
        if rest.is_pair() = false
            return false
        let tail rest.get_cdr()
        if tail.is_nil() = false
            return false
        var d StringC()
        if Convert.convert_string(host, (rest.get_car()) as ref[ELObj], &d) = false
            return false
        if spec.is_false()
        {
            set r.has_principal_mode: true
            set r.principal_has_desc: true
            set r.principal_desc: d
            return true
        }
        if spec.is_symbol_p() = false
            return false
        let m MultiModeRec.make(host)
        let nm spec.symbol_name()
        set m.name: StringC^host(nm.data_ptr(), nm.get_size())
        set m.desc: d
        set m.has_desc: true
        r.named.add(m)
        true
    }

    ; SosofoObj::isCharacter (ProcessContext.cxx:535) — only a `character`
    ; flow-object sosofo answers true; it is what `radical:` demands.
    function is_character_sosofo(val: ref[ELObj]?) returns bool
    {
        if val = null
            return false
        if val.is_sosofo_p() = false
            return false
        if val.sosofo_kind() <> SOSO_FLOWOBJ
            return false
        let fo val.sosofo_flowobj()
        if fo = null
            return false
        fo.get_foc() = FOC_CHARACTER
    }

    ; convertRealC.
    function convert_real(val_in: ref[ELObj], out: ref[double], interp: ref[Interpreter], loc: Location) returns bool
    {
        let val interp.convert_from_string(val_in, CONVERT_ALLOW_NUMBER, loc)
        if val.is_number() = false
            return false
        set out: val.real_value()
        true
    }

    ; convertCharC: a char object, or a string of exactly one character.
    function convert_char(host: ref[Page], val: ref[ELObj], out: ref[u32]) returns bool
    {
        if val.is_char_p()
        {
            set out: val.char_value() as u32
            return true
        }
        if val.has_string_data()
        {
            let s val.string_data(host)
            if s.get_size() = 1
            {
                set out: s.get(0)
                return true
            }
        }
        false
    }

    ; the math-class enum set (CharacterFlowObj::setNonInheritedC).
    function convert_math_class(val: ref[ELObj], out: ref[FotSym], host: ref[Page], interp: ref[Interpreter], loc: Location) returns bool
    {
        let allowed host.allocate(9 * sizeof int, alignof int) as pointer[int]
        set *allowed: SYM_ORDINARY
        set *(allowed + 1): SYM_OPERATOR
        set *(allowed + 2): SYM_BINARY
        set *(allowed + 3): SYM_RELATION
        set *(allowed + 4): SYM_OPENING
        set *(allowed + 5): SYM_CLOSING
        set *(allowed + 6): SYM_PUNCTUATION
        set *(allowed + 7): SYM_INNER
        set *(allowed + 8): SYM_SPACE
        Convert.convert_enum_set(val, Slice[int](9, allowed), out, interp, loc)
    }

    ; the math-font-posture enum set — #f is IN the set here (symbolFalse is
    ; the first allowed value), so `math-font-posture: #f` is valid.
    function convert_math_font_posture(val: ref[ELObj], out: ref[FotSym], host: ref[Page], interp: ref[Interpreter], loc: Location) returns bool
    {
        let allowed host.allocate(7 * sizeof int, alignof int) as pointer[int]
        set *allowed: SYM_FALSE
        set *(allowed + 1): SYM_NOT_APPLICABLE
        set *(allowed + 2): SYM_UPRIGHT
        set *(allowed + 3): SYM_OBLIQUE
        set *(allowed + 4): SYM_BACK_SLANTED_OBLIQUE
        set *(allowed + 5): SYM_ITALIC
        set *(allowed + 6): SYM_BACK_SLANTED_ITALIC
        Convert.convert_enum_set(val, Slice[int](7, allowed), out, interp, loc)
    }

    ; CharacterFlowObj::setNonInheritedC. Every branch marks its `specified`
    ; bit ONLY on a successful conversion (the reference's `if (convert…)`
    ; shape) — an invalid value leaves the field unspecified and the fot dump
    ; silent. `stretch-factor` is the one field with no bit: it renders
    ; whenever it differs from 1.0.
    ; ★A name that is a DECLARED char NIC (not a syntactic key) is accepted by
    ; hasNonInheritedC and then does NOTHING here — the reference's
    ; charNICDefined arm returns before the CANNOT_HAPPEN, so the value is
    ; swallowed without a diagnostic. Measured against the reference binary.
    procedure set_character_nic(r: ref[CharacterNICRec], sk: int, val: ref[ELObj], ident: ref[Identifier]?, loc: Location, interp: ref[Interpreter], host: ref[Page])
    {
        if sk = SK_CHAR
        {
            if Convert.set_implicit_char(r, val, ident, loc, interp, host)
            {
                r.set_specified(CNIC_CHAR)
                ; the reference clears the two input-* flags after an
                ; explicit char: unless they were specified themselves.
                if r.is_specified(CNIC_IS_INPUT_TAB) = false
                    set r.is_input_tab: false
                if r.is_specified(CNIC_IS_INPUT_WHITESPACE) = false
                    set r.is_input_whitespace: false
            }
            return
        }
        if sk = SK_GLYPH_ID
        {
            if val.is_false()
            {
                set r.glyph_id: null
                r.set_specified(CNIC_GLYPH_ID)
                return
            }
            if val.is_glyph_id_p() = false
            {
                Convert.invalid_value(interp, ident, loc)
                return
            }
            set r.glyph_id: val
            r.set_specified(CNIC_GLYPH_ID)
            return
        }
        if sk = SK_SCRIPT
        {
            if val.is_false()
            {
                set r.script: StringC()
                r.set_specified(CNIC_SCRIPT)
                return
            }
            var s StringC()
            if Convert.convert_string(host, val, &s) = false
            {
                Convert.invalid_value(interp, ident, loc)
                return
            }
            set r.script: s
            r.set_specified(CNIC_SCRIPT)
            return
        }
        if sk = SK_MATH_CLASS
        {
            var m FotSym()
            if Convert.convert_math_class(val, &m, host, interp, loc)
            {
                set r.math_class: m
                r.set_specified(CNIC_MATH_CLASS)
            }
            else
                Convert.invalid_value(interp, ident, loc)
            return
        }
        if sk = SK_MATH_FONT_POSTURE
        {
            var p FotSym()
            if Convert.convert_math_font_posture(val, &p, host, interp, loc)
            {
                set r.math_font_posture: p
                r.set_specified(CNIC_MATH_FONT_POSTURE)
            }
            else
                Convert.invalid_value(interp, ident, loc)
            return
        }
        if sk = SK_STRETCH_FACTOR
        {
            var d 0.0
            if Convert.convert_real(val, &d, interp, loc)
                set r.stretch_factor: d
            else
                Convert.invalid_value(interp, ident, loc)
            return
        }
        if (sk = SK_BREAK_BEFORE_PRIORITY) or (sk = SK_BREAK_AFTER_PRIORITY)
        {
            var n 0
            if Convert.convert_integer(val, &n, interp, loc) = false
            {
                Convert.invalid_value(interp, ident, loc)
                return
            }
            if sk = SK_BREAK_BEFORE_PRIORITY
            {
                set r.break_before_priority: n
                r.set_specified(CNIC_BREAK_BEFORE_PRIORITY)
            }
            else
            {
                set r.break_after_priority: n
                r.set_specified(CNIC_BREAK_AFTER_PRIORITY)
            }
            return
        }
        ; the seven boolean flags
        var bit 0 - 1
        if sk = SK_IS_SPACE
            set bit: CNIC_IS_SPACE
        if sk = SK_IS_RECORD_END
            set bit: CNIC_IS_RECORD_END
        if sk = SK_IS_INPUT_TAB
            set bit: CNIC_IS_INPUT_TAB
        if sk = SK_IS_INPUT_WHITESPACE
            set bit: CNIC_IS_INPUT_WHITESPACE
        if sk = SK_IS_PUNCT
            set bit: CNIC_IS_PUNCT
        if sk = SK_IS_DROP_AFTER_LINE_BREAK
            set bit: CNIC_IS_DROP_AFTER_LINE_BREAK
        if sk = SK_IS_DROP_UNLESS_BEFORE_LINE_BREAK
            set bit: CNIC_IS_DROP_UNLESS_BEFORE_LINE_BREAK
        if bit < 0
            ; a declared char NIC (see the note above) — accepted, dropped.
            return
        var b false
        if Convert.convert_boolean(val, &b, interp, loc) = false
        {
            Convert.invalid_value(interp, ident, loc)
            return
        }
        if bit = CNIC_IS_SPACE
            set r.is_space: b
        if bit = CNIC_IS_RECORD_END
            set r.is_record_end: b
        if bit = CNIC_IS_INPUT_TAB
            set r.is_input_tab: b
        if bit = CNIC_IS_INPUT_WHITESPACE
            set r.is_input_whitespace: b
        if bit = CNIC_IS_PUNCT
            set r.is_punct: b
        if bit = CNIC_IS_DROP_AFTER_LINE_BREAK
            set r.is_drop_after_line_break: b
        if bit = CNIC_IS_DROP_UNLESS_BEFORE_LINE_BREAK
            set r.is_drop_unless_before_line_break: b
        r.set_specified(bit)
    }

    ; CharacterFlowObj::setImplicitChar — the heart of the class: once `char`
    ; is known, every characteristic still UNSPECIFIED is filled from that
    ; character's PROPERTIES (the thirteen built-ins of installCharProperties
    ; plus whatever a stylesheet declared). Answers false when the char does
    ; not convert or was already specified — the reference then leaves the NIC
    ; alone (and, on the `char:` branch, skips the specified bit as well).
    function set_implicit_char(r: ref[CharacterNICRec], val: ref[ELObj], ident: ref[Identifier]?, loc: Location, interp: ref[Interpreter], host: ref[Page]) returns bool
    {
        if r.is_specified(CNIC_CHAR)
            return false
        var ch: u32 0
        if Convert.convert_char(host, val, &ch) = false
        {
            Convert.invalid_value(interp, ident, loc)
            return false
        }
        set r.ch: ch
        set r.valid: true
        if r.is_specified(CNIC_IS_SPACE) = false
            Convert.char_prop_bool("space?", ch, loc, interp, ident, &r.is_space)
        if r.is_specified(CNIC_IS_RECORD_END) = false
            Convert.char_prop_bool("record-end?", ch, loc, interp, ident, &r.is_record_end)
        if r.is_specified(CNIC_IS_INPUT_TAB) = false
            Convert.char_prop_bool("input-tab?", ch, loc, interp, ident, &r.is_input_tab)
        if r.is_specified(CNIC_IS_INPUT_WHITESPACE) = false
            Convert.char_prop_bool("input-whitespace?", ch, loc, interp, ident, &r.is_input_whitespace)
        if r.is_specified(CNIC_IS_PUNCT) = false
            Convert.char_prop_bool("punct?", ch, loc, interp, ident, &r.is_punct)
        if r.is_specified(CNIC_IS_DROP_AFTER_LINE_BREAK) = false
            Convert.char_prop_bool("drop-after-line-break?", ch, loc, interp, ident, &r.is_drop_after_line_break)
        if r.is_specified(CNIC_IS_DROP_UNLESS_BEFORE_LINE_BREAK) = false
            Convert.char_prop_bool("drop-unless-before-line-break?", ch, loc, interp, ident, &r.is_drop_unless_before_line_break)
        if r.is_specified(CNIC_BREAK_BEFORE_PRIORITY) = false
            Convert.char_prop_int("break-before-priority", ch, loc, interp, ident, &r.break_before_priority)
        if r.is_specified(CNIC_BREAK_AFTER_PRIORITY) = false
            Convert.char_prop_int("break-after-priority", ch, loc, interp, ident, &r.break_after_priority)
        if r.is_specified(CNIC_SCRIPT) = false
        {
            let prop interp.char_property(StringC("script"), ch, loc, null)
            if prop <> null
            {
                if prop.is_false()
                    set r.script: StringC()
                else
                {
                    var s StringC()
                    if Convert.convert_string(host, prop, &s)
                        set r.script: s
                    else
                        Convert.invalid_value(interp, ident, loc)
                }
            }
        }
        if r.is_specified(CNIC_GLYPH_ID) = false
        {
            let prop interp.char_property(StringC("glyph-id"), ch, loc, null)
            if prop <> null
            {
                if prop.is_false()
                    set r.glyph_id: null
                else if prop.is_glyph_id_p()
                    set r.glyph_id: prop
            }
        }
        if r.is_specified(CNIC_MATH_FONT_POSTURE) = false
        {
            let prop interp.char_property(StringC("math-font-posture"), ch, loc, null)
            if prop <> null
            {
                var p FotSym()
                if Convert.convert_math_font_posture(prop, &p, host, interp, loc)
                    set r.math_font_posture: p
                else
                    Convert.invalid_value(interp, ident, loc)
            }
        }
        if r.is_specified(CNIC_MATH_CLASS) = false
        {
            let prop interp.char_property(StringC("math-class"), ch, loc, null)
            if prop <> null
            {
                var m FotSym()
                if Convert.convert_math_class(prop, &m, host, interp, loc)
                    set r.math_class: m
                else
                    Convert.invalid_value(interp, ident, loc)
            }
        }
        true
    }

    procedure char_prop_bool(name: pointer[const_char], ch: u32, loc: Location, interp: ref[Interpreter], ident: ref[Identifier]?, out: ref[bool])
    {
        let prop interp.char_property(StringC(name), ch, loc, null)
        if prop = null
            return
        var b false
        if Convert.convert_boolean(prop, &b, interp, loc)
            set out: b
        else
            Convert.invalid_value(interp, ident, loc)
    }

    procedure char_prop_int(name: pointer[const_char], ch: u32, loc: Location, interp: ref[Interpreter], ident: ref[Identifier]?, out: ref[int])
    {
        let prop interp.char_property(StringC(name), ch, loc, null)
        if prop = null
            return
        var n 0
        if Convert.convert_integer(prop, &n, interp, loc)
            set out: n
        else
            Convert.invalid_value(interp, ident, loc)
    }

    function is_display_nic_key(sk: int) returns bool
    {
        if sk = SK_POSITION_PREFERENCE
            return true
        if sk = SK_KEEP_WITH_PREVIOUS
            return true
        if sk = SK_KEEP_WITH_NEXT
            return true
        if sk = SK_KEEP
            return true
        if sk = SK_BREAK_BEFORE
            return true
        if sk = SK_BREAK_AFTER
            return true
        if sk = SK_MAY_VIOLATE_KEEP_BEFORE
            return true
        if sk = SK_MAY_VIOLATE_KEEP_AFTER
            return true
        if sk = SK_SPACE_BEFORE
            return true
        if sk = SK_SPACE_AFTER
            return true
        false
    }
}

; --- StyleStack (Style.cxx) --------------------------------------------------
; VarStyleObj's payload (the ELObj Style arm keeps its two-pointer shape: spec
; points here, use_chain stays in the arm). `display` is the captured closure
; vars of the style's VarInheritedC codes (null-terminated, like a closure
; display); `node` the current node at style creation (typed void: Style does
; not import Grove — only the VM glue dereferences it).
define VarStyleRec
(
    force_specs: ref[Array[ref[InheritedC]?]]?
    specs: ref[Array[ref[InheritedC]?]]?
    display: pointer[pointer[ELObj]]
    node: ref[GroveNode]?
)
{
    function make(host: ref[Page], force_specs: ref[Array[ref[InheritedC]?]]?, specs: ref[Array[ref[InheritedC]?]]?, display: pointer[pointer[ELObj]], node: ref[GroveNode]?) returns ref[VarStyleRec]
    {
        let r &VarStyleRec^host(force_specs, specs, display, node)
        r
    }
}

; InheritedCInfo — one pushed spec for one characteristic index; `prev` chains
; to the spec shadowed at an outer level (restored by pop). `style` is the
; VarStyleRec the spec came from (display + node for VarInheritedC evaluation);
; `cached_value` the push-time evaluated value (valid only while none of
; `dependencies` — indices this value read via actual-*/inherited-* — changed).
define InheritedCInfo
(
    spec: ref[InheritedC]
    prev: ref[InheritedCInfo]?
    val_level: int
    spec_level: int
    style: ref[VarStyleRec]
    cached_value: ref[ELObj]?
    dependencies: ref[Array[int]]
    ; the STYLE RULE that specified this characteristic at this level, null for
    ; a style pushed by `make` (which has no rule). Only ambiguousStyle reads
    ; it: two rules of EQUAL specificity setting the same characteristic at
    ; the same level is the one case the reference reports.
    rule: ref[Rule]?
)
{
    function make(host: ref[Page], spec: ref[InheritedC], style: ref[VarStyleRec], prev: ref[InheritedCInfo], val_level: int, spec_level: int) returns ref[InheritedCInfo]
        InheritedCInfo.make_ruled(host, spec, style, prev, val_level, spec_level, null)

    function make_ruled(host: ref[Page], spec: ref[InheritedC], style: ref[VarStyleRec], prev: ref[InheritedCInfo]?, val_level: int, spec_level: int, rule: ref[Rule]?) returns ref[InheritedCInfo]
    {
        let info &InheritedCInfo^host(spec, prev, val_level, spec_level, style, null, Array[int]^host(), rule)
        info
    }
}

define PopList (list: ref[Array[int]]?, depending_list: ref[Array[int]], prev: ref[PopList]?)
{
    function make(host: ref[Page], prev: ref[PopList]?) returns ref[PopList]
    {
        let pl &PopList^host(Array[int]^host(), Array[int]^host(), prev)
        pl
    }
}

define StyleStack (info: ref[Array[ref[InheritedCInfo]?]], level: int, pop_list: ref[PopList]?, host: ref[Page])
{
    function make(host: ref[Page]) returns ref[StyleStack]
    {
        let ss &StyleStack^host(Array[ref[InheritedCInfo]?]^host(), 0, null, host)
        ss
    }

    function push_start(this: ref[StyleStack], scratch: ref[Page])
    {
        set this.level: this.level + 1
        set this.pop_list: PopList.make(scratch, this.pop_list)
    }

    ; the C++ StyleStack copy (Connectable/Connection snapshots): a shallow
    ; copy of the info vector (the InheritedCInfo chains are immutable and
    ; shared), same level, SHARED pop-list pointer — balanced push/pop on the
    ; copy builds and unwinds its own PopLists on top and never mutates the
    ; shared tail (push_end_prologue only READS prev's depending list).
    function copy(this: ref[StyleStack], host: ref[Page]) returns ref[StyleStack]
    {
        let ss host.allocate(sizeof StyleStack, alignof StyleStack) as pointer[StyleStack]
        let info Array[ref[InheritedCInfo]?]^host()
        let n this.info.get_length()
        var i: size_t 0
        while i < n
        {
            let p this.info.get(i)
            if p <> null
                info.add(*p)
            else
                info.add(null)
            set i: i + 1
        }
        set ss.info: info
        set ss.level: this.level
        set ss.pop_list: this.pop_list
        set ss.host: host
        ss
    }

    ; grow the info vector to cover index `ind`.
    function info_at(this: ref[StyleStack], ind: int) returns ref[InheritedCInfo]?
    {
        if (ind as size_t) >= this.info.get_length()
            return null
        let p this.info.get(ind as size_t)
        if p = null
            return null
        *p
    }

    function info_set(this: ref[StyleStack], ind: int, v: ref[InheritedCInfo]?)
    {
        while this.info.get_length() <= (ind as size_t)
            this.info.add(null)
        this.info.put(ind as size_t, v)
    }

    ; StyleStack::pushContinue — walk the style chain per VarStyleObj::
    ; appendIter: own force! specs, own specs, then the use chain (its force
    ; and normal specs at that point); first spec per characteristic wins
    ; within this level.
    function push_continue(this: ref[StyleStack], style: ref[ELObj]?, scratch: ref[Page], rule: ref[Rule]?, interp: ref[Interpreter])
    {
        if style = null
            return
        ; MergeStyleObj::appendIter — a merged style has no specifications of
        ; its own; it expands to its parts IN ORDER, and since the first
        ; specification per characteristic wins at a level, the FIRST part
        ; takes precedence.
        let parts style.style_merged()
        if parts <> null
        {
            let np parts.get_length()
            var pi: size_t 0
            while pi < np
            {
                let pp parts.get(pi)
                if pp <> null
                    this.push_continue(*pp, scratch, rule, interp)
                set pi: pi + 1
            }
            return
        }
        let rec style.style_spec()
        if rec <> null
        {
            this.push_spec_array(rec.force_specs, rec, scratch, rule, interp)
            this.push_spec_array(rec.specs, rec, scratch, rule, interp)
        }
        let u style.style_use()
        if u <> null
            this.push_continue(u, scratch, rule, interp)
    }

    function push_spec_array(this: ref[StyleStack], arr: ref[Array[ref[InheritedC]?]]?, rec: ref[VarStyleRec], scratch: ref[Page], rule: ref[Rule]?, interp: ref[Interpreter])
    {
        if arr = null
            return
        let n arr.get_length()
        var i: size_t 0
        while i < n
        {
            let icp arr.get(i)
            if icp <> null
            {
                let ic *icp
                if ic <> null
                    this.push_spec(ic, rec, scratch, rule, interp)
            }
            set i: i + 1
        }
    }

    function push_spec(this: ref[StyleStack], spec: ref[InheritedC], rec: ref[VarStyleRec], scratch: ref[Page], rule: ref[Rule]?, interp: ref[Interpreter])
    {
        let ind spec.get_index()
        let cur this.info_at(ind)
        if cur <> null
        {
            if cur.val_level = this.level
            {
                ; ambiguousStyle (Style.cxx:42): the characteristic is already
                ; specified AT THIS LEVEL. Only a RULE-borne specification can
                ; clash — and only with another rule of equal specificity,
                ; because a more specific one legitimately wins. ★The message
                ; anchors at the EXISTING rule and carries the new one as the
                ; auxiliary line, which is the reverse of every other duplicate
                ; diagnostic in this engine.
                if (rule <> null) and (cur.rule <> null)
                {
                    if rule.compare_specificity(cur.rule as ref[Rule]) = 0
                    {
                        interp.set_next_location(cur.rule.get_action().location())
                        interp.message1(InterpreterMessages.ambiguousStyle(), spec.get_ident_name())
                        interp.emit_aux(InterpreterMessages.ambiguousStyle_aux(), rule.get_action().location())
                    }
                }
                return
            }
        }
        this.pop_list.list.add(ind)
        this.info_set(ind, InheritedCInfo.make_ruled(scratch, spec, rec, cur, this.level, this.level, rule))
    }

    ; StyleStack::pushEnd's prologue: a characteristic that DEPENDS (via
    ; actual-*) on another characteristic re-evaluates at this level when any
    ; of its dependencies was re-specified here — re-push it (keeping its
    ; original spec_level); otherwise it keeps depending at this level too.
    function push_end_prologue(this: ref[StyleStack], scratch: ref[Page])
    {
        let pl this.pop_list
        if pl = null
            return
        let old pl.prev
        if old = null
            return
        let n old.depending_list.get_length()
        var i: size_t 0
        while i < n
        {
            let dp old.depending_list.get(i)
            if dp <> null
            {
                let d *dp
                let info this.info_at(d)
                if info <> null
                {
                    if info.val_level <> this.level
                    {
                        var changed false
                        let deps info.dependencies
                        let nd deps.get_length()
                        var j: size_t 0
                        while j < nd
                        {
                            if changed = false
                            {
                                let ip deps.get(j)
                                if ip <> null
                                {
                                    let p this.info_at(*ip)
                                    if p <> null
                                    {
                                        if p.val_level = this.level
                                        {
                                            this.info_set(d, InheritedCInfo.make(scratch, info.spec, info.style, info, this.level, info.spec_level))
                                            pl.list.add(d)
                                            set changed: true
                                        }
                                    }
                                }
                            }
                            set j: j + 1
                        }
                        if changed = false
                            pl.depending_list.add(d)
                    }
                }
            }
            set i: i + 1
        }
    }

    ; pushEnd's per-spec epilogue: a spec whose evaluation recorded
    ; dependencies keeps re-evaluating at deeper levels (see prologue).
    function note_depending(this: ref[StyleStack], ind: int)
    {
        if this.pop_list <> null
            this.pop_list.depending_list.add(ind)
    }

    function pop(this: ref[StyleStack])
    {
        let pl this.pop_list
        if pl <> null
        {
            let n pl.list.get_length()
            var i: size_t 0
            while i < n
            {
                let indp pl.list.get(i)
                if indp <> null
                {
                    let ind *indp
                    let cur this.info_at(ind)
                    if cur <> null
                        this.info_set(ind, cur.prev)
                }
                set i: i + 1
            }
            set this.pop_list: pl.prev
        }
        set this.level: this.level - 1
    }

    function push_empty(this: ref[StyleStack])
        set this.level: this.level + 1

    function pop_empty(this: ref[StyleStack])
        set this.level: this.level - 1

    function get_level(this: ref[StyleStack]) returns int
        level

    ; the specs pushed at the CURRENT level, in push order — the set* feed for
    ; pushEnd (the caller renders them through its sink).
    function current_specs(this: ref[StyleStack]) returns ref[Array[int]]?
    {
        if this.pop_list = null
            return null
        this.pop_list.list
    }

}
