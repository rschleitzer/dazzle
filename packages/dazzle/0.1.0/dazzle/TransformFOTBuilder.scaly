; TransformFOTBuilder — the faithful transform SGML/XML output sink (Stage 6a
; Inc 5b, slice A). Ported from dazzle-net's TransformFOTBuilder.cs (structural
; mirror) against ~/repos/dazzle/jade/TransformFOTBuilder.cxx (C++ oracle, which
; owns the `directory` extension). Replaces the Inc 5a character-collecting
; FOTBuilder in ProcessContext with the real record-end (RE) state machine and
; the eight transform flow-object callbacks.
;
; Slice A is the sink alone, unit-tested by driving the callbacks directly.
; Slice B wires the `make` special form -> flow-object sosofos -> process_sosofo
; dispatch that feeds these callbacks from a stylesheet.
;
; RBMM: one arena region per run (roadmap doctrine). Output collects into the
; current u32 buffer; the entity flow object swaps in a fresh buffer, flushed to
; its file (UTF-8 via opensp's CodingSystem) on end. The directory flow object
; mkdir's (0755) and prefixes subsequent entity filenames, per the C++/C# source
; (the DESIGN.md no-mkdir note predated the checked-out C++ dazzle extension).

use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String.String
use scaly.containers.StringBuilder.StringBuilder
use scaly.os.File.File
use scaly.os.Directory.Directory
use dazzle.TestScratch.TestScratch
use opensp.StringC.StringC
use opensp.CodingSystem.CodingSystem
use opensp.CodingSystemKit.CodingSystemKit
use opensp.CodingSystem.IENC_UTF8
use dazzle.Grove.GroveNode

; RE (record-end) states — SGML line handling, mirrors ReState in the reference.
define TFB_MIDDLE: int 0
define TFB_START_OF_ELEMENT: int 1
define TFB_PENDING_RE: int 2

; libc + shim externs for the entity-FO open probe. Prototypes match the
; other roots' declarations (runtime.scaly fopen/fclose, Storage.scaly
; strerror/errno — extern declares must type-match across the whole root).
; fopen is non-variadic, so a direct extern is fine (open(2) is variadic —
; containment rule (b) would force the shim).
function fopen(filename: pointer[const_char], mode: pointer[const_char]) returns pointer[OpaqueFile] extern
function fclose(stream: pointer[OpaqueFile]) returns i32 extern
function strerror(code: i32) returns pointer[const_char] extern
function scaly_eio_errno() returns i32 extern
procedure scaly_eputs(s: pointer[const_char]) extern
procedure scaly_eputnl() extern

; argv0 for the app-message prefix: the reference reports entity-file
; failures through CmdLineApp::message, which renders `<argv0>:E: <text>`.
; The CLI driver sets this once (set_prog_name). A `shared` module global,
; not a TransformFOTBuilder field — growing a heap-hosted struct in the
; dazzle run region trips the S62 page-boundary fragility.
shared tfb_prog: pointer[const_char] null

; An open entity file: its content buffer, the parent buffer to restore on
; end, the resolved output filename (empty = not redirected: open failed or
; no name — content flows to the parent stream, like the reference leaving
; os_ untouched), and the raw system id (the close-error message argument —
; endEntity reports of.systemId, not the directory-joined path).
; ... and the file's own REGION (null when the entity was not redirected): an
; exclusive page of the run region that hosts this file's u32 buffer and the
; encode scratch, released when the file is written. This is where a codegen
; run's memory goes — 84 % of the peak is per-file work, and the entity flow
; object is its seam (tests/dazzle/PERFORMANCE.md, lever 2).
define TfbOpenFile (buf: ref[Array[u32]], save: ref[Array[u32]]?, filename: String, sysid: String, region: ref[Page]?)

define TransformFOTBuilder
(
    out: ref[Array[u32]]
    root: ref[Array[u32]]
    xml: bool
    ; the `-t sgml-raw` output option (reference ctor: RE_[0]=0, SP_[0]=' ') —
    ; tags close with a bare '>' and attributes separate with a space instead
    ; of the RE-per-attribute default.
    raw: bool
    state: int
    open_elements: ref[Array[StringC]]
    open_count: size_t
    file_stack: ref[Array[TfbOpenFile]]
    file_count: size_t
    dir_stack: ref[Array[String]]
    dir_count: size_t
    host: ref[Page]
)
{
    function make(host: ref[Page], xml: bool) returns ref[TransformFOTBuilder]
    {
        let r Array[u32]^host()
        let f &TransformFOTBuilder^host(r, r, xml, false, TFB_MIDDLE, Array[StringC]^host(), 0, Array[TfbOpenFile]^host(), 0, Array[String]^host(), 0, host)
        ; NB the reference -t xml emits NO <?xml?> declaration (verified
        ; against the reference dazzle) — xml only switches the escaping
        ; and the empty-element/PI closers.
        f
    }

    procedure set_raw(mutable this: ref[TransformFOTBuilder], raw: bool)
        set this.raw: raw

    ; --- low-level output to the current buffer -----------------------------
    procedure output_ascii(mutable this: ref[TransformFOTBuilder], s: Slice[char])
    {
        var i: size_t 0
        while i < s.length
        {
            this.out.add(s[i] as u32)
            set i: i + 1
        }
    }

    procedure output_stringc(mutable this: ref[TransformFOTBuilder], s: StringC)
    {
        let n s.get_size()
        var i: size_t 0
        while i < n
        {
            this.out.add(s.get(i))
            set i: i + 1
        }
    }

    procedure flush_pending_re(mutable this: ref[TransformFOTBuilder])
    {
        if this.state = TFB_PENDING_RE
        {
            this.out.add(0x0D)
            set this.state: TFB_MIDDLE
        }
    }

    procedure flush_pending_re_char_ref(mutable this: ref[TransformFOTBuilder])
    {
        if this.state = TFB_PENDING_RE
        {
            this.output_ascii("&#13;")
            set this.state: TFB_MIDDLE
        }
    }

    ; TransformFOTBuilder::attributes — quote selection first: a value with no
    ; `&` takes `"` (or `'` when it contains `"`; raw either way, `<`/`>`
    ; included); only a value containing `&` (or both quote chars) is emitted
    ; `"`-quoted with ONLY `"` and `&` escaped — &quot;/&amp; in xml mode,
    ; numeric &#34;/&#38; in sgml mode (outputNumericCharRef).
    procedure output_attribute_value(mutable this: ref[TransformFOTBuilder], value: StringC)
    {
        let n value.get_size()
        var has_amp false
        var has_dq false
        var has_sq false
        var i: size_t 0
        while i < n
        {
            let c value.get(i)
            if c = 0x26
                set has_amp: true
            else if c = 0x22
                set has_dq: true
            else if c = 0x27
                set has_sq: true
            set i: i + 1
        }
        var quote: u32 0
        if has_amp = false
        {
            if has_dq = false
                set quote: 0x22
            else if has_sq = false
                set quote: 0x27
        }
        if quote <> 0
        {
            this.out.add(quote)
            set i: 0
            while i < n
            {
                this.out.add(value.get(i))
                set i: i + 1
            }
            this.out.add(quote)
            return
        }
        this.out.add(0x22)
        set i: 0
        while i < n
        {
            let c value.get(i)
            if c = 0x22
            {
                if this.xml
                    this.output_ascii("&quot;")
                else
                    this.output_ascii("&#34;")
            }
            else if c = 0x26
            {
                if this.xml
                    this.output_ascii("&amp;")
                else
                    this.output_ascii("&#38;")
            }
            else
                this.out.add(c)
            set i: i + 1
        }
        this.out.add(0x22)
    }

    procedure output_attributes(mutable this: ref[TransformFOTBuilder], atts: ref[Array[StringC]]?)
    {
        if atts = null
            return
        let cnt atts.get_length()
        var i: size_t 0
        while (i + 1) < cnt
        {
            ; SP_ default = RE: each attribute starts on its own output line
            ; (raw: a plain space)
            if this.raw
                this.out.add(0x20)
            else
                this.out.add(0x0D)
            let namep atts.get i
            if namep <> null
            {
                let nm *namep
                this.output_stringc(nm)
            }
            this.output_ascii("=")
            let valp atts.get(i + 1)
            if valp <> null
            {
                let vv *valp
                this.output_attribute_value(vv)
            }
            else
                this.output_ascii("\"\"")
            set i: i + 2
        }
    }

    ; --- flow-object callbacks ----------------------------------------------
    ; characters(): the reference RE state machine (TransformFOTBuilder.cxx).
    ; A pending RE is flushed ONCE up front; a leading RE right after a start
    ; tag becomes `&#13;`; only the TRAILING RE of the chunk is deferred (so a
    ; following end tag can drop or re-emit it); every INTERIOR RE is emitted
    ; verbatim (a real record end, later rendered as the output newline). The
    ; earlier code ran the pending-RE machine per character and silently lost
    ; interior REs. Data escaping is mode-split like the reference: &lt;/&gt;/
    ; &amp; in xml mode, numeric &#60;/&#62;/&#38; in sgml mode.
    procedure characters(mutable this: ref[TransformFOTBuilder], data: Slice[u32])
    {
        if data.length = 0
            return
        this.flush_pending_re()
        var lo: size_t 0
        var hi data.length
        if (this.state = TFB_START_OF_ELEMENT) and (data[0] = 0x0D)
        {
            set lo: 1
            this.output_ascii("&#13;")
            if lo >= hi
            {
                set this.state: TFB_MIDDLE
                return
            }
        }
        if data[(hi - 1)] = 0x0D
        {
            set hi: hi - 1
            set this.state: TFB_PENDING_RE
        }
        else
            set this.state: TFB_MIDDLE
        var i lo
        while i < hi
        {
            let c data[i]
            if c = 0x3C
            {
                if this.xml
                    this.output_ascii("&lt;")
                else
                    this.output_ascii("&#60;")
            }
            else if c = 0x3E
            {
                if this.xml
                    this.output_ascii("&gt;")
                else
                    this.output_ascii("&#62;")
            }
            else if c = 0x26
            {
                if this.xml
                    this.output_ascii("&amp;")
                else
                    this.output_ascii("&#38;")
            }
            else
                this.out.add(c)
            set i: i + 1
        }
    }

    ; charactersFromNode — SDATA substitution is deferred (preserve-sdata?);
    ; here it is the plain character path (matches the reference default).
    procedure characters_from_node(mutable this: ref[TransformFOTBuilder], node: ref[GroveNode]?, s: Slice[u32])
        this.characters(s)

    ; start/endElement close their tag with RE_ + '>' (an RE before the `>`,
    ; rendered as the output newline) and each attribute is preceded by SP_
    ; (also an RE) — the reference DEFAULTS; the compact single-line form is
    ; the `-t sgml-raw` output option (the `raw` flag above; empty elements
    ; close bare in both modes, like the reference).
    procedure start_element(mutable this: ref[TransformFOTBuilder], gi: StringC, atts: ref[Array[StringC]]?)
    {
        this.flush_pending_re()
        this.output_ascii("<")
        this.output_stringc(gi)
        this.output_attributes(atts)
        if this.raw = false
            this.out.add(0x0D)
        this.output_ascii(">")
        if this.open_count < this.open_elements.get_length()
            this.open_elements.put(this.open_count, gi)
        else
            this.open_elements.add(gi)
        set this.open_count: this.open_count + 1
        set this.state: TFB_START_OF_ELEMENT
    }

    procedure end_element(mutable this: ref[TransformFOTBuilder])
    {
        if this.open_count > 0
        {
            set this.open_count: this.open_count - 1
            let gip this.open_elements.get(this.open_count)
            ; reference endElement: a pending RE renders as &#13; here
            this.flush_pending_re_char_ref()
            this.output_ascii("</")
            if gip <> null
            {
                let gi *gip
                this.output_stringc(gi)
            }
            if this.raw = false
                this.out.add(0x0D)
            this.output_ascii(">")
            set this.state: TFB_MIDDLE
        }
    }

    procedure empty_element(mutable this: ref[TransformFOTBuilder], gi: StringC, atts: ref[Array[StringC]]?)
    {
        this.flush_pending_re()
        this.output_ascii("<")
        this.output_stringc(gi)
        this.output_attributes(atts)
        if this.xml
            this.output_ascii("/>")
        else
            this.output_ascii(">")
        set this.state: TFB_MIDDLE
    }

    procedure processing_instruction(mutable this: ref[TransformFOTBuilder], data: StringC)
    {
        this.flush_pending_re_char_ref()
        this.output_ascii("<?")
        this.output_stringc(data)
        if this.xml
            this.output_ascii("?>")
        else
            this.output_ascii(">")
        set this.state: TFB_MIDDLE
    }

    procedure document_type(mutable this: ref[TransformFOTBuilder], name: StringC, public_id: StringC, system_id: StringC)
    {
        this.flush_pending_re()
        this.output_ascii("<!DOCTYPE ")
        this.output_stringc(name)
        if public_id.get_size() > 0
        {
            this.output_ascii(" PUBLIC \"")
            this.output_stringc(public_id)
            this.output_ascii("\"")
            if system_id.get_size() > 0
            {
                this.output_ascii(" \"")
                this.output_stringc(system_id)
                this.output_ascii("\"")
            }
        }
        else if system_id.get_size() > 0
        {
            this.output_ascii(" SYSTEM \"")
            this.output_stringc(system_id)
            this.output_ascii("\"")
        }
        ; reference documentType closes with '>' + RE (a raw 0x0A here would
        ; be an RS and get dropped by the record encoder)
        this.output_ascii(">")
        this.out.add(0x0D)
    }

    procedure entity_ref(mutable this: ref[TransformFOTBuilder], name: StringC)
    {
        this.flush_pending_re()
        this.output_ascii("&")
        this.output_stringc(name)
        this.output_ascii(";")
    }

    procedure formatting_instruction(mutable this: ref[TransformFOTBuilder], s: StringC)
    {
        this.flush_pending_re()
        this.output_stringc(s)
    }

    ; the CLI driver's argv0 — the prefix of the entity-file app messages.
    procedure set_prog_name(prog: pointer[const_char]) mutable tfb_prog
        set tfb_prog: prog

    ; render `<argv0>:E: <text-head>"<arg>" (<errno text>)` on stderr — the
    ; observed CmdLineApp::message shape (%1 StringMessageArg quoted,
    ; %2 ErrnoMessageArg raw). rc is NOT affected (matches the reference:
    ; the runs exit 0 with these errors on stderr).
    procedure file_error(this: ref[TransformFOTBuilder], head: Slice[char], arg: String, err: i32)
    {
        if tfb_prog <> null
            scaly_eputs(tfb_prog)
        scaly_eputs ":E: "
        write(2, head.data as pointer[void], head.length)
        scaly_eputs "\""
        let arg_c arg.to_c_string()
        scaly_eputs(arg_c)
        scaly_eputs "\" ("
        let et strerror(err)
        scaly_eputs(et)
        scaly_eputs ")"
        scaly_eputnl()
    }

    ; --- entity flow object: redirect output to a file ----------------------
    ; startEntity (TransformFOTBuilder.cxx): the output file is opened HERE.
    ; A failed open reports cannotOpenOutputError and leaves os_ on the
    ; PARENT stream — the entity's content falls through to it (ultimately
    ; stdout). Only a successful open redirects. Our sink buffers and writes
    ; on end, so the open is a probe (create/truncate, like the reference's
    ; eager FileOutputByteStream::open) whose failure routes the content.
    procedure start_entity(mutable this: ref[TransformFOTBuilder], system_id: StringC)
    {
        this.flush_pending_re()
        let name_str this.stringc_to_string(system_id)
        var filename name_str
        if this.dir_count > 0
        {
            let dp this.dir_stack.get(this.dir_count - 1)
            if dp <> null
            {
                let dir *dp
                set filename: this.join_path(dir, name_str)
            }
        }
        var redirected false
        if filename.get_length() > 0
        {
            let fn_c filename.to_c_string()
            let fh fopen(fn_c, "w")
            if fh = null
                this.file_error("cannot open output file ", filename, scaly_eio_errno())
            else
            {
                fclose(fh)
                set redirected: true
            }
        }
        var of TfbOpenFile(this.out, this.out, String(), String(), null)
        if redirected
        {
            ; the file's own region — see the TfbOpenFile comment. The buffer
            ; is built ON it (`^fr`, a LET-bound page name: a `var` one places
            ; the construction at the page BASE), so its growth chains there
            ; too and the whole file's output cost dies at end_entity.
            let fr this.host.allocate_exclusive_page()
            let newbuf Array[u32]^fr()
            set of: TfbOpenFile(newbuf, this.out, filename, name_str, fr)
            set this.out: newbuf
        }
        if this.file_count < this.file_stack.get_length()
            this.file_stack.put(this.file_count, of)
        else
            this.file_stack.add(of)
        set this.file_count: this.file_count + 1
    }

    procedure end_entity(mutable this: ref[TransformFOTBuilder])
    {
        this.flush_pending_re()
        if this.file_count > 0
        {
            set this.file_count: this.file_count - 1
            let ofp this.file_stack.get(this.file_count)
            if ofp <> null
            {
                let of *ofp
                if of.filename.get_length() > 0
                {
                    ; a failed write is the reference's fb.close() failure:
                    ; closeFileError, %1 = the RAW system id (endEntity
                    ; reports of.systemId, not the joined path).
                    var scratch this.host
                    if of.region <> null
                        set scratch: of.region as ref[Page]
                    if this.flush_buffer_to_file(scratch, of.buf, of.filename) = false
                        this.file_error("cannot close output file ", of.sysid, scaly_eio_errno())
                }
                set this.out: of.save as ref[Array[u32]]
                ; the file is written and `out` is back on the parent stream:
                ; nothing points into this file's region any more.
                if of.region <> null
                    this.host.deallocate_exclusive_page(of.region as ref[Page])
            }
        }
    }

    ; --- directory flow object: mkdir + prefix entity filenames -------------
    procedure start_directory(mutable this: ref[TransformFOTBuilder], mutable path: StringC)
    {
        let path_str this.stringc_to_string(path)
        var full path_str
        if this.dir_count > 0
        {
            let dp this.dir_stack.get(this.dir_count - 1)
            if dp <> null
            {
                let dir *dp
                set full: this.join_path(dir, path_str)
            }
        }
        if full.get_length() > 0
            Directory.create(full)
        if this.dir_count < this.dir_stack.get_length()
            this.dir_stack.put(this.dir_count, full)
        else
            this.dir_stack.add(full)
        set this.dir_count: this.dir_count + 1
    }

    procedure end_directory(mutable this: ref[TransformFOTBuilder])
    {
        if this.dir_count > 0
            set this.dir_count: this.dir_count - 1
    }

    ; --- helpers ------------------------------------------------------------
    ; StringC (u32 codepoints) -> scaly String via UTF-8 (opensp CodingSystem).
    ; NB the returned String's buffer is allocated on `host` (the run region),
    ; not this frame — filenames/directory paths outlive the call that builds
    ; them (they are stashed in dir_stack / the open-file record and read back on
    ; a later entity/flush). A frame-local String would dangle (later overwritten
    ; -> a garbage filename -> the file silently fails to open).
    procedure stringc_to_string(mutable this: ref[TransformFOTBuilder], sc: StringC) returns String
    {
        let n sc.get_size()
        if n = 0
            return String()
        let hp this.host
        let cap n * 4 + 1
        let bytes allocate_slice[u8](hp, cap)
        let blen CodingSystem.encode_utf8_bytes(sc.as_slice(), bytes)
        String^hp(bytes.data as pointer[const_char], blen)
    }

    procedure join_path(mutable this: ref[TransformFOTBuilder], dir: String, name: String) returns String
    {
        let hp this.host
        var sb StringBuilder()
        sb.append dir
        sb.append("/" as char)
        sb.append name
        let joined sb.to_string()
        String^hp(joined.to_c_string(), joined.get_length())
    }

    ; Encode a record buffer through the reference's
    ; RecordOutputCharStream::outputBuf record discipline: RE (0x0D) renders
    ; as the output newline, RS (0x0A) is DROPPED (document data keeps BOTH
    ; per line boundary — a <code> SQL case doubled every newline before
    ; this). Raw literal CRs already leave the sink as the `&#13;` character
    ; reference, so every remaining 0x0D is a record end.
    ; The chars then go through the app's OUTPUT coding system, which every
    ; stream of this sink shares — the top-level one over stdout
    ; (TransformFOTBuilder.cxx:363) and one per entity file (:550). Both carry
    ; outputNumericCharRef as their escaper (:368 / :553), so an unencodable
    ; char leaves as `&#<decimal>;`. One call per FILE, because the BOM is
    ; Encoder::startFile.
    ; `scratch` is where the three conversion buffers go: the file's own region
    ; while an entity file is being written (they are the same order of
    ; magnitude as the file and die with it), the run region for the top-level
    ; stream. NOT named `page`/`rp` — a first parameter of that name is peeled
    ; into the implicit caller-page slot.
    procedure encode_records(this: ref[TransformFOTBuilder], scratch: ref[Page], buf: Slice[u32]) returns String
    {
        let host scratch
        let cap buf.length * 4 + 1
        let src allocate_slice[u32](host, buf.length + 1)
        var m: size_t 0
        var i: size_t 0
        while i < buf.length
        {
            let c buf[i]
            if c = 0x0D
            {
                src.put(m, 0x0A)
                set m: m + 1
            }
            else if c = 0x0A
                0
            else
            {
                src.put(m, c)
                set m: m + 1
            }
            set i: i + 1
        }
        let bytes allocate_slice[u8](host, cap)
        let blen CodingSystem.encode_utf8_bytes(src.subslice(0, m), bytes)
        let obytes CodingSystemKit.encode_output_charref(host, bytes.slice_to(blen), true)
        String(obytes.data as pointer[const_char], obytes.length)
    }

    procedure flush_buffer_to_file(this: ref[TransformFOTBuilder], scratch: ref[Page], buf: ref[Array[u32]], filename: String) returns bool
    {
        let content this.encode_records(scratch, buf.as_slice())
        File.write_from_string(filename, content)
    }

    ; the top-level (root) output as a StringC — the test observation point.
    function root_to_stringc(this: ref[TransformFOTBuilder], host: ref[Page]) returns StringC
    {
        let n this.root.get_length()
        StringC^host(this.root.get_buffer(), n)
    }

    ; the top-level (root) output UTF-8-encoded — the CLI's stdout/-o payload.
    ; (entity/directory flow objects write their own files; this is the main
    ; stream, exactly what `jade -t sgml`/`xml` sends to its output byte stream.)
    procedure root_to_utf8(mutable this: ref[TransformFOTBuilder]) returns String
        this.encode_records(this.host, this.root.as_slice())

    procedure test() returns int
    {
        ; bootstrap the run region (the established test idiom)
        let anchor StringC("x")
        let host Page.get(anchor.data_ptr())

        ; 1. element + attributes + characters (end_element leaves a pending RE)
        let fb TransformFOTBuilder.make(host, false)
        let gi StringC("p")
        let atts Array[StringC]^host()
        let a_name StringC("class")
        let a_val StringC("x")
        atts.add(a_name)
        atts.add(a_val)
        fb.start_element(gi, atts)
        let hi StringC("hi")
        fb.characters( Slice[u32](hi.get_size(), hi.data_ptr()))
        fb.end_element()
        ; SP_/RE_ default = RE: attribute on its own record, RE before `>`
        let got fb.root_to_stringc(host)
        if got.equals(StringC("<p\rclass=\"x\"\r>hi</p\r>")) = false
            return -1

        ; 2. character escaping — sgml mode uses numeric char refs
        ; (outputNumericCharRef), xml mode the entity names.
        let fb2 TransformFOTBuilder.make(host, false)
        let raw StringC("a<b>&c")
        fb2.characters( Slice[u32](raw.get_size(), raw.data_ptr()))
        let got2 fb2.root_to_stringc(host)
        if got2.equals(StringC("a&#60;b&#62;&#38;c")) = false
            return -2
        let fb2x TransformFOTBuilder.make(host, true)
        fb2x.characters( Slice[u32](raw.get_size(), raw.data_ptr()))
        let got2x fb2x.root_to_stringc(host)
        if got2x.equals(StringC("a&lt;b&gt;&amp;c")) = false
            return -7
        ; attribute quote selection: a value with & is "-quoted and escaped
        ; numerically; a value with " but no & takes ' raw.
        let fb2a TransformFOTBuilder.make(host, false)
        let atts2 Array[StringC]^host()
        let an1 StringC("a")
        let av1 StringC("x&y")
        let an2 StringC("b")
        let av2 StringC("say \"hi\" <now>")
        atts2.add(an1)
        atts2.add(av1)
        atts2.add(an2)
        atts2.add(av2)
        let gi2a StringC("e")
        fb2a.start_element(gi2a, atts2)
        fb2a.end_element()
        let got2a fb2a.root_to_stringc(host)
        if got2a.equals(StringC("<e\ra=\"x&#38;y\"\rb='say \"hi\" <now>'\r></e\r>")) = false
            return -8

        ; 3. empty element in XML mode (self-closing; NO <?xml?> declaration)
        let fb3 TransformFOTBuilder.make(host, true)
        let br StringC("br")
        let noatts Array[StringC]^host()
        fb3.empty_element(br, noatts)
        let got3 fb3.root_to_stringc(host)
        if got3.equals(StringC("<br/>")) = false
            return -3

        ; 4. document type (PUBLIC + SYSTEM)
        let fb4 TransformFOTBuilder.make(host, false)
        fb4.document_type(StringC("html"), StringC("-//W3C//DTD"), StringC("x.dtd"))
        let got4 fb4.root_to_stringc(host)
        if got4.equals(StringC("<!DOCTYPE html PUBLIC \"-//W3C//DTD\" \"x.dtd\">\r")) = false
            return -4

        ; 5. directory + entity: content goes to a file, root stays empty
        let fb5 TransformFOTBuilder.make(host, false)
        let tfb_dir TestScratch.path("dazzle_tfb_test")
        fb5.start_directory(StringC(tfb_dir.to_c_string()))
        fb5.start_entity(StringC("out.sgml"))
        let body StringC("body")
        fb5.characters( Slice[u32](body.get_size(), body.data_ptr()))
        fb5.end_entity()
        fb5.end_directory()
        let tfb_out TestScratch.path("dazzle_tfb_test/out.sgml")
        if File.exists(tfb_out) = false
            return -5
        let content File.read_to_string(tfb_out)
        if content.equals(String("body")) = false
            return -6
        let got5 fb5.root_to_stringc(host)
        if got5.get_size() <> 0
            return -7

        0
    }
}
