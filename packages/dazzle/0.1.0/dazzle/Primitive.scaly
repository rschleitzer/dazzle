use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.Location.Location
use dazzle.ELObj.ELObj
use dazzle.ELObj.QuantityValue
use dazzle.ELObj.QT_NONE
use dazzle.ELObj.QT_LONG
use dazzle.ELObj.QT_DOUBLE
use dazzle.VM.VM
use dazzle.Interpreter.Interpreter

; Primitive — the built-in procedures over ELObj (Style/Primitive.cxx). The
; reference has one class per primitive; here each is a prim_id arm of a single
; dispatch. Inc-3 starter set: the pure-ELObj primitives (arithmetic,
; comparison, pairs/lists, predicates, not) — the reference's "install first"
; batch. Strings/chars/vectors and the grove / sosofo / style primitives join
; as their machinery lands. prim_id values are the install order in Interpreter.

define PRIM_CONS: int 0
define PRIM_LIST: int 1
define PRIM_CAR: int 2
define PRIM_CDR: int 3
define PRIM_IS_NULL: int 4
define PRIM_IS_PAIR: int 5
define PRIM_IS_LIST: int 6
define PRIM_LENGTH: int 7
define PRIM_APPEND: int 8
define PRIM_REVERSE: int 9
define PRIM_LIST_REF: int 10
define PRIM_MEMQ: int 11
define PRIM_MEMV: int 12
define PRIM_MEMBER: int 13
define PRIM_ASSQ: int 14
define PRIM_IS_EQUAL: int 15
define PRIM_IS_EQV: int 16
define PRIM_PLUS: int 17
define PRIM_MINUS: int 18
define PRIM_TIMES: int 19
define PRIM_DIVIDE: int 20
define PRIM_NUM_EQ: int 21
define PRIM_LESS: int 22
define PRIM_GREATER: int 23
define PRIM_LESS_EQ: int 24
define PRIM_GREATER_EQ: int 25
define PRIM_NOT: int 26
define PRIM_IS_ZERO: int 27
define PRIM_IS_POSITIVE: int 28
define PRIM_IS_NEGATIVE: int 29
define PRIM_IS_ODD: int 30
define PRIM_IS_EVEN: int 31
define PRIM_ABS: int 32
define PRIM_MODULO: int 33
define PRIM_REMAINDER: int 34
define PRIM_QUOTIENT: int 35
define PRIM_IS_NUMBER: int 36
define PRIM_IS_INTEGER: int 37
define PRIM_IS_REAL: int 38
define PRIM_IS_STRING: int 39
define PRIM_IS_SYMBOL: int 40
define PRIM_IS_CHAR: int 41
define PRIM_IS_BOOLEAN: int 42
define PRIM_IS_PROCEDURE: int 43
define PRIM_IS_VECTOR: int 44
define PRIM_IS_KEYWORD: int 45

define Primitive
{
    ; primitiveCall dispatch. args points into the VM value stack (n_args
    ; slots). An error result is interp.makeError(); the VM turns it into the
    ; error unwind.
    function dispatch(id: int, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], interp: pointer[Interpreter], loc: Location) returns pointer[ELObj]
    {
        let host interp.get_host()
        let a0 *args
        if id = PRIM_CONS
            return ELObj.make_pair(host, *args, *(args + 1))
        if id = PRIM_LIST
            return Primitive.build_list(host, interp, args, n_args)
        if id = PRIM_CAR
        {
            if a0.is_pair() = false
                return Primitive.arg_error(interp, loc)
            return a0.get_car()
        }
        if id = PRIM_CDR
        {
            if a0.is_pair() = false
                return Primitive.arg_error(interp, loc)
            return a0.get_cdr()
        }
        if id = PRIM_IS_NULL
            return interp.make_bool(a0.is_nil())
        if id = PRIM_IS_PAIR
            return interp.make_bool(a0.is_pair())
        if id = PRIM_IS_LIST
            return interp.make_bool(a0.is_list())
        if id = PRIM_LENGTH
            return Primitive.list_length(host, interp, *args, loc)
        if id = PRIM_APPEND
            return Primitive.append_lists(host, interp, args, n_args)
        if id = PRIM_REVERSE
            return Primitive.reverse_list(host, interp, *args)
        if id = PRIM_LIST_REF
            return Primitive.list_ref(interp, *args, *(args + 1), loc)
        if id = PRIM_MEMQ
            return Primitive.member_of(interp, *args, *(args + 1), 0)
        if id = PRIM_MEMV
            return Primitive.member_of(interp, *args, *(args + 1), 1)
        if id = PRIM_MEMBER
            return Primitive.member_of(interp, *args, *(args + 1), 2)
        if id = PRIM_ASSQ
            return Primitive.assq(interp, *args, *(args + 1))
        if id = PRIM_IS_EQUAL
            return interp.make_bool(ELObj.equal(*args, *(args + 1)))
        if id = PRIM_IS_EQV
            return interp.make_bool(ELObj.eqv(*args, *(args + 1)))
        if id = PRIM_NOT
            return interp.make_bool(a0.is_true() = false)
        if id = PRIM_IS_NUMBER
            return interp.make_bool(a0.is_number())
        if id = PRIM_IS_INTEGER
            return interp.make_bool(a0.is_integer_p())
        if id = PRIM_IS_REAL
            return interp.make_bool(a0.is_real())
        if id = PRIM_IS_STRING
            return interp.make_bool(a0.is_string_p())
        if id = PRIM_IS_SYMBOL
            return interp.make_bool(a0.is_symbol_p())
        if id = PRIM_IS_CHAR
            return interp.make_bool(a0.is_char_p())
        if id = PRIM_IS_KEYWORD
            return interp.make_bool(a0.is_keyword_p())
        if id = PRIM_IS_BOOLEAN
            return interp.make_bool(a0.is_boolean_p())
        if id = PRIM_IS_VECTOR
            return interp.make_bool(a0.is_vector_p())
        if id = PRIM_IS_PROCEDURE
            return interp.make_bool(a0.is_function())

        ; --- arithmetic ----------------------------------------------------
        if id = PRIM_PLUS
            return Primitive.arith_add(host, interp, args, n_args, loc)
        if id = PRIM_TIMES
            return Primitive.arith_mul(host, interp, args, n_args, loc)
        if id = PRIM_MINUS
            return Primitive.arith_sub(host, interp, args, n_args, loc)
        if id = PRIM_DIVIDE
            return Primitive.arith_div(host, interp, args, n_args, loc)
        if id = PRIM_NUM_EQ
            return Primitive.compare(host, interp, args, n_args, loc, 0)
        if id = PRIM_LESS
            return Primitive.compare(host, interp, args, n_args, loc, 1)
        if id = PRIM_GREATER
            return Primitive.compare(host, interp, args, n_args, loc, 2)
        if id = PRIM_LESS_EQ
            return Primitive.compare(host, interp, args, n_args, loc, 3)
        if id = PRIM_GREATER_EQ
            return Primitive.compare(host, interp, args, n_args, loc, 4)
        if id = PRIM_IS_ZERO
            return Primitive.sign_test(interp, *args, loc, 0)
        if id = PRIM_IS_POSITIVE
            return Primitive.sign_test(interp, *args, loc, 1)
        if id = PRIM_IS_NEGATIVE
            return Primitive.sign_test(interp, *args, loc, 2)
        if id = PRIM_IS_ODD
            return Primitive.parity_test(interp, *args, loc, 1)
        if id = PRIM_IS_EVEN
            return Primitive.parity_test(interp, *args, loc, 0)
        if id = PRIM_ABS
            return Primitive.abs_val(host, interp, *args, loc)
        if id = PRIM_MODULO
            return Primitive.int_div(host, interp, *args, *(args + 1), loc, 0)
        if id = PRIM_REMAINDER
            return Primitive.int_div(host, interp, *args, *(args + 1), loc, 1)
        if id = PRIM_QUOTIENT
            return Primitive.int_div(host, interp, *args, *(args + 1), loc, 2)

        interp.make_error()
    }

    function arg_error(interp: pointer[Interpreter], loc: Location) returns pointer[ELObj]
    {
        interp.set_next_location(loc)
        interp.make_error()
    }

    ; --- list helpers ------------------------------------------------------
    function build_list(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int) returns pointer[ELObj]
    {
        var result interp.make_nil()
        var i n_args - 1
        while i >= 0
        {
            set result: ELObj.make_pair(host, *(args + i), result)
            set i: i - 1
        }
        result
    }

    function list_length(host: pointer[Page], interp: pointer[Interpreter], obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        var n 0
        var p obj
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
                return Primitive.arg_error(interp, loc)
            set n: n + 1
            set p: p.get_cdr()
        }
        ELObj.make_integer(host, n)
    }

    function append_lists(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int) returns pointer[ELObj]
    {
        if n_args = 0
            return interp.make_nil()
        var result *(args + (n_args - 1))
        var i n_args - 2
        while i >= 0
        {
            ; prepend the elements of args[i] (reversed onto result)
            let tmp Primitive.reverse_list(host, interp, *(args + i))
            var p tmp
            while (p <> null) and (p.is_nil() = false)
            {
                set result: ELObj.make_pair(host, p.get_car(), result)
                set p: p.get_cdr()
            }
            set i: i - 1
        }
        result
    }

    function reverse_list(host: pointer[Page], interp: pointer[Interpreter], obj: pointer[ELObj]) returns pointer[ELObj]
    {
        var result interp.make_nil()
        var p obj
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
                return result
            set result: ELObj.make_pair(host, p.get_car(), result)
            set p: p.get_cdr()
        }
        result
    }

    function list_ref(interp: pointer[Interpreter], list: pointer[ELObj], k_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if k_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc)
        var k k_obj.exact_integer_value()
        var p list
        while k > 0
        {
            if p.is_pair() = false
                return Primitive.arg_error(interp, loc)
            set p: p.get_cdr()
            set k: k - 1
        }
        if p.is_pair() = false
            return Primitive.arg_error(interp, loc)
        p.get_car()
    }

    ; mode: 0 memq (eq/eqv-ptr), 1 memv (eqv), 2 member (equal).
    function member_of(interp: pointer[Interpreter], obj: pointer[ELObj], list: pointer[ELObj], mode: int) returns pointer[ELObj]
    {
        var p list
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
                return interp.make_false()
            let car p.get_car()
            var hit false
            if mode = 0
                set hit: car = obj
            else if mode = 1
                set hit: ELObj.eqv(car, obj)
            else
                set hit: ELObj.equal(car, obj)
            if hit
                return p
            set p: p.get_cdr()
        }
        interp.make_false()
    }

    function assq(interp: pointer[Interpreter], obj: pointer[ELObj], list: pointer[ELObj]) returns pointer[ELObj]
    {
        var p list
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
                return interp.make_false()
            let entry p.get_car()
            if entry.is_pair()
            {
                if entry.get_car() = obj
                    return entry
            }
            set p: p.get_cdr()
        }
        interp.make_false()
    }

    ; --- numeric core ------------------------------------------------------
    ; Accumulate args as exact-long while all operands are exact, promoting to
    ; double on the first inexact. Dimensions are not tracked in the starter
    ; set (numbers assumed dimensionless); length/quantity dims join later.
    function arith_add(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        var is_double false
        var lsum 0
        var dsum 0.0
        var i 0
        while i < n_args
        {
            let a *(args + i)
            let qv a.quantity_value()
            let qt qv.get_qtype()
            if qt = QT_NONE
                return Primitive.arg_error(interp, loc)
            if qt = QT_DOUBLE
            {
                if is_double = false
                {
                    set dsum: lsum as double
                    set is_double: true
                }
                set dsum: dsum + qv.get_dval()
            }
            else
            {
                if is_double
                    set dsum: dsum + (qv.get_lval() as double)
                else
                    set lsum: lsum + qv.get_lval()
            }
            set i: i + 1
        }
        if is_double
            return ELObj.make_real(host, dsum)
        ELObj.make_integer(host, lsum)
    }

    function arith_mul(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        var is_double false
        var lprod 1
        var dprod 1.0
        var i 0
        while i < n_args
        {
            let a *(args + i)
            let qv a.quantity_value()
            if qv.get_qtype() = QT_NONE
                return Primitive.arg_error(interp, loc)
            if qv.get_qtype() = QT_DOUBLE
            {
                if is_double = false
                {
                    set dprod: lprod as double
                    set is_double: true
                }
                set dprod: dprod * qv.get_dval()
            }
            else
            {
                if is_double
                    set dprod: dprod * (qv.get_lval() as double)
                else
                    set lprod: lprod * qv.get_lval()
            }
            set i: i + 1
        }
        if is_double
            return ELObj.make_real(host, dprod)
        ELObj.make_integer(host, lprod)
    }

    function arith_sub(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        let qv0 a0.quantity_value()
        if qv0.get_qtype() = QT_NONE
            return Primitive.arg_error(interp, loc)
        var is_double qv0.get_qtype() = QT_DOUBLE
        var lacc qv0.get_lval()
        var dacc qv0.get_dval()
        if is_double = false
            set dacc: lacc as double
        if n_args = 1
        {
            if is_double
                return ELObj.make_real(host, 0.0 - dacc)
            return ELObj.make_integer(host, 0 - lacc)
        }
        var i 1
        while i < n_args
        {
            let a *(args + i)
            let qv a.quantity_value()
            if qv.get_qtype() = QT_NONE
                return Primitive.arg_error(interp, loc)
            if qv.get_qtype() = QT_DOUBLE
            {
                if is_double = false
                {
                    set dacc: lacc as double
                    set is_double: true
                }
                set dacc: dacc - qv.get_dval()
            }
            else
            {
                if is_double
                    set dacc: dacc - (qv.get_lval() as double)
                else
                    set lacc: lacc - qv.get_lval()
            }
            set i: i + 1
        }
        if is_double
            return ELObj.make_real(host, dacc)
        ELObj.make_integer(host, lacc)
    }

    function arith_div(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        let qv0 a0.quantity_value()
        if qv0.get_qtype() = QT_NONE
            return Primitive.arg_error(interp, loc)
        var acc qv0.get_dval()
        if qv0.get_qtype() <> QT_DOUBLE
            set acc: qv0.get_lval() as double
        if n_args = 1
        {
            if acc = 0.0
                return Primitive.arg_error(interp, loc)
            return ELObj.make_real(host, 1.0 / acc)
        }
        var all_exact qv0.get_qtype() <> QT_DOUBLE
        var lnum qv0.get_lval()
        var i 1
        while i < n_args
        {
            let a *(args + i)
            let qv a.quantity_value()
            if qv.get_qtype() = QT_NONE
                return Primitive.arg_error(interp, loc)
            var d qv.get_dval()
            if qv.get_qtype() <> QT_DOUBLE
                set d: qv.get_lval() as double
            if d = 0.0
                return Primitive.arg_error(interp, loc)
            set acc: acc / d
            if qv.get_qtype() = QT_DOUBLE
                set all_exact: false
            else
            {
                if all_exact and ((lnum % qv.get_lval()) = 0)
                    set lnum: lnum / qv.get_lval()
                else
                    set all_exact: false
            }
            set i: i + 1
        }
        if all_exact
            return ELObj.make_integer(host, lnum)
        ELObj.make_real(host, acc)
    }

    ; op: 0 =, 1 <, 2 >, 3 <=, 4 >=. Chain comparison over adjacent operands.
    function compare(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int, loc: Location, op: int) returns pointer[ELObj]
    {
        var i 0
        while i < n_args - 1
        {
            let ea *(args + i)
            let eb *(args + i + 1)
            let a ea.quantity_value()
            let b eb.quantity_value()
            let aqt a.get_qtype()
            let bqt b.get_qtype()
            if (aqt = QT_NONE) or (bqt = QT_NONE)
                return Primitive.arg_error(interp, loc)
            var av a.get_dval()
            if aqt <> QT_DOUBLE
                set av: a.get_lval() as double
            var bv b.get_dval()
            if bqt <> QT_DOUBLE
                set bv: b.get_lval() as double
            var ok false
            if op = 0
                set ok: av = bv
            else if op = 1
                set ok: av < bv
            else if op = 2
                set ok: av > bv
            else if op = 3
                set ok: av <= bv
            else
                set ok: av >= bv
            if ok = false
                return interp.make_false()
            set i: i + 1
        }
        interp.make_true()
    }

    ; test: 0 zero?, 1 positive?, 2 negative?.
    function sign_test(interp: pointer[Interpreter], obj: pointer[ELObj], loc: Location, test: int) returns pointer[ELObj]
    {
        let qv obj.quantity_value()
        if qv.get_qtype() = QT_NONE
            return Primitive.arg_error(interp, loc)
        var v qv.get_dval()
        if qv.get_qtype() <> QT_DOUBLE
            set v: qv.get_lval() as double
        if test = 0
            return interp.make_bool(v = 0.0)
        if test = 1
            return interp.make_bool(v > 0.0)
        interp.make_bool(v < 0.0)
    }

    ; parity: 1 odd?, 0 even?.
    function parity_test(interp: pointer[Interpreter], obj: pointer[ELObj], loc: Location, want_odd: int) returns pointer[ELObj]
    {
        if obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc)
        let n obj.exact_integer_value()
        let r n % 2
        if want_odd = 1
            return interp.make_bool(r <> 0)
        interp.make_bool(r = 0)
    }

    function abs_val(host: pointer[Page], interp: pointer[Interpreter], obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        let qv obj.quantity_value()
        if qv.get_qtype() = QT_NONE
            return Primitive.arg_error(interp, loc)
        if qv.get_qtype() = QT_DOUBLE
        {
            var d qv.get_dval()
            if d < 0.0
                set d: 0.0 - d
            return ELObj.make_real(host, d)
        }
        var n qv.get_lval()
        if n < 0
            set n: 0 - n
        ELObj.make_integer(host, n)
    }

    ; op: 0 modulo, 1 remainder, 2 quotient.
    function int_div(host: pointer[Page], interp: pointer[Interpreter], a: pointer[ELObj], b: pointer[ELObj], loc: Location, op: int) returns pointer[ELObj]
    {
        if (a.is_exact_integer() = false) or (b.is_exact_integer() = false)
            return Primitive.arg_error(interp, loc)
        let x a.exact_integer_value()
        let y b.exact_integer_value()
        if y = 0
            return Primitive.arg_error(interp, loc)
        if op = 2
            return ELObj.make_integer(host, x / y)
        let r x % y
        if op = 1
            return ELObj.make_integer(host, r)
        ; modulo: result takes the sign of the divisor
        var m r
        if (m <> 0) and (((m < 0) and (y > 0)) or ((m > 0) and (y < 0)))
            set m: m + y
        ELObj.make_integer(host, m)
    }
}
