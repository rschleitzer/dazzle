use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.Location.Location
use dazzle.ELObj.ELObj
use dazzle.ELObj.OutputCharStream
use dazzle.ELObj.QuantityValue
use dazzle.Grove.GroveNode
use dazzle.Grove.GN_DOCUMENT
use dazzle.Grove.GN_ELEMENT
use dazzle.Grove.GN_DATA
use dazzle.ELObj.QT_NONE
use dazzle.ELObj.QT_LONG
use dazzle.ELObj.QT_DOUBLE
use dazzle.VM.VM
use dazzle.Interpreter.Interpreter

; Primitive — the built-in procedures over ELObj (Style/Primitive.cxx). The
; reference has one class per primitive; here each is a prim_id arm of a single
; dispatch. Inc-3 starter set: the pure-ELObj primitives (arithmetic,
; comparison, pairs/lists, predicates, not) — the reference's "install first"
; batch. Strings/chars/vectors and the grove / sosofo / style primitives join
; as their machinery lands. prim_id values are the install order in Interpreter.

define PRIM_CONS: int 0
define PRIM_LIST: int 1
define PRIM_CAR: int 2
define PRIM_CDR: int 3
define PRIM_IS_NULL: int 4
define PRIM_IS_PAIR: int 5
define PRIM_IS_LIST: int 6
define PRIM_LENGTH: int 7
define PRIM_APPEND: int 8
define PRIM_REVERSE: int 9
define PRIM_LIST_REF: int 10
define PRIM_MEMQ: int 11
define PRIM_MEMV: int 12
define PRIM_MEMBER: int 13
define PRIM_ASSQ: int 14
define PRIM_IS_EQUAL: int 15
define PRIM_IS_EQV: int 16
define PRIM_PLUS: int 17
define PRIM_MINUS: int 18
define PRIM_TIMES: int 19
define PRIM_DIVIDE: int 20
define PRIM_NUM_EQ: int 21
define PRIM_LESS: int 22
define PRIM_GREATER: int 23
define PRIM_LESS_EQ: int 24
define PRIM_GREATER_EQ: int 25
define PRIM_NOT: int 26
define PRIM_IS_ZERO: int 27
define PRIM_IS_POSITIVE: int 28
define PRIM_IS_NEGATIVE: int 29
define PRIM_IS_ODD: int 30
define PRIM_IS_EVEN: int 31
define PRIM_ABS: int 32
define PRIM_MODULO: int 33
define PRIM_REMAINDER: int 34
define PRIM_QUOTIENT: int 35
define PRIM_IS_NUMBER: int 36
define PRIM_IS_INTEGER: int 37
define PRIM_IS_REAL: int 38
define PRIM_IS_STRING: int 39
define PRIM_IS_SYMBOL: int 40
define PRIM_IS_CHAR: int 41
define PRIM_IS_BOOLEAN: int 42
define PRIM_IS_PROCEDURE: int 43
define PRIM_IS_VECTOR: int 44
define PRIM_IS_KEYWORD: int 45
; --- string / char / symbol / keyword / vector primitives (Inc 3) ----------
define PRIM_SYMBOL_TO_STRING: int 46
define PRIM_STRING_TO_SYMBOL: int 47
define PRIM_KEYWORD_TO_STRING: int 48
define PRIM_STRING_TO_KEYWORD: int 49
define PRIM_STRING_APPEND: int 50
define PRIM_STRING_LENGTH: int 51
define PRIM_STRING_REF: int 52
define PRIM_SUBSTRING: int 53
define PRIM_STRING: int 54
define PRIM_STRING_EQUAL: int 55
define PRIM_STRING_LESS: int 56
define PRIM_STRING_LESS_EQ: int 57
define PRIM_STRING_TO_LIST: int 58
define PRIM_LIST_TO_STRING: int 59
define PRIM_STRING_TO_NUMBER: int 60
define PRIM_NUMBER_TO_STRING: int 61
define PRIM_CHAR_TO_INTEGER: int 62
define PRIM_INTEGER_TO_CHAR: int 63
define PRIM_CHAR_LESS: int 64
define PRIM_CHAR_LESS_EQ: int 65
define PRIM_CHAR_EQUAL: int 66
define PRIM_CHAR_UPCASE: int 67
define PRIM_CHAR_DOWNCASE: int 68
define PRIM_MAKE_VECTOR: int 69
define PRIM_VECTOR: int 70
define PRIM_VECTOR_REF: int 71
define PRIM_VECTOR_SET: int 72
define PRIM_VECTOR_LENGTH: int 73
define PRIM_VECTOR_TO_LIST: int 74
define PRIM_LIST_TO_VECTOR: int 75
define PRIM_LIST_TAIL: int 76
; --- grove / node-list primitives (Inc 4) ----------------------------------
define PRIM_IS_NODE_LIST: int 77
define PRIM_NODE_LIST_EMPTY: int 78
define PRIM_NODE_LIST_LENGTH: int 79
define PRIM_NODE_LIST_FIRST: int 80
define PRIM_NODE_LIST_REST: int 81
define PRIM_NODE_LIST_REF: int 82
define PRIM_EMPTY_NODE_LIST: int 83
define PRIM_NODE_LIST: int 84
define PRIM_CHILDREN: int 85
define PRIM_GI: int 86
define PRIM_DATA: int 87
; --- grove / property axis (Inc 4) -----------------------------------------
; The pure grove-node axis, ported 1:1 from dazzle style/primitive.cxx over the
; grove/Node.h accessors. NOT ported here (need machinery from a later slice):
; - attribute-string: BLOCKED on an emitter bug — an sret-returning helper that
;   binds the result of an sret method-call (the value->text->string chain over
;   opensp's AttributeValue/Text) is truncated: the emitter emits an early `ret`
;   with the sret slot unfilled, dropping the rest → garbage StringC / SIGSEGV.
;   node_gi (pointer-returning) is unaffected; DssslSpecEventHandler.attribute_string
;   works only because its sole sret is the tail return. See memory
;   dazzle-crosspkg-struct-layout-bug. Re-add once the compiler is fixed.
; - select-elements (needs the Pattern type + convertToPattern), node-property /
;   select-by-class (need the ComponentName id space + Node::property metamodel).
define PRIM_PARENT: int 91
define PRIM_ANCESTOR: int 93
define PRIM_DESCENDANTS: int 94
; --- sosofo primitives (Inc 4 foundation) ----------------------------------
define PRIM_IS_SOSOFO: int 88
define PRIM_EMPTY_SOSOFO: int 89
define PRIM_SOSOFO_APPEND: int 90

define Primitive
{
    ; primitiveCall dispatch. args points into the VM value stack (n_args
    ; slots). An error result is interp.makeError(); the VM turns it into the
    ; error unwind.
    function dispatch(id: int, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], interp: pointer[Interpreter], loc: Location) returns pointer[ELObj]
    {
        let host interp.get_host()
        let a0 *args
        if id = PRIM_CONS
            return ELObj.make_pair(host, *args, *(args + 1))
        if id = PRIM_LIST
            return Primitive.build_list(host, interp, args, n_args)
        if id = PRIM_CAR
        {
            if a0.is_pair() = false
                return Primitive.arg_error(interp, loc)
            return a0.get_car()
        }
        if id = PRIM_CDR
        {
            if a0.is_pair() = false
                return Primitive.arg_error(interp, loc)
            return a0.get_cdr()
        }
        if id = PRIM_IS_NULL
            return interp.make_bool(a0.is_nil())
        if id = PRIM_IS_PAIR
            return interp.make_bool(a0.is_pair())
        if id = PRIM_IS_LIST
            return interp.make_bool(a0.is_list())
        if id = PRIM_LENGTH
            return Primitive.list_length(host, interp, *args, loc)
        if id = PRIM_APPEND
            return Primitive.append_lists(host, interp, args, n_args)
        if id = PRIM_REVERSE
            return Primitive.reverse_list(host, interp, *args)
        if id = PRIM_LIST_REF
            return Primitive.list_ref(interp, *args, *(args + 1), loc)
        if id = PRIM_MEMQ
            return Primitive.member_of(interp, *args, *(args + 1), 0)
        if id = PRIM_MEMV
            return Primitive.member_of(interp, *args, *(args + 1), 1)
        if id = PRIM_MEMBER
            return Primitive.member_of(interp, *args, *(args + 1), 2)
        if id = PRIM_ASSQ
            return Primitive.assq(interp, *args, *(args + 1))
        if id = PRIM_IS_EQUAL
            return interp.make_bool(ELObj.equal(*args, *(args + 1)))
        if id = PRIM_IS_EQV
            return interp.make_bool(ELObj.eqv(*args, *(args + 1)))
        if id = PRIM_NOT
            return interp.make_bool(a0.is_true() = false)
        if id = PRIM_IS_NUMBER
            return interp.make_bool(a0.is_number())
        if id = PRIM_IS_INTEGER
            return interp.make_bool(a0.is_integer_p())
        if id = PRIM_IS_REAL
            return interp.make_bool(a0.is_real())
        if id = PRIM_IS_STRING
            return interp.make_bool(a0.is_string_p())
        if id = PRIM_IS_SYMBOL
            return interp.make_bool(a0.is_symbol_p())
        if id = PRIM_IS_CHAR
            return interp.make_bool(a0.is_char_p())
        if id = PRIM_IS_KEYWORD
            return interp.make_bool(a0.is_keyword_p())
        if id = PRIM_IS_BOOLEAN
            return interp.make_bool(a0.is_boolean_p())
        if id = PRIM_IS_VECTOR
            return interp.make_bool(a0.is_vector_p())
        if id = PRIM_IS_PROCEDURE
            return interp.make_bool(a0.is_function())

        ; --- arithmetic ----------------------------------------------------
        if id = PRIM_PLUS
            return Primitive.arith_add(host, interp, args, n_args, loc)
        if id = PRIM_TIMES
            return Primitive.arith_mul(host, interp, args, n_args, loc)
        if id = PRIM_MINUS
            return Primitive.arith_sub(host, interp, args, n_args, loc)
        if id = PRIM_DIVIDE
            return Primitive.arith_div(host, interp, args, n_args, loc)
        if id = PRIM_NUM_EQ
            return Primitive.compare(host, interp, args, n_args, loc, 0)
        if id = PRIM_LESS
            return Primitive.compare(host, interp, args, n_args, loc, 1)
        if id = PRIM_GREATER
            return Primitive.compare(host, interp, args, n_args, loc, 2)
        if id = PRIM_LESS_EQ
            return Primitive.compare(host, interp, args, n_args, loc, 3)
        if id = PRIM_GREATER_EQ
            return Primitive.compare(host, interp, args, n_args, loc, 4)
        if id = PRIM_IS_ZERO
            return Primitive.sign_test(interp, *args, loc, 0)
        if id = PRIM_IS_POSITIVE
            return Primitive.sign_test(interp, *args, loc, 1)
        if id = PRIM_IS_NEGATIVE
            return Primitive.sign_test(interp, *args, loc, 2)
        if id = PRIM_IS_ODD
            return Primitive.parity_test(interp, *args, loc, 1)
        if id = PRIM_IS_EVEN
            return Primitive.parity_test(interp, *args, loc, 0)
        if id = PRIM_ABS
            return Primitive.abs_val(host, interp, *args, loc)
        if id = PRIM_MODULO
            return Primitive.int_div(host, interp, *args, *(args + 1), loc, 0)
        if id = PRIM_REMAINDER
            return Primitive.int_div(host, interp, *args, *(args + 1), loc, 1)
        if id = PRIM_QUOTIENT
            return Primitive.int_div(host, interp, *args, *(args + 1), loc, 2)

        ; --- string / char / symbol / keyword / vector --------------------
        if id = PRIM_SYMBOL_TO_STRING
        {
            if a0.is_symbol_p() = false
                return Primitive.arg_error(interp, loc)
            return ELObj.make_string(host, a0.symbol_name())
        }
        if id = PRIM_STRING_TO_SYMBOL
        {
            if a0.has_string_data() = false
                return Primitive.arg_error(interp, loc)
            return interp.make_symbol(a0.string_data(host))
        }
        if id = PRIM_KEYWORD_TO_STRING
        {
            if a0.is_keyword_p() = false
                return Primitive.arg_error(interp, loc)
            return ELObj.make_string(host, a0.keyword_name())
        }
        if id = PRIM_STRING_TO_KEYWORD
        {
            if a0.has_string_data() = false
                return Primitive.arg_error(interp, loc)
            return interp.make_keyword(a0.string_data(host))
        }
        if id = PRIM_STRING_APPEND
            return Primitive.string_append(host, interp, args, n_args, loc)
        if id = PRIM_STRING_LENGTH
        {
            if a0.has_string_data() = false
                return Primitive.arg_error(interp, loc)
            let sl a0.string_data(host)
            return ELObj.make_integer(host, sl.get_size() as int)
        }
        if id = PRIM_STRING_REF
            return Primitive.string_ref(host, interp, a0, *(args + 1), loc)
        if id = PRIM_SUBSTRING
            return Primitive.substring(host, interp, a0, *(args + 1), *(args + 2), loc)
        if id = PRIM_STRING
            return Primitive.string_from_chars(host, interp, args, n_args, loc)
        if id = PRIM_STRING_EQUAL
            return Primitive.string_compare(interp, a0, *(args + 1), loc, 0)
        if id = PRIM_STRING_LESS
            return Primitive.string_compare(interp, a0, *(args + 1), loc, 1)
        if id = PRIM_STRING_LESS_EQ
            return Primitive.string_compare(interp, a0, *(args + 1), loc, 2)
        if id = PRIM_STRING_TO_LIST
            return Primitive.string_to_list(host, interp, a0, loc)
        if id = PRIM_LIST_TO_STRING
            return Primitive.list_to_string(host, interp, a0, loc)
        if id = PRIM_STRING_TO_NUMBER
            return Primitive.string_to_number(host, interp, args, n_args, loc)
        if id = PRIM_NUMBER_TO_STRING
            return Primitive.number_to_string(host, interp, args, n_args, loc)
        if id = PRIM_CHAR_TO_INTEGER
        {
            if a0.is_char_p() = false
                return Primitive.arg_error(interp, loc)
            return ELObj.make_integer(host, a0.char_value())
        }
        if id = PRIM_INTEGER_TO_CHAR
            return Primitive.integer_to_char(host, interp, a0, loc)
        if id = PRIM_CHAR_LESS
            return Primitive.char_compare(interp, a0, *(args + 1), loc, 1)
        if id = PRIM_CHAR_LESS_EQ
            return Primitive.char_compare(interp, a0, *(args + 1), loc, 2)
        if id = PRIM_CHAR_EQUAL
            return Primitive.char_compare(interp, a0, *(args + 1), loc, 0)
        if id = PRIM_CHAR_UPCASE
            return Primitive.char_case(host, interp, a0, loc, true)
        if id = PRIM_CHAR_DOWNCASE
            return Primitive.char_case(host, interp, a0, loc, false)
        if id = PRIM_MAKE_VECTOR
            return Primitive.make_vector_prim(host, interp, args, n_args, loc)
        if id = PRIM_VECTOR
            return ELObj.make_vector_of(host, args, n_args as size_t)
        if id = PRIM_VECTOR_REF
            return Primitive.vector_ref(interp, a0, *(args + 1), loc)
        if id = PRIM_VECTOR_SET
            return Primitive.vector_set(interp, a0, *(args + 1), *(args + 2), loc)
        if id = PRIM_VECTOR_LENGTH
        {
            if a0.is_vector_p() = false
                return Primitive.arg_error(interp, loc)
            return ELObj.make_integer(host, a0.vector_length() as int)
        }
        if id = PRIM_VECTOR_TO_LIST
            return Primitive.vector_to_list(host, interp, a0, loc)
        if id = PRIM_LIST_TO_VECTOR
            return Primitive.list_to_vector(host, interp, a0, loc)
        if id = PRIM_LIST_TAIL
            return Primitive.list_tail(interp, a0, *(args + 1), loc)

        ; --- grove / node-list --------------------------------------------
        if id = PRIM_IS_NODE_LIST
            return interp.make_bool(a0.is_node_list_p())
        if id = PRIM_NODE_LIST_EMPTY
        {
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc)
            return interp.make_bool(a0.node_list_count() = 0)
        }
        if id = PRIM_NODE_LIST_LENGTH
        {
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc)
            return ELObj.make_integer(host, a0.node_list_count())
        }
        if id = PRIM_NODE_LIST_FIRST
        {
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc)
            if a0.node_list_count() = 0
                return Primitive.arg_error(interp, loc)
            return ELObj.make_node_singleton(host, a0.node_list_node(0))
        }
        if id = PRIM_NODE_LIST_REST
        {
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc)
            let buf a0.node_list_buffer()
            let st a0.node_list_start()
            if a0.node_list_count() = 0
                return ELObj.make_node_list(host, buf, st)
            return ELObj.make_node_list(host, buf, st + 1)
        }
        if id = PRIM_NODE_LIST_REF
            return Primitive.node_list_ref(host, interp, a0, *(args + 1), loc)
        if id = PRIM_EMPTY_NODE_LIST
            return ELObj.make_node_list(host, null, 0)
        if id = PRIM_NODE_LIST
            return Primitive.node_list_concat(host, interp, args, n_args, loc)
        if id = PRIM_CHILDREN
            return Primitive.children(host, interp, a0, loc)
        if id = PRIM_GI
            return Primitive.node_gi(host, interp, a0, loc)
        if id = PRIM_DATA
            return Primitive.node_data(host, interp, a0, loc)

        ; --- grove / property axis ----------------------------------------
        if id = PRIM_PARENT
            return Primitive.node_parent(host, interp, a0, loc)
        if id = PRIM_ANCESTOR
            return Primitive.ancestor(host, interp, a0, *(args + 1), loc)
        if id = PRIM_DESCENDANTS
            return Primitive.descendants(host, interp, a0, loc)

        ; --- sosofos ------------------------------------------------------
        if id = PRIM_IS_SOSOFO
            return interp.make_bool(a0.is_sosofo_p())
        if id = PRIM_EMPTY_SOSOFO
            return ELObj.make_empty_sosofo(host)
        if id = PRIM_SOSOFO_APPEND
            return Primitive.sosofo_append(host, interp, args, n_args, loc)

        interp.make_error()
    }

    function arg_error(interp: pointer[Interpreter], loc: Location) returns pointer[ELObj]
    {
        interp.set_next_location(loc)
        interp.make_error()
    }

    ; --- list helpers ------------------------------------------------------
    function build_list(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int) returns pointer[ELObj]
    {
        var result interp.make_nil()
        var i n_args - 1
        while i >= 0
        {
            set result: ELObj.make_pair(host, *(args + i), result)
            set i: i - 1
        }
        result
    }

    function list_length(host: pointer[Page], interp: pointer[Interpreter], obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        var n 0
        var p obj
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
                return Primitive.arg_error(interp, loc)
            set n: n + 1
            set p: p.get_cdr()
        }
        ELObj.make_integer(host, n)
    }

    function append_lists(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int) returns pointer[ELObj]
    {
        if n_args = 0
            return interp.make_nil()
        var result *(args + (n_args - 1))
        var i n_args - 2
        while i >= 0
        {
            ; prepend the elements of args[i] (reversed onto result)
            let tmp Primitive.reverse_list(host, interp, *(args + i))
            var p tmp
            while (p <> null) and (p.is_nil() = false)
            {
                set result: ELObj.make_pair(host, p.get_car(), result)
                set p: p.get_cdr()
            }
            set i: i - 1
        }
        result
    }

    function reverse_list(host: pointer[Page], interp: pointer[Interpreter], obj: pointer[ELObj]) returns pointer[ELObj]
    {
        var result interp.make_nil()
        var p obj
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
                return result
            set result: ELObj.make_pair(host, p.get_car(), result)
            set p: p.get_cdr()
        }
        result
    }

    function list_ref(interp: pointer[Interpreter], list: pointer[ELObj], k_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if k_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc)
        var k k_obj.exact_integer_value()
        var p list
        while k > 0
        {
            if p.is_pair() = false
                return Primitive.arg_error(interp, loc)
            set p: p.get_cdr()
            set k: k - 1
        }
        if p.is_pair() = false
            return Primitive.arg_error(interp, loc)
        p.get_car()
    }

    ; mode: 0 memq (eq/eqv-ptr), 1 memv (eqv), 2 member (equal).
    function member_of(interp: pointer[Interpreter], obj: pointer[ELObj], list: pointer[ELObj], mode: int) returns pointer[ELObj]
    {
        var p list
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
                return interp.make_false()
            let car p.get_car()
            var hit false
            if mode = 0
                set hit: car = obj
            else if mode = 1
                set hit: ELObj.eqv(car, obj)
            else
                set hit: ELObj.equal(car, obj)
            if hit
                return p
            set p: p.get_cdr()
        }
        interp.make_false()
    }

    function assq(interp: pointer[Interpreter], obj: pointer[ELObj], list: pointer[ELObj]) returns pointer[ELObj]
    {
        var p list
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
                return interp.make_false()
            let entry p.get_car()
            if entry.is_pair()
            {
                if entry.get_car() = obj
                    return entry
            }
            set p: p.get_cdr()
        }
        interp.make_false()
    }

    ; --- numeric core ------------------------------------------------------
    ; Accumulate args as exact-long while all operands are exact, promoting to
    ; double on the first inexact. Dimensions are not tracked in the starter
    ; set (numbers assumed dimensionless); length/quantity dims join later.
    function arith_add(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        var is_double false
        var lsum 0
        var dsum 0.0
        var i 0
        while i < n_args
        {
            let a *(args + i)
            let qv a.quantity_value()
            let qt qv.get_qtype()
            if qt = QT_NONE
                return Primitive.arg_error(interp, loc)
            if qt = QT_DOUBLE
            {
                if is_double = false
                {
                    set dsum: lsum as double
                    set is_double: true
                }
                set dsum: dsum + qv.get_dval()
            }
            else
            {
                if is_double
                    set dsum: dsum + (qv.get_lval() as double)
                else
                    set lsum: lsum + qv.get_lval()
            }
            set i: i + 1
        }
        if is_double
            return ELObj.make_real(host, dsum)
        ELObj.make_integer(host, lsum)
    }

    function arith_mul(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        var is_double false
        var lprod 1
        var dprod 1.0
        var i 0
        while i < n_args
        {
            let a *(args + i)
            let qv a.quantity_value()
            if qv.get_qtype() = QT_NONE
                return Primitive.arg_error(interp, loc)
            if qv.get_qtype() = QT_DOUBLE
            {
                if is_double = false
                {
                    set dprod: lprod as double
                    set is_double: true
                }
                set dprod: dprod * qv.get_dval()
            }
            else
            {
                if is_double
                    set dprod: dprod * (qv.get_lval() as double)
                else
                    set lprod: lprod * qv.get_lval()
            }
            set i: i + 1
        }
        if is_double
            return ELObj.make_real(host, dprod)
        ELObj.make_integer(host, lprod)
    }

    function arith_sub(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        let qv0 a0.quantity_value()
        if qv0.get_qtype() = QT_NONE
            return Primitive.arg_error(interp, loc)
        var is_double qv0.get_qtype() = QT_DOUBLE
        var lacc qv0.get_lval()
        var dacc qv0.get_dval()
        if is_double = false
            set dacc: lacc as double
        if n_args = 1
        {
            if is_double
                return ELObj.make_real(host, 0.0 - dacc)
            return ELObj.make_integer(host, 0 - lacc)
        }
        var i 1
        while i < n_args
        {
            let a *(args + i)
            let qv a.quantity_value()
            if qv.get_qtype() = QT_NONE
                return Primitive.arg_error(interp, loc)
            if qv.get_qtype() = QT_DOUBLE
            {
                if is_double = false
                {
                    set dacc: lacc as double
                    set is_double: true
                }
                set dacc: dacc - qv.get_dval()
            }
            else
            {
                if is_double
                    set dacc: dacc - (qv.get_lval() as double)
                else
                    set lacc: lacc - qv.get_lval()
            }
            set i: i + 1
        }
        if is_double
            return ELObj.make_real(host, dacc)
        ELObj.make_integer(host, lacc)
    }

    function arith_div(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        let qv0 a0.quantity_value()
        if qv0.get_qtype() = QT_NONE
            return Primitive.arg_error(interp, loc)
        var acc qv0.get_dval()
        if qv0.get_qtype() <> QT_DOUBLE
            set acc: qv0.get_lval() as double
        if n_args = 1
        {
            if acc = 0.0
                return Primitive.arg_error(interp, loc)
            return ELObj.make_real(host, 1.0 / acc)
        }
        var all_exact qv0.get_qtype() <> QT_DOUBLE
        var lnum qv0.get_lval()
        var i 1
        while i < n_args
        {
            let a *(args + i)
            let qv a.quantity_value()
            if qv.get_qtype() = QT_NONE
                return Primitive.arg_error(interp, loc)
            var d qv.get_dval()
            if qv.get_qtype() <> QT_DOUBLE
                set d: qv.get_lval() as double
            if d = 0.0
                return Primitive.arg_error(interp, loc)
            set acc: acc / d
            if qv.get_qtype() = QT_DOUBLE
                set all_exact: false
            else
            {
                if all_exact and ((lnum % qv.get_lval()) = 0)
                    set lnum: lnum / qv.get_lval()
                else
                    set all_exact: false
            }
            set i: i + 1
        }
        if all_exact
            return ELObj.make_integer(host, lnum)
        ELObj.make_real(host, acc)
    }

    ; op: 0 =, 1 <, 2 >, 3 <=, 4 >=. Chain comparison over adjacent operands.
    function compare(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int, loc: Location, op: int) returns pointer[ELObj]
    {
        var i 0
        while i < n_args - 1
        {
            let ea *(args + i)
            let eb *(args + i + 1)
            let a ea.quantity_value()
            let b eb.quantity_value()
            let aqt a.get_qtype()
            let bqt b.get_qtype()
            if (aqt = QT_NONE) or (bqt = QT_NONE)
                return Primitive.arg_error(interp, loc)
            var av a.get_dval()
            if aqt <> QT_DOUBLE
                set av: a.get_lval() as double
            var bv b.get_dval()
            if bqt <> QT_DOUBLE
                set bv: b.get_lval() as double
            var ok false
            if op = 0
                set ok: av = bv
            else if op = 1
                set ok: av < bv
            else if op = 2
                set ok: av > bv
            else if op = 3
                set ok: av <= bv
            else
                set ok: av >= bv
            if ok = false
                return interp.make_false()
            set i: i + 1
        }
        interp.make_true()
    }

    ; test: 0 zero?, 1 positive?, 2 negative?.
    function sign_test(interp: pointer[Interpreter], obj: pointer[ELObj], loc: Location, test: int) returns pointer[ELObj]
    {
        let qv obj.quantity_value()
        if qv.get_qtype() = QT_NONE
            return Primitive.arg_error(interp, loc)
        var v qv.get_dval()
        if qv.get_qtype() <> QT_DOUBLE
            set v: qv.get_lval() as double
        if test = 0
            return interp.make_bool(v = 0.0)
        if test = 1
            return interp.make_bool(v > 0.0)
        interp.make_bool(v < 0.0)
    }

    ; parity: 1 odd?, 0 even?.
    function parity_test(interp: pointer[Interpreter], obj: pointer[ELObj], loc: Location, want_odd: int) returns pointer[ELObj]
    {
        if obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc)
        let n obj.exact_integer_value()
        let r n % 2
        if want_odd = 1
            return interp.make_bool(r <> 0)
        interp.make_bool(r = 0)
    }

    function abs_val(host: pointer[Page], interp: pointer[Interpreter], obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        let qv obj.quantity_value()
        if qv.get_qtype() = QT_NONE
            return Primitive.arg_error(interp, loc)
        if qv.get_qtype() = QT_DOUBLE
        {
            var d qv.get_dval()
            if d < 0.0
                set d: 0.0 - d
            return ELObj.make_real(host, d)
        }
        var n qv.get_lval()
        if n < 0
            set n: 0 - n
        ELObj.make_integer(host, n)
    }

    ; op: 0 modulo, 1 remainder, 2 quotient.
    function int_div(host: pointer[Page], interp: pointer[Interpreter], a: pointer[ELObj], b: pointer[ELObj], loc: Location, op: int) returns pointer[ELObj]
    {
        if (a.is_exact_integer() = false) or (b.is_exact_integer() = false)
            return Primitive.arg_error(interp, loc)
        let x a.exact_integer_value()
        let y b.exact_integer_value()
        if y = 0
            return Primitive.arg_error(interp, loc)
        if op = 2
            return ELObj.make_integer(host, x / y)
        let r x % y
        if op = 1
            return ELObj.make_integer(host, r)
        ; modulo: result takes the sign of the divisor
        var m r
        if (m <> 0) and (((m < 0) and (y > 0)) or ((m > 0) and (y < 0)))
            set m: m + y
        ELObj.make_integer(host, m)
    }

    ; --- string primitives -------------------------------------------------
    ; string-append: concatenate the string-data of every argument.
    function string_append(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        var total: size_t 0
        var i 0
        while i < n_args
        {
            let a *(args + i)
            if a.has_string_data() = false
                return Primitive.arg_error(interp, loc)
            let s a.string_data(host)
            set total: total + s.get_size()
            set i: i + 1
        }
        if total = (0 as size_t)
            return ELObj.make_string(host, StringC())
        let buf host.allocate(total * (sizeof u32), alignof u32) as pointer[u32]
        var off: size_t 0
        var j 0
        while j < n_args
        {
            let a *(args + j)
            let s a.string_data(host)
            let m s.get_size()
            var k: size_t 0
            while k < m
            {
                set *(buf + off): s.get(k)
                set off: off + 1
                set k: k + 1
            }
            set j: j + 1
        }
        ELObj.make_string(host, StringC(buf, total))
    }

    function string_ref(host: pointer[Page], interp: pointer[Interpreter], obj: pointer[ELObj], k_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.has_string_data() = false
            return Primitive.arg_error(interp, loc)
        if k_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc)
        let s obj.string_data(host)
        let k k_obj.exact_integer_value()
        if (k < 0) or ((k as size_t) >= s.get_size())
            return Primitive.arg_error(interp, loc)
        ELObj.make_char(host, s.get(k as size_t))
    }

    function substring(host: pointer[Page], interp: pointer[Interpreter], obj: pointer[ELObj], s_obj: pointer[ELObj], e_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.has_string_data() = false
            return Primitive.arg_error(interp, loc)
        if (s_obj.is_exact_integer() = false) or (e_obj.is_exact_integer() = false)
            return Primitive.arg_error(interp, loc)
        let s obj.string_data(host)
        let start s_obj.exact_integer_value()
        let end e_obj.exact_integer_value()
        if (start < 0) or (end < start) or ((end as size_t) > s.get_size())
            return Primitive.arg_error(interp, loc)
        ELObj.make_string(host, s.substr(start as size_t, (end - start) as size_t))
    }

    ; string: build a string from char arguments.
    function string_from_chars(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        if n_args = 0
            return ELObj.make_string(host, StringC())
        let buf host.allocate((n_args as size_t) * (sizeof u32), alignof u32) as pointer[u32]
        var i 0
        while i < n_args
        {
            let a *(args + i)
            if a.is_char_p() = false
                return Primitive.arg_error(interp, loc)
            set *(buf + (i as size_t)): a.char_value() as u32
            set i: i + 1
        }
        ELObj.make_string(host, StringC(buf, n_args as size_t))
    }

    ; mode: 0 string=?, 1 string<?, 2 string<=?.
    function string_compare(interp: pointer[Interpreter], a: pointer[ELObj], b: pointer[ELObj], loc: Location, mode: int) returns pointer[ELObj]
    {
        let host interp.get_host()
        if (a.has_string_data() = false) or (b.has_string_data() = false)
            return Primitive.arg_error(interp, loc)
        let s1 a.string_data(host)
        let s2 b.string_data(host)
        let n1 s1.get_size()
        let n2 s2.get_size()
        if mode = 0
        {
            if n1 <> n2
                return interp.make_false()
            var i: size_t 0
            while i < n1
            {
                if s1.get(i) <> s2.get(i)
                    return interp.make_false()
                set i: i + 1
            }
            return interp.make_true()
        }
        var minlen n1
        if n2 < n1
            set minlen: n2
        var i: size_t 0
        while i < minlen
        {
            let c1 s1.get(i)
            let c2 s2.get(i)
            if c1 < c2
                return interp.make_true()
            if c1 > c2
                return interp.make_false()
            set i: i + 1
        }
        if mode = 1
            return interp.make_bool(n1 < n2)
        interp.make_bool(n1 <= n2)
    }

    function string_to_list(host: pointer[Page], interp: pointer[Interpreter], obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.has_string_data() = false
            return Primitive.arg_error(interp, loc)
        let s obj.string_data(host)
        var result interp.make_nil()
        var i s.get_size()
        while i > (0 as size_t)
        {
            set i: i - 1
            set result: ELObj.make_pair(host, ELObj.make_char(host, s.get(i)), result)
        }
        result
    }

    function list_to_string(host: pointer[Page], interp: pointer[Interpreter], obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        ; count chars first
        var n: size_t 0
        var p obj
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
                return Primitive.arg_error(interp, loc)
            let car p.get_car()
            if car.is_char_p() = false
                return Primitive.arg_error(interp, loc)
            set n: n + 1
            set p: p.get_cdr()
        }
        if n = (0 as size_t)
            return ELObj.make_string(host, StringC())
        let buf host.allocate(n * (sizeof u32), alignof u32) as pointer[u32]
        var i: size_t 0
        set p: obj
        while (p <> null) and (p.is_nil() = false)
        {
            let car p.get_car()
            set *(buf + i): car.char_value() as u32
            set i: i + 1
            set p: p.get_cdr()
        }
        ELObj.make_string(host, StringC(buf, n))
    }

    ; string->number: parse in the given radix (default 10). Non-numeric → #f.
    function string_to_number(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        if a0.has_string_data() = false
            return Primitive.arg_error(interp, loc)
        var radix 10
        if n_args > 1
        {
            let a1 *(args + 1)
            if a1.is_exact_integer() = false
                return Primitive.arg_error(interp, loc)
            set radix: a1.exact_integer_value()
            if (radix < 2) or (radix > 36)
                return Primitive.arg_error(interp, loc)
        }
        let s a0.string_data(host)
        let n s.get_size()
        if n = (0 as size_t)
            return interp.make_false()
        ; radix-10 with a '.'/'e'/'E' → parse as a real
        if radix = 10
        {
            var is_real false
            var i: size_t 0
            while i < n
            {
                let c s.get(i)
                if (c = (0x2E as u32)) or (c = (0x65 as u32)) or (c = (0x45 as u32))
                    set is_real: true
                set i: i + 1
            }
            if is_real
                return Primitive.parse_real(host, interp, s)
        }
        Primitive.parse_integer(host, interp, s, radix)
    }

    function parse_integer(host: pointer[Page], interp: pointer[Interpreter], s: StringC, radix: int) returns pointer[ELObj]
    {
        let n s.get_size()
        var i: size_t 0
        var neg false
        let first s.get(0 as size_t)
        if first = (0x2D as u32)
        {
            set neg: true
            set i: 1 as size_t
        }
        else if first = (0x2B as u32)
            set i: 1 as size_t
        if i >= n
            return interp.make_false()
        var acc 0
        while i < n
        {
            let c s.get(i)
            var d 0 - 1
            if (c >= (0x30 as u32)) and (c <= (0x39 as u32))
                set d: (c - (0x30 as u32)) as int
            else if (c >= (0x61 as u32)) and (c <= (0x7A as u32))
                set d: (c - (0x61 as u32)) as int + 10
            else if (c >= (0x41 as u32)) and (c <= (0x5A as u32))
                set d: (c - (0x41 as u32)) as int + 10
            if (d < 0) or (d >= radix)
                return interp.make_false()
            set acc: acc * radix + d
            set i: i + 1
        }
        if neg
            set acc: 0 - acc
        ELObj.make_integer(host, acc)
    }

    function parse_real(host: pointer[Page], interp: pointer[Interpreter], s: StringC) returns pointer[ELObj]
    {
        let n s.get_size()
        ; build a NUL-terminated ASCII byte buffer for strtod
        let buf host.allocate(n + (1 as size_t), 1 as size_t) as pointer[u8]
        var i: size_t 0
        while i < n
        {
            set *(buf + i): s.get(i) as u8
            set i: i + 1
        }
        set *(buf + n): 0 as u8
        var endp: pointer[u8] null
        let v strtod(buf as pointer[const_char], &endp)
        ; reject if not all consumed
        if endp <> (buf + n)
            return interp.make_false()
        ELObj.make_real(host, v)
    }

    ; number->string: print with radix (2/8/10/16 only; else radix 10).
    function number_to_string(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        if a0.is_number() = false
            return Primitive.arg_error(interp, loc)
        var radix 10
        if n_args > 1
        {
            let a1 *(args + 1)
            if a1.is_exact_integer() = false
                return Primitive.arg_error(interp, loc)
            let r a1.exact_integer_value()
            if (r = 2) or (r = 8) or (r = 10) or (r = 16)
                set radix: r
            else
                set radix: 10
        }
        let os OutputCharStream.make(host)
        a0.print_radix(os, radix as u32, interp.get_units_per_inch())
        ELObj.make_string(host, os.to_string_c(host))
    }

    ; --- char primitives ---------------------------------------------------
    function integer_to_char(host: pointer[Page], interp: pointer[Interpreter], obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc)
        let n obj.exact_integer_value()
        if (n < 0) or (n > 0x10FFFF)
            return Primitive.arg_error(interp, loc)
        ELObj.make_char(host, n as u32)
    }

    ; mode: 0 char=?, 1 char<?, 2 char<=?.
    function char_compare(interp: pointer[Interpreter], a: pointer[ELObj], b: pointer[ELObj], loc: Location, mode: int) returns pointer[ELObj]
    {
        if (a.is_char_p() = false) or (b.is_char_p() = false)
            return Primitive.arg_error(interp, loc)
        let c1 a.char_value()
        let c2 b.char_value()
        if mode = 0
            return interp.make_bool(c1 = c2)
        if mode = 1
            return interp.make_bool(c1 < c2)
        interp.make_bool(c1 <= c2)
    }

    ; char-upcase / char-downcase — the default language's ASCII case fold
    ; (no declared language ⇒ C-locale behaviour; a-z <-> A-Z only).
    function char_case(host: pointer[Page], interp: pointer[Interpreter], obj: pointer[ELObj], loc: Location, up: bool) returns pointer[ELObj]
    {
        if obj.is_char_p() = false
            return Primitive.arg_error(interp, loc)
        var c obj.char_value()
        if up
        {
            if (c >= 0x61) and (c <= 0x7A)
                set c: c - 0x20
        }
        else
        {
            if (c >= 0x41) and (c <= 0x5A)
                set c: c + 0x20
        }
        ELObj.make_char(host, c as u32)
    }

    ; --- vector primitives -------------------------------------------------
    function make_vector_prim(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        if a0.is_exact_integer() = false
            return Primitive.arg_error(interp, loc)
        let k a0.exact_integer_value()
        if k < 0
            return Primitive.arg_error(interp, loc)
        var fill interp.make_false()
        if n_args > 1
            set fill: *(args + 1)
        ELObj.make_vector(host, k as size_t, fill)
    }

    function vector_ref(interp: pointer[Interpreter], obj: pointer[ELObj], k_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.is_vector_p() = false
            return Primitive.arg_error(interp, loc)
        if k_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc)
        let k k_obj.exact_integer_value()
        if (k < 0) or ((k as size_t) >= obj.vector_length())
            return Primitive.arg_error(interp, loc)
        obj.vector_elem(k as size_t)
    }

    function vector_set(interp: pointer[Interpreter], obj: pointer[ELObj], k_obj: pointer[ELObj], val: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.is_vector_p() = false
            return Primitive.arg_error(interp, loc)
        if k_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc)
        let k k_obj.exact_integer_value()
        if (k < 0) or ((k as size_t) >= obj.vector_length())
            return Primitive.arg_error(interp, loc)
        obj.vector_set_elem(k as size_t, val)
        interp.make_unspecified()
    }

    function vector_to_list(host: pointer[Page], interp: pointer[Interpreter], obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.is_vector_p() = false
            return Primitive.arg_error(interp, loc)
        var result interp.make_nil()
        var i obj.vector_length()
        while i > (0 as size_t)
        {
            set i: i - 1
            set result: ELObj.make_pair(host, obj.vector_elem(i), result)
        }
        result
    }

    function list_to_vector(host: pointer[Page], interp: pointer[Interpreter], obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        var n: size_t 0
        var p obj
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
                return Primitive.arg_error(interp, loc)
            set n: n + 1
            set p: p.get_cdr()
        }
        let vec ELObj.make_vector(host, n, interp.make_false())
        var i: size_t 0
        set p: obj
        while (p <> null) and (p.is_nil() = false)
        {
            vec.vector_set_elem(i, p.get_car())
            set i: i + 1
            set p: p.get_cdr()
        }
        vec
    }

    ; list-tail: drop the first k pairs.
    function list_tail(interp: pointer[Interpreter], obj: pointer[ELObj], k_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if k_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc)
        var k k_obj.exact_integer_value()
        if k < 0
            return Primitive.arg_error(interp, loc)
        var p obj
        while k > 0
        {
            if p.is_pair() = false
                return Primitive.arg_error(interp, loc)
            set p: p.get_cdr()
            set k: k - 1
        }
        p
    }

    ; --- grove / node-list helpers -----------------------------------------
    function node_list_ref(host: pointer[Page], interp: pointer[Interpreter], nl: pointer[ELObj], k_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc)
        if k_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc)
        let k k_obj.exact_integer_value()
        if (k < 0) or (k >= nl.node_list_count())
            return ELObj.make_node_list(host, null, 0)
        ELObj.make_node_singleton(host, nl.node_list_node(k))
    }

    ; node-list: concatenate the argument node-lists into one buffer.
    function node_list_concat(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let arr Array[pointer[GroveNode]]^host()
        var i 0
        while i < n_args
        {
            let a *(args + i)
            if a.is_node_list_p() = false
                return Primitive.arg_error(interp, loc)
            let c a.node_list_count()
            var j 0
            while j < c
            {
                arr.add(a.node_list_node(j))
                set j: j + 1
            }
            set i: i + 1
        }
        ELObj.make_node_list(host, arr, 0)
    }

    ; children: the child axis of the first node (empty if none / not present).
    function children(host: pointer[Page], interp: pointer[Interpreter], nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc)
        let node nl.node_list_node(0)
        if node = null
            return ELObj.make_node_list(host, null, 0)
        let ch node.get_children()
        if ch = null
            return ELObj.make_node_list(host, null, 0)
        ELObj.make_node_list(host, ch, 0)
    }

    ; gi: the generic identifier of the first node (an element), else #f.
    function node_gi(host: pointer[Page], interp: pointer[Interpreter], nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc)
        let node nl.node_list_node(0)
        if node = null
            return interp.make_false()
        if node.get_class() <> GN_ELEMENT
            return interp.make_false()
        let g node.get_gi()
        ELObj.make_string(host, g)
    }

    ; data: the string value — all descendant data of the first node, joined.
    function node_data(host: pointer[Page], interp: pointer[Interpreter], nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc)
        let node nl.node_list_node(0)
        if node = null
            return ELObj.make_string(host, StringC())
        let total Primitive.collect_data_len(node)
        if total = (0 as size_t)
            return ELObj.make_string(host, StringC())
        let buf host.allocate(total * (sizeof u32), alignof u32) as pointer[u32]
        Primitive.collect_data_fill(node, buf, 0 as size_t)
        ELObj.make_string(host, StringC(buf, total))
    }

    ; --- property axis (Inc 4) ---------------------------------------------
    ; A GI / attribute-name argument may arrive as a string or a symbol; both
    ; carry a name StringC (else empty). Single construction site + one tail
    ; return (a by-value struct returned from multiple branches region-allocates
    ; per site and the merging phi fails llc verification).
    function name_arg(host: pointer[Page], obj: pointer[ELObj]) returns StringC
    {
        var result StringC()
        if obj.is_string_p()
            set result: obj.string_data(host)
        else if obj.is_symbol_p()
            set result: obj.symbol_name()
        result
    }

    ; parent: the parent axis of the first node (empty for the grove root /
    ; a node with no parent).
    function node_parent(host: pointer[Page], interp: pointer[Interpreter], nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc)
        let node nl.node_list_node(0)
        if node = null
            return ELObj.make_node_list(host, null, 0)
        let p node.get_parent()
        if p = null
            return ELObj.make_node_list(host, null, 0)
        ELObj.make_node_singleton(host, p)
    }

    ; attribute-string is DEFERRED — blocked on an emitter bug: an sret-returning
    ; helper that binds an sret method-call result (the opensp AttributeValue/Text
    ; value chain) truncates (emits `ret` with the sret slot unfilled → garbage /
    ; SIGSEGV). See the PRIM_* block above and memory dazzle-crosspkg-struct-layout-bug.

    ; ancestor: the nearest ancestor element of the first node whose GI equals
    ; the given name, or the empty node-list.
    function ancestor(host: pointer[Page], interp: pointer[Interpreter], gi_obj: pointer[ELObj], nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc)
        let node nl.node_list_node(0)
        if node = null
            return ELObj.make_node_list(host, null, 0)
        let target Primitive.name_arg(host, gi_obj)
        var cur node.get_parent()
        while cur <> null
        {
            if cur.get_class() = GN_ELEMENT
            {
                let g cur.get_gi()
                if g.equals(target)
                    return ELObj.make_node_singleton(host, cur)
            }
            set cur: cur.get_parent()
        }
        ELObj.make_node_list(host, null, 0)
    }

    ; descendants: every descendant of the first node, in document order
    ; (self excluded).
    function descendants(host: pointer[Page], interp: pointer[Interpreter], nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc)
        let node nl.node_list_node(0)
        if node = null
            return ELObj.make_node_list(host, null, 0)
        let arr Array[pointer[GroveNode]]^host()
        Primitive.collect_descendants(node, arr)
        ELObj.make_node_list(host, arr, 0)
    }

    function collect_descendants(node: pointer[GroveNode], arr: pointer[Array[pointer[GroveNode]]])
    {
        let n node.child_count()
        var i 0
        while i < n
        {
            let ch node.child_at(i)
            arr.add(ch)
            Primitive.collect_descendants(ch, arr)
            set i: i + 1
        }
    }

    function collect_data_len(node: pointer[GroveNode]) returns size_t
    {
        if node = null
            return 0 as size_t
        if node.get_class() = GN_DATA
        {
            let c node.get_chars()
            return c.get_size()
        }
        var total: size_t 0
        let n node.child_count()
        var i 0
        while i < n
        {
            let ch node.child_at(i)
            set total: total + Primitive.collect_data_len(ch)
            set i: i + 1
        }
        total
    }

    ; sosofo-append: flatten the argument sosofos' parts into one sosofo.
    function sosofo_append(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let parts Array[pointer[ELObj]]^host()
        var i 0
        while i < n_args
        {
            let a *(args + i)
            if a.is_sosofo_p() = false
                return Primitive.arg_error(interp, loc)
            let sub a.sosofo_parts()
            if sub <> null
            {
                let sb sub.get_buffer()
                let m sub.get_length()
                var j: size_t 0
                while j < m
                {
                    parts.add(*(sb + j))
                    set j: j + 1
                }
            }
            set i: i + 1
        }
        ELObj.make_sosofo(host, parts)
    }

    function collect_data_fill(node: pointer[GroveNode], buf: pointer[u32], off: size_t) returns size_t
    {
        if node = null
            return off
        if node.get_class() = GN_DATA
        {
            let c node.get_chars()
            let m c.get_size()
            var k: size_t 0
            var o off
            while k < m
            {
                set *(buf + o): c.get(k)
                set o: o + 1
                set k: k + 1
            }
            return o
        }
        var o off
        let n node.child_count()
        var i 0
        while i < n
        {
            let ch node.child_at(i)
            set o: Primitive.collect_data_fill(ch, buf, o)
            set i: i + 1
        }
        o
    }
}
