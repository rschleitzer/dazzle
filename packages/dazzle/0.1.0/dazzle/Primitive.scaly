; color-space kinds (ColorSpaceObjRec.kind)
define CS_RGB: int 0
define CS_GRAY: int 1
define CS_CMYK: int 2
define CS_KX: int 3
define CS_LUV: int 4
define CS_LAB: int 5
define CS_ABC: int 6
define CS_A: int 7

; the CIE color-space data (XYZData + the per-kind extras, one flat record;
; every pointer is a host-allocated double/ELObj* buffer of the noted size).
define CieData
(
    xyz: pointer[double]              ; 14: white[3], white_u, white_v, M[9]
    range: pointer[double]            ; 6 (LUV/LAB)
    range_abc: pointer[double]        ; 6
    decode_abc: pointer[pointer[ELObj]] ; 3 (null entries = identity)
    matrix_abc: pointer[double]       ; 9
    range_lmn: pointer[double]        ; 6
    decode_lmn: pointer[pointer[ELObj]] ; 3
    matrix_lmn: pointer[double]       ; 9
    range_a: pointer[double]          ; 2
    decode_a: pointer[ELObj]
    matrix_a: pointer[double]         ; 3
)
{
    function make(host: pointer[Page]) returns pointer[CieData]
    {
        let d host.allocate(sizeof CieData, alignof CieData) as pointer[CieData]
        set d.xyz: null
        set d.range: null
        set d.range_abc: null
        set d.decode_abc: null
        set d.matrix_abc: null
        set d.range_lmn: null
        set d.decode_lmn: null
        set d.matrix_lmn: null
        set d.range_a: null
        set d.decode_a: null
        set d.matrix_a: null
        d
    }
}

define Primitive
{
    ; primitiveCall dispatch. args points into the VM value stack (n_args
    ; slots). An error result is interp.makeError(); the VM turns it into the
    ; error unwind.
    function dispatch(id: int, name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], interp: pointer[Interpreter], loc: Location) returns pointer[ELObj]
    {
        let host interp.get_host()
        let a0 *args
        if id = PRIM_CONS
            return ELObj.make_pair(host, *args, *(args + 1))
        if id = PRIM_LIST
            return Primitive.build_list(host, interp, args, n_args)
        if id = PRIM_CAR
        {
            if a0.is_pair() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAPair(), name, 0, a0)
            return a0.get_car()
        }
        if id = PRIM_CDR
        {
            if a0.is_pair() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAPair(), name, 0, a0)
            return a0.get_cdr()
        }
        if id = PRIM_IS_NULL
            return interp.make_bool(a0.is_nil())
        if id = PRIM_IS_PAIR
            return interp.make_bool(a0.is_pair())
        if id = PRIM_IS_LIST
            return interp.make_bool(a0.is_list())
        if id = PRIM_LENGTH
            return Primitive.list_length(host, interp, name, *args, loc)
        if id = PRIM_APPEND
            return Primitive.append_lists(host, interp, name, args, n_args, loc)
        if id = PRIM_REVERSE
            return Primitive.reverse_list(host, interp, name, *args, loc)
        if id = PRIM_LIST_REF
            return Primitive.list_ref(interp, name, *args, *(args + 1), loc)
        if id = PRIM_MEMV
            return Primitive.member_of(interp, name, *args, *(args + 1), 1, loc)
        if id = PRIM_MEMBER
            return Primitive.member_of(interp, name, *args, *(args + 1), 2, loc)
        if id = PRIM_ASSOC
            return Primitive.assoc(interp, name, *args, *(args + 1), loc)
        if id = PRIM_IS_EQUAL
            return interp.make_bool(ELObj.equal(*args, *(args + 1)))
        if id = PRIM_IS_EQV
            return interp.make_bool(ELObj.eqv(*args, *(args + 1)))
        if id = PRIM_NOT
            return interp.make_bool(a0.is_true() = false)
        if id = PRIM_IS_NUMBER
            return interp.make_bool(a0.is_number())
        if id = PRIM_IS_INTEGER
            return interp.make_bool(a0.is_integer_p())
        if id = PRIM_IS_REAL
            return interp.make_bool(a0.is_real())
        if id = PRIM_IS_STRING
            return interp.make_bool(a0.is_string_p())
        if id = PRIM_IS_SYMBOL
            return interp.make_bool(a0.is_symbol_p())
        if id = PRIM_IS_CHAR
            return interp.make_bool(a0.is_char_p())
        if id = PRIM_IS_KEYWORD
            return interp.make_bool(a0.is_keyword_p())
        if id = PRIM_IS_BOOLEAN
            return interp.make_bool(a0.is_boolean_p())
        if id = PRIM_IS_VECTOR
            return interp.make_bool(a0.is_vector_p())
        if id = PRIM_IS_PROCEDURE
            return interp.make_bool(a0.is_function())

        ; --- arithmetic ----------------------------------------------------
        if id = PRIM_PLUS
            return Primitive.arith_add(host, interp, name, args, n_args, loc)
        if id = PRIM_TIMES
            return Primitive.arith_mul(host, interp, name, args, n_args, loc)
        if id = PRIM_MINUS
            return Primitive.arith_sub(host, interp, name, args, n_args, loc)
        if id = PRIM_DIVIDE
            return Primitive.arith_div(host, interp, name, args, n_args, loc)
        if id = PRIM_NUM_EQ
            return Primitive.compare(host, interp, name, args, n_args, loc, 0)
        if id = PRIM_LESS
            return Primitive.compare(host, interp, name, args, n_args, loc, 1)
        if id = PRIM_GREATER
            return Primitive.compare(host, interp, name, args, n_args, loc, 2)
        if id = PRIM_LESS_EQ
            return Primitive.compare(host, interp, name, args, n_args, loc, 3)
        if id = PRIM_GREATER_EQ
            return Primitive.compare(host, interp, name, args, n_args, loc, 4)
        if id = PRIM_IS_ZERO
            return Primitive.sign_test(interp, name, *args, loc, 0)
        if id = PRIM_IS_POSITIVE
            return Primitive.sign_test(interp, name, *args, loc, 1)
        if id = PRIM_IS_NEGATIVE
            return Primitive.sign_test(interp, name, *args, loc, 2)
        if id = PRIM_IS_ODD
            return Primitive.parity_test(interp, name, *args, loc, 1)
        if id = PRIM_IS_EVEN
            return Primitive.parity_test(interp, name, *args, loc, 0)
        if id = PRIM_ABS
            return Primitive.abs_val(host, interp, name, *args, loc)
        if id = PRIM_MODULO
            return Primitive.int_div(host, interp, name, *args, *(args + 1), loc, 0)
        if id = PRIM_REMAINDER
            return Primitive.int_div(host, interp, name, *args, *(args + 1), loc, 1)
        if id = PRIM_QUOTIENT
            return Primitive.int_div(host, interp, name, *args, *(args + 1), loc, 2)

        ; --- string / char / symbol / keyword / vector --------------------
        if id = PRIM_SYMBOL_TO_STRING
        {
            if a0.is_symbol_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASymbol(), name, 0, a0)
            return ELObj.make_string(host, a0.symbol_name())
        }
        if id = PRIM_STRING_TO_SYMBOL
        {
            if a0.has_string_data() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
            return interp.make_symbol(a0.string_data(host))
        }
        if id = PRIM_KEYWORD_TO_STRING
        {
            if a0.is_keyword_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAKeyword(), name, 0, a0)
            return ELObj.make_string(host, a0.keyword_name())
        }
        if id = PRIM_STRING_TO_KEYWORD
        {
            if a0.has_string_data() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
            return interp.make_keyword(a0.string_data(host))
        }
        if id = PRIM_STRING_APPEND
            return Primitive.string_append(host, interp, name, args, n_args, loc)
        if id = PRIM_STRING_LENGTH
        {
            if a0.has_string_data() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
            ; string_size, not string_data: don't flatten a rope for its length
            let sl0 a0.string_size()
            return ELObj.make_integer(host, sl0 as int)
        }
        if id = PRIM_STRING_REF
            return Primitive.string_ref(host, interp, name, a0, *(args + 1), loc)
        if id = PRIM_SUBSTRING
            return Primitive.substring(host, interp, name, a0, *(args + 1), *(args + 2), loc)
        if id = PRIM_STRING
            return Primitive.string_from_chars(host, interp, name, args, n_args, loc)
        if id = PRIM_STRING_EQUAL
            return Primitive.string_compare(interp, name, a0, *(args + 1), loc, 0, ctx)
        if id = PRIM_STRING_LESS
            return Primitive.string_compare(interp, name, a0, *(args + 1), loc, 1, ctx)
        if id = PRIM_STRING_LESS_EQ
            return Primitive.string_compare(interp, name, a0, *(args + 1), loc, 2, ctx)
        if id = PRIM_STRING_TO_LIST
            return Primitive.string_to_list(host, interp, name, a0, loc)
        if id = PRIM_LIST_TO_STRING
            return Primitive.list_to_string(host, interp, name, a0, loc)
        if id = PRIM_STRING_TO_NUMBER
            return Primitive.string_to_number(host, interp, name, args, n_args, loc)
        if id = PRIM_NUMBER_TO_STRING
            return Primitive.number_to_string(host, interp, name, args, n_args, loc)
        if id = PRIM_CHAR_LESS
            return Primitive.char_compare(interp, name, a0, *(args + 1), loc, 1, ctx)
        if id = PRIM_CHAR_LESS_EQ
            return Primitive.char_compare(interp, name, a0, *(args + 1), loc, 2, ctx)
        if id = PRIM_CHAR_EQUAL
            return Primitive.char_compare(interp, name, a0, *(args + 1), loc, 0, ctx)
        if id = PRIM_CHAR_UPCASE
            return Primitive.char_case(host, interp, name, a0, loc, true, ctx)
        if id = PRIM_CHAR_DOWNCASE
            return Primitive.char_case(host, interp, name, a0, loc, false, ctx)
        if id = PRIM_MAKE_VECTOR
            return Primitive.make_vector_prim(host, interp, name, args, n_args, loc)
        if id = PRIM_VECTOR
            return ELObj.make_vector_of(host, args, n_args as size_t)
        if id = PRIM_VECTOR_REF
            return Primitive.vector_ref(interp, name, a0, *(args + 1), loc)
        if id = PRIM_VECTOR_SET
            return Primitive.vector_set(interp, name, a0, *(args + 1), *(args + 2), loc)
        if id = PRIM_VECTOR_FILL
            return Primitive.vector_fill(interp, name, a0, *(args + 1), loc)
        if id = PRIM_VECTOR_TO_LIST
            return Primitive.vector_to_list(host, interp, name, a0, loc)
        if id = PRIM_LIST_TO_VECTOR
            return Primitive.list_to_vector(host, interp, name, a0, loc)
        if id = PRIM_LIST_TAIL
            return Primitive.list_tail(interp, name, a0, *(args + 1), loc)

        ; --- grove / node-list --------------------------------------------
        if id = PRIM_IS_NODE_LIST
            return interp.make_bool(a0.is_node_list_p())
        if id = PRIM_NODE_LIST_EMPTY
        {
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, a0)
            return interp.make_bool(a0.node_list_count() = 0)
        }
        if id = PRIM_NODE_LIST_LENGTH
        {
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, a0)
            return ELObj.make_integer(host, a0.node_list_count())
        }
        if id = PRIM_NODE_LIST_FIRST
        {
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, a0)
            if a0.node_list_count() = 0
                return ELObj.make_node_list(host, null, 0)
            return ELObj.make_node_singleton(host, a0.node_list_node(0))
        }
        if id = PRIM_NODE_LIST_REST
        {
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, a0)
            let buf a0.node_list_buffer()
            let px a0.node_list_prefix()
            let st a0.node_list_start()
            if a0.node_list_count() = 0
                return ELObj.make_node_list_prefix(host, buf, st, px)
            return ELObj.make_node_list_prefix(host, buf, st + 1, px)
        }
        if id = PRIM_NODE_LIST_REF
            return Primitive.node_list_ref(host, interp, name, a0, *(args + 1), loc)
        if id = PRIM_EMPTY_NODE_LIST
            return ELObj.make_node_list(host, null, 0)
        if id = PRIM_NODE_LIST
            return Primitive.node_list_concat(host, interp, name, args, n_args, loc)
        if id = PRIM_CHILDREN
            return Primitive.children(host, interp, name, a0, loc)
        if id = PRIM_GI
        {
            ; (0,1,0): without the optional osnl arg, the current node — whose
            ; absence is the noCurrentNode error (DEFPRIMITIVE Gi).
            if n_args = 0
            {
                let cn ctx.get_current_node()
                if cn = null
                    return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
                return Primitive.node_gi(host, interp, name, ELObj.make_node_singleton(host, cn), loc)
            }
            return Primitive.node_gi(host, interp, name, a0, loc)
        }
        if id = PRIM_DATA
            return Primitive.node_data(host, interp, name, a0, loc)

        ; --- grove / property axis ----------------------------------------
        if id = PRIM_PARENT
        {
            ; (0,1,0): defaulted arg = the current node (DEFPRIMITIVE Parent).
            if n_args = 0
            {
                let cn ctx.get_current_node()
                if cn = null
                    return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
                return Primitive.node_parent(host, interp, name, ELObj.make_node_singleton(host, cn), loc)
            }
            return Primitive.node_parent(host, interp, name, a0, loc)
        }
        if id = PRIM_ATTRIBUTE_STRING
        {
            ; (1,1,0): the name, then the optional osnl (default current node
            ; — noCurrentNode when absent). DEFPRIMITIVE AttributeString.
            if n_args < 2
            {
                let cn ctx.get_current_node()
                if cn = null
                    return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
                return Primitive.attribute_string(host, interp, name, a0, ELObj.make_node_singleton(host, cn), loc)
            }
            return Primitive.attribute_string(host, interp, name, a0, *(args + 1), loc)
        }
        if id = PRIM_ANCESTOR
        {
            ; (1,1,0): the gi, then the optional singleton node (default
            ; current node). DEFPRIMITIVE Ancestor.
            if n_args < 2
            {
                let cn ctx.get_current_node()
                if cn = null
                    return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
                return Primitive.ancestor(host, interp, name, a0, ELObj.make_node_singleton(host, cn), loc)
            }
            return Primitive.ancestor(host, interp, name, a0, *(args + 1), loc)
        }
        if id = PRIM_DESCENDANTS
            return Primitive.descendants(host, interp, name, a0, loc)

        ; --- sosofos ------------------------------------------------------
        if id = PRIM_IS_SOSOFO
            return interp.make_bool(a0.is_sosofo_p())
        if id = PRIM_EMPTY_SOSOFO
            return ELObj.make_empty_sosofo(host)
        if id = PRIM_SOSOFO_APPEND
            return Primitive.sosofo_append(host, interp, name, args, n_args, loc)

        ; --- style engine (Inc 5): construction-rule sosofos --------------
        ; the process-* sosofos capture the VM's processing mode (reference:
        ; context.processingMode), so with-mode brackets take effect.
        if id = PRIM_PROCESS_CHILDREN
            return ELObj.make_process_children_sosofo(host, false, ctx.get_processing_mode())
        if id = PRIM_PROCESS_CHILDREN_TRIM
            return ELObj.make_process_children_sosofo(host, true, ctx.get_processing_mode())
        if id = PRIM_NEXT_MATCH
        {
            ; (0,1,0): DEFPRIMITIVE NextMatch — no current processing mode is
            ; an error; the optional arg is an overriding style.
            if ctx.get_processing_mode() = null
            {
                interp.set_next_location(loc)
                interp.message0(InterpreterMessages.noCurrentProcessingMode())
                return interp.make_error()
            }
            if n_args > 0
            {
                if a0.is_style_p() = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notAStyle(), name, 0, a0)
                ; the vm.overridingStyle machinery (MaybeOverrideStyleInsn /
                ; OverriddenStyleObj) is not ported — no real-world corpus
                ; stylesheet passes a style here. LOUD, never silent.
                interp.set_next_location(loc)
                interp.message1(InterpreterMessages.errorProc(), StringC("next-match with an overriding style is not ported"))
                return interp.make_error()
            }
            return ELObj.make_next_match_sosofo(host)
        }
        if id = PRIM_CURRENT_NODE
        {
            let cn ctx.get_current_node()
            if cn = null
                return ELObj.make_node_list(host, null, 0)
            return ELObj.make_node_singleton(host, cn)
        }
        if id = PRIM_LITERAL
        {
            ; (0,0,1): DEFPRIMITIVE Literal — no args = the empty sosofo;
            ; several strings concatenate into one literal (args verified in
            ; order, so the diagnostic indexes match the reference).
            if n_args = 0
                return ELObj.make_empty_sosofo(host)
            if a0.has_string_data() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
            if n_args = 1
                return ELObj.make_literal_sosofo(host, a0)
            var total: size_t a0.string_size() as size_t
            var i 1
            while i < n_args
            {
                let ai *(args + i)
                if ai.has_string_data() = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, i, ai)
                set total: total + (ai.string_size() as size_t)
                set i: i + 1
            }
            let buf host.allocate(total * (sizeof u32), alignof u32) as pointer[u32]
            var off: size_t 0
            var j 0
            while j < n_args
            {
                let aj *(args + j)
                let s aj.string_data(host)
                let m s.get_size()
                var k: size_t 0
                while k < m
                {
                    set *(buf + off): s.get(k)
                    set off: off + 1
                    set k: k + 1
                }
                set j: j + 1
            }
            return ELObj.make_literal_sosofo(host, ELObj.make_string(host, StringC(buf, total)))
        }
        if id = PRIM_PROCESS_NODE_LIST
        {
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, a0)
            return ELObj.make_process_node_list_sosofo(host, a0, ctx.get_processing_mode())
        }
        if (id = PRIM_INHERITED_C) or (id = PRIM_ACTUAL_C)
        {
            ; InheritedCPrimitiveObj / ActualCPrimitiveObj::primitiveCall.
            let ss ctx.get_style_stack()
            if ss = null
            {
                interp.set_next_location(loc)
                interp.message0(InterpreterMessages.notInCharacteristicValue())
                return interp.make_error()
            }
            var plen: size_t 10
            if id = PRIM_ACTUAL_C
                set plen: 7
            let base interp.lookup(StringC(name.data_ptr() + plen, name.get_size() - plen))
            let icraw base.get_inherited_c()
            if icraw = null
                return interp.make_error()
            let ic icraw as pointer[InheritedC]
            if id = PRIM_INHERITED_C
                return VM.stack_inherited(ss, ic, ctx.get_spec_level(), interp, ctx.get_actual_deps())
            return VM.stack_actual(ss, ic, loc, interp, ctx.get_actual_deps())
        }
        if id = PRIM_PAGE_NUMBER_SOSOFO
            return ELObj.make_page_number_sosofo(host)
        if id = PRIM_CURRENT_NODE_PAGE_NUMBER_SOSOFO
        {
            let cn ctx.get_current_node()
            if cn = null
                return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
            return ELObj.make_current_node_page_number_sosofo(host, cn)
        }
        if id = PRIM_EXTERNAL_PROCEDURE
        {
            if a0.has_string_data() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
            let pubid a0.string_data(host)
            let func interp.lookup_external_proc(pubid)
            if func = null
                return interp.make_bool(false)
            return func
        }
        if (id = PRIM_IF_FIRST_PAGE) or (id = PRIM_IF_FRONT_PAGE)
        {
            var i 0
            while i < 2
            {
                let a *(args + i)
                if a.is_sosofo_p() = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notASosofo(), name, i, a)
                set i: i + 1
            }
            var flag 1
            if id = PRIM_IF_FRONT_PAGE
                set flag: 2
            return ELObj.make_page_type_sosofo(host, flag, a0, *(args + 1))
        }
        if id = PRIM_SELECT_ELEMENTS
            return Primitive.select_elements(host, interp, name, a0, *(args + 1), loc)
        if id = PRIM_ELEMENT_WITH_ID
            return Primitive.element_with_id(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_ID
            return Primitive.node_id(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_IS_FIRST_SIBLING
            return Primitive.is_first_sibling(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_IS_LAST_SIBLING
            return Primitive.is_last_sibling(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_CHILD_NUMBER
            return Primitive.child_number(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_IS_NODE_LIST_EQUAL
            return Primitive.node_list_equal(interp, name, a0, *(args + 1), loc)
        if id = PRIM_NODE_LIST_MAP
            return Primitive.node_list_map(host, interp, name, a0, *(args + 1), ctx, loc)
        if id = PRIM_NODE_LIST_REVERSE
            return Primitive.node_list_reverse_prim(host, interp, name, a0, loc)
        if id = PRIM_NODE_PROPERTY
            return Primitive.node_property(host, interp, name, n_args, args, loc)

        ; --- length-spec / space / color (Family-B front) --------------------
        if id = PRIM_DISPLAY_SIZE
            return ELObj.make_length_spec(host, 0.0, 1.0, 0.0)
        if id = PRIM_TABLE_UNIT
        {
            if a0.is_integer_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 0, a0)
            return ELObj.make_length_spec(host, 0.0, 0.0, a0.exact_integer_value() as double)
        }
        if id = PRIM_IS_DISPLAY_SPACE
            return interp.make_bool(a0.as_display_space() <> null)
        if id = PRIM_DISPLAY_SPACE
            return Primitive.display_space_prim(host, interp, name, args, n_args, loc)
        if id = PRIM_IS_INLINE_SPACE
            return interp.make_bool(a0.as_inline_space() <> null)
        if id = PRIM_INLINE_SPACE
            return Primitive.inline_space_prim(host, interp, name, args, n_args, loc)
        if id = PRIM_IS_COLOR
            return interp.make_bool(a0.is_color_p())
        if id = PRIM_IS_COLOR_SPACE
            return interp.make_bool(a0.is_color_space_p())
        if id = PRIM_COLOR
        {
            if a0.is_color_space_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAColorSpace(), name, 0, a0)
            return Primitive.make_color_from_space(host, interp, a0, n_args - 1, args + 1, loc)
        }
        if id = PRIM_COLOR_SPACE
            return Primitive.color_space_prim(host, interp, name, args, n_args, loc)

        ; --- glyph ids / glyph substitution tables ---------------------------
        if id = PRIM_IS_GLYPH_ID
            return interp.make_bool(a0.is_glyph_id_p())
        if id = PRIM_GLYPH_ID
        {
            if a0.has_string_data() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
            return Primitive.convert_glyph_id(host, interp, a0.string_data(host), loc)
        }
        if id = PRIM_IS_GLYPH_SUBST_TABLE
            return interp.make_bool(a0.as_glyph_subst_table() <> null)
        if id = PRIM_GLYPH_SUBST_TABLE
            return Primitive.glyph_subst_table_prim(host, interp, name, a0, loc)
        if id = PRIM_GLYPH_SUBST
        {
            let table a0.as_glyph_subst_table()
            if table = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAGlyphSubstTable(), name, 0, a0)
            let a1 *(args + 1)
            if a1.is_glyph_id_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAGlyphId(), name, 1, a1)
            return table.subst(a1)
        }
        if id = PRIM_FORMAT_NUMBER
            return Primitive.format_number_prim(host, interp, name, args, loc)
        if id = PRIM_FORMAT_NUMBER_LIST
            return Primitive.format_number_list_prim(host, interp, name, args, loc)
        if id = PRIM_ERROR
        {
            ; DEFPRIMITIVE Error: strict string arg, message errorProc ("%1"),
            ; result is the error object (the VM unwinds).
            if a0.has_string_data() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
            interp.set_next_location(loc)
            interp.message1(InterpreterMessages.errorProc(), a0.string_data(host))
            return interp.make_error()
        }
        if id = PRIM_NODE_LIST_ERROR
        {
            ; DEFPRIMITIVE NodeListError: like error, but anchored at the
            ; singleton node's location when the arg has one. Our grove nodes
            ; carry no Location (LocNode::convert fails in the reference for
            ; location-less nodes too) -> anchor at the call loc.
            if a0.has_string_data() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
            let a1 *(args + 1)
            if a1.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 1, a1)
            interp.set_next_location(loc)
            interp.message1(InterpreterMessages.errorProc(), a0.string_data(host))
            return interp.make_error()
        }
        ; --- docbook.dsl batch (Family B) ----------------------------------
        if id = PRIM_HAVE_ANCESTOR
            return Primitive.have_ancestor(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_INHERITED_ATTRIBUTE_STRING
            return Primitive.inherited_attribute_string(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_IS_ABSOLUTE_FIRST_SIBLING
            return Primitive.absolute_first_sibling(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_IS_ABSOLUTE_LAST_SIBLING
            return Primitive.absolute_last_sibling(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_HIERARCHICAL_NUMBER_RECURSIVE
            return Primitive.hierarchical_number_recursive(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_ELEMENT_NUMBER
            return Primitive.element_number(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_ENTITY_PUBLIC_ID
            return Primitive.entity_public_id(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_ENTITY_GENERATED_SYSTEM_ID
            return Primitive.entity_generated_system_id(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_ENTITY_NOTATION
            return Primitive.entity_notation(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_ENTITY_SYSTEM_ID
            return Primitive.entity_system_id(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_ENTITY_TEXT
            return Primitive.entity_text(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_ENTITY_TYPE
            return Primitive.entity_type(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_ENTITY_ATTRIBUTE_STRING
            return Primitive.entity_attribute_string(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_ENTITY_NAME_NORMALIZE
            return Primitive.entity_name_normalize(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_NOTATION_SYSTEM_ID
            return Primitive.notation_id(host, interp, name, n_args, args, ctx, loc, 0)
        if id = PRIM_NOTATION_PUBLIC_ID
            return Primitive.notation_id(host, interp, name, n_args, args, ctx, loc, 1)
        if id = PRIM_NOTATION_GENERATED_SYSTEM_ID
            return Primitive.notation_id(host, interp, name, n_args, args, ctx, loc, 2)
        if id = PRIM_CHAR_PROPERTY
        {
            ; DEFPRIMITIVE(CharProperty) — the property NAME is a symbol,
            ; the character an ordinary char, and an optional third
            ; argument is the fallback for a character the property says
            ; nothing about (it beats the property's own default).
            if a0.is_symbol_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASymbol(), name, 0, a0)
            let a1 *(args + 1)
            if a1.is_char_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAChar(), name, 1, a1)
            var def: pointer[ELObj] null
            if n_args > 2
                set def: *(args + 2)
            return interp.char_property(a0.symbol_name(), a1.char_value() as u32, loc, def)
        }
        if id = PRIM_CHAR_SCRIPT_CASE
        {
            ; DEFPRIMITIVE(CharScriptCase) — ★a STUB in the reference too
            ; (`// FIXME`): it only demands a style-stack context, checks
            ; that every EVEN-indexed argument is a string, and returns the
            ; LAST argument. Ported as written, stub and all.
            if ctx.get_style_stack() = null
                return Primitive.simple_error(interp, loc, InterpreterMessages.notInCharacteristicValue())
            var i 0
            while i < n_args
            {
                let ai *(args + i)
                if ai.has_string_data() = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, i, ai)
                set i: i + 2
            }
            return *(args + (n_args - 1))
        }
        if id = PRIM_IS_LANGUAGE
            return interp.make_bool(a0.is_language_p())
        if id = PRIM_CURRENT_LANGUAGE
        {
            ; DEFPRIMITIVE(CurrentLanguage) — the context's language, else
            ; the declared default, which is #f until declare-default-language
            ; sets one.
            let cl ctx.get_current_language()
            if cl <> null
                return cl
            let dl interp.get_default_language()
            if dl <> null
                return dl
            return interp.make_false()
        }
        if id = PRIM_WITH_LANGUAGE
            return Primitive.with_language(host, interp, name, *args, *(args + 1), ctx, loc)
        if id = PRIM_STRING_EQUIV
            return Primitive.string_equiv(host, interp, name, args, ctx, loc)
        if id = PRIM_LANGUAGE
        {
            ; XXPRIMITIVE(Language) — reachable only as
            ; "UNREGISTERED::OpenJade//Procedure::language". ★It answers #f
            ; here, which IS the reference's behaviour on a build without
            ; SP_HAVE_LOCALE + SP_HAVE_WCHAR: a RefLangObj is a live C locale
            ; (setlocale + wcscoll + towupper around every call), and this
            ; port has no locale-backed collation. A define-language value is
            ; unaffected — that is the LangObj branch, and it is ported.
            let l0 a0.convert_to_string(host)
            if l0 = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAStringOrSymbol(), name, 0, a0)
            let a1 *(args + 1)
            let l1 a1.convert_to_string(host)
            if l1 = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAStringOrSymbol(), name, 1, a1)
            return interp.make_false()
        }
        if id = PRIM_PROCESS_FIRST_DESCENDANT
            return Primitive.process_matching(host, interp, name, n_args, args, ctx, loc, true)
        if id = PRIM_PROCESS_MATCHING_CHILDREN
            return Primitive.process_matching(host, interp, name, n_args, args, ctx, loc, false)
        if id = PRIM_SOSOFO_LABEL
            return Primitive.sosofo_label(host, interp, name, *args, *(args + 1), loc, false)
        if id = PRIM_SOSOFO_DISCARD_LABELED
            return Primitive.sosofo_label(host, interp, name, *args, *(args + 1), loc, true)
        if id = PRIM_MERGE_STYLE
            return Primitive.merge_style(host, interp, name, args, n_args, loc)
        if id = PRIM_IS_STYLE
            return interp.make_bool(a0.is_style_p())
        if id = PRIM_IS_MATCH_ELEMENT
            return Primitive.is_match_element(host, interp, name, *args, *(args + 1), loc)
        if id = PRIM_INHERITED_ELEMENT_ATTRIBUTE_STRING
            return Primitive.inherited_element_attribute_string(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_ANCESTOR_CHILD_NUMBER
            return Primitive.ancestor_child_number(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_HIERARCHICAL_NUMBER
            return Primitive.hierarchical_number(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_ELEMENT_NUMBER_LIST
            return Primitive.element_number_list(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_FIRST_CHILD_GI
            return Primitive.first_child_gi(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_NODE_LIST_NO_ORDER
        {
            ; DEFPRIMITIVE(NodeListNoOrder) — NodeListObj::nodeListNoOrder is
            ; `return this` for every list this port builds; only the
            ; reference's NamedNodeListPtr wrapper hands back a different
            ; object, and that difference is not observable through any
            ; primitive (the members and their order are the same).
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, a0)
            return a0
        }
        if id = PRIM_ATTRIBUTES
            return Primitive.attributes_prim(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_IS_NAMED_NODE_LIST
        {
            ; (bind the receiver: a method call on a DEREF expression
            ; mis-dispatches silently — the deref-receiver footgun.)
            let nnl_arg *args
            return interp.make_bool(nnl_arg.node_list_named() <> NNL_NONE)
        }
        if id = PRIM_NAMED_NODE
            return Primitive.named_node_prim(host, interp, name, *args, *(args + 1), loc)
        if id = PRIM_NAMED_NODE_LIST_NAMES
            return Primitive.named_node_list_names(host, interp, name, *args, loc)
        if id = PRIM_NAMED_NODE_LIST_NORMALIZE
            return Primitive.named_node_list_normalize(host, interp, name, args, loc)
        if id = PRIM_ROUND
            return Primitive.round_prim(host, interp, name, *args, loc)

        ; --- the numeric / transcendental family ---------------------------
        if id = PRIM_MIN
            return Primitive.min_max(host, interp, name, args, n_args, loc, true)
        if id = PRIM_MAX
            return Primitive.min_max(host, interp, name, args, n_args, loc, false)
        if id = PRIM_FLOOR
            return Primitive.round_to_integral(host, interp, name, a0, loc, 0)
        if id = PRIM_CEILING
            return Primitive.round_to_integral(host, interp, name, a0, loc, 1)
        if id = PRIM_TRUNCATE
            return Primitive.round_to_integral(host, interp, name, a0, loc, 2)
        if id = PRIM_SQRT
            return Primitive.sqrt_prim(host, interp, name, a0, loc)
        if id = PRIM_IS_EXACT
            return Primitive.exactness_test(interp, name, a0, loc, true)
        if id = PRIM_IS_INEXACT
            return Primitive.exactness_test(interp, name, a0, loc, false)
        if id = PRIM_EXP
            return Primitive.transcendental(host, interp, name, a0, loc, 0)
        if id = PRIM_LOG
            return Primitive.transcendental(host, interp, name, a0, loc, 1)
        if id = PRIM_SIN
            return Primitive.transcendental(host, interp, name, a0, loc, 2)
        if id = PRIM_COS
            return Primitive.transcendental(host, interp, name, a0, loc, 3)
        if id = PRIM_TAN
            return Primitive.transcendental(host, interp, name, a0, loc, 4)
        if id = PRIM_ASIN
            return Primitive.transcendental(host, interp, name, a0, loc, 5)
        if id = PRIM_ACOS
            return Primitive.transcendental(host, interp, name, a0, loc, 6)
        if id = PRIM_ATAN
            return Primitive.atan_prim(host, interp, name, args, n_args, loc)
        if id = PRIM_EXPT
            return Primitive.expt_prim(host, interp, name, *args, *(args + 1), loc)
        if id = PRIM_X_EXPT
            return Primitive.x_expt_prim(host, interp, name, *args, *(args + 1), loc)
        if id = PRIM_EXACT_TO_INEXACT
            return Primitive.exact_to_inexact(host, interp, name, a0, loc)
        if id = PRIM_INEXACT_TO_EXACT
            return Primitive.inexact_to_exact(host, interp, name, a0, loc)

        ; --- quantities ----------------------------------------------------
        if id = PRIM_IS_QUANTITY
        {
            ; DEFPRIMITIVE(IsQuantity) — anything quantityValue answers for,
            ; so a LENGTH is a quantity where it is not a number.
            let qv a0.quantity_value()
            return interp.make_bool(qv.get_qtype() <> QT_NONE)
        }
        if id = PRIM_QUANTITY_TO_NUMBER
            return Primitive.quantity_to_number(host, interp, name, a0, loc)
        if id = PRIM_QUANTITY_TO_STRING
            return Primitive.quantity_to_string(host, interp, name, args, n_args, loc)
        if id = PRIM_MAP_CONSTRUCTOR
            return Primitive.map_constructor(host, interp, name, *args, *(args + 1), ctx, loc)
        if id = PRIM_SELECT_BY_CLASS
            return Primitive.select_by_class(host, interp, name, *args, *(args + 1), loc)
        if id = PRIM_FOLLOW
            return Primitive.follow_prim(host, interp, name, *args, loc)
        if id = PRIM_GENERAL_NAME_NORMALIZE
            return Primitive.general_name_normalize(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_PROCESS_ELEMENT_WITH_ID
            return Primitive.process_element_with_id(host, interp, name, a0, ctx, loc)
        if id = PRIM_PRECED
            return Primitive.preced_prim(host, interp, name, a0, loc)
        if id = PRIM_IS_ADDRESS
            return interp.make_bool(a0.is_address_p())
        if id = PRIM_NODE_LIST_ADDRESS
        {
            ; DEFPRIMITIVE NodeListAddress — a resolved-node address of the
            ; singleton (`|| !node` is the notASingletonNode arg error).
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 0, a0)
            let nd a0.node_list_node(0)
            if nd = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 0, a0)
            return ELObj.make_address(host, ADDR_RESOLVED_NODE, nd as pointer[void])
        }
        if id = PRIM_IS_ADDRESS_LOCAL
        {
            ; DEFPRIMITIVE IsAddressLocal — the address must be an address AND
            ; there must be a current node; then the type decides. An idref is
            ; local by construction (it names an ID in the current node's
            ; grove), an entity reference never is, and everything else —
            ; sgmlDocument, hytimeLinkend, tei, html, none — falls through the
            ; switch's `default` to #f.
            if a0.is_address_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAnAddress(), name, 0, a0)
            let cn ctx.get_current_node()
            if cn = null
                return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
            let a a0.address_rec()
            if a.addr_type = ADDR_RESOLVED_NODE
            {
                ; Node::sameGrove is `groveIndex() == node.groveIndex()`
                ; (grove/Node.h:706) — a real comparison since sgml-parse can
                ; put a second grove in reach: an address into a LOADED grove
                ; is not local to a current node in the document grove.
                let anode a.node as pointer[GroveNode]
                return interp.make_bool(GroveInfo.index_of(anode) = GroveInfo.index_of(cn))
            }
            if a.addr_type = ADDR_IDREF
                return interp.make_bool(true)
            return interp.make_bool(false)
        }
        if id = PRIM_IS_ADDRESS_VISITED
        {
            ; DEFPRIMITIVE IsAddressVisited — the reference type-checks and
            ; then returns #f under a bare `// FIXME`: it has no visited-link
            ; history. Same here, deliberately.
            if a0.is_address_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAnAddress(), name, 0, a0)
            return interp.make_bool(false)
        }
        if id = PRIM_CURRENT_NODE_ADDRESS
        {
            let cn ctx.get_current_node()
            if cn = null
                return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
            return ELObj.make_address(host, ADDR_RESOLVED_NODE, cn as pointer[void])
        }
        if id = PRIM_HYTIME_LINKEND
        {
            let cn ctx.get_current_node()
            if cn = null
                return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
            return ELObj.make_address(host, ADDR_HYTIME_LINKEND, cn as pointer[void])
        }
        if (id = PRIM_IDREF_ADDRESS) or (id = PRIM_ENTITY_ADDRESS)
        {
            ; DEFPRIMITIVE IdrefAddress / EntityAddress — both carry the
            ; CURRENT node (the grove the name is to be resolved in) plus the
            ; name string in params[0]; neither resolves here. The reference's
            ; note on idref: keeping the string rather than a NodeAddressObj is
            ; what makes a FORWARD reference work. entity-address additionally
            ; allows several space-separated names, which is why it cannot
            ; resolve either (Address holds one node).
            ; ★The argument order matters: the string check comes BEFORE the
            ; current-node check in both.
            if a0.has_string_data() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
            let cn ctx.get_current_node()
            if cn = null
                return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
            let s a0.string_data(host)
            var t ADDR_IDREF
            if id = PRIM_ENTITY_ADDRESS
                set t: ADDR_ENTITY
            return ELObj.make_address1(host, t, cn as pointer[void], s)
        }
        if id = PRIM_SGML_DOCUMENT_ADDRESS
        {
            ; DEFPRIMITIVE SgmlDocumentAddress — params[0] is the system id,
            ; params[1] the second string; the node stays EMPTY (the only
            ; address form with no node at all).
            let a1 *(args + 1)
            if a0.has_string_data() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
            let sysid a0.string_data(host)
            if a1.has_string_data() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 1, a1)
            let sid a1.string_data(host)
            return ELObj.make_address2(host, ADDR_SGML_DOCUMENT, null, sysid, sid)
        }
        if id = PRIM_DEBUG
        {
            ; XPRIMITIVE Debug — message `debug %1` (Info) with the printed
            ; object; the value passes through unchanged.
            interp.set_next_location(loc)
            let os OutputCharStream.make(host)
            a0.print(os, interp.get_units_per_inch())
            interp.message1(InterpreterMessages.debug(), os.to_string_c(host))
            return a0
        }
        if id = PRIM_READ_ENTITY
            return Primitive.read_entity_prim(host, interp, name, a0, loc)
        if id = PRIM_ALL_ELEMENT_NUMBER
        {
            ; XPRIMITIVE AllElementNumber — the element's 1-based document-
            ; order ordinal (Node::elementIndex + 1); non-elements are #f;
            ; an explicit EMPTY osnl is #f too (no `|| !node` gate here).
            var node: pointer[GroveNode] null
            if n_args > 0
            {
                if a0.is_node_list_p() = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notAnOptSingletonNode(), name, 0, a0)
                set node: a0.node_list_node(0)
            }
            else
            {
                set node: ctx.get_current_node()
                if node = null
                    return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
            }
            if node = null
                return interp.make_false()
            let idx node.get_element_index()
            if idx < 0
                return interp.make_false()
            return ELObj.make_integer(host, idx + 1)
        }
        if (id = PRIM_SGML_PARSE) or (id = PRIM_X_SGML_PARSE)
            return Primitive.sgml_parse_prim(host, interp, name, id, n_args, args, ctx, loc)
        if id = PRIM_TIME
        {
            ; DEFPRIMITIVE Time (primitive.cxx:1564) — "This assumes a Posix
            ; compatible time()."
            return ELObj.make_integer(host, scaly_time_now() as int)
        }
        if id = PRIM_TIME_TO_STRING
            return Primitive.time_to_string(host, interp, name, args, n_args, loc)
        if id = PRIM_TIME_LESS
            return Primitive.time_compare(host, interp, name, args, loc, 0)
        if id = PRIM_TIME_GREATER
            return Primitive.time_compare(host, interp, name, args, loc, 1)
        if id = PRIM_TIME_LESS_EQ
            return Primitive.time_compare(host, interp, name, args, loc, 2)
        if id = PRIM_TIME_GREATER_EQ
            return Primitive.time_compare(host, interp, name, args, loc, 3)

        interp.make_error()
    }

    ; --- the time family (primitive.cxx:1571, 5191-5280) --------------------
    ;
    ; DEFPRIMITIVE TimeToString — an exact integer, optionally a second
    ; argument selecting gmtime. The reference's gate is
    ; `argc > 1 && argv[1] != interp.makeFalse()`, so an explicit #f means
    ; LOCAL time, like no second argument at all.
    function time_to_string(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        if a0.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 0, a0)
        var gmt: i64 0
        if n_args > 1
        {
            let a1 *(args + 1)
            if a1.is_true()
                set gmt: 1
        }
        ; 64 bytes, exactly the reference's stack buffer: the year is printed
        ; with %04d, so a far-future time_t is wider than the 19 characters of
        ; the ISO form.
        var buf u8[64]
        let p buf as pointer[u8]
        let n scaly_time_format(a0.exact_integer_value() as i64, gmt, p)
        let out Array[u32]^host()
        var i: size_t 0
        while i < (n as size_t)
        {
            out.add((*(p + i)) as u32)
            set i: i + (1 as size_t)
        }
        ELObj.make_string(host, StringC^host(out.get_buffer(), out.get_length()))
    }

    ; DEFTIMECOMP (primitive.cxx:5265) — the four comparisons over timeConv.
    ; op: 0 `<`, 1 `>`, 2 `<=`, 3 `>=`.
    ; ★The reference calls timeConv FOUR times per comparison (twice to test
    ; for the error value, twice more inside the comparison itself); one call
    ; per argument is the same answer, since timeConv is a pure function of
    ; its string plus the wall clock, which only the defaults of the
    ; time-of-day form read at all.
    function time_compare(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], loc: Location, op: int) returns pointer[ELObj]
    {
        let a0 *args
        let a1 *(args + 1)
        if a0.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
        if a1.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 1, a1)
        let s0 a0.string_data(host)
        let s1 a1.string_data(host)
        let t0 scaly_time_conv(s0.data_ptr(), s0.get_size() as i64) as int
        if t0 = 0 - 1
            return Primitive.arg_error(interp, loc, InterpreterMessages.notATimeString(), name, 0, a0)
        let t1 scaly_time_conv(s1.data_ptr(), s1.get_size() as i64) as int
        if t1 = 0 - 1
            return Primitive.arg_error(interp, loc, InterpreterMessages.notATimeString(), name, 1, a1)
        var r false
        if op = 0
            set r: t0 < t1
        if op = 1
            set r: t0 > t1
        if op = 2
            set r: t0 <= t1
        if op = 3
            set r: t0 >= t1
        interp.make_bool(r)
    }

    ; Interpreter::convertGlyphId — split a trailing "::<digits>" suffix (the
    ; digit run must not start with '0' and must be non-empty), then store the
    ; public id: chars >= 128 message invalidPublicIdChar and are dropped
    ; (storePublicId).
    function convert_glyph_id(host: pointer[Page], interp: pointer[Interpreter], s: StringC, loc: Location) returns pointer[ELObj]
    {
        let len s.get_size()
        var n 0
        var id_len len
        var found false
        var i len
        while (i > (1 as size_t)) and (found = false)
        {
            let c1 s.get(i - (1 as size_t))
            if c1 = (0x3A as u32)
            {
                if s.get(i - (2 as size_t)) = (0x3A as u32)
                {
                    if i < len
                    {
                        if s.get(i) <> (0x30 as u32)
                        {
                            var j i
                            while j < len
                            {
                                set n: n * 10 + ((s.get(j) - (0x30 as u32)) as int)
                                set j: j + (1 as size_t)
                            }
                            set id_len: i - (2 as size_t)
                            set found: true
                        }
                    }
                }
                if found = false
                    set i: 0 as size_t
            }
            else if (c1 < (0x30 as u32)) or (c1 > (0x39 as u32))
                set i: 0 as size_t
            else
                set i: i - (1 as size_t)
        }
        if found = false
        {
            set n: 0
            set id_len: len
        }
        ; storePublicId over s[0..id_len)
        let ihost interp.get_host()
        let buf ihost.allocate(id_len * (sizeof u32) + (4 as size_t), alignof u32) as pointer[u32]
        var m: size_t 0
        var k: size_t 0
        while k < id_len
        {
            let c s.get(k)
            if c >= (128 as u32)
            {
                var cb u32[1]
                set *(cb as pointer[u32]): c
                let cs StringC(cb as pointer[u32], 1 as size_t)
                interp.set_next_location(loc)
                interp.message1(InterpreterMessages.invalidPublicIdChar(), cs)
            }
            else
            {
                set *(buf + m): c
                set m: m + (1 as size_t)
            }
            set k: k + (1 as size_t)
        }
        let pubid StringC^ihost(buf, m)
        ELObj.make_glyph_id(ihost, pubid, n)
    }

    ; the glyph-subst-table primitive — a list of (old-gid . new-gid) pairs
    ; flattened into the table's pair sequence.
    function glyph_subst_table_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, a0: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        let ihost interp.get_host()
        let uid interp.alloc_gst_unique_id()
        let table GlyphSubstTableRec.make(ihost, uid)
        let pairs table.get_pairs()
        var p a0
        while p.is_nil() = false
        {
            if p.is_pair() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAGlyphIdPairList(), name, 0, a0)
            let entry p.get_car()
            set p: p.get_cdr()
            var g1: pointer[ELObj] null
            var g2: pointer[ELObj] null
            if entry <> null
            {
                if entry.is_pair()
                {
                    let c1 entry.get_car()
                    let c2 entry.get_cdr()
                    if c1 <> null
                    {
                        if c1.is_glyph_id_p()
                            set g1: c1
                    }
                    if c2 <> null
                    {
                        if c2.is_glyph_id_p()
                            set g2: c2
                    }
                }
            }
            if (g1 = null) or (g2 = null)
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAGlyphIdPairList(), name, 0, a0)
            pairs.add(g1)
            pairs.add(g2)
        }
        ELObj.make_glyph_subst_table(ihost, table)
    }

    ; PrimitiveObj::argError (Insn.cxx:592): report the offending argument
    ; with the primitive's name, the 1-based ordinal, and the printed object,
    ; then yield the error object. The C++ suppression arm (a node-list whose
    ; suppressError() is true) is only ever taken for the lazy MapNodeListObj;
    ; our node-list-map is eager and yields plain node-lists, so no
    ; suppression here.
    function arg_error(interp: pointer[Interpreter], loc: Location, mt: MessageType, name: StringC, index: int, obj: pointer[ELObj]) returns pointer[ELObj]
    {
        let host interp.get_host()
        let os OutputCharStream.make(host)
        let upi interp.get_units_per_inch()
        obj.print(os, upi)
        let printed os.to_string_c(host)
        interp.set_next_location(loc)
        interp.message3(mt, name, (index + 1) as u64, printed)
        interp.make_error()
    }

    ; The reference's inline `setNextLocation + message + makeError` shape
    ; (outOfRange, divideBy0, ...).
    function simple_error(interp: pointer[Interpreter], loc: Location, mt: MessageType) returns pointer[ELObj]
    {
        interp.set_next_location(loc)
        interp.message0(mt)
        interp.make_error()
    }

    ; --- list helpers ------------------------------------------------------
    function build_list(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int) returns pointer[ELObj]
    {
        var result interp.make_nil()
        var i n_args - 1
        while i >= 0
        {
            set result: ELObj.make_pair(host, *(args + i), result)
            set i: i - 1
        }
        result
    }

    function list_length(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        var n 0
        var p obj
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
            {
                if interp.is_error(p)
                    return p
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 0, p)
            }
            set n: n + 1
            set p: p.get_cdr()
        }
        ELObj.make_integer(host, n)
    }

    function append_lists(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        if n_args = 0
            return interp.make_nil()
        ; every arg but the last must be a proper list; the improper tail is
        ; reported left-to-right (Append passes the tail object).
        var i 0
        while i < n_args - 1
        {
            var p *(args + i)
            while (p <> null) and (p.is_nil() = false)
            {
                if p.is_pair() = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, i, p)
                set p: p.get_cdr()
            }
            set i: i + 1
        }
        var result *(args + (n_args - 1))
        set i: n_args - 2
        while i >= 0
        {
            ; prepend the elements of args[i] (reversed onto result)
            let tmp Primitive.reverse_list(host, interp, name, *(args + i), loc)
            var p tmp
            while (p <> null) and (p.is_nil() = false)
            {
                set result: ELObj.make_pair(host, p.get_car(), result)
                set p: p.get_cdr()
            }
            set i: i - 1
        }
        result
    }

    function reverse_list(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        var result interp.make_nil()
        var p obj
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 0, obj)
            set result: ELObj.make_pair(host, p.get_car(), result)
            set p: p.get_cdr()
        }
        result
    }

    function list_ref(interp: pointer[Interpreter], name: StringC, list: pointer[ELObj], k_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if k_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, k_obj)
        var k k_obj.exact_integer_value()
        if k < 0
            return Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
        var p list
        while (p <> null) and p.is_pair()
        {
            if k = 0
                return p.get_car()
            set k: k - 1
            set p: p.get_cdr()
        }
        if (p <> null) and (p.is_nil() = false)
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 0, list)
        Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
    }

    ; mode: 0 memq (eq/eqv-ptr), 1 memv (eqv), 2 member (equal).
    function member_of(interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], list: pointer[ELObj], mode: int, loc: Location) returns pointer[ELObj]
    {
        var p list
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 1, list)
            let car p.get_car()
            var hit false
            if mode = 0
                set hit: car = obj
            else if mode = 1
                set hit: ELObj.eqv(car, obj)
            else
                set hit: ELObj.equal(car, obj)
            if hit
                return p
            set p: p.get_cdr()
        }
        interp.make_false()
    }

    ; assoc: DEFPRIMITIVE(Assoc) — the alist lookup, comparing with
    ; ELObj::equal (there is no assq/assv in the reference). A non-pair
    ; ELEMENT is notAnAlist, a non-pair non-nil TAIL is notAList; both point
    ; at argument 2.
    function assoc(interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], list: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        var p list
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 1, list)
            let entry p.get_car()
            if entry.is_pair() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAnAlist(), name, 1, list)
            if ELObj.equal(entry.get_car(), obj)
                return entry
            set p: p.get_cdr()
        }
        interp.make_false()
    }

    ; --- numeric core ------------------------------------------------------
    ; Accumulate args as exact-long while all operands are exact, promoting to
    ; double on the first inexact. Dimensions are not tracked in the starter
    ; set (numbers assumed dimensionless); length/quantity dims join later.
    ; a dimensioned arithmetic result (the DEFPRIMITIVE tails): exact — dim 0
    ; integer, dim 1 length, else promoted to an inexact quantity; inexact —
    ; dim 0 real, else quantity.
    function quantity_result(host: pointer[Page], is_double: bool, l: int, d: double, dim: int) returns pointer[ELObj]
    {
        if is_double = false
        {
            if dim = 0
                return ELObj.make_integer(host, l)
            if dim = 1
                return ELObj.make_length(host, l)
            return ELObj.make_quantity(host, l as double, dim)
        }
        if dim = 0
            return ELObj.make_real(host, d)
        ELObj.make_quantity(host, d, dim)
    }

    ; signed-64 overflow predicates (the reference's LONG_MIN/LONG_MAX
    ; guards); overflow promotes the accumulation to double.
    function add_overflows(a: int, b: int) returns bool
    {
        let maxv 0x7FFFFFFFFFFFFFFF
        let minv 0 - maxv - 1
        if b > 0
            return a > maxv - b
        if b < 0
            return a < minv - b
        false
    }

    function mul_overflows(a: int, b: int) returns bool
    {
        if (a = 0) or (b = 0)
            return false
        let maxv 0x7FFFFFFFFFFFFFFF
        let minv 0 - maxv - 1
        if a > 0
        {
            if b > 0
                return a > maxv / b
            return b < minv / a
        }
        if b > 0
            return a < minv / b
        a < maxv / b
    }

    ; the length-spec accumulation path of Plus/Minus (primitive.cxx `spec`
    ; branch): component-wise over the engine 3-vector; every plain-quantity
    ; operand must be dimension 1. `negate_rest` = Minus (args past the first
    ; subtract; a sole arg negates).
    function arith_spec(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location, negate_rest: bool) returns pointer[ELObj]
    {
        var v0 0.0
        var v1 0.0
        var v2 0.0
        var i 0
        while i < n_args
        {
            let a *(args + i)
            var minus false
            if negate_rest
            {
                if (i > 0) or (n_args = 1)
                    set minus: true
            }
            let lsp a.length_spec()
            if lsp <> null
            {
                if minus
                {
                    set v0: v0 - lsp.v0
                    set v1: v1 - lsp.v1
                    set v2: v2 - lsp.v2
                }
                else
                {
                    set v0: v0 + lsp.v0
                    set v1: v1 + lsp.v1
                    set v2: v2 + lsp.v2
                }
            }
            else
            {
                let qv a.quantity_value()
                if qv.get_qtype() = QT_NONE
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantityOrLengthSpec(), name, i, a)
                if qv.get_dim() <> 1
                    return Primitive.simple_error(interp, loc, InterpreterMessages.incompatibleDimensions())
                var d qv.get_dval()
                if qv.get_qtype() = QT_LONG
                    set d: qv.get_lval() as double
                if minus
                    set v0: v0 - d
                else
                    set v0: v0 + d
            }
            set i: i + 1
        }
        ELObj.make_length_spec(host, v0, v1, v2)
    }

    ; the length-spec scaling path of Multiply/Divide: only the FIRST arg may
    ; be a length-spec; the rest scale it as plain reals. QUIRK kept: the
    ; not-a-number error always reports argument 1 (argv[1]) whatever i is.
    function arith_spec_scale(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location, divide: bool) returns pointer[ELObj]
    {
        ; deref receiver bound first (the chained-call-on-deref miscompile).
        let a0 *args
        let lsp a0.length_spec()
        var v0 lsp.v0
        var v1 lsp.v1
        var v2 lsp.v2
        var i 1
        while i < n_args
        {
            let a *(args + i)
            if a.is_real() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notANumber(), name, 1, *(args + 1))
            let d a.real_value()
            if divide
            {
                if d = 0.0
                    return Primitive.simple_error(interp, loc, InterpreterMessages.divideBy0())
                set v0: v0 / d
                set v1: v1 / d
                set v2: v2 / d
            }
            else
            {
                set v0: v0 * d
                set v1: v1 * d
                set v2: v2 * d
            }
            set i: i + 1
        }
        ELObj.make_length_spec(host, v0, v1, v2)
    }

    ; Plus (primitive.cxx): all args must share ONE dimension
    ; (incompatibleDimensions otherwise); exact stays exact unless an inexact
    ; arg or overflow promotes. A length-spec operand diverts the whole sum
    ; onto the spec path (dimension checks of the scanned prefix included).
    function arith_add(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        if n_args = 0
            return ELObj.make_integer(host, 0)
        let a0 *args
        let qv0 a0.quantity_value()
        if qv0.get_qtype() = QT_NONE
            return Primitive.arith_spec(host, interp, name, args, n_args, loc, false)
        var is_double qv0.get_qtype() = QT_DOUBLE
        let dim qv0.get_dim()
        var lsum qv0.get_lval()
        var dsum qv0.get_dval()
        var i 1
        while i < n_args
        {
            let a *(args + i)
            let qv a.quantity_value()
            let qt qv.get_qtype()
            if qt = QT_NONE
            {
                ; the reference sets dim2 = 1, checks it against dim, then
                ; re-scans everything on the spec path.
                if dim <> 1
                    return Primitive.simple_error(interp, loc, InterpreterMessages.incompatibleDimensions())
                return Primitive.arith_spec(host, interp, name, args, n_args, loc, false)
            }
            if qv.get_dim() <> dim
                return Primitive.simple_error(interp, loc, InterpreterMessages.incompatibleDimensions())
            if qt = QT_DOUBLE
            {
                if is_double = false
                {
                    set dsum: lsum as double
                    set is_double: true
                }
                set dsum: dsum + qv.get_dval()
            }
            else
            {
                if is_double
                    set dsum: dsum + (qv.get_lval() as double)
                else
                {
                    if Primitive.add_overflows(lsum, qv.get_lval())
                    {
                        set dsum: (lsum as double) + (qv.get_lval() as double)
                        set is_double: true
                    }
                    else
                        set lsum: lsum + qv.get_lval()
                }
            }
            set i: i + 1
        }
        Primitive.quantity_result(host, is_double, lsum, dsum, dim)
    }

    ; Multiply (primitive.cxx): dimensions ADD; an exact product whose
    ; dimension exceeds 1 (or overflows) is promoted to an inexact quantity.
    function arith_mul(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        if n_args = 0
            return ELObj.make_integer(host, 1)
        let a0 *args
        let qv0 a0.quantity_value()
        if qv0.get_qtype() = QT_NONE
        {
            ; a leading length-spec scales by the remaining reals.
            if a0.length_spec() <> null
                return Primitive.arith_spec_scale(host, interp, name, args, n_args, loc, false)
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, 0, a0)
        }
        var is_double qv0.get_qtype() = QT_DOUBLE
        var dim qv0.get_dim()
        var lprod qv0.get_lval()
        var dprod qv0.get_dval()
        var i 1
        while i < n_args
        {
            let a *(args + i)
            let qv a.quantity_value()
            if qv.get_qtype() = QT_NONE
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, i, a)
            set dim: dim + qv.get_dim()
            if qv.get_qtype() = QT_DOUBLE
            {
                if is_double = false
                {
                    set dprod: lprod as double
                    set is_double: true
                }
                set dprod: dprod * qv.get_dval()
            }
            else
            {
                if is_double
                    set dprod: dprod * (qv.get_lval() as double)
                else
                {
                    ; the reference forces exact results past dim 1 inexact
                    ; (lengths are inexact millipoints).
                    if (dim > 1) or Primitive.mul_overflows(lprod, qv.get_lval())
                    {
                        set dprod: (lprod as double) * (qv.get_lval() as double)
                        set is_double: true
                    }
                    else
                        set lprod: lprod * qv.get_lval()
                }
            }
            set i: i + 1
        }
        Primitive.quantity_result(host, is_double, lprod, dprod, dim)
    }

    ; Minus (primitive.cxx): like Plus — one shared dimension; a length-spec
    ; operand diverts onto the spec path (later args subtract; a sole arg
    ; negates).
    function arith_sub(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        let qv0 a0.quantity_value()
        if qv0.get_qtype() = QT_NONE
            return Primitive.arith_spec(host, interp, name, args, n_args, loc, true)
        var is_double qv0.get_qtype() = QT_DOUBLE
        let dim qv0.get_dim()
        var lacc qv0.get_lval()
        var dacc qv0.get_dval()
        if is_double = false
            set dacc: lacc as double
        if n_args = 1
        {
            if is_double
                return Primitive.quantity_result(host, true, 0, 0.0 - dacc, dim)
            return Primitive.quantity_result(host, false, 0 - lacc, 0.0, dim)
        }
        var i 1
        while i < n_args
        {
            let a *(args + i)
            let qv a.quantity_value()
            if qv.get_qtype() = QT_NONE
            {
                if dim <> 1
                    return Primitive.simple_error(interp, loc, InterpreterMessages.incompatibleDimensions())
                return Primitive.arith_spec(host, interp, name, args, n_args, loc, true)
            }
            if qv.get_dim() <> dim
                return Primitive.simple_error(interp, loc, InterpreterMessages.incompatibleDimensions())
            if qv.get_qtype() = QT_DOUBLE
            {
                if is_double = false
                {
                    set dacc: lacc as double
                    set is_double: true
                }
                set dacc: dacc - qv.get_dval()
            }
            else
            {
                if is_double
                    set dacc: dacc - (qv.get_lval() as double)
                else
                {
                    if Primitive.add_overflows(lacc, 0 - qv.get_lval())
                    {
                        set dacc: (lacc as double) - (qv.get_lval() as double)
                        set is_double: true
                    }
                    else
                        set lacc: lacc - qv.get_lval()
                }
            }
            set i: i + 1
        }
        Primitive.quantity_result(host, is_double, lacc, dacc, dim)
    }

    ; Divide (primitive.cxx): dimensions SUBTRACT; an exact quotient stays
    ; exact only for dimensionless divisors that divide evenly (dividing BY a
    ; dimensioned quantity — lengths are inexact — promotes to double).
    function arith_div(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        let qv0 a0.quantity_value()
        if qv0.get_qtype() = QT_NONE
        {
            ; a leading length-spec divides by the remaining reals (multi-arg
            ; form only, like the reference).
            if n_args > 1
            {
                if a0.length_spec() <> null
                    return Primitive.arith_spec_scale(host, interp, name, args, n_args, loc, true)
            }
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, 0, a0)
        }
        var dim qv0.get_dim()
        var acc qv0.get_dval()
        if qv0.get_qtype() <> QT_DOUBLE
            set acc: qv0.get_lval() as double
        if n_args = 1
        {
            if acc = 0.0
                return Primitive.simple_error(interp, loc, InterpreterMessages.divideBy0())
            return Primitive.quantity_result(host, true, 0, 1.0 / acc, 0 - dim)
        }
        var is_double qv0.get_qtype() = QT_DOUBLE
        var lnum qv0.get_lval()
        var i 1
        while i < n_args
        {
            let a *(args + i)
            let qv a.quantity_value()
            if qv.get_qtype() = QT_NONE
                ; reference quirk: the Divide loop reports argument 0/argv[0].
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, 0, a0)
            var d qv.get_dval()
            if qv.get_qtype() <> QT_DOUBLE
                set d: qv.get_lval() as double
            if d = 0.0
                return Primitive.simple_error(interp, loc, InterpreterMessages.divideBy0())
            set dim: dim - qv.get_dim()
            set acc: acc / d
            if qv.get_qtype() = QT_DOUBLE
                set is_double: true
            else
            {
                if (is_double = false) and (qv.get_dim() = 0) and ((lnum % qv.get_lval()) = 0)
                    set lnum: lnum / qv.get_lval()
                else
                    set is_double: true
            }
            set i: i + 1
        }
        Primitive.quantity_result(host, is_double, lnum, acc, dim)
    }

    ; op: 0 =, 1 <, 2 >, 3 <=, 4 >=. Chain comparison over adjacent operands.
    function compare(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location, op: int) returns pointer[ELObj]
    {
        var i 0
        while i < n_args - 1
        {
            let ea *(args + i)
            let eb *(args + i + 1)
            let a ea.quantity_value()
            let b eb.quantity_value()
            let aqt a.get_qtype()
            let bqt b.get_qtype()
            if aqt = QT_NONE
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, i, ea)
            if bqt = QT_NONE
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, i + 1, eb)
            var av a.get_dval()
            if aqt <> QT_DOUBLE
                set av: a.get_lval() as double
            var bv b.get_dval()
            if bqt <> QT_DOUBLE
                set bv: b.get_lval() as double
            var ok false
            if op = 0
                set ok: av = bv
            else if op = 1
                set ok: av < bv
            else if op = 2
                set ok: av > bv
            else if op = 3
                set ok: av <= bv
            else
                set ok: av >= bv
            if ok = false
                return interp.make_false()
            set i: i + 1
        }
        interp.make_true()
    }

    ; test: 0 zero?, 1 positive?, 2 negative?.
    function sign_test(interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location, test: int) returns pointer[ELObj]
    {
        let qv obj.quantity_value()
        if qv.get_qtype() = QT_NONE
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, 0, obj)
        var v qv.get_dval()
        if qv.get_qtype() <> QT_DOUBLE
            set v: qv.get_lval() as double
        if test = 0
            return interp.make_bool(v = 0.0)
        if test = 1
            return interp.make_bool(v > 0.0)
        interp.make_bool(v < 0.0)
    }

    ; parity: 1 odd?, 0 even?.
    function parity_test(interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location, want_odd: int) returns pointer[ELObj]
    {
        if obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnInteger(), name, 0, obj)
        let n obj.exact_integer_value()
        let r n % 2
        if want_odd = 1
            return interp.make_bool(r <> 0)
        interp.make_bool(r = 0)
    }

    function abs_val(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        let qv obj.quantity_value()
        if qv.get_qtype() = QT_NONE
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, 0, obj)
        if qv.get_qtype() = QT_DOUBLE
        {
            var d qv.get_dval()
            if d < 0.0
                set d: 0.0 - d
            return ELObj.make_real(host, d)
        }
        var n qv.get_lval()
        if n < 0
            set n: 0 - n
        ELObj.make_integer(host, n)
    }

    ; op: 0 modulo, 1 remainder, 2 quotient.
    function int_div(host: pointer[Page], interp: pointer[Interpreter], name: StringC, a: pointer[ELObj], b: pointer[ELObj], loc: Location, op: int) returns pointer[ELObj]
    {
        if a.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 0, a)
        if b.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, b)
        let x a.exact_integer_value()
        let y b.exact_integer_value()
        if y = 0
            return Primitive.simple_error(interp, loc, InterpreterMessages.divideBy0())
        if op = 2
            return ELObj.make_integer(host, x / y)
        let r x % y
        if op = 1
            return ELObj.make_integer(host, r)
        ; modulo: result takes the sign of the divisor
        var m r
        if (m <> 0) and (((m < 0) and (y > 0)) or ((m > 0) and (y < 0)))
            set m: m + y
        ELObj.make_integer(host, m)
    }

    ; --- string primitives -------------------------------------------------
    ; string-append: concatenate the string-data of every argument.
    function string_append(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        var total: size_t 0
        var i 0
        while i < n_args
        {
            let a *(args + i)
            let sz a.string_size()
            if sz < (0 as i64)
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, i, a)
            set total: total + (sz as size_t)
            set i: i + 1
        }
        ; a big result becomes a rope (StrCatObj) instead of materializing:
        ; the generator corpus nests appends ($-trees), and eager copies
        ; retain O(depth × bytes) in the eval region — the reference reclaims
        ; those intermediates with the GC. Small results materialize exactly
        ; as before (flat path below).
        if total > (0x100 as size_t)
        {
            let parts Array[pointer[ELObj]]^host()
            var j 0
            while j < n_args
            {
                let a *(args + j)
                let sz a.string_size()
                if sz > (0 as i64)
                    parts.add(a)
                set j: j + 1
            }
            return ELObj.make_strcat(host, parts, total)
        }
        if total = (0 as size_t)
            return ELObj.make_string(host, StringC())
        let buf host.allocate(total * (sizeof u32), alignof u32) as pointer[u32]
        var off: size_t 0
        var j 0
        while j < n_args
        {
            let a *(args + j)
            let s a.string_data(host)
            let m s.get_size()
            var k: size_t 0
            while k < m
            {
                set *(buf + off): s.get(k)
                set off: off + 1
                set k: k + 1
            }
            set j: j + 1
        }
        ELObj.make_string(host, StringC(buf, total))
    }

    function string_ref(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], k_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, obj)
        if k_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, k_obj)
        let s obj.string_data(host)
        let k k_obj.exact_integer_value()
        if (k < 0) or ((k as size_t) >= s.get_size())
            return Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
        ELObj.make_char(host, s.get(k as size_t))
    }

    function substring(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], s_obj: pointer[ELObj], e_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, obj)
        if s_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, s_obj)
        if e_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 2, e_obj)
        let s obj.string_data(host)
        let start s_obj.exact_integer_value()
        let end e_obj.exact_integer_value()
        if (start < 0) or (end < start) or ((end as size_t) > s.get_size())
            return Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
        ELObj.make_string(host, s.substr(start as size_t, (end - start) as size_t))
    }

    ; string: build a string from char arguments.
    function string_from_chars(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        if n_args = 0
            return ELObj.make_string(host, StringC())
        let buf host.allocate((n_args as size_t) * (sizeof u32), alignof u32) as pointer[u32]
        var i 0
        while i < n_args
        {
            let a *(args + i)
            if a.is_char_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAChar(), name, i, a)
            set *(buf + (i as size_t)): a.char_value() as u32
            set i: i + 1
        }
        ELObj.make_string(host, StringC(buf, n_args as size_t))
    }

    ; mode: 0 string=?, 1 string<?, 2 string<=?.
    ; string=? is a plain code-point comparison; string<? and string<=? are
    ; COLLATING and therefore GETCURLANG-gated, exactly like char<? / char<=?.
    ; mode: 0 string=?, 1 string<?, 2 string<=?.
    function string_compare(interp: pointer[Interpreter], name: StringC, a: pointer[ELObj], b: pointer[ELObj], loc: Location, mode: int, ctx: pointer[VM]) returns pointer[ELObj]
    {
        let host interp.get_host()
        var lang: pointer[ELObj] null
        if mode <> 0
        {
            set lang: Primitive.current_lang(interp, ctx)
            if lang = null
                return Primitive.no_current_language(interp)
        }
        if a.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a)
        if b.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 1, b)
        let s1 a.string_data(host)
        let s2 b.string_data(host)
        let n1 s1.get_size()
        let n2 s2.get_size()
        if mode <> 0
        {
            ; isLess / isLessOrEqual — the full collating strength.
            let r Primitive.lang_compare(host, lang, s1, s2, Primitive.lang_levels(lang))
            if mode = 1
                return interp.make_bool(r < 0)
            return interp.make_bool(r <= 0)
        }
        if mode = 0
        {
            if n1 <> n2
                return interp.make_false()
            var i: size_t 0
            while i < n1
            {
                if s1.get(i) <> s2.get(i)
                    return interp.make_false()
                set i: i + 1
            }
            return interp.make_true()
        }
        var minlen n1
        if n2 < n1
            set minlen: n2
        var i: size_t 0
        while i < minlen
        {
            let c1 s1.get(i)
            let c2 s2.get(i)
            if c1 < c2
                return interp.make_true()
            if c1 > c2
                return interp.make_false()
            set i: i + 1
        }
        if mode = 1
            return interp.make_bool(n1 < n2)
        interp.make_bool(n1 <= n2)
    }

    function string_to_list(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, obj)
        let s obj.string_data(host)
        var result interp.make_nil()
        var i s.get_size()
        while i > (0 as size_t)
        {
            set i: i - 1
            set result: ELObj.make_pair(host, ELObj.make_char(host, s.get(i)), result)
        }
        result
    }

    function list_to_string(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        ; count chars first
        var n: size_t 0
        var p obj
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 0, obj)
            let car p.get_car()
            if car.is_char_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notACharList(), name, 0, obj)
            set n: n + 1
            set p: p.get_cdr()
        }
        if n = (0 as size_t)
            return ELObj.make_string(host, StringC())
        let buf host.allocate(n * (sizeof u32), alignof u32) as pointer[u32]
        var i: size_t 0
        set p: obj
        while (p <> null) and (p.is_nil() = false)
        {
            let car p.get_car()
            set *(buf + i): car.char_value() as u32
            set i: i + 1
            set p: p.get_cdr()
        }
        ELObj.make_string(host, StringC(buf, n))
    }

    ; string->number: parse in the given radix (default 10). Non-numeric → #f.
    function string_to_number(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        if a0.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
        var radix 10
        if n_args > 1
        {
            let a1 *(args + 1)
            if a1.is_exact_integer() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, a1)
            let r a1.exact_integer_value()
            if (r = 2) or (r = 8) or (r = 10) or (r = 16)
                set radix: r
            else
            {
                ; invalid radix: report and continue with 10 (StringToNumber)
                interp.set_next_location(loc)
                interp.message0(InterpreterMessages.invalidRadix())
                set radix: 10
            }
        }
        let s a0.string_data(host)
        let n s.get_size()
        if n = (0 as size_t)
            return interp.make_false()
        ; radix-10 with a '.'/'e'/'E' → parse as a real
        if radix = 10
        {
            var is_real false
            var i: size_t 0
            while i < n
            {
                let c s.get(i)
                if (c = (0x2E as u32)) or (c = (0x65 as u32)) or (c = (0x45 as u32))
                    set is_real: true
                set i: i + 1
            }
            if is_real
                return Primitive.parse_real(host, interp, s)
        }
        Primitive.parse_integer(host, interp, s, radix)
    }

    function parse_integer(host: pointer[Page], interp: pointer[Interpreter], s: StringC, radix: int) returns pointer[ELObj]
    {
        let n s.get_size()
        var i: size_t 0
        var neg false
        let first s.get(0 as size_t)
        if first = (0x2D as u32)
        {
            set neg: true
            set i: 1 as size_t
        }
        else if first = (0x2B as u32)
            set i: 1 as size_t
        if i >= n
            return interp.make_false()
        var acc 0
        while i < n
        {
            let c s.get(i)
            var d 0 - 1
            if (c >= (0x30 as u32)) and (c <= (0x39 as u32))
                set d: (c - (0x30 as u32)) as int
            else if (c >= (0x61 as u32)) and (c <= (0x7A as u32))
                set d: (c - (0x61 as u32)) as int + 10
            else if (c >= (0x41 as u32)) and (c <= (0x5A as u32))
                set d: (c - (0x41 as u32)) as int + 10
            if (d < 0) or (d >= radix)
                return interp.make_false()
            set acc: acc * radix + d
            set i: i + 1
        }
        if neg
            set acc: 0 - acc
        ELObj.make_integer(host, acc)
    }

    function parse_real(host: pointer[Page], interp: pointer[Interpreter], s: StringC) returns pointer[ELObj]
    {
        let n s.get_size()
        ; build a NUL-terminated ASCII byte buffer for strtod
        let buf host.allocate(n + (1 as size_t), 1 as size_t) as pointer[u8]
        var i: size_t 0
        while i < n
        {
            set *(buf + i): s.get(i) as u8
            set i: i + 1
        }
        set *(buf + n): 0 as u8
        var endp: pointer[u8] null
        let v strtod(buf as pointer[const_char], &endp)
        ; reject if not all consumed
        if endp <> (buf + n)
            return interp.make_false()
        ELObj.make_real(host, v)
    }

    ; number->string: print with radix (2/8/10/16 only; else radix 10).
    function number_to_string(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        if a0.is_number() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANumber(), name, 0, a0)
        var radix 10
        if n_args > 1
        {
            let a1 *(args + 1)
            if a1.is_exact_integer() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, a1)
            let r a1.exact_integer_value()
            if (r = 2) or (r = 8) or (r = 10) or (r = 16)
                set radix: r
            else
            {
                ; invalid radix: report and continue with 10 (NumberToString)
                interp.set_next_location(loc)
                interp.message0(InterpreterMessages.invalidRadix())
                set radix: 10
            }
        }
        let os OutputCharStream.make(host)
        a0.print_radix(os, radix as u32, interp.get_units_per_inch())
        ELObj.make_string(host, os.to_string_c(host))
    }

    ; --- format-number (primitive.cxx formatNumberLetter/Decimal/Roman) ----
    ; formatNumberLetter — 1->a, 26->z, 27->aa; 0 -> "0"; a negative value
    ; appends '-' before the final segment reversal (so it ends up first).
    function format_number_letter(n: int, letters: pointer[const_char], out: pointer[Array[u32]])
    {
        if n = 0
        {
            out.add(0x30 as u32)
            return
        }
        var v n
        var neg false
        if v < 0
        {
            set v: 0 - v
            set neg: true
        }
        let start out.get_length()
        let lb letters as pointer[u8]
        repeat
        {
            set v: v - 1
            let r v % 26
            set v: (v - r) / 26
            out.add((*(lb + r)) as u32)
            if v <= 0
                break
        }
        if neg
            out.add(0x2D as u32)
        ; reverse the [start, end) segment
        let buf out.get_buffer()
        var i start
        var j out.get_length() - (1 as size_t)
        while i < j
        {
            let t *(buf + i)
            set *(buf + i): *(buf + j)
            set *(buf + j): t
            set i: i + (1 as size_t)
            set j: j - (1 as size_t)
        }
    }

    ; formatNumberDecimal — zero-padded to min_width digits; the '-' does not
    ; count toward the width.
    function format_number_decimal(n: int, min_width: size_t, out: pointer[Array[u32]])
    {
        var v n
        if v < 0
        {
            out.add(0x2D as u32)
            set v: 0 - v
        }
        var nd: size_t 1
        var t v / 10
        while t > 0
        {
            set nd: nd + (1 as size_t)
            set t: t / 10
        }
        while nd < min_width
        {
            out.add(0x30 as u32)
            set nd: nd + (1 as size_t)
        }
        ; digits, built reversed then flipped in place
        let start out.get_length()
        repeat
        {
            out.add(((v % 10) + 0x30) as u32)
            set v: v / 10
            if v <= 0
                break
        }
        let buf out.get_buffer()
        var i start
        var j out.get_length() - (1 as size_t)
        while i < j
        {
            let c *(buf + i)
            set *(buf + i): *(buf + j)
            set *(buf + j): c
            set i: i + (1 as size_t)
            set j: j - (1 as size_t)
        }
    }

    ; formatNumberRoman — out of range (|n| > 5000 or 0) falls back to plain
    ; decimal. letters = "mdclxvi" / "MDCLXVI"; the pointer advances 2 per
    ; decade so [0]=subtractive base, [1]=five-unit, [2]=one-unit.
    function format_number_roman(n: int, letters: pointer[const_char], out: pointer[Array[u32]])
    {
        if (n > 5000) or (n < (0 - 5000)) or (n = 0)
        {
            Primitive.format_number_decimal(n, 1 as size_t, out)
            return
        }
        var v n
        if v < 0
        {
            out.add(0x2D as u32)
            set v: 0 - v
        }
        let lb letters as pointer[u8]
        while v >= 1000
        {
            out.add((*lb) as u32)
            set v: v - 1000
        }
        var i 100
        var off 0
        while i > 0
        {
            let q v / i
            set v: v - (q * i)
            let l0 (*(lb + off)) as u32
            let l1 (*(lb + (off + 1))) as u32
            let l2 (*(lb + (off + 2))) as u32
            if q = 1
                out.add(l2)
            if q = 2
            {
                out.add(l2)
                out.add(l2)
            }
            if q = 3
            {
                out.add(l2)
                out.add(l2)
                out.add(l2)
            }
            if q = 4
            {
                out.add(l2)
                out.add(l1)
            }
            if q = 5
                out.add(l1)
            if q = 6
            {
                out.add(l1)
                out.add(l2)
            }
            if q = 7
            {
                out.add(l1)
                out.add(l2)
                out.add(l2)
            }
            if q = 8
            {
                out.add(l1)
                out.add(l2)
                out.add(l2)
                out.add(l2)
            }
            if q = 9
            {
                out.add(l2)
                out.add(l0)
            }
            set i: i / 10
            set off: off + 2
        }
    }

    ; formatNumber — dispatch on the LAST char of the format string; an
    ; unrecognized format falls back to plain decimal and returns false
    ; (the caller emits invalidNumberFormat but keeps the result).
    function format_number(n: int, fmt: StringC, out: pointer[Array[u32]]) returns bool
    {
        let len fmt.get_size()
        if len > (0 as size_t)
        {
            let last fmt.get(len - (1 as size_t))
            if last = (0x61 as u32)
            {
                Primitive.format_number_letter(n, "abcdefghijklmnopqrstuvwxyz", out)
                return true
            }
            if last = (0x41 as u32)
            {
                Primitive.format_number_letter(n, "ABCDEFGHIJKLMNOPQRSTUVWXYZ", out)
                return true
            }
            if last = (0x69 as u32)
            {
                Primitive.format_number_roman(n, "mdclxvi", out)
                return true
            }
            if last = (0x49 as u32)
            {
                Primitive.format_number_roman(n, "MDCLXVI", out)
                return true
            }
            if last = (0x31 as u32)
            {
                Primitive.format_number_decimal(n, len, out)
                return true
            }
        }
        Primitive.format_number_decimal(n, 1 as size_t, out)
        false
    }

    ; format-number (FormatNumber)
    function format_number_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        let a1 *(args + 1)
        if a0.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 0, a0)
        if a1.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 1, a1)
        let fmt a1.string_data(host)
        let out Array[u32]^host()
        if Primitive.format_number(a0.exact_integer_value(), fmt, out) = false
        {
            interp.set_next_location(loc)
            interp.message1(InterpreterMessages.invalidNumberFormat(), fmt)
        }
        ELObj.make_string(host, StringC(out.get_buffer(), out.get_length()))
    }

    ; format-number-list (FormatNumberList) — formats/seps may each be a
    ; single string (reused) or a list consumed in step; the reference's
    ; arg-index quirk on a non-string format element (index 0) is kept.
    function format_number_list_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], loc: Location) returns pointer[ELObj]
    {
        var numbers *args
        var formats *(args + 1)
        var seps *(args + 2)
        let out Array[u32]^host()
        while numbers.is_nil() = false
        {
            if numbers <> *args
            {
                var s StringC()
                if seps.has_string_data()
                    set s: seps.string_data(host)
                else
                {
                    if seps.is_pair() = false
                        return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 2, *(args + 2))
                    let scar seps.get_car()
                    if scar.has_string_data() = false
                        return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 2, scar)
                    set s: scar.string_data(host)
                    set seps: seps.get_cdr()
                }
                let sn s.get_size()
                var si: size_t 0
                while si < sn
                {
                    out.add(s.get(si))
                    set si: si + (1 as size_t)
                }
            }
            if numbers.is_pair() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 0, *args)
            let ncar numbers.get_car()
            if ncar.is_exact_integer() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 0, ncar)
            set numbers: numbers.get_cdr()
            var f StringC()
            if formats.has_string_data()
                set f: formats.string_data(host)
            else
            {
                if formats.is_pair() = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 1, *(args + 1))
                let fcar formats.get_car()
                if fcar.has_string_data() = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, fcar)
                set f: fcar.string_data(host)
                set formats: formats.get_cdr()
            }
            if Primitive.format_number(ncar.exact_integer_value(), f, out) = false
            {
                interp.set_next_location(loc)
                interp.message1(InterpreterMessages.invalidNumberFormat(), f)
            }
        }
        if out.get_length() = (0 as size_t)
            return ELObj.make_string(host, StringC())
        ELObj.make_string(host, StringC(out.get_buffer(), out.get_length()))
    }

    ; --- char primitives ---------------------------------------------------
    function integer_to_char(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 0, obj)
        let n obj.exact_integer_value()
        if (n < 0) or (n > 0x10FFFF)
            return Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
        ELObj.make_char(host, n as u32)
    }

    ; mode: 0 char=?, 1 char<?, 2 char<=?.
    ; GETCURLANG (primitive.cxx:4639) — the context's language, else the
    ; declared default IF that is a language; null = the caller must report
    ; noCurrentLanguage and return the error object. Every collating
    ; primitive is gated on this, `char=?` alone excepted.
    function current_lang(interp: pointer[Interpreter], ctx: pointer[VM]) returns pointer[ELObj]
    {
        let cl ctx.get_current_language()
        if cl <> null
        {
            if cl.is_language_p()
                return cl
        }
        let dl interp.get_default_language()
        if dl <> null
        {
            if dl.is_language_p()
                return dl
        }
        null
    }

    function no_current_language(interp: pointer[Interpreter]) returns pointer[ELObj]
    {
        ; ★the reference's GETCURLANG reports WITHOUT setNextLocation, so the
        ; diagnostic carries no file/line — measured.
        interp.message0(InterpreterMessages.noCurrentLanguage())
        interp.make_error()
    }

    ; LangObj::compare (LangObj.cxx:322) — the collating comparison of a
    ; define-language value, at collating strength `k`. ★A language with no
    ; `collate` clause has ZERO levels, so the loop body never runs and
    ; compare is 0 for EVERY pair: `char<?` is then always #f, `char<=?`
    ; always #t and `string-equiv?` always #t, whatever the code points say.
    ; Measured against the reference.
    ; The temporaries (collating-element and weight strings) go on the
    ; CALLER's host — a comparison must not allocate on the language's own
    ; run-arena page, or a sort loop grows the arena per comparison.
    function lang_compare(host: pointer[Page], lang: pointer[ELObj], a: StringC, b: StringC, k: u32) returns int
    {
        let lo lang.as_language()
        if lo = null
            return 0
        lo.compare(host, a, b, k)
    }

    function lang_levels(lang: pointer[ELObj]) returns u32
    {
        let lo lang.as_language()
        if lo = null
            return 0 as u32
        lo.levels()
    }

    ; char=? never consults a language; char<? and char<=? always do.
    ; mode: 0 char=?, 1 char<?, 2 char<=?.
    function char_compare(interp: pointer[Interpreter], name: StringC, a: pointer[ELObj], b: pointer[ELObj], loc: Location, mode: int, ctx: pointer[VM]) returns pointer[ELObj]
    {
        var lang: pointer[ELObj] null
        if mode <> 0
        {
            set lang: Primitive.current_lang(interp, ctx)
            if lang = null
                return Primitive.no_current_language(interp)
        }
        if a.is_char_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAChar(), name, 0, a)
        if b.is_char_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAChar(), name, 1, b)
        let c1 a.char_value()
        let c2 b.char_value()
        if mode = 0
            return interp.make_bool(c1 = c2)
        ; the one-character strings the reference builds for the collating
        ; comparison. The buffer is page-allocated, never `&local`: a
        ; stack address handed to StringC's copying init is not addressable
        ; here (it segfaults).
        let host interp.get_host()
        let b host.allocate(2 * (sizeof u32), alignof u32) as pointer[u32]
        set *b: c1 as u32
        set *(b + 1): c2 as u32
        let s1 StringC^host(b, 1 as size_t)
        let s2 StringC^host(b + 1, 1 as size_t)
        let r Primitive.lang_compare(host, lang, s1, s2, Primitive.lang_levels(lang))
        if mode = 1
            return interp.make_bool(r < 0)
        interp.make_bool(r <= 0)
    }

    ; string-equiv?: DEFPRIMITIVE(StringEquiv) — equivalence at collating
    ; strength k (a POSITIVE exact integer).
    function string_equiv(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        let lang Primitive.current_lang(interp, ctx)
        if lang = null
            return Primitive.no_current_language(interp)
        let a0 *args
        if a0.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
        let a1 *(args + 1)
        if a1.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 1, a1)
        let a2 *(args + 2)
        var k 0
        if a2.is_exact_integer()
            set k: a2.exact_integer_value()
        if k <= 0
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAPositiveInteger(), name, 2, a2)
        ; areEquivalent — comparison capped at the requested strength.
        let sa a0.string_data(host)
        let sb a1.string_data(host)
        let r Primitive.lang_compare(host, lang, sa, sb, k as u32)
        interp.make_bool(r = 0)
    }

    ; with-language: DEFPRIMITIVE(WithLanguage) — bind the context language
    ; around a THUNK (a procedure taking nothing at all, like
    ; map-constructor's) and restore it afterwards, error or not.
    function with_language(host: pointer[Page], interp: pointer[Interpreter], name: StringC, lang: pointer[ELObj], f: pointer[ELObj], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        if lang.is_language_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notALanguage(), name, 0, lang)
        if f.is_function() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAProcedure(), name, 1, f)
        if (f.n_required_args() + f.n_optional_args()) > 0
        {
            ; ★no setNextLocation here either (the reference calls message
            ; directly), so this diagnostic is location-less too.
            interp.message0(InterpreterMessages.tooManyArgs())
            return interp.make_error()
        }
        let saved ctx.get_current_language()
        ctx.set_current_language(lang)
        let vm VM.make(host, interp)
        vm.set_current_node(ctx.get_current_node())
        vm.set_processing_mode(ctx.get_processing_mode())
        vm.set_current_language(lang)
        let insn f.make_call_insn(0, interp, loc, null)
        let ret vm.eval(insn, null, null)
        ctx.set_current_language(saved)
        ret
    }

    ; char-upcase / char-downcase — GETCURLANG, then the language's case
    ; tables (define-language pairs; a miss is identity, so sf latin1 folds
    ; the umlauts and nothing else). ★Without a language this now reports
    ; noCurrentLanguage like the reference: the ASCII fallback this port used
    ; to apply was a marked deviation, and it is closed — a stylesheet that
    ; wants ASCII folding has to declare a language that says so, exactly as
    ; the reference demands.
    function char_case(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location, up: bool, ctx: pointer[VM]) returns pointer[ELObj]
    {
        let lang Primitive.current_lang(interp, ctx)
        if lang = null
            return Primitive.no_current_language(interp)
        if obj.is_char_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAChar(), name, 0, obj)
        let c obj.char_value()
        ELObj.make_char(host, lang.language_case(c as u32, up))
    }

    ; --- vector primitives -------------------------------------------------
    function make_vector_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        if a0.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 0, a0)
        let k a0.exact_integer_value()
        if k < 0
            return Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
        var fill interp.make_unspecified()
        if n_args > 1
            set fill: *(args + 1)
        ELObj.make_vector(host, k as size_t, fill)
    }

    function vector_ref(interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], k_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.is_vector_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAVector(), name, 0, obj)
        if k_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, k_obj)
        let k k_obj.exact_integer_value()
        if (k < 0) or ((k as size_t) >= obj.vector_length())
            return Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
        obj.vector_elem(k as size_t)
    }

    function vector_set(interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], k_obj: pointer[ELObj], val: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.is_vector_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAVector(), name, 0, obj)
        if k_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, k_obj)
        let k k_obj.exact_integer_value()
        if (k < 0) or ((k as size_t) >= obj.vector_length())
            return Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
        obj.vector_set_elem(k as size_t, val)
        interp.make_unspecified()
    }

    ; vector-fill!: DEFPRIMITIVE(VectorFill) — every slot takes argument 2.
    ; ★The reference's readOnly gate is NOT reproduced: readOnly is a
    ; COLLECTOR bit (Collector.h:20, set by makePermanent and the tracing
    ; pass), and this port has no collector — the same reason vector-set!
    ; carries no such check. Nothing in the language can observe the bit
    ; other than by mutating a permanent object, which our object model does
    ; not distinguish.
    function vector_fill(interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], val: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.is_vector_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAVector(), name, 0, obj)
        let n obj.vector_length()
        var i 0 as size_t
        while i < n
        {
            obj.vector_set_elem(i, val)
            set i: i + (1 as size_t)
        }
        interp.make_unspecified()
    }

    ; quantity->number: DEFPRIMITIVE(QuantityToNumber) — a DIMENSIONLESS
    ; quantity passes through with its exactness; a dimensioned one is scaled
    ; into METRES per dimension and always comes back inexact. (The reference
    ; carries a FIXME here about what "the number of the quantity" even means;
    ; the arithmetic is ported as written.)
    function quantity_to_number(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        let qv obj.quantity_value()
        let t qv.get_qtype()
        if t = QT_NONE
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, 0, obj)
        let dim qv.get_dim()
        if t = QT_DOUBLE
        {
            let d qv.get_dval()
            if dim = 0
                return ELObj.make_real(host, d)
            let f pow(0.0254 / (interp.get_units_per_inch() as double), dim as double)
            return ELObj.make_real(host, d * f)
        }
        let n qv.get_lval()
        if dim = 0
            return ELObj.make_integer(host, n)
        let f pow(0.0254 / (interp.get_units_per_inch() as double), dim as double)
        ELObj.make_real(host, (n as double) * f)
    }

    ; quantity->string: DEFPRIMITIVE(QuantityToString) — number->string with
    ; the quantityValue gate instead of the realValue one, so it prints what
    ; number->string refuses (a length as "1pt1", an area as "1pt2").
    function quantity_to_string(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        let qv a0.quantity_value()
        if qv.get_qtype() = QT_NONE
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, 0, a0)
        var radix 10
        if n_args > 1
        {
            let a1 *(args + 1)
            if a1.is_exact_integer() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, a1)
            let r a1.exact_integer_value()
            if (r = 2) or (r = 8) or (r = 10) or (r = 16)
                set radix: r
            else
            {
                interp.set_next_location(loc)
                interp.message0(InterpreterMessages.invalidRadix())
                set radix: 10
            }
        }
        let os OutputCharStream.make(host)
        a0.print_radix(os, radix as u32, interp.get_units_per_inch())
        ELObj.make_string(host, os.to_string_c(host))
    }

    ; map-constructor: DEFPRIMITIVE(MapConstructor) — call a ZERO-argument
    ; procedure once per node of the list, with that node as the current
    ; node, and append the sosofos it returns. The arity gate is the mirror
    ; image of node-list-map's: here totalArgs() must be 0, i.e. the
    ; procedure may take NOTHING (a required OR optional parameter is
    ; tooManyArgs).
    function map_constructor(host: pointer[Page], interp: pointer[Interpreter], name: StringC, f: pointer[ELObj], nl: pointer[ELObj], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        if f.is_function() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAProcedure(), name, 0, f)
        if (f.n_required_args() + f.n_optional_args()) > 0
            return Primitive.simple_error(interp, loc, InterpreterMessages.tooManyArgs())
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 1, nl)
        ; the parts must OUTLIVE the loop, so unlike node-list-map there is no
        ; per-call scratch region here: a sosofo is the result, not a grove
        ; pointer.
        let parts Array[pointer[ELObj]]^host()
        let n nl.node_list_count()
        var i 0
        while i < n
        {
            let node nl.node_list_node(i)
            if node <> null
            {
                let vm VM.make(host, interp)
                vm.set_current_node(node)
                vm.set_processing_mode(ctx.get_processing_mode())
                let insn f.make_call_insn(0, interp, loc, null)
                let ret vm.eval(insn, null, null)
                if interp.is_error(ret)
                    return ret
                if ret.is_sosofo_p() = false
                {
                    interp.set_next_location(loc)
                    interp.message0(InterpreterMessages.returnNotSosofo())
                    return interp.make_error()
                }
                parts.add(ret)
            }
            set i: i + 1
        }
        ELObj.make_sosofo(host, parts)
    }

    function vector_to_list(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.is_vector_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAVector(), name, 0, obj)
        var result interp.make_nil()
        var i obj.vector_length()
        while i > (0 as size_t)
        {
            set i: i - 1
            set result: ELObj.make_pair(host, obj.vector_elem(i), result)
        }
        result
    }

    function list_to_vector(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        var n: size_t 0
        var p obj
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 0, obj)
            set n: n + 1
            set p: p.get_cdr()
        }
        let vec ELObj.make_vector(host, n, interp.make_false())
        var i: size_t 0
        set p: obj
        while (p <> null) and (p.is_nil() = false)
        {
            vec.vector_set_elem(i, p.get_car())
            set i: i + 1
            set p: p.get_cdr()
        }
        vec
    }

    ; list-tail: drop the first k pairs.
    function list_tail(interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], k_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if k_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, k_obj)
        var k k_obj.exact_integer_value()
        if k < 0
            return Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
        var p obj
        while k > 0
        {
            if p.is_pair() = false
            {
                if p.is_nil()
                    return Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 0, obj)
            }
            set p: p.get_cdr()
            set k: k - 1
        }
        p
    }

    ; --- grove / node-list helpers -----------------------------------------
    function node_list_ref(host: pointer[Page], interp: pointer[Interpreter], name: StringC, nl: pointer[ELObj], k_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, nl)
        if k_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, k_obj)
        let k k_obj.exact_integer_value()
        if (k < 0) or (k >= nl.node_list_count())
            return ELObj.make_node_list(host, null, 0)
        ELObj.make_node_singleton(host, nl.node_list_node(k))
    }

    ; node-list: concatenate the argument node-lists into one buffer.
    function node_list_concat(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let arr Array[pointer[GroveNode]]^host()
        var i 0
        while i < n_args
        {
            let a *(args + i)
            if a.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, i, a)
            let c a.node_list_count()
            var j 0
            while j < c
            {
                arr.add(a.node_list_node(j))
                set j: j + 1
            }
            set i: i + 1
        }
        ELObj.make_node_list(host, arr, 0)
    }

    ; children: the child axis of the first node (empty if none / not present).
    ; children: DEFPRIMITIVE(Children) — a singleton yields the node's child
    ; list; a NON-singleton node-list maps `children` over every member and
    ; appends (the reference wraps itself in a MapNodeListObj), so nested
    ; `(children (children nl))` flattens across all members.
    function children(host: pointer[Page], interp: pointer[Interpreter], name: StringC, nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, nl)
        let n nl.node_list_count()
        if n = 0
            return nl
        ; the reference's children node-list has ONE node per character of a
        ; data run. The members stay chunk-level and the prefix index carries
        ; the expansion (ELObj.make_node_list_expanded) — the per-character
        ; views are materialized only if a caller asks for one.
        let result Array[pointer[GroveNode]]^host()
        var i 0
        while i < n
        {
            let node nl.node_list_node(i)
            if node <> null
            {
                ; the CHILDREN AXIS (Node::firstChild), not the structural child
                ; list: `children` of the sgml-document node is EMPTY in the
                ; reference (the class has no children property at all — its
                ; subnodes are prolog / document-element / epilog).
                let m node.axis_child_count()
                var j 0
                while j < m
                {
                    result.add(node.axis_child_at(j))
                    set j: j + 1
                }
            }
            set i: i + 1
        }
        ELObj.make_node_list_expanded(host, result, 0)
    }

    ; Node::getGi — accessOK for the THREE classes that implement it: an ELEMENT
    ; (its chunk's type name), an ELEMENT-TYPE and an ELEMENT-TOKEN (their
    ; declared names). Several primitives use getGi as a GATE (gi,
    ; first-sibling?, last-sibling?), so the test has to name all three —
    ; measured: `(gi <element-type>)` is "DOC" and `(gi <entity>)` is #f.
    function node_has_gi(node: pointer[GroveNode]) returns bool
    {
        let cls node.get_class()
        if cls = GN_ELEMENT
            return true
        if cls = GN_ELEMENT_TYPE
            return true
        cls = GN_ELEMENT_TOKEN
    }

    function gi_of(node: pointer[GroveNode]) returns StringC
    {
        let cls node.get_class()
        if cls = GN_ELEMENT_TYPE
        {
            let et node.get_decl() as pointer[ElementType]
            if et = null
                return StringC()
            return et.get_name()
        }
        if cls = GN_ELEMENT_TOKEN
        {
            let leaf node.get_decl() as pointer[CmNode]
            if leaf = null
                return StringC()
            let let1 leaf.element
            if let1 = null
                return StringC()
            return let1.get_name()
        }
        node.get_gi()
    }

    ; gi: the generic identifier of the first node, else #f.
    function node_gi(host: pointer[Page], interp: pointer[Interpreter], name: StringC, nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnOptSingletonNode(), name, 0, nl)
        let node nl.node_list_node(0)
        if node = null
            return interp.make_false()
        if Primitive.node_has_gi(node) = false
            return interp.make_false()
        let g Primitive.gi_of(node)
        ELObj.make_string(host, g)
    }

    ; data: the string value — the concatenated descendant data of EVERY
    ; member of the node list (DEFPRIMITIVE(Data) loops nodeListFirst/
    ; nodeListChunkRest, appending nodeData per node into ONE StringObj;
    ; the earlier first-node-only reading dropped the tail members of
    ; multi-<return> sprocs).
    function node_data(host: pointer[Page], interp: pointer[Interpreter], name: StringC, nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, nl)
        ; A data node that is a LIST MEMBER is a per-character node and
        ; contributes exactly ITS character (measured: `(data <char node>)` =
        ; "F"); a data chunk reached by RECURSION through an element's content
        ; contributes the whole run (the reference walks content chunk-wise via
        ; charChunk). Both together reproduce `(data (children p))` =
        ; "First inner text." — every character once.
        ;
        ; Walked per MEMBER, not per character position: a data member spans a
        ; whole run whose characters are exactly the per-character nodes it
        ; stands for, so appending the run in one go yields the identical
        ; string without materializing a single view. `skip` is the part of the
        ; first member a preceding node-list-rest already consumed.
        let n nl.node_list_member_count()
        let skip nl.node_list_member_skip()
        let px nl.node_list_prefix()
        let expanded px <> null
        var total: size_t 0
        var i 0
        while i < n
        {
            let node nl.node_list_member(i)
            if node <> null
            {
                if node.get_class() = GN_DATA
                    set total: total + Primitive.data_member_len(node, i, skip, expanded)
                else
                    set total: total + Primitive.collect_data_len(interp, node)
            }
            set i: i + 1
        }
        if total = (0 as size_t)
            return ELObj.make_string(host, StringC())
        let buf host.allocate(total * (sizeof u32), alignof u32) as pointer[u32]
        var off: size_t 0
        var j 0
        while j < n
        {
            let node nl.node_list_member(j)
            if node <> null
            {
                if node.get_class() = GN_DATA
                {
                    let s node.get_chars()
                    let f Primitive.data_member_first(node, j, skip)
                    let e f + Primitive.data_member_len(node, j, skip, expanded)
                    var k f
                    while k < e
                    {
                        set *(buf + off): s.get(k)
                        set off: off + (1 as size_t)
                        set k: k + (1 as size_t)
                    }
                }
                else
                    set off: Primitive.collect_data_fill(interp, node, buf, off)
            }
            set j: j + 1
        }
        ELObj.make_string(host, StringC(buf, total))
    }

    ; --- property axis (Inc 4) ---------------------------------------------
    ; A GI / attribute-name argument may arrive as a string or a symbol; both
    ; carry a name StringC (else empty). Single construction site + one tail
    ; return (a by-value struct returned from multiple branches region-allocates
    ; per site and the merging phi fails llc verification).
    function name_arg(host: pointer[Page], obj: pointer[ELObj]) returns StringC
    {
        var result StringC()
        if obj.is_string_p()
            set result: obj.string_data(host)
        else if obj.is_symbol_p()
            set result: obj.symbol_name()
        result
    }

    ; parent: the parent AXIS of the first node — empty node-list when the axis
    ; has no parent (DEFPRIMITIVE(Parent): `getParent != accessOK ->
    ; makeEmptyNodeList`). ChunkNode::getParent stops at the document element,
    ; so the sgml-document node is not reachable here; see get_axis_parent.
    function node_parent(host: pointer[Page], interp: pointer[Interpreter], name: StringC, nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnOptSingletonNode(), name, 0, nl)
        let node nl.node_list_node(0)
        if node = null
            return ELObj.make_node_list(host, null, 0)
        let p node.get_axis_parent()
        if p = null
            return ELObj.make_node_list(host, null, 0)
        ELObj.make_node_singleton(host, p)
    }

    ; attribute-string: the value of the named attribute on the first node of
    ; the node-list arg, as a string — or #f when the attribute is absent.
    ; Faithful to nodeAttributeString / DEFPRIMITIVE(AttributeString): read
    ; arg0 as the attribute name, look it up in the node's attribute list, and
    ; return its text. The reference's 1-arg (current-node) form needs a
    ; current-node context, not yet modeled here, so the node-list is required.
    ; Name lookup is AttrLookup.index_ci — the case-insensitive approximation
    ; of normalizeGeneralName for both namecase regimes (a lowercase name
    ; matches an upper-folded SGML grove AND an as-is XML grove).
    function attribute_string(host: pointer[Page], interp: pointer[Interpreter], name: StringC, name_obj: pointer[ELObj], nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if name_obj.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, name_obj)
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnOptSingletonNode(), name, 1, nl)
        let node nl.node_list_node(0)
        if node = null
            return interp.make_false()
        let atts node.get_attributes()
        if atts = null
            return interp.make_false()
        let nm name_obj.string_data(host)
        let idx AttrLookup.index_ci(atts, nm)
        if idx < 0
            return interp.make_false()
        let v atts.value(idx as size_t)
        if v = null
            return interp.make_false()
        let t v.get_text()
        if t = null
            return interp.make_false()
        let s t.string()
        ELObj.make_string(host, s)
    }

    ; select-elements: the members of a node-list matching a pattern (a GI
    ; string/symbol, #t, or an ancestor/attribute-qualifier list). Faithful to
    ; DEFPRIMITIVE(SelectElements) — convertToPattern the 2nd arg, filter the
    ; node-list. (Inc 5: unblocked by the Pattern type.)
    function select_elements(host: pointer[Page], interp: pointer[Interpreter], name: StringC, nl: pointer[ELObj], pat_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, nl)
        let pat Pattern.convert(host, interp, pat_obj, loc)
        ; convertToPattern reports its own diagnostic (work package 10); the
        ; primitive only mirrors the bare makeError (SelectElements).
        if pat = null
            return interp.make_error()
        let result Array[pointer[GroveNode]]^host()
        ; walk MEMBERS, not character positions: an element pattern can never
        ; match a data-char or PI node (Element::matches bails on the class),
        ; and a node-list over mixed content is mostly characters. This is the
        ; reference's chunk skip (SelectElementsNodeListObj::nodeListChunkRest
        ; steps over a whole data chunk at once) — a data run costs one step
        ; here instead of one Pattern.matches call, hence one region, per
        ; character. Elements always span one position, so the member walk and
        ; the flat walk agree on everything this primitive can select.
        let n nl.node_list_member_count()
        var i 0
        while i < n
        {
            let node nl.node_list_member(i)
            if node <> null
            {
                if node.get_class() = GN_ELEMENT
                {
                    if pat.matches(host, interp, node)
                        result.add(node)
                }
            }
            set i: i + 1
        }
        ELObj.make_node_list(host, result, 0)
    }

    ; element-with-id: the element in the grove whose ID-typed attribute equals
    ; the given string, as a singleton node-list (empty if none). DEFPRIMITIVE
    ; (ElementWithId): the optional 2nd arg NAMES THE GROVE to search — a strict
    ; singleton whose grove root's `elements` list answers; without it the
    ; current node's grove, and no current node is a hard diagnostic.
    function element_with_id(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        let id_obj *args
        if id_obj.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, id_obj)
        var gnode: pointer[GroveNode] null
        if n_args > 1
        {
            let a1 *(args + 1)
            if a1.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 1, a1)
            let nd a1.node_list_node(0)
            if nd = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 1, a1)
            set gnode: nd
        }
        else
        {
            let cn ctx.get_current_node()
            if cn = null
                return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
            set gnode: cn
        }
        ; ★the id goes through the ELEMENTS named node list, so it is FOLDED
        ; with the general substitution table before the lookup —
        ; `(element-with-id "probe")` has to reach an element stored under
        ; `PROBE`. Without the fold only an already-upper-cased id hit.
        let q Primitive.nnl_normalize(host, gnode, NNL_ELEMENTS, id_obj.string_data(host))
        let node GroveBuilder.element_by_id(host, gnode, *q)
        let result Array[pointer[GroveNode]]^host()
        if node <> null
            result.add(node)
        ELObj.make_node_list(host, result, 0)
    }

    ; ancestor: the nearest ancestor element of the first node whose GI equals
    ; the given name, or the empty node-list. The GI compare is GiMatch —
    ; convertGeneralName normalizes the argument per the grove's namecase.
    function ancestor(host: pointer[Page], interp: pointer[Interpreter], name: StringC, gi_obj: pointer[ELObj], nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 1, nl)
        let node nl.node_list_node(0)
        ; DEFPRIMITIVE Ancestor: an explicit EMPTY node list is the same
        ; notASingletonNode arg error (`|| !node`), not an empty result.
        if node = null
            return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 1, nl)
        let target Primitive.name_arg(host, gi_obj)
        ; DEFPRIMITIVE(Ancestor) walks getParent -> the parent AXIS.
        var cur node.get_axis_parent()
        while cur <> null
        {
            if cur.get_class() = GN_ELEMENT
            {
                let g cur.get_gi()
                if GiMatch.equal(g, target)
                    return ELObj.make_node_singleton(host, cur)
            }
            set cur: cur.get_axis_parent()
        }
        ELObj.make_node_list(host, null, 0)
    }

    ; descendants: every descendant, in document order (self excluded).
    ; DEFPRIMITIVE(Descendants) — like children, a non-singleton node-list
    ; maps itself over the members.
    function descendants(host: pointer[Page], interp: pointer[Interpreter], name: StringC, nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, nl)
        let n nl.node_list_count()
        if n = 0
            return nl
        let arr Array[pointer[GroveNode]]^host()
        var i 0
        while i < n
        {
            let node nl.node_list_node(i)
            if node <> null
                Primitive.collect_descendants(host, node, arr)
            set i: i + 1
        }
        ELObj.make_node_list_expanded(host, arr, 0)
    }

    ; the node's sibling group (Grove.sibling_range_*) as CHUNK-LEVEL members —
    ; what preced/follow walk over, character-expanded through the node-list
    ; prefix index (ELObj.make_node_list_expanded), never as a flat per-char
    ; array. A char VIEW gets the same group as its chunk, so it finds ITSELF in
    ; the list via GroveNode.node_same.
    procedure collect_expanded_siblings(host: pointer[Page], node: pointer[GroveNode], out: pointer[Array[pointer[GroveNode]]])
    {
        let par node.get_parent()
        if par = null
            return
        let m node.sibling_range_end()
        var j node.sibling_range_begin()
        while j < m
        {
            out.add(node.sibling_group_at(j))
            set j: j + 1
        }
    }

    ; document order as CHUNK-LEVEL members; data chunks expand per character
    ; through the caller's prefix index, like the child axis (measured:
    ; descendants of `First <em>inner</em> text.` = 13 + 5 = 18).
    ; DescendantsNodeListObj::advance walks assignFirstChild, so this is the
    ; children AXIS too — `descendants` of the sgml-document node is empty.
    procedure collect_descendants(host: pointer[Page], node: pointer[GroveNode], arr: pointer[Array[pointer[GroveNode]]])
    {
        let n node.axis_child_count()
        var i 0
        while i < n
        {
            let ch node.axis_child_at(i)
            arr.add(ch)
            if ch.get_class() <> GN_DATA
                Primitive.collect_descendants(host, ch, arr)
            set i: i + 1
        }
    }

    ; id: the node's unique identifier — the value of its ID-typed attribute —
    ; or #f. DEFPRIMITIVE(Id): the optional arg is an opt-singleton node-list
    ; (an empty one yields #f); without it the current node, whose absence is
    ; the noCurrentNode error.
    function node_id(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        var node: pointer[GroveNode] null
        if n_args > 0
        {
            let a0 *args
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAnOptSingletonNode(), name, 0, a0)
            set node: a0.node_list_node(0)
        }
        else
        {
            set node: ctx.get_current_node()
            if node = null
                return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
        }
        if node = null
            return interp.make_false()
        let atts node.get_attributes()
        if atts = null
            return interp.make_false()
        let sz atts.size()
        var i: size_t 0
        while i < sz
        {
            if atts.id(i)
            {
                let v atts.value(i)
                if v <> null
                {
                    let t v.get_text()
                    if t <> null
                    {
                        let s t.string()
                        return ELObj.make_string(host, s)
                    }
                }
            }
            set i: i + 1
        }
        interp.make_false()
    }

    ; The 0/1-arg singleton-node resolution shared by first-sibling? /
    ; last-sibling? / child-number (DEFPRIMITIVE arg handling: a present arg
    ; must resolve to a NON-empty singleton, absent means the current node).
    ; Returns null when an error object must be produced instead; err_kind
    ; distinguishes the two error shapes (0 = notASingletonNode on the arg,
    ; 1 = noCurrentNode).
    function singleton_node_arg(n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM]) returns pointer[GroveNode]
    {
        var node: pointer[GroveNode] null
        if n_args > 0
        {
            let a0 *args
            if a0.is_node_list_p()
                set node: a0.node_list_node(0)
        }
        else
            set node: ctx.get_current_node()
        node
    }

    ; first-sibling?: no preceding sibling element shares the node's GI.
    ; DEFPRIMITIVE(IsFirstSibling): a node whose GI is inaccessible (a
    ; non-element) is #f; siblings without a GI (data/pi chunks) are skipped.
    function is_first_sibling(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        if n_args > 0
        {
            let a0 *args
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 0, a0)
            if a0.node_list_node(0) = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 0, a0)
        }
        else if ctx.get_current_node() = null
            return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
        let node Primitive.singleton_node_arg(n_args, args, ctx)
        ; the gate is getGi, which the element-TYPE and element-TOKEN classes
        ; implement too (Primitive.node_has_gi)
        if Primitive.node_has_gi(node) = false
            return interp.make_false()
        let par node.get_parent()
        if par = null
            return interp.make_false()
        ; IsFirstSibling: a failing firstSibling is #f — the document element has
        ; no sibling axis at all (Grove.has_siblings).
        if node.has_siblings() = false
            return interp.make_false()
        let g Primitive.gi_of(node)
        let n node.sibling_range_end()
        var i node.sibling_range_begin()
        while i < n
        {
            let s node.sibling_group_at(i)
            if s = node
                return interp.make_true()
            if s.get_class() = GN_ELEMENT
            {
                let sg s.get_gi()
                if sg.equals(g)
                    return interp.make_false()
            }
            set i: i + 1
        }
        interp.make_true()
    }

    ; last-sibling?: no following sibling element shares the node's GI.
    ; DEFPRIMITIVE(IsLastSibling).
    function is_last_sibling(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        if n_args > 0
        {
            let a0 *args
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 0, a0)
            if a0.node_list_node(0) = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 0, a0)
        }
        else if ctx.get_current_node() = null
            return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
        let node Primitive.singleton_node_arg(n_args, args, ctx)
        if Primitive.node_has_gi(node) = false
            return interp.make_false()
        let par node.get_parent()
        if par = null
            return interp.make_true()
        ; IsLastSibling walks nextChunkSibling only — no firstSibling call, so a
        ; node without a sibling axis (the document element, and every
        ; DECLARATION node that has a gi) is #t.
        let g Primitive.gi_of(node)
        let n node.sibling_range_end()
        var i node.sibling_range_begin()
        var found false
        while i < n
        {
            let s node.sibling_group_at(i)
            if found
            {
                if s.get_class() = GN_ELEMENT
                {
                    let sg s.get_gi()
                    if sg.equals(g)
                        return interp.make_false()
                }
            }
            else if s = node
                set found: true
            set i: i + 1
        }
        interp.make_true()
    }

    ; child-number: the 1-based position of the node among the siblings with
    ; the same GI. DEFPRIMITIVE(ChildNumber) via NumberCache::childNumber
    ; (semantics without the cache): a GI-less node is #f, the document
    ; element (no parent) is 1, else 1 + the count of preceding same-GI
    ; sibling elements.
    function child_number(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        if n_args > 0
        {
            let a0 *args
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 0, a0)
            if a0.node_list_node(0) = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 0, a0)
        }
        else if ctx.get_current_node() = null
            return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
        let node Primitive.singleton_node_arg(n_args, args, ctx)
        ; ★the gate stays the ELEMENT class although getGi also succeeds for the
        ; element-TYPE and element-TOKEN classes: NumberCache::advance ASSERTS
        ; (and the reference aborts, measured) as soon as it is asked to number a
        ; declaration node, so there is no reference behaviour to reproduce.
        if node.get_class() <> GN_ELEMENT
            return interp.make_false()
        ; NumberCache::childNumber: `getParent != accessOK` -> 0 ("must be
        ; document element"), which the primitive turns into 1. That test is the
        ; parent AXIS; the sibling COUNT below stays structural (the reference
        ; counts with firstSibling/nextChunkSibling).
        if node.get_axis_parent() = null
            return ELObj.make_integer(host, 1)
        let par node.get_parent()
        let g node.get_gi()
        var count 0
        let n par.child_count()
        var i 0
        while i < n
        {
            let s node.sibling_group_at(i)
            if s = node
                return ELObj.make_integer(host, count + 1)
            if s.get_class() = GN_ELEMENT
            {
                let sg s.get_gi()
                if sg.equals(g)
                    set count: count + 1
            }
            set i: i + 1
        }
        ELObj.make_integer(host, count + 1)
    }

    ; the optional-singleton decode at arg index k for the strict (`|| !node
    ; -> notASingletonNode`) query primitives; without the arg, the current
    ; node. The CALLER must have verified the arg/current-node preconditions
    ; (mirroring singleton_node_arg's contract).
    function singleton_node_arg_at(n_args: int, args: pointer[pointer[ELObj]], k: int, ctx: pointer[VM]) returns pointer[GroveNode]
    {
        var node: pointer[GroveNode] null
        if n_args > k
        {
            let ak *(args + k)
            if ak.is_node_list_p()
                set node: ak.node_list_node(0)
        }
        else
            set node: ctx.get_current_node()
        node
    }

    ; the same-GI ordinal among the node's preceding siblings, 1-based
    ; (NumberCache::childNumber + the primitive's +1; document element = 1).
    function same_gi_sibling_ordinal(node: pointer[GroveNode]) returns int
    {
        ; the childNumber early-out is the parent AXIS (document element -> 0,
        ; +1 = 1); the count itself is structural.
        if node.get_axis_parent() = null
            return 1
        let par node.get_parent()
        let g node.get_gi()
        var count 0
        let n par.child_count()
        var i 0
        while i < n
        {
            let s node.sibling_group_at(i)
            if s = node
                return count + 1
            if s.get_class() = GN_ELEMENT
            {
                let sg s.get_gi()
                if sg.equals(g)
                    set count: count + 1
            }
            set i: i + 1
        }
        count + 1
    }

    ; have-ancestor?: DEFPRIMITIVE IsHaveAncestor. The string form walks the
    ; parent axis for a GI match (convertGeneralName -> namecase-insensitive
    ; GiMatch); the list form is matchAncestors — the ancestor chain, OUTERMOST
    ; first, must consume the whole pattern list (non-consecutive matches
    ; allowed); a non-list / non-string member is the notAList arg error.
    function have_ancestor(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        if n_args > 1
        {
            let a1 *(args + 1)
            if a1.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 1, a1)
            if a1.node_list_node(0) = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 1, a1)
        }
        else if ctx.get_current_node() = null
            return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
        let node Primitive.singleton_node_arg_at(n_args, args, 1, ctx)
        let a0 *args
        if a0.has_string_data()
        {
            let target a0.string_data(host)
            ; DEFPRIMITIVE(IsHaveAncestor) walks getParent -> the parent AXIS.
            var cur node.get_axis_parent()
            while cur <> null
            {
                if cur.get_class() = GN_ELEMENT
                {
                    let cg cur.get_gi()
                    if GiMatch.equal(cg, target)
                        return interp.make_true()
                }
                set cur: cur.get_axis_parent()
            }
            return interp.make_false()
        }
        ; list form (matchAncestors): ancestors top-down against the pattern —
        ; matchAncestors likewise walks getParent (the AXIS).
        let chain Array[pointer[GroveNode]]^host()
        var p node.get_axis_parent()
        while p <> null
        {
            chain.add(p)
            set p: p.get_axis_parent()
        }
        var unmatched a0
        var i (chain.get_length() as int) - 1
        while i >= 0
        {
            if unmatched.is_nil() = false
            {
                if unmatched.is_pair() = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 0, a0)
                let want unmatched.get_car()
                if want.has_string_data() = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 0, a0)
                let anc *(chain.get_buffer() + i)
                if anc.get_class() = GN_ELEMENT
                {
                    let ag anc.get_gi()
                    if GiMatch.equal(ag, want.string_data(host))
                        set unmatched: unmatched.get_cdr()
                }
            }
            set i: i - 1
        }
        interp.make_bool(unmatched.is_nil())
    }

    ; inherited-attribute-string: the named attribute on the node or its
    ; nearest ancestor carrying a value for it (DEFPRIMITIVE
    ; InheritedAttributeString — the do/while getParent walk). An explicit
    ; EMPTY osnl is #f, not an error (notAnOptSingletonNode gate).
    function inherited_attribute_string(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        var node: pointer[GroveNode] null
        if n_args > 1
        {
            let a1 *(args + 1)
            if a1.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAnOptSingletonNode(), name, 1, a1)
            set node: a1.node_list_node(0)
            if node = null
                return interp.make_false()
        }
        else
        {
            set node: ctx.get_current_node()
            if node = null
                return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
        }
        let a0 *args
        if a0.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
        let nm a0.string_data(host)
        ; DEFPRIMITIVE(InheritedAttributeString) walks `getParent` from the node
        ; upwards -> the parent AXIS (it stops at the document element).
        var cur node
        while cur <> null
        {
            let atts cur.get_attributes()
            if atts <> null
            {
                let idx AttrLookup.index_ci(atts, nm)
                if idx >= 0
                {
                    let v atts.value(idx as size_t)
                    if v <> null
                    {
                        let t v.get_text()
                        if t <> null
                        {
                            let s t.string()
                            return ELObj.make_string(host, s)
                        }
                    }
                }
            }
            set cur: cur.get_axis_parent()
        }
        interp.make_false()
    }

    ; inherited-element-attribute-string: DEFPRIMITIVE
    ; (InheritedElementAttributeString) — inherited-attribute-string narrowed
    ; to a GI: the walk climbs the parent axis and takes the attribute from
    ; the first node that BOTH has that GI and has the attribute. ★An empty
    ; explicit node-list is #f, not a diagnostic (the opt-singleton form).
    function inherited_element_attribute_string(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        var node: pointer[GroveNode] null
        if n_args > 2
        {
            let a2 *(args + 2)
            if a2.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAnOptSingletonNode(), name, 2, a2)
            set node: a2.node_list_node(0)
            if node = null
                return interp.make_false()
        }
        else
        {
            set node: ctx.get_current_node()
            if node = null
                return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
        }
        let a0 *args
        let target Primitive.convert_general_name(host, node, a0)
        if target = null
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
        let a1 *(args + 1)
        if a1.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 1, a1)
        let nm a1.string_data(host)
        var cur node
        while cur <> null
        {
            if cur.get_class() = GN_ELEMENT
            {
                let cg cur.get_gi()
                if cg.equals(*target)
                {
                    let atts cur.get_attributes()
                    if atts <> null
                    {
                        let idx AttrLookup.index_ci(atts, nm)
                        if idx >= 0
                        {
                            let v atts.value(idx as size_t)
                            if v <> null
                            {
                                let t v.get_text()
                                if t <> null
                                    return ELObj.make_string(host, t.string())
                            }
                        }
                    }
                }
            }
            set cur: cur.get_axis_parent()
        }
        interp.make_false()
    }

    ; match-element?: DEFPRIMITIVE(IsMatchElement) — does the pattern of
    ; argument 1 match the singleton of argument 2. ★Unlike its neighbours
    ; the node argument is REQUIRED and strict: an empty node-list is the
    ; notASingletonNode diagnostic.
    function is_match_element(host: pointer[Page], interp: pointer[Interpreter], name: StringC, pat_obj: pointer[ELObj], nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        let pat Pattern.convert(host, interp, pat_obj, loc)
        if pat = null
            return interp.make_error()
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 1, nl)
        let node nl.node_list_node(0)
        if node = null
            return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 1, nl)
        interp.make_bool(pat.matches(host, interp, node))
    }

    ; merge-style: DEFPRIMITIVE(MergeStyle) — a StyleObj that expands to its
    ; arguments IN ORDER when the style stack walks it (MergeStyleObj::
    ; appendIter), so the FIRST argument's specifications win. Zero arguments
    ; are legal and yield an empty style.
    function merge_style(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let parts Array[pointer[ELObj]]^host()
        var i 0
        while i < n_args
        {
            let a *(args + i)
            if a.is_style_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAStyle(), name, i, a)
            parts.add(a)
            set i: i + 1
        }
        ELObj.make_merge_style(host, parts)
    }

    ; sosofo-label / sosofo-discard-labeled: DEFPRIMITIVE(SosofoLabel) /
    ; (SosofoDiscardLabeled) — the procedural spellings of the `label:`
    ; keyword and its opposite. Same argument gates; `discard` picks the
    ; sosofo kind whose processing drops what connects to the label.
    function sosofo_label(host: pointer[Page], interp: pointer[Interpreter], name: StringC, so: pointer[ELObj], sym: pointer[ELObj], loc: Location, discard: bool) returns pointer[ELObj]
    {
        if so.is_sosofo_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notASosofo(), name, 0, so)
        if sym.is_symbol_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notASymbol(), name, 1, sym)
        if discard
            return ELObj.make_discard_labeled_sosofo(host, sym, so)
        ELObj.make_label_sosofo(host, sym, loc, so)
    }

    ; process-first-descendant / process-matching-children: DEFPRIMITIVE
    ; (ProcessFirstDescendant) / (ProcessMatchingChildren) — both take a REST
    ; of patterns and process what matches ANY of them.
    ; ★process-first-descendant filters the DESCENDANTS — the node itself
    ; excluded, because DescendantsNodeListObj advances once in its own
    ; constructor — and processes only the FIRST hit; process-matching-
    ; children filters the children axis and processes ALL hits. ★With no
    ; patterns at all,
    ; process-matching-children is the empty sosofo outright, while
    ; process-first-descendant runs a zero-pattern filter that matches
    ; nothing — same result by a different road.
    function process_matching(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location, first_descendant: bool) returns pointer[ELObj]
    {
        if ctx.get_processing_mode() = null
        {
            interp.set_next_location(loc)
            interp.message0(InterpreterMessages.noCurrentProcessingMode())
            return interp.make_error()
        }
        let cur ctx.get_current_node()
        if cur = null
            return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
        let pats Array[pointer[Pattern]]^host()
        var i 0
        while i < n_args
        {
            let p Pattern.convert(host, interp, *(args + i), loc)
            if p = null
                return interp.make_error()
            pats.add(p)
            set i: i + 1
        }
        let np pats.get_length()
        if (first_descendant = false) and (np = (0 as size_t))
            return ELObj.make_empty_sosofo(host)
        let cands Array[pointer[GroveNode]]^host()
        if first_descendant
            Primitive.collect_descendants(host, cur, cands)
        else
        {
            let n cur.axis_child_count()
            var k 0
            while k < n
            {
                let c cur.axis_child_at(k)
                if c <> null
                    cands.add(c)
                set k: k + 1
            }
        }
        let hits Array[pointer[GroveNode]]^host()
        let nc cands.get_length()
        var j: size_t 0
        while j < nc
        {
            let nd *(cands.get_buffer() + j)
            if nd.get_class() = GN_ELEMENT
            {
                var m false
                var pi: size_t 0
                while pi < np
                {
                    let p *(pats.get_buffer() + pi)
                    if p.matches(host, interp, nd)
                        set m: true
                    set pi: pi + (1 as size_t)
                }
                if m
                {
                    if first_descendant
                        return ELObj.make_process_node_sosofo(host, nd, ctx.get_processing_mode())
                    hits.add(nd)
                }
            }
            set j: j + (1 as size_t)
        }
        if first_descendant
            return ELObj.make_empty_sosofo(host)
        let nl ELObj.make_node_list(host, hits, 0)
        ELObj.make_process_node_list_sosofo(host, nl, ctx.get_processing_mode())
    }

    ; absolute-first-sibling?: no ELEMENT sibling precedes the node
    ; (DEFPRIMITIVE IsAbsoluteFirstSibling — data/PI siblings don't count;
    ; a parentless node is #f via the failing firstSibling).
    function absolute_first_sibling(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        if n_args > 0
        {
            let a0 *args
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 0, a0)
            if a0.node_list_node(0) = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 0, a0)
        }
        else if ctx.get_current_node() = null
            return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
        let node Primitive.singleton_node_arg(n_args, args, ctx)
        let par node.get_parent()
        if par = null
            return interp.make_false()
        ; IsAbsoluteFirstSibling: a failing firstSibling is #f (the document
        ; element has no sibling axis).
        if node.has_siblings() = false
            return interp.make_false()
        let n node.sibling_range_end()
        var i node.sibling_range_begin()
        while i < n
        {
            let s node.sibling_group_at(i)
            if s = node
                return interp.make_true()
            if s.get_class() = GN_ELEMENT
                return interp.make_false()
            set i: i + 1
        }
        interp.make_true()
    }

    ; absolute-last-sibling?: no ELEMENT sibling follows the node
    ; (DEFPRIMITIVE IsAbsoluteLastSibling; a parentless node has no
    ; following siblings, so #t).
    function absolute_last_sibling(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        if n_args > 0
        {
            let a0 *args
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 0, a0)
            if a0.node_list_node(0) = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 0, a0)
        }
        else if ctx.get_current_node() = null
            return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
        let node Primitive.singleton_node_arg(n_args, args, ctx)
        let par node.get_parent()
        if par = null
            return interp.make_true()
        ; IsAbsoluteLastSibling walks nextChunkSibling only, so a node without a
        ; sibling axis (the document element) is #t.
        let n node.sibling_range_end()
        var i node.sibling_range_begin()
        var after false
        while i < n
        {
            let s node.sibling_group_at(i)
            if after
            {
                if s.get_class() = GN_ELEMENT
                    return interp.make_false()
            }
            else if s = node
                set after: true
            set i: i + 1
        }
        interp.make_true()
    }

    ; hierarchical-number-recursive: the child-number of every ancestor
    ; matching the GI, outermost first (DEFPRIMITIVE
    ; HierarchicalNumberRecursive — the upward walk PREPENDS, so higher
    ; levels end up at the list head).
    function hierarchical_number_recursive(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        if n_args > 1
        {
            let a1 *(args + 1)
            if a1.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 1, a1)
            if a1.node_list_node(0) = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 1, a1)
        }
        else if ctx.get_current_node() = null
            return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
        let node Primitive.singleton_node_arg_at(n_args, args, 1, ctx)
        let a0 *args
        if a0.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
        let target a0.string_data(host)
        var result ELObj.make_nil(host)
        ; the reference's upward walk is getParent -> the parent AXIS.
        var cur node.get_axis_parent()
        while cur <> null
        {
            if cur.get_class() = GN_ELEMENT
            {
                let cg cur.get_gi()
                if GiMatch.equal(cg, target)
                {
                    let num Primitive.same_gi_sibling_ordinal(cur)
                    set result: ELObj.make_pair(host, ELObj.make_integer(host, num), result)
                }
            }
            set cur: cur.get_axis_parent()
        }
        result
    }

    ; The shared prologue of the numbering primitives whose OPTIONAL node is
    ; argument `idx`: a strict singleton there, the current node otherwise.
    ; Returns null when the gate passes, else the object to return.
    function number_node_gate(interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location, idx: int) returns pointer[ELObj]
    {
        if n_args > idx
        {
            let a *(args + idx)
            if a.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, idx, a)
            if a.node_list_node(0) = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, idx, a)
        }
        else if ctx.get_current_node() = null
            return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
        null
    }

    ; ancestor-child-number: DEFPRIMITIVE(AncestorChildNumber) — the
    ; child-number of the NEAREST ancestor with that GI, 1-based, #f when
    ; there is none. ★The walk starts at the PARENT: the reference's loop
    ; condition reassigns the node before testing the GI, so a node is never
    ; its own ancestor here.
    function ancestor_child_number(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        let gate Primitive.number_node_gate(interp, name, n_args, args, ctx, loc, 1)
        if gate <> null
            return gate
        let node Primitive.singleton_node_arg_at(n_args, args, 1, ctx)
        let a0 *args
        let target Primitive.convert_general_name(host, node, a0)
        if target = null
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
        var cur node.get_axis_parent()
        while cur <> null
        {
            if cur.get_class() = GN_ELEMENT
            {
                let cg cur.get_gi()
                if cg.equals(*target)
                {
                    let num Primitive.same_gi_sibling_ordinal(cur)
                    return ELObj.make_integer(host, num)
                }
            }
            set cur: cur.get_axis_parent()
        }
        interp.make_false()
    }

    ; hierarchical-number: DEFPRIMITIVE(HierarchicalNumber) — one number per
    ; GI in the argument list, OUTERMOST first. The reference walks the list
    ; reversed (innermost GI first) and consumes the ancestor chain as it
    ; goes, so each GI is resolved against what is left ABOVE the previous
    ; match — and ★once the walk runs out of ancestors every remaining GI
    ; scores 0, rather than the whole call failing.
    function hierarchical_number(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        let gate Primitive.number_node_gate(interp, name, n_args, args, ctx, loc, 1)
        if gate <> null
            return gate
        let node Primitive.singleton_node_arg_at(n_args, args, 1, ctx)
        ; collect the GIs in order; the walk then runs them back to front.
        let gis Array[pointer[StringC]]^host()
        let a0 *args
        var p a0
        while p.is_nil() = false
        {
            if p.is_pair() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 0, a0)
            let q Primitive.convert_general_name(host, node, p.get_car())
            if q = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, p.get_car())
            gis.add(q)
            set p: p.get_cdr()
        }
        let n gis.get_length() as int
        let nums host.allocate((n as size_t) * (sizeof int), alignof int) as pointer[int]
        var cur node
        var i n - 1
        while i >= 0
        {
            let g *(gis.get_buffer() + (i as size_t))
            var found false
            while found = false
            {
                let up cur.get_axis_parent()
                if up = null
                {
                    set *(nums + i): 0
                    set found: true
                }
                else
                {
                    set cur: up
                    if cur.get_class() = GN_ELEMENT
                    {
                        let cg cur.get_gi()
                        if cg.equals(*g)
                        {
                            set *(nums + i): Primitive.same_gi_sibling_ordinal(cur)
                            set found: true
                        }
                    }
                }
            }
            set i: i - 1
        }
        var result ELObj.make_nil(host)
        var j n - 1
        while j >= 0
        {
            set result: ELObj.make_pair(host, ELObj.make_integer(host, *(nums + j)), result)
            set j: j - 1
        }
        result
    }

    ; element-number-list: DEFPRIMITIVE(ElementNumberList) — for the GI list
    ; (g0 g1 ... gk), the numbers (n0 n1 ... nk) where n0 is the PLAIN
    ; element-number of g0 and every later ni counts gi occurrences since the
    ; last g(i-1). ★So the list reads outermost-to-innermost and each level
    ; is reset by the level BEFORE it: for `("chap" "sec" "p")` at the second
    ; paragraph of the first section of chapter two the answer is (2 1 2) —
    ; chapter 2 outright, section 1 within it, paragraph 2 within that. The
    ; reference reaches this by reversing the list and pairing each entry
    ; with its SUCCESSOR in the reversal, which is its predecessor here.
    function element_number_list(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        let gate Primitive.number_node_gate(interp, name, n_args, args, ctx, loc, 1)
        if gate <> null
            return gate
        let node Primitive.singleton_node_arg_at(n_args, args, 1, ctx)
        let gis Array[pointer[StringC]]^host()
        let a0 *args
        var p a0
        while p.is_nil() = false
        {
            if p.is_pair() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 0, a0)
            let q Primitive.convert_general_name(host, node, p.get_car())
            if q = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, p.get_car())
            gis.add(q)
            set p: p.get_cdr()
        }
        let n gis.get_length() as int
        if n = 0
            return ELObj.make_nil(host)
        var result ELObj.make_nil(host)
        ; built back to front: every entry but the first counts since its
        ; PREDECESSOR's last occurrence, and the first is unreset.
        var i n - 1
        while i > 0
        {
            let g *(gis.get_buffer() + (i as size_t))
            let reset *(gis.get_buffer() + ((i - 1) as size_t))
            set result: ELObj.make_pair(host, ELObj.make_integer(host, Primitive.count_elements_upto(node, *g, reset)), result)
            set i: i - 1
        }
        let first *(gis.get_buffer() + (0 as size_t))
        ELObj.make_pair(host, ELObj.make_integer(host, Primitive.count_elements_upto(node, *first, null)), result)
    }

    ; NumberCache::elementNumber / ::elementNumberAfter, uncached: the
    ; document-order pre-order walk from the document element up to and
    ; including `target`, counting elements whose GI is `gi`. A non-null
    ; `reset` zeroes the count at every occurrence of THAT gi.
    function count_elements_upto(target: pointer[GroveNode], gi: StringC, reset: pointer[StringC]) returns int
    {
        var root target
        var rp root.get_parent()
        while rp <> null
        {
            set root: rp
            set rp: root.get_parent()
        }
        var count 0
        let kids root.get_children()
        if kids <> null
        {
            var ki: size_t 0
            var done false
            while ki < kids.get_length()
            {
                if done = false
                {
                    let k *(kids.get_buffer() + ki)
                    if k.get_class() = GN_ELEMENT
                    {
                        if Primitive.count_elements_walk(k, target, gi, reset, &count)
                            set done: true
                    }
                }
                set ki: ki + (1 as size_t)
            }
        }
        count
    }

    function count_elements_walk(cur: pointer[GroveNode], target: pointer[GroveNode], gi: StringC, reset: pointer[StringC], count: pointer[int]) returns bool
    {
        if cur.get_class() = GN_ELEMENT
        {
            let cg cur.get_gi()
            var counted false
            if reset <> null
            {
                if cg.equals(*reset)
                {
                    set *count: 0
                    set counted: true
                }
            }
            if counted = false
            {
                if cg.equals(gi)
                    set *count: *count + 1
            }
        }
        if cur = target
            return true
        let n cur.child_count()
        var i 0
        while i < n
        {
            let c cur.child_at(i)
            if Primitive.count_elements_walk(c, target, gi, reset, count)
                return true
            set i: i + 1
        }
        false
    }

    ; first-child-gi: DEFPRIMITIVE(FirstChildGi) — the GI of the first CHILD
    ; that has one, scanning chunk-siblings until one answers. ★Its node
    ; argument is the FIRST one and is an OPT singleton: an EMPTY node-list
    ; is #f, not a diagnostic (notAnOptSingletonNode is only for a non-list).
    function first_child_gi(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        var node: pointer[GroveNode] null
        if n_args > 0
        {
            let a0 *args
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAnOptSingletonNode(), name, 0, a0)
            set node: a0.node_list_node(0)
            if node = null
                return interp.make_false()
        }
        else
        {
            if ctx.get_current_node() = null
                return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
            set node: ctx.get_current_node()
        }
        let n node.axis_child_count()
        var i 0
        while i < n
        {
            let c node.axis_child_at(i)
            if c <> null
            {
                if c.get_class() = GN_ELEMENT
                    return ELObj.make_string(host, c.get_gi())
            }
            set i: i + 1
        }
        interp.make_false()
    }

    ; element-number: the node's ordinal among the same-GI elements in
    ; document order, 1-based (NumberCache::elementNumber, uncached — the
    ; pre-order walk from the document element counts equal GIs up to and
    ; including the node). A non-element is #f.
    function element_number_walk(cur: pointer[GroveNode], target: pointer[GroveNode], gi: StringC, count: pointer[int]) returns bool
    {
        if cur.get_class() = GN_ELEMENT
        {
            let cg cur.get_gi()
            if cg.equals(gi)
                set *count: *count + 1
        }
        if cur = target
            return true
        let n cur.child_count()
        var i 0
        while i < n
        {
            let c cur.child_at(i)
            if Primitive.element_number_walk(c, target, gi, count)
                return true
            set i: i + 1
        }
        false
    }

    function element_number(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        if n_args > 0
        {
            let a0 *args
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 0, a0)
            if a0.node_list_node(0) = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 0, a0)
        }
        else if ctx.get_current_node() = null
            return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
        let node Primitive.singleton_node_arg(n_args, args, ctx)
        if node.get_class() <> GN_ELEMENT
            return interp.make_false()
        ; grove root -> document element. STRUCTURAL on purpose: the reference
        ; does `node->getGroveRoot(start); start->getDocumentElement(start)`,
        ; never getParent — the axis would stop AT the document element and the
        ; element-children scan below would then skip it.
        var root node
        var rp root.get_parent()
        while rp <> null
        {
            set root: rp
            set rp: root.get_parent()
        }
        var count 0
        let g node.get_gi()
        let kids root.get_children()
        if kids <> null
        {
            var ki: size_t 0
            var done false
            while ki < kids.get_length()
            {
                if done = false
                {
                    let k *(kids.get_buffer() + ki)
                    if k.get_class() = GN_ELEMENT
                    {
                        if Primitive.element_number_walk(k, node, g, &count)
                            set done: true
                    }
                }
                set ki: ki + (1 as size_t)
            }
        }
        ELObj.make_integer(host, count)
    }

    ; preced: the preceding siblings of each member, in order (DEFPRIMITIVE
    ; Preced — SiblingNodeListObj from firstSibling up to the node; a
    ; non-singleton arg maps itself over the members à la MapNodeListObj).
    function preced_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, nl)
        let result Array[pointer[GroveNode]]^host()
        let n nl.node_list_count()
        var i 0
        while i < n
        {
            let node nl.node_list_node(i)
            if node <> null
            {
                ; the SIBLING axis, not the parent axis: Node::preced runs over
                ; firstSibling/nextChunkSibling, whose own root rule gives the
                ; document element NO siblings and keeps each prolog/epilog PI
                ; group to itself (Grove.sibling_range_*). Data chunks expand
                ; per character (measured: preced of the `em` in
                ; `First <em>inner</em> text.` = 6).
                ;
                ; DOCUMENTED DEVIATION: with a CHAR NODE as the argument the
                ; reference ABORTS — SiblingNodeListObj::nodeListChunkRest hits
                ; CANNOT_HAPPEN (style/primitive.cxx:5695) because
                ; nextChunkSibling fails on a mid-chunk node. Aborting a library
                ; call is not worth reproducing, so we return the consistent
                ; count (the characters before it in its chunk plus the expanded
                ; siblings before that chunk); no reachable stylesheet can rely
                ; on the reference's SIGABRT. See COMPLETENESS.md.
                let sibs Array[pointer[GroveNode]]^host()
                Primitive.collect_expanded_siblings(host, node, sibs)
                ; the members are chunk-level; only the member HOLDING the node
                ; is truncated, and only that one materializes char views (a
                ; prefix index cannot express a partial trailing member).
                let tc Primitive.member_chunk_of(node)
                let off Primitive.member_offset_of(node)
                let m sibs.get_length()
                var j: size_t 0
                while j < m
                {
                    let s *(sibs.get_buffer() + j)
                    if s = tc
                    {
                        var k 0
                        while k < off
                        {
                            result.add(GroveNode.char_view(s, k))
                            set k: k + 1
                        }
                        break
                    }
                    result.add(s)
                    set j: j + (1 as size_t)
                }
            }
            set i: i + 1
        }
        ELObj.make_node_list_expanded(host, result, 0)
    }

    ; The first character a DATA member of a node-list contributes to `data`:
    ; a character VIEW stands for exactly its own character, a chunk for its
    ; whole run — and member 0 starts past whatever a preceding node-list-rest
    ; already consumed (node_list_member_skip).
    function data_member_first(node: pointer[GroveNode], index: int, skip: int) returns size_t
    {
        var first: size_t node.get_char_index() as size_t
        if index = 0
            set first: first + (skip as size_t)
        first
    }

    ; How many characters that member contributes. ★The two `data` rules are
    ; asymmetric and this is where the asymmetry lives: in a PLAIN node-list a
    ; data member is one per-character node and contributes exactly ITS
    ; character (measured: `(data (node-list-first (children p)))` = "F", even
    ; though that node IS the chunk — the index-0 view); only in an EXPANDED
    ; list does a chunk member stand for its whole run, because there the
    ; run's other characters have no member of their own. A character VIEW is
    ; one character either way.
    function data_member_len(node: pointer[GroveNode], index: int, skip: int, expanded: bool) returns size_t
    {
        if expanded = false
            return 1 as size_t
        if node.data_chunk() <> node
            return 1 as size_t
        let s node.get_chars()
        let n s.get_size()
        let f Primitive.data_member_first(node, index, skip)
        if f >= n
            return 0 as size_t
        n - f
    }

    ; the sibling-list MEMBER a node belongs to: its data chunk for a character
    ; view, the node itself otherwise.
    function member_chunk_of(node: pointer[GroveNode]) returns pointer[GroveNode]
    {
        if node.get_class() <> GN_DATA
            return node
        node.data_chunk()
    }

    ; that member's character offset (0 for everything but a character view).
    function member_offset_of(node: pointer[GroveNode]) returns int
    {
        if node.get_class() <> GN_DATA
            return 0
        node.get_char_index()
    }

    ; process-element-with-id: process the element carrying the ID, in the
    ; current mode (DEFPRIMITIVE ProcessElementWithId — the grove-root
    ; elements index; unknown id = the empty sosofo).
    function process_element_with_id(host: pointer[Page], interp: pointer[Interpreter], name: StringC, a0: pointer[ELObj], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        if a0.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
        let cn ctx.get_current_node()
        if cn = null
            return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
        if ctx.get_processing_mode() = null
        {
            interp.set_next_location(loc)
            interp.message0(InterpreterMessages.noCurrentProcessingMode())
            return interp.make_error()
        }
        ; same ELEMENTS-list fold as element-with-id, in the CURRENT node's grove
        let q Primitive.nnl_normalize(host, cn, NNL_ELEMENTS, a0.string_data(host))
        let node GroveBuilder.element_by_id(host, cn, *q)
        if node = null
            return ELObj.make_empty_sosofo(host)
        ELObj.make_process_node_sosofo(host, node, ctx.get_processing_mode())
    }

    ; --- the grove DTD's general-entity axis (groveRoot getEntities) --------
    ; entity-public-id / entity-generated-system-id / entity-notation query
    ; the document DTD's general entities (installed on the Interpreter by the
    ; CLI after the parse). Entity names are NOT namecase-folded here: the
    ; reference folds per NAMECASE ENTITY, which is NO in every corpus
    ; declaration (XML and the reference SGML default alike).
    function entity_arg_node_gate(interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location, out_node: pointer[pointer[GroveNode]]) returns pointer[ELObj]
    {
        ; shared gate: arg 0 string, optional arg 1 strict singleton, default
        ; current node. Returns null when the gate passes; else the
        ; error/diagnostic object to return. ★The node is an OUT parameter, not
        ; a formality: the reference resolves it to reach ITS GROVE
        ; (`node->getGroveRoot(node) && node->getEntities(...)`), so with more
        ; than one grove in the run it decides which entity table answers.
        set *out_node: null
        let a0 *args
        if a0.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
        if n_args > 1
        {
            let a1 *(args + 1)
            if a1.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 1, a1)
            let nd a1.node_list_node(0)
            if nd = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 1, a1)
            set *out_node: nd
        }
        else
        {
            let cn ctx.get_current_node()
            if cn = null
                return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
            set *out_node: cn
        }
        null
    }

    ; The entity these primitives name. Every one of them spells the lookup
    ; `getGroveRoot -> getEntities -> namedNode`, so it is the sgml-document
    ; `entities` NAMED NODE LIST that answers — and that list carries the
    ; DEFAULTED-ENTITY FALLBACK (DocEntitiesNodeList::namedNode). ★So a
    ; PARAMETER entity is findable here although it is not a general entity
    ; and not a member of the list: the grove's defaulted-entity table is fed
    ; from every successful entity lookup of the parse, parameter entities
    ; included. Measured — `(entity-type "pent")` is `text`, not #f. Entity
    ; names are NOT case-folded (the entity substitution table is identity
    ; unless NAMECASE ENTITY says otherwise), which is why the plain name
    ; comparison is right here and wrong for notations below.
    function grove_entity(node: pointer[GroveNode], nm: StringC) returns pointer[Entity]
    {
        let d GroveInfo.dtd_of(node)
        if d <> null
        {
            let dtd d as pointer[Dtd]
            let e dtd.lookup_entity(false, nm)
            if e <> null
                return e
        }
        GroveInfo.lookup_defaulted_ent(node, nm)
    }

    ; the governing DTD's notation of that name (Dtd::lookupNotationTemp),
    ; the name taken AS GIVEN — the one caller is the attribute-value-token
    ; `notation` property, whose token the parser already normalized.
    function grove_notation(node: pointer[GroveNode], nm: StringC) returns pointer[Notation]
    {
        let d GroveInfo.dtd_of(node)
        if d = null
            return null
        let dtd d as pointer[Dtd]
        dtd.lookup_notation(nm)
    }

    ; ★The three notation-*-id primitives reach the notation through the
    ; `notations` NAMED NODE LIST, which folds the queried name with the
    ; GENERAL substitution table — so `(notation-system-id "tiff")` finds the
    ; notation declared as `tiff` and stored under `TIFF`. Without the fold
    ; every lowercase notation name missed.
    function grove_notation_named(node: pointer[GroveNode], host: pointer[Page], nm: StringC) returns pointer[Notation]
    {
        let q Primitive.nnl_normalize(host, node, NNL_NOTATIONS, nm)
        Primitive.grove_notation(node, *q)
    }

    ; --- the ATTRIBUTE axis --------------------------------------------------

    ; ElementNode::getAttributes — the attribute assignments of one element as a
    ; NAMED node list. Its members are views (GroveNode.attr_views), so building
    ; the list costs one array; the naming folds queries through the GENERAL
    ; substitution table (AttributesNamedNodeList passes generalSubstTable).
    function make_attributes_list(host: pointer[Page], elem: pointer[GroveNode]) returns pointer[ELObj]
    {
        let arr Array[pointer[GroveNode]]^host()
        let views GroveNode.attr_views(elem)
        let n views.get_length() as int
        var i 0
        while i < n
        {
            arr.add(*(views.get_buffer() + i))
            set i: i + 1
        }
        ELObj.make_named_node_list(host, arr, NNL_ATTRIBUTES)
    }

    ; the children AXIS of one node as a character-expanded node-list — the
    ; shape `content` and an assignment's `value` both hand out.
    function axis_children_list(host: pointer[Page], node: pointer[GroveNode]) returns pointer[ELObj]
    {
        let arr Array[pointer[GroveNode]]^host()
        let m node.axis_child_count()
        var i 0
        while i < m
        {
            arr.add(node.axis_child_at(i))
            set i: i + 1
        }
        ELObj.make_node_list_expanded(host, arr, 0)
    }

    ; DEFPRIMITIVE(Attributes) — the attributes of a SINGLETON node as a named
    ; node list; an empty argument answers itself, and a MULTI-node list maps
    ; the property over its members (MapNodeListObj), which is an ordinary
    ; node-list, not a named one.
    function attributes_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        if a0.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, a0)
        let n a0.node_list_count()
        if n = 0
            return a0
        if n = 1
        {
            let node a0.node_list_node(0)
            if node = null
                return a0
            if node.get_class() <> GN_ELEMENT
                return ELObj.make_node_list(host, null, 0)
            return Primitive.make_attributes_list(host, node)
        }
        let arr Array[pointer[GroveNode]]^host()
        var i 0
        while i < n
        {
            let node a0.node_list_node(i)
            if node <> null
            {
                if node.get_class() = GN_ELEMENT
                {
                    let views GroveNode.attr_views(node)
                    let m views.get_length() as int
                    var k 0
                    while k < m
                    {
                        arr.add(*(views.get_buffer() + k))
                        set k: k + 1
                    }
                }
            }
            set i: i + 1
        }
        ELObj.make_node_list(host, arr, 0)
    }

    ; DEFPRIMITIVE(NamedNode) — the member of a named node list whose name
    ; matches, the query folded through the list's substitution table first.
    ; A miss is the EMPTY node-list (NodePtrNodeListObj over a null NodePtr).
    function named_node_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, a0: pointer[ELObj], a1: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if a0.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
        let named a1.node_list_named()
        if named = NNL_NONE
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANamedNodeList(), name, 1, a1)
        ; the fold table is the LIST's grove — its first member names it (see
        ; the note on nnl_normalize for the empty case).
        let lnode a1.node_list_node(0)
        let q Primitive.nnl_normalize(host, lnode, named, a0.string_data(host))
        let n a1.node_list_count()
        var i 0
        while i < n
        {
            let node a1.node_list_node(i)
            if node <> null
            {
                let nm Primitive.named_member_name(node, named)
                if nm.equals(*q)
                    return ELObj.make_node_singleton(host, node)
            }
            set i: i + 1
        }
        ; ★DocEntitiesNamedNodeList::namedNodeU's second half: a name the
        ; general entities do not hold is looked up in the GROVE's defaulted
        ; entity table (which is why `entities` finds names that are not among
        ; its members — measured). Only the sgml-document `entities` list has it.
        if named = NNL_DOC_ENTITIES
        {
            let dflt GroveInfo.lookup_defaulted_ent(lnode, *q)
            if dflt <> null
            {
                var owner: pointer[GroveNode] null
                if n > 0
                {
                    let m0 a1.node_list_node(0)
                    if m0 <> null
                        set owner: m0.get_parent()
                }
                let nd Primitive.entity_node(host, GN_ENTITY, dflt, owner)
                return ELObj.make_node_singleton(host, nd)
            }
        }
        ELObj.make_node_list(host, null, 0)
    }

    ; DEFPRIMITIVE(NamedNodeListNames) — the members' names, in order, as a list
    ; of strings (a member without a name is skipped, as nodeName failing is).
    function named_node_list_names(host: pointer[Page], interp: pointer[Interpreter], name: StringC, a0: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        let named a0.node_list_named()
        if named = NNL_NONE
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANamedNodeList(), name, 0, a0)
        let n a0.node_list_count()
        var result ELObj.make_nil(host)
        var i n - 1
        while i >= 0
        {
            let node a0.node_list_node(i)
            if node <> null
            {
                let nm Primitive.named_member_name(node, named)
                ; a member whose class does not occur in the list type has no
                ; name (nodeName is accessNotInClass) and is SKIPPED, exactly as
                ; the reference's `if (nnl->nodeName(nd, str))` does.
                if nm.get_size() > (0 as size_t)
                {
                    let s ELObj.make_string(host, nm)
                    set result: ELObj.make_pair(host, s, result)
                }
            }
            set i: i - 1
        }
        result
    }

    ; DEFPRIMITIVE(NamedNodeListNormalize) — (string nnl symbol): the string
    ; folded through the list's substitution table. The third argument only has
    ; to BE a symbol (the reference checks and then ignores it).
    function named_node_list_normalize(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        let a1 *(args + 1)
        let a2 *(args + 2)
        if a0.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
        let named a1.node_list_named()
        if named = NNL_NONE
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANamedNodeList(), name, 1, a1)
        if a2.is_symbol_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notASymbol(), name, 2, a2)
        let lnode a1.node_list_node(0)
        let q Primitive.nnl_normalize(host, lnode, named, a0.string_data(host))
        ELObj.make_string(host, *q)
    }

    ; The name a NAMED node list answers to for one member — `named-node`
    ; compares against this and `named-node-list-names` collects it.
    ; NamedNodeList::nodeName (grove/Node.cxx:727) dispatches on the pair (LIST
    ; TYPE, node class) through NodeNameNodeVisitor, and the two disagree in one
    ; place that matters: in an `elements` list an element answers with its ID,
    ; everywhere else with its GI. A member whose class does not occur in the
    ; list type answers accessNotInClass, which the two callers skip — modelled
    ; as the empty name.
    function named_member_name(node: pointer[GroveNode], named: int) returns StringC
    {
        if node = null
            return StringC()
        let cls node.get_class()
        if cls = GN_ATTR_ASSIGN
        {
            if named = NNL_ATTRIBUTES
                return node.assign_name()
            return StringC()
        }
        if cls = GN_ELEMENT
        {
            if named = NNL_ELEMENTS
                return node.id_value()
            return StringC()
        }
        if cls = GN_ELEMENT_TYPE
        {
            if named <> NNL_ELEMENT_TYPES
                return StringC()
            let et node.get_decl() as pointer[ElementType]
            if et = null
                return StringC()
            return et.get_name()
        }
        if cls = GN_ENTITY
        {
            if named = NNL_ENTITIES
                return Primitive.decl_name_of(node)
            if named = NNL_DOC_ENTITIES
                return Primitive.decl_name_of(node)
            return StringC()
        }
        if cls = GN_NOTATION
        {
            if named <> NNL_NOTATIONS
                return StringC()
            return Primitive.decl_name_of(node)
        }
        if cls = GN_DOCUMENT_TYPE
        {
            if named <> NNL_DOCTYPES_AND_LINKTYPES
                return StringC()
            return Primitive.decl_name_of(node)
        }
        if cls = GN_ATTRIBUTE_DEF
        {
            if named <> NNL_ATTRIBUTE_DEFS
                return StringC()
            let def Primitive.att_def_of(node)
            if def = null
                return StringC()
            return def.get_name()
        }
        ; ★a DEFAULT-ENTITY node has NO visitor entry (accept dispatches to
        ; defaultEntity, which NodeNameNodeVisitor does not override), so it is
        ; nameless in every list.
        StringC()
    }

    ; BaseNamedNodeList::normalize — fold every character through the list's
    ; substitution table. Every list type but the ENTITY ones folds through the
    ; parse's GENERAL subst table (upper folding under NAMECASE GENERAL YES,
    ; identity for XML); the entity lists use the entity table, which every
    ; declaration in reach leaves at identity (NAMECASE ENTITY NO).
    ; ★The general table is the PARSE's, held by the queried node's own GROVE —
    ; not a blanket ASCII upper-fold like the GI matcher's documented
    ; approximation.
    ; Answers on `host` through an explicit construction (a StringC RETURNED by
    ; value would allocate its buffer through Page.get(<the return slot>)).
    ; ★`node` null = "no grove nameable from the arguments". The reference always
    ; has one, because the table belongs to the NamedNodeList object itself
    ; (BaseNamedNodeList carries its grove's SubstTable); this port reads it off
    ; a node instead, and an EMPTY named node list has none to offer. The
    ; document grove answers for that case — the only observable difference
    ; would be an empty named list from a grove sgml-parse loaded whose NAMECASE
    ; differs from the document's, and no caller can tell such a list apart from
    ; the document's own. Growing NodeListObj by a grove pointer instead would
    ; widen the whole ELObj union for every value in the engine.
    function nnl_normalize(host: pointer[Page], node: pointer[GroveNode], named: int, s: StringC) returns pointer[StringC]
    {
        let n s.get_size()
        if named = NNL_ENTITIES
            return StringC^host(s.data_ptr(), n)
        if named = NNL_DOC_ENTITIES
            return StringC^host(s.data_ptr(), n)
        var gn node
        if gn = null
            set gn: GroveManager.principal()
        let tab GroveInfo.subst_of(gn)
        if tab = null
            return StringC^host(s.data_ptr(), n)
        if n = (0 as size_t)
            return StringC^host()
        let buf host.allocate(n * (sizeof u32), alignof u32) as pointer[u32]
        var i: size_t 0
        while i < n
        {
            let c s.get(i)
            var f c
            if c < (256 as u32)
                set f: *(tab + (c as size_t))
            set *(buf + i): f
            set i: i + (1 as size_t)
        }
        StringC^host(buf, n)
    }

    ; widen an opensp byte String (public ids / system ids are minimum-data)
    ; into an ELObj string.
    function make_string_from_bytes(host: pointer[Page], s: String) returns pointer[ELObj]
    {
        let n s.get_length()
        if n = (0 as size_t)
            return ELObj.make_string(host, StringC())
        let buf host.allocate(n * (sizeof u32), alignof u32) as pointer[u32]
        var i: size_t 0
        while i < n
        {
            set *(buf + i): s.get(i) as u32
            set i: i + (1 as size_t)
        }
        ELObj.make_string(host, StringC(buf, n))
    }

    function entity_public_id(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        var gnode: pointer[GroveNode] null
        let gate Primitive.entity_arg_node_gate(interp, name, n_args, args, ctx, loc, &gnode)
        if gate <> null
            return gate
        let a0 *args
        let ent Primitive.grove_entity(gnode, a0.string_data(host))
        if ent = null
            return interp.make_false()
        let xid ent.get_external_id()
        if xid.has_public_id() = false
            return interp.make_false()
        Primitive.make_string_from_bytes(host, xid.get_public_id())
    }

    function entity_generated_system_id(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        var gnode: pointer[GroveNode] null
        let gate Primitive.entity_arg_node_gate(interp, name, n_args, args, ctx, loc, &gnode)
        if gate <> null
            return gate
        let a0 *args
        let ent Primitive.grove_entity(gnode, a0.string_data(host))
        if ent = null
            return interp.make_false()
        let xid ent.get_external_id()
        let eff xid.get_effective_system()
        ; getGeneratedSystemId: an EMPTY effective system id is accessNull.
        if eff.get_length() = (0 as size_t)
            return interp.make_false()
        Primitive.make_string_from_bytes(host, eff)
    }

    function entity_notation(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        var gnode: pointer[GroveNode] null
        let gate Primitive.entity_arg_node_gate(interp, name, n_args, args, ctx, loc, &gnode)
        if gate <> null
            return gate
        let a0 *args
        let ent Primitive.grove_entity(gnode, a0.string_data(host))
        if ent = null
            return interp.make_false()
        let np ent.get_data_notation()
        if np = null
            return interp.make_false()
        let nt np as pointer[Notation]
        ELObj.make_string(host, nt.get_name())
    }

    ; entity-system-id: DEFPRIMITIVE(EntitySystemId) — getEntities ->
    ; namedNode -> getExternalId -> getSystemId. That is the DECLARED system
    ; identifier (ExternalIdNode::getSystemId reads systemIdString()), NOT the
    ; resolved one entity-generated-system-id returns; an entity declared
    ; without one is accessNull -> #f.
    function entity_system_id(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        var gnode: pointer[GroveNode] null
        let gate Primitive.entity_arg_node_gate(interp, name, n_args, args, ctx, loc, &gnode)
        if gate <> null
            return gate
        let a0 *args
        let ent Primitive.grove_entity(gnode, a0.string_data(host))
        if ent = null
            return interp.make_false()
        let xid ent.get_external_id()
        if xid.has_system_id() = false
            return interp.make_false()
        Primitive.make_string_from_bytes(host, xid.get_system_id())
    }

    ; entity-text: DEFPRIMITIVE(EntityText) — Node::getText, i.e. the
    ; REPLACEMENT TEXT of an internal entity. Every external arm has no text
    ; and answers #f, exactly like an unknown name (the chained accessOK test
    ; makes no distinction between "no such entity" and "not accessible").
    function entity_text(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        var gnode: pointer[GroveNode] null
        let gate Primitive.entity_arg_node_gate(interp, name, n_args, args, ctx, loc, &gnode)
        if gate <> null
            return gate
        let a0 *args
        let ent Primitive.grove_entity(gnode, a0.string_data(host))
        if ent = null
            return interp.make_false()
        if ent.is_external()
            return interp.make_false()
        ELObj.make_string(host, ent.internal_text())
    }

    ; entity-type: DEFPRIMITIVE(EntityType) — a plain SYMBOL, one of text /
    ; cdata / sdata / ndata / subdocument / pi. ★These are the same six words
    ; the entity-type PROPERTY answers with, but as ordinary symbols: the
    ; property goes through the component-name table and switches spelling
    ; under rcs?, this does not.
    function entity_type(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        var gnode: pointer[GroveNode] null
        let gate Primitive.entity_arg_node_gate(interp, name, n_args, args, ctx, loc, &gnode)
        if gate <> null
            return gate
        let a0 *args
        let ent Primitive.grove_entity(gnode, a0.string_data(host))
        if ent = null
            return interp.make_false()
        let dt ent.data_type()
        if dt = GDT_PI
            return interp.make_symbol(StringC("pi"))
        if dt = GDT_CDATA
            return interp.make_symbol(StringC("cdata"))
        if dt = GDT_SDATA
            return interp.make_symbol(StringC("sdata"))
        if dt = GDT_NDATA
            return interp.make_symbol(StringC("ndata"))
        if dt = GDT_SUBDOC
            return interp.make_symbol(StringC("subdocument"))
        interp.make_symbol(StringC("text"))
    }

    ; entity-attribute-string: DEFPRIMITIVE(EntityAttributeString) — the
    ; nodeAttributeString of the named entity's DATA attributes (an NDATA
    ; entity's ATTLIST). #f whenever any link in the chain fails: unknown
    ; entity, no data attributes, unknown attribute, or an IMPLIED one.
    function entity_attribute_string(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        if a0.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
        let a1 *(args + 1)
        if a1.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 1, a1)
        var gnode: pointer[GroveNode] null
        if n_args > 2
        {
            let a2 *(args + 2)
            if a2.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 2, a2)
            let nd2 a2.node_list_node(0)
            if nd2 = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 2, a2)
            set gnode: nd2
        }
        else
        {
            let cn2 ctx.get_current_node()
            if cn2 = null
                return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
            set gnode: cn2
        }
        let ent Primitive.grove_entity(gnode, a0.string_data(host))
        if ent = null
            return interp.make_false()
        let atts0 ent.get_data_attributes()
        if atts0 = null
            return interp.make_false()
        let atts atts0 as pointer[AttributeList]
        let idx AttrLookup.index_ci(atts, a1.string_data(host))
        if idx < 0
            return interp.make_false()
        let v atts.value(idx as size_t)
        if v = null
            return interp.make_false()
        let t v.get_text()
        if t = null
            return interp.make_false()
        ELObj.make_string(host, t.string())
    }

    ; entity-name-normalize: DEFPRIMITIVE(EntityNameNormalize) — fold a name
    ; with the ENTITY substitution table of the parse (the same table the
    ; `entities` named node list uses), so it can find `&Logo;` under `logo`
    ; or not, depending on NAMECASE ENTITY. ★Unlike its siblings this one
    ; NEVER answers #f: the reference ignores every access result and
    ; normalizes whatever it was handed.
    function entity_name_normalize(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        var gnode: pointer[GroveNode] null
        let gate Primitive.entity_arg_node_gate(interp, name, n_args, args, ctx, loc, &gnode)
        if gate <> null
            return gate
        let a0 *args
        let q Primitive.nnl_normalize(host, gnode, NNL_ENTITIES, a0.string_data(host))
        ELObj.make_string(host, *q)
    }

    ; notation-system-id / -public-id / -generated-system-id: the three
    ; DEFPRIMITIVEs that walk grove root -> governing doctype -> notations ->
    ; named notation -> external id. kind: 0 system, 1 public, 2 generated.
    function notation_id(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location, kind: int) returns pointer[ELObj]
    {
        var gnode: pointer[GroveNode] null
        let gate Primitive.entity_arg_node_gate(interp, name, n_args, args, ctx, loc, &gnode)
        if gate <> null
            return gate
        let a0 *args
        let nt Primitive.grove_notation_named(gnode, host, a0.string_data(host))
        if nt = null
            return interp.make_false()
        let xid nt.get_external_id()
        if kind = 1
        {
            if xid.has_public_id() = false
                return interp.make_false()
            return Primitive.make_string_from_bytes(host, xid.get_public_id())
        }
        if kind = 2
        {
            ; getGeneratedSystemId: the EFFECTIVE system id, accessNull when
            ; empty (same rule as entity-generated-system-id above).
            let eff xid.get_effective_system()
            if eff.get_length() = (0 as size_t)
                return interp.make_false()
            return Primitive.make_string_from_bytes(host, eff)
        }
        if xid.has_system_id() = false
            return interp.make_false()
        Primitive.make_string_from_bytes(host, xid.get_system_id())
    }

    ; round: DEFPRIMITIVE(Round) — floor(d + .5), then corrected to
    ; round-half-to-EVEN (the .5 case that rounded up away from an even
    ; result steps back down). An exact integer is returned UNCHANGED (same
    ; object); anything that is neither an inexact real nor an exact integer
    ; is notANumber. `inexactRealValue` is true for RealObj always and for a
    ; QuantityObj only when its dimension is 0, so a LENGTH errors.
    function round_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        let qv obj.quantity_value()
        var is_inexact_real false
        if qv.get_qtype() = QT_DOUBLE
        {
            if qv.get_dim() = 0
                set is_inexact_real: true
        }
        if is_inexact_real
        {
            let d qv.get_dval()
            var result floor(d + 0.5)
            if (result - d) = 0.5
            {
                if ((result as int) % 2) <> 0
                    set result: result - 1.0
            }
            return ELObj.make_real(host, result)
        }
        if obj.is_exact_integer()
            return obj
        Primitive.arg_error(interp, loc, InterpreterMessages.notANumber(), name, 0, obj)
    }

    ; --- the numeric / transcendental family --------------------------------
    ;
    ; (double)LONG_MAX. LONG_MAX itself is not representable as a double and
    ; rounds UP to 2^63, so the reference's `fabs(res) < LONG_MAX` compares
    ; against exactly this value.
    function long_max_double() returns double
        pow(2.0, 63.0)

    function fabs_d(x: double) returns double
    {
        if x < 0.0
            return 0.0 - x
        x
    }

    ; min / max: DEFPRIMITIVE(Min) / (Max) — one shape with the comparison
    ; flipped. The reference runs TWO loops: an exact one over the leading
    ; run of longQuantities, and an inexact one entered as soon as a double
    ; argument WINS. ★The switch-over carries a quirk that is deliberately
    ; reproduced: a double argument that does NOT beat a DIMENSIONED exact
    ; result `break`s the switch (primitive.cxx:1310/1392) and leaves the
    ; accumulator exact — only for dim 0 does a losing double force the
    ; conversion. Every argument must share arg 0's dimension.
    function min_max(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location, want_min: bool) returns pointer[ELObj]
    {
        let a0 *args
        let q0 a0.quantity_value()
        let t0 q0.get_qtype()
        if t0 = QT_NONE
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, 0, a0)
        let dim q0.get_dim()
        var l_result q0.get_lval()
        var d_result q0.get_dval()
        var use_double false
        if t0 = QT_DOUBLE
            set use_double: true
        var i 1
        ; the exact loop
        while (use_double = false) and (i < n_args)
        {
            let ai *(args + i)
            let qi ai.quantity_value()
            let ti qi.get_qtype()
            if ti = QT_NONE
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, i, ai)
            if qi.get_dim() <> dim
                return Primitive.simple_error(interp, loc, InterpreterMessages.incompatibleDimensions())
            if ti = QT_LONG
            {
                let v qi.get_lval()
                var wins v > l_result
                if want_min
                    set wins: v < l_result
                if wins
                    set l_result: v
            }
            else
            {
                let v qi.get_dval()
                let cur l_result as double
                var wins v > cur
                if want_min
                    set wins: v < cur
                if wins
                {
                    set d_result: v
                    set use_double: true
                }
                else if dim = 0
                {
                    set d_result: cur
                    set use_double: true
                }
            }
            set i: i + 1
        }
        ; the inexact loop
        while i < n_args
        {
            let ai *(args + i)
            let qi ai.quantity_value()
            let ti qi.get_qtype()
            if ti = QT_NONE
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, i, ai)
            if qi.get_dim() <> dim
                return Primitive.simple_error(interp, loc, InterpreterMessages.incompatibleDimensions())
            var v qi.get_dval()
            if ti = QT_LONG
                set v: qi.get_lval() as double
            var wins v > d_result
            if want_min
                set wins: v < d_result
            if wins
                set d_result: v
            set i: i + 1
        }
        if use_double = false
        {
            if dim = 0
                return ELObj.make_integer(host, l_result)
            return ELObj.make_length(host, l_result)
        }
        if dim = 0
            return ELObj.make_real(host, d_result)
        ELObj.make_quantity(host, d_result, dim)
    }

    ; floor / ceiling / truncate: DEFPRIMITIVE(Floor) / (Ceiling) /
    ; (Truncate) — the same shape as Round. mode: 0 floor, 1 ceiling,
    ; 2 truncate. The reference's truncate is `modf(d, &iPart)`, i.e. the
    ; integer part toward ZERO — floor above 0, ceil below.
    function round_to_integral(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location, mode: int) returns pointer[ELObj]
    {
        if obj.is_inexact_real()
        {
            let d obj.real_value()
            var r floor(d)
            if mode = 1
                set r: ceil(d)
            if mode = 2
            {
                if d < 0.0
                    set r: ceil(d)
            }
            return ELObj.make_real(host, r)
        }
        if obj.is_exact_integer()
            return obj
        Primitive.arg_error(interp, loc, InterpreterMessages.notANumber(), name, 0, obj)
    }

    ; sqrt: DEFPRIMITIVE(Sqrt) — an ODD dimension or a negative value is
    ; outOfRange; the dimension HALVES. ★An exact argument whose root is
    ; exact comes back as an integer, everything else as a QuantityObj —
    ; including the dimensionless case, which is the reference's own choice
    ; (a dim-0 quantity, not a RealObj).
    function sqrt_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        let qv obj.quantity_value()
        let t qv.get_qtype()
        if t = QT_NONE
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, 0, obj)
        var d qv.get_dval()
        if t = QT_LONG
            set d: qv.get_lval() as double
        var dim qv.get_dim()
        if ((dim & 1) <> 0) or (d < 0.0)
            return Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
        set dim: dim / 2
        set d: sqrt(d)
        if (t = QT_LONG) and (dim = 0)
        {
            let n d as int
            if (n * n) = qv.get_lval()
                return ELObj.make_integer(host, n)
        }
        ELObj.make_quantity(host, d, dim)
    }

    ; exact? / inexact?: DEFPRIMITIVE(IsExact) / (IsInexact) — the quantity
    ; TYPE is the answer; a non-quantity is notAQuantity.
    function exactness_test(interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location, want_exact: bool) returns pointer[ELObj]
    {
        let qv obj.quantity_value()
        let t qv.get_qtype()
        if t = QT_NONE
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, 0, obj)
        if want_exact
            return interp.make_bool(t = QT_LONG)
        interp.make_bool(t = QT_DOUBLE)
    }

    ; exp / log / sin / cos / tan / asin / acos: the one-argument libm
    ; family. Every one gates on realValue (integers, reals and DIMENSIONLESS
    ; quantities) with notANumber; log and the two arcs add a domain check
    ; that is outOfRange, not a libm NaN.
    ; mode: 0 exp, 1 log, 2 sin, 3 cos, 4 tan, 5 asin, 6 acos.
    function transcendental(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location, mode: int) returns pointer[ELObj]
    {
        if obj.is_real() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANumber(), name, 0, obj)
        let d obj.real_value()
        if mode = 0
            return ELObj.make_real(host, exp(d))
        if mode = 1
        {
            if d <= 0.0
                return Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
            return ELObj.make_real(host, log(d))
        }
        if mode = 2
            return ELObj.make_real(host, sin(d))
        if mode = 3
            return ELObj.make_real(host, cos(d))
        if mode = 4
            return ELObj.make_real(host, tan(d))
        if (d < 0.0 - 1.0) or (d > 1.0)
            return Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
        if mode = 5
            return ELObj.make_real(host, asin(d))
        ELObj.make_real(host, acos(d))
    }

    ; atan: DEFPRIMITIVE(Atan) — one argument is plain atan over a
    ; DIMENSIONLESS quantity (a dimensioned one is notANumber); two are
    ; atan2, which allows any dimension as long as BOTH share it.
    function atan_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        let q0 a0.quantity_value()
        let t0 q0.get_qtype()
        var d0 q0.get_dval()
        if t0 = QT_LONG
            set d0: q0.get_lval() as double
        if n_args = 1
        {
            if (t0 = QT_NONE) or (q0.get_dim() <> 0)
                return Primitive.arg_error(interp, loc, InterpreterMessages.notANumber(), name, 0, a0)
            return ELObj.make_real(host, atan(d0))
        }
        if t0 = QT_NONE
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, 0, a0)
        let a1 *(args + 1)
        let q1 a1.quantity_value()
        let t1 q1.get_qtype()
        if t1 = QT_NONE
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, 1, a1)
        var d1 q1.get_dval()
        if t1 = QT_LONG
            set d1: q1.get_lval() as double
        if q0.get_dim() <> q1.get_dim()
            return Primitive.simple_error(interp, loc, InterpreterMessages.incompatibleDimensions())
        ELObj.make_real(host, atan2(d0, d1))
    }

    ; expt: DEFPRIMITIVE(Expt) — pow over two realValues; the result is an
    ; exact integer only when BOTH arguments were exact integers and it fits
    ; a long.
    function expt_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, a: pointer[ELObj], b: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if a.is_real() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANumber(), name, 0, a)
        if b.is_real() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANumber(), name, 1, b)
        let d a.real_value()
        let d2 b.real_value()
        let res pow(d, d2)
        if a.is_exact_integer() and b.is_exact_integer()
        {
            let m Primitive.fabs_d(res)
            let lim Primitive.long_max_double()
            if m < lim
                return ELObj.make_integer(host, res as int)
        }
        ELObj.make_real(host, res)
    }

    ; XExpt: the XXPRIMITIVE variant (primitive.h:235), reachable only as
    ; `UNREGISTERED::OpenJade//Procedure::expt` through external-procedure —
    ; the identifier `expt` stays bound to the ISO one above. It is the
    ; DIMENSIONED power: a length raised to an exact integer multiplies the
    ; dimension.
    ;
    ; ★MEASURED REFERENCE DEFECT, ported bug-for-bug where it is DEFINED and
    ; documented where it is not (primitive.cxx:5042): the second quantity is
    ; read from `argv[0]` — `argv[0]->quantityValue(n2, d2, dim2)`, where
    ; every sibling reads argv[1]. Two consequences, both measured against
    ; the reference binary and both reproduced here:
    ;   (xexpt 2.0 3.0) = 4  and  (xexpt 3.0 2.0) = 27   -- argv[0] to its
    ;     OWN power, argv[1]'s value never read;
    ;   (xexpt 2.0 "x") = 4  with NO diagnostic          -- the type guard
    ;     inspects argv[0] too, so it can never fire on argv[1].
    ; The DIMENSIONED branch is unaffected: it reads argv[1] properly and
    ; reports notAnExactInteger.
    ; ★NOT reproduced, because it is undefined behaviour: when argv[0] is an
    ; exact integer or a length, quantityValue never writes the double slot
    ; and the reference powers UNINITIALIZED stack — measured as
    ; `(xexpt 2 3)` = 0 and `(xexpt 2pt 2)` = 0 on this build, which is not a
    ; value any implementation can be held to. This port uses argv[0]'s real
    ; value there, so those two cases diverge by design.
    function x_expt_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, a: pointer[ELObj], b: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        let q1 a.quantity_value()
        let t1 q1.get_qtype()
        if t1 = QT_NONE
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, 0, a)
        var d1 q1.get_dval()
        if t1 = QT_LONG
            set d1: q1.get_lval() as double
        let dim1 q1.get_dim()
        if dim1 <> 0
        {
            if b.is_exact_integer() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, b)
            let n2 b.exact_integer_value()
            return ELObj.make_quantity(host, pow(d1, n2 as double), dim1 * n2)
        }
        ; the argv[0]-for-argv[1] read: the exponent IS the base, and the
        ; guard that would have rejected a bad argv[1] tests argv[0].
        let d2 d1
        let res pow(d1, d2)
        if a.is_exact_integer() and b.is_exact_integer()
        {
            let m Primitive.fabs_d(res)
            let lim Primitive.long_max_double()
            if m < lim
                return ELObj.make_integer(host, res as int)
        }
        ELObj.make_real(host, res)
    }

    ; exact->inexact: DEFPRIMITIVE(ExactToInexact) — an inexact argument is
    ; returned UNCHANGED, an exact one becomes a RealObj.
    ; ★The reference feeds RealObj from `realValue`, which FAILS for a
    ; dimensioned quantity and leaves the double unwritten — `(exact->inexact
    ; 1pt)` reads uninitialized stack there. This port answers with the
    ; port's own realValue result (0.0 for a Length) rather than garbage.
    function exact_to_inexact(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        let qv obj.quantity_value()
        let t qv.get_qtype()
        if t = QT_NONE
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, 0, obj)
        if t = QT_DOUBLE
            return obj
        ELObj.make_real(host, obj.real_value())
    }

    ; inexact->exact: DEFPRIMITIVE(InexactToExact) — only an inexact value
    ; that is integral, dimensionless and in long range converts; everything
    ; else that is inexact reports noExactRepresentation and then ★FALLS
    ; THROUGH to `return argv[0]` (the C++ case label has no break), so the
    ; primitive yields the ARGUMENT after the error, not an error object.
    function inexact_to_exact(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        let qv obj.quantity_value()
        let t qv.get_qtype()
        if t = QT_NONE
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, 0, obj)
        if t = QT_DOUBLE
        {
            if obj.is_real() and (qv.get_dim() = 0)
            {
                let d obj.real_value()
                var ipart floor(d)
                if d < 0.0
                    set ipart: ceil(d)
                let m Primitive.fabs_d(d)
                let lim Primitive.long_max_double()
                if ((d - ipart) = 0.0) and (m < lim)
                    return ELObj.make_integer(host, d as int)
            }
            interp.set_next_location(loc)
            let os OutputCharStream.make(host)
            obj.print(os, interp.get_units_per_inch())
            let printed os.to_string_c(host)
            interp.message1(InterpreterMessages.noExactRepresentation(), printed)
        }
        obj
    }

    ; select-by-class: DEFPRIMITIVE(SelectByClass) — the members of the node
    ; list whose CLASS is the named one. The reference resolves the name
    ; through Interpreter::lookupNodeProperty over the whole RCS component-name
    ; table and hands the id to a lazy SelectByClassNodeListObj that keeps
    ; members with `classDef() == id`; a name that is not a component name at
    ; all yields the empty node list, and one that is a component name but not
    ; a CLASS name matches nothing — so matching the four grove class names and
    ; returning empty otherwise is behaviourally identical.
    function select_by_class(host: pointer[Page], interp: pointer[Interpreter], name: StringC, nl: pointer[ELObj], cls: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, nl)
        let cs cls.convert_to_string(host)
        if cs = null
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAStringOrSymbol(), name, 1, cls)
        let want cs.string_data(host)
        ; DEFPRIMITIVE(SelectByClass) resolves the name through
        ; lookupNodeProperty — a name that is no component at all yields the
        ; EMPTY node-list — and then compares classDef().className, so EVERY
        ; ComponentName spelling selects, the short RCS names ('sgmldoc,
        ; 'datachar) included. A class this port never builds simply matches
        ; nothing.
        let want_id interp.lookup_node_property(want)
        let result Array[pointer[GroveNode]]^host()
        if want_id <> CN_NO_ID
        {
            let n nl.node_list_count()
            var i 0
            while i < n
            {
                let node nl.node_list_node(i)
                if node <> null
                {
                    if GroveClassDef.class_name(node.get_class()) = want_id
                        result.add(node)
                }
                set i: i + 1
            }
        }
        ELObj.make_node_list(host, result, 0)
    }

    ; follow: DEFPRIMITIVE(Follow) — BaseNode::follow is the FOLLOWING
    ; SIBLINGS (nextSibling, then a SiblingNodeList from there), the exact
    ; mirror of preced. A multi-member argument maps over its members and
    ; concatenates, like preced.
    function follow_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, nl)
        let result Array[pointer[GroveNode]]^host()
        let n nl.node_list_count()
        var i 0
        while i < n
        {
            let node nl.node_list_node(i)
            if node <> null
            {
                ; the SIBLING axis, like preced (Node::follow; sibling_range_*
                ; carries getFirstSibling's root rule and the prolog/epilog PI
                ; overrides), data chunks expanded per character. Measured
                ; against the reference: follow of the `em` in
                ; `First <em>inner</em> text.` = 6, of its char node at index 3
                ; = 9 (2 chars + em + 6 chars).
                let sibs Array[pointer[GroveNode]]^host()
                Primitive.collect_expanded_siblings(host, node, sibs)
                ; chunk-level members like preced; only the member HOLDING the
                ; node contributes character views (its tail after the node).
                let tc Primitive.member_chunk_of(node)
                let off Primitive.member_offset_of(node)
                let m sibs.get_length()
                var j: size_t 0
                var seen false
                while j < m
                {
                    let s *(sibs.get_buffer() + j)
                    if seen
                        result.add(s)
                    else
                    {
                        if s = tc
                        {
                            set seen: true
                            if s.get_class() = GN_DATA
                            {
                                let cn s.chunk_char_count()
                                var k off + 1
                                while k < cn
                                {
                                    result.add(GroveNode.char_view(s, k))
                                    set k: k + 1
                                }
                            }
                        }
                    }
                    set j: j + (1 as size_t)
                }
            }
            set i: i + 1
        }
        ELObj.make_node_list_expanded(host, result, 0)
    }

    ; general-name-normalize: the string normalized per the grove's general-
    ; namecase (DEFPRIMITIVE GeneralNameNormalize / convertGeneralName) — the
    ; grove being the optional node argument's, else the current node's.
    function general_name_normalize(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        var node: pointer[GroveNode] null
        if n_args > 1
        {
            let a1 *(args + 1)
            if a1.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 1, a1)
            let nd a1.node_list_node(0)
            if nd = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 1, a1)
            set node: nd
        }
        else
        {
            let cn ctx.get_current_node()
            if cn = null
                return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
            set node: cn
        }
        let a0 *args
        if a0.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
        let q Primitive.convert_general_name(host, node, a0)
        if q = null
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
        ELObj.make_string(host, *q)
    }

    ; convertGeneralName (primitive.cxx:2868) — a GI written in a stylesheet
    ; folded with the ELEMENTS named node list's table, i.e. the general
    ; substitution table of the parse, so `"doc"` matches an element stored
    ; as `DOC`. ★This used to be the IDENTITY here, which made
    ; `general-name-normalize` a no-op and left every GI-matching primitive
    ; below relying on a case-insensitive compare instead of the parse's own
    ; table. Null = the argument had no string data.
    function convert_general_name(host: pointer[Page], node: pointer[GroveNode], obj: pointer[ELObj]) returns pointer[StringC]
    {
        if obj.has_string_data() = false
            return null
        Primitive.nnl_normalize(host, node, NNL_ELEMENTS, obj.string_data(host))
    }

    ; read-entity: the entity's decoded text (XPRIMITIVE ReadEntity —
    ; GroveManager::readEntity). The sysid opens as a file relative to the
    ; run's working directory; records normalize to RE (CR / CRLF / LF ->
    ; one 0x0D) exactly like the stylesheet reader; bytes widen 1:1
    ; (ASCII/Latin-1, the stylesheet-reader convention). A failing open is
    ; the error object — the reference reports it through the entity
    ; manager's messenger; we report the plain fact.
    ; a Scheme list of strings -> a byte-String list for the parser's -a/-A
    ; surfaces. Returns null on success, else the argError to return; `argx` is
    ; the 0-based argv index the reference names in the diagnostic.
    function decode_string_list(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], argx: int, blame: pointer[ELObj], out: pointer[Array[String]], loc: Location) returns pointer[ELObj]
    {
        var e obj
        while e.is_nil() = false
        {
            if e.is_pair() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, argx, blame)
            let car e.get_car()
            if car.has_string_data() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, argx, car)
            let sc car.string_data(host)
            let n sc.get_size()
            let cap n * (4 as size_t) + (1 as size_t)
            let pb host.allocate(cap, 1) as pointer[u8]
            let blen CodingSystem.encode_utf8_bytes(sc.data_ptr(), n, pb, cap)
            out.add(String^host(pb as pointer[const_char], blen))
            set e: e.get_cdr()
        }
        null
    }

    ; DEFPRIMITIVE SgmlParse (primitive.cxx:4303) and XSgmlParse (:4347) —
    ; groveManager()->load of a second document. The two differ in their key
    ; table only: ISO takes `active:` and `parent:`, the OpenJade-prefixed
    ; extension inserts `architecture:` between them.
    ;
    ; ★★The extension's decode loop is BROKEN in the reference, measured against
    ; the reference binary, and this port reproduces every reachable half of it:
    ;
    ;   for (int i = 0; i < 3; i++)
    ;     if (pos[i] >= 0) { ELObj *obj = argv[pos[0] + 1]; ... lists[i] ... }
    ;
    ; the subscript is `pos[0]` for EVERY i (a copy-paste slip), and `lists` has
    ; only TWO elements while i runs to 2. So:
    ;   * `architecture:` or `parent:` WITHOUT `active:` walks argv[0] — the
    ;     sysid string, which is no list — and reports `not a list` naming the
    ;     OTHER key's argument (measured: `3rd argument … "("arch")" not a
    ;     list`, and with parent: the node-list prints as `#<unknown object …>`);
    ;   * `architecture:` WITH `active:` silently fills the architecture list
    ;     from the ACTIVE names;
    ;   * `parent:` WITH `active:` writes past `lists` and the reference
    ;     SEGFAULTS (rc 139, measured). Reproducing a stack smash is not
    ;     fidelity — this port takes the same walk into a discarded list and
    ;     carries on, which is what the write would have meant.
    ; The ISO primitive has none of this: its single block reads pos[0] and is
    ; the one the standard names.
    function sgml_parse_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, id: int, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        if a0.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
        let sysid a0.string_data(host)
        let ext id = PRIM_X_SGML_PARSE
        var n_keys 2
        if ext
            set n_keys: 3
        let keys host.allocate(24, 8) as pointer[int]
        set *keys: SK_ACTIVE
        if ext
        {
            set *(keys + 1): SK_ARCHITECTURE
            set *(keys + 2): SK_PARENT
        }
        else
            set *(keys + 1): SK_PARENT
        let pos host.allocate(24, 8) as pointer[int]
        if Primitive.decode_key_args(n_args - 1, args + 1, keys, n_keys, interp, loc, pos) = false
            return interp.make_error()
        let active Array[String]^host()
        let arch Array[String]^host()
        let pa *pos
        ; `argv[pos[0] + 1]` — the reference's subscript, verbatim: the ACTIVE
        ; value when that key was given, else argv[0], the sysid string.
        var src a0
        if pa >= 0
            set src: *(args + 1 + pa)
        ; i = 0 — the active link types (both variants; the ISO body stops here).
        if pa >= 0
        {
            let e0 Primitive.decode_string_list(host, interp, name, src, pa + 1, src, &active, loc)
            if e0 <> null
                return e0
        }
        if ext
        {
            ; i = 1 — `architecture:`, walked out of `src` (see the note above),
            ; blamed on its OWN argument.
            let p1 *(pos + 1)
            if p1 >= 0
            {
                let b1 *(args + 1 + p1)
                let e1 Primitive.decode_string_list(host, interp, name, src, p1 + 1, b1, &arch, loc)
                if e1 <> null
                    return e1
            }
            ; i = 2 — the out-of-bounds `lists[2]`: the same walk, discarded.
            let p2 *(pos + 2)
            if p2 >= 0
            {
                let b2 *(args + 1 + p2)
                let scrap Array[String]^host()
                let e2 Primitive.decode_string_list(host, interp, name, src, p2 + 1, b2, &scrap, loc)
                if e2 <> null
                    return e2
            }
        }
        ; the `parent:` node — a strict singleton. The reference's own note
        ; applies: it reaches nothing beyond this type check (GroveManager.load
        ; on the dead subdoc branch).
        var parent: pointer[GroveNode] null
        let ppos *(pos + (n_keys - 1))
        if ppos >= 0
        {
            let pv *(args + 1 + ppos)
            if pv.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, ppos + 1, pv)
            let pn pv.node_list_node(0)
            if pn = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, ppos + 1, pv)
            set parent: pn
        }
        let root GroveManager.load(sysid, &active, parent, &arch)
        if root = null
            return ELObj.make_node_list(host, null, 0)
        ELObj.make_node_singleton(host, root)
    }

    function read_entity_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, a0: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if a0.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
        let sc a0.string_data(host)
        ; StringC (u32) -> byte String for the file API (UTF-8 encode).
        let n sc.get_size()
        let cap n * (4 as size_t) + (1 as size_t)
        let pbytes host.allocate(cap, 1) as pointer[u8]
        let blen CodingSystem.encode_utf8_bytes(sc.data_ptr(), n, pbytes, cap)
        let path String^host(pbytes as pointer[const_char], blen)
        if File.exists(path) = false
        {
            interp.set_next_location(loc)
            interp.message1(InterpreterMessages.errorProc(), StringC("read-entity: cannot open entity"))
            return interp.make_error()
        }
        let src File.read_to_string(path)
        let m src.get_length()
        let buf host.allocate(m * (sizeof u32), alignof u32) as pointer[u32]
        var off: size_t 0
        var i: size_t 0
        while i < m
        {
            let b src.get(i)
            if b = (0x0D as u8)
            {
                set *(buf + off): 0x0D as u32
                set off: off + (1 as size_t)
                if (i + (1 as size_t)) < m
                {
                    if src.get(i + (1 as size_t)) = (0x0A as u8)
                        set i: i + (1 as size_t)
                }
            }
            else if b = (0x0A as u8)
            {
                set *(buf + off): 0x0D as u32
                set off: off + (1 as size_t)
            }
            else
            {
                set *(buf + off): b as u32
                set off: off + (1 as size_t)
            }
            set i: i + (1 as size_t)
        }
        ELObj.make_string(host, StringC(buf, off))
    }

    ; node-list=?: the two node-lists contain identical nodes in identical
    ; order. DEFPRIMITIVE(IsNodeListEqual): node identity, pairwise.
    function node_list_equal(interp: pointer[Interpreter], name: StringC, a0: pointer[ELObj], a1: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if a0.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, a0)
        if a0 = a1
            return interp.make_true()
        if a1.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 1, a1)
        let n a0.node_list_count()
        if a1.node_list_count() <> n
            return interp.make_false()
        var i 0
        while i < n
        {
            ; DataNode::same2: a data node is (chunk, index), never object
            ; identity — two `children` calls hand out fresh views of the same
            ; character and must compare equal (measured: YES).
            let x a0.node_list_node(i)
            let y a1.node_list_node(i)
            if GroveNode.node_same(x, y) = false
                return interp.make_false()
            set i: i + 1
        }
        interp.make_true()
    }

    ; node-list-map: apply the procedure to each member (as a singleton) and
    ; append the resulting node-lists. DEFPRIMITIVE(NodeListMap) is lazy
    ; (MapNodeListObj); this eager equivalent mirrors mapNext exactly: an
    ; erroring call or a non-node-list result stops the mapping (the reference
    ; truncates the lazy list — it does NOT yield an error object), the
    ; non-node-list case additionally reporting returnNotNodeList.
    function node_list_map(host: pointer[Page], interp: pointer[Interpreter], name: StringC, f: pointer[ELObj], nl: pointer[ELObj], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        if f.is_function() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAProcedure(), name, 0, f)
        if f.n_required_args() > 1
            return Primitive.simple_error(interp, loc, InterpreterMessages.missingArg())
        if ((f.n_required_args() + f.n_optional_args()) = 0) and (f.has_rest_arg() = false)
            return Primitive.simple_error(interp, loc, InterpreterMessages.tooManyArgs())
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 1, nl)
        let result Array[pointer[GroveNode]]^host()
        let n nl.node_list_count()
        var i 0
        while i < n
        {
            let node nl.node_list_node(i)
            if node <> null
            {
                ; each member call runs under its own scratch region (the
                ; eval-bracket shape): only GroveNode POINTERS survive into
                ; `result` (grove-hosted, stable) — the fresh VM, its stacks,
                ; the call insn and every transient of f's body die here.
                ; Mirrors mapNext's per-call `VM vm(context, interp)` whose
                ; garbage the reference GC reclaims.
                let saved_region interp.get_eval_region()
                let mparent interp.get_host()
                let scratch mparent.allocate_exclusive_page()
                interp.set_eval_region(scratch)
                let mhost interp.get_host()
                let single ELObj.make_node_singleton(mhost, node)
                let mvm VM.make(mhost, interp)
                let cn ctx.get_current_node()
                mvm.set_current_node(cn)
                ; EvalContext carries over (the reference constructs the
                ; per-call VM FROM the outer context) — mode included.
                mvm.set_processing_mode(ctx.get_processing_mode())
                let insn f.make_call_insn(1, interp, loc, null)
                let ret mvm.eval(insn, null, single)
                var stop false
                if interp.is_error(ret)
                    set stop: true
                else if ret.is_node_list_p() = false
                {
                    interp.set_next_location(loc)
                    interp.message0(InterpreterMessages.returnNotNodeList())
                    set stop: true
                }
                else
                {
                    let m ret.node_list_count()
                    var j 0
                    while j < m
                    {
                        let rn ret.node_list_node(j)
                        if rn <> null
                            result.add(rn)
                        set j: j + 1
                    }
                }
                interp.set_eval_region(saved_region)
                mparent.deallocate_exclusive_page(scratch)
                if stop
                    return ELObj.make_node_list(host, result, 0)
            }
            set i: i + 1
        }
        ELObj.make_node_list(host, result, 0)
    }

    ; --- the DECLARATION axis: nodes over the prolog's tables ---------------
    ;
    ; BaseNode::getGroveRoot — the sgml-document node. A tree node climbs its
    ; structural parents; a DECLARATION node climbs the OWNER chain, which is
    ; what its `parent` field holds (its parent AXIS is null).
    function grove_root_of(node: pointer[GroveNode]) returns pointer[GroveNode]
    {
        var cur node
        var up cur.get_parent()
        while up <> null
        {
            set cur: up
            set up: cur.get_parent()
        }
        cur
    }

    ; grove->governingDtd(), as a document-type node owned by the grove root.
    ; Null when the run has no DTD (the reference answers accessNull then).
    function doctype_node(host: pointer[Page], node: pointer[GroveNode]) returns pointer[GroveNode]
    {
        let d GroveInfo.dtd_of(node)
        if d = null
            return null
        let root Primitive.grove_root_of(node)
        GroveNode.make_decl(host, GN_DOCUMENT_TYPE, d, root, 0)
    }

    ; an entity node: EntityNode / DefaultEntityNode. The data ATTRIBUTES ride in
    ; the node's attribute slot so the assignment views (GroveNode.attr_views)
    ; work off an entity origin exactly as off an element.
    function entity_node(host: pointer[Page], node_class: int, ent: pointer[Entity], owner: pointer[GroveNode]) returns pointer[GroveNode]
    {
        let p GroveNode.make_decl(host, node_class, ent as pointer[void], owner, 0)
        let atts ent.get_data_attributes()
        set p.attributes: atts as pointer[AttributeList]
        p
    }

    ; --- EntityRefNode (spgrove/GroveBuilder.cxx:3580) --------------------
    ; The two accessors the sdata / external-data / subdocument classes share
    ; with a PI ENTITY node: the referenced entity's name, and an entity NODE
    ; over it. The builder parked the Entity in the node's `decl` slot; a
    ; markup PI has none, and there the reference's PiNode answers accessNull
    ; for both (they ARE declared on the pi class, so never notInClass).
    function entity_ref_name(host: pointer[Page], node: pointer[GroveNode], access: pointer[int]) returns pointer[ELObj]
    {
        let ent node.get_decl() as pointer[Entity]
        if ent = null
        {
            set *access: ACCESS_NULL
            return null
        }
        set *access: ACCESS_OK
        return ELObj.make_string(host, ent.get_name())
    }

    function entity_ref_node_value(host: pointer[Page], interp: pointer[Interpreter], node: pointer[GroveNode], access: pointer[int]) returns pointer[ELObj]
    {
        let ent node.get_decl() as pointer[Entity]
        if ent = null
        {
            set *access: ACCESS_NULL
            return null
        }
        set *access: ACCESS_OK
        ; `new EntityNode(grove(), chunk()->entity)` — an ordinary entity node,
        ; so its owner (and therefore its origin) is the governing doctype.
        let edt Primitive.doctype_node(host, node)
        let enode Primitive.entity_node(host, GN_ENTITY, ent, edt)
        return ELObj.make_node_singleton(host, enode)
    }

    ; SdataNode::charChunk — the one character the SdataMapper resolves for
    ; this reference. The entity NAME is the primary key (the built-in sdata.h
    ; table), its replacement text the secondary one.
    function sdata_char(interp: pointer[Interpreter], node: pointer[GroveNode]) returns u32
    {
        let cached node.sdata_view()
        if cached.get_size() > (0 as size_t)
            return cached.get(0 as size_t)
        let ent node.get_decl() as pointer[Entity]
        var nm StringC()
        if ent <> null
            set nm: ent.get_name()
        let c interp.sdata_map(nm, node.get_chars())
        node.set_sdata_view(c)
        c
    }

    ; SdataNode::charChunk's string: the same character as a one-element run,
    ; for the callers that hand a (pointer, length) to a FOT builder — which
    ; may RECORD the pointer, so it has to be the node's memoized copy.
    function sdata_view_string(interp: pointer[Interpreter], node: pointer[GroveNode]) returns StringC
    {
        let cached node.sdata_view()
        if cached.get_size() > (0 as size_t)
            return cached
        let c Primitive.sdata_char(interp, node)
        node.sdata_view()
    }

    ; The reference's NamedTable ITERATION ORDER as a permutation of an
    ; insertion-ordered name list: every declaration table in this port is an
    ; insertion-ordered Array while the reference's is a PointerTable, and the
    ; order is OBSERVABLE through the named node lists. Computed by the table
    ; itself (IdTable.bucket_order, the same layout the -oentity general-entity
    ; sweep re-derives) — the permutation, not the nodes, is what crosses the
    ; package boundary.
    function bucket_order(host: pointer[Page], names: pointer[Array[StringC]]) returns pointer[Array[size_t]]
        IdTable.bucket_order(host, names)

    ; EntitiesNodeList over a DTD entity table (general or parameter), in bucket
    ; order, as entity nodes owned by the doctype node.
    function dtd_entity_nodes(host: pointer[Page], dtd: pointer[Dtd], is_parameter: bool, dt_node: pointer[GroveNode]) returns pointer[Array[pointer[GroveNode]]]
    {
        let ents Array[pointer[Entity]]^host()
        let names Array[StringC]^host()
        let n dtd.n_entities(is_parameter)
        var i: size_t 0
        while i < n
        {
            let e dtd.entity_at(is_parameter, i)
            if e <> null
            {
                ents.add(e)
                names.add(e.get_name())
            }
            set i: i + (1 as size_t)
        }
        let perm Primitive.bucket_order(host, names)
        let arr Array[pointer[GroveNode]]^host()
        let pn perm.get_length()
        let pb perm.get_buffer()
        let eb ents.get_buffer()
        var k: size_t 0
        while k < pn
        {
            let idx *(pb + k)
            let e2 *(eb + idx)
            let nd Primitive.entity_node(host, GN_ENTITY, e2, dt_node)
            arr.add(nd)
            set k: k + (1 as size_t)
        }
        arr
    }

    ; the grove's defaulted-entity table (GroveImpl::defaultedEntityIter), same
    ; bucket-order treatment.
    function defaulted_entity_nodes(host: pointer[Page], dt_node: pointer[GroveNode]) returns pointer[Array[pointer[GroveNode]]]
    {
        let arr Array[pointer[GroveNode]]^host()
        let list GroveInfo.defaulted_ents_of(dt_node)
        if list = null
            return arr
        let names Array[StringC]^host()
        let ents Array[pointer[Entity]]^host()
        let n list.get_length()
        let buf list.get_buffer()
        var i: size_t 0
        while i < n
        {
            let e *(buf + i)
            if e <> null
            {
                ents.add(e)
                names.add(e.get_name())
            }
            set i: i + (1 as size_t)
        }
        let perm Primitive.bucket_order(host, names)
        let pn perm.get_length()
        let pb perm.get_buffer()
        let eb ents.get_buffer()
        var k: size_t 0
        while k < pn
        {
            let idx *(pb + k)
            let e2 *(eb + idx)
            let nd Primitive.entity_node(host, GN_ENTITY, e2, dt_node)
            arr.add(nd)
            set k: k + (1 as size_t)
        }
        arr
    }

    ; SgmlDocumentNode::getEntities — DocEntitiesNamedNodeList. ★Its LIST is the
    ; governing DTD's general entities; the grove's defaulted entities appear
    ; only when that table is EMPTY, because DocEntitiesNodeList's default-entity
    ; fallback sits in chunkRest and the rest chain hands out a PLAIN
    ; EntitiesNodeList from the second step on. The NAMED lookup does have the
    ; fallback for every step, which NNL_DOC_ENTITIES carries (named_node_prim).
    function doc_entities_list(host: pointer[Page], interp: pointer[Interpreter], node: pointer[GroveNode]) returns pointer[ELObj]
    {
        let dt Primitive.doctype_node(host, node)
        if dt = null
            return null
        let d GroveInfo.dtd_of(node)
        let dtd d as pointer[Dtd]
        var arr Primitive.dtd_entity_nodes(host, dtd, false, dt)
        if arr.get_length() = (0 as size_t)
        {
            if dtd.get_default_entity() <> null
                set arr: Primitive.defaulted_entity_nodes(host, dt)
        }
        ELObj.make_named_node_list(host, arr, NNL_DOC_ENTITIES)
    }

    ; NotationsNodeList over the DTD's notation table, in bucket order.
    function notation_nodes(host: pointer[Page], dtd: pointer[Dtd], dt_node: pointer[GroveNode]) returns pointer[Array[pointer[GroveNode]]]
    {
        let nots Array[pointer[Notation]]^host()
        let names Array[StringC]^host()
        let n dtd.n_notations()
        var i: size_t 0
        while i < n
        {
            let nt dtd.notation_at(i)
            if nt <> null
            {
                nots.add(nt)
                names.add(nt.get_name())
            }
            set i: i + (1 as size_t)
        }
        let perm Primitive.bucket_order(host, names)
        let arr Array[pointer[GroveNode]]^host()
        let pn perm.get_length()
        let pb perm.get_buffer()
        let nb2 nots.get_buffer()
        var k: size_t 0
        while k < pn
        {
            let idx *(pb + k)
            let nt2 *(nb2 + idx)
            let nd GroveNode.make_decl(host, GN_NOTATION, nt2 as pointer[void], dt_node, 0)
            arr.add(nd)
            set k: k + (1 as size_t)
        }
        arr
    }

    ; ElementTypesNodeList over the DTD's element-type table, in bucket order.
    function element_type_nodes(host: pointer[Page], dtd: pointer[Dtd], dt_node: pointer[GroveNode]) returns pointer[Array[pointer[GroveNode]]]
    {
        let ets Array[pointer[ElementType]]^host()
        let names Array[StringC]^host()
        let n dtd.n_element_types()
        var i: size_t 0
        while i < n
        {
            let et dtd.get_element_type_at(i)
            if et <> null
            {
                ets.add(et)
                names.add(et.get_name())
            }
            set i: i + (1 as size_t)
        }
        let perm Primitive.bucket_order(host, names)
        let arr Array[pointer[GroveNode]]^host()
        let pn perm.get_length()
        let pb perm.get_buffer()
        let eb ets.get_buffer()
        var k: size_t 0
        while k < pn
        {
            let idx *(pb + k)
            let et2 *(eb + idx)
            let nd GroveNode.make_decl(host, GN_ELEMENT_TYPE, et2 as pointer[void], dt_node, 0)
            arr.add(nd)
            set k: k + (1 as size_t)
        }
        arr
    }

    ; AttributeDefsNodeList — every definition of an attribute definition list in
    ; DECLARATION order (attIndex 0..n, no permutation: the reference walks the
    ; index, not a table). `owner` is the element-type or notation node, which is
    ; also the attribute-def's identity (attributeOriginId).
    function attribute_def_nodes(host: pointer[Page], adl: pointer[AttributeDefinitionList], owner: pointer[GroveNode]) returns pointer[Array[pointer[GroveNode]]]
    {
        let arr Array[pointer[GroveNode]]^host()
        if adl = null
            return arr
        let n adl.size()
        var i: size_t 0
        while i < n
        {
            let nd GroveNode.make_decl(host, GN_ATTRIBUTE_DEF, adl as pointer[void], owner, i as int)
            arr.add(nd)
            set i: i + (1 as size_t)
        }
        arr
    }

    ; the attribute definition list an attribute-def node (or an element-type /
    ; notation node) reads: AttributeDefOrigin::attDefList.
    function att_def_list_of(node: pointer[GroveNode]) returns pointer[AttributeDefinitionList]
    {
        let cls node.get_class()
        if cls = GN_ELEMENT_TYPE
        {
            let et node.get_decl() as pointer[ElementType]
            return et.get_attribute_def()
        }
        if cls = GN_NOTATION
        {
            let nt node.get_decl() as pointer[Notation]
            return nt.get_attribute_def()
        }
        if cls = GN_ATTRIBUTE_DEF
            return node.get_decl() as pointer[AttributeDefinitionList]
        null
    }

    ; `entity_->defaulted() && grove()->lookupDefaultedEntity(name)` — the
    ; reference's own conjunction (EntityNode::getOrigin / …RelPropertyName):
    ; the entity must be a DEFAULTED COPY *and* registered in the grove's table.
    ; A prolog-time defaulted copy lands in the DTD but not in that table, and a
    ; plainly declared entity that the instance referenced is in the table but is
    ; not a copy — neither counts.
    function entity_is_grove_defaulted(node: pointer[GroveNode], ent: pointer[Entity]) returns bool
    {
        if ent = null
            return false
        if GroveInfo.entity_is_defaulted(node, ent) = false
            return false
        let nm ent.get_name()
        GroveInfo.lookup_defaulted_ent(node, nm) <> null
    }

    ; the NAME of the declaration a node stands for (EntityNodeBase::getName,
    ; NotationNode::getName, DocumentTypeNode::getName — all the same property).
    function decl_name_of(node: pointer[GroveNode]) returns StringC
    {
        let cls node.get_class()
        if cls = GN_ENTITY
        {
            let e node.get_decl() as pointer[Entity]
            if e = null
                return StringC()
            return e.get_name()
        }
        if cls = GN_DEFAULT_ENTITY
        {
            let e2 node.get_decl() as pointer[Entity]
            if e2 = null
                return StringC()
            return e2.get_name()
        }
        if cls = GN_NOTATION
        {
            let nt node.get_decl() as pointer[Notation]
            if nt = null
                return StringC()
            return nt.get_name()
        }
        if cls = GN_DOCUMENT_TYPE
        {
            let dtd node.get_decl() as pointer[Dtd]
            if dtd = null
                return StringC()
            return dtd.get_name()
        }
        StringC()
    }

    ; the definition an attribute-def node stands for, null out of range
    function att_def_of(node: pointer[GroveNode]) returns pointer[AttributeDefinition]
    {
        let adl Primitive.att_def_list_of(node)
        if adl = null
            return null
        let i node.get_char_index() as size_t
        if i >= adl.size()
            return null
        adl.def(i)
    }

    ; ModelGroupNode::makeNode — one content token of a model group: a nested
    ; group, an element token, or the #PCDATA token.
    function content_token_node(host: pointer[Page], mg_node: pointer[GroveNode], member: pointer[CmNode], index: int) returns pointer[GroveNode]
    {
        if member = null
            return null
        if member.kind = GNK_GROUP
            return GroveNode.make_decl(host, GN_MODEL_GROUP, member as pointer[void], mg_node, index)
        ; a LEAF: an element token, or (the reference's only other reachable
        ; leaf) the #PCDATA token.
        let et member.element
        if et <> null
            return GroveNode.make_decl(host, GN_ELEMENT_TOKEN, member as pointer[void], mg_node, index)
        GroveNode.make_decl(host, GN_PCDATA_TOKEN, member as pointer[void], mg_node, index)
    }

    ; ContentTokenNodeList over a model group's members.
    function content_token_nodes(host: pointer[Page], mg_node: pointer[GroveNode]) returns pointer[Array[pointer[GroveNode]]]
    {
        let arr Array[pointer[GroveNode]]^host()
        let mg mg_node.get_decl() as pointer[CmNode]
        if mg = null
            return arr
        let mems mg.members
        if mems = null
            return arr
        let n mems.get_length()
        let buf mems.get_buffer()
        var i: size_t 0
        while i < n
        {
            let m *(buf + i)
            let nd Primitive.content_token_node(host, mg_node, m, i as int)
            if nd <> null
                arr.add(nd)
            set i: i + (1 as size_t)
        }
        arr
    }

    ; GroveStringListPtr — a proper list of strings (exclusions / inclusions /
    ; tokens), built back to front onto nil like every other ELObj list.
    function make_string_list(host: pointer[Page], interp: pointer[Interpreter], items: pointer[Array[StringC]]) returns pointer[ELObj]
    {
        var result interp.make_nil()
        var i items.get_length()
        let buf items.get_buffer()
        while i > (0 as size_t)
        {
            set i: i - (1 as size_t)
            let s *(buf + i)
            let so ELObj.make_string(host, s)
            set result: ELObj.make_pair(host, so, result)
        }
        result
    }

    ; ElementTypeCurrentGroupAttributeDefsNodeList — every #CURRENT attribute
    ; definition in the DTD that shares one current-attribute index, walking the
    ; element types in bucket order.
    ; ★DOCUMENTED DEVIATION: the reference dereferences
    ; `elementType->attributeDefTemp()` without a null check, so this property
    ; SEGFAULTS for any DTD holding an element type without an attribute
    ; definition list (measured: one #CURRENT probe on a document whose title
    ; element has no ATTLIST kills it). We skip such element types.
    function current_group_nodes(host: pointer[Page], interp: pointer[Interpreter], node: pointer[GroveNode], current_index: size_t) returns pointer[Array[pointer[GroveNode]]]
    {
        let arr Array[pointer[GroveNode]]^host()
        let d GroveInfo.dtd_of(node)
        if d = null
            return arr
        let dtd d as pointer[Dtd]
        let dt Primitive.doctype_node(host, node)
        let ets Primitive.element_type_nodes(host, dtd, dt)
        let n ets.get_length()
        let buf ets.get_buffer()
        var i: size_t 0
        while i < n
        {
            let et_node *(buf + i)
            let adl Primitive.att_def_list_of(et_node)
            if adl <> null
            {
                let m adl.size()
                var k: size_t 0
                while k < m
                {
                    let def adl.def(k)
                    if def <> null
                    {
                        if def.is_current()
                        {
                            if def.get_current_index() = current_index
                            {
                                let nd GroveNode.make_decl(host, GN_ATTRIBUTE_DEF, adl as pointer[void], et_node, k as int)
                                arr.add(nd)
                            }
                        }
                    }
                    set k: k + (1 as size_t)
                }
            }
            set i: i + (1 as size_t)
        }
        arr
    }

    ; AttributeDefOrigin::makeAttributeValueNodeList — an attribute definition's
    ; DEFAULT VALUE as a node list: accessNull when there is no value object or
    ; the CDATA text holds no character data (skipBoring), else the same two
    ; shapes an attribute assignment's `value` has — one attribute-value-token
    ; per token, or a data chunk whose per-character views are the members.
    function default_value_list(host: pointer[Page], node: pointer[GroveNode], access: pointer[int]) returns pointer[ELObj]
    {
        set *access: ACCESS_NULL
        let def Primitive.att_def_of(node)
        if def = null
            return null
        let av def.get_default_value()
        if av = null
            return null
        let arr Array[pointer[GroveNode]]^host()
        if av.is_tokenized()
        {
            let nt av.n_tokens()
            var k: size_t 0
            while k < nt
            {
                let p GroveNode.make_decl(host, GN_ATTR_TOKEN, null as pointer[void], node, 0)
                let tok GroveNode.value_token(host, av, k)
                set p.chars: *tok
                set p.element_index: k as int
                set p.chunk: node
                arr.add(p)
                set k: k + (1 as size_t)
            }
            set *access: ACCESS_OK
            return ELObj.make_node_list(host, arr, 0)
        }
        let t av.get_text()
        if t = null
            return null
        let s t.string()
        if s.get_size() = (0 as size_t)
            return null
        let p2 GroveNode.make_decl(host, GN_DATA, null as pointer[void], node, 0)
        set p2.chars: s
        arr.add(p2)
        set *access: ACCESS_OK
        ELObj.make_node_list_expanded(host, arr, 0)
    }

    ; node-property: the named property of a singleton node (DEFPRIMITIVE
    ; NodeProperty), keyword args default:/null:/rcs? decoded per the
    ; reference decodeKeyArgs (first occurrence wins, odd count / non-keyword /
    ; unknown keyword are hard messages). The name resolves through the full
    ; ComponentName table (Grove.ComponentName — both the RCS and the SDQL
    ; spelling of all 107 ids, case-insensitively), the value comes from
    ; node_property_value below, and the three access results decide the answer:
    ; accessOK -> the value, accessNull -> null: then default:, and both
    ; accessNotInClass and an unknown NAME -> default:, without which the
    ; reference reports noNodePropertyValue and yields an error object.
    ;
    ; NOT ported: the reference's one hack for the duplicate RCS name `tokens`
    ; (on a model-group node it means content-tokens) — that node class does not
    ; exist here, so the plain table lookup is equivalent.
    function node_property(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], loc: Location) returns pointer[ELObj]
    {
        let prop_obj *args
        let cs prop_obj.convert_to_string(host)
        if cs = null
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAStringOrSymbol(), name, 0, prop_obj)
        let nl *(args + 1)
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 1, nl)
        let node nl.node_list_node(0)
        if node = null
            return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 1, nl)
        ; --- decodeKeyArgs over args[2..] (pairs; reverse scan = first wins) --
        let n_rest n_args - 2
        if (n_rest & 1) = 1
        {
            interp.set_next_location(loc)
            interp.message0(InterpreterMessages.oddKeyArgs())
            return interp.make_error()
        }
        var dflt: pointer[ELObj] null
        var nullv: pointer[ELObj] null
        var want_rcs false
        var i n_args - 1
        while i > 2
        {
            let kobj *(args + i - 1)
            if kobj.is_keyword_p() = false
            {
                interp.set_next_location(loc)
                interp.message0(InterpreterMessages.keyArgsNotKey())
                return interp.make_error()
            }
            let kn kobj.keyword_name()
            if kn.equals(StringC("default"))
                set dflt: *(args + i)
            else if kn.equals(StringC("null"))
                set nullv: *(args + i)
            else if kn.equals(StringC("rcs?"))
            {
                ; `pos[2] >= 0 && argv[...] != makeFalse()` — the flag is the
                ; VALUE, so rcs?: #f is off; it selects the short RCS spelling
                ; of every component-name result.
                let v *(args + i)
                set want_rcs: v.is_true()
            }
            else
            {
                interp.set_next_location(loc)
                interp.message1(InterpreterMessages.invalidKeyArg(), kn)
                return interp.make_error()
            }
            set i: i - 2
        }
        ; --- lookupNodeProperty + Node::property ---------------------------
        let pname cs.string_data(host)
        var access ACCESS_NOT_IN_CLASS
        var result: pointer[ELObj] null
        let id interp.lookup_node_property(pname)
        if id <> CN_NO_ID
            set result: Primitive.node_property_value(host, interp, node, id, want_rcs, &access)
        ; accessOK -> the value; accessNull prefers null: over default:; both
        ; accessNotInClass and an UNKNOWN name fall through to default:, and
        ; without one the reference reports noNodePropertyValue with the name
        ; AS WRITTEN and yields an error object.
        if access = ACCESS_OK
            return result
        if access = ACCESS_NULL
        {
            if nullv <> null
                return nullv
        }
        if dflt <> null
            return dflt
        interp.set_next_location(loc)
        interp.message1(InterpreterMessages.noNodePropertyValue(), pname)
        interp.make_error()
    }

    ; Node::property for the DECLARATION classes (the per-class blocks of
    ; grove/Node.cxx's switch, whose accessors live in spgrove/GroveBuilder.cxx).
    ; The INTRINSIC props are answered by node_property_value before it gets
    ; here; `access` arrives set to accessNotInClass, which is the answer for
    ; every id a class does not declare.
    function decl_property_value(host: pointer[Page], interp: pointer[Interpreter], node: pointer[GroveNode], id: int, want_rcs: bool, access: pointer[int]) returns pointer[ELObj]
    {
        let cls node.get_class()
        ; --- classes entity / default-entity (ClassDef::entity /
        ;     ClassDef::defaultEntity; EntityNodeBase's accessors) -----------
        if node.is_entity_class()
        {
            let ent node.get_decl() as pointer[Entity]
            if ent = null
                return null
            if id = CN_NAME
            {
                set *access: ACCESS_OK
                return ELObj.make_string(host, ent.get_name())
            }
            if id = CN_ENTITY_TYPE
            {
                ; EntityNodeBase::getEntityType, then Node::property's mapping
                ; of the EntityType enum onto a component NAME.
                set *access: ACCESS_OK
                let dt ent.data_type()
                if dt = GDT_PI
                    return Primitive.make_component_name(interp, CN_PI, want_rcs)
                if dt = GDT_CDATA
                    return Primitive.make_component_name(interp, CN_CDATA, want_rcs)
                if dt = GDT_SDATA
                    return Primitive.make_component_name(interp, CN_SDATA, want_rcs)
                if dt = GDT_NDATA
                    return Primitive.make_component_name(interp, CN_NDATA, want_rcs)
                if dt = GDT_SUBDOC
                    return Primitive.make_component_name(interp, CN_SUBDOCUMENT, want_rcs)
                return Primitive.make_component_name(interp, CN_TEXT, want_rcs)
            }
            if id = CN_TEXT
            {
                ; asInternalEntity()->string() — accessNull for every external arm
                if ent.is_external()
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                return ELObj.make_string(host, ent.internal_text())
            }
            if id = CN_EXTERNAL_ID
            {
                ; asExternalEntity() — accessNull for an internal entity
                if ent.is_external() = false
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                let x GroveNode.make_decl(host, GN_EXTERNAL_ID, ent as pointer[void], node, 0)
                return ELObj.make_node_singleton(host, x)
            }
            if id = CN_ATTRIBUTES
            {
                ; EntityNodeBase::getAttributes — the DATA attributes of an
                ; external data entity, accessNull for anything else. The
                ; assignment views read the node's attribute slot, which
                ; Primitive.entity_node filled from the entity.
                let atts0 node.get_attributes()
                if atts0 = null
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                return Primitive.make_attributes_list(host, node)
            }
            if id = CN_NOTATION_NAME
            {
                let nt0 ent.get_data_notation() as pointer[Notation]
                if nt0 = null
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                return ELObj.make_string(host, nt0.get_name())
            }
            if id = CN_NOTATION
            {
                let nt1 ent.get_data_notation() as pointer[Notation]
                if nt1 = null
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                let dt1 Primitive.doctype_node(host, node)
                let nn GroveNode.make_decl(host, GN_NOTATION, nt1 as pointer[void], dt1, 0)
                return ELObj.make_node_singleton(host, nn)
            }
            if id = CN_DEFAULTED
            {
                ; ★EntityNode::getDefaulted only — the DEFAULT-ENTITY class does
                ; not implement it (measured accessNotInClass), which is also why
                ; `defaulted?` is missing from its all-property-names.
                if cls <> GN_ENTITY
                    return null
                set *access: ACCESS_OK
                if GroveInfo.entity_is_defaulted(node, ent)
                    return interp.make_true()
                return interp.make_false()
            }
            return null
        }

        ; --- class notation (ClassDef::notation) ---------------------------
        if cls = GN_NOTATION
        {
            let nt node.get_decl() as pointer[Notation]
            if nt = null
                return null
            if id = CN_NAME
            {
                set *access: ACCESS_OK
                return ELObj.make_string(host, nt.get_name())
            }
            if id = CN_EXTERNAL_ID
            {
                ; NotationNode::getExternalId assigns UNCONDITIONALLY — a
                ; notation always has an external id node, even a
                ; PUBLIC-only one whose system-id is then accessNull.
                set *access: ACCESS_OK
                let x2 GroveNode.make_decl(host, GN_EXTERNAL_ID, nt as pointer[void], node, 0)
                return ELObj.make_node_singleton(host, x2)
            }
            if id = CN_ATTRIBUTE_DEFS
            {
                set *access: ACCESS_OK
                let adl0 nt.get_attribute_def()
                let arr0 Primitive.attribute_def_nodes(host, adl0, node)
                return ELObj.make_named_node_list(host, arr0, NNL_ATTRIBUTE_DEFS)
            }
            return null
        }

        ; --- class external-id (ClassDef::externalId) -----------------------
        if cls = GN_EXTERNAL_ID
        {
            ; ExternalIdNode::externalId() — the owner's id (an entity's or a
            ; notation's), which is why the owner CLASS decides how to fetch it.
            let owner node.get_parent()
            if owner = null
                return null
            var xid ExternalId()
            let ocls owner.get_class()
            if ocls = GN_NOTATION
            {
                let ownt owner.get_decl() as pointer[Notation]
                if ownt = null
                    return null
                set xid: ownt.get_external_id()
            }
            else
            {
                let owent owner.get_decl() as pointer[Entity]
                if owent = null
                    return null
                set xid: owent.get_external_id()
            }
            if id = CN_PUBLIC_ID
            {
                ; publicIdString() — accessNull when none was declared
                if xid.has_public_id() = false
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                let pid xid.get_public_id()
                return Primitive.make_string_from_bytes(host, pid)
            }
            if id = CN_SYSTEM_ID
            {
                if xid.has_system_id() = false
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                let sid xid.get_system_id()
                return Primitive.make_string_from_bytes(host, sid)
            }
            if id = CN_GENERATED_SYSTEM_ID
            {
                ; effectiveSystemId() — accessNull when EMPTY (the catalog
                ; consult found nothing), never when merely unresolved.
                let eff xid.get_effective_system()
                if eff.get_length() = (0 as size_t)
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                return Primitive.make_string_from_bytes(host, eff)
            }
            return null
        }

        ; --- class document-type (ClassDef::documentType) -------------------
        if cls = GN_DOCUMENT_TYPE
        {
            let dtd node.get_decl() as pointer[Dtd]
            if dtd = null
                return null
            if id = CN_NAME
            {
                set *access: ACCESS_OK
                return ELObj.make_string(host, dtd.get_name())
            }
            if id = CN_GOVERNING
            {
                ; DocumentTypeNode::getGoverning — Dtd::isBase
                set *access: ACCESS_OK
                if dtd.get_is_base()
                    return interp.make_true()
                return interp.make_false()
            }
            if id = CN_GENERAL_ENTITIES
            {
                set *access: ACCESS_OK
                let arr1 Primitive.dtd_entity_nodes(host, dtd, false, node)
                return ELObj.make_named_node_list(host, arr1, NNL_ENTITIES)
            }
            if id = CN_PARAMETER_ENTITIES
            {
                set *access: ACCESS_OK
                let arr2 Primitive.dtd_entity_nodes(host, dtd, true, node)
                return ELObj.make_named_node_list(host, arr2, NNL_ENTITIES)
            }
            if id = CN_NOTATIONS
            {
                set *access: ACCESS_OK
                let arr3 Primitive.notation_nodes(host, dtd, node)
                return ELObj.make_named_node_list(host, arr3, NNL_NOTATIONS)
            }
            if id = CN_ELEMENT_TYPES
            {
                set *access: ACCESS_OK
                let arr4 Primitive.element_type_nodes(host, dtd, node)
                return ELObj.make_named_node_list(host, arr4, NNL_ELEMENT_TYPES)
            }
            if id = CN_DEFAULT_ENTITY
            {
                ; DocumentTypeNode::getDefaultEntity — the #DEFAULT declaration,
                ; as a node of the DEFAULT-ENTITY class (a different class from
                ; every other entity node).
                let de dtd.get_default_entity()
                if de = null
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                let den Primitive.entity_node(host, GN_DEFAULT_ENTITY, de, node)
                return ELObj.make_node_singleton(host, den)
            }
            return null
        }

        ; --- class element-type (ClassDef::elementType) ---------------------
        if cls = GN_ELEMENT_TYPE
        {
            let et node.get_decl() as pointer[ElementType]
            if et = null
                return null
            if id = CN_GI
            {
                set *access: ACCESS_OK
                return ELObj.make_string(host, et.get_name())
            }
            if id = CN_ATTRIBUTE_DEFS
            {
                set *access: ACCESS_OK
                let adl1 et.get_attribute_def()
                let arr5 Primitive.attribute_def_nodes(host, adl1, node)
                return ELObj.make_named_node_list(host, arr5, NNL_ATTRIBUTE_DEFS)
            }
            ; every remaining property needs the DEFINITION — an element type
            ; that was only referenced has none, and the reference answers
            ; accessNull for all of them then.
            let def et.get_definition()
            if def = null
            {
                set *access: ACCESS_NULL
                return null
            }
            let dc def.get_declared_content()
            if id = CN_CONTENT_TYPE
            {
                set *access: ACCESS_OK
                if dc = GDC_ANY
                    return Primitive.make_component_name(interp, CN_ANY, want_rcs)
                if dc = GDC_CDATA
                    return Primitive.make_component_name(interp, CN_CDATA, want_rcs)
                if dc = GDC_RCDATA
                    return Primitive.make_component_name(interp, CN_RCDATA, want_rcs)
                if dc = GDC_EMPTY
                    return Primitive.make_component_name(interp, CN_EMPTY, want_rcs)
                return Primitive.make_component_name(interp, CN_MODEL_GROUP, want_rcs)
            }
            if id = CN_EXCLUSIONS
            {
                ; getExclusions / getInclusions — accessNull unless the declared
                ; content is a model group or ANY; an EMPTY list otherwise
                ; (accessOK), which is the measured difference between an EMPTY
                ; element type and an ANY one.
                if dc <> GDC_MODEL_GROUP
                {
                    if dc <> GDC_ANY
                    {
                        set *access: ACCESS_NULL
                        return null
                    }
                }
                set *access: ACCESS_OK
                let ex Array[StringC]^host()
                let nx def.n_exclusions()
                var xi: size_t 0
                while xi < nx
                {
                    let xt def.exclusion(xi)
                    if xt <> null
                        ex.add(xt.get_name())
                    set xi: xi + (1 as size_t)
                }
                return Primitive.make_string_list(host, interp, ex)
            }
            if id = CN_INCLUSIONS
            {
                if dc <> GDC_MODEL_GROUP
                {
                    if dc <> GDC_ANY
                    {
                        set *access: ACCESS_NULL
                        return null
                    }
                }
                set *access: ACCESS_OK
                let inc Array[StringC]^host()
                let ni def.n_inclusions()
                var ii: size_t 0
                while ii < ni
                {
                    let it def.inclusion(ii)
                    if it <> null
                        inc.add(it.get_name())
                    set ii: ii + (1 as size_t)
                }
                return Primitive.make_string_list(host, interp, inc)
            }
            if id = CN_MODEL_GROUP
            {
                if dc <> GDC_MODEL_GROUP
                {
                    set *access: ACCESS_NULL
                    return null
                }
                let cmg def.compiled_model_group()
                if cmg = null
                {
                    set *access: ACCESS_NULL
                    return null
                }
                let mg cmg.model_group
                if mg = null
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                let mgn GroveNode.make_decl(host, GN_MODEL_GROUP, mg as pointer[void], node, 0)
                return ELObj.make_node_singleton(host, mgn)
            }
            if id = CN_OMIT_START_TAG
            {
                ; accessNull unless the declaration carried an omitted-tag
                ; minimization spec at all (OMITTAG NO documents have none).
                if def.omitted_tag_spec() = false
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                if def.can_omit_start_tag()
                    return interp.make_true()
                return interp.make_false()
            }
            if id = CN_OMIT_END_TAG
            {
                if def.omitted_tag_spec() = false
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                if def.can_omit_end_tag()
                    return interp.make_true()
                return interp.make_false()
            }
            return null
        }

        ; --- class attribute-def (ClassDef::attributeDef) -------------------
        if cls = GN_ATTRIBUTE_DEF
        {
            let adef Primitive.att_def_of(node)
            if adef = null
                return null
            if id = CN_NAME
            {
                set *access: ACCESS_OK
                return ELObj.make_string(host, adef.get_name())
            }
            if id = CN_DEFAULT_VALUE
            {
                ; ★ElementTypeAttributeDefNode only — the NOTATION variant's
                ; getDefaultValue is commented out in the reference, so a
                ; notation's attribute definition answers accessNotInClass
                ; (measured).
                let ow node.get_parent()
                if ow = null
                    return null
                if ow.get_class() <> GN_ELEMENT_TYPE
                    return null
                return Primitive.default_value_list(host, node, access)
            }
            ; the remaining three read the DESC (AttributeDefinition::getDesc)
            let desc AttributeDefinitionDesc.make(host)
            adef.get_desc(desc)
            if id = CN_DECL_VALUE_TYPE
            {
                set *access: ACCESS_OK
                let dv desc.declared_value
                if dv = GADV_NAME
                    return Primitive.make_component_name(interp, CN_NAME, want_rcs)
                if dv = GADV_NUMBER
                    return Primitive.make_component_name(interp, CN_NUMBER, want_rcs)
                if dv = GADV_NMTOKEN
                    return Primitive.make_component_name(interp, CN_NMTOKEN, want_rcs)
                if dv = GADV_NUTOKEN
                    return Primitive.make_component_name(interp, CN_NUTOKEN, want_rcs)
                if dv = GADV_ENTITY
                    return Primitive.make_component_name(interp, CN_ENTITY, want_rcs)
                if dv = GADV_IDREF
                    return Primitive.make_component_name(interp, CN_IDREF, want_rcs)
                if dv = GADV_NAMES
                    return Primitive.make_component_name(interp, CN_NAMES, want_rcs)
                if dv = GADV_NUMBERS
                    return Primitive.make_component_name(interp, CN_NUMBERS, want_rcs)
                if dv = GADV_NMTOKENS
                    return Primitive.make_component_name(interp, CN_NMTOKENS, want_rcs)
                if dv = GADV_NUTOKENS
                    return Primitive.make_component_name(interp, CN_NUTOKENS, want_rcs)
                if dv = GADV_ENTITIES
                    return Primitive.make_component_name(interp, CN_ENTITIES, want_rcs)
                if dv = GADV_IDREFS
                    return Primitive.make_component_name(interp, CN_IDREFS, want_rcs)
                if dv = GADV_ID
                    return Primitive.make_component_name(interp, CN_ID, want_rcs)
                if dv = GADV_NOTATION
                    return Primitive.make_component_name(interp, CN_NOTATION, want_rcs)
                if dv = GADV_NAMETOKENGROUP
                    return Primitive.make_component_name(interp, CN_NMTKGRP, want_rcs)
                return Primitive.make_component_name(interp, CN_CDATA, want_rcs)
            }
            if id = CN_DEFAULT_VALUE_TYPE
            {
                set *access: ACCESS_OK
                let dvt desc.default_value_type
                if dvt = GDVT_CURRENT
                    return Primitive.make_component_name(interp, CN_CURRENT, want_rcs)
                if dvt = GDVT_IMPLIED
                    return Primitive.make_component_name(interp, CN_IMPLIED, want_rcs)
                if dvt = GDVT_CONREF
                    return Primitive.make_component_name(interp, CN_CONREF, want_rcs)
                if dvt = GDVT_DEFAULTED
                    return Primitive.make_component_name(interp, CN_VALUE, want_rcs)
                if dvt = GDVT_FIXED
                    return Primitive.make_component_name(interp, CN_FIXED, want_rcs)
                return Primitive.make_component_name(interp, CN_REQUIRED, want_rcs)
            }
            if id = CN_TOKENS
            {
                ; AttributeDefNode::getTokens — the allowed values of a NOTATION
                ; or name-token-group declared value, accessNull for every other.
                ; ★DOCUMENTED DEVIATION: the reference builds its GroveStrings
                ; from this LOCAL desc and returns them, so it prints freed
                ; memory (measured: unstable garbage, differing per run). We
                ; answer the actual tokens.
                let dv2 desc.declared_value
                var is_group false
                if dv2 = GADV_NOTATION
                    set is_group: true
                if dv2 = GADV_NAMETOKENGROUP
                    set is_group: true
                if is_group = false
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                let toks Array[StringC]^host()
                let av0 desc.allowed_values
                if av0 <> null
                {
                    let na av0.get_length()
                    let ab av0.get_buffer()
                    var ai: size_t 0
                    while ai < na
                    {
                        let t0 *(ab + ai)
                        toks.add(t0)
                        set ai: ai + (1 as size_t)
                    }
                }
                return Primitive.make_string_list(host, interp, toks)
            }
            if id = CN_CURRENT_ATTRIBUTE_INDEX
            {
                if desc.default_value_type <> GDVT_CURRENT
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                return ELObj.make_integer(host, desc.current_index as int)
            }
            if id = CN_CURRENT_GROUP
            {
                if desc.default_value_type <> GDVT_CURRENT
                {
                    set *access: ACCESS_NULL
                    return null
                }
                let ow2 node.get_parent()
                if ow2 = null
                    return null
                set *access: ACCESS_OK
                if ow2.get_class() <> GN_ELEMENT_TYPE
                {
                    ; NotationAttributeDefNode::getCurrentGroup — a
                    ; SiblingNodeList over ITSELF (notation attribute
                    ; definitions never share a current group).
                    let self_arr Array[pointer[GroveNode]]^host()
                    self_arr.add(node)
                    return ELObj.make_node_list(host, self_arr, 0)
                }
                let cg Primitive.current_group_nodes(host, interp, node, desc.current_index)
                return ELObj.make_node_list(host, cg, 0)
            }
            return null
        }

        ; --- class model-group (ClassDef::modelGroup) -----------------------
        if cls = GN_MODEL_GROUP
        {
            let mgd node.get_decl() as pointer[CmNode]
            if mgd = null
                return null
            if id = CN_CONNECTOR
            {
                set *access: ACCESS_OK
                let cn0 mgd.connector
                if cn0 = GCONN_AND
                    return Primitive.make_component_name(interp, CN_AND, want_rcs)
                if cn0 = GCONN_OR
                    return Primitive.make_component_name(interp, CN_OR, want_rcs)
                return Primitive.make_component_name(interp, CN_SEQ, want_rcs)
            }
            if id = CN_CONTENT_TOKENS
            {
                set *access: ACCESS_OK
                let cts Primitive.content_token_nodes(host, node)
                return ELObj.make_node_list(host, cts, 0)
            }
            ; ★`occurence-indicator` is NOT a property: getOccurIndicator exists
            ; on the class but Node::property has no case for the id (it is one
            ; of the 39 component names that are not properties), so the
            ; reference answers accessNotInClass — measured, and left as the
            ; default here.
            return null
        }

        ; --- class element-token (ClassDef::elementToken) -------------------
        if cls = GN_ELEMENT_TOKEN
        {
            if id = CN_GI
            {
                let leaf node.get_decl() as pointer[CmNode]
                if leaf = null
                    return null
                let let0 leaf.element
                if let0 = null
                    return null
                set *access: ACCESS_OK
                return ELObj.make_string(host, let0.get_name())
            }
            return null
        }

        ; --- class pcdata-token / sgml-constants: no properties of their own -
        if cls = GN_PCDATA_TOKEN
            return null
        if cls = GN_SGML_CONSTANTS
            return null

        null
    }

    ; Node::property (grove/Node.cxx:465) — the property VALUE of a node, with
    ; the access result out of band. The reference dispatches an id through one
    ; switch onto per-class virtual getX accessors that default to
    ; accessNotInClass; here the same shape is one id chain for the eleven
    ; INTRINSIC_PROPS (which every class carries) plus a per-class block, the
    ; declaration classes' blocks living in decl_property_value above.
    ;
    ; UNPORTED, and therefore accessNotInClass where the reference answers:
    ; `messages`/`severity` (the message class), `subdocument`/`external-data`
    ; (the entity-reference classes) and the address/HyTime properties — the
    ; remaining items of COMPLETENESS.md's property list. Note that
    ; `all-property-names` LISTS every property a class declares, exactly as the
    ; reference does: it answers from the ClassDef table, which is a statement
    ; about the class, not about what is implemented.
    function node_property_value(host: pointer[Page], interp: pointer[Interpreter], node: pointer[GroveNode], id: int, want_rcs: bool, access: pointer[int]) returns pointer[ELObj]
    {
        set *access: ACCESS_NOT_IN_CLASS
        let cls node.get_class()

        ; --- INTRINSIC_PROPS (grove/Node.cxx:1148) -------------------------
        if id = CN_CLASS_NAME
        {
            set *access: ACCESS_OK
            return Primitive.make_component_name(interp, GroveClassDef.class_name(cls), want_rcs)
        }
        if id = CN_CHILDREN_PROPERTY_NAME
            return Primitive.component_name_or_null(interp, GroveClassDef.children_property_name(cls), want_rcs, access)
        if id = CN_DATA_PROPERTY_NAME
            return Primitive.component_name_or_null(interp, GroveClassDef.data_property_name(cls), want_rcs, access)
        if id = CN_DATA_SEP_PROPERTY_NAME
            return Primitive.component_name_or_null(interp, GroveClassDef.data_sep_property_name(cls), want_rcs, access)
        if id = CN_SUBNODE_PROPERTY_NAMES
        {
            set *access: ACCESS_OK
            let ids Array[int]^host()
            GroveClassDef.subnode_property_names(cls, ids)
            return Primitive.make_component_name_list(host, interp, ids, want_rcs)
        }
        if id = CN_ALL_PROPERTY_NAMES
        {
            set *access: ACCESS_OK
            let ids Array[int]^host()
            GroveClassDef.all_property_names(cls, ids)
            return Primitive.make_component_name_list(host, interp, ids, want_rcs)
        }
        if id = CN_GROVE_ROOT
        {
            ; BaseNode::getGroveRoot — STRUCTURAL: it must reach the
            ; sgml-document node, which is exactly what the parent axis hides
            ; (and which a declaration node reaches over its owner chain).
            set *access: ACCESS_OK
            let gr Primitive.grove_root_of(node)
            return ELObj.make_node_singleton(host, gr)
        }
        if id = CN_TREE_ROOT
        {
            ; ChunkNode::getTreeRoot + Node::getTreeRoot (grove/Node.cxx:49):
            ; climb the parent AXIS and return the last node — NEVER accessNull.
            ; A deep node yields the document element; the document element, a
            ; prolog/epilog PI and the sgml-document node yield THEMSELVES
            ; (their axis parent fails at once). The reference's fast path
            ; (`origin != root && !root->epilog && root->documentElement` ->
            ; documentElement) is this walk's result in every case, the epilog
            ; guard included, so the walk alone is faithful.
            set *access: ACCESS_OK
            var cur node
            var cp cur.get_axis_parent()
            while cp <> null
            {
                set cur: cp
                set cp: cur.get_axis_parent()
            }
            return ELObj.make_node_singleton(host, cur)
        }
        if id = CN_ORIGIN
        {
            ; the DECLARATION classes: the OWNER node is the origin for all of
            ; them except two measured specials — an ATTRIBUTE-DEF's origin is
            ; another attribute-def (AttributeDefNode::getOrigin goes through
            ; makeOriginNode, which rebuilds the SAME node), and a defaulted
            ; ENTITY's origin is the grove root, not its doctype
            ; (EntityNode::getOrigin, :4281).
            if node.is_decl_class()
            {
                set *access: ACCESS_OK
                if cls = GN_ATTRIBUTE_DEF
                    return ELObj.make_node_singleton(host, node)
                if cls = GN_ENTITY
                {
                    let ent1 node.get_decl() as pointer[Entity]
                    if Primitive.entity_is_grove_defaulted(node, ent1)
                    {
                        let rt Primitive.grove_root_of(node)
                        return ELObj.make_node_singleton(host, rt)
                    }
                }
                let own node.get_parent()
                if own = null
                {
                    set *access: ACCESS_NULL
                    return null
                }
                return ELObj.make_node_singleton(host, own)
            }
            ; ChunkNode::getOrigin — STRUCTURAL by definition (no root check);
            ; the reference's own comment on getParent says the prolog PIs and
            ; the document element "do have an origin".
            let p node.get_parent()
            if p = null
                set *access: ACCESS_NULL
            else
            {
                set *access: ACCESS_OK
                return ELObj.make_node_singleton(host, p)
            }
            return null
        }
        if id = CN_PARENT
        {
            ; the PARENT AXIS (ChunkNode::getParent): accessNull for every node
            ; whose origin is the grove root, so the document element and the
            ; prolog/epilog PIs have no parent.
            let p node.get_axis_parent()
            if p = null
                set *access: ACCESS_NULL
            else
            {
                set *access: ACCESS_OK
                return ELObj.make_node_singleton(host, p)
            }
            return null
        }
        if id = CN_ORIGIN_TO_SUBNODE_REL_PROPERTY_NAME
        {
            ; the DECLARATION classes each override it with a constant, except
            ; the two that are two-valued: an ENTITY names `defaulted-entities`
            ; when it is a grove-registered defaulted one (EntityNode::
            ; getOriginToSubnodeRelPropertyName) and a MODEL GROUP names
            ; `model-group` at the top of a content model, `content-tokens`
            ; inside one (ModelGroupNode::…, :5640).
            if node.is_decl_class()
            {
                set *access: ACCESS_OK
                if cls = GN_DOCUMENT_TYPE
                    return Primitive.make_component_name(interp, CN_DOCTYPES_AND_LINKTYPES, want_rcs)
                if cls = GN_ENTITY
                {
                    let ent0 node.get_decl() as pointer[Entity]
                    if Primitive.entity_is_grove_defaulted(node, ent0)
                        return Primitive.make_component_name(interp, CN_DEFAULTED_ENTITIES, want_rcs)
                    return Primitive.make_component_name(interp, CN_GENERAL_ENTITIES, want_rcs)
                }
                if cls = GN_DEFAULT_ENTITY
                    return Primitive.make_component_name(interp, CN_DEFAULT_ENTITY, want_rcs)
                if cls = GN_NOTATION
                    return Primitive.make_component_name(interp, CN_NOTATIONS, want_rcs)
                if cls = GN_EXTERNAL_ID
                    return Primitive.make_component_name(interp, CN_EXTERNAL_ID, want_rcs)
                if cls = GN_ELEMENT_TYPE
                    return Primitive.make_component_name(interp, CN_ELEMENT_TYPES, want_rcs)
                if cls = GN_ATTRIBUTE_DEF
                    return Primitive.make_component_name(interp, CN_ATTRIBUTE_DEFS, want_rcs)
                if cls = GN_SGML_CONSTANTS
                    return Primitive.make_component_name(interp, CN_SGML_CONSTANTS, want_rcs)
                if cls = GN_MODEL_GROUP
                {
                    let up node.get_parent()
                    if up <> null
                    {
                        if up.get_class() = GN_ELEMENT_TYPE
                            return Primitive.make_component_name(interp, CN_MODEL_GROUP, want_rcs)
                    }
                    return Primitive.make_component_name(interp, CN_CONTENT_TOKENS, want_rcs)
                }
                return Primitive.make_component_name(interp, CN_CONTENT_TOKENS, want_rcs)
            }
            ; the attribute classes override it with a constant: an assignment
            ; is reached through its origin's `attributes`, a value token through
            ; its assignment's `value` (both are inline overrides in
            ; GroveBuilder.cxx's class declarations).
            if cls = GN_ATTR_ASSIGN
            {
                set *access: ACCESS_OK
                return Primitive.make_component_name(interp, CN_ATTRIBUTES, want_rcs)
            }
            if cls = GN_ATTR_TOKEN
            {
                set *access: ACCESS_OK
                return Primitive.make_component_name(interp, CN_VALUE, want_rcs)
            }
            ; ChunkNode::getOriginToSubnodeRelPropertyName (:5010): `content`
            ; unless the origin IS the grove root, where it names WHICH of the
            ; sgml-document node's three subnode properties holds this node —
            ; document-element, prolog or epilog. The sgml-document node itself
            ; overrides the property to accessNull. rsiblings reads this and
            ; then that property of the origin, so the three-way answer is what
            ; keeps a prolog PI's rsiblings out of the document element.
            let p node.get_parent()
            if p = null
            {
                set *access: ACCESS_NULL
                return null
            }
            set *access: ACCESS_OK
            if p.get_class() <> GN_DOCUMENT
                return Primitive.make_component_name(interp, CN_CONTENT, want_rcs)
            let di p.document_element_index()
            let mi node.index_in_parent()
            if mi = di
                return Primitive.make_component_name(interp, CN_DOCUMENT_ELEMENT, want_rcs)
            if mi < di
                return Primitive.make_component_name(interp, CN_PROLOG, want_rcs)
            if di < 0
                return Primitive.make_component_name(interp, CN_PROLOG, want_rcs)
            return Primitive.make_component_name(interp, CN_EPILOG, want_rcs)
        }

        ; --- class element (ClassDef::element) -----------------------------
        if cls = GN_ELEMENT
        {
            if id = CN_GI
            {
                set *access: ACCESS_OK
                return ELObj.make_string(host, node.get_gi())
            }
            if id = CN_ID
            {
                ; ElementNode::getId — accessNull without an ID attribute.
                let v node.id_value()
                if v.get_size() = (0 as size_t)
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                return ELObj.make_string(host, v)
            }
            if id = CN_CONTENT
            {
                ; ElementNode::getContent == children(): accessOK even for an
                ; EMPTY element (an empty node-list, never accessNull), and
                ; character-EXPANDED like the children axis.
                set *access: ACCESS_OK
                let arr Array[pointer[GroveNode]]^host()
                let m node.child_count()
                var i 0
                while i < m
                {
                    arr.add(node.child_at(i))
                    set i: i + 1
                }
                return ELObj.make_node_list_expanded(host, arr, 0)
            }
            if id = CN_INCLUDED
            {
                set *access: ACCESS_OK
                if node.get_included()
                    return interp.make_true()
                return interp.make_false()
            }
            if id = CN_MUST_OMIT_END_TAG
            {
                set *access: ACCESS_OK
                if node.get_must_omit_end_tag()
                    return interp.make_true()
                return interp.make_false()
            }
            if id = CN_ATTRIBUTES
            {
                ; ElementNode::getAttributes — the NAMED node list of every
                ; DECLARED attribute in declaration order (accessOK even for an
                ; element without any: an empty list, like `content`).
                set *access: ACCESS_OK
                return Primitive.make_attributes_list(host, node)
            }
            if id = CN_ELEMENT_TYPE
            {
                ; ElementNode::getElementType — the chunk's ElementType, which
                ; this port re-derives by GI from the governing DTD rather than
                ; keeping a pointer on every element node (the lookup returns the
                ; same object, so node identity is unaffected; the memory of one
                ; pointer per grove node is not worth it).
                let d0 GroveInfo.dtd_of(node)
                if d0 = null
                {
                    set *access: ACCESS_NULL
                    return null
                }
                let dtd0 d0 as pointer[Dtd]
                let et0 dtd0.lookup_element_type(node.get_gi())
                if et0 = null
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                let dtn Primitive.doctype_node(host, node)
                let etn GroveNode.make_decl(host, GN_ELEMENT_TYPE, et0 as pointer[void], dtn, 0)
                return ELObj.make_node_singleton(host, etn)
            }
            return null
        }

        ; --- class attribute-assignment (ClassDef::attributeAssignment) ----
        if cls = GN_ATTR_ASSIGN
        {
            if id = CN_NAME
            {
                set *access: ACCESS_OK
                return ELObj.make_string(host, node.assign_name())
            }
            if id = CN_IMPLIED
            {
                var ok false
                let implied node.assign_implied(&ok)
                if ok = false
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                if implied
                    return interp.make_true()
                return interp.make_false()
            }
            if id = CN_TOKEN_SEP
            {
                var ok false
                let ch node.assign_token_sep(&ok)
                if ok = false
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                return ELObj.make_char(host, ch)
            }
            if id = CN_VALUE
            {
                ; AttributeAsgnNode::getValue == children(): accessNull only
                ; when there is NO value (implied) — an empty CDATA value is an
                ; empty node-list, accessOK.
                let av node.assign_value()
                if av = null
                {
                    set *access: ACCESS_NULL
                    return null
                }
                if av.get_text() = null
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                return Primitive.axis_children_list(host, node)
            }
            if id = CN_ATTRIBUTE_DEF
            {
                ; ★measured: the reference LISTS attribute-def among the class's
                ; properties but answers accessNotInClass for an element's (and
                ; an entity's) assignment — ElementAttributeOrigin does not
                ; implement makeAttributeDefNode. Left as the default.
                return null
            }
            return null
        }

        ; --- class attribute-value-token (ClassDef::attributeValueToken) ---
        if cls = GN_ATTR_TOKEN
        {
            if id = CN_TOKEN
            {
                set *access: ACCESS_OK
                return ELObj.make_string(host, node.get_chars())
            }
            if id = CN_ENTITY
            {
                ; AttributeValueTokenNode::getEntity — only for an ENTITY /
                ; ENTITIES declared value, and only if the name resolves in the
                ; governing DTD.
                let atts node.get_attributes()
                if atts = null
                {
                    set *access: ACCESS_NULL
                    return null
                }
                if atts.entity(node.get_char_index() as size_t) = false
                {
                    set *access: ACCESS_NULL
                    return null
                }
                let ename node.get_chars()
                let ent Primitive.grove_entity(node, ename)
                if ent = null
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                let edt Primitive.doctype_node(host, node)
                let enode Primitive.entity_node(host, GN_ENTITY, ent, edt)
                return ELObj.make_node_singleton(host, enode)
            }
            if id = CN_NOTATION
            {
                let atts node.get_attributes()
                if atts = null
                {
                    set *access: ACCESS_NULL
                    return null
                }
                if atts.notation(node.get_char_index() as size_t) = false
                {
                    set *access: ACCESS_NULL
                    return null
                }
                let nname node.get_chars()
                let ntn Primitive.grove_notation(node, nname)
                if ntn = null
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                let ndt Primitive.doctype_node(host, node)
                let nnode GroveNode.make_decl(host, GN_NOTATION, ntn as pointer[void], ndt, 0)
                return ELObj.make_node_singleton(host, nnode)
            }
            if id = CN_REFERENT
            {
                ; AttributeValueTokenNode::getReferent — an IDREF/IDREFS token
                ; that HITS the grove's element-by-id index; accessNull else.
                let atts node.get_attributes()
                if atts = null
                {
                    set *access: ACCESS_NULL
                    return null
                }
                if atts.idref(node.get_char_index() as size_t) = false
                {
                    set *access: ACCESS_NULL
                    return null
                }
                let refid node.get_chars()
                let target GroveBuilder.element_by_id(host, node, refid)
                if target = null
                {
                    set *access: ACCESS_NULL
                    return null
                }
                set *access: ACCESS_OK
                return ELObj.make_node_singleton(host, target)
            }
            return null
        }

        ; --- the DECLARATION classes ---------------------------------------
        ; Split off into its own function, which is also the reference's shape
        ; (Node::property dispatches onto per-class virtuals) — and necessary:
        ; a single function holding every class's block overflows the planner's
        ; per-statement recursion.
        if node.is_decl_class()
            return Primitive.decl_property_value(host, interp, node, id, want_rcs, access)

        ; --- class data-char (ClassDef::dataChar) --------------------------
        if cls = GN_DATA
        {
            if id = CN_CHAR
            {
                ; DataNode::getChar via charChunk — this view's character.
                set *access: ACCESS_OK
                return ELObj.make_char(host, node.view_char())
            }
            return null
        }

        ; --- class pi (ClassDef::pi) ---------------------------------------
        if cls = GN_PI
        {
            if id = CN_SYSTEM_DATA
            {
                ; PiNode::getSystemData — the instruction's data; for a PI
                ; ENTITY reference (PiEntityNode) the entity's replacement
                ; text. Both live in the node's chars.
                set *access: ACCESS_OK
                return ELObj.make_string(host, node.get_chars())
            }
            if id = CN_ENTITY_NAME
                return Primitive.entity_ref_name(host, node, access)
            if id = CN_ENTITY
                return Primitive.entity_ref_node_value(host, interp, node, access)
            return null
        }

        ; --- the ENTITY-REFERENCE classes ----------------------------------
        ; sdata / external-data / subdocument: EntityRefNode's two accessors,
        ; plus sdata's own system-data and char.
        if cls = GN_SDATA
        {
            if id = CN_SYSTEM_DATA
            {
                ; SdataNode::getSystemData (:3474) — the entity's replacement
                ; text, NOT the character it maps to.
                set *access: ACCESS_OK
                return ELObj.make_string(host, node.get_chars())
            }
            if id = CN_CHAR
            {
                ; SdataNode::charChunk (:3461) through Interpreter::sdataMap,
                ; which never fails.
                set *access: ACCESS_OK
                return ELObj.make_char(host, Primitive.sdata_char(interp, node))
            }
            if id = CN_ENTITY_NAME
                return Primitive.entity_ref_name(host, node, access)
            if id = CN_ENTITY
                return Primitive.entity_ref_node_value(host, interp, node, access)
            return null
        }
        if (cls = GN_EXTERNAL_DATA) or (cls = GN_SUBDOC)
        {
            if id = CN_ENTITY_NAME
                return Primitive.entity_ref_name(host, node, access)
            if id = CN_ENTITY
                return Primitive.entity_ref_node_value(host, interp, node, access)
            return null
        }
        if cls = GN_NONSGML
        {
            ; ★The non-sgml class declares NOTHING (ClassDef::nonSgml is the
            ; reference's FIXME table), so every named property is
            ; accessNotInClass — except `char`, which Node::property answers
            ; through getChar/charChunk for ANY class, and NonSgmlNode::charChunk
            ; (:3510) returns accessNull. Measured, not guessed.
            if id = CN_CHAR
            {
                set *access: ACCESS_NULL
                return null
            }
            return null
        }

        ; --- class sgml-document (ClassDef::sgmlDocument) ------------------
        if cls <> GN_DOCUMENT
            return null
        if id = CN_DOCUMENT_ELEMENT
        {
            ; SgmlDocumentNode::getDocumentElement — the sole element child;
            ; an invalid document without one is a null access.
            let di node.document_element_index()
            if di < 0
                return null
            set *access: ACCESS_OK
            return ELObj.make_node_singleton(host, node.child_at(di))
        }
        if id = CN_PROLOG
        {
            ; SgmlDocumentNode::getProlog / getEpilog: the sibling group before
            ; / after the document element, accessOK with an EMPTY list when
            ; there is none. NOT character-expanded — only PIs live there.
            set *access: ACCESS_OK
            return Primitive.document_child_range(host, node, 0, node.prolog_end())
        }
        if id = CN_EPILOG
        {
            set *access: ACCESS_OK
            return Primitive.document_child_range(host, node, node.epilog_begin(), node.child_count())
        }
        if id = CN_SGML_CONSTANTS
        {
            ; SgmlDocumentNode::getSgmlConstants — always a node, of a class with
            ; no properties at all (ClassDef::sgmlConstants is noProps twice).
            set *access: ACCESS_OK
            let sc GroveNode.make_decl(host, GN_SGML_CONSTANTS, null as pointer[void], node, 0)
            return ELObj.make_node_singleton(host, sc)
        }
        if id = CN_APPLICATION_INFO
        {
            ; SgmlDocumentNode::getApplicationInfo — the SGML declaration's
            ; APPINFO literal; accessNull under APPINFO NONE (no event, so the
            ; grove cell stays empty).
            let ai GroveInfo.appinfo_of(node)
            if ai = null
            {
                set *access: ACCESS_NULL
                return null
            }
            set *access: ACCESS_OK
            return ELObj.make_string(host, *ai)
        }
        if id = CN_GOVERNING_DOCTYPE
        {
            let dt2 Primitive.doctype_node(host, node)
            if dt2 = null
            {
                set *access: ACCESS_NULL
                return null
            }
            set *access: ACCESS_OK
            return ELObj.make_node_singleton(host, dt2)
        }
        if id = CN_DOCTYPES_AND_LINKTYPES
        {
            ; DoctypesAndLinktypesNamedNodeList — a one-member list over the
            ; governing DTD (LINK types are the unported LPD axis, and the
            ; reference lists none either without an active LPD).
            let dt3 Primitive.doctype_node(host, node)
            if dt3 = null
            {
                set *access: ACCESS_NULL
                return null
            }
            set *access: ACCESS_OK
            let darr Array[pointer[GroveNode]]^host()
            darr.add(dt3)
            return ELObj.make_named_node_list(host, darr, NNL_DOCTYPES_AND_LINKTYPES)
        }
        if id = CN_ELEMENTS
        {
            ; SgmlDocumentNode::getElements — ElementsNamedNodeList over the
            ; elements that have an ID, in DOCUMENT order (ElementsNodeList walks
            ; the chunk chain testing Chunk::id), named by their ID VALUE. That
            ; is exactly the grove's id index. accessNull without a document
            ; element or a general subst table.
            let idx GroveInfo.id_index_of(node)
            if idx = null
            {
                set *access: ACCESS_NULL
                return null
            }
            if node.document_element_index() < 0
            {
                set *access: ACCESS_NULL
                return null
            }
            set *access: ACCESS_OK
            let earr Array[pointer[GroveNode]]^host()
            let ne idx.get_length()
            let ebuf idx.get_buffer()
            var ei: size_t 0
            while ei < ne
            {
                let ent2 *(ebuf + ei)
                if ent2 <> null
                {
                    let en ent2.get_node()
                    if en <> null
                        earr.add(en)
                }
                set ei: ei + (1 as size_t)
            }
            return ELObj.make_named_node_list(host, earr, NNL_ELEMENTS)
        }
        if id = CN_ENTITIES
        {
            let el Primitive.doc_entities_list(host, interp, node)
            if el = null
            {
                set *access: ACCESS_NULL
                return null
            }
            set *access: ACCESS_OK
            return el
        }
        if id = CN_DEFAULTED_ENTITIES
        {
            ; DefaultedEntitiesNamedNodeList — the grove's own table (always
            ; accessOK once the parse is complete, empty when nothing defaulted).
            let dt4 Primitive.doctype_node(host, node)
            set *access: ACCESS_OK
            let darr2 Primitive.defaulted_entity_nodes(host, dt4)
            return ELObj.make_named_node_list(host, darr2, NNL_ENTITIES)
        }
        null
    }

    ; a half-open range of the sgml-document node's structural children as a
    ; node-list (the prolog / epilog sibling groups).
    function document_child_range(host: pointer[Page], node: pointer[GroveNode], from: int, to: int) returns pointer[ELObj]
    {
        let arr Array[pointer[GroveNode]]^host()
        var i from
        while i < to
        {
            arr.add(node.child_at(i))
            set i: i + 1
        }
        ELObj.make_node_list(host, arr, 0)
    }

    ; ELObjPropertyValue::set(ComponentName::Id) — a component name is a SYMBOL
    ; whose spelling the rcs? flag selects (short RCS vs long SDQL name).
    function make_component_name(interp: pointer[Interpreter], id: int, want_rcs: bool) returns pointer[ELObj]
    {
        let nm interp.component_name(id, want_rcs)
        interp.make_symbol(nm)
    }

    ; getChildrenPropertyName / getDataPropertyName / getDataSepPropertyName:
    ; the ClassDef slot, accessNull when it holds ComponentName::noId.
    function component_name_or_null(interp: pointer[Interpreter], id: int, want_rcs: bool, access: pointer[int]) returns pointer[ELObj]
    {
        if id = CN_NO_ID
        {
            set *access: ACCESS_NULL
            return null
        }
        set *access: ACCESS_OK
        Primitive.make_component_name(interp, id, want_rcs)
    }

    ; ELObjPropertyValue::set(const ComponentName::Id *) — a proper LIST of
    ; component-name symbols, built back to front onto nil.
    function make_component_name_list(host: pointer[Page], interp: pointer[Interpreter], ids: pointer[Array[int]], want_rcs: bool) returns pointer[ELObj]
    {
        var result interp.make_nil()
        var i ids.get_length() as int
        while i > 0
        {
            set i: i - 1
            let cid *(ids.get_buffer() + (i as size_t))
            let sym Primitive.make_component_name(interp, cid, want_rcs)
            set result: ELObj.make_pair(host, sym, result)
        }
        result
    }

    ; node-list-reverse: the members in reverse order. NodeListObj::
    ; nodeListReverse (the lazy ReverseNodeListObj), eagerly.
    function node_list_reverse_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, nl)
        let result Array[pointer[GroveNode]]^host()
        var i nl.node_list_count() - 1
        while i >= 0
        {
            let node nl.node_list_node(i)
            if node <> null
                result.add(node)
            set i: i - 1
        }
        ELObj.make_node_list(host, result, 0)
    }

    ; nodeData (style/primitive.cxx:4070) recurses through firstChild, so this
    ; is the children AXIS: `(data <sgml-document node>)` is the empty string.
    ; `nodeData` (style/primitive.cxx:4070) in its exact order: charChunk, then
    ; ★`tokens` — an ATTRIBUTE ASSIGNMENT with a tokenized value contributes the
    ; whole value STRING, separators included, which is why `(data <assignment>)`
    ; reads "ONE TWO" and not "ONETWO" — then the children, and last `getToken`
    ; for a value token reached on its own.
    function collect_data_len(interp: pointer[Interpreter], node: pointer[GroveNode]) returns size_t
    {
        if node = null
            return 0 as size_t
        if node.get_class() = GN_DATA
        {
            let c node.get_chars()
            return c.get_size()
        }
        if node.get_class() = GN_ATTR_ASSIGN
        {
            var ok false
            let t node.assign_tokens(&ok)
            if ok
                return t.get_size()
        }
        if node.get_class() = GN_ATTR_TOKEN
        {
            let c node.get_chars()
            return c.get_size()
        }
        ; an sdata node's data is its MAPPED character — one, always (its
        ; replacement text is only `system-data`). external-data, subdocument
        ; and non-sgml contribute nothing: their charChunk is not accessOK and
        ; they have no children.
        if node.get_class() = GN_SDATA
            return 1 as size_t
        var total: size_t 0
        let n node.axis_child_count()
        var i 0
        while i < n
        {
            let ch node.axis_child_at(i)
            set total: total + Primitive.collect_data_len(interp, ch)
            set i: i + 1
        }
        total
    }

    ; sosofo-append: an append sosofo whose parts are the argument sosofos
    ; themselves (AppendSosofoObj holds the sosofos; process() walks them in
    ; order). Args are added directly — NOT flattened by their inner parts:
    ; a literal / process-children sosofo has no parts, so flattening would
    ; drop it.
    function sosofo_append(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let parts Array[pointer[ELObj]]^host()
        var i 0
        while i < n_args
        {
            let a *(args + i)
            if a.is_sosofo_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASosofo(), name, i, a)
            parts.add(a)
            set i: i + 1
        }
        ELObj.make_sosofo(host, parts)
    }

    ; --- display-space / inline-space / color (primitive.cxx + Style.cxx) ---

    ; the strict boolean of the keyword args (#t/#f identity — see
    ; convertBooleanC's trap).
    function strict_bool(val: pointer[ELObj], out: pointer[bool]) returns bool
    {
        if val.is_false()
        {
            set *out: false
            return true
        }
        if val.is_boolean_p()
        {
            set *out: true
            return true
        }
        false
    }

    function invalid_key_arg(interp: pointer[Interpreter], loc: Location, kname: StringC) returns pointer[ELObj]
    {
        interp.set_next_location(loc)
        interp.message1(InterpreterMessages.invalidKeyArg(), kname)
        interp.make_error()
    }

    ; DEFPRIMITIVE(DisplaySpace): nominal from arg 0, keyword args scanned
    ; BACKWARDS (first specified wins); odd trailing args -> oddKeyArgs.
    function display_space_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        var nominal LengthSpec()
        if Convert.convert_length_spec(a0, &nominal) = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notALengthSpec(), name, 0, a0)
        let ds DisplaySpace.make(host)
        set ds.nominal: nominal
        set ds.min: nominal
        set ds.max: nominal
        var i n_args - 1
        while i > 0
        {
            if (n_args & 1) = 0
                return Primitive.simple_error(interp, loc, InterpreterMessages.oddKeyArgs())
            let kobj *(args + (i - 1))
            if kobj.is_keyword_p() = false
                return Primitive.simple_error(interp, loc, InterpreterMessages.keyArgsNotKey())
            let kident kobj.keyword_ident()
            let a *(args + i)
            if kident.is_syntactic_key() = false
                return Primitive.invalid_key_arg(interp, loc, kident.get_name())
            let sk kident.syntactic_key()
            if sk = SK_MIN
            {
                var ls LengthSpec()
                if Convert.convert_length_spec(a, &ls) = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notALengthSpec(), name, i, a)
                set ds.min: ls
            }
            else if sk = SK_MAX
            {
                var ls LengthSpec()
                if Convert.convert_length_spec(a, &ls) = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notALengthSpec(), name, i, a)
                set ds.max: ls
            }
            else if sk = SK_IS_CONDITIONAL
            {
                var b false
                if Primitive.strict_bool(a, &b) = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notABoolean(), name, i, a)
                set ds.conditional: b
            }
            else if sk = SK_PRIORITY
            {
                if a.is_integer_p()
                {
                    set ds.priority: a.exact_integer_value()
                    set ds.force: false
                }
                else
                {
                    var is_force false
                    if a.is_symbol_p()
                    {
                        if a.symbol_c_value() = SYM_FORCE
                            set is_force: true
                    }
                    if is_force = false
                        return Primitive.arg_error(interp, loc, InterpreterMessages.notAPriority(), name, i, a)
                    set ds.force: true
                }
            }
            else
                return Primitive.invalid_key_arg(interp, loc, kident.get_name())
            set i: i - 2
        }
        ELObj.make_display_space(host, ds as pointer[void])
    }

    ; DEFPRIMITIVE(InlineSpace): like display-space with min:/max: only.
    function inline_space_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        var nominal LengthSpec()
        if Convert.convert_length_spec(a0, &nominal) = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notALengthSpec(), name, 0, a0)
        let sp InlineSpace.make(host)
        set sp.nominal: nominal
        set sp.min: nominal
        set sp.max: nominal
        var i n_args - 1
        while i > 0
        {
            if (n_args & 1) = 0
                return Primitive.simple_error(interp, loc, InterpreterMessages.oddKeyArgs())
            let kobj *(args + (i - 1))
            if kobj.is_keyword_p() = false
                return Primitive.simple_error(interp, loc, InterpreterMessages.keyArgsNotKey())
            let kident kobj.keyword_ident()
            let a *(args + i)
            if kident.is_syntactic_key() = false
                return Primitive.invalid_key_arg(interp, loc, kident.get_name())
            let sk kident.syntactic_key()
            if sk = SK_MIN
            {
                var ls LengthSpec()
                if Convert.convert_length_spec(a, &ls) = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notALengthSpec(), name, i, a)
                set sp.min: ls
            }
            else if sk = SK_MAX
            {
                var ls LengthSpec()
                if Convert.convert_length_spec(a, &ls) = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notALengthSpec(), name, i, a)
                set sp.max: ls
            }
            else
                return Primitive.invalid_key_arg(interp, loc, kident.get_name())
            set i: i - 2
        }
        ELObj.make_inline_space(host, sp as pointer[void])
    }

    ; --- color spaces (DEFPRIMITIVE(ColorSpace) + Style.cxx makeColor) ------

    function color_space_message(interp: pointer[Interpreter], loc: Location, mt: MessageType, sname: pointer[const_char]) returns pointer[ELObj]
    {
        interp.set_next_location(loc)
        interp.message1(mt, StringC(sname))
        interp.make_error()
    }

    ; ascii compare of str[from..from+len) against a literal of exactly len.
    function str_part_is(s: StringC, from: size_t, lit: pointer[const_char]) returns bool
    {
        let n s.get_size()
        var i: size_t 0
        while true
        {
            let b *((lit as pointer[u8]) + i)
            if b = (0 as u8)
                break
            if (from + i) >= n
                return false
            if s.get(from + i) <> (b as u32)
                return false
            set i: i + 1
        }
        (from + i) = n
    }

    function color_space_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        if a0.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
        let s a0.string_data(host)
        let n s.get_size()
        ; the reference compares the first 43 chars against the family prefix,
        ; then re-reads the tail from char 40 (after "Family::").
        var is_dev false
        var is_cie false
        if n >= (43 as size_t)
        {
            var prefix_ok true
            let fam StringC("ISO/IEC 10179:1996//Color-Space Family::")
            var i: size_t 0
            while i < (40 as size_t)
            {
                if s.get(i) <> fam.get(i)
                    set prefix_ok: false
                set i: i + 1
            }
            if prefix_ok
            {
                if (s.get(40 as size_t) = (0x44 as u32)) and (s.get(41 as size_t) = (0x65 as u32)) and (s.get(42 as size_t) = (0x76 as u32))
                    set is_dev: true
                if (s.get(40 as size_t) = (0x43 as u32)) and (s.get(41 as size_t) = (0x49 as u32)) and (s.get(42 as size_t) = (0x45 as u32))
                    set is_cie: true
            }
        }
        if is_dev
        {
            var kind 0 - 1
            var sname ""
            if Primitive.str_part_is(s, 40 as size_t, "Device RGB")
            {
                set kind: CS_RGB
                set sname: "Device RGB"
            }
            else if Primitive.str_part_is(s, 40 as size_t, "Device Gray")
            {
                set kind: CS_GRAY
                set sname: "Device Gray"
            }
            else if Primitive.str_part_is(s, 40 as size_t, "Device CMYK")
            {
                set kind: CS_CMYK
                set sname: "Device CMYK"
            }
            else if Primitive.str_part_is(s, 40 as size_t, "Device KX")
            {
                set kind: CS_KX
                set sname: "Device KX"
            }
            if kind < 0
            {
                interp.set_next_location(loc)
                interp.message1(InterpreterMessages.unknownColorSpaceFamily(), s)
                return interp.make_error()
            }
            if n_args > 1
                ; message only — the space is still returned (reference).
                Primitive.color_space_message(interp, loc, InterpreterMessages.colorSpaceNoArgs(), sname)
            return ELObj.make_color_space(host, kind, null)
        }
        if is_cie
        {
            var kind 0 - 1
            var sname ""
            if Primitive.str_part_is(s, 40 as size_t, "CIE LUV")
            {
                set kind: CS_LUV
                set sname: "CIE LUV"
            }
            else if Primitive.str_part_is(s, 40 as size_t, "CIE LAB")
            {
                set kind: CS_LAB
                set sname: "CIE LAB"
            }
            else if Primitive.str_part_is(s, 40 as size_t, "CIE Based ABC")
            {
                set kind: CS_ABC
                set sname: "CIE Based ABC"
            }
            else if Primitive.str_part_is(s, 40 as size_t, "CIE Based A")
            {
                set kind: CS_A
                set sname: "CIE Based A"
            }
            if kind >= 0
                return Primitive.make_cie_space(host, interp, kind, sname, args + 1, n_args - 1, loc)
        }
        interp.set_next_location(loc)
        interp.message1(InterpreterMessages.unknownColorSpaceFamily(), s)
        interp.make_error()
    }

    ; decodeNumVector: a list of exactly-readable numbers of length len.
    function decode_num_vector(res: pointer[double], len: int, obj: pointer[ELObj]) returns bool
    {
        var e obj
        var i 0
        while i < len
        {
            if e.is_pair() = false
                return false
            let car e.get_car()
            if car.is_real() = false
                return false
            set *(res + i): car.real_value()
            set e: e.get_cdr()
            set i: i + 1
        }
        true
    }

    function decode_func_vector(res: pointer[pointer[ELObj]], len: int, obj: pointer[ELObj]) returns bool
    {
        var e obj
        var i 0
        while i < len
        {
            if e.is_pair() = false
                return false
            let car e.get_car()
            if car.is_function() = false
                return false
            set *(res + i): car
            set e: e.get_cdr()
            set i: i + 1
        }
        true
    }

    ; decodeKeyArgs: pos[j] = value index (relative to args) of key j, -1 if
    ; absent; first occurrence wins (reverse scan). Messages fire here AND the
    ; caller adds colorSpaceArgError (reference double-message shape).
    function decode_key_args(argc: int, args: pointer[pointer[ELObj]], keys: pointer[int], n_keys: int, interp: pointer[Interpreter], loc: Location, pos: pointer[int]) returns bool
    {
        if (argc & 1) = 1
        {
            interp.set_next_location(loc)
            interp.message0(InterpreterMessages.oddKeyArgs())
            return false
        }
        var j 0
        while j < n_keys
        {
            set *(pos + j): 0 - 1
            set j: j + 1
        }
        var i argc - 1
        while i > 0
        {
            let kobj *(args + (i - 1))
            if kobj.is_keyword_p() = false
            {
                interp.set_next_location(loc)
                interp.message0(InterpreterMessages.keyArgsNotKey())
                return false
            }
            let kident kobj.keyword_ident()
            var found false
            if kident.is_syntactic_key()
            {
                let sk kident.syntactic_key()
                set j: 0
                while j < n_keys
                {
                    if sk = *(keys + j)
                    {
                        set *(pos + j): i
                        set found: true
                    }
                    set j: j + 1
                }
            }
            if found = false
            {
                interp.set_next_location(loc)
                interp.message1(InterpreterMessages.invalidKeyArg(), kident.get_name())
                return false
            }
            set i: i - 2
        }
        true
    }

    ; the CIE space constructors (primitive.cxx ColorSpace + Style.cxx ctors).
    ; keys order: white-point black-point range range-abc range-lmn range-a
    ; matrix-abc matrix-lmn matrix-a decode-abc decode-lmn decode-a.
    function make_cie_space(host: pointer[Page], interp: pointer[Interpreter], kind: int, sname: pointer[const_char], args: pointer[pointer[ELObj]], argc: int, loc: Location) returns pointer[ELObj]
    {
        let keys host.allocate(96, 8) as pointer[int]
        set *keys: SK_WHITE_POINT
        set *(keys + 1): SK_BLACK_POINT
        set *(keys + 2): SK_RANGE
        set *(keys + 3): SK_RANGE_ABC
        set *(keys + 4): SK_RANGE_LMN
        set *(keys + 5): SK_RANGE_A
        set *(keys + 6): SK_MATRIX_ABC
        set *(keys + 7): SK_MATRIX_LMN
        set *(keys + 8): SK_MATRIX_A
        set *(keys + 9): SK_DECODE_ABC
        set *(keys + 10): SK_DECODE_LMN
        set *(keys + 11): SK_DECODE_A
        let pos host.allocate(96, 8) as pointer[int]
        var wp double[3]
        var bp double[3]
        var range double[6]
        var range_abc double[6]
        var range_lmn double[6]
        var range_a double[2]
        var matrix_abc double[9]
        var matrix_lmn double[9]
        var matrix_a double[3]
        var decode_abc pointer[ELObj][3]
        var decode_lmn pointer[ELObj][3]
        var decode_a: pointer[ELObj] null
        var ok Primitive.decode_key_args(argc, args, keys, 12, interp, loc, pos)
        if ok
        {
            if *pos < 0
                set ok: false
        }
        if ok
        {
            if Primitive.decode_num_vector(wp as pointer[double], 3, *(args + *pos)) = false
                set ok: false
        }
        if ok
        {
            if *(pos + 1) >= 0
            {
                if Primitive.decode_num_vector(bp as pointer[double], 3, *(args + *(pos + 1))) = false
                    set ok: false
            }
        }
        if ok
        {
            if *(pos + 2) >= 0
            {
                if Primitive.decode_num_vector(range as pointer[double], 6, *(args + *(pos + 2))) = false
                    set ok: false
            }
        }
        if ok
        {
            if *(pos + 3) >= 0
            {
                if Primitive.decode_num_vector(range_abc as pointer[double], 6, *(args + *(pos + 3))) = false
                    set ok: false
            }
        }
        if ok
        {
            if *(pos + 4) >= 0
            {
                if Primitive.decode_num_vector(range_lmn as pointer[double], 6, *(args + *(pos + 4))) = false
                    set ok: false
            }
        }
        if ok
        {
            if *(pos + 5) >= 0
            {
                if Primitive.decode_num_vector(range_a as pointer[double], 2, *(args + *(pos + 5))) = false
                    set ok: false
            }
        }
        if ok
        {
            if *(pos + 6) >= 0
            {
                if Primitive.decode_num_vector(matrix_abc as pointer[double], 9, *(args + *(pos + 6))) = false
                    set ok: false
            }
        }
        if ok
        {
            if *(pos + 7) >= 0
            {
                if Primitive.decode_num_vector(matrix_lmn as pointer[double], 9, *(args + *(pos + 7))) = false
                    set ok: false
            }
        }
        if ok
        {
            if *(pos + 8) >= 0
            {
                if Primitive.decode_num_vector(matrix_a as pointer[double], 3, *(args + *(pos + 8))) = false
                    set ok: false
            }
        }
        if ok
        {
            if *(pos + 9) >= 0
            {
                if Primitive.decode_func_vector(decode_abc as pointer[pointer[ELObj]], 3, *(args + *(pos + 9))) = false
                    set ok: false
            }
        }
        if ok
        {
            if *(pos + 10) >= 0
            {
                if Primitive.decode_func_vector(decode_lmn as pointer[pointer[ELObj]], 3, *(args + *(pos + 10))) = false
                    set ok: false
            }
        }
        if ok
        {
            if *(pos + 11) >= 0
            {
                let fa *(args + *(pos + 11))
                if fa.is_function()
                    set decode_a: fa
                else
                    set ok: false
            }
        }
        if ok
        {
            ; per-kind forbidden keys (colorSpaceArgError like the arg errors).
            if (kind = CS_LUV) or (kind = CS_LAB)
            {
                var j 3
                while j < 12
                {
                    if *(pos + j) >= 0
                        set ok: false
                    set j: j + 1
                }
            }
            if kind = CS_ABC
            {
                if *(pos + 2) >= 0
                    set ok: false
                if *(pos + 5) >= 0
                    set ok: false
                if *(pos + 8) >= 0
                    set ok: false
                if *(pos + 11) >= 0
                    set ok: false
            }
            if kind = CS_A
            {
                if *(pos + 2) >= 0
                    set ok: false
                if *(pos + 3) >= 0
                    set ok: false
                if *(pos + 6) >= 0
                    set ok: false
                if *(pos + 9) >= 0
                    set ok: false
            }
        }
        if ok = false
            return Primitive.color_space_message(interp, loc, InterpreterMessages.colorSpaceArgError(), sname)
        let d CieData.make(host)
        set d.xyz: Primitive.xyz_data(host, wp as pointer[double])
        if (kind = CS_LUV) or (kind = CS_LAB)
        {
            let r host.allocate(48, 8) as pointer[double]
            var j 0
            while j < 6
            {
                if *(pos + 2) >= 0
                    set *(r + j): *((range as pointer[double]) + j)
                else
                {
                    if (j % 2) = 1
                        set *(r + j): 1.0
                    else
                        set *(r + j): 0.0
                }
                set j: j + 1
            }
            set d.range: r
        }
        if kind = CS_ABC
        {
            set d.range_abc: Primitive.range_buf(host, 6, *(pos + 3) >= 0, range_abc as pointer[double])
            set d.range_lmn: Primitive.range_buf(host, 6, *(pos + 4) >= 0, range_lmn as pointer[double])
            set d.matrix_abc: Primitive.matrix_buf(host, *(pos + 6) >= 0, matrix_abc as pointer[double])
            set d.matrix_lmn: Primitive.matrix_buf(host, *(pos + 7) >= 0, matrix_lmn as pointer[double])
            set d.decode_abc: Primitive.func_buf(host, *(pos + 9) >= 0, decode_abc as pointer[pointer[ELObj]])
            set d.decode_lmn: Primitive.func_buf(host, *(pos + 10) >= 0, decode_lmn as pointer[pointer[ELObj]])
        }
        if kind = CS_A
        {
            set d.range_a: Primitive.range_buf(host, 2, *(pos + 5) >= 0, range_a as pointer[double])
            set d.range_lmn: Primitive.range_buf(host, 6, *(pos + 4) >= 0, range_lmn as pointer[double])
            ; matrixA default is 1.0 in every slot (CIEAColorSpaceObj ctor).
            let ma host.allocate(24, 8) as pointer[double]
            var j 0
            while j < 3
            {
                if *(pos + 8) >= 0
                    set *(ma + j): *((matrix_a as pointer[double]) + j)
                else
                    set *(ma + j): 1.0
                set j: j + 1
            }
            set d.matrix_a: ma
            set d.matrix_lmn: Primitive.matrix_buf(host, *(pos + 7) >= 0, matrix_lmn as pointer[double])
            set d.decode_a: decode_a
            set d.decode_lmn: Primitive.func_buf(host, *(pos + 10) >= 0, decode_lmn as pointer[pointer[ELObj]])
        }
        ELObj.make_color_space(host, kind, d as pointer[void])
    }

    ; a range buffer: given values, or the 0/1 alternating default.
    function range_buf(host: pointer[Page], len: int, given: bool, vals: pointer[double]) returns pointer[double]
    {
        let r host.allocate((len * 8) as size_t, 8) as pointer[double]
        var j 0
        while j < len
        {
            if given
                set *(r + j): *(vals + j)
            else
            {
                if (j % 2) = 1
                    set *(r + j): 1.0
                else
                    set *(r + j): 0.0
            }
            set j: j + 1
        }
        r
    }

    ; a 3x3 matrix buffer: given values, or identity ((i % 4) ? 0 : 1).
    function matrix_buf(host: pointer[Page], given: bool, vals: pointer[double]) returns pointer[double]
    {
        let r host.allocate(72, 8) as pointer[double]
        var j 0
        while j < 9
        {
            if given
                set *(r + j): *(vals + j)
            else
            {
                if (j % 4) = 0
                    set *(r + j): 1.0
                else
                    set *(r + j): 0.0
            }
            set j: j + 1
        }
        r
    }

    function func_buf(host: pointer[Page], given: bool, vals: pointer[pointer[ELObj]]) returns pointer[pointer[ELObj]]
    {
        if given = false
            return null
        let r host.allocate(24, 8) as pointer[pointer[ELObj]]
        var j 0
        while j < 3
        {
            set *(r + j): *(vals + j)
            set j: j + 1
        }
        r
    }

    ; CIEXYZColorSpaceObj ctor: white point + the phosphor matrix (color faq)
    ; inverted twice into the XYZ->RGB matrix. Layout: white[3], white_u,
    ; white_v, M[9].
    function xyz_data(host: pointer[Page], wp: pointer[double]) returns pointer[double]
    {
        let d host.allocate(112, 8) as pointer[double]
        var i 0
        while i < 3
        {
            set *(d + i): *(wp + i)
            set i: i + 1
        }
        let tmp (*wp) + (15.0 * (*(wp + 1))) + (3.0 * (*(wp + 2)))
        set *(d + 3): 4.0 * (*wp) / tmp
        set *(d + 4): 9.0 * (*(wp + 1)) / tmp
        var u double[9]
        let up u as pointer[double]
        ; xr .64 yr .33 / xg .30 yg .60 / xb .15 yb .06
        set *up: 0.64
        set *(up + 1): 0.30
        set *(up + 2): 0.15
        set *(up + 3): 0.33
        set *(up + 4): 0.60
        set *(up + 5): 0.06
        set *(up + 6): 1.0 - 0.64 - 0.33
        set *(up + 7): 1.0 - 0.30 - 0.60
        set *(up + 8): 1.0 - 0.15 - 0.06
        var uinv double[9]
        Primitive.invert3(up, uinv as pointer[double])
        var c double[3]
        set i: 0
        while i < 3
        {
            let ui uinv as pointer[double]
            set *((c as pointer[double]) + i): ((*(ui + (3 * i))) * (*wp)) + ((*(ui + (3 * i) + 1)) * (*(wp + 1))) + ((*(ui + (3 * i) + 2)) * (*(wp + 2)))
            set i: i + 1
        }
        var minv double[9]
        let mp minv as pointer[double]
        let cp c as pointer[double]
        set i: 0
        while i < 3
        {
            var j 0
            while j < 3
            {
                set *(mp + (3 * i) + j): (*(up + (3 * i) + j)) * (*(cp + j))
                set j: j + 1
            }
            set i: i + 1
        }
        Primitive.invert3(mp, d + 5)
        d
    }

    ; invert a 3x3 matrix (Style.cxx invert; the near-singular case is left
    ; unreported like the reference FIXME).
    procedure invert3(a: pointer[double], b: pointer[double])
    {
        set *b: ((*(a + 4)) * (*(a + 8))) - ((*(a + 5)) * (*(a + 7)))
        set *(b + 3): 0.0 - (((*(a + 3)) * (*(a + 8))) - ((*(a + 5)) * (*(a + 6))))
        set *(b + 6): ((*(a + 3)) * (*(a + 7))) - ((*(a + 4)) * (*(a + 6)))
        set *(b + 1): 0.0 - (((*(a + 1)) * (*(a + 8))) - ((*(a + 2)) * (*(a + 7))))
        set *(b + 4): ((*a) * (*(a + 8))) - ((*(a + 2)) * (*(a + 6)))
        set *(b + 7): 0.0 - (((*a) * (*(a + 7))) - ((*(a + 1)) * (*(a + 6))))
        set *(b + 2): ((*(a + 1)) * (*(a + 5))) - ((*(a + 2)) * (*(a + 4)))
        set *(b + 5): 0.0 - (((*a) * (*(a + 5))) - ((*(a + 2)) * (*(a + 3))))
        set *(b + 8): ((*a) * (*(a + 4))) - ((*(a + 1)) * (*(a + 3)))
        let det ((*a) * (*b)) + ((*(a + 1)) * (*(b + 3))) + ((*(a + 2)) * (*(b + 6)))
        var i 0
        while i < 9
        {
            set *(b + i): (*(b + i)) / det
            set i: i + 1
        }
    }

    ; --- makeColor per space kind -------------------------------------------

    function color_arg_real(interp: pointer[Interpreter], loc: Location, sname: pointer[const_char], a: pointer[ELObj], lo: double, hi: double, out: pointer[double]) returns pointer[ELObj]
    {
        if a.is_real() = false
            return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgType(), sname)
        let d a.real_value()
        if d < lo
            return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgRange(), sname)
        if d > hi
            return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgRange(), sname)
        set *out: d
        null
    }

    ; (unsigned char)(d*255.0 + .5)
    function to_255(d: double) returns int
        (((d * 255.0) + 0.5) as int) & 0xFF

    ; applyFunc (Style.cxx): call a decode function on a fresh VM with the
    ; component as a real; the result must read back as a real.
    function apply_color_func(interp: pointer[Interpreter], f: pointer[ELObj], d: pointer[double]) returns bool
    {
        let host interp.get_host()
        let vm VM.make(host, interp)
        let insn f.make_call_insn(1, interp, Location(), null)
        let arg ELObj.make_real(host, *d)
        let res vm.eval(insn, null, arg)
        if res = null
            return false
        if res.is_real() = false
            return false
        set *d: res.real_value()
        true
    }

    ; CIEXYZColorSpaceObj::makeColor — XYZ through M into device RGB.
    function xyz_make_color(host: pointer[Page], xyz: pointer[double], h: pointer[double]) returns pointer[ELObj]
    {
        let m xyz + 5
        var c int[3]
        var i 0
        while i < 3
        {
            let v ((*(m + (3 * i))) * (*h)) + ((*(m + (3 * i) + 1)) * (*(h + 1))) + ((*(m + (3 * i) + 2)) * (*(h + 2)))
            set *((c as pointer[int]) + i): Primitive.to_255(v)
            set i: i + 1
        }
        let cp c as pointer[int]
        ELObj.make_color(host, *cp, *(cp + 1), *(cp + 2))
    }

    function make_color_from_space(host: pointer[Page], interp: pointer[Interpreter], space: pointer[ELObj], argc: int, args: pointer[pointer[ELObj]], loc: Location) returns pointer[ELObj]
    {
        let kind space.color_space_kind()
        ; every makeColor returns device black for zero args.
        if argc = 0
            return ELObj.make_color(host, 0, 0, 0)
        if kind = CS_RGB
        {
            if argc <> 3
                return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgCount(), "Device RGB")
            var c int[3]
            var i 0
            while i < 3
            {
                var d 0.0
                let err Primitive.color_arg_real(interp, loc, "Device RGB", *(args + i), 0.0, 1.0, &d)
                if err <> null
                    return err
                set *((c as pointer[int]) + i): Primitive.to_255(d)
                set i: i + 1
            }
            let cp c as pointer[int]
            return ELObj.make_color(host, *cp, *(cp + 1), *(cp + 2))
        }
        if kind = CS_GRAY
        {
            if argc <> 1
                return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgCount(), "Device Gray")
            var d 0.0
            let err Primitive.color_arg_real(interp, loc, "Device Gray", *args, 0.0, 1.0, &d)
            if err <> null
                return err
            let c Primitive.to_255(d)
            return ELObj.make_color(host, c, c, c)
        }
        if kind = CS_CMYK
        {
            if argc <> 4
                return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgCount(), "Device CMYK")
            var d double[4]
            var i 0
            while i < 4
            {
                var v 0.0
                let err Primitive.color_arg_real(interp, loc, "Device CMYK", *(args + i), 0.0, 1.0, &v)
                if err <> null
                    return err
                set *((d as pointer[double]) + i): v
                set i: i + 1
            }
            let dp d as pointer[double]
            var c int[3]
            set i: 0
            while i < 3
            {
                var sum (*(dp + i)) + (*(dp + 3))
                if sum > 1.0
                    set sum: 1.0
                set *((c as pointer[int]) + i): Primitive.to_255(1.0 - sum)
                set i: i + 1
            }
            let cp c as pointer[int]
            return ELObj.make_color(host, *cp, *(cp + 1), *(cp + 2))
        }
        if kind = CS_KX
        {
            if argc <> 2
                return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgCount(), "Device KX")
            var d0 0.0
            var d1 0.0
            let e0 Primitive.color_arg_real(interp, loc, "Device KX", *args, 0.0, 1.0, &d0)
            if e0 <> null
                return e0
            let e1 Primitive.color_arg_real(interp, loc, "Device KX", *(args + 1), 0.0, 1.0, &d1)
            if e1 <> null
                return e1
            var sum d0 + d1
            if sum > 1.0
                set sum: 1.0
            let c Primitive.to_255(1.0 - sum)
            return ELObj.make_color(host, c, c, c)
        }
        let data space.color_space_data() as pointer[CieData]
        if kind = CS_LUV
        {
            if argc <> 3
                return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgCount(), "CIE LUV")
            var d double[3]
            var i 0
            while i < 3
            {
                var v 0.0
                let err Primitive.color_arg_real(interp, loc, "CIE LUV", *(args + i), *(data.range + (2 * i)), *(data.range + (2 * i) + 1), &v)
                if err <> null
                    return err
                set *((d as pointer[double]) + i): v
                set i: i + 1
            }
            let dp d as pointer[double]
            var h double[3]
            let hp h as pointer[double]
            if *dp = 0.0
            {
                set *hp: 0.0
                set *(hp + 1): 0.0
                set *(hp + 2): 0.0
            }
            else
            {
                if *dp <= 7.996968
                    set *(hp + 1): (*dp) / 903.0
                else
                {
                    let t ((*dp) + 16.0) / 116.0
                    set *(hp + 1): t * t * t
                }
                let uu ((*(dp + 1)) / (13.0 * (*dp))) + (*(data.xyz + 3))
                let vv ((*(dp + 2)) / (13.0 * (*dp))) + (*(data.xyz + 4))
                let tmp 9.0 * (*(hp + 1)) / vv
                set *hp: uu * tmp / 4.0
                set *(hp + 2): (tmp - (15.0 * (*(hp + 1))) - (*hp)) / 3.0
            }
            return Primitive.xyz_make_color(host, data.xyz, hp)
        }
        if kind = CS_LAB
        {
            if argc <> 3
                return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgCount(), "CIE LAB")
            var d double[3]
            var i 0
            while i < 3
            {
                var v 0.0
                let err Primitive.color_arg_real(interp, loc, "CIE LAB", *(args + i), *(data.range + (2 * i)), *(data.range + (2 * i) + 1), &v)
                if err <> null
                    return err
                set *((d as pointer[double]) + i): v
                set i: i + 1
            }
            let dp d as pointer[double]
            set *dp: (*dp) / 100.0
            var h double[3]
            let hp h as pointer[double]
            var tmp ((*dp) + 16.0) / 116.0
            set *(hp + 1): tmp * tmp * tmp
            if *(hp + 1) < 0.008856
            {
                set tmp: (*dp) / 9.03292
                set *hp: (*data.xyz) * (((*(dp + 1)) / 3893.5) + tmp)
                set *(hp + 1): tmp
                set *(hp + 2): (*(data.xyz + 2)) * (tmp - ((*(dp + 2)) / 1557.4))
            }
            else
            {
                var tmp2 tmp + ((*(dp + 1)) / 5.0)
                set *hp: (*data.xyz) * tmp2 * tmp2 * tmp2
                set tmp2: tmp - ((*(dp + 2)) / 2.0)
                set *(hp + 2): (*(data.xyz + 2)) * tmp2 * tmp2 * tmp2
            }
            return Primitive.xyz_make_color(host, data.xyz, hp)
        }
        if kind = CS_ABC
        {
            if argc <> 3
                return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgCount(), "CIE Based ABC")
            var d double[3]
            var i 0
            while i < 3
            {
                var v 0.0
                let err Primitive.color_arg_real(interp, loc, "CIE Based ABC", *(args + i), *(data.range_abc + (2 * i)), *(data.range_abc + (2 * i) + 1), &v)
                if err <> null
                    return err
                if data.decode_abc <> null
                {
                    let f *(data.decode_abc + i)
                    if f <> null
                    {
                        if Primitive.apply_color_func(interp, f, &v) = false
                            return Primitive.color_space_message(interp, loc, InterpreterMessages.colorProcResType(), "CIE Based ABC")
                    }
                }
                set *((d as pointer[double]) + i): v
                set i: i + 1
            }
            let dp d as pointer[double]
            var l double[3]
            let lp l as pointer[double]
            set i: 0
            while i < 3
            {
                var v ((*(data.matrix_abc + i)) * (*dp)) + ((*(data.matrix_abc + 3 + i)) * (*(dp + 1))) + ((*(data.matrix_abc + 6 + i)) * (*(dp + 2)))
                if v < *(data.range_lmn + (2 * i))
                    return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgRange(), "CIE Based ABC")
                if v > *(data.range_lmn + (2 * i) + 1)
                    return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgRange(), "CIE Based ABC")
                if data.decode_lmn <> null
                {
                    let f *(data.decode_lmn + i)
                    if f <> null
                    {
                        if Primitive.apply_color_func(interp, f, &v) = false
                            return Primitive.color_space_message(interp, loc, InterpreterMessages.colorProcResType(), "CIE Based ABC")
                    }
                }
                set *(lp + i): v
                set i: i + 1
            }
            var h double[3]
            let hp h as pointer[double]
            set i: 0
            while i < 3
            {
                set *(hp + i): ((*(data.matrix_lmn + i)) * (*lp)) + ((*(data.matrix_lmn + 3 + i)) * (*(lp + 1))) + ((*(data.matrix_lmn + 6 + i)) * (*(lp + 2)))
                set i: i + 1
            }
            return Primitive.xyz_make_color(host, data.xyz, hp)
        }
        if kind = CS_A
        {
            if argc <> 1
                return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgCount(), "CIE Based A")
            var d 0.0
            let err Primitive.color_arg_real(interp, loc, "CIE Based A", *args, *data.range_a, *(data.range_a + 1), &d)
            if err <> null
                return err
            if data.decode_a <> null
            {
                if Primitive.apply_color_func(interp, data.decode_a, &d) = false
                    return Primitive.color_space_message(interp, loc, InterpreterMessages.colorProcResType(), "CIE Based A")
            }
            var l double[3]
            let lp l as pointer[double]
            var i 0
            while i < 3
            {
                var v (*(data.matrix_a + i)) * d
                if v < *(data.range_lmn + (2 * i))
                    return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgRange(), "CIE Based A")
                if v > *(data.range_lmn + (2 * i) + 1)
                    return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgRange(), "CIE Based A")
                if data.decode_lmn <> null
                {
                    let f *(data.decode_lmn + i)
                    if f <> null
                    {
                        if Primitive.apply_color_func(interp, f, &v) = false
                            return Primitive.color_space_message(interp, loc, InterpreterMessages.colorProcResType(), "CIE Based A")
                    }
                }
                set *(lp + i): v
                set i: i + 1
            }
            var h double[3]
            let hp h as pointer[double]
            set i: 0
            while i < 3
            {
                set *(hp + i): ((*(data.matrix_lmn + i)) * (*lp)) + ((*(data.matrix_lmn + 3 + i)) * (*(lp + 1))) + ((*(data.matrix_lmn + 6 + i)) * (*(lp + 2)))
                set i: i + 1
            }
            return Primitive.xyz_make_color(host, data.xyz, hp)
        }
        ELObj.make_color(host, 0, 0, 0)
    }

    function collect_data_fill(interp: pointer[Interpreter], node: pointer[GroveNode], buf: pointer[u32], off: size_t) returns size_t
    {
        if node = null
            return off
        if node.get_class() = GN_ATTR_ASSIGN
        {
            var ok false
            let t node.assign_tokens(&ok)
            if ok
            {
                let m t.get_size()
                var k: size_t 0
                var o off
                while k < m
                {
                    set *(buf + o): t.get(k)
                    set o: o + 1
                    set k: k + 1
                }
                return o
            }
        }
        if node.get_class() = GN_ATTR_TOKEN
        {
            let c node.get_chars()
            let m c.get_size()
            var k: size_t 0
            var o off
            while k < m
            {
                set *(buf + o): c.get(k)
                set o: o + 1
                set k: k + 1
            }
            return o
        }
        if node.get_class() = GN_DATA
        {
            let c node.get_chars()
            let m c.get_size()
            var k: size_t 0
            var o off
            while k < m
            {
                set *(buf + o): c.get(k)
                set o: o + 1
                set k: k + 1
            }
            return o
        }
        if node.get_class() = GN_SDATA
        {
            set *(buf + off): Primitive.sdata_char(interp, node)
            return off + (1 as size_t)
        }
        var o off
        let n node.axis_child_count()
        var i 0
        while i < n
        {
            let ch node.axis_child_at(i)
            set o: Primitive.collect_data_fill(interp, ch, buf, o)
            set i: i + 1
        }
        o
    }
}
