; Primitive — the built-in procedures over ELObj (Style/Primitive.cxx). The
; reference has one class per primitive; here each is a prim_id arm of a single
; dispatch. Inc-3 starter set: the pure-ELObj primitives (arithmetic,
; comparison, pairs/lists, predicates, not) — the reference's "install first"
; batch. Strings/chars/vectors and the grove / sosofo / style primitives join
; as their machinery lands. prim_id values are the install order in Interpreter.

define PRIM_CONS: int 0
define PRIM_LIST: int 1
define PRIM_CAR: int 2
define PRIM_CDR: int 3
define PRIM_IS_NULL: int 4
define PRIM_IS_PAIR: int 5
define PRIM_IS_LIST: int 6
define PRIM_LENGTH: int 7
define PRIM_APPEND: int 8
define PRIM_REVERSE: int 9
define PRIM_LIST_REF: int 10
define PRIM_MEMQ: int 11
define PRIM_MEMV: int 12
define PRIM_MEMBER: int 13
define PRIM_ASSQ: int 14
define PRIM_IS_EQUAL: int 15
define PRIM_IS_EQV: int 16
define PRIM_PLUS: int 17
define PRIM_MINUS: int 18
define PRIM_TIMES: int 19
define PRIM_DIVIDE: int 20
define PRIM_NUM_EQ: int 21
define PRIM_LESS: int 22
define PRIM_GREATER: int 23
define PRIM_LESS_EQ: int 24
define PRIM_GREATER_EQ: int 25
define PRIM_NOT: int 26
define PRIM_IS_ZERO: int 27
define PRIM_IS_POSITIVE: int 28
define PRIM_IS_NEGATIVE: int 29
define PRIM_IS_ODD: int 30
define PRIM_IS_EVEN: int 31
define PRIM_ABS: int 32
define PRIM_MODULO: int 33
define PRIM_REMAINDER: int 34
define PRIM_QUOTIENT: int 35
define PRIM_IS_NUMBER: int 36
define PRIM_IS_INTEGER: int 37
define PRIM_IS_REAL: int 38
define PRIM_IS_STRING: int 39
define PRIM_IS_SYMBOL: int 40
define PRIM_IS_CHAR: int 41
define PRIM_IS_BOOLEAN: int 42
define PRIM_IS_PROCEDURE: int 43
define PRIM_IS_VECTOR: int 44
define PRIM_IS_KEYWORD: int 45
; --- string / char / symbol / keyword / vector primitives (Inc 3) ----------
define PRIM_SYMBOL_TO_STRING: int 46
define PRIM_STRING_TO_SYMBOL: int 47
define PRIM_KEYWORD_TO_STRING: int 48
define PRIM_STRING_TO_KEYWORD: int 49
define PRIM_STRING_APPEND: int 50
define PRIM_STRING_LENGTH: int 51
define PRIM_STRING_REF: int 52
define PRIM_SUBSTRING: int 53
define PRIM_STRING: int 54
define PRIM_STRING_EQUAL: int 55
define PRIM_STRING_LESS: int 56
define PRIM_STRING_LESS_EQ: int 57
define PRIM_STRING_TO_LIST: int 58
define PRIM_LIST_TO_STRING: int 59
define PRIM_STRING_TO_NUMBER: int 60
define PRIM_NUMBER_TO_STRING: int 61
define PRIM_CHAR_TO_INTEGER: int 62
define PRIM_INTEGER_TO_CHAR: int 63
define PRIM_CHAR_LESS: int 64
define PRIM_CHAR_LESS_EQ: int 65
define PRIM_CHAR_EQUAL: int 66
define PRIM_CHAR_UPCASE: int 67
define PRIM_CHAR_DOWNCASE: int 68
define PRIM_MAKE_VECTOR: int 69
define PRIM_VECTOR: int 70
define PRIM_VECTOR_REF: int 71
define PRIM_VECTOR_SET: int 72
define PRIM_VECTOR_LENGTH: int 73
define PRIM_VECTOR_TO_LIST: int 74
define PRIM_LIST_TO_VECTOR: int 75
define PRIM_LIST_TAIL: int 76
; --- grove / node-list primitives (Inc 4) ----------------------------------
define PRIM_IS_NODE_LIST: int 77
define PRIM_NODE_LIST_EMPTY: int 78
define PRIM_NODE_LIST_LENGTH: int 79
define PRIM_NODE_LIST_FIRST: int 80
define PRIM_NODE_LIST_REST: int 81
define PRIM_NODE_LIST_REF: int 82
define PRIM_EMPTY_NODE_LIST: int 83
define PRIM_NODE_LIST: int 84
define PRIM_CHILDREN: int 85
define PRIM_GI: int 86
define PRIM_DATA: int 87
; --- grove / property axis (Inc 4) -----------------------------------------
; The pure grove-node axis, ported 1:1 from dazzle style/primitive.cxx over the
; grove/Node.h accessors. NOT ported here (need machinery from a later slice):
; - node-property / select-by-class (need the ComponentName id space +
;   Node::property metamodel).
define PRIM_PARENT: int 91
define PRIM_ATTRIBUTE_STRING: int 92
define PRIM_ANCESTOR: int 93
define PRIM_DESCENDANTS: int 94
; --- sosofo primitives (Inc 4 foundation) ----------------------------------
define PRIM_IS_SOSOFO: int 88
define PRIM_EMPTY_SOSOFO: int 89
define PRIM_SOSOFO_APPEND: int 90
; --- style-engine primitives (Inc 5): construction-rule sosofos ------------
define PRIM_PROCESS_CHILDREN: int 95
define PRIM_PROCESS_CHILDREN_TRIM: int 96
define PRIM_PROCESS_NODE_LIST: int 97
define PRIM_CURRENT_NODE: int 98
define PRIM_LITERAL: int 99
define PRIM_NEXT_MATCH: int 100
define PRIM_PROCESS_NODE: int 101
define PRIM_SELECT_ELEMENTS: int 102
define PRIM_ELEMENT_WITH_ID: int 103
define PRIM_ID: int 104
define PRIM_IS_FIRST_SIBLING: int 105
define PRIM_IS_LAST_SIBLING: int 106
define PRIM_CHILD_NUMBER: int 107
define PRIM_IS_NODE_LIST_EQUAL: int 108
define PRIM_NODE_LIST_MAP: int 109
define PRIM_NODE_LIST_REVERSE: int 110
define PRIM_NODE_PROPERTY: int 111
define PRIM_PAGE_NUMBER_SOSOFO: int 112
define PRIM_CURRENT_NODE_PAGE_NUMBER_SOSOFO: int 113
define PRIM_EXTERNAL_PROCEDURE: int 114
; XPRIMITIVEs (Clark externals; reachable only via external-procedure)
define PRIM_IF_FIRST_PAGE: int 115
define PRIM_IF_FRONT_PAGE: int 116
; the per-characteristic inherited-<name> / actual-<name> primitives
; (InheritedCPrimitiveObj / ActualCPrimitiveObj, InheritedC.cxx): the target
; characteristic is recovered from the primitive's own name (prefix strip).
define PRIM_INHERITED_C: int 117
define PRIM_ACTUAL_C: int 118
; length-spec / space / color primitives (Family-B front)
define PRIM_DISPLAY_SIZE: int 119
define PRIM_TABLE_UNIT: int 120
define PRIM_IS_DISPLAY_SPACE: int 121
define PRIM_DISPLAY_SPACE: int 122
define PRIM_IS_INLINE_SPACE: int 123
define PRIM_INLINE_SPACE: int 124
define PRIM_IS_COLOR: int 125
define PRIM_IS_COLOR_SPACE: int 126
define PRIM_COLOR: int 127
define PRIM_COLOR_SPACE: int 128

; color-space kinds (ColorSpaceObjRec.kind)
define CS_RGB: int 0
define CS_GRAY: int 1
define CS_CMYK: int 2
define CS_KX: int 3
define CS_LUV: int 4
define CS_LAB: int 5
define CS_ABC: int 6
define CS_A: int 7

; the CIE color-space data (XYZData + the per-kind extras, one flat record;
; every pointer is a host-allocated double/ELObj* buffer of the noted size).
define CieData
(
    xyz: pointer[double]              ; 14: white[3], white_u, white_v, M[9]
    range: pointer[double]            ; 6 (LUV/LAB)
    range_abc: pointer[double]        ; 6
    decode_abc: pointer[pointer[ELObj]] ; 3 (null entries = identity)
    matrix_abc: pointer[double]       ; 9
    range_lmn: pointer[double]        ; 6
    decode_lmn: pointer[pointer[ELObj]] ; 3
    matrix_lmn: pointer[double]       ; 9
    range_a: pointer[double]          ; 2
    decode_a: pointer[ELObj]
    matrix_a: pointer[double]         ; 3
)
{
    function make(host: pointer[Page]) returns pointer[CieData]
    {
        let d host.allocate(sizeof CieData, alignof CieData) as pointer[CieData]
        set d.xyz: null
        set d.range: null
        set d.range_abc: null
        set d.decode_abc: null
        set d.matrix_abc: null
        set d.range_lmn: null
        set d.decode_lmn: null
        set d.matrix_lmn: null
        set d.range_a: null
        set d.decode_a: null
        set d.matrix_a: null
        d
    }
}

define Primitive
{
    ; primitiveCall dispatch. args points into the VM value stack (n_args
    ; slots). An error result is interp.makeError(); the VM turns it into the
    ; error unwind.
    function dispatch(id: int, name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], interp: pointer[Interpreter], loc: Location) returns pointer[ELObj]
    {
        let host interp.get_host()
        let a0 *args
        if id = PRIM_CONS
            return ELObj.make_pair(host, *args, *(args + 1))
        if id = PRIM_LIST
            return Primitive.build_list(host, interp, args, n_args)
        if id = PRIM_CAR
        {
            if a0.is_pair() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAPair(), name, 0, a0)
            return a0.get_car()
        }
        if id = PRIM_CDR
        {
            if a0.is_pair() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAPair(), name, 0, a0)
            return a0.get_cdr()
        }
        if id = PRIM_IS_NULL
            return interp.make_bool(a0.is_nil())
        if id = PRIM_IS_PAIR
            return interp.make_bool(a0.is_pair())
        if id = PRIM_IS_LIST
            return interp.make_bool(a0.is_list())
        if id = PRIM_LENGTH
            return Primitive.list_length(host, interp, name, *args, loc)
        if id = PRIM_APPEND
            return Primitive.append_lists(host, interp, name, args, n_args, loc)
        if id = PRIM_REVERSE
            return Primitive.reverse_list(host, interp, name, *args, loc)
        if id = PRIM_LIST_REF
            return Primitive.list_ref(interp, name, *args, *(args + 1), loc)
        if id = PRIM_MEMQ
            return Primitive.member_of(interp, name, *args, *(args + 1), 0, loc)
        if id = PRIM_MEMV
            return Primitive.member_of(interp, name, *args, *(args + 1), 1, loc)
        if id = PRIM_MEMBER
            return Primitive.member_of(interp, name, *args, *(args + 1), 2, loc)
        if id = PRIM_ASSQ
            return Primitive.assq(interp, name, *args, *(args + 1), loc)
        if id = PRIM_IS_EQUAL
            return interp.make_bool(ELObj.equal(*args, *(args + 1)))
        if id = PRIM_IS_EQV
            return interp.make_bool(ELObj.eqv(*args, *(args + 1)))
        if id = PRIM_NOT
            return interp.make_bool(a0.is_true() = false)
        if id = PRIM_IS_NUMBER
            return interp.make_bool(a0.is_number())
        if id = PRIM_IS_INTEGER
            return interp.make_bool(a0.is_integer_p())
        if id = PRIM_IS_REAL
            return interp.make_bool(a0.is_real())
        if id = PRIM_IS_STRING
            return interp.make_bool(a0.is_string_p())
        if id = PRIM_IS_SYMBOL
            return interp.make_bool(a0.is_symbol_p())
        if id = PRIM_IS_CHAR
            return interp.make_bool(a0.is_char_p())
        if id = PRIM_IS_KEYWORD
            return interp.make_bool(a0.is_keyword_p())
        if id = PRIM_IS_BOOLEAN
            return interp.make_bool(a0.is_boolean_p())
        if id = PRIM_IS_VECTOR
            return interp.make_bool(a0.is_vector_p())
        if id = PRIM_IS_PROCEDURE
            return interp.make_bool(a0.is_function())

        ; --- arithmetic ----------------------------------------------------
        if id = PRIM_PLUS
            return Primitive.arith_add(host, interp, name, args, n_args, loc)
        if id = PRIM_TIMES
            return Primitive.arith_mul(host, interp, name, args, n_args, loc)
        if id = PRIM_MINUS
            return Primitive.arith_sub(host, interp, name, args, n_args, loc)
        if id = PRIM_DIVIDE
            return Primitive.arith_div(host, interp, name, args, n_args, loc)
        if id = PRIM_NUM_EQ
            return Primitive.compare(host, interp, name, args, n_args, loc, 0)
        if id = PRIM_LESS
            return Primitive.compare(host, interp, name, args, n_args, loc, 1)
        if id = PRIM_GREATER
            return Primitive.compare(host, interp, name, args, n_args, loc, 2)
        if id = PRIM_LESS_EQ
            return Primitive.compare(host, interp, name, args, n_args, loc, 3)
        if id = PRIM_GREATER_EQ
            return Primitive.compare(host, interp, name, args, n_args, loc, 4)
        if id = PRIM_IS_ZERO
            return Primitive.sign_test(interp, name, *args, loc, 0)
        if id = PRIM_IS_POSITIVE
            return Primitive.sign_test(interp, name, *args, loc, 1)
        if id = PRIM_IS_NEGATIVE
            return Primitive.sign_test(interp, name, *args, loc, 2)
        if id = PRIM_IS_ODD
            return Primitive.parity_test(interp, name, *args, loc, 1)
        if id = PRIM_IS_EVEN
            return Primitive.parity_test(interp, name, *args, loc, 0)
        if id = PRIM_ABS
            return Primitive.abs_val(host, interp, name, *args, loc)
        if id = PRIM_MODULO
            return Primitive.int_div(host, interp, name, *args, *(args + 1), loc, 0)
        if id = PRIM_REMAINDER
            return Primitive.int_div(host, interp, name, *args, *(args + 1), loc, 1)
        if id = PRIM_QUOTIENT
            return Primitive.int_div(host, interp, name, *args, *(args + 1), loc, 2)

        ; --- string / char / symbol / keyword / vector --------------------
        if id = PRIM_SYMBOL_TO_STRING
        {
            if a0.is_symbol_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASymbol(), name, 0, a0)
            return ELObj.make_string(host, a0.symbol_name())
        }
        if id = PRIM_STRING_TO_SYMBOL
        {
            if a0.has_string_data() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
            return interp.make_symbol(a0.string_data(host))
        }
        if id = PRIM_KEYWORD_TO_STRING
        {
            if a0.is_keyword_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAKeyword(), name, 0, a0)
            return ELObj.make_string(host, a0.keyword_name())
        }
        if id = PRIM_STRING_TO_KEYWORD
        {
            if a0.has_string_data() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
            return interp.make_keyword(a0.string_data(host))
        }
        if id = PRIM_STRING_APPEND
            return Primitive.string_append(host, interp, name, args, n_args, loc)
        if id = PRIM_STRING_LENGTH
        {
            if a0.has_string_data() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
            ; string_size, not string_data: don't flatten a rope for its length
            let sl0 a0.string_size()
            return ELObj.make_integer(host, sl0 as int)
        }
        if id = PRIM_STRING_REF
            return Primitive.string_ref(host, interp, name, a0, *(args + 1), loc)
        if id = PRIM_SUBSTRING
            return Primitive.substring(host, interp, name, a0, *(args + 1), *(args + 2), loc)
        if id = PRIM_STRING
            return Primitive.string_from_chars(host, interp, name, args, n_args, loc)
        if id = PRIM_STRING_EQUAL
            return Primitive.string_compare(interp, name, a0, *(args + 1), loc, 0)
        if id = PRIM_STRING_LESS
            return Primitive.string_compare(interp, name, a0, *(args + 1), loc, 1)
        if id = PRIM_STRING_LESS_EQ
            return Primitive.string_compare(interp, name, a0, *(args + 1), loc, 2)
        if id = PRIM_STRING_TO_LIST
            return Primitive.string_to_list(host, interp, name, a0, loc)
        if id = PRIM_LIST_TO_STRING
            return Primitive.list_to_string(host, interp, name, a0, loc)
        if id = PRIM_STRING_TO_NUMBER
            return Primitive.string_to_number(host, interp, name, args, n_args, loc)
        if id = PRIM_NUMBER_TO_STRING
            return Primitive.number_to_string(host, interp, name, args, n_args, loc)
        if id = PRIM_CHAR_TO_INTEGER
        {
            if a0.is_char_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAChar(), name, 0, a0)
            return ELObj.make_integer(host, a0.char_value())
        }
        if id = PRIM_INTEGER_TO_CHAR
            return Primitive.integer_to_char(host, interp, name, a0, loc)
        if id = PRIM_CHAR_LESS
            return Primitive.char_compare(interp, name, a0, *(args + 1), loc, 1)
        if id = PRIM_CHAR_LESS_EQ
            return Primitive.char_compare(interp, name, a0, *(args + 1), loc, 2)
        if id = PRIM_CHAR_EQUAL
            return Primitive.char_compare(interp, name, a0, *(args + 1), loc, 0)
        if id = PRIM_CHAR_UPCASE
            return Primitive.char_case(host, interp, name, a0, loc, true)
        if id = PRIM_CHAR_DOWNCASE
            return Primitive.char_case(host, interp, name, a0, loc, false)
        if id = PRIM_MAKE_VECTOR
            return Primitive.make_vector_prim(host, interp, name, args, n_args, loc)
        if id = PRIM_VECTOR
            return ELObj.make_vector_of(host, args, n_args as size_t)
        if id = PRIM_VECTOR_REF
            return Primitive.vector_ref(interp, name, a0, *(args + 1), loc)
        if id = PRIM_VECTOR_SET
            return Primitive.vector_set(interp, name, a0, *(args + 1), *(args + 2), loc)
        if id = PRIM_VECTOR_LENGTH
        {
            if a0.is_vector_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAVector(), name, 0, a0)
            return ELObj.make_integer(host, a0.vector_length() as int)
        }
        if id = PRIM_VECTOR_TO_LIST
            return Primitive.vector_to_list(host, interp, name, a0, loc)
        if id = PRIM_LIST_TO_VECTOR
            return Primitive.list_to_vector(host, interp, name, a0, loc)
        if id = PRIM_LIST_TAIL
            return Primitive.list_tail(interp, name, a0, *(args + 1), loc)

        ; --- grove / node-list --------------------------------------------
        if id = PRIM_IS_NODE_LIST
            return interp.make_bool(a0.is_node_list_p())
        if id = PRIM_NODE_LIST_EMPTY
        {
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, a0)
            return interp.make_bool(a0.node_list_count() = 0)
        }
        if id = PRIM_NODE_LIST_LENGTH
        {
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, a0)
            return ELObj.make_integer(host, a0.node_list_count())
        }
        if id = PRIM_NODE_LIST_FIRST
        {
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, a0)
            if a0.node_list_count() = 0
                return ELObj.make_node_list(host, null, 0)
            return ELObj.make_node_singleton(host, a0.node_list_node(0))
        }
        if id = PRIM_NODE_LIST_REST
        {
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, a0)
            let buf a0.node_list_buffer()
            let st a0.node_list_start()
            if a0.node_list_count() = 0
                return ELObj.make_node_list(host, buf, st)
            return ELObj.make_node_list(host, buf, st + 1)
        }
        if id = PRIM_NODE_LIST_REF
            return Primitive.node_list_ref(host, interp, name, a0, *(args + 1), loc)
        if id = PRIM_EMPTY_NODE_LIST
            return ELObj.make_node_list(host, null, 0)
        if id = PRIM_NODE_LIST
            return Primitive.node_list_concat(host, interp, name, args, n_args, loc)
        if id = PRIM_CHILDREN
            return Primitive.children(host, interp, name, a0, loc)
        if id = PRIM_GI
            return Primitive.node_gi(host, interp, name, a0, loc)
        if id = PRIM_DATA
            return Primitive.node_data(host, interp, name, a0, loc)

        ; --- grove / property axis ----------------------------------------
        if id = PRIM_PARENT
            return Primitive.node_parent(host, interp, name, a0, loc)
        if id = PRIM_ATTRIBUTE_STRING
            return Primitive.attribute_string(host, interp, name, a0, *(args + 1), loc)
        if id = PRIM_ANCESTOR
            return Primitive.ancestor(host, interp, name, a0, *(args + 1), loc)
        if id = PRIM_DESCENDANTS
            return Primitive.descendants(host, interp, name, a0, loc)

        ; --- sosofos ------------------------------------------------------
        if id = PRIM_IS_SOSOFO
            return interp.make_bool(a0.is_sosofo_p())
        if id = PRIM_EMPTY_SOSOFO
            return ELObj.make_empty_sosofo(host)
        if id = PRIM_SOSOFO_APPEND
            return Primitive.sosofo_append(host, interp, name, args, n_args, loc)

        ; --- style engine (Inc 5): construction-rule sosofos --------------
        ; the process-* sosofos capture the VM's processing mode (reference:
        ; context.processingMode), so with-mode brackets take effect.
        if id = PRIM_PROCESS_CHILDREN
            return ELObj.make_process_children_sosofo(host, false, ctx.get_processing_mode())
        if id = PRIM_PROCESS_CHILDREN_TRIM
            return ELObj.make_process_children_sosofo(host, true, ctx.get_processing_mode())
        if id = PRIM_NEXT_MATCH
            return ELObj.make_next_match_sosofo(host)
        if id = PRIM_CURRENT_NODE
        {
            let cn ctx.get_current_node()
            if cn = null
                return ELObj.make_node_list(host, null, 0)
            return ELObj.make_node_singleton(host, cn)
        }
        if id = PRIM_LITERAL
        {
            if a0.has_string_data() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
            return ELObj.make_literal_sosofo(host, a0)
        }
        if id = PRIM_PROCESS_NODE_LIST
        {
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, a0)
            return ELObj.make_process_node_list_sosofo(host, a0, ctx.get_processing_mode())
        }
        if id = PRIM_PROCESS_NODE
        {
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, a0)
            let nd a0.node_list_node(0)
            if nd = null
                return ELObj.make_empty_sosofo(host)
            return ELObj.make_process_node_sosofo(host, nd, ctx.get_processing_mode())
        }
        if (id = PRIM_INHERITED_C) or (id = PRIM_ACTUAL_C)
        {
            ; InheritedCPrimitiveObj / ActualCPrimitiveObj::primitiveCall.
            let ss ctx.get_style_stack()
            if ss = null
            {
                interp.set_next_location(loc)
                interp.message0(InterpreterMessages.notInCharacteristicValue())
                return interp.make_error()
            }
            var plen: size_t 10
            if id = PRIM_ACTUAL_C
                set plen: 7
            let base interp.lookup(StringC(name.data_ptr() + plen, name.get_size() - plen))
            let icraw base.get_inherited_c()
            if icraw = null
                return interp.make_error()
            let ic icraw as pointer[InheritedC]
            if id = PRIM_INHERITED_C
                return VM.stack_inherited(ss, ic, ctx.get_spec_level(), interp, ctx.get_actual_deps())
            return VM.stack_actual(ss, ic, loc, interp, ctx.get_actual_deps())
        }
        if id = PRIM_PAGE_NUMBER_SOSOFO
            return ELObj.make_page_number_sosofo(host)
        if id = PRIM_CURRENT_NODE_PAGE_NUMBER_SOSOFO
        {
            let cn ctx.get_current_node()
            if cn = null
                return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
            return ELObj.make_current_node_page_number_sosofo(host, cn)
        }
        if id = PRIM_EXTERNAL_PROCEDURE
        {
            if a0.has_string_data() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
            let pubid a0.string_data(host)
            let func interp.lookup_external_proc(pubid)
            if func = null
                return interp.make_bool(false)
            return func
        }
        if (id = PRIM_IF_FIRST_PAGE) or (id = PRIM_IF_FRONT_PAGE)
        {
            var i 0
            while i < 2
            {
                let a *(args + i)
                if a.is_sosofo_p() = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notASosofo(), name, i, a)
                set i: i + 1
            }
            var flag 1
            if id = PRIM_IF_FRONT_PAGE
                set flag: 2
            return ELObj.make_page_type_sosofo(host, flag, a0, *(args + 1))
        }
        if id = PRIM_SELECT_ELEMENTS
            return Primitive.select_elements(host, interp, name, a0, *(args + 1), loc)
        if id = PRIM_ELEMENT_WITH_ID
            return Primitive.element_with_id(host, interp, name, a0, loc)
        if id = PRIM_ID
            return Primitive.node_id(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_IS_FIRST_SIBLING
            return Primitive.is_first_sibling(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_IS_LAST_SIBLING
            return Primitive.is_last_sibling(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_CHILD_NUMBER
            return Primitive.child_number(host, interp, name, n_args, args, ctx, loc)
        if id = PRIM_IS_NODE_LIST_EQUAL
            return Primitive.node_list_equal(interp, name, a0, *(args + 1), loc)
        if id = PRIM_NODE_LIST_MAP
            return Primitive.node_list_map(host, interp, name, a0, *(args + 1), ctx, loc)
        if id = PRIM_NODE_LIST_REVERSE
            return Primitive.node_list_reverse_prim(host, interp, name, a0, loc)
        if id = PRIM_NODE_PROPERTY
            return Primitive.node_property(host, interp, name, n_args, args, loc)

        ; --- length-spec / space / color (Family-B front) --------------------
        if id = PRIM_DISPLAY_SIZE
            return ELObj.make_length_spec(host, 0.0, 1.0, 0.0)
        if id = PRIM_TABLE_UNIT
        {
            if a0.is_integer_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 0, a0)
            return ELObj.make_length_spec(host, 0.0, 0.0, a0.exact_integer_value() as double)
        }
        if id = PRIM_IS_DISPLAY_SPACE
            return interp.make_bool(a0.as_display_space() <> null)
        if id = PRIM_DISPLAY_SPACE
            return Primitive.display_space_prim(host, interp, name, args, n_args, loc)
        if id = PRIM_IS_INLINE_SPACE
            return interp.make_bool(a0.as_inline_space() <> null)
        if id = PRIM_INLINE_SPACE
            return Primitive.inline_space_prim(host, interp, name, args, n_args, loc)
        if id = PRIM_IS_COLOR
            return interp.make_bool(a0.is_color_p())
        if id = PRIM_IS_COLOR_SPACE
            return interp.make_bool(a0.is_color_space_p())
        if id = PRIM_COLOR
        {
            if a0.is_color_space_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAColorSpace(), name, 0, a0)
            return Primitive.make_color_from_space(host, interp, a0, n_args - 1, args + 1, loc)
        }
        if id = PRIM_COLOR_SPACE
            return Primitive.color_space_prim(host, interp, name, args, n_args, loc)

        interp.make_error()
    }

    ; PrimitiveObj::argError (Insn.cxx:592): report the offending argument
    ; with the primitive's name, the 1-based ordinal, and the printed object,
    ; then yield the error object. The C++ suppression arm (a node-list whose
    ; suppressError() is true) is only ever taken for the lazy MapNodeListObj;
    ; our node-list-map is eager and yields plain node-lists, so no
    ; suppression here.
    function arg_error(interp: pointer[Interpreter], loc: Location, mt: MessageType, name: StringC, index: int, obj: pointer[ELObj]) returns pointer[ELObj]
    {
        let host interp.get_host()
        let os OutputCharStream.make(host)
        let upi interp.get_units_per_inch()
        obj.print(os, upi)
        let printed os.to_string_c(host)
        interp.set_next_location(loc)
        interp.message3(mt, name, (index + 1) as u64, printed)
        interp.make_error()
    }

    ; The reference's inline `setNextLocation + message + makeError` shape
    ; (outOfRange, divideBy0, ...).
    function simple_error(interp: pointer[Interpreter], loc: Location, mt: MessageType) returns pointer[ELObj]
    {
        interp.set_next_location(loc)
        interp.message0(mt)
        interp.make_error()
    }

    ; --- list helpers ------------------------------------------------------
    function build_list(host: pointer[Page], interp: pointer[Interpreter], args: pointer[pointer[ELObj]], n_args: int) returns pointer[ELObj]
    {
        var result interp.make_nil()
        var i n_args - 1
        while i >= 0
        {
            set result: ELObj.make_pair(host, *(args + i), result)
            set i: i - 1
        }
        result
    }

    function list_length(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        var n 0
        var p obj
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
            {
                if interp.is_error(p)
                    return p
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 0, p)
            }
            set n: n + 1
            set p: p.get_cdr()
        }
        ELObj.make_integer(host, n)
    }

    function append_lists(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        if n_args = 0
            return interp.make_nil()
        ; every arg but the last must be a proper list; the improper tail is
        ; reported left-to-right (Append passes the tail object).
        var i 0
        while i < n_args - 1
        {
            var p *(args + i)
            while (p <> null) and (p.is_nil() = false)
            {
                if p.is_pair() = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, i, p)
                set p: p.get_cdr()
            }
            set i: i + 1
        }
        var result *(args + (n_args - 1))
        set i: n_args - 2
        while i >= 0
        {
            ; prepend the elements of args[i] (reversed onto result)
            let tmp Primitive.reverse_list(host, interp, name, *(args + i), loc)
            var p tmp
            while (p <> null) and (p.is_nil() = false)
            {
                set result: ELObj.make_pair(host, p.get_car(), result)
                set p: p.get_cdr()
            }
            set i: i - 1
        }
        result
    }

    function reverse_list(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        var result interp.make_nil()
        var p obj
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 0, obj)
            set result: ELObj.make_pair(host, p.get_car(), result)
            set p: p.get_cdr()
        }
        result
    }

    function list_ref(interp: pointer[Interpreter], name: StringC, list: pointer[ELObj], k_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if k_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, k_obj)
        var k k_obj.exact_integer_value()
        if k < 0
            return Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
        var p list
        while (p <> null) and p.is_pair()
        {
            if k = 0
                return p.get_car()
            set k: k - 1
            set p: p.get_cdr()
        }
        if (p <> null) and (p.is_nil() = false)
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 0, list)
        Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
    }

    ; mode: 0 memq (eq/eqv-ptr), 1 memv (eqv), 2 member (equal).
    function member_of(interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], list: pointer[ELObj], mode: int, loc: Location) returns pointer[ELObj]
    {
        var p list
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 1, list)
            let car p.get_car()
            var hit false
            if mode = 0
                set hit: car = obj
            else if mode = 1
                set hit: ELObj.eqv(car, obj)
            else
                set hit: ELObj.equal(car, obj)
            if hit
                return p
            set p: p.get_cdr()
        }
        interp.make_false()
    }

    function assq(interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], list: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        var p list
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 1, list)
            let entry p.get_car()
            if entry.is_pair() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAnAlist(), name, 1, list)
            if entry.get_car() = obj
                return entry
            set p: p.get_cdr()
        }
        interp.make_false()
    }

    ; --- numeric core ------------------------------------------------------
    ; Accumulate args as exact-long while all operands are exact, promoting to
    ; double on the first inexact. Dimensions are not tracked in the starter
    ; set (numbers assumed dimensionless); length/quantity dims join later.
    ; a dimensioned arithmetic result (the DEFPRIMITIVE tails): exact — dim 0
    ; integer, dim 1 length, else promoted to an inexact quantity; inexact —
    ; dim 0 real, else quantity.
    function quantity_result(host: pointer[Page], is_double: bool, l: int, d: double, dim: int) returns pointer[ELObj]
    {
        if is_double = false
        {
            if dim = 0
                return ELObj.make_integer(host, l)
            if dim = 1
                return ELObj.make_length(host, l)
            return ELObj.make_quantity(host, l as double, dim)
        }
        if dim = 0
            return ELObj.make_real(host, d)
        ELObj.make_quantity(host, d, dim)
    }

    ; signed-64 overflow predicates (the reference's LONG_MIN/LONG_MAX
    ; guards); overflow promotes the accumulation to double.
    function add_overflows(a: int, b: int) returns bool
    {
        let maxv 0x7FFFFFFFFFFFFFFF
        let minv 0 - maxv - 1
        if b > 0
            return a > maxv - b
        if b < 0
            return a < minv - b
        false
    }

    function mul_overflows(a: int, b: int) returns bool
    {
        if (a = 0) or (b = 0)
            return false
        let maxv 0x7FFFFFFFFFFFFFFF
        let minv 0 - maxv - 1
        if a > 0
        {
            if b > 0
                return a > maxv / b
            return b < minv / a
        }
        if b > 0
            return a < minv / b
        a < maxv / b
    }

    ; the length-spec accumulation path of Plus/Minus (primitive.cxx `spec`
    ; branch): component-wise over the engine 3-vector; every plain-quantity
    ; operand must be dimension 1. `negate_rest` = Minus (args past the first
    ; subtract; a sole arg negates).
    function arith_spec(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location, negate_rest: bool) returns pointer[ELObj]
    {
        var v0 0.0
        var v1 0.0
        var v2 0.0
        var i 0
        while i < n_args
        {
            let a *(args + i)
            var minus false
            if negate_rest
            {
                if (i > 0) or (n_args = 1)
                    set minus: true
            }
            let lsp a.length_spec()
            if lsp <> null
            {
                if minus
                {
                    set v0: v0 - lsp.v0
                    set v1: v1 - lsp.v1
                    set v2: v2 - lsp.v2
                }
                else
                {
                    set v0: v0 + lsp.v0
                    set v1: v1 + lsp.v1
                    set v2: v2 + lsp.v2
                }
            }
            else
            {
                let qv a.quantity_value()
                if qv.get_qtype() = QT_NONE
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantityOrLengthSpec(), name, i, a)
                if qv.get_dim() <> 1
                    return Primitive.simple_error(interp, loc, InterpreterMessages.incompatibleDimensions())
                var d qv.get_dval()
                if qv.get_qtype() = QT_LONG
                    set d: qv.get_lval() as double
                if minus
                    set v0: v0 - d
                else
                    set v0: v0 + d
            }
            set i: i + 1
        }
        ELObj.make_length_spec(host, v0, v1, v2)
    }

    ; the length-spec scaling path of Multiply/Divide: only the FIRST arg may
    ; be a length-spec; the rest scale it as plain reals. QUIRK kept: the
    ; not-a-number error always reports argument 1 (argv[1]) whatever i is.
    function arith_spec_scale(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location, divide: bool) returns pointer[ELObj]
    {
        ; deref receiver bound first (the chained-call-on-deref miscompile).
        let a0 *args
        let lsp a0.length_spec()
        var v0 lsp.v0
        var v1 lsp.v1
        var v2 lsp.v2
        var i 1
        while i < n_args
        {
            let a *(args + i)
            if a.is_real() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notANumber(), name, 1, *(args + 1))
            let d a.real_value()
            if divide
            {
                if d = 0.0
                    return Primitive.simple_error(interp, loc, InterpreterMessages.divideBy0())
                set v0: v0 / d
                set v1: v1 / d
                set v2: v2 / d
            }
            else
            {
                set v0: v0 * d
                set v1: v1 * d
                set v2: v2 * d
            }
            set i: i + 1
        }
        ELObj.make_length_spec(host, v0, v1, v2)
    }

    ; Plus (primitive.cxx): all args must share ONE dimension
    ; (incompatibleDimensions otherwise); exact stays exact unless an inexact
    ; arg or overflow promotes. A length-spec operand diverts the whole sum
    ; onto the spec path (dimension checks of the scanned prefix included).
    function arith_add(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        if n_args = 0
            return ELObj.make_integer(host, 0)
        let a0 *args
        let qv0 a0.quantity_value()
        if qv0.get_qtype() = QT_NONE
            return Primitive.arith_spec(host, interp, name, args, n_args, loc, false)
        var is_double qv0.get_qtype() = QT_DOUBLE
        let dim qv0.get_dim()
        var lsum qv0.get_lval()
        var dsum qv0.get_dval()
        var i 1
        while i < n_args
        {
            let a *(args + i)
            let qv a.quantity_value()
            let qt qv.get_qtype()
            if qt = QT_NONE
            {
                ; the reference sets dim2 = 1, checks it against dim, then
                ; re-scans everything on the spec path.
                if dim <> 1
                    return Primitive.simple_error(interp, loc, InterpreterMessages.incompatibleDimensions())
                return Primitive.arith_spec(host, interp, name, args, n_args, loc, false)
            }
            if qv.get_dim() <> dim
                return Primitive.simple_error(interp, loc, InterpreterMessages.incompatibleDimensions())
            if qt = QT_DOUBLE
            {
                if is_double = false
                {
                    set dsum: lsum as double
                    set is_double: true
                }
                set dsum: dsum + qv.get_dval()
            }
            else
            {
                if is_double
                    set dsum: dsum + (qv.get_lval() as double)
                else
                {
                    if Primitive.add_overflows(lsum, qv.get_lval())
                    {
                        set dsum: (lsum as double) + (qv.get_lval() as double)
                        set is_double: true
                    }
                    else
                        set lsum: lsum + qv.get_lval()
                }
            }
            set i: i + 1
        }
        Primitive.quantity_result(host, is_double, lsum, dsum, dim)
    }

    ; Multiply (primitive.cxx): dimensions ADD; an exact product whose
    ; dimension exceeds 1 (or overflows) is promoted to an inexact quantity.
    function arith_mul(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        if n_args = 0
            return ELObj.make_integer(host, 1)
        let a0 *args
        let qv0 a0.quantity_value()
        if qv0.get_qtype() = QT_NONE
        {
            ; a leading length-spec scales by the remaining reals.
            if a0.length_spec() <> null
                return Primitive.arith_spec_scale(host, interp, name, args, n_args, loc, false)
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, 0, a0)
        }
        var is_double qv0.get_qtype() = QT_DOUBLE
        var dim qv0.get_dim()
        var lprod qv0.get_lval()
        var dprod qv0.get_dval()
        var i 1
        while i < n_args
        {
            let a *(args + i)
            let qv a.quantity_value()
            if qv.get_qtype() = QT_NONE
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, i, a)
            set dim: dim + qv.get_dim()
            if qv.get_qtype() = QT_DOUBLE
            {
                if is_double = false
                {
                    set dprod: lprod as double
                    set is_double: true
                }
                set dprod: dprod * qv.get_dval()
            }
            else
            {
                if is_double
                    set dprod: dprod * (qv.get_lval() as double)
                else
                {
                    ; the reference forces exact results past dim 1 inexact
                    ; (lengths are inexact millipoints).
                    if (dim > 1) or Primitive.mul_overflows(lprod, qv.get_lval())
                    {
                        set dprod: (lprod as double) * (qv.get_lval() as double)
                        set is_double: true
                    }
                    else
                        set lprod: lprod * qv.get_lval()
                }
            }
            set i: i + 1
        }
        Primitive.quantity_result(host, is_double, lprod, dprod, dim)
    }

    ; Minus (primitive.cxx): like Plus — one shared dimension; a length-spec
    ; operand diverts onto the spec path (later args subtract; a sole arg
    ; negates).
    function arith_sub(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        let qv0 a0.quantity_value()
        if qv0.get_qtype() = QT_NONE
            return Primitive.arith_spec(host, interp, name, args, n_args, loc, true)
        var is_double qv0.get_qtype() = QT_DOUBLE
        let dim qv0.get_dim()
        var lacc qv0.get_lval()
        var dacc qv0.get_dval()
        if is_double = false
            set dacc: lacc as double
        if n_args = 1
        {
            if is_double
                return Primitive.quantity_result(host, true, 0, 0.0 - dacc, dim)
            return Primitive.quantity_result(host, false, 0 - lacc, 0.0, dim)
        }
        var i 1
        while i < n_args
        {
            let a *(args + i)
            let qv a.quantity_value()
            if qv.get_qtype() = QT_NONE
            {
                if dim <> 1
                    return Primitive.simple_error(interp, loc, InterpreterMessages.incompatibleDimensions())
                return Primitive.arith_spec(host, interp, name, args, n_args, loc, true)
            }
            if qv.get_dim() <> dim
                return Primitive.simple_error(interp, loc, InterpreterMessages.incompatibleDimensions())
            if qv.get_qtype() = QT_DOUBLE
            {
                if is_double = false
                {
                    set dacc: lacc as double
                    set is_double: true
                }
                set dacc: dacc - qv.get_dval()
            }
            else
            {
                if is_double
                    set dacc: dacc - (qv.get_lval() as double)
                else
                {
                    if Primitive.add_overflows(lacc, 0 - qv.get_lval())
                    {
                        set dacc: (lacc as double) - (qv.get_lval() as double)
                        set is_double: true
                    }
                    else
                        set lacc: lacc - qv.get_lval()
                }
            }
            set i: i + 1
        }
        Primitive.quantity_result(host, is_double, lacc, dacc, dim)
    }

    ; Divide (primitive.cxx): dimensions SUBTRACT; an exact quotient stays
    ; exact only for dimensionless divisors that divide evenly (dividing BY a
    ; dimensioned quantity — lengths are inexact — promotes to double).
    function arith_div(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        let qv0 a0.quantity_value()
        if qv0.get_qtype() = QT_NONE
        {
            ; a leading length-spec divides by the remaining reals (multi-arg
            ; form only, like the reference).
            if n_args > 1
            {
                if a0.length_spec() <> null
                    return Primitive.arith_spec_scale(host, interp, name, args, n_args, loc, true)
            }
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, 0, a0)
        }
        var dim qv0.get_dim()
        var acc qv0.get_dval()
        if qv0.get_qtype() <> QT_DOUBLE
            set acc: qv0.get_lval() as double
        if n_args = 1
        {
            if acc = 0.0
                return Primitive.simple_error(interp, loc, InterpreterMessages.divideBy0())
            return Primitive.quantity_result(host, true, 0, 1.0 / acc, 0 - dim)
        }
        var is_double qv0.get_qtype() = QT_DOUBLE
        var lnum qv0.get_lval()
        var i 1
        while i < n_args
        {
            let a *(args + i)
            let qv a.quantity_value()
            if qv.get_qtype() = QT_NONE
                ; reference quirk: the Divide loop reports argument 0/argv[0].
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, 0, a0)
            var d qv.get_dval()
            if qv.get_qtype() <> QT_DOUBLE
                set d: qv.get_lval() as double
            if d = 0.0
                return Primitive.simple_error(interp, loc, InterpreterMessages.divideBy0())
            set dim: dim - qv.get_dim()
            set acc: acc / d
            if qv.get_qtype() = QT_DOUBLE
                set is_double: true
            else
            {
                if (is_double = false) and (qv.get_dim() = 0) and ((lnum % qv.get_lval()) = 0)
                    set lnum: lnum / qv.get_lval()
                else
                    set is_double: true
            }
            set i: i + 1
        }
        Primitive.quantity_result(host, is_double, lnum, acc, dim)
    }

    ; op: 0 =, 1 <, 2 >, 3 <=, 4 >=. Chain comparison over adjacent operands.
    function compare(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location, op: int) returns pointer[ELObj]
    {
        var i 0
        while i < n_args - 1
        {
            let ea *(args + i)
            let eb *(args + i + 1)
            let a ea.quantity_value()
            let b eb.quantity_value()
            let aqt a.get_qtype()
            let bqt b.get_qtype()
            if aqt = QT_NONE
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, i, ea)
            if bqt = QT_NONE
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, i + 1, eb)
            var av a.get_dval()
            if aqt <> QT_DOUBLE
                set av: a.get_lval() as double
            var bv b.get_dval()
            if bqt <> QT_DOUBLE
                set bv: b.get_lval() as double
            var ok false
            if op = 0
                set ok: av = bv
            else if op = 1
                set ok: av < bv
            else if op = 2
                set ok: av > bv
            else if op = 3
                set ok: av <= bv
            else
                set ok: av >= bv
            if ok = false
                return interp.make_false()
            set i: i + 1
        }
        interp.make_true()
    }

    ; test: 0 zero?, 1 positive?, 2 negative?.
    function sign_test(interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location, test: int) returns pointer[ELObj]
    {
        let qv obj.quantity_value()
        if qv.get_qtype() = QT_NONE
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, 0, obj)
        var v qv.get_dval()
        if qv.get_qtype() <> QT_DOUBLE
            set v: qv.get_lval() as double
        if test = 0
            return interp.make_bool(v = 0.0)
        if test = 1
            return interp.make_bool(v > 0.0)
        interp.make_bool(v < 0.0)
    }

    ; parity: 1 odd?, 0 even?.
    function parity_test(interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location, want_odd: int) returns pointer[ELObj]
    {
        if obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnInteger(), name, 0, obj)
        let n obj.exact_integer_value()
        let r n % 2
        if want_odd = 1
            return interp.make_bool(r <> 0)
        interp.make_bool(r = 0)
    }

    function abs_val(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        let qv obj.quantity_value()
        if qv.get_qtype() = QT_NONE
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAQuantity(), name, 0, obj)
        if qv.get_qtype() = QT_DOUBLE
        {
            var d qv.get_dval()
            if d < 0.0
                set d: 0.0 - d
            return ELObj.make_real(host, d)
        }
        var n qv.get_lval()
        if n < 0
            set n: 0 - n
        ELObj.make_integer(host, n)
    }

    ; op: 0 modulo, 1 remainder, 2 quotient.
    function int_div(host: pointer[Page], interp: pointer[Interpreter], name: StringC, a: pointer[ELObj], b: pointer[ELObj], loc: Location, op: int) returns pointer[ELObj]
    {
        if a.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 0, a)
        if b.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, b)
        let x a.exact_integer_value()
        let y b.exact_integer_value()
        if y = 0
            return Primitive.simple_error(interp, loc, InterpreterMessages.divideBy0())
        if op = 2
            return ELObj.make_integer(host, x / y)
        let r x % y
        if op = 1
            return ELObj.make_integer(host, r)
        ; modulo: result takes the sign of the divisor
        var m r
        if (m <> 0) and (((m < 0) and (y > 0)) or ((m > 0) and (y < 0)))
            set m: m + y
        ELObj.make_integer(host, m)
    }

    ; --- string primitives -------------------------------------------------
    ; string-append: concatenate the string-data of every argument.
    function string_append(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        var total: size_t 0
        var i 0
        while i < n_args
        {
            let a *(args + i)
            let sz a.string_size()
            if sz < (0 as i64)
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, i, a)
            set total: total + (sz as size_t)
            set i: i + 1
        }
        ; a big result becomes a rope (StrCatObj) instead of materializing:
        ; the generator corpus nests appends ($-trees), and eager copies
        ; retain O(depth × bytes) in the eval region — the reference reclaims
        ; those intermediates with the GC. Small results materialize exactly
        ; as before (flat path below).
        if total > (0x100 as size_t)
        {
            let parts Array[pointer[ELObj]]^host()
            var j 0
            while j < n_args
            {
                let a *(args + j)
                let sz a.string_size()
                if sz > (0 as i64)
                    parts.add(a)
                set j: j + 1
            }
            return ELObj.make_strcat(host, parts, total)
        }
        if total = (0 as size_t)
            return ELObj.make_string(host, StringC())
        let buf host.allocate(total * (sizeof u32), alignof u32) as pointer[u32]
        var off: size_t 0
        var j 0
        while j < n_args
        {
            let a *(args + j)
            let s a.string_data(host)
            let m s.get_size()
            var k: size_t 0
            while k < m
            {
                set *(buf + off): s.get(k)
                set off: off + 1
                set k: k + 1
            }
            set j: j + 1
        }
        ELObj.make_string(host, StringC(buf, total))
    }

    function string_ref(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], k_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, obj)
        if k_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, k_obj)
        let s obj.string_data(host)
        let k k_obj.exact_integer_value()
        if (k < 0) or ((k as size_t) >= s.get_size())
            return Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
        ELObj.make_char(host, s.get(k as size_t))
    }

    function substring(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], s_obj: pointer[ELObj], e_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, obj)
        if s_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, s_obj)
        if e_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 2, e_obj)
        let s obj.string_data(host)
        let start s_obj.exact_integer_value()
        let end e_obj.exact_integer_value()
        if (start < 0) or (end < start) or ((end as size_t) > s.get_size())
            return Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
        ELObj.make_string(host, s.substr(start as size_t, (end - start) as size_t))
    }

    ; string: build a string from char arguments.
    function string_from_chars(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        if n_args = 0
            return ELObj.make_string(host, StringC())
        let buf host.allocate((n_args as size_t) * (sizeof u32), alignof u32) as pointer[u32]
        var i 0
        while i < n_args
        {
            let a *(args + i)
            if a.is_char_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAChar(), name, i, a)
            set *(buf + (i as size_t)): a.char_value() as u32
            set i: i + 1
        }
        ELObj.make_string(host, StringC(buf, n_args as size_t))
    }

    ; mode: 0 string=?, 1 string<?, 2 string<=?.
    function string_compare(interp: pointer[Interpreter], name: StringC, a: pointer[ELObj], b: pointer[ELObj], loc: Location, mode: int) returns pointer[ELObj]
    {
        let host interp.get_host()
        if a.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a)
        if b.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 1, b)
        let s1 a.string_data(host)
        let s2 b.string_data(host)
        let n1 s1.get_size()
        let n2 s2.get_size()
        if mode = 0
        {
            if n1 <> n2
                return interp.make_false()
            var i: size_t 0
            while i < n1
            {
                if s1.get(i) <> s2.get(i)
                    return interp.make_false()
                set i: i + 1
            }
            return interp.make_true()
        }
        var minlen n1
        if n2 < n1
            set minlen: n2
        var i: size_t 0
        while i < minlen
        {
            let c1 s1.get(i)
            let c2 s2.get(i)
            if c1 < c2
                return interp.make_true()
            if c1 > c2
                return interp.make_false()
            set i: i + 1
        }
        if mode = 1
            return interp.make_bool(n1 < n2)
        interp.make_bool(n1 <= n2)
    }

    function string_to_list(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, obj)
        let s obj.string_data(host)
        var result interp.make_nil()
        var i s.get_size()
        while i > (0 as size_t)
        {
            set i: i - 1
            set result: ELObj.make_pair(host, ELObj.make_char(host, s.get(i)), result)
        }
        result
    }

    function list_to_string(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        ; count chars first
        var n: size_t 0
        var p obj
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 0, obj)
            let car p.get_car()
            if car.is_char_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notACharList(), name, 0, obj)
            set n: n + 1
            set p: p.get_cdr()
        }
        if n = (0 as size_t)
            return ELObj.make_string(host, StringC())
        let buf host.allocate(n * (sizeof u32), alignof u32) as pointer[u32]
        var i: size_t 0
        set p: obj
        while (p <> null) and (p.is_nil() = false)
        {
            let car p.get_car()
            set *(buf + i): car.char_value() as u32
            set i: i + 1
            set p: p.get_cdr()
        }
        ELObj.make_string(host, StringC(buf, n))
    }

    ; string->number: parse in the given radix (default 10). Non-numeric → #f.
    function string_to_number(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        if a0.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
        var radix 10
        if n_args > 1
        {
            let a1 *(args + 1)
            if a1.is_exact_integer() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, a1)
            let r a1.exact_integer_value()
            if (r = 2) or (r = 8) or (r = 10) or (r = 16)
                set radix: r
            else
            {
                ; invalid radix: report and continue with 10 (StringToNumber)
                interp.set_next_location(loc)
                interp.message0(InterpreterMessages.invalidRadix())
                set radix: 10
            }
        }
        let s a0.string_data(host)
        let n s.get_size()
        if n = (0 as size_t)
            return interp.make_false()
        ; radix-10 with a '.'/'e'/'E' → parse as a real
        if radix = 10
        {
            var is_real false
            var i: size_t 0
            while i < n
            {
                let c s.get(i)
                if (c = (0x2E as u32)) or (c = (0x65 as u32)) or (c = (0x45 as u32))
                    set is_real: true
                set i: i + 1
            }
            if is_real
                return Primitive.parse_real(host, interp, s)
        }
        Primitive.parse_integer(host, interp, s, radix)
    }

    function parse_integer(host: pointer[Page], interp: pointer[Interpreter], s: StringC, radix: int) returns pointer[ELObj]
    {
        let n s.get_size()
        var i: size_t 0
        var neg false
        let first s.get(0 as size_t)
        if first = (0x2D as u32)
        {
            set neg: true
            set i: 1 as size_t
        }
        else if first = (0x2B as u32)
            set i: 1 as size_t
        if i >= n
            return interp.make_false()
        var acc 0
        while i < n
        {
            let c s.get(i)
            var d 0 - 1
            if (c >= (0x30 as u32)) and (c <= (0x39 as u32))
                set d: (c - (0x30 as u32)) as int
            else if (c >= (0x61 as u32)) and (c <= (0x7A as u32))
                set d: (c - (0x61 as u32)) as int + 10
            else if (c >= (0x41 as u32)) and (c <= (0x5A as u32))
                set d: (c - (0x41 as u32)) as int + 10
            if (d < 0) or (d >= radix)
                return interp.make_false()
            set acc: acc * radix + d
            set i: i + 1
        }
        if neg
            set acc: 0 - acc
        ELObj.make_integer(host, acc)
    }

    function parse_real(host: pointer[Page], interp: pointer[Interpreter], s: StringC) returns pointer[ELObj]
    {
        let n s.get_size()
        ; build a NUL-terminated ASCII byte buffer for strtod
        let buf host.allocate(n + (1 as size_t), 1 as size_t) as pointer[u8]
        var i: size_t 0
        while i < n
        {
            set *(buf + i): s.get(i) as u8
            set i: i + 1
        }
        set *(buf + n): 0 as u8
        var endp: pointer[u8] null
        let v strtod(buf as pointer[const_char], &endp)
        ; reject if not all consumed
        if endp <> (buf + n)
            return interp.make_false()
        ELObj.make_real(host, v)
    }

    ; number->string: print with radix (2/8/10/16 only; else radix 10).
    function number_to_string(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        if a0.is_number() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANumber(), name, 0, a0)
        var radix 10
        if n_args > 1
        {
            let a1 *(args + 1)
            if a1.is_exact_integer() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, a1)
            let r a1.exact_integer_value()
            if (r = 2) or (r = 8) or (r = 10) or (r = 16)
                set radix: r
            else
            {
                ; invalid radix: report and continue with 10 (NumberToString)
                interp.set_next_location(loc)
                interp.message0(InterpreterMessages.invalidRadix())
                set radix: 10
            }
        }
        let os OutputCharStream.make(host)
        a0.print_radix(os, radix as u32, interp.get_units_per_inch())
        ELObj.make_string(host, os.to_string_c(host))
    }

    ; --- char primitives ---------------------------------------------------
    function integer_to_char(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 0, obj)
        let n obj.exact_integer_value()
        if (n < 0) or (n > 0x10FFFF)
            return Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
        ELObj.make_char(host, n as u32)
    }

    ; mode: 0 char=?, 1 char<?, 2 char<=?.
    function char_compare(interp: pointer[Interpreter], name: StringC, a: pointer[ELObj], b: pointer[ELObj], loc: Location, mode: int) returns pointer[ELObj]
    {
        if a.is_char_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAChar(), name, 0, a)
        if b.is_char_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAChar(), name, 1, b)
        let c1 a.char_value()
        let c2 b.char_value()
        if mode = 0
            return interp.make_bool(c1 = c2)
        if mode = 1
            return interp.make_bool(c1 < c2)
        interp.make_bool(c1 <= c2)
    }

    ; char-upcase / char-downcase — GETCURLANG: the declared default language's
    ; case tables (define-language pairs; miss = identity — sf latin1 folds the
    ; umlauts). Without a declared language the reference errors
    ; noCurrentLanguage; the pre-language ASCII fold is kept as the fallback
    ; instead (a deliberate, marked deviation: the smoke stylesheets and the
    ; unit suite fold ASCII without declaring a language).
    function char_case(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location, up: bool) returns pointer[ELObj]
    {
        if obj.is_char_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAChar(), name, 0, obj)
        var c obj.char_value()
        let lang interp.get_default_language()
        if lang <> null
            set c: lang.language_case(c as u32, up) as int
        else if up
        {
            if (c >= 0x61) and (c <= 0x7A)
                set c: c - 0x20
        }
        else
        {
            if (c >= 0x41) and (c <= 0x5A)
                set c: c + 0x20
        }
        ELObj.make_char(host, c as u32)
    }

    ; --- vector primitives -------------------------------------------------
    function make_vector_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        if a0.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 0, a0)
        let k a0.exact_integer_value()
        if k < 0
            return Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
        var fill interp.make_unspecified()
        if n_args > 1
            set fill: *(args + 1)
        ELObj.make_vector(host, k as size_t, fill)
    }

    function vector_ref(interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], k_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.is_vector_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAVector(), name, 0, obj)
        if k_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, k_obj)
        let k k_obj.exact_integer_value()
        if (k < 0) or ((k as size_t) >= obj.vector_length())
            return Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
        obj.vector_elem(k as size_t)
    }

    function vector_set(interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], k_obj: pointer[ELObj], val: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.is_vector_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAVector(), name, 0, obj)
        if k_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, k_obj)
        let k k_obj.exact_integer_value()
        if (k < 0) or ((k as size_t) >= obj.vector_length())
            return Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
        obj.vector_set_elem(k as size_t, val)
        interp.make_unspecified()
    }

    function vector_to_list(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if obj.is_vector_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAVector(), name, 0, obj)
        var result interp.make_nil()
        var i obj.vector_length()
        while i > (0 as size_t)
        {
            set i: i - 1
            set result: ELObj.make_pair(host, obj.vector_elem(i), result)
        }
        result
    }

    function list_to_vector(host: pointer[Page], interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        var n: size_t 0
        var p obj
        while (p <> null) and (p.is_nil() = false)
        {
            if p.is_pair() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 0, obj)
            set n: n + 1
            set p: p.get_cdr()
        }
        let vec ELObj.make_vector(host, n, interp.make_false())
        var i: size_t 0
        set p: obj
        while (p <> null) and (p.is_nil() = false)
        {
            vec.vector_set_elem(i, p.get_car())
            set i: i + 1
            set p: p.get_cdr()
        }
        vec
    }

    ; list-tail: drop the first k pairs.
    function list_tail(interp: pointer[Interpreter], name: StringC, obj: pointer[ELObj], k_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if k_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, k_obj)
        var k k_obj.exact_integer_value()
        if k < 0
            return Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
        var p obj
        while k > 0
        {
            if p.is_pair() = false
            {
                if p.is_nil()
                    return Primitive.simple_error(interp, loc, InterpreterMessages.outOfRange())
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAList(), name, 0, obj)
            }
            set p: p.get_cdr()
            set k: k - 1
        }
        p
    }

    ; --- grove / node-list helpers -----------------------------------------
    function node_list_ref(host: pointer[Page], interp: pointer[Interpreter], name: StringC, nl: pointer[ELObj], k_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, nl)
        if k_obj.is_exact_integer() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnExactInteger(), name, 1, k_obj)
        let k k_obj.exact_integer_value()
        if (k < 0) or (k >= nl.node_list_count())
            return ELObj.make_node_list(host, null, 0)
        ELObj.make_node_singleton(host, nl.node_list_node(k))
    }

    ; node-list: concatenate the argument node-lists into one buffer.
    function node_list_concat(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let arr Array[pointer[GroveNode]]^host()
        var i 0
        while i < n_args
        {
            let a *(args + i)
            if a.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, i, a)
            let c a.node_list_count()
            var j 0
            while j < c
            {
                arr.add(a.node_list_node(j))
                set j: j + 1
            }
            set i: i + 1
        }
        ELObj.make_node_list(host, arr, 0)
    }

    ; children: the child axis of the first node (empty if none / not present).
    ; children: DEFPRIMITIVE(Children) — a singleton yields the node's child
    ; list; a NON-singleton node-list maps `children` over every member and
    ; appends (the reference wraps itself in a MapNodeListObj), so nested
    ; `(children (children nl))` flattens across all members.
    function children(host: pointer[Page], interp: pointer[Interpreter], name: StringC, nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, nl)
        let n nl.node_list_count()
        if n = 0
            return nl
        if n = 1
        {
            let node nl.node_list_node(0)
            let ch node.get_children()
            if ch = null
                return ELObj.make_node_list(host, null, 0)
            return ELObj.make_node_list(host, ch, 0)
        }
        let result Array[pointer[GroveNode]]^host()
        var i 0
        while i < n
        {
            let node nl.node_list_node(i)
            if node <> null
            {
                let m node.child_count()
                var j 0
                while j < m
                {
                    let c node.child_at(j)
                    result.add(c)
                    set j: j + 1
                }
            }
            set i: i + 1
        }
        ELObj.make_node_list(host, result, 0)
    }

    ; gi: the generic identifier of the first node (an element), else #f.
    function node_gi(host: pointer[Page], interp: pointer[Interpreter], name: StringC, nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnOptSingletonNode(), name, 0, nl)
        let node nl.node_list_node(0)
        if node = null
            return interp.make_false()
        if node.get_class() <> GN_ELEMENT
            return interp.make_false()
        let g node.get_gi()
        ELObj.make_string(host, g)
    }

    ; data: the string value — the concatenated descendant data of EVERY
    ; member of the node list (DEFPRIMITIVE(Data) loops nodeListFirst/
    ; nodeListChunkRest, appending nodeData per node into ONE StringObj;
    ; the earlier first-node-only reading dropped the tail members of
    ; multi-<return> sprocs).
    function node_data(host: pointer[Page], interp: pointer[Interpreter], name: StringC, nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, nl)
        let n nl.node_list_count()
        var total: size_t 0
        var i 0
        while i < n
        {
            let node nl.node_list_node(i)
            if node <> null
                set total: total + Primitive.collect_data_len(node)
            set i: i + 1
        }
        if total = (0 as size_t)
            return ELObj.make_string(host, StringC())
        let buf host.allocate(total * (sizeof u32), alignof u32) as pointer[u32]
        var off: size_t 0
        var j 0
        while j < n
        {
            let node nl.node_list_node(j)
            if node <> null
                set off: Primitive.collect_data_fill(node, buf, off)
            set j: j + 1
        }
        ELObj.make_string(host, StringC(buf, total))
    }

    ; --- property axis (Inc 4) ---------------------------------------------
    ; A GI / attribute-name argument may arrive as a string or a symbol; both
    ; carry a name StringC (else empty). Single construction site + one tail
    ; return (a by-value struct returned from multiple branches region-allocates
    ; per site and the merging phi fails llc verification).
    function name_arg(host: pointer[Page], obj: pointer[ELObj]) returns StringC
    {
        var result StringC()
        if obj.is_string_p()
            set result: obj.string_data(host)
        else if obj.is_symbol_p()
            set result: obj.symbol_name()
        result
    }

    ; parent: the parent axis of the first node (empty for the grove root /
    ; a node with no parent).
    function node_parent(host: pointer[Page], interp: pointer[Interpreter], name: StringC, nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnOptSingletonNode(), name, 0, nl)
        let node nl.node_list_node(0)
        if node = null
            return ELObj.make_node_list(host, null, 0)
        let p node.get_parent()
        if p = null
            return ELObj.make_node_list(host, null, 0)
        ELObj.make_node_singleton(host, p)
    }

    ; attribute-string: the value of the named attribute on the first node of
    ; the node-list arg, as a string — or #f when the attribute is absent.
    ; Faithful to nodeAttributeString / DEFPRIMITIVE(AttributeString): read
    ; arg0 as the attribute name, look it up in the node's attribute list, and
    ; return its text. The reference's 1-arg (current-node) form needs a
    ; current-node context, not yet modeled here, so the node-list is required.
    ; Name lookup is AttrLookup.index_ci — the case-insensitive approximation
    ; of normalizeGeneralName for both namecase regimes (a lowercase name
    ; matches an upper-folded SGML grove AND an as-is XML grove).
    function attribute_string(host: pointer[Page], interp: pointer[Interpreter], name: StringC, name_obj: pointer[ELObj], nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if name_obj.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, name_obj)
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAnOptSingletonNode(), name, 1, nl)
        let node nl.node_list_node(0)
        if node = null
            return interp.make_false()
        let atts node.get_attributes()
        if atts = null
            return interp.make_false()
        let nm name_obj.string_data(host)
        let idx AttrLookup.index_ci(atts, nm)
        if idx < 0
            return interp.make_false()
        let v atts.value(idx as size_t)
        if v = null
            return interp.make_false()
        let t v.get_text()
        if t = null
            return interp.make_false()
        let s t.string()
        ELObj.make_string(host, s)
    }

    ; select-elements: the members of a node-list matching a pattern (a GI
    ; string/symbol, #t, or an ancestor/attribute-qualifier list). Faithful to
    ; DEFPRIMITIVE(SelectElements) — convertToPattern the 2nd arg, filter the
    ; node-list. (Inc 5: unblocked by the Pattern type.)
    function select_elements(host: pointer[Page], interp: pointer[Interpreter], name: StringC, nl: pointer[ELObj], pat_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, nl)
        let pat Pattern.convert(host, interp, pat_obj, loc)
        ; convertToPattern reports its own diagnostics in the reference;
        ; Pattern.convert messaging is that port's debt — mirror the bare
        ; makeError here (SelectElements).
        if pat = null
            return interp.make_error()
        let result Array[pointer[GroveNode]]^host()
        let n nl.node_list_count()
        var i 0
        while i < n
        {
            let node nl.node_list_node(i)
            if node <> null
            {
                if pat.matches(node)
                    result.add(node)
            }
            set i: i + 1
        }
        ELObj.make_node_list(host, result, 0)
    }

    ; element-with-id: the element in the grove whose ID-typed attribute equals
    ; the given string, as a singleton node-list (empty if none). DEFPRIMITIVE
    ; (ElementWithId): the optional 2nd arg names the grove to search — with a
    ; single run grove it is immaterial, so we resolve against the interpreter's
    ; installed grove ID index.
    function element_with_id(host: pointer[Page], interp: pointer[Interpreter], name: StringC, id_obj: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if id_obj.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, id_obj)
        let node interp.lookup_element_by_id(id_obj.string_data(host))
        let result Array[pointer[GroveNode]]^host()
        if node <> null
            result.add(node)
        ELObj.make_node_list(host, result, 0)
    }

    ; ancestor: the nearest ancestor element of the first node whose GI equals
    ; the given name, or the empty node-list. The GI compare is GiMatch —
    ; convertGeneralName normalizes the argument per the grove's namecase.
    function ancestor(host: pointer[Page], interp: pointer[Interpreter], name: StringC, gi_obj: pointer[ELObj], nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 1, nl)
        let node nl.node_list_node(0)
        if node = null
            return ELObj.make_node_list(host, null, 0)
        let target Primitive.name_arg(host, gi_obj)
        var cur node.get_parent()
        while cur <> null
        {
            if cur.get_class() = GN_ELEMENT
            {
                let g cur.get_gi()
                if GiMatch.equal(g, target)
                    return ELObj.make_node_singleton(host, cur)
            }
            set cur: cur.get_parent()
        }
        ELObj.make_node_list(host, null, 0)
    }

    ; descendants: every descendant, in document order (self excluded).
    ; DEFPRIMITIVE(Descendants) — like children, a non-singleton node-list
    ; maps itself over the members.
    function descendants(host: pointer[Page], interp: pointer[Interpreter], name: StringC, nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, nl)
        let n nl.node_list_count()
        if n = 0
            return nl
        let arr Array[pointer[GroveNode]]^host()
        var i 0
        while i < n
        {
            let node nl.node_list_node(i)
            if node <> null
                Primitive.collect_descendants(node, arr)
            set i: i + 1
        }
        ELObj.make_node_list(host, arr, 0)
    }

    function collect_descendants(node: pointer[GroveNode], arr: pointer[Array[pointer[GroveNode]]])
    {
        let n node.child_count()
        var i 0
        while i < n
        {
            let ch node.child_at(i)
            arr.add(ch)
            Primitive.collect_descendants(ch, arr)
            set i: i + 1
        }
    }

    ; id: the node's unique identifier — the value of its ID-typed attribute —
    ; or #f. DEFPRIMITIVE(Id): the optional arg is an opt-singleton node-list
    ; (an empty one yields #f); without it the current node, whose absence is
    ; the noCurrentNode error.
    function node_id(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        var node: pointer[GroveNode] null
        if n_args > 0
        {
            let a0 *args
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notAnOptSingletonNode(), name, 0, a0)
            set node: a0.node_list_node(0)
        }
        else
        {
            set node: ctx.get_current_node()
            if node = null
                return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
        }
        if node = null
            return interp.make_false()
        let atts node.get_attributes()
        if atts = null
            return interp.make_false()
        let sz atts.size()
        var i: size_t 0
        while i < sz
        {
            if atts.id(i)
            {
                let v atts.value(i)
                if v <> null
                {
                    let t v.get_text()
                    if t <> null
                    {
                        let s t.string()
                        return ELObj.make_string(host, s)
                    }
                }
            }
            set i: i + 1
        }
        interp.make_false()
    }

    ; The 0/1-arg singleton-node resolution shared by first-sibling? /
    ; last-sibling? / child-number (DEFPRIMITIVE arg handling: a present arg
    ; must resolve to a NON-empty singleton, absent means the current node).
    ; Returns null when an error object must be produced instead; err_kind
    ; distinguishes the two error shapes (0 = notASingletonNode on the arg,
    ; 1 = noCurrentNode).
    function singleton_node_arg(n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM]) returns pointer[GroveNode]
    {
        var node: pointer[GroveNode] null
        if n_args > 0
        {
            let a0 *args
            if a0.is_node_list_p()
                set node: a0.node_list_node(0)
        }
        else
            set node: ctx.get_current_node()
        node
    }

    ; first-sibling?: no preceding sibling element shares the node's GI.
    ; DEFPRIMITIVE(IsFirstSibling): a node whose GI is inaccessible (a
    ; non-element) is #f; siblings without a GI (data/pi chunks) are skipped.
    function is_first_sibling(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        if n_args > 0
        {
            let a0 *args
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 0, a0)
            if a0.node_list_node(0) = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 0, a0)
        }
        else if ctx.get_current_node() = null
            return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
        let node Primitive.singleton_node_arg(n_args, args, ctx)
        if node.get_class() <> GN_ELEMENT
            return interp.make_false()
        let par node.get_parent()
        if par = null
            return interp.make_false()
        let g node.get_gi()
        let n par.child_count()
        var i 0
        while i < n
        {
            let s par.child_at(i)
            if s = node
                return interp.make_true()
            if s.get_class() = GN_ELEMENT
            {
                let sg s.get_gi()
                if sg.equals(g)
                    return interp.make_false()
            }
            set i: i + 1
        }
        interp.make_true()
    }

    ; last-sibling?: no following sibling element shares the node's GI.
    ; DEFPRIMITIVE(IsLastSibling).
    function is_last_sibling(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        if n_args > 0
        {
            let a0 *args
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 0, a0)
            if a0.node_list_node(0) = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 0, a0)
        }
        else if ctx.get_current_node() = null
            return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
        let node Primitive.singleton_node_arg(n_args, args, ctx)
        if node.get_class() <> GN_ELEMENT
            return interp.make_false()
        let par node.get_parent()
        if par = null
            return interp.make_true()
        let g node.get_gi()
        let n par.child_count()
        var i 0
        var found false
        while i < n
        {
            let s par.child_at(i)
            if found
            {
                if s.get_class() = GN_ELEMENT
                {
                    let sg s.get_gi()
                    if sg.equals(g)
                        return interp.make_false()
                }
            }
            else if s = node
                set found: true
            set i: i + 1
        }
        interp.make_true()
    }

    ; child-number: the 1-based position of the node among the siblings with
    ; the same GI. DEFPRIMITIVE(ChildNumber) via NumberCache::childNumber
    ; (semantics without the cache): a GI-less node is #f, the document
    ; element (no parent) is 1, else 1 + the count of preceding same-GI
    ; sibling elements.
    function child_number(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        if n_args > 0
        {
            let a0 *args
            if a0.is_node_list_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 0, a0)
            if a0.node_list_node(0) = null
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 0, a0)
        }
        else if ctx.get_current_node() = null
            return Primitive.simple_error(interp, loc, InterpreterMessages.noCurrentNode())
        let node Primitive.singleton_node_arg(n_args, args, ctx)
        if node.get_class() <> GN_ELEMENT
            return interp.make_false()
        let par node.get_parent()
        if par = null
            return ELObj.make_integer(host, 1)
        let g node.get_gi()
        var count 0
        let n par.child_count()
        var i 0
        while i < n
        {
            let s par.child_at(i)
            if s = node
                return ELObj.make_integer(host, count + 1)
            if s.get_class() = GN_ELEMENT
            {
                let sg s.get_gi()
                if sg.equals(g)
                    set count: count + 1
            }
            set i: i + 1
        }
        ELObj.make_integer(host, count + 1)
    }

    ; node-list=?: the two node-lists contain identical nodes in identical
    ; order. DEFPRIMITIVE(IsNodeListEqual): node identity, pairwise.
    function node_list_equal(interp: pointer[Interpreter], name: StringC, a0: pointer[ELObj], a1: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if a0.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, a0)
        if a0 = a1
            return interp.make_true()
        if a1.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 1, a1)
        let n a0.node_list_count()
        if a1.node_list_count() <> n
            return interp.make_false()
        var i 0
        while i < n
        {
            if a0.node_list_node(i) <> a1.node_list_node(i)
                return interp.make_false()
            set i: i + 1
        }
        interp.make_true()
    }

    ; node-list-map: apply the procedure to each member (as a singleton) and
    ; append the resulting node-lists. DEFPRIMITIVE(NodeListMap) is lazy
    ; (MapNodeListObj); this eager equivalent mirrors mapNext exactly: an
    ; erroring call or a non-node-list result stops the mapping (the reference
    ; truncates the lazy list — it does NOT yield an error object), the
    ; non-node-list case additionally reporting returnNotNodeList.
    function node_list_map(host: pointer[Page], interp: pointer[Interpreter], name: StringC, f: pointer[ELObj], nl: pointer[ELObj], ctx: pointer[VM], loc: Location) returns pointer[ELObj]
    {
        if f.is_function() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAProcedure(), name, 0, f)
        if f.n_required_args() > 1
            return Primitive.simple_error(interp, loc, InterpreterMessages.missingArg())
        if ((f.n_required_args() + f.n_optional_args()) = 0) and (f.has_rest_arg() = false)
            return Primitive.simple_error(interp, loc, InterpreterMessages.tooManyArgs())
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 1, nl)
        let result Array[pointer[GroveNode]]^host()
        let n nl.node_list_count()
        var i 0
        while i < n
        {
            let node nl.node_list_node(i)
            if node <> null
            {
                ; each member call runs under its own scratch region (the
                ; eval-bracket shape): only GroveNode POINTERS survive into
                ; `result` (grove-hosted, stable) — the fresh VM, its stacks,
                ; the call insn and every transient of f's body die here.
                ; Mirrors mapNext's per-call `VM vm(context, interp)` whose
                ; garbage the reference GC reclaims.
                let saved_region interp.get_eval_region()
                let mparent interp.get_host()
                let scratch mparent.allocate_exclusive_page()
                interp.set_eval_region(scratch)
                let mhost interp.get_host()
                let single ELObj.make_node_singleton(mhost, node)
                let mvm VM.make(mhost, interp)
                let cn ctx.get_current_node()
                mvm.set_current_node(cn)
                ; EvalContext carries over (the reference constructs the
                ; per-call VM FROM the outer context) — mode included.
                mvm.set_processing_mode(ctx.get_processing_mode())
                let insn f.make_call_insn(1, interp, loc, null)
                let ret mvm.eval(insn, null, single)
                var stop false
                if interp.is_error(ret)
                    set stop: true
                else if ret.is_node_list_p() = false
                {
                    interp.set_next_location(loc)
                    interp.message0(InterpreterMessages.returnNotNodeList())
                    set stop: true
                }
                else
                {
                    let m ret.node_list_count()
                    var j 0
                    while j < m
                    {
                        let rn ret.node_list_node(j)
                        if rn <> null
                            result.add(rn)
                        set j: j + 1
                    }
                }
                interp.set_eval_region(saved_region)
                mparent.deallocate_exclusive_page(scratch)
                if stop
                    return ELObj.make_node_list(host, result, 0)
            }
            set i: i + 1
        }
        ELObj.make_node_list(host, result, 0)
    }

    ; node-property: the named property of a singleton node (DEFPRIMITIVE
    ; NodeProperty), keyword args default:/null:/rcs? decoded per the
    ; reference decodeKeyArgs (first occurrence wins, odd count / non-keyword
    ; / unknown keyword are hard messages). Our grove has no ComponentName
    ; metamodel, so the NAME TABLE is the ported subset the real-world corpus
    ; reaches through the builtins wrappers: 'tree-root (builtins tree-root)
    ; and 'grove-root (builtins current-root). Reference semantics beyond the
    ; table: unknown name -> default: if given, else noNodePropertyValue +
    ; error; a null access prefers null:, then default:, then the message.
    ; tree-root mirrors ChunkNode::getTreeRoot: a node BELOW the document
    ; element yields THE document element; the document element itself (and
    ; any prolog node whose origin is the grove root) is a null access — the
    ; builtins default: (empty-node-list) covers it. (The reference's
    ; invalid-document epilog fallback to the grove root is not modeled.)
    function node_property(host: pointer[Page], interp: pointer[Interpreter], name: StringC, n_args: int, args: pointer[pointer[ELObj]], loc: Location) returns pointer[ELObj]
    {
        let prop_obj *args
        let cs prop_obj.convert_to_string(host)
        if cs = null
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAStringOrSymbol(), name, 0, prop_obj)
        let nl *(args + 1)
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 1, nl)
        let node nl.node_list_node(0)
        if node = null
            return Primitive.arg_error(interp, loc, InterpreterMessages.notASingletonNode(), name, 1, nl)
        ; --- decodeKeyArgs over args[2..] (pairs; reverse scan = first wins) --
        let n_rest n_args - 2
        if (n_rest & 1) = 1
        {
            interp.set_next_location(loc)
            interp.message0(InterpreterMessages.oddKeyArgs())
            return interp.make_error()
        }
        var dflt: pointer[ELObj] null
        var nullv: pointer[ELObj] null
        var i n_args - 1
        while i > 2
        {
            let kobj *(args + i - 1)
            if kobj.is_keyword_p() = false
            {
                interp.set_next_location(loc)
                interp.message0(InterpreterMessages.keyArgsNotKey())
                return interp.make_error()
            }
            let kn kobj.keyword_name()
            if kn.equals(StringC("default"))
                set dflt: *(args + i)
            else if kn.equals(StringC("null"))
                set nullv: *(args + i)
            else if kn.equals(StringC("rcs?"))
                0
            else
            {
                interp.set_next_location(loc)
                interp.message1(InterpreterMessages.invalidKeyArg(), kn)
                return interp.make_error()
            }
            set i: i - 2
        }
        ; --- the property table ------------------------------------------
        let pname cs.string_data(host)
        var known false
        var is_null false
        var result: pointer[ELObj] null
        if pname.equals(StringC("tree-root"))
        {
            set known: true
            let p node.get_parent()
            if p = null
                set is_null: true
            else if p.get_class() = GN_DOCUMENT
                set is_null: true
            else
            {
                var cur node
                var cp cur.get_parent()
                while cp <> null
                {
                    if cp.get_class() = GN_DOCUMENT
                        break
                    set cur: cp
                    set cp: cur.get_parent()
                }
                set result: ELObj.make_node_singleton(host, cur)
            }
        }
        else if pname.equals(StringC("grove-root"))
        {
            set known: true
            var cur node
            var cp cur.get_parent()
            while cp <> null
            {
                set cur: cp
                set cp: cur.get_parent()
            }
            set result: ELObj.make_node_singleton(host, cur)
        }
        else if pname.equals(StringC("origin"))
        {
            ; the node's origin = its parent node (builtins origin/rsiblings).
            set known: true
            let p node.get_parent()
            if p = null
                set is_null: true
            else
                set result: ELObj.make_node_singleton(host, p)
        }
        else if pname.equals(StringC("origin-to-subnode-rel-property-name"))
        {
            ; the property of the ORIGIN under which this node appears —
            ; our grove has one child axis, so every parented node reports
            ; "content" (rsiblings then reads (node-property "content"
            ; (origin snl)) and finds the node among its siblings).
            set known: true
            if node.get_parent() = null
                set is_null: true
            else
                set result: ELObj.make_string(host, StringC("content"))
        }
        else if pname.equals(StringC("content"))
        {
            ; the child list (the dynamic rel lookup rsiblings performs).
            set known: true
            let kids node.get_children()
            if kids = null
                set is_null: true
            else if kids.get_length() = (0 as size_t)
                set is_null: true
            else
            {
                let arr Array[pointer[GroveNode]]^host()
                var ki: size_t 0
                while ki < kids.get_length()
                {
                    arr.add(*(kids.get_buffer() + ki))
                    set ki: ki + (1 as size_t)
                }
                set result: ELObj.make_node_list(host, arr, 0)
            }
        }
        if known
        {
            if is_null = false
                return result
            if nullv <> null
                return nullv
        }
        if dflt <> null
            return dflt
        interp.set_next_location(loc)
        interp.message1(InterpreterMessages.noNodePropertyValue(), pname)
        interp.make_error()
    }

    ; node-list-reverse: the members in reverse order. NodeListObj::
    ; nodeListReverse (the lazy ReverseNodeListObj), eagerly.
    function node_list_reverse_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, nl: pointer[ELObj], loc: Location) returns pointer[ELObj]
    {
        if nl.is_node_list_p() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notANodeList(), name, 0, nl)
        let result Array[pointer[GroveNode]]^host()
        var i nl.node_list_count() - 1
        while i >= 0
        {
            let node nl.node_list_node(i)
            if node <> null
                result.add(node)
            set i: i - 1
        }
        ELObj.make_node_list(host, result, 0)
    }

    function collect_data_len(node: pointer[GroveNode]) returns size_t
    {
        if node = null
            return 0 as size_t
        if node.get_class() = GN_DATA
        {
            let c node.get_chars()
            return c.get_size()
        }
        var total: size_t 0
        let n node.child_count()
        var i 0
        while i < n
        {
            let ch node.child_at(i)
            set total: total + Primitive.collect_data_len(ch)
            set i: i + 1
        }
        total
    }

    ; sosofo-append: an append sosofo whose parts are the argument sosofos
    ; themselves (AppendSosofoObj holds the sosofos; process() walks them in
    ; order). Args are added directly — NOT flattened by their inner parts:
    ; a literal / process-children sosofo has no parts, so flattening would
    ; drop it.
    function sosofo_append(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let parts Array[pointer[ELObj]]^host()
        var i 0
        while i < n_args
        {
            let a *(args + i)
            if a.is_sosofo_p() = false
                return Primitive.arg_error(interp, loc, InterpreterMessages.notASosofo(), name, i, a)
            parts.add(a)
            set i: i + 1
        }
        ELObj.make_sosofo(host, parts)
    }

    ; --- display-space / inline-space / color (primitive.cxx + Style.cxx) ---

    ; the strict boolean of the keyword args (#t/#f identity — see
    ; convertBooleanC's trap).
    function strict_bool(val: pointer[ELObj], out: pointer[bool]) returns bool
    {
        if val.is_false()
        {
            set *out: false
            return true
        }
        if val.is_boolean_p()
        {
            set *out: true
            return true
        }
        false
    }

    function invalid_key_arg(interp: pointer[Interpreter], loc: Location, kname: StringC) returns pointer[ELObj]
    {
        interp.set_next_location(loc)
        interp.message1(InterpreterMessages.invalidKeyArg(), kname)
        interp.make_error()
    }

    ; DEFPRIMITIVE(DisplaySpace): nominal from arg 0, keyword args scanned
    ; BACKWARDS (first specified wins); odd trailing args -> oddKeyArgs.
    function display_space_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        var nominal LengthSpec()
        if Convert.convert_length_spec(a0, &nominal) = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notALengthSpec(), name, 0, a0)
        let ds DisplaySpace.make(host)
        set ds.nominal: nominal
        set ds.min: nominal
        set ds.max: nominal
        var i n_args - 1
        while i > 0
        {
            if (n_args & 1) = 0
                return Primitive.simple_error(interp, loc, InterpreterMessages.oddKeyArgs())
            let kobj *(args + (i - 1))
            if kobj.is_keyword_p() = false
                return Primitive.simple_error(interp, loc, InterpreterMessages.keyArgsNotKey())
            let kident kobj.keyword_ident()
            let a *(args + i)
            if kident.is_syntactic_key() = false
                return Primitive.invalid_key_arg(interp, loc, kident.get_name())
            let sk kident.syntactic_key()
            if sk = SK_MIN
            {
                var ls LengthSpec()
                if Convert.convert_length_spec(a, &ls) = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notALengthSpec(), name, i, a)
                set ds.min: ls
            }
            else if sk = SK_MAX
            {
                var ls LengthSpec()
                if Convert.convert_length_spec(a, &ls) = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notALengthSpec(), name, i, a)
                set ds.max: ls
            }
            else if sk = SK_IS_CONDITIONAL
            {
                var b false
                if Primitive.strict_bool(a, &b) = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notABoolean(), name, i, a)
                set ds.conditional: b
            }
            else if sk = SK_PRIORITY
            {
                if a.is_integer_p()
                {
                    set ds.priority: a.exact_integer_value()
                    set ds.force: false
                }
                else
                {
                    var is_force false
                    if a.is_symbol_p()
                    {
                        if a.symbol_c_value() = SYM_FORCE
                            set is_force: true
                    }
                    if is_force = false
                        return Primitive.arg_error(interp, loc, InterpreterMessages.notAPriority(), name, i, a)
                    set ds.force: true
                }
            }
            else
                return Primitive.invalid_key_arg(interp, loc, kident.get_name())
            set i: i - 2
        }
        ELObj.make_display_space(host, ds as pointer[void])
    }

    ; DEFPRIMITIVE(InlineSpace): like display-space with min:/max: only.
    function inline_space_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        var nominal LengthSpec()
        if Convert.convert_length_spec(a0, &nominal) = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notALengthSpec(), name, 0, a0)
        let sp InlineSpace.make(host)
        set sp.nominal: nominal
        set sp.min: nominal
        set sp.max: nominal
        var i n_args - 1
        while i > 0
        {
            if (n_args & 1) = 0
                return Primitive.simple_error(interp, loc, InterpreterMessages.oddKeyArgs())
            let kobj *(args + (i - 1))
            if kobj.is_keyword_p() = false
                return Primitive.simple_error(interp, loc, InterpreterMessages.keyArgsNotKey())
            let kident kobj.keyword_ident()
            let a *(args + i)
            if kident.is_syntactic_key() = false
                return Primitive.invalid_key_arg(interp, loc, kident.get_name())
            let sk kident.syntactic_key()
            if sk = SK_MIN
            {
                var ls LengthSpec()
                if Convert.convert_length_spec(a, &ls) = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notALengthSpec(), name, i, a)
                set sp.min: ls
            }
            else if sk = SK_MAX
            {
                var ls LengthSpec()
                if Convert.convert_length_spec(a, &ls) = false
                    return Primitive.arg_error(interp, loc, InterpreterMessages.notALengthSpec(), name, i, a)
                set sp.max: ls
            }
            else
                return Primitive.invalid_key_arg(interp, loc, kident.get_name())
            set i: i - 2
        }
        ELObj.make_inline_space(host, sp as pointer[void])
    }

    ; --- color spaces (DEFPRIMITIVE(ColorSpace) + Style.cxx makeColor) ------

    function color_space_message(interp: pointer[Interpreter], loc: Location, mt: MessageType, sname: pointer[const_char]) returns pointer[ELObj]
    {
        interp.set_next_location(loc)
        interp.message1(mt, StringC(sname))
        interp.make_error()
    }

    ; ascii compare of str[from..from+len) against a literal of exactly len.
    function str_part_is(s: StringC, from: size_t, lit: pointer[const_char]) returns bool
    {
        let n s.get_size()
        var i: size_t 0
        while true
        {
            let b *((lit as pointer[u8]) + i)
            if b = (0 as u8)
                break
            if (from + i) >= n
                return false
            if s.get(from + i) <> (b as u32)
                return false
            set i: i + 1
        }
        (from + i) = n
    }

    function color_space_prim(host: pointer[Page], interp: pointer[Interpreter], name: StringC, args: pointer[pointer[ELObj]], n_args: int, loc: Location) returns pointer[ELObj]
    {
        let a0 *args
        if a0.has_string_data() = false
            return Primitive.arg_error(interp, loc, InterpreterMessages.notAString(), name, 0, a0)
        let s a0.string_data(host)
        let n s.get_size()
        ; the reference compares the first 43 chars against the family prefix,
        ; then re-reads the tail from char 40 (after "Family::").
        var is_dev false
        var is_cie false
        if n >= (43 as size_t)
        {
            var prefix_ok true
            let fam StringC("ISO/IEC 10179:1996//Color-Space Family::")
            var i: size_t 0
            while i < (40 as size_t)
            {
                if s.get(i) <> fam.get(i)
                    set prefix_ok: false
                set i: i + 1
            }
            if prefix_ok
            {
                if (s.get(40 as size_t) = (0x44 as u32)) and (s.get(41 as size_t) = (0x65 as u32)) and (s.get(42 as size_t) = (0x76 as u32))
                    set is_dev: true
                if (s.get(40 as size_t) = (0x43 as u32)) and (s.get(41 as size_t) = (0x49 as u32)) and (s.get(42 as size_t) = (0x45 as u32))
                    set is_cie: true
            }
        }
        if is_dev
        {
            var kind 0 - 1
            var sname ""
            if Primitive.str_part_is(s, 40 as size_t, "Device RGB")
            {
                set kind: CS_RGB
                set sname: "Device RGB"
            }
            else if Primitive.str_part_is(s, 40 as size_t, "Device Gray")
            {
                set kind: CS_GRAY
                set sname: "Device Gray"
            }
            else if Primitive.str_part_is(s, 40 as size_t, "Device CMYK")
            {
                set kind: CS_CMYK
                set sname: "Device CMYK"
            }
            else if Primitive.str_part_is(s, 40 as size_t, "Device KX")
            {
                set kind: CS_KX
                set sname: "Device KX"
            }
            if kind < 0
            {
                interp.set_next_location(loc)
                interp.message1(InterpreterMessages.unknownColorSpaceFamily(), s)
                return interp.make_error()
            }
            if n_args > 1
                ; message only — the space is still returned (reference).
                Primitive.color_space_message(interp, loc, InterpreterMessages.colorSpaceNoArgs(), sname)
            return ELObj.make_color_space(host, kind, null)
        }
        if is_cie
        {
            var kind 0 - 1
            var sname ""
            if Primitive.str_part_is(s, 40 as size_t, "CIE LUV")
            {
                set kind: CS_LUV
                set sname: "CIE LUV"
            }
            else if Primitive.str_part_is(s, 40 as size_t, "CIE LAB")
            {
                set kind: CS_LAB
                set sname: "CIE LAB"
            }
            else if Primitive.str_part_is(s, 40 as size_t, "CIE Based ABC")
            {
                set kind: CS_ABC
                set sname: "CIE Based ABC"
            }
            else if Primitive.str_part_is(s, 40 as size_t, "CIE Based A")
            {
                set kind: CS_A
                set sname: "CIE Based A"
            }
            if kind >= 0
                return Primitive.make_cie_space(host, interp, kind, sname, args + 1, n_args - 1, loc)
        }
        interp.set_next_location(loc)
        interp.message1(InterpreterMessages.unknownColorSpaceFamily(), s)
        interp.make_error()
    }

    ; decodeNumVector: a list of exactly-readable numbers of length len.
    function decode_num_vector(res: pointer[double], len: int, obj: pointer[ELObj]) returns bool
    {
        var e obj
        var i 0
        while i < len
        {
            if e.is_pair() = false
                return false
            let car e.get_car()
            if car.is_real() = false
                return false
            set *(res + i): car.real_value()
            set e: e.get_cdr()
            set i: i + 1
        }
        true
    }

    function decode_func_vector(res: pointer[pointer[ELObj]], len: int, obj: pointer[ELObj]) returns bool
    {
        var e obj
        var i 0
        while i < len
        {
            if e.is_pair() = false
                return false
            let car e.get_car()
            if car.is_function() = false
                return false
            set *(res + i): car
            set e: e.get_cdr()
            set i: i + 1
        }
        true
    }

    ; decodeKeyArgs: pos[j] = value index (relative to args) of key j, -1 if
    ; absent; first occurrence wins (reverse scan). Messages fire here AND the
    ; caller adds colorSpaceArgError (reference double-message shape).
    function decode_key_args(argc: int, args: pointer[pointer[ELObj]], keys: pointer[int], n_keys: int, interp: pointer[Interpreter], loc: Location, pos: pointer[int]) returns bool
    {
        if (argc & 1) = 1
        {
            interp.set_next_location(loc)
            interp.message0(InterpreterMessages.oddKeyArgs())
            return false
        }
        var j 0
        while j < n_keys
        {
            set *(pos + j): 0 - 1
            set j: j + 1
        }
        var i argc - 1
        while i > 0
        {
            let kobj *(args + (i - 1))
            if kobj.is_keyword_p() = false
            {
                interp.set_next_location(loc)
                interp.message0(InterpreterMessages.keyArgsNotKey())
                return false
            }
            let kident kobj.keyword_ident()
            var found false
            if kident.is_syntactic_key()
            {
                let sk kident.syntactic_key()
                set j: 0
                while j < n_keys
                {
                    if sk = *(keys + j)
                    {
                        set *(pos + j): i
                        set found: true
                    }
                    set j: j + 1
                }
            }
            if found = false
            {
                interp.set_next_location(loc)
                interp.message1(InterpreterMessages.invalidKeyArg(), kident.get_name())
                return false
            }
            set i: i - 2
        }
        true
    }

    ; the CIE space constructors (primitive.cxx ColorSpace + Style.cxx ctors).
    ; keys order: white-point black-point range range-abc range-lmn range-a
    ; matrix-abc matrix-lmn matrix-a decode-abc decode-lmn decode-a.
    function make_cie_space(host: pointer[Page], interp: pointer[Interpreter], kind: int, sname: pointer[const_char], args: pointer[pointer[ELObj]], argc: int, loc: Location) returns pointer[ELObj]
    {
        let keys host.allocate(96, 8) as pointer[int]
        set *keys: SK_WHITE_POINT
        set *(keys + 1): SK_BLACK_POINT
        set *(keys + 2): SK_RANGE
        set *(keys + 3): SK_RANGE_ABC
        set *(keys + 4): SK_RANGE_LMN
        set *(keys + 5): SK_RANGE_A
        set *(keys + 6): SK_MATRIX_ABC
        set *(keys + 7): SK_MATRIX_LMN
        set *(keys + 8): SK_MATRIX_A
        set *(keys + 9): SK_DECODE_ABC
        set *(keys + 10): SK_DECODE_LMN
        set *(keys + 11): SK_DECODE_A
        let pos host.allocate(96, 8) as pointer[int]
        var wp double[3]
        var bp double[3]
        var range double[6]
        var range_abc double[6]
        var range_lmn double[6]
        var range_a double[2]
        var matrix_abc double[9]
        var matrix_lmn double[9]
        var matrix_a double[3]
        var decode_abc pointer[ELObj][3]
        var decode_lmn pointer[ELObj][3]
        var decode_a: pointer[ELObj] null
        var ok Primitive.decode_key_args(argc, args, keys, 12, interp, loc, pos)
        if ok
        {
            if *pos < 0
                set ok: false
        }
        if ok
        {
            if Primitive.decode_num_vector(wp as pointer[double], 3, *(args + *pos)) = false
                set ok: false
        }
        if ok
        {
            if *(pos + 1) >= 0
            {
                if Primitive.decode_num_vector(bp as pointer[double], 3, *(args + *(pos + 1))) = false
                    set ok: false
            }
        }
        if ok
        {
            if *(pos + 2) >= 0
            {
                if Primitive.decode_num_vector(range as pointer[double], 6, *(args + *(pos + 2))) = false
                    set ok: false
            }
        }
        if ok
        {
            if *(pos + 3) >= 0
            {
                if Primitive.decode_num_vector(range_abc as pointer[double], 6, *(args + *(pos + 3))) = false
                    set ok: false
            }
        }
        if ok
        {
            if *(pos + 4) >= 0
            {
                if Primitive.decode_num_vector(range_lmn as pointer[double], 6, *(args + *(pos + 4))) = false
                    set ok: false
            }
        }
        if ok
        {
            if *(pos + 5) >= 0
            {
                if Primitive.decode_num_vector(range_a as pointer[double], 2, *(args + *(pos + 5))) = false
                    set ok: false
            }
        }
        if ok
        {
            if *(pos + 6) >= 0
            {
                if Primitive.decode_num_vector(matrix_abc as pointer[double], 9, *(args + *(pos + 6))) = false
                    set ok: false
            }
        }
        if ok
        {
            if *(pos + 7) >= 0
            {
                if Primitive.decode_num_vector(matrix_lmn as pointer[double], 9, *(args + *(pos + 7))) = false
                    set ok: false
            }
        }
        if ok
        {
            if *(pos + 8) >= 0
            {
                if Primitive.decode_num_vector(matrix_a as pointer[double], 3, *(args + *(pos + 8))) = false
                    set ok: false
            }
        }
        if ok
        {
            if *(pos + 9) >= 0
            {
                if Primitive.decode_func_vector(decode_abc as pointer[pointer[ELObj]], 3, *(args + *(pos + 9))) = false
                    set ok: false
            }
        }
        if ok
        {
            if *(pos + 10) >= 0
            {
                if Primitive.decode_func_vector(decode_lmn as pointer[pointer[ELObj]], 3, *(args + *(pos + 10))) = false
                    set ok: false
            }
        }
        if ok
        {
            if *(pos + 11) >= 0
            {
                let fa *(args + *(pos + 11))
                if fa.is_function()
                    set decode_a: fa
                else
                    set ok: false
            }
        }
        if ok
        {
            ; per-kind forbidden keys (colorSpaceArgError like the arg errors).
            if (kind = CS_LUV) or (kind = CS_LAB)
            {
                var j 3
                while j < 12
                {
                    if *(pos + j) >= 0
                        set ok: false
                    set j: j + 1
                }
            }
            if kind = CS_ABC
            {
                if *(pos + 2) >= 0
                    set ok: false
                if *(pos + 5) >= 0
                    set ok: false
                if *(pos + 8) >= 0
                    set ok: false
                if *(pos + 11) >= 0
                    set ok: false
            }
            if kind = CS_A
            {
                if *(pos + 2) >= 0
                    set ok: false
                if *(pos + 3) >= 0
                    set ok: false
                if *(pos + 6) >= 0
                    set ok: false
                if *(pos + 9) >= 0
                    set ok: false
            }
        }
        if ok = false
            return Primitive.color_space_message(interp, loc, InterpreterMessages.colorSpaceArgError(), sname)
        let d CieData.make(host)
        set d.xyz: Primitive.xyz_data(host, wp as pointer[double])
        if (kind = CS_LUV) or (kind = CS_LAB)
        {
            let r host.allocate(48, 8) as pointer[double]
            var j 0
            while j < 6
            {
                if *(pos + 2) >= 0
                    set *(r + j): *((range as pointer[double]) + j)
                else
                {
                    if (j % 2) = 1
                        set *(r + j): 1.0
                    else
                        set *(r + j): 0.0
                }
                set j: j + 1
            }
            set d.range: r
        }
        if kind = CS_ABC
        {
            set d.range_abc: Primitive.range_buf(host, 6, *(pos + 3) >= 0, range_abc as pointer[double])
            set d.range_lmn: Primitive.range_buf(host, 6, *(pos + 4) >= 0, range_lmn as pointer[double])
            set d.matrix_abc: Primitive.matrix_buf(host, *(pos + 6) >= 0, matrix_abc as pointer[double])
            set d.matrix_lmn: Primitive.matrix_buf(host, *(pos + 7) >= 0, matrix_lmn as pointer[double])
            set d.decode_abc: Primitive.func_buf(host, *(pos + 9) >= 0, decode_abc as pointer[pointer[ELObj]])
            set d.decode_lmn: Primitive.func_buf(host, *(pos + 10) >= 0, decode_lmn as pointer[pointer[ELObj]])
        }
        if kind = CS_A
        {
            set d.range_a: Primitive.range_buf(host, 2, *(pos + 5) >= 0, range_a as pointer[double])
            set d.range_lmn: Primitive.range_buf(host, 6, *(pos + 4) >= 0, range_lmn as pointer[double])
            ; matrixA default is 1.0 in every slot (CIEAColorSpaceObj ctor).
            let ma host.allocate(24, 8) as pointer[double]
            var j 0
            while j < 3
            {
                if *(pos + 8) >= 0
                    set *(ma + j): *((matrix_a as pointer[double]) + j)
                else
                    set *(ma + j): 1.0
                set j: j + 1
            }
            set d.matrix_a: ma
            set d.matrix_lmn: Primitive.matrix_buf(host, *(pos + 7) >= 0, matrix_lmn as pointer[double])
            set d.decode_a: decode_a
            set d.decode_lmn: Primitive.func_buf(host, *(pos + 10) >= 0, decode_lmn as pointer[pointer[ELObj]])
        }
        ELObj.make_color_space(host, kind, d as pointer[void])
    }

    ; a range buffer: given values, or the 0/1 alternating default.
    function range_buf(host: pointer[Page], len: int, given: bool, vals: pointer[double]) returns pointer[double]
    {
        let r host.allocate((len * 8) as size_t, 8) as pointer[double]
        var j 0
        while j < len
        {
            if given
                set *(r + j): *(vals + j)
            else
            {
                if (j % 2) = 1
                    set *(r + j): 1.0
                else
                    set *(r + j): 0.0
            }
            set j: j + 1
        }
        r
    }

    ; a 3x3 matrix buffer: given values, or identity ((i % 4) ? 0 : 1).
    function matrix_buf(host: pointer[Page], given: bool, vals: pointer[double]) returns pointer[double]
    {
        let r host.allocate(72, 8) as pointer[double]
        var j 0
        while j < 9
        {
            if given
                set *(r + j): *(vals + j)
            else
            {
                if (j % 4) = 0
                    set *(r + j): 1.0
                else
                    set *(r + j): 0.0
            }
            set j: j + 1
        }
        r
    }

    function func_buf(host: pointer[Page], given: bool, vals: pointer[pointer[ELObj]]) returns pointer[pointer[ELObj]]
    {
        if given = false
            return null
        let r host.allocate(24, 8) as pointer[pointer[ELObj]]
        var j 0
        while j < 3
        {
            set *(r + j): *(vals + j)
            set j: j + 1
        }
        r
    }

    ; CIEXYZColorSpaceObj ctor: white point + the phosphor matrix (color faq)
    ; inverted twice into the XYZ->RGB matrix. Layout: white[3], white_u,
    ; white_v, M[9].
    function xyz_data(host: pointer[Page], wp: pointer[double]) returns pointer[double]
    {
        let d host.allocate(112, 8) as pointer[double]
        var i 0
        while i < 3
        {
            set *(d + i): *(wp + i)
            set i: i + 1
        }
        let tmp (*wp) + (15.0 * (*(wp + 1))) + (3.0 * (*(wp + 2)))
        set *(d + 3): 4.0 * (*wp) / tmp
        set *(d + 4): 9.0 * (*(wp + 1)) / tmp
        var u double[9]
        let up u as pointer[double]
        ; xr .64 yr .33 / xg .30 yg .60 / xb .15 yb .06
        set *up: 0.64
        set *(up + 1): 0.30
        set *(up + 2): 0.15
        set *(up + 3): 0.33
        set *(up + 4): 0.60
        set *(up + 5): 0.06
        set *(up + 6): 1.0 - 0.64 - 0.33
        set *(up + 7): 1.0 - 0.30 - 0.60
        set *(up + 8): 1.0 - 0.15 - 0.06
        var uinv double[9]
        Primitive.invert3(up, uinv as pointer[double])
        var c double[3]
        set i: 0
        while i < 3
        {
            let ui uinv as pointer[double]
            set *((c as pointer[double]) + i): ((*(ui + (3 * i))) * (*wp)) + ((*(ui + (3 * i) + 1)) * (*(wp + 1))) + ((*(ui + (3 * i) + 2)) * (*(wp + 2)))
            set i: i + 1
        }
        var minv double[9]
        let mp minv as pointer[double]
        let cp c as pointer[double]
        set i: 0
        while i < 3
        {
            var j 0
            while j < 3
            {
                set *(mp + (3 * i) + j): (*(up + (3 * i) + j)) * (*(cp + j))
                set j: j + 1
            }
            set i: i + 1
        }
        Primitive.invert3(mp, d + 5)
        d
    }

    ; invert a 3x3 matrix (Style.cxx invert; the near-singular case is left
    ; unreported like the reference FIXME).
    procedure invert3(a: pointer[double], b: pointer[double])
    {
        set *b: ((*(a + 4)) * (*(a + 8))) - ((*(a + 5)) * (*(a + 7)))
        set *(b + 3): 0.0 - (((*(a + 3)) * (*(a + 8))) - ((*(a + 5)) * (*(a + 6))))
        set *(b + 6): ((*(a + 3)) * (*(a + 7))) - ((*(a + 4)) * (*(a + 6)))
        set *(b + 1): 0.0 - (((*(a + 1)) * (*(a + 8))) - ((*(a + 2)) * (*(a + 7))))
        set *(b + 4): ((*a) * (*(a + 8))) - ((*(a + 2)) * (*(a + 6)))
        set *(b + 7): 0.0 - (((*a) * (*(a + 7))) - ((*(a + 1)) * (*(a + 6))))
        set *(b + 2): ((*(a + 1)) * (*(a + 5))) - ((*(a + 2)) * (*(a + 4)))
        set *(b + 5): 0.0 - (((*a) * (*(a + 5))) - ((*(a + 2)) * (*(a + 3))))
        set *(b + 8): ((*a) * (*(a + 4))) - ((*(a + 1)) * (*(a + 3)))
        let det ((*a) * (*b)) + ((*(a + 1)) * (*(b + 3))) + ((*(a + 2)) * (*(b + 6)))
        var i 0
        while i < 9
        {
            set *(b + i): (*(b + i)) / det
            set i: i + 1
        }
    }

    ; --- makeColor per space kind -------------------------------------------

    function color_arg_real(interp: pointer[Interpreter], loc: Location, sname: pointer[const_char], a: pointer[ELObj], lo: double, hi: double, out: pointer[double]) returns pointer[ELObj]
    {
        if a.is_real() = false
            return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgType(), sname)
        let d a.real_value()
        if d < lo
            return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgRange(), sname)
        if d > hi
            return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgRange(), sname)
        set *out: d
        null
    }

    ; (unsigned char)(d*255.0 + .5)
    function to_255(d: double) returns int
        (((d * 255.0) + 0.5) as int) & 0xFF

    ; applyFunc (Style.cxx): call a decode function on a fresh VM with the
    ; component as a real; the result must read back as a real.
    function apply_color_func(interp: pointer[Interpreter], f: pointer[ELObj], d: pointer[double]) returns bool
    {
        let host interp.get_host()
        let vm VM.make(host, interp)
        let insn f.make_call_insn(1, interp, Location(), null)
        let arg ELObj.make_real(host, *d)
        let res vm.eval(insn, null, arg)
        if res = null
            return false
        if res.is_real() = false
            return false
        set *d: res.real_value()
        true
    }

    ; CIEXYZColorSpaceObj::makeColor — XYZ through M into device RGB.
    function xyz_make_color(host: pointer[Page], xyz: pointer[double], h: pointer[double]) returns pointer[ELObj]
    {
        let m xyz + 5
        var c int[3]
        var i 0
        while i < 3
        {
            let v ((*(m + (3 * i))) * (*h)) + ((*(m + (3 * i) + 1)) * (*(h + 1))) + ((*(m + (3 * i) + 2)) * (*(h + 2)))
            set *((c as pointer[int]) + i): Primitive.to_255(v)
            set i: i + 1
        }
        let cp c as pointer[int]
        ELObj.make_color(host, *cp, *(cp + 1), *(cp + 2))
    }

    function make_color_from_space(host: pointer[Page], interp: pointer[Interpreter], space: pointer[ELObj], argc: int, args: pointer[pointer[ELObj]], loc: Location) returns pointer[ELObj]
    {
        let kind space.color_space_kind()
        ; every makeColor returns device black for zero args.
        if argc = 0
            return ELObj.make_color(host, 0, 0, 0)
        if kind = CS_RGB
        {
            if argc <> 3
                return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgCount(), "Device RGB")
            var c int[3]
            var i 0
            while i < 3
            {
                var d 0.0
                let err Primitive.color_arg_real(interp, loc, "Device RGB", *(args + i), 0.0, 1.0, &d)
                if err <> null
                    return err
                set *((c as pointer[int]) + i): Primitive.to_255(d)
                set i: i + 1
            }
            let cp c as pointer[int]
            return ELObj.make_color(host, *cp, *(cp + 1), *(cp + 2))
        }
        if kind = CS_GRAY
        {
            if argc <> 1
                return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgCount(), "Device Gray")
            var d 0.0
            let err Primitive.color_arg_real(interp, loc, "Device Gray", *args, 0.0, 1.0, &d)
            if err <> null
                return err
            let c Primitive.to_255(d)
            return ELObj.make_color(host, c, c, c)
        }
        if kind = CS_CMYK
        {
            if argc <> 4
                return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgCount(), "Device CMYK")
            var d double[4]
            var i 0
            while i < 4
            {
                var v 0.0
                let err Primitive.color_arg_real(interp, loc, "Device CMYK", *(args + i), 0.0, 1.0, &v)
                if err <> null
                    return err
                set *((d as pointer[double]) + i): v
                set i: i + 1
            }
            let dp d as pointer[double]
            var c int[3]
            set i: 0
            while i < 3
            {
                var sum (*(dp + i)) + (*(dp + 3))
                if sum > 1.0
                    set sum: 1.0
                set *((c as pointer[int]) + i): Primitive.to_255(1.0 - sum)
                set i: i + 1
            }
            let cp c as pointer[int]
            return ELObj.make_color(host, *cp, *(cp + 1), *(cp + 2))
        }
        if kind = CS_KX
        {
            if argc <> 2
                return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgCount(), "Device KX")
            var d0 0.0
            var d1 0.0
            let e0 Primitive.color_arg_real(interp, loc, "Device KX", *args, 0.0, 1.0, &d0)
            if e0 <> null
                return e0
            let e1 Primitive.color_arg_real(interp, loc, "Device KX", *(args + 1), 0.0, 1.0, &d1)
            if e1 <> null
                return e1
            var sum d0 + d1
            if sum > 1.0
                set sum: 1.0
            let c Primitive.to_255(1.0 - sum)
            return ELObj.make_color(host, c, c, c)
        }
        let data space.color_space_data() as pointer[CieData]
        if kind = CS_LUV
        {
            if argc <> 3
                return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgCount(), "CIE LUV")
            var d double[3]
            var i 0
            while i < 3
            {
                var v 0.0
                let err Primitive.color_arg_real(interp, loc, "CIE LUV", *(args + i), *(data.range + (2 * i)), *(data.range + (2 * i) + 1), &v)
                if err <> null
                    return err
                set *((d as pointer[double]) + i): v
                set i: i + 1
            }
            let dp d as pointer[double]
            var h double[3]
            let hp h as pointer[double]
            if *dp = 0.0
            {
                set *hp: 0.0
                set *(hp + 1): 0.0
                set *(hp + 2): 0.0
            }
            else
            {
                if *dp <= 7.996968
                    set *(hp + 1): (*dp) / 903.0
                else
                {
                    let t ((*dp) + 16.0) / 116.0
                    set *(hp + 1): t * t * t
                }
                let uu ((*(dp + 1)) / (13.0 * (*dp))) + (*(data.xyz + 3))
                let vv ((*(dp + 2)) / (13.0 * (*dp))) + (*(data.xyz + 4))
                let tmp 9.0 * (*(hp + 1)) / vv
                set *hp: uu * tmp / 4.0
                set *(hp + 2): (tmp - (15.0 * (*(hp + 1))) - (*hp)) / 3.0
            }
            return Primitive.xyz_make_color(host, data.xyz, hp)
        }
        if kind = CS_LAB
        {
            if argc <> 3
                return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgCount(), "CIE LAB")
            var d double[3]
            var i 0
            while i < 3
            {
                var v 0.0
                let err Primitive.color_arg_real(interp, loc, "CIE LAB", *(args + i), *(data.range + (2 * i)), *(data.range + (2 * i) + 1), &v)
                if err <> null
                    return err
                set *((d as pointer[double]) + i): v
                set i: i + 1
            }
            let dp d as pointer[double]
            set *dp: (*dp) / 100.0
            var h double[3]
            let hp h as pointer[double]
            var tmp ((*dp) + 16.0) / 116.0
            set *(hp + 1): tmp * tmp * tmp
            if *(hp + 1) < 0.008856
            {
                set tmp: (*dp) / 9.03292
                set *hp: (*data.xyz) * (((*(dp + 1)) / 3893.5) + tmp)
                set *(hp + 1): tmp
                set *(hp + 2): (*(data.xyz + 2)) * (tmp - ((*(dp + 2)) / 1557.4))
            }
            else
            {
                var tmp2 tmp + ((*(dp + 1)) / 5.0)
                set *hp: (*data.xyz) * tmp2 * tmp2 * tmp2
                set tmp2: tmp - ((*(dp + 2)) / 2.0)
                set *(hp + 2): (*(data.xyz + 2)) * tmp2 * tmp2 * tmp2
            }
            return Primitive.xyz_make_color(host, data.xyz, hp)
        }
        if kind = CS_ABC
        {
            if argc <> 3
                return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgCount(), "CIE Based ABC")
            var d double[3]
            var i 0
            while i < 3
            {
                var v 0.0
                let err Primitive.color_arg_real(interp, loc, "CIE Based ABC", *(args + i), *(data.range_abc + (2 * i)), *(data.range_abc + (2 * i) + 1), &v)
                if err <> null
                    return err
                if data.decode_abc <> null
                {
                    let f *(data.decode_abc + i)
                    if f <> null
                    {
                        if Primitive.apply_color_func(interp, f, &v) = false
                            return Primitive.color_space_message(interp, loc, InterpreterMessages.colorProcResType(), "CIE Based ABC")
                    }
                }
                set *((d as pointer[double]) + i): v
                set i: i + 1
            }
            let dp d as pointer[double]
            var l double[3]
            let lp l as pointer[double]
            set i: 0
            while i < 3
            {
                var v ((*(data.matrix_abc + i)) * (*dp)) + ((*(data.matrix_abc + 3 + i)) * (*(dp + 1))) + ((*(data.matrix_abc + 6 + i)) * (*(dp + 2)))
                if v < *(data.range_lmn + (2 * i))
                    return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgRange(), "CIE Based ABC")
                if v > *(data.range_lmn + (2 * i) + 1)
                    return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgRange(), "CIE Based ABC")
                if data.decode_lmn <> null
                {
                    let f *(data.decode_lmn + i)
                    if f <> null
                    {
                        if Primitive.apply_color_func(interp, f, &v) = false
                            return Primitive.color_space_message(interp, loc, InterpreterMessages.colorProcResType(), "CIE Based ABC")
                    }
                }
                set *(lp + i): v
                set i: i + 1
            }
            var h double[3]
            let hp h as pointer[double]
            set i: 0
            while i < 3
            {
                set *(hp + i): ((*(data.matrix_lmn + i)) * (*lp)) + ((*(data.matrix_lmn + 3 + i)) * (*(lp + 1))) + ((*(data.matrix_lmn + 6 + i)) * (*(lp + 2)))
                set i: i + 1
            }
            return Primitive.xyz_make_color(host, data.xyz, hp)
        }
        if kind = CS_A
        {
            if argc <> 1
                return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgCount(), "CIE Based A")
            var d 0.0
            let err Primitive.color_arg_real(interp, loc, "CIE Based A", *args, *data.range_a, *(data.range_a + 1), &d)
            if err <> null
                return err
            if data.decode_a <> null
            {
                if Primitive.apply_color_func(interp, data.decode_a, &d) = false
                    return Primitive.color_space_message(interp, loc, InterpreterMessages.colorProcResType(), "CIE Based A")
            }
            var l double[3]
            let lp l as pointer[double]
            var i 0
            while i < 3
            {
                var v (*(data.matrix_a + i)) * d
                if v < *(data.range_lmn + (2 * i))
                    return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgRange(), "CIE Based A")
                if v > *(data.range_lmn + (2 * i) + 1)
                    return Primitive.color_space_message(interp, loc, InterpreterMessages.colorArgRange(), "CIE Based A")
                if data.decode_lmn <> null
                {
                    let f *(data.decode_lmn + i)
                    if f <> null
                    {
                        if Primitive.apply_color_func(interp, f, &v) = false
                            return Primitive.color_space_message(interp, loc, InterpreterMessages.colorProcResType(), "CIE Based A")
                    }
                }
                set *(lp + i): v
                set i: i + 1
            }
            var h double[3]
            let hp h as pointer[double]
            set i: 0
            while i < 3
            {
                set *(hp + i): ((*(data.matrix_lmn + i)) * (*lp)) + ((*(data.matrix_lmn + 3 + i)) * (*(lp + 1))) + ((*(data.matrix_lmn + 6 + i)) * (*(lp + 2)))
                set i: i + 1
            }
            return Primitive.xyz_make_color(host, data.xyz, hp)
        }
        ELObj.make_color(host, 0, 0, 0)
    }

    function collect_data_fill(node: pointer[GroveNode], buf: pointer[u32], off: size_t) returns size_t
    {
        if node = null
            return off
        if node.get_class() = GN_DATA
        {
            let c node.get_chars()
            let m c.get_size()
            var k: size_t 0
            var o off
            while k < m
            {
                set *(buf + o): c.get(k)
                set o: o + 1
                set k: k + 1
            }
            return o
        }
        var o off
        let n node.child_count()
        var i 0
        while i < n
        {
            let ch node.child_at(i)
            set o: Primitive.collect_data_fill(ch, buf, o)
            set i: i + 1
        }
        o
    }
}
