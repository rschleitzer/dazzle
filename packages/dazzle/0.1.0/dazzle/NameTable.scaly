; NameTable — the hash-probed name index the reference reaches for wherever a
; name maps to ONE object: `NamedTable<T>` (generic/NamedTable.h, an open
; hash table over `Named` objects) behind `Interpreter::identTable_`,
; `symbolTable_`, `unitTable_` and `ProcessingMode::GroveRules::elementTable`.
;
; The port grew up without it — every one of those tables was a linear Array
; scan, which is a CONSTANT-factor loss on the small tables but an asymptotic
; one on the interning path: measured on the DocBook print stylesheets,
; `Interpreter.lookup` ran 81 804 times for 83.5 million StringC comparisons
; (~1 020 per lookup). See tests/dazzle/PERFORMANCE.md, "Zwei algorithmische
; Abweichungen von der Referenz".
;
; Shape: open addressing with linear probing, capacity a power of two, load
; factor 3/4, entries allocated on the caller's arena page and never removed
; (no table in this engine ever deletes a name). The value is a `NamedRef`,
; the reference's `Named *` (NamedTable<T> stores `Named`, never `T`); the
; typed façade `NamedTable[T]` below casts it back, and every table here maps
; a name to a page-hosted object.
;
; ★The KEY is stored as a StringC VALUE, i.e. a (data, size) pair sharing the
; buffer of the object it names. Callers must therefore hand in a key that
; lives on the arena — `ident.get_name()`, not a `StringC(lit)` temporary
; (CLAUDE.md, "Strings": a stack-built StringC's buffer is garbage by the time
; anyone compares against it).

use scaly.memory.Page
use opensp.StringC.StringC

; `Named` (opensp/include/Named.h): the base every table value derives from
; upstream. The port's values share no base, so the kind is an opaque pointer
; alias — ONE declaration, and a NamedRef handed where a NIC or a grove
; declaration belongs is a planner error.
define Named()
define NamedRef pointer[Named]

; One occupied slot. `hash_code` is kept so a probe can reject a collision
; without touching the key's characters.
define NameEntry (key: StringC, hash_code: size_t, value: NamedRef)
{
    function make(host: ref[Page], key: StringC, hash_code: size_t, value: NamedRef) returns ref[NameEntry]
    {
        let e &NameEntry^host(key, hash_code, value)
        e
    }

    function get_key(this: NameEntry) returns StringC
        key

    function get_value(this: NameEntry) returns NamedRef
        value
}

define NameTable (var slots: pointer[pointer[NameEntry]], var capacity: size_t, var count: size_t)
{
    ; `initial` is a hint; the capacity is rounded up to a power of two and
    ; never drops below 8.
    function make(host: ref[Page], initial: size_t) returns ref[NameTable]
    {
        let t host.allocate(sizeof NameTable, alignof NameTable) as pointer[NameTable]
        NameTable.setup(t, host, initial)
        t
    }

    ; the constructor over storage the caller already owns -- what lets
    ; `NamedTable[T]` hold the store BY VALUE the way the reference's
    ; `OwnerTable<Named, ...> table_` member does.
    procedure setup(mutable t: ref[NameTable], host: ref[Page], initial: size_t)
    {
        var cap: size_t 8
        while cap < initial
            set cap: cap * 2
        set t.slots: NameTable.alloc_slots(host, cap)
        set t.capacity: cap
        set t.count: 0
    }

    function alloc_slots(host: ref[Page], cap: size_t) returns pointer[pointer[NameEntry]]
    {
        let s host.allocate(cap * sizeof pointer[NameEntry], alignof pointer[NameEntry]) as pointer[pointer[NameEntry]]
        var i: size_t 0
        while i < cap
        {
            set *(s + i): null
            set i: i + 1
        }
        s
    }

    ; djb2 over the characters. The reference hashes bytes; a DSSSL name is a
    ; sequence of Chars here, so the loop runs over `get`.
    function hash_of(key: StringC) returns size_t
    {
        let n key.get_size()
        var h: size_t 5381
        var i: size_t 0
        while i < n
        {
            set h: (h * 33) + (key.get(i) as size_t)
            set i: i + 1
        }
        h
    }

    function get_count(this: NameTable) returns size_t
        count

    ; the value under `key`, null when the name is not in the table.
    function lookup(this: ref[NameTable], key: StringC) returns NamedRef
    {
        let cap this.capacity
        let mask cap - 1
        let h NameTable.hash_of(key)
        let slots this.slots
        var i h & mask
        var probes: size_t 0
        ; the load factor keeps at least one slot empty, so the walk always
        ; terminates on a null; the counter is the belt-and-braces bound.
        while probes < cap
        {
            let e *(slots + i)
            if e = null
                return null
            if e.hash_code = h
            {
                let k e.key
                if k.equals(key)
                    return e.value
            }
            set i: (i + 1) & mask
            set probes: probes + 1
        }
        null
    }

    ; Insert a name the caller has already established is absent (every table
    ; here does lookup-then-insert, exactly as the reference's `insert`).
    procedure insert(mutable this: ref[NameTable], host: ref[Page], key: StringC, value: NamedRef)
    {
        if ((this.count + 1) * 4) > (this.capacity * 3)
            this.grow(host)
        let h NameTable.hash_of(key)
        let e NameEntry.make(host, key, h, value)
        NameTable.place(this.slots, this.capacity, e)
        set this.count: this.count + 1
    }

    procedure place(mutable slots: pointer[pointer[NameEntry]], cap: size_t, e: ref[NameEntry])
    {
        let mask cap - 1
        var i e.hash_code & mask
        var probes: size_t 0
        while probes < cap
        {
            if *(slots + i) = null
            {
                set *(slots + i): e
                return
            }
            set i: (i + 1) & mask
            set probes: probes + 1
        }
    }

    procedure grow(mutable this: ref[NameTable], host: ref[Page])
    {
        let old this.slots
        let old_cap this.capacity
        let cap old_cap * 2
        let slots NameTable.alloc_slots(host, cap)
        var i: size_t 0
        while i < old_cap
        {
            let e *(old + i)
            if e <> null
                NameTable.place(slots, cap, e)
            set i: i + 1
        }
        set this.slots: slots
        set this.capacity: cap
    }

    function test() returns int
    {
        let anchor StringC("x")
        let host Page.get(anchor.data_ptr())
        let t NameTable.make(host, 4)
        ; 26 distinct names (the prefixes of the alphabet) — three growths of
        ; the initial table, so the rehash path is exercised too.
        let alphabet StringC^host("abcdefghijklmnopqrstuvwxyz")
        let chars alphabet.data_ptr()
        var i: size_t 0
        while i < 26
        {
            let key StringC^host(chars, i + 1)
            if t.lookup(*key) <> null
                return 1
            t.insert(host, *key, key as NamedRef)
            set i: i + 1
        }
        if t.get_count() <> 26
            return 2
        set i: 0
        while i < 26
        {
            let key StringC^host(chars, i + 1)
            let hit t.lookup(*key)
            if hit = null
                return 3
            let back hit as ref[StringC]
            if back.equals(*key) = false
                return 4
            set i: i + 1
        }
        let miss StringC("no-such-name")
        if t.lookup(*miss) <> null
            return 5

        ; the typed façade over the same store: a hit comes back as ref[T]
        ; without a cast at the call site, a miss as null.
        let tt &NamedTable[StringC](4)
        let k1 StringC("alpha")
        let k2 StringC("beta")
        tt.insert(host, *k1, k1)
        if tt.get_count() <> 1
            return 6
        let got tt.lookup(*k1)
        if got = null
            return 7
        if got.equals(*k1) = false
            return 8
        if tt.lookup(*k2) <> null
            return 9
        0
    }
}

; NamedTable<T> (opensp/include/NamedTable.h) — the reference's own answer to
; "a name table whose values have a type", and worth naming precisely because
; it is NOT a template over the storage: `NamedTable<T>` instantiates
; `OwnerTable<Named, ...>` — always `Named`, never `T` — so ONE table body
; exists in the binary and `T` lives only in the inline downcasts of the
; façade (`T *lookup(const StringC &s) const { return (T *)table_.lookup(s); }`).
;
; This is that shape, one for one: the untyped `NameTable` above is the store,
; held BY VALUE like the reference's `table_` member (a `ref` field would add a
; load to every lookup, and the symbol lookup is a hot path), and each method
; here is a forward plus the cast the caller used to write. What it buys is
; what the reference's template buys: the field says what the table holds, and
; a value of the wrong type no longer passes.
define NamedTable[T] (table: NameTable)
{
    ; the allocating init derives its page from the table's own address, the
    ; `Vector` pattern -- so a NamedTable must be constructed PAGE-HOSTED
    ; (`NamedTable[T]^host(n)`), never on a frame.
    init(initial: size_t)
    {
        let host Page.get(this)
        NameTable.setup(&this.table, host, initial)
    }

    function get_count(this: ref[NamedTable[T]]) returns size_t
    {
        let t &this.table
        t.get_count()
    }

    ; `T *lookup(const StringC &s) const { return (T *)table_.lookup(s); }` --
    ; the cast lands on the OPTION type, so a miss stays a miss and no
    ; null-unwrap trap is emitted for a null the caller is meant to see.
    function lookup(this: ref[NamedTable[T]], key: StringC) returns ref[T]?
    {
        let t &this.table
        t.lookup(key) as ref[T]?
    }

    procedure insert(mutable this: ref[NamedTable[T]], host: ref[Page], key: StringC, value: ref[T])
    {
        let t &this.table
        t.insert(host, key, value as NamedRef)
    }
}
