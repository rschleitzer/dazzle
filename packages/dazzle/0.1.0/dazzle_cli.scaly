; dazzle — the DSSSL transform CLI (the `jade -t sgml|xml -d spec.dsl doc`
; drop-in). Wires the full Stage-6a pipeline end to end: SGML/XML document ->
; opensp parse -> Grove; DSSSL stylesheet -> Interpreter; ProcessContext drives
; the grove through the construction rules into the transform FOTBuilder; the
; top-level output stream goes to stdout (or -o FILE), while entity/directory
; flow objects write their own files (the codegen use case).
;
; This is a program, not part of the `define dazzle` package module — it is
; compiled standalone and linked against libdazzle.a + libopensp.a (see
; tests/dazzle/build-cli.sh), exactly as onsgmls.scaly is for opensp.
;
; MVP flag set (mirrors the reference subset needed to run + corpus-diff):
;   -d <stylesheet.dsl>   the DSSSL spec (required)
;   -t sgml | xml         output flavour (default sgml; xml adds the decl +
;                         self-closing empty elements)
;   -o <file>             write the top-level stream to FILE instead of stdout
;   <document>            the SGML/XML instance (one positional arg, required)
; Deferred to later slices (reference has them): -G debug, -V var=value, -2
; dsssl2, -s strict, the getopt-style combined/long options, stderr message
; fidelity + exit codes over the corpus.

package scaly 0.1.0
package opensp 0.1.0
package dazzle 0.1.0

use opensp.Parser.Parser
use opensp.ParserState.ParserState
use opensp.Location.InputSource
use opensp.StringC.StringC
use dazzle.Grove.GroveNode
use dazzle.Grove.GroveBuilder
use dazzle.Grove.GroveBuildState
use dazzle.Interpreter.Interpreter
use dazzle.SchemeParser.SchemeParser
use dazzle.DssslSpecEventHandler.DssslSpecEventHandler
use dazzle.DssslSpecEventHandler.Part
use dazzle.TransformFOTBuilder.TransformFOTBuilder
use dazzle.SgmlFOTBuilder.SgmlFOTBuilder
use dazzle.RtfFOTBuilder.RtfFOTBuilder
use dazzle.ProcessContext.ProcessContext
use scaly.memory.Page
use scaly.containers.String
use scaly.containers.Array
use scaly.io.File
use scaly.io.Console
use scaly.fiber.Io

; Normalize file bytes into a u32 record buffer: LF and CRLF collapse to a
; single RE (0x0D) — the OpenSP record convention the SchemeParser lexer
; expects (skip_comment ends a `;` comment at RE, never at LF; a raw LF file
; would otherwise swallow the rest of the stylesheet after the first comment).
; Bytes map 1:1 to codepoints (ASCII/Latin-1; a UTF-8 decode for non-ASCII
; stylesheets is a later refinement).
function normalize_records(host: pointer[Page], src: String) returns pointer[InputSource]
{
    let out Array[u32]^host()
    let n src.get_length()
    var i: size_t 0
    while i < n
    {
        let b src.get(i)
        if b = (0x0D as u8)
        {
            out.add(0x0D as u32)
            ; CRLF -> single RE: swallow a following LF.
            if (i + (1 as size_t)) < n
            {
                if src.get(i + (1 as size_t)) = (0x0A as u8)
                    set i: i + 1
            }
        }
        else if b = (0x0A as u8)
            out.add(0x0D as u32)
        else
            out.add(b as u32)
        set i: i + 1
    }
    InputSource.make(host, null, out.get_buffer(), out.get_length())
}

; Load the DSSSL Scheme prolog (dsssl/builtins.dsl: map, node-list->list,
; reduce, node-list-* …) into `interp` BEFORE the user stylesheet, mirroring
; the reference Interpreter::installBuiltins() (which reads the builtins entity
; and runs SchemeParser::parse over it). The file is resolved under SCALY_HOME
; (fallback cwd-relative, matching the package-resolution base). Records are
; normalized like any stylesheet — a raw-LF prolog would otherwise have its
; first `;` comment swallow the whole file. Absent file = silent no-op (the
; reference guards the same way with readEntity's boolean).
function install_builtins(host: pointer[Page], interp: pointer[Interpreter])
{
    var path String("packages/dazzle/0.1.0/dsssl/builtins.dsl")
    let home getenv("SCALY_HOME")
    if home <> null
        set path: String("`home`/packages/dazzle/0.1.0/dsssl/builtins.dsl")
    if File.exists(path) = false
        return
    let src File.read_to_string(path)
    if src.get_length() = (0 as size_t)
        return
    ; Interpreter::installBuiltins brackets the builtins parse with part
    ; index -1 (any user define overrides a builtin), then resets to 0.
    interp.set_part_index(0xFFFFFFFF as u32)
    let src_in normalize_records(host, src)
    let sp SchemeParser.make(host, interp, src_in)
    sp.parse()
    interp.set_part_index(0 as u32)
}

; A `.dsl` is SGML (the DSSSL style-sheet document openjade requires) iff its
; first non-whitespace byte is `<` (a markup declaration / element). Otherwise
; it is dazzle's raw-Scheme convenience form (the smoke-test stylesheets).
function is_sgml_stylesheet(src: String) returns bool
{
    let n src.get_length()
    var i: size_t 0
    while i < n
    {
        let b src.get(i)
        if (b <> (0x20 as u8)) and (b <> (0x09 as u8)) and (b <> (0x0A as u8)) and (b <> (0x0D as u8))
            return b = (0x3C as u8)
        set i: i + 1
    }
    false
}

; Load a `.dsl` stylesheet into `interp`. Raw Scheme parses directly (records
; normalized). A full DSSSL style-sheet SGML document routes through the
; DssslSpecEventHandler (StyleEngine::parseSpec): parse the document, gate on
; the DSSSL architecture notation, assemble the resolved part + its USE closure,
; then feed each part's body text to the SchemeParser in order. Returns false on
; a hard load failure (unparseable document / not a DSSSL spec).
function load_stylesheet(host: pointer[Page], interp: pointer[Interpreter], dsl_path: String, prog_name: String) returns bool
{
    let dsl_src File.read_to_string(dsl_path)
    if is_sgml_stylesheet(dsl_src) = false
    {
        let src_in normalize_records(host, dsl_src)
        let sp SchemeParser.make(host, interp, src_in)
        sp.parse()
        return true
    }
    ; the shipped DSSSL catalog (maps the style-sheet DTD's PUBLIC id -> the
    ; bundled style-sheet.dtd, which declares the DSSSL arch notation the gate
    ; needs) — resolved under SCALY_HOME, fallback cwd-relative.
    var catalog_path String("packages/dazzle/0.1.0/dsssl/catalog")
    let home getenv("SCALY_HOME")
    if home <> null
        set catalog_path: String("`home`/packages/dazzle/0.1.0/dsssl/catalog")
    if File.exists(catalog_path) = false
        set catalog_path: String("")
    let ps Parser.parse_simple_cat(host, dsl_path, prog_name, catalog_path)
    if ps = null
        return false
    let eh DssslSpecEventHandler.make(host, interp, prog_name, catalog_path)
    let parts eh.load(ps, StringC())
    if parts = null
        return false
    ; StyleEngine::parseSpec: one SchemeParser per body element, each over its
    ; own InputSource — an immediate body's text origin carries the per-chunk
    ; location table, so a runtime diagnostic (`no clause in case expression
    ; matched …`) resolves into the original `.scm` source.
    let n parts.get_length()
    var i: size_t 0
    while i < n
    {
        let part *(parts.get_buffer() + i)
        let bes part.get_body_elements()
        let bn bes.get_length()
        var j: size_t 0
        while j < bn
        {
            let be *(bes.get_buffer() + j)
            let bsrc DssslSpecEventHandler.make_input_source(host, be)
            if bsrc <> null
            {
                let bsp SchemeParser.make(host, interp, bsrc)
                bsp.parse()
            }
            set j: j + (1 as size_t)
        }
        ; StyleEngine::parseSpec: endPart after each part — earlier parts'
        ; defines and rules take precedence over later (USEd) ones.
        interp.end_part()
        set i: i + (1 as size_t)
    }
    true
}

; the streaming-drain sink (opensp's do_content pump invokes this via
; scaly_call_ptr with the ParserState as arg — the C-shaped fn(ptr)->ptr
; convention the fiber entries use): feed the queued event chunk into the
; grove builder; the caller then resets the event scratch region.
procedure grove_stream_drain(arg: pointer[void]) returns pointer[void]
{
    let ps arg as pointer[ParserState]
    let st ps.get_stream_w() as pointer[GroveBuildState]
    GroveBuilder.feed(st, ps)
    null
}

function main(argc: int, argv: pointer[pointer[char]]) returns int
{
    let prog_name String(*argv)
    ; bootstrap the run region (one arena page for the whole run).
    let anchor0 String("x")
    let host Page.get(anchor0.get_buffer() as pointer[void])

    var xml false
    var fot false
    var rtf false
    var dsl_path String("")
    var doc_path String("")
    var out_path String("")
    var have_dsl false
    var have_doc false
    var debug false

    var i 1
    while i < argc
    {
        let arg String(*(argv + i))
        if arg.equals("-G")
            set debug: true
        else if arg.equals("-t")
        {
            set i: i + 1
            if i < argc
            {
                let tp String(*(argv + i))
                if tp.equals("xml")
                    set xml: true
                else if tp.equals("fot")
                    set fot: true
                else if tp.equals("rtf")
                    set rtf: true
            }
        }
        else if arg.equals("-d")
        {
            set i: i + 1
            if i < argc
            {
                set dsl_path: String(*(argv + i))
                set have_dsl: true
            }
        }
        else if arg.equals("-o")
        {
            set i: i + 1
            if i < argc
                set out_path: String(*(argv + i))
        }
        else
        {
            set doc_path: arg
            set have_doc: true
        }
        set i: i + 1
    }

    if (have_doc = false) or (have_dsl = false)
    {
        Console.println("usage: dazzle -d <stylesheet.dsl> [-t sgml|xml] [-o <out>] <document>")
        return 1
    }

    ; --- document -> grove (streaming: the parse drains event chunks into
    ; the grove builder and resets the event scratch region — the whole-run
    ; event queue retained ~600 MB on a 5 MB parse) ------------------------
    let gs GroveBuilder.begin(host)
    let ps Parser.parse_simple_stream(host, doc_path, prog_name, &grove_stream_drain, gs as pointer[void])
    if ps = null
    {
        Console.println("dazzle: cannot parse document")
        return 1
    }
    ; the tail queued since the last drain
    GroveBuilder.feed(gs, ps)
    let root GroveBuilder.finish(gs)
    ; exit code = document-parse errors only (ParserApp::generateEvents:
    ; `return errorCount > 0`) — stylesheet/Scheme/style errors never flip it.
    var doc_rc 0
    if ps.get_n_errors() > (0 as u32)
        set doc_rc: 1

    ; --- stylesheet -> interpreter (parse + compile the construction rules) --
    ; -G (debugMode): VM errors print the `called from here` stack trace.
    ; unitsPerInch = 72000 (millipoints) — JadeApp's `u` for every backend
    ; except RTF (which overrides to twips); the fot Units format depends on it.
    ; The transform extension classes exist only under -t sgml/xml (jade.cxx
    ; passes an extension table only there).
    if fot or rtf
        Interpreter.set_extensions_on(false)
    ; RTF runs the engine in twips (jade.cxx: unitsPerInch = 20*72)
    var upi 72000
    if rtf
        set upi: 1440
    let interp Interpreter.make(host, upi, debug, false, false)
    if rtf
        interp.set_rtf_extensions(true)
    ; argv0 for the interpreter's MessageReporter prefix
    ; (`<argv0>:<file>:<line>:<col>:<sev>: …`) — set BEFORE the stylesheet
    ; loads, so Scheme parse diagnostics already carry it.
    let prog_c0 prog_name.to_c_string()
    Interpreter.set_msg_prog(prog_c0)
    install_builtins(host, interp)
    if load_stylesheet(host, interp, dsl_path, prog_name) = false
    {
        Console.println("dazzle: cannot load stylesheet")
        return 1
    }
    interp.compile()

    ; --- drive the grove through the style engine into the transform sink ----
    ; install the grove ID index so element-with-id resolves IDREF attributes.
    ; (bind first: a chained call as an argument silently drops.)
    let grove_id_index GroveBuilder.build_id_index(host, root)
    interp.set_grove_id_index(grove_id_index)
    ; the document DTD backs the entity-* primitives (grove getEntities axis).
    let doc_dtd ps.get_current_dtd()
    interp.set_grove_dtd(doc_dtd as pointer[void])

    if fot
    {
        ; --- the fot backend: the flow object tree as SGML, written to a FILE
        ; (jade.cxx: default <docbase>.fot; -o overrides) --------------------
        let sgml SgmlFOTBuilder.make(host)
        let pcf ProcessContext.make_fot(host, interp, sgml)
        pcf.process(root)
        sgml.finish()
        let outf sgml.to_utf8()
        var fot_path out_path
        if fot_path.get_length() = (0 as size_t)
            set fot_path: fot_output_name(host, doc_path)
        File.write_from_string(fot_path, outf)
        return doc_rc
    }

    if rtf
    {
        ; --- the rtf backend: written to a FILE (jade.cxx: default
        ; <docbase>.rtf; -o overrides) ---------------------------------------
        let rtfb RtfFOTBuilder.make(host, interp)
        let pcr ProcessContext.make_rtf(host, interp, rtfb)
        pcr.process(root)
        let outr rtfb.finish()
        var rtf_path out_path
        if rtf_path.get_length() = (0 as size_t)
            set rtf_path: rtf_output_name(host, doc_path)
        File.write_from_string(rtf_path, outr)
        return doc_rc
    }

    let fotb TransformFOTBuilder.make(host, xml)
    ; argv0 for the entity-file app messages (`<argv0>:E: cannot open …`).
    let prog_c prog_name.to_c_string()
    TransformFOTBuilder.set_prog_name(prog_c)
    let pc ProcessContext.make(host, interp, fotb)
    pc.process(root)

    ; --- emit the top-level stream (entity/directory FOs wrote their own files)
    let outp fotb.root_to_utf8()
    if out_path.get_length() > (0 as size_t)
        File.write_from_string(out_path, outp)
    else
        Io.write_all(1 as i32, outp.get_buffer() as pointer[void], outp.get_length())
    doc_rc
}

; the default -t fot output name (JadeApp::makeFOTBuilder): the document's
; basename with its extension replaced by ".fot", in the CURRENT directory
; (defaultOutputBasename_ strips the directory).
function fot_output_name(host: pointer[Page], doc_path: String) returns String
{
    let n doc_path.get_length()
    var start: size_t 0
    var dot n
    var i: size_t 0
    while i < n
    {
        let b doc_path.get(i)
        if b = (0x2F as u8)
        {
            set start: i + (1 as size_t)
            set dot: n
        }
        else if b = (0x2E as u8)
            set dot: i
        set i: i + (1 as size_t)
    }
    if dot <= start
        set dot: n
    let sb StringBuilder()
    set i: start
    while i < dot
    {
        sb.append(doc_path.get(i) as char)
        set i: i + (1 as size_t)
    }
    sb.append(".fot")
    sb.to_string()
}

; the default -t rtf output name: the document's basename with its extension
; replaced by ".rtf", in the CURRENT directory.
function rtf_output_name(host: pointer[Page], doc_path: String) returns String
{
    let n doc_path.get_length()
    var start: size_t 0
    var dot n
    var i: size_t 0
    while i < n
    {
        let b doc_path.get(i)
        if b = (0x2F as u8)
        {
            set start: i + (1 as size_t)
            set dot: n
        }
        else if b = (0x2E as u8)
            set dot: i
        set i: i + (1 as size_t)
    }
    if dot <= start
        set dot: n
    let sb StringBuilder()
    set i: start
    while i < dot
    {
        sb.append(doc_path.get(i) as char)
        set i: i + (1 as size_t)
    }
    sb.append(".rtf")
    sb.to_string()
}
