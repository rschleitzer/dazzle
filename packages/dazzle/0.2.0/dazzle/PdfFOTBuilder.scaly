    ; A page-sequence: like a simple-page-sequence without headers and
    ; footers, its pages from its models. i0 = 1, i1/i2 = where its initial
    ; and repeat page models are in `page_models` (-1 none).
    procedure start_page_sequence(mutable this: ref[PdfFOTBuilder])
    {
        let n this.add(PN_PAGE_SEQUENCE)
        n.i0 := 1
        n.i1 := this.next.initial_models
        n.i2 := this.next.repeat_models
        this.open(n)
    }

    procedure end_page_sequence(mutable this: ref[PdfFOTBuilder])
        this.close()

    ; A column-set-sequence: its content set into the columns of its model,
    ; a display-group with the columns of column-set-model (i2 = 1).
    procedure start_column_set_sequence(mutable this: ref[PdfFOTBuilder], dnic: ref[DisplayNIC]?)
    {
        let n this.add(PN_GROUP)
        this.display(n, dnic)
        n.i0 := 0 - 1
        n.i2 := 1
        if this.next.column_model >= 0
        {
            n.i0 := this.next.column_model
            if this.next.column_model_balance
                n.i1 := 1
        }
        else
            this.error("a column-set-sequence without a column-set-model")
        this.open(n)
    }

    procedure end_column_set_sequence(mutable this: ref[PdfFOTBuilder])
        this.close()
}
