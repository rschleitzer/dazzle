    ; --- cross-references, links, index entries ----------------------------
    procedure out_pending_inline_statements(mutable this: ref[MifFOTBuilder])
    {
        let host this.host
        let os this.os()
        if this.link_depth > 1
        {
            let parent this.link_at(this.link_depth - 2)
            if parent.opened_in_mif and (parent.cri <> null)
            {
                this.pending_mif_closings := this.pending_mif_closings + 1
                parent.opened_in_mif := false
            }
        }
        while this.pending_mif_closings > 0
        {
            this.out_marker(os, MIF_MK_TYPE | MIF_MK_TEXT, MIF_MARKER_HYPERTEXT, String())
            this.pending_mif_closings := this.pending_mif_closings - 1
        }
        if this.index_depth > 0
        {
            let mp this.index_entry_stack.get((this.index_depth - 1) as size_t)
            let m *mp
            this.out_marker(os, m.set_props, m.m_type, m.m_text)
            this.index_depth := this.index_depth - 1
        }
        var i 0
        while i < this.node_depth
        {
            let ni this.node_at(i)
            let node ni.node
            if node <> null
            {
                let n node.get_element_index()
                if n >= 0
                {
                    let id node.get_id()
                    let grove_index GroveInfo.index_of(node)
                    let cri MifCrossRefInfo.make(host, MIF_CRI_POTENTIAL_MARKER, grove_index, n, os.ind, id)
                    this.out_cross_ref_info(cri, os)
                    let bci (this.book_components.get_length() as int) - 1
                    if id.get_size() > 0
                        this.set_bc_index_id(grove_index, id, bci)
                    else
                        this.set_bc_index_n(grove_index, n, bci)
                }
            }
            i := i + 1
        }
        this.non_empty_elements_opened := 0
        this.node_depth := 0
        if this.link_depth > 0
        {
            let top this.link_at(this.link_depth - 1)
            if (top.opened_in_mif = false) and (top.cri <> null)
            {
                top.cri.tag_indent := os.ind
                this.out_cross_ref_info(top.cri as ref[MifCrossRefInfo], os)
                top.opened_in_mif := true
            }
        }
    }

    procedure start_link(mutable this: ref[MifFOTBuilder], mutable nic: ref[LinkNIC])
    {
        let host this.host
        var handled false
        if nic.addr_type = ADDR_IDREF
        {
            ; MifFOTBuilder::startLink's idref arm: the params[0] prefix up
            ; to the first space, a cross-ref with element index 0 (the
            ; target is named by ID, not by index) and an unconditional
            ; LinkReference flag on that id — the resolvedNode arm's
            ; id/index fork does not apply here.
            let idfull nic.p0
            let ln idfull.get_size()
            var i: size_t 0
            while i < ln
            {
                if idfull.get(i) = 0x20
                    break
                i := i + 1
            }
            ; ★NOT StringC.substr — see the same cut in RtfFOTBuilder:
            ; its init allocates through Page.get(<stack return slot>).
            let idp StringC^host(idfull.data_ptr(), i)
            let id *idp
            let anode nic.node
            let grove_index GroveInfo.index_of(anode)
            this.link_push()
            let top this.link_at(this.link_depth - 1)
            top.cri := MifCrossRefInfo.make(host, MIF_CRI_HYPERTEXT_LINK, grove_index, 0, 0, id)
            this.set_referenced_flag_id(MIF_REF_LINK, grove_index, id)
            handled := true
        }
        else if nic.addr_type = ADDR_RESOLVED_NODE
        {
            let node nic.node
            if node <> null
            {
                let n node.get_element_index()
                if n >= 0
                {
                    let id node.get_id()
                    let grove_index GroveInfo.index_of(node)
                    this.link_push()
                    let top this.link_at(this.link_depth - 1)
                    top.cri := MifCrossRefInfo.make(host, MIF_CRI_HYPERTEXT_LINK, grove_index, n, 0, id)
                    if id.get_size() > 0
                        this.set_referenced_flag_id(MIF_REF_LINK, grove_index, id)
                    else
                        this.set_referenced_flag_n(MIF_REF_LINK, grove_index, n)
                    handled := true
                }
            }
        }
        if handled = false
            this.link_push()
    }

    procedure end_link(mutable this: ref[MifFOTBuilder])
    {
        if this.link_depth <= 0
            MifFOTBuilder.trap("endLink() with an empty link stack")
        let top this.link_at(this.link_depth - 1)
        if top.opened_in_mif
            this.pending_mif_closings := this.pending_mif_closings + 1
        this.link_depth := this.link_depth - 1
    }

    procedure start_node(mutable this: ref[MifFOTBuilder], node: ref[GroveNode], mode_name: StringC)
    {
        this.cur_node_level := this.cur_node_level + 1
        if mode_name.get_size() = 0
            this.node_push(node, this.cur_node_level)
    }

    procedure end_node(mutable this: ref[MifFOTBuilder])
    {
        if this.node_depth > 0
        {
            let top this.node_at(this.node_depth - 1)
            if top.node_level = this.cur_node_level
            {
                if this.non_empty_elements_opened < this.node_depth
                    this.node_depth := this.node_depth - 1
            }
        }
        this.cur_node_level := this.cur_node_level - 1
    }

    procedure current_node_page_number(mutable this: ref[MifFOTBuilder], mutable node: ref[GroveNode]?)
    {
        let host this.host
        let mc this.mc
        if node = null
            return
        let n node.get_element_index()
        if n < 0
            return
        let id node.get_id()
        let bc this.book_component()
        if bc.pgnum_xref_generated = false
        {
            let xf &MifXRefFormat^host(MIF_XRF_NAME | MIF_XRF_DEF, mc.s_page_num_xref_format_name, String^host("<$pagenum\\>"))
            bc.xref_formats.add(xf)
            bc.pgnum_xref_generated := true
        }
        let os this.os()
        let grove_index GroveInfo.index_of(node)
        let cri MifCrossRefInfo.make(host, MIF_CRI_XREF, grove_index, n, os.ind, id)
        this.out_cross_ref_info(cri, os)
        if id.get_size() > 0
            this.set_referenced_flag_id(MIF_REF_PAGE, grove_index, id)
        else
            this.set_referenced_flag_n(MIF_REF_PAGE, grove_index, n)
    }

    ; --- setCellBackground / colours ---------------------------------------
    procedure make_color(mutable this: ref[MifFOTBuilder], r: int, g: int, b2: int) returns ref[MifColor]
    {
        let host this.host
        let c host.allocate(sizeof MifColor, alignof MifColor) as pointer[MifColor]
        let arr Array[u8]^host()
        MifFOTBuilder.arr_raw(arr, "RGB-")
        MifFOTBuilder.arr_udec(arr, r)
        arr.add(0x2D)
        MifFOTBuilder.arr_udec(arr, g)
        arr.add(0x2D)
        MifFOTBuilder.arr_udec(arr, b2)
        c.tag := MifFOTBuilder.str_from_bytes(host, arr)
        c.set_props := MIF_COL_TAG
        if (r >= g) and (r >= b2)
        {
            c.black := ((255 - r) as double) / 2.55
            c.yellow := ((r - b2) as double) / 2.55
            c.magenta := ((r - g) as double) / 2.55
            c.cyan := 0.0
        }
        else if (g >= r) and (g >= b2)
        {
            c.black := ((255 - g) as double) / 2.55
            c.cyan := ((g - r) as double) / 2.55
            c.yellow := ((g - b2) as double) / 2.55
            c.magenta := 0.0
        }
        else
        {
            c.black := ((255 - b2) as double) / 2.55
            c.cyan := ((b2 - r) as double) / 2.55
            c.magenta := ((b2 - g) as double) / 2.55
            c.yellow := 0.0
        }
        c.set_props := c.set_props | MIF_COL_BLACK | MIF_COL_YELLOW | MIF_COL_MAGENTA | MIF_COL_CYAN
        c
    }

    procedure intern_color(mutable this: ref[MifFOTBuilder], c: ref[MifColor])
    {
        let bc this.book_component()
        if MifFOTBuilder.color_lookup(bc, c.tag) = null
            this.color_insert(bc, c)
    }

    ; --- setFontFamilyName --------------------------------------------------
    procedure set_font_family_name(mutable this: ref[MifFOTBuilder], name: StringC)
    {
        let host this.host
        let arr Array[u8]^host()
        MifFOTBuilder.arr_stringc(arr, name)
        this.next_format.f_family := MifFOTBuilder.str_from_bytes(host, arr)
    }

    ; --- the inherited-characteristic dispatch ------------------------------
    procedure set_ic(mutable this: ref[MifFOTBuilder], ic: ref[InheritedC])
    {
        let mc this.mc
        let ext ic.ext_setter
        if ext <> 0
        {
            this.set_extension_ic(ext, ic)
            return
        }
        let index ic.get_index()
        if index = 0
            this.next_format.f_size := ic.lval
        else if index = 1
            this.set_font_family_name(ic.sval)
        else if index = 2
        {
            if ic.sym.code > MIF_SYM_MEDIUM
                this.next_format.f_weight := mc.s_bold
            else
                this.next_format.f_weight := mc.s_regular
        }
        else if index = 3
        {
            let p ic.sym.code
            if (p = MIF_SYM_OBLIQUE) or (p = MIF_SYM_BS_OBLIQUE) or (p = MIF_SYM_ITALIC) or (p = MIF_SYM_BS_ITALIC)
                this.next_format.f_angle := mc.s_italic
            else
                this.next_format.f_angle := mc.s_regular
        }
        else if index = 4
        {
            let q ic.sym.code
            if q = MIF_SYM_END
                this.next_format.pgf_alignment := mc.s_right
            else if q = MIF_SYM_CENTER
                this.next_format.pgf_alignment := mc.s_center
            else if q = MIF_SYM_JUSTIFY
                this.next_format.pgf_alignment := mc.s_left_right
            else
                this.next_format.pgf_alignment := mc.s_left
        }
        else if index = 5
            this.next_format.fot_display_alignment := ic.sym.code
        else if index = 6
            this.next_format.fot_field_align := ic.sym.code
        else if index = 7
            this.next_format.fot_lines := ic.sym.code
        else if index = 8
            this.next_format.fot_start_indent := ic.ls
        else if index = 9
            this.next_format.fot_first_line_start_indent := ic.ls
        else if index = 10
            this.next_format.fot_end_indent := ic.ls
        else if index = 12
            this.next_format.fot_line_spacing := ic.ls
        else if index = 13
            this.next_format.fot_field_width := ic.ls
        else if index = 14
            this.next_format.fot_left_margin := ic.lval
        else if index = 15
            this.next_format.fot_right_margin := ic.lval
        else if index = 16
            this.next_format.fot_top_margin := ic.lval
        else if index = 17
            this.next_format.fot_bottom_margin := ic.lval
        else if index = 18
            this.next_format.fot_header_margin := ic.lval
        else if index = 19
            this.next_format.fot_footer_margin := ic.lval
        else if index = 20
            this.next_format.fot_page_width := ic.lval
        else if index = 21
            this.next_format.fot_page_height := ic.lval
        else if index = 22
            this.next_format.fot_border_present := ic.bval
        else if index = 23
            this.next_format.fot_line_thickness := ic.lval
        else if index = 24
            this.next_format.pgf_cm_t := ic.lval
        else if index = 25
            this.next_format.pgf_cm_b := ic.lval
        else if index = 26
            this.next_format.pgf_cm_l := ic.lval
        else if index = 27
            this.next_format.pgf_cm_r := ic.lval
        else if index = 28
            this.next_format.fot_line_sep := ic.lval
        else if index = 31
            this.next_format.fot_position_point_shift := ic.ls
        else if index = 44
            this.next_format.pgf_hyphenate := ic.bval
        else if index = 45
            this.next_format.f_pair_kern := ic.bval
        else if index = 51
            this.next_format.fot_cell_background := ic.bval
        else if index = 67
            this.next_format.fot_line_cap := ic.sym.code
        else if index = 70
            this.next_format.fot_input_whitespace := ic.sym.code
        else if index = 87
        {
            let a ic.sym.code
            if a = MIF_SYM_END
                this.next_format.pgf_cell_alignment := mc.s_bottom
            else if a = MIF_SYM_CENTER
                this.next_format.pgf_cell_alignment := mc.s_middle
            else
                this.next_format.pgf_cell_alignment := mc.s_top
        }
        else if index = 97
            this.next_format.fot_border_priority := ic.lval
        else if index = 98
            this.next_format.fot_line_repeat := ic.lval
        else if index = 99
            this.next_format.fot_span := ic.lval
        else if index = 101
            this.next_format.hyphen_min_prefix := ic.lval
        else if index = 102
            this.next_format.hyphen_min_suffix := ic.lval
        else if index = 103
            this.next_format.pgf_block_size := ic.lval
        else if index = 104
            this.next_format.pgf_block_size := ic.lval
        else if index = 132
        {
            var code 0
            if ic.bval = false
            {
                if ic.sval.get_size() >= 2
                    code := (((ic.sval.get(0) & 0xFF) as int) << 8) | ((ic.sval.get(1) & 0xFF) as int)
            }
            this.next_format.fot_language := code
            this.compute_pgf_language(this.next_format)
        }
        else if index = 133
        {
            var code2 0
            if ic.bval = false
            {
                if ic.sval.get_size() >= 2
                    code2 := (((ic.sval.get(0) & 0xFF) as int) << 8) | ((ic.sval.get(1) & 0xFF) as int)
            }
            this.next_format.fot_country := code2
            this.compute_pgf_language(this.next_format)
        }
        else if index = 135
            this.next_format.hyphen_max_lines := ic.lval
        else if index = 155
        {
            if ic.obj <> null
            {
                let rgb ic.obj.color_rgb()
                let c this.make_color((rgb >> 16) & 0xFF, (rgb >> 8) & 0xFF, rgb & 0xFF)
                this.next_format.f_color := c.tag
                this.intern_color(c)
            }
        }
        else if index = 156
        {
            if ic.obj = null
                this.next_format.mif_background_color := String()
            else
            {
                let rgb2 ic.obj.color_rgb()
                let c2 this.make_color((rgb2 >> 16) & 0xFF, (rgb2 >> 8) & 0xFF, rgb2 & 0xFF)
                this.next_format.mif_background_color := c2.tag
                this.intern_color(c2)
            }
        }
        else if index = 159
        {
            if ic.bval
                this.next_format.fot_min_leading_has := false
            else
                this.next_format.fot_min_leading_has := true
        }
    }

    ; the jade.cxx makeMifFOTBuilder extension table (3 characteristics)
    procedure set_extension_ic(mutable this: ref[MifFOTBuilder], ext: int, ic: ref[InheritedC])
    {
        if ext = 1
        {
            this.next_format.fot_page_n_columns := ic.lval
            let bc this.book_component()
            bc.d_columns := ic.lval
            bc.doc_set := bc.doc_set | MIF_DOC_COLUMNS
            return
        }
        if ext = 2
        {
            this.next_format.fot_page_column_sep := ic.lval
            let bc2 this.book_component()
            bc2.d_column_gap := ic.lval
            bc2.doc_set := bc2.doc_set | MIF_DOC_COLUMNGAP
            return
        }
        if ext = 3
            this.next_format.fot_page_balance := ic.bval
    }

    ; --- the index-entry extension flow object ------------------------------
    procedure index_entry(mutable this: ref[MifFOTBuilder], nic: ref[IndexEntryNIC])
    {
        let host this.host
        let components nic.components
        let sort_string nic.sort_string
        let page_number nic.page_number
        let starts_range nic.starts_page_range
        let ends_range nic.ends_page_range
        let n components.get_length()
        if n = 0
            return
        let arr Array[u8]^host()
        if page_number = false
            MifFOTBuilder.arr_raw(arr, "<$nopage>")
        if starts_range
            MifFOTBuilder.arr_raw(arr, "<$startrange>")
        if ends_range
            MifFOTBuilder.arr_raw(arr, "<$endrange>")
        var i: size_t 0
        while i < n
        {
            if i > 0
                arr.add(0x3A)
            let cp components.get(i)
            MifFOTBuilder.arr_stringc(arr, *cp)
            i := i + 1
        }
        if sort_string.get_size() > 0
        {
            arr.add(0x5B)
            MifFOTBuilder.arr_stringc(arr, sort_string)
            arr.add(0x5D)
        }
        let m &MifMarker^host(MIF_MK_TYPE | MIF_MK_TEXT, MIF_MARKER_INDEX, MifFOTBuilder.str_from_bytes(host, arr))
        this.index_push(m)
    }
    ; --- the INLINE/MARK family -------------------------------------------------
    ; None of these six classes is overridden by the reference Mif backend, so the
    ; plain FOTBuilder brackets apply. ★`character` is the interesting one: the
    ; base EMITS THE CHARACTER as text when the NIC is valid, then takes the
    ; atomic bracket (FOTBuilder.cxx:174) — measured (`-t rtf` renders
    ; `(make character char: #\A)` as an "A").
    procedure character(mutable this: ref[MifFOTBuilder], nic: ref[CharacterNIC])
    {
        if nic.valid
        {
            var buf u32[1]
            *(buf as pointer[u32]) := nic.ch
            this.characters( Slice[u32](1, buf as pointer[u32]))
        }
        this.mif_atomic()
    }

