define MifTablePart
(
    var columns: ref[Array[ref[MifColumn]?]]?
    var header: ref[Array[ref[MifFotRow]?]]
    var body: ref[Array[ref[MifFotRow]?]]?
    var footer: ref[Array[ref[MifFotRow]?]]
    var mif_table_num: int
    var columns_processed: bool
    var needs_col_reproc: bool
)
{
    function make(host: ref[Page]) returns ref[MifTablePart]
    {
        let p &MifTablePart^host(Array[ref[MifColumn]?]^host(), Array[ref[MifFotRow]?]^host(), Array[ref[MifFotRow]?]^host(), Array[ref[MifFotRow]?]^host(), 0, false, false)
        p
    }
}

define MifTable
(
    var parts: ref[Array[ref[MifTablePart]?]]?
    before_row_border: ref[MifBorder]
    after_row_border: ref[MifBorder]
    before_column_border: ref[MifBorder]
    after_column_border: ref[MifBorder]
    var table_width: int
    var display_alignment: int
    var start_indent: int
    var cur_part: ref[MifTablePart]?
    var cur_cell: ref[MifFotCell]?
    ; Table::CurRows — a DIRECT pointer, as in the reference: it survives a
    ; table's end and a stray table-row then appends to the stale (but live)
    ; row list instead of asserting.
    var cur_rows: ref[Array[ref[MifFotRow]?]]?
    var default_tblfmt_generated: bool
    var no_parts_seen: bool
)
{
    function make(host: ref[Page]) returns ref[MifTable]
    {
        let t &MifTable^host(Array[ref[MifTablePart]?]^host(), MifBorder.make(host, false), MifBorder.make(host, false), MifBorder.make(host, false), MifBorder.make(host, false), 0, 0, 0, null, null, null, false, true)
        t
    }
}

; --- display / link / node bookkeeping ------------------------------------
define MifDisplayInfo
(
    space_before: DisplaySpace
    space_after: DisplaySpace
    keep: int
    break_before: int
    break_after: int
    keep_with_previous: bool
    keep_with_next: bool
    may_violate_keep_before: bool
    may_violate_keep_after: bool
    var first_para_outputed: bool
    var is_paragraph: bool
    var para_closed_in_mif: bool
    keep_within_page: bool
)
{
    function make(host: ref[Page]) returns ref[MifDisplayInfo]
    {
        let d &MifDisplayInfo^host(DisplaySpace(), DisplaySpace(), 0, 0, 0, false, false, false, false, false, false, false, false)
        d
    }
}

define MifDsi (space: DisplaySpace, break_type: int, break_is_after: bool)
{
    function make(host: ref[Page]) returns ref[MifDsi]
    {
        let d &MifDsi^host(DisplaySpace(), 0, false)
        d
    }
}

; EffectiveDisplaySpace — a value record
define MifEds (var nominal: int, var min: int, var max: int, priority: int, conditional: bool, force: bool)
{
    init()
    {
        this.nominal := 0
        this.min := 0
        this.max := 0
        this.priority := 0
        this.conditional := true
        this.force := false
    }
}

define MifNodeInfo (node: ref[GroveNode]?, node_level: int)

define MifLinkInfo (var cri: ref[MifCrossRefInfo]?, var opened_in_mif: bool)
{
    function make(host: ref[Page]) returns ref[MifLinkInfo]
    {
        let l &MifLinkInfo^host(null, false)
        l
    }
}

; TFotSimplePageSequence
define MifSps
(
    var body: ref[MifTagStream]?
    var first_header: ref[MifTagStream]?
    var first_footer: ref[MifTagStream]?
    var left_header: ref[MifTagStream]?
    var left_footer: ref[MifTagStream]?
    var right_header: ref[MifTagStream]?
    var right_footer: ref[MifTagStream]?
    para_fmt: ref[MifFormat]
)
{
    function make(host: ref[Page]) returns ref[MifSps]
    {
        let s &MifSps^host(null, null, null, null, null, null, null, MifFormat.make(host))
        s
    }
}

define MifFOTBuilder
(
    host: ref[Page]
    mc: ref[MifConsts]
    ; --- MifDoc state -------------------------------------------------------
    out_loc: String
    var next_id: int
    var obj_id_cnt: int
    var cur_os: ref[MifOS]?
    book_components: ref[Array[ref[MifBookComponent]?]]
    var cur_tbl_num: int
    var doc_format: ref[MifFormat]
    var cur_text_flow: ref[MifTagStream]?
    var cur_cell: ref[MifTagStream]?
    var cur_para: ref[MifTagStream]?
    ts_stack: ref[Array[ref[MifTagStream]?]]
    var ts_depth: int
    cross_ref_infos: ref[Array[ref[MifCrossRefInfo]?]]
    ; ElementSet: the SgmlIdInfo PointerTable + the per-grove flag vectors
    var elem_slots: ref[Array[ref[MifSgmlIdInfo]?]]
    var elem_used: int
    var elem_limit: int
    elem_flags: ref[Array[ref[Array[int]]?]]
    ; the statics: Para::currentlyOpened, ParaLine::setProperties/TextRectID/ATbl
    var para_currently_opened: bool
    var paraline_set: int
    var paraline_text_rect_id: int
    var paraline_atbl: int
    ; --- MifFOTBuilder state ------------------------------------------------
    char_table: ref[Array[int]]
    format_stack: ref[Array[ref[MifFormat]?]]
    var format_depth: int
    next_format: ref[MifFormat]
    display_stack: ref[Array[ref[MifDisplayInfo]?]]
    var display_depth: int
    dsq: ref[Array[ref[MifDsi]?]]
    var dsq_head: int
    var dsq_tail: int
    node_stack: ref[Array[ref[MifNodeInfo]?]]?
    var node_depth: int
    link_stack: ref[Array[ref[MifLinkInfo]?]]
    var link_depth: int
    index_entry_stack: ref[Array[ref[MifMarker]?]]
    var index_depth: int
    var pending_break: int
    var pending_eds: MifEds
    var non_empty_elements_opened: int
    var cur_node_level: int
    var pending_mif_closings: int
    var paragraph_break_in_effect: bool
    var in_leader: bool
    var last_flow_object_was_whitespace: bool
    var first_header_footer: bool
    var in_simple_page_sequence: bool
    var book_component_opened: bool
    var book_component_available: bool
    var cur_leader_stream: ref[MifTmp]?
    sps: ref[MifSps]
    cur_table: ref[MifTable]
    ; the port passes a null NIC pointer where the reference has a
    ; default-constructed one; these stand in for it
    default_dnic: ref[DisplayNIC]
    default_cell_nic: ref[TableCellNIC]
)
{
    procedure make(host: ref[Page], mutable out_loc: String) returns ref[MifFOTBuilder]
    {
        let f &MifFOTBuilder^host(host, MifConsts.make(host), out_loc, 0, 0, null, Array[ref[MifBookComponent]?]^host(), 0, MifFormat.make(host), null, null, null, Array[ref[MifTagStream]?]^host(), 0, Array[ref[MifCrossRefInfo]?]^host(), Array[ref[MifSgmlIdInfo]?]^host(), 0, 0, Array[ref[Array[int]]?]^host(), false, 0, 0, 0, Array[int]^host(), Array[ref[MifFormat]?]^host(), 0, MifFormat.make(host), Array[ref[MifDisplayInfo]?]^host(), 0, Array[ref[MifDsi]?]^host(), 0, 0, Array[ref[MifNodeInfo]?]^host(), 0, Array[ref[MifLinkInfo]?]^host(), 0, Array[ref[MifMarker]?]^host(), 0, MIF_SYM_FALSE, MifEds(), 0, 0, 0, false, false, false, true, false, false, false, null, MifSps.make(host), MifTable.make(host), DisplayNIC.make(host), TableCellNIC.make(host))
        ; the CharMap: a flat table over the reachable code-point range
        var z 0
        while z < MIF_CHAR_TABLE_SIZE
        {
            f.char_table.add(0)
            z := z + 1
        }
        ; the MifDoc ctor: strip a trailing NUL, then enterBookComponent()
        f.enter_book_component()
        ; the MifFOTBuilder ctor
        f.next_format.set_dsssl_defaults(f.mc)
        f.next_format.fot_cur_display_size := (72000 * 8) - 2
        f.format_push()
        f.init_mif_book_component()
        f.book_component_opened := true
        f.book_component_available := true
        f.build_char_table()
        f
    }

    ; --- messages -----------------------------------------------------------
    procedure trap(what: Slice[char])
    {
        if mif_prog <> null
            scaly_eputs(mif_prog)
        scaly_eputs ":E: MifFOTBuilder invariant violated: "
        write(2, what.data as pointer[void], what.length)
        scaly_eputnl()
        exit(17)
    }

    procedure set_prog_name(prog: pointer[const_char]) mutable mif_prog
        mif_prog := prog

    ; MifMessages W0 (no location): `<prog>:W: <text>`
    procedure msg_w(text: Slice[char])
    {
        if mif_prog <> null
            scaly_eputs(mif_prog)
        scaly_eputs ":W: "
        write(2, text.data as pointer[void], text.length)
        scaly_eputnl()
    }

    ; MifMessages E1 systemIdNotFilename
    procedure msg_system_id_not_filename(sysid: StringC)
    {
        if mif_prog <> null
            scaly_eputs(mif_prog)
        scaly_eputs ":E: MIF: could not convert system identifier "
        let n sysid.get_size()
        var i: size_t 0
        var buf u8[2]
        while i < n
        {
            buf[0] := (sysid.get(i) & 0xFF) as u8
            buf[1] := 0
            scaly_eputs(buf as pointer[const_char])
            i := i + 1
        }
        scaly_eputs " to a single filename"
        scaly_eputnl()
    }

    ; MifMessages E2 cannotOpenOutputError
    procedure msg_cannot_open(name: String, err: i32)
    {
        if mif_prog <> null
            scaly_eputs(mif_prog)
        scaly_eputs ":E: MIF: cannot open output file "
        let c name.to_c_string()
        scaly_eputs(c)
        scaly_eputs " ("
        scaly_eputs(strerror(err))
        scaly_eputs ")"
        scaly_eputnl()
    }

    ; --- String helpers -----------------------------------------------------
    function str_from_bytes(host: ref[Page], arr: ref[Array[u8]]) returns String
    {
        let n arr.get_length()
        if n = 0
            return String()
        String^host(arr.get_buffer() as pointer[const_char], n)
    }

    function bytes_of(host: ref[Page], s: String) returns ref[Array[u8]]
    {
        let a Array[u8]^host()
        let n s.get_length()
        if n = 0
            return a
        let p s.as_slice()
        var i: size_t 0
        while i < n
        {
            a.add(p[i])
            i := i + 1
        }
        a
    }

    procedure str_cat(host: ref[Page], mutable a: String, b2: String) returns String
    {
        let arr MifFOTBuilder.bytes_of(host, a)
        let n b2.get_length()
        if n > 0
        {
            let p b2.as_slice()
            var i: size_t 0
            while i < n
            {
                arr.add(p[i])
                i := i + 1
            }
        }
        MifFOTBuilder.str_from_bytes(host, arr)
    }

    function str_of_c(host: ref[Page], s: Slice[char]) returns String
        String^host(s.data, s.length)

    ; append the decimal of an unsigned long to a byte array
    procedure arr_udec(mutable arr: ref[Array[u8]], n_in: int)
    {
        var n n_in
        if n = 0
        {
            arr.add(0x30)
            return
        }
        var digits u8[24]
        var k 0
        while n > 0
        {
            digits[k] := ((n % 10) + 0x30) as u8
            n := n / 10
            k := k + 1
        }
        while k > 0
        {
            k := k - 1
            arr.add(digits[k])
        }
    }

    procedure arr_raw(mutable arr: ref[Array[u8]], s: Slice[char])
    {
        var i: size_t 0
        while i < s.length
        {
            arr.add(s[i] as u8)
            i := i + 1
        }
    }

    procedure arr_str(mutable arr: ref[Array[u8]], s: String)
    {
        let n s.get_length()
        if n = 0
            return
        let p s.as_slice()
        var i: size_t 0
        while i < n
        {
            arr.add(p[i])
            i := i + 1
        }
    }

    procedure arr_stringc(mutable arr: ref[Array[u8]], s: StringC)
    {
        let n s.get_size()
        var i: size_t 0
        while i < n
        {
            arr.add((s.get(i) & 0xFF) as u8)
            i := i + 1
        }
    }

    procedure arr_hex_char(mutable arr: ref[Array[u8]], code: int)
    {
        arr.add(0x5C)
        arr.add(0x78)
        arr.add(MifFOTBuilder.hex_digit((code >> 4) & 0xF))
        arr.add(MifFOTBuilder.hex_digit(code & 0xF))
        arr.add(0x20)
    }

    function hex_digit(v: int) returns u8
    {
        if v < 10
            return (v + 0x30) as u8
        (v - 10 + 0x61) as u8
    }

    ; T_string::escapeSpecialChars
    function escape_special_chars(host: ref[Page], s: String) returns String
    {
        let n s.get_length()
        if n = 0
            return s
        let p s.as_slice()
        let arr Array[u8]^host()
        var changed false
        var i: size_t 0
        while i < n
        {
            let c p[i]
            if c = 0x0A
                changed := true
            else if c = 0x0D
                changed := true
            else if c = 0x09
            {
                MifFOTBuilder.arr_raw(arr, "\\t")
                changed := true
            }
            else if c = 0x3E
            {
                MifFOTBuilder.arr_raw(arr, "\\>")
                changed := true
            }
            else if c = 0x27
            {
                MifFOTBuilder.arr_raw(arr, "\\q")
                changed := true
            }
            else if c = 0x60
            {
                MifFOTBuilder.arr_raw(arr, "\\Q")
                changed := true
            }
            else if c = 0x5C
            {
                MifFOTBuilder.arr_raw(arr, "\\\\")
                changed := true
            }
            else if c >= 0x80
            {
                changed := true
                MifFOTBuilder.arr_hex_char(arr, c as int)
            }
            else
                arr.add(c)
            i := i + 1
        }
        if changed = false
            return s
        MifFOTBuilder.str_from_bytes(host, arr)
    }

    ; --- the CharMap --------------------------------------------------------
    function char_at(this: ref[MifFOTBuilder], c: int) returns int
    {
        if c < 0
            return 0
        if c >= MIF_CHAR_TABLE_SIZE
            return 0
        let p this.char_table.get(c as size_t)
        *p
    }

    procedure char_set(mutable this: ref[MifFOTBuilder], c: int, v: int)
    {
        if c < 0
            return
        if c >= MIF_CHAR_TABLE_SIZE
            return
        this.char_table.put(c as size_t, v)
    }

    procedure build_char_table(mutable this: ref[MifFOTBuilder])
    {
        var i 0
        while i < 128
        {
            let c *(MIF_FRAME_CHARSET_MAP + i) as int
            if c <> 0
            {
                if this.char_at(i + 0x80) = 0
                    this.char_set(i + 0x80, c)
            }
            i := i + 1
        }
        var fi 0
        while fi < MIF_N_SYMBOL_FONTS
        {
            var j 0
            while j < 256
            {
                let c *(MIF_SYMBOL_FONT_MAP + ((fi * 256) + j)) as int
                if c <> 0
                {
                    if this.char_at(c) = 0
                        this.char_set(c, j | (fi << 16) | MIF_CHAR_TABLE_SYMBOL_FLAG)
                }
                j := j + 1
            }
            fi := fi + 1
        }
    }

    procedure symbol_font_name(mutable this: ref[MifFOTBuilder], n: int) returns String
    {
        if n = 0
            return String^this.host("Symbol")
        if n = 1
            return String^this.host("Wingdings")
        String^this.host("ZapfDingbats")
    }

    ; --- book components / tag streams -------------------------------------
    procedure book_component(this: ref[MifFOTBuilder]) returns ref[MifBookComponent]
    {
        let n this.book_components.get_length()
        if n = 0
            MifFOTBuilder.trap("bookComponent() with no book component")
        let p this.book_components.get(n - 1)
        *p as ref[MifBookComponent]
    }

    procedure next_object_id(mutable this: ref[MifFOTBuilder]) returns int
    {
        this.obj_id_cnt := this.obj_id_cnt + 1
        this.obj_id_cnt
    }

    procedure alloc_id(mutable this: ref[MifFOTBuilder]) returns int
    {
        this.next_id := this.next_id + 1
        this.next_id
    }

    procedure os(this: ref[MifFOTBuilder]) returns ref[MifOS]
    {
        if this.cur_os = null
            MifFOTBuilder.trap("os() with no current stream")
        this.cur_os as ref[MifOS]
    }

    procedure cur_tag_stream(this: ref[MifFOTBuilder]) returns ref[MifTagStream]
    {
        if this.ts_depth <= 0
            MifFOTBuilder.trap("curTagStream() on an empty stack")
        let p this.ts_stack.get((this.ts_depth - 1) as size_t)
        *p as ref[MifTagStream]
    }

    procedure switch_to_tag_stream(mutable this: ref[MifFOTBuilder], mutable ts: ref[MifTagStream], default_pgf: bool)
    {
        if ts.ts_class = MIF_TS_TEXTFLOW
            this.cur_text_flow := ts
        else if ts.ts_class = MIF_TS_CELL
            this.cur_cell := ts
        if ts.ts_class = MIF_TS_PARA
            this.para_currently_opened := true
        else if default_pgf
        {
            ts.pgf_tag_used := false
            let host this.host
            let d MifFormat.make(host)
            d.set_dsssl_defaults(this.mc)
            this.doc_format := d
        }
        this.cur_os := ts.content.os
    }

    procedure enter_tag_stream(mutable this: ref[MifFOTBuilder], mutable ts: ref[MifTagStream]?)
    {
        let d this.ts_depth as size_t
        if d < this.ts_stack.get_length()
            this.ts_stack.put(d, ts)
        else
            this.ts_stack.add(ts)
        this.ts_depth := this.ts_depth + 1
        this.switch_to_tag_stream(ts as ref[MifTagStream], true)
    }

    procedure exit_tag_stream(mutable this: ref[MifFOTBuilder])
    {
        var default_pgf true
        if this.ts_depth <= 0
            MifFOTBuilder.trap("exitTagStream() on an empty stack")
        let top this.cur_tag_stream()
        if top.ts_class = MIF_TS_PARA
        {
            this.para_currently_opened := false
            default_pgf := false
        }
        this.ts_depth := this.ts_depth - 1
        if this.ts_depth >= 1
        {
            let nt this.cur_tag_stream()
            this.switch_to_tag_stream(nt, default_pgf)
        }
    }

    procedure enter_book_component(mutable this: ref[MifFOTBuilder])
    {
        let host this.host
        let ts MifTagStream.make(host, MIF_TS_PLAIN, 0, this.mc)
        this.enter_tag_stream(ts)
        this.book_components.add(MifBookComponent.make(host, ts.content))
    }

    procedure exit_book_component(mutable this: ref[MifFOTBuilder])
        this.exit_tag_stream()

    procedure enter_text_flow(mutable this: ref[MifFOTBuilder], mutable tf: ref[MifTagStream]?)
        this.enter_tag_stream(tf)

    procedure exit_text_flow(mutable this: ref[MifFOTBuilder])
    {
        this.cur_text_flow := null
        this.exit_tag_stream()
    }

    procedure enter_table_cell(mutable this: ref[MifFOTBuilder], mutable cell: ref[MifTagStream])
        this.enter_tag_stream(cell)

    procedure exit_table_cell(mutable this: ref[MifFOTBuilder])
    {
        this.cur_cell := null
        this.exit_tag_stream()
    }

    procedure enter_para(mutable this: ref[MifFOTBuilder], mutable p: ref[MifTagStream])
        this.enter_tag_stream(p)

    procedure exit_para(mutable this: ref[MifFOTBuilder])
    {
        this.cur_para := null
        this.exit_tag_stream()
    }

    procedure cur_tbl(this: ref[MifFOTBuilder]) returns ref[MifTbl]?
    {
        if this.cur_tbl_num <= 0
            return null
        let bc this.book_component()
        let p bc.tbls.get((this.cur_tbl_num - 1) as size_t)
        *p
    }

    procedure cur_tbl_asserted(this: ref[MifFOTBuilder]) returns ref[MifTbl]?
    {
        if this.cur_tbl_num <= 0
            MifFOTBuilder.trap("curTbl() with CurTblNum == 0")
        this.cur_tbl()
    }

    ; --- format stack -------------------------------------------------------
    procedure format_push(mutable this: ref[MifFOTBuilder])
    {
        let host this.host
        let d this.format_depth as size_t
        if d < this.format_stack.get_length()
        {
            let p this.format_stack.get(d)
            MifFormat.copy_all(host, (*p) as ref[MifFormat], this.next_format)
        }
        else
        {
            let rec MifFormat.make(host)
            MifFormat.copy_all(host, rec, this.next_format)
            this.format_stack.add(rec)
        }
        this.format_depth := this.format_depth + 1
    }

    procedure format(this: ref[MifFOTBuilder]) returns ref[MifFormat]
    {
        if this.format_depth <= 0
            MifFOTBuilder.trap("format() on an empty format stack")
        let p this.format_stack.get((this.format_depth - 1) as size_t)
        *p as ref[MifFormat]
    }

    ; FOTBuilder::start()
    procedure mif_start(mutable this: ref[MifFOTBuilder])
    {
        this.non_empty_elements_opened := this.node_depth
        let host this.host
        let d this.format_depth as size_t
        var eff: ref[MifFormat]? null
        if d < this.format_stack.get_length()
        {
            let p this.format_stack.get(d)
            eff := *p
            MifFormat.copy_all(host, eff as ref[MifFormat], this.next_format)
        }
        else
        {
            eff := MifFormat.make(host)
            MifFormat.copy_all(host, eff as ref[MifFormat], this.next_format)
            this.format_stack.add(eff)
        }
        if this.next_format.f_size > 0
        {
            let shift this.compute_length_spec(this.next_format.fot_position_point_shift)
            eff.f_dy := ((shift * (0 - 100)) as double) / (this.next_format.f_size as double)
            eff.ff_set := eff.ff_set | MIF_FF_DY
        }
        this.format_depth := this.format_depth + 1
    }

    ; FOTBuilder::end()
    procedure mif_end(mutable this: ref[MifFOTBuilder])
    {
        if this.format_depth <= 1
            MifFOTBuilder.trap("end() underflows the format stack")
        this.format_depth := this.format_depth - 1
        let host this.host
        MifFormat.copy_all(host, this.next_format, this.format())
    }

    ; FOTBuilder::atomic() — start() then end().
    procedure mif_atomic(mutable this: ref[MifFOTBuilder])
    {
        this.mif_start()
        this.mif_end()
    }

    procedure compute_length_spec(this: ref[MifFOTBuilder], spec: LengthSpec) returns int
    {
        if spec.factor = 0.0
            return spec.length
        let tem (this.format().fot_cur_display_size as double) * spec.factor
        if tem >= 0.0
            return spec.length + ((tem + 0.5) as int)
        spec.length + ((tem - 0.5) as int)
    }

    procedure make_eds(this: ref[MifFOTBuilder], ds: DisplaySpace) returns MifEds
    {
        var e MifEds()
        e.nominal := this.compute_length_spec(ds.nominal)
        e.min := this.compute_length_spec(ds.min)
        e.max := this.compute_length_spec(ds.max)
        e.priority := ds.priority
        e.conditional := ds.conditional
        e.force := ds.force
        e
    }

    ; EffectiveDisplaySpace::combine
    procedure eds_combine(mutable dst: ref[MifEds], src: MifEds)
    {
        if src.force
        {
            if dst.force
            {
                dst.nominal := dst.nominal + src.nominal
                dst.min := dst.min + src.min
                dst.max := dst.max + src.max
            }
            else
                dst := src
            return
        }
        if src.priority > dst.priority
        {
            dst := src
            return
        }
        if src.priority <> dst.priority
            return
        if src.nominal > dst.nominal
        {
            dst := src
            return
        }
        if src.nominal <> dst.nominal
            return
        if src.min < dst.min
            dst.min := src.min
        if src.max > dst.max
            dst.max := src.max
    }

    ; --- the display-space queue (IQueue: FIFO) -----------------------------
    procedure dsq_append(mutable this: ref[MifFOTBuilder], space: DisplaySpace, break_type: int, break_is_after: bool)
    {
        let host this.host
        let t this.dsq_tail as size_t
        var d: ref[MifDsi]? null
        if t < this.dsq.get_length()
        {
            let p this.dsq.get(t)
            d := *p
        }
        else
        {
            d := MifDsi.make(host)
            this.dsq.add(d)
        }
        d.space := space
        d.break_type := break_type
        d.break_is_after := break_is_after
        this.dsq_tail := this.dsq_tail + 1
    }

    ; --- the display stack (IList: LIFO) ------------------------------------
    function display_head(this: ref[MifFOTBuilder]) returns ref[MifDisplayInfo]?
    {
        if this.display_depth <= 0
            return null
        let p this.display_stack.get((this.display_depth - 1) as size_t)
        *p
    }

    procedure display_push(mutable this: ref[MifFOTBuilder], nic: ref[DisplayNIC])
    {
        let host this.host
        let parent this.display_head()
        let d this.display_depth as size_t
        var di: ref[MifDisplayInfo]? null
        if d < this.display_stack.get_length()
        {
            let p this.display_stack.get(d)
            di := *p
        }
        else
        {
            di := MifDisplayInfo.make(host)
            this.display_stack.add(di)
        }
        di.space_before := nic.space_before
        di.space_after := nic.space_after
        di.keep := nic.keep.code
        di.break_before := nic.break_before.code
        di.break_after := nic.break_after.code
        di.keep_with_previous := nic.keep_with_previous
        di.keep_with_next := nic.keep_with_next
        di.may_violate_keep_before := nic.may_violate_keep_before
        di.may_violate_keep_after := nic.may_violate_keep_after
        di.first_para_outputed := false
        di.is_paragraph := false
        di.para_closed_in_mif := false
        if nic.keep.code = MIF_SYM_PAGE
            di.keep_within_page := true
        else
        {
            if parent <> null
                di.keep_within_page := parent.keep_within_page
            else
                di.keep_within_page := false
        }
        this.display_depth := this.display_depth + 1
    }

    ; --- the node / link / index-entry stacks -------------------------------
    procedure node_push(mutable this: ref[MifFOTBuilder], node: ref[GroveNode], level: int)
    {
        let host this.host
        let d this.node_depth as size_t
        var ni: ref[MifNodeInfo]? null
        if d < this.node_stack.get_length()
        {
            let p this.node_stack.get(d)
            ni := *p
        }
        else
        {
            ni := host.allocate(sizeof MifNodeInfo, alignof MifNodeInfo) as pointer[MifNodeInfo]
            this.node_stack.add(ni)
        }
        ni.node := node
        ni.node_level := level
        this.node_depth := this.node_depth + 1
    }

    function node_at(this: ref[MifFOTBuilder], i: int) returns ref[MifNodeInfo]
    {
        let p this.node_stack.get(i as size_t)
        *p as ref[MifNodeInfo]
    }

    procedure link_push(mutable this: ref[MifFOTBuilder])
    {
        let host this.host
        let d this.link_depth as size_t
        var li: ref[MifLinkInfo]? null
        if d < this.link_stack.get_length()
        {
            let p this.link_stack.get(d)
            li := *p
        }
        else
        {
            li := MifLinkInfo.make(host)
            this.link_stack.add(li)
        }
        li.cri := null
        li.opened_in_mif := false
        this.link_depth := this.link_depth + 1
    }

    function link_at(this: ref[MifFOTBuilder], i: int) returns ref[MifLinkInfo]
    {
        let p this.link_stack.get(i as size_t)
        *p as ref[MifLinkInfo]
    }

    procedure index_push(mutable this: ref[MifFOTBuilder], m: ref[MifMarker])
    {
        let d this.index_depth as size_t
        if d < this.index_entry_stack.get_length()
            this.index_entry_stack.put(d, m)
        else
            this.index_entry_stack.add(m)
        this.index_depth := this.index_depth + 1
    }

    ; --- ElementSet ---------------------------------------------------------
    function stringc_hash(s: StringC) returns size_t
    {
        var h: size_t 0
        let n s.get_size()
        var i: size_t 0
        while i < n
        {
            h := (h << 5) + h + (s.get(i) as size_t)
            i := i + 1
        }
        h
    }

    procedure enforce_sgml_id(mutable this: ref[MifFOTBuilder], sgml_id: StringC, grove_index: int) returns ref[MifSgmlIdInfo]?
    {
        let host this.host
        if this.elem_slots.get_length() = 0
        {
            var z 0
            while z < 8
            {
                let np: ref[MifSgmlIdInfo]? null
                this.elem_slots.add(np)
                z := z + 1
            }
            this.elem_limit := 4
        }
        var size this.elem_slots.get_length()
        var i (MifFOTBuilder.stringc_hash(sgml_id) & (size - 1))
        while true
        {
            let sp this.elem_slots.get(i)
            var e: ref[MifSgmlIdInfo]? null
            if sp <> null
                e := *sp
            if e = null
                break
            if e.sgml_id.equals(sgml_id)
                return e
            if i = 0
                i := size - 1
            else
                i := i - 1
        }
        if this.elem_used >= this.elem_limit
        {
            let old this.elem_slots
            let old_size old.get_length()
            let fresh Array[ref[MifSgmlIdInfo]?]^host()
            var z2: size_t 0
            while z2 < (old_size * 2)
            {
                let np2: ref[MifSgmlIdInfo]? null
                fresh.add(np2)
                z2 := z2 + 1
            }
            this.elem_slots := fresh
            size := fresh.get_length()
            this.elem_limit := (size / 2) as int
            var oi: size_t 0
            while oi < old_size
            {
                let op old.get(oi)
                var oe: ref[MifSgmlIdInfo]? null
                if op <> null
                    oe := *op
                if oe <> null
                {
                    var j (MifFOTBuilder.stringc_hash(oe.sgml_id) & (size - 1))
                    while true
                    {
                        let sp2 fresh.get(j)
                        var cur: ref[MifSgmlIdInfo]? null
                        if sp2 <> null
                            cur := *sp2
                        if cur = null
                            break
                        if j = 0
                            j := size - 1
                        else
                            j := j - 1
                    }
                    fresh.put(j, oe)
                }
                oi := oi + 1
            }
            i := (MifFOTBuilder.stringc_hash(sgml_id) & (size - 1))
            while true
            {
                let sp3 this.elem_slots.get(i)
                var e3: ref[MifSgmlIdInfo]? null
                if sp3 <> null
                    e3 := *sp3
                if e3 = null
                    break
                if i = 0
                    i := size - 1
                else
                    i := i - 1
            }
        }
        let fresh_info MifSgmlIdInfo.make(host, sgml_id, grove_index)
        this.elem_slots.put(i, fresh_info)
        this.elem_used := this.elem_used + 1
        fresh_info
    }

    procedure elem_get_flags(this: ref[MifFOTBuilder], grove_index: int, n: int, mutable result: ref[int]) returns bool
    {
        if grove_index < 0
            return false
        if (grove_index as size_t) >= this.elem_flags.get_length()
            return false
        let vp this.elem_flags.get(grove_index as size_t)
        let v *vp
        if v = null
            return false
        if n < 0
            return false
        if (n as size_t) >= v.get_length()
            return false
        let fp v.get(n as size_t)
        result := *fp
        true
    }

    procedure elem_add(mutable this: ref[MifFOTBuilder], grove_index: int, n: int, flags: int)
    {
        let host this.host
        while (grove_index as size_t) >= this.elem_flags.get_length()
        {
            let fresh Array[int]^host()
            this.elem_flags.add(fresh)
        }
        let vp this.elem_flags.get(grove_index as size_t)
        let v *vp
        while (n as size_t) >= v.get_length()
            v.add(0)
        v.put(n as size_t, flags)
    }

    procedure set_referenced_flag_n(mutable this: ref[MifFOTBuilder], ref_type: int, grove_index: int, n: int)
    {
        var flags 0
        this.elem_get_flags(grove_index, n, &flags)
        this.elem_add(grove_index, n, flags | ref_type)
    }

    procedure set_referenced_flag_id(mutable this: ref[MifFOTBuilder], ref_type: int, grove_index: int, mutable sgml_id: StringC)
    {
        let info this.enforce_sgml_id(sgml_id, grove_index)
        info.flags := info.flags | ref_type
    }

    procedure set_bc_index_n(mutable this: ref[MifFOTBuilder], grove_index: int, n: int, idx: int)
    {
        var flags 0
        this.elem_get_flags(grove_index, n, &flags)
        this.elem_add(grove_index, n, (flags & MIF_REF_ANY) | (idx & MIF_REF_BC_INDEX_MASK))
    }

    procedure set_bc_index_id(mutable this: ref[MifFOTBuilder], grove_index: int, mutable sgml_id: StringC, idx: int)
    {
        let info this.enforce_sgml_id(sgml_id, grove_index)
        info.flags := (info.flags & MIF_REF_ANY) | (idx & MIF_REF_BC_INDEX_MASK)
    }

    function has_been_referenced_n(this: ref[MifFOTBuilder], ref_type: int, grove_index: int, n: int) returns bool
    {
        var flags 0
        this.elem_get_flags(grove_index, n, &flags)
        (flags & ref_type) <> 0
    }

    procedure has_been_referenced_id(mutable this: ref[MifFOTBuilder], ref_type: int, grove_index: int, sgml_id: StringC) returns bool
    {
        let info this.enforce_sgml_id(sgml_id, grove_index)
        (info.flags & ref_type) <> 0
    }

    procedure bc_index_n(this: ref[MifFOTBuilder], grove_index: int, n: int) returns int
    {
        var flags 0
        if this.elem_get_flags(grove_index, n, &flags)
            return flags & MIF_REF_BC_INDEX_MASK
        MifFOTBuilder.trap("bookComponentIndex() for an unregistered element")
        0
    }

    procedure bc_index_id(mutable this: ref[MifFOTBuilder], grove_index: int, sgml_id: StringC) returns int
    {
        let info this.enforce_sgml_id(sgml_id, grove_index)
        info.flags & MIF_REF_BC_INDEX_MASK
    }

    ; --- the Ruling / Color PointerTables (OpenSP StringHash over bytes) ----
    function string_hash(s: String) returns size_t
    {
        var h: size_t 0
        let n s.get_length()
        if n = 0
            return h
        let p s.as_slice()
        var i: size_t 0
        while i < n
        {
            h := (h << 5) + h + (p[i] as size_t)
            i := i + 1
        }
        h
    }

    function ruling_lookup(bc: ref[MifBookComponent], key: String) returns ref[MifRuling]?
    {
        if bc.ruling_used = 0
            return null
        let size bc.ruling_slots.get_length()
        var i (MifFOTBuilder.string_hash(key) & (size - 1))
        while true
        {
            let sp bc.ruling_slots.get(i)
            if sp = null
                return null
            let e *sp
            if e = null
                return null
            if e.tag.equals(key)
                return e
            if i = 0
                i := size - 1
            else
                i := i - 1
        }
        null
    }

    procedure ruling_insert(mutable this: ref[MifFOTBuilder], mutable bc: ref[MifBookComponent], r: ref[MifRuling])
    {
        let host this.host
        if bc.ruling_slots.get_length() = 0
        {
            var z 0
            while z < 8
            {
                let np: ref[MifRuling]? null
                bc.ruling_slots.add(np)
                z := z + 1
            }
            bc.ruling_limit := 4
        }
        var size bc.ruling_slots.get_length()
        var i (MifFOTBuilder.string_hash(r.tag) & (size - 1))
        while true
        {
            let sp bc.ruling_slots.get(i)
            var e: ref[MifRuling]? null
            if sp <> null
                e := *sp
            if e = null
                break
            if e.tag.equals(r.tag)
                return
            if i = 0
                i := size - 1
            else
                i := i - 1
        }
        if bc.ruling_used >= bc.ruling_limit
        {
            let old bc.ruling_slots
            let old_size old.get_length()
            let fresh Array[ref[MifRuling]?]^host()
            var z2: size_t 0
            while z2 < (old_size * 2)
            {
                let np2: ref[MifRuling]? null
                fresh.add(np2)
                z2 := z2 + 1
            }
            bc.ruling_slots := fresh
            size := fresh.get_length()
            bc.ruling_limit := (size / 2) as int
            var oi: size_t 0
            while oi < old_size
            {
                let op old.get(oi)
                var oe: ref[MifRuling]? null
                if op <> null
                    oe := *op
                if oe <> null
                {
                    var j (MifFOTBuilder.string_hash(oe.tag) & (size - 1))
                    while true
                    {
                        let sp2 fresh.get(j)
                        var cur: ref[MifRuling]? null
                        if sp2 <> null
                            cur := *sp2
                        if cur = null
                            break
                        if j = 0
                            j := size - 1
                        else
                            j := j - 1
                    }
                    fresh.put(j, oe)
                }
                oi := oi + 1
            }
            i := (MifFOTBuilder.string_hash(r.tag) & (size - 1))
            while true
            {
                let sp3 bc.ruling_slots.get(i)
                var e3: ref[MifRuling]? null
                if sp3 <> null
                    e3 := *sp3
                if e3 = null
                    break
                if i = 0
                    i := size - 1
                else
                    i := i - 1
            }
        }
        bc.ruling_slots.put(i, r)
        bc.ruling_used := bc.ruling_used + 1
    }

    function color_lookup(bc: ref[MifBookComponent], key: String) returns ref[MifColor]?
    {
        if bc.color_used = 0
            return null
        let size bc.color_slots.get_length()
        var i (MifFOTBuilder.string_hash(key) & (size - 1))
        while true
        {
            let sp bc.color_slots.get(i)
            if sp = null
                return null
            let e *sp
            if e = null
                return null
            if e.tag.equals(key)
                return e
            if i = 0
                i := size - 1
            else
                i := i - 1
        }
        null
    }

    procedure color_insert(mutable this: ref[MifFOTBuilder], mutable bc: ref[MifBookComponent], r: ref[MifColor])
    {
        let host this.host
        if bc.color_slots.get_length() = 0
        {
            var z 0
            while z < 8
            {
                let np: ref[MifColor]? null
                bc.color_slots.add(np)
                z := z + 1
            }
            bc.color_limit := 4
        }
        var size bc.color_slots.get_length()
        var i (MifFOTBuilder.string_hash(r.tag) & (size - 1))
        while true
        {
            let sp bc.color_slots.get(i)
            var e: ref[MifColor]? null
            if sp <> null
                e := *sp
            if e = null
                break
            if e.tag.equals(r.tag)
                return
            if i = 0
                i := size - 1
            else
                i := i - 1
        }
        if bc.color_used >= bc.color_limit
        {
            let old bc.color_slots
            let old_size old.get_length()
            let fresh Array[ref[MifColor]?]^host()
            var z2: size_t 0
            while z2 < (old_size * 2)
            {
                let np2: ref[MifColor]? null
                fresh.add(np2)
                z2 := z2 + 1
            }
            bc.color_slots := fresh
            size := fresh.get_length()
            bc.color_limit := (size / 2) as int
            var oi: size_t 0
            while oi < old_size
            {
                let op old.get(oi)
                var oe: ref[MifColor]? null
                if op <> null
                    oe := *op
                if oe <> null
                {
                    var j (MifFOTBuilder.string_hash(oe.tag) & (size - 1))
                    while true
                    {
                        let sp2 fresh.get(j)
                        var cur: ref[MifColor]? null
                        if sp2 <> null
                            cur := *sp2
                        if cur = null
                            break
                        if j = 0
                            j := size - 1
                        else
                            j := j - 1
                    }
                    fresh.put(j, oe)
                }
                oi := oi + 1
            }
            i := (MifFOTBuilder.string_hash(r.tag) & (size - 1))
            while true
            {
                let sp3 bc.color_slots.get(i)
                var e3: ref[MifColor]? null
                if sp3 <> null
                    e3 := *sp3
                if e3 = null
                    break
                if i = 0
                    i := size - 1
                else
                    i := i - 1
            }
        }
        bc.color_slots.put(i, r)
        bc.color_used := bc.color_used + 1
    }

    ; --- ParagraphFormat::out (needs curTagStream()/curCell()) --------------
    procedure pf_out(mutable this: ref[MifFOTBuilder], f: ref[MifFormat], mutable os: ref[MifOS], props: int, fprops: int, exclude_cell: bool)
    {
        var out_pgf_tag false
        var pgf_tag String()
        if (props & MIF_PF_TAG) = 0
        {
            let ts this.cur_tag_stream()
            if ts.pgf_tag_used = false
            {
                pgf_tag := ts.initial_pgf_tag
                out_pgf_tag := true
                ts.pgf_tag_used := true
            }
        }
        var emit false
        if props <> 0
            emit := true
        if fprops <> 0
            emit := true
        if out_pgf_tag
            emit := true
        if emit = false
            return
        os.begin_stmt("Pgf")
        if out_pgf_tag
            os.p_tstr("PgfTag", pgf_tag)
        else
        {
            if (props & MIF_PF_TAG) <> 0
                os.p_tstr("PgfTag", f.pgf_tag)
        }
        f.ff_out(os, fprops, true)
        if (props & MIF_PF_LANGUAGE) <> 0
            os.p_kw("PgfLanguage", f.pgf_language)
        if (props & MIF_PF_FINDENT) <> 0
            os.p_dim("PgfFIndent", f.pgf_findent)
        if (props & MIF_PF_LINDENT) <> 0
            os.p_dim("PgfLIndent", f.pgf_lindent)
        if (props & MIF_PF_RINDENT) <> 0
            os.p_dim("PgfRIndent", f.pgf_rindent)
        if (props & MIF_PF_ALIGNMENT) <> 0
            os.p_kw("PgfAlignment", f.pgf_alignment)
        if (props & MIF_PF_SPBEFORE) <> 0
            os.p_dim("PgfSpBefore", f.pgf_sp_before)
        if (props & MIF_PF_SPAFTER) <> 0
            os.p_dim("PgfSpAfter", f.pgf_sp_after)
        if (props & MIF_PF_LINESPACING) <> 0
            os.p_kw("PgfLineSpacing", f.pgf_line_spacing)
        if (props & MIF_PF_LEADING) <> 0
            os.p_dim("PgfLeading", f.pgf_leading)
        if (props & MIF_PF_NUMTABS) <> 0
            os.p_num("PgfNumTabs", f.pgf_num_tabs)
        if (props & MIF_PF_TABSTOPS) <> 0
        {
            let n f.tab_stops.get_length()
            var i: size_t 0
            while i < n
            {
                let tp f.tab_stops.get(i)
                let t *tp
                if t <> null
                    t.out(os)
                i := i + 1
            }
        }
        if (props & MIF_PF_PLACEMENT) <> 0
            os.p_kw("PgfPlacement", f.pgf_placement)
        if (props & MIF_PF_PLACEMENTSTYLE) <> 0
            os.p_kw("PgfPlacementStyle", f.pgf_placement_style)
        if (props & MIF_PF_WITHPREV) <> 0
            os.p_bool("PgfWithPrev", f.pgf_with_prev)
        if (props & MIF_PF_WITHNEXT) <> 0
            os.p_bool("PgfWithNext", f.pgf_with_next)
        if (props & MIF_PF_BLOCKSIZE) <> 0
            os.p_num("PgfBlockSize", f.pgf_block_size)
        if (props & MIF_PF_AUTONUM) <> 0
            os.p_bool("PgfAutoNum", f.pgf_auto_num)
        if (props & MIF_PF_NUMFORMAT) <> 0
            os.p_tstr("PgfNumFormat", f.pgf_num_format)
        if (props & MIF_PF_NUMBERFONT) <> 0
            os.p_tstr("PgfNumberFont", f.pgf_number_font)
        if (props & MIF_PF_HYPHENATE) <> 0
            os.p_bool("PgfHyphenate", f.pgf_hyphenate)
        if (props & MIF_PF_HMAXLINES) <> 0
            os.p_num("HyphenMaxLines", f.hyphen_max_lines)
        if (props & MIF_PF_HMINPREFIX) <> 0
            os.p_num("HyphenMinPrefix", f.hyphen_min_prefix)
        if (props & MIF_PF_HMINSUFFIX) <> 0
            os.p_num("HyphenMinSuffix", f.hyphen_min_suffix)
        if (props & MIF_PF_HMINWORD) <> 0
            os.p_num("HyphenMinWord", f.hyphen_min_word)
        if (props & MIF_PF_LETTERSPACE) <> 0
            os.p_bool("PgfLetterSpace", f.pgf_letter_space)
        var cell_props false
        if this.cur_cell <> null
            cell_props := true
        if exclude_cell = false
            cell_props := true
        if cell_props
        {
            if (props & MIF_PF_CELLALIGN) <> 0
                os.p_kw("PgfCellAlignment", f.pgf_cell_alignment)
            if (props & MIF_PF_CELLMARGINS) <> 0
                os.p_ltrb("PgfCellMargins", f.pgf_cm_l, f.pgf_cm_t, f.pgf_cm_r, f.pgf_cm_b)
            if (props & MIF_PF_CELLLFIXED) <> 0
                os.p_bool("PgfCellLMarginFixed", f.pgf_cell_l_fixed)
            if (props & MIF_PF_CELLTFIXED) <> 0
                os.p_bool("PgfCellTMarginFixed", f.pgf_cell_t_fixed)
            if (props & MIF_PF_CELLRFIXED) <> 0
                os.p_bool("PgfCellRMarginFixed", f.pgf_cell_r_fixed)
            if (props & MIF_PF_CELLBFIXED) <> 0
                os.p_bool("PgfCellBMarginFixed", f.pgf_cell_b_fixed)
        }
        os.end_stmt()
    }

    ; --- Para / ParaLine prologs and epilogs -------------------------------
    procedure para_out_simple_prolog(mutable this: ref[MifFOTBuilder], mutable os: ref[MifOS])
    {
        this.para_currently_opened := true
        os.begin_stmt("Para")
    }

    procedure para_out_epilog(mutable this: ref[MifFOTBuilder], mutable os: ref[MifOS])
    {
        os.end_stmt()
        this.para_currently_opened := false
    }

    procedure paraline_out_prolog(mutable this: ref[MifFOTBuilder], mutable os: ref[MifOS])
    {
        os.begin_stmt("ParaLine")
        let tf this.cur_text_flow
        if tf <> null
        {
            if tf.text_rect_id_used = false
            {
                this.paraline_text_rect_id := tf.text_rect_id
                this.paraline_set := this.paraline_set | MIF_PARALINE_TEXTRECTID
                os.p_num("TextRectID", this.paraline_text_rect_id)
                this.paraline_set := this.paraline_set & (MIF_PARALINE_TEXTRECTID xor 0xFFFF)
                tf.text_rect_id_used := true
            }
        }
        let tbl this.cur_tbl()
        if tbl <> null
        {
            if tbl.id_used = false
            {
                this.paraline_atbl := tbl.tbl_id
                this.paraline_set := this.paraline_set | MIF_PARALINE_ATBL
                os.p_num("ATbl", this.paraline_atbl)
                this.paraline_set := this.paraline_set & (MIF_PARALINE_ATBL xor 0xFFFF)
                tbl.id_used := true
            }
        }
    }

    procedure paraline_out_epilog(this: ref[MifFOTBuilder], mutable os: ref[MifOS])
        os.end_stmt()

    ; Para::out — the whole paragraph statement into the enclosing stream
    procedure para_out(mutable this: ref[MifFOTBuilder], p: ref[MifTagStream], mutable os: ref[MifOS])
    {
        this.para_out_prolog(p, os)
        this.paraline_out_prolog(os)
        this.tmp_commit(p.content, os.b, false)
        this.paraline_out_epilog(os)
        this.para_out_epilog(os)
    }

    procedure para_out_prolog(mutable this: ref[MifFOTBuilder], p: ref[MifTagStream], mutable os: ref[MifOS])
    {
        this.para_out_simple_prolog(os)
        if (p.para_set & MIF_PARA_PGFTAG) <> 0
            os.p_tstr("PgfTag", p.para_pgf_tag)
        if (p.para_set & MIF_PARA_FORMAT) <> 0
            this.pf_out(p.fmt, os, p.fmt.pf_set, p.fmt.ff_set, true)
    }

    ; --- MifDoc emission helpers -------------------------------------------
    procedure out_hex_char(this: ref[MifFOTBuilder], code: int, mutable os: ref[MifOS])
    {
        os.raw("\\x")
        os.put(MifFOTBuilder.hex_digit((code >> 4) & 0xF))
        os.put(MifFOTBuilder.hex_digit(code & 0xF))
        os.put(0x20)
    }

    procedure out_special_char(this: ref[MifFOTBuilder], name: String, mutable os: ref[MifOS])
        os.p_kw("Char", name)

    procedure out_page_number(mutable this: ref[MifFOTBuilder])
    {
        let os this.os()
        os.nlind()
        os.raw("<Variable <VariableName \`Current Page #'>>")
    }

    procedure out_a_frame(this: ref[MifFOTBuilder], id: int, mutable os: ref[MifOS])
        os.p_num("AFrame", id)

    procedure begin_para_line(mutable this: ref[MifFOTBuilder])
        this.paraline_out_prolog(this.os())

    procedure end_para_line(mutable this: ref[MifFOTBuilder])
        this.paraline_out_epilog(this.os())

    procedure out_breaking_para(mutable this: ref[MifFOTBuilder], pgf_placement: String)
    {
        let os this.os()
        let f this.doc_format
        f.pgf_sp_before := 0
        f.pgf_sp_after := 0
        f.pgf_placement := pgf_placement
        f.pf_set := f.pf_set | MIF_PF_SPBEFORE | MIF_PF_SPAFTER | MIF_PF_PLACEMENT
        this.para_out_simple_prolog(os)
        this.pf_out(f, os, f.pf_set, f.ff_set, true)
        this.paraline_out_prolog(os)
        this.paraline_out_epilog(os)
        this.para_out_epilog(os)
    }

    ; --- CrossRefInfo: record + escape, then resolve at commit time --------
    procedure out_cross_ref_info(mutable this: ref[MifFOTBuilder], cri: ref[MifCrossRefInfo], mutable os: ref[MifOS])
    {
        let host this.host
        let idx this.cross_ref_infos.get_length() as int
        this.cross_ref_infos.add(cri.copy(host))
        os.put(0)
        os.put((idx & 0xFF) as u8)
        os.put(((idx >> 8) & 0xFF) as u8)
        os.put(((idx >> 16) & 0xFF) as u8)
        os.put(((idx >> 24) & 0xFF) as u8)
    }

    procedure cross_ref_text(mutable this: ref[MifFOTBuilder], cri: ref[MifCrossRefInfo]) returns String
    {
        let host this.host
        let arr Array[u8]^host()
        MifFOTBuilder.arr_raw(arr, "NODE")
        MifFOTBuilder.arr_udec(arr, cri.grove_index)
        arr.add(0x2E)
        if cri.sgml_id.get_size() > 0
        {
            MifFOTBuilder.arr_stringc(arr, cri.sgml_id)
            return MifFOTBuilder.str_from_bytes(host, arr)
        }
        MifFOTBuilder.arr_udec(arr, cri.element_index)
        MifFOTBuilder.str_from_bytes(host, arr)
    }

    procedure out_marker(mutable this: ref[MifFOTBuilder], mutable os: ref[MifOS], set_props: int, m_type: int, m_text_in: String)
    {
        let host this.host
        os.begin_stmt("Marker")
        if (set_props & MIF_MK_TYPE) <> 0
            os.p_num("MType", m_type)
        var m_text m_text_in
        if (set_props & MIF_MK_TEXT) <> 0
        {
            m_text := MifFOTBuilder.escape_special_chars(host, m_text)
            os.p_tstr("MText", m_text)
        }
        os.end_stmt()
    }

    ; Marker(CrossRefInfo &, linkDestinationMode)
    procedure out_marker_for_cri(mutable this: ref[MifFOTBuilder], cri: ref[MifCrossRefInfo], mutable os: ref[MifOS], link_destination: bool)
    {
        let host this.host
        let t cri.cri_type
        if t = MIF_CRI_POTENTIAL_MARKER
        {
            if link_destination
            {
                let base MifFOTBuilder.str_of_c(host, "newlink ")
                let txt MifFOTBuilder.str_cat(host, base, this.cross_ref_text(cri))
                this.out_marker(os, MIF_MK_TYPE | MIF_MK_TEXT, MIF_MARKER_HYPERTEXT, txt)
                return
            }
            this.out_marker(os, MIF_MK_TYPE | MIF_MK_TEXT, MIF_MARKER_XREF, this.cross_ref_text(cri))
            return
        }
        if t = MIF_CRI_HYPERTEXT_LINK
        {
            var bci 0
            if cri.sgml_id.get_size() > 0
                bci := this.bc_index_id(cri.grove_index, cri.sgml_id)
            else
                bci := this.bc_index_n(cri.grove_index, cri.element_index)
            let arr Array[u8]^host()
            MifFOTBuilder.arr_raw(arr, "gotolink <c>")
            let bcp this.book_components.get(bci as size_t)
            let bc *bcp
            MifFOTBuilder.arr_str(arr, bc.file_name)
            arr.add(0x3A)
            MifFOTBuilder.arr_str(arr, this.cross_ref_text(cri))
            this.out_marker(os, MIF_MK_TYPE | MIF_MK_TEXT, MIF_MARKER_HYPERTEXT, MifFOTBuilder.str_from_bytes(host, arr))
            return
        }
        MifFOTBuilder.trap("Marker for an unexpected CrossRefInfo type")
    }

    ; XRef(CrossRefInfo &)
    procedure out_xref_for_cri(mutable this: ref[MifFOTBuilder], cri: ref[MifCrossRefInfo], mutable os: ref[MifOS])
    {
        let host this.host
        var bci 0
        if cri.sgml_id.get_size() > 0
            bci := this.bc_index_id(cri.grove_index, cri.sgml_id)
        else
            bci := this.bc_index_n(cri.grove_index, cri.element_index)
        let arr Array[u8]^host()
        MifFOTBuilder.arr_raw(arr, "<c\\>")
        let bcp this.book_components.get(bci as size_t)
        let bc *bcp
        MifFOTBuilder.arr_str(arr, bc.file_name)
        let src_file MifFOTBuilder.str_from_bytes(host, arr)
        let src_text MifFOTBuilder.escape_special_chars(host, this.cross_ref_text(cri))
        os.begin_stmt("XRef")
        os.p_tstr("XRefName", this.mc.s_page_num_xref_format_name)
        os.p_tstr("XRefSrcText", src_text)
        os.p_tstr("XRefSrcFile", src_file)
        os.end_stmt()
        os.nlind()
        os.raw("<String ")
        os.tstr(MifFOTBuilder.str_of_c(host, "000"))
        os.put(0x3E)
        os.nlind()
        os.raw("<XRefEnd>")
    }

    ; CrossRefInfo::out
    procedure cri_out(mutable this: ref[MifFOTBuilder], cri: ref[MifCrossRefInfo], mutable os: ref[MifOS])
    {
        let t cri.cri_type
        if t = MIF_CRI_POTENTIAL_MARKER
        {
            var regular false
            var link false
            if cri.sgml_id.get_size() > 0
            {
                if this.has_been_referenced_id(MIF_REF_PAGE, cri.grove_index, cri.sgml_id)
                    regular := true
                if this.has_been_referenced_id(MIF_REF_LINK, cri.grove_index, cri.sgml_id)
                    link := true
            }
            else
            {
                if this.has_been_referenced_n(MIF_REF_PAGE, cri.grove_index, cri.element_index)
                    regular := true
                if this.has_been_referenced_n(MIF_REF_LINK, cri.grove_index, cri.element_index)
                    link := true
            }
            if regular
            {
                os.ind := cri.tag_indent
                this.out_marker_for_cri(cri, os, false)
            }
            if link
            {
                os.ind := cri.tag_indent
                this.out_marker_for_cri(cri, os, true)
            }
            return
        }
        if t = MIF_CRI_HYPERTEXT_LINK
        {
            os.ind := cri.tag_indent
            this.out_marker_for_cri(cri, os, false)
            return
        }
        if t = MIF_CRI_XREF
        {
            os.ind := cri.tag_indent
            this.out_xref_for_cri(cri, os)
            return
        }
        MifFOTBuilder.trap("CrossRefInfo::out on an unexpected type")
    }

    ; MifTmpOutputByteStream::commit
    procedure tmp_commit(mutable this: ref[MifFOTBuilder], src: ref[MifTmp], mutable dst: ref[Array[u8]], resolve: bool)
    {
        let host this.host
        let outs MifOS.make(host, dst, 0)
        let n src.b.get_length()
        if n = 0
            return
        let p src.b.as_slice()
        var i: size_t 0
        while i < n
        {
            let c p[i]
            var handled false
            if resolve
            {
                if c = 0
                {
                    var idx 0
                    var k 0
                    while k < 4
                    {
                        i := i + 1
                        if i < n
                        {
                            let b2 p[i]
                            idx := idx | ((b2 as int) << (k * 8))
                        }
                        k := k + 1
                    }
                    if (idx as size_t) >= this.cross_ref_infos.get_length()
                        MifFOTBuilder.trap("cross-reference index out of range")
                    let cp this.cross_ref_infos.get(idx as size_t)
                    this.cri_out((*cp) as ref[MifCrossRefInfo], outs)
                    handled := true
                }
            }
            if handled = false
                dst.add(c)
            i := i + 1
        }
    }

    ; --- catalog + component emission ---------------------------------------
    procedure pgf_catalog_out(mutable this: ref[MifFOTBuilder], bc: ref[MifBookComponent], mutable os: ref[MifOS])
    {
        os.begin_stmt("PgfCatalog")
        let n bc.pgf_catalog.get_length()
        var i: size_t 0
        while i < n
        {
            let fp bc.pgf_catalog.get(i)
            let f *fp
            if f <> null
                this.pf_out(f, os, f.pf_set, f.ff_set, false)
            i := i + 1
        }
        os.end_stmt()
    }

    procedure color_catalog_out(this: ref[MifFOTBuilder], bc: ref[MifBookComponent], mutable os: ref[MifOS])
    {
        if bc.color_used = 0
            return
        os.begin_stmt("ColorCatalog")
        let n bc.color_slots.get_length()
        var i: size_t 0
        while i < n
        {
            let sp bc.color_slots.get(i)
            if sp <> null
            {
                let c *sp
                if c <> null
                    c.out(os)
            }
            i := i + 1
        }
        os.end_stmt()
    }

    procedure ruling_catalog_out(this: ref[MifFOTBuilder], bc: ref[MifBookComponent], mutable os: ref[MifOS])
    {
        if bc.ruling_used = 0
            return
        os.begin_stmt("RulingCatalog")
        let n bc.ruling_slots.get_length()
        var i: size_t 0
        while i < n
        {
            let sp bc.ruling_slots.get(i)
            if sp <> null
            {
                let r *sp
                if r <> null
                    r.out(os)
            }
            i := i + 1
        }
        os.end_stmt()
    }

    procedure tbl_catalog_out(this: ref[MifFOTBuilder], bc: ref[MifBookComponent], mutable os: ref[MifOS])
    {
        let n bc.tbl_catalog.get_length()
        if n = 0
            return
        os.begin_stmt("TblCatalog")
        var i: size_t 0
        while i < n
        {
            let fp bc.tbl_catalog.get(i)
            let f *fp
            if f <> null
                f.out(os)
            i := i + 1
        }
        os.end_stmt()
    }

    procedure cell_out(mutable this: ref[MifFOTBuilder], c: ref[MifTagStream], mutable os: ref[MifOS], resolve: bool)
    {
        os.begin_stmt("Cell")
        if (c.cell_set & MIF_CELL_FILL) <> 0
            os.p_num("CellFill", c.cell_fill)
        if (c.cell_set & MIF_CELL_COLOR) <> 0
            os.p_tstr("CellColor", c.cell_color)
        if (c.cell_set & MIF_CELL_LRULING) <> 0
            os.p_tstr("CellLRuling", c.cell_l_ruling)
        if (c.cell_set & MIF_CELL_BRULING) <> 0
            os.p_tstr("CellBRuling", c.cell_b_ruling)
        if (c.cell_set & MIF_CELL_RRULING) <> 0
            os.p_tstr("CellRRuling", c.cell_r_ruling)
        if (c.cell_set & MIF_CELL_TRULING) <> 0
            os.p_tstr("CellTRuling", c.cell_t_ruling)
        if (c.cell_set & MIF_CELL_COLUMNS) <> 0
            os.p_num("CellColumns", c.cell_columns)
        if (c.cell_set & MIF_CELL_ROWS) <> 0
            os.p_num("CellRows", c.cell_rows)
        os.begin_stmt("CellContent")
        this.tmp_commit(c.content, os.b, resolve)
        os.end_stmt()
        os.end_stmt()
    }

    procedure row_out(mutable this: ref[MifFOTBuilder], r: ref[MifRow], mutable os: ref[MifOS], resolve: bool)
    {
        os.begin_stmt("Row")
        let n r.cells.get_length()
        var i: size_t 0
        while i < n
        {
            let cp r.cells.get(i)
            let c *cp
            if c <> null
                this.cell_out(c, os, resolve)
            i := i + 1
        }
        os.end_stmt()
    }

    procedure rows_out(mutable this: ref[MifFOTBuilder], rows: ref[Array[ref[MifRow]?]], name: Slice[char], mutable os: ref[MifOS], resolve: bool)
    {
        let n rows.get_length()
        if n = 0
            return
        os.begin_stmt(name)
        var i: size_t 0
        while i < n
        {
            let rp rows.get(i)
            let r *rp
            if r <> null
                this.row_out(r, os, resolve)
            i := i + 1
        }
        os.end_stmt()
    }

    procedure tbl_out(mutable this: ref[MifFOTBuilder], t: ref[MifTbl], mutable os: ref[MifOS], resolve: bool)
    {
        os.begin_stmt("Tbl")
        if (t.set_props & MIF_TBL_ID) <> 0
            os.p_udec("TblID", t.tbl_id)
        if (t.set_props & MIF_TBL_TAG) <> 0
            os.p_tstr("TblTag", t.tbl_tag)
        if (t.set_props & MIF_TBL_FORMAT) <> 0
            t.fmt.out(os)
        if (t.set_props & MIF_TBL_NUMCOLUMNS) <> 0
            os.p_num("TblNumColumns", t.num_columns)
        if (t.set_props & MIF_TBL_COLUMNWIDTHS) <> 0
        {
            let n t.col_widths.get_length()
            var i: size_t 0
            while i < n
            {
                let wp t.col_widths.get(i)
                os.p_dim("TblColumnWidth", *wp)
                i := i + 1
            }
        }
        this.rows_out(t.tblh, "TblH", os, resolve)
        this.rows_out(t.tblbody, "TblBody", os, resolve)
        this.rows_out(t.tblf, "TblF", os, resolve)
        os.end_stmt()
    }

    procedure text_flow_out(mutable this: ref[MifFOTBuilder], tf: ref[MifTagStream], mutable os: ref[MifOS], resolve: bool)
    {
        os.begin_stmt("TextFlow")
        if (tf.tf_set & MIF_TF_TAG) <> 0
            os.p_tstr("TFTag", tf.tf_tag)
        if (tf.tf_set & MIF_TF_AUTOCONNECT) <> 0
            os.p_bool("TFAutoConnect", tf.tf_auto_connect)
        this.tmp_commit(tf.content, os.b, resolve)
        os.end_stmt()
    }

    ; BookComponent::commit
    procedure book_component_commit(mutable this: ref[MifFOTBuilder], bc: ref[MifBookComponent], mutable dir: String, resolve: bool)
    {
        let host this.host
        if bc.file_name.get_length() = 0
            MifFOTBuilder.trap("book component without a file name")
        let file_loc MifFOTBuilder.str_cat(host, dir, bc.file_name)
        let bytes Array[u8]^host()
        let os MifOS.make(host, bytes, 0)
        os.raw("<MIFFile 5.0>")
        this.color_catalog_out(bc, os)
        this.pgf_catalog_out(bc, os)
        this.ruling_catalog_out(bc, os)
        var i: size_t 0
        let na bc.aframes.get_length()
        if na > 0
        {
            os.raw("\n<AFrames ")
            os.indent()
            i := 0
            while i < na
            {
                let ap bc.aframes.get(i)
                let a *ap
                if a <> null
                    a.out(os)
                i := i + 1
            }
            os.undent()
            os.raw("\n>")
        }
        let nx bc.xref_formats.get_length()
        if nx > 0
        {
            os.raw("\n<XRefFormats ")
            os.indent()
            i := 0
            while i < nx
            {
                let xp bc.xref_formats.get(i)
                let x *xp
                if x <> null
                    x.out(os)
                i := i + 1
            }
            os.undent()
            os.raw("\n>")
        }
        this.tbl_catalog_out(bc, os)
        bc.out_document(os)
        let nt bc.tbls.get_length()
        if nt > 0
        {
            os.raw("\n<Tbls ")
            os.indent()
            i := 0
            while i < nt
            {
                let tp bc.tbls.get(i)
                let t *tp
                if t <> null
                    this.tbl_out(t, os, resolve)
                i := i + 1
            }
            os.undent()
            os.raw("\n>")
        }
        let np bc.pages.get_length()
        i := 0
        while i < np
        {
            let pp bc.pages.get(i)
            let p *pp
            if p <> null
                p.out(os)
            i := i + 1
        }
        let nf bc.text_flows.get_length()
        i := 0
        while i < nf
        {
            let fp bc.text_flows.get(i)
            let f *fp
            if f <> null
                this.text_flow_out(f, os, resolve)
            i := i + 1
        }
        if bc.epilog_os <> null
            this.tmp_commit(bc.epilog_os, bytes, resolve)
        let content MifFOTBuilder.str_from_bytes(host, bytes)
        if File.write_from_string(file_loc, content) = false
            MifFOTBuilder.msg_cannot_open(file_loc, scaly_eio_errno())
    }

    ; MifDoc::commit — the reference destructor
    procedure commit(mutable this: ref[MifFOTBuilder])
    {
        let host this.host
        let loc this.out_loc
        let ln loc.get_length()
        let lp loc.get_buffer()
        var sep 0 - 1
        var k (ln as int) - 1
        while k >= 0
        {
            let c *(lp + (k as size_t))
            if c = 0x2F
                break
            if c = 0x5C
                break
            k := k - 1
        }
        sep := k
        var out_dir String()
        var out_file_name String()
        if (sep + 1) > 0
            out_dir := String(lp as pointer[const_char], (sep + 1) as size_t)
        if ((ln as int) - (sep + 1)) > 0
            out_file_name := String^host((lp + ((sep + 1) as size_t)) as pointer[const_char], ((ln as int) - (sep + 1)) as size_t)
        let nbc this.book_components.get_length()
        if nbc > 1
        {
            ; the file-name extension of the root output location, "mif" when
            ; there is none
            var ext_start ln
            var idx ln
            while idx > 0
            {
                if *(lp + (idx - 1)) = 0x2E
                    break
                idx := idx - 1
            }
            var ext String()
            if idx > 0
            {
                if (ln - idx) > 0
                    ext := String^host((lp + idx) as pointer[const_char], ln - idx)
            }
            if ext.get_length() = 0
                ext := String^host("mif")
            var bi: size_t 0
            while bi < nbc
            {
                let arr Array[u8]^host()
                MifFOTBuilder.arr_udec(arr, (bi as int) + 1)
                arr.add(0x2E)
                MifFOTBuilder.arr_str(arr, ext)
                let bcp this.book_components.get(bi)
                let bc *bcp
                bc.file_name := MifFOTBuilder.str_from_bytes(host, arr)
                bi := bi + 1
            }
            let bytes Array[u8]^host()
            let os MifOS.make(host, bytes, 0)
            os.raw("<Book 5.0>")
            bi := 0
            while bi < nbc
            {
                let bcp this.book_components.get(bi)
                let bc *bcp
                os.raw("\n<BookComponent")
                os.raw("\n  <FileName \`<c\\>")
                os.str(bc.file_name)
                os.raw("'>")
                os.raw("\n>")
                bi := bi + 1
            }
            let content MifFOTBuilder.str_from_bytes(host, bytes)
            if File.write_from_string(loc, content) = false
                MifFOTBuilder.msg_cannot_open(loc, scaly_eio_errno())
        }
        else
        {
            if nbc = 1
            {
                let bcp this.book_components.get(0)
                let bc *bcp
                bc.file_name := out_file_name
            }
        }
        var bj: size_t 0
        while bj < nbc
        {
            let bcp this.book_components.get(bj)
            this.book_component_commit((*bcp) as ref[MifBookComponent], out_dir, true)
            bj := bj + 1
        }
    }

    ; --- initMifBookComponent ----------------------------------------------
    procedure init_mif_book_component(mutable this: ref[MifFOTBuilder])
    {
        let host this.host
        let bc this.book_component()
        let def MifFormat.make(host)
        def.set_dsssl_defaults(this.mc)
        def.pgf_tag := this.mc.s_default_pgf_format
        def.pf_set := def.pf_set | MIF_PF_TAG
        bc.pgf_catalog.add(def)
        let f this.format()
        bc.d_page_w := f.fot_page_width
        bc.d_page_h := f.fot_page_height
        bc.doc_set := bc.doc_set | MIF_DOC_PAGESIZE
        bc.d_margin_l := 1
        bc.d_margin_t := 1
        bc.d_margin_r := 1
        bc.d_margin_b := 1
        bc.doc_set := bc.doc_set | MIF_DOC_MARGINS
        bc.d_columns := 1
        bc.doc_set := bc.doc_set | MIF_DOC_COLUMNS
    }

    ; --- Format::computePgfLanguage (with the missing `break` after DE) -----
    procedure compute_pgf_language(this: ref[MifFOTBuilder], mutable f: ref[MifFormat])
    {
        let mc this.mc
        let lang f.fot_language
        let country f.fot_country
        if lang = 0x454E
        {
            if country = 0x4742
                f.pgf_language := mc.s_uk_english
            else
                f.pgf_language := mc.s_us_english
            return
        }
        var fell_through false
        if lang = 0x4445
        {
            if country = 0x4348
                f.pgf_language := mc.s_swiss_german
            else
                f.pgf_language := mc.s_german
            ; NO `break` in the reference: control falls into the FR arm
            fell_through := true
        }
        if fell_through or (lang = 0x4652)
        {
            if country = 0x4341
                f.pgf_language := mc.s_canadian_french
            else
                f.pgf_language := mc.s_french
            return
        }
        if lang = 0x4553
        {
            f.pgf_language := mc.s_spanish
            return
        }
        if lang = 0x4341
        {
            f.pgf_language := mc.s_catalan
            return
        }
        if lang = 0x4954
        {
            f.pgf_language := mc.s_italian
            return
        }
        if lang = 0x5054
        {
            f.pgf_language := mc.s_portuguese
            return
        }
        if lang = 0x4E4C
        {
            f.pgf_language := mc.s_dutch
            return
        }
        if lang = 0x4E4F
        {
            f.pgf_language := mc.s_norwegian
            return
        }
        if lang = 0x4649
        {
            f.pgf_language := mc.s_finnish
            return
        }
        if lang = 0x5356
        {
            f.pgf_language := mc.s_swedish
            return
        }
        f.pgf_language := mc.s_no_language
    }

    ; --- synchronizeFontFormat ---------------------------------------------
    procedure synchronize_font_format(mutable this: ref[MifFOTBuilder])
    {
        let os this.os()
        if this.cur_para <> null
        {
            let cf this.cur_para.cur_fmt
            MifFormat.ff_update_from(cf, this.next_format)
            cf.ff_out(os, cf.ff_set, false)
        }
        else
        {
            let cf this.doc_format
            MifFormat.ff_update_from(cf, this.next_format)
            cf.ff_out(os, cf.ff_set, false)
        }
        this.out_pending_inline_statements()
    }

    ; --- outString ---------------------------------------------------------
    procedure out_string(mutable this: ref[MifFOTBuilder], s: Slice[u32], o: ref[MifTmp]?, in_paragraph: bool)
    {
        let mc this.mc
        var out_s: ref[MifOS]? null
        if o <> null
            out_s := o.os
        else
            out_s := this.os()
        var cur_pf: ref[MifFormat]? null
        if in_paragraph
        {
            if this.cur_para <> null
                cur_pf := this.cur_para.cur_fmt
            else
                cur_pf := this.doc_format
        }
        var para_family String()
        if cur_pf <> null
            para_family := cur_pf.f_family
        var string_opened false
        var prev_symbol_font 0
        var cur_symbol_font 0
        var i: size_t 0
        while i < s.length
        {
            let ch s[i] as int
            var this_is_ws false
            ; 0 nothing, 1 char, 2 code, 3 str, 4 hard return, 5 special char
            var next_out 0
            var out_chr 0
            var out_code 0
            var out_str: Slice[char] ""
            var out_special String()
            if ch = 0x0A
            {
            }
            else if ch = 0x0D
            {
                if in_paragraph = false
                {
                    out_chr := 0x20
                    next_out := 1
                }
                else
                {
                    let lines this.format().fot_lines
                    if (lines = MIF_SYM_NONE) or (lines = MIF_SYM_WRAP)
                    {
                        let iwt this.format().fot_input_whitespace
                        if iwt = MIF_SYM_IGNORE
                        {
                        }
                        else if (iwt = MIF_SYM_COLLAPSE) and this.last_flow_object_was_whitespace
                        {
                        }
                        else
                        {
                            out_chr := 0x20
                            next_out := 1
                        }
                    }
                    else
                        next_out := 4
                    this_is_ws := true
                }
            }
            else if ch = 0x09
            {
                if in_paragraph = false
                {
                    out_str := "\\t"
                    next_out := 3
                }
                else
                {
                    let iwt this.format().fot_input_whitespace
                    if iwt = MIF_SYM_IGNORE
                    {
                    }
                    else if (iwt = MIF_SYM_COLLAPSE) and this.last_flow_object_was_whitespace
                    {
                    }
                    else
                    {
                        out_str := "\\t"
                        next_out := 3
                    }
                    this_is_ws := true
                }
            }
            else if ch = 0x3E
            {
                out_str := "\\>"
                next_out := 3
            }
            else if ch = 0x27
            {
                out_str := "\\q"
                next_out := 3
            }
            else if ch = 0x60
            {
                out_str := "\\Q"
                next_out := 3
            }
            else if ch = 0x5C
            {
                out_str := "\\\\"
                next_out := 3
            }
            else if ch = 0x20
            {
                if in_paragraph = false
                {
                    out_chr := 0x20
                    next_out := 1
                }
                else
                {
                    let iwt this.format().fot_input_whitespace
                    if iwt = MIF_SYM_IGNORE
                    {
                    }
                    else if (iwt = MIF_SYM_COLLAPSE) and this.last_flow_object_was_whitespace
                    {
                    }
                    else
                    {
                        out_chr := 0x20
                        next_out := 1
                    }
                    this_is_ws := true
                }
            }
            else if ch = 0xA0
            {
                out_special := mc.s_hard_space
                next_out := 5
            }
            else if ch = 0xA2
            {
                out_special := mc.s_cent
                next_out := 5
            }
            else if (ch = 0xA3) or (ch = 0x20A4)
            {
                out_special := mc.s_pound
                next_out := 5
            }
            else if ch = 0xA5
            {
                out_special := mc.s_yen
                next_out := 5
            }
            else if ch = 0x2002
            {
                out_special := mc.s_en_space
                next_out := 5
            }
            else if ch = 0x2003
            {
                out_special := mc.s_em_space
                next_out := 5
            }
            else if ch = 0x2009
            {
                out_special := mc.s_thin_space
                next_out := 5
            }
            else if ch = 0x2010
            {
                out_special := mc.s_soft_hyphen
                next_out := 5
            }
            else if ch = 0x2011
            {
                out_special := mc.s_hard_hyphen
                next_out := 5
            }
            else if ch = 0x2013
            {
                out_special := mc.s_en_dash
                next_out := 5
            }
            else if ch = 0x2014
            {
                out_special := mc.s_em_dash
                next_out := 5
            }
            else if ch = 0x2020
            {
                out_special := mc.s_dagger
                next_out := 5
            }
            else if ch = 0x2021
            {
                out_special := mc.s_double_dagger
                next_out := 5
            }
            else if ch = 0x2022
            {
                out_special := mc.s_bullet
                next_out := 5
            }
            else if ch >= 0x80
            {
                let code this.char_at(ch)
                if (code & MIF_CHAR_TABLE_SYMBOL_FLAG) <> 0
                {
                    if cur_pf <> null
                    {
                        cur_symbol_font := ((code & (MIF_CHAR_TABLE_SYMBOL_FLAG xor 0xFFFFFFFF)) >> 16) + 1
                        if cur_symbol_font >= MIF_N_SYMBOL_FONTS
                            MifFOTBuilder.trap("symbol font index out of range (reference assert)")
                        out_code := code & 0xFF
                        next_out := 2
                    }
                }
                else
                {
                    if code <> 0
                    {
                        out_code := code & 0xFF
                        next_out := 2
                    }
                }
            }
            else
            {
                out_chr := ch
                next_out := 1
            }
            if next_out <> 0
            {
                if cur_symbol_font <> prev_symbol_font
                {
                    if string_opened
                    {
                        out_s.raw("'>")
                        string_opened := false
                    }
                    var family String()
                    if cur_symbol_font = 0
                        family := para_family
                    else
                        family := this.symbol_font_name(cur_symbol_font - 1)
                    cur_pf.f_family := family
                    cur_pf.ff_set := cur_pf.ff_set | MIF_FF_FAMILY
                    cur_pf.ff_out(out_s as ref[MifOS], cur_pf.ff_set, false)
                }
                if cur_pf <> null
                {
                    if string_opened = false
                    {
                        out_s.nlind()
                        out_s.raw("<String \`")
                        string_opened := true
                    }
                }
                if next_out = 1
                    out_s.put(out_chr as u8)
                else if next_out = 4
                {
                    if in_paragraph
                    {
                        if string_opened
                        {
                            out_s.raw("'>")
                            string_opened := false
                        }
                        this.out_special_char(mc.s_hard_return, out_s as ref[MifOS])
                        this.paraline_out_epilog(out_s as ref[MifOS])
                        this.paraline_out_prolog(out_s as ref[MifOS])
                    }
                }
                else if next_out = 5
                {
                    if in_paragraph
                    {
                        if string_opened
                        {
                            out_s.raw("'>")
                            string_opened := false
                        }
                        this.out_special_char(out_special, out_s as ref[MifOS])
                    }
                }
                else if next_out = 2
                    this.out_hex_char(out_code, out_s as ref[MifOS])
                else if next_out = 3
                    out_s.raw(out_str)
            }
            prev_symbol_font := cur_symbol_font
            this.last_flow_object_was_whitespace := this_is_ws
            i := i + 1
        }
        if string_opened
            out_s.raw("'>")
        if cur_symbol_font <> 0
        {
            cur_pf.f_family := para_family
            cur_pf.ff_set := cur_pf.ff_set | MIF_FF_FAMILY
            cur_pf.ff_out(out_s as ref[MifOS], cur_pf.ff_set, false)
            cur_pf.ff_set := cur_pf.ff_set & (MIF_FF_ALL xor MIF_FF_FAMILY)
        }
    }

    ; --- characters --------------------------------------------------------
    procedure characters(mutable this: ref[MifFOTBuilder], s: Slice[u32])
    {
        this.check_for_paragraph_reopening()
        if this.para_currently_opened
        {
            if this.in_leader
            {
                if this.cur_leader_stream = null
                    MifFOTBuilder.trap("curLeaderStream() is null")
                this.out_string(s, this.cur_leader_stream, false)
            }
            else
            {
                this.synchronize_font_format()
                this.out_string(s, null, true)
            }
        }
    }

    procedure characters_from_node(mutable this: ref[MifFOTBuilder], node: ref[GroveNode]?, s: Slice[u32])
        this.characters(s)

    ; --- checkForParagraphReopening ----------------------------------------
    procedure check_for_paragraph_reopening(mutable this: ref[MifFOTBuilder])
    {
        let host this.host
        let mc this.mc
        let cur_ds this.display_head()
        if cur_ds = null
            return
        if cur_ds.para_closed_in_mif = false
            return
        let f MifFormat.make(host)
        MifFormat.copy_all(host, f, this.format())
        if cur_ds.first_para_outputed
            f.pgf_with_prev := cur_ds.keep_within_page
        else
            f.pgf_with_prev := false
        f.pgf_with_next := false
        f.pf_set := f.pf_set | MIF_PF_WITHPREV | MIF_PF_WITHNEXT
        cur_ds.first_para_outputed := true
        this.process_display_space_stack()
        if this.pending_break = MIF_SYM_PAGE
            f.pgf_placement := mc.s_page_top
        else if this.pending_break = MIF_SYM_COLUMN
            f.pgf_placement := mc.s_column_top
        else
            f.pgf_placement := mc.s_anywhere
        f.pf_set := f.pf_set | MIF_PF_PLACEMENT
        this.pending_break := MIF_SYM_FALSE
        f.pgf_sp_before := this.pending_eds.nominal
        f.pf_set := f.pf_set | MIF_PF_SPBEFORE
        this.pending_eds := MifEds()
        f.pgf_findent := this.next_format.pgf_lindent
        f.pf_set := f.pf_set | MIF_PF_FINDENT
        let p MifTagStream.make_para(host, this.cur_tag_stream().content.os.ind + 4, mc)
        MifFormat.copy_pf(host, p.fmt, this.doc_format)
        MifFormat.pf_update_from(p.fmt, f)
        p.fmt.f_size := this.doc_format.f_size
        p.fmt.ff_set := p.fmt.ff_set & (MIF_FF_ALL xor MIF_FF_SIZE)
        let line_spacing this.compute_length_spec(f.fot_line_spacing)
        if p.fmt.f_size <> line_spacing
        {
            p.fmt.f_size := line_spacing
            p.fmt.ff_set := p.fmt.ff_set | MIF_FF_SIZE
        }
        MifFormat.copy_pf(host, p.cur_fmt, p.fmt)
        this.cur_para := p
        this.enter_para(p)
        cur_ds.para_closed_in_mif := false
    }

    ; --- processDisplaySpaceStack ------------------------------------------
    procedure process_display_space_stack(mutable this: ref[MifFOTBuilder])
    {
        let mc this.mc
        this.pending_break := MIF_SYM_FALSE
        var eds MifEds()
        while this.dsq_head < this.dsq_tail
        {
            let p this.dsq.get(this.dsq_head as size_t)
            let cur *p
            this.dsq_head := this.dsq_head + 1
            if (cur.break_type = MIF_SYM_PAGE) or (cur.break_type = MIF_SYM_COLUMN)
            {
                eds := MifEds()
                if this.pending_break <> MIF_SYM_FALSE
                {
                    if cur.break_type = MIF_SYM_PAGE
                        this.out_breaking_para(mc.s_page_top)
                    else
                        this.out_breaking_para(mc.s_column_top)
                }
                this.pending_break := cur.break_type
                if cur.break_is_after = false
                    MifFOTBuilder.eds_combine(&eds, this.make_eds(cur.space))
            }
            else
                MifFOTBuilder.eds_combine(&eds, this.make_eds(cur.space))
        }
        this.dsq_head := 0
        this.dsq_tail := 0
        this.pending_eds := eds
    }

    ; --- paragraphs --------------------------------------------------------
    procedure do_start_paragraph(mutable this: ref[MifFOTBuilder], nic: ref[DisplayNIC]?, serves_as_wrapper: bool, height_in: int, allow_negative_leading: bool)
    {
        let host this.host
        let mc this.mc
        this.start_display(nic as ref[DisplayNIC])
        let cur_ds this.display_head()
        if cur_ds = null
            MifFOTBuilder.trap("doStartParagraph without a display info")
        cur_ds.is_paragraph := true
        if cur_ds.may_violate_keep_before
            this.next_format.pgf_with_prev := cur_ds.keep_with_previous
        else
        {
            if cur_ds.first_para_outputed
                this.next_format.pgf_with_prev := cur_ds.keep_within_page
            else
                this.next_format.pgf_with_prev := false
        }
        this.next_format.pgf_with_next := cur_ds.keep_with_next
        this.next_format.pf_set := this.next_format.pf_set | MIF_PF_WITHPREV | MIF_PF_WITHNEXT
        cur_ds.first_para_outputed := true
        this.process_display_space_stack()
        if this.pending_break = MIF_SYM_PAGE
            this.next_format.pgf_placement := mc.s_page_top
        else if this.pending_break = MIF_SYM_COLUMN
            this.next_format.pgf_placement := mc.s_column_top
        else
            this.next_format.pgf_placement := mc.s_anywhere
        this.next_format.pf_set := this.next_format.pf_set | MIF_PF_PLACEMENT
        this.pending_break := MIF_SYM_FALSE
        var line_spacing 0
        var extra_space_before 0
        var height height_in
        if serves_as_wrapper
        {
            if height < 2000
            {
                if allow_negative_leading
                {
                    this.next_format.pgf_leading := height - 2000
                    this.next_format.pf_set := this.next_format.pf_set | MIF_PF_LEADING
                }
                else
                {
                    if this.pending_eds.nominal > 2000
                        this.pending_eds.nominal := this.pending_eds.nominal - 2000
                    else
                        this.pending_eds.nominal := 0
                }
                height := 2000
            }
            line_spacing := height
            this.next_format.f_color := mc.s_white
            this.next_format.ff_set := this.next_format.ff_set | MIF_FF_COLOR
            this.next_format.pgf_line_spacing := mc.s_fixed
            this.next_format.pf_set := this.next_format.pf_set | MIF_PF_LINESPACING
        }
        else
        {
            line_spacing := this.compute_length_spec(this.next_format.fot_line_spacing)
            if this.next_format.fot_min_leading_has
                this.next_format.pgf_line_spacing := mc.s_proportional
            else
                this.next_format.pgf_line_spacing := mc.s_fixed
        }
        this.next_format.pgf_sp_before := this.pending_eds.nominal + extra_space_before
        this.next_format.pf_set := this.next_format.pf_set | MIF_PF_SPBEFORE
        this.pending_eds := MifEds()
        this.next_format.pgf_lindent := this.compute_length_spec(this.next_format.fot_start_indent)
        this.next_format.pgf_findent := this.compute_length_spec(this.next_format.fot_first_line_start_indent) + this.next_format.pgf_lindent
        this.next_format.pgf_rindent := this.compute_length_spec(this.next_format.fot_end_indent)
        this.next_format.pf_set := this.next_format.pf_set | MIF_PF_LINDENT | MIF_PF_FINDENT | MIF_PF_RINDENT
        if this.next_format.fot_span > 1
            this.next_format.pgf_placement_style := mc.s_straddle
        else
            this.next_format.pgf_placement_style := mc.s_normal
        this.next_format.pf_set := this.next_format.pf_set | MIF_PF_PLACEMENTSTYLE
        this.mif_start()
        let p MifTagStream.make_para(host, this.cur_tag_stream().content.os.ind + 4, mc)
        MifFormat.copy_pf(host, p.fmt, this.doc_format)
        MifFormat.pf_update_from(p.fmt, this.format())
        p.fmt.f_size := this.doc_format.f_size
        p.fmt.ff_set := p.fmt.ff_set & (MIF_FF_ALL xor MIF_FF_SIZE)
        if p.fmt.f_size <> line_spacing
        {
            p.fmt.f_size := line_spacing
            p.fmt.ff_set := p.fmt.ff_set | MIF_FF_SIZE
        }
        MifFormat.copy_pf(host, p.cur_fmt, p.fmt)
        this.cur_para := p
        this.enter_para(p)
        this.last_flow_object_was_whitespace := false
        this.out_pending_inline_statements()
    }

    procedure start_paragraph(mutable this: ref[MifFOTBuilder], nic: ref[DisplayNIC]?)
        this.do_start_paragraph(nic, false, 0, false)

    procedure do_end_paragraph(mutable this: ref[MifFOTBuilder], sustain_format: bool, sustain_display: bool, break_test: bool, discard: bool)
    {
        let host this.host
        let cur_ds this.display_head()
        if cur_ds = null
            MifFOTBuilder.trap("doEndParagraph without a display info")
        if sustain_format = false
            this.mif_end()
        if sustain_display = false
            this.end_display()
        if break_test
        {
            if this.paragraph_break_in_effect
            {
                this.paragraph_break_in_effect := false
                this.mif_end()
            }
        }
        if cur_ds.para_closed_in_mif = false
        {
            let p this.cur_para
            if p = null
                MifFOTBuilder.trap("curPara() is null in doEndParagraph")
            this.exit_para()
            if discard = false
            {
                this.para_out(p as ref[MifTagStream], this.os())
                MifFormat.pf_update_from(this.doc_format, p.fmt)
            }
        }
    }

    procedure end_paragraph(mutable this: ref[MifFOTBuilder])
        this.do_end_paragraph(false, false, true, false)

    procedure paragraph_break(mutable this: ref[MifFOTBuilder], nic: ref[DisplayNIC]?)
    {
        if this.para_currently_opened
        {
            if this.paragraph_break_in_effect
                this.do_end_paragraph(false, false, false, false)
            else
            {
                this.do_end_paragraph(true, false, false, false)
                this.paragraph_break_in_effect := true
            }
            this.do_start_paragraph(nic, false, 0, false)
        }
    }

    ; --- displays ----------------------------------------------------------
    procedure start_display_group(mutable this: ref[MifFOTBuilder], nic: ref[DisplayNIC])
    {
        this.start_display(nic)
        this.mif_start()
    }

    procedure end_display_group(mutable this: ref[MifFOTBuilder])
    {
        this.mif_end()
        this.end_display()
    }

    procedure start_display(mutable this: ref[MifFOTBuilder], nic_in: ref[DisplayNIC])
    {
        var nic: ref[DisplayNIC]? nic_in
        if nic = null
            nic := this.default_dnic
        if this.in_simple_page_sequence = false
        {
            if this.book_component_opened = false
            {
                this.enter_book_component()
                this.init_mif_book_component()
                this.book_component_opened := true
            }
            this.book_component_available := false
        }
        this.dsq_append(nic.space_before, nic.break_before.code, false)
        let di this.display_head()
        if di <> null
        {
            if di.is_paragraph and (di.para_closed_in_mif = false)
            {
                var empty false
                if this.cur_para <> null
                    empty := this.cur_para.content.is_empty()
                if empty
                    this.do_end_paragraph(true, true, true, true)
                else
                    this.do_end_paragraph(true, true, true, false)
                di.para_closed_in_mif := true
            }
        }
        let t this.cur_table
        if t.cur_cell <> null
            this.next_format.fot_cur_display_size := t.cur_cell.display_size
        else if this.next_format.fot_span > 1
            this.next_format.fot_cur_display_size := this.next_format.fot_page_width - this.next_format.fot_left_margin - this.next_format.fot_right_margin
        else
        {
            let ncols this.next_format.fot_page_n_columns
            this.next_format.fot_cur_display_size := (this.next_format.fot_page_width - this.next_format.fot_left_margin - this.next_format.fot_right_margin - (this.next_format.fot_page_column_sep * (ncols - 1))) / ncols
        }
        this.display_push(nic as ref[DisplayNIC])
    }

    procedure end_display(mutable this: ref[MifFOTBuilder])
    {
        if this.display_depth <= 0
            MifFOTBuilder.trap("endDisplay() on an empty display stack")
        let di this.display_head()
        this.display_depth := this.display_depth - 1
        this.dsq_append(di.space_after, di.break_after, true)
    }

    ; --- sequence / scroll / box (the FOTBuilder base brackets) -------------
    procedure start_sequence(mutable this: ref[MifFOTBuilder])
        this.mif_start()

    procedure end_sequence(mutable this: ref[MifFOTBuilder])
        this.mif_end()

    procedure start_scroll(mutable this: ref[MifFOTBuilder])
        this.mif_start()

    procedure end_scroll(mutable this: ref[MifFOTBuilder])
        this.mif_end()

    procedure start_box(mutable this: ref[MifFOTBuilder], nic: ref[BoxNIC], dnic: ref[DisplayNIC]?)
        this.mif_start()

    procedure end_box(mutable this: ref[MifFOTBuilder])
        this.mif_end()

    procedure page_number(mutable this: ref[MifFOTBuilder])
        this.out_page_number()

    ; --- scores ------------------------------------------------------------
    procedure start_score(mutable this: ref[MifFOTBuilder], nic: ref[ScoreNIC])
    {
        let mc this.mc
        this.check_for_paragraph_reopening()
        ; only the Symbol form reaches MifFOTBuilder::startScore(Symbol); the
        ; Char and LengthSpec forms fall through to FOTBuilder's start()-only
        ; overloads.
        var st 0 - 1
        if nic.kind = MIF_SCORE_SYMBOL
            st := nic.sym.code
        if st < 0
        {
            this.mif_start()
            return
        }
        if st = MIF_SYM_BEFORE
        {
            this.next_format.f_overline := true
            this.next_format.ff_set := this.next_format.ff_set | MIF_FF_OVERLINE
        }
        else if st = MIF_SYM_THROUGH
        {
            this.next_format.f_strike := true
            this.next_format.ff_set := this.next_format.ff_set | MIF_FF_STRIKE
        }
        else
        {
            if this.next_format.fot_line_repeat > 1
                this.next_format.f_underlining := mc.s_fdouble
            else
                this.next_format.f_underlining := mc.s_fsingle
            this.next_format.ff_set := this.next_format.ff_set | MIF_FF_UNDERLINING
        }
        this.mif_start()
    }

    procedure end_score(mutable this: ref[MifFOTBuilder])
        this.mif_end()

    ; --- leaders -----------------------------------------------------------
    procedure start_leader(mutable this: ref[MifFOTBuilder], nic: ref[LeaderNIC])
    {
        let host this.host
        this.check_for_paragraph_reopening()
        this.last_flow_object_was_whitespace := false
        this.out_special_char(this.mc.s_tab, this.os())
        this.in_leader := true
        this.cur_leader_stream := MifTmp.make(host, 0)
    }

    procedure end_leader(mutable this: ref[MifFOTBuilder])
    {
        let host this.host
        let mc this.mc
        let p this.cur_para
        if p = null
            MifFOTBuilder.trap("curPara() is null in endLeader")
        if p.leader_tabs_set = false
        {
            var leader String()
            if this.cur_leader_stream <> null
                leader := MifFOTBuilder.str_from_bytes(host, this.cur_leader_stream.b)
            let num_tabs this.doc_format.pgf_num_tabs + 1
            this.doc_format.pgf_num_tabs := num_tabs
            this.doc_format.pf_set := this.doc_format.pf_set | MIF_PF_NUMTABS
            let tsx this.format().fot_cur_display_size - this.doc_format.pgf_rindent - 1
            p.fmt.tab_stops.add(MifTabStop.make(host, mc.s_right, tsx, leader))
            p.fmt.pgf_num_tabs := num_tabs
            p.fmt.pf_set := p.fmt.pf_set | MIF_PF_NUMTABS
            p.cur_fmt.pgf_num_tabs := num_tabs
            p.cur_fmt.pf_set := p.cur_fmt.pf_set | MIF_PF_NUMTABS
            p.fmt.pf_set := p.fmt.pf_set | MIF_PF_TABSTOPS
            p.leader_tabs_set := true
        }
        this.cur_leader_stream := null
        this.in_leader := false
        this.last_flow_object_was_whitespace := false
    }

    ; --- line fields -------------------------------------------------------
    procedure start_line_field(mutable this: ref[MifFOTBuilder], nic: ref[LineFieldNIC]?)
    {
        let host this.host
        let mc this.mc
        this.check_for_paragraph_reopening()
        this.last_flow_object_was_whitespace := false
        let p this.cur_para
        if p = null
            MifFOTBuilder.trap("curPara() is null in startLineField")
        let field_width this.compute_length_spec(this.next_format.fot_field_width)
        let first_line_indent p.fmt.pgf_findent
        var leading_tab true
        let fa this.next_format.fot_field_align
        if fa = MIF_SYM_END
        {
            p.fmt.tab_stops.add(MifTabStop.make(host, mc.s_right, first_line_indent + field_width, mc.s_space))
            p.fmt.tab_stops.add(MifTabStop.make(host, mc.s_left, first_line_indent + field_width + 1, mc.s_space))
        }
        else if fa = MIF_SYM_CENTER
        {
            p.fmt.tab_stops.add(MifTabStop.make(host, mc.s_center, first_line_indent + (field_width / 2), mc.s_space))
            p.fmt.tab_stops.add(MifTabStop.make(host, mc.s_left, first_line_indent + field_width + 1, mc.s_space))
        }
        else
        {
            p.fmt.tab_stops.add(MifTabStop.make(host, mc.s_left, first_line_indent + field_width, mc.s_space))
            leading_tab := false
        }
        ; the reference expression is `PgfNumTabs + leadingTab ? 2 : 1`, which
        ; parses as `(PgfNumTabs + leadingTab) ? 2 : 1`
        var num_tabs 1
        var sum this.doc_format.pgf_num_tabs
        if leading_tab
            sum := sum + 1
        if sum <> 0
            num_tabs := 2
        this.doc_format.pgf_num_tabs := num_tabs
        this.doc_format.pf_set := this.doc_format.pf_set | MIF_PF_NUMTABS
        p.fmt.pgf_num_tabs := num_tabs
        p.fmt.pf_set := p.fmt.pf_set | MIF_PF_NUMTABS
        p.cur_fmt.pgf_num_tabs := num_tabs
        p.cur_fmt.pf_set := p.cur_fmt.pf_set | MIF_PF_NUMTABS
        p.fmt.pf_set := p.fmt.pf_set | MIF_PF_TABSTOPS
        this.mif_start()
        if leading_tab
            this.out_special_char(mc.s_tab, this.os())
    }

    procedure end_line_field(mutable this: ref[MifFOTBuilder])
    {
        this.out_special_char(this.mc.s_tab, this.os())
        this.mif_end()
        this.last_flow_object_was_whitespace := false
    }

    ; --- anchored frames ---------------------------------------------------
    procedure make_anchored_frame(mutable this: ref[MifFOTBuilder], frame_type: String, width: int, height: int, anchor_align: String) returns ref[MifObject]
    {
        let host this.host
        let bc this.book_component()
        let frame MifObject.make(host, MIF_OBJ_FRAME, this.next_object_id(), this.mc)
        frame.objects := Array[ref[MifObject]?]^host()
        frame.frame_type := frame_type
        frame.anchor_align := anchor_align
        frame.shape_l := 0
        frame.shape_t := 0
        frame.shape_w := width
        frame.shape_h := height
        frame.set_props := frame.set_props | MIF_FR_TYPE | MIF_FR_ANCHORALIGN | MIF_FR_SHAPERECT
        bc.aframes.add(frame)
        frame
    }

    procedure mif_alignment(this: ref[MifFOTBuilder], sym: int) returns String
    {
        let mc this.mc
        if sym = MIF_SYM_START
            return mc.s_left
        if sym = MIF_SYM_END
            return mc.s_right
        if sym = MIF_SYM_CENTER
            return mc.s_center
        if sym = MIF_SYM_INSIDE
            return mc.s_inside
        if sym = MIF_SYM_OUTSIDE
            return mc.s_outside
        MifFOTBuilder.trap("unexpected display-alignment symbol")
        mc.s_left
    }

    ; --- external graphics -------------------------------------------------
    procedure external_graphic(mutable this: ref[MifFOTBuilder], nic: ref[ExternalGraphicNIC], dnic: ref[DisplayNIC]?)
    {
        let host this.host
        let mc this.mc
        var is_inline false
        if this.para_currently_opened
            is_inline := true
        if is_inline = false
            this.start_display(dnic as ref[DisplayNIC])
        this.mif_start()
        let mif_path this.system_id_to_mif_pathname(nic.entity_system_id)
        if mif_path.get_length() > 0
        {
            let align this.mif_alignment(this.format().fot_display_alignment)
            var w 72000
            if nic.has_max_width
                w := this.compute_length_spec(nic.max_width)
            var h 72000
            if nic.has_max_height
                h := this.compute_length_spec(nic.max_height)
            var ft mc.s_below
            if is_inline
                ft := mc.s_inline
            let frame this.make_anchored_frame(ft, w, h, align)
            let imp MifObject.make(host, MIF_OBJ_IMPORT, this.next_object_id(), mc)
            imp.import_file := mif_path
            imp.shape_l := frame.shape_l
            imp.shape_t := frame.shape_t
            imp.shape_w := frame.shape_w
            imp.shape_h := frame.shape_h
            imp.fixed_size := true
            imp.bitmap_dpi := 72
            imp.set_props := imp.set_props | MIF_IM_FILEDI | MIF_IM_SHAPERECT | MIF_IM_FIXEDSIZE | MIF_IM_DPI
            frame.objects.add(imp)
            if is_inline = false
                this.do_start_paragraph(dnic, true, 0, false)
            else
                this.check_for_paragraph_reopening()
            this.out_a_frame(frame.id, this.os())
            if is_inline = false
                this.end_paragraph()
            else
                this.last_flow_object_was_whitespace := false
        }
        this.mif_end()
        if is_inline = false
            this.end_display()
    }

    ; the MIF pathname encoding (`<c\>name`, `<u\>`, `<r\>`)
    procedure add_path_component(mutable arr: ref[Array[u8]], ctype: int, comp: ref[Array[u8]])
    {
        arr.add(0x3C)
        if ctype = 0
            arr.add(0x63)
        else if ctype = 1
            arr.add(0x75)
        else
            arr.add(0x72)
        arr.add(0x5C)
        arr.add(0x3E)
        if (ctype = 0) or (ctype = 3)
        {
            let n comp.get_length()
            var i: size_t 0
            while i < n
            {
                let cp comp.get(i)
                arr.add(*cp)
                i := i + 1
            }
        }
    }

    ; systemIdToMifPathname — returns the encoded pathname, or the empty
    ; string when the system id could not be converted (the reference's
    ; `false` return; it also reports systemIdNotFilename in that case).
    procedure system_id_to_mif_pathname(mutable this: ref[MifFOTBuilder], system_id: StringC) returns String
    {
        let host this.host
        let filename this.system_id_filename(system_id)
        if filename.get_size() = 0
        {
            MifFOTBuilder.msg_system_id_not_filename(system_id)
            return String()
        }
        let arr Array[u8]^host()
        var first true
        let fn filename.get_size()
        var i: size_t 0
        var running true
        while running
        {
            let comp Array[u8]^host()
            while i < fn
            {
                let c filename.get(i)
                if c = 0x5C
                    break
                if c = 0x2F
                    break
                comp.add((c & 0xFF) as u8)
                i := i + 1
            }
            let cn comp.get_length()
            if cn = 2
            {
                let c0p comp.get(0)
                let c1p comp.get(1)
                if first and (*c1p = 0x3A)
                    MifFOTBuilder.add_path_component(arr, 3, comp)
                else if (*c0p = 0x2E) and (*c1p = 0x2E)
                    MifFOTBuilder.add_path_component(arr, 1, comp)
                else
                    MifFOTBuilder.add_path_component(arr, 0, comp)
            }
            else if cn = 1
            {
                let c0p comp.get(0)
                if *c0p <> 0x2E
                    MifFOTBuilder.add_path_component(arr, 0, comp)
            }
            else if cn = 0
            {
                if first and (fn > 0)
                    MifFOTBuilder.add_path_component(arr, 2, comp)
            }
            else
                MifFOTBuilder.add_path_component(arr, 0, comp)
            first := false
            i := i + 1
            if i >= fn
                running := false
        }
        MifFOTBuilder.str_from_bytes(host, arr)
    }

    ; MifFOTBuilder::systemIdFilename. Design-note deviation (same as the RTF
    ; port's includePicture): the reference round-trips the system id through
    ; the ExtendEntityManager to obtain the OSFILE storage id; the port's
    ; backend seam has no entity manager, and for the corpus the id IS the
    ; storage id, so a leading `<OSFILE>` storage-spec prefix is stripped and
    ; the remainder taken as the file name. A missing file is therefore not
    ; reported (the reference would emit no frame at all).
    function system_id_filename(this: ref[MifFOTBuilder], system_id: StringC) returns StringC
    {
        if system_id.get_size() = 0
            return StringC()
        var sysid system_id
        if sysid.get_size() > 8
        {
            let prefix sysid.substr(0, 8)
            if prefix.equals(StringC("<OSFILE>"))
                sysid := sysid.substr(8, sysid.get_size() - 8)
        }
        sysid
    }

    ; --- rules -------------------------------------------------------------
    procedure rule(mutable this: ref[MifFOTBuilder], nic: ref[RuleNIC], dnic: ref[DisplayNIC]?)
    {
        let host this.host
        let mc this.mc
        var orientation MIF_SYM_HORIZONTAL
        orientation := nic.orientation.code
        var is_inline true
        if (orientation = MIF_SYM_HORIZONTAL) or (orientation = MIF_SYM_VERTICAL)
            is_inline := false
        if is_inline
            this.check_for_paragraph_reopening()
        if is_inline = false
            this.start_display(dnic as ref[DisplayNIC])
        this.mif_start()
        let f this.format()
        let indentless f.fot_cur_display_size - this.compute_length_spec(f.fot_start_indent) - this.compute_length_spec(f.fot_end_indent)
        var rule_height f.fot_line_thickness + (f.fot_line_sep * (f.fot_line_repeat - 1))
        if rule_height < 0
            rule_height := 0
        var rule_length 0
        var rule_offset 0
        var have_length false
        if nic.has_length
        {
            rule_length := this.compute_length_spec(nic.length)
            if rule_length > 0
                have_length := true
        }
        if have_length
        {
            let da f.fot_display_alignment
            if da = MIF_SYM_CENTER
                rule_offset := (indentless - rule_length) / 2
            else if da = MIF_SYM_END
                rule_offset := indentless - rule_length
            else
                rule_offset := 0
        }
        else
        {
            rule_offset := 0
            rule_length := indentless
        }
        var fw indentless
        if is_inline
            fw := rule_length
        let frame this.make_anchored_frame(mc.s_inline, fw, rule_height, mc.s_left)
        if is_inline
            frame.bl_offset := this.compute_length_spec(f.fot_position_point_shift)
        else
            frame.bl_offset := ((0 - rule_height) / 2) + (4000 / 3)
        frame.set_props := frame.set_props | MIF_FR_BLOFFSET
        var cap mc.s_butt
        if f.fot_line_cap = MIF_SYM_ROUND
            cap := mc.s_round
        else if f.fot_line_cap = MIF_SYM_SQUARE
            cap := mc.s_square
        var v_offset f.fot_line_thickness / 2
        var i f.fot_line_repeat
        while i > 0
        {
            let pl MifObject.make(host, MIF_OBJ_POLYLINE, this.next_object_id(), mc)
            pl.points_x := Array[int]^host()
            pl.points_y := Array[int]^host()
            pl.pen := 0
            pl.fill := 0
            pl.pen_width := f.fot_line_thickness
            pl.ob_color := f.f_color
            pl.head_cap := cap
            pl.tail_cap := cap
            pl.set_props := pl.set_props | MIF_PL_HEADCAP | MIF_PL_TAILCAP
            frame.objects.add(pl)
            pl.points_x.add(rule_offset)
            pl.points_y.add(v_offset)
            pl.points_x.add(rule_offset + rule_length)
            pl.points_y.add(v_offset)
            v_offset := v_offset + f.fot_line_sep
            i := i - 1
        }
        if is_inline = false
            this.do_start_paragraph(dnic, true, 0, true)
        this.out_a_frame(frame.id, this.os())
        if is_inline = false
            this.end_paragraph()
        else
            this.last_flow_object_was_whitespace := false
        this.mif_end()
        if is_inline = false
            this.end_display()
    }

    ; --- simple page sequence ----------------------------------------------
    procedure start_simple_page_sequence(mutable this: ref[MifFOTBuilder])
    {
        this.in_simple_page_sequence := true
        this.first_header_footer := true
        var open_bc true
        if this.book_component_opened
        {
            if this.book_component_available
            {
                open_bc := false
                this.book_component_available := false
            }
            else
                this.exit_book_component()
        }
        if open_bc
        {
            this.enter_book_component()
            this.init_mif_book_component()
            this.book_component_opened := true
            this.book_component_available := false
        }
        let bc this.book_component()
        bc.d_page_w := this.next_format.fot_page_width
        bc.d_page_h := this.next_format.fot_page_height
        bc.doc_set := bc.doc_set | MIF_DOC_PAGESIZE
        let ncols this.next_format.fot_page_n_columns
        this.next_format.fot_cur_display_size := (this.next_format.fot_page_width - this.next_format.fot_left_margin - this.next_format.fot_right_margin - (this.next_format.fot_page_column_sep * (ncols - 1))) / ncols
        bc.d_columns := ncols
        bc.doc_set := bc.doc_set | MIF_DOC_COLUMNS
        if ncols > 1
        {
            bc.d_column_gap := this.next_format.fot_page_column_sep
            bc.doc_set := bc.doc_set | MIF_DOC_COLUMNGAP
        }
        bc.doc_set := bc.doc_set & (MIF_DOC_MARGINS xor 0xFFFF)
        this.mif_start()
        let host this.host
        MifFormat.copy_pf(host, this.sps.para_fmt, this.format())
    }

    procedure end_simple_page_sequence(mutable this: ref[MifFOTBuilder])
    {
        this.mif_end()
        this.exit_text_flow()
        this.exit_book_component()
        this.in_simple_page_sequence := false
        this.book_component_opened := false
        this.book_component_available := false
    }

    procedure make_text_rect(mutable this: ref[MifFOTBuilder], l: int, t: int, w: int, h: int, ncols: int, gap: int, balance: bool) returns ref[MifObject]
    {
        let host this.host
        let r MifObject.make(host, MIF_OBJ_TEXTRECT, this.next_object_id(), this.mc)
        r.shape_l := l
        r.shape_t := t
        r.shape_w := w
        r.shape_h := h
        r.tr_num_columns := ncols
        r.tr_column_gap := gap
        r.tr_column_balance := balance
        r.set_props := r.set_props | MIF_TR_SHAPERECT | MIF_TR_NUMCOLUMNS | MIF_TR_COLUMNGAP | MIF_TR_COLUMNBALANCE
        r
    }

    procedure make_text_flow(mutable this: ref[MifFOTBuilder], text_rect: ref[MifObject], body: bool, fmt: ref[MifFormat]?, pgf_tag: String) returns ref[MifTagStream]
    {
        let host this.host
        let tf MifTagStream.make(host, MIF_TS_TEXTFLOW, 2, this.mc)
        tf.text_rect_id := text_rect.id
        tf.text_rect_id_used := false
        tf.initial_pgf_tag := pgf_tag
        if fmt <> null
            MifFormat.copy_pf(host, tf.fmt, fmt)
        if body
        {
            tf.tf_tag := this.mc.s_a
            tf.tf_auto_connect := true
            tf.tf_set := tf.tf_set | MIF_TF_TAG | MIF_TF_AUTOCONNECT
        }
        tf
    }

    procedure make_empty_text_flow(mutable this: ref[MifFOTBuilder], mutable text_rect: ref[MifObject])
    {
        let bc this.book_component()
        let tf this.make_text_flow(text_rect, true, null, this.mc.s_none)
        bc.text_flows.add(tf)
        this.enter_text_flow(tf)
        let os this.os()
        this.para_out_simple_prolog(os)
        this.paraline_out_prolog(os)
        this.paraline_out_epilog(os)
        this.para_out_epilog(os)
        this.exit_text_flow()
    }

    procedure begin_header_footer(mutable this: ref[MifFOTBuilder], header: bool)
    {
        let mc this.mc
        this.mif_start()
        let os this.os()
        ; the reference builds a throwaway local Para whose only set property
        ; is the tag (fParagraphFormat is cleared) and emits its prolog
        this.para_out_simple_prolog(os)
        if header
            os.p_tstr("PgfTag", mc.s_header)
        else
            os.p_tstr("PgfTag", mc.s_footer)
        let host this.host
        let ff MifFormat.make(host)
        ff.f_size := this.format().f_size
        ff.ff_out(os, MIF_FF_SIZE, false)
        this.begin_para_line()
    }

    procedure end_header_footer(mutable this: ref[MifFOTBuilder], hf_part: int)
    {
        this.end_para_line()
        this.para_out_epilog(this.os())
        ; the reference resets currentlyOpened so the right header survives
        if (hf_part & MIF_HF_RIGHT) <> 0
            this.para_currently_opened := true
        this.mif_end()
    }

    procedure setup_hf_paragraph_format(mutable this: ref[MifFOTBuilder], mutable hpf: ref[MifFormat], mutable fpf: ref[MifFormat], text_rect_width: int)
    {
        let host this.host
        let mc this.mc
        let bc this.book_component()
        MifFormat.pf_set_from(hpf, this.sps.para_fmt, 0, MIF_FF_ALL)
        hpf.tab_stops.add(MifTabStop.make(host, mc.s_center, text_rect_width / 2, mc.s_space))
        hpf.tab_stops.add(MifTabStop.make(host, mc.s_right, text_rect_width, mc.s_space))
        hpf.pf_set := hpf.pf_set | MIF_PF_TABSTOPS
        MifFormat.copy_pf(host, fpf, hpf)
        ; NOTE: the reference assigns the FOOTER size to hpf and the HEADER
        ; size to fpf (swapped) — reproduced verbatim.
        hpf.f_size := ((this.format().fot_bottom_margin - this.format().fot_footer_margin) * 3) / 2
        hpf.ff_set := hpf.ff_set | MIF_FF_SIZE
        fpf.f_size := (this.format().fot_header_margin * 3) / 2
        fpf.ff_set := fpf.ff_set | MIF_FF_SIZE
        hpf.pgf_tag := mc.s_header
        hpf.pf_set := hpf.pf_set | MIF_PF_TAG
        fpf.pgf_tag := mc.s_footer
        fpf.pf_set := fpf.pf_set | MIF_PF_TAG
        let hcopy MifFormat.make(host)
        MifFormat.copy_pf(host, hcopy, hpf)
        bc.pgf_catalog.add(hcopy)
        let fcopy MifFormat.make(host)
        MifFormat.copy_pf(host, fcopy, fpf)
        bc.pgf_catalog.add(fcopy)
        hpf.clear_set_props()
        fpf.clear_set_props()
    }

    procedure setup_simple_page_sequence(mutable this: ref[MifFOTBuilder])
    {
        let host this.host
        let mc this.mc
        let bc this.book_component()
        let f this.format()
        let first_master MifPage.make(host, mc.s_other_master_page, mc.s_first, mc.s_none, mc)
        let right_master MifPage.make(host, mc.s_right_master_page, mc.s_right, mc.s_none, mc)
        let left_master MifPage.make(host, mc.s_left_master_page, mc.s_left, mc.s_none, mc)
        let body_page MifPage.make(host, mc.s_body_page, mc.s_none, mc.s_first, mc)
        let body_l f.fot_left_margin
        let body_t f.fot_top_margin
        let body_w f.fot_page_width - f.fot_left_margin - f.fot_right_margin
        let body_h f.fot_page_height - f.fot_top_margin - f.fot_bottom_margin
        let head_l f.fot_left_margin
        let head_t 0
        let head_w body_w
        let head_h f.fot_top_margin
        let foot_l f.fot_left_margin
        let foot_t f.fot_page_height - f.fot_bottom_margin
        let foot_w body_w
        let foot_h f.fot_bottom_margin
        let ncols f.fot_page_n_columns
        let gap f.fot_page_column_sep
        let balance f.fot_page_balance
        let first_body this.make_text_rect(body_l, body_t, body_w, body_h, ncols, gap, balance)
        let right_body this.make_text_rect(body_l, body_t, body_w, body_h, ncols, gap, balance)
        let left_body this.make_text_rect(body_l, body_t, body_w, body_h, ncols, gap, balance)
        let body_rect this.make_text_rect(body_l, body_t, body_w, body_h, ncols, gap, balance)
        let first_head this.make_text_rect(head_l, head_t, head_w, head_h, 1, 0, false)
        let right_head this.make_text_rect(head_l, head_t, head_w, head_h, 1, 0, false)
        let left_head this.make_text_rect(head_l, head_t, head_w, head_h, 1, 0, false)
        let first_foot this.make_text_rect(foot_l, foot_t, foot_w, foot_h, 1, 0, false)
        let right_foot this.make_text_rect(foot_l, foot_t, foot_w, foot_h, 1, 0, false)
        let left_foot this.make_text_rect(foot_l, foot_t, foot_w, foot_h, 1, 0, false)
        first_master.text_rects.add(first_head)
        first_master.text_rects.add(first_body)
        first_master.text_rects.add(first_foot)
        right_master.text_rects.add(right_head)
        right_master.text_rects.add(right_body)
        right_master.text_rects.add(right_foot)
        left_master.text_rects.add(left_head)
        left_master.text_rects.add(left_body)
        left_master.text_rects.add(left_foot)
        body_page.text_rects.add(body_rect)
        bc.pages.add(body_page)
        bc.pages.add(first_master)
        bc.pages.add(right_master)
        bc.pages.add(left_master)
        let hpf MifFormat.make(host)
        hpf.set_dsssl_defaults(mc)
        let fpf MifFormat.make(host)
        fpf.set_dsssl_defaults(mc)
        this.setup_hf_paragraph_format(hpf, fpf, body_w)
        this.sps.body := this.make_text_flow(body_rect, true, this.sps.para_fmt, mc.s_default_pgf_format)
        this.sps.first_header := this.make_text_flow(first_head, false, hpf, mc.s_header)
        this.sps.first_footer := this.make_text_flow(first_foot, false, fpf, mc.s_footer)
        this.sps.left_header := this.make_text_flow(left_head, false, hpf, mc.s_header)
        this.sps.left_footer := this.make_text_flow(left_foot, false, fpf, mc.s_footer)
        this.sps.right_header := this.make_text_flow(right_head, false, hpf, mc.s_header)
        this.sps.right_footer := this.make_text_flow(right_foot, false, fpf, mc.s_footer)
        this.make_empty_text_flow(first_body)
        this.make_empty_text_flow(left_body)
        this.make_empty_text_flow(right_body)
        bc.text_flows.add(this.sps.body)
        bc.text_flows.add(this.sps.first_header)
        bc.text_flows.add(this.sps.first_footer)
        bc.text_flows.add(this.sps.left_header)
        bc.text_flows.add(this.sps.left_footer)
        bc.text_flows.add(this.sps.right_header)
        bc.text_flows.add(this.sps.right_footer)
        bc.d_two_sides := true
        bc.doc_set := bc.doc_set | MIF_DOC_TWOSIDES
        bc.d_parity := mc.s_first_right
        bc.doc_set := bc.doc_set | MIF_DOC_PARITY
        this.enter_text_flow(this.sps.body)
    }

    procedure start_simple_page_sequence_header_footer(mutable this: ref[MifFOTBuilder], hf_part: int)
    {
        let mc this.mc
        if this.first_header_footer
        {
            this.setup_simple_page_sequence()
            this.first_header_footer := false
        }
        var tf: ref[MifTagStream]? null
        if (hf_part & MIF_HF_FIRST) <> 0
        {
            if (hf_part & MIF_HF_FRONT) <> 0
            {
                if (hf_part & MIF_HF_HEADER) <> 0
                    tf := this.sps.first_header
                else
                    tf := this.sps.first_footer
            }
            else
                return
        }
        else
        {
            if (hf_part & MIF_HF_FRONT) <> 0
            {
                if (hf_part & MIF_HF_HEADER) <> 0
                    tf := this.sps.right_header
                else
                    tf := this.sps.right_footer
            }
            else
            {
                if (hf_part & MIF_HF_HEADER) <> 0
                    tf := this.sps.left_header
                else
                    tf := this.sps.left_footer
            }
        }
        this.enter_text_flow(tf)
        if (hf_part & (MIF_HF_CENTER | MIF_HF_RIGHT)) <> 0
            this.out_special_char(mc.s_tab, this.os())
        else
        {
            if (hf_part & MIF_HF_HEADER) <> 0
                this.begin_header_footer(true)
            else
                this.begin_header_footer(false)
        }
    }

    procedure end_simple_page_sequence_header_footer(mutable this: ref[MifFOTBuilder], hf_part: int)
    {
        if (hf_part & MIF_HF_RIGHT) <> 0
        {
            var ok false
            if (hf_part & MIF_HF_FRONT) <> 0
                ok := true
            if (hf_part & MIF_HF_FIRST) = 0
                ok := true
            if ok
                this.end_header_footer(hf_part)
        }
        var exit_flow false
        if (hf_part & MIF_HF_FIRST) = 0
            exit_flow := true
        if (hf_part & MIF_HF_FRONT) <> 0
            exit_flow := true
        if exit_flow
            this.exit_text_flow()
    }

    function end_all_simple_page_sequence_header_footer(this: ref[MifFOTBuilder])
    {
    }

    ; --- tables ------------------------------------------------------------
    function rows_of(this: ref[MifFOTBuilder], part: ref[MifTablePart], sel: int) returns ref[Array[ref[MifFotRow]?]]
    {
        if sel = 0
            return part.header
        if sel = 2
            return part.footer
        part.body as ref[Array[Option[ref[MifFotRow]]]]
    }

    procedure cur_part(this: ref[MifFOTBuilder]) returns ref[MifTablePart]
    {
        let p this.cur_table.cur_part
        if p = null
            MifFOTBuilder.trap("curTablePart() is null")
        p as ref[MifTablePart]
    }

    procedure cur_rows(this: ref[MifFOTBuilder]) returns ref[Array[ref[MifFotRow]?]]
    {
        let r this.cur_table.cur_rows
        if r = null
            MifFOTBuilder.trap("curRows() is null")
        r as ref[Array[Option[ref[MifFotRow]]]]
    }

    procedure mif_table_of(this: ref[MifFOTBuilder], part: ref[MifTablePart]) returns ref[MifTbl]
    {
        if part.mif_table_num <= 0
            MifFOTBuilder.trap("mifTable() with MifTableNum == 0")
        let bc this.book_component()
        let p bc.tbls.get((part.mif_table_num - 1) as size_t)
        *p as ref[MifTbl]
    }

    procedure border_from_fot(this: ref[MifFOTBuilder], mutable b: ref[MifBorder])
    {
        let f this.format()
        b.border_priority := f.fot_border_priority
        b.border_present := f.fot_border_present
        b.line_thickness := f.fot_line_thickness
        b.line_repeat := f.fot_line_repeat
        b.line_sep := f.fot_line_sep
        b.color := f.f_color
    }

    ; Border::makeMifRuling
    procedure make_mif_ruling(mutable this: ref[MifFOTBuilder], b: ref[MifBorder]) returns String
    {
        let host this.host
        if b.border_present = false
            return String()
        let r MifRuling.make(host)
        r.pen_width := b.line_thickness
        r.set_props := r.set_props | MIF_RUL_PENWIDTH
        if b.line_repeat >= 2
            r.lines := 2
        else
            r.lines := b.line_repeat
        r.set_props := r.set_props | MIF_RUL_LINES
        if b.line_repeat >= 2
            r.gap := b.line_sep - b.line_thickness
        else
            r.gap := 0
        r.set_props := r.set_props | MIF_RUL_GAP
        r.color := b.color
        r.set_props := r.set_props | MIF_RUL_COLOR
        ; Ruling::key — "Ruling-<penWidth>-<gap>-<pen>-<lines>-" + colour
        let arr Array[u8]^host()
        MifFOTBuilder.arr_raw(arr, "Ruling-")
        MifFOTBuilder.arr_udec(arr, r.pen_width)
        arr.add(0x2D)
        MifFOTBuilder.arr_udec(arr, r.gap)
        arr.add(0x2D)
        MifFOTBuilder.arr_udec(arr, r.pen)
        arr.add(0x2D)
        MifFOTBuilder.arr_udec(arr, r.lines)
        arr.add(0x2D)
        MifFOTBuilder.arr_str(arr, r.color)
        let key MifFOTBuilder.str_from_bytes(host, arr)
        r.key := key
        r.tag := key
        r.set_props := r.set_props | MIF_RUL_TAG
        let bc this.book_component()
        if MifFOTBuilder.ruling_lookup(bc, key) = null
            this.ruling_insert(bc, r)
        key
    }

    ; Cell::translate
    procedure cell_translate(mutable this: ref[MifFOTBuilder], mutable c: ref[MifFotCell])
    {
        let mcell c.mif_cell
        var tag this.make_mif_ruling(c.before_row_border)
        if tag.get_length() > 0
        {
            mcell.cell_t_ruling := tag
            mcell.cell_set := mcell.cell_set | MIF_CELL_TRULING
        }
        tag := this.make_mif_ruling(c.after_row_border)
        if tag.get_length() > 0
        {
            mcell.cell_b_ruling := tag
            mcell.cell_set := mcell.cell_set | MIF_CELL_BRULING
        }
        tag := this.make_mif_ruling(c.before_column_border)
        if tag.get_length() > 0
        {
            mcell.cell_l_ruling := tag
            mcell.cell_set := mcell.cell_set | MIF_CELL_LRULING
        }
        tag := this.make_mif_ruling(c.after_column_border)
        if tag.get_length() > 0
        {
            mcell.cell_r_ruling := tag
            mcell.cell_set := mcell.cell_set | MIF_CELL_RRULING
        }
    }

    ; Row::translate
    procedure row_translate(mutable this: ref[MifFOTBuilder], mutable row: ref[MifFotRow], mutable mif_rows: ref[Array[ref[MifRow]?]])
    {
        let host this.host
        let mrow MifRow.make(host)
        mif_rows.add(mrow)
        let n row.cells.get_length()
        var i: size_t 0
        while (i + 1) < n
        {
            let cp row.cells.get(i)
            let c *cp
            if c <> null
            {
                this.cell_translate(c)
                mrow.cells.add(c.mif_cell)
            }
            i := i + 1
        }
    }

    procedure fot_rows_resize(mutable this: ref[MifFOTBuilder], mutable rows: ref[Array[ref[MifFotRow]?]], n: int)
    {
        let host this.host
        while rows.get_length() < (n as size_t)
            rows.add(MifFotRow.make(host))
    }

    procedure cells_resize(mutable this: ref[MifFOTBuilder], mutable row: ref[MifFotRow], n: int)
    {
        let host this.host
        while row.cells.get_length() < (n as size_t)
            row.cells.add(MifFotCell.make(host, this.mc))
    }

    procedure columns_resize(mutable this: ref[MifFOTBuilder], mutable part: ref[MifTablePart], n: int)
    {
        let host this.host
        while part.columns.get_length() < (n as size_t)
            part.columns.add(MifColumn.make(host))
    }

    function cell_at(row: ref[MifFotRow], i: int) returns ref[MifFotCell]
    {
        let p row.cells.get(i as size_t)
        *p as ref[MifFotCell]
    }

    function row_at(rows: ref[Array[ref[MifFotRow]?]], i: int) returns ref[MifFotRow]
    {
        let p rows.get(i as size_t)
        *p as ref[MifFotRow]
    }

    function column_at(part: ref[MifTablePart], i: int) returns ref[MifColumn]
    {
        let p part.columns.get(i as size_t)
        *p as ref[MifColumn]
    }

    ; TablePart::processColumns
    procedure part_process_columns(mutable this: ref[MifFOTBuilder], mutable part: ref[MifTablePart])
    {
        let host this.host
        let tbl this.mif_table_of(part)
        let ncols part.columns.get_length() as int
        tbl.num_columns := 0
        tbl.set_props := tbl.set_props | MIF_TBL_NUMCOLUMNS
        tbl.num_columns := ncols
        let fresh Array[int]^host()
        var z 0
        while z < ncols
        {
            fresh.add(0)
            z := z + 1
        }
        tbl.col_widths := fresh
        tbl.set_props := tbl.set_props | MIF_TBL_COLUMNWIDTHS
        var total_nonprop 0
        var total_prop 0.0
        var i 0
        while i < ncols
        {
            let col MifFOTBuilder.column_at(part, i)
            if col.has_width
            {
                if col.tuf <> 0.0
                    total_prop := total_prop + col.tuf
                else
                {
                    let w this.compute_length_spec(col.width)
                    fresh.put(i as size_t, w)
                    total_nonprop := total_nonprop + w
                }
            }
            i := i + 1
        }
        var prop_unit 0.0
        if total_prop <> 0.0
            prop_unit := ((this.cur_table.table_width - total_nonprop) as double) / total_prop
        i := 0
        while i < ncols
        {
            let col MifFOTBuilder.column_at(part, i)
            if col.has_width
            {
                if col.tuf <> 0.0
                    fresh.put(i as size_t, (prop_unit * col.tuf) as int)
            }
            else
                fresh.put(i as size_t, prop_unit as int)
            i := i + 1
        }
        part.columns_processed := true
    }

    ; TablePart::normalizeRows
    procedure part_normalize_rows(mutable this: ref[MifFOTBuilder], mutable part: ref[MifTablePart])
    {
        var max_cells (part.columns.get_length() as int) + 1
        var step 0
        while step < 2
        {
            var row_type 0
            while row_type < 3
            {
                let rows this.rows_of(part, row_type)
                let nr rows.get_length() as int
                var r 0
                while r < nr
                {
                    let row MifFOTBuilder.row_at(rows, r)
                    if step = 0
                    {
                        if row.cells.get_length() > 1
                        {
                            let last_idx (row.cells.get_length() as int) - 2
                            let last MifFOTBuilder.cell_at(row, last_idx)
                            if last.missing = false
                            {
                                if (last_idx + last.n_cols_spanned + 1) > max_cells
                                    max_cells := last_idx + last.n_cols_spanned + 1
                            }
                        }
                    }
                    else
                    {
                        if (row.cells.get_length() as int) < max_cells
                            this.cells_resize(row, max_cells)
                    }
                    r := r + 1
                }
                row_type := row_type + 1
            }
            step := step + 1
        }
    }

    ; Table::resolveBorders
    procedure resolve_borders(mutable this: ref[MifFOTBuilder], mutable rows: ref[Array[ref[MifFotRow]?]], has_first: bool, has_last: bool)
    {
        let t this.cur_table
        let nr rows.get_length() as int
        var r 0
        while r < nr
        {
            let row MifFOTBuilder.row_at(rows, r)
            let nc (row.cells.get_length() as int) - 1
            var c 0
            while c < nc
            {
                let cell MifFOTBuilder.cell_at(row, c)
                if cell.overlapping = null
                {
                    var rr r
                    while rr < (r + cell.n_rows_spanned)
                    {
                        if rr < nr
                        {
                            let rw MifFOTBuilder.row_at(rows, rr)
                            var cc c
                            while cc < (c + cell.n_cols_spanned)
                            {
                                if cc < (rw.cells.get_length() as int)
                                {
                                    let target MifFOTBuilder.cell_at(rw, cc)
                                    target.overlapping := cell
                                }
                                cc := cc + 1
                            }
                        }
                        rr := rr + 1
                    }
                }
                c := c + 1
            }
            r := r + 1
        }
        r := 0
        while r < nr
        {
            let row MifFOTBuilder.row_at(rows, r)
            let nc (row.cells.get_length() as int) - 1
            var c 0
            while c < nc
            {
                let cell MifFOTBuilder.cell_at(row, c)
                if cell.overlapping = cell
                {
                    var top_edge true
                    var rr r
                    while rr < (r + cell.n_rows_spanned)
                    {
                        var is_first_row false
                        if rr = 0
                            is_first_row := true
                        var is_last_row false
                        if rr = (nr - 1)
                            is_last_row := true
                        var left_edge true
                        var cc c
                        while cc < (c + cell.n_cols_spanned)
                        {
                            var is_first_col false
                            if cc = 0
                                is_first_col := true
                            var is_last_col false
                            if rr < nr
                            {
                                let rw2 MifFOTBuilder.row_at(rows, rr)
                                if cc = ((rw2.cells.get_length() as int) - 2)
                                    is_last_col := true
                            }
                            if left_edge
                            {
                                if is_first_col
                                    cell.before_column_border.resolve(t.before_column_border)
                                else
                                {
                                    if rr < nr
                                    {
                                        let rw3 MifFOTBuilder.row_at(rows, rr)
                                        if (cc - 1) < (rw3.cells.get_length() as int)
                                        {
                                            let nb MifFOTBuilder.cell_at(rw3, cc - 1)
                                            if nb.overlapping <> null
                                                cell.before_column_border.resolve(nb.overlapping.after_column_border)
                                        }
                                    }
                                }
                            }
                            if top_edge
                            {
                                if is_first_row and has_first
                                    cell.before_row_border.resolve(t.before_row_border)
                                else
                                {
                                    if is_first_row = false
                                    {
                                        let rw4 MifFOTBuilder.row_at(rows, rr - 1)
                                        if cc < (rw4.cells.get_length() as int)
                                        {
                                            let nb2 MifFOTBuilder.cell_at(rw4, cc)
                                            if nb2.overlapping <> null
                                                cell.before_row_border.resolve(nb2.overlapping.after_row_border)
                                        }
                                    }
                                }
                            }
                            if is_last_col
                                cell.after_column_border.resolve(t.after_column_border)
                            if is_last_row and has_last
                                cell.after_row_border.resolve(t.after_row_border)
                            left_edge := false
                            cc := cc + 1
                        }
                        top_edge := false
                        rr := rr + 1
                    }
                }
                c := c + 1
            }
            r := r + 1
        }
    }

    ; TablePart::translate
    procedure part_translate(mutable this: ref[MifFOTBuilder], mutable part: ref[MifTablePart])
    {
        let mc this.mc
        let t this.cur_table
        if part.needs_col_reproc
            this.part_process_columns(part)
        let tbl this.mif_table_of(part)
        if t.start_indent <> 0
        {
            tbl.fmt.lindent := t.start_indent
            tbl.fmt.set_props := tbl.fmt.set_props | MIF_TBLF_LINDENT
            tbl.set_props := tbl.set_props | MIF_TBL_FORMAT
        }
        if t.display_alignment <> MIF_SYM_START
        {
            tbl.set_props := tbl.set_props | MIF_TBL_FORMAT
            tbl.fmt.alignment := this.mif_alignment(t.display_alignment)
            tbl.fmt.set_props := tbl.fmt.set_props | MIF_TBLF_ALIGNMENT
        }
        let nh part.header.get_length() as int
        let nb part.body.get_length() as int
        let nf part.footer.get_length() as int
        var put_header_in_body false
        if (nb = 0) and (nh > 0)
            put_header_in_body := true
        var put_footer_in_body false
        if (put_header_in_body = false) and (nb = 0) and (nf > 0)
            put_footer_in_body := true
        var i 0
        while i < nh
        {
            let row MifFOTBuilder.row_at(part.header, i)
            if put_header_in_body
                this.row_translate(row, tbl.tblbody)
            else
                this.row_translate(row, tbl.tblh)
            i := i + 1
        }
        i := 0
        while i < nb
        {
            let row MifFOTBuilder.row_at(part.body as ref[Array[Option[ref[MifFotRow]]]], i)
            this.row_translate(row, tbl.tblbody)
            i := i + 1
        }
        i := 0
        while i < nf
        {
            let row MifFOTBuilder.row_at(part.footer, i)
            if put_footer_in_body
                this.row_translate(row, tbl.tblbody)
            else
                this.row_translate(row, tbl.tblf)
            i := i + 1
        }
    }

    ; TablePart::begin
    procedure part_begin(mutable this: ref[MifFOTBuilder], mutable part: ref[MifTablePart])
    {
        let host this.host
        let t this.cur_table
        part.columns := Array[ref[MifColumn]?]^host()
        part.header := Array[ref[MifFotRow]?]^host()
        part.body := Array[ref[MifFotRow]?]^host()
        part.footer := Array[ref[MifFotRow]?]^host()
        part.columns_processed := false
        part.needs_col_reproc := false
        t.cur_rows := part.body
        t.cur_part := part
        if part.mif_table_num = 0
        {
            let bc this.book_component()
            bc.tbls.add(MifTbl.make(host, this.alloc_id(), this.mc))
            part.mif_table_num := bc.tbls.get_length() as int
            this.cur_tbl_num := part.mif_table_num
        }
    }

    ; Table::begin
    procedure table_begin(mutable this: ref[MifFOTBuilder])
    {
        let host this.host
        let t this.cur_table
        t.cur_cell := null
        t.no_parts_seen := true
        t.parts := Array[ref[MifTablePart]?]^host()
        let part MifTablePart.make(host)
        t.parts.add(part)
        this.part_begin(part)
    }

    procedure start_table(mutable this: ref[MifFOTBuilder], tnic: ref[TableNIC], dnic: ref[DisplayNIC]?)
    {
        let host this.host
        let mc this.mc
        this.start_display(dnic as ref[DisplayNIC])
        this.mif_start()
        let t this.cur_table
        if t.default_tblfmt_generated = false
        {
            let bc this.book_component()
            let df MifTblFormat.make(host)
            df.tbl_tag := mc.s_default_tbl_format
            df.set_props := df.set_props | MIF_TBLF_TAG
            df.set_dsssl_defaults(mc)
            bc.tbl_catalog.add(df)
            t.default_tblfmt_generated := true
        }
        let f this.format()
        let start_indent this.compute_length_spec(f.fot_start_indent)
        t.start_indent := start_indent
        this.table_begin()
        t.display_alignment := f.fot_display_alignment
        var explicit false
        if tnic.width_type = MIF_TABLE_WIDTH_EXPLICIT
            explicit := true
        if explicit
            t.table_width := this.compute_length_spec(tnic.width)
        else
            t.table_width := f.fot_cur_display_size - start_indent - this.compute_length_spec(f.fot_end_indent)
        this.do_start_paragraph(dnic, true, 0, false)
        this.end_paragraph()
    }

    procedure end_table(mutable this: ref[MifFOTBuilder])
    {
        let t this.cur_table
        let np t.parts.get_length() as int
        var i 0
        while i < np
        {
            var first_part false
            if i = 0
                first_part := true
            var last_part false
            if i = (np - 1)
                last_part := true
            let pp t.parts.get(i as size_t)
            let part *pp
            this.part_normalize_rows(part as ref[MifTablePart])
            var has_header false
            if part.header.get_length() > 0
                has_header := true
            var has_footer false
            if part.footer.get_length() > 0
                has_footer := true
            if has_header
                this.resolve_borders(part.header, first_part, false)
            var body_first true
            if has_header
                body_first := false
            var body_last true
            if has_footer
                body_last := false
            this.resolve_borders(part.body as ref[Array[Option[ref[MifFotRow]]]], body_first, body_last)
            if has_footer
                this.resolve_borders(part.footer, false, last_part)
            this.part_translate(part as ref[MifTablePart])
            i := i + 1
        }
        this.cur_tbl_num := 0
        this.end_display()
        this.mif_end()
    }

    procedure table_column(mutable this: ref[MifFOTBuilder], nic: ref[TableColumnNIC])
    {
        let part this.cur_part()
        if (nic.column_index as size_t) >= part.columns.get_length()
            this.columns_resize(part, nic.column_index + 1)
        let col MifFOTBuilder.column_at(part, nic.column_index)
        col.has_width := nic.has_width
        if nic.has_width
        {
            col.width := nic.width
            col.tuf := nic.width_tfactor
        }
    }

    procedure start_table_row(mutable this: ref[MifFOTBuilder])
    {
        let host this.host
        let rows this.cur_rows()
        rows.add(MifFotRow.make(host))
    }

    function end_table_row(this: ref[MifFOTBuilder])
    {
    }

    procedure start_table_cell(mutable this: ref[MifFOTBuilder], nic_in: ref[TableCellNIC])
    {
        var nic: ref[TableCellNIC]? nic_in
        if nic = null
            nic := this.default_cell_nic
        this.mif_start()
        let t this.cur_table
        let part this.cur_part()
        if part.columns_processed = false
            this.part_process_columns(part)
        let rows this.cur_rows()
        let nr rows.get_length() as int
        if nr = 0
            MifFOTBuilder.trap("startTableCell with no open table row")
        let row MifFOTBuilder.row_at(rows, nr - 1)
        if (nic.column_index as size_t) >= row.cells.get_length()
            this.cells_resize(row, nic.column_index + 1)
        let cell MifFOTBuilder.cell_at(row, nic.column_index)
        t.cur_cell := cell
        cell.missing := nic.missing
        if nic.n_columns_spanned <> 1
        {
            cell.n_cols_spanned := nic.n_columns_spanned
            cell.mif_cell.cell_columns := nic.n_columns_spanned
            cell.mif_cell.cell_set := cell.mif_cell.cell_set | MIF_CELL_COLUMNS
        }
        if nic.n_rows_spanned <> 1
        {
            cell.n_rows_spanned := nic.n_rows_spanned
            cell.mif_cell.cell_rows := nic.n_rows_spanned
            cell.mif_cell.cell_set := cell.mif_cell.cell_set | MIF_CELL_ROWS
        }
        let f this.format()
        if f.fot_cell_background
        {
            if f.mif_background_color.get_length() > 0
            {
                cell.mif_cell.cell_fill := 0
                cell.mif_cell.cell_set := cell.mif_cell.cell_set | MIF_CELL_FILL
                cell.mif_cell.cell_color := f.mif_background_color
                cell.mif_cell.cell_set := cell.mif_cell.cell_set | MIF_CELL_COLOR
            }
        }
        var new_display_size 0
        var i nic.column_index
        while i < (nic.column_index + nic.n_columns_spanned)
        {
            if i < (part.columns.get_length() as int)
            {
                let col MifFOTBuilder.column_at(part, i)
                if col.has_width
                    new_display_size := new_display_size + this.compute_length_spec(col.width)
            }
            else
            {
                if nic.missing = false
                {
                    MifFOTBuilder.msg_w("MIF: missing table column flow object (table-auto-width feature not fully supported)")
                    this.columns_resize(part, (part.columns.get_length() as int) + 1)
                    let last MifFOTBuilder.column_at(part, (part.columns.get_length() as int) - 1)
                    last.has_width := true
                    last.width := LengthSpec()
                    last.tuf := 1.0
                    part.needs_col_reproc := true
                    let tbl this.mif_table_of(part)
                    if i > tbl.num_columns
                    {
                        tbl.num_columns := i
                        tbl.set_props := tbl.set_props | MIF_TBL_NUMCOLUMNS
                    }
                }
            }
            i := i + 1
        }
        new_display_size := new_display_size - (f.pgf_cm_l + f.pgf_cm_r)
        if new_display_size > 0
            f.fot_cur_display_size := new_display_size
        cell.display_size := f.fot_cur_display_size
        this.enter_table_cell(cell.mif_cell)
    }

    procedure end_table_cell(mutable this: ref[MifFOTBuilder])
    {
        this.exit_table_cell()
        this.mif_end()
        this.cur_table.cur_cell := null
    }

    procedure start_table_part_serial(mutable this: ref[MifFOTBuilder], dnic: ref[DisplayNIC]?)
    {
        let host this.host
        this.start_display(dnic as ref[DisplayNIC])
        this.mif_start()
        let t this.cur_table
        if t.no_parts_seen
            t.no_parts_seen := false
        else
            t.parts.add(MifTablePart.make(host))
        let n t.parts.get_length() as int
        let pp t.parts.get((n - 1) as size_t)
        this.part_begin((*pp) as ref[MifTablePart])
        this.do_start_paragraph(dnic, true, 0, false)
        this.end_paragraph()
    }

    procedure end_table_part_serial(mutable this: ref[MifFOTBuilder])
    {
        this.cur_table.cur_part := null
        this.end_display()
        this.mif_end()
    }

    procedure start_table_part_header(mutable this: ref[MifFOTBuilder])
        this.cur_table.cur_rows := this.cur_part().header

    procedure end_table_part_header(mutable this: ref[MifFOTBuilder])
        this.cur_table.cur_rows := this.cur_part().body

    procedure start_table_part_footer(mutable this: ref[MifFOTBuilder])
        this.cur_table.cur_rows := this.cur_part().footer

    procedure end_table_part_footer(mutable this: ref[MifFOTBuilder])
        this.cur_table.cur_rows := this.cur_part().body

    ; --- table borders -----------------------------------------------------
    procedure table_before_row_border(mutable this: ref[MifFOTBuilder])
    {
        this.mif_start()
        this.border_from_fot(this.cur_table.before_row_border)
        this.mif_end()
    }

    procedure table_after_row_border(mutable this: ref[MifFOTBuilder])
    {
        this.mif_start()
        this.border_from_fot(this.cur_table.after_row_border)
        this.mif_end()
    }

    procedure table_before_column_border(mutable this: ref[MifFOTBuilder])
    {
        this.mif_start()
        this.border_from_fot(this.cur_table.before_column_border)
        this.mif_end()
    }

    procedure table_after_column_border(mutable this: ref[MifFOTBuilder])
    {
        this.mif_start()
        this.border_from_fot(this.cur_table.after_column_border)
        this.mif_end()
    }

    procedure cur_fot_cell(this: ref[MifFOTBuilder]) returns ref[MifFotCell]
    {
        let c this.cur_table.cur_cell
        if c = null
            MifFOTBuilder.trap("curCell() is null")
        c as ref[MifFotCell]
    }

    procedure table_cell_before_row_border(mutable this: ref[MifFOTBuilder])
    {
        this.mif_start()
        this.border_from_fot(this.cur_fot_cell().before_row_border)
        this.mif_end()
    }

    procedure table_cell_after_row_border(mutable this: ref[MifFOTBuilder])
    {
        this.mif_start()
        this.border_from_fot(this.cur_fot_cell().after_row_border)
        this.mif_end()
    }

    procedure table_cell_before_column_border(mutable this: ref[MifFOTBuilder])
    {
        this.mif_start()
        this.border_from_fot(this.cur_fot_cell().before_column_border)
        this.mif_end()
    }

    procedure table_cell_after_column_border(mutable this: ref[MifFOTBuilder])
    {
        this.mif_start()
        this.border_from_fot(this.cur_fot_cell().after_column_border)
        this.mif_end()
