; --- MifConsts: the reference's `CONST_STRING` block, interned once on the
; run page (a String is a one-pointer handle, so passing them by value is
; free; every one of them is compared bytewise by the delta-format code) ----
define MifConsts
(
    s_none: String
    s_space: String
    s_default_tbl_format: String
    s_default_pgf_format: String
    s_times_new_roman: String
    s_page_num_xref_format_name: String
    s_a: String
    s_regular: String
    s_bold: String
    s_italic: String
    s_fno_underlining: String
    s_fsingle: String
    s_fdouble: String
    s_fnumeric: String
    s_fnormal: String
    s_fsuperscript: String
    s_fsubscript: String
    s_fastyped: String
    s_fsmallcaps: String
    s_flowercase: String
    s_fuppercase: String
    s_left_right: String
    s_left: String
    s_right: String
    s_center: String
    s_fixed: String
    s_proportional: String
    s_top: String
    s_middle: String
    s_bottom: String
    s_no_language: String
    s_us_english: String
    s_uk_english: String
    s_german: String
    s_swiss_german: String
    s_french: String
    s_canadian_french: String
    s_spanish: String
    s_catalan: String
    s_italian: String
    s_portuguese: String
    s_brazilian: String
    s_danish: String
    s_dutch: String
    s_norwegian: String
    s_nynorsk: String
    s_finnish: String
    s_swedish: String
    s_left_master_page: String
    s_right_master_page: String
    s_other_master_page: String
    s_body_page: String
    s_decimal: String
    s_tab: String
    s_hard_space: String
    s_soft_hyphen: String
    s_hard_hyphen: String
    s_hard_return: String
    s_number_space: String
    s_thin_space: String
    s_en_space: String
    s_em_space: String
    s_header: String
    s_footer: String
    s_arabic: String
    s_uc_roman: String
    s_lc_roman: String
    s_uc_alpha: String
    s_lc_alpha: String
    s_first_left: String
    s_first_right: String
    s_anywhere: String
    s_column_top: String
    s_page_top: String
    s_lpage_top: String
    s_rpage_top: String
    s_first: String
    s_inside: String
    s_outside: String
    s_none_kw: String
    s_run_into_paragraph: String
    s_inline: String
    s_below: String
    s_butt: String
    s_round: String
    s_square: String
    s_white: String
    s_black: String
    s_normal: String
    s_straddle: String
    s_cent: String
    s_pound: String
    s_yen: String
    s_en_dash: String
    s_em_dash: String
    s_dagger: String
    s_double_dagger: String
    s_bullet: String
)
{
    function make(host: ref[Page]) returns ref[MifConsts]
    {
        let c &MifConsts^host(String(), String^host(" "), String^host("Default Tbl Format"), String^host("Default Pgf Format"), String^host("Times New Roman"), String^host("Page Number Format"), String^host("A"), String^host("Regular"), String^host("Bold"), String^host("Italic"), String^host("FNoUnderlining"), String^host("FSingle"), String^host("FDouble"), String^host("FNumeric"), String^host("FNormal"), String^host("FSuperscript"), String^host("FSubscript"), String^host("FAsTyped"), String^host("FSmallCaps"), String^host("FLowercase"), String^host("FUppercase"), String^host("LeftRight"), String^host("Left"), String^host("Right"), String^host("Center"), String^host("Fixed"), String^host("Proportional"), String^host("Top"), String^host("Middle"), String^host("Bottom"), String^host("NoLanguage"), String^host("USEnglish"), String^host("UKEnglish"), String^host("German"), String^host("SwissGerman"), String^host("French"), String^host("CanadianFrench"), String^host("Spanish"), String^host("Catalan"), String^host("Italian"), String^host("Portuguese"), String^host("Brazilian"), String^host("Danish"), String^host("Dutch"), String^host("Norwegian"), String^host("Nynorsk"), String^host("Finnish"), String^host("Swedish"), String^host("LeftMasterPage"), String^host("RightMasterPage"), String^host("OtherMasterPage"), String^host("BodyPage"), String^host("Decimal"), String^host("Tab"), String^host("HardSpace"), String^host("SoftHyphen"), String^host("HardHyphen"), String^host("HardReturn"), String^host("NumberSpace"), String^host("ThinSpace"), String^host("EnSpace"), String^host("EmSpace"), String^host("Header"), String^host("Footer"), String^host("Arabic"), String^host("UCRoman"), String^host("LCRoman"), String^host("UCAlpha"), String^host("LCAlpha"), String^host("FirstLeft"), String^host("FirstRight"), String^host("Anywhere"), String^host("ColumnTop"), String^host("PageTop"), String^host("LPageTop"), String^host("RPageTop"), String^host("First"), String^host("Inside"), String^host("Outside"), String^host("None"), String^host("RunIntoParagraph"), String^host("Inline"), String^host("Below"), String^host("Butt"), String^host("Round"), String^host("Square"), String^host("White"), String^host("Black"), String^host("Normal"), String^host("Straddle"), String^host("Cent"), String^host("Pound"), String^host("Yen"), String^host("EnDash"), String^host("EmDash"), String^host("Dagger"), String^host("DoubleDagger"), String^host("Bullet"))
        c
    }
}

; --- MifOS: MifOutputByteStream — a byte sink plus the CurTagIndent cursor.
; Several MifOS views can share one byte array (the reference constructs a
; fresh MifOutputByteStream with indent 0 over a stream at commit time). ----
define MifOS (b: ref[Array[u8]], var ind: int)
{
    function make(host: ref[Page], b: ref[Array[u8]], ind: int) returns ref[MifOS]
    {
        let o &MifOS^host(b, ind)
        o
    }

    procedure put(mutable this: ref[MifOS], c: u8)
        this.b.add(c)

    procedure raw(mutable this: ref[MifOS], s: Slice[char])
    {
        var i: size_t 0
        while i < s.length
        {
            this.b.add(s[i] as u8)
            i := i + 1
        }
    }

    ; the raw bytes of a String<char>-valued property (T_keyword prints bare)
    procedure str(mutable this: ref[MifOS], s: String)
    {
        let n s.get_length()
        if n = 0
            return
        let p s.as_slice()
        var i: size_t 0
        while i < n
        {
            this.b.add(p[i])
            i := i + 1
        }
    }

    ; T_string / T_tagstring / T_pathname: backtick + bytes + apostrophe
    procedure tstr(mutable this: ref[MifOS], s: String)
    {
        this.b.add(0x60)
        this.str(s)
        this.b.add(0x27)
    }

    procedure indent(mutable this: ref[MifOS])
        this.ind := this.ind + 2

    procedure undent(mutable this: ref[MifOS])
        this.ind := this.ind - 2

    ; `os << '\n' << MifOutputByteStream::INDENT`
    procedure nlind(mutable this: ref[MifOS])
    {
        this.b.add(0x0A)
        var k this.ind
        while k > 0
        {
            this.b.add(0x20)
            k := k - 1
        }
    }

    procedure udec(mutable this: ref[MifOS], n_in: int)
    {
        var n n_in
        if n = 0
        {
            this.b.add(0x30)
            return
        }
        var digits u8[24]
        var k 0
        while n > 0
        {
            digits[k] := ((n % 10) + 0x30) as u8
            n := n / 10
            k := k + 1
        }
        while k > 0
        {
            k := k - 1
            this.b.add(digits[k])
        }
    }

    procedure num(mutable this: ref[MifOS], n: int)
    {
        if n < 0
        {
            this.b.add(0x2D)
            this.udec(0 - n)
            return
        }
        this.udec(n)
    }

    ; T_dimension: sprintf("%li.%.3i", d/1000, abs(d%1000)) with the trailing
    ; zeros (and a bare trailing '.') stripped, then "pt". Values in
    ; (-1000, 0) lose their sign because the integer part prints as 0 —
    ; faithful to the reference.
    procedure dim(mutable this: ref[MifOS], d: int)
    {
        var buf u8[48]
        var n 0
        var q d / 1000
        var r d % 1000
        if r < 0
            r := 0 - r
        if q < 0
        {
            buf[n] := 0x2D
            n := n + 1
            q := 0 - q
        }
        if q = 0
        {
            buf[n] := 0x30
            n := n + 1
        }
        else
        {
            var tmp u8[24]
            var k 0
            var qq q
            while qq > 0
            {
                tmp[k] := ((qq % 10) + 0x30) as u8
                qq := qq / 10
                k := k + 1
            }
            while k > 0
            {
                k := k - 1
                buf[n] := tmp[k]
                n := n + 1
            }
        }
        buf[n] := 0x2E
        n := n + 1
        buf[n] := (((r / 100) % 10) + 0x30) as u8
        n := n + 1
        buf[n] := (((r / 10) % 10) + 0x30) as u8
        n := n + 1
        buf[n] := ((r % 10) + 0x30) as u8
        n := n + 1
        var i n - 1
        while buf[i] = 0x30
            i := i - 1
        if buf[i] = 0x2E
            i := i - 1
        var j 0
        while j <= i
        {
            this.b.add(buf[j])
            j := j + 1
        }
        this.raw("pt")
    }

    ; T_percentage: sprintf("%.6f")
    procedure pct(mutable this: ref[MifOS], x: double)
    {
        var v x
        var neg false
        if v < 0.0
        {
            neg := true
            v := 0.0 - v
        }
        var ip v as int
        let frac v - (ip as double)
        var f6 ((frac * 1000000.0) + 0.5) as int
        if f6 >= 1000000
        {
            f6 := f6 - 1000000
            ip := ip + 1
        }
        if neg
            this.b.add(0x2D)
        this.udec(ip)
        this.b.add(0x2E)
        var div 100000
        var k 0
        while k < 6
        {
            this.b.add((((f6 / div) % 10) + 0x30) as u8)
            div := div / 10
            k := k + 1
        }
    }

    procedure boolyn(mutable this: ref[MifOS], v: bool)
    {
        if v
            this.raw("Yes")
        else
            this.raw("No")
    }

    procedure sp(mutable this: ref[MifOS])
        this.b.add(0x20)

    procedure ltrb(mutable this: ref[MifOS], l: int, t: int, r: int, b2: int)
    {
        this.dim(l)
        this.sp()
        this.dim(t)
        this.sp()
        this.dim(r)
        this.sp()
        this.dim(b2)
    }

    procedure two(mutable this: ref[MifOS], a: int, b2: int)
    {
        this.dim(a)
        this.sp()
        this.dim(b2)
    }

    ; `<Name ` … `>` at the current indent
    procedure open_prop(mutable this: ref[MifOS], name: Slice[char])
    {
        this.nlind()
        this.b.add(0x3C)
        this.raw(name)
        this.b.add(0x20)
    }

    procedure close_prop(mutable this: ref[MifOS])
        this.b.add(0x3E)

    procedure p_dim(mutable this: ref[MifOS], name: Slice[char], v: int)
    {
        this.open_prop(name)
        this.dim(v)
        this.close_prop()
    }

    procedure p_num(mutable this: ref[MifOS], name: Slice[char], v: int)
    {
        this.open_prop(name)
        this.num(v)
        this.close_prop()
    }

    procedure p_udec(mutable this: ref[MifOS], name: Slice[char], v: int)
    {
        this.open_prop(name)
        this.udec(v)
        this.close_prop()
    }

    procedure p_kw(mutable this: ref[MifOS], name: Slice[char], v: String)
    {
        this.open_prop(name)
        this.str(v)
        this.close_prop()
    }

    procedure p_tstr(mutable this: ref[MifOS], name: Slice[char], v: String)
    {
        this.open_prop(name)
        this.tstr(v)
        this.close_prop()
    }

    procedure p_bool(mutable this: ref[MifOS], name: Slice[char], v: bool)
    {
        this.open_prop(name)
        this.boolyn(v)
        this.close_prop()
    }

    procedure p_pct(mutable this: ref[MifOS], name: Slice[char], v: double)
    {
        this.open_prop(name)
        this.pct(v)
        this.close_prop()
    }

    procedure p_ltrb(mutable this: ref[MifOS], name: Slice[char], l: int, t: int, r: int, b2: int)
    {
        this.open_prop(name)
        this.ltrb(l, t, r, b2)
        this.close_prop()
    }

    procedure p_two(mutable this: ref[MifOS], name: Slice[char], a: int, b2: int)
    {
        this.open_prop(name)
        this.two(a, b2)
        this.close_prop()
    }

    ; `<Name ` … open a nested statement and indent
    procedure begin_stmt(mutable this: ref[MifOS], name: Slice[char])
    {
        this.nlind()
        this.b.add(0x3C)
        this.raw(name)
        this.b.add(0x20)
        this.indent()
    }

    procedure end_stmt(mutable this: ref[MifOS])
    {
        this.undent()
        this.nlind()
        this.b.add(0x3E)
    }
}

; --- MifTmp: MifTmpOutputByteStream — the per-tag-stream content buffer ----
define MifTmp (b: ref[Array[u8]], os: ref[MifOS])
{
    function make(host: ref[Page], ind: int) returns ref[MifTmp]
    {
        let bytes Array[u8]^host()
        let t &MifTmp^host(bytes, MifOS.make(host, bytes, ind))
        t
    }

    function is_empty(this: ref[MifTmp]) returns bool
        b.get_length() = 0
}

; --- MifTabStop ------------------------------------------------------------
define MifTabStop (var set_props: int, var tsx: int, var ts_type: String, var ts_leader: String, var ts_decimal: int)
{
    function make(host: ref[Page], ts_type: String, tsx: int, leader: String) returns ref[MifTabStop]
    {
        let t host.allocate(sizeof MifTabStop, alignof MifTabStop) as pointer[MifTabStop]
        t.tsx := tsx
        t.ts_type := ts_type
        t.ts_decimal := 0
        t.set_props := MIF_TS_TYPE | MIF_TS_X
        t.ts_leader := leader
        t.set_props := t.set_props | MIF_TS_LEADERSTR
        t
    }

    procedure out(this: ref[MifTabStop], mutable os: ref[MifOS])
    {
        os.begin_stmt("TabStop")
        if (this.set_props & MIF_TS_X) <> 0
            os.p_dim("TSX", this.tsx)
        if (this.set_props & MIF_TS_TYPE) <> 0
            os.p_kw("TSType", this.ts_type)
        if (this.set_props & MIF_TS_LEADERSTR) <> 0
            os.p_tstr("TSLeaderStr", this.ts_leader)
        if (this.set_props & MIF_TS_DECIMALCHAR) <> 0
            os.p_num("TSDecimalChar", this.ts_decimal)
        os.end_stmt()
    }
}

; --- MifFormat: FontFormat + ParagraphFormat + MifFOTBuilder::Format -------
define MifFormat
(
    var ff_set: int
    var f_family: String
    var f_angle: String
    var f_weight: String
    var f_var: String
    var f_size: int
    var f_color: String
    var f_underlining: String
    var f_overline: bool
    var f_strike: bool
    var f_position: String
    var f_pair_kern: bool
    var f_case: String
    var f_dx: double
    var f_dy: double
    var f_dw: double
    var pf_set: int
    var pgf_tag: String
    var pgf_findent: int
    var pgf_lindent: int
    var pgf_rindent: int
    var pgf_alignment: String
    var pgf_sp_before: int
    var pgf_sp_after: int
    var pgf_line_spacing: String
    var pgf_leading: int
    var pgf_num_tabs: int
    var tab_stops: ref[Array[ref[MifTabStop]?]]
    var pgf_placement: String
    var pgf_placement_style: String
    var pgf_with_prev: bool
    var pgf_with_next: bool
    var pgf_block_size: int
    var pgf_auto_num: bool
    var pgf_num_format: String
    var pgf_number_font: String
    var pgf_hyphenate: bool
    var hyphen_max_lines: int
    var hyphen_min_prefix: int
    var hyphen_min_suffix: int
    var hyphen_min_word: int
    var pgf_letter_space: bool
    var pgf_language: String
    var pgf_cell_alignment: String
    var pgf_cm_l: int
    var pgf_cm_t: int
    var pgf_cm_r: int
    var pgf_cm_b: int
    var pgf_cell_l_fixed: bool
    var pgf_cell_t_fixed: bool
    var pgf_cell_r_fixed: bool
    var pgf_cell_b_fixed: bool
    ; --- MifFOTBuilder::Format: the FOT-side snapshot -----------------------
    var fot_first_line_start_indent: LengthSpec
    var fot_start_indent: LengthSpec
    var fot_end_indent: LengthSpec
    var fot_line_spacing: LengthSpec
    var fot_position_point_shift: LengthSpec
    var fot_field_width: LengthSpec
    var fot_min_leading_has: bool
    var fot_cur_display_size: int
    var fot_line_thickness: int
    var fot_line_cap: int
    var fot_border_priority: int
    var fot_border_present: bool
    var fot_line_repeat: int
    var fot_line_sep: int
    var fot_display_alignment: int
    var fot_left_margin: int
    var fot_right_margin: int
    var fot_top_margin: int
    var fot_bottom_margin: int
    var fot_header_margin: int
    var fot_footer_margin: int
    var fot_page_width: int
    var fot_page_height: int
    var fot_field_align: int
    var fot_input_whitespace: int
    var fot_lines: int
    var fot_page_n_columns: int
    var fot_page_column_sep: int
    var fot_span: int
    var fot_page_balance: bool
    var fot_cell_background: bool
    var mif_background_color: String
    var fot_language: int
    var fot_country: int
)
{
    ; the reference Format ctor's member initialiser list
    function make(host: ref[Page]) returns ref[MifFormat]
    {
        let f host.allocate(sizeof MifFormat, alignof MifFormat) as pointer[MifFormat]
        f.ff_set := 0
        f.f_family := String()
        f.f_angle := String()
        f.f_weight := String()
        f.f_var := String()
        f.f_size := 0
        f.f_color := String()
        f.f_underlining := String()
        f.f_overline := false
        f.f_strike := false
        f.f_position := String()
        f.f_pair_kern := false
        f.f_case := String()
        f.f_dx := 0.0
        f.f_dy := 0.0
        f.f_dw := 0.0
        f.pf_set := 0
        f.pgf_tag := String()
        f.pgf_findent := 0
        f.pgf_lindent := 0
        f.pgf_rindent := 0
        f.pgf_alignment := String()
        f.pgf_sp_before := 0
        f.pgf_sp_after := 0
        f.pgf_line_spacing := String()
        f.pgf_leading := 0
        f.pgf_num_tabs := 0
        f.tab_stops := Array[ref[MifTabStop]?]^host()
        f.pgf_placement := String()
        f.pgf_placement_style := String()
        f.pgf_with_prev := false
        f.pgf_with_next := false
        f.pgf_block_size := 0
        f.pgf_auto_num := false
        f.pgf_num_format := String()
        f.pgf_number_font := String()
        f.pgf_hyphenate := false
        f.hyphen_max_lines := 0
        f.hyphen_min_prefix := 0
        f.hyphen_min_suffix := 0
        f.hyphen_min_word := 0
        f.pgf_letter_space := false
        f.pgf_language := String()
        f.pgf_cell_alignment := String()
        f.pgf_cm_l := 0
        f.pgf_cm_t := 0
        f.pgf_cm_r := 0
        f.pgf_cm_b := 0
        f.pgf_cell_l_fixed := false
        f.pgf_cell_t_fixed := false
        f.pgf_cell_r_fixed := false
        f.pgf_cell_b_fixed := false
        f.fot_first_line_start_indent := LengthSpec()
        f.fot_start_indent := LengthSpec()
        f.fot_end_indent := LengthSpec()
        var lsp LengthSpec()
        lsp.length := 12000
        f.fot_line_spacing := lsp
        f.fot_position_point_shift := LengthSpec()
        f.fot_field_width := LengthSpec()
        f.fot_min_leading_has := false
        f.fot_cur_display_size := 0
        f.fot_line_thickness := 1000
        f.fot_line_cap := MIF_SYM_BUTT
        f.fot_border_priority := 0
        f.fot_border_present := true
        f.fot_line_repeat := 1
        f.fot_line_sep := 1000
        f.fot_display_alignment := MIF_SYM_START
        f.fot_left_margin := 1
        f.fot_right_margin := 1
        f.fot_top_margin := 0
        f.fot_bottom_margin := 0
        f.fot_header_margin := 0
        f.fot_footer_margin := 0
        f.fot_page_width := 72000 * 8
        f.fot_page_height := (72000 * 23) / 2
        f.fot_field_align := MIF_SYM_START
        f.fot_input_whitespace := MIF_SYM_PRESERVE
        f.fot_lines := MIF_SYM_WRAP
        f.fot_page_n_columns := 1
        f.fot_page_column_sep := 72000 / 2
        f.fot_span := 1
        f.fot_page_balance := false
        f.fot_cell_background := false
        f.mif_background_color := String()
        f.fot_language := 0
        f.fot_country := 0
        f
    }

    ; the FontFormat + ParagraphFormat slice (`ParagraphFormat = Format`)
    procedure copy_pf(host: ref[Page], mutable dst: ref[MifFormat], src: ref[MifFormat])
    {
        dst.ff_set := src.ff_set
        dst.f_family := src.f_family
        dst.f_angle := src.f_angle
        dst.f_weight := src.f_weight
        dst.f_var := src.f_var
        dst.f_size := src.f_size
        dst.f_color := src.f_color
        dst.f_underlining := src.f_underlining
        dst.f_overline := src.f_overline
        dst.f_strike := src.f_strike
        dst.f_position := src.f_position
        dst.f_pair_kern := src.f_pair_kern
        dst.f_case := src.f_case
        dst.f_dx := src.f_dx
        dst.f_dy := src.f_dy
        dst.f_dw := src.f_dw
        dst.pf_set := src.pf_set
        dst.pgf_tag := src.pgf_tag
        dst.pgf_findent := src.pgf_findent
        dst.pgf_lindent := src.pgf_lindent
        dst.pgf_rindent := src.pgf_rindent
        dst.pgf_alignment := src.pgf_alignment
        dst.pgf_sp_before := src.pgf_sp_before
        dst.pgf_sp_after := src.pgf_sp_after
        dst.pgf_line_spacing := src.pgf_line_spacing
        dst.pgf_leading := src.pgf_leading
        dst.pgf_num_tabs := src.pgf_num_tabs
        ; Vector<TabStop> is a VALUE member: every copy owns its own list
        let fresh Array[ref[MifTabStop]?]^host()
        let n src.tab_stops.get_length()
        var i: size_t 0
        while i < n
        {
            let sp src.tab_stops.get(i)
            if sp <> null
                fresh.add(*sp)
            i := i + 1
        }
        dst.tab_stops := fresh
        dst.pgf_placement := src.pgf_placement
        dst.pgf_placement_style := src.pgf_placement_style
        dst.pgf_with_prev := src.pgf_with_prev
        dst.pgf_with_next := src.pgf_with_next
        dst.pgf_block_size := src.pgf_block_size
        dst.pgf_auto_num := src.pgf_auto_num
        dst.pgf_num_format := src.pgf_num_format
        dst.pgf_number_font := src.pgf_number_font
        dst.pgf_hyphenate := src.pgf_hyphenate
        dst.hyphen_max_lines := src.hyphen_max_lines
        dst.hyphen_min_prefix := src.hyphen_min_prefix
        dst.hyphen_min_suffix := src.hyphen_min_suffix
        dst.hyphen_min_word := src.hyphen_min_word
        dst.pgf_letter_space := src.pgf_letter_space
        dst.pgf_language := src.pgf_language
        dst.pgf_cell_alignment := src.pgf_cell_alignment
        dst.pgf_cm_l := src.pgf_cm_l
        dst.pgf_cm_t := src.pgf_cm_t
        dst.pgf_cm_r := src.pgf_cm_r
        dst.pgf_cm_b := src.pgf_cm_b
        dst.pgf_cell_l_fixed := src.pgf_cell_l_fixed
        dst.pgf_cell_t_fixed := src.pgf_cell_t_fixed
        dst.pgf_cell_r_fixed := src.pgf_cell_r_fixed
        dst.pgf_cell_b_fixed := src.pgf_cell_b_fixed
    }

    ; the full Format copy (`new Format(nextFormat)` / `nextFormat = *head`)
    procedure copy_all(host: ref[Page], mutable dst: ref[MifFormat], src: ref[MifFormat])
    {
        MifFormat.copy_pf(host, dst, src)
        dst.fot_first_line_start_indent := src.fot_first_line_start_indent
        dst.fot_start_indent := src.fot_start_indent
        dst.fot_end_indent := src.fot_end_indent
        dst.fot_line_spacing := src.fot_line_spacing
        dst.fot_position_point_shift := src.fot_position_point_shift
        dst.fot_field_width := src.fot_field_width
        dst.fot_min_leading_has := src.fot_min_leading_has
        dst.fot_cur_display_size := src.fot_cur_display_size
        dst.fot_line_thickness := src.fot_line_thickness
        dst.fot_line_cap := src.fot_line_cap
        dst.fot_border_priority := src.fot_border_priority
        dst.fot_border_present := src.fot_border_present
        dst.fot_line_repeat := src.fot_line_repeat
        dst.fot_line_sep := src.fot_line_sep
        dst.fot_display_alignment := src.fot_display_alignment
        dst.fot_left_margin := src.fot_left_margin
        dst.fot_right_margin := src.fot_right_margin
        dst.fot_top_margin := src.fot_top_margin
        dst.fot_bottom_margin := src.fot_bottom_margin
        dst.fot_header_margin := src.fot_header_margin
        dst.fot_footer_margin := src.fot_footer_margin
        dst.fot_page_width := src.fot_page_width
        dst.fot_page_height := src.fot_page_height
        dst.fot_field_align := src.fot_field_align
        dst.fot_input_whitespace := src.fot_input_whitespace
        dst.fot_lines := src.fot_lines
        dst.fot_page_n_columns := src.fot_page_n_columns
        dst.fot_page_column_sep := src.fot_page_column_sep
        dst.fot_span := src.fot_span
        dst.fot_page_balance := src.fot_page_balance
        dst.fot_cell_background := src.fot_cell_background
        dst.mif_background_color := src.mif_background_color
        dst.fot_language := src.fot_language
        dst.fot_country := src.fot_country
    }

    procedure set_dsssl_defaults(mutable this: ref[MifFormat], mc: ref[MifConsts])
    {
        ; FontFormat::setDSSSLDefaults
        this.f_family := mc.s_times_new_roman
        this.f_angle := mc.s_regular
        this.f_weight := mc.s_regular
        this.f_var := mc.s_regular
        this.f_size := 10000
        this.f_color := mc.s_black
        this.f_underlining := mc.s_fno_underlining
        this.f_overline := false
        this.f_strike := false
        this.f_position := mc.s_fnormal
        this.f_pair_kern := false
        this.f_case := mc.s_fastyped
        this.f_dx := 0.0
        this.f_dy := 0.0
        this.f_dw := 0.0
        this.ff_set := this.ff_set | MIF_FF_FAMILY | MIF_FF_ANGLE | MIF_FF_WEIGHT | MIF_FF_VAR | MIF_FF_SIZE | MIF_FF_COLOR | MIF_FF_UNDERLINING | MIF_FF_OVERLINE | MIF_FF_STRIKE | MIF_FF_POSITION | MIF_FF_PAIRKERN | MIF_FF_CASE | MIF_FF_DX | MIF_FF_DY | MIF_FF_DW
        ; ParagraphFormat::setDSSSLDefaults
        this.pgf_findent := 0
        this.pgf_lindent := 0
        this.pgf_rindent := 0
        this.pgf_alignment := mc.s_left
        this.pgf_sp_before := 0
        this.pgf_sp_after := 0
        this.pgf_line_spacing := mc.s_fixed
        this.pgf_leading := 0
        this.pgf_num_tabs := 0
        this.pgf_with_prev := false
        this.pgf_with_next := false
        this.pgf_block_size := 2
        this.pgf_auto_num := false
        this.pgf_hyphenate := false
        this.hyphen_max_lines := 999
        this.hyphen_min_prefix := 2
        this.hyphen_min_suffix := 2
        this.hyphen_min_word := 2
        this.pgf_letter_space := false
        this.pgf_language := mc.s_no_language
        this.pgf_cell_alignment := mc.s_top
        this.pgf_cm_l := 0
        this.pgf_cm_t := 0
        this.pgf_cm_r := 0
        this.pgf_cm_b := 0
        this.pgf_cell_l_fixed := true
        this.pgf_cell_t_fixed := true
        this.pgf_cell_r_fixed := true
        this.pgf_cell_b_fixed := true
        this.pgf_placement := mc.s_anywhere
        this.pgf_placement_style := mc.s_normal
        this.pf_set := this.pf_set | MIF_PF_FINDENT | MIF_PF_LINDENT | MIF_PF_RINDENT | MIF_PF_ALIGNMENT | MIF_PF_SPBEFORE | MIF_PF_SPAFTER | MIF_PF_LINESPACING | MIF_PF_LEADING | MIF_PF_NUMTABS | MIF_PF_WITHPREV | MIF_PF_WITHNEXT | MIF_PF_BLOCKSIZE | MIF_PF_AUTONUM | MIF_PF_HYPHENATE | MIF_PF_HMAXLINES | MIF_PF_HMINPREFIX | MIF_PF_HMINSUFFIX | MIF_PF_HMINWORD | MIF_PF_LETTERSPACE | MIF_PF_LANGUAGE | MIF_PF_CELLALIGN | MIF_PF_CELLMARGINS | MIF_PF_CELLLFIXED | MIF_PF_CELLTFIXED | MIF_PF_CELLRFIXED | MIF_PF_CELLBFIXED | MIF_PF_PLACEMENT | MIF_PF_PLACEMENTSTYLE
    }

    ; FontFormat::compare
    function ff_compare(a: ref[MifFormat], b2: ref[MifFormat]) returns int
    {
        var d 0
        if a.f_family.equals(b2.f_family) = false
            d := d | MIF_FF_FAMILY
        if a.f_angle.equals(b2.f_angle) = false
            d := d | MIF_FF_ANGLE
        if a.f_weight.equals(b2.f_weight) = false
            d := d | MIF_FF_WEIGHT
        if a.f_var.equals(b2.f_var) = false
            d := d | MIF_FF_VAR
        if a.f_size <> b2.f_size
            d := d | MIF_FF_SIZE
        if a.f_color.equals(b2.f_color) = false
            d := d | MIF_FF_COLOR
        if a.f_underlining.equals(b2.f_underlining) = false
            d := d | MIF_FF_UNDERLINING
        if a.f_overline <> b2.f_overline
            d := d | MIF_FF_OVERLINE
        if a.f_strike <> b2.f_strike
            d := d | MIF_FF_STRIKE
        if a.f_position.equals(b2.f_position) = false
            d := d | MIF_FF_POSITION
        if a.f_pair_kern <> b2.f_pair_kern
            d := d | MIF_FF_PAIRKERN
        if a.f_case.equals(b2.f_case) = false
            d := d | MIF_FF_CASE
        if a.f_dx <> b2.f_dx
            d := d | MIF_FF_DX
        if a.f_dy <> b2.f_dy
            d := d | MIF_FF_DY
        if a.f_dw <> b2.f_dw
            d := d | MIF_FF_DW
        d
    }

    ; FontFormat::setFrom
    procedure ff_set_from(mutable dst: ref[MifFormat], src: ref[MifFormat], props: int)
    {
        if (props & MIF_FF_FAMILY) <> 0
            dst.f_family := src.f_family
        if (props & MIF_FF_ANGLE) <> 0
            dst.f_angle := src.f_angle
        if (props & MIF_FF_WEIGHT) <> 0
            dst.f_weight := src.f_weight
        if (props & MIF_FF_VAR) <> 0
            dst.f_var := src.f_var
        if (props & MIF_FF_SIZE) <> 0
            dst.f_size := src.f_size
        if (props & MIF_FF_COLOR) <> 0
            dst.f_color := src.f_color
        if (props & MIF_FF_UNDERLINING) <> 0
            dst.f_underlining := src.f_underlining
        if (props & MIF_FF_OVERLINE) <> 0
            dst.f_overline := src.f_overline
        if (props & MIF_FF_STRIKE) <> 0
            dst.f_strike := src.f_strike
        if (props & MIF_FF_POSITION) <> 0
            dst.f_position := src.f_position
        if (props & MIF_FF_PAIRKERN) <> 0
            dst.f_pair_kern := src.f_pair_kern
        if (props & MIF_FF_CASE) <> 0
            dst.f_case := src.f_case
        if (props & MIF_FF_DX) <> 0
            dst.f_dx := src.f_dx
        if (props & MIF_FF_DY) <> 0
            dst.f_dy := src.f_dy
        if (props & MIF_FF_DW) <> 0
            dst.f_dw := src.f_dw
    }

    procedure ff_update_from(mutable dst: ref[MifFormat], src: ref[MifFormat])
    {
        let d MifFormat.ff_compare(dst, src)
        MifFormat.ff_set_from(dst, src, d)
        dst.ff_set := d
    }

    ; ParagraphFormat::compare
    function pf_compare(a: ref[MifFormat], b2: ref[MifFormat]) returns int
    {
        var d 0
        if a.pgf_tag.equals(b2.pgf_tag) = false
            d := d | MIF_PF_TAG
        if a.pgf_language.equals(b2.pgf_language) = false
            d := d | MIF_PF_LANGUAGE
        if a.pgf_findent <> b2.pgf_findent
            d := d | MIF_PF_FINDENT
        if a.pgf_lindent <> b2.pgf_lindent
            d := d | MIF_PF_LINDENT
        if a.pgf_rindent <> b2.pgf_rindent
            d := d | MIF_PF_RINDENT
        if a.pgf_alignment.equals(b2.pgf_alignment) = false
            d := d | MIF_PF_ALIGNMENT
        if a.pgf_sp_before <> b2.pgf_sp_before
            d := d | MIF_PF_SPBEFORE
        if a.pgf_sp_after <> b2.pgf_sp_after
            d := d | MIF_PF_SPAFTER
        if a.pgf_line_spacing.equals(b2.pgf_line_spacing) = false
            d := d | MIF_PF_LINESPACING
        if a.pgf_leading <> b2.pgf_leading
            d := d | MIF_PF_LEADING
        if a.pgf_num_tabs <> b2.pgf_num_tabs
            d := d | MIF_PF_NUMTABS
        if a.pgf_placement.equals(b2.pgf_placement) = false
            d := d | MIF_PF_PLACEMENT
        if a.pgf_placement_style.equals(b2.pgf_placement_style) = false
            d := d | MIF_PF_PLACEMENTSTYLE
        if a.pgf_with_prev <> b2.pgf_with_prev
            d := d | MIF_PF_WITHPREV
        if a.pgf_with_next <> b2.pgf_with_next
            d := d | MIF_PF_WITHNEXT
        if a.pgf_block_size <> b2.pgf_block_size
            d := d | MIF_PF_BLOCKSIZE
        if a.pgf_auto_num <> b2.pgf_auto_num
            d := d | MIF_PF_AUTONUM
        if a.pgf_num_format.equals(b2.pgf_num_format) = false
            d := d | MIF_PF_NUMFORMAT
        if a.pgf_number_font.equals(b2.pgf_number_font) = false
            d := d | MIF_PF_NUMBERFONT
        if a.pgf_hyphenate <> b2.pgf_hyphenate
            d := d | MIF_PF_HYPHENATE
        if a.hyphen_max_lines <> b2.hyphen_max_lines
            d := d | MIF_PF_HMAXLINES
        if a.hyphen_min_prefix <> b2.hyphen_min_prefix
            d := d | MIF_PF_HMINPREFIX
        if a.hyphen_min_suffix <> b2.hyphen_min_suffix
            d := d | MIF_PF_HMINSUFFIX
        if a.hyphen_min_word <> b2.hyphen_min_word
            d := d | MIF_PF_HMINWORD
        if a.pgf_letter_space <> b2.pgf_letter_space
            d := d | MIF_PF_LETTERSPACE
        if a.pgf_cell_alignment.equals(b2.pgf_cell_alignment) = false
            d := d | MIF_PF_CELLALIGN
        var margins_differ false
        if a.pgf_cm_l <> b2.pgf_cm_l
            margins_differ := true
        if a.pgf_cm_t <> b2.pgf_cm_t
            margins_differ := true
        if a.pgf_cm_r <> b2.pgf_cm_r
            margins_differ := true
        if a.pgf_cm_b <> b2.pgf_cm_b
            margins_differ := true
        if margins_differ
            d := d | MIF_PF_CELLMARGINS
        if a.pgf_cell_l_fixed <> b2.pgf_cell_l_fixed
            d := d | MIF_PF_CELLLFIXED
        if a.pgf_cell_t_fixed <> b2.pgf_cell_t_fixed
            d := d | MIF_PF_CELLTFIXED
        if a.pgf_cell_r_fixed <> b2.pgf_cell_r_fixed
            d := d | MIF_PF_CELLRFIXED
        if a.pgf_cell_b_fixed <> b2.pgf_cell_b_fixed
            d := d | MIF_PF_CELLBFIXED
        d
    }

    ; ParagraphFormat::setFrom
    procedure pf_set_from(mutable dst: ref[MifFormat], src: ref[MifFormat], props: int, fprops: int)
    {
        if (props & MIF_PF_TAG) <> 0
            dst.pgf_tag := src.pgf_tag
        if (props & MIF_PF_LANGUAGE) <> 0
            dst.pgf_language := src.pgf_language
        if (props & MIF_PF_FINDENT) <> 0
            dst.pgf_findent := src.pgf_findent
        if (props & MIF_PF_LINDENT) <> 0
            dst.pgf_lindent := src.pgf_lindent
        if (props & MIF_PF_RINDENT) <> 0
            dst.pgf_rindent := src.pgf_rindent
        if (props & MIF_PF_ALIGNMENT) <> 0
            dst.pgf_alignment := src.pgf_alignment
        if (props & MIF_PF_SPBEFORE) <> 0
            dst.pgf_sp_before := src.pgf_sp_before
        if (props & MIF_PF_SPAFTER) <> 0
            dst.pgf_sp_after := src.pgf_sp_after
        if (props & MIF_PF_LINESPACING) <> 0
            dst.pgf_line_spacing := src.pgf_line_spacing
        if (props & MIF_PF_LEADING) <> 0
            dst.pgf_leading := src.pgf_leading
        if (props & MIF_PF_NUMTABS) <> 0
            dst.pgf_num_tabs := src.pgf_num_tabs
        if (props & MIF_PF_PLACEMENT) <> 0
            dst.pgf_placement := src.pgf_placement
        if (props & MIF_PF_PLACEMENTSTYLE) <> 0
            dst.pgf_placement_style := src.pgf_placement_style
        if (props & MIF_PF_WITHPREV) <> 0
            dst.pgf_with_prev := src.pgf_with_prev
        if (props & MIF_PF_WITHNEXT) <> 0
            dst.pgf_with_next := src.pgf_with_next
        if (props & MIF_PF_BLOCKSIZE) <> 0
            dst.pgf_block_size := src.pgf_block_size
        if (props & MIF_PF_AUTONUM) <> 0
            dst.pgf_auto_num := src.pgf_auto_num
        if (props & MIF_PF_NUMFORMAT) <> 0
            dst.pgf_num_format := src.pgf_num_format
        if (props & MIF_PF_NUMBERFONT) <> 0
            dst.pgf_number_font := src.pgf_number_font
        if (props & MIF_PF_HYPHENATE) <> 0
            dst.pgf_hyphenate := src.pgf_hyphenate
        if (props & MIF_PF_HMAXLINES) <> 0
            dst.hyphen_max_lines := src.hyphen_max_lines
        if (props & MIF_PF_HMINPREFIX) <> 0
            dst.hyphen_min_prefix := src.hyphen_min_prefix
        if (props & MIF_PF_HMINSUFFIX) <> 0
            dst.hyphen_min_suffix := src.hyphen_min_suffix
        if (props & MIF_PF_HMINWORD) <> 0
            dst.hyphen_min_word := src.hyphen_min_word
        if (props & MIF_PF_LETTERSPACE) <> 0
            dst.pgf_letter_space := src.pgf_letter_space
        if (props & MIF_PF_CELLALIGN) <> 0
            dst.pgf_cell_alignment := src.pgf_cell_alignment
        if (props & MIF_PF_CELLMARGINS) <> 0
        {
            dst.pgf_cm_l := src.pgf_cm_l
            dst.pgf_cm_t := src.pgf_cm_t
            dst.pgf_cm_r := src.pgf_cm_r
            dst.pgf_cm_b := src.pgf_cm_b
        }
        if (props & MIF_PF_CELLLFIXED) <> 0
            dst.pgf_cell_l_fixed := src.pgf_cell_l_fixed
        if (props & MIF_PF_CELLTFIXED) <> 0
            dst.pgf_cell_t_fixed := src.pgf_cell_t_fixed
        if (props & MIF_PF_CELLRFIXED) <> 0
            dst.pgf_cell_r_fixed := src.pgf_cell_r_fixed
        if (props & MIF_PF_CELLBFIXED) <> 0
            dst.pgf_cell_b_fixed := src.pgf_cell_b_fixed
        MifFormat.ff_set_from(dst, src, fprops)
    }

    procedure pf_update_from(mutable dst: ref[MifFormat], src: ref[MifFormat])
    {
        MifFormat.ff_update_from(dst, src)
        let d MifFormat.pf_compare(dst, src)
        MifFormat.pf_set_from(dst, src, d, 0)
        dst.pf_set := d
    }

    procedure clear_set_props(mutable this: ref[MifFormat])
    {
        this.pf_set := 0
        this.ff_set := 0
    }

    ; FontFormat::out — `is_pgf_font` picks the statement name
    procedure ff_out(this: ref[MifFormat], mutable os: ref[MifOS], props: int, is_pgf_font: bool)
    {
        if props = 0
            return
        if is_pgf_font
            os.begin_stmt("PgfFont")
        else
            os.begin_stmt("Font")
        if (props & MIF_FF_FAMILY) <> 0
            os.p_tstr("FFamily", this.f_family)
        if (props & MIF_FF_ANGLE) <> 0
            os.p_tstr("FAngle", this.f_angle)
        if (props & MIF_FF_WEIGHT) <> 0
            os.p_tstr("FWeight", this.f_weight)
        if (props & MIF_FF_VAR) <> 0
            os.p_tstr("FVar", this.f_var)
        if (props & MIF_FF_SIZE) <> 0
            os.p_dim("FSize", this.f_size)
        if (props & MIF_FF_COLOR) <> 0
            os.p_tstr("FColor", this.f_color)
        if (props & MIF_FF_UNDERLINING) <> 0
            os.p_kw("FUnderlining", this.f_underlining)
        if (props & MIF_FF_OVERLINE) <> 0
            os.p_bool("FOverline", this.f_overline)
        if (props & MIF_FF_STRIKE) <> 0
            os.p_bool("FStrike", this.f_strike)
        if (props & MIF_FF_POSITION) <> 0
            os.p_kw("FPosition", this.f_position)
        if (props & MIF_FF_PAIRKERN) <> 0
            os.p_bool("FPairKern", this.f_pair_kern)
        if (props & MIF_FF_CASE) <> 0
            os.p_kw("FCase", this.f_case)
        if (props & MIF_FF_DX) <> 0
            os.p_pct("FDX", this.f_dx)
        if (props & MIF_FF_DY) <> 0
            os.p_pct("FDY", this.f_dy)
        if (props & MIF_FF_DW) <> 0
            os.p_pct("FDW", this.f_dw)
        os.end_stmt()
    }
}

; --- MifTagStream: TagStream / TextFlow / Cell / Para in one tagged record --
define MifTagStream
(
    ts_class: int
    content: ref[MifTmp]
    fmt: ref[MifFormat]
    var initial_pgf_tag: String
    var pgf_tag_used: bool
    ; TextFlow
    var tf_set: int
    var tf_tag: String
    var tf_auto_connect: bool
    var text_rect_id: int
    var text_rect_id_used: bool
    ; Para
    var para_set: int
    para_pgf_tag: String
    var leader_tabs_set: bool
    cur_fmt: ref[MifFormat]
    ; Cell
    var cell_set: int
    var cell_fill: int
    var cell_color: String
    var cell_l_ruling: String
    var cell_b_ruling: String
    var cell_r_ruling: String
    var cell_t_ruling: String
    var cell_columns: int
    var cell_rows: int
)
{
    function make(host: ref[Page], ts_class: int, ind: int, mc: ref[MifConsts]) returns ref[MifTagStream]
    {
        let t &MifTagStream^host(ts_class, MifTmp.make(host, ind), MifFormat.make(host), mc.s_default_pgf_format, false, 0, String(), false, 0, false, 0, String(), false, MifFormat.make(host), 0, 0, String(), String(), String(), String(), String(), 0, 0)
        t
    }

    ; Para(T_indent osIndent = 2): setProperties = fParagraphFormat
    procedure make_para(host: ref[Page], ind: int, mutable mc: ref[MifConsts]) returns ref[MifTagStream]
    {
        let t MifTagStream.make(host, MIF_TS_PARA, ind, mc)
        t.para_set := MIF_PARA_FORMAT
        t
    }

    function make_cell(host: ref[Page], mc: ref[MifConsts]) returns ref[MifTagStream]
        MifTagStream.make(host, MIF_TS_CELL, 12, mc)
}

; --- MifObject: PolyLine / ImportObject / Frame / TextRect ------------------
define MifObject
(
    tag: int
    var set_props: int
    id: int
    var pen: int
    var fill: int
    var pen_width: int
    var ob_color: String
    ; PolyLine
    var head_cap: String
    var tail_cap: String
    var points_x: ref[Array[int]]?
    var points_y: ref[Array[int]]?
    ; ImportObject
    var import_file: String
    var bitmap_dpi: int
    var fixed_size: bool
    native_x: int
    native_y: int
    ; Frame + ImportObject + TextRect share the shape rect
    var shape_l: int
    var shape_t: int
    var shape_w: int
    var shape_h: int
    var frame_type: String
    ns_offset: int
    var bl_offset: int
    var anchor_align: String
    var objects: ref[Array[ref[MifObject]?]]?
    ; TextRect
    var tr_num_columns: int
    var tr_column_gap: int
    var tr_column_balance: bool
)
{
    ; Object(pen=15, fill=15, penWidth=0, obColor=sBlack) — one global ID
    ; counter across every object of the run (the reference static IDCnt).
    function make(host: ref[Page], tag: int, id: int, mc: ref[MifConsts]) returns ref[MifObject]
    {
        let o &MifObject^host(tag, MIF_OB_ID | MIF_OB_PEN | MIF_OB_FILL | MIF_OB_PENWIDTH | MIF_OB_OBCOLOR, id, 15, 15, 0, mc.s_black, String(), String(), null, null, String(), 0, false, 0, 0, 0, 0, 0, 0, String(), 0, 0, String(), null, 0, 0, false)
        o
    }

    procedure out_object_properties(this: ref[MifObject], mutable os: ref[MifOS])
    {
        if (this.set_props & MIF_OB_ID) <> 0
            os.p_num("ID", this.id)
        if (this.set_props & MIF_OB_PEN) <> 0
            os.p_num("Pen", this.pen)
        if (this.set_props & MIF_OB_FILL) <> 0
            os.p_num("Fill", this.fill)
        if (this.set_props & MIF_OB_PENWIDTH) <> 0
            os.p_dim("PenWidth", this.pen_width)
        if (this.set_props & MIF_OB_OBCOLOR) <> 0
            os.p_tstr("ObColor", this.ob_color)
    }

    procedure out(this: ref[MifObject], mutable os: ref[MifOS])
    {
        let tag this.tag
        if tag = MIF_OBJ_POLYLINE
        {
            os.begin_stmt("PolyLine")
            this.out_object_properties(os)
            if (this.set_props & MIF_PL_HEADCAP) <> 0
                os.p_kw("HeadCap", this.head_cap)
            if (this.set_props & MIF_PL_TAILCAP) <> 0
                os.p_kw("TailCap", this.tail_cap)
            let n this.points_x.get_length()
            var i: size_t 0
            while i < n
            {
                let xp this.points_x.get(i)
                let yp this.points_y.get(i)
                os.p_two("Point", *xp, *yp)
                i := i + 1
            }
            os.end_stmt()
            return
        }
        if tag = MIF_OBJ_IMPORT
        {
            os.begin_stmt("ImportObject")
            this.out_object_properties(os)
            if (this.set_props & MIF_IM_FILEDI) <> 0
                os.p_tstr("ImportObFileDI", this.import_file)
            if (this.set_props & MIF_IM_DPI) <> 0
                os.p_num("BitMapDpi", this.bitmap_dpi)
            if (this.set_props & MIF_IM_SHAPERECT) <> 0
                os.p_ltrb("ShapeRect", this.shape_l, this.shape_t, this.shape_w, this.shape_h)
            if (this.set_props & MIF_IM_FIXEDSIZE) <> 0
                os.p_bool("ImportObFixedSize", this.fixed_size)
            if (this.set_props & MIF_IM_NATIVEORIGIN) <> 0
                os.p_two("NativeOrigin", this.native_x, this.native_y)
            os.end_stmt()
            return
        }
        if tag = MIF_OBJ_FRAME
        {
            os.begin_stmt("Frame")
            this.out_object_properties(os)
            if (this.set_props & MIF_FR_SHAPERECT) <> 0
                os.p_ltrb("ShapeRect", this.shape_l, this.shape_t, this.shape_w, this.shape_h)
            if (this.set_props & MIF_FR_TYPE) <> 0
                os.p_kw("FrameType", this.frame_type)
            if (this.set_props & MIF_FR_NSOFFSET) <> 0
                os.p_dim("NSOffset", this.ns_offset)
            if (this.set_props & MIF_FR_BLOFFSET) <> 0
                os.p_dim("BLOffset", this.bl_offset)
            if (this.set_props & MIF_FR_ANCHORALIGN) <> 0
                os.p_kw("AnchorAlign", this.anchor_align)
            let n this.objects.get_length()
            var i: size_t 0
            while i < n
            {
                let op this.objects.get(i)
                let o2 *op
                if o2 <> null
                    o2.out(os)
                i := i + 1
            }
            os.end_stmt()
            return
        }
        os.begin_stmt("TextRect")
        this.out_object_properties(os)
        if (this.set_props & MIF_TR_SHAPERECT) <> 0
            os.p_ltrb("ShapeRect", this.shape_l, this.shape_t, this.shape_w, this.shape_h)
        if (this.set_props & MIF_TR_NUMCOLUMNS) <> 0
            os.p_num("TRNumColumns", this.tr_num_columns)
        if (this.set_props & MIF_TR_COLUMNGAP) <> 0
            os.p_dim("TRColumnGap", this.tr_column_gap)
        if (this.set_props & MIF_TR_COLUMNBALANCE) <> 0
            os.p_bool("TRColumnBalance", this.tr_column_balance)
        os.end_stmt()
    }
}

; --- MifPage ---------------------------------------------------------------
define MifPage (set_props: int, page_type: String, page_tag: String, page_background: String, text_rects: ref[Array[ref[MifObject]?]])
{
    function make(host: ref[Page], page_type: String, page_tag: String, page_background: String, mc: ref[MifConsts]) returns ref[MifPage]
    {
        ; the reference ctor seeds fPageType | fPageTag unconditionally
        var sp MIF_PG_TYPE | MIF_PG_TAG
        if page_tag.equals(mc.s_none) = false
            sp := sp | MIF_PG_TAG
        if page_background.equals(mc.s_none) = false
            sp := sp | MIF_PG_BACKGROUND
        let p &MifPage^host(sp, page_type, page_tag, page_background, Array[ref[MifObject]?]^host())
        p
    }

    procedure out(this: ref[MifPage], mutable os: ref[MifOS])
    {
        os.begin_stmt("Page")
        if (this.set_props & MIF_PG_TYPE) <> 0
            os.p_kw("PageType", this.page_type)
        if (this.set_props & MIF_PG_TAG) <> 0
            os.p_tstr("PageTag", this.page_tag)
        if (this.set_props & MIF_PG_BACKGROUND) <> 0
            os.p_tstr("PageBackground", this.page_background)
        let n this.text_rects.get_length()
        var i: size_t 0
        while i < n
        {
            let tp this.text_rects.get(i)
            let t *tp
            if t <> null
                t.out(os)
            i := i + 1
        }
        os.end_stmt()
    }
}

; --- MifTblColumn / MifTblFormat / MifRow / MifTbl -------------------------
define MifTblColumn (set_props: int, num: int, width: int)
{
    function make(host: ref[Page], num: int, width: int) returns ref[MifTblColumn]
    {
        let c &MifTblColumn^host(MIF_TBLC_NUM | MIF_TBLC_WIDTH, num, width)
        c
    }

    ; NOTE: the reference prints a TblColumn as `<TblFormat …>` (a bug that
    ; is part of the byte stream).
    procedure out(this: ref[MifTblColumn], mutable os: ref[MifOS])
    {
        os.begin_stmt("TblFormat")
        if (this.set_props & MIF_TBLC_NUM) <> 0
            os.p_num("TblColumnNum", this.num)
        if (this.set_props & MIF_TBLC_WIDTH) <> 0
            os.p_dim("TblColumnWidth", this.width)
        os.end_stmt()
    }
}

define MifTblFormat
(
    var set_props: int
    var tbl_tag: String
    var lindent: int
    var rindent: int
    var sp_before: int
    var sp_after: int
    var alignment: String
    var cm_l: int
    var cm_t: int
    var cm_r: int
    var cm_b: int
    var title_placement: String
    width: int
    columns: ref[Array[ref[MifTblColumn]?]]?
)
{
    function make(host: ref[Page]) returns ref[MifTblFormat]
    {
        let f &MifTblFormat^host(0, String(), 0, 0, 0, 0, String(), 0, 0, 0, 0, String(), 0, Array[ref[MifTblColumn]?]^host())
        f
    }

    procedure set_dsssl_defaults(mutable this: ref[MifTblFormat], mc: ref[MifConsts])
    {
        this.lindent := 0
        this.rindent := 0
        this.sp_before := 0
        this.sp_after := 0
        this.alignment := mc.s_left
        this.cm_l := 0
        this.cm_t := 0
        this.cm_r := 0
        this.cm_b := 0
        this.title_placement := mc.s_none_kw
        this.set_props := this.set_props | MIF_TBLF_LINDENT | MIF_TBLF_RINDENT | MIF_TBLF_SPBEFORE | MIF_TBLF_SPAFTER | MIF_TBLF_ALIGNMENT | MIF_TBLF_CELLMARGINS | MIF_TBLF_TITLEPLACEMENT
    }

    procedure out(this: ref[MifTblFormat], mutable os: ref[MifOS])
    {
        os.begin_stmt("TblFormat")
        if (this.set_props & MIF_TBLF_TAG) <> 0
            os.p_tstr("TblTag", this.tbl_tag)
        if (this.set_props & MIF_TBLF_LINDENT) <> 0
            os.p_dim("TblLIndent", this.lindent)
        if (this.set_props & MIF_TBLF_RINDENT) <> 0
            os.p_dim("TblRIndent", this.rindent)
        if (this.set_props & MIF_TBLF_SPBEFORE) <> 0
            os.p_dim("TblSpBefore", this.sp_before)
        if (this.set_props & MIF_TBLF_SPAFTER) <> 0
            os.p_dim("TblSpAfter", this.sp_after)
        if (this.set_props & MIF_TBLF_ALIGNMENT) <> 0
            os.p_kw("TblAlignment", this.alignment)
        if (this.set_props & MIF_TBLF_CELLMARGINS) <> 0
            os.p_ltrb("TblCellMargins", this.cm_l, this.cm_t, this.cm_r, this.cm_b)
        if (this.set_props & MIF_TBLF_TITLEPLACEMENT) <> 0
            os.p_kw("TblTitlePlacement", this.title_placement)
        if (this.set_props & MIF_TBLF_WIDTH) <> 0
            os.p_dim("TblWidth", this.width)
        let n this.columns.get_length()
        var i: size_t 0
        while i < n
        {
            let cp this.columns.get(i)
            let c *cp
            if c <> null
                c.out(os)
            i := i + 1
        }
        os.end_stmt()
    }
}

