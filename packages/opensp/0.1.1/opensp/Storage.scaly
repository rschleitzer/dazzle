use scaly.memory.Page
use scaly.os.File
use scaly.os.Path
use scaly.memory.runtime.fopen
use scaly.memory.runtime.fclose
use scaly.memory.root_pages.getenv

; strerror(3): fixed-prototype libc call, direct extern (i32 per the extern
; 32-bit-param ABI rule). Returns a pointer to a static, thread-local buffer —
; consume before the next libc call on this thread.
function strerror(code: i32) returns pointer[const_char] extern
; scaly_eio_errno (scaly/fiber/eio.c): the errno accessor — errno itself is a
; thread-local macro a direct extern cannot read (shim rule c).
function scaly_eio_errno() returns i32 extern

; ---- the file names of the system the program runs on --------------------
; The reference decides it when it is compiled: SP_POSIX_FILENAMES or
; SP_MSDOS_FILENAMES (PosixStorage.cxx: isAbsolute, extractDir, combineDir),
; and PATH_SEPARATOR `:` or `;` for a list of them. One source serves every
; target here, so the convention is asked at run time, and the port takes the
; MS-DOS one in at the BOUNDARY: a name out of the command line or the
; environment has its backslashes turned into slashes there (the system takes
; either), and everything behind -- extractDir, combineDir, the catalog's
; base -- goes on splitting at `/` alone, as it does on POSIX. What that
; leaves out: a backslash in a system identifier INSIDE a document or a
; catalog is not a separator.

; MS-DOS file names? $SP_FILENAMES says it (`msdos` or `posix`); without, the
; system does: every Windows process has OS=Windows_NT in its environment.
procedure sp_msdos_filenames() returns bool
{
    let own getenv("SP_FILENAMES")
    if own <> null
    {
        if strcmp(own, "msdos") = 0
            return true
        if strcmp(own, "posix") = 0
            return false
    }
    let os getenv("OS")
    if os = null
        return false
    strcmp(os, "Windows_NT") = 0
}

; The line terminator of the system: the reference's SP_LINE_TERM1/2
; (OutputCharStream.h `newline`, RecordOutputCharStream), CR LF where it is
; built with MS-DOS file names and LF elsewhere -- compiled in there, asked
; here like the file names. $SP_LINE_TERM says it (`crlf` or `lf`); without,
; it follows sp_msdos_filenames#.
procedure sp_crlf_lines() returns bool
{
    let own getenv("SP_LINE_TERM")
    if own <> null
    {
        if strcmp(own, "crlf") = 0
            return true
        if strcmp(own, "lf") = 0
            return false
    }
    sp_msdos_filenames()
}

; the separator of a list of file names in an environment variable
function sp_path_separator(msdos: bool) returns u32
{
    if msdos
        return 0x3B
    0x3A
}

; A file name as the program was given it, `n` bytes at `p`, on `hp`: with
; MS-DOS file names its backslashes are slashes.
procedure sp_file_name(hp: ref[Page], p: pointer[const_char], n: size_t, msdos: bool) returns ref[String]
{
    let buf hp.allocate(n + 1, 1) as pointer[u8]
    let src p as pointer[u8]
    var i: size_t 0
    while i < n
    {
        var c *(src + i)
        if msdos and c = 0x5C
            c := 0x2F
        *(buf + i) := c
        i := i + 1
    }
    *(buf + n) := 0
    let s String^hp(buf as pointer[const_char], n)
    return &s
}

; the same for a name that lies in memory the program may write -- a cell of
; its argument vector: in place
procedure sp_slashes(mutable p: pointer[char], msdos: bool)
{
    if p = null or msdos = false
        return
    let b p as pointer[u8]
    var i: size_t 0
    while *(b + i) <> 0
    {
        if *(b + i) = 0x5C
            *(b + i) := 0x2F
        i := i + 1
    }
}

; PosixStorageManager::isAbsolute, both conventions at once: a leading slash,
; or a drive -- a letter, a colon, a slash (`C:/work`; the backslash went at
; the boundary). The drive form is taken on every system: a relative name
; that begins so would need a directory called `C:`.
function sp_is_absolute(name: String) returns bool
{
    let n name.get_length()
    if n = 0
        return false
    if name.get(0) = 0x2F
        return true
    if n < 3
        return false
    let d name.get(0)
    let letter (d >= 0x41 and d <= 0x5A) or (d >= 0x61 and d <= 0x7A)
    letter and name.get(1) = 0x3A and name.get(2) = 0x2F
}

; Storage — the byte-source abstraction (StorageManager + StorageObject,
; StorageManager.cs / LiteralStorage.cs / PosixStorage.cs).
;
; The C++ abstract factory + reader hierarchy ports to a union over the storage
; kinds we need: Literal (in-memory bytes, no I/O) and OsFile (reads a file from
; disk through scaly.os.File). Bytes are Scaly byte `String`s here; the
; byte->Char decode happens one layer up in EntityManager via a CodingSystem.
;
; Deferred (StorageManager map): rewind/block-size/search-dir machinery, the Fd/
; URL/WinInet/Stdio managers, and ParsedSystemId's <osfile ...> bracket syntax.
; OsFile's payload is the base directory a relative spec id resolves against.

define Storage union
(
    Literal: String
    OsFile: String
)
{
    ; Read the bytes named by spec_id. For Literal, spec_id is ignored and the
    ; in-memory content is returned; for OsFile, spec_id is resolved relative to
    ; the base directory and read from disk. An empty String signals failure /
    ; not found (callers check exists() first when that matters).
    procedure read(mutable this: Storage, mutable spec_id: String) returns String
    {
        choose this
            when bytes: Literal
                return bytes
            when base: OsFile
            {
                let full resolve(base, spec_id)
                if File.exists(full) = false
                    return String()

                return File.read_to_string(full)
            }
        String()
    }

    ; PosixStorageManager::makeStorageObject's failure report, factored: try to
    ; open spec_id; on failure return the strerror text real onsgmls substitutes
    ; as %2 of openSystemCall ("cannot open %1 (%2)"); null when the file opens
    ; (or for Literal storage, which cannot fail). The returned pointer aliases
    ; strerror's static buffer — consume it before the next libc call.
    procedure open_error(this: Storage, spec_id: String) returns pointer[const_char]
    {
        choose this
            when bytes: Literal
                return null
            when base: OsFile
            {
                let full resolve(base, spec_id)
                let file fopen(full.to_c_string(), "rb")
                if file = null
                    return strerror(scaly_eio_errno())
                let closed fclose(file)
                return null
            }
        null
    }

    procedure has_spec(mutable this: Storage, mutable spec_id: String) returns bool
    {
        choose this
            when bytes: Literal
                return true
            when base: OsFile
                return File.exists(resolve(base, spec_id))
        false
    }

    ; resolveRelative: join the base directory with a (relative) spec id.
    function resolve(this: Storage, base: String, spec_id: String) returns String
    {
        if base.get_length() = 0
            return spec_id

        Path.join(base, spec_id)
    }

    function type_name(this: Storage) returns pointer[const_char]
    {
        choose this
            when b: Literal
                return "LITERAL"
            when f: OsFile
                return "OSFILE"
        "UNKNOWN"
    }

    procedure test() returns int
    {
        ; Literal storage serves its bytes regardless of the spec id.
        let lit Storage.Literal("hello world")
        let got lit.read("ignored")
        if (got = "hello world") = false
            return -1

        let lit_exists lit.has_spec("anything")
        if lit_exists = false
            return -2

        0
    }
}
