use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.Location.Location
use opensp.Entity.Entity
use opensp.Entity.InternalEntity

; ShortReferenceMap — ShortReferenceMap.cs (105 LOC). A named SHORTREF map: for
; each shortref delimiter index it records the general-entity NAME to reference
; (nameMap_) and, once the DTD resolves them, the borrowed Entity itself
; (entityMap_). Reached only via shortref delimiters against a DTD.
;
; PORT SHAPE: page-hosted flat struct (referenced by identity from the DTD's
; shortref-map table and from an element type's `map`). The C++ Vector<StringC>
; / Vector<ConstPtr<Entity>> become Array pointers (null = unset); entities are
; borrowed pointers in the one-region-per-run arena. `defined()` mirrors the C++
; `nameMap_.size() > 0` test: a set (even empty) name map counts as defined
; (C++ resizes an empty map to 1).

define ShortReferenceMap
(
    name: StringC
    var name_map: ref[Array[StringC]]?
    var entity_map: ref[Array[ref[Entity]?]]?
    var used: bool
    var def_location: Location
)
{
    function make(host: ref[Page], name: StringC) returns ref[ShortReferenceMap]
    {
        let m &ShortReferenceMap^host(name, null, null, false, Location())
        m
    }

    function get_name(this: ShortReferenceMap) returns StringC
        name

    ; Boolean defined() const { return nameMap_.size() > 0; }
    function defined(this: ShortReferenceMap) returns bool
        name_map <> null

    ; void setNameMap(Vector<StringC> &map).
    procedure set_name_map(mutable this: ref[ShortReferenceMap], map: ref[Array[StringC]])
        this.name_map := map

    ; void setEntityMap(Vector<ConstPtr<Entity> > &map).
    procedure set_entity_map(mutable this: ref[ShortReferenceMap], map: ref[Array[ref[Entity]?]])
        this.entity_map := map

    ; Boolean lookup(int i, const StringC *&) — presence of a non-empty name.
    function has_entity_name(this: ShortReferenceMap, i: size_t) returns bool
    {
        if name_map = null
            return false
        if i >= name_map.get_length()
            return false
        (name_map[i]).get_size() <> 0
    }

    ; const StringC *entityName(size_t i) — the name at i, or empty if none.
    function entity_name(this: ShortReferenceMap, i: size_t) returns StringC
    {
        if this.has_entity_name(i) = false
            return StringC()
        name_map[i]
    }

    ; const ConstPtr<Entity> &entity(size_t i) — the resolved entity, or null.
    function entity(this: ShortReferenceMap, i: size_t) returns ref[Entity]?
    {
        if entity_map = null
            return null
        if i >= entity_map.get_length()
            return null
        entity_map[i]
    }

    function is_used(this: ShortReferenceMap) returns bool
        used

    procedure set_used(mutable this: ref[ShortReferenceMap])
        this.used := true

    function get_def_location(this: ShortReferenceMap) returns Location
        def_location

    procedure set_def_location(mutable this: ref[ShortReferenceMap], loc: Location)
        this.def_location := loc

    function test() returns int
    {
        let anchor StringC("x")
        let host Page.get(anchor.data_ptr())

        let m ShortReferenceMap.make(host, StringC("map"))
        if m.get_name().equals(StringC("map")) = false
            return -1
        if m.defined()
            return -2
        if m.is_used()
            return -3

        ; a name map: index 0 empty (no shortref), index 1 -> "amp".
        var nm Array[StringC]^host()
        nm.add(StringC())
        nm.add(StringC("amp"))
        m.set_name_map(nm)
        if m.defined() = false
            return -4
        if m.has_entity_name(0)
            return -5
        if m.has_entity_name(1) = false
            return -6
        if m.entity_name(1).equals(StringC("amp")) = false
            return -7
        ; out of range -> no name.
        if m.has_entity_name(2)
            return -8

        ; an entity map resolving index 1 by identity.
        let ent_v Entity.Internal^host(InternalEntity(StringC("amp"), StringC("&"), DT_SGML))
        let ent &ent_v
        var em Array[ref[Entity]?]^host()
        em.add(null)
        em.add(ent)
        m.set_entity_map(em)
        if m.entity(1) <> ent
            return -9
        if m.entity(0) <> null
            return -10

        ; used + def-location bookkeeping.
        m.set_used()
        if m.is_used() = false
            return -11
        m.set_def_location(Location(null, 5))
        if m.get_def_location().get_index() <> 5
            return -12

        0
    }
}
