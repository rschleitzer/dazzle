use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.Location.Location
use opensp.Dtd.Dtd
use opensp.ElementType.ElementType
use opensp.AttributeList.AttributeList
use opensp.AttributeList.AttributeDefinitionList

; Lpd — link process definitions (Lpd.h / Lpd.cxx). The LINK feature axis'
; data layer: one Lpd per LINKTYPE declaration (simple / implicit / explicit),
; complex LPDs carry LINK/IDLINK link sets whose rules attach link attribute
; lists (and, for explicit links, result element specs) to source elements.
;
; PORT SHAPE (the Event/CmNode convention): C++'s Lpd/SimpleLpd/ComplexLpd
; inheritance triangle collapses into ONE flat tagged struct keyed by `kind`
; (LPD_SIMPLE carries the Attributed half, IMPLICIT/EXPLICIT the complex half).
; SourceLinkRule and IdLinkRule likewise collapse (an IdLinkRule is a
; SourceLinkRule with a non-null assoc_element_types vector); ResultElementSpec
; is folded into the rule as (result_type, result_attributes). SourceLinkRule's
; uselink/postlink name a LinkSet declared AFTER it in this module — a forward
; reference the compiler resolves, as it does the cross-MODULE ones that
; ExternalDataEntity.notation and Origin.entity_decl carry.
;
; NamedTable<LinkSet> / NamedTable<IdLinkRuleGroup> are OpenSP open-addressing
; hash tables; parseLinktypeDeclEnd SWEEPS the link-set table for undefined
; link sets, so the ITERATION ORDER (ascending bucket index) is message-order
; load-bearing — LinkSetTable mirrors the IdTable port exactly (initial size 8,
; usedLimit half, grow x2 reinserting in old bucket order, probe DOWNWARD).

define LPD_SIMPLE: int 0
define LPD_IMPLICIT: int 1
define LPD_EXPLICIT: int 2

; SourceLinkRule (+ IdLinkRule when assoc_element_types is non-null).
; uselink/postlink name a LinkSet declared further down this file.
define SourceLinkRule
(
    var uselink: ref[LinkSet]?
    var postlink: ref[LinkSet]?
    var postlink_restore: bool
    var link_attributes: ref[AttributeList]?
    ; ResultElementSpec (explicit links): the result element (null = none
    ; looked up / no result dtd) and its attributes. has_result distinguishes
    ; an omitted (#IMPLIED) result from a present one.
    var has_result: bool
    var result_type: ref[ElementType]?
    var result_attributes: ref[AttributeList]?
    ; IdLinkRule: the associated source element types.
    var assoc_element_types: ref[Array[ref[ElementType]?]]?
)
{
    function make(host: ref[Page]) returns ref[SourceLinkRule]
    {
        let r &SourceLinkRule^host(null, null, false, null, false, null, null, null)
        r
    }

    procedure set_uselink(mutable this: ref[SourceLinkRule], ls: ref[LinkSet]?)
        this.uselink := ls

    function get_uselink(this: SourceLinkRule) returns ref[LinkSet]?
        uselink

    procedure set_postlink(mutable this: ref[SourceLinkRule], ls: ref[LinkSet]?)
        this.postlink := ls

    function get_postlink(this: SourceLinkRule) returns ref[LinkSet]?
        postlink

    procedure set_postlink_restore(mutable this: ref[SourceLinkRule])
        this.postlink_restore := true

    function get_postlink_restore(this: SourceLinkRule) returns bool
        postlink_restore

    procedure set_link_attributes(mutable this: ref[SourceLinkRule], atts: ref[AttributeList]?)
        this.link_attributes := atts

    function attributes(this: SourceLinkRule) returns ref[AttributeList]?
        link_attributes

    procedure set_result(mutable this: ref[SourceLinkRule], e: ref[ElementType]?, atts: ref[AttributeList]?)
    {
        this.has_result := true
        this.result_type := e
        this.result_attributes := atts
    }

    function get_result_type(this: SourceLinkRule) returns ref[ElementType]?
        result_type

    function get_result_attributes(this: SourceLinkRule) returns ref[AttributeList]?
        result_attributes

    procedure set_assoc_element_types(mutable this: ref[SourceLinkRule], v: ref[Array[ref[ElementType]?]])
        this.assoc_element_types := v

    ; IdLinkRule::isAssociatedWith.
    function is_associated_with(this: SourceLinkRule, e: ref[ElementType]?) returns bool
    {
        if assoc_element_types = null
            return false
        let n assoc_element_types.get_length()
        var i: size_t 0
        while i < n
        {
            if assoc_element_types[i] = e
                return true
            i := i + 1
        }
        false
    }
}

; LinkSet (Lpd.h:99): link rules indexed by the SOURCE element's type index,
; plus the implied source link rules (result specs of `#IMPLIED source` rules).
; The reference sizes linkRules_ to the source DTD's nElementTypeIndex at
; construction and indexes UNCHECKED thereafter — but link rules may
; lookupCreateElement NEW elements, so the port grows the vector on demand
; (behaviorally identical for every input the reference handles defined).
define LinkSet
(
    name: StringC
    var defined: bool
    ; per source-element type index: the rules for that element.
    link_rules: ref[Array[ref[Array[ref[SourceLinkRule]?]]?]]
    ; ResultElementSpecs of implied-source rules, stored as rules (result half).
    implied_rules: ref[Array[ref[SourceLinkRule]?]]
)
{
    ; deep-copies the name onto host (parm tokens are transient).
    function make(host: ref[Page], name: StringC, dtd: ref[Dtd]?) returns ref[LinkSet]
    {
        let link_rules Array[ref[Array[ref[SourceLinkRule]?]]?]^host()
        var n: size_t 0
        if dtd <> null
            n := dtd.n_element_type_index()
        var i: size_t 0
        while i < n
        {
            link_rules.add(null)
            i := i + 1
        }
        let ls &LinkSet^host(StringC^host(name.as_slice()), false, link_rules, Array[ref[SourceLinkRule]?]^host())
        ls
    }

    function get_name(this: LinkSet) returns StringC
        name

    function is_defined(this: LinkSet) returns bool
        defined

    procedure set_defined(mutable this: ref[LinkSet])
        this.defined := true

    procedure add_link_rule(mutable this: ref[LinkSet], host: ref[Page], e: ref[ElementType], rule: ref[SourceLinkRule])
    {
        let idx e.get_index()
        while this.link_rules.get_length() <= idx
            this.link_rules.add(null)
        var slot this.link_rules[idx]
        if slot = null
        {
            slot := Array[ref[SourceLinkRule]?]^host()
            this.link_rules.put(idx, slot)
        }
        slot.add(rule)
    }

    function n_link_rules(this: LinkSet, e: ref[ElementType]) returns size_t
    {
        let idx e.get_index()
        if idx >= link_rules.get_length()
            return 0 as size_t
        let slot link_rules[idx]
        if slot = null
            return 0 as size_t
        slot.get_length()
    }

    function link_rule(this: LinkSet, e: ref[ElementType], i: size_t) returns ref[SourceLinkRule]
    {
        let slot link_rules[e.get_index()]
        slot[i] as ref[SourceLinkRule]
    }

    ; LinkSet::addImplied — record the result spec of an `#IMPLIED source` rule.
    procedure add_implied(mutable this: ref[LinkSet], host: ref[Page], e: ref[ElementType], atts: ref[AttributeList]?)
    {
        let r SourceLinkRule.make(host)
        r.set_result(e, atts)
        this.implied_rules.add(r)
    }

    function n_implied_link_rules(this: LinkSet) returns size_t
        implied_rules.get_length()

    function implied_link_rule(this: LinkSet, i: size_t) returns ref[SourceLinkRule]?
        implied_rules[i]

    ; LinkSet::impliedResultAttributes — whether a result spec for this result
    ; element type already exists (duplicateImpliedResult's test).
    function has_implied_result(this: LinkSet, result_type: ref[ElementType]) returns bool
    {
        let n implied_rules.get_length()
        var i: size_t 0
        while i < n
        {
            let r implied_rules[i]
            if r.get_result_type() = result_type
                return true
            i := i + 1
        }
        false
    }
}

; NamedTable<LinkSet> — the OpenSP OwnerTable/Hash open-addressing port (the
; IdTable pattern): iteration order = ascending bucket index, load-bearing for
; parseLinktypeDeclEnd's undefined-link-set sweep.
define LinkSetTable
(
    var vec: Slice[ref[LinkSet]?]
    var vec_size: size_t
    var used: size_t
    var used_limit: size_t
)
{
    function make(host: ref[Page]) returns ref[LinkSetTable]
    {
        let t &LinkSetTable^host(Slice[ref[LinkSet]?](), 0, 0, 0)
        t
    }

    ; Hash::hash — h*33 + char.
    function hash(name: StringC) returns u64
    {
        var h: u64 0
        let n name.get_size()
        var i: size_t 0
        while i < n
        {
            h := (h << 5) + h + (name.get(i) as u64)
            i := i + 1
        }
        h
    }

    function start_index(this: LinkSetTable, name: StringC) returns size_t
        (LinkSetTable.hash(name) & ((vec_size - 1) as u64)) as size_t

    function next_index(this: LinkSetTable, i: size_t) returns size_t
    {
        if i = 0
            return vec_size - 1
        i - 1
    }

    function alloc_vec(host: ref[Page], n: size_t) returns Slice[ref[LinkSet]?]
    {
        let v allocate_slice[ref[LinkSet]?](host, n)
        var i: size_t 0
        while i < n
        {
            v.put(i, null)
            i := i + 1
        }
        v
    }

    function lookup(this: LinkSetTable, name: StringC) returns ref[LinkSet]?
    {
        if used = 0
            return null
        var i this.start_index(name)
        while vec[i] <> null
        {
            let ls vec[i]
            let lsname ls.get_name()
            if lsname.equals(name)
                return ls
            i := this.next_index(i)
        }
        null
    }

    procedure insert(mutable this: ref[LinkSetTable], host: ref[Page], ls: ref[LinkSet])
    {
        var h: size_t 0
        if this.vec_size = 0
        {
            this.vec := LinkSetTable.alloc_vec(host, 8)
            this.vec_size := 8
            this.used_limit := 4
            h := this.start_index(ls.get_name())
        }
        else
        {
            h := this.start_index(ls.get_name())
            while this.vec[h] <> null
                h := this.next_index(h)
            if this.used >= this.used_limit
            {
                let old_vec this.vec
                let old_size this.vec_size
                this.vec := LinkSetTable.alloc_vec(host, old_size * 2)
                this.vec_size := old_size * 2
                this.used_limit := this.vec_size / 2
                var oi: size_t 0
                while oi < old_size
                {
                    let e old_vec[oi]
                    if e <> null
                    {
                        var j this.start_index(e.get_name())
                        while this.vec[j] <> null
                            j := this.next_index(j)
                        this.vec.put(j, e)
                    }
                    oi := oi + 1
                }
                h := this.start_index(ls.get_name())
                while this.vec[h] <> null
                    h := this.next_index(h)
            }
        }
        this.used := this.used + 1
        this.vec.put(h, ls)
    }

    ; the sweep surface (ConstNamedTableIter): ascending bucket index, callers
    ; skip nulls.
    function bucket_count(this: LinkSetTable) returns size_t
        vec_size

    function bucket_at(this: LinkSetTable, i: size_t) returns ref[LinkSet]?
        vec[i]
}

; IdLinkRuleGroup (Lpd.h:137) — the ID link rules sharing one unique id.
define IdLinkRuleGroup
(
    name: StringC
    rules: ref[Array[ref[SourceLinkRule]?]]
)
{
    function make(host: ref[Page], name: StringC) returns ref[IdLinkRuleGroup]
    {
        let g &IdLinkRuleGroup^host(StringC^host(name.as_slice()), Array[ref[SourceLinkRule]?]^host())
        g
    }

    function get_name(this: IdLinkRuleGroup) returns StringC
        name

    function n_link_rules(this: IdLinkRuleGroup) returns size_t
        rules.get_length()

    function link_rule(this: IdLinkRuleGroup, i: size_t) returns ref[SourceLinkRule]?
        rules[i]

    procedure add_link_rule(mutable this: ref[IdLinkRuleGroup], rule: ref[SourceLinkRule])
        this.rules.add(rule)
}

; NamedTable<IdLinkRuleGroup> — same table shape (lookup only, never swept).
define IdLinkTable
(
    var vec: Slice[ref[IdLinkRuleGroup]?]
    var vec_size: size_t
    var used: size_t
    var used_limit: size_t
)
{
    function make(host: ref[Page]) returns ref[IdLinkTable]
    {
        let t &IdLinkTable^host(Slice[ref[IdLinkRuleGroup]?](), 0, 0, 0)
        t
    }

    function start_index(this: IdLinkTable, name: StringC) returns size_t
        (LinkSetTable.hash(name) & ((vec_size - 1) as u64)) as size_t

    function next_index(this: IdLinkTable, i: size_t) returns size_t
    {
        if i = 0
            return vec_size - 1
        i - 1
    }

    function alloc_vec(host: ref[Page], n: size_t) returns Slice[ref[IdLinkRuleGroup]?]
    {
        let v allocate_slice[ref[IdLinkRuleGroup]?](host, n)
        var i: size_t 0
        while i < n
        {
            v.put(i, null)
            i := i + 1
        }
        v
    }

    function lookup(this: IdLinkTable, name: StringC) returns ref[IdLinkRuleGroup]?
    {
        if used = 0
            return null
        var i this.start_index(name)
        while vec[i] <> null
        {
            let g vec[i]
            let gname g.get_name()
            if gname.equals(name)
                return g
            i := this.next_index(i)
        }
        null
    }

    procedure insert(mutable this: ref[IdLinkTable], host: ref[Page], g: ref[IdLinkRuleGroup])
    {
        var h: size_t 0
        if this.vec_size = 0
        {
            this.vec := IdLinkTable.alloc_vec(host, 8)
            this.vec_size := 8
            this.used_limit := 4
            h := this.start_index(g.get_name())
        }
        else
        {
            h := this.start_index(g.get_name())
            while this.vec[h] <> null
                h := this.next_index(h)
            if this.used >= this.used_limit
            {
                let old_vec this.vec
                let old_size this.vec_size
                this.vec := IdLinkTable.alloc_vec(host, old_size * 2)
                this.vec_size := old_size * 2
                this.used_limit := this.vec_size / 2
                var oi: size_t 0
                while oi < old_size
                {
                    let e old_vec[oi]
                    if e <> null
                    {
                        var j this.start_index(e.get_name())
                        while this.vec[j] <> null
                            j := this.next_index(j)
                        this.vec.put(j, e)
                    }
                    oi := oi + 1
                }
                h := this.start_index(g.get_name())
                while this.vec[h] <> null
                    h := this.next_index(h)
            }
        }
        this.used := this.used + 1
        this.vec.put(h, g)
    }
}

; Lpd — the flat tagged struct (see the header note). SIMPLE uses
; attribute_def; IMPLICIT/EXPLICIT use the complex half.
define Lpd
(
    var kind: int
    var name: StringC
    var location: Location
    var active: bool
    var source_dtd: ref[Dtd]?
    ; SimpleLpd (Attributed):
    var attribute_def: ref[AttributeDefinitionList]?
    ; ComplexLpd:
    var result_dtd: ref[Dtd]?
    ; per source-element type index: the link attribute definitions
    ; (ComplexLpd::linkAttributeDefs_), grown on demand like LinkSet's rules.
    var link_attribute_defs: ref[Array[ref[AttributeDefinitionList]?]]?
    var link_sets: ref[LinkSetTable]?
    var initial_link_set: ref[LinkSet]?
    var empty_link_set: ref[LinkSet]?
    var had_id_link_set: bool
    var id_links: ref[IdLinkTable]?
    var n_attribute_definition_list: size_t
)
{
    ; SimpleLpd ctor. Deep-copies the name (a swapped parm token).
    function make_simple(host: ref[Page], name: StringC, loc: Location, source_dtd: ref[Dtd]?) returns ref[Lpd]
    {
        let l &Lpd^host(LPD_SIMPLE, StringC^host(name.as_slice()), loc, false, source_dtd, null, null, null, null, null, null, false, null, 0)
        l
    }

    ; ComplexLpd ctor. initial_name/empty_name are the syntax's RNI-prefixed
    ; INITIAL/EMPTY reserved names (the caller renders them — Lpd cannot see
    ; Syntax, declared later? no: Syntax precedes; passed to keep the ctor
    ; signature flat like the reference's syntax handle).
    function make_complex(host: ref[Page], name: StringC, kind: int, loc: Location, initial_name: StringC, empty_name: StringC, source_dtd: ref[Dtd]?, result_dtd: ref[Dtd]?) returns ref[Lpd]
    {
        let l host.allocate(sizeof Lpd, alignof Lpd) as pointer[Lpd]
        l.kind := kind
        l.name := StringC^host(name.as_slice())
        l.location := loc
        l.active := false
        l.source_dtd := source_dtd as ref[Dtd]
        l.attribute_def := null
        l.result_dtd := result_dtd
        l.link_attribute_defs := Array[ref[AttributeDefinitionList]?]^host()
        var n: size_t 0
        if source_dtd <> null
            n := source_dtd.n_element_type_index()
        var i: size_t 0
        while i < n
        {
            l.link_attribute_defs.add(null)
            i := i + 1
        }
        l.link_sets := LinkSetTable.make(host)
        l.initial_link_set := LinkSet.make(host, initial_name, source_dtd)
        l.empty_link_set := LinkSet.make(host, empty_name, source_dtd)
        l.had_id_link_set := false
        l.id_links := IdLinkTable.make(host)
        l.n_attribute_definition_list := 0
        l
    }

    function get_kind(this: Lpd) returns int
        kind

    function get_name(this: Lpd) returns StringC
        name

    function get_location(this: Lpd) returns Location
        location

    function is_active(this: Lpd) returns bool
        active

    procedure activate(mutable this: ref[Lpd])
        this.active := true

    function get_source_dtd(this: Lpd) returns ref[Dtd]?
        source_dtd

    function get_result_dtd(this: Lpd) returns ref[Dtd]?
        result_dtd

    ; ---- SimpleLpd (Attributed) ----
    function get_attribute_def(this: Lpd) returns ref[AttributeDefinitionList]?
        attribute_def

    procedure set_attribute_def(mutable this: ref[Lpd], adl: ref[AttributeDefinitionList]?)
        this.attribute_def := adl

    ; ---- ComplexLpd ----
    procedure alloc_attribute_definition_list_index(mutable this: ref[Lpd]) returns size_t
    {
        let i this.n_attribute_definition_list
        this.n_attribute_definition_list := i + 1
        i
    }

    function initial_link_set_of(this: Lpd) returns ref[LinkSet]?
        initial_link_set

    function empty_link_set_of(this: Lpd) returns ref[LinkSet]?
        empty_link_set

    function lookup_link_set(this: Lpd, name: StringC) returns ref[LinkSet]?
        link_sets.lookup(name)

    procedure insert_link_set(mutable this: ref[Lpd], host: ref[Page], ls: ref[LinkSet])
        this.link_sets.insert(host, ls)

    function get_link_sets(this: Lpd) returns ref[LinkSetTable]?
        link_sets

    function had_id_link_set_of(this: Lpd) returns bool
        had_id_link_set

    procedure set_had_id_link_set(mutable this: ref[Lpd])
        this.had_id_link_set := true

    function lookup_id_link(this: Lpd, id: StringC) returns ref[IdLinkRuleGroup]?
        id_links.lookup(id)

    ; ComplexLpd::lookupCreateIdLink.
    procedure lookup_create_id_link(mutable this: ref[Lpd], host: ref[Page], id: StringC) returns ref[IdLinkRuleGroup]
    {
        let found this.lookup_id_link(id)
        if found <> null
            return found as ref[IdLinkRuleGroup]
        let g IdLinkRuleGroup.make(host, id)
        this.id_links.insert(host, g)
        g
    }

    ; ComplexLpd::attributeDef(e) — null when unset (or index out of range).
    function link_attribute_def(this: Lpd, e: ref[ElementType]) returns ref[AttributeDefinitionList]?
    {
        let idx e.get_index()
        if idx >= link_attribute_defs.get_length()
            return null
        link_attribute_defs[idx]
    }

    procedure set_link_attribute_def(mutable this: ref[Lpd], e: ref[ElementType], adl: ref[AttributeDefinitionList])
    {
        let idx e.get_index()
        while this.link_attribute_defs.get_length() <= idx
            this.link_attribute_defs.add(null)
        this.link_attribute_defs.put(idx, adl)
    }
}
