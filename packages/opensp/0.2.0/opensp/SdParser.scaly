use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use opensp.Sd.Sd
use opensp.Syntax.Syntax
use opensp.StringC.StringC
use opensp.CharsetDecl.CharsetDecl
use opensp.CharsetDecl.UnivCharsetDesc
use opensp.Location.Location
use opensp.Attribute.Text

; SdParser — the SGML-declaration parser's builder structures (parseSd.cxx).
; The parse itself (Parser::parse_sgml_decl + the sdParse* sections) lives in
; Parser.scaly and drives these through parseSdParam; the former scoped
; keyword reader was retired when the full parser landed.

; ======================================================================
; Full parseSd machinery (parseSd.cxx) — the structs the Parser's
; parse_sgml_decl drives. The scoped keyword reader above is retired once
; parse_to_esis switches over.

; SdParam::Type (parseSd.cxx:64). SDP_RESERVED_NAME is a BASE: an allowed
; entry SDP_RESERVED_NAME + SDR_x means "the SD reserved name x".
define SDP_INVALID: int 0
define SDP_EE: int 1
define SDP_MINIMUM_LITERAL: int 2
define SDP_MDC: int 3
define SDP_MINUS: int 4
define SDP_NUMBER: int 5
define SDP_CAPACITY_NAME: int 6
define SDP_NAME: int 7
define SDP_PARAM_LITERAL: int 8
define SDP_SYSTEM_IDENTIFIER: int 9
define SDP_GENERAL_DELIMITER_NAME: int 10
define SDP_REFERENCE_RESERVED_NAME: int 11
define SDP_QUANTITY_NAME: int 12
define SDP_RESERVED_NAME: int 13

; The parsed SD parameter (SdParam). The reference's union is decomposed:
; `n` carries the number, `idx` the capacity/quantity/general-delimiter/
; reference-reserved-name ordinal (the reserved-name ordinal rides in `kind`
; itself as SDP_RESERVED_NAME + SDR_x).
define SdParam
(
    var kind: int
    var token: StringC
    var literal_text: ref[Text]?
    var param_literal: StringC
    var n: u32
    var idx: int
)
{
    init()
    {
        kind := SDP_INVALID
        token := StringC()
        literal_text := null
        param_literal := StringC()
        n := 0
        idx := 0
    }
}

; AllowedSdParams — up to six allowed parameter types (parseSd.cxx:95).
define AllowedSdParams (a0: int, a1: int, a2: int, a3: int, a4: int, a5: int)
{
    init(t0: int)
    {
        a0 := t0
        a1 := SDP_INVALID
        a2 := SDP_INVALID
        a3 := SDP_INVALID
        a4 := SDP_INVALID
        a5 := SDP_INVALID
    }

    init(t0: int, t1: int)
    {
        a0 := t0
        a1 := t1
        a2 := SDP_INVALID
        a3 := SDP_INVALID
        a4 := SDP_INVALID
        a5 := SDP_INVALID
    }

    init(t0: int, t1: int, t2: int)
    {
        a0 := t0
        a1 := t1
        a2 := t2
        a3 := SDP_INVALID
        a4 := SDP_INVALID
        a5 := SDP_INVALID
    }

    init(t0: int, t1: int, t2: int, t3: int)
    {
        a0 := t0
        a1 := t1
        a2 := t2
        a3 := t3
        a4 := SDP_INVALID
        a5 := SDP_INVALID
    }

    init(t0: int, t1: int, t2: int, t3: int, t4: int)
    {
        a0 := t0
        a1 := t1
        a2 := t2
        a3 := t3
        a4 := t4
        a5 := SDP_INVALID
    }

    init(t0: int, t1: int, t2: int, t3: int, t4: int, t5: int)
    {
        a0 := t0
        a1 := t1
        a2 := t2
        a3 := t3
        a4 := t4
        a5 := t5
    }

    function param(this: AllowedSdParams, t: int) returns bool
    {
        var i: int 0
        while i < 6
        {
            let v get(i)
            if v = SDP_INVALID
                return false
            if v = t
                return true
            i := i + 1
        }
        false
    }

    function get(this: AllowedSdParams, i: int) returns int
    {
        if i = 0
            return a0
        if i = 1
            return a1
        if i = 2
            return a2
        if i = 3
            return a3
        if i = 4
            return a4
        if i = 5
            return a5
        SDP_INVALID
    }
}

; CharSwitcher (parseSd.cxx:23) — the SWITCHES substitutions with per-switch
; use tracking (checkSwitchesMarkup reports unused ones).
define CharSwitcher (from_v: Slice[u32], to_v: Slice[u32], used_v: Slice[u8], var n_v: size_t)
{
    init(host: ref[Page])
    {
        from_v := allocate_slice[u32](host, 64)
        to_v := allocate_slice[u32](host, 64)
        used_v := allocate_slice[u8](host, 64)
        n_v := 0
    }

    procedure add_switch(mutable this: ref[CharSwitcher], from: u32, to: u32)
    {
        if this.n_v >= 64
            return
        this.from_v.put(this.n_v, from)
        this.to_v.put(this.n_v, to)
        this.used_v.put(this.n_v, 0)
        this.n_v := this.n_v + 1
    }

    procedure subst(mutable this: ref[CharSwitcher], c: u32) returns u32
    {
        var i: size_t 0
        while i < this.n_v
        {
            if (this.from_v[i]) = c
            {
                this.used_v.put(i, 1)
                return this.to_v[i]
            }
            i := i + 1
        }
        c
    }

    function n_switches(this: CharSwitcher) returns size_t
        n_v

    function switch_used(this: CharSwitcher, i: size_t) returns bool
        this.used_v[i] <> 0

    function switch_from(this: CharSwitcher, i: size_t) returns u32
        this.from_v[i]

    function switch_to(this: CharSwitcher, i: size_t) returns u32
        this.to_v[i]
}

; SdFormalError kinds — the deferred formal-error list entries (SdFormalError).
; FPI classification errors carry the S28 fpi-error code; the text-class
; mismatches map to their fixed messages.
define SDFE_FPI: int 0
define SDFE_TEXTCLASS_SD: int 1
define SDFE_TEXTCLASS_BASESET: int 2
define SDFE_TEXTCLASS_CAPACITY: int 3
define SDFE_TEXTCLASS_SYNTAX: int 4

; SdBuilder (parseSd.cxx:39) — the SGML declaration under construction.
define SdBuilder
(
    var sd: ref[Sd]?
    var syntax: ref[Syntax]?
    syntax_charset_decl: ref[CharsetDecl]
    syntax_charset: ref[UnivCharsetDesc]
    switcher: ref[CharSwitcher]
    var external_syntax: bool
    var enr: bool
    var www: bool
    var valid: bool
    var external: bool
    sys_desc: ref[UnivCharsetDesc]
    ferr_kind: Slice[int]
    ferr_code: Slice[int]
    ferr_id: Slice[StringC]
    ferr_loc: Slice[Location]
    var n_ferr: size_t
)
{
    init(host: ref[Page])
    {
        sd := null
        syntax := null
        syntax_charset_decl := CharsetDecl^host()
        syntax_charset := UnivCharsetDesc^host()
        let sw &CharSwitcher^host(host)
        switcher := sw
        external_syntax := false
        enr := false
        www := false
        valid := true
        external := false
        sys_desc := UnivCharsetDesc.make_system(host)
        ferr_kind := allocate_slice[int](host, 64)
        ferr_code := allocate_slice[int](host, 64)
        ferr_id := allocate_slice[StringC](host, 64)
        ferr_loc := allocate_slice[Location](host, 64)
        n_ferr := 0
    }

    ; SdBuilder::addFormalError — queued; parse_sgml_decl sends them at the
    ; end iff the parsed declaration says FORMAL YES. The id is deep-copied
    ; onto the builder's page (literal buffers are transient).
    procedure add_formal_error(mutable this: ref[SdBuilder], kind: int, code: int, id: StringC, loc: Location)
    {
        if this.n_ferr >= 64
            return
        let host Page.get(this.ferr_kind.data)
        ; ★`this.ferr_kind.put(this.n_ferr, kind)` -- a `put` of a PARAMETER -- makes this
        ; routine a STORING callee for that parameter in the escape checker's
        ; eyes, TYPE-BLIND (kind and code are ints), and both callers hand it
        ; call results (`out_id.get_fpi_error()`, `this.sd_loc()`): *argument on
        ; the local page is stored beyond the frame*. The store through the raw
        ; element address is the shape the checker reads, so the three parameter
        ; stores keep it; the fields themselves are the views (`Slice[..]`).
        *(this.ferr_kind.data + this.n_ferr) := kind
        *(this.ferr_code.data + this.n_ferr) := code
        let n id.get_size()
        var cb: pointer[u32] null
        if n > 0
        {
            cb := host.allocate(n * 4, 4) as pointer[u32]
            var i: size_t 0
            while i < n
            {
                *(cb + i) := id.get(i)
                i := i + 1
            }
        }
        let slot this.ferr_id.at(this.n_ferr)
        slot.data := cb
        slot.size := n
        *(this.ferr_loc.data + this.n_ferr) := loc
        this.n_ferr := this.n_ferr + 1
    }
}
