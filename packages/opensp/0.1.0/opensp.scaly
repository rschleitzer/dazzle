; opensp - a Scaly port of James Clark's OpenSP SGML parser.
;
; Part I of the dazzle epic (ROADMAP-dazzle.md): a complete OpenSP port with
; an onsgmls drop-in, gated by the tests/sgml corpus oracle. Ported FROM the
; C# mirror (~/repos/openjade-net) for convenience; the C++ upstream is the
; single source of truth on any doubt.
;
; Memory doctrine (Stage-1 design note): a parse run is ONE arena region.
; OpenSP's Ptr/ConstPtr ref-counting graph needs no counts when everything
; lives until the run dies; Owner<T> becomes a plain field; StringC's Char
; buffer is page-resident (Page.get(this)). Char stays a 32-bit codepoint
; (u32); external bytes are translated at the I/O boundary by CodingSystems.

package scaly 0.1.0

define opensp
{
    ; Stage 1 — foundation layer.
    module StringC
    module CodingSystem
    module Message
    module Location

    function test() returns int
    {
        var result StringC.test()
        if result <> 0
            return result - 100

        set result: CodingSystem.test()
        if result <> 0
            return result - 200

        set result: Message.MessageFormatter.test()
        if result <> 0
            return result - 300

        set result: Location.InputSource.test()
        if result <> 0
            return result - 400

        0
    }
}
