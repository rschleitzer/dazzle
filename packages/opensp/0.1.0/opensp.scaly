; opensp - a Scaly port of James Clark's OpenSP SGML parser.
;
; Part I of the dazzle epic (ROADMAP-dazzle.md): a complete OpenSP port with
; an onsgmls drop-in, gated by the tests/sgml corpus oracle. Ported FROM the
; C# mirror (~/repos/openjade-net) for convenience; the C++ upstream is the
; single source of truth on any doubt.
;
; Memory doctrine (Stage-1 design note): a parse run is ONE arena region.
; OpenSP's Ptr/ConstPtr ref-counting graph needs no counts when everything
; lives until the run dies; Owner<T> becomes a plain field; StringC's Char
; buffer is page-resident (Page.get(this)). Char stays a 32-bit codepoint
; (u32); external bytes are translated at the I/O boundary by CodingSystems.

package scaly 0.1.0

use opensp.StringC.StringC
use opensp.Message.MessageType

define opensp
{
    ; Stage 1 — foundation layer.
    module StringC
    module CodingSystem
    module Message
    ; Message tables — GENERATED from OpenSP lib/*.msg by tools/msggen.py (./mkp
    ; regenerates them). One accessor per reference tag returning its MessageType
    ; (text + severity + number sourced from the .msg). Declared after Message
    ; (they build MessageType/MessageFragment/Severity), before any reporter.
    module ParserMessages
    module ParserAppMessages
    module CatalogMessages
    module EntityManagerMessages
    module EntityAppMessages
    module CmdLineAppMessages
    module PosixStorageMessages
    module StdioStorageMessages
    module URLStorageMessages
    module WinInetStorageMessages
    module ArcEngineMessages
    module MessageReporterMessages
    module MessageFormatterMessages
    module Location
    module CharsetDecl
    ; Stage 2 — entity layer.
    module Storage
    module ExternalId
    module EntityCatalog
    module EntityManager
    module Entity
    ; Stage 3 — declarations (Increment A: tokens + reference syntax).
    module Tokens
    module Sd
    module Syntax
    module SdParser
    ; Stage 3 — Increment B: scanner. (ModeInfo's mode constants precede the
    ; ElementType layer, which reads them in ElementDefinition.computeMode.)
    module ISet
    module Partition
    module Trie
    module ModeInfo
    module Recognizer
    ; Stage 3 — attributes.
    module Attribute
    module AttributeList
    ; Stage 3 — notation.
    module Notation
    ; Stage 3 — Increment C: content-model DFA + the DTD (Dtd increment grows
    ; ElementType to the full layer and adds ShortReferenceMap + Dtd).
    module ShortReferenceMap
    module ElementType
    module ContentToken
    module Dtd
    ; Stage 3 — content-model runtime: the open-element stack.
    module OpenElement
    module ContentState
    ; Stage 3 — parser state scaffold (the pivot to the live parser). XcharMap +
    ; Id are ParserState's small dependencies (normal map + id table).
    module XcharMap
    module Id
    ; Stage 4 — the parser's output stream (content events); ParserState owns the
    ; event queue, so Event is declared before it.
    module Event
    module ParserState
    ; Stage 4 — the ESIS event-dump writer (walks ParserState.events -> onsgmls
    ; ESIS text); declared after ParserState/Event, before the Parser drives it.
    module Esis
    ; Stage 3 — Increment (decl-parser): the prolog + DTD declaration-subset
    ; parser. Declared last: reads constants from Tokens/ModeInfo/Syntax/Attribute/
    ; ElementType/ContentToken/Entity/Notation (all above) and drives ParserState.
    module Parser

    function test() returns int
    {
        var result StringC.test()
        if result <> 0
            return result - 100

        set result: CodingSystem.test()
        if result <> 0
            return result - 200

        set result: Message.MessageFormatter.test()
        if result <> 0
            return result - 300

        set result: Location.InputSource.test()
        if result <> 0
            return result - 400

        set result: Storage.Storage.test()
        if result <> 0
            return result - 500

        set result: ExternalId.ExternalId.test()
        if result <> 0
            return result - 600

        set result: EntityCatalog.CatalogParser.test()
        if result <> 0
            return result - 700

        set result: Entity.Entity.test()
        if result <> 0
            return result - 800

        set result: Syntax.Syntax.test()
        if result <> 0
            return result - 900

        set result: ContentToken.ContentToken.test()
        if result <> 0
            return result - 1000

        set result: ISet.ISet.test()
        if result <> 0
            return result - 1100

        set result: Partition.Partition.test()
        if result <> 0
            return result - 1200

        set result: Trie.TrieBuilder.test()
        if result <> 0
            return result - 1300

        set result: ModeInfo.ModeInfo.test()
        if result <> 0
            return result - 1400

        set result: Recognizer.Recognizer.test()
        if result <> 0
            return result - 1500

        set result: Attribute.DeclaredValue.test()
        if result <> 0
            return result - 1600

        set result: Attribute.AttributeValue.test()
        if result <> 0
            return result - 1700

        set result: Attribute.AttributeSemantics.test()
        if result <> 0
            return result - 1800

        set result: Attribute.Attribute.test()
        if result <> 0
            return result - 1900

        set result: Attribute.AttributeContext.test()
        if result <> 0
            return result - 2000

        set result: Attribute.AttributeDefinition.test()
        if result <> 0
            return result - 2100

        set result: AttributeList.AttributeDefinitionList.test()
        if result <> 0
            return result - 2200

        set result: AttributeList.AttributeList.test()
        if result <> 0
            return result - 2300

        set result: AttributeList.Attributed.test()
        if result <> 0
            return result - 2400

        set result: Notation.Notation.test()
        if result <> 0
            return result - 2500

        set result: ElementType.ElementType.test()
        if result <> 0
            return result - 2600

        set result: ShortReferenceMap.ShortReferenceMap.test()
        if result <> 0
            return result - 2700

        set result: Dtd.Dtd.test()
        if result <> 0
            return result - 2800

        set result: OpenElement.OpenElement.test()
        if result <> 0
            return result - 2900

        set result: ContentState.ContentState.test()
        if result <> 0
            return result - 3000

        set result: XcharMap.XcharMap.test()
        if result <> 0
            return result - 3100

        set result: Id.Id.test()
        if result <> 0
            return result - 3200

        set result: ParserState.ParserState.test()
        if result <> 0
            return result - 3300

        set result: Parser.Parser.test()
        if result <> 0
            return result - 3400

        set result: Esis.Esis.test()
        if result <> 0
            return result - 3500

        ; message-table sanity: a couple of GENERATED accessors return the exact
        ; .msg text + severity (guards the generator/table without a parser run).
        let mt_nonsgml ParserMessages.ParserMessages.nonSgmlCharacter()
        let exp_nonsgml StringC("non SGML character number %1")
        let txt_nonsgml mt_nonsgml.get_text()
        if txt_nonsgml.equals(exp_nonsgml) = false
            return -3600
        if mt_nonsgml.severity_char() <> (0x45 as u32)
            return -3601
        let mt_elimit ParserAppMessages.ParserAppMessages.errorLimitExceeded()
        if mt_elimit.severity_char() <> (0x49 as u32)
            return -3602

        set result: CharsetDecl.CharsetDecl.test()
        if result <> 0
            return result - 3700

        0
    }
}
