; opensp - a Scaly port of James Clark's OpenSP SGML parser.
;
; Part I of the dazzle epic (ROADMAP-dazzle.md): a complete OpenSP port with
; an onsgmls drop-in, gated by the tests/sgml corpus oracle. Ported FROM the
; C# mirror (~/repos/openjade-net) for convenience; the C++ upstream is the
; single source of truth on any doubt.
;
; Memory doctrine (Stage-1 design note): a parse run is ONE arena region.
; OpenSP's Ptr/ConstPtr ref-counting graph needs no counts when everything
; lives until the run dies; Owner<T> becomes a plain field; StringC's Char
; buffer is page-resident (Page.get(this)). Char stays a 32-bit codepoint
; (u32); external bytes are translated at the I/O boundary by CodingSystems.

package scaly 0.1.0

use opensp.StringC.StringC
use opensp.Message.MessageType

define opensp
{
    ; Stage 1 — foundation layer.
    module StringC
    module CodingSystem
    ; the CLI option scanner (include/Options.h getopt clone) the onsgmls
    ; driver's processOptions loop runs.
    module Options
    module Message
    ; Message tables — GENERATED from OpenSP lib/*.msg by tools/msggen.py (./mkp
    ; regenerates them). One accessor per reference tag returning its MessageType
    ; (text + severity + number sourced from the .msg). Declared after Message
    ; (they build MessageType/MessageFragment/Severity), before any reporter.
    module ParserMessages
    module ParserAppMessages
    module CatalogMessages
    module EntityManagerMessages
    module EntityAppMessages
    module CmdLineAppMessages
    module NsgmlsMessages
    module RastEventHandlerMessages
    module PosixStorageMessages
    module StdioStorageMessages
    module URLStorageMessages
    module WinInetStorageMessages
    module ArcEngineMessages
    module MessageReporterMessages
    module MessageFormatterMessages
    module Location
    module CharsetDecl
    module CharsetRegistry
    module CodingSystemKit
    ; Stage 2 — entity layer.
    module Storage
    module ExternalId
    module EntityCatalog
    module EntityManager
    module Entity
    ; Stage 3 — declarations (Increment A: tokens + reference syntax).
    module Tokens
    module Sd
    module Syntax
    ; Stage 3 — Increment B: scanner. (ModeInfo's mode constants precede the
    ; ElementType layer, which reads them in ElementDefinition.computeMode.)
    module ISet
    module Partition
    module Trie
    module ModeInfo
    module Recognizer
    ; Stage 3 — attributes.
    module Attribute
    module AttributeList
    ; the SGML-declaration parser's builder structs (SdParam/SdBuilder/...);
    ; after Attribute (SdParam carries a Text literal).
    module SdParser
    ; Stage 3 — notation.
    module Notation
    ; Stage 3 — Increment C: content-model DFA + the DTD (Dtd increment grows
    ; ElementType to the full layer and adds ShortReferenceMap + Dtd).
    module ShortReferenceMap
    module ElementType
    module ContentToken
    module Dtd
    ; Stage 3 — content-model runtime: the open-element stack.
    module OpenElement
    module ContentState
    ; LINK feature axis: link process definitions (Lpd/LinkSet/link rules) —
    ; needs Dtd/ElementType/AttributeList (above); ParserState holds Lpd
    ; pointers, so Lpd precedes it.
    module Lpd
    ; Stage 3 — parser state scaffold (the pivot to the live parser). XcharMap +
    ; Id are ParserState's small dependencies (normal map + id table).
    module XcharMap
    module Id
    ; the -w warning axis (ParserOptions + the enableWarning table); declared
    ; before ParserState, which carries the options pointer.
    module ParserOptions
    ; Stage 4 — the parser's output stream (content events); ParserState owns the
    ; event queue, so Event is declared before it.
    module Event
    module ParserState
    ; Stage 4 — the ESIS event-dump writer (walks ParserState.events -> onsgmls
    ; ESIS text); declared after ParserState/Event, before the Parser drives it.
    module Esis
    ; the RAST result writer (-t; nsgmls/RastEventHandler.cxx).
    module Rast
    ; Stage 3 — Increment (decl-parser): the prolog + DTD declaration-subset
    ; parser. Declared last: reads constants from Tokens/ModeInfo/Syntax/Attribute/
    ; ElementType/ContentToken/Entity/Notation (all above) and drives ParserState.
    module Parser
    ; the -A architectural-form processor (ArcEngine.cxx); a post-parse pass over
    ; the event queue that spins up a meta-DTD sub-parser — declared after Parser,
    ; whose public parse primitives it calls.
    module ArcEngine

    procedure test() @ret_nonlocal true returns int io reads STDERR_ENC linked













































































































































































}
