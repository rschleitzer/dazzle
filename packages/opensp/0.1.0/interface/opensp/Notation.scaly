use scaly.memory.Page
use scaly.containers.String
use opensp.StringC.StringC
use opensp.ExternalId.ExternalId
use opensp.Location.Location
use opensp.Location.Origin
use opensp.AttributeList.AttributeDefinitionList

; Notation — Notation.cs (C++ Notation.h/.cxx). A NOTATION declaration: a name,
; an optional external identifier, and (because a notation is Attributed) its
; data-attribute definition list.
;
; MI resolution (DESIGN.md Stage 3): C++ `Notation : EntityDecl + Attributed`.
; Scaly has no MI, so — exactly as the C# port did for the Attributed half — the
; EntityDecl declaration metadata (declType/dataType/dtd-scoping/defLocation) and
; the Attributed member (`attribute_def`) are FOLDED INLINE into Notation. A
; notation's declType is always `notation` and its dataType always `ndata`, so
; those are fixed accessors rather than stored fields. The full shared EntityDecl
; base (reused by the entity table) and the entity-side decl metadata land with
; the Dtd/entity-table increment; Notation is a self-contained leaf here.
;
; Notations are referenced by IDENTITY (a borrowed pointer) from
; NotationAttributeSemantics and the DTD's notation table, so they are
; page-hosted (one region per run) via `Notation.make(host, ...)`.
;
; `generateSystemId` (catalog lookup of a notation's system id) needs the live
; ParserState + EntityCatalog and lands with the parser stage.

; EntityDecl::DeclType (the notation value is all this leaf needs; the full enum
; is shared by the entity table in the Dtd increment). DataType lives in the
; Entity module (DT_NDATA), visible unqualified across the package.
define DCL_GENERAL_ENTITY: int 0
define DCL_PARAMETER_ENTITY: int 1
define DCL_DOCTYPE: int 2
define DCL_LINKTYPE: int 3
define DCL_NOTATION: int 4
define DCL_SGML: int 5

define Notation
(
    name: StringC
    dtd_is_base: bool
    dtd_name: StringC
    def_location: Location
    defined: bool
    external_id: ExternalId
    attribute_def: ref[AttributeDefinitionList]?
)
{
    function make(host: ref[Page], name: StringC, dtd_name: StringC, dtd_is_base: bool) returns ref[Notation] linked





    function get_name(this: Notation) @page true @direct true returns StringC linked


    ; EntityDecl::declType / dataType — constant for a notation.
    function decl_type(this: Notation) returns int linked


    function data_type(this: Notation) returns int linked


    function decl_in_dtd_is_base(this: Notation) returns bool linked


    function decl_in_dtd_name(this: Notation) @page true @direct true returns StringC linked


    function get_def_location(this: Notation) @page true @direct true returns Location linked


    procedure set_def_location(mutable this: ref[Notation], loc: Location) linked


    ; Notation::defined — true once an external id has been set by ATTLIST/NOTATION.
    function is_defined(this: Notation) returns bool linked


    function get_external_id(this: Notation) @page true @direct true returns ExternalId linked


    ; Notation::generateSystemId's result — stamp the effective system id
    ; (the -onotation-sysid f-record) into the stored external id.
    procedure set_effective_system(mutable this: ref[Notation], eff: String) linked


    ; Notation::setExternalId — records the id, marks the notation defined, and
    ; stamps the declaration location.
    procedure set_external_id(mutable this: ref[Notation], id: ExternalId, def_location: Location) linked






    ; systemIdPointer / publicIdPointer — presence + value from the external id.
    function has_system_id(this: Notation) returns bool linked


    function system_id(this: Notation) @page true @direct true returns String linked


    function has_public_id(this: Notation) returns bool linked


    function public_id(this: Notation) @page true @direct true returns String linked


    ; Attributed (inline): the notation's data-attribute definition list.
    function get_attribute_def(this: Notation) returns ref[AttributeDefinitionList]? linked


    procedure set_attribute_def(mutable this: ref[Notation], def: ref[AttributeDefinitionList]) linked


    function test() returns int linked









































}
