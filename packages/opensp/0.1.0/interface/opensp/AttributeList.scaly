use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.Syntax.Syntax
use opensp.Sd.Sd
use opensp.Location.Location
use opensp.Attribute.Text
use opensp.Attribute.DeclaredValue
use opensp.Attribute.AttributeValue
use opensp.Attribute.AttributeDefinition
use opensp.Attribute.Attribute
use opensp.Attribute.AttributeContext
use opensp.Notation.Notation

; AttributeList — AttributeList.cs (AttributeDefinitionList, AttributeList) and
; Attributed.cs. The per-element-type list of attribute DEFINITIONS, the live
; per-element list of attribute VALUES, and the mix-in that holds a definition
; list (elements and notations are Attributed).
;
; PORT SHAPE: flat page-hosted structs (same rationale as Attribute.scaly). The
; C++ Owner/Ptr/ConstPtr sharing collapses to plain borrowed pointers in the
; one-region-per-run arena. The value-PRODUCTION paths that need the full
; content Text + live parser context (setValue/setValueToken/recoverUnquoted/
; handleAsUnterminated, and the makeSemantics half of finish) land with the
; parser stage; this increment ports the structural bookkeeping, the missing-
; value fill of finish(), and the spec-index tracking.

; size_t(-1): "no ID / no notation attribute", and "no definition list index".
define ADL_NONE: size_t 0xFFFFFFFFFFFFFFFF

; --- AttributeDefinitionList ---------------------------------------------
define AttributeDefinitionList
(
    defs: ref[Array[ref[AttributeDefinition]?]]
    var index: size_t
    var id_index: size_t
    var notation_index: size_t
    var any_current: bool
)
{
    function make(host: ref[Page], index: size_t) @ret_explicit_0 true @deep true returns ref[AttributeDefinitionList] linked

    ; AttributeDefinitionList(const ConstPtr<AttributeDefinitionList>&) — the copy
    ; parseAttributeValueSpec makes before appending an implied definition for an
    ; undeclared attribute (IMPLYDEF ATTLIST): the element's own list is shared
    ; (the DTD's implicit one is shared by EVERY undefined element), so it must
    ; never be grown in place. The definitions themselves are immutable and are
    ; aliased, not cloned. The index is reassigned by the caller.
    function copy(host: ref[Page], src: ref[AttributeDefinitionList]?) @ret_explicit_0 true @deep true returns ref[AttributeDefinitionList] linked

    function size(this: AttributeDefinitionList) @ret_param_0 true @deep true returns size_t linked

    function def(this: AttributeDefinitionList, i: size_t) @ret_param_0 true @deep true returns ref[AttributeDefinition]? linked

    ; AttributeDefinitionList::append — track id/notation/current as they arrive.
    procedure append(mutable this: ref[AttributeDefinitionList], d: ref[AttributeDefinition]?) @persists true @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true linked

    ; attributeIndex — index of the definition named `name`, or -1.
    function attribute_index(this: AttributeDefinitionList, name: StringC) @ret_param_0 true @deep true returns int linked

    ; tokenIndex — index of the definition whose group contains `token`, or -1.
    function token_index(this: AttributeDefinitionList, token: StringC) @ret_param_0 true @deep true returns int linked

    function token_index_unique(this: AttributeDefinitionList, token: StringC, i: int) @ret_nonlocal true @deep true returns bool linked

    function get_index(this: AttributeDefinitionList) @ret_param_0 true @deep true returns size_t linked

    procedure set_index(mutable this: ref[AttributeDefinitionList], index: size_t) @deep true linked

    function get_id_index(this: AttributeDefinitionList) @ret_param_0 true @deep true returns size_t linked

    ; parseAttlistDecl passes idIndex/notationIndex into the ctor explicitly
    ; (parseDecl.cxx:1016) with LAST-wins semantics from its tracking loop —
    ; append()'s first-wins auto-tracking is overridden by these setters there.
    procedure set_id_index(mutable this: ref[AttributeDefinitionList], i: size_t) @deep true linked

    procedure set_notation_index(mutable this: ref[AttributeDefinitionList], i: size_t) @deep true linked

    function get_notation_index(this: AttributeDefinitionList) @ret_param_0 true @deep true returns size_t linked

    function get_any_current(this: AttributeDefinitionList) @ret_param_0 true @deep true returns bool linked

    function test() @ret_nonlocal true @deep true returns int linked
}

; --- AttributeList --------------------------------------------------------
define AttributeList
(
    conref: bool
    var n_idrefs: u32
    var n_entity_names: u32
    var n_spec: size_t
    vec: ref[Array[ref[Attribute]?]]
    var def: ref[AttributeDefinitionList]?
)
{
    procedure make(host: ref[Page], mutable def: ref[AttributeDefinitionList]?) @ret_explicit_0 true @deep true returns ref[AttributeList] linked

    function def_private(this: AttributeList, i: size_t) @ret_param_0 true @deep true returns ref[AttributeDefinition]? linked

    function attribute(this: AttributeList, i: size_t) @ret_param_0 true @deep true returns ref[Attribute]? linked

    ; The definition behind slot i — the parser's checkValue/missing-value
    ; ports dispatch on its kind (null for an index past the definition list).
    function definition(this: AttributeList, i: size_t) @page true @direct true @ret_param_0 true @deep true returns ref[AttributeDefinition]? linked

    function size(this: AttributeList) @ret_param_0 true @deep true returns size_t linked

    function conref_of(this: AttributeList) @ret_param_0 true @deep true returns bool linked

    function n_spec_of(this: AttributeList) @ret_param_0 true @deep true returns size_t linked

    function name(this: AttributeList, i: size_t) @page true @direct true @ret_param_0 true @deep true returns StringC linked

    function value(this: AttributeList, i: size_t) @page true @direct true @ret_param_0 true @deep true returns ref[AttributeValue]? linked

    function spec_index(this: AttributeList, i: size_t) @ret_param_0 true @deep true returns size_t linked

    function tokenized(this: AttributeList, i: size_t) @ret_nonlocal true @deep true returns bool linked

    function specified(this: AttributeList, i: size_t) @ret_param_0 true @deep true returns bool linked

    function id(this: AttributeList, i: size_t) @ret_nonlocal true @deep true returns bool linked

    function idref(this: AttributeList, i: size_t) @ret_nonlocal true @deep true returns bool linked

    ; entity-declared value (ENTITY/ENTITIES) — also selects the ENTITY subst
    ; table in set_value (entity names are not namecase-folded).
    function entity(this: AttributeList, i: size_t) @ret_nonlocal true @deep true returns bool linked

    function notation(this: AttributeList, i: size_t) @ret_nonlocal true @deep true returns bool linked

    ; nEntityNames accumulation (EntityDeclaredValue::makeSemantics adds the
    ; value's token count; finish checks the total against GRPCNT).
    procedure add_entity_names(mutable this: ref[AttributeList], n: u32) @deep true linked

    ; nIdrefs accumulation (IdrefDeclaredValue::makeSemantics, Attribute.cxx:564).
    procedure add_idrefs(mutable this: ref[AttributeList], n: u32) @deep true linked

    function n_idrefs_of(this: AttributeList) @ret_param_0 true @deep true returns u32 linked

    function n_entity_names_of(this: AttributeList) @ret_param_0 true @deep true returns u32 linked

    ; the definition's DeclaredValue (category/group info for makeValue checks).
    function declared_value(this: AttributeList, i: size_t) @page true @direct true @ret_param_0 true @deep true returns ref[DeclaredValue]? linked

    function current(this: AttributeList, i: size_t) @ret_nonlocal true @deep true returns bool linked

    function any_current(this: AttributeList) @ret_param_0 true @deep true returns bool linked

    function attribute_index(this: AttributeList, name: StringC) @ret_param_0 true @deep true returns int linked

    function token_index(this: AttributeList, name: StringC) @ret_param_0 true @deep true returns int linked

    ; no LATER definition also declares `token` (WebSGML uniqueness check).
    function token_index_unique(this: AttributeList, token: StringC, i: int) @ret_nonlocal true @deep true returns bool linked

    function get_allowed_tokens(this: AttributeList, i: size_t) @page true @direct true @ret_param_0 true @deep true returns ref[Array[StringC]]? linked

    function def_index(this: AttributeList) @deep true returns size_t linked

    ; getId — the ID attribute's value string, or empty if none/implied.
    function get_id(this: AttributeList) @page true @direct true @ret_param_0 true @deep true returns StringC linked

    ; setSpec — record that attribute `index` was specified (or a duplicate).
    procedure set_spec(mutable this: ref[AttributeList], index: size_t, mutable context: ref[AttributeContext]) @ret_nonlocal true @deep true linked

    procedure note_invalid_spec(mutable this: ref[AttributeList]) @deep true linked

    ; setValue — build the AttributeValue for a specified attribute from its
    ; parsed Text. CDATA -> verbatim; tokenized -> whitespace-separated tokens
    ; (space_index over the normalized text; null when single-token). The
    ; makeSemantics half (id/idref/entity/notation resolution + messages) runs
    ; parser-side right after (Parser.check_value_semantics), as do the
    ; makeValue validation checks (Parser.validate_attribute_value: token
    ; category/NAMELEN/normalized-length, group membership).
    procedure set_value(mutable this: ref[AttributeList], host: ref[Page], index: size_t, mutable text: ref[Text], context: ref[AttributeContext]) @ret_nonlocal true @deep true returns bool linked

    function get_def(this: AttributeList) @ret_param_0 true @deep true returns ref[AttributeDefinitionList]? linked

    ; the finish-tail conrefNotation condition (Attribute.cxx:1267): CONREF
    ; was specified AND the list has a NOTATION attribute that was specified.
    function conref_notation_specified(this: AttributeList) @ret_param_0 true @deep true returns bool linked

    ; AttributeList::changeDef — adopt a grown definition list (vec_.resize):
    ; the already-parsed attributes KEEP their slots (and their values), the new
    ; definitions get fresh ones. Rebuilding the vector here would drop every
    ; attribute specified earlier in the same start tag.
    procedure change_def(mutable this: ref[AttributeList], host: ref[Page], def: ref[AttributeDefinitionList]?) @deep true @deep_this_4 true @deep_whole_4 true linked

    ; AttributeList::finish — fill in the values of unspecified attributes from
    ; their definitions' missing-value rule. The makeSemantics half (idref /
    ; entity / notation resolution) needs the live parser context and lands with
    ; the parser stage; the grpcnt overflow + conref/notation checks are kept.
    procedure finish(mutable this: ref[AttributeList], mutable context: ref[AttributeContext]) @ret_nonlocal true @deep true linked

    function test() @ret_nonlocal true @deep true returns int linked
}

; --- Attributed -----------------------------------------------------------
; The mix-in for things with attribute definitions (elements, notations).
; Upstream's `Attributed *` in a LIST position (Parser::parseAttributed fills a
; `Vector<Attributed *>`): an ElementType OR a Notation, both `: Attributed`
; there. The port's two records share no base, so the list element is this
; opaque pointer alias and the reader picks the type by the `is_notation`
; flag (`a as ref[ElementType]` / `a as ref[Notation]`).
define AttributedDecl()
define AttributedRef pointer[AttributedDecl]

define Attributed (var attribute_def: ref[AttributeDefinitionList]?)
{
    init() linked

    function make(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[Attributed] linked

    function get_attribute_def(this: Attributed) @ret_param_0 true @deep true returns ref[AttributeDefinitionList]? linked

    procedure set_attribute_def(mutable this: ref[Attributed], def: ref[AttributeDefinitionList]?) @deep true @deep_this_2 true @deep_whole_2 true linked

    function test() @ret_nonlocal true @deep true returns int linked
}
