use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.Location.Location
use opensp.Entity.Entity
use opensp.Entity.InternalEntity

; ShortReferenceMap — ShortReferenceMap.cs (105 LOC). A named SHORTREF map: for
; each shortref delimiter index it records the general-entity NAME to reference
; (nameMap_) and, once the DTD resolves them, the borrowed Entity itself
; (entityMap_). Reached only via shortref delimiters against a DTD.
;
; PORT SHAPE: page-hosted flat struct (referenced by identity from the DTD's
; shortref-map table and from an element type's `map`). The C++ Vector<StringC>
; / Vector<ConstPtr<Entity>> become Array pointers (null = unset); entities are
; borrowed pointers in the one-region-per-run arena. `defined()` mirrors the C++
; `nameMap_.size() > 0` test: a set (even empty) name map counts as defined
; (C++ resizes an empty map to 1).

define ShortReferenceMap
(
    name: StringC
    var name_map: ref[Array[StringC]]?
    var entity_map: ref[Array[ref[Entity]?]]?
    var used: bool
    var def_location: Location
)
{
    function make(host: ref[Page], name: StringC) @ret_explicit_0 true @deep true returns ref[ShortReferenceMap] linked

    function get_name(this: ShortReferenceMap) @page true @direct true @ret_param_0 true @deep true returns StringC linked

    ; Boolean defined() const { return nameMap_.size() > 0; }
    function defined(this: ShortReferenceMap) @ret_param_0 true @deep true returns bool linked

    ; void setNameMap(Vector<StringC> &map).
    procedure set_name_map(mutable this: ref[ShortReferenceMap], map: ref[Array[StringC]]) @deep true @deep_this_2 true @deep_whole_2 true linked

    ; void setEntityMap(Vector<ConstPtr<Entity> > &map).
    procedure set_entity_map(mutable this: ref[ShortReferenceMap], map: ref[Array[ref[Entity]?]]) @deep true @deep_this_2 true @deep_whole_2 true linked

    ; Boolean lookup(int i, const StringC *&) — presence of a non-empty name.
    function has_entity_name(this: ShortReferenceMap, i: size_t) @ret_param_0 true @deep true returns bool linked

    ; const StringC *entityName(size_t i) — the name at i, or empty if none.
    function entity_name(this: ShortReferenceMap, i: size_t) @page true @direct true @ret_param_0 true @deep true returns StringC linked

    ; const ConstPtr<Entity> &entity(size_t i) — the resolved entity, or null.
    function entity(this: ShortReferenceMap, i: size_t) @ret_param_0 true @deep true returns ref[Entity]? linked

    function is_used(this: ShortReferenceMap) @ret_param_0 true @deep true returns bool linked

    procedure set_used(mutable this: ref[ShortReferenceMap]) @deep true linked

    function get_def_location(this: ShortReferenceMap) @page true @direct true @ret_param_0 true @deep true returns Location linked

    procedure set_def_location(mutable this: ref[ShortReferenceMap], loc: Location) @deep true @deep_this_2 true @deep_whole_2 true linked

    function test() @ret_nonlocal true @deep true returns int linked
}
