use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.Location.Location
use opensp.ElementType.ElementType
use opensp.ElementType.ElementDefinition
use opensp.ShortReferenceMap.ShortReferenceMap
use opensp.ContentToken.ContentToken
use opensp.ContentToken.MatchState
use opensp.ContentToken.CompiledModelGroup
use opensp.ContentToken.CmNode

; OpenElement — OpenElement.cs (160 LOC). One entry on the parser's open-element
; stack: the element type, whether its start-tag was net-enabling, whether it is
; included, its content-model cursor (`MatchState`), the declared content (cached
; so the empty/cdata/rcdata fast paths dodge the model group), its active
; shortref map, its start location, and its serial index.
;
; PORT SHAPE: page-hosted flat struct (referenced by pointer from the open-element
; stack). C++ `OpenElement : Link` (intrusive list node) — the ContentState port
; threads the stack itself (an Array + live depth), so the Link base drops; an
; OpenElement is just the payload. Mutated through a pointer via plain `.`.
;
; impliedStartTag / doRequiredTransition landed with the OMITTAG increment
; (Stage 4 Inc 4). DEFERRED still: `invalidExclusion` / `transitionToken` (the
; exclusion-recovery automaton), which arrive with exclusion diagnostics.

define OpenElement
(
    var element_type: ref[ElementType]?
    var net_enabling: bool
    var included: bool
    var match_state: ref[MatchState]?
    var declared_content: int
    var map: ref[ShortReferenceMap]?
    var start_location: Location
    var index: u64
)
{
    function make(host: ref[Page], type: ref[ElementType]?, net: bool, included: bool, map: ref[ShortReferenceMap]?, start_location: Location) @ret_caller true @deep true returns ref[OpenElement] linked
















    ; Re-arm a recycled element in place (ContentState.acquire_element). Same
    ; field set as `make`, but the MatchState struct rides along and only its
    ; AndState is re-armed — see ContentToken.reset_match_state. Every field is
    ; written, so a recycled element carries nothing of its previous life.
    procedure reinit(mutable this: ref[OpenElement], host: ref[Page], type: ref[ElementType]?, net: bool, included: bool, map: ref[ShortReferenceMap]?, start_location: Location) @deep true @deep_this_100 true @deep_whole_100 true linked























    function get_type(this: OpenElement) @ret_param_0 true @deep true returns ref[ElementType]? linked


    function get_net_enabling(this: OpenElement) @ret_param_0 true @deep true returns bool linked


    function get_included(this: OpenElement) @ret_param_0 true @deep true returns bool linked


    function get_match_state(this: OpenElement) @ret_param_0 true @deep true returns ref[MatchState]? linked


    procedure set_match_state(mutable this: ref[OpenElement], state: ref[MatchState]?) @deep true @deep_this_2 true @deep_whole_2 true linked


    function is_finished(this: OpenElement) @ret_nonlocal true @deep true returns bool linked






    procedure try_transition(mutable this: OpenElement, e: ref[ElementType]) @ret_param_1 true @deep true returns bool linked












    procedure try_transition_pcdata(mutable this: OpenElement) @ret_nonlocal true @deep true returns bool linked







    ; MatchState::impliedStartTag — the uniquely-required next element (OMITTAG
    ; start-tag omission), or null. Only model-group content implies tags.
    function implied_start_tag(this: OpenElement) @ret_param_0 true @deep true returns ref[ElementType]? linked






    ; the required token itself — its type_index feeds requiredElementExcluded.
    function implied_start_token(this: OpenElement) @ret_param_0 true @deep true returns ref[CmNode]? linked






    ; MatchState::possibleTransitions — the element types reachable by one
    ; transition (null = the #PCDATA leaf); findMissingTag's candidate set.
    procedure possible_transitions(this: OpenElement, mutable v: ref[Array[ref[ElementType]?]]) @ret_nonlocal true @deep true linked





    ; MatchState::invalidExclusion — the transition token for e that may not be
    ; excluded (neither inherently optional nor an OR-group member), or null.
    function invalid_exclusion(this: OpenElement, e: ref[ElementType]) @ret_caller true @deep true returns ref[CmNode]? linked






    ; a deep copy of the content-model cursor (undo snapshot).
    function copy_match_state(this: OpenElement, host: ref[Page]) @ret_explicit_1 true @deep true returns ref[MatchState] linked


    ; MatchState::doRequiredTransition — advance past the implied required element.
    procedure do_required_transition(mutable this: ref[OpenElement]) @ret_nonlocal true @deep true linked





    function get_map(this: OpenElement) @ret_param_0 true @deep true returns ref[ShortReferenceMap]? linked


    procedure set_map(mutable this: ref[OpenElement], map: ref[ShortReferenceMap]?) @deep true @deep_this_2 true @deep_whole_2 true linked


    ; declaredContent == cdata || rcdata — the special (verbatim) parse.
    function requires_special_parse(this: OpenElement) @ret_param_0 true @deep true returns bool linked


    function mode(this: OpenElement, net_enabled: bool) @ret_param_0 true @deep true returns int linked


















    function get_start_location(this: OpenElement) @page true @direct true @ret_param_0 true @deep true returns Location linked


    function current_position(this: OpenElement) @ret_param_0 true @deep true returns ref[CmNode]? linked






    function declared_empty(this: OpenElement) @ret_param_0 true @deep true returns bool linked


    ; setConref — a CONREF attribute makes the element behave as EMPTY.
    procedure set_conref(mutable this: ref[OpenElement]) @deep true linked


    function get_index(this: OpenElement) @ret_param_0 true @deep true returns u64 linked


    procedure set_index(mutable this: ref[OpenElement], index: u64) @deep true linked


    function test() @ret_nonlocal true @deep true returns int linked



























































}
