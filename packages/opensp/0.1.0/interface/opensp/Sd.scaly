use scaly.memory.Page
use opensp.CharsetDecl.CharsetDecl
use opensp.CharsetDecl.UnivCharsetDesc
use opensp.StringC.StringC

; Sd — the SGML declaration's non-syntax info (Sd.cs).
;
; Stage-3 scope (Increment A): the minimum Syntax(Sd) needs — the internal
; charset mapping (identity for the reference/XML case) and the www (WWW-TC)
; flag. The full feature-flag/capacity/quantity/charset machinery and the SD
; parser land with later increments; a plain reference Sd is what the corpus's
; implied XML declaration yields.

; SHORTTAG STARTTAG NETENABL — whether/how a start tag may be net-enabling
; (Sd::NetEnable). netEnableAll is the reference concrete syntax's value; the SD
; parser sets netEnableImmednet for the XML/scaly declaration (NETENABL IMMEDNET).
define NET_ENABLE_NO: int 0
define NET_ENABLE_IMMEDNET: int 1
define NET_ENABLE_ALL: int 2

; IMPLYDEF ELEMENT (Sd::ImplydefElement). NO = an element with no declaration is
; an error; YES = it is implied (ANY content, undefined); ANYOTHER additionally
; forbids immediate recursion. The reference declaration and xml.dcl both say NO —
; ParserState turns it to YES for the rest of the parse when a document has no
; document type declaration at all (Parser.imply_dtd -> enable_implydef).
define IMPLYDEF_ELEMENT_NO: int 0
define IMPLYDEF_ELEMENT_YES: int 1
define IMPLYDEF_ELEMENT_ANYOTHER: int 2

; FEATURES OTHER ENTITIES REF (Sd::EntityRef).
define ENTITY_REF_ANY: int 0
define ENTITY_REF_INTERNAL: int 1
define ENTITY_REF_NONE: int 2

; Sd::BooleanFeature ordinals — sdParseFeatures assigns them sequentially in
; FEATURES-section order (Sd.h:31).
define SDF_DATATAG: int 0
define SDF_OMITTAG: int 1
define SDF_RANK: int 2
define SDF_STARTTAGEMPTY: int 3
define SDF_STARTTAGUNCLOSED: int 4
define SDF_ENDTAGEMPTY: int 5
define SDF_ENDTAGUNCLOSED: int 6
define SDF_ATTRIBDEFAULT: int 7
define SDF_ATTRIBOMITNAME: int 8
define SDF_ATTRIBVALUE: int 9
define SDF_EMPTYNRM: int 10
define SDF_IMPLYDEFATTLIST: int 11
define SDF_IMPLYDEFDOCTYPE: int 12
define SDF_IMPLYDEFENTITY: int 13
define SDF_IMPLYDEFNOTATION: int 14
define SDF_IMPLICIT: int 15
define SDF_FORMAL: int 16
define SDF_URN: int 17
define SDF_KEEPRSRE: int 18

; Sd::NumberFeature ordinals (Sd.h:58).
define SDNF_SIMPLE: int 0
define SDNF_EXPLICIT: int 1
define SDNF_CONCUR: int 2
define SDNF_SUBDOC: int 3

; Sd::Capacity — 17 capacities, TOTALCAP first (Sd.h); ctor default 35000 each.
define N_CAPACITY: int 17

; Sd::ReservedName — the SGML declaration's own reserved names (Sd.cxx:46,
; alphabetical). parseSdParam matches candidate name tokens against these.
define SDR_ALL: int 0
define SDR_ANY: int 1
define SDR_ANYOTHER: int 2
define SDR_APPINFO: int 3
define SDR_ATTLIST: int 4
define SDR_ATTRIB: int 5
define SDR_BASESET: int 6
define SDR_CAPACITY: int 7
define SDR_CHARSET: int 8
define SDR_CONCUR: int 9
define SDR_CONTROLS: int 10
define SDR_DATATAG: int 11
define SDR_DEFAULT: int 12
define SDR_DELIM: int 13
define SDR_DESCSET: int 14
define SDR_DOCTYPE: int 15
define SDR_DOCUMENT: int 16
define SDR_ELEMENT: int 17
define SDR_EMPTY: int 18
define SDR_EMPTYNRM: int 19
define SDR_ENDTAG: int 20
define SDR_ENTITIES: int 21
define SDR_ENTITY: int 22
define SDR_EXPLICIT: int 23
define SDR_FEATURES: int 24
define SDR_FORMAL: int 25
define SDR_FUNCHAR: int 26
define SDR_FUNCTION: int 27
define SDR_GENERAL: int 28
define SDR_IMMEDNET: int 29
define SDR_IMPLICIT: int 30
define SDR_IMPLYDEF: int 31
define SDR_INSTANCE: int 32
define SDR_INTEGRAL: int 33
define SDR_INTERNAL: int 34
define SDR_KEEPRSRE: int 35
define SDR_LCNMCHAR: int 36
define SDR_LCNMSTRT: int 37
define SDR_LINK: int 38
define SDR_MINIMIZE: int 39
define SDR_MSICHAR: int 40
define SDR_MSOCHAR: int 41
define SDR_MSSCHAR: int 42
define SDR_NAMECASE: int 43
define SDR_NAMECHAR: int 44
define SDR_NAMES: int 45
define SDR_NAMESTRT: int 46
define SDR_NAMING: int 47
define SDR_NETENABL: int 48
define SDR_NO: int 49
define SDR_NOASSERT: int 50
define SDR_NONE: int 51
define SDR_NOTATION: int 52
define SDR_OMITNAME: int 53
define SDR_OMITTAG: int 54
define SDR_OTHER: int 55
define SDR_PUBLIC: int 56
define SDR_QUANTITY: int 57
define SDR_RANK: int 58
define SDR_RE: int 59
define SDR_REF: int 60
define SDR_RS: int 61
define SDR_SCOPE: int 62
define SDR_SEEALSO: int 63
define SDR_SEPCHAR: int 64
define SDR_SGML: int 65
define SDR_SGMLREF: int 66
define SDR_SHORTREF: int 67
define SDR_SHORTTAG: int 68
define SDR_SHUNCHAR: int 69
define SDR_SIMPLE: int 70
define SDR_SPACE: int 71
define SDR_STARTTAG: int 72
define SDR_SUBDOC: int 73
define SDR_SWITCHES: int 74
define SDR_SYNTAX: int 75
define SDR_SYSTEM: int 76
define SDR_TYPE: int 77
define SDR_UCNMCHAR: int 78
define SDR_UCNMSTRT: int 79
define SDR_UNCLOSED: int 80
define SDR_UNUSED: int 81
define SDR_URN: int 82
define SDR_VALIDITY: int 83
define SDR_VALUE: int 84
define SDR_YES: int 85
define N_SD_RESERVED: int 86

; namecase_general_flag / omitname_flag carry the SD parser's NAMECASE GENERAL
; and SHORTTAG ATTRIB OMITNAME values (SdParser.build). Their reference-syntax
; defaults (GENERAL YES, OMITNAME YES) reproduce the implied-declaration
; behavior every catalog-less corpus model is parsed under — so a plain Sd()
; is byte-identical to the previous hardcoded reference. net_enable_flag
; defaults to netEnableAll (the reference concrete syntax).
define Sd @resident true (www_flag: bool, namecase_general_flag: bool, omitname_flag: bool, net_enable_flag: int, emptynrm_flag: bool, omittag_flag: bool, attribute_default_flag: bool, keeprsre_flag: bool, starttag_empty_flag: bool, starttag_unclosed_flag: bool, endtag_empty_flag: bool, endtag_unclosed_flag: bool, attribute_value_flag: bool, formal_flag: bool, urn_flag: bool, doc_charset_decl_ptr: ref[CharsetDecl]?, doc_charset_desc_ptr: ref[UnivCharsetDesc]?, internal_is_doc_charset_flag: bool, scope_instance_flag: bool, type_valid_flag: bool, entity_ref_val: int, integrally_stored_flag: bool, implydef_element_val: int, implydef_attlist_flag: bool, implydef_doctype_flag: bool, implydef_entity_flag: bool, implydef_notation_flag: bool, datatag_flag: bool, rank_flag: bool, implicit_flag: bool, num_simple: u32, num_explicit: u32, num_concur: u32, num_subdoc: u32, capacities_v: Slice[u32], named_chars_v: Slice[StringC], n_named_v: size_t)
{
    init() linked













































    init(www_flag: bool) linked













































    ; Sd::Sd (Sd.cxx:15) — the RAW declaration the SD parser fills in: every
    ; boolean feature 0, NETENABL NO, ENTITIES REF ANY, VALIDITY TYPE,
    ; INTEGRAL NO, IMPLYDEF ELEMENT NO. parse_sgml_decl constructs Sd() (the
    ; implied-decl defaults above) and then calls this to zero the features the
    ; FEATURES section will parse for real.
    procedure set_raw_defaults(mutable this: ref[Sd]) linked




























    ; execToInternal: map a document-charset byte to an internal Char. The
    ; reference/XML case is the identity coding system, so this is zero-extend.
    function exec_to_internal(this: Sd, c: u8) returns u32 linked


    ; The CHARSET section (Sd::docCharsetDecl) + the desc->univ mapping
    ; (Sd::docCharset). ALWAYS installed before parsing starts — parsed from
    ; the SGML declaration (SdParser.parse_charset) or the implied pair
    ; (CharsetDecl.make_implied / UnivCharsetDesc.make_system, Parser.cxx:46) —
    ; parse_numeric_char_ref dereferences the decl unconditionally, mirroring
    ; the reference where the Parser constructor guarantees one.
    function doc_charset_decl(this: Sd) returns ref[CharsetDecl]? linked


    procedure set_doc_charset_decl(mutable this: ref[Sd], d: ref[CharsetDecl]) linked


    function doc_charset_desc(this: Sd) returns ref[UnivCharsetDesc]? linked


    procedure set_doc_charset_desc(mutable this: ref[Sd], d: ref[UnivCharsetDesc]) linked


    ; Sd::internalCharsetIsDocCharset — TRUE in the default mode (the internal
    ; charset IS the document charset; numeric char refs need no translation);
    ; FALSE under SP_CHARSET_FIXED=YES/1 (the internal charset is the fixed
    ; system charset — translateNumericCharRef maps doc char -> univ ->
    ; internal, CmdLineApp::initCodingSystem).
    function internal_charset_is_doc_charset(this: Sd) returns bool linked


    procedure set_internal_charset_is_doc_charset(mutable this: ref[Sd], v: bool) linked


    function www(this: Sd) returns bool linked


    procedure set_www(mutable this: ref[Sd], v: bool) linked


    ; NAMECASE GENERAL — when NO, name folding (Syntax.fold / the general subst
    ; table) is the identity map (Syntax init consults this).
    function namecase_general(this: Sd) returns bool linked


    procedure set_namecase_general(mutable this: ref[Sd], v: bool) linked


    ; SHORTTAG ATTRIB OMITNAME — governs whether a bare enumerated-value token
    ; (attribute name omitted) is legal in an attribute spec (Sd::attributeOmitName).
    function attribute_omit_name(this: Sd) returns bool linked


    procedure set_attribute_omit_name(mutable this: ref[Sd], v: bool) linked


    ; SHORTTAG STARTTAG NETENABL — how a start tag may be net-enabling (`/` NESTC).
    function start_tag_net_enable(this: Sd) returns int linked


    procedure set_start_tag_net_enable(mutable this: ref[Sd], v: int) linked


    ; EMPTYNRM — empty-element-tag normalization (`<x/>` closes an EMPTY element
    ; via the following NET); reference default NO, the XML/scaly declaration YES.
    function empty_element_normal(this: Sd) returns bool linked


    procedure set_empty_element_normal(mutable this: ref[Sd], v: bool) linked


    ; SHORTTAG STARTTAG/ENDTAG EMPTY/UNCLOSED + ATTRIB VALUE — the remaining
    ; Annex-K SHORTTAG sub-features (Sd's fSTARTTAGEMPTY..fATTRIBVALUE). A plain
    ; `SHORTTAG YES|NO` sets ALL seven sub-flags at once (Sd::setShorttag,
    ; Sd.cxx:268); the WWW sub-form sets them individually. Defaults are the
    ; implied declaration's (SHORTTAG YES = all true).
    function start_tag_empty(this: Sd) returns bool linked


    procedure set_start_tag_empty(mutable this: ref[Sd], v: bool) linked


    function start_tag_unclosed(this: Sd) returns bool linked


    procedure set_start_tag_unclosed(mutable this: ref[Sd], v: bool) linked


    function end_tag_empty(this: Sd) returns bool linked


    procedure set_end_tag_empty(mutable this: ref[Sd], v: bool) linked


    function end_tag_unclosed(this: Sd) returns bool linked


    procedure set_end_tag_unclosed(mutable this: ref[Sd], v: bool) linked


    ; Sd::attributeValueNotLiteral — despite the name it returns the ATTRIB
    ; VALUE flag DIRECTLY (Sd.cxx:347): true = unquoted attribute values legal.
    function attribute_value_not_literal(this: Sd) returns bool linked


    procedure set_attribute_value_not_literal(mutable this: ref[Sd], v: bool) linked


    ; Sd::setShorttag — plain `SHORTTAG YES|NO` in FEATURES MINIMIZE: every
    ; sub-flag gets the value, and netEnable_ is set to ALL unconditionally
    ; (Sd.cxx:272 — yes, also for NO; ported faithfully).
    procedure set_shorttag(mutable this: ref[Sd], v: bool) linked











    ; FEATURES OTHER FORMAL — formal-public-identifier validation: when YES,
    ; a PUBLIC minimum literal that fails the FPI decomposition (ExternalId's
    ; PublicId classification) is reported (Sd::formal, Sd.cxx:432). Reference
    ; declaration and xml.dcl both say NO.
    function formal(this: Sd) returns bool linked


    procedure set_formal(mutable this: ref[Sd], v: bool) linked


    procedure set_rank(mutable this: ref[Sd], v: bool) linked


    ; the SUBDOC quantity (number of concurrent subdocuments admitted). The
    ; provisional/implied Sd carries the ParserOptions default (Parser.cxx:46,
    ; opt.subdoc = 99999999); an explicit FEATURES SUBDOC section overwrites it.
    procedure set_subdoc(mutable this: ref[Sd], n: u32) linked


    ; FEATURES OTHER ... URN — an Annex-K (WWW) feature: when YES, a public
    ; identifier must be an RFC-2141 URN (Sd::urn, Sd.cxx:438). Default NO.
    function urn(this: Sd) returns bool linked


    procedure set_urn(mutable this: ref[Sd], v: bool) linked


    ; Sd::concur (Sd.h:401) — the CONCUR quantity (0 = NO).
    function concur(this: Sd) returns int linked


    ; Sd::link (Sd.h:279) — any LINK feature admitted.
    function link(this: Sd) returns bool linked


    ; OTHER KEEPRSRE — when YES (xml.dcl), RS and RE are NOT record boundaries but
    ; ordinary DATA characters: ModeInfo drops the tokenRs/tokenRe entries from the
    ; content modes (REQUIRE_NOT_KEEPRSRE), so they reach the parser as tokenChar
    ; and the OutputState record machine never shapes them. Reference default NO.
    function keeprsre(this: Sd) returns bool linked


    procedure set_keeprsre(mutable this: ref[Sd], v: bool) linked


    ; Flags ParserState.setSd consults (Sd.cs):
    ;   mayDefaultAttribute = omittag || attributeDefault    (ParserState.cxx:303)
    ;   validate            = typeValid
    ;
    ; FEATURES MINIMIZE OMITTAG — tag omission. Governs tryImplyTag, which bails
    ; immediately when it is NO (parseInstance.cxx:754), so NO also means the
    ; document element is never implied and a prolog-only document correctly ends
    ; up with an unfinished root ("no document element").
    ;
    ; SHORTTAG ATTRIB DEFAULT — attribute defaulting from the DTD.
    ;
    ; These are INDEPENDENT: the corpus's xml.dcl sets OMITTAG NO *and* ATTRIB
    ; DEFAULT YES, so defaulting survives with no tag omission at all. (They used
    ; to be hardcoded true/false — omittag was forced YES purely to switch
    ; defaulting on, which also silently enabled tag omission for XML.) Defaults
    ; here are the reference declaration's (OMITTAG YES, SHORTTAG YES).
    function omittag(this: Sd) returns bool linked


    procedure set_omittag(mutable this: ref[Sd], v: bool) linked


    function attribute_default(this: Sd) returns bool linked


    procedure set_attribute_default(mutable this: ref[Sd], v: bool) linked


    function type_valid(this: Sd) returns bool linked


    procedure set_type_valid(mutable this: ref[Sd], v: bool) linked


    function implydef_element(this: Sd) returns int linked


    procedure set_implydef_element(mutable this: ref[Sd], v: int) linked


    function implydef_attlist(this: Sd) returns bool linked


    ; IMPLYDEF DOCTYPE — when YES, a missing DOCTYPE implies an external DTD
    ; subset looked up in the catalog under the document element's name. NO in the
    ; reference declaration and in xml.dcl (and no corpus catalog declares one),
    ; so implyDtd always takes the "no document type declaration" branch.
    function implydef_doctype(this: Sd) returns bool linked


    ; IMPLYDEF ENTITY — an SP extension (NO in the reference declaration and in
    ; xml.dcl): when NO, a reference to an undeclared general entity is an error
    ; rather than an implied declaration.
    function implydef_entity(this: Sd) returns bool linked


    function implydef_notation(this: Sd) returns bool linked


    ; SCOPE INSTANCE — the declared syntax applies only to the instance; the
    ; prolog is parsed with the reference syntax (parseSgmlDecl builds both).
    function scope_instance(this: Sd) returns bool linked


    procedure set_scope_instance(mutable this: ref[Sd]) linked


    function integrally_stored(this: Sd) returns bool linked


    procedure set_integrally_stored(mutable this: ref[Sd], v: bool) linked


    function entity_ref(this: Sd) returns int linked


    procedure set_entity_ref(mutable this: ref[Sd], v: int) linked


    function datatag(this: Sd) returns bool linked


    function rank(this: Sd) returns bool linked


    function implicit_link(this: Sd) returns bool linked


    function simple_link(this: Sd) returns u32 linked


    function explicit_link(this: Sd) returns u32 linked


    function subdoc(this: Sd) returns u32 linked


    ; Sd::setBooleanFeature — sdParseFeatures assigns the SDF_* ordinals in
    ; FEATURES-section order.
    procedure set_boolean_feature(mutable this: ref[Sd], f: int, v: bool) linked









































    procedure set_number_feature(mutable this: ref[Sd], f: int, n: u32) linked











    ; ---- CAPACITY (Sd::setCapacity/capacity; ctor default 35000 each) ------
    procedure set_capacity(mutable this: ref[Sd], i: int, n: u32) @persists true linked















    function capacity(this: Sd, i: int) returns u32 linked






    function capacity_name(this: Sd, i: int) @page true @direct true returns StringC linked




































    ; Sd::lookupCapacityName — -1 when the name is no capacity name.
    function lookup_capacity_name(this: Sd, name: StringC) returns int linked












    ; Sd::quantityName (Syntax::Quantity order, Sd.cxx:157).
    function quantity_name(this: Sd, i: int) @page true @direct true returns StringC linked
































    ; Sd::lookupQuantityName — -1 when the name is no quantity name.
    function lookup_quantity_name(this: Sd, name: StringC) returns int linked












    ; Sd::generalDelimiterName (Syntax::DelimGeneral order = dAND..dVI).
    function general_delimiter_name(this: Sd, i: int) @page true @direct true returns StringC linked




































































    ; Sd::lookupGeneralDelimiterName — -1 when no general-delimiter role name.
    function lookup_general_delimiter_name(this: Sd, name: StringC) returns int linked












    ; Sd::nameToUniv (Sd.cxx:255): a minimum-literal-described character maps
    ; into the ISO 10646 private-use group — 0x60000000 + n, one n per
    ; DISTINCT name (lazy table; the Sd must be page-hosted by the SD parser).
    procedure name_to_univ(mutable this: ref[Sd], name: StringC) returns u32 linked





































    ; Sd::reservedName — the SD's own reserved-name spellings (SDR_* order).
    function sd_reserved_name(this: Sd, i: int) @page true @direct true returns StringC linked













































































































































































}
