use scaly.memory.Page

; ExternalId — a PUBLIC and/or SYSTEM identifier (ExternalId.cs), plus the
; PublicId FPI/URN classification (ExternalId.cxx:47-332).
;
; classify_public ports PublicId::init: the minimum literal is decomposed as a
; formal public identifier (initFpi) and as an RFC-2141 URN (initUrn); the type
; records which succeeded (informal when neither), the loser's error code feeds
; parseExternalId's FORMAL/URN reporting switch (parseDecl.cxx:1523). The
; decomposed FPI substrings (owner, description, language, display version,
; nid, nss) are validated but not stored — every reference getter for them is
; unused in the drop-in; the scalars (text class, owner type, unavailable,
; display-version presence) carry all consulted state.
;
; Identifiers are byte `String`s, not StringC: public ids, system ids and file
; paths are ASCII/Latin-1 identifiers that live at the I/O boundary (the design
; note's byte<->Char rule puts them on the byte side). StringC (u32) is reserved
; for Char CONTENT — the entity text that becomes an InputSource.

; PublicId::Type (ExternalId.h).
define PUBLIC_INFORMAL: int 0
define PUBLIC_FPI: int 1
define PUBLIC_URN: int 2

; PublicId::OwnerType.
define OWNER_ISO: int 0
define OWNER_REGISTERED: int 1
define OWNER_UNREGISTERED: int 2

; PublicId::TextClass — ordinals index the reference's textClasses table.
define TC_NONE: int 0 - 1
define TC_CAPACITY: int 0
define TC_CHARSET: int 1
define TC_DOCUMENT: int 2
define TC_DTD: int 3
define TC_ELEMENTS: int 4
define TC_ENTITIES: int 5
define TC_LPD: int 6
define TC_NONSGML: int 7
define TC_NOTATION: int 8
define TC_SD: int 9
define TC_SHORTREF: int 10
define TC_SUBDOC: int 11
define TC_SYNTAX: int 12
define TC_TEXT: int 13

; Classification error codes — Parser.fpi_message / urn_message map them to the
; ParserMessages entries the reference passes back via the MessageType1*&
; out-params of PublicId::init. 0 = the decomposition succeeded.
define FPI_ERR_MISSING_FIELD: int 1
define FPI_ERR_MISSING_TEXT_CLASS_SPACE: int 2
define FPI_ERR_INVALID_TEXT_CLASS: int 3
define FPI_ERR_INVALID_LANGUAGE: int 4
define FPI_ERR_ILLEGAL_DISPLAY_VERSION: int 5
define FPI_ERR_EXTRA_FIELD: int 6
define URN_ERR_MISSING_FIELD: int 1
define URN_ERR_MISSING_PREFIX: int 2
define URN_ERR_INVALID_NID: int 3
define URN_ERR_INVALID_NSS: int 4

define ExternalId
(
    has_public: bool
    public_id: String
    has_system: bool
    system_id: String
    ; ExternalId::effectiveSystemId_ — the FULL formal-system-identifier text
    ; generateSystemId stamps after the catalog consult (`<OSFILE>path` for a
    ; resolved entry or the declared system id against the declaring source's
    ; directory; `<CATALOG PUBLIC="pub"><OSFILE>cat` for a DELEGATE hit).
    ; The ESIS f-record prints it verbatim.
    has_effective: bool
    effective_system: String
    public_type: int
    text_class: int
    owner_type: int
    unavailable: bool
    have_display_version: bool
    fpi_error: int
    urn_error: int
    owner_start: size_t
    owner_len: size_t
    desc_start: size_t
    desc_len: size_t
    lang_start: size_t
    lang_len: size_t
)
{
    init() linked

    init(has_public: bool, public_id: String, has_system: bool, system_id: String) linked

    ; Heap-allocate a copy on `host`, DEEP-COPYING both identifier strings onto it.
    ; An ExternalId parsed out of a declaration holds Strings built off the
    ; parser's transient literal buffer — storing it in an entity that is only
    ; referenced LATER (an external text entity) needs them pinned to the run page,
    ; exactly like InternalEntity.make pins the entity name and replacement text.
    ; (The DOCTYPE external subset consumes its ExternalId immediately and so never
    ; noticed; a DTD declaring several entities corrupted all but the last.)
    function make(host: ref[Page], id: ExternalId) returns ref[ExternalId] linked

    function get_public_id(this: ExternalId) @page true @direct true returns String linked

    function get_system_id(this: ExternalId) @page true @direct true returns String linked

    function has_public_id(this: ExternalId) returns bool linked

    function has_system_id(this: ExternalId) returns bool linked

    ; ExternalId::setSystem — the system identifier arrives AFTER the public id
    ; has been classified; a setter keeps the classification intact.
    procedure set_system(mutable this: ref[ExternalId], s: String) linked

    function get_effective_system(this: ExternalId) @page true @direct true returns String linked

    function has_effective_system(this: ExternalId) returns bool linked

    ; ExternalId::setEffectiveSystem (generateSystemId's result).
    procedure set_effective_system(mutable this: ref[ExternalId], s: String) linked

    ; a copy with the effective system id stamped — the Entity union rebuilds
    ; its variant around this (no in-place mutation of union payload fields).
    procedure with_effective(mutable id: ExternalId, s: String) @page true @direct true returns ExternalId linked

    function get_public_type(this: ExternalId) returns int linked

    function get_text_class(this: ExternalId) returns int linked

    function get_owner_type(this: ExternalId) returns int linked

    function get_unavailable(this: ExternalId) returns bool linked

    function get_have_display_version(this: ExternalId) returns bool linked

    function get_fpi_error(this: ExternalId) returns int linked

    function get_urn_error(this: ExternalId) returns int linked

    ; PublicId::getOwner/getDescription/getDesignatingSequence — byte offsets
    ; into the public id (valid only when the id classified as an FPI).
    procedure get_owner_bytes(this: ExternalId, mutable out_start: ref[size_t], mutable out_len: ref[size_t]) returns bool linked

    procedure get_description_bytes(this: ExternalId, mutable out_start: ref[size_t], mutable out_len: ref[size_t]) returns bool linked

    procedure get_designating_sequence_bytes(this: ExternalId, mutable out_start: ref[size_t], mutable out_len: ref[size_t]) returns bool linked

    ; ---- PublicId classification (ExternalId.cxx:47-332) -------------------
    ; The reference works Char-wise through CharsetInfo::execToDesc/descToUniv;
    ; the port's internal charset is identity over ASCII and minimum literals
    ; are minimum data, so byte-wise comparison is equivalent.

    ; PublicId::init — run both decompositions; initFpi first, initUrn second
    ; (a string valid as both classifies as urn, like the reference).
    procedure classify_public(mutable this: ref[ExternalId]) linked

    ; PublicId::nextField — fields are separated by TWO seps for an FPI
    ; ("//", dup true) and ONE (':', dup false) for a URN. *next / *has_next
    ; carry the scan state (the reference encodes exhaustion as next == 0);
    ; the field lands in *field_start / *field_len. Returns false when the
    ; previous field was the last one.
    procedure next_field(buf: Slice[u8], sep: u8, dup: bool, mutable next: ref[size_t], mutable has_next: ref[bool], mutable field_start: ref[size_t], mutable field_len: ref[size_t]) returns bool linked

    function is_alpha_byte(c: u8) returns bool linked

    function is_digit_byte(c: u8) returns bool linked

    function is_alnum_byte(c: u8) returns bool linked

    ; a-f / A-F / 0-9 (the URN NSS %-escape digits).
    function is_hex_byte(c: u8) returns bool linked

    ; the URN NSS "other" characters: ( ) + , - . : = @ ; $ _ ! * '
    function is_nss_other_byte(c: u8) returns bool linked

    function field_word_eq(buf: Slice[u8], start: size_t, len: size_t, s: Slice[char]) returns bool linked

    ; PublicId::lookupTextClass over the textClasses table; TC_NONE = no match.
    function lookup_text_class(buf: Slice[u8], start: size_t, len: size_t) returns int linked

    ; PublicId::initFpi (ExternalId.cxx:185). Returns 0 or an FPI_ERR_* code;
    ; assigns the scalar fields as it goes, exactly like the reference (a later
    ; failure leaves the earlier assignments in place — type stays informal).
    procedure classify_fpi(mutable this: ref[ExternalId]) returns int linked

    ; PublicId::initUrn (ExternalId.cxx:62). Returns 0 or a URN_ERR_* code.
    ; The nid/nss substrings are validated but not stored (see header note).
    function classify_urn(this: ref[ExternalId]) returns int linked

    function test() returns int linked

    ; heap-construct + classify a PUBLIC-only id (test/probe convenience —
    ; classify_public needs a pointer receiver).
    procedure make_classified(host: ref[Page], mutable pub: String) returns ref[ExternalId] linked
}
