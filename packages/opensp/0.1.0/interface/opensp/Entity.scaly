use scaly.memory.Page
use opensp.StringC.StringC
use opensp.ExternalId.ExternalId
use opensp.Location.Location
use opensp.Location.InputSource
use opensp.Location.Origin
use opensp.AttributeList.AttributeList
use opensp.Notation.Notation
use opensp.EntityCatalog.EntityCatalog
use opensp.EntityCatalog.CatalogParser
use opensp.EntityManager.EntityManager
use opensp.Storage.Storage
use opensp.CodingSystem.CodingSystem

; Entities and entity stacking — EntityDecl.cs / Entity.cs.
;
; Stage-2 scope: the two entity kinds whose reference PUSHES an input source —
; InternalTextEntity (in-memory text) and ExternalTextEntity (resolved through
; the catalog + entity manager). Data entities (cdata/sdata/ndata/subdoc emit
; events instead of stacking), the DeclType/DataType breadth, and the parser-
; side recursion guard land with the parser stages. `stack()` is the
; normalReference path: it returns the pushed InputSource, whose origin carries
; the reference Location (so nested-source location tracking, Stage 1, works).

define DT_SGML: int 0
define DT_PI: int 1
define DT_CDATA: int 2
define DT_SDATA: int 3
define DT_NDATA: int 4
define DT_SUBDOC: int 5

define InternalEntity (name: StringC, text: StringC, data_type: int, var def_locs: Slice[Location])
{
    init(name: StringC, text: StringC, data_type: int) linked








    ; Heap-allocate an InternalEntity on `host`, DEEP-COPYING the name onto the
    ; host page so it does not alias the parser's transient folded-token buffer.
    function make(host: ref[Page], name: StringC, text: StringC, data_type: int) @ret_explicit_0 true @deep true returns ref[InternalEntity] linked





    ; Text::charLocation backing (InternalEntity::text_'s per-char locations,
    ; parallel to `text`): EntityOrigin::defLocation maps an offset inside the
    ; replacement text back to the literal source through this buffer — the
    ; -e (open-entities) reporter option anchors messages there. An empty
    ; view = untracked (predefined/SGML-declaration/driver-synthesized
    ; entities); the walk then reports "(invalid location)", like a reference
    ; Text built from location-less addChars.
    procedure set_def_locs(mutable this: ref[InternalEntity], locs: Slice[Location]) @deep true @deep_this_2 true @deep_whole_2 true linked


    ; the per-char location view the -e reporter walks (ParserState.scaly);
    ; one Location per char of `text`, so its length is the text's size.
    function get_def_locs(this: InternalEntity) @page true @direct true @ret_param_0 true @deep true returns Slice[Location] linked


    function get_name(this: InternalEntity) @page true @direct true @ret_param_0 true @deep true returns StringC linked


    function get_text(this: InternalEntity) @page true @direct true @ret_param_0 true @deep true returns StringC linked


    function get_data_type(this: InternalEntity) @ret_param_0 true @deep true returns int linked

}

; base_dir: the directory a relative SYSTEM id resolves against — captured at
; DECLARATION time (the file the <!ENTITY> is in), since the entity's content is
; opened later, after that file has been popped off the input stack. Mirrors
; PosixStorageManager::resolveRelative(base = the declaring file's directory).
; def_location: EntityDecl::defLocation_ — where the entity was declared (or, for
; an undefined entity, where it was first referenced). ExternalTextEntity::
; normalReference passes it as the auxiliary "entity was defined here" location of
; nonExistentEntityRef when the entity has no effective system id.
define ExternalTextEntity (name: StringC, external_id: ExternalId, base_dir: String, def_location: Location)
{
    init(name: StringC, external_id: ExternalId, base_dir: String, def_location: Location) linked







    function get_name(this: ExternalTextEntity) @page true @direct true @ret_param_0 true @deep true returns StringC linked


    function get_external_id(this: ExternalTextEntity) @page true @direct true @ret_param_0 true @deep true returns ExternalId linked


    function get_base_dir(this: ExternalTextEntity) @page true @direct true @ret_param_0 true @deep true returns String linked


    function get_def_location(this: ExternalTextEntity) @page true @direct true @ret_param_0 true @deep true returns Location linked

}

; ExternalDataEntity — an external CDATA/SDATA/NDATA entity. Referenced in
; content it emits an ExternalDataEntityEvent (never stacks); as an ENTITY
; attribute value it is what makeSemantics admits. `notation` is the (possibly
; still undefined) Notation from lookupCreateNotation; `attributes` the entity's
; data-attribute list (built at declaration time from the notation's attribute
; definitions). Both are borrowed references into LATER modules, which the
; `use` clauses at the top of this file bridge.
define ExternalDataEntity (name: StringC, external_id: ExternalId, base_dir: String, def_location: Location, data_type: int, notation: ref[Notation]?, attributes: ref[AttributeList]?)
{
    init(name: StringC, external_id: ExternalId, base_dir: String, def_location: Location, data_type: int, notation: ref[Notation]?, attributes: ref[AttributeList]?) linked










    function get_name(this: ExternalDataEntity) @page true @direct true @ret_param_0 true @deep true returns StringC linked


    function get_external_id(this: ExternalDataEntity) @page true @direct true @ret_param_0 true @deep true returns ExternalId linked


    function get_base_dir(this: ExternalDataEntity) @page true @direct true @ret_param_0 true @deep true returns String linked


    function get_def_location(this: ExternalDataEntity) @page true @direct true @ret_param_0 true @deep true returns Location linked


    function get_data_type(this: ExternalDataEntity) @ret_param_0 true @deep true returns int linked


    function get_notation(this: ExternalDataEntity) @ret_param_0 true @deep true returns ref[Notation]? linked


    function get_attributes(this: ExternalDataEntity) @ret_param_0 true @deep true returns ref[AttributeList]? linked

}

; SubdocEntity — an external SGML-subdocument entity. Its content reference
; (the sub-parse) is the SUBDOC feature axis; declaration and ENTITY-attribute
; semantics (isDataOrSubdoc) are modeled here.
define SubdocEntity (name: StringC, external_id: ExternalId, base_dir: String, def_location: Location)
{
    init(name: StringC, external_id: ExternalId, base_dir: String, def_location: Location) linked







    function get_name(this: SubdocEntity) @page true @direct true @ret_param_0 true @deep true returns StringC linked


    function get_external_id(this: SubdocEntity) @page true @direct true @ret_param_0 true @deep true returns ExternalId linked


    function get_base_dir(this: SubdocEntity) @page true @direct true @ret_param_0 true @deep true returns String linked


    function get_def_location(this: SubdocEntity) @page true @direct true @ret_param_0 true @deep true returns Location linked

}

define Entity union
(
    Internal: InternalEntity
    ExternalText: ExternalTextEntity
    ExternalData: ExternalDataEntity
    Subdoc: SubdocEntity
)
{
    ; EntityDecl::name — used to key the DTD's entity tables (StringC).
    function get_name(this: Entity) @page true @direct true @deep true returns StringC linked













    ; The Internal arm's per-char replacement-text locations (an empty view
    ; for the external arms and for untracked internal text) —
    ; EntityOrigin::defLocation input for the -e reporter walk.
    function internal_def_locs(this: Entity) @page true @direct true @ret_param_0 true @deep true returns Slice[Location] linked









    ; The Internal arm's replacement-text length (0 for external arms) — the
    ; def_locs buffer bound for the -e walk's charLocation extrapolation.
    function internal_text_size(this: Entity) @ret_param_0 true @deep true returns size_t linked









    ; Entity::asExternalEntity — whether this entity carries an ExternalId
    ; (generateSystemId only applies to external entities).
    function is_external(this: Entity) @ret_nonlocal true @deep true returns bool linked







    ; the declaring source's directory of an external entity (empty for
    ; internal ones) — generateSystemId's expandSystemId base.
    function get_base_dir(this: Entity) @page true @direct true @deep true returns String linked











    ; the external id of an external entity (an empty id for internal ones).
    function get_external_id(this: Entity) @page true @direct true @deep true returns ExternalId linked











    ; the notation of an external data entity (null for every other kind) —
    ; checkDtd's notation-defined sweep and the ESIS writer read it.
    function get_data_notation(this: Entity) @ret_param_0 true @deep true returns ref[Notation]? linked







    ; the data ATTRIBUTES of an external data entity (an AttributeList; null for
    ; every other kind) — Entity::asExternalDataEntity()->attributes(), which the
    ; grove hands out as the entity class's `attributes` named node list.
    function get_data_attributes(this: Entity) @ret_param_0 true @deep true returns ref[AttributeList]? linked







    ; Entity::asExternalDataEntity() as a PREDICATE. Asked instead of
    ; `get_data_notation() <> null` because the notation is what the caller is
    ; about to REPLACE (ArcProcessor.munge_data_entity) — a data entity whose
    ; notation slot happened to be null would then be silently skipped.
    function is_external_data(this: Entity) @ret_nonlocal true @deep true returns bool linked







    ; ExternalDataEntity::setNotation(notation, atts) — ArcProcessor::
    ; mungeDataEntity (ArcEngine.cxx:960) re-points a COPY of a document data
    ; entity at the architecture's own notation and its mapped data attributes,
    ; so the architectural stream declares `E<name> CDATA <arch notation>`.
    ; Rebuilt around a fresh payload for the same reason as
    ; set_effective_system: no in-place mutation of a choose-bound variant.
    procedure set_data_notation(mutable this: ref[Entity], notation: ref[Notation]?, atts: ref[AttributeList]?) @deep true @deep_this_6 true @deep_whole_6 true linked









    ; EntityDecl::dataType — the declared data type (DT_*). The external TEXT
    ; arm is sgmlText and the subdoc arm subdoc by construction; the grove's
    ; `entity-type` property maps these onto its own EntityType enum.
    function data_type(this: Entity) @deep true returns int linked











    ; Entity::asInternalEntity()->string() — an INTERNAL entity's replacement
    ; text (the grove's `text` property; the external arms have none, which
    ; is_external above distinguishes).
    function internal_text(this: Entity) @page true @direct true @ret_param_0 true @deep true returns StringC linked







    ; EntityDecl::defLocation — the declaration's MDO (or, for an undefined
    ; entity, its first reference site).
    function get_def_location(this: Entity) @page true @direct true @deep true returns Location linked











    ; Entity::isDataOrSubdoc — what an ENTITY attribute value may name
    ; (EntityDeclaredValue::makeSemantics): internal CDATA/SDATA entities
    ; (InternalDataEntity minus PI), every ExternalNonTextEntity (external
    ; CDATA/SDATA/NDATA) and subdocument entities. PI and (internal or
    ; external) SGML-text entities are NOT data.
    function is_data_or_subdoc(this: Entity) @ret_nonlocal true @deep true returns bool linked




















    ; Entity::copy() + setName(name) — the defaulted-entity clone (ParserState::
    ; lookupEntity's default-entity consult copies the default entity and renames
    ; it after the referenced name). The name is DEEP-COPIED onto the host page;
    ; every other field is shared (the port's entities are immutable after
    ; definition, so structural sharing is safe).
    procedure copy_with_name(mutable this: Entity, host: ref[Page], mutable name: StringC) @ret_caller true @deep true returns ref[Entity] linked



































    ; Entity::generateSystemId's result — stamp the effective system id into
    ; the stored external id. The union payload is rebuilt around the modified
    ; ExternalId copy (no in-place mutation of a choose-bound variant). `eff`
    ; must already be pinned to the entity's page.
    procedure set_effective_system(mutable this: ref[Entity], eff: String) @deep true @deep_this_2 true @deep_whole_2 true linked



















    ; normalReference: produce the input source this entity pushes. `origin`
    ; carries the reference location. Internal entities stack their own text;
    ; external entities resolve through the catalog and open via the manager.
    ; (cat/storage/cs/em are unused for the Internal arm.)
    procedure stack(mutable this: Entity, mutable cat: EntityCatalog, mutable storage: Storage, cs: CodingSystem, em: EntityManager, origin: ref[Origin]) @page true @direct true @deep true returns InputSource io linked
















    procedure test() @ret_nonlocal true @deep true returns int io linked











































































}
