; Tokens — the lexer token constants (Token.cs). Token is u32.
;
; tokenUnrecognized MUST be 0; tokenEe = end of entity; 2..12 are the
; character/separator classes; 13..60 are the delimiters and delimiters-in-
; context the recognizer emits; short references start at tokenFirstShortref.
; Module-level constants are visible unqualified to sibling opensp modules.

define tokenUnrecognized: u32 0
define tokenEe: u32 1
define tokenS: u32 2
define tokenRe: u32 3
define tokenRs: u32 4
define tokenSpace: u32 5
define tokenSepchar: u32 6
define tokenNameStart: u32 7
define tokenDigit: u32 8
define tokenLcUcNmchar: u32 9
define tokenChar: u32 10
define tokenCharDelim: u32 11
define tokenIgnoredChar: u32 12
define tokenAnd: u32 13
define tokenCom: u32 14
define tokenCroDigit: u32 15
define tokenCroNameStart: u32 16
define tokenDsc: u32 17
define tokenDso: u32 18
define tokenDtgc: u32 19
define tokenDtgo: u32 20
define tokenEroNameStart: u32 21
define tokenEroGrpo: u32 22
define tokenEtago: u32 23
define tokenEtagoNameStart: u32 24
define tokenEtagoTagc: u32 25
define tokenEtagoGrpo: u32 26
define tokenGrpc: u32 27
define tokenGrpo: u32 28
define tokenHcroHexDigit: u32 29
define tokenLit: u32 30
define tokenLita: u32 31
define tokenMdc: u32 32
define tokenMdoNameStart: u32 33
define tokenMdoMdc: u32 34
define tokenMdoCom: u32 35
define tokenMdoDso: u32 36
define tokenMinus: u32 37
define tokenMinusGrpo: u32 38
define tokenMscMdc: u32 39
define tokenNet: u32 40
define tokenNestc: u32 41
define tokenOpt: u32 42
define tokenOr: u32 43
define tokenPero: u32 44
define tokenPeroNameStart: u32 45
define tokenPeroGrpo: u32 46
define tokenPic: u32 47
define tokenPio: u32 48
define tokenPlus: u32 49
define tokenPlusGrpo: u32 50
define tokenRefc: u32 51
define tokenRep: u32 52
define tokenRni: u32 53
define tokenSeq: u32 54
define tokenStago: u32 55
define tokenStagoNameStart: u32 56
define tokenStagoTagc: u32 57
define tokenStagoGrpo: u32 58
define tokenTagc: u32 59
define tokenVi: u32 60
define tokenFirstShortref: u32 61
