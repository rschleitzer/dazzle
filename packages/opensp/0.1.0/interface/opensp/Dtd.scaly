use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.ElementType.ElementType
use opensp.ElementType.RankStem
use opensp.ShortReferenceMap.ShortReferenceMap
use opensp.Syntax.Syntax
use opensp.Notation.Notation
use opensp.Entity.Entity
use opensp.Entity.InternalEntity
use opensp.AttributeList.AttributeDefinitionList

; Dtd — Dtd.cs (451 LOC). The Document Type Definition: the run's central table
; of element types, entities (general + parameter), notations, rank stems, and
; shortref maps, plus the shortref-string interning table and the index
; allocators that hand out dense indices for element types / definitions /
; current attributes / attribute-definition lists.
;
; PORT SHAPE: page-hosted flat struct (one region per run). C++'s
; NamedTable / NamedResourceTable (hash-bucket keyed on the object's Named name)
; are ported as flat Array-of-pointers keyed by StringC name with a LINEAR SCAN.
; The C++ tables use a hash for scale; this increment builds + unit-tests the
; construction/lookup API on small hand-built DTDs (the perf path is the
; Parser increment's concern, where real corpus DTDs are parsed). Iteration
; order is insertion order (C++'s is hash-bucket order) — not semantically
; load-bearing for lookups. `remove` tombstones the slot (Array cannot shrink);
; lookups skip null slots.
;
; ENTITY TABLE KEYING: C++ splits general vs parameter entities into two tables;
; lookupEntity/removeEntity already take `isParameter` explicitly, and only
; insertEntity derives it from declType(). Our Entity union stays FOLDED (no
; shared EntityDecl base — the notation increment's open decision, resolved
; here: staying folded), so insert_entity ALSO takes `is_parameter` explicitly
; (the parser knows it — it parsed the `%`). Faithful to the two-table split.

define Dtd
(
    var name: StringC
    var is_base: bool
    var is_instantiated: bool
    var general_entity_table: ref[Array[ref[Entity]?]]
    var parameter_entity_table: ref[Array[ref[Entity]?]]
    var default_entity: ref[Entity]?
    var element_type_table: ref[Array[ref[ElementType]?]]
    var rank_stem_table: ref[Array[ref[RankStem]?]]
    var short_reference_map_table: ref[Array[ref[ShortReferenceMap]?]]
    var notation_table: ref[Array[ref[Notation]?]]
    var shortrefs: ref[Array[StringC]]
    var n_current_attribute: size_t
    var n_element_definition: size_t
    var n_attribute_definition_list: size_t
    var n_element_type: size_t
    var document_element_type: ref[ElementType]
    var implicit_element_attribute_def: ref[AttributeDefinitionList]?
    var implicit_notation_attribute_def: ref[AttributeDefinitionList]?
)
{
    ; Dtd(const StringC &name, Boolean isBase).
    function make(host: ref[Page], name: StringC, is_base: bool) @ret_explicit_0 true @deep true returns ref[Dtd] linked

























    function get_name(this: Dtd) @page true @direct true @ret_param_0 true @deep true returns StringC linked


    ; ---- element types (NamedTable<ElementType>) -------------------------
    function lookup_element_type(this: Dtd, name: StringC) @ret_param_0 true @deep true returns ref[ElementType]? linked
















    ; insert — replace an existing same-name entry (returning the old one) or
    ; append (returning null), mirroring NamedTable::insert.
    procedure insert_element_type(mutable this: ref[Dtd], e: ref[ElementType]) @persists true @ret_param_0 true @deep true @deep_this_2 true @deep_whole_2 true returns ref[ElementType]? linked





















    procedure remove_element_type(mutable this: ref[Dtd], name: StringC) @ret_param_0 true @deep true returns ref[ElementType]? linked



















    ; size_t nElementTypeIndex() — index 0 is reserved for #pcdata.
    function n_element_type_index(this: Dtd) @ret_nonlocal true @deep true returns size_t linked


    procedure alloc_element_type_index(mutable this: ref[Dtd]) @ret_nonlocal true @deep true returns size_t linked






    ; the raw element-type table (Dtd::ElementTypeIter) — checkDtd walks it to give
    ; every element type declared only by reference its undefined definition.
    ; Slots emptied by remove_element_type read back null.
    function n_element_types(this: Dtd) @ret_param_0 true @deep true returns size_t linked


    function get_element_type_at(this: Dtd, i: size_t) @ret_param_0 true @deep true returns ref[ElementType]? linked


    function get_document_element_type(this: Dtd) @ret_param_0 true @deep true returns ref[ElementType]? linked


    ; ---- entities (NamedResourceTable<Entity>, split param/general) ------
    function lookup_entity(this: Dtd, is_parameter: bool, name: StringC) @ret_param_0 true @deep true returns ref[Entity]? linked




















    ; insertEntity(entity, replace) — C++ routes by declType(); we take
    ; is_parameter explicitly (see file header). Without replace, an existing
    ; same-name entry wins (returned unchanged); with replace it is overwritten.
    procedure insert_entity(mutable this: ref[Dtd], entity: ref[Entity], is_parameter: bool, replace: bool) @deep true @deep_this_2 true @deep_whole_2 true returns ref[Entity] linked




























    procedure remove_entity(mutable this: ref[Dtd], is_parameter: bool, name: StringC) @ret_param_0 true @deep true returns ref[Entity]? linked























    function get_default_entity(this: Dtd) @ret_param_0 true @deep true returns ref[Entity]? linked


    ; setDefaultEntity — the LPD/defaulted-entity fan-out (copy the default into
    ; every general entity flagged `defaulted`) needs the live ParserState and
    ; the entity-decl `defaulted` flag, so it lands with the parser stage; here
    ; we record the default pointer (the common case).
    procedure set_default_entity(mutable this: ref[Dtd], entity: ref[Entity]) @deep true @deep_this_2 true @deep_whole_2 true linked


    ; ---- table iteration (checkDtd's entity/notation sweeps) --------------
    ; INSERTION order; the reference's NamedTableIter yields BUCKET order —
    ; the caller (check_dtd_notations) re-derives that with an IdTable.
    function n_entities(this: Dtd, is_parameter: bool) @ret_param_0 true @deep true returns size_t linked






    function entity_at(this: Dtd, is_parameter: bool, i: size_t) @ret_param_0 true @deep true returns ref[Entity]? linked






    function n_notations(this: Dtd) @ret_param_0 true @deep true returns size_t linked


    function notation_at(this: Dtd, i: size_t) @ret_param_0 true @deep true returns ref[Notation]? linked


    ; ---- notations (NamedResourceTable<Notation>) ------------------------
    function lookup_notation(this: Dtd, name: StringC) @ret_param_0 true @deep true returns ref[Notation]? linked
















    procedure insert_notation(mutable this: ref[Dtd], nt: ref[Notation]) @persists true @deep true @deep_this_2 true @deep_whole_2 true returns ref[Notation] linked








    procedure remove_notation(mutable this: ref[Dtd], name: StringC) @ret_param_0 true @deep true returns ref[Notation]? linked



















    ; ---- rank stems (NamedTable<RankStem>) -------------------------------
    function lookup_rank_stem(this: Dtd, name: StringC) @ret_param_0 true @deep true returns ref[RankStem]? linked
















    procedure insert_rank_stem(mutable this: ref[Dtd], e: ref[RankStem]) @persists true @deep true @deep_this_2 true @deep_whole_2 true returns ref[RankStem] linked








    function n_rank_stem(this: Dtd) @ret_param_0 true @deep true returns size_t linked


    ; ---- shortref maps (NamedTable<ShortReferenceMap>) -------------------
    function lookup_short_reference_map(this: Dtd, name: StringC) @ret_param_0 true @deep true returns ref[ShortReferenceMap]? linked
















    procedure insert_short_reference_map(mutable this: ref[Dtd], map: ref[ShortReferenceMap]) @persists true @deep true @deep_this_2 true @deep_whole_2 true returns ref[ShortReferenceMap] linked








    function n_short_reference_maps(this: Dtd) @ret_param_0 true @deep true returns size_t linked


    function short_reference_map_at(this: Dtd, i: size_t) @ret_param_0 true @deep true returns ref[ShortReferenceMap]? linked


    ; ---- shortref string table -------------------------------------------
    ; find_shortref — index of an interned shortref string, or -1.
    function find_shortref(this: Dtd, str: StringC) @ret_param_0 true @deep true returns int linked












    ; addNeededShortref / the interning half of shortrefIndex: append-if-absent,
    ; return the index. (Syntax::isValidShortref validation is driven by the
    ; parser and lands with it; this is the pure table op.)
    procedure intern_shortref(mutable this: ref[Dtd], str: StringC) @persists true @ret_param_0 true @deep true @deep_this_2 true @deep_whole_2 true returns size_t linked









    ; Dtd::shortrefIndex (Dtd.cxx:30): the FULL reference op — an already
    ; interned string returns its index; a new one is interned only if the
    ; syntax admits it as a shortref delimiter (else false, and the caller
    ; reports unknownShortrefDelim).
    procedure shortref_index(mutable this: ref[Dtd], str: StringC, syn: Syntax, mutable out_index: ref[size_t]) @persists true @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true returns bool linked















    function n_shortref(this: Dtd) @ret_param_0 true @deep true returns size_t linked


    function shortref(this: Dtd, i: size_t) @page true @direct true @ret_param_0 true @deep true returns StringC linked


    ; ---- index allocators -------------------------------------------------
    procedure alloc_current_attribute_index(mutable this: ref[Dtd]) @ret_param_0 true @deep true returns size_t linked






    function get_n_current_attribute(this: Dtd) @ret_param_0 true @deep true returns size_t linked


    procedure alloc_element_definition_index(mutable this: ref[Dtd]) @ret_param_0 true @deep true returns size_t linked






    function get_n_element_definition(this: Dtd) @ret_param_0 true @deep true returns size_t linked


    procedure alloc_attribute_definition_list_index(mutable this: ref[Dtd]) @ret_param_0 true @deep true returns size_t linked






    function get_n_attribute_definition_list(this: Dtd) @ret_param_0 true @deep true returns size_t linked


    ; ---- base / instantiation / implicit attribute defs ------------------
    function get_is_base(this: Dtd) @ret_param_0 true @deep true returns bool linked


    function get_is_instantiated(this: Dtd) @ret_param_0 true @deep true returns bool linked


    procedure instantiate(mutable this: ref[Dtd]) @deep true linked


    function get_implicit_element_attribute_def(this: Dtd) @ret_param_0 true @deep true returns ref[AttributeDefinitionList]? linked


    procedure set_implicit_element_attribute_def(mutable this: ref[Dtd], def: ref[AttributeDefinitionList]?) @deep true @deep_this_2 true @deep_whole_2 true linked


    function get_implicit_notation_attribute_def(this: Dtd) @ret_param_0 true @deep true returns ref[AttributeDefinitionList]? linked


    procedure set_implicit_notation_attribute_def(mutable this: ref[Dtd], def: ref[AttributeDefinitionList]?) @deep true @deep_this_2 true @deep_whole_2 true linked


    function test() @ret_nonlocal true @deep true returns int linked

































































































































































}
