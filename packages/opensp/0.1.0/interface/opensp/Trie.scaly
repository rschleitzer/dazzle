use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC

; Trie + TrieBuilder — the recognizer's decision tree (Trie.cs / TrieBuilder.cs).
;
; A Trie node has one child per EquivCode (`next`, an array of n_codes child
; Nodes, or null at a leaf) plus the token/length/priority recognized at that
; node. TrieBuilder threads each delimiter's code sequence into the tree
; (`extend`/`force_next`) and stamps the token with longest-match / priority
; arbitration (`set_token`), recording lexical ambiguities. `recognize_ee`
; installs the end-of-entity transition on code 0.
;
; PORT SHAPE: the C++ Trie/BlankTrie pair is flattened to one page-hosted
; `TrieNode` struct (as with ContentToken's graph) mutated through a pointer via
; plain `.`. Priority is a u8: data=0, function=2, delim=255 (Priority.cs).
;
; SHORTREF B-SEQUENCE (landed with the Dtd increment, which brings shortrefs):
; the BlankTrie machinery (`recognize_b`/`do_b`/`copy_into` + the blank fields).
; A "B" in a shortref delimiter matches a run of blank characters; the trie
; hangs a BlankTrie off a node (`blank`) that, once entered, scans up to
; `max_blanks_to_scan` blank codes (those flagged in `code_is_blank`) before
; matching the delimiter's continuation. It is reached ONLY when compiling
; shortref delimiters against a DTD; the plain mode recognizers never build one,
; so `blank` stays null and the recognizer takes the plain path.

define PRI_DATA: u8 0
define PRI_FUNCTION: u8 2
define PRI_DELIM: u8 255

; Priority::blank(n) = n + function — a longer B-sequence outranks a shorter.
function pri_blank(n: int) @ret_nonlocal true returns u8 linked


define TrieNode
(
    var token: u32
    var token_length: u8
    var priority: u8
    n_codes: int
    var next: Slice[ref[TrieNode]?]          ; array[n_codes] of child TrieNode, or empty
    var blank: ref[TrieNode]?                 ; the BlankTrie subtree, or null
    ; BlankTrie fields (meaningful only on a node reached via `blank`):
    var additional_length: u8            ; delimiter chars consumed before the B-run
    var max_blanks_to_scan: size_t       ; upper bound on blanks in the run
    var code_is_blank: Slice[u8]         ; per-EquivCode 0/1 blank flags, or empty
)
{
    function has_next(this: TrieNode) @ret_param_0 true returns bool linked


    ; const Trie *next(int i)
    function child(this: TrieNode, i: int) @ret_param_0 true returns ref[TrieNode]? linked







    function get_token(this: TrieNode) @ret_param_0 true returns u32 linked


    function get_token_length(this: TrieNode) @ret_param_0 true returns int linked


    function get_blank(this: TrieNode) @ret_param_0 true returns ref[TrieNode]? linked


    ; Boolean includeBlanks() const { return Priority::isBlank(priority_); }
    function include_blanks(this: TrieNode) @ret_param_0 true returns bool linked


    ; BlankTrie accessors.
    function get_additional_length(this: TrieNode) @ret_param_0 true returns int linked


    function get_max_blanks_to_scan(this: TrieNode) @ret_param_0 true returns size_t linked


    function code_is_blank_at(this: TrieNode, i: int) @ret_param_0 true returns bool linked





}

define TrieBuilder @resident true (root: ref[TrieNode], n_codes: int)
{
    init(n_codes: int) linked







    function new_node(host: ref[Page], n_codes: int) @ret_explicit_0 true returns ref[TrieNode] linked








    function extract_trie(this: TrieBuilder) @ret_param_0 true returns ref[TrieNode] linked


    ; void recognize(const String<EquivCode> &chars, Token, Priority, ambiguities)
    procedure recognize(mutable this: TrieBuilder, mutable codes: Slice[u16], token: u32, priority: u8, mutable amb: ref[Array[u32]]?) @ret_nonlocal true linked





    ; void recognize(chars, set, Token, Priority, ambiguities): each set char
    ; forms a one-longer delimiter-in-context.
    procedure recognize_set(mutable this: TrieBuilder, mutable codes: Slice[u16], set_codes: Slice[u16], token: u32, priority: u8, mutable amb: ref[Array[u32]]?) linked











    ; void recognizeEE(EquivCode code, Token t)
    procedure recognize_ee(mutable this: TrieBuilder, code: u16, token: u32) linked







    procedure extend_trie(mutable this: TrieBuilder, mutable start: ref[TrieNode]?, codes: Slice[u16]) @page true @direct true @ret_param_1 true returns ref[TrieNode]? linked











    ; void setToken(Trie *, int tokenLength, Token, Priority, ambiguities)
    procedure set_token(this: TrieBuilder, mutable trie: ref[TrieNode], token_length: int, token: u32, pri: u8, mutable amb: ref[Array[u32]]) linked























    ; Trie *forceNext(Trie *trie, EquivCode c) — materialize the child array,
    ; inheriting this node's token/length/priority into each child. When `trie`
    ; carries a BlankTrie, it is pushed down: its length/scan bounds are advanced
    ; by one, it is moved into the first blank-code child (deep-copied into the
    ; rest), and its token structure is copied back via copy_into.
    procedure force_next(mutable this: TrieBuilder, mutable trie: ref[TrieNode], c: u16) @page true @direct true @ret_param_1 true returns ref[TrieNode]? linked












































    ; A full recursive TrieNode-subtree copy (C++ new BlankTrie(other)) — used when a
    ; BlankTrie has to be shared into more than one blank-code child. code_is_blank
    ; is immutable after construction, so the flag buffer is shared.
    function copy_node(this: TrieBuilder, host: ref[Page], from: ref[TrieNode]) @ret_caller true returns ref[TrieNode] linked
























    ; void copyInto(Trie *into, const Trie *from, int additionalLength) — graft
    ; `from`'s token structure onto `into`, adding additionalLength to lengths.
    procedure copy_into(mutable this: TrieBuilder, mutable into: ref[TrieNode]?, from: ref[TrieNode], additional_length: int) linked



















    ; void recognizeB(chars, bSequenceLength, maxBlankSequence, blankCodes,
    ;                 chars2, Token, ambiguities) — a shortref delimiter with an
    ; embedded "B" (blank run) of length >= bSequenceLength, up to
    ; maxBlankSequence, followed by chars2.
    procedure recognize_b(mutable this: TrieBuilder, mutable codes: Slice[u16], b_sequence_length: int, max_blank_sequence: size_t, blank_codes: Slice[u16], mutable chars2: Slice[u16], token: u32, mutable amb: ref[Array[u32]]?) @ret_nonlocal true linked





    procedure do_b(mutable this: TrieBuilder, mutable trie: ref[TrieNode], token_length: int, min_b_length: int, max_length: size_t, blank_codes: Slice[u16], mutable chars2: Slice[u16], token: u32, pri: u8, mutable amb: ref[Array[u32]]?) linked





















































    function test() @ret_nonlocal true returns int linked









































































































}
