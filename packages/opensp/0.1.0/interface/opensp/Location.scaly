use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.CodingSystem.CodingSystem
use opensp.Entity.Entity
use scaly.memory.runtime.fread
use scaly.memory.runtime.fclose
use scaly.memory.runtime.fopen

; stdio seek for the streaming raw window (SourceFill.ensure_raw). Through the
; eio shim rather than libc's fseek: that one carries a `long` offset, which is
; 32-bit on Win64, and one committed seed serves every target, so a single
; declaration cannot describe both (check 4 of tests/abi/run.sh). The whence
; argument is the LITERAL 0 (SEEK_SET) at the call site, as EntityCatalog spells
; its 2 for SEEK_END: a module-level `define` for it would be a second strong
; symbol for a name `scaly.os.File` already defines.
function scaly_eio_seek(stream: pointer[OpaqueFile], offset: int, whence: int) returns int extern

; Source locations — Location.cs / InputSource.cs.
;
; A Location is the fundamental (origin, index) pair. An Origin is where a run
; of Chars came from; for an input source it also records refLocation_ — the
; location in the PARENT source where this source was referenced — so a
; location resolves back up through nested (pushed) sources via parent().
;
; `Origin` models InputSourceOrigin (the only origin kind the port needs); the
; rest of the C++ hierarchy (Proxy/Bracket/Replacement/NumericCharRef/Entity
; origins) is folded into it. `InputSource` covers BOTH reference forms: without
; a SourceFill it is InternalInputSource (its whole Char buffer is in memory),
; with one it is ExternalInputSource — a decoding WINDOW over its entity that
; refills a read block at a time. See SourceFill.
;
; Origins/sources are referenced by pointer and must outlive the Locations that
; point at them (one parse region — everything lives to run end). `Index` is u32.

; line_col's "no column" sentinel: the resolved position sits ON a record
; start (its RS), where onsgmls's columnNumber is 0 and printLocation omits
; the column field entirely.
define COL_OMITTED: u32 0xFFFFFFFF

; Record types (ExternalInputSource::recordType_) — how a storage object spells
; its record boundaries; `lf` translates LF to RE and INSERTS the next record's
; RS, `cr` inserts one after each CR, `crlf` and `asis` insert nothing (see the
; record-normalization comment on Parser.make_char_source). The reference's
; `unknown`/`crUnknown` states are not needed: we hold the object's bytes, so
; the type is detected once up front (Parser.detect_record_type).
define RT_LF: int 0
define RT_CRLF: int 1
define RT_CR: int 2
define RT_ASIS: int 3
; "the record type is not decided yet" — only ever seen by the streaming OPEN
; path, which detects the type from a PREFIX of the entity and falls back to
; reading the whole object when the prefix holds no record boundary at all.
define RT_UNKNOWN: int -1

; The most raw bytes any of the port's coding systems consumes for ONE Char
; (UTF-8's four, the fixed-width systems' four, EUC's three, SJIS's two) —
; the lookahead SourceFill.ensure_raw must guarantee ahead of the cursor.
define RAW_CHAR_MAX: size_t 8

; DocSegment — one storage object of a multi-file document entity
; (EntityManagerImpl::mergeSystemIds: every file argument becomes one storage
; object of ONE entity; ExternalInfoImpl keeps the per-object boundaries).
; `start` is the segment's first index in the shared normalized buffer
; (== the previous segment's end, ExternalInfoImpl::position_[i-1].endOffset);
; `starts_with_rs` mirrors startsWithRS — the record-normalization RS pending
; at the previous file's end flushed as this segment's first char, so line
; counting subtracts it (the segment's text then starts on ITS line 1);
; `name` is the per-object actualStorageId a diagnostic in this segment
; displays; `base_dir` is the found file's directory — the base a relative
; system id in a declaration WITHIN this segment resolves against
; (FSIParser's defLoc storage object).
define DocSegment (start: size_t, starts_with_rs: bool, name: StringC, base_dir: String)
{
    init() linked
}

define Location (origin: ref[Origin]?(null), index: u32(0))
{
    init() linked

    ; ★The parameter MIRRORS the field's nullability, and it has to: the field
    ; is `ref[Origin]?`, so an init declaring a plain `ref[Origin]` matches no
    ; construction that passes a nullable origin -- `ref[T]?` IS `Option[ref[T]]`,
    ; a different type -- and the four call sites below (current_location,
    ; token_start_location, here_location, and the pinning one at line 436, all
    ; passing an `InputSource.origin` that is itself `ref[Origin]?`) fell through
    ; to the positional-tuple path with this body never running. Right only
    ; because the assignments happen to be in FIELD ORDER; silent otherwise.
    init(origin: ref[Origin]?, index: u32) linked

    function get_index(this: Location) @ret_param_0 true @deep true returns u32 linked

    function get_origin(this: Location) @ret_param_0 true @deep true returns ref[Origin]? linked

    function is_null(this: Location) @ret_param_0 true @deep true returns bool linked

    ; The location where this location's origin was referenced (walk one level
    ; up the nesting). A null-origin location's parent is itself null.
    function parent(this: Location) @page true @direct true @deep true returns Location linked
}

; Origin — Stage-1 InputSourceOrigin. ref_location is the location in the
; parent source where this source was referenced (empty for the top source).
;
; entity_decl == InputSourceOrigin::entityDecl(): the entity whose reference
; opened this source (null for the document entity / the external DTD subset).
; ParserState.entity_is_open walks the input stack comparing it by IDENTITY —
; the recursive-entity-reference guard (Entity::checkNotOpen). Entity is
; declared in a LATER module and uses Location back, so this is a reference
; cycle across the module boundary — the `use` at the top of this file is
; what carries it, and the type needs no cast at either end.
; file_name is the storage id the reference onsgmls DISPLAYS for a location in
; this source (MessageReporter::printLocation's actualStorageId): the document
; path for the top source, the system id for an external DTD subset / text
; entity. Empty when unknown; a message resolves it by walking up the origin
; chain to the nearest source that names one. Held here (not on InputSource) so
; a Location — an (origin,index) pair — can name its file without the buffer.
;
; contents/length are the resolved backing source's normalized buffer, stashed
; here (for a REAL source built by make_char_source) so a diagnostic can compute
; line/col from a location that resolves to an origin LOWER in the input stack
; than the current top input — the reference's MessageReporter resolves an
; entity-internal location up the origin chain to the enclosing source and
; prints line/col from THAT source's buffer, which is generally not the source
; being scanned. An internal-entity / parameter-entity / literal-expansion
; origin (empty file_name) leaves these null: its locations resolve up through
; parent() to a named source before line/col is ever computed. Lifting only the
; buffer pointer onto Origin keeps line_col stack-independent (data-model option
; (a) — see the origin-chain-location task) rather than searching the live stack.
; ref_length is EntityOrigin::refLength_ — the length of the reference markup
; (`&name;` / `%name;`) that opened this entity origin, captured at the reference
; site (parseCommon.cxx: currentLocation().index() + currentTokenLength() −
; startLocation.index()). MessageReporter::locationHeader adds it to the
; reference location's index when resolving a location up through this origin, so
; a diagnostic from inside the entity prints the position JUST PAST the reference
; in the enclosing source. Zero for a real backing source (no reference).
; segments — the multi-file document entity's storage-object table (null for
; every single-file source, which keeps the historical line_col path exactly).
; unopened marks an EXTERNAL source whose storage object was never opened —
; the reference's lazy-open InputSourceOrigin carries an ExternalInfo whose
; position_ table is still empty, so externalize() FAILS and printLocation
; renders "(invalid location)" WITHOUT resolving up to the reference site
; (the eager-open port needs the flag to reproduce that stop). The -e walk is
; unaffected: it prints the "In entity" header off the entity_decl first and
; then fails the anchor the same way.
; rs_list — the RS-offset list of a real backing source (ExternalInfoImpl's
; rsList_): the normalized-buffer indexes that hold a record start (0x0A),
; appended as the buffer is written. line/col is a BINARY SEARCH over it
; (convertOffset's rsList_.findPreceding), not a scan of the buffer — the scan
; it replaced was quadratic under -oline for BACKWARD queries (every AUX line
; "start tag was here" resolves a position below the last one, which defeated
; the monotonic resume cache that used to live here) and, more importantly, it
; is what pinned the whole decoded document in memory.
;
; TextChunk — one gathered run of a Text object (Text.h class Text): the chars
; [start, next chunk's start) of the gathered buffer came from `loc`. A
; TextInputSourceOrigin (DssslSpecEventHandler.cxx) resolves an offset in the
; gathered text back to the run's own source via this table (Text::charLocation).
define TextChunk (start: size_t, var loc: Location)
{
    init(start: size_t, loc: Location) linked
}

; `pinned` is the forwarding pointer of Origin.pin — see the comment there. It
; is NOT parse state: it stays null for the whole of a parse and is written
; once, by the pin, when a consumer copies this origin onto a longer-lived
; host. Kept in the record rather than in a side table because the natural key
; IS the origin's address, and an address is only unique while the arena that
; holds it lives — a side table would survive that arena and answer for a
; recycled address.
define Origin (var ref_location: Location, var entity_decl: ref[Entity]?(null), var file_name: StringC, var contents: pointer[u32](null), var length: size_t(0), var ref_length: size_t(0), var rs_list: ref[Array[u32]]?(null), var segments: ref[Array[DocSegment]]?(null), var unopened: bool(false), var text_chunks: ref[Array[TextChunk]]?(null), var fill_bounds: ref[Array[size_t]]?(null), var has_text: bool(false), var pinned: ref[Origin]?(null), var entity_marked: bool(false))
{
    init() linked

    init(ref_location: Location) linked

    init(ref_location: Location, entity_decl: ref[Entity]?) linked

    ; EntityOrigin::make(entity, refLocation, refLength, markup): an entity origin
    ; carrying the length of the reference that opened it (for location resolution).
    init(ref_location: Location, entity_decl: ref[Entity]?, ref_length: size_t) linked

    ; EntityOrigin::make(entity, Location()) for a cross-package caller (the
    ; dazzle spec handler's CONTENT= entity body) — a same-package `sizeof
    ; Origin` construction cannot be written there (the S50 cross-package
    ; sizeof trap).
    function make_entity_origin(host: ref[Page], entity_decl: ref[Entity]?) @ret_explicit_0 true @deep true returns ref[Origin] linked

    ; TextInputSourceOrigin::TextInputSourceOrigin(Text &) — an origin over
    ; gathered text whose per-chunk table maps offsets back to the sources the
    ; chunks were gathered from (defLocation → Text::charLocation).
    function make_text(host: ref[Page], chunks: ref[Array[TextChunk]]?) @ret_explicit_0 true @deep true returns ref[Origin] linked

    ; --- pinning a location onto a longer-lived host -----------------------
    ;
    ; ★A Location is an (origin, index) pair, and an origin lives on the arena
    ; of the PARSE that produced it. Every consumer that keeps a location past
    ; its parse — the DSSSL spec handler keeps one per gathered text chunk, so
    ; a runtime diagnostic in the assembled Scheme resolves back into the
    ; original `.dsl`/`.scm` line — must therefore COPY the chain onto its own
    ; host first. pin() is that copy, and it is a copy of the chain, because
    ; resolve_chain walks parent() up to the first origin with a real backing
    ; source and reads line/col off THAT one.
    ;
    ; What is copied is exactly what a POST-parse reader touches: file_name,
    ; length, ref_length, unopened, has_text, rs_list, segments, fill_bounds
    ; (line_col + file_name_at + on_segment_leading_rs) and the parent chain.
    ; Two fields are deliberately NOT carried over, and both would be a stale
    ; pointer into the released arena rather than data:
    ;   * `contents` — the whole decoded buffer. line_col computes off rs_list
    ;     alone; the only readers of get_contents() are the parse itself (the
    ;     catalog sub-parse and the InputSource clone). Dropped to null, which
    ;     is exactly the shape a STREAMING source already has.
    ;   * `entity_decl` — an Entity on the parse arena. The one post-parse
    ;     reader needs the PROPERTY, not the entity (resolve_chain's index
    ;     arithmetic: an entity origin re-anchors past the reference, a plain
    ;     one adds through), so the copy carries `entity_marked` and leaves the
    ;     pointer null — see is_entity_origin. The parse-side walk that really
    ;     does dereference it (resolve_location_open's "In entity" header)
    ;     never sees a pinned origin, and would get a null it already handles
    ;     if it ever did.
    ;
    ; The memo is the `pinned` field of the SOURCE origin (a forwarding
    ; pointer): the chunk table of one body element holds hundreds of thousands
    ; of locations over a few thousand distinct origins, so the lookup has to be
    ; O(1), and the field dies with the arena it lives on — which is the only
    ; correct lifetime for a memo keyed on an address. A pinned copy forwards to
    ; ITSELF, so pinning an already-pinned location is the identity.
    procedure pin(host: ref[Page], mutable o: ref[Origin]?) @page true @direct true @deep true returns ref[Origin]? linked

    ; ★The forwarding-pointer HIT is the hot half — one gathered body element
    ; pins hundreds of thousands of chunk locations over a few thousand
    ; distinct origins — so it lives here, in a body small enough to inline,
    ; and only the miss calls the copy. (One construction of the returned
    ; Location, per the small-struct return rule.)
    procedure pin_location(host: ref[Page], mutable loc: Location) @page true @direct true @deep true returns Location linked

    function get_text_chunks(this: Origin) @ret_param_0 true @deep true returns ref[Array[TextChunk]]? linked

    ; resolve_chain — the parser-free half of ParserState.resolve_location (the
    ; MessageReporter::locationHeader origin walk): resolve `loc` up the origin
    ; chain to the first origin with a real backing source and compute its
    ; line/col. The dazzle style engine reports interpreter diagnostics through
    ; this walk (its Messenger has no parser input stack to fall back to — an
    ; unresolvable chain returns null and the caller renders the reference's
    ; "(invalid location)"). Adds the TextInputSourceOrigin arm: a text origin
    ; maps the offset through its chunk table to the chunk's own source
    ; (defLocation → Text::charLocation) and the walk continues from there.
    ; Keep the walk arms in step with resolve_location — that body is byte-
    ; validated by the onsgmls corpus and stays untouched (it can never see a
    ; text origin: only gathered style-specification bodies build one).
    procedure resolve_chain(loc: Location, rs_next_line: bool, mutable out_line: ref[u32], mutable out_col: ref[u32], mutable out_index: ref[size_t]) @ret_param_0 true @deep true returns ref[Origin]? linked

    function is_unopened(this: Origin) @ret_param_0 true @deep true returns bool linked

    procedure set_unopened(mutable this: ref[Origin]) @deep true linked

    ; Origin.parent() == InputSourceOriginImpl.parent() => refLocation_.
    function parent(this: Origin) @page true @direct true @ret_param_0 true @deep true returns Location linked

    function get_entity_decl(this: Origin) @ret_param_0 true @deep true returns ref[Entity]? linked

    ; "this origin was opened by an entity reference" — the property, as
    ; opposed to the entity itself. A PINNED origin (Origin.pin) has the
    ; property without the pointer: its Entity lives on the released parse
    ; arena, and the only post-parse reader of the field is the index
    ; arithmetic in resolve_chain, which needs the bit and not the entity.
    ; So the copy carries the bit and leaves entity_decl NULL — a later
    ; reader that does dereference it (resolve_location_open's "In entity"
    ; walk, which is parse-side and never sees a pinned origin) then gets a
    ; null it must already handle, not freed memory.
    function is_entity_origin(this: Origin) @ret_param_0 true @deep true returns bool linked

    function get_ref_location(this: Origin) @page true @direct true @ret_param_0 true @deep true returns Location linked

    function get_ref_length(this: Origin) @ret_param_0 true @deep true returns size_t linked

    function get_file_name(this: Origin) @page true @direct true @ret_param_0 true @deep true returns StringC linked

    procedure set_file_name(mutable this: ref[Origin], name: StringC) @deep true @deep_this_2 true @deep_whole_2 true linked

    ; the normalized buffer as a view — `contents` paired with `length`, so
    ; a reader never spells the pair itself (the window fields stay a pointer
    ; and a length: the scan cursor walks them by arithmetic).
    function get_contents(this: Origin) @page true @direct true @ret_param_0 true @deep true returns Slice[u32] linked

    ; the normalized buffer's length — 0 for an EMPTY entity, which never got
    ; its synthetic leading RS (make_char_source flushes it before the first
    ; Char only). The column-omission rule keys on this: index 0 of a
    ; non-empty buffer sits ON the inserted RS (columnNumber 0 — onsgmls
    ; omits the column), while index 0 of an empty buffer is a real position
    ; rendered as column 0 (`file:1:0:E: end of document in prolog`).
    function get_buf_length(this: Origin) @ret_param_0 true @deep true returns size_t linked

    ; make_char_source hands the finished normalized buffer to its origin so a
    ; resolved location can be turned into line/col without the InputSource.
    ; The RS-offset list arrives WITH the buffer, never separately: line_col
    ; reads line/col out of the list alone, so a buffer without one would
    ; silently report every position as line 1.
    procedure set_buffer(mutable this: ref[Origin], buf: Slice[u32], rs: ref[Array[u32]]) @deep true @deep_this_6 true @deep_whole_4 true linked

    ; the STREAMING counterpart of set_buffer: a windowed source has text but no
    ; whole buffer, so `contents` stays null and `length` grows with each fill.
    ; The two tables arrive empty and are appended to as the entity decodes.
    procedure set_stream(mutable this: ref[Origin], rs: ref[Array[u32]], bounds: ref[Array[size_t]]) @deep true @deep_this_6 true @deep_whole_6 true linked

    ; how far the entity has been decoded (the reference's bufLimOffset_ seen
    ; from the origin). Never shrinks within one pass.
    procedure note_decoded(mutable this: ref[Origin], n: size_t) @deep true linked

    ; noteRS: `idx` holds a record start. Called by fill for every 0x0A it
    ; wrote — collected by a scan of the freshly written window range, for the
    ; same reason build_rs_list scans (the `crlf` record type deletes a trailing
    ; record start again, and finished bytes cannot disagree with themselves).
    procedure append_rs(mutable this: ref[Origin], idx: size_t) @persists true @deep true linked

    procedure note_bound(mutable this: ref[Origin], idx: size_t) @persists true @deep true linked

    ; rewind (ExternalInputSource::rewind, which installs a FRESH
    ; ExternalInfoImpl): the pass-2 re-parse decodes the entity again from the
    ; start, so both tables and the decoded length start over. Their contents
    ; are a function of the bytes alone, so pass 2 rebuilds them identically.
    procedure reset_text(mutable this: ref[Origin]) @ret_nonlocal true @deep true linked

    function get_rs_list(this: Origin) @ret_param_0 true @deep true returns ref[Array[u32]] linked

    ; whether this origin HAS a backing source at all — the reference's
    ; `externalInfo() != 0`. The origin-chain walks resolve a location to the
    ; first origin that answers true; an internal-entity / parameter-entity /
    ; literal-expansion origin answers false and its locations resolve one
    ; level up. This is deliberately NOT "get_contents() <> null": a streaming
    ; source holds only a WINDOW of its entity, so it has text without having
    ; the whole buffer.
    function get_has_text(this: Origin) @ret_param_0 true @deep true returns bool linked

    ; The normalized-buffer indexes where the reference's ExternalInputSource
    ; would have started a fresh read block (fill() reads 8192 raw bytes at a
    ; time) — a data token never crosses one (extendData stops at the buffer
    ; end), which is observable through the grove's data-chunk boundaries.
    procedure set_fill_bounds(mutable this: ref[Origin], bounds: ref[Array[size_t]]?) @deep true @deep_this_2 true @deep_whole_2 true linked

    function get_fill_bounds(this: Origin) @ret_param_0 true @deep true returns ref[Array[size_t]]? linked

    ; ---- the multi-file storage-object table (mergeSystemIds) --------------
    procedure set_segments(mutable this: ref[Origin], segs: ref[Array[DocSegment]]?) @deep true @deep_this_2 true @deep_whole_2 true linked

    function has_segments(this: Origin) @ret_param_0 true @deep true returns bool linked

    ; the storage object `index` sits in: the LAST segment whose start is
    ; <= index — an empty segment (equal starts) is never selected, exactly
    ; like ExternalInfoImpl::convertOffset's `off >= endOffset` skip.
    function segment_index_at(this: Origin, index: size_t) @ret_nonlocal true @deep true returns size_t linked

    ; the actualStorageId a diagnostic at `index` displays — the segment's
    ; found path for a multi-file document, the origin's single storage id
    ; otherwise.
    function file_name_at(this: Origin, index: size_t) @page true @direct true @ret_param_0 true @deep true returns StringC linked

    ; the directory a relative system id in a declaration at `index` resolves
    ; against (the defLoc storage object's base). Empty when unsegmented —
    ; the caller falls back to its stored base.
    function base_dir_at(this: Origin, index: size_t) @page true @direct true @ret_param_0 true @deep true returns String linked

    ; the multi-file analogue of the buffer-index-0 rule: the position sits ON
    ; a segment's leading INSERTED RS — line 1, columnNumber 0 of its storage
    ; object, so printLocation omits the column.
    function on_segment_leading_rs(this: Origin, index: size_t) @ret_nonlocal true @deep true returns bool linked

    ; the first RS-list position whose offset is >= `v` (findPreceding's binary
    ; search). Answers the list LENGTH when every offset is smaller.
    function rs_lower_bound(this: Origin, v: size_t) @ret_nonlocal true @deep true returns size_t linked

    ; line/col of the char at `index` in this origin's entity — the same
    ; RS-counting rule as InputSource.line_col (see there), computed from the
    ; RS-offset list so a diagnostic resolving to this origin (which may be
    ; below the current top input, and whose chars may already have left the
    ; window) prints the position onsgmls prints.
    ;
    ; `rs_next_line` selects onsgmls's rendering of an index sitting ON an
    ; inserted RS (a record-start position — e.g. refLocation+refLength of an
    ; entity referenced by a shortref whose delimiter is the RE):
    ;   false — a MAIN message: the previous record's line, col one past its
    ;           RE (verified: `9:9:E: document type does not allow ...`);
    ;   true  — an AUX line (`start tag was here`): the line the RS opens,
    ;           columnNumber 0 → COL_OMITTED (verified: `file:10: start ...`).
    ;
    ; ★A pushed-back char (`&#RS;` — push_char_ref) needs no exclusion list any
    ; more: it OVERWRITES a dead slot in the shared buffer AFTER normalization,
    ; so it never enters the RS list, where the scan this replaced saw it and
    ; had to skip it explicitly. The reverse hazard — a push overwriting a slot
    ; that IS in the list, which would leave a stale record start — cannot
    ; happen: the overwritten slot holds the last char the reference consumed
    ; (refMode recognizes REFC `;` and RE 0x0D only, and a zero-length refMode
    ; token leaves a NAME char there), never an RS.
    procedure line_col(this: Origin, index: size_t, rs_next_line: bool, mutable out_line: ref[u32], mutable out_col: ref[u32]) @deep true linked
}

; SourceFill — the streaming half of an InputSource (ExternalInputSource's
; decoder + read-block state). A source WITHOUT one is the reference's
; InternalInputSource: its whole Char buffer is in memory already and fill()
; answers end-of-entity. WITH one, the source holds only a WINDOW of its
; entity — fill() decodes the next read block of raw bytes into the window,
; record-normalizes them and slides the window forward, so a 13 MB document
; costs one window plus an RS-offset list instead of 4 bytes per char (plus the
; same again in worst-case reserve) for the whole text.
;
; The two one-shot pre-passes stay OUTSIDE, in Parser: `resolve_input`'s decoder
; split (cs_first up to switch_at, cs_rest after, raw_start bytes skipped for a
; BOM / XML declaration) and the record type. Both need CodingSystemKit, which
; is declared AFTER this module; everything fill() itself needs is a plain
; CodingSystem method.
;
; `raw` must OUTLIVE the source — the entity is decoded from it for the whole
; parse, not once at open time.
; `next_bound` is the next RAW BYTE offset that opens a read block, counted
; from byte 0 of the object (not from raw_start), because that is where the
; reference's fill() boundaries fall; the origin's fill_bounds records the
; normalized index each block starts at.
;
; --- the two RAW shapes -------------------------------------------------------
; `raw` is either the WHOLE entity in memory (`fp` null: an internal entity, a
; literal, stdin, a merged multi-file document) or a WINDOW of a file that stays
; on disk (`fp` non-null: PosixStorageObject::read). In the in-memory shape
; raw_base is 0 and raw_valid is raw_len, so every index below is an entity
; offset that indexes `raw` directly — that is why the decode loop reads
; identically for both.
; In the file shape `raw` is a reusable window (its `length` is the capacity) holding
; raw_valid bytes of the entity starting at entity offset raw_base; ensure_raw
; slides it. `path` is kept so a REWIND can reopen the entity after fp was
; closed at end of entity (the fd is not held for the whole parse — a document
; with hundreds of external entities would otherwise run the process out).
define SourceFill (host: ref[Page], raw: Slice[u8], raw_len: size_t, raw_start: size_t, var raw_pos: size_t, cs_first: CodingSystem, switch_at: size_t, cs_rest: CodingSystem, rt: int, var pending: bool, block: size_t, var next_bound: size_t, var win_cap: size_t, var fp: pointer[OpaqueFile], path: String, var raw_base: size_t, var raw_valid: size_t)
{
    init(host: ref[Page], raw: Slice[u8], raw_len: size_t, raw_start: size_t, raw_pos: size_t, cs_first: CodingSystem, switch_at: size_t, cs_rest: CodingSystem, rt: int, pending: bool, block: size_t, next_bound: size_t, win_cap: size_t, fp: pointer[OpaqueFile], path: String, raw_base: size_t, raw_valid: size_t) linked

    ; Make the entity bytes at [pos, pos+want) present in the raw window,
    ; clipped to the entity end. A NO-OP for an in-memory source: its window IS
    ; the entity, so the caller's guard never fires. For a file source this is
    ; PosixStorageObject::read — one seek + one buffer fill; the buffer is
    ; several read blocks wide so a per-block fill() does not mean a syscall per
    ; block.
    procedure ensure_raw(mutable this: ref[SourceFill], pos: size_t, want: size_t) @deep true io linked

    ; End of entity: give the descriptor back (the reference's StorageObject dies
    ; with the input source). Idempotent — fill() reaches the end once, but a
    ; rewound source can end again.
    ; A source ABANDONED before its end (`-p` stops after the prolog; an error
    ; limit ends the parse) keeps its descriptor until the process exits. That is
    ; bounded by the number of entities open at once, not by their count, because
    ; every entity a parse actually finishes closes here.
    procedure close_raw(mutable this: ref[SourceFill]) @deep true io linked
}

; InputSource — in-memory Char buffer with an origin. current_location(index)
; is the Location of the char at `index`; char_at reads it. (Stage 2 adds the
; streaming fill()/get() cursor and record normalization.)
;
; Increment-B scanner cursor (InputSource.cs): the Recognizer scans a token by
; repeatedly advancing `cur_index` (`token_char`), then commits the recognized
; length with `end_token`. `start_token_no_multicode` marks the token start
; (the reference syntax is single-code, so the multicode/scanSuppress path is
; not needed). `token_char` yields the signed end-of-entity sentinel eE (-1)
; past the buffer end — the recognizer maps eE to equiv code 0 (tokenEe).
; ALL indexes on an InputSource are ABSOLUTE entity offsets (they ARE Location
; indexes). `contents` is the window, `win_start` the absolute index of its
; first slot, so a char lives at `contents + (index - win_start)`. An in-memory
; source has win_start 0 and a window that spans the whole entity, which is why
; every access below reads identically for it.
define InputSource (origin: ref[Origin]?(null), var contents: pointer[u32](null), var length: size_t(0), var start_index: size_t(0), var cur_index: size_t(0), var end_index: size_t(0), var start_loc_index: u32(0), var win_start: size_t(0), var fill_st: ref[SourceFill]?(null))
{
    init(origin: ref[Origin]?, buf: Slice[u32]) linked

    ; the EMPTY source -- an entity whose text is missing or vanished between
    ; two passes: no buffer, every index 0. This is the `(null, 0)` pair the
    ; buffer init used to be handed; a `Slice` has no null to hand.
    init(origin: ref[Origin]?) linked

    ; page-hosted factory — cross-package callers (the dazzle SchemeParser
    ; reads through InputSources) must allocate HERE: a cross-package
    ; `sizeof InputSource` at the call site miscompiles (the S50 lesson).
    function make(host: ref[Page], origin: ref[Origin]?, buf: Slice[u32]) @ret_explicit_0 true @deep true returns ref[InputSource] linked

    ; ExternalInputSource: a source that decodes its entity on demand. Nothing
    ; is decoded here — the first get/token_char fills the window. `raw_start`
    ; is the first byte to decode (past a BOM or the XML declaration the guessed
    ; decoder already read), `rt` the record type, `block` the storage object's
    ; read-block size. See SourceFill for why the pre-passes are the caller's.
    procedure make_stream(host: ref[Page], mutable origin: ref[Origin]?, raw: Slice[u8], raw_start: size_t, cs_first: CodingSystem, switch_at: size_t, cs_rest: CodingSystem, rt: int, block: size_t) @ret_explicit_0 true @deep true returns ref[InputSource] linked

    ; ...and the FILE-backed form: the entity stays on disk and `raw` is a
    ; reusable window (`raw.length` bytes) already holding `raw_valid` bytes from
    ; offset 0 (the prefix the caller read for the decoder/record-type
    ; pre-passes). `path` lets a rewind reopen after end of entity closes fp.
    procedure make_stream_file(host: ref[Page], mutable origin: ref[Origin]?, raw: Slice[u8], raw_valid: size_t, raw_len: size_t, fp: pointer[OpaqueFile], path: String, raw_start: size_t, cs_first: CodingSystem, switch_at: size_t, cs_rest: CodingSystem, rt: int, block: size_t) @ret_explicit_0 true @deep true returns ref[InputSource] linked

    ; rewind + re-get (maybeStartPass2's ExternalInputSource::rewind): a FRESH
    ; source over the same entity, positioned at `index`. A streaming source
    ; re-decodes from the start to get there (`pass2StartOffset` chars, exactly
    ; the reference's route — which is also why no byte<->char offset table is
    ; needed); an in-memory one just moves its cursor.
    procedure make_rewound(host: ref[Page], mutable old: ref[InputSource], index: size_t) @page true @direct true @ret_explicit_0 true @deep true returns ref[InputSource]? io linked

    function get_length(this: InputSource) @ret_param_0 true @deep true returns size_t linked

    function get_origin(this: InputSource) @ret_param_0 true @deep true returns ref[Origin]? linked

    ; the scan cursor's absolute buffer index — how far reading has advanced
    ; (the multi-file document's pending-open flush compares boundaries
    ; against the BOTTOM input's cursor).
    function get_cur_index(this: InputSource) @ret_param_0 true @deep true returns size_t linked

    ; the window as a view; its indexes are window-relative, so only an
    ; in-memory source (win_start 0) may index it by absolute entity offset.
    function get_contents(this: InputSource) @page true @direct true @ret_param_0 true @deep true returns Slice[u32] linked

    ; position the (fresh) source at an absolute buffer index — the pass-2
    ; rewind point (the reference rewinds the source and re-gets
    ; pass2StartOffset chars; our Location indices are absolute, so the
    ; cursor and location jump directly).
    procedure advance_to(mutable this: ref[InputSource], index: size_t) @deep true linked

    function char_at(this: InputSource, index: size_t) @deep true returns u32 linked

    ; the char at an absolute index IF it is still in the window — for the one
    ; reader that looks BACKWARD past the current token (the attribute-value
    ; adjacency check in Parser). Answers false once the chars have been decoded
    ; over; the reference, which holds no more of the entity than we do, has the
    ; same blind spot.
    procedure window_char(this: InputSource, index: size_t, mutable out_ch: ref[u32]) @ret_nonlocal true @deep true returns bool linked

    function current_location(this: InputSource, index: size_t) @page true @direct true @ret_caller true @deep true returns Location linked

    ; line/column of the char at `index` in this source's normalized buffer, for
    ; diagnostic locations (MessageReporter::printLocation). make_char_source lays
    ; each record out as an RS (0x0A, record/line start) then its data then an RE
    ; (0x0D, record end, from a source LF); the entity opens with a leading RS and
    ; the FINAL record's RS is dropped at end of entity. onsgmls numbers lines by
    ; record START, so a trailing RE does NOT advance the line (its RS was
    ; dropped) — matching real onsgmls, which reports e.g. a DOCTYPE-only document
    ; ending in one newline at line 1, two newlines at line 2:
    ;   line = number of RS (0x0A) at or before index   (leading RS => line 1)
    ;   col  = index - (position after the last RS)      0-based
    ; col is the value onsgmls prints (its 1-based columnNumber minus 1). A BOM was
    ; stripped at decode, so `index` is a decoded-Char offset, matching onsgmls's
    ; character-counted column.
    ;
    ; Only reachable for a source whose origin has no text of its own (the
    ; documented-dead pre-resolution fallback in ParserState.resolve_location):
    ; an origin WITH text answers through its RS-offset list, which is stack-
    ; independent and does not need the chars. A windowed source therefore never
    ; arrives here, and the scan below reads its own in-memory buffer.
    procedure line_col(this: InputSource, index: size_t, rs_next_line: bool, mutable out_line: ref[u32], mutable out_col: ref[u32]) @deep true linked

    ; --- token-scanning cursor (multicode=false path) ---

    ; void startTokenNoMulticode(): commit any consumed chars to the start
    ; location, then anchor the new token at the current position.
    procedure start_token_no_multicode(mutable this: InputSource) @deep true linked

    ; Xchar tokenChar(Messenger&): next char, advancing the cursor; at the end of
    ; what is decoded it fills, and eE (-1) once the entity is exhausted (fill()
    ; of an internal source returns eE straight away).
    ; The refill is a separate function on purpose: token_char is THE hot loop
    ; of the parser (one call per document char), and keeping fill out of its
    ; body keeps the fast path a load and an increment.
    procedure token_char(mutable this: InputSource) @deep true returns i32 io linked

    ; Xchar tokenCharInBuffer(Messenger &) (InputSource.h:135) — the same read
    ; WITHOUT the refill: at the window end it answers the end-of-entity
    ; sentinel instead of pulling the next block. `extendData`'s inner loop
    ; runs on this so a data run never blocks on I/O mid-scan; the caller
    ; resumes the run after the refill that the next token_char does.
    ; -1 is the eE marker XcharMap.get maps to its index-0 slot, exactly as
    ; the reference's `eE` indexes the extra slot of its XcharMap.
    procedure token_char_in_buffer(mutable this: InputSource) @deep true returns i32 linked

    procedure token_char_refill(mutable this: InputSource) @deep true returns i32 io linked

    ; fill (ExternalInputSource::fill): decode the entity's next read block into
    ; the window, record-normalize it and extend the scan limit. Returns false at
    ; end of entity — a record start still pending there is DROPPED, exactly as
    ; the reference's fill returns eE without flushing insertRS_, which is why a
    ; file ending in a newline ends with RE and not RE RS.
    ;
    ; The normalization is the same code the eager
    ; Parser.normalize_append_bounds_cs runs, one read block at a time; keep the
    ; two in step. Every write goes through `out - win_start`, and the window is
    ; sized so one block always fits after the kept prefix.
    procedure fill(mutable this: InputSource) @ret_param_0 true @deep true returns bool io linked

    ; void endToken(size_t length): the recognizer knows the matched length.
    procedure end_token(mutable this: InputSource, len: size_t) @deep true linked

    ; size_t currentTokenLength()
    function current_token_length(this: InputSource) @ret_param_0 true @deep true returns size_t linked

    function current_token_start_index(this: InputSource) @ret_param_0 true @deep true returns size_t linked

    function token_start_location(this: InputSource) @page true @direct true @ret_caller true @deep true returns Location linked

    ; currentLocation() — the location at the scan cursor (the next char to be
    ; read). ParserState.currentLocation() resolves through nested sources by
    ; walking this location's origin chain (parent()).
    function here_location(this: InputSource) @page true @direct true @ret_caller true @deep true returns Location linked

    ; currentToken() — a StringC copy of the [start_index, cur_index) slice the
    ; recognizer just committed (on the returned value's own page).
    function current_token_string(this: InputSource) @page true @direct true @ret_caller true @deep true returns StringC linked

    ; --- parser-stage cursor helpers (InputSource.cs) ---

    ; void ungetToken(): push the just-recognized token back (curIndex_ =
    ; startIndex_) so the next getToken re-scans from the token start.
    procedure unget_token(mutable this: InputSource) @deep true linked

    ; void discardInitial(): advanceStart(cur_, curIndex_ - 1) — drop the
    ; recognized delimiter prefix of a delim+nameStart token, leaving the
    ; name-start char as the token start (so extendNameToken can grow the name).
    procedure discard_initial(mutable this: InputSource) @deep true linked

    ; Char currentChar(): the first Char of the current token (currentTokenStart).
    function current_char(this: InputSource) @deep true returns u32 linked

    ; void startToken(): advanceStart(cur_, curIndex_) — anchor a fresh token at
    ; the current cursor (used after an RNI delimiter to read the name after it).
    procedure start_token(mutable this: InputSource) @deep true linked

    ; pushCharRef (InternalInputSource.cxx:34 / ExtendEntityManager.cxx:1045):
    ; re-inject the char a named function reference (`&#RE;`) stands for, so
    ; it is scanned as an ordinary source char — RE/RS re-tokenize through the
    ; normal record machinery (verified vs real onsgmls: `<doc>&#RE;</doc>`
    ; suppresses it as the first RE, `x&#RE;` drops it as the trailing RE,
    ; `x&#RE;y` keeps it — plain re-tokenization, no special-casing). Called
    ; with cur == start just past the consumed reference (the reference
    ; ASSERTs it); the slot before holds the ref's last consumed char (REFC or
    ; RE), dead to the scanner, so stepping back and overwriting it is the
    ; index-model equivalent of the reference's moveLeft()+insert. The
    ; reference leaves location indexes unshifted and corrects file offsets
    ; through the origin's NamedCharRef table; our buffer index IS the
    ; location index, so all three cursors step back together and later
    ; locations stay correct by construction. The overwrite edits the shared
    ; origin buffer, so a pushed RS (10) from `&#RS;` would read as a line
    ; boundary to a line_col that SCANNED the buffer, and would shift line/col
    ; of LATER positions (probed: a `&#RS;`-led SHORTREF pushed every -oline L
    ; record one line high). line_col reads the origin's RS-offset list now,
    ; which is written by the NORMALIZER — a pushed char is never in it, so the
    ; exclusion list this used to maintain is gone (see Origin.note_rs for why
    ; the reverse, a push over a listed RS, cannot happen).
    procedure push_char_ref(mutable this: InputSource, c: u32) @deep true linked

    function test() @ret_nonlocal true @deep true returns int linked
}
