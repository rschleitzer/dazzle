use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String

; Options<AppChar> — include/Options.h + Options.cxx, the att_getopt-derived
; option scanner CmdLineApp::processOptions drives. It never prints: get()
; reports problems through signal chars the caller renders —
;   '?'  unknown option / missing argument (opt() = the short char, or 0 for
;        a long option whose name the caller extracts from argv)
;   '-'  ambiguous long-option prefix
;   '='  a long option that does not take an argument got one
; Long options match on UNIQUE PREFIX (`--max-err 5`); `--` ends the options;
; clustered short options (`-egn`) advance sp through one argv cell.

; One registered option (LongOption<T>): the long name (empty = short-only),
; the option char processOption receives, and whether it takes an argument.
; (The reference's separate `key` field only blanks non-alnum chars for
; search(); every onsgmls option char is alnum, so value doubles as key.)
define LongOpt
(
    name: String
    value: u32
    has_argument: bool
)
{
    init(name: String, value: u32, has_argument: bool) linked





}

define Options
(
    argc: int
    argv: pointer[pointer[char]]
    ind: int
    sp: size_t
    opt: u32
    arg: pointer[char]
    opt_ind: int
    opts: ref[Array[LongOpt]]
)
{
    function make(host: ref[Page], argc: int, argv: pointer[pointer[char]], opts: ref[Array[LongOpt]]) returns ref[Options] linked





    ; optarg / optopt / optind accessors.
    function get_arg(this: Options) returns pointer[char] linked


    function get_opt(this: Options) returns u32 linked


    function get_ind(this: Options) returns int linked


    ; Options::search — short-option lookup; sets opt_ind.
    procedure search(mutable this: ref[Options], c: u32) returns bool linked

















    ; Options::searchLong — true on a unique match (exact beats prefix); false
    ; with opt_ind >= 0 means AMBIGUOUS, opt_ind < 0 means unknown. On a match
    ; sp is left at the index of the char ending the name ('\0' or '=').
    procedure search_long(mutable this: ref[Options], a: pointer[char]) returns bool linked










































    ; Options::get — the scanner step. Returns false when no options remain
    ; (ind then points at the first non-option argument).
    procedure get(mutable this: ref[Options], mutable out_c: ref[u32]) returns bool linked



































































































    ; ---- self-test ---------------------------------------------------------
    function test() returns int linked





}
