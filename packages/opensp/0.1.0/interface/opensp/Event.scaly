use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.Location.Location
use opensp.Entity.Entity
use opensp.ElementType.ElementType
use opensp.AttributeList.AttributeList
use opensp.Lpd.Lpd
use opensp.Lpd.LinkSet
use opensp.Lpd.SourceLinkRule
use opensp.ParserState.ParserState

; Event — the parser's output stream (Event.cs / Event.h). Clark's C++ has a
; deep virtual Event hierarchy (StartElementEvent/EndElementEvent/DataEvent/…)
; dispatched by an EventHandler; the Nsgmls app turns that stream into ESIS.
;
; PORT SHAPE: a single page-hosted FLAT TAGGED struct keyed by `event_type`
; (the same shape ContentToken.CmNode / the Attribute hierarchy use for mutable
; pointer-linked graphs). Events are immutable value records the parser appends
; to a queue (ParserState.events, an Array[pointer[Event]]) in document order;
; an event-dump / ESIS writer walks the queue. This replaces the C++ eventQueue
; + eventHandler indirection: the parser calls ps.queue_event(...) directly.
;
; STAGE 4 INCREMENT 1: the content events (startElement/endElement/characterData)
; the well-formed instance path produces. DEFERRED (later increments / Stage 5):
; the markup/declaration events (startDtd/endProlog/pi/entityStart/…), attribute
; payloads on start events, and the full Markup capture (wantInstanceMarkup).

define EV_START_ELEMENT: int 0
define EV_END_ELEMENT: int 1
define EV_DATA: int 2
define EV_PI: int 3
; APPINFO minimum literal from the SGML declaration (AppinfoEvent)
define EV_APPINFO: int 5
define EV_ENTITY_REF: int 4
; SUBDOC entity reference in content (SubdocEntityEvent): brackets the nested
; sub-parse's events. The writer emits the subdoc entity's definition records
; (once per document) then `{name`; END emits `}name`. Both carry the entity.
define EV_START_SUBDOC: int 6
define EV_END_SUBDOC: int 7
; EndPrologEvent (LINK axis): carries the ACTIVE complex LPD (or null) that
; initializes the writer-side link process, and the active simple LPDs'
; names + finished attribute lists (printed as `a<linkname> ...` records).
define EV_END_PROLOG: int 8
; SDATA entity reference in content (SdataEntityEvent): the entity's
; replacement text, written INLINE into the surrounding data run between
; `\|` markers (SgmlsEventHandler::sdataEntity — startData(), not flushData()).
define EV_SDATA: int 9
; CommentDeclEvent: a comment declaration's comment segments (one StringC per
; `--…--` pair). Queued from parse_comment_decl only when -ocomment enabled;
; the writer prints `_<text>` per segment, but only once the prolog has ended
; (the reference's inDocument_ gate).
define EV_COMMENT: int 10
; NonSgmlCharEvent: a numeric char ref in content denoting a declared NON-SGML
; char — data holds the single char; -ononsgml renders `\%N;` inline in the
; data run, the default output drops it silently.
define EV_NONSGML: int 11
; EntityDefaultedEvent + the found-entity re-dispatch (ParserState::lookupEntity
; fires entityDefaulted for EVERY successful lookup outside the pass-2-prolog
; special case — probed: -oentity re-prints `Ifoo …` at each `&foo;`). Queued
; only when -oentity is on; the writer flushes the data run and re-emits the
; entity's definition (no markEntity consult — reference behavior).
define EV_ENTITY_DEFAULTED: int 12
; UselinkEvent (LINK axis, RAST only): a USELINK declaration changed the active
; complex LPD's current link set — link_set_after snapshots the post-uselink
; set (LinkSets are immutable once the prolog ends, so the pointer suffices).
; Queued only in RAST mode; the ESIS writer never sees one.
define EV_USELINK: int 13

; SgmlsEventHandler output flags (SgmlsEventHandler.h — octal in the
; reference): the -o option axis. outputAll = 07777 (posfix excluded there
; too). The driver mirrors these as ONS_OF_* (cross-package defines are not
; visible to a program).
define OF_LINE: u32 0x1
define OF_ENTITY: u32 0x2
define OF_ID: u32 0x4
define OF_INCLUDED: u32 0x8
define OF_NOTATION_SYSID: u32 0x10
define OF_NONSGML: u32 0x20
define OF_EMPTY: u32 0x40
define OF_DATA_ATT: u32 0x80
define OF_COMMENT: u32 0x100
define OF_TAG_OMISSION: u32 0x200
define OF_ATTR_OMISSION: u32 0x400
define OF_PARSER_INFO: u32 0x800
define OF_ALL: u32 0xFFF

; --- EventAux: the payload only a handful of event kinds ever carry --------
; ★★★A FLAT RECORD PAYS ITS WIDEST KIND FOR EVERY VALUE — the same lesson the
; `Insn` union and `ELObj` already paid for, here on the PARSE side, where it is
; the dominant class rather than a rounding error. Measured 2026-08-08:
; a DSSSL spec parse of the DocBook
; print stylesheet queues 445 317 events and frees none of them until exit, and
; the Event record was 176 bytes of which a character-data event — 99 % of the
; population — used forty. These ten fields are what made it that wide:
; nine pointers and a bool that only EV_COMMENT, EV_END_PROLOG and the LINK /
; RAST axes ever touch. Behind one pointer the record is 96 bytes.
;
; The reference has no such problem: openjade/OpenSP has a real Event class
; hierarchy (ImmediateDataEvent, StartElementEvent, EndPrologEvent, …), so each
; kind is sized for itself. This is the flat-struct port shape catching up.
;
; Materialised on demand (Event.need_aux) on the Event's OWN page, so the aux
; has exactly the Event's lifetime — which matters because the parser hands
; events out on `ps.event_host()`, an exclusive scratch page in the streaming
; parse and the run page otherwise.
define EventAux
(
    ; EV_COMMENT: the declaration's comment segments.
    var comments: ref[Array[StringC]]?
    ; EV_END_PROLOG under -oentity: the DTD's general entities in the
    ; reference's NamedTable bucket order (the endProlog define sweep).
    var general_entities: ref[Array[ref[Entity]?]]
    ; LINK axis — startElement: the link rule's attributes + the owning LPD's
    ; name (the `a<lpdname> <att> ...` records preceding the `A` records),
    ; attached by the link process when the event is queued.
    var link_attributes: ref[AttributeList]?
    var link_owner: ref[StringC]?
    ; LINK axis — endProlog: the active complex LPD and the active simple
    ; LPDs' names/attributes.
    var end_prolog_lpd: ref[Lpd]?
    var simple_link_names: ref[Array[StringC]]?
    var simple_link_atts: ref[Array[ref[AttributeList]?]]?
    ; RAST axis — start/end element: the SELECTED link rule and the link
    ; process' current LinkSet AFTER this event (post-push on start, post-pop
    ; on end; also EV_USELINK's payload). The writer reads implied link rules
    ; / the result element spec from these.
    var link_rule: ref[SourceLinkRule]?
    var link_set_after: ref[LinkSet]?
    ; RAST — start/end subdoc: whether the rast-parse-subdoc queue said to
    ; parse the referenced document.
    var subdoc_parsed: bool
    ; RAST — the child parse's ParserState (it carries the child's PI-declared
    ; active link types for the writer's #ACTIVE-LINK rendering).
    var child_ps: ref[ParserState]?
)
{
    ; A data class with no init of its own: `EventAux()` zero-fills the whole
    ; struct, which is exactly the "nothing attached yet" state.
    function make(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[EventAux] linked
}

define Event
@resident true @inplace true (
    event_type: int
    ; startElement / endElement: the element type (borrowed DTD identity).
    element_type: ref[ElementType]?
    ; entityRef (ExternalDataEntityEvent): the referenced data entity — the
    ; writer prints its definition (once) and the `&name` reference line.
    var entity: ref[Entity]?
    ; characterData: the data chars (deep-copied onto the run page).
    data: StringC
    loc: Location
    ; startElement: the MARKUP location — the STAGO of the start tag (onsgmls's
    ; markupLocation()), which is where OpenElement.startLocation comes from and
    ; what the "start tag was here" auxiliary diagnostic points at. Distinct from
    ; `loc` (captured after the GI name = the TAGC position, used by the
    ; elementNotAllowed diagnostic). Defaults to `loc` for implied / synthetic
    ; start events that have no real STAGO.
    var markup_loc: Location
    ; startElement: the specified + defaulted attribute values (null on end/data).
    var attributes: ref[AttributeList]?
    ; the LINK / RAST / declaration payload, null until something attaches one
    ; — see the width note at EventAux above. ★Keep the two bools LAST: the
    ; struct's alignment is a pointer's, so any field after them would round
    ; them up to eight bytes of their own.
    var aux: ref[EventAux]?
    ; whether this element was reached as an inclusion (ESIS "&" prefix).
    var included: bool
    ; start/end element: whether a REAL tag produced this event (the
    ; reference's markupPtr() under wantInstanceMarkup — implied/auto-generated
    ; tags carry none). -otagomit prints `o` when false.
    var has_markup: bool
)
{
    ; ---- constructors (host = the run page) ------------------------------
    function make_start(host: ref[Page], e: ref[ElementType]?, loc: Location) @ret_explicit_0 true @deep true returns ref[Event] linked

    function make_end(host: ref[Page], e: ref[ElementType]?, loc: Location) @ret_explicit_0 true @deep true returns ref[Event] linked

    ; character data — deep-copy the source chars onto the run page (the
    ; StringC^host field-assign idiom; the source points into the lexer buffer).
    function make_data(host: ref[Page], src: StringC, loc: Location) @ret_explicit_0 true @deep true returns ref[Event] linked

    ; SDATA entity text (SdataEntityEvent — InternalSdataEntity::normalReference):
    ; written inline into the data run between `\|` markers.
    function make_sdata(host: ref[Page], src: StringC, loc: Location) @ret_explicit_0 true @deep true returns ref[Event] linked

    ; processing instruction — the raw content between PIO and PIC, deep-copied
    ; onto the run page (SgmlsEventHandler::pi emits `?` + data + RE).
    ; Also carries a PI ENTITY's replacement text (PiEntityEvent is a PiEvent
    ; subclass — SgmlsEventHandler routes both through pi()).
    function make_pi(host: ref[Page], src: StringC, loc: Location) @ret_explicit_0 true @deep true returns ref[Event] linked

    ; APPINFO literal (AppinfoEvent with a literal — sdParseAppinfo).
    function make_appinfo(host: ref[Page], src: StringC, loc: Location) @ret_explicit_0 true @deep true returns ref[Event] linked

    ; external data entity reference in content (ExternalDataEntityEvent):
    ; the writer emits the entity's definition records (once per document)
    ; followed by the `&name` reference line.
    function make_entity_ref(host: ref[Page], ent: ref[Entity], loc: Location) @ret_explicit_0 true @deep true returns ref[Event] linked

    ; SubdocEntityEvent bracket events (SgmlsEventHandler::subdocEntity): the
    ; START carries the subdoc entity (writer defines it once, then `{name`),
    ; the END carries the same entity (writer emits `}name`). The nested
    ; sub-parse's events sit between them in the queue.
    function make_start_subdoc(host: ref[Page], ent: ref[Entity], loc: Location) @ret_explicit_0 true @deep true returns ref[Event] linked

    function make_end_subdoc(host: ref[Page], ent: ref[Entity], loc: Location) @ret_explicit_0 true @deep true returns ref[Event] linked

    ; EndPrologEvent (LINK axis) — see the field comment.
    function make_end_prolog(host: ref[Page], lpd: ref[Lpd]?, names: ref[Array[StringC]]?, atts: ref[Array[ref[AttributeList]?]]?, loc: Location) @ret_explicit_0 true @deep true returns ref[Event] linked

    ; CommentDeclEvent — the comment segments of one declaration; `loc` is the
    ; MDO (markupLocation()).
    function make_comment(host: ref[Page], segs: ref[Array[StringC]]?, loc: Location) @ret_explicit_0 true @deep true returns ref[Event] linked

    ; NonSgmlCharEvent — the single non-SGML char (in data), at the char ref's
    ; start location.
    function make_nonsgml(host: ref[Page], src: StringC, loc: Location) @ret_explicit_0 true @deep true returns ref[Event] linked

    ; EntityDefaultedEvent / the lookup re-dispatch — the writer re-emits the
    ; entity's definition (-oentity only; see EV_ENTITY_DEFAULTED).
    function make_entity_defaulted(host: ref[Page], ent: ref[Entity], loc: Location) @ret_explicit_0 true @deep true returns ref[Event] linked

    ; UselinkEvent (RAST only) — ls is the post-uselink current LinkSet.
    function make_uselink(host: ref[Page], ls: ref[LinkSet]?, loc: Location) @ret_explicit_0 true @deep true returns ref[Event] linked

    ; ---- accessors -------------------------------------------------------
    function get_type(this: Event) @ret_param_0 true @deep true returns int linked

    function get_entity(this: Event) @ret_param_0 true @deep true returns ref[Entity]? linked

    function get_element_type(this: Event) @ret_param_0 true @deep true returns ref[ElementType]? linked

    function get_data(this: Event) @page true @direct true @ret_param_0 true @deep true returns StringC linked

    function get_loc(this: Event) @page true @direct true @ret_param_0 true @deep true returns Location linked

    function get_markup_loc(this: Event) @page true @direct true @ret_param_0 true @deep true returns Location linked

    procedure set_markup_loc(mutable this: ref[Event], l: Location) @deep true @deep_this_2 true @deep_whole_2 true linked

    function is_included(this: Event) @ret_param_0 true @deep true returns bool linked

    procedure set_included(mutable this: ref[Event]) @deep true linked

    ; a REAL source tag produced this start/end event (markupPtr() analog).
    function get_has_markup(this: Event) @ret_param_0 true @deep true returns bool linked

    procedure set_has_markup(mutable this: ref[Event]) @deep true linked

    ; --- the rare payload -------------------------------------------------
    ; Materialise the aux on the Event's OWN page. Page.get is valid here
    ; because every make_* above allocates the Event out of a page, and using
    ; that page rather than a threaded-in host is what keeps the aux's lifetime
    ; equal to the Event's — including on the streaming parse's scratch page,
    ; which is dropped wholesale.
    procedure need_aux(mutable this: ref[Event]) @ret_param_0 true @deep true returns ref[EventAux] linked

    function get_comments(this: Event) @ret_param_0 true @deep true returns ref[Array[StringC]]? linked

    function get_general_entities(this: Event) @ret_param_0 true @deep true returns ref[Array[ref[Entity]?]]? linked

    procedure set_general_entities(mutable this: ref[Event], ge: ref[Array[ref[Entity]?]]) @deep true @deep_this_2 true @deep_whole_2 true linked

    function get_attributes(this: Event) @ret_param_0 true @deep true returns ref[AttributeList]? linked

    procedure set_attributes(mutable this: ref[Event], atts: ref[AttributeList]?) @deep true @deep_this_2 true @deep_whole_2 true linked

    ; ---- LINK axis -------------------------------------------------------
    function get_link_attributes(this: Event) @ret_param_0 true @deep true returns ref[AttributeList]? linked

    function get_link_owner(this: Event) @ret_param_0 true @deep true returns ref[StringC]? linked

    procedure set_link_attributes(mutable this: ref[Event], atts: ref[AttributeList]?, owner: ref[StringC]?) @deep true @deep_this_6 true @deep_whole_6 true linked

    ; ---- RAST axis -------------------------------------------------------
    function get_link_rule(this: Event) @ret_param_0 true @deep true returns ref[SourceLinkRule]? linked

    procedure set_link_rule(mutable this: ref[Event], r: ref[SourceLinkRule]?) @deep true @deep_this_2 true @deep_whole_2 true linked

    function get_link_set_after(this: Event) @ret_param_0 true @deep true returns ref[LinkSet]? linked

    procedure set_link_set_after(mutable this: ref[Event], ls: ref[LinkSet]?) @deep true @deep_this_2 true @deep_whole_2 true linked

    function get_subdoc_parsed(this: Event) @ret_param_0 true @deep true returns bool linked

    procedure set_subdoc_parsed(mutable this: ref[Event]) @deep true linked

    function get_child_ps(this: Event) @ret_param_0 true @deep true returns ref[ParserState]? linked

    procedure set_child_ps(mutable this: ref[Event], c: ref[ParserState]?) @deep true @deep_this_2 true @deep_whole_2 true linked

    function get_end_prolog_lpd(this: Event) @ret_param_0 true @deep true returns ref[Lpd]? linked

    function get_simple_link_names(this: Event) @ret_param_0 true @deep true returns ref[Array[StringC]]? linked

    function get_simple_link_atts(this: Event) @ret_param_0 true @deep true returns ref[Array[ref[AttributeList]?]]? linked
}
