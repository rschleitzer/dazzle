    procedure resolve_doc_file(mutable this: Parser, em_cfg: ref[EmConfig], dspec: String, mutable out_path: ref[String], mutable out_is_find: ref[bool], mutable out_detail: ref[String]) @ret_nonlocal true @deep true returns bool io linked
























































































