    ; (S*, INCLUDE or IGNORE, S*) under the instance syntax's general subst.
    function maybe_status_keyword(this: Parser, ent: ref[Entity]) @ret_nonlocal true @deep true returns bool linked





















































    ; checkDtd (parseDecl.cxx:2466-2520), the ENTITY/NOTATION halves — the
    ; element half stays with the implied-DTD check_dtd above. Runs at DOCTYPE
    ; end BEFORE the closing MDC is parsed (so a current-location message points
    ; at the DSC, verified vs real onsgmls). Two sweeps:
    ;   - every external data entity whose notation is still undefined reports
    ;     entityNotationUndefined (notation, entity) at the entity's declaration
    ;     MDO (its defLocation);
    ;   - every undefined notation that carries an attribute definition list
    ;     reports attlistNotationUndefined at the current location.
    ; Both sweeps iterate the reference's NamedTable BUCKET order, NOT
    ; declaration order (verified: zebra/mike/alpha) — re-derived by inserting
    ; the names in declaration order into an IdTable (the faithful
    ; Hash/PointerTable port) and walking its buckets. The reference's
    ; implydefNotation branch (auto-define instead of report) is unreachable:
    ; our Sd never sets IMPLYDEF NOTATION (constant, like implydef_doctype).
    ; Under WWW the reference sweeps parameter entities too.
    procedure check_dtd_notations(mutable this: Parser, mutable dtd: ref[Dtd]) @deep true io reads STDERR_ENC linked




































































































































    ; implyDtd (parseDecl.cxx) — the document has no document type declaration at
    ; all: the first thing in the prolog is the document element's start tag.
    ;
    ; Two errors, in this order (both hard — the parse continues but the document
    ; does NOT conform, so onsgmls exits 1 and writes no trailing `C`):
    ;   omittedProlog  the prolog may only be omitted with CONCUR NO, LINK EXPLICIT
    ;                  NO and IMPLYDEF ELEMENT or DOCTYPE YES. xml.dcl and the
    ;                  reference declaration say IMPLYDEF NO -> always reported.
    ;   noDtd          "no document type declaration; will parse without validation"
    ;                  — the reference reaches it when the catalog has no DTD filed
    ;                  under the document element's name. We do not wire that
    ;                  lookup: no corpus catalog declares a DOCTYPE entry, so the
    ;                  lookup would always fail and this is the only branch.
    ;
    ; Then enableImplydef: for the rest of the parse an undeclared element is
    ; implied (ANY content) rather than an error, and an undeclared attribute gets
    ; an implied CDATA definition. The DTD itself is a base Dtd named after the GI,
    ; carrying only the syntax's predefined entities.
    procedure imply_dtd(mutable this: Parser, mutable gi: StringC) @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true io reads STDERR_ENC linked






































































































    ; doProlog (scoped): skip separators, dispatch the DOCTYPE declaration, and
    ; leave the input positioned at the first instance token.
    ; prologRecover (parseDecl.cxx): after an invalid prolog character, skip
    ; ahead to something that could open a declaration / PI / the instance.
    procedure prolog_recover(mutable this: Parser) @deep true io linked











































