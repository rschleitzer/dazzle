    ; on the last specified attribute's value text.
    procedure atts_handle_as_unterminated(mutable this: Parser, atts: ref[AttributeList]) @ret_nonlocal true @deep true returns bool io reads STDERR_ENC linked


























    ; the makeSemantics half of AttributeList::finish (Attribute.cxx:1246):
