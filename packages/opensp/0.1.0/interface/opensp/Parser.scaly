; selects cannotFind vs openSystemCall, detail its %2 payload — see
; Parser.resolve_doc_file / ParserState.queue_pending_open).
define DocFileRes (found: bool, path: String, bytes: String, is_find: bool, detail: String)
{
    init() linked







}

define Parser (host: ref[Page], ps: ref[ParserState]?)
{
    function make(host: ref[Page], ps: ref[ParserState]?) @page true @direct true @deep true returns Parser linked


    ; ---- delegating helpers ----------------------------------------------
    ; (the err(N) numbered-stub helper is GONE: every reference message the
    ; ported code paths reach now renders through the generated tables.)

    ; report a message with REAL text (written to stderr, MessageReporter path).
    ; report0: no arguments; report1: one String argument, substituted for %1
    ; (String args are quoted by the formatter). `mt` is the MessageType from a
    ; GENERATED table (e.g. ParserMessages.elementNotAllowed()) — text, severity
    ; and number all sourced from the reference .msg (see *Messages.scaly).
    procedure report0(mutable this: Parser, mutable mt: MessageType) @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true io reads STDERR_ENC linked





    ; report0 at an explicit location (a captured construct location).
    procedure report0_at(mutable this: Parser, mt: MessageType, loc: Location) @ret_nonlocal true @deep true @deep_this_6 true @deep_whole_6 true io reads STDERR_ENC linked





    procedure report1(mutable this: Parser, mutable mt: MessageType, a1: StringC) @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true io reads STDERR_ENC linked






    ; report1 at an explicit location (a captured construct location).
    procedure report1_at(mutable this: Parser, mt: MessageType, a1: StringC, loc: Location) @ret_nonlocal true @deep true @deep_this_10 true @deep_whole_10 true io reads STDERR_ENC linked






    ; E2 with two String args (%1, %2, both quoted) — entityNotationUndefined.
    procedure report2_at(mutable this: Parser, mt: MessageType, a1: StringC, a2: StringC, loc: Location) @ret_nonlocal true @deep true @deep_this_18 true @deep_whole_18 true io reads STDERR_ENC linked







    ; PosixStorageManager's open-failure report, openSystemCall "cannot open %1
    ; (%2)": %1 the effective system id (quoted StringMessageArg), %2 the
    ; strerror text (unquoted — ErrnoMessageArg). Reported at the location of
    ; the reference that opened the entity (ParentLocationMessenger).
    procedure report_open_failure(mutable this: Parser, sysid: StringC, emsg: pointer[const_char], loc: Location) @ret_nonlocal true @deep true @deep_this_8 true @deep_whole_8 true io reads STDERR_ENC linked







    ; report a message whose %1 is a NUMBER (decimal, unquoted — NumberMessageArg)
    ; at an explicit location.
    procedure report_num_at(mutable this: Parser, mt: MessageType, a1: u64, loc: Location) @ret_nonlocal true @deep true @deep_this_10 true @deep_whole_10 true io reads STDERR_ENC linked






    ; E2 with %1 Number, %2 String (quoted) — numericCharRefUnknownDesc.
    procedure report_num_str_at(mutable this: Parser, mt: MessageType, a1: u64, a2: StringC, loc: Location) @ret_nonlocal true @deep true @deep_this_18 true @deep_whole_18 true io reads STDERR_ENC linked







    ; two NUMBER args (%1, %2, unquoted) — normalizedAttributeValueLength /
    ; attsplen (the limit, then the actual length).
    procedure report_num_num_at(mutable this: Parser, mt: MessageType, a1: u64, a2: u64, loc: Location) @ret_nonlocal true @deep true @deep_this_18 true @deep_whole_18 true io reads STDERR_ENC linked







    ; %1 String, %2 String, %3 StringVector (each item quoted, ", "-separated)
    ; — attributeValueNotInGroup (value, attribute name, allowed tokens).
    procedure report2_vec_at(mutable this: Parser, mt: MessageType, a1: StringC, a2: StringC, a3: ref[Array[StringC]]?, loc: Location) @ret_nonlocal true @deep true @deep_this_34 true @deep_whole_34 true io reads STDERR_ENC linked








    ; E3 with %1 Number, %2 Number, %3 String (quoted) —
    ; numericCharRefUnknownBase (doc number, base number, baseset public id).
    procedure report_num_num_str_at(mutable this: Parser, mt: MessageType, a1: u64, a2: u64, a3: StringC, loc: Location) @ret_nonlocal true @deep true @deep_this_34 true @deep_whole_34 true io reads STDERR_ENC linked








    ; E2 with both args pre-rendered (unquoted) — the *InvalidToken messages,
    ; whose args (TokenMessageArg / Allowed*MessageArg) mix quoted delimiter
    ; text with unquoted fragment text; the quotes are already IN the strings.
    procedure report_raw_raw_at(mutable this: Parser, mt: MessageType, a1: StringC, a2: StringC, loc: Location) @ret_nonlocal true @deep true @deep_this_18 true @deep_whole_18 true io reads STDERR_ENC linked







    ; E2 with %1 String (quoted), %2 pre-rendered (unquoted) —
    ; markupDeclarationCharacter / groupCharacter (char, allowed list).
    procedure report_str_raw_at(mutable this: Parser, mt: MessageType, a1: StringC, a2: StringC, loc: Location) @ret_nonlocal true @deep true @deep_this_18 true @deep_whole_18 true io reads STDERR_ENC linked







    ; a single RAW (pre-rendered, unquoted) %1 — endTagInvalidToken.
    procedure report_raw_at(mutable this: Parser, mt: MessageType, a1: StringC, loc: Location) @ret_nonlocal true @deep true @deep_this_10 true @deep_whole_10 true io reads STDERR_ENC linked






    ; report0 WITH an auxiliary line at aux_loc — commentEntityEnd
    ; ("comment started here" at the COM that opened the comment).
    procedure report0_aux(mutable this: Parser, mt: MessageType, loc: Location, aux: MessageFragment, aux_loc: Location) @ret_nonlocal true @deep true @deep_this_6 true @deep_whole_6 true io reads STDERR_ENC linked






    ; ordinal %1 + two quoted names — requiredElementExcluded / invalidExclusion.
    procedure report_ord2_at(mutable this: Parser, mt: MessageType, n: u64, a1: StringC, a2: StringC, loc: Location) @ret_nonlocal true @deep true @deep_this_34 true @deep_whole_34 true io reads STDERR_ENC linked








    ; quoted name %1 + quoted name list %2 — missingElementMultiple.
    procedure report_str_vec_at(mutable this: Parser, mt: MessageType, a1: StringC, v: ref[Array[StringC]], loc: Location) @ret_nonlocal true @deep true @deep_this_18 true @deep_whole_18 true io reads STDERR_ENC linked







    ; The display name of a leaf content token for the ambiguousModel*
    ; family (reportAmbiguity, parseDecl.cxx:748): the element name, or
    ; RNI + PCDATA for the #PCDATA pseudo-element.
    function leaf_token_name(this: Parser, leaf: ref[CmNode]) @page true @direct true @ret_param_1 true @deep true returns StringC linked













    ; Parser::reportAmbiguity (parseDecl.cxx:742): one detected content-model
    ; ambiguity, split over four message shapes by from-token kind and the
