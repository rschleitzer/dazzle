    ; doInstanceStart (parseInstance.cxx:16) — the instance's FIRST token: when
    ; it is not a tag (or entity end), the document element's start tag is
    ; implied under OMITTAG YES; under OMITTAG NO the instance must start with
    ; the document element (instanceStartOmittag) and the data stays outside.
    ; The token is ungotten either way and re-dispatched by do_content.
    procedure do_instance_start(mutable this: Parser) @ret_param_0 true @deep true io reads STDERR_ENC linked

























