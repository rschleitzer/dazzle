use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use opensp.StringC.StringC
use opensp.Location.Location
use opensp.ParserState.ParserState
use opensp.ParserOptions.ParserOptions
use opensp.Event.Event
use opensp.Attribute.Attribute
use opensp.Attribute.AttributeValue
use opensp.Attribute.AttributeSemantics
use opensp.Attribute.AttributeContext
use opensp.Attribute.AttributeDefinition
use opensp.Attribute.DeclaredValue
use opensp.Attribute.Text
use opensp.ParserMessages.ParserMessages
use opensp.ArcEngineMessages.ArcEngineMessages
use opensp.Message.MessageType
use opensp.Id.Id
use opensp.Id.IdTable
use opensp.AttributeList.AttributeList
use opensp.AttributeList.AttributeDefinitionList
use opensp.ElementType.ElementType
use opensp.ElementType.ElementDefinition
use opensp.Entity.Entity
use opensp.Notation.Notation
use opensp.ExternalId.ExternalId
use opensp.Dtd.Dtd
use opensp.Syntax.Syntax
use opensp.Sd.Sd
use opensp.OpenElement.OpenElement
use opensp.ContentState.ContentState
use opensp.Parser.Parser
use opensp.ModeInfo.ModeInfo
use opensp.Location.InputSource
use opensp.Location.Origin
use opensp.Storage.Storage

; ArcEngine — a Scaly port of James Clark's OpenSP ArcEngine (lib/ArcEngine.cxx
; + lib/ArcProcessor.h), the -A architectural-form processor (ISO/IEC 10744
; AFDR). Unlike the reference's streaming EventHandler chain, this runs as a
; POST-PARSE PASS over the materialized event queue (ParserState.events) — the
; same shape the RAST writer uses (Rast.scaly). The base document's events
; drive one ArcProcessor per ArcBase architecture; the processor consults a
; META-DTD (parsed on demand from the architecture's ArcDTD entity), maps each
; base element/attribute onto its architectural form, and GENERATES a fresh
; event stream. For the -A <name> selection (SelectOneArcDirector) only the
; matching architecture's generated stream is rendered; the base stream and any
; non-selected architecture go to a null sink.
;
; STATUS: the af-1 core path (single ArcBase, ArcFormA=architecture name, plain
; CDATA/#REQUIRED attribute mapping via buildAttributeMapRest, no suppression /
; renamer / token-map / #CONTENT / notation-data-form), PLUS since 2026-08-09
; the VALIDATING half: the meta-DTD content check (undefinedElement /
; elementExcluded / invalidElement / unfinishedElement), the `included` flag and
; the arch-space id table with missingId — before that, ArcEngineMessages had
; forty accessors and not one caller. With it came its three prerequisites,
; each of which had been silently wrong: ArcOpt -> options.includes (or every
; marked section of the meta-DTD resolves to IGNORE), the PARAMETER form of
; ArcDTD plus the catalog-resolved FSI (or the DSSSL architecture resolves to
; nothing at all), and the end tag's markup location in the parser.
;
; Since 2026-08-09 also mungeMetaDtd/mungeDataEntity plus the arch-space
; ENTITY/NOTATION attribute semantics (note_semantics): the meta-DTD has no
; entity table of its own, so without the copy every ENTITY-declared
; architectural attribute came out as a bare token (`ACONTENT TOKEN body-ent`
; instead of `ACONTENT ENTITY body-ent`) — and the DSSSL specification's
; `document`/`content` attributes are exactly that, which is what a routing of
; the spec parse through this engine depends on.
;
; And the meta-DTD-resolution diagnostics (noArcDTDAtt / arcDtdNotDeclared-
; Parameter / arcDtdNotDeclaredGeneral / arcDtdNotExternal /
; arcGenerateSystemId): every one of them used to be a silent `return` in
; setup, which the routing turns into "the stylesheet has no rules and nobody
; said why".
;
; NOT ported, and each is why a message here still has no caller:
; considerSupr/considerIgnD (so invalidData/invalidSuppress/invalidIgnD and the
; documentElementNotArc branch are unreachable), considerNamer + token maps
; (the rename diagnostics), #ARCCONT/emitArcContent, ArcQuant, and PI-declared
; architectures. `noArcNotation` also stays uncalled: the reference anchors it
; at the ArcBase PI's per-NAME offset and scan_arcbase_names keeps only the
; names — and on the DSSSL path the gate reports specNotArc for that case
; anyway. Also deliberately not carried across: the GRPCNT tally of the
; arch list's idref/entity-name tokens (idrefGrpcnt/entityNameGrpcnt). The
; reference counts inside setValue, i.e. before finish; this port's semantics
; walk runs AFTER finish, so the count would have to be re-plumbed for a
; message that needs more than 32 tokens in one architectural attribute to
; fire, and there is no fixture that reaches it.

; openElementFlags_ bits (ArcEngine.cxx suppressForm/…): only the ones the
; af-1 path needs plus the frame marker.
define ARC_IS_ARC: u32 0x0001
define ARC_IGNORE_DATA: u32 0x0002
define ARC_RECOVER_DATA: u32 0x0004

define ArcProcessor
(
    var valid: bool
    name: StringC
    var doc_dtd: ref[Dtd]?
    var meta_dtd: ref[Dtd]?
    var doc_sd: ref[Sd]?
    var doc_syntax: ref[Syntax]?
    var meta_syntax: ref[Syntax]?
    var cs: ref[ContentState]?
    var ctx: ref[AttributeContext]?
    var form_att_name: StringC
    var namer_att: StringC
    var supr_att: StringC
    var ignd_att: StringC
    var arc_doc_f: StringC
    supr_f: StringC
    var brid_f: StringC
    var data_f: StringC
    ; supportAttsText_[rArcDataF]->charLocation(0) — the only support attribute
    ; whose VALUE anchors a diagnostic (noArcDataF, ArcEngine.cxx:940).
    var data_f_loc: Location
    var arc_auto: bool
    var host: ref[Page]
    var ps: ref[ParserState]?
    var cur_loc: Location
    out: ref[Array[ref[Event]?]]?
    open_flags: ref[Array[u32]]
    var n_flags: size_t
    ; the ARCH-SPACE id table (ArcProcessor::idTable_, ArcProcessor.h). It is a
    ; SECOND table, independent of the document's: the same IDREF is reported
    ; twice when it resolves in neither space, once by the parser
    ; (ParserMessages.missingId) and once here (ArcEngineMessages.missingId).
    var id_table: ref[IdTable]?
    var error_idref: bool
)
{
    function make(host: ref[Page], name: StringC) returns ref[ArcProcessor] linked





    procedure flags_push(mutable this: ref[ArcProcessor], v: u32) linked








    function flags_top(this: ArcProcessor) returns u32 linked






    procedure flags_pop(mutable this: ref[ArcProcessor]) linked





    ; init (ArcProcessor::init, ArcEngine.cxx:779): resolve the ArcBase notation,
    ; read the ArcDTD support attribute, parse the meta-DTD, set up content state.
    procedure setup(mutable this: ref[ArcProcessor], host: ref[Page], ps: ref[ParserState], mutable doc_dtd: ref[Dtd], mutable sd: ref[Sd]?, mutable syntax: ref[Syntax]) io reads STDERR_ENC linked








































































































































































































































    ; --- diagnostics -------------------------------------------------------
    ; ArcProcessor is a Messenger in the reference; here the post-parse pass
    ; borrows the Parser's reporter, the same way the attribute-group check
    ; below already does.
    procedure arc_report1(mutable this: ref[ArcProcessor], mt: MessageType, a1: StringC, loc: Location) io reads STDERR_ENC linked





    procedure arc_report0(mutable this: ref[ArcProcessor], mt: MessageType, loc: Location) io reads STDERR_ENC linked





    ; --- mungeMetaDtd (ArcEngine.cxx:936) ----------------------------------
    ; The architectural stream is parsed against the meta-DTD, so an ENTITY-
    ; declared architectural attribute resolves its tokens in the META-DTD's
    ; general entity table (getAttributeEntity, :671) — a table the meta-DTD
    ; source never fills, because the entities are the DOCUMENT's. This copies
    ; them across, and re-points each external DATA entity at the
    ; architecture's own data form; without it every ENTITY attribute in the
    ; arch space comes out as a plain token (`ACONTENT TOKEN body-ent` instead
    ; of `ACONTENT ENTITY body-ent`), which is precisely what the DSSSL
    ; specification's `document` and `content` attributes are.
    procedure munge_meta_dtd(mutable this: ref[ArcProcessor], host: ref[Page]) io reads STDERR_ENC linked











































    ; mungeDataEntity (ArcEngine.cxx:960): map the entity's DOCUMENT notation
    ; onto an architectural one and its data attributes with it. False = the
    ; architecture has no form for this notation, and the reference then does
    ; not copy the entity into the meta-DTD at all.
    procedure munge_data_entity(mutable this: ref[ArcProcessor], host: ref[Page], mutable ent: ref[Entity]) returns bool io reads STDERR_ENC linked













    ; considerForm/autoForm in their isNotation form (ArcEngine.cxx:1770/1819).
    ; ★Two differences from the element side, both load-bearing: there is no
    ; CONSTDTD fallback (an unknown form yields nothing, so the entity is
    ; dropped rather than declared against an undefined notation), and the
    ; auto path falls back to ArcDataF — which is how the DSSSL architecture
    ; maps a `CDATA DSSSL` entity onto its `dsssl-specification` notation.
    procedure consider_form_notation(mutable this: ref[ArcProcessor], atts: ref[AttributeList], doc_nt: ref[Notation]) returns ref[Notation]? linked























    ; TokenizedAttributeValue::tokenLocation(k) as an OFFSET into the value's
    ; text: token 0 starts at 0, every later one one past its preceding
    ; separator.
    function token_offset(v: ref[AttributeValue], k: size_t) returns size_t linked







    ; --- the arch-space attribute semantics --------------------------------
    ; defineId/noteIdref (ArcEngine.cxx:695/709) plus getAttributeEntity /
    ; getAttributeNotation (:671/663). In the reference all four are
    ; AttributeContext overrides that the mapped list's own setValue/finish
    ; calls into; this port books id and entity semantics in the parser's
    ; attribute tokenizer (Parser.check_value_semantics) rather than in the
    ; context, so the arch side does the same walk over the FINISHED list.
    ; ★The resolution TABLES are the architecture's, not the document's: the
    ; id table is a second one (field comment above) and the entity/notation
    ; lookups go to the meta-DTD, which munge_meta_dtd filled.
    procedure note_semantics(mutable this: ref[ArcProcessor], host: ref[Page], mutable to: ref[AttributeList]) io reads STDERR_ENC linked












    procedure note_semantics_one(mutable this: ref[ArcProcessor], host: ref[Page], mutable to: ref[AttributeList], i: size_t) io reads STDERR_ENC linked

























































































    ; checkIdrefs (ArcEngine.cxx:728), run when the base stream is exhausted —
    ; the reference does it in ~ArcEngineImpl for every VALID processor.
    ; ★The iteration is the id table's raw bucket order, not document order,
    ; exactly as the parser's own check_idrefs: that order IS the message order
    ; the reference prints (useloss reports OTHER before NOSUCHPART).
    procedure check_idrefs(mutable this: ref[ArcProcessor]) io reads STDERR_ENC linked























    ; considerForm (ArcEngine.cxx:1727, af-1 subset): the ArcFormA attribute on
    ; the base element names the architectural element type.
    procedure consider_form(mutable this: ref[ArcProcessor], mutable atts: ref[AttributeList], base_et: ref[ElementType]?) @page true @direct true returns ref[ElementType]? linked































    function auto_form(this: ref[ArcProcessor], base_et: ref[ElementType]?, atts: ref[AttributeList]) returns ref[ElementType]? linked



























    ; mapAttributes (ArcEngine.cxx:1432) + buildAttributeMapRest (af-1 subset):
    ; each architectural attribute takes its value from the same-named base
    ; attribute.
    ; copy one base attribute's text value into the meta attribute at to_idx.
    procedure copy_att(mutable this: ref[ArcProcessor], host: ref[Page], mutable from_atts: ref[AttributeList], from_idx: size_t, mutable to: ref[AttributeList], to_idx: size_t) linked













    ; buildAttributeMapRename (ArcEngine.cxx:1849, name-pair subset): the renamer
    ; attribute's value is space-separated pairs `metaAtt baseAtt` — map each meta
    ; attribute from the named base attribute and mark it renamed. (#ARCCONT /
    ; #CONTENT / #DEFAULT / #MAPTOKEN forms are not yet handled.)
    procedure apply_rename(mutable this: ref[ArcProcessor], host: ref[Page], spec: StringC, mutable from_atts: ref[AttributeList], mutable to: ref[AttributeList], meta_def: ref[AttributeDefinitionList], mutable renamed: ref[Array[u8]]) linked



















    ; mapAttributes (ArcEngine.cxx:1432): apply the renamer (considerNamer +
    ; buildAttributeMapRename) then fill the remaining meta attributes by
    ; same-name match (buildAttributeMapRest).
    ; ★The reference's `map.attributed` is an ElementType OR a Notation
    ; (buildMetaMap takes both — mungeDataEntity goes through the notation
    ; side), and everything below reads only its attributeDef(), so the
    ; attribute def is the parameter and `map_attributes` is the element-typed
    ; caller.
    procedure map_attributes(mutable this: ref[ArcProcessor], host: ref[Page], mutable from_atts: ref[AttributeList]?, mutable meta_et: ref[ElementType]) returns ref[AttributeList] io reads STDERR_ENC linked


    procedure map_attributes_def(mutable this: ref[ArcProcessor], host: ref[Page], mutable from_atts: ref[AttributeList], mutable meta_def: ref[AttributeDefinitionList]?) returns ref[AttributeList] io reads STDERR_ENC linked



















































































    ; processStartElement (ArcEngine.cxx:1286, af-1 subset).
    procedure process_start_element(mutable this: ref[ArcProcessor], host: ref[Page], mutable ev: ref[Event]) io reads STDERR_ENC linked







































































    ; processData (ArcEngine.cxx:1409, af-1 subset): architectural iff the
    ; current architectural element admits PCDATA.
    procedure process_data_arc(mutable this: ref[ArcProcessor]) returns bool linked









    ; processEndElement (ArcEngine.cxx:2029).
    procedure process_end_element(mutable this: ref[ArcProcessor], host: ref[Page], mutable ev: ref[Event]) io reads STDERR_ENC linked






















}

define ArcEngine ( )
{
    ; fold a StringC through the general substitution table (NAMECASE GENERAL).
    ; ★The result must be PAGE-HOSTED on `host`, not built as the plain return
    ; expression: `StringC(buf, n)` runs the copying init, which allocates
    ; through `Page.get(this)` — and as a return value `this` is the CALLER's
    ; return slot, i.e. a stack temporary, so the characters land on the
    ; caller's region FRAME page and dangle the moment that frame pops
    ; (CLAUDE.md, "Strings"). `setup` stores these folded names in long-lived
    ; fields (form_att_name/namer_att/…), so the dangling buffer is read on
    ; every later element: `consider_form` stopped finding the ArcFormA
    ; attribute and silently dropped the element, which is exactly how
    ; synth-arc-07/08/11 lost their children — LATENT, because it only bites
    ; once something reuses the recycled frame page (more renamer tokens =
    ; more reuse = the second element fails where the first still worked).
    function fold_sc(host: ref[Page], syntax: ref[Syntax], s: StringC) @page true @direct true returns StringC linked













    ; read a named support attribute's value from a finished attribute list.
    ; The lookup name folds through the general subst table; the returned value
    ; is folded too when do_fold (doc/meta names), left raw otherwise (ArcDTD =
    ; an entity name, entity-subst not general-subst — identity for the corpus).
    function support_att(host: ref[Page], syntax: ref[Syntax], al: ref[AttributeList], name: StringC, do_fold: bool) @page true @direct true returns StringC linked

















    ; Dtd::generalEntityIter's order — the NamedTable BUCKET order, re-derived
    ; through an IdTable exactly as Parser.parse_end_prolog and
    ; Parser.check_dtd_notations do it (the same insertion sequence feeds the
    ; same hash and the same growth, so the buckets land the same way).
    function general_entities_in_bucket_order(host: ref[Page], dtd: ref[Dtd]) returns ref[Array[ref[Entity]?]] linked































    ; the LOCATION a support attribute's diagnostics anchor at:
    ; supportAttsText_[i]->charLocation(0) (ArcEngine.cxx:940) — the first
    ; character of the attribute's value, not the notation's declaration. An
    ; unset attribute has no text and answers an invalid Location, which is
    ; what the reference would print for a value it never read.
    function support_att_loc(host: ref[Page], syntax: ref[Syntax], al: ref[AttributeList], name: StringC) @page true @direct true returns Location linked














    ; split a StringC on whitespace into raw (unfolded) tokens. ★The tokens are
    ; page-hosted for the same reason as fold_sc above: `substr` builds its
    ; result with the copying init, so as a plain temporary its characters would
    ; land on THIS frame's region page and dangle as soon as split_ws returns —
    ; and the array outlives the call by construction.
    function split_ws(host: ref[Page], syntax: ref[Syntax]?, s: StringC) returns ref[Array[StringC]] linked




















    function in_group(v: StringC, allowed: ref[Array[StringC]]) returns bool linked












    function is_s(syntax: ref[Syntax], c: u32) returns bool linked












    ; parse an external meta-DTD file into a fresh Dtd (ArcProcessor::init's
    ; sub-parse; models SgmlParser::Params{entityType=dtd}). Reuses the port's
    ; declaration-subset parser on a child ParserState sharing the parent's
    ; entity manager / catalog / options; the Dtd is queried straight off the
    ; local pointer (no end_dtd, which would move it to the stack).
    procedure parse_meta_dtd(host: ref[Page], ps: ref[ParserState], mutable doctype_name: StringC, base_dir: String, mutable sysid: String, mutable sd: ref[Sd]?, syntax: ref[Syntax], includes: ref[Array[StringC]]?) @page true @direct true returns ref[Dtd]? io reads STDERR_ENC linked


































































    ; scan a PI's data for `IS10744 ArcBase name...` and append one ArcProcessor
    ; per architecture name (ArcEngineImpl::pi, ArcEngine.cxx:220, ArcBase form).
    procedure scan_arcbase_pi(host: ref[Page], syntax: ref[Syntax], data: StringC, is10744: StringC, arc_base: StringC, mutable procs: ref[Array[ref[ArcProcessor]?]]) linked












    ; the name half of scan_arcbase_pi: append each architecture name the PI
    ; declares as a BASE architecture (folded through the general subst table,
    ; the form lookupNotation then keys on).
    procedure scan_arcbase_names(host: ref[Page], syntax: ref[Syntax], data: StringC, is10744: StringC, arc_base: StringC, mutable names: ref[Array[StringC]]) linked











































    ; declares_base_architecture — the gate the reference's gotArc_ flag records
    ; (style/DssslSpecEventHandler.cxx:88 loadDoc): does the document declare, as
    ; a BASE architecture, an architecture whose notation carries `pubid` as its
    ; public identifier?
    ;
    ; It is the conjunction of three reference steps, all of which must hold:
    ;   1. ArcEngineImpl::pi (ArcEngine.cxx:220) sees an `IS10744 ArcBase name…`
    ;      PI and builds one ArcProcessor per name;
    ;   2. ArcProcessor::init (ArcEngine.cxx:838) resolves that name against the
    ;      document DTD's notations — `docDtd_->lookupNotation(name_)`;
    ;   3. the nested ArcEngineImpl hands that notation to the director, and the
    ;      director matches on its public id (SelectOneArcDirector /
    ;      DssslSpecEventHandler::arcEventHandler, which sets gotArc_).
    ;
    ; ★DECLARING THE NOTATION IS NOT DECLARING THE ARCHITECTURE. Without an
    ; ArcBase PI no ArcProcessor exists, step 3 never runs, and the reference
    ; reports its "not a base architecture" error — the notation-only test this
    ; replaces passed such a document (tests/dazzle/cli/notarc.dsl).
    ;
    ; The PI-declared form (`<?IS10744 ArcDecl …>` / ArcPubid support attribute)
    ; deliberately does NOT count: there ArcProcessor::init leaves `notation`
    ; null and the DSSSL director returns 0 without setting gotArc_.
    ;
    ; DEVIATION: the reference recognizes an ArcBase PI only at stage_ == 1, i.e.
    ; between startDtd and endDtd; the port's event queue has no DTD brackets, so
    ; PIs are taken up to the first start element (the prolog). A PI sitting
    ; between the DTD and the document element would wrongly count.
    function declares_base_architecture(host: ref[Page], ps: ref[ParserState], pubid: Slice[char]) returns bool linked













































    ; the arch stream's END-PROLOG (ArcEngine.cxx:931 — the last thing
    ; ArcProcessor::init does, so it precedes every generated element). It
    ; carries the META-DTD, which is what makes `-A <arch> -oentity` list the
    ; architecture's entities (the munged copies) instead of the document's, and
    ; it is what an event consumer reads for the document's own location — the
    ; DSSSL specification handler anchors its `noParts` diagnostic there.
    ;
    ; The LOCATION is the base end-prolog's (`event.location()`); LINK plays no
    ; part in an architectural stream (the reference passes only dtd + loc), so
    ; the lpd and simple-link columns stay null.
    procedure emit_end_prolog(host: ref[Page], ps: ref[ParserState], p: ref[ArcProcessor], mutable out: ref[Array[ref[Event]?]]) @page true @direct true linked





















    ; drive the base event stream through a processor, generating the
    ; architectural stream into p.out.
    procedure run_events(host: ref[Page], mutable ps: ref[ParserState], mutable p: ref[ArcProcessor]) io reads STDERR_ENC linked

























    ; ArcEngine::parseAll + SelectOneArcDirector (ArcEngine.cxx:147/157): build
    ; the processors from the ArcBase PIs, init each, and replace the event
    ; queue with the SELECTED architecture's generated stream (empty when the
    ; selection matches no architecture — the reference's null handler).
    procedure transform(host: ref[Page], mutable ps: ref[ParserState], arc_names: ref[Array[String]]?) returns bool io reads STDERR_ENC linked




















































}
