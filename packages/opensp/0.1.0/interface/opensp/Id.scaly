use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.Location.Location
use opensp.Location.Origin
use opensp.Location.InputSource

; Id — Id.cs (65 LOC). The id-table record for one ID attribute value: the name,
; the defining location (once the ID has been declared by an ELEMENT that
; carries it), and the list of pending IDREF locations recorded BEFORE the ID was
; defined (so forward references that never resolve can be reported). C++'s
; `Id : Named` base -> a `name` field; the `Vector<Location> pendingRefs_` -> an
; `Array[Location]` (grows within the run, never shrinks).
;
; PORT SHAPE: page-hosted flat struct (referenced by identity from the parser's
; NamedTable<Id> id table). `defined()` mirrors C++: an ID is defined once its
; defLocation_ has a non-null origin.

define Id @resident true (name: StringC, var def_loc: Location, var pending_refs: ref[Array[Location]])
{
    function make(host: ref[Page], name: StringC) @ret_explicit_0 true @deep true returns ref[Id] linked





    function get_name(this: Id) @page true @direct true @ret_param_0 true @deep true returns StringC linked


    ; define(loc) [renamed: `define` is a Scaly keyword]: record the defining
    ; location and release the pending refs (C++ swaps pendingRefs_ with a fresh
    ; empty vector — the arena makes the old one dead; we drop the reference to a
    ; fresh empty Array).
    procedure mark_defined(mutable this: ref[Id], loc: Location) @deep true @deep_this_2 true @deep_whole_2 true @deep_pageof_1 true linked






    function defined(this: Id) @ret_param_0 true @deep true returns bool linked


    function def_location(this: Id) @page true @direct true @ret_param_0 true @deep true returns Location linked


    procedure add_pending_ref(mutable this: ref[Id], loc: Location) @persists true @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true linked


    ; noteIdref(loc): record a pending ref only while the ID is still undefined.
    procedure note_idref(mutable this: ref[Id], loc: Location) @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true linked





    function n_pending_refs(this: Id) @ret_param_0 true @deep true returns size_t linked


    function pending_ref_at(this: Id, i: size_t) @page true @direct true @ret_param_0 true @deep true returns Location linked


    function first_ref_location(this: Id) @page true @direct true @deep true returns Location linked







    function test() @ret_nonlocal true @deep true returns int linked












































}

; --- IdTable ---------------------------------------------------------------
; ParserState's idTable_: NamedTable<Id> = OwnerTable over PointerTable
; (PointerTable.cxx) keyed by Hash::hash (Hash.cxx: h = h*33 + char, the Chris
; Torek fold in an unsigned long). The table SHAPE is load-bearing for the
; drop-in: checkIdrefs iterates the raw bucket vector in ascending index order,
; so the missingId message ORDER is the open-addressing layout — initial size
; 8 (usedLimit 4), grow x2 when used_ >= usedLimit_ (rehash reinserting in old
; bucket order), probe DOWNWARD (nextIndex: i == 0 ? size-1 : i-1). Verified
; against real onsgmls: ids NOPE,Y,GONE,LOST land as [GONE,Y,NOPE,_,_,_,_,LOST]
; and the messages print GONE,NOPE,LOST — not document order.
define IdTable
(
    var vec: Slice[ref[Id]?]
    var vec_size: size_t
    var used: size_t
    var used_limit: size_t
)
{
    function make(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[IdTable] linked





    ; Hash::hash — h*33 + char over the (folded) name, in u64.
    function hash(name: StringC) @ret_nonlocal true @deep true returns u64 linked












    function start_index(this: IdTable, name: StringC) @ret_nonlocal true @deep true returns size_t linked


    function next_index(this: IdTable, i: size_t) @ret_param_0 true @deep true returns size_t linked






    function alloc_vec(host: ref[Page], n: size_t) @page true @direct true @ret_explicit_0 true @deep true returns Slice[ref[Id]?] linked











    function lookup(this: IdTable, name: StringC) @ret_param_0 true @deep true returns ref[Id]? linked














    ; PointerTable::insert of a fresh Id (no replace arm — lookupCreateId
    ; looks up first). Mirrors the reference exactly: first insert allocates 8
    ; buckets; at used_ >= usedLimit_ the vector doubles and every old entry
    ; reinserts IN OLD BUCKET ORDER, each probing down to the first free slot.
    procedure insert(mutable this: ref[IdTable], host: ref[Page], id: ref[Id]) @persists true @ret_nonlocal true @deep true @deep_this_4 true @deep_whole_4 true linked











































    ; ParserState::lookupCreateId.
    procedure lookup_create(mutable this: ref[IdTable], host: ref[Page], name: StringC) @deep true returns ref[Id] linked




















    ; iteration surface for checkIdrefs: ascending bucket index, nulls skipped
    ; by the caller (PointerTableIter::next).
    function bucket_count(this: IdTable) @ret_param_0 true @deep true returns size_t linked


    function bucket_at(this: IdTable, i: size_t) @ret_param_0 true @deep true returns ref[Id]? linked


    ; The NamedTable ITERATION ORDER (ascending bucket index) for a list of
    ; names, as a permutation of their positions: every C++ NamedTable in the
    ; prolog (entities, notations, element types) is a PointerTable with this
    ; layout while the port's tables are insertion-ordered Arrays, and the order
    ; is OBSERVABLE — through the missingId message order (checkIdrefs), through
    ; the -oentity endProlog sweep, and through the GROVE's named node lists.
    ; The permutation is computed here rather than at each caller because the
    ; layout belongs to this table; a name appearing twice keeps its FIRST
    ; position (PointerTable::insert replaces in place).
    function bucket_order(host: ref[Page], names: ref[Array[StringC]]) @ret_explicit_0 true @deep true returns ref[Array[size_t]] linked








































    function id_test() @ret_nonlocal true @deep true returns int linked

























}
