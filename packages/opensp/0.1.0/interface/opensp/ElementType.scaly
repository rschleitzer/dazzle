use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.Location.Location
use opensp.ContentToken.CompiledModelGroup
use opensp.AttributeList.AttributeDefinitionList
use opensp.ShortReferenceMap.ShortReferenceMap

; ElementType — ElementType.cs (389 LOC). The full element-type layer: an
; `ElementDefinition` (owns the compiled model group, the omit-tag flags,
; declared content, inclusions/exclusions/rank stems), the `RankStem`, and
; `ElementType` itself (name + dense index + attributed member + a borrowed
; definition pointer). This GROWS the minimal Increment-C seed in place: the
; content-model DFA (ContentToken) references an element type only by IDENTITY
; and by its dense `index`, so those two fields — and their construction shape
; (`ElementType^host(name, index)`) — stay byte-stable.
;
; PORT SHAPE: the C++ ref-counted graph (ConstPtr<ElementDefinition>,
; Owner<CompiledModelGroup>, ConstPtr<ElementDefinition> rank defs) collapses to
; plain borrowed pointers in the one-region-per-run arena; ElementType /
; ElementDefinition / RankStem are page-hosted flat structs mutated through a
; pointer via plain `.`. Names are StringC (u32) — the scanner produces StringC
; names and the attribute/notation lookups key on StringC; this reconciles the
; earlier byte-String seed.
;
; MI resolution (C++ `ElementType : Named + Attributed`): following the C# port
; and Notation's lead, the `Attributed` member is FOLDED INLINE as a single
; `attribute_def` pointer.

; ElementDefinition::DeclaredContent.
define DC_MODEL_GROUP: int 0
define DC_ANY: int 1
define DC_CDATA: int 2
define DC_RCDATA: int 3
define DC_EMPTY: int 4

; ElementDefinition::OmitFlags (C++ octal 01/02/04).
define OMIT_START: u8 1
define OMIT_END: u8 2
define OMIT_SPEC: u8 4

; size_t(undefinedIndex) — an element declared only by reference (implicit).
define ELEMENT_UNDEFINED_INDEX: size_t 0xFFFFFFFFFFFFFFFF

; --- ElementDefinition ----------------------------------------------------
; The shared definition body of one or more element types. Owns the compiled
; model group and the content-mode bookkeeping computed from the declared
; content. inclusions/exclusions/rank_stems are Array pointers (null = empty),
; set once via set_* (C++ swaps a Vector in; the arena just stores the pointer).
define ElementDefinition
(
    location: Location
    index: size_t
    omit_flags: u8
    declared_content: int
    allow_immediate_recursion: bool
    model_group: ref[CompiledModelGroup]?
    var inclusions: ref[Array[ref[ElementType]?]]?
    var exclusions: ref[Array[ref[ElementType]?]]?
    var rank_stems: ref[Array[ref[RankStem]?]]?
    var rank_suffix: StringC
    var mode_normal: int
    var mode_net: int
)
{
    ; ElementDefinition(location, index, omitFlags, declaredContent,
    ;                   allowImmediateRecursion = 1) — no model group.
    procedure make(host: ref[Page], mutable location: Location, index: size_t, omit_flags: u8, declared_content: int, allow_immediate_recursion: bool) @ret_explicit_0 true returns ref[ElementDefinition] linked






    ; ElementDefinition(location, index, omitFlags, declaredContent, modelGroup).
    procedure make_with_model(host: ref[Page], mutable location: Location, index: size_t, omit_flags: u8, declared_content: int, mutable model_group: ref[CompiledModelGroup]) @ret_explicit_0 true returns ref[ElementDefinition] linked






    function compiled_model_group(this: ElementDefinition) @ret_param_0 true returns ref[CompiledModelGroup]? linked


    function get_declared_content(this: ElementDefinition) @ret_param_0 true returns int linked


    function omitted_tag_spec(this: ElementDefinition) @ret_param_0 true returns bool linked


    function can_omit_start_tag(this: ElementDefinition) @ret_param_0 true returns bool linked


    function can_omit_end_tag(this: ElementDefinition) @ret_param_0 true returns bool linked


    function n_rank_stems(this: ElementDefinition) @ret_param_0 true returns size_t linked






    function rank_stem(this: ElementDefinition, i: size_t) @ret_param_0 true returns ref[RankStem]? linked






    function get_rank_suffix(this: ElementDefinition) @page true @direct true @ret_param_0 true returns StringC linked


    function n_inclusions(this: ElementDefinition) @ret_param_0 true returns size_t linked






    function inclusion(this: ElementDefinition, i: size_t) @ret_param_0 true returns ref[ElementType]? linked






    function n_exclusions(this: ElementDefinition) @ret_param_0 true returns size_t linked






    function exclusion(this: ElementDefinition, i: size_t) @ret_param_0 true returns ref[ElementType]? linked






    function undefined(this: ElementDefinition) @ret_param_0 true returns bool linked


    function get_allow_immediate_recursion(this: ElementDefinition) @ret_param_0 true returns bool linked


    procedure set_inclusions(mutable this: ref[ElementDefinition], inclusions: ref[Array[ref[ElementType]?]]) linked


    procedure set_exclusions(mutable this: ref[ElementDefinition], exclusions: ref[Array[ref[ElementType]?]]) linked


    procedure set_rank(mutable this: ref[ElementDefinition], rank_suffix: StringC, rank_stems: ref[Array[ref[RankStem]?]]) linked





    ; Mode mode(Boolean netEnabled) const.
    function mode(this: ElementDefinition, net_enabled: bool) @ret_param_0 true returns int linked






    function get_location(this: ElementDefinition) @page true @direct true @ret_param_0 true returns Location linked


    ; computeMode — derive the two content modes from the declared content,
    ; consulting the compiled model group for PCDATA reachability.
    procedure compute_mode(mutable this: ref[ElementDefinition]) linked





































}

; --- RankStem -------------------------------------------------------------
; A rank stem groups the element definitions that share a ranked declaration.
define RankStem
@resident true (
    name: StringC
    index: size_t
    defs: ref[Array[ref[ElementDefinition]?]]
)
{
    init(name: StringC, index: size_t) linked







    ; Cross-file construction goes through this factory (the `^host` init form
    ; mis-plans when called from another module — the fields come out zero).
    function make(host: ref[Page], name: StringC, index: size_t) @ret_explicit_0 true returns ref[RankStem] linked





    function get_name(this: RankStem) @page true @direct true @ret_param_0 true returns StringC linked


    function get_index(this: RankStem) @ret_param_0 true returns size_t linked


    procedure add_definition(mutable this: ref[RankStem], p: ref[ElementDefinition]?) @persists true @ret_nonlocal true linked


    function n_definitions(this: RankStem) @ret_param_0 true returns size_t linked


    function definition(this: RankStem, i: size_t) @ret_param_0 true returns ref[ElementDefinition]? linked

}

; --- ElementType ----------------------------------------------------------
define ElementType
(
    name: StringC
    var orig_name: StringC
    index: size_t
    var def_index: size_t
    var element_def: ref[ElementDefinition]?
    var short_ref_map: ref[ShortReferenceMap]?
    var attribute_def: ref[AttributeDefinitionList]?
)
{
    init(name: StringC, index: size_t) linked










    ; Heap-allocate an ElementType on `host`, DEEP-COPYING the name onto the
    ; host page (the C++ StringC copy-ctor semantics) so the stored name does
    ; not alias the parser's transient folded-token buffer.
    function make(host: ref[Page], name: StringC, index: size_t) @ret_explicit_0 true returns ref[ElementType] linked





    function get_name(this: ElementType) @page true @direct true @ret_param_0 true returns StringC linked


    function get_index(this: ElementType) @ret_param_0 true returns size_t linked


    function get_orig_name(this: ElementType) @page true @direct true @ret_param_0 true returns StringC linked


    procedure set_orig_name(mutable this: ref[ElementType], orig_name: StringC) linked


    ; setElementDefinition(def, defIndex) — defIndex = position in the ranked
    ; group sharing this definition.
    procedure set_element_definition(mutable this: ref[ElementType], def: ref[ElementDefinition]?, def_index: size_t) linked





    function get_definition(this: ElementType) @ret_param_0 true returns ref[ElementDefinition]? linked


    function undefined(this: ElementType) @ret_param_0 true returns bool linked






    function is_ranked_element(this: ElementType) @ret_param_0 true returns bool linked






    function ranked_element_rank_stem(this: ElementType) @ret_param_0 true returns ref[RankStem]? linked






    procedure set_map(mutable this: ref[ElementType], map: ref[ShortReferenceMap]?) linked


    function get_map(this: ElementType) @ret_param_0 true returns ref[ShortReferenceMap]? linked


    ; Attributed (folded inline).
    function get_attribute_def(this: ElementType) @ret_param_0 true returns ref[AttributeDefinitionList]? linked


    procedure set_attribute_def(mutable this: ref[ElementType], def: ref[AttributeDefinitionList]?) linked


    function test() @ret_nonlocal true returns int linked

















































































}
