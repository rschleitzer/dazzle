use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.Location.Location
use opensp.Dtd.Dtd
use opensp.ElementType.ElementType
use opensp.AttributeList.AttributeList
use opensp.AttributeList.AttributeDefinitionList

; Lpd — link process definitions (Lpd.h / Lpd.cxx). The LINK feature axis'
; data layer: one Lpd per LINKTYPE declaration (simple / implicit / explicit),
; complex LPDs carry LINK/IDLINK link sets whose rules attach link attribute
; lists (and, for explicit links, result element specs) to source elements.
;
; PORT SHAPE (the Event/CmNode convention): C++'s Lpd/SimpleLpd/ComplexLpd
; inheritance triangle collapses into ONE flat tagged struct keyed by `kind`
; (LPD_SIMPLE carries the Attributed half, IMPLICIT/EXPLICIT the complex half).
; SourceLinkRule and IdLinkRule likewise collapse (an IdLinkRule is a
; SourceLinkRule with a non-null assoc_element_types vector); ResultElementSpec
; is folded into the rule as (result_type, result_attributes). SourceLinkRule's
; uselink/postlink name a LinkSet declared AFTER it in this module — a forward
; reference the compiler resolves, as it does the cross-MODULE ones that
; ExternalDataEntity.notation and Origin.entity_decl carry.
;
; NamedTable<LinkSet> / NamedTable<IdLinkRuleGroup> are OpenSP open-addressing
; hash tables; parseLinktypeDeclEnd SWEEPS the link-set table for undefined
; link sets, so the ITERATION ORDER (ascending bucket index) is message-order
; load-bearing — LinkSetTable mirrors the IdTable port exactly (initial size 8,
; usedLimit half, grow x2 reinserting in old bucket order, probe DOWNWARD).

define LPD_SIMPLE: int 0
define LPD_IMPLICIT: int 1
define LPD_EXPLICIT: int 2

; SourceLinkRule (+ IdLinkRule when assoc_element_types is non-null).
; uselink/postlink name a LinkSet declared further down this file.
define SourceLinkRule
(
    var uselink: ref[LinkSet]?
    var postlink: ref[LinkSet]?
    var postlink_restore: bool
    var link_attributes: ref[AttributeList]?
    ; ResultElementSpec (explicit links): the result element (null = none
    ; looked up / no result dtd) and its attributes. has_result distinguishes
    ; an omitted (#IMPLIED) result from a present one.
    var has_result: bool
    var result_type: ref[ElementType]?
    var result_attributes: ref[AttributeList]?
    ; IdLinkRule: the associated source element types.
    var assoc_element_types: ref[Array[ref[ElementType]?]]?
)
{
    function make(host: ref[Page]) @ret_explicit_0 true returns ref[SourceLinkRule] linked





    procedure set_uselink(mutable this: ref[SourceLinkRule], ls: ref[LinkSet]?) linked


    function get_uselink(this: SourceLinkRule) @ret_param_0 true returns ref[LinkSet]? linked


    procedure set_postlink(mutable this: ref[SourceLinkRule], ls: ref[LinkSet]?) linked


    function get_postlink(this: SourceLinkRule) @ret_param_0 true returns ref[LinkSet]? linked


    procedure set_postlink_restore(mutable this: ref[SourceLinkRule]) linked


    function get_postlink_restore(this: SourceLinkRule) @ret_param_0 true returns bool linked


    procedure set_link_attributes(mutable this: ref[SourceLinkRule], atts: ref[AttributeList]?) linked


    function attributes(this: SourceLinkRule) @ret_param_0 true returns ref[AttributeList]? linked


    procedure set_result(mutable this: ref[SourceLinkRule], e: ref[ElementType]?, atts: ref[AttributeList]?) linked






    function get_result_type(this: SourceLinkRule) @ret_param_0 true returns ref[ElementType]? linked


    function get_result_attributes(this: SourceLinkRule) @ret_param_0 true returns ref[AttributeList]? linked


    procedure set_assoc_element_types(mutable this: ref[SourceLinkRule], v: ref[Array[ref[ElementType]?]]) linked


    ; IdLinkRule::isAssociatedWith.
    function is_associated_with(this: SourceLinkRule, e: ref[ElementType]?) @ret_nonlocal true returns bool linked













}

; LinkSet (Lpd.h:99): link rules indexed by the SOURCE element's type index,
; plus the implied source link rules (result specs of `#IMPLIED source` rules).
; The reference sizes linkRules_ to the source DTD's nElementTypeIndex at
; construction and indexes UNCHECKED thereafter — but link rules may
; lookupCreateElement NEW elements, so the port grows the vector on demand
; (behaviorally identical for every input the reference handles defined).
define LinkSet
(
    name: StringC
    var defined: bool
    ; per source-element type index: the rules for that element.
    link_rules: ref[Array[ref[Array[ref[SourceLinkRule]?]]?]]
    ; ResultElementSpecs of implied-source rules, stored as rules (result half).
    implied_rules: ref[Array[ref[SourceLinkRule]?]]
)
{
    ; deep-copies the name onto host (parm tokens are transient).
    function make(host: ref[Page], name: StringC, dtd: ref[Dtd]?) @ret_explicit_0 true returns ref[LinkSet] linked















    function get_name(this: LinkSet) @page true @direct true @ret_param_0 true returns StringC linked


    function is_defined(this: LinkSet) @ret_param_0 true returns bool linked


    procedure set_defined(mutable this: ref[LinkSet]) linked


    procedure add_link_rule(mutable this: ref[LinkSet], host: ref[Page], e: ref[ElementType], rule: ref[SourceLinkRule]) @ret_nonlocal true linked













    function n_link_rules(this: LinkSet, e: ref[ElementType]) @ret_nonlocal true returns size_t linked










    function link_rule(this: LinkSet, e: ref[ElementType], i: size_t) @ret_param_0 true returns ref[SourceLinkRule] linked





    ; LinkSet::addImplied — record the result spec of an `#IMPLIED source` rule.
    procedure add_implied(mutable this: ref[LinkSet], host: ref[Page], e: ref[ElementType], atts: ref[AttributeList]?) @ret_nonlocal true linked






    function n_implied_link_rules(this: LinkSet) @ret_param_0 true returns size_t linked


    function implied_link_rule(this: LinkSet, i: size_t) @ret_param_0 true returns ref[SourceLinkRule]? linked


    ; LinkSet::impliedResultAttributes — whether a result spec for this result
    ; element type already exists (duplicateImpliedResult's test).
    function has_implied_result(this: LinkSet, result_type: ref[ElementType]) @ret_nonlocal true returns bool linked












}

; NamedTable<LinkSet> — the OpenSP OwnerTable/Hash open-addressing port (the
; IdTable pattern): iteration order = ascending bucket index, load-bearing for
; parseLinktypeDeclEnd's undefined-link-set sweep.
define LinkSetTable
(
    var vec: Slice[ref[LinkSet]?]
    var vec_size: size_t
    var used: size_t
    var used_limit: size_t
)
{
    function make(host: ref[Page]) @ret_explicit_0 true returns ref[LinkSetTable] linked





    ; Hash::hash — h*33 + char.
    function hash(name: StringC) @ret_nonlocal true returns u64 linked












    function start_index(this: LinkSetTable, name: StringC) @ret_nonlocal true returns size_t linked


    function next_index(this: LinkSetTable, i: size_t) @ret_param_0 true returns size_t linked






    function alloc_vec(host: ref[Page], n: size_t) @page true @direct true @ret_caller true returns Slice[ref[LinkSet]?] linked











    function lookup(this: LinkSetTable, name: StringC) @ret_param_0 true returns ref[LinkSet]? linked















    procedure insert(mutable this: ref[LinkSetTable], host: ref[Page], ls: ref[LinkSet]) @persists true @ret_nonlocal true linked











































    ; the sweep surface (ConstNamedTableIter): ascending bucket index, callers
    ; skip nulls.
    function bucket_count(this: LinkSetTable) @ret_param_0 true returns size_t linked


    function bucket_at(this: LinkSetTable, i: size_t) @ret_param_0 true returns ref[LinkSet]? linked

}

; IdLinkRuleGroup (Lpd.h:137) — the ID link rules sharing one unique id.
define IdLinkRuleGroup
(
    name: StringC
    rules: ref[Array[ref[SourceLinkRule]?]]
)
{
    function make(host: ref[Page], name: StringC) @ret_explicit_0 true returns ref[IdLinkRuleGroup] linked





    function get_name(this: IdLinkRuleGroup) @page true @direct true @ret_param_0 true returns StringC linked


    function n_link_rules(this: IdLinkRuleGroup) @ret_param_0 true returns size_t linked


    function link_rule(this: IdLinkRuleGroup, i: size_t) @ret_param_0 true returns ref[SourceLinkRule]? linked


    procedure add_link_rule(mutable this: ref[IdLinkRuleGroup], rule: ref[SourceLinkRule]) @persists true @ret_nonlocal true linked

}

; NamedTable<IdLinkRuleGroup> — same table shape (lookup only, never swept).
define IdLinkTable
(
    var vec: Slice[ref[IdLinkRuleGroup]?]
    var vec_size: size_t
    var used: size_t
    var used_limit: size_t
)
{
    function make(host: ref[Page]) @ret_explicit_0 true returns ref[IdLinkTable] linked





    function start_index(this: IdLinkTable, name: StringC) @ret_nonlocal true returns size_t linked


    function next_index(this: IdLinkTable, i: size_t) @ret_param_0 true returns size_t linked






    function alloc_vec(host: ref[Page], n: size_t) @page true @direct true @ret_caller true returns Slice[ref[IdLinkRuleGroup]?] linked











    function lookup(this: IdLinkTable, name: StringC) @ret_param_0 true returns ref[IdLinkRuleGroup]? linked















    procedure insert(mutable this: ref[IdLinkTable], host: ref[Page], g: ref[IdLinkRuleGroup]) @persists true @ret_nonlocal true linked










































}

; Lpd — the flat tagged struct (see the header note). SIMPLE uses
; attribute_def; IMPLICIT/EXPLICIT use the complex half.
define Lpd
(
    var kind: int
    var name: StringC
    var location: Location
    var active: bool
    var source_dtd: ref[Dtd]?
    ; SimpleLpd (Attributed):
    var attribute_def: ref[AttributeDefinitionList]?
    ; ComplexLpd:
    var result_dtd: ref[Dtd]?
    ; per source-element type index: the link attribute definitions
    ; (ComplexLpd::linkAttributeDefs_), grown on demand like LinkSet's rules.
    var link_attribute_defs: ref[Array[ref[AttributeDefinitionList]?]]?
    var link_sets: ref[LinkSetTable]?
    var initial_link_set: ref[LinkSet]?
    var empty_link_set: ref[LinkSet]?
    var had_id_link_set: bool
    var id_links: ref[IdLinkTable]?
    var n_attribute_definition_list: size_t
)
{
    ; SimpleLpd ctor. Deep-copies the name (a swapped parm token).
    function make_simple(host: ref[Page], name: StringC, loc: Location, source_dtd: ref[Dtd]?) @ret_explicit_0 true returns ref[Lpd] linked





    ; ComplexLpd ctor. initial_name/empty_name are the syntax's RNI-prefixed
    ; INITIAL/EMPTY reserved names (the caller renders them — Lpd cannot see
    ; Syntax, declared later? no: Syntax precedes; passed to keep the ctor
    ; signature flat like the reference's syntax handle).
    function make_complex(host: ref[Page], name: StringC, kind: int, loc: Location, initial_name: StringC, empty_name: StringC, source_dtd: ref[Dtd]?, result_dtd: ref[Dtd]?) @ret_explicit_0 true returns ref[Lpd] linked




























    function get_kind(this: Lpd) @ret_param_0 true returns int linked


    function get_name(this: Lpd) @page true @direct true @ret_param_0 true returns StringC linked


    function get_location(this: Lpd) @page true @direct true @ret_param_0 true returns Location linked


    function is_active(this: Lpd) @ret_param_0 true returns bool linked


    procedure activate(mutable this: ref[Lpd]) linked


    function get_source_dtd(this: Lpd) @ret_param_0 true returns ref[Dtd]? linked


    function get_result_dtd(this: Lpd) @ret_param_0 true returns ref[Dtd]? linked


    ; ---- SimpleLpd (Attributed) ----
    function get_attribute_def(this: Lpd) @ret_param_0 true returns ref[AttributeDefinitionList]? linked


    procedure set_attribute_def(mutable this: ref[Lpd], adl: ref[AttributeDefinitionList]?) linked


    ; ---- ComplexLpd ----
    procedure alloc_attribute_definition_list_index(mutable this: ref[Lpd]) @ret_param_0 true returns size_t linked






    function initial_link_set_of(this: Lpd) @ret_param_0 true returns ref[LinkSet]? linked


    function empty_link_set_of(this: Lpd) @ret_param_0 true returns ref[LinkSet]? linked


    function lookup_link_set(this: Lpd, name: StringC) @ret_param_0 true returns ref[LinkSet]? linked


    procedure insert_link_set(mutable this: ref[Lpd], host: ref[Page], ls: ref[LinkSet]) @ret_nonlocal true linked


    function get_link_sets(this: Lpd) @ret_param_0 true returns ref[LinkSetTable]? linked


    function had_id_link_set_of(this: Lpd) @ret_param_0 true returns bool linked


    procedure set_had_id_link_set(mutable this: ref[Lpd]) linked


    function lookup_id_link(this: Lpd, id: StringC) @ret_param_0 true returns ref[IdLinkRuleGroup]? linked


    ; ComplexLpd::lookupCreateIdLink.
    procedure lookup_create_id_link(mutable this: ref[Lpd], host: ref[Page], id: StringC) returns ref[IdLinkRuleGroup] linked









    ; ComplexLpd::attributeDef(e) — null when unset (or index out of range).
    function link_attribute_def(this: Lpd, e: ref[ElementType]) @ret_param_0 true returns ref[AttributeDefinitionList]? linked







    procedure set_link_attribute_def(mutable this: ref[Lpd], e: ref[ElementType], adl: ref[AttributeDefinitionList]) @persists true @ret_nonlocal true linked






}
