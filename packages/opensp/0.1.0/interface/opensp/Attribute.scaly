use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.Syntax.Syntax
use opensp.Sd.Sd
use opensp.Location.Location
use opensp.Entity.Entity
use opensp.Entity.InternalEntity
use opensp.AttributeList.AttributeList
use opensp.Notation.Notation

; Attributes — Attribute.cs / Attribute.cxx (the declared-value classification,
; the AttributeDefinition family, the produced AttributeValue / semantics, the
; per-spec Attribute, and the AttributeContext Messenger).
;
; PORT SHAPE — the C++ class hierarchies here (DeclaredValue -> Cdata/Tokenized
; -> Group -> NameTokenGroup/Notation, plus Entity/Id/Idref; AttributeDefinition
; -> Required/Current/Implied -> Conref, Default -> Fixed; AttributeValue ->
; Implied/Cdata/Tokenized -> Data; AttributeSemantics -> Entity/Notation) are
; FLATTENED into page-hosted structs tagged by a `*_kind` int, exactly as the
; ContentToken increment flattened its node hierarchy. Rationale identical: the
; subclasses differ only by a handful of flags / one extra field, share most of
; their state, are cross-referenced by pointer (a definition owns a declared
; value; a value owns a Text), and live to run end (one region per run) — a
; Scaly union would duplicate the shared fields across every variant and model
; the shared graph awkwardly. The tag replaces C++ virtual dispatch.
;
; Entities and Notations are referenced by IDENTITY only (a borrowed
; reference); their concepts land in LATER modules, which a `use` bridges.
; `Text` is a
; minimal seed here (a StringC plus fixed-equality) — the full content Text
; (TextIter/TextItem, per-char locations, subst tables) lands with the parser
; stage, which is also where the message-emitting value NORMALISATION/VALIDATION
; (makeValue's category checks, length limits, allowed-value/notation/entity/id
; resolution through the live AttributeContext) is driven. This increment ports
; the type structure, the pure classification/`buildDesc` logic, the missing-
; value selection, and the tokenized-value token splitting; it is exercised by
; a synthetic AttributeContext with no live parser behind it.

; --- Text (minimal seed) --------------------------------------------------
; The full content Text lands with the parser; the attribute layer needs only
; the normalized string and content equality.
define Text (str: StringC, locs: pointer[Location](null), sdata_runs: ref[Array[size_t]]?(null), nonsgml_items: ref[Array[size_t]]?(null), var delim_loc: Location(Location()))
{
    init(str: StringC) linked

    ; The reference Text records a Location per stored char (addChar); ours is
    ; optional (an empty view = untracked) and only the attribute-literal path
    ; fills it — the consumers are the ID/IDREF token locations
    ; (tokenLocation(i)), which must survive entity expansion and value
    ; normalization, so a source-offset reconstruction cannot stand in. One
    ; Location per stored char, so the view's length IS `str`'s size — which
    ; is why the FIELD stays a bare pointer: a `Slice` here is +8 bytes on
    ; every attribute-value record (+4.6 MB on the ClaML transform, measured
    ; and taken back, history 2026-09-06 (27)); the view lives in get_locs().
    init(str: StringC, locs: Slice[Location]) linked

    ; The same with the location block as another Text holds it -- run form
    ; included (see loc_at) -- for a Text that takes over that one's value.
    init(str: StringC, locs: pointer[Location]) linked

    ; Literal text with SDATA item runs (Text::addSdata): flat (start,end)
    ; char-index pairs into str, in order — the ESIS attribute writer renders
    ; those ranges between `\|` markers. null/empty = no sdata items.
    init(str: StringC, locs: Slice[Location], sdata_runs: ref[Array[size_t]]?) linked

    ; Literal text with SDATA runs AND non-SGML items (Text::addNonSgmlChar):
    ; nonsgml_items is a flat (char-index, char-code) pair list — the port
    ; drops the char from str (the plain writer never prints it), so the index
    ; names the position BETWEEN str chars where the item sits; -ononsgml
    ; renders `\%N;` there.
    init(str: StringC, locs: Slice[Location], sdata_runs: ref[Array[size_t]]?, nonsgml_items: ref[Array[size_t]]?) linked

    ; the SDATA (start,end) run pairs, null when the text has none.
    function get_sdata_runs(this: Text) @ret_param_0 true @deep true returns ref[Array[size_t]]? linked

    ; the non-SGML (index, char) pairs, null when the text has none.
    function get_nonsgml_items(this: Text) @ret_param_0 true @deep true returns ref[Array[size_t]]? linked

    ; Text::addStartDelim (literalDelimInfo): the literal's opening delimiter
    ; location — recorded only when markup capture is on (the -o axis:
    ; -otagomit instance markup / -ocomment prolog markup). It is the FIRST
    ; Text item, so handleAsUnterminated's startLoc anchors here (the quote)
    ; instead of the first char — a probed reference column shift.
    function get_delim_loc(this: Text) @page true @direct true @ret_param_0 true @deep true returns Location linked

    procedure set_delim_loc(mutable this: ref[Text], l: Location) @deep true @deep_this_2 true @deep_whole_2 true linked

    function has_locs(this: Text) @ret_param_0 true @deep true returns bool linked

    ; the location block as it is held (null = untracked): for handing to
    ; another Text over the same characters, nothing else
    function raw_locs(this: Text) @ret_param_0 true @deep true returns pointer[Location] linked

    ; ★The block has TWO forms. One Location per stored char is the general
    ; one. Where every char follows the one before it in ONE origin -- a
    ; literal with no entity or character reference in it, which is nearly
    ; all of them -- the block is two entries instead: a marker no real
    ; location can be (no origin, index 0xFFFFFFFF) and the location of the
    ; first char. Sixteen bytes a character were the largest single part of an
    ; attribute value (measured 2026-10-07: 11 MB of a 70 MB grove). Text.run_
    ; locs makes that form; every reader goes through loc_at or locs_on.
    function is_run(this: Text) @ret_param_0 true @deep true returns bool linked

    ; Location of the i-th stored char (Text::charLocation analog); a null
    ; Location for untracked text.
    function loc_at(this: Text, i: size_t) @page true @direct true @deep true returns Location linked

    ; One Location per char on `host`, whichever form this Text holds (empty
    ; for untracked text): for the few consumers that keep a view.
    procedure locs_on(this: Text, host: ref[Page]) @page true @direct true @ret_explicit_1 true @deep true returns Slice[Location] linked

    ; The run form's block on `host`: n chars from `first` on.
    procedure run_locs(host: ref[Page], first: Location) @page true @direct true @ret_explicit_0 true @deep true returns Slice[Location] linked

    function string(this: Text) @page true @direct true @ret_param_0 true @deep true returns StringC linked

    function size(this: Text) @ret_param_0 true @deep true returns size_t linked

    ; Text::fixedEqual compares content ignoring location; string equality is
    ; the faithful essence here.
    function fixed_equal(this: Text, other: ref[Text]) @ret_nonlocal true @deep true returns bool linked
}

; --- DeclaredValue kinds (DVK_*) ------------------------------------------
define DVK_CDATA: int 0
define DVK_TOKENIZED: int 1
define DVK_GROUP: int 2
define DVK_NAMETOKENGROUP: int 3
define DVK_NOTATION: int 4
define DVK_ENTITY: int 5
define DVK_ID: int 6
define DVK_IDREF: int 7
define DVK_DATA: int 8

; TokenizedDeclaredValue::TokenType (same order as AttributeDefinitionDesc).
define TT_NAME: int 0
define TT_NUMBER: int 1
define TT_NAMETOKEN: int 2
define TT_NUMBERTOKEN: int 3
define TT_ENTITYNAME: int 4

; AttributeDefinitionDesc::DeclaredValue enum (the declaration-dump target).
define ADV_CDATA: int 0
define ADV_NAME: int 1
define ADV_NUMBER: int 2
define ADV_NMTOKEN: int 3
define ADV_NUTOKEN: int 4
define ADV_ENTITY: int 5
define ADV_IDREF: int 6
define ADV_NAMES: int 7
define ADV_NUMBERS: int 8
define ADV_NMTOKENS: int 9
define ADV_NUTOKENS: int 10
define ADV_ENTITIES: int 11
define ADV_IDREFS: int 12
define ADV_ID: int 13
define ADV_NOTATION: int 14
define ADV_NAMETOKENGROUP: int 15

; AttributeDefinitionDesc::DefaultValueType.
define DVT_REQUIRED: int 0
define DVT_CURRENT: int 1
define DVT_IMPLIED: int 2
define DVT_CONREF: int 3
define DVT_DEFAULTED: int 4
define DVT_FIXED: int 5

; AttributeValue::Type.
define AVT_IMPLIED: int 0
define AVT_CDATA: int 1
define AVT_TOKENIZED: int 2

; AttributeValue kinds (AVK_*).
define AVK_IMPLIED: int 0
define AVK_CDATA: int 1
define AVK_TOKENIZED: int 2
define AVK_DATA: int 3

; AttributeSemantics kinds (ASK_*).
define ASK_ENTITY: int 0
define ASK_NOTATION: int 1

; AttributeDefinition kinds (ADK_*).
define ADK_REQUIRED: int 0
define ADK_CURRENT: int 1
define ADK_IMPLIED: int 2
define ADK_CONREF: int 3
define ADK_DEFAULT: int 4
define ADK_FIXED: int 5

; --- AttributeDefinitionDesc ---------------------------------------------
; The plain declaration-dump struct getDesc() fills.
define AttributeDefinitionDesc
(
    var declared_value: int
    var default_value_type: int
    var current_index: size_t
    var allowed_values: ref[Array[StringC]]?
    var orig_allowed_values: ref[Array[StringC]]?
)
{
    function make(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[AttributeDefinitionDesc] linked
}

; --- DeclaredValue --------------------------------------------------------
define DeclaredValue
(
    var dv_kind: int
    var token_type: int
    var is_list: bool
    var initial_categories: int
    var subsequent_categories: int
    var allowed_values: ref[Array[StringC]]?
    var orig_allowed_values: ref[Array[StringC]]?
    ; DataDeclaredValue (Attribute.h:534) — the WWW `DATA notation [specs]`
    ; declared value: a CDATA value that carries its notation + the data-
    ; attribute list, both borrowed like ExternalDataEntity's.
    var data_notation: ref[Notation]?
    var data_attributes: ref[AttributeList]?
)
{
    function alloc(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[DeclaredValue] linked

    ; DataDeclaredValue::DataDeclaredValue (Attribute.cxx:126).
    ; DataDeclaredValue's payload (the -odata-attribute A-record shape and the
    ; D records): the declared notation + the finished data-attribute list —
    ; makeValue shares them into every DataAttributeValue.
    function get_data_notation(this: DeclaredValue) @ret_param_0 true @deep true returns ref[Notation]? linked

    function get_data_attributes(this: DeclaredValue) @ret_param_0 true @deep true returns ref[AttributeList]? linked

    function make_data(host: ref[Page], notation: ref[Notation]?, attributes: ref[AttributeList]?) @deep true returns ref[DeclaredValue] linked

    ; The TokenizedDeclaredValue ctor's category selection per TokenType.
    procedure set_categories(mutable p: ref[DeclaredValue], type: int) @deep true linked

    function make_cdata(host: ref[Page]) @deep true returns ref[DeclaredValue] linked

    function make_tokenized(host: ref[Page], type: int, is_list: bool) @deep true returns ref[DeclaredValue] linked

    function make_group(host: ref[Page], type: int, allowed: ref[Array[StringC]]) @deep true returns ref[DeclaredValue] linked

    procedure make_name_token_group(host: ref[Page], mutable allowed: ref[Array[StringC]]) @deep true returns ref[DeclaredValue] linked

    procedure make_notation(host: ref[Page], mutable allowed: ref[Array[StringC]]) @deep true returns ref[DeclaredValue] linked

    function make_entity(host: ref[Page], is_list: bool) @deep true returns ref[DeclaredValue] linked

    function make_id(host: ref[Page]) @deep true returns ref[DeclaredValue] linked

    function make_idref(host: ref[Page], is_list: bool) @deep true returns ref[DeclaredValue] linked

    function tokenized(this: DeclaredValue) @ret_nonlocal true @deep true returns bool linked

    function is_notation(this: DeclaredValue) @ret_param_0 true @deep true returns bool linked

    function is_entity(this: DeclaredValue) @ret_param_0 true @deep true returns bool linked

    function is_id(this: DeclaredValue) @ret_param_0 true @deep true returns bool linked

    function is_idref(this: DeclaredValue) @ret_param_0 true @deep true returns bool linked

    function get_initial_categories(this: DeclaredValue) @ret_param_0 true @deep true returns int linked

    function get_subsequent_categories(this: DeclaredValue) @ret_param_0 true @deep true returns int linked

    function get_is_list(this: DeclaredValue) @ret_param_0 true @deep true returns bool linked

    function contains_token(this: DeclaredValue, token: StringC) @ret_nonlocal true @deep true returns bool linked

    function get_tokens(this: DeclaredValue) @ret_param_0 true @deep true returns ref[Array[StringC]]? linked

    function get_orig_tokens(this: DeclaredValue) @ret_param_0 true @deep true returns ref[Array[StringC]] linked

    ; The base TokenizedDeclaredValue::buildDesc arithmetic:
    ;   (type - TokenType.name) + (isList ? names : name)
    function tokenized_adv(this: DeclaredValue) @ret_param_0 true @deep true returns int linked

    ; DeclaredValue::buildDesc (all variants). Fills desc.declared_value plus,
    ; for the group family, the allowed-value vectors.
    procedure build_desc(this: DeclaredValue, mutable desc: ref[AttributeDefinitionDesc]) @deep true linked

    ; DeclaredValue::copy — shallow in one region (allowed-value vectors shared).
    function copy(this: DeclaredValue, host: ref[Page]) @ret_param_0 true @deep true returns ref[DeclaredValue] linked

    function test() @ret_nonlocal true @deep true returns int linked
}

; --- AttributeValue -------------------------------------------------------
define AttributeValue
(
    av_kind: int
    text: ref[Text]?
    space_index: ref[Array[size_t]]?
    notation: ref[Notation]?
    data_attributes: ref[AttributeList]?
)
{
    function make_implied(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[AttributeValue] linked

    function make_cdata(host: ref[Page], text: ref[Text]) @ret_explicit_0 true @deep true returns ref[AttributeValue] linked

    ; DataAttributeValue (Attribute.cxx:1129) — a CDATA value carrying the DATA
    ; declared value's notation + shared data-attribute list (-odata-attribute).
    function make_cdata_data(host: ref[Page], text: ref[Text], notation: ref[Notation]?, data_attributes: ref[AttributeList]?) @ret_explicit_0 true @deep true returns ref[AttributeValue] linked

    function make_tokenized(host: ref[Page], text: ref[Text], space_index: ref[Array[size_t]]?) @ret_explicit_0 true @deep true returns ref[AttributeValue] linked

    ; CdataAttributeValue::notation / DataAttributeValue::attributes.
    function get_cdata_notation(this: AttributeValue) @ret_param_0 true @deep true returns ref[Notation]? linked

    function get_data_attributes(this: AttributeValue) @ret_param_0 true @deep true returns ref[AttributeList]? linked

    ; AttributeValue::info -> the Type discriminant.
    function value_type(this: AttributeValue) @deep true returns int linked

    function get_text(this: AttributeValue) @ret_param_0 true @deep true returns ref[Text]? linked

    function is_tokenized(this: AttributeValue) @ret_param_0 true @deep true returns bool linked

    ; The normalized value string (tokenized values return their Text string).
    function get_string(this: AttributeValue) @page true @direct true @ret_param_0 true @deep true returns StringC linked

    function get_space_index(this: AttributeValue) @ret_param_0 true @deep true returns ref[Array[size_t]]? linked

    function n_tokens(this: AttributeValue) @ret_param_0 true @deep true returns size_t linked

    ; TokenizedAttributeValue::token — the i-th whitespace-separated token.
    function token(this: AttributeValue, i: size_t) @page true @direct true @ret_param_0 true @deep true returns StringC linked

    function test() @ret_nonlocal true @deep true returns int linked
}

; --- AttributeSemantics ---------------------------------------------------
; Entity/Notation identities are borrowed pointers (their concepts land with
; the Dtd increment); this holds them for later drop-in resolution.
define AttributeSemantics
(
    as_kind: int
    entities: ref[Array[ref[Entity]?]]?
    notation: ref[Notation]?
)
{
    function make_entity(host: ref[Page], entities: ref[Array[ref[Entity]?]]) @ret_explicit_0 true @deep true returns ref[AttributeSemantics] linked

    function make_notation(host: ref[Page], notation: ref[Notation]?) @ret_explicit_0 true @deep true returns ref[AttributeSemantics] linked

    function n_entities(this: AttributeSemantics) @ret_param_0 true @deep true returns size_t linked

    function entity(this: AttributeSemantics, i: size_t) @ret_param_0 true @deep true returns ref[Entity]? linked

    function get_notation(this: AttributeSemantics) @ret_param_0 true @deep true returns ref[Notation]? linked

    function test() @ret_nonlocal true @deep true returns int linked
}

; --- Attribute (a single spec slot) ---------------------------------------
define Attribute
(
    var spec_index_plus: size_t
    var value: ref[AttributeValue]?
    var semantics: ref[AttributeSemantics]?
)
{
    function make(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[Attribute] linked

    function specified(this: Attribute) @ret_param_0 true @deep true returns bool linked

    function spec_index(this: Attribute) @ret_param_0 true @deep true returns size_t linked

    function get_value(this: Attribute) @ret_param_0 true @deep true returns ref[AttributeValue]? linked

    function get_semantics(this: Attribute) @ret_param_0 true @deep true returns ref[AttributeSemantics]? linked

    procedure set_spec(mutable this: ref[Attribute], index: size_t) @deep true linked

    procedure set_value(mutable this: ref[Attribute], value: ref[AttributeValue]?) @deep true @deep_this_2 true @deep_whole_2 true linked

    procedure set_semantics(mutable this: ref[Attribute], semantics: ref[AttributeSemantics]) @deep true @deep_this_2 true @deep_whole_2 true linked

    procedure clear(mutable this: ref[Attribute]) @deep true linked

    function test() @ret_nonlocal true @deep true returns int linked
}

; --- AttributeContext (Messenger) -----------------------------------------
; A minimal concrete context: the flags the missing-value / validation paths
; consult plus a message counter for test observability. The parser stage
; supplies the live subclass (id table, entity/notation lookup, current-value
; store); the getters here return the abstract defaults.
define AttributeContext
(
    host: ref[Page]
    var syntax: ref[Syntax]?
    var do_validate: bool
    var may_default: bool
    var n_messages: int
    var implied_value: ref[AttributeValue]?
    var current_values: Slice[ref[AttributeValue]?]
    var n_current: size_t
)
{
    function make(host: ref[Page], syntax: ref[Syntax]?, do_validate: bool, may_default: bool) @ret_explicit_0 true @deep true returns ref[AttributeContext] linked

    function validate(this: AttributeContext) @ret_param_0 true @deep true returns bool linked

    function may_default_attribute(this: AttributeContext) @ret_param_0 true @deep true returns bool linked

    function attribute_syntax(this: AttributeContext) @ret_param_0 true @deep true returns ref[Syntax]? linked

    ; Flags/syntax setters — the live ParserState wires these from the Sd
    ; (mayDefaultAttribute = omittag||attributeDefault; validate = typeValid)
    ; and the concrete syntax once they are known (ParserState.setSd/setSyntax).
    procedure set_validate(mutable this: ref[AttributeContext], b: bool) @deep true linked

    procedure set_may_default(mutable this: ref[AttributeContext], b: bool) @deep true linked

    procedure set_syntax(mutable this: ref[AttributeContext], syn: ref[Syntax]?) @deep true @deep_this_2 true @deep_whole_2 true linked

    procedure message(mutable this: ref[AttributeContext]) @deep true linked

    ; AttributeContext::makeImpliedAttributeValue — cached ImpliedAttributeValue.
    procedure make_implied_attribute_value(mutable this: ref[AttributeContext]) @ret_param_0 true @deep true returns ref[AttributeValue] linked

    ; The CURRENT-attribute value store (ParserState::currentAttributes_,
    ; ParserState.cxx:474): sized to the DTD's nCurrentAttribute at instance
    ; start. Before start_current_store runs the store is null — note/get are
    ; no-ops, which is the reference's inInstance() gate (noteCurrentAttribute
    ; and getCurrentAttribute both bail outside the instance).
    procedure start_current_store(mutable this: ref[AttributeContext], n: size_t) @deep true linked

    ; ParserState::noteCurrentAttribute — remember the last specified value of
    ; a CURRENT attribute (called from the checkValue path on specified values).
    procedure note_current_attribute(mutable this: ref[AttributeContext], index: size_t, v: ref[AttributeValue]?) @persists true @deep true @deep_this_4 true @deep_whole_4 true linked

    ; How many CURRENT-attribute slots this context carries (0 before
    ; start_current_store, and for every DTD that declares none).
    ; ParserState.attribute_host reads it: a CURRENT value is stored by RAW
    ; POINTER in note_current_attribute above and reused by a LATER element, so
    ; it must not live on a drainable region.
    function n_current_store(this: AttributeContext) @ret_param_0 true @deep true returns size_t linked

    ; ParserState::getCurrentAttribute — the value a missing CURRENT attribute
    ; reuses (null until the attribute was specified once).
    function get_current_attribute(this: AttributeContext, index: size_t) @ret_param_0 true @deep true returns ref[AttributeValue]? linked

    function get_attribute_entity(this: AttributeContext, name: StringC) @ret_nonlocal true @deep true returns ref[Entity]? linked

    function get_attribute_notation(this: AttributeContext, name: StringC) @ret_nonlocal true @deep true returns ref[Notation]? linked

    function test() @ret_nonlocal true @deep true returns int linked
}

; --- AttributeDefinition --------------------------------------------------
define AttributeDefinition
(
    ad_kind: int
    var is_implicit: bool
    var is_all: bool
    name: StringC
    var orig_name: StringC
    declared_value: ref[DeclaredValue]?
    var current_index: size_t
    var default_value: ref[AttributeValue]?
)
{
    function alloc(host: ref[Page], ad_kind: int, name: StringC, value: ref[DeclaredValue]?) @ret_explicit_0 true @deep true returns ref[AttributeDefinition] linked

    function make_required(host: ref[Page], name: StringC, value: ref[DeclaredValue]) @ret_explicit_0 true @deep true returns ref[AttributeDefinition] linked

    procedure make_current(host: ref[Page], mutable name: StringC, mutable value: ref[DeclaredValue], index: size_t) @ret_explicit_0 true @deep true returns ref[AttributeDefinition] linked

    function make_implied(host: ref[Page], name: StringC, value: ref[DeclaredValue]) @ret_explicit_0 true @deep true returns ref[AttributeDefinition] linked

    function make_conref(host: ref[Page], name: StringC, value: ref[DeclaredValue]) @ret_explicit_0 true @deep true returns ref[AttributeDefinition] linked

    procedure make_default(host: ref[Page], mutable name: StringC, mutable value: ref[DeclaredValue], default_value: ref[AttributeValue]) @ret_args_9 true @deep true returns ref[AttributeDefinition] linked

    procedure make_fixed(host: ref[Page], mutable name: StringC, mutable value: ref[DeclaredValue], default_value: ref[AttributeValue]) @ret_args_9 true @deep true returns ref[AttributeDefinition] linked

    function get_name(this: AttributeDefinition) @page true @direct true @ret_param_0 true @deep true returns StringC linked

    ; AttributeDefinition::copy() — a member-wise clone (the AFDR/#ALL merge
    ; paths append COPIES so the per-copy specified flags stay independent;
    ; the declared value itself is immutable and shared).
    procedure copy(mutable this: AttributeDefinition, host: ref[Page]) @ret_args_3 true @deep true returns ref[AttributeDefinition] linked

    function get_declared_value(this: AttributeDefinition) @ret_param_0 true @deep true returns ref[DeclaredValue]? linked

    function get_orig_name(this: AttributeDefinition) @page true @direct true @ret_param_0 true @deep true returns StringC linked

    procedure set_orig_name(mutable this: ref[AttributeDefinition], orig_name: StringC) @deep true @deep_this_2 true @deep_whole_2 true linked

    function tokenized(this: AttributeDefinition) @ret_param_0 true @deep true returns bool linked

    function is_notation(this: AttributeDefinition) @ret_param_0 true @deep true returns bool linked

    function is_entity(this: AttributeDefinition) @ret_param_0 true @deep true returns bool linked

    function is_id(this: AttributeDefinition) @ret_param_0 true @deep true returns bool linked

    function is_idref(this: AttributeDefinition) @ret_param_0 true @deep true returns bool linked

    function contains_token(this: AttributeDefinition, token: StringC) @ret_param_0 true @deep true returns bool linked

    function is_conref(this: AttributeDefinition) @ret_param_0 true @deep true returns bool linked

    function is_current(this: AttributeDefinition) @ret_param_0 true @deep true returns bool linked

    function is_fixed(this: AttributeDefinition) @ret_param_0 true @deep true returns bool linked

    ; The kind discriminant — the parser's missing-value message sweep
    ; re-derives the reference's virtual makeMissingValue dispatch from it.
    function get_ad_kind(this: AttributeDefinition) @ret_param_0 true @deep true returns int linked

    function get_current_index(this: AttributeDefinition) @ret_param_0 true @deep true returns size_t linked

    function get_default_value(this: AttributeDefinition) @ret_param_0 true @deep true returns ref[AttributeValue]? linked

    function get_tokens(this: AttributeDefinition) @ret_param_0 true @deep true returns ref[Array[StringC]]? linked

    ; AttributeDefinition::buildDesc — the default-value-type half.
    procedure build_desc(this: AttributeDefinition, mutable desc: ref[AttributeDefinitionDesc]) @deep true linked

    ; AttributeDefinition::getDesc — reset, then both buildDesc halves.
    procedure get_desc(this: AttributeDefinition, mutable desc: ref[AttributeDefinitionDesc]) @ret_param_0 true @deep true linked

    procedure set_specified(mutable this: ref[AttributeDefinition], is_implicit: bool) @deep true linked

    procedure is_specified(this: AttributeDefinition, mutable out_implicit: ref[bool]) @ret_param_0 true @deep true returns bool linked

    ; AttributeDefinition::makeMissingValue — the branch that picks the value a
    ; missing attribute gets (messages counted through the context).
    procedure make_missing_value(this: AttributeDefinition, mutable context: ref[AttributeContext]) @ret_args_3 true @deep true returns ref[AttributeValue]? linked

    function test() @ret_nonlocal true @deep true returns int linked
}
