use scaly.memory.Page
use opensp.StringC.StringC

; XcharMap — XcharMap.cs (120 LOC). A map from an Xchar (an i32 = any Char value
; plus the -1 end-of-entity / EOF sentinel) to a value. C++ backs it with a
; SharedXcharMap of 2 + 0xFFFF entries whose ptr() points at v[1], so index -1
; (EOF) lands at v[0] and Char c lands at v[c+1].
;
; This port specializes the value type T to PackedBoolean (u8): the ONLY
; instantiation of XcharMap in OpenSP is `XcharMap<PackedBoolean> normalMap_` on
; ParserState (the "is this Char normal data?" bitmap). The [-1, 0xFFFF] range is
; held densely with the +1 offset; chars above 0xFFFF (C++'s separate hiMap_) are
; outside the reference/XML syntax's 8-bit character scope (matching the
; Partition 0..255 scope of Increment B) and clamp to the default value — a
; documented deferral, not a general-charset regression.
;
; PORT SHAPE: page-hosted flat struct. The backing buffer is a single u8 array of
; XCHARMAP_SIZE bytes region-allocated on the run's page; get/setRange/setChar
; mutate through that pointer (the map value can be copied freely — the buffer is
; shared, one region per run).

define XCHARMAP_HI: size_t 0xFFFF        ; highest densely-held Char
define XCHARMAP_SIZE: size_t 0x10001     ; 2 + 0xFFFF entries (index -1 .. 0xFFFF)

define XcharMap (v: Slice[u8], default_value: u8)
{
    function make(host: ref[Page], default_value: u8) @ret_caller true returns ref[XcharMap] linked












    ; operator[](Xchar c): index -1 (EOF) -> v[0]; Char c -> v[c+1]. Chars above
    ; the densely-held range return the default (see hiMap_ deferral above).
    function get(this: XcharMap, c: i32) @ret_param_0 true returns u8 linked







    ; setRange(Char min, Char max, T val): fill [min, max] (clamped to 0xFFFF).
    procedure set_range(mutable this: XcharMap, min: u32, max: u32, val: u8) linked
















    ; setChar(Char c, T val).
    procedure set_char(mutable this: XcharMap, c: u32, val: u8) @persists true linked







    ; setEe(T val): the value for the -1 EOF sentinel (v[0]).
    procedure set_ee(mutable this: XcharMap, val: u8) @persists true @ret_nonlocal true linked


    function test() @ret_nonlocal true returns int linked













































}
