use scaly.memory.Page

; StringC — OpenSP's string of Char (Char = u32 codepoint). In C++ it is a
; String<Char> value type over a resizable buffer; here it is a small value
; { data, size } whose Char buffer is region-allocated on the value's own
; page (Page.get(this)), mirroring scaly.containers.String's residency but
; over u32 elements. Copies are shallow (fine inside one parse region); the
; byte<->Char boundary is handled by CodingSystems, never here.
;
; Char is u32 throughout; CHAR_BYTES is its element size for allocation.
define CHAR_BYTES: size_t 4

define StringC @resident true (var data: pointer[u32](null), var size: size_t(0))
{
    ; Empty string — no allocation.
    init() linked





    ; Copy n Chars from a raw buffer onto this value's page.
    init(chars: pointer[u32], n: size_t) linked













    ; Copy the Chars a borrowed view names onto this value's page.  The twin of
    ; the (chars, n) init above, and the one the call sites want: opensp hands a
    ; buffer and its length around as two arguments at 125 sites, of which only
    ; four ever reach a C function -- see `as_slice` below.
    ;
    ; ★The two 1-argument inits are told apart by TYPE, which CLAUDE.md's
    ; "selection is by argument COUNT" is too coarse to promise: probed before
    ; this was written, `Box^host("xy")` and `Box^host(<Slice[u32]>)` each
    ; reached their own init.  With `init(other: StringC)` there would be a
    ; THIRD, and it is deliberately absent: a copy has a spelling already
    ; (`StringC^host(x.as_slice())`), and a second one would be a second way to
    ; say the same thing.
    init(chars: Slice[u32]) linked














    ; The same widening for a BORROWED VIEW: the ports' ASCII-literal parameters are
    ; `Slice[char]` since 2026-09-06. Both one-argument inits stay: a LITERAL at a
    ; call site still resolves to the pointer init below, a Slice variable to this
    ; one (probed with all three one-argument inits declared, `Slice[u32]` included).
    init(ascii: Slice[char]) linked



















    ; Widen an ASCII/Latin-1 C string to Char (StringC.cs's string ctor:
    ; per-char zero-extend). The byte<->Char boundary otherwise lives in
    ; CodingSystems; this is only for building literal message/diagnostic text.
    init(ascii: pointer[const_char]) linked



















    function get_size(this: StringC) @ret_param_0 true returns size_t linked


    ; Raw Char buffer (region-resident) — for handing content to an InputSource.
    ;
    ; ★★★THIS ACCESSOR IS THE C BOUNDARY AND NOTHING ELSE.  Measured 2026-09-04:
    ; of its 201 call sites exactly FOUR reach a C function; the rest handed the
    ; pointer straight back into Scaly code, almost always as the pair
    ; `StringC^host(x.data_ptr(), x.get_size())`.  A `StringC` IS `{data, size}`
    ; -- a `Slice[u32]` under another name -- so that pair was a slice taken
    ; apart and put back together.  `as_slice` is the form for everything that
    ; does not cross into C; reach for `data_ptr` only when a C prototype is on
    ; the other side.
    function data_ptr(this: StringC) @ret_param_0 true returns pointer[u32] linked


    ; The Chars as a borrowed view.  Allocates nothing and copies nothing: the
    ; buffer stays where it is and the view names it.
    ;
    ; ★`Slice` is `{length, data}` in that order, and the field-order check
    ; (`report_component_type_mismatch#`) is what makes writing it out safe.
    ;
    ; ★★★AND IT COSTS NOTHING, WHICH IS NOT OBVIOUS AND HAD TO BE MEASURED: a
    ; `Slice` is a 16-byte value, so the RAW emission returns it through an
    ; `sret` slot where the pair `data_ptr()`/`get_size()` was two register
    ; returns -- exactly the memory round-trip CLAUDE.md charges against
    ; `Primitive.args`.  In the SHIPPED binary it is gone: after whole-program
    ; `opt -O2` on the opensp root, ZERO of the 48 `as_slice` calls survive and
    ; the `Slice[u32]` allocas fall 197 -> 38.  Wall clock over the tree's own
    ; grammar (60 parses of `scaly.sgm`) is 0.63 s either way and the binary
    ; grows 168 bytes.  ★The difference to `Primitive.args` is inlining: this
    ; accessor is two loads, `dispatch` is far too large to inline into
    ; `prim_call`.  A Slice-by-value is expensive across a call that STAYS a
    ; call, not across one that folds.
    function as_slice(this: StringC) @page true @direct true @ret_param_0 true returns Slice[u32] linked


    function get(this: StringC, index: size_t) returns u32 linked







    ; A copy of the [start, start+len) Char slice as a fresh StringC (buffer on
    ; the returned value's own page). Out-of-range slices clamp to empty.
    function substr(this: StringC, start: size_t, len: size_t) @page true @direct true @ret_caller true returns StringC linked











    function equals(this: StringC, other: StringC) @ret_nonlocal true returns bool linked










    function test() @ret_nonlocal true returns int linked



































































}
