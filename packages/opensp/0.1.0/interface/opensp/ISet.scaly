use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC

; ISet<Char> — a set of characters held as a sorted list of coalesced,
; disjoint inclusive ranges (ISet.cs / ISet.h). The scanner's Partition uses
; it to describe the character sets (nameStart, digit, sgmlChar, ...) it
; refines into equivalence classes.
;
; Char is a u32 codepoint. Ranges are stored in an `Array[ISetRange]` used as
; raw growable storage with a separate live-count `n` (Array cannot shrink, and
; addRange/remove both delete ranges on coalesce/split) — the same live-count
; idiom ContentToken uses for follow sets. Every ISet is page-hosted
; (`ISet^host()`) so Page.get(this) resolves the arena page.

define ISetRange (var min: u32, var max: u32)
{
    init(min: u32, max: u32) linked
}

define ISet @resident true (ranges: ref[Array[ISetRange]], var n: size_t)
{
    init() linked

    function get_count(this: ISet) @ret_param_0 true @deep true returns size_t linked

    function range_at(this: ISet, i: size_t) @ret_param_0 true @deep true returns ref[ISetRange] linked

    function range_min(this: ISet, i: size_t) @ret_param_0 true @deep true returns u32 linked

    function range_max(this: ISet, i: size_t) @ret_param_0 true @deep true returns u32 linked

    function is_empty(this: ISet) @ret_param_0 true @deep true returns bool linked

    function is_singleton(this: ISet) @ret_param_0 true @deep true returns bool linked

    procedure clear(mutable this: ISet) @deep true linked

    ; Grow backing storage so index m-1 is a valid buffer slot.
    procedure reserve(mutable this: ISet, m: size_t) @deep true linked

    function contains(this: ISet, x: u32) @ret_param_0 true @deep true returns bool linked

    procedure add(mutable this: ISet, x: u32) @ret_nonlocal true @deep true linked

    ; void addRange(T, T) — insert [lo,hi], coalescing with adjacent ranges.
    procedure add_range(mutable this: ISet, lo: u32, hi: u32) @deep true linked

    ; void remove(T) — delete a single char, splitting a range if interior.
    procedure remove(mutable this: ISet, c: u32) @deep true linked

    function test() @ret_nonlocal true @deep true returns int linked
}
