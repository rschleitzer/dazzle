use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.ISet.ISet
use opensp.Sd.Sd
use opensp.Syntax.Syntax
use opensp.Partition.Partition
use opensp.Trie.TrieNode
use opensp.Trie.TrieBuilder
use opensp.ModeInfo.ModeInfo
use opensp.ModeInfo.TokenInfo
use opensp.ModeInfo.PackedTokenInfo
use opensp.Location.InputSource
use opensp.Location.Origin

; Recognizer — the trie-driven token scanner (Recognizer.cs) plus the
; compile-modes driver (Parser::compileModes, minus the shortref/DTD path).
;
; `build_recognizer` mirrors compileModes for a SINGLE mode: it walks that
; mode's ModeInfo token list twice — first to collect the delimiter/function
; chars and character sets it needs (which seed the Partition's equivalence
; codes), then to thread each token's code sequence into a TrieBuilder. The
; resulting Recognizer maps each scanned char to its EquivCode and walks the
; trie greedily; `end_token` then commits the longest recognized prefix.
;
; The reference syntax is single-code (multicode = false), so `recognize`
; takes the plain `start_token_no_multicode` path — no scanSuppress / markup-
; scan table. Shortref B-sequences (the BlankTrie machinery) are deferred with
; the Dtd increment; the driver never passes a DTD, so no blank node is built.

define Recognizer (root: pointer[TrieNode], partition: pointer[Partition])
{
    init(root: pointer[TrieNode], partition: pointer[Partition])
    {
        set this.root: root
        set this.partition: partition
    }

    ; Token recognize(InputSource*, Messenger&) const — one token at the cursor.
    function recognize(this: Recognizer, input: pointer[InputSource]) returns u32
    {
        input.start_token_no_multicode()
        var pos: pointer[TrieNode] root
        repeat
        {
            let ch input.token_char()
            let code partition.code_of_xchar(ch)
            set pos: pos.child(code as int)
            if pos = null
                break
            if pos.has_next() = false
                break
        }
        if pos = null
        {
            input.end_token(0 as size_t)
            return tokenUnrecognized
        }
        input.end_token(pos.get_token_length() as size_t)
        pos.get_token()
    }

    ; Build the recognizer for one Mode from the syntax + mode token table.
    function build_recognizer(host: pointer[Page], mode: int, sd: Sd, syn: Syntax, table: pointer[Array[PackedTokenInfo]]) returns pointer[Recognizer]
    {
        let used_delim host.allocate(N_DELIM_GENERAL as size_t, 1) as pointer[u8]
        let used_set host.allocate(N_SET as size_t, 1) as pointer[u8]
        let used_func host.allocate(3 as size_t, 1) as pointer[u8]
        zero_bytes(used_delim, N_DELIM_GENERAL as size_t)
        zero_bytes(used_set, N_SET as size_t)
        zero_bytes(used_func, 3 as size_t)

        ; --- pass 1: which delimiters / sets / functions does this mode use? ---
        let mi1 ModeInfo^host(mode, sd, table)
        var t1 TokenInfo()
        while mi1.next_token(&t1)
        {
            if t1.kind = TT_DELIM
                set *(used_delim + (t1.delim1 as size_t)): (1 as u8)
            else if t1.kind = TT_DELIMDELIM
            {
                set *(used_delim + (t1.delim1 as size_t)): (1 as u8)
                set *(used_delim + (t1.delim2 as size_t)): (1 as u8)
            }
            else if t1.kind = TT_DELIMSET
            {
                set *(used_delim + (t1.delim1 as size_t)): (1 as u8)
                set *(used_set + (t1.set_idx as size_t)): (1 as u8)
            }
            else if t1.kind = TT_SET
                set *(used_set + (t1.set_idx as size_t)): (1 as u8)
            else if t1.kind = TT_FUNCTION
                set *(used_func + (t1.func_idx as size_t)): (1 as u8)
        }

        ; --- the specific chars to distinguish (functions + delimiter chars) ---
        let chars ISet^host()
        var f: int 0
        while f < 3
        {
            if *(used_func + (f as size_t)) <> (0 as u8)
                chars.add(syn.standard_function(f))
            set f: f + 1
        }
        var d: int 0
        while d < N_DELIM_GENERAL
        {
            if *(used_delim + (d as size_t)) <> (0 as u8)
            {
                var j: size_t 0
                while j < syn.delim_general_len(d)
                {
                    chars.add(syn.delim_general_char(d, j))
                    set j: j + 1
                }
            }
            set d: d + 1
        }

        ; --- the used character sets, and each set's partition position ---
        let set_pos host.allocate((N_SET as size_t) * (4 as size_t), 4) as pointer[i32]
        var n_used: int 0
        var s: int 0
        while s < N_SET
        {
            if *(used_set + (s as size_t)) <> (0 as u8)
                set n_used: n_used + 1
            set s: s + 1
        }
        let csets host.allocate((n_used as size_t) * (sizeof pointer[void]), alignof pointer[void]) as pointer[pointer[ISet]]
        var p: int 0
        set s: 0
        while s < N_SET
        {
            if *(used_set + (s as size_t)) <> (0 as u8)
            {
                set *(csets + (p as size_t)): syn.char_set(s)
                set *(set_pos + (s as size_t)): p as i32
                set p: p + 1
            }
            else
                set *(set_pos + (s as size_t)): (-1 as i32)
            set s: s + 1
        }

        let part Partition^host(chars, csets, n_used)

        ; --- delimiter code sequences ---
        let delim_codes host.allocate((N_DELIM_GENERAL as size_t) * (sizeof pointer[void]), alignof pointer[void]) as pointer[pointer[u16]]
        set d: 0
        while d < N_DELIM_GENERAL
        {
            if *(used_delim + (d as size_t)) <> (0 as u8)
            {
                let ln syn.delim_general_len(d)
                let cb host.allocate(ln * (2 as size_t), 2) as pointer[u16]
                var j: size_t 0
                while j < ln
                {
                    set *(cb + j): part.char_code(syn.delim_general_char(d, j))
                    set j: j + 1
                }
                set *(delim_codes + (d as size_t)): cb
            }
            else
                set *(delim_codes + (d as size_t)): null
            set d: d + 1
        }

        ; --- function codes (one each) ---
        let func_codes host.allocate(3 * (2 as size_t), 2) as pointer[u16]
        set f: 0
        while f < 3
        {
            if *(used_func + (f as size_t)) <> (0 as u8)
                set *(func_codes + (f as size_t)): part.char_code(syn.standard_function(f))
            set f: f + 1
        }

        ; --- pass 2: thread each token into the trie ---
        let tb TrieBuilder^host((part.max_code() as int) + 1)
        var amb Array[u32]^host()
        tb.recognize_ee(part.ee_code(), tokenEe)

        let mi2 ModeInfo^host(mode, sd, table)
        var t2 TokenInfo()
        while mi2.next_token(&t2)
        {
            if t2.kind = TT_DELIM
            {
                let ln syn.delim_general_len(t2.delim1)
                if ln > (0 as size_t)
                    tb.recognize(*(delim_codes + (t2.delim1 as size_t)), ln, t2.token, t2.priority, amb)
            }
            else if t2.kind = TT_DELIMDELIM
            {
                let l1 syn.delim_general_len(t2.delim1)
                let l2 syn.delim_general_len(t2.delim2)
                if (l1 > (0 as size_t)) and (l2 > (0 as size_t))
                {
                    let cb host.allocate((l1 + l2) * (2 as size_t), 2) as pointer[u16]
                    let c1 *(delim_codes + (t2.delim1 as size_t))
                    let c2 *(delim_codes + (t2.delim2 as size_t))
                    var j: size_t 0
                    while j < l1
                    {
                        set *(cb + j): *(c1 + j)
                        set j: j + 1
                    }
                    var k: size_t 0
                    while k < l2
                    {
                        set *(cb + (l1 + k)): *(c2 + k)
                        set k: k + 1
                    }
                    tb.recognize(cb, l1 + l2, t2.token, t2.priority, amb)
                }
            }
            else if t2.kind = TT_DELIMSET
            {
                let ln syn.delim_general_len(t2.delim1)
                let pos *(set_pos + (t2.set_idx as size_t))
                if ln > (0 as size_t)
                    tb.recognize_set(*(delim_codes + (t2.delim1 as size_t)), ln, part.set_codes_buffer(pos as int), part.set_code_count(pos as int), t2.token, t2.priority, amb)
            }
            else if t2.kind = TT_SET
            {
                let pos *(set_pos + (t2.set_idx as size_t))
                tb.recognize_set(func_codes, 0 as size_t, part.set_codes_buffer(pos as int), part.set_code_count(pos as int), t2.token, t2.priority, amb)
            }
            else if t2.kind = TT_FUNCTION
                tb.recognize(func_codes + (t2.func_idx as size_t), 1 as size_t, t2.token, t2.priority, amb)
        }

        Recognizer^host(tb.extract_trie(), part)
    }

    function zero_bytes(p: pointer[u8], n: size_t)
    {
        var i: size_t 0
        while i < n
        {
            set *(p + i): (0 as u8)
            set i: i + 1
        }
    }

    ; --- integration test: build recognizers, tokenize sample input ---
    function tokenize(rec: pointer[Recognizer], src: pointer[InputSource]) returns u32
        rec.recognize(src)

    function test() returns int
    {
        let anchor StringC("x")
        let host Page.get(anchor.data_ptr() as pointer[void])
        let sd Sd()
        let syn Syntax^host(sd)
        let table ModeInfo.build_table(host)

        ; ---- grpMode: tokenize a content-model group "(a|b)" ----
        let grp Recognizer.build_recognizer(host, grpMode, sd, syn, table)

        var gbuf u32[6]
        let pg gbuf as pointer[u32]
        set *(pg + (0 as size_t)): (0x28 as u32)   ; (
        set *(pg + (1 as size_t)): (0x61 as u32)   ; a
        set *(pg + (2 as size_t)): (0x7C as u32)   ; |
        set *(pg + (3 as size_t)): (0x62 as u32)   ; b
        set *(pg + (4 as size_t)): (0x29 as u32)   ; )
        var origin Origin()
        var gsrc InputSource(&origin, pg, 5 as size_t)

        if grp.recognize(&gsrc) <> tokenGrpo
            return -1
        if grp.recognize(&gsrc) <> tokenNameStart
            return -2
        if grp.recognize(&gsrc) <> tokenOr
            return -3
        if grp.recognize(&gsrc) <> tokenNameStart
            return -4
        if grp.recognize(&gsrc) <> tokenGrpc
            return -5
        if grp.recognize(&gsrc) <> tokenEe
            return -6

        ; ---- econMode: a start-tag open in element content ----
        let econ Recognizer.build_recognizer(host, econMode, sd, syn, table)

        var ebuf u32[5]
        let pe ebuf as pointer[u32]
        set *(pe + (0 as size_t)): (0x3C as u32)   ; <
        set *(pe + (1 as size_t)): (0x61 as u32)   ; a
        set *(pe + (2 as size_t)): (0x62 as u32)   ; b
        var origin2 Origin()
        var esrc InputSource(&origin2, pe, 3 as size_t)

        ; "<a" -> tokenStagoNameStart (delimiter-in-context, length 2)
        if econ.recognize(&esrc) <> tokenStagoNameStart
            return -7
        if esrc.current_token_length() <> (2 as size_t)
            return -8
        ; then 'b' is a data character
        if econ.recognize(&esrc) <> tokenChar
            return -9

        ; ---- econMode: '<' NOT followed by a name-start char is data ----
        var ebuf2 u32[3]
        let pe2 ebuf2 as pointer[u32]
        set *(pe2 + (0 as size_t)): (0x3C as u32)   ; <
        set *(pe2 + (1 as size_t)): (0x20 as u32)   ; space
        var origin3 Origin()
        var esrc2 InputSource(&origin3, pe2, 2 as size_t)
        if esrc2.get_length() <> (2 as size_t)
            return -10
        if econ.recognize(&esrc2) <> tokenChar   ; '<' as data (length 1)
            return -11
        if esrc2.current_token_length() <> (1 as size_t)
            return -12
        if econ.recognize(&esrc2) <> tokenS       ; the space
            return -13

        ; ---- mdMode: markup-declaration open comment "<!--" pieces ----
        let md Recognizer.build_recognizer(host, mdMode, sd, syn, table)
        var mbuf u32[4]
        let pm mbuf as pointer[u32]
        set *(pm + (0 as size_t)): (0x28 as u32)   ; (  GRPO recognized in mdMode
        set *(pm + (1 as size_t)): (0x2D as u32)   ; -
        set *(pm + (2 as size_t)): (0x2D as u32)   ; -
        var origin4 Origin()
        var msrc InputSource(&origin4, pm, 3 as size_t)
        if md.recognize(&msrc) <> tokenGrpo
            return -14
        ; "--" is the COM delimiter in mdMode
        if md.recognize(&msrc) <> tokenCom
            return -15

        0
    }
}
