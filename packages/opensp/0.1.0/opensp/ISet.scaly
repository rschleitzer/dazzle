use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC

; ISet<Char> — a set of characters held as a sorted list of coalesced,
; disjoint inclusive ranges (ISet.cs / ISet.h). The scanner's Partition uses
; it to describe the character sets (nameStart, digit, sgmlChar, ...) it
; refines into equivalence classes.
;
; Char is a u32 codepoint. Ranges are stored in an `Array[ISetRange]` used as
; raw growable storage with a separate live-count `n` (Array cannot shrink, and
; addRange/remove both delete ranges on coalesce/split) — the same live-count
; idiom ContentToken uses for follow sets. Every ISet is page-hosted
; (`ISet^host()`) so Page.get(this) resolves the arena page.

define ISetRange (min: u32, max: u32)
{
    init(min: u32, max: u32)
    {
        set this.min: min
        set this.max: max
    }
}

define ISet (ranges: ref[Array[ISetRange]], n: size_t)
{
    init()
    {
        let host Page.get(this)
        set ranges: Array[ISetRange]^host()
        set n: 0
    }

    function get_count(this: ISet) returns size_t
        n

    function range_at(this: ISet, i: size_t) returns ref[ISetRange]
        ranges.get_buffer() + i

    function range_min(this: ISet, i: size_t) returns u32
        range_at(i).min

    function range_max(this: ISet, i: size_t) returns u32
        range_at(i).max

    function is_empty(this: ISet) returns bool
        n = 0

    function is_singleton(this: ISet) returns bool
    {
        if n <> 1
            return false

        range_at(0).min = range_at(0).max
    }

    function clear(this: ISet)
        set n: 0

    ; Grow backing storage so index m-1 is a valid buffer slot.
    function reserve(this: ISet, m: size_t)
    {
        while ranges.get_length() < m
            ranges.add(ISetRange(0, 0))
    }

    function contains(this: ISet, x: u32) returns bool
    {
        var i: size_t 0
        while i < n
        {
            if range_at(i).max >= x
                return range_at(i).min <= x
            set i: i + 1
        }
        false
    }

    function add(this: ISet, x: u32)
        add_range(x, x)

    ; void addRange(T, T) — insert [lo,hi], coalescing with adjacent ranges.
    function add_range(this: ISet, lo: u32, hi: u32)
    {
        var i: size_t
        if lo = 0
            set i: 0
        else
        {
            set i: n
            while (i > 0) and ((lo - 1) <= range_at(i - 1).max)
                set i: i - 1
        }

        ; r_[i-1].max < lo-1 <= r_[i].max
        if (i < n) and ((range_at(i).min = 0) or (hi >= (range_at(i).min - 1)))
        {
            ; coalesce into range i
            if lo < range_at(i).min
                set range_at(i).min: lo
            if hi > range_at(i).max
            {
                set range_at(i).max: hi
                var j: size_t (i + 1)
                while (j < n) and (range_at(i).max >= (range_at(j).min - 1))
                {
                    set range_at(i).max: range_at(j).max
                    set j: j + 1
                }
                ; drop coalesced ranges i+1 .. j-1
                if j > (i + 1)
                {
                    let gap (j - i - 1)
                    var k: size_t j
                    while k < n
                    {
                        set range_at(k - gap).min: range_at(k).min
                        set range_at(k - gap).max: range_at(k).max
                        set k: k + 1
                    }
                    set n: n - gap
                }
            }
        }
        else
        {
            ; insert a fresh range at i, shifting the tail right
            reserve(n + 1)
            var j: size_t n
            while j > i
            {
                set range_at(j).min: range_at(j - 1).min
                set range_at(j).max: range_at(j - 1).max
                set j: j - 1
            }
            set range_at(i).min: lo
            set range_at(i).max: hi
            set n: n + 1
        }
    }

    ; void remove(T) — delete a single char, splitting a range if interior.
    function remove(this: ISet, c: u32)
    {
        var i: size_t 0
        while i < n
        {
            if range_at(i).max >= c
            {
                if range_at(i).min <= c
                {
                    if range_at(i).min = range_at(i).max
                    {
                        var j: size_t (i + 1)
                        while j < n
                        {
                            set range_at(j - 1).min: range_at(j).min
                            set range_at(j - 1).max: range_at(j).max
                            set j: j + 1
                        }
                        set n: n - 1
                    }
                    else if c = range_at(i).min
                        set range_at(i).min: range_at(i).min + 1
                    else if c = range_at(i).max
                        set range_at(i).max: range_at(i).max - 1
                    else
                    {
                        ; interior: split into [min, c-1] and [c+1, max]
                        reserve(n + 1)
                        var j: size_t n
                        while j > (i + 1)
                        {
                            set range_at(j).min: range_at(j - 1).min
                            set range_at(j).max: range_at(j - 1).max
                            set j: j - 1
                        }
                        let old_max range_at(i).max
                        set range_at(i + 1).min: c + 1
                        set range_at(i + 1).max: old_max
                        set range_at(i).max: c - 1
                        set n: n + 1
                    }
                }
                return
            }
            set i: i + 1
        }
    }

    function test() returns int
    {
        let anchor StringC("x")
        let host Page.get(anchor.data_ptr())
        let s ISet^host()

        ; empty
        if s.is_empty() = false
            return -1
        if s.contains(5)
            return -2

        ; add a few singletons; they coalesce into one range
        s.add(3)
        s.add(4)
        s.add(5)
        if s.get_count() <> 1
            return -3
        if s.range_min(0) <> 3
            return -4
        if s.range_max(0) <> 5
            return -5
        if s.contains(4) = false
            return -6
        if s.contains(6)
            return -7

        ; a disjoint range stays separate
        s.add_range(10, 12)
        if s.get_count() <> 2
            return -8

        ; bridge them: [3,5]+[6,9]+[10,12] -> one range [3,12]
        s.add_range(6, 9)
        if s.get_count() <> 1
            return -9
        if s.range_max(0) <> 12
            return -10

        ; remove an interior char -> split
        s.remove(7)
        if s.get_count() <> 2
            return -11
        if s.contains(7)
            return -12
        if s.contains(6) = false
            return -13
        if s.contains(8) = false
            return -14

        ; remove a range endpoint -> shrink range
        s.remove(3)
        if s.contains(3)
            return -15
        if s.range_min(0) <> 4
            return -16

        ; singleton then remove -> gone
        let s2 ISet^host()
        s2.add(42)
        if s2.is_singleton() = false
            return -17
        s2.remove(42)
        if s2.is_empty() = false
            return -18

        0
    }
}
