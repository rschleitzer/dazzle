use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC

; Diagnostics — Message.cs / MessageArg.cs / MessageFormatter.cs.
;
; Stage-1 scope: the pieces that make "message formatting" testable — the
; message fragment/type, the MessageArg variants a foundation message actually
; carries (String / Number / Ordinal; Token / Location / Other args arrive with
; the layers that produce them), and the MessageFormatter's %1..%9 substitution.
; MessageArg is a C# interface; here it ports to a union (ELObj pattern), the
; MessageBuilder/OutputCharStream sink is deferred (format writes into a caller
; Char buffer, mirroring the deferred OutputByteStream in CodingSystem).

; MessageType.Severity (Message.cs).
define Severity union
(
    Info,
    Warning,
    QuantityError,
    IdrefError,
    Error
)

; MessageFragment (Message.cs): a numbered piece of message text.
define MessageFragment (number: u32(0), text: StringC)
{
    init()
    {
        set number: (0 as u32)
        set text: StringC()
    }

    init(number: u32, text: StringC)
    {
        set this.number: number
        set this.text: text
    }
}

; MessageType (Message.cs): a fragment plus a severity. isError() is true for
; everything above Warning.
define MessageType (fragment: MessageFragment, severity: Severity)
{
    init(fragment: MessageFragment, severity: Severity)
    {
        set this.fragment: fragment
        set this.severity: severity
    }

    function is_error(this: MessageType) returns bool
    {
        choose severity
            when x: Info
                false
            when x: Warning
                false
            else
                true
    }

    function get_text(this: MessageType) returns StringC
        fragment.text

    ; The one-letter severity tag onsgmls prints (MessageReporterMessages.msg:
    ; infoTag=I, warningTag=W, quantityErrorTag=Q, idrefErrorTag=X, errorTag=E).
    function severity_char(this: MessageType) returns u32
    {
        choose severity
            when x: Info
                0x49 as u32
            when x: Warning
                0x57 as u32
            when x: QuantityError
                0x51 as u32
            when x: IdrefError
                0x58 as u32
            else
                0x45 as u32
    }
}

; MessageArg — a formatted message argument. String args are quoted unless the
; formatter is in noquote mode (MessageFormatter.Builder.appendChars); Number is
; decimal; Ordinal is decimal + an English suffix keyed on n % 10 (faithful to
; MessageFormatter.Builder.appendOrdinal — no 11th/12th/13th special-casing).
; Vec is StringVectorMessageArg (MessageArg.cxx:91): each item like a String
; arg, separated by the listSep fragment ", " (unquoted). Raw is the
; ErrnoMessageArg shape (ErrnoMessageArg.cxx: strerror text substituted
; verbatim): always appended WITHOUT quotes.
define MessageArg union
(
    Str: StringC
    Num: u64
    Ord: u64
    Vec: pointer[Array[StringC]]
    Raw: StringC
)
{
    function append_to(this: MessageArg, out: pointer[u32], cap: size_t, pos: size_t, noquote: bool) returns size_t
    {
        choose this
            when s: Str
                append_string(s, out, cap, pos, noquote)
            when n: Num
                append_number(n, out, cap, pos)
            when o: Ord
                append_ordinal(o, out, cap, pos)
            when v: Vec
                append_string_vector(v, out, cap, pos, noquote)
            when r: Raw
                append_string(r, out, cap, pos, true)
    }

    function append_string_vector(this: MessageArg, v: pointer[Array[StringC]], out: pointer[u32], cap: size_t, pos: size_t, noquote: bool) returns size_t
    {
        var p pos
        if v = null
            return p
        let n v.get_length()
        let buf v.get_buffer()
        var i: size_t 0
        while i < n
        {
            if i > (0 as size_t)
            {
                set p: put(out, cap, p, 0x2C as u32)
                set p: put(out, cap, p, 0x20 as u32)
            }
            set p: append_string(*(buf + i), out, cap, p, noquote)
            set i: i + 1
        }
        p
    }

    function put(this: MessageArg, out: pointer[u32], cap: size_t, pos: size_t, c: u32) returns size_t
    {
        if pos < cap
        {
            set *(out + pos): c
            return pos + (1 as size_t)
        }
        pos
    }

    function append_string(this: MessageArg, s: StringC, out: pointer[u32], cap: size_t, pos: size_t, noquote: bool) returns size_t
    {
        var p pos
        if noquote = false
            set p: put(out, cap, p, 0x22 as u32)

        var i: size_t 0
        while i < s.get_size()
        {
            set p: put(out, cap, p, s.get(i))
            set i: i + 1
        }

        if noquote = false
            set p: put(out, cap, p, 0x22 as u32)

        p
    }

    function append_number(this: MessageArg, n: u64, out: pointer[u32], cap: size_t, pos: size_t) returns size_t
    {
        var tmp u32[24]
        let t tmp as pointer[u32]
        var count: size_t 0
        var v n
        if v = (0 as u64)
        {
            set *t: (0x30 as u32)
            set count: 1
        }
        else
        {
            while v > (0 as u64)
            {
                set *(t + count): ((0x30 as u64) + (v % (10 as u64))) as u32
                set v: v / (10 as u64)
                set count: count + 1
            }
        }

        var p pos
        var i count
        while i > (0 as size_t)
        {
            set i: i - 1
            set p: put(out, cap, p, *(t + i))
        }
        p
    }

    function append_ordinal(this: MessageArg, n: u64, out: pointer[u32], cap: size_t, pos: size_t) returns size_t
    {
        var p append_number(n, out, cap, pos)
        let r n % (10 as u64)
        if r = (1 as u64)
        {
            set p: put(out, cap, p, 0x73 as u32)
            set p: put(out, cap, p, 0x74 as u32)
        }
        else if r = (2 as u64)
        {
            set p: put(out, cap, p, 0x6E as u32)
            set p: put(out, cap, p, 0x64 as u32)
        }
        else if r = (3 as u64)
        {
            set p: put(out, cap, p, 0x72 as u32)
            set p: put(out, cap, p, 0x64 as u32)
        }
        else
        {
            set p: put(out, cap, p, 0x74 as u32)
            set p: put(out, cap, p, 0x68 as u32)
        }
        p
    }
}

; MessageFormatter (MessageFormatter.cs): %1..%9 substitution of a fragment's
; text with its args, writing Char codepoints into `out` (capacity `cap`).
; Returns the count produced. `%%`/`%x` copies the char after `%` literally.
define MessageFormatter ()
{
    function format(this: MessageFormatter, text: StringC, args: Vector[MessageArg], out: pointer[u32], cap: size_t, noquote: bool) returns size_t
    {
        var p: size_t 0
        var i: size_t 0
        let n text.get_size()
        while i < n
        {
            let c text.get(i)
            if c = (0x25 as u32)
            {
                set i: i + 1
                if i >= n
                    break

                let d text.get(i)
                if (d >= (0x31 as u32)) and (d <= (0x39 as u32))
                {
                    let arg_index (d - (0x31 as u32)) as size_t
                    if arg_index < args.length
                    {
                        let arg *(args.get(arg_index))
                        set p: arg.append_to(out, cap, p, noquote)
                    }
                }
                else
                {
                    if p < cap
                    {
                        set *(out + p): d
                        set p: p + (1 as size_t)
                    }
                }
                set i: i + 1
            }
            else
            {
                if p < cap
                {
                    set *(out + p): c
                    set p: p + (1 as size_t)
                }
                set i: i + 1
            }
        }
        p
    }

    function test() returns int
    {
        ; MessageType severity
        let et MessageType(MessageFragment(1 as u32, StringC("bad")), Severity.Error)
        if et.is_error() = false
            return -1

        let wt MessageType(MessageFragment(2 as u32, StringC("hmm")), Severity.Warning)
        if wt.is_error()
            return -2

        ; Format "%1 at line %2" with args ["foo", 42] -> `"foo" at line 42`
        var args Vector[MessageArg](2)
        set *(args.get(0 as size_t)): MessageArg.Str(StringC("foo"))
        set *(args.get(1 as size_t)): MessageArg.Num(42 as u64)

        var out u32[128]
        let fmt MessageFormatter()
        let count fmt.format(StringC("%1 at line %2"), args, out as pointer[u32], 128 as size_t, false)

        let expected StringC("\"foo\" at line 42")
        if count <> expected.get_size()
            return -3

        var i: size_t 0
        while i < count
        {
            if *((out as pointer[u32]) + i) <> expected.get(i)
                return -4

            set i: i + 1
        }

        ; noquote mode drops the surrounding quotes
        var args2 Vector[MessageArg](1)
        set *(args2.get(0 as size_t)): MessageArg.Str(StringC("x"))
        var out2 u32[16]
        let c2 fmt.format(StringC("[%1]"), args2, out2 as pointer[u32], 16 as size_t, true)
        let exp2 StringC("[x]")
        if c2 <> exp2.get_size()
            return -5

        var j: size_t 0
        while j < c2
        {
            if *((out2 as pointer[u32]) + j) <> exp2.get(j)
                return -6

            set j: j + 1
        }

        ; ordinal suffix: 3 -> "3rd"
        var args3 Vector[MessageArg](1)
        set *(args3.get(0 as size_t)): MessageArg.Ord(3 as u64)
        var out3 u32[16]
        let c3 fmt.format(StringC("%1"), args3, out3 as pointer[u32], 16 as size_t, true)
        let exp3 StringC("3rd")
        if c3 <> exp3.get_size()
            return -7

        var k: size_t 0
        while k < c3
        {
            if *((out3 as pointer[u32]) + k) <> exp3.get(k)
                return -8

            set k: k + 1
        }

        0
    }
}
