            return StringC("PILEN")
        if i = 13
            return StringC("TAGLEN")
        StringC("TAGLVL")
    }

    ; Sd::lookupQuantityName — -1 when the name is no quantity name.
    function lookup_quantity_name(this: Sd, name: StringC) returns int
    {
        var i: int 0
        while i < 15
        {
            let qn quantity_name(i)
            if name.equals(qn)
                return i
            set i: i + 1
        }
        0 - 1
    }

    ; Sd::generalDelimiterName (Syntax::DelimGeneral order = dAND..dVI).
    function general_delimiter_name(this: Sd, i: int) returns StringC
    {
        if i = 0
            return StringC("AND")
        if i = 1
            return StringC("COM")
        if i = 2
            return StringC("CRO")
