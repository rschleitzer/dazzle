        if i = 31
            return StringC("TAGC")
        StringC("VI")
    }

    ; Sd::lookupGeneralDelimiterName — -1 when no general-delimiter role name.
    function lookup_general_delimiter_name(this: Sd, name: StringC) returns int
    {
        var i: int 0
        while i < 33
        {
            let dn general_delimiter_name(i)
            if name.equals(dn)
                return i
            set i: i + 1
        }
        0 - 1
    }

    ; Sd::nameToUniv (Sd.cxx:255): a minimum-literal-described character maps
    ; into the ISO 10646 private-use group — 0x60000000 + n, one n per
    ; DISTINCT name (lazy table; the Sd must be page-hosted by the SD parser).
    function name_to_univ(this: pointer[Sd], name: StringC) returns u32
    {
        if this.named_chars_v = null
        {
            let own_page Page.get(this as pointer[void])
            set this.named_chars_v: own_page.allocate((64 as size_t) * sizeof StringC, alignof StringC) as pointer[StringC]
        }
        var i: size_t 0
        while i < this.n_named_v
        {
            let e *(this.named_chars_v + i)
            if e.equals(name)
                return (0x60000000 as u32) + (i as u32)
            set i: i + 1
        }
        if this.n_named_v >= (64 as size_t)
            return 0x60000000 as u32
        ; deep-copy the name onto the Sd's page
        let own_page2 Page.get(this as pointer[void])
        let n name.get_size()
        var cb: pointer[u32] null
        if n > (0 as size_t)
        {
            set cb: own_page2.allocate(n * (4 as size_t), 4) as pointer[u32]
            var j: size_t 0
            while j < n
            {
                set *(cb + j): name.get(j)
                set j: j + 1
            }
        }
        let slot this.named_chars_v + this.n_named_v
        set slot.data: cb
        set slot.size: n
        set this.n_named_v: this.n_named_v + (1 as size_t)
        (0x60000000 as u32) + ((this.n_named_v - (1 as size_t)) as u32)
    }

