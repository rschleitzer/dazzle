; Sd — the SGML declaration's non-syntax info (Sd.cs).
;
; Stage-3 scope (Increment A): the minimum Syntax(Sd) needs — the internal
; charset mapping (identity for the reference/XML case) and the www (WWW-TC)
; flag. The full feature-flag/capacity/quantity/charset machinery and the SD
; parser land with later increments; a plain reference Sd is what the corpus's
; implied XML declaration yields.

; SHORTTAG STARTTAG NETENABL — whether/how a start tag may be net-enabling
; (Sd::NetEnable). netEnableAll is the reference concrete syntax's value; the SD
; parser sets netEnableImmednet for the XML/scaly declaration (NETENABL IMMEDNET).
define NET_ENABLE_NO: int 0
define NET_ENABLE_IMMEDNET: int 1
define NET_ENABLE_ALL: int 2

; IMPLYDEF ELEMENT (Sd::ImplydefElement). NO = an element with no declaration is
; an error; YES = it is implied (ANY content, undefined); ANYOTHER additionally
; forbids immediate recursion. The reference declaration and xml.dcl both say NO —
; ParserState turns it to YES for the rest of the parse when a document has no
; document type declaration at all (Parser.imply_dtd -> enable_implydef).
define IMPLYDEF_ELEMENT_NO: int 0
define IMPLYDEF_ELEMENT_YES: int 1
define IMPLYDEF_ELEMENT_ANYOTHER: int 2

; namecase_general_flag / omitname_flag carry the SD parser's NAMECASE GENERAL
; and SHORTTAG ATTRIB OMITNAME values (SdParser.build). Their reference-syntax
; defaults (GENERAL YES, OMITNAME YES) reproduce the implied-declaration
; behavior every catalog-less corpus model is parsed under — so a plain Sd()
; is byte-identical to the previous hardcoded reference. net_enable_flag
; defaults to netEnableAll (the reference concrete syntax).
define Sd (www_flag: bool, namecase_general_flag: bool, omitname_flag: bool, net_enable_flag: int, emptynrm_flag: bool, omittag_flag: bool, attribute_default_flag: bool, keeprsre_flag: bool)
{
    init()
    {
        set www_flag: false
        set namecase_general_flag: true
        set omitname_flag: true
        set net_enable_flag: NET_ENABLE_ALL
        set emptynrm_flag: false
        set omittag_flag: true
        set attribute_default_flag: true
        set keeprsre_flag: false
    }

    init(www_flag: bool)
    {
        set this.www_flag: www_flag
        set namecase_general_flag: true
        set omitname_flag: true
        set net_enable_flag: NET_ENABLE_ALL
        set emptynrm_flag: false
        set omittag_flag: true
        set attribute_default_flag: true
        set keeprsre_flag: false
    }

    ; execToInternal: map a document-charset byte to an internal Char. The
    ; reference/XML case is the identity coding system, so this is zero-extend.
    function exec_to_internal(this: Sd, c: u8) returns u32
        c as u32

    function www(this: Sd) returns bool
        www_flag

    function set_www(this: pointer[Sd], v: bool)
        set this.www_flag: v

    ; NAMECASE GENERAL — when NO, name folding (Syntax.fold / the general subst
    ; table) is the identity map (Syntax init consults this).
    function namecase_general(this: Sd) returns bool
        namecase_general_flag

    function set_namecase_general(this: pointer[Sd], v: bool)
        set this.namecase_general_flag: v

    ; SHORTTAG ATTRIB OMITNAME — governs whether a bare enumerated-value token
    ; (attribute name omitted) is legal in an attribute spec (Sd::attributeOmitName).
    function attribute_omit_name(this: Sd) returns bool
        omitname_flag

    function set_attribute_omit_name(this: pointer[Sd], v: bool)
        set this.omitname_flag: v

    ; SHORTTAG STARTTAG NETENABL — how a start tag may be net-enabling (`/` NESTC).
    function start_tag_net_enable(this: Sd) returns int
        net_enable_flag

    function set_start_tag_net_enable(this: pointer[Sd], v: int)
        set this.net_enable_flag: v

    ; EMPTYNRM — empty-element-tag normalization (`<x/>` closes an EMPTY element
    ; via the following NET); reference default NO, the XML/scaly declaration YES.
    function empty_element_normal(this: Sd) returns bool
        emptynrm_flag

    function set_empty_element_normal(this: pointer[Sd], v: bool)
        set this.emptynrm_flag: v

    ; Feature flags the scanner's ModeInfo consults to drop tokens whose
    ; delimiters require an absent feature (Increment-B seed = the reference /
    ; SHORTTAG-on document defaults; the SD parser sets these per declaration).
    function start_tag_empty(this: Sd) returns bool
        true

    function end_tag_empty(this: Sd) returns bool
        true

    function concur(this: Sd) returns int
        0

    function link(this: Sd) returns bool
        false

    ; OTHER KEEPRSRE — when YES (xml.dcl), RS and RE are NOT record boundaries but
    ; ordinary DATA characters: ModeInfo drops the tokenRs/tokenRe entries from the
    ; content modes (REQUIRE_NOT_KEEPRSRE), so they reach the parser as tokenChar
    ; and the OutputState record machine never shapes them. Reference default NO.
    function keeprsre(this: Sd) returns bool
        keeprsre_flag

    function set_keeprsre(this: pointer[Sd], v: bool)
        set this.keeprsre_flag: v

    ; Flags ParserState.setSd consults (Sd.cs):
    ;   mayDefaultAttribute = omittag || attributeDefault    (ParserState.cxx:303)
    ;   validate            = typeValid
    ;
    ; FEATURES MINIMIZE OMITTAG — tag omission. Governs tryImplyTag, which bails
    ; immediately when it is NO (parseInstance.cxx:754), so NO also means the
    ; document element is never implied and a prolog-only document correctly ends
    ; up with an unfinished root ("no document element").
    ;
    ; SHORTTAG ATTRIB DEFAULT — attribute defaulting from the DTD.
    ;
    ; These are INDEPENDENT: the corpus's xml.dcl sets OMITTAG NO *and* ATTRIB
    ; DEFAULT YES, so defaulting survives with no tag omission at all. (They used
    ; to be hardcoded true/false — omittag was forced YES purely to switch
    ; defaulting on, which also silently enabled tag omission for XML.) Defaults
    ; here are the reference declaration's (OMITTAG YES, SHORTTAG YES).
    function omittag(this: Sd) returns bool
        omittag_flag

    function set_omittag(this: pointer[Sd], v: bool)
        set this.omittag_flag: v

    function attribute_default(this: Sd) returns bool
        attribute_default_flag

    function set_attribute_default(this: pointer[Sd], v: bool)
        set this.attribute_default_flag: v

    function type_valid(this: Sd) returns bool
        true

    function implydef_element(this: Sd) returns int
        IMPLYDEF_ELEMENT_NO

    function implydef_attlist(this: Sd) returns bool
        false

    ; IMPLYDEF DOCTYPE — when YES, a missing DOCTYPE implies an external DTD
    ; subset looked up in the catalog under the document element's name. NO in the
    ; reference declaration and in xml.dcl (and no corpus catalog declares one),
    ; so implyDtd always takes the "no document type declaration" branch.
    function implydef_doctype(this: Sd) returns bool
        false

    ; IMPLYDEF ENTITY — an SP extension (NO in the reference declaration and in
    ; xml.dcl): when NO, a reference to an undeclared general entity is an error
    ; rather than an implied declaration.
    function implydef_entity(this: Sd) returns bool
        false
}
