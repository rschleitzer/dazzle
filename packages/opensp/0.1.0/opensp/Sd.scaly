; Sd — the SGML declaration's non-syntax info (Sd.cs).
;
; Stage-3 scope (Increment A): the minimum Syntax(Sd) needs — the internal
; charset mapping (identity for the reference/XML case) and the www (WWW-TC)
; flag. The full feature-flag/capacity/quantity/charset machinery and the SD
; parser land with later increments; a plain reference Sd is what the corpus's
; implied XML declaration yields.

define Sd (www_flag: bool)
{
    init()
    {
        set www_flag: false
    }

    init(www_flag: bool)
    {
        set www_flag: www_flag
    }

    ; execToInternal: map a document-charset byte to an internal Char. The
    ; reference/XML case is the identity coding system, so this is zero-extend.
    function exec_to_internal(this: Sd, c: u8) returns u32
        c as u32

    function www(this: Sd) returns bool
        www_flag
}
