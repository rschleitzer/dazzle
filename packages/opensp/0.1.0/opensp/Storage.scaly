use scaly.memory.Page
use scaly.io.File
use scaly.io.Path
use scaly.memory.runtime.fopen
use scaly.memory.runtime.fclose

; strerror(3): fixed-prototype libc call, direct extern (i32 per the extern
; 32-bit-param ABI rule). Returns a pointer to a static, thread-local buffer —
; consume before the next libc call on this thread.
function strerror(code: i32) returns pointer[const_char] extern
; scaly_eio_errno (scaly/fiber/eio.c): the errno accessor — errno itself is a
; thread-local macro a direct extern cannot read (shim rule c).
function scaly_eio_errno() returns i32 extern

; Storage — the byte-source abstraction (StorageManager + StorageObject,
; StorageManager.cs / LiteralStorage.cs / PosixStorage.cs).
;
; The C++ abstract factory + reader hierarchy ports to a union over the storage
; kinds we need: Literal (in-memory bytes, no I/O) and OsFile (reads a file from
; disk through scaly.io.File). Bytes are Scaly byte `String`s here; the
; byte->Char decode happens one layer up in EntityManager via a CodingSystem.
;
; Deferred (StorageManager map): rewind/block-size/search-dir machinery, the Fd/
; URL/WinInet/Stdio managers, and ParsedSystemId's <osfile ...> bracket syntax.
; OsFile's payload is the base directory a relative spec id resolves against.

define Storage union
(
    Literal: String
    OsFile: String
)
{
    ; Read the bytes named by spec_id. For Literal, spec_id is ignored and the
    ; in-memory content is returned; for OsFile, spec_id is resolved relative to
    ; the base directory and read from disk. An empty String signals failure /
    ; not found (callers check exists() first when that matters).
    procedure read(this: Storage, spec_id: String) returns String
    {
        choose this
            when bytes: Literal
                return bytes
            when base: OsFile
            {
                let full resolve(base, spec_id)
                if File.exists(full) = false
                    return String()

                return File.read_to_string(full)
            }
        String()
    }

    ; PosixStorageManager::makeStorageObject's failure report, factored: try to
    ; open spec_id; on failure return the strerror text real onsgmls substitutes
    ; as %2 of openSystemCall ("cannot open %1 (%2)"); null when the file opens
    ; (or for Literal storage, which cannot fail). The returned pointer aliases
    ; strerror's static buffer — consume it before the next libc call.
    function open_error(this: Storage, spec_id: String) returns pointer[const_char]
    {
        choose this
            when bytes: Literal
                return null
            when base: OsFile
            {
                let full resolve(base, spec_id)
                let file fopen(full.to_c_string(), "rb")
                if file = null
                    return strerror(scaly_eio_errno())
                let closed fclose(file)
                return null
            }
        null
    }

    procedure has_spec(this: Storage, spec_id: String) returns bool
    {
        choose this
            when bytes: Literal
                return true
            when base: OsFile
                return File.exists(resolve(base, spec_id))
        false
    }

    ; resolveRelative: join the base directory with a (relative) spec id.
    function resolve(this: Storage, base: String, spec_id: String) returns String
    {
        if base.get_length() = 0
            return spec_id

        Path.join(base, spec_id)
    }

    function type_name(this: Storage) returns pointer[const_char]
    {
        choose this
            when b: Literal
                return "LITERAL"
            when f: OsFile
                return "OSFILE"
        "UNKNOWN"
    }

    procedure test() returns int
    {
        ; Literal storage serves its bytes regardless of the spec id.
        let lit Storage.Literal("hello world")
        let got lit.read("ignored")
        if (got = "hello world") = false
            return -1

        let lit_exists lit.has_spec("anything")
        if lit_exists = false
            return -2

        0
    }
}
