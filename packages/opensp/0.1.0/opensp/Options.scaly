use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String

; Options<AppChar> — include/Options.h + Options.cxx, the att_getopt-derived
; option scanner CmdLineApp::processOptions drives. It never prints: get()
; reports problems through signal chars the caller renders —
;   '?'  unknown option / missing argument (opt() = the short char, or 0 for
;        a long option whose name the caller extracts from argv)
;   '-'  ambiguous long-option prefix
;   '='  a long option that does not take an argument got one
; Long options match on UNIQUE PREFIX (`--max-err 5`); `--` ends the options;
; clustered short options (`-egn`) advance sp through one argv cell.

; One registered option (LongOption<T>): the long name (empty = short-only),
; the option char processOption receives, and whether it takes an argument.
; (The reference's separate `key` field only blanks non-alnum chars for
; search(); every onsgmls option char is alnum, so value doubles as key.)
define LongOpt
(
    name: String
    value: u32
    has_argument: bool
)
{
    init(name: String, value: u32, has_argument: bool)
    {
        set this.name: name
        set this.value: value
        set this.has_argument: has_argument
    }
}

define Options
(
    argc: int
    argv: pointer[pointer[char]]
    ind: int
    sp: size_t
    opt: u32
    arg: pointer[char]
    opt_ind: int
    opts: ref[Array[LongOpt]]
)
{
    function make(host: ref[Page], argc: int, argv: pointer[pointer[char]], opts: ref[Array[LongOpt]]) returns ref[Options]
    {
        let o &Options^host(argc, argv, 1, 1, 0, null, 0 - 1, opts)
        o
    }

    ; optarg / optopt / optind accessors.
    function get_arg(this: Options) returns pointer[char]
        arg

    function get_opt(this: Options) returns u32
        opt

    function get_ind(this: Options) returns int
        ind

    ; Options::search — short-option lookup; sets opt_ind.
    procedure search(this: ref[Options], c: u32) returns bool
    {
        let n this.opts.get_length()
        var i: size_t 0
        while i < n
        {
            let lo this.opts[i]
            if lo.value = c
            {
                set this.opt_ind: i as int
                return true
            }
            set i: i + 1
        }
        set this.opt_ind: 0 - 1
        false
    }

    ; Options::searchLong — true on a unique match (exact beats prefix); false
    ; with opt_ind >= 0 means AMBIGUOUS, opt_ind < 0 means unknown. On a match
    ; sp is left at the index of the char ending the name ('\0' or '=').
    procedure search_long(this: ref[Options], a: pointer[char]) returns bool
    {
        set this.opt_ind: 0 - 1
        let n this.opts.get_length()
        var i: size_t 0
        while i < n
        {
            let lo this.opts[i]
            let nlen lo.name.get_length()
            if nlen > 0
            {
                var sp: size_t 2
                var t: size_t 0
                var scanning true
                while scanning
                {
                    let ac (*(a + sp)) as u32
                    if (ac = 0) or (ac = 0x3D)
                    {
                        if this.opt_ind >= 0
                            return false
                        set this.opt_ind: i as int
                        set this.sp: sp
                        if t = nlen
                            return true
                        set scanning: false
                    }
                    else if t >= nlen
                        set scanning: false
                    else if ac <> (((*(lo.name.get_buffer() + t)) as u8) as u32)
                        set scanning: false
                    else
                    {
                        set sp: sp + 1
                        set t: t + 1
                    }
                }
            }
            set i: i + 1
        }
        this.opt_ind >= 0
    }

    ; Options::get — the scanner step. Returns false when no options remain
    ; (ind then points at the first non-option argument).
    procedure get(this: ref[Options], out_c: ref[u32]) returns bool
    {
        if this.sp = 1
        {
            if this.ind >= this.argc
                return false
            let a *(this.argv + this.ind)
            let c0 (*(a + 0)) as u32
            let c1 (*(a + 1)) as u32
            if (c0 <> 0x2D) or (c1 = 0)
                return false
            if c1 = 0x2D
            {
                let c2 (*(a + 2)) as u32
                if c2 = 0
                {
                    ; `--` terminator
                    set this.ind: this.ind + 1
                    return false
                }
                ; long option; opt = 0 marks it for the caller's error text
                set this.opt: 0
                if this.search_long(a)
                {
                    let lo this.opts[(this.opt_ind as size_t)]
                    set out_c: lo.value
                    if lo.has_argument
                    {
                        if ((*(a + this.sp)) as u32) = 0x3D
                            set this.arg: a + (this.sp + 1)
                        else if (this.ind + 1) < this.argc
                        {
                            set this.ind: this.ind + 1
                            set this.arg: *(this.argv + this.ind)
                        }
                        else
                            set out_c: 0x3F
                    }
                    else if ((*(a + this.sp)) as u32) = 0x3D
                        set out_c: 0x3D
                }
                else if this.opt_ind >= 0
                    set out_c: 0x2D
                else
                    set out_c: 0x3F
                set this.ind: this.ind + 1
                set this.sp: 1
                return true
            }
        }
        let a2 *(this.argv + this.ind)
        let ch (*(a2 + this.sp)) as u32
        set this.opt: ch
        set out_c: ch
        if this.search(ch) = false
        {
            set this.sp: this.sp + 1
            if ((*(a2 + this.sp)) as u32) = 0
            {
                set this.ind: this.ind + 1
                set this.sp: 1
            }
            set out_c: 0x3F
            return true
        }
        let lo this.opts[(this.opt_ind as size_t)]
        if lo.has_argument
        {
            if ((*(a2 + (this.sp + 1))) as u32) <> 0
            {
                set this.arg: a2 + (this.sp + 1)
                set this.ind: this.ind + 1
            }
            else
            {
                set this.ind: this.ind + 1
                if this.ind >= this.argc
                {
                    set this.sp: 1
                    set out_c: 0x3F
                    return true
                }
                set this.arg: *(this.argv + this.ind)
                set this.ind: this.ind + 1
            }
            set this.sp: 1
        }
        else
        {
            set this.sp: this.sp + 1
            if ((*(a2 + this.sp)) as u32) = 0
            {
                set this.sp: 1
                set this.ind: this.ind + 1
            }
            set this.arg: null
        }
        true
    }

    ; ---- self-test ---------------------------------------------------------
    function test() returns int
    {
        ; exercised end-to-end through the onsgmls driver + corpus; the
        ; scanner is covered by the option-error fixtures.
        0
    }
}
