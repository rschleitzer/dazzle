use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use opensp.CharsetRegistry.CharsetRegistryIter
use opensp.CharsetRegistry.CharsetRegistry
use opensp.CodingSystem.CodingSystem
use opensp.CodingSystem.IENC_IDENTITY
use opensp.CodingSystem.IENC_UTF8
use opensp.CodingSystem.IENC_XML
use opensp.CodingSystem.IENC_FIXED2
use opensp.CodingSystem.IENC_FIXED4
use opensp.CodingSystem.IENC_UTF16
use opensp.CodingSystem.IENC_UNICODE
use opensp.CodingSystem.IENC_EUC
use opensp.CodingSystem.IENC_SJIS
use opensp.CodingSystem.IENC_BIG5
use opensp.CodingSystem.IENC_TRANSLATE
use opensp.CodingSystem.OSP_REPLACEMENT_CHAR

; CodingSystemKit — the OUTPUT half of CodingSystemKitImpl (CodingSystemKit.cxx)
; plus the concrete output encoders (IdentityCodingSystem/UTF8/Fixed2/Fixed4/
; UTF16/Unicode/EUCJP/SJIS/Big5CodingSystem.cxx encoder halves and
; TranslateCodingSystem.cxx's TranslateEncoder). It backs the -b option: the
; ESIS/RAST writers accumulate the char stream as internal UTF-8 bytes and
; `transcode` re-encodes the whole stream through the selected system.
;
; The kit's system charset is ISO 10646 (iso10646Desc), the only internal
; charset this port models (SP_SYSTEM_CHARSET is not consulted — the input
; side is Unicode-internal throughout), so the reference's
; `univToDesc(univ) -> sysChar` is the identity and an encode map is simply
; map[univ] = desc_code + add, built with the same CharsetRegistry iteration
; as TranslateCodingSystem::makeEncoder (last desc entry wins on overlap,
; CharMap::setChar overwrite order).
;
; Escaping (EncodeOutputCharStream::handleUnencodable): encoders derived from
; RecoveringEncoder route an unencodable Char to the stream's escaper —
; SgmlsEventHandler::escaper writes `\#<decimal>;` back through the SAME
; encoder (a temporary stream over the same Encoder; the chars of the escape
; sequence are themselves translated, e.g. `\` lands as the fullwidth reverse
; solidus under the JIS maps). Plain-Encoder systems DROP unencodable chars.
; A TranslateEncoder's SUB-encoder never has a handler (the reference's
; `FIXME set unencodeable handler for underlying encoder`) — a char the map
; resolves but the sub bctf cannot express drops silently, bug-for-bug.
;
; There are exactly TWO escapers in the reference tree, and which one a stream
; carries is a property of the WRITER, not of the coding system:
;   `\#<decimal>;`  SgmlsEventHandler::escaper — the ESIS stream (onsgmls)
;   `&#<decimal>;`  outputNumericCharRef — the jade backends that write a char
;                   stream (SgmlFOTBuilder.cxx:615, TransformFOTBuilder.cxx:368
;                   and :553). The HTML backend deliberately sets NONE
;                   (`// FIXME setEscaper`, HtmlFOTBuilder.cxx:997), so an
;                   unencodable char DROPS there.
define OESC_NONE: int 0
define OESC_BACKSLASH: int 1
define OESC_CHARREF: int 2

; encoder kinds (CodingSystemId, restricted to what an OUTPUT system needs;
; XML's makeEncoder returns the UTF-8 encoder, so XML lookups yield OENC_UTF8)
define OENC_IDENTITY: int 0
define OENC_UTF8: int 1
define OENC_FIXED2: int 2
define OENC_FIXED4: int 3
define OENC_UTF16: int 4
define OENC_UNICODE: int 5
define OENC_EUC: int 6
define OENC_SJIS: int 7
define OENC_BIG5: int 8
define OENC_TRANSLATE: int 9

; TranslateCodingSystem::Desc tables (CodingSystemKit.cxx), as
; (registration-number, add) pairs. Numbers are the CR_* constants
; (CharsetRegistry.scaly): 1 ISO646_ASCII_G0, 2 ISO646_C0, 3 ISO6429,
; 4..12 ISO8859_1..9, 15 KOI8_R, 16 ISO646_JIS_G0, 17 JIS0201, 18 JIS0208,
; 19 JIS0212, 20 GB2312, 21 KSC5601, 22 BIG5.
define OENC_DESC_JIS: u32[] [2, 0, 16, 0, 3, 0x80, 17, 0x80, 18, 0x8080,]
define OENC_DESC_JIS2: u32[] [2, 0, 16, 0, 3, 0x80, 17, 0x80, 18, 0x8080, 19, 0x8000,]
define OENC_DESC_GB: u32[] [2, 0, 1, 0, 3, 0x80, 20, 0x8080,]
define OENC_DESC_BIG5: u32[] [2, 0, 1, 0, 22, 0,]
define OENC_DESC_KSC: u32[] [2, 0, 1, 0, 3, 0x80, 21, 0x8080,]
define OENC_DESC_ISO8859_1: u32[] [2, 0, 1, 0, 3, 0x80, 4, 0x80,]
define OENC_DESC_ISO8859_2: u32[] [2, 0, 1, 0, 3, 0x80, 5, 0x80,]
define OENC_DESC_ISO8859_3: u32[] [2, 0, 1, 0, 3, 0x80, 6, 0x80,]
define OENC_DESC_ISO8859_4: u32[] [2, 0, 1, 0, 3, 0x80, 7, 0x80,]
define OENC_DESC_ISO8859_5: u32[] [2, 0, 1, 0, 3, 0x80, 8, 0x80,]
define OENC_DESC_ISO8859_6: u32[] [2, 0, 1, 0, 3, 0x80, 9, 0x80,]
define OENC_DESC_ISO8859_7: u32[] [2, 0, 1, 0, 3, 0x80, 10, 0x80,]
define OENC_DESC_ISO8859_8: u32[] [2, 0, 1, 0, 3, 0x80, 11, 0x80,]
define OENC_DESC_ISO8859_9: u32[] [2, 0, 1, 0, 3, 0x80, 12, 0x80,]
; KOI8-R: only the GR part is registered (reference FIXME — koi8-r does not
; follow the ISO control/graphic model), so C0/ASCII + the 0x80-added table.
define OENC_DESC_KOI8: u32[] [2, 0, 1, 0, 15, 0x80,]

; the pseudo-attribute name XMLDecoder::extractEncoding looks for
define ENCODING_NAME: u32[] [0x65, 0x6E, 0x63, 0x6F, 0x64, 0x69, 0x6E, 0x67,]

; the encoder value the driver selects (outputCodingSystem_): a simple kind,
; or OENC_TRANSLATE with the sub bctf, the 64K encode map and the map's
; illegal (default) char.
define OutputEncoder
(
    kind: int
    sub: int
    map: pointer[u32]
    illegal: u32
)
{
    init()
    {
        set kind: OENC_IDENTITY
        set sub: OENC_IDENTITY
        set map: null
        set illegal: 0
    }
}

; CmdLineApp::outputCodingSystem() — the app's OUTPUT coding system, the one
; every char-stream writer of a run shares (`-b` if given, else the
; environment's codingSystem()). onsgmls threads its encoder through the call
; chain; the jade backends cannot (the reference reaches it through the app
; pointer they were handed at construction), so the driver installs it here
; once, exactly like ParserState's STDERR_ENC cell.
; ★`shared`, not `mutable`: written ONCE while single-threaded in main, and a
; THREAD-LOCAL in a JIT-linked dependency object aborts ORC's TLV bootstrap.
shared OUTPUT_ENC: ref[OutputEncoder]? null

; translate-system selectors for make_encoder (`which`; 0 = a simple kind)
define OENC_T_ISO8859_1: int 1
define OENC_T_ISO8859_2: int 2
define OENC_T_ISO8859_3: int 3
define OENC_T_ISO8859_4: int 4
define OENC_T_ISO8859_5: int 5
define OENC_T_ISO8859_6: int 6
define OENC_T_ISO8859_7: int 7
define OENC_T_ISO8859_8: int 8
define OENC_T_ISO8859_9: int 9
define OENC_T_KOI8: int 10
define OENC_T_EUCJP: int 11
define OENC_T_EUCCN: int 12
define OENC_T_EUCKR: int 13
define OENC_T_SJIS: int 14
define OENC_T_BIG5: int 15

define CodingSystemKit
{
    ; TranslateCodingSystem::makeEncoder — the encode CharMap. 64K entries
    ; (every charset the descs reference is BMP), default illegalChar.
    function make_translate(host: ref[Page], desc: Slice[u32], sub: int, illegal: u32, e: ref[OutputEncoder])
    {
        let map host.allocate(0x40000, 4) as pointer[u32]
        var i: size_t 0
        while i < 0x10000
        {
            set *(map + i): illegal
            set i: i + 1
        }
        var p: size_t 0
        ; ★`desc` is a flat (number, add) PAIR table, so the slice is twice
        ; the pair count -- the length a `Slice` carries is ELEMENTS, and
        ; taking the pair count for it would halve the buffer and trap the
        ; last pair at exit 15.
        let n_pairs desc.length / 2
        while p < n_pairs
        {
            let number desc[p * 2]
            let add desc[p * 2 + 1]
            var it CharsetRegistryIter()
            if CharsetRegistry.make_iter(number as int, &it)
            {
                var dmin: u32 0
                var dmax: u32 0
                var univ: u32 0
                while it.next(&dmin, &dmax, &univ)
                {
                    var k: u32 0
                    let n (dmax - dmin) + 1
                    while k < n
                    {
                        let u univ + k
                        if u < 0x10000
                            set *(map + (u as size_t)): dmin + add + k
                        set k: k + 1
                    }
                }
            }
            set p: p + 1
        }
        set e.kind: OENC_TRANSLATE
        set e.sub: sub
        set e.map: map
        set e.illegal: illegal
    }

    ; page-allocate a fresh OutputEncoder (identity default). The allocation
    ; MUST happen inside this package: a cross-package `sizeof OutputEncoder`
    ; in the driver miscompiles (the layout isn't visible there), so the
    ; driver calls this factory instead of allocating the record itself.
    function new_encoder(host: ref[Page]) returns ref[OutputEncoder]
    {
        let e &OutputEncoder^host()
        e
    }

    ; the driver installs the run's output coding system here (see OUTPUT_ENC).
    ; ★named `install_output_encoder`, not `set_output_encoder`: ParserState
    ; already has a METHOD of that name, and a same-named static here made the
    ; planner mangle the method calls onto this one (an undefined symbol at
    ; link time, `set_output_encoder(OutputEncoder*)`).
    procedure install_output_encoder(e: ref[OutputEncoder])
        set OUTPUT_ENC: e

    ; A writer's internal UTF-8 char stream through the app's OUTPUT coding
    ; system — one call per FILE, because `bom` is Encoder::startFile, which
    ; the reference runs when it builds the EncodeOutputCharStream for that
    ; file. A null cell (unit tests, the in-process JIT paths that never went
    ; through a driver) means UTF-8, i.e. the internal bytes unchanged.
    ;
    ; ★Answers a RAW BUFFER plus its length, not a String and not the
    ; accumulator. Two measured constraints shape that signature:
    ;   - a String built two frames down lands through `Page.get(this)` on the
    ;     outermost caller's return slot (a stack local) and comes back as
    ;     garbage — this package's first cut segfaulted the fot backend;
    ;   - a `pointer[Array[u8]]` handed ACROSS THE PACKAGE BOUNDARY reads back
    ;     as garbage in the caller (get_buffer/get_length answer nonsense),
    ;     so the generic instance never leaves opensp.
    ; The backend then does `String(p as pointer[const_char], n)` as its own
    ; return expression, which is the shape it always had.
    ; ★TWO entry points instead of an `esc` argument: a module-level constant
    ; of THIS package is not visible inside a MODULE of another one (only in a
    ; program ROOT), and — the expensive half — passing it anyway does not
    ; diagnose: the whole CALL is silently dropped and its result is garbage.
    ; The escaper is a property of the writer, so a wrapper per writer kind
    ; carries it without a constant ever crossing the boundary.
    function encode_output_charref(host: ref[Page], data: pointer[u8], len: size_t, bom: bool, out_len: ref[size_t]) returns pointer[u8]
        CodingSystemKit.encode_output(host, data, len, OESC_CHARREF, bom, out_len)

    function encode_output_plain(host: ref[Page], data: pointer[u8], len: size_t, bom: bool, out_len: ref[size_t]) returns pointer[u8]
        CodingSystemKit.encode_output(host, data, len, OESC_NONE, bom, out_len)

    function encode_output(host: ref[Page], data: pointer[u8], len: size_t, esc: int, bom: bool, out_len: ref[size_t]) returns pointer[u8]
    {
        var fb OutputEncoder()
        CodingSystemKit.make_default(host, true, &fb)
        var enc &fb
        if OUTPUT_ENC <> null
            set enc: OUTPUT_ENC as ref[OutputEncoder]
        if enc.kind = OENC_UTF8
        {
            set out_len: len
            return data
        }
        let acc CodingSystemKit.encode_bytes(host, enc, Slice[u8](len, data), esc, bom)
        set out_len: acc.get_length()
        acc.get_buffer()
    }

    ; the environment default (initCodingSystem's fallback): the identity
    ; system, or UTF-8 when the driver derived output_utf8 from the
    ; environment. Callers outside this module use this instead of naming the
    ; OENC_* kind constants (which are module-gated).
    function make_default(host: ref[Page], utf8: bool, e: ref[OutputEncoder])
    {
        var k OENC_IDENTITY
        if utf8
            set k: OENC_UTF8
        CodingSystemKit.make_encoder(host, k, 0, e)
    }

    ; fill `e` for a lookup result: which = 0 is the simple `kind`, otherwise
    ; one of the OENC_T_* translate systems (CodingSystemKitImpl's
    ; TranslateCodingSystem members with their desc/sub/illegal wiring).
    function make_encoder(host: ref[Page], kind: int, which: int, e: ref[OutputEncoder])
    {
        if which = 0
        {
            set e.kind: kind
            set e.sub: OENC_IDENTITY
            set e.map: null
            set e.illegal: 0
            return
        }
        var d: pointer[u32] null
        var np: size_t 4
        var sub OENC_IDENTITY
        var illegal: u32 0x100
        if which = OENC_T_ISO8859_1
            set d: OENC_DESC_ISO8859_1
        else if which = OENC_T_ISO8859_2
            set d: OENC_DESC_ISO8859_2
        else if which = OENC_T_ISO8859_3
            set d: OENC_DESC_ISO8859_3
        else if which = OENC_T_ISO8859_4
            set d: OENC_DESC_ISO8859_4
        else if which = OENC_T_ISO8859_5
            set d: OENC_DESC_ISO8859_5
        else if which = OENC_T_ISO8859_6
            set d: OENC_DESC_ISO8859_6
        else if which = OENC_T_ISO8859_7
            set d: OENC_DESC_ISO8859_7
        else if which = OENC_T_ISO8859_8
            set d: OENC_DESC_ISO8859_8
        else if which = OENC_T_ISO8859_9
            set d: OENC_DESC_ISO8859_9
        else if which = OENC_T_KOI8
        {
            set d: OENC_DESC_KOI8
            set np: 3
        }
        else if which = OENC_T_EUCJP
        {
            set d: OENC_DESC_JIS2
            set np: 6
            set sub: OENC_EUC
            set illegal: 0x8000
        }
        else if which = OENC_T_EUCCN
        {
            set d: OENC_DESC_GB
            set np: 4
            set sub: OENC_EUC
            set illegal: 0x8000
        }
        else if which = OENC_T_EUCKR
        {
            set d: OENC_DESC_KSC
            set np: 4
            set sub: OENC_EUC
            set illegal: 0x8000
        }
        else if which = OENC_T_SJIS
        {
            set d: OENC_DESC_JIS
            set np: 5
            set sub: OENC_SJIS
            set illegal: 0x8000
        }
        else if which = OENC_T_BIG5
        {
            set d: OENC_DESC_BIG5
            set np: 3
            set sub: OENC_BIG5
            set illegal: 0x0080
        }
        CodingSystemKit.make_translate(host, Slice[u32](np * 2, d), sub, illegal, e)
    }

    ; CodingSystemKitImpl::match — exact-length, per-char case-insensitive.
    function name_matches(name: String, key: String) returns bool
    {
        let n name.get_length()
        if n <> key.get_length()
            return false
        var i: size_t 0
        while i < n
        {
            var c (name.get(i)) as u32
            if (c >= 0x61) and (c <= 0x7A)
                set c: c - 0x20
            var k (key.get(i)) as u32
            if (k >= 0x61) and (k <= 0x7A)
                set k: k - 0x20
            if c <> k
                return false
            set i: i + 1
        }
        true
    }

    ; CmdLineApp::lookupCodingSystem + the two CodingSystemKitImpl name
    ; tables. bctf mode (internal charset = doc charset, no SP_CHARSET_FIXED)
    ; consults bctfTable_; fixed mode consults encodingTable_ (the full table:
    ; the kit's system charset is ISO 10646). WINDOWS/MS-DOS/WUNICODE are
    ; WIN32-only makeCodingSystem arms — on these targets they yield 0 just
    ; like a miss, so they are simply absent here. Returns false = unknown
    ; (also for names of MAX_CS_NAME 50 chars or more — nothing that long is
    ; in either table).
    function lookup(name: String, is_bctf: bool, out_kind: ref[int], out_which: ref[int]) returns bool
    {
        set out_kind: OENC_IDENTITY
        set out_which: 0
        if is_bctf
        {
            if CodingSystemKit.name_matches(name, String("IDENTITY"))
                return true
            if CodingSystemKit.name_matches(name, String("FIXED-2"))
            {
                set out_kind: OENC_FIXED2
                return true
            }
            if CodingSystemKit.name_matches(name, String("FIXED-4"))
            {
                set out_kind: OENC_FIXED4
                return true
            }
            if CodingSystemKit.name_matches(name, String("UTF-8"))
            {
                set out_kind: OENC_UTF8
                return true
            }
            if CodingSystemKit.name_matches(name, String("EUC"))
            {
                set out_kind: OENC_EUC
                return true
            }
            if CodingSystemKit.name_matches(name, String("SJIS"))
            {
                set out_kind: OENC_SJIS
                return true
            }
            if CodingSystemKit.name_matches(name, String("BIG5"))
            {
                set out_kind: OENC_BIG5
                return true
            }
            return false
        }
        if CodingSystemKit.name_matches(name, String("UTF-8"))
        {
            set out_kind: OENC_UTF8
            return true
        }
        if CodingSystemKit.name_matches(name, String("UCS-2")) or CodingSystemKit.name_matches(name, String("ISO-10646-UCS-2"))
        {
            set out_kind: OENC_FIXED2
            return true
        }
        if CodingSystemKit.name_matches(name, String("UCS-4")) or CodingSystemKit.name_matches(name, String("ISO-10646-UCS-4")) or CodingSystemKit.name_matches(name, String("UTF-32"))
        {
            set out_kind: OENC_FIXED4
            return true
        }
        if CodingSystemKit.name_matches(name, String("UNICODE"))
        {
            set out_kind: OENC_UNICODE
            return true
        }
        if CodingSystemKit.name_matches(name, String("UTF-16"))
        {
            set out_kind: OENC_UTF16
            return true
        }
        if CodingSystemKit.name_matches(name, String("XML"))
        {
            set out_kind: OENC_UTF8
            return true
        }
        var which 0
        if CodingSystemKit.name_matches(name, String("IS8859-1")) or CodingSystemKit.name_matches(name, String("ISO-8859-1"))
            set which: OENC_T_ISO8859_1
        else if CodingSystemKit.name_matches(name, String("IS8859-2")) or CodingSystemKit.name_matches(name, String("ISO-8859-2"))
            set which: OENC_T_ISO8859_2
        else if CodingSystemKit.name_matches(name, String("IS8859-3")) or CodingSystemKit.name_matches(name, String("ISO-8859-3"))
            set which: OENC_T_ISO8859_3
        else if CodingSystemKit.name_matches(name, String("IS8859-4")) or CodingSystemKit.name_matches(name, String("ISO-8859-4"))
            set which: OENC_T_ISO8859_4
        else if CodingSystemKit.name_matches(name, String("IS8859-5")) or CodingSystemKit.name_matches(name, String("ISO-8859-5"))
            set which: OENC_T_ISO8859_5
        else if CodingSystemKit.name_matches(name, String("IS8859-6")) or CodingSystemKit.name_matches(name, String("ISO-8859-6"))
            set which: OENC_T_ISO8859_6
        else if CodingSystemKit.name_matches(name, String("IS8859-7")) or CodingSystemKit.name_matches(name, String("ISO-8859-7"))
            set which: OENC_T_ISO8859_7
        else if CodingSystemKit.name_matches(name, String("IS8859-8")) or CodingSystemKit.name_matches(name, String("ISO-8859-8"))
            set which: OENC_T_ISO8859_8
        else if CodingSystemKit.name_matches(name, String("IS8859-9")) or CodingSystemKit.name_matches(name, String("ISO-8859-9"))
            set which: OENC_T_ISO8859_9
        else if CodingSystemKit.name_matches(name, String("KOI8-R")) or CodingSystemKit.name_matches(name, String("KOI8"))
            set which: OENC_T_KOI8
        else if CodingSystemKit.name_matches(name, String("EUC-JP"))
            set which: OENC_T_EUCJP
        else if CodingSystemKit.name_matches(name, String("EUC-CN")) or CodingSystemKit.name_matches(name, String("GB2312")) or CodingSystemKit.name_matches(name, String("CN-GB"))
            set which: OENC_T_EUCCN
        else if CodingSystemKit.name_matches(name, String("EUC-KR"))
            set which: OENC_T_EUCKR
        else if CodingSystemKit.name_matches(name, String("SJIS")) or CodingSystemKit.name_matches(name, String("SHIFT_JIS"))
            set which: OENC_T_SJIS
        else if CodingSystemKit.name_matches(name, String("BIG5")) or CodingSystemKit.name_matches(name, String("CN-BIG5"))
            set which: OENC_T_BIG5
        if which = 0
            return false
        set out_which: which
        set out_kind: OENC_TRANSLATE
        true
    }

    ; ---- the INPUT side: name -> decoder --------------------------------------
    ;
    ; TranslateCodingSystem::makeDecoder's map, the INVERSE of make_translate's:
    ; `map[min + add + i] = univToDesc(univ) + i`, which for our ISO 10646 system
    ; charset is `map[desc_code] = univ`. Everything unmapped is the
    ; REPLACEMENT char (the constructor's replacementChar_), not the illegal
    ; char — that one only guards the encode direction.
    function make_decode_map(host: ref[Page], desc: Slice[u32]) returns pointer[u32]
    {
        let map host.allocate(0x40000, 4) as pointer[u32]
        var i: size_t 0
        while i < 0x10000
        {
            set *(map + i): OSP_REPLACEMENT_CHAR
            set i: i + 1
        }
        var p: size_t 0
        ; ★`desc` is a flat (number, add) PAIR table, so the slice is twice
        ; the pair count -- the length a `Slice` carries is ELEMENTS, and
        ; taking the pair count for it would halve the buffer and trap the
        ; last pair at exit 15.
        let n_pairs desc.length / 2
        while p < n_pairs
        {
            let number desc[p * 2]
            let add desc[p * 2 + 1]
            var it CharsetRegistryIter()
            if CharsetRegistry.make_iter(number as int, &it)
            {
                var dmin: u32 0
                var dmax: u32 0
                var univ: u32 0
                while it.next(&dmin, &dmax, &univ)
                {
                    var k: u32 0
                    let cnt (dmax - dmin) + 1
                    while k < cnt
                    {
                        let code dmin + add + k
                        if code < 0x10000
                            set *(map + (code as size_t)): univ + k
                        set k: k + 1
                    }
                }
            }
            set p: p + 1
        }
        map
    }

    ; the input coding system for a translate selector (the OENC_T_* values name
    ; the same TranslateCodingSystem members as on the encode side, so the desc
    ; tables and sub-BCTFs are shared).
    function make_input_translate(host: ref[Page], which: int) returns CodingSystem
    {
        var d: pointer[u32] null
        var np: size_t 4
        var sub IENC_IDENTITY
        if which = OENC_T_ISO8859_1
            set d: OENC_DESC_ISO8859_1
        else if which = OENC_T_ISO8859_2
            set d: OENC_DESC_ISO8859_2
        else if which = OENC_T_ISO8859_3
            set d: OENC_DESC_ISO8859_3
        else if which = OENC_T_ISO8859_4
            set d: OENC_DESC_ISO8859_4
        else if which = OENC_T_ISO8859_5
            set d: OENC_DESC_ISO8859_5
        else if which = OENC_T_ISO8859_6
            set d: OENC_DESC_ISO8859_6
        else if which = OENC_T_ISO8859_7
            set d: OENC_DESC_ISO8859_7
        else if which = OENC_T_ISO8859_8
            set d: OENC_DESC_ISO8859_8
        else if which = OENC_T_ISO8859_9
            set d: OENC_DESC_ISO8859_9
        else if which = OENC_T_KOI8
        {
            set d: OENC_DESC_KOI8
            set np: 3
        }
        else if which = OENC_T_EUCJP
        {
            set d: OENC_DESC_JIS2
            set np: 6
            set sub: IENC_EUC
        }
        else if which = OENC_T_EUCCN
        {
            set d: OENC_DESC_GB
            set np: 4
            set sub: IENC_EUC
        }
        else if which = OENC_T_EUCKR
        {
            set d: OENC_DESC_KSC
            set np: 4
            set sub: IENC_EUC
        }
        else if which = OENC_T_SJIS
        {
            set d: OENC_DESC_JIS
            set np: 5
            set sub: IENC_SJIS
        }
        else if which = OENC_T_BIG5
        {
            set d: OENC_DESC_BIG5
            set np: 3
            set sub: IENC_BIG5
        }
        let map CodingSystemKit.make_decode_map(host, Slice[u32](np * 2, d))
        CodingSystem.translate(sub, map)
    }

    ; CodingSystemKitImpl::makeInputCodingSystem — the same two name tables as
    ; the encode side (lookup), resolved to a DECODER. ★ISO-8859-1 is the
    ; IDENTITY system, not a translate one: `case iso8859_1:` returns
    ; identityCodingSystem_ whenever the system charset is ISO 10646, which is
    ; the only kit this port builds. Returns false for a name in neither table.
    function lookup_input(host: ref[Page], name: String, is_bctf: bool, out: ref[CodingSystem]) returns bool
    {
        let id CodingSystem.identity()
        id.store(out)
        var kind IENC_IDENTITY
        var which 0
        if CodingSystemKit.lookup(name, is_bctf, &kind, &which) = false
            return false
        if which <> 0
        {
            if which = OENC_T_ISO8859_1
                return true
            let tr CodingSystemKit.make_input_translate(host, which)
            tr.store(out)
            return true
        }
        ; the simple kinds, in the ENCODE side's numbering (`lookup` answers in
        ; OENC_* terms; only the input side distinguishes UTF-16 from Unicode).
        var ikind IENC_IDENTITY
        if kind = OENC_UTF8
            set ikind: IENC_UTF8
        else if kind = OENC_FIXED2
            set ikind: IENC_FIXED2
        else if kind = OENC_FIXED4
            set ikind: IENC_FIXED4
        else if kind = OENC_UTF16
            set ikind: IENC_UTF16
        else if kind = OENC_UNICODE
            set ikind: IENC_UNICODE
        else if kind = OENC_EUC
            set ikind: IENC_EUC
        else if kind = OENC_SJIS
            set ikind: IENC_SJIS
        else if kind = OENC_BIG5
            set ikind: IENC_BIG5
        ; the two fixed-width systems carry a byte order; big-endian is what a
        ; NAME selects (UCS-2/UCS-4/UTF-16 are defined big-endian, and only a
        ; byte-order mark — Unicode/XML — ever chooses the other one).
        if ikind = IENC_FIXED2
        {
            let f2 CodingSystem.fixed2(false)
            f2.store(out)
            return true
        }
        if ikind = IENC_FIXED4
        {
            let f4 CodingSystem.fixed4(false, false)
            f4.store(out)
            return true
        }
        if ikind = IENC_UTF16
        {
            let u16 CodingSystem.utf16(false)
            u16.store(out)
            return true
        }
        let simple CodingSystem.simple(ikind)
        simple.store(out)
        true
    }

    ; the XML system needs its own arm: the ENCODE table maps "XML" onto the
    ; UTF-8 encoder (XMLCodingSystem::makeEncoder), so `lookup` cannot tell it
    ; from a plain UTF-8 name. Only the input side distinguishes them.
    function lookup_input_name(host: ref[Page], name: String, is_bctf: bool, out: ref[CodingSystem]) returns bool
    {
        if is_bctf = false
        {
            if CodingSystemKit.name_matches(name, String("XML"))
            {
                let x CodingSystem.simple(IENC_XML)
                x.store(out)
                return true
            }
        }
        CodingSystemKit.lookup_input(host, name, is_bctf, out)
    }

    ; CmdLineApp::initCodingSystem's INPUT half for an app whose internal
    ; charset is fixed (a GroveApp, i.e. dazzle): the SP_ENCODING name, unless
    ; it names no system or one wider than a byte per char — then
    ; SP_DEFAULT_ENCODING = IS8859-1 = the identity system.
    ; ★The whole decision lives HERE and not in the driver: the driver's own
    ; version of it (lookup_input_name, then `sel.fixed_bytes_per_char()`, then
    ; `sel.store(&dz_cs)`) silently answered the untouched default for EVERY
    ; name — a cross-package METHOD CALL on a record VALUE is the same trap the
    ; IdTable port hit, and it is silent.
    function select_app_input(host: ref[Page], name: String, out: ref[CodingSystem])
    {
        let id CodingSystem.identity()
        id.store(out)
        var sel CodingSystem.identity()
        if CodingSystemKit.lookup_input_name(host, name, false, &sel) = false
            return
        if sel.fixed_bytes_per_char() > 1
            return
        sel.store(out)
    }

    ; ---- resolve_input: the two STATEFUL systems -----------------------------
    ;
    ; XMLDecoder and UnicodeDecoder decide what they are from the first bytes of
    ; the entity, so a whole-buffer reader has to resolve them up front. The
    ; answer has four parts: how many bytes to SKIP (a byte-order mark), the
    ; decoder for the region up to `switch_at`, that switch offset, and the
    ; decoder for the rest. For every other system the answer is (0, cs, n, cs).
    ;
    ; For XML that mirrors the decoder exactly: the autodetect switch picks a
    ; guessed width, the `<?xml … ?>` PI is read AT THAT WIDTH (so its chars are
    ; the ones the caller sees), and the declaration's `encoding=` name — looked
    ; up in the ENCODING table regardless of the app's charset-fixed mode, as
    ; initDecoderPI does with its own ASCII piCharset — selects the decoder for
    ; everything after the PI's `>`. A PI that is absent, malformed or names an
    ; unknown encoding leaves the guessed default in place, from the byte where
    ; the scan gave up (initDecoderDefault + `break`).
    procedure resolve_input(host: ref[Page], cs: CodingSystem, input: Slice[u8], out_skip: ref[size_t], out_first: ref[CodingSystem], out_switch: ref[size_t], out_rest: ref[CodingSystem])
    {
        set out_skip: 0
        set out_switch: input.length
        cs.store(out_first)
        cs.store(out_rest)
        let k cs.get_kind()
        if k = IENC_UNICODE
        {
            ; UnicodeDecoder: the mark is compared as a HOST-ORDER 16-bit word,
            ; so on every LP64 target this port builds for (all little-endian)
            ; the bytes FF FE are `byteOrderMark` and FE FF are the SWAPPED one
            ; — the opposite of what the byte order says. Bug-for-bug, as on the
            ; encode side. No mark at all: UTF-16 big-endian.
            var lsb false
            var skip: size_t 0
            if input.length >= 2
            {
                let b0 input[0]
                let b1 input[1]
                if (b0 = 0xFF) and (b1 = 0xFE)
                    set skip: 2
                else if (b0 = 0xFE) and (b1 = 0xFF)
                {
                    set skip: 2
                    set lsb: true
                }
            }
            set out_skip: skip
            let u16 CodingSystem.utf16(lsb)
            u16.store(out_first)
            u16.store(out_rest)
            return
        }
        if k <> IENC_XML
            return
        ; --- XMLDecoder, phaseInit: the autodetect switch ------------------
        var width: size_t 1
        var lsb false
        var lsw false
        var skip: size_t 0
        var try_pi false
        if input.length >= 2
        {
            let b0 (input[0]) as u32
            let b1 (input[1]) as u32
            let w2 (b0 << (8 as u32)) | b1
            if (b0 = 0x00) or (b0 = 0x3C) or (b0 = 0xFF) or (b0 = 0xFE)
            {
                if w2 = 0xFEFF
                {
                    set try_pi: true
                    set width: 2
                    set skip: 2
                }
                else if w2 = 0xFFFE
                {
                    set try_pi: true
                    set width: 2
                    set lsb: true
                    set skip: 2
                }
                else if w2 = 0x3C3F
                    set try_pi: true
                else if (w2 = 0x0000) or (w2 = 0x3C00) or (w2 = 0x003C)
                {
                    if input.length >= 4
                    {
                        let b2 (input[2]) as u32
                        let b3 (input[3]) as u32
                        let w4 (b0 << (24 as u32)) | (b1 << (16 as u32)) | (b2 << (8 as u32)) | b3
                        if w4 = 0x0000003C
                        {
                            set try_pi: true
                            set width: 4
                        }
                        else if w4 = 0x00003C00
                        {
                            set try_pi: true
                            set width: 4
                            set lsb: true
                        }
                        else if w4 = 0x003C0000
                        {
                            set try_pi: true
                            set width: 4
                            set lsw: true
                        }
                        else if w4 = 0x3C000000
                        {
                            set try_pi: true
                            set width: 4
                            set lsb: true
                            set lsw: true
                        }
                        else if w4 = 0x003C003F
                        {
                            set try_pi: true
                            set width: 2
                            set lsb: true
                        }
                        else if w4 = 0x3C003F00
                        {
                            set try_pi: true
                            set width: 2
                        }
                    }
                }
            }
        }
        ; initDecoderDefault: the guessed width's decoder (1 -> UTF-8,
        ; 2 -> UTF-16, 4 -> Fixed4/UTF-32).
        var dflt CodingSystem.simple(IENC_UTF8)
        if width = 2
            set dflt: CodingSystem.utf16(lsb)
        else if width = 4
            set dflt: CodingSystem.fixed4(lsb, lsw)
        set out_skip: skip
        if try_pi = false
        {
            ; not an XML declaration at all: the default decoder from byte 0
            ; (guessBytesPerChar_ 1, so UTF-8 — which also skips a UTF-8 mark).
            dflt.store(out_first)
            dflt.store(out_rest)
            return
        }
        ; --- phasePI: read the declaration at the guessed width ------------
        ; The reference's `pi_` is a StringC that GROWS as the declaration comes
        ; in, so it costs what the declaration costs. ★Reserving its 32768-char
        ; worst case up front was not merely wasteful, it CRASHED: the host page
        ; here is `Page.get(<the caller's normalized buffer>)`, and that buffer is
        ; an OVERSIZED allocation for any entity past a few hundred bytes — the
        ; oversized page's `next_object` is NULL, so `allocate` measured its
        ; capacity from offset 0, handed out address 0 and left the header
        ; pointing into the middle of the block (SIGSEGV on the write, or a
        ; corrupted freelist and a SIGKILL later). So the scan runs TWICE: once
        ; to MEASURE (`scan_pi` with a null buffer — the only buffer state it
        ; needs is the PREVIOUS char, for the closing `>`), then over an
        ; exact-sized one.
        var pn: size_t 0
        var end_at skip
        let ended CodingSystemKit.scan_pi(input, skip, width, lsb, lsw, null, &pn, &end_at)
        ; the region read at the guessed width, and where the sub-decoder starts
        dflt.store(out_first)
        set out_switch: end_at
        dflt.store(out_rest)
        if ended = false
            return
        let pi host.allocate(pn * 4, 4) as pointer[u32]
        var pn2: size_t 0
        var end2 skip
        CodingSystemKit.scan_pi(input, skip, width, lsb, lsw, pi, &pn2, &end2)
        ; initDecoderPI: extract `encoding="…"` and look the name up
        var nm String()
        if CodingSystemKit.extract_encoding(host, pi, pn, &nm) = false
            return
        var sub CodingSystem.identity()
        if CodingSystemKit.lookup_input_name(host, nm, false, &sub)
            sub.store(out_rest)
    }

    ; One phasePI scan: `<?xml` then whitespace, no char >= 0x7F, quoted
    ; literals tracked, and the PI ends at the `>` that closes it (checked
    ; BEFORE the next char is read, so the `>` itself is part of the PI text).
    ; `pi` null MEASURES only (the end test reads the previously accepted char,
    ; which a scalar carries just as well as the buffer would). `*out_pn` = the
    ; chars accepted, `*out_end` = the byte offset the scan stopped at (the
    ; sub-decoder's switch point), result = whether the PI ENDED at its `>`
    ; (initDecoderPI) rather than aborting (initDecoderDefault).
    function scan_pi(input: Slice[u8], skip: size_t, width: size_t, lsb: bool, lsw: bool, pi: pointer[u32], out_pn: ref[size_t], out_end: ref[size_t]) returns bool
    {
        let pi_cap: size_t 32768
        var pn: size_t 0
        var prev: u32 0
        var lit: u32 0
        var i skip
        var ended false
        while (input.length - i) > width
        {
            if lit = 0
            {
                if pn > 0
                {
                    if prev = 0x3E
                    {
                        set ended: true
                        break
                    }
                }
            }
            var c: u32 0
            if width = 1
                set c: (input[i]) as u32
            else if width = 2
            {
                let x0 (input[i]) as u32
                let x1 (input[i + 1]) as u32
                if lsb
                    set c: (x1 << (8 as u32)) | x0
                else
                    set c: (x0 << (8 as u32)) | x1
            }
            else
            {
                var s0: u32 24
                var s1: u32 16
                var s2: u32 8
                var s3: u32 0
                if lsb
                {
                    if lsw
                    {
                        set s0: 0
                        set s1: 8
                        set s2: 16
                        set s3: 24
                    }
                    else
                    {
                        set s0: 16
                        set s1: 24
                        set s2: 0
                        set s3: 8
                    }
                }
                else if lsw
                {
                    set s0: 8
                    set s1: 0
                    set s2: 24
                    set s3: 16
                }
                set c: (((input[i]) as u32) << s0) | (((input[i + 1]) as u32) << s1) | (((input[i + 2]) as u32) << s2) | (((input[i + 3]) as u32) << s3)
            }
            ; the five chars of `<?xml`, then a space
            var stop false
            if c = 0
                set stop: true
            if c >= 0x7F
                set stop: true
            if pn > 0
            {
                if c = 0x3C
                    set stop: true
            }
            if pn > pi_cap - 2
                set stop: true
            if pn < 5
            {
                var want: u32 0x3C
                if pn = 1
                    set want: 0x3F
                else if pn = 2
                    set want: 0x78
                else if pn = 3
                    set want: 0x6D
                else if pn = 4
                    set want: 0x6C
                if c <> want
                    set stop: true
            }
            else if pn = 5
            {
                if CodingSystemKit.is_pi_ws(c) = false
                    set stop: true
            }
            if stop
                break
            if pi <> null
                set *(pi + pn): c
            set prev: c
            set pn: pn + 1
            if lit <> 0
            {
                if c = lit
                    set lit: 0
            }
            else if (c = 0x22) or (c = 0x27)
                set lit: c
            set i: i + width
        }
        set out_pn: pn
        set out_end: i
        ended
    }

    ; XMLDecoder::isWS
    function is_pi_ws(c: u32) returns bool
    {
        if c = 0x0D
            return true
        if c = 0x0A
            return true
        if c = 0x20
            return true
        if c = 0x09
            return true
        false
    }

    ; XMLDecoder::extractEncoding — find an `encoding` pseudo-attribute in the
    ; accumulated PI text and return its literal value. The scan walks from the
    ; sixth char: an `=` outside a literal makes the token before it (trimmed of
    ; whitespace) a candidate name, and if that name is exactly `encoding` the
    ; following literal is the value.
    function extract_encoding(host: ref[Page], pi: pointer[u32], pn: size_t, out: ref[String]) returns bool
    {
        var lit: u32 0
        var i: size_t 5
        while i < pn
        {
            let c *(pi + i)
            if lit = 0
            {
                if (c = 0x27) or (c = 0x22)
                    set lit: c
                else if c = 0x3D
                {
                    var j i
                    while j > 0
                    {
                        if CodingSystemKit.is_pi_ws(*(pi + j - 1)) = false
                            break
                        set j: j - 1
                    }
                    let name_end j
                    while j > 0
                    {
                        let pc *(pi + j - 1)
                        if CodingSystemKit.is_pi_ws(pc)
                            break
                        if pc = 0x22
                            break
                        if pc = 0x27
                            break
                        set j: j - 1
                    }
                    ; is the token exactly "encoding"?
                    var k j
                    var m: size_t 0
                    let want ENCODING_NAME
                    var matched true
                    while m < 8
                    {
                        if k >= name_end
                        {
                            set matched: false
                            break
                        }
                        if *(pi + k) <> *(want + m)
                        {
                            set matched: false
                            break
                        }
                        set k: k + 1
                        set m: m + 1
                    }
                    if matched
                    {
                        if k = name_end
                        {
                            var q i + 1
                            while q < pn
                            {
                                if CodingSystemKit.is_pi_ws(*(pi + q)) = false
                                    break
                                set q: q + 1
                            }
                            if q < pn
                            {
                                let ql *(pi + q)
                                if (ql = 0x22) or (ql = 0x27)
                                {
                                    let start q + 1
                                    var e start
                                    while e < pn
                                    {
                                        if *(pi + e) = ql
                                            break
                                        set e: e + 1
                                    }
                                    if e < pn
                                    {
                                        if e > start
                                        {
                                            ; the PI scan rejects every char >=
                                            ; 0x7F, so the name is ASCII.
                                            let bytes Array[u8]^host()
                                            var b start
                                            while b < e
                                            {
                                                bytes.add((*(pi + b)) as u8)
                                                set b: b + 1
                                            }
                                            ; ★on the HOST page: String's init
                                            ; allocates its buffer on
                                            ; Page.get(this), and `this` for a
                                            ; store into the caller's stack
                                            ; local is NOT page-hosted — the
                                            ; name came back as garbage (it
                                            ; even matched "XML") before this.
                                            set out: String^host(bytes.get_buffer() as pointer[const_char], bytes.get_length())
                                            return true
                                        }
                                        return false
                                    }
                                    return false
                                }
                            }
                        }
                    }
                }
            }
            else if c = lit
                set lit: 0
            set i: i + 1
        }
        false
    }


    ; ---- the concrete encoders ------------------------------------------------

    function put_utf8(acc: ref[Array[u8]], c: u32)
    {
        if c < 0x80
            acc.add(c as u8)
        else if c < 0x800
        {
            acc.add((0xC0 | (c >> (6 as u32))) as u8)
            acc.add((0x80 | (c & 0x3F)) as u8)
        }
        else if c < 0x10000
        {
            acc.add((0xE0 | (c >> (12 as u32))) as u8)
            acc.add((0x80 | ((c >> (6 as u32)) & 0x3F)) as u8)
            acc.add((0x80 | (c & 0x3F)) as u8)
        }
        else
        {
            acc.add((0xF0 | (c >> (18 as u32))) as u8)
            acc.add((0x80 | ((c >> (12 as u32)) & 0x3F)) as u8)
            acc.add((0x80 | ((c >> (6 as u32)) & 0x3F)) as u8)
            acc.add((0x80 | (c & 0x3F)) as u8)
        }
    }

    ; UTF16Encoder::output — big-endian, surrogate pairs above the BMP.
    function put_utf16(acc: ref[Array[u8]], c: u32)
    {
        if c < 0x10000
        {
            acc.add(((c >> (8 as u32)) & 0xFF) as u8)
            acc.add((c & 0xFF) as u8)
        }
        else
        {
            let y ((c - 0x10000) / 0x400) + 0xD800
            let z ((c - 0x10000) % 0x400) + 0xDC00
            acc.add(((y >> (8 as u32)) & 0xFF) as u8)
            acc.add((y & 0xFF) as u8)
            acc.add(((z >> (8 as u32)) & 0xFF) as u8)
            acc.add((z & 0xFF) as u8)
        }
    }

    ; EUCJPEncoder::output — pure bit-split on the 0x8080 mask, never fails.
    function put_euc(acc: ref[Array[u8]], c: u32)
    {
        let mask c & 0x8080
        if mask = 0
            acc.add((c & 0xFF) as u8)
        else if mask = 0x8080
        {
            acc.add(((c >> (8 as u32)) & 0xFF) as u8)
            acc.add((c & 0xFF) as u8)
        }
        else if mask = 0x0080
        {
            acc.add(0x8E)
            acc.add((c & 0xFF) as u8)
        }
        else
        {
            acc.add(0x8F)
            acc.add(((c >> (8 as u32)) & 0xFF) as u8)
            acc.add((c & 0x7F) as u8)
        }
    }

    ; SJISEncoder::output — returns false when the char is unencodable (the
    ; caller decides between the escaper and the silent sub-encoder drop).
    function put_sjis(acc: ref[Array[u8]], c: u32) returns bool
    {
        let mask c & 0x8080
        if mask = 0
        {
            acc.add((c & 0xFF) as u8)
            return true
        }
        if mask = 0x8080
        {
            let c1 (c >> (8 as u32)) & 0x7F
            let c2 c & 0x7F
            var out1: u32 0
            if c1 < 33
                set out1: 0
            else if c1 < 95
                set out1: ((c1 + 1) >> (1 as u32)) + 112
            else if c1 < 127
                set out1: ((c1 + 1) >> (1 as u32)) + 176
            if out1 <> 0
            {
                var out2: u32 0
                if (c1 & 1) <> 0
                {
                    if c2 < 33
                        set out2: 0
                    else if c2 <= 95
                        set out2: c2 + 31
                    else if c2 <= 126
                        set out2: c2 + 32
                }
                else
                {
                    if (33 <= c2) and (c2 <= 126)
                        set out2: c2 + 126
                }
                if out2 <> 0
                {
                    acc.add(out1 as u8)
                    acc.add(out2 as u8)
                    return true
                }
                return false
            }
            return false
        }
        if mask = 0x0080
        {
            if (161 <= c) and (c <= 223)
            {
                acc.add((c & 0xFF) as u8)
                return true
            }
            return false
        }
        false
    }

    ; Big5Encoder::output — returns false when unencodable (plain Encoder:
    ; direct use drops; as a translate sub it drops too).
    function put_big5(acc: ref[Array[u8]], c: u32) returns bool
    {
        if c < 0x80
        {
            acc.add(c as u8)
            return true
        }
        if (c & 0x8000) <> 0
        {
            acc.add(((c >> (8 as u32)) & 0xFF) as u8)
            acc.add((c & 0xFF) as u8)
            return true
        }
        false
    }

    ; the escaper (SgmlsEventHandler::escaper): `\#<decimal>;` written back
    ; through the same encoder — each escape char is re-encoded (and could in
    ; principle recurse; every table maps the ASCII escape chars).
    ; the escape sequence itself goes back through the SAME encoder (the
    ; reference builds a temporary EncodeOutputCharStream over the same
    ; Encoder), so its own chars are translated too. The lead-in is the only
    ; difference between the two escapers: `\#` for the ESIS stream,
    ; `&#` for outputNumericCharRef in the jade backends.
    function put_escape(enc: ref[OutputEncoder], acc: ref[Array[u8]], c: u32, esc: int)
    {
        var lead: u32 0x5C
        if esc = OESC_CHARREF
            set lead: 0x26
        CodingSystemKit.out_char(enc, lead, acc, esc)
        CodingSystemKit.out_char(enc, 0x23, acc, esc)
        var digits u8[16]
        var v c
        var count: size_t 0
        var go true
        while go
        {
            set digits[count]: ((0x30 + (v % 10)) as u8)
            set count: count + 1
            set v: v / 10
            if v = 0
                set go: false
        }
        var i count
        while i > 0
        {
            set i: i - 1
            CodingSystemKit.out_char(enc, (digits[i]) as u32, acc, esc)
        }
        CodingSystemKit.out_char(enc, 0x3B, acc, esc)
    }

    ; one Char through the output coding system. `esc` is the stream's escaper
    ; (OESC_BACKSLASH for ESIS stdout, OESC_CHARREF for the jade char-stream
    ; backends, OESC_NONE for RAST / the HTML backend / stderr) — it only ever
    ; fires for the RecoveringEncoder-derived systems (Identity, Fixed2, SJIS,
    ; Translate); the plain-Encoder systems drop.
    function out_char(enc: ref[OutputEncoder], c: u32, acc: ref[Array[u8]], esc: int)
    {
        let kind enc.kind
        if kind = OENC_UTF8
        {
            CodingSystemKit.put_utf8(acc, c)
            return
        }
        if kind = OENC_IDENTITY
        {
            if c < 0x100
            {
                acc.add(c as u8)
                return
            }
            if esc <> OESC_NONE
                CodingSystemKit.put_escape(enc, acc, c, esc)
            return
        }
        if kind = OENC_FIXED2
        {
            if c > 0xFFFF
            {
                if esc <> OESC_NONE
                    CodingSystemKit.put_escape(enc, acc, c, esc)
                return
            }
            acc.add(((c >> (8 as u32)) & 0xFF) as u8)
            acc.add((c & 0xFF) as u8)
            return
        }
        if kind = OENC_FIXED4
        {
            acc.add(((c >> (24 as u32)) & 0xFF) as u8)
            acc.add(((c >> (16 as u32)) & 0xFF) as u8)
            acc.add(((c >> (8 as u32)) & 0xFF) as u8)
            acc.add((c & 0xFF) as u8)
            return
        }
        if (kind = OENC_UTF16) or (kind = OENC_UNICODE)
        {
            CodingSystemKit.put_utf16(acc, c)
            return
        }
        if kind = OENC_EUC
        {
            CodingSystemKit.put_euc(acc, c)
            return
        }
        if kind = OENC_SJIS
        {
            ; direct SJIS is a RecoveringEncoder — unencodable escapes.
            if CodingSystemKit.put_sjis(acc, c) = false
            {
                if esc <> OESC_NONE
                    CodingSystemKit.put_escape(enc, acc, c, esc)
            }
            return
        }
        if kind = OENC_BIG5
        {
            ; direct Big5 is a plain Encoder — unencodable drops.
            let ok CodingSystemKit.put_big5(acc, c)
            return
        }
        ; OENC_TRANSLATE: map-level illegal escapes; a mapped char the sub
        ; bctf cannot express drops (the sub encoder has no handler).
        var mapped enc.illegal
        if c < 0x10000
            set mapped: *(enc.map + (c as size_t))
        if mapped = enc.illegal
        {
            if esc <> OESC_NONE
                CodingSystemKit.put_escape(enc, acc, c, esc)
            return
        }
        if enc.sub = OENC_EUC
        {
            CodingSystemKit.put_euc(acc, mapped)
            return
        }
        if enc.sub = OENC_SJIS
        {
            let ok CodingSystemKit.put_sjis(acc, mapped)
            return
        }
        if enc.sub = OENC_BIG5
        {
            let ok CodingSystemKit.put_big5(acc, mapped)
            return
        }
        ; identity sub (the 8-bit translate systems)
        if mapped < 0x100
            acc.add(mapped as u8)
    }

    ; Re-encode a writer's internal UTF-8 char stream through the selected
    ; output coding system. `bom` = Encoder::startFile at stream creation —
    ; only UnicodeEncoder writes one: the byteOrderMark in HOST byte order
    ; (all four LP64 targets are little-endian, so FF FE) followed by
    ; big-endian UTF-16 content, bug-for-bug with the reference.
    function transcode(host: ref[Page], enc: ref[OutputEncoder], internal: String, esc: int, bom: bool) returns String
    {
        if enc.kind = OENC_UTF8
            return internal
        let acc CodingSystemKit.encode_bytes(host, enc, internal.as_slice(), esc, bom)
        String(acc.get_buffer() as pointer[const_char], acc.get_length())
    }

    ; the byte-level core of transcode: an internal UTF-8 buffer decoded char
    ; by char and written through `enc` into a fresh page-hosted accumulator.
    ; ★Returns the ACCUMULATOR, not a String: every caller builds the String
    ; itself, as its own return expression. A String constructed two frames
    ; down lands through `Page.get(this)` on the outermost caller's return
    ; slot — a stack local — and comes back as garbage (the SIGSEGV this
    ; package's first cut produced in the fot backend).
    function encode_bytes(host: ref[Page], enc: ref[OutputEncoder], buf: Slice[u8], esc: int, bom: bool) returns ref[Array[u8]]
    {
        let acc Array[u8]^host()
        if bom and (enc.kind = OENC_UNICODE)
        {
            acc.add(0xFF)
            acc.add(0xFE)
        }
        var i: size_t 0
        while i < buf.length
        {
            let b0 (buf[i]) as u32
            var c b0
            var extra: size_t 0
            if (b0 & 0x80) = 0
                set extra: 0
            else if (b0 & 0xE0) = 0xC0
            {
                set c: b0 & 0x1F
                set extra: 1
            }
            else if (b0 & 0xF0) = 0xE0
            {
                set c: b0 & 0x0F
                set extra: 2
            }
            else
            {
                set c: b0 & 0x07
                set extra: 3
            }
            var k: size_t 0
            while k < extra
            {
                set i: i + 1
                if i >= buf.length
                    break
                set c: (c << (6 as u32)) | (((buf[i]) as u32) & 0x3F)
                set k: k + 1
            }
            CodingSystemKit.out_char(enc, c, acc, esc)
            set i: i + 1
        }
        acc
    }

    function test() returns int
    {
        let anchor String("k")
        let host Page.get(anchor.get_buffer())

        ; identity escapes >0xFF through the escaper (`é` stays, U+20AC -> \#8364;)
        var e0 OutputEncoder()
        CodingSystemKit.make_encoder(host, OENC_IDENTITY, 0, &e0)
        var acc0 Array[u8]()
        CodingSystemKit.out_char(&e0, 0xE9, &acc0, OESC_BACKSLASH)
        CodingSystemKit.out_char(&e0, 0x20AC, &acc0, OESC_BACKSLASH)
        if acc0.get_length() <> 8
            return -1
        if *(acc0.get_buffer()) <> 0xE9
            return -2
        if acc0[1] <> 0x5C
            return -3

        ; EUC bctf splits on the 0x8080 mask: 0xE9 -> SS2 0x8E 0xE9
        var e1 OutputEncoder()
        CodingSystemKit.make_encoder(host, OENC_EUC, 0, &e1)
        var acc1 Array[u8]()
        CodingSystemKit.out_char(&e1, 0xE9, &acc1, OESC_BACKSLASH)
        if acc1.get_length() <> 2
            return -4
        if *(acc1.get_buffer()) <> 0x8E
            return -5

        ; ISO-8859-1 translate: é -> 0xE9, € -> illegal -> \#8364; (plain `\`)
        var e2 OutputEncoder()
        CodingSystemKit.make_encoder(host, OENC_TRANSLATE, OENC_T_ISO8859_1, &e2)
        var acc2 Array[u8]()
        CodingSystemKit.out_char(&e2, 0xE9, &acc2, OESC_BACKSLASH)
        CodingSystemKit.out_char(&e2, 0x20AC, &acc2, OESC_BACKSLASH)
        if acc2.get_length() <> 8
            return -6
        if *(acc2.get_buffer()) <> 0xE9
            return -7
        if acc2[1] <> 0x5C
            return -8

        ; NB the CJK translate systems (EUC-JP/SJIS/BIG5/GB/KSC) are exercised
        ; end-to-end and A/B-verified against onsgmls -b in the corpus fixtures
        ; (synth-bctf-*/synth-encoding-*), not here: their escape-prefix byte
        ; (`\` via the contested JIS-G0/JIS0208 U+005C mapping) is not asserted
        ; as a raw unit here.

        ; --- the input side: name lookup and the XML resolver ---------------
        var probe CodingSystem.identity()
        if CodingSystemKit.lookup_input_name(host, String("UTF-8"), false, &probe) = false
            return -30
        if probe.get_kind() <> IENC_UTF8
            return -31
        if CodingSystemKit.lookup_input_name(host, String("XML"), false, &probe) = false
            return -32
        if probe.get_kind() <> IENC_XML
            return -33
        if CodingSystemKit.lookup_input_name(host, String("ISO-8859-1"), false, &probe) = false
            return -34
        if probe.get_kind() <> IENC_IDENTITY
            return -35
        if CodingSystemKit.lookup_input_name(host, String("KOI8-R"), false, &probe) = false
            return -36
        if probe.get_kind() <> IENC_TRANSLATE
            return -37
        if CodingSystemKit.lookup_input_name(host, String("NO-SUCH-CS"), false, &probe)
            return -38

        ; resolve_input over `<?xml version="1.0" encoding="UTF-8"?>` + a byte
        var pib Array[u8]()
        let pitext String("<?xml version=\"1.0\" encoding=\"UTF-8\"?>X")
        var pk: size_t 0
        while pk < pitext.get_length()
        {
            pib.add(pitext.get(pk))
            set pk: pk + 1
        }
        var rskip: size_t 0
        var rfirst CodingSystem.identity()
        var rswitch: size_t 0
        var rrest CodingSystem.identity()
        let xmlcs CodingSystem.simple(IENC_XML)
        CodingSystemKit.resolve_input(host, xmlcs, pib.as_slice(), &rskip, &rfirst, &rswitch, &rrest)
        if rskip <> 0
            return -39
        if rfirst.get_kind() <> IENC_UTF8
            return -40
        if rswitch <> (pitext.get_length() - 1)
            return -41
        if rrest.get_kind() <> IENC_UTF8
            return -42

        ; transcode: internal UTF-8 `A é` to UNICODE = BOM + UTF-16BE
        var acc4 Array[u8]()
        acc4.add(0x41)
        acc4.add(0xC3)
        acc4.add(0xA9)
        let s4 String(acc4.get_buffer() as pointer[const_char], acc4.get_length())
        var e4 OutputEncoder()
        CodingSystemKit.make_encoder(host, OENC_UNICODE, 0, &e4)
        let t4 CodingSystemKit.transcode(host, &e4, s4, OESC_NONE, true).as_slice()
        if t4.length <> 6
            return -12
        if t4[0] <> 0xFF
            return -13
        if t4[3] <> 0x41
            return -14
        if t4[5] <> 0xE9
            return -15

        0
    }
}
