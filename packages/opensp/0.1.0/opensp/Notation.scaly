use scaly.memory.Page
use scaly.containers.String
use opensp.StringC.StringC
use opensp.ExternalId.ExternalId
use opensp.Location.Location
use opensp.Location.Origin
use opensp.AttributeList.AttributeDefinitionList

; Notation — Notation.cs (C++ Notation.h/.cxx). A NOTATION declaration: a name,
; an optional external identifier, and (because a notation is Attributed) its
; data-attribute definition list.
;
; MI resolution (DESIGN.md Stage 3): C++ `Notation : EntityDecl + Attributed`.
; Scaly has no MI, so — exactly as the C# port did for the Attributed half — the
; EntityDecl declaration metadata (declType/dataType/dtd-scoping/defLocation) and
; the Attributed member (`attribute_def`) are FOLDED INLINE into Notation. A
; notation's declType is always `notation` and its dataType always `ndata`, so
; those are fixed accessors rather than stored fields. The full shared EntityDecl
; base (reused by the entity table) and the entity-side decl metadata land with
; the Dtd/entity-table increment; Notation is a self-contained leaf here.
;
; Notations are referenced by IDENTITY (a borrowed pointer) from
; NotationAttributeSemantics and the DTD's notation table, so they are
; page-hosted (one region per run) via `Notation.make(host, ...)`.
;
; `generateSystemId` (catalog lookup of a notation's system id) needs the live
; ParserState + EntityCatalog and lands with the parser stage.

; EntityDecl::DeclType (the notation value is all this leaf needs; the full enum
; is shared by the entity table in the Dtd increment). DataType lives in the
; Entity module (DT_NDATA), visible unqualified across the package.
define DCL_GENERAL_ENTITY: int 0
define DCL_PARAMETER_ENTITY: int 1
define DCL_DOCTYPE: int 2
define DCL_LINKTYPE: int 3
define DCL_NOTATION: int 4
define DCL_SGML: int 5

define Notation
(
    name: StringC
    dtd_is_base: bool
    dtd_name: StringC
    def_location: Location
    defined: bool
    external_id: ExternalId
    attribute_def: ref[AttributeDefinitionList]?
)
{
    function make(host: pointer[Page], name: StringC, dtd_name: StringC, dtd_is_base: bool) returns ref[Notation]
    {
        let n host.allocate(sizeof Notation, alignof Notation) as pointer[Notation]
        set n.name: name
        set n.dtd_is_base: dtd_is_base
        set n.dtd_name: dtd_name
        set n.def_location: Location()
        set n.defined: false
        set n.external_id: ExternalId()
        set n.attribute_def: null
        n
    }

    function get_name(this: Notation) returns StringC
        name

    ; EntityDecl::declType / dataType — constant for a notation.
    function decl_type(this: Notation) returns int
        DCL_NOTATION

    function data_type(this: Notation) returns int
        DT_NDATA

    function decl_in_dtd_is_base(this: Notation) returns bool
        dtd_is_base

    function decl_in_dtd_name(this: Notation) returns StringC
        dtd_name

    function get_def_location(this: Notation) returns Location
        def_location

    function set_def_location(this: ref[Notation], loc: Location)
        set this.def_location: loc

    ; Notation::defined — true once an external id has been set by ATTLIST/NOTATION.
    function is_defined(this: Notation) returns bool
        defined

    function get_external_id(this: Notation) returns ExternalId
        external_id

    ; Notation::generateSystemId's result — stamp the effective system id
    ; (the -onotation-sysid f-record) into the stored external id.
    function set_effective_system(this: ref[Notation], eff: String)
        set this.external_id: ExternalId.with_effective(this.external_id, eff)

    ; Notation::setExternalId — records the id, marks the notation defined, and
    ; stamps the declaration location.
    function set_external_id(this: ref[Notation], id: ExternalId, def_location: Location)
    {
        set this.external_id: id
        set this.defined: true
        set this.def_location: def_location
    }

    ; systemIdPointer / publicIdPointer — presence + value from the external id.
    function has_system_id(this: Notation) returns bool
        external_id.has_system_id()

    function system_id(this: Notation) returns String
        external_id.get_system_id()

    function has_public_id(this: Notation) returns bool
        external_id.has_public_id()

    function public_id(this: Notation) returns String
        external_id.get_public_id()

    ; Attributed (inline): the notation's data-attribute definition list.
    function get_attribute_def(this: Notation) returns ref[AttributeDefinitionList]?
        attribute_def

    function set_attribute_def(this: ref[Notation], def: ref[AttributeDefinitionList])
        set this.attribute_def: def

    function test() returns int
    {
        let host Page.get(StringC("x").data_ptr() as pointer[void])

        ; a freshly declared (but not yet externally identified) notation "gif".
        let n Notation.make(host, StringC("gif"), StringC("model"), true)
        if n.get_name().equals(StringC("gif")) = false
            return -1
        if n.decl_type() <> DCL_NOTATION
            return -2
        if n.data_type() <> DT_NDATA
            return -3
        if n.is_defined()
            return -4
        if n.decl_in_dtd_is_base() = false
            return -5
        if n.get_attribute_def() <> null
            return -6

        ; give it a SYSTEM id -> defined, id readable, def-location stamped.
        var org Origin()
        let loc Location(&org, 7)
        n.set_external_id(ExternalId(false, String(), true, "gif.exe"), loc)
        if n.is_defined() = false
            return -7
        if n.has_system_id() = false
            return -8
        if (n.system_id() = "gif.exe") = false
            return -9
        if n.has_public_id()
            return -10
        if n.get_def_location().get_index() <> 7
            return -11

        ; attach a (empty) data-attribute definition list -> readable by identity.
        let adl AttributeDefinitionList.make(host, 0)
        n.set_attribute_def(adl)
        if n.get_attribute_def() <> adl
            return -12

        0
    }
}
