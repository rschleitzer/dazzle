use scaly.memory.Page

; Source locations — Location.cs / InputSource.cs.
;
; A Location is the fundamental (origin, index) pair. An Origin is where a run
; of Chars came from; for an input source it also records refLocation_ — the
; location in the PARENT source where this source was referenced — so a
; location resolves back up through nested (pushed) sources via parent().
;
; Stage-1 scope: `Origin` models InputSourceOrigin (the only origin kind the
; foundation needs yet); the rest of the C++ hierarchy (Proxy/Bracket/
; Replacement/NumericCharRef/Entity origins) lands when the parser produces
; them. `InputSource` is the in-memory (InternalInputSource) form — a Char
; buffer + origin + start location, enough for nested location tracking; the
; streaming decoder-backed source with a mutable fill() cursor is Stage 2.
;
; Origins/sources are referenced by pointer and must outlive the Locations that
; point at them (one parse region — everything lives to run end). `Index` is u32.

define Location (origin: pointer[Origin](null), index: u32(0))
{
    init()
    {
        set origin: null
        set index: (0 as u32)
    }

    init(origin: pointer[Origin], index: u32)
    {
        set origin: origin
        set index: index
    }

    function get_index(this: Location) returns u32
        index

    function get_origin(this: Location) returns pointer[Origin]
        origin

    function is_null(this: Location) returns bool
        origin = null

    ; The location where this location's origin was referenced (walk one level
    ; up the nesting). A null-origin location's parent is itself null.
    function parent(this: Location) returns Location
    {
        if origin = null
            return Location()

        (*origin).parent()
    }
}

; Origin — Stage-1 InputSourceOrigin. ref_location is the location in the
; parent source where this source was referenced (empty for the top source).
define Origin (ref_location: Location)
{
    init()
    {
        set ref_location: Location()
    }

    init(ref_location: Location)
    {
        set ref_location: ref_location
    }

    ; Origin.parent() == InputSourceOriginImpl.parent() => refLocation_.
    function parent(this: Origin) returns Location
        ref_location
}

; InputSource — in-memory Char buffer with an origin. current_location(index)
; is the Location of the char at `index`; char_at reads it. (Stage 2 adds the
; streaming fill()/get() cursor and record normalization.)
;
; Increment-B scanner cursor (InputSource.cs): the Recognizer scans a token by
; repeatedly advancing `cur_index` (`token_char`), then commits the recognized
; length with `end_token`. `start_token_no_multicode` marks the token start
; (the reference syntax is single-code, so the multicode/scanSuppress path is
; not needed). `token_char` yields the signed end-of-entity sentinel eE (-1)
; past the buffer end — the recognizer maps eE to equiv code 0 (tokenEe).
define InputSource (origin: pointer[Origin](null), contents: pointer[u32](null), length: size_t(0), start_index: size_t(0), cur_index: size_t(0), end_index: size_t(0), start_loc_index: u32(0))
{
    init(origin: pointer[Origin], contents: pointer[u32], length: size_t)
    {
        set origin: origin
        set contents: contents
        set length: length
        set start_index: 0
        set cur_index: 0
        set end_index: length
        set start_loc_index: (0 as u32)
    }

    function get_length(this: InputSource) returns size_t
        length

    function char_at(this: InputSource, index: size_t) returns u32
    {
        if index >= length
            return (0 as u32)

        *(contents + index)
    }

    function current_location(this: InputSource, index: size_t) returns Location
        Location(origin, index as u32)

    ; --- token-scanning cursor (multicode=false path) ---

    ; void startTokenNoMulticode(): commit any consumed chars to the start
    ; location, then anchor the new token at the current position.
    function start_token_no_multicode(this: InputSource)
    {
        set start_loc_index: start_loc_index + ((cur_index - start_index) as u32)
        set start_index: cur_index
    }

    ; Xchar tokenChar(Messenger&): next char, advancing the cursor; eE (-1) at
    ; end of the in-memory buffer (fill() of an internal source returns eE).
    function token_char(this: InputSource) returns i32
    {
        if cur_index < end_index
        {
            let c *(contents + cur_index) as i32
            set cur_index: cur_index + 1
            return c
        }
        -1
    }

    ; void endToken(size_t length): the recognizer knows the matched length.
    function end_token(this: InputSource, len: size_t)
        set cur_index: start_index + len

    ; size_t currentTokenLength()
    function current_token_length(this: InputSource) returns size_t
        cur_index - start_index

    function current_token_start_index(this: InputSource) returns size_t
        start_index

    function token_start_location(this: InputSource) returns Location
        Location(origin, start_loc_index)

    function test() returns int
    {
        ; Top source A = "hello" (origin has no reference location).
        var origin_a Origin()
        var ca u32[5]
        let pca ca as pointer[u32]
        set *(pca + (0 as size_t)): (0x68 as u32)
        set *(pca + (1 as size_t)): (0x65 as u32)
        set *(pca + (2 as size_t)): (0x6C as u32)
        set *(pca + (3 as size_t)): (0x6C as u32)
        set *(pca + (4 as size_t)): (0x6F as u32)
        var src_a InputSource(&origin_a, pca, 5 as size_t)

        if src_a.char_at(1 as size_t) <> (0x65 as u32)
            return -1

        ; While parsing A at index 2, push source B = "XY" referenced there.
        let ref_in_a src_a.current_location(2 as size_t)
        var origin_b Origin(ref_in_a)
        var cb u32[2]
        let pcb cb as pointer[u32]
        set *(pcb + (0 as size_t)): (0x58 as u32)
        set *(pcb + (1 as size_t)): (0x59 as u32)
        var src_b InputSource(&origin_b, pcb, 2 as size_t)

        ; A location deep in B.
        let loc_b src_b.current_location(1 as size_t)
        if loc_b.get_index() <> (1 as u32)
            return -2

        if loc_b.is_null()
            return -3

        ; Walk up: B's origin was referenced at A index 2.
        let up loc_b.parent()
        if up.get_index() <> (2 as u32)
            return -4

        if up.get_origin() <> (&origin_a)
            return -5

        ; A is the top source: its origin has a null reference location.
        let top up.parent()
        if top.is_null() = false
            return -6

        0
    }
}
