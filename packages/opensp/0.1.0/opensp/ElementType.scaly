use scaly.memory.Page

; ElementType — minimal seed (ElementType.cs is 389 LOC, lands whole in the
; Dtd increment). The content-model DFA (ContentToken) references an element
; type only by IDENTITY (pointer equality in the transition tables) and by its
; dense INDEX (elementTransition/nextTypeIndex arrays), so those two fields are
; all the DFA needs. The declaration/attributed machinery is added later.
;
; ElementTypes are page-hosted so pointer identity is stable for the run
; (one-region-per-run doctrine): construct with `ElementType^host(name, index)`.

define ElementType (name: String, index: size_t)
{
    init(name: String, index: size_t)
    {
        set name: name
        set index: index
    }

    function get_index(this: ElementType) returns size_t
        index

    function get_name(this: ElementType) returns String
        name
}
