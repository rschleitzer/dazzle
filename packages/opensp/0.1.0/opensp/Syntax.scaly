use scaly.memory.Page
use opensp.Sd.Sd

; Syntax — the concrete/reference syntax (Syntax.cs).
;
; Stage-3 Increment A: the reference-syntax CHARACTER CLASSIFICATION, namecase
; substitution and quantities built by the C++ `Syntax(const Sd&)` ctor —
; letters/digits classified, lowercase folded to uppercase, reference
; quantities loaded. This is what name scanning (extendNameToken) needs.
;
; Deferred to Increment B (scanner): the general-delimiter table (populated by
; the SD parser / reference concrete syntax), standard functions (RE/RS/SPACE),
; the s/blank/sepchar sets, reserved-name table, shortref delimiters and the
; markup-scan table. The category table is keyed over the ASCII range (chars
; >= 256 are always `other` in the reference syntax), so a 256-entry table
; suffices; extend on demand when a non-ASCII naming rule appears.

; Category values (bit-ordered so nameChar == "category >= nameStart").
define CAT_OTHER: int 0
define CAT_S: int 1
define CAT_NAMESTART: int 2
define CAT_DIGIT: int 4
define CAT_OTHERNAME: int 8

; Quantity indices (enum Quantity) and their reference values.
define qATTCNT: int 0
define qATTSPLEN: int 1
define qBSEQLEN: int 2
define qDTAGLEN: int 3
define qDTEMPLEN: int 4
define qENTLVL: int 5
define qGRPCNT: int 6
define qGRPGTCNT: int 7
define qGRPLVL: int 8
define qLITLEN: int 9
define qNAMELEN: int 10
define qNORMSEP: int 11
define qPILEN: int 12
define qTAGLEN: int 13
define qTAGLVL: int 14
define N_QUANTITY: size_t 15

define Syntax (category: pointer[u8], subst: pointer[u32], quantity: pointer[u32])
{
    ; Build the reference syntax over the given Sd (identity charset).
    init(sd: Sd)
    {
        let own_page Page.get(this as pointer[void])
        set category: own_page.allocate(256, 1) as pointer[u8]
        set subst: own_page.allocate(256 * (4 as size_t), 4) as pointer[u32]
        set quantity: own_page.allocate(N_QUANTITY * (4 as size_t), 4) as pointer[u32]

        var i: size_t 0
        while i < (256 as size_t)
        {
            set *(category + i): CAT_OTHER as u8
            set *(subst + i): i as u32
            set i: i + 1
        }

        ; letters -> nameStart; lowercase folds to uppercase (namecase general)
        var k: int 0
        while k < 26
        {
            let lc (sd.exec_to_internal((0x61 + k) as u8)) as size_t
            let uc (sd.exec_to_internal((0x41 + k) as u8)) as size_t
            set *(category + lc): CAT_NAMESTART as u8
            set *(category + uc): CAT_NAMESTART as u8
            set *(subst + lc): uc as u32
            set k: k + 1
        }

        ; digits -> digit
        set k: 0
        while k < 10
        {
            let c (sd.exec_to_internal((0x30 + k) as u8)) as size_t
            set *(category + c): CAT_DIGIT as u8
            set k: k + 1
        }

        set i: 0
        while i < N_QUANTITY
        {
            set *(quantity + i): ref_q(i as int)
            set i: i + 1
        }
    }

    ; Reference quantity set (Syntax.referenceQuantity_).
    function ref_q(this: Syntax, q: int) returns u32
    {
        if q = qATTCNT
            return 40 as u32
        if q = qATTSPLEN
            return 960 as u32
        if q = qBSEQLEN
            return 960 as u32
        if q = qDTAGLEN
            return 16 as u32
        if q = qDTEMPLEN
            return 16 as u32
        if q = qENTLVL
            return 16 as u32
        if q = qGRPCNT
            return 32 as u32
        if q = qGRPGTCNT
            return 96 as u32
        if q = qGRPLVL
            return 16 as u32
        if q = qLITLEN
            return 240 as u32
        if q = qNAMELEN
            return 8 as u32
        if q = qNORMSEP
            return 2 as u32
        if q = qPILEN
            return 240 as u32
        if q = qTAGLEN
            return 960 as u32
        if q = qTAGLVL
            return 24 as u32
        0 as u32
    }

    function category_of(this: Syntax, c: u32) returns int
    {
        if c >= (256 as u32)
            return CAT_OTHER

        *(category + (c as size_t)) as int
    }

    function is_name_start_character(this: Syntax, c: u32) returns bool
        category_of(c) = CAT_NAMESTART

    ; A name character is name-start OR digit OR other-name (category >= nameStart).
    function is_name_character(this: Syntax, c: u32) returns bool
        category_of(c) >= CAT_NAMESTART

    function is_digit(this: Syntax, c: u32) returns bool
        category_of(c) = CAT_DIGIT

    function is_hex_digit(this: Syntax, c: u32) returns bool
    {
        if (c >= (0x30 as u32)) and (c <= (0x39 as u32))
            return true
        if (c >= (0x41 as u32)) and (c <= (0x46 as u32))
            return true
        if (c >= (0x61 as u32)) and (c <= (0x66 as u32))
            return true
        false
    }

    ; Namecase fold (uppercase substitution for general names).
    function fold(this: Syntax, c: u32) returns u32
    {
        if c >= (256 as u32)
            return c

        *(subst + (c as size_t))
    }

    function get_quantity(this: Syntax, q: int) returns u32
        *(quantity + (q as size_t))

    function reference_quantity(this: Syntax, q: int) returns u32
        ref_q(q)

    ; Extend naming rules (what the SD parser's NAMING LCNMCHAR/UCNMCHAR /
    ; XML name-char additions do). Inclusive ranges over the ASCII table.
    function add_name_start_characters(this: Syntax, lo: u32, hi: u32)
    {
        var c lo
        while (c <= hi) and (c < (256 as u32))
        {
            set *(category + (c as size_t)): CAT_NAMESTART as u8
            set c: c + 1
        }
    }

    function add_name_characters(this: Syntax, lo: u32, hi: u32)
    {
        var c lo
        while (c <= hi) and (c < (256 as u32))
        {
            if (*(category + (c as size_t)) as int) = CAT_OTHER
                set *(category + (c as size_t)): CAT_OTHERNAME as u8
            set c: c + 1
        }
    }

    function test() returns int
    {
        let sd Sd()
        let syn Syntax(sd)

        ; letters are name-start
        if syn.is_name_start_character(0x41 as u32) = false
            return -1

        if syn.is_name_start_character(0x7A as u32) = false
            return -2

        ; digits are name chars but not name-start
        if syn.is_name_start_character(0x35 as u32)
            return -3

        if syn.is_digit(0x35 as u32) = false
            return -4

        if syn.is_name_character(0x35 as u32) = false
            return -5

        ; hex digits
        if syn.is_hex_digit(0x66 as u32) = false
            return -6

        if syn.is_hex_digit(0x46 as u32) = false
            return -7

        if syn.is_hex_digit(0x67 as u32)
            return -8

        ; namecase fold
        if syn.fold(0x61 as u32) <> (0x41 as u32)
            return -9

        if syn.fold(0x41 as u32) <> (0x41 as u32)
            return -10

        ; reference quantity NAMELEN = 8
        if syn.get_quantity(qNAMELEN) <> (8 as u32)
            return -11

        if syn.get_quantity(qTAGLVL) <> (24 as u32)
            return -12

        ; extend naming: '-' becomes a name char (not name-start), as in XML
        if syn.is_name_character(0x2D as u32)
            return -13

        syn.add_name_characters(0x2D as u32, 0x2D as u32)
        if syn.is_name_character(0x2D as u32) = false
            return -14

        if syn.is_name_start_character(0x2D as u32)
            return -15

        0
    }
}
