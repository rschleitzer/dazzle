use scaly.memory.Page
use scaly.containers.String
use scaly.containers.Array
use opensp.StringC.StringC
use scaly.memory.root_pages.getenv

; ParserOptions — ParserOptions.h/.cxx + the ParserApp::enableWarning table
; (ParserApp.cxx:154). The Warnings base (62 PackedBooleans, all zeroed by the
; Warnings ctor) plus the error_/override flags the -w axis can toggle. The
; feature/quantity knobs of the C++ struct (datatag/omittag/rank/shorttag/
; emptynrm/link*/concur/subdoc/formal/shortref/quantity[]/includes) keep their
; reference defaults hardwired at the implied-Sd construction in parse_to_esis
; (Parser.cxx:36-45) — no CLI option of the drop-in changes them.
;
; enable_warning ports the table verbatim: `no-` prefix clears instead of
; sets, the group names (all/min-tag/xml) fan out over the tagged entries and
; are checked FIRST, and the trailing special case `valid` sets type_valid.
; Unknown names return false — the driver renders unknownWarning (app-level,
; no location, does NOT affect the exit code).

define GROUP_ALL: int 1
define GROUP_MIN_TAG: int 2
define GROUP_XML: int 4

; ParserOptions.h:100 enum { sgmlDeclTypeValid = -1 } — the "leave it to the
; SGML declaration" sentinel for type_valid.
define OPT_SGML_DECL_TYPE_VALID: int 0 - 1

define ParserOptions
(
    var warn_sgml_decl: bool,
    var warn_duplicate_entity: bool,
    var warn_should: bool,
    var warn_undefined_element: bool,
    var warn_default_entity_reference: bool,
    var warn_mixed_content: bool,
    var warn_empty_tag: bool,
    var warn_unused_map: bool,
    var warn_unused_param: bool,
    var warn_notation_system_id: bool,
    var warn_inclusion: bool,
    var warn_exclusion: bool,
    var warn_rcdata_content: bool,
    var warn_cdata_content: bool,
    var warn_ps_comment: bool,
    var warn_element_group_decl: bool,
    var warn_attlist_group_decl: bool,
    var warn_pi_entity: bool,
    var warn_internal_sdata_entity: bool,
    var warn_internal_cdata_entity: bool,
    var warn_external_sdata_entity: bool,
    var warn_external_cdata_entity: bool,
    var warn_bracket_entity: bool,
    var warn_data_attributes: bool,
    var warn_missing_system_id: bool,
    var warn_conref: bool,
    var warn_current: bool,
    var warn_nutoken_declared_value: bool,
    var warn_number_declared_value: bool,
    var warn_name_declared_value: bool,
    var warn_named_char_ref: bool,
    var warn_refc: bool,
    var warn_temp_marked_section: bool,
    var warn_rcdata_marked_section: bool,
    var warn_instance_include_marked_section: bool,
    var warn_instance_ignore_marked_section: bool,
    var warn_and_group: bool,
    var warn_rank: bool,
    var warn_empty_comment_decl: bool,
    var warn_attribute_value_not_literal: bool,
    var warn_missing_attribute_name: bool,
    var warn_comment_decl_s: bool,
    var warn_comment_decl_multiple: bool,
    var warn_missing_status_keyword: bool,
    var warn_multiple_status_keyword: bool,
    var warn_instance_param_entity_ref: bool,
    var warn_minimization_param: bool,
    var warn_mixed_content_rep_or_group: bool,
    var warn_name_group_not_or: bool,
    var warn_pi_missing_name: bool,
    var warn_instance_status_keyword_spec_s: bool,
    var warn_external_data_entity_ref: bool,
    var warn_attribute_value_external_entity_ref: bool,
    var warn_data_delim: bool,
    var warn_explicit_sgml_decl: bool,
    var warn_internal_subset_marked_section: bool,
    var warn_default_entity_decl: bool,
    var warn_non_sgml_char_ref: bool,
    var warn_internal_subset_ps_param_entity_ref: bool,
    var warn_internal_subset_ts_param_entity_ref: bool,
    var warn_internal_subset_literal_param_entity_ref: bool,
    var warn_immediate_recursion: bool,
    var type_valid: int,
    var error_idref: bool,
    var error_significant: bool,
    var error_afdr: bool,
    var no_unclosed_tag: bool,
    var no_net: bool,
    var fully_declared: bool,
    var fully_tagged: bool,
    var amply_tagged: bool,
    var amply_tagged_anyother: bool,
    var valid: bool,
    var entity_ref: bool,
    var external_entity_ref: bool,
    var integral: bool,
    ; ParserOptions::includes (-i): parameter-entity names defined as INCLUDE
    ; in every started DTD (null = none).
    var includes: ref[Array[StringC]]?,
    ; the content-model compile's scratch arena (ContentToken.compile) — on by
    ; default, `SP_CM_SCRATCH=0` restores the historical lifetime. Ours, not
    ; the reference's: its scratch is stack locals and freed Vectors.
    var cm_scratch: bool
)
{
    init()
    {
        cm_scratch := true
        warn_sgml_decl := false
        warn_duplicate_entity := false
        warn_should := false
        warn_undefined_element := false
        warn_default_entity_reference := false
        warn_mixed_content := false
        warn_empty_tag := false
        warn_unused_map := false
        warn_unused_param := false
        warn_notation_system_id := false
        warn_inclusion := false
        warn_exclusion := false
        warn_rcdata_content := false
        warn_cdata_content := false
        warn_ps_comment := false
        warn_element_group_decl := false
        warn_attlist_group_decl := false
        warn_pi_entity := false
        warn_internal_sdata_entity := false
        warn_internal_cdata_entity := false
        warn_external_sdata_entity := false
        warn_external_cdata_entity := false
        warn_bracket_entity := false
        warn_data_attributes := false
        warn_missing_system_id := false
        warn_conref := false
        warn_current := false
        warn_nutoken_declared_value := false
        warn_number_declared_value := false
        warn_name_declared_value := false
        warn_named_char_ref := false
        warn_refc := false
        warn_temp_marked_section := false
        warn_rcdata_marked_section := false
        warn_instance_include_marked_section := false
        warn_instance_ignore_marked_section := false
        warn_and_group := false
        warn_rank := false
        warn_empty_comment_decl := false
        warn_attribute_value_not_literal := false
        warn_missing_attribute_name := false
        warn_comment_decl_s := false
        warn_comment_decl_multiple := false
        warn_missing_status_keyword := false
        warn_multiple_status_keyword := false
        warn_instance_param_entity_ref := false
        warn_minimization_param := false
        warn_mixed_content_rep_or_group := false
        warn_name_group_not_or := false
        warn_pi_missing_name := false
        warn_instance_status_keyword_spec_s := false
        warn_external_data_entity_ref := false
        warn_attribute_value_external_entity_ref := false
        warn_data_delim := false
        warn_explicit_sgml_decl := false
        warn_internal_subset_marked_section := false
        warn_default_entity_decl := false
        warn_non_sgml_char_ref := false
        warn_internal_subset_ps_param_entity_ref := false
        warn_internal_subset_ts_param_entity_ref := false
        warn_internal_subset_literal_param_entity_ref := false
        warn_immediate_recursion := false
        type_valid := OPT_SGML_DECL_TYPE_VALID
        error_idref := true
        error_significant := true
        error_afdr := true
        no_unclosed_tag := false
        no_net := false
        fully_declared := false
        fully_tagged := false
        amply_tagged := false
        amply_tagged_anyother := false
        valid := false
        entity_ref := false
        external_entity_ref := false
        integral := false
        includes := null
    }

    function make(host: ref[Page]) returns ref[ParserOptions]
    {
        let o &ParserOptions^host()
        o
    }

    ; `SP_CM_SCRATCH=0` turns the content-model scratch arena off. Read here,
    ; by whoever makes the options for a run, and not in `init`: an
    ; initializer builds its object and has no other effect.
    procedure read_environment(mutable this: ref[ParserOptions])
    {
        let e getenv("SP_CM_SCRATCH")
        if e <> null
        {
            let zero "0" as char
            if (*e as u32) = (zero as u32)
                this.cm_scratch := false
        }
    }

    ; the group fan-outs (the `groups` column of the enableWarning table).
    procedure set_group_all(mutable this: ref[ParserOptions], val: bool)
    {
        this.warn_mixed_content := val
        this.warn_should := val
        this.warn_default_entity_reference := val
        this.warn_undefined_element := val
        this.warn_sgml_decl := val
        this.no_unclosed_tag := val
        this.warn_empty_tag := val
        this.warn_unused_map := val
        this.warn_unused_param := val
    }

    procedure set_group_min_tag(mutable this: ref[ParserOptions], val: bool)
    {
        this.no_unclosed_tag := val
        this.no_net := val
        this.warn_empty_tag := val
    }

    procedure set_group_xml(mutable this: ref[ParserOptions], val: bool)
    {
        this.warn_inclusion := val
        this.warn_exclusion := val
        this.warn_rcdata_content := val
        this.warn_cdata_content := val
        this.warn_ps_comment := val
        this.warn_attlist_group_decl := val
        this.warn_element_group_decl := val
        this.warn_pi_entity := val
        this.warn_internal_sdata_entity := val
        this.warn_internal_cdata_entity := val
        this.warn_external_sdata_entity := val
        this.warn_external_cdata_entity := val
        this.warn_bracket_entity := val
        this.warn_data_attributes := val
        this.warn_missing_system_id := val
        this.warn_conref := val
        this.warn_current := val
        this.warn_nutoken_declared_value := val
        this.warn_number_declared_value := val
        this.warn_name_declared_value := val
        this.warn_named_char_ref := val
        this.warn_refc := val
        this.warn_temp_marked_section := val
        this.warn_rcdata_marked_section := val
        this.warn_instance_include_marked_section := val
        this.warn_instance_ignore_marked_section := val
        this.warn_and_group := val
        this.warn_rank := val
        this.warn_empty_comment_decl := val
        this.warn_attribute_value_not_literal := val
        this.warn_missing_attribute_name := val
        this.warn_comment_decl_s := val
        this.warn_comment_decl_multiple := val
        this.warn_missing_status_keyword := val
        this.warn_multiple_status_keyword := val
        this.warn_instance_param_entity_ref := val
        this.warn_minimization_param := val
        this.warn_mixed_content_rep_or_group := val
        this.warn_name_group_not_or := val
        this.warn_pi_missing_name := val
        this.warn_instance_status_keyword_spec_s := val
        this.warn_external_data_entity_ref := val
        this.warn_attribute_value_external_entity_ref := val
        this.warn_data_delim := val
        this.warn_explicit_sgml_decl := val
        this.warn_internal_subset_marked_section := val
        this.warn_default_entity_decl := val
        this.warn_non_sgml_char_ref := val
        this.warn_internal_subset_ps_param_entity_ref := val
        this.warn_internal_subset_ts_param_entity_ref := val
        this.warn_internal_subset_literal_param_entity_ref := val
    }

    ; ParserApp::enableWarning — returns false when the name is unknown (the
    ; caller reports unknownWarning). `s` is the 8-bit argument after `-w`.
    procedure enable_warning(mutable this: ref[ParserOptions], arg: String) returns bool
    {
        var s arg
        var val true
        if arg.get_length() >= 3
        {
            if (arg.get(0) = 0x6E) and (arg.get(1) = 0x6F) and (arg.get(2) = 0x2D)
            {
                ; strip the `no-` prefix; the remainder toggles OFF.
                var rest String((arg.to_c_string() + 3) as pointer[const_char])
                s := rest
                val := false
            }
        }
        ; groups first (the reference scans groupTable before table).
        if s.equals("all")
        {
            this.set_group_all(val)
            return true
        }
        if s.equals("min-tag")
        {
            this.set_group_min_tag(val)
            return true
        }
        if s.equals("xml")
        {
            this.set_group_xml(val)
            return true
        }
        if s.equals("mixed")
        {
            this.warn_mixed_content := val
            return true
        }
        if s.equals("should")
        {
            this.warn_should := val
            return true
        }
        if s.equals("duplicate")
        {
            this.warn_duplicate_entity := val
            return true
        }
        if s.equals("default")
        {
            this.warn_default_entity_reference := val
            return true
        }
        if s.equals("undefined")
        {
            this.warn_undefined_element := val
            return true
        }
        if s.equals("sgmldecl")
        {
            this.warn_sgml_decl := val
            return true
        }
        if s.equals("unclosed")
        {
            this.no_unclosed_tag := val
            return true
        }
        if s.equals("net")
        {
            this.no_net := val
            return true
        }
        if s.equals("empty")
        {
            this.warn_empty_tag := val
            return true
        }
        if s.equals("unused-map")
        {
            this.warn_unused_map := val
            return true
        }
        if s.equals("unused-param")
        {
            this.warn_unused_param := val
            return true
        }
        if s.equals("notation-sysid")
        {
            this.warn_notation_system_id := val
            return true
        }
        if s.equals("inclusion")
        {
            this.warn_inclusion := val
            return true
        }
        if s.equals("exclusion")
        {
            this.warn_exclusion := val
            return true
        }
        if s.equals("rcdata-content")
        {
            this.warn_rcdata_content := val
            return true
        }
        if s.equals("cdata-content")
        {
            this.warn_cdata_content := val
            return true
        }
        if s.equals("ps-comment")
        {
            this.warn_ps_comment := val
            return true
        }
        if s.equals("attlist-group-decl")
        {
            this.warn_attlist_group_decl := val
            return true
        }
        if s.equals("element-group-decl")
        {
            this.warn_element_group_decl := val
            return true
        }
        if s.equals("pi-entity")
        {
            this.warn_pi_entity := val
            return true
        }
        if s.equals("internal-sdata-entity")
        {
            this.warn_internal_sdata_entity := val
            return true
        }
        if s.equals("internal-cdata-entity")
        {
            this.warn_internal_cdata_entity := val
            return true
        }
        if s.equals("external-sdata-entity")
        {
            this.warn_external_sdata_entity := val
            return true
        }
        if s.equals("external-cdata-entity")
        {
            this.warn_external_cdata_entity := val
            return true
        }
        if s.equals("bracket-entity")
        {
            this.warn_bracket_entity := val
            return true
        }
        if s.equals("data-atts")
        {
            this.warn_data_attributes := val
            return true
        }
        if s.equals("missing-system-id")
        {
            this.warn_missing_system_id := val
            return true
        }
        if s.equals("conref")
        {
            this.warn_conref := val
            return true
        }
        if s.equals("current")
        {
            this.warn_current := val
            return true
        }
        if s.equals("nutoken-decl-value")
        {
            this.warn_nutoken_declared_value := val
            return true
        }
        if s.equals("number-decl-value")
        {
            this.warn_number_declared_value := val
            return true
        }
        if s.equals("name-decl-value")
        {
            this.warn_name_declared_value := val
            return true
        }
        if s.equals("named-char-ref")
        {
            this.warn_named_char_ref := val
            return true
        }
        if s.equals("refc")
        {
            this.warn_refc := val
            return true
        }
        if s.equals("temp-ms")
        {
            this.warn_temp_marked_section := val
            return true
        }
        if s.equals("rcdata-ms")
        {
            this.warn_rcdata_marked_section := val
            return true
        }
        if s.equals("instance-include-ms")
        {
            this.warn_instance_include_marked_section := val
            return true
        }
        if s.equals("instance-ignore-ms")
        {
            this.warn_instance_ignore_marked_section := val
            return true
        }
        if s.equals("and-group")
        {
            this.warn_and_group := val
            return true
        }
        if s.equals("rank")
        {
            this.warn_rank := val
            return true
        }
        if s.equals("empty-comment-decl")
        {
            this.warn_empty_comment_decl := val
            return true
        }
        if s.equals("att-value-not-literal")
        {
            this.warn_attribute_value_not_literal := val
            return true
        }
        if s.equals("missing-att-name")
        {
            this.warn_missing_attribute_name := val
            return true
        }
        if s.equals("comment-decl-s")
        {
            this.warn_comment_decl_s := val
            return true
        }
        if s.equals("comment-decl-multiple")
        {
            this.warn_comment_decl_multiple := val
            return true
        }
        if s.equals("missing-status-keyword")
        {
            this.warn_missing_status_keyword := val
            return true
        }
        if s.equals("multiple-status-keyword")
        {
            this.warn_multiple_status_keyword := val
            return true
        }
        if s.equals("instance-param-entity")
        {
            this.warn_instance_param_entity_ref := val
            return true
        }
        if s.equals("min-param")
        {
            this.warn_minimization_param := val
            return true
        }
        if s.equals("mixed-content-xml")
        {
            this.warn_mixed_content_rep_or_group := val
            return true
        }
        if s.equals("name-group-not-or")
        {
            this.warn_name_group_not_or := val
            return true
        }
        if s.equals("pi-missing-name")
        {
            this.warn_pi_missing_name := val
            return true
        }
        if s.equals("instance-status-keyword-s")
        {
            this.warn_instance_status_keyword_spec_s := val
            return true
        }
        if s.equals("external-data-entity-ref")
        {
            this.warn_external_data_entity_ref := val
            return true
        }
        if s.equals("att-value-external-entity-ref")
        {
            this.warn_attribute_value_external_entity_ref := val
            return true
        }
        if s.equals("data-delim")
        {
            this.warn_data_delim := val
            return true
        }
        if s.equals("explicit-sgml-decl")
        {
            this.warn_explicit_sgml_decl := val
            return true
        }
        if s.equals("internal-subset-ms")
        {
            this.warn_internal_subset_marked_section := val
            return true
        }
        if s.equals("default-entity")
        {
            this.warn_default_entity_decl := val
            return true
        }
        if s.equals("non-sgml-char-ref")
        {
            this.warn_non_sgml_char_ref := val
            return true
        }
        if s.equals("internal-subset-ps-param-entity")
        {
            this.warn_internal_subset_ps_param_entity_ref := val
            return true
        }
        if s.equals("internal-subset-ts-param-entity")
        {
            this.warn_internal_subset_ts_param_entity_ref := val
            return true
        }
        if s.equals("internal-subset-literal-param-entity")
        {
            this.warn_internal_subset_literal_param_entity_ref := val
            return true
        }
        if s.equals("immediate-recursion")
        {
            this.warn_immediate_recursion := val
            return true
        }
        if s.equals("fully-declared")
        {
            this.fully_declared := val
            return true
        }
        if s.equals("fully-tagged")
        {
            this.fully_tagged := val
            return true
        }
        if s.equals("amply-tagged-recursive")
        {
            this.amply_tagged := val
            return true
        }
        if s.equals("amply-tagged")
        {
            this.amply_tagged_anyother := val
            return true
        }
        if s.equals("type-valid")
        {
            this.valid := val
            return true
        }
        if s.equals("entity-ref")
        {
            this.entity_ref := val
            return true
        }
        if s.equals("external-entity-ref")
        {
            this.external_entity_ref := val
            return true
        }
        if s.equals("integral")
        {
            this.integral := val
            return true
        }
        if s.equals("idref")
        {
            this.error_idref := val
            return true
        }
        if s.equals("significant")
        {
            this.error_significant := val
            return true
        }
        if s.equals("afdr")
        {
            this.error_afdr := val
            return true
        }
        ; enableWarning's trailing special case.
        if s.equals("valid")
        {
            if val
                this.type_valid := 1
            else
                this.type_valid := 0
            return true
        }
        false
    }
}
