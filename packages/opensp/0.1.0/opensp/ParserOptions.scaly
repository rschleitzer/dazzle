use scaly.memory.Page
use scaly.containers.String
use scaly.containers.Array
use opensp.StringC.StringC
use scaly.memory.root_pages.getenv

; ParserOptions — ParserOptions.h/.cxx + the ParserApp::enableWarning table
; (ParserApp.cxx:154). The Warnings base (62 PackedBooleans, all zeroed by the
; Warnings ctor) plus the error_/override flags the -w axis can toggle. The
; feature/quantity knobs of the C++ struct (datatag/omittag/rank/shorttag/
; emptynrm/link*/concur/subdoc/formal/shortref/quantity[]/includes) keep their
; reference defaults hardwired at the implied-Sd construction in parse_to_esis
; (Parser.cxx:36-45) — no CLI option of the drop-in changes them.
;
; enable_warning ports the table verbatim: `no-` prefix clears instead of
; sets, the group names (all/min-tag/xml) fan out over the tagged entries and
; are checked FIRST, and the trailing special case `valid` sets type_valid.
; Unknown names return false — the driver renders unknownWarning (app-level,
; no location, does NOT affect the exit code).

define GROUP_ALL: int 1
define GROUP_MIN_TAG: int 2
define GROUP_XML: int 4

; ParserOptions.h:100 enum { sgmlDeclTypeValid = -1 } — the "leave it to the
; SGML declaration" sentinel for type_valid.
define OPT_SGML_DECL_TYPE_VALID: int 0 - 1

define ParserOptions
(
    warn_sgml_decl: bool,
    warn_duplicate_entity: bool,
    warn_should: bool,
    warn_undefined_element: bool,
    warn_default_entity_reference: bool,
    warn_mixed_content: bool,
    warn_empty_tag: bool,
    warn_unused_map: bool,
    warn_unused_param: bool,
    warn_notation_system_id: bool,
    warn_inclusion: bool,
    warn_exclusion: bool,
    warn_rcdata_content: bool,
    warn_cdata_content: bool,
    warn_ps_comment: bool,
    warn_element_group_decl: bool,
    warn_attlist_group_decl: bool,
    warn_pi_entity: bool,
    warn_internal_sdata_entity: bool,
    warn_internal_cdata_entity: bool,
    warn_external_sdata_entity: bool,
    warn_external_cdata_entity: bool,
    warn_bracket_entity: bool,
    warn_data_attributes: bool,
    warn_missing_system_id: bool,
    warn_conref: bool,
    warn_current: bool,
    warn_nutoken_declared_value: bool,
    warn_number_declared_value: bool,
    warn_name_declared_value: bool,
    warn_named_char_ref: bool,
    warn_refc: bool,
    warn_temp_marked_section: bool,
    warn_rcdata_marked_section: bool,
    warn_instance_include_marked_section: bool,
    warn_instance_ignore_marked_section: bool,
    warn_and_group: bool,
    warn_rank: bool,
    warn_empty_comment_decl: bool,
    warn_attribute_value_not_literal: bool,
    warn_missing_attribute_name: bool,
    warn_comment_decl_s: bool,
    warn_comment_decl_multiple: bool,
    warn_missing_status_keyword: bool,
    warn_multiple_status_keyword: bool,
    warn_instance_param_entity_ref: bool,
    warn_minimization_param: bool,
    warn_mixed_content_rep_or_group: bool,
    warn_name_group_not_or: bool,
    warn_pi_missing_name: bool,
    warn_instance_status_keyword_spec_s: bool,
    warn_external_data_entity_ref: bool,
    warn_attribute_value_external_entity_ref: bool,
    warn_data_delim: bool,
    warn_explicit_sgml_decl: bool,
    warn_internal_subset_marked_section: bool,
    warn_default_entity_decl: bool,
    warn_non_sgml_char_ref: bool,
    warn_internal_subset_ps_param_entity_ref: bool,
    warn_internal_subset_ts_param_entity_ref: bool,
    warn_internal_subset_literal_param_entity_ref: bool,
    warn_immediate_recursion: bool,
    type_valid: int,
    error_idref: bool,
    error_significant: bool,
    error_afdr: bool,
    no_unclosed_tag: bool,
    no_net: bool,
    fully_declared: bool,
    fully_tagged: bool,
    amply_tagged: bool,
    amply_tagged_anyother: bool,
    valid: bool,
    entity_ref: bool,
    external_entity_ref: bool,
    integral: bool,
    ; ParserOptions::includes (-i): parameter-entity names defined as INCLUDE
    ; in every started DTD (null = none).
    includes: ref[Array[StringC]]?,
    ; the content-model compile's scratch arena (ContentToken.compile) — on by
    ; default, `SP_CM_SCRATCH=0` restores the historical lifetime. Ours, not
    ; the reference's: its scratch is stack locals and freed Vectors.
    cm_scratch: bool
)
{
    init()
    {
        set cm_scratch: true
        set warn_sgml_decl: false
        set warn_duplicate_entity: false
        set warn_should: false
        set warn_undefined_element: false
        set warn_default_entity_reference: false
        set warn_mixed_content: false
        set warn_empty_tag: false
        set warn_unused_map: false
        set warn_unused_param: false
        set warn_notation_system_id: false
        set warn_inclusion: false
        set warn_exclusion: false
        set warn_rcdata_content: false
        set warn_cdata_content: false
        set warn_ps_comment: false
        set warn_element_group_decl: false
        set warn_attlist_group_decl: false
        set warn_pi_entity: false
        set warn_internal_sdata_entity: false
        set warn_internal_cdata_entity: false
        set warn_external_sdata_entity: false
        set warn_external_cdata_entity: false
        set warn_bracket_entity: false
        set warn_data_attributes: false
        set warn_missing_system_id: false
        set warn_conref: false
        set warn_current: false
        set warn_nutoken_declared_value: false
        set warn_number_declared_value: false
        set warn_name_declared_value: false
        set warn_named_char_ref: false
        set warn_refc: false
        set warn_temp_marked_section: false
        set warn_rcdata_marked_section: false
        set warn_instance_include_marked_section: false
        set warn_instance_ignore_marked_section: false
        set warn_and_group: false
        set warn_rank: false
        set warn_empty_comment_decl: false
        set warn_attribute_value_not_literal: false
        set warn_missing_attribute_name: false
        set warn_comment_decl_s: false
        set warn_comment_decl_multiple: false
        set warn_missing_status_keyword: false
        set warn_multiple_status_keyword: false
        set warn_instance_param_entity_ref: false
        set warn_minimization_param: false
        set warn_mixed_content_rep_or_group: false
        set warn_name_group_not_or: false
        set warn_pi_missing_name: false
        set warn_instance_status_keyword_spec_s: false
        set warn_external_data_entity_ref: false
        set warn_attribute_value_external_entity_ref: false
        set warn_data_delim: false
        set warn_explicit_sgml_decl: false
        set warn_internal_subset_marked_section: false
        set warn_default_entity_decl: false
        set warn_non_sgml_char_ref: false
        set warn_internal_subset_ps_param_entity_ref: false
        set warn_internal_subset_ts_param_entity_ref: false
        set warn_internal_subset_literal_param_entity_ref: false
        set warn_immediate_recursion: false
        set type_valid: OPT_SGML_DECL_TYPE_VALID
        set error_idref: true
        set error_significant: true
        set error_afdr: true
        set no_unclosed_tag: false
        set no_net: false
        set fully_declared: false
        set fully_tagged: false
        set amply_tagged: false
        set amply_tagged_anyother: false
        set valid: false
        set entity_ref: false
        set external_entity_ref: false
        set integral: false
        set includes: null
    }

    function make(host: ref[Page]) returns ref[ParserOptions]
    {
        let o &ParserOptions^host()
        o
    }

    ; `SP_CM_SCRATCH=0` turns the content-model scratch arena off. Read here,
    ; by whoever makes the options for a run, and not in `init`: an
    ; initializer builds its object and has no other effect.
    procedure read_environment(mutable this: ref[ParserOptions])
    {
        let e getenv("SP_CM_SCRATCH")
        if e <> null
        {
            let zero "0" as char
            if (*e as u32) = (zero as u32)
                set this.cm_scratch: false
        }
    }

    ; the group fan-outs (the `groups` column of the enableWarning table).
    procedure set_group_all(mutable this: ref[ParserOptions], val: bool)
    {
        set this.warn_mixed_content: val
        set this.warn_should: val
        set this.warn_default_entity_reference: val
        set this.warn_undefined_element: val
        set this.warn_sgml_decl: val
        set this.no_unclosed_tag: val
        set this.warn_empty_tag: val
        set this.warn_unused_map: val
        set this.warn_unused_param: val
    }

    procedure set_group_min_tag(mutable this: ref[ParserOptions], val: bool)
    {
        set this.no_unclosed_tag: val
        set this.no_net: val
        set this.warn_empty_tag: val
    }

    procedure set_group_xml(mutable this: ref[ParserOptions], val: bool)
    {
        set this.warn_inclusion: val
        set this.warn_exclusion: val
        set this.warn_rcdata_content: val
        set this.warn_cdata_content: val
        set this.warn_ps_comment: val
        set this.warn_attlist_group_decl: val
        set this.warn_element_group_decl: val
        set this.warn_pi_entity: val
        set this.warn_internal_sdata_entity: val
        set this.warn_internal_cdata_entity: val
        set this.warn_external_sdata_entity: val
        set this.warn_external_cdata_entity: val
        set this.warn_bracket_entity: val
        set this.warn_data_attributes: val
        set this.warn_missing_system_id: val
        set this.warn_conref: val
        set this.warn_current: val
        set this.warn_nutoken_declared_value: val
        set this.warn_number_declared_value: val
        set this.warn_name_declared_value: val
        set this.warn_named_char_ref: val
        set this.warn_refc: val
        set this.warn_temp_marked_section: val
        set this.warn_rcdata_marked_section: val
        set this.warn_instance_include_marked_section: val
        set this.warn_instance_ignore_marked_section: val
        set this.warn_and_group: val
        set this.warn_rank: val
        set this.warn_empty_comment_decl: val
        set this.warn_attribute_value_not_literal: val
        set this.warn_missing_attribute_name: val
        set this.warn_comment_decl_s: val
        set this.warn_comment_decl_multiple: val
        set this.warn_missing_status_keyword: val
        set this.warn_multiple_status_keyword: val
        set this.warn_instance_param_entity_ref: val
        set this.warn_minimization_param: val
        set this.warn_mixed_content_rep_or_group: val
        set this.warn_name_group_not_or: val
        set this.warn_pi_missing_name: val
        set this.warn_instance_status_keyword_spec_s: val
        set this.warn_external_data_entity_ref: val
        set this.warn_attribute_value_external_entity_ref: val
        set this.warn_data_delim: val
        set this.warn_explicit_sgml_decl: val
        set this.warn_internal_subset_marked_section: val
        set this.warn_default_entity_decl: val
        set this.warn_non_sgml_char_ref: val
        set this.warn_internal_subset_ps_param_entity_ref: val
        set this.warn_internal_subset_ts_param_entity_ref: val
        set this.warn_internal_subset_literal_param_entity_ref: val
    }

    ; ParserApp::enableWarning — returns false when the name is unknown (the
    ; caller reports unknownWarning). `s` is the 8-bit argument after `-w`.
    procedure enable_warning(mutable this: ref[ParserOptions], arg: String) returns bool
    {
        var s arg
        var val true
        if arg.get_length() >= 3
        {
            if (arg.get(0) = 0x6E) and (arg.get(1) = 0x6F) and (arg.get(2) = 0x2D)
            {
                ; strip the `no-` prefix; the remainder toggles OFF.
                var rest String((arg.to_c_string() + 3) as pointer[const_char])
                set s: rest
                set val: false
            }
        }
        ; groups first (the reference scans groupTable before table).
        if s.equals("all")
        {
            this.set_group_all(val)
            return true
        }
        if s.equals("min-tag")
        {
            this.set_group_min_tag(val)
            return true
        }
        if s.equals("xml")
        {
            this.set_group_xml(val)
            return true
        }
        if s.equals("mixed")
        {
            set this.warn_mixed_content: val
            return true
        }
        if s.equals("should")
        {
            set this.warn_should: val
            return true
        }
        if s.equals("duplicate")
        {
            set this.warn_duplicate_entity: val
            return true
        }
        if s.equals("default")
        {
            set this.warn_default_entity_reference: val
            return true
        }
        if s.equals("undefined")
        {
            set this.warn_undefined_element: val
            return true
        }
        if s.equals("sgmldecl")
        {
            set this.warn_sgml_decl: val
            return true
        }
        if s.equals("unclosed")
        {
            set this.no_unclosed_tag: val
            return true
        }
        if s.equals("net")
        {
            set this.no_net: val
            return true
        }
        if s.equals("empty")
        {
            set this.warn_empty_tag: val
            return true
        }
        if s.equals("unused-map")
        {
            set this.warn_unused_map: val
            return true
        }
        if s.equals("unused-param")
        {
            set this.warn_unused_param: val
            return true
        }
        if s.equals("notation-sysid")
        {
            set this.warn_notation_system_id: val
            return true
        }
        if s.equals("inclusion")
        {
            set this.warn_inclusion: val
            return true
        }
        if s.equals("exclusion")
        {
            set this.warn_exclusion: val
            return true
        }
        if s.equals("rcdata-content")
        {
            set this.warn_rcdata_content: val
            return true
        }
        if s.equals("cdata-content")
        {
            set this.warn_cdata_content: val
            return true
        }
        if s.equals("ps-comment")
        {
            set this.warn_ps_comment: val
            return true
        }
        if s.equals("attlist-group-decl")
        {
            set this.warn_attlist_group_decl: val
            return true
        }
        if s.equals("element-group-decl")
        {
            set this.warn_element_group_decl: val
            return true
        }
        if s.equals("pi-entity")
        {
            set this.warn_pi_entity: val
            return true
        }
        if s.equals("internal-sdata-entity")
        {
            set this.warn_internal_sdata_entity: val
            return true
        }
        if s.equals("internal-cdata-entity")
        {
            set this.warn_internal_cdata_entity: val
            return true
        }
        if s.equals("external-sdata-entity")
        {
            set this.warn_external_sdata_entity: val
            return true
        }
        if s.equals("external-cdata-entity")
        {
            set this.warn_external_cdata_entity: val
            return true
        }
        if s.equals("bracket-entity")
        {
            set this.warn_bracket_entity: val
            return true
        }
        if s.equals("data-atts")
        {
            set this.warn_data_attributes: val
            return true
        }
        if s.equals("missing-system-id")
        {
            set this.warn_missing_system_id: val
            return true
        }
        if s.equals("conref")
        {
            set this.warn_conref: val
            return true
        }
        if s.equals("current")
        {
            set this.warn_current: val
            return true
        }
        if s.equals("nutoken-decl-value")
        {
            set this.warn_nutoken_declared_value: val
            return true
        }
        if s.equals("number-decl-value")
        {
            set this.warn_number_declared_value: val
            return true
        }
        if s.equals("name-decl-value")
        {
            set this.warn_name_declared_value: val
            return true
        }
        if s.equals("named-char-ref")
        {
            set this.warn_named_char_ref: val
            return true
        }
        if s.equals("refc")
        {
            set this.warn_refc: val
            return true
        }
        if s.equals("temp-ms")
        {
            set this.warn_temp_marked_section: val
            return true
        }
        if s.equals("rcdata-ms")
        {
            set this.warn_rcdata_marked_section: val
            return true
        }
        if s.equals("instance-include-ms")
        {
            set this.warn_instance_include_marked_section: val
            return true
        }
        if s.equals("instance-ignore-ms")
        {
            set this.warn_instance_ignore_marked_section: val
            return true
        }
        if s.equals("and-group")
        {
            set this.warn_and_group: val
            return true
        }
        if s.equals("rank")
        {
            set this.warn_rank: val
            return true
        }
        if s.equals("empty-comment-decl")
        {
            set this.warn_empty_comment_decl: val
            return true
        }
        if s.equals("att-value-not-literal")
        {
            set this.warn_attribute_value_not_literal: val
            return true
        }
        if s.equals("missing-att-name")
        {
            set this.warn_missing_attribute_name: val
            return true
        }
        if s.equals("comment-decl-s")
        {
            set this.warn_comment_decl_s: val
            return true
        }
        if s.equals("comment-decl-multiple")
        {
            set this.warn_comment_decl_multiple: val
            return true
        }
        if s.equals("missing-status-keyword")
        {
            set this.warn_missing_status_keyword: val
            return true
        }
        if s.equals("multiple-status-keyword")
        {
            set this.warn_multiple_status_keyword: val
            return true
        }
        if s.equals("instance-param-entity")
        {
            set this.warn_instance_param_entity_ref: val
            return true
        }
        if s.equals("min-param")
        {
            set this.warn_minimization_param: val
            return true
        }
        if s.equals("mixed-content-xml")
        {
            set this.warn_mixed_content_rep_or_group: val
            return true
        }
        if s.equals("name-group-not-or")
        {
            set this.warn_name_group_not_or: val
            return true
        }
        if s.equals("pi-missing-name")
        {
            set this.warn_pi_missing_name: val
            return true
        }
        if s.equals("instance-status-keyword-s")
        {
            set this.warn_instance_status_keyword_spec_s: val
            return true
        }
        if s.equals("external-data-entity-ref")
        {
            set this.warn_external_data_entity_ref: val
            return true
        }
        if s.equals("att-value-external-entity-ref")
        {
            set this.warn_attribute_value_external_entity_ref: val
            return true
        }
        if s.equals("data-delim")
        {
            set this.warn_data_delim: val
            return true
        }
        if s.equals("explicit-sgml-decl")
        {
            set this.warn_explicit_sgml_decl: val
            return true
        }
        if s.equals("internal-subset-ms")
        {
            set this.warn_internal_subset_marked_section: val
            return true
        }
        if s.equals("default-entity")
        {
            set this.warn_default_entity_decl: val
            return true
        }
        if s.equals("non-sgml-char-ref")
        {
            set this.warn_non_sgml_char_ref: val
            return true
        }
        if s.equals("internal-subset-ps-param-entity")
        {
            set this.warn_internal_subset_ps_param_entity_ref: val
            return true
        }
        if s.equals("internal-subset-ts-param-entity")
        {
            set this.warn_internal_subset_ts_param_entity_ref: val
            return true
        }
        if s.equals("internal-subset-literal-param-entity")
        {
            set this.warn_internal_subset_literal_param_entity_ref: val
            return true
        }
        if s.equals("immediate-recursion")
        {
            set this.warn_immediate_recursion: val
            return true
        }
        if s.equals("fully-declared")
        {
            set this.fully_declared: val
            return true
        }
        if s.equals("fully-tagged")
        {
            set this.fully_tagged: val
            return true
        }
        if s.equals("amply-tagged-recursive")
        {
            set this.amply_tagged: val
            return true
        }
        if s.equals("amply-tagged")
        {
            set this.amply_tagged_anyother: val
            return true
        }
        if s.equals("type-valid")
        {
            set this.valid: val
            return true
        }
        if s.equals("entity-ref")
        {
            set this.entity_ref: val
            return true
        }
        if s.equals("external-entity-ref")
        {
            set this.external_entity_ref: val
            return true
        }
        if s.equals("integral")
        {
            set this.integral: val
            return true
        }
        if s.equals("idref")
        {
            set this.error_idref: val
            return true
        }
        if s.equals("significant")
        {
            set this.error_significant: val
            return true
        }
        if s.equals("afdr")
        {
            set this.error_afdr: val
            return true
        }
        ; enableWarning's trailing special case.
        if s.equals("valid")
        {
            if val
                set this.type_valid: 1
            else
                set this.type_valid: 0
            return true
        }
        false
    }
}
