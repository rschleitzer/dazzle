use scaly.memory.Page
use opensp.StringC.StringC
use opensp.Storage.Storage
use opensp.CodingSystem.CodingSystem
use opensp.CodingSystem.IENC_UTF8
use opensp.Location.InputSource
use opensp.Location.Origin

; EntityManager — the catalog/storage/decoder → InputSource glue
; (EntityManager.cs / ExtendEntityManager.cs).
;
; Stage-2 scope: open() resolves a (already catalog-resolved) system id through
; a Storage, decodes the bytes with a CodingSystem, and returns an in-memory
; InputSource carrying the given origin. The full ExternalInputSource with lazy
; per-spec storage objects, record normalization and ParsedSystemId FSI parsing
; is deferred; here it is whole-buffer decode. The decoded Char buffer is
; region-allocated on the byte buffer's own page (one region per run).

; the entity-manager configuration the driver collects (EntityApp's option
; surface): the -c/-m catalog system ids (the first n_must_exist are the
; command-line ones a missing file REPORTS on; the rest come from
; SGML_CATALOG_FILES and skip silently), the -D/-SGML_SEARCH_PATH search
; directories (PosixStorageManager::addSearchDir), -R restricted reading,
; -C catalog-document mapping, and the SP_USE_DOCUMENT_CATALOG gate for the
; document's implicit `catalog` file.
;
; CmdLineApp::codingSystem() as a process cell — see EmConfig.init.
shared APP_INPUT_CS: ref[CodingSystem]? null

define EmConfig (catalog_sysids: ref[Array[String]]?, n_must_exist: size_t, search_dirs: ref[Array[String]]?, use_doc_catalog: bool, restrict_reading: bool, map_catalog_document: bool, input_cs: CodingSystem)
{
    init()
    {
        set this.catalog_sysids: null
        set this.search_dirs: null
        set this.n_must_exist: 0
        set this.use_doc_catalog: true
        set this.restrict_reading: false
        set this.map_catalog_document: false
        ; codingSystem(): the APP's coding system if a driver installed one
        ; (see APP_INPUT_CS), else the reference's own default — identity, via
        ; SP_DEFAULT_ENCODING = IS8859-1 on this port's ISO 10646 charset.
        ; ★The cell exists because the reference has ONE coding system per RUN
        ; and reaches it through the app pointer: the document, its DTD and
        ; entities, the catalogs, the DSSSL spec AND every grove sgml-parse
        ; loads are decoded with it. The library entry points that build their
        ; own EmConfig (Parser.parse_simple*, the stylesheet loader,
        ; GroveManager.load) have no app pointer to ask, and reading the
        ; stylesheet with a different decoder than the document is observable:
        ; under SP_ENCODING=EUC-JP the reference's stylesheet loses its `\`
        ; (JIS-Roman maps 0x5C to YEN SIGN), so a string escape stops working.
        let app APP_INPUT_CS
        if app <> null
        {
            (*app).store(&this.input_cs)
            return
        }
        let id CodingSystem.identity()
        id.store(&this.input_cs)
    }

    ; codingSystem() — the coding system ExtendEntityManager::make is handed,
    ; i.e. the one every document/DTD/entity/catalog file is DECODED with. The
    ; app derives it from the environment (CmdLineApp::initCodingSystem), which
    ; is where the reference's identity default lives; what is left on THIS
    ; default is the deviation documented in `init` above.
    function get_input_cs(this: EmConfig) returns CodingSystem
        input_cs

    procedure set_input_cs(this: ref[EmConfig], cs: CodingSystem)
        cs.store(&this.input_cs)

    ; the driver installs the run's coding system here, once, while single
    ; threaded — the same doctrine as ParserState's STDERR_ENC and
    ; CodingSystemKit's OUTPUT_ENC cells (`shared`, never `mutable`).
    procedure install_app_input_cs(host: ref[Page], cs: CodingSystem)
    {
        let p &CodingSystem^host()
        cs.store(p)
        set APP_INPUT_CS: p
    }
}

define EntityManager ()
{
    function open(this: EntityManager, sysid: String, storage: Storage, cs: CodingSystem, origin: ref[Origin]) returns InputSource
    {
        let bytes storage.read(sysid)
        let n bytes.get_length()
        if n = 0
            return InputSource(origin)

        ; The decoded Char buffer must live on the CALLER's region page (_rp)
        ; so it outlives the returned InputSource. Do NOT use Page.get(bbuf):
        ; for Literal storage the bytes are a String LITERAL whose buffer is a
        ; global constant (rodata), not page-hosted, so Page.get masks a bogus
        ; header and allocate SIGSEGVs. Anchor a StringC on the caller page
        ; (`#`) and take ITS page — the run region where this source lives.
        let bbuf bytes.get_buffer()
        let anchor StringC#("x")
        let page Page.get(anchor.data_ptr())
        let cbuf page.allocate(n * 4, 4) as pointer[u32]
        let produced cs.decode(bbuf, n, cbuf)
        let view Slice[u32](produced, cbuf)
        InputSource(origin, view)
    }
}
