use scaly.memory.Page

; ExternalId — a PUBLIC and/or SYSTEM identifier (ExternalId.cs).
;
; Stage-2 scope: holds the public-id and system-id strings. Formal-public-id
; PARSING (PublicId's FPI/URN decomposition, TextClass, owner/description) is
; deferred — catalog lookup keys on the raw public-id string, which is all the
; corpus's PUBLIC "-//…//EN" ids need. The resolved ("effective") system id is
; returned by EntityCatalog.lookup rather than stored back here.
;
; Identifiers are byte `String`s, not StringC: public ids, system ids and file
; paths are ASCII/Latin-1 identifiers that live at the I/O boundary (the design
; note's byte<->Char rule puts them on the byte side). StringC (u32) is reserved
; for Char CONTENT — the entity text that becomes an InputSource.

define ExternalId
(
    has_public: bool
    public_id: String
    has_system: bool
    system_id: String
)
{
    init()
    {
        set has_public: false
        set public_id: String()
        set has_system: false
        set system_id: String()
    }

    init(has_public: bool, public_id: String, has_system: bool, system_id: String)
    {
        set this.has_public: has_public
        set this.public_id: public_id
        set this.has_system: has_system
        set this.system_id: system_id
    }

    ; Heap-allocate a copy on `host`, DEEP-COPYING both identifier strings onto it.
    ; An ExternalId parsed out of a declaration holds Strings built off the
    ; parser's transient literal buffer — storing it in an entity that is only
    ; referenced LATER (an external text entity) needs them pinned to the run page,
    ; exactly like InternalEntity.make pins the entity name and replacement text.
    ; (The DOCTYPE external subset consumes its ExternalId immediately and so never
    ; noticed; a DTD declaring several entities corrupted all but the last.)
    function make(host: pointer[Page], id: ExternalId) returns pointer[ExternalId]
    {
        let p host.allocate(sizeof ExternalId, alignof ExternalId) as pointer[ExternalId]
        set p.has_public: id.has_public_id()
        set p.public_id: String^host(id.get_public_id())
        set p.has_system: id.has_system_id()
        set p.system_id: String^host(id.get_system_id())
        p
    }

    function get_public_id(this: ExternalId) returns String
        public_id

    function get_system_id(this: ExternalId) returns String
        system_id

    function has_public_id(this: ExternalId) returns bool
        has_public

    function has_system_id(this: ExternalId) returns bool
        has_system

    function test() returns int
    {
        ; PUBLIC + SYSTEM fallback, the corpus's common shape.
        let id ExternalId(true, "-//Example//DTD Model v1//EN", true, "model.dtd")
        if id.has_public_id() = false
            return -1

        if id.has_system_id() = false
            return -2

        if (id.get_system_id() = "model.dtd") = false
            return -3

        ; SYSTEM only.
        let sysonly ExternalId(false, String(), true, "grammar.dtd")
        if sysonly.has_public_id()
            return -4

        if (sysonly.get_system_id() = "grammar.dtd") = false
            return -5

        0
    }
}
