use scaly.memory.Page

; ExternalId — a PUBLIC and/or SYSTEM identifier (ExternalId.cs), plus the
; PublicId FPI/URN classification (ExternalId.cxx:47-332).
;
; classify_public ports PublicId::init: the minimum literal is decomposed as a
; formal public identifier (initFpi) and as an RFC-2141 URN (initUrn); the type
; records which succeeded (informal when neither), the loser's error code feeds
; parseExternalId's FORMAL/URN reporting switch (parseDecl.cxx:1523). The
; decomposed FPI substrings (owner, description, language, display version,
; nid, nss) are validated but not stored — every reference getter for them is
; unused in the drop-in; the scalars (text class, owner type, unavailable,
; display-version presence) carry all consulted state.
;
; Identifiers are byte `String`s, not StringC: public ids, system ids and file
; paths are ASCII/Latin-1 identifiers that live at the I/O boundary (the design
; note's byte<->Char rule puts them on the byte side). StringC (u32) is reserved
; for Char CONTENT — the entity text that becomes an InputSource.

; PublicId::Type (ExternalId.h).
define PUBLIC_INFORMAL: int 0
define PUBLIC_FPI: int 1
define PUBLIC_URN: int 2

; PublicId::OwnerType.
define OWNER_ISO: int 0
define OWNER_REGISTERED: int 1
define OWNER_UNREGISTERED: int 2

; PublicId::TextClass — ordinals index the reference's textClasses table.
define TC_NONE: int 0 - 1
define TC_CAPACITY: int 0
define TC_CHARSET: int 1
define TC_DOCUMENT: int 2
define TC_DTD: int 3
define TC_ELEMENTS: int 4
define TC_ENTITIES: int 5
define TC_LPD: int 6
define TC_NONSGML: int 7
define TC_NOTATION: int 8
define TC_SD: int 9
define TC_SHORTREF: int 10
define TC_SUBDOC: int 11
define TC_SYNTAX: int 12
define TC_TEXT: int 13

; Classification error codes — Parser.fpi_message / urn_message map them to the
; ParserMessages entries the reference passes back via the MessageType1*&
; out-params of PublicId::init. 0 = the decomposition succeeded.
define FPI_ERR_MISSING_FIELD: int 1
define FPI_ERR_MISSING_TEXT_CLASS_SPACE: int 2
define FPI_ERR_INVALID_TEXT_CLASS: int 3
define FPI_ERR_INVALID_LANGUAGE: int 4
define FPI_ERR_ILLEGAL_DISPLAY_VERSION: int 5
define FPI_ERR_EXTRA_FIELD: int 6
define URN_ERR_MISSING_FIELD: int 1
define URN_ERR_MISSING_PREFIX: int 2
define URN_ERR_INVALID_NID: int 3
define URN_ERR_INVALID_NSS: int 4

define ExternalId
(
    has_public: bool
    public_id: String
    has_system: bool
    system_id: String
    ; ExternalId::effectiveSystemId_ — the FULL formal-system-identifier text
    ; generateSystemId stamps after the catalog consult (`<OSFILE>path` for a
    ; resolved entry or the declared system id against the declaring source's
    ; directory; `<CATALOG PUBLIC="pub"><OSFILE>cat` for a DELEGATE hit).
    ; The ESIS f-record prints it verbatim.
    has_effective: bool
    effective_system: String
    public_type: int
    text_class: int
    owner_type: int
    unavailable: bool
    have_display_version: bool
    fpi_error: int
    urn_error: int
    owner_start: size_t
    owner_len: size_t
    desc_start: size_t
    desc_len: size_t
    lang_start: size_t
    lang_len: size_t
)
{
    init()
    {
        set has_public: false
        set public_id: String()
        set has_system: false
        set system_id: String()
        set has_effective: false
        set effective_system: String()
        set public_type: PUBLIC_INFORMAL
        set text_class: TC_NONE
        set owner_type: OWNER_ISO
        set unavailable: false
        set have_display_version: false
        set fpi_error: 0
        set urn_error: 0
        set owner_start: 0
        set owner_len: 0
        set desc_start: 0
        set desc_len: 0
        set lang_start: 0
        set lang_len: 0
    }

    init(has_public: bool, public_id: String, has_system: bool, system_id: String)
    {
        set this.has_public: has_public
        set this.public_id: public_id
        set this.has_system: has_system
        set this.system_id: system_id
        set has_effective: false
        set effective_system: String()
        set public_type: PUBLIC_INFORMAL
        set text_class: TC_NONE
        set owner_type: OWNER_ISO
        set unavailable: false
        set have_display_version: false
        set fpi_error: 0
        set urn_error: 0
        set owner_start: 0
        set owner_len: 0
        set desc_start: 0
        set desc_len: 0
        set lang_start: 0
        set lang_len: 0
    }

    ; Heap-allocate a copy on `host`, DEEP-COPYING both identifier strings onto it.
    ; An ExternalId parsed out of a declaration holds Strings built off the
    ; parser's transient literal buffer — storing it in an entity that is only
    ; referenced LATER (an external text entity) needs them pinned to the run page,
    ; exactly like InternalEntity.make pins the entity name and replacement text.
    ; (The DOCTYPE external subset consumes its ExternalId immediately and so never
    ; noticed; a DTD declaring several entities corrupted all but the last.)
    function make(host: ref[Page], id: ExternalId) returns ref[ExternalId]
    {
        let p &ExternalId^host(id.has_public_id(), String^host(id.get_public_id()), id.has_system_id(), String^host(id.get_system_id()), id.has_effective_system(), String^host(id.get_effective_system()), id.get_public_type(), id.get_text_class(), id.get_owner_type(), id.get_unavailable(), id.get_have_display_version(), id.get_fpi_error(), id.get_urn_error(), id.owner_start, id.owner_len, id.desc_start, id.desc_len, id.lang_start, id.lang_len)
        p
    }

    function get_public_id(this: ExternalId) returns String
        public_id

    function get_system_id(this: ExternalId) returns String
        system_id

    function has_public_id(this: ExternalId) returns bool
        has_public

    function has_system_id(this: ExternalId) returns bool
        has_system

    ; ExternalId::setSystem — the system identifier arrives AFTER the public id
    ; has been classified; a setter keeps the classification intact.
    function set_system(this: ref[ExternalId], s: String)
    {
        set this.has_system: true
        set this.system_id: s
    }

    function get_effective_system(this: ExternalId) returns String
        effective_system

    function has_effective_system(this: ExternalId) returns bool
        has_effective

    ; ExternalId::setEffectiveSystem (generateSystemId's result).
    function set_effective_system(this: ref[ExternalId], s: String)
    {
        set this.has_effective: true
        set this.effective_system: s
    }

    ; a copy with the effective system id stamped — the Entity union rebuilds
    ; its variant around this (no in-place mutation of union payload fields).
    function with_effective(id: ExternalId, s: String) returns ExternalId
    {
        var c id
        set c.has_effective: true
        set c.effective_system: s
        c
    }

    function get_public_type(this: ExternalId) returns int
        public_type

    function get_text_class(this: ExternalId) returns int
        text_class

    function get_owner_type(this: ExternalId) returns int
        owner_type

    function get_unavailable(this: ExternalId) returns bool
        unavailable

    function get_have_display_version(this: ExternalId) returns bool
        have_display_version

    function get_fpi_error(this: ExternalId) returns int
        fpi_error

    function get_urn_error(this: ExternalId) returns int
        urn_error

    ; PublicId::getOwner/getDescription/getDesignatingSequence — byte offsets
    ; into the public id (valid only when the id classified as an FPI).
    function get_owner_bytes(this: ExternalId, out_start: ref[size_t], out_len: ref[size_t]) returns bool
    {
        if public_type <> PUBLIC_FPI
            return false
        set out_start: owner_start
        set out_len: owner_len
        true
    }

    function get_description_bytes(this: ExternalId, out_start: ref[size_t], out_len: ref[size_t]) returns bool
    {
        if public_type <> PUBLIC_FPI
            return false
        set out_start: desc_start
        set out_len: desc_len
        true
    }

    function get_designating_sequence_bytes(this: ExternalId, out_start: ref[size_t], out_len: ref[size_t]) returns bool
    {
        if public_type <> PUBLIC_FPI
            return false
        if text_class <> TC_CHARSET
            return false
        set out_start: lang_start
        set out_len: lang_len
        true
    }

    ; ---- PublicId classification (ExternalId.cxx:47-332) -------------------
    ; The reference works Char-wise through CharsetInfo::execToDesc/descToUniv;
    ; the port's internal charset is identity over ASCII and minimum literals
    ; are minimum data, so byte-wise comparison is equivalent.

    ; PublicId::init — run both decompositions; initFpi first, initUrn second
    ; (a string valid as both classifies as urn, like the reference).
    function classify_public(this: ref[ExternalId])
    {
        set this.public_type: PUBLIC_INFORMAL
        let fe this.classify_fpi()
        set this.fpi_error: fe
        if fe = 0
            set this.public_type: PUBLIC_FPI
        let ue this.classify_urn()
        set this.urn_error: ue
        if ue = 0
            set this.public_type: PUBLIC_URN
    }

    ; PublicId::nextField — fields are separated by TWO seps for an FPI
    ; ("//", dup true) and ONE (':', dup false) for a URN. *next / *has_next
    ; carry the scan state (the reference encodes exhaustion as next == 0);
    ; the field lands in *field_start / *field_len. Returns false when the
    ; previous field was the last one.
    function next_field(buf: pointer[u8], lim: size_t, sep: u8, dup: bool, next: ref[size_t], has_next: ref[bool], field_start: ref[size_t], field_len: ref[size_t]) returns bool
    {
        if has_next = false
            return false
        set field_start: next
        var i: size_t next
        while i < lim
        {
            var matched false
            if (*(buf + i)) = sep
            {
                if dup
                {
                    if (i + 1) < lim
                    {
                        if (*(buf + i + 1)) = sep
                            set matched: true
                    }
                }
                else
                    set matched: true
            }
            if matched
            {
                set field_len: i - field_start
                if dup
                    set next: i + 2
                else
                    set next: i + 1
                return true
            }
            set i: i + 1
        }
        set field_len: lim - field_start
        set has_next: false
        true
    }

    function is_alpha_byte(c: u8) returns bool
    {
        if (c >= 0x41) and (c <= 0x5A)
            return true
        (c >= 0x61) and (c <= 0x7A)
    }

    function is_digit_byte(c: u8) returns bool
        (c >= 0x30) and (c <= 0x39)

    function is_alnum_byte(c: u8) returns bool
    {
        if ExternalId.is_alpha_byte(c)
            return true
        ExternalId.is_digit_byte(c)
    }

    ; a-f / A-F / 0-9 (the URN NSS %-escape digits).
    function is_hex_byte(c: u8) returns bool
    {
        if (c >= 0x61) and (c <= 0x66)
            return true
        if (c >= 0x41) and (c <= 0x46)
            return true
        ExternalId.is_digit_byte(c)
    }

    ; the URN NSS "other" characters: ( ) + , - . : = @ ; $ _ ! * '
    function is_nss_other_byte(c: u8) returns bool
    {
        if (c = 0x28) or (c = 0x29) or (c = 0x2B) or (c = 0x2C)
            return true
        if (c = 0x2D) or (c = 0x2E) or (c = 0x3A) or (c = 0x3D)
            return true
        if (c = 0x40) or (c = 0x3B) or (c = 0x24) or (c = 0x5F)
            return true
        (c = 0x21) or (c = 0x2A) or (c = 0x27)
    }

    function field_word_eq(buf: pointer[u8], start: size_t, len: size_t, s: Slice[char]) returns bool
    {
        if s.length <> len
            return false
        var j: size_t 0
        while j < len
        {
            if (*(buf + start + j)) <> (s[j] as u8)
                return false
            set j: j + 1
        }
        true
    }

    ; PublicId::lookupTextClass over the textClasses table; TC_NONE = no match.
    function lookup_text_class(buf: pointer[u8], start: size_t, len: size_t) returns int
    {
        if ExternalId.field_word_eq(buf, start, len, "CAPACITY")
            return TC_CAPACITY
        if ExternalId.field_word_eq(buf, start, len, "CHARSET")
            return TC_CHARSET
        if ExternalId.field_word_eq(buf, start, len, "DOCUMENT")
            return TC_DOCUMENT
        if ExternalId.field_word_eq(buf, start, len, "DTD")
            return TC_DTD
        if ExternalId.field_word_eq(buf, start, len, "ELEMENTS")
            return TC_ELEMENTS
        if ExternalId.field_word_eq(buf, start, len, "ENTITIES")
            return TC_ENTITIES
        if ExternalId.field_word_eq(buf, start, len, "LPD")
            return TC_LPD
        if ExternalId.field_word_eq(buf, start, len, "NONSGML")
            return TC_NONSGML
        if ExternalId.field_word_eq(buf, start, len, "NOTATION")
            return TC_NOTATION
        if ExternalId.field_word_eq(buf, start, len, "SD")
            return TC_SD
        if ExternalId.field_word_eq(buf, start, len, "SHORTREF")
            return TC_SHORTREF
        if ExternalId.field_word_eq(buf, start, len, "SUBDOC")
            return TC_SUBDOC
        if ExternalId.field_word_eq(buf, start, len, "SYNTAX")
            return TC_SYNTAX
        if ExternalId.field_word_eq(buf, start, len, "TEXT")
            return TC_TEXT
        TC_NONE
    }

    ; PublicId::initFpi (ExternalId.cxx:185). Returns 0 or an FPI_ERR_* code;
    ; assigns the scalar fields as it goes, exactly like the reference (a later
    ; failure leaves the earlier assignments in place — type stays informal).
    function classify_fpi(this: ref[ExternalId]) returns int
    {
        let pid this.public_id
        let buf pid.get_buffer()
        let lim pid.get_length()
        let solidus: u8 0x2F
        let minus: u8 0x2D
        let plus: u8 0x2B
        var next: size_t 0
        var has_next true
        var fs: size_t 0
        var fl: size_t 0
        if ExternalId.next_field(buf, lim, solidus, true, &next, &has_next, &fs, &fl) = false
            return FPI_ERR_MISSING_FIELD
        var owner_is_indicator false
        if fl = 1
        {
            let c0 *(buf + fs)
            if (c0 = minus) or (c0 = plus)
            {
                set owner_is_indicator: true
                if c0 = plus
                    set this.owner_type: OWNER_REGISTERED
                else
                    set this.owner_type: OWNER_UNREGISTERED
            }
        }
        if owner_is_indicator
        {
            if ExternalId.next_field(buf, lim, solidus, true, &next, &has_next, &fs, &fl) = false
                return FPI_ERR_MISSING_FIELD
        }
        else
            set this.owner_type: OWNER_ISO
        ; the owner field (stored as offsets — PublicId::owner_).
        set this.owner_start: fs
        set this.owner_len: fl
        if ExternalId.next_field(buf, lim, solidus, true, &next, &has_next, &fs, &fl) = false
            return FPI_ERR_MISSING_FIELD
        ; text class = the part before the first SPACE of this field.
        var sp: size_t 0
        while sp < fl
        {
            if (*(buf + fs + sp)) = 0x20
                break
            set sp: sp + 1
        }
        if sp >= fl
            return FPI_ERR_MISSING_TEXT_CLASS_SPACE
        let tc ExternalId.lookup_text_class(buf, fs, sp)
        if tc = TC_NONE
            return FPI_ERR_INVALID_TEXT_CLASS
        set this.text_class: tc
        ; skip the space; a lone "-" description means "unavailable" and the
        ; real description is the NEXT field.
        set sp: sp + 1
        let dstart fs + sp
        let dlen fl - sp
        var unavail false
        if dlen = 1
        {
            if (*(buf + dstart)) = minus
                set unavail: true
        }
        set this.unavailable: unavail
        if unavail
        {
            if ExternalId.next_field(buf, lim, solidus, true, &next, &has_next, &fs, &fl) = false
                return FPI_ERR_MISSING_FIELD
            set this.desc_start: fs
            set this.desc_len: fl
        }
        else
        {
            set this.desc_start: dstart
            set this.desc_len: dlen
        }
        ; language / designating sequence field (stored as offsets — the
        ; designating sequence of a CHARSET-class FPI lives here).
        if ExternalId.next_field(buf, lim, solidus, true, &next, &has_next, &fs, &fl) = false
            return FPI_ERR_MISSING_FIELD
        set this.lang_start: fs
        set this.lang_len: fl
        if tc <> TC_CHARSET
        {
            ; the public text language must be a NAME of upper-case letters
            ; (names cannot be empty).
            var k: size_t 0
            while k < fl
            {
                let c *(buf + fs + k)
                if (c < 0x41) or (c > 0x5A)
                    return FPI_ERR_INVALID_LANGUAGE
                set k: k + 1
            }
            if fl = 0
                return FPI_ERR_INVALID_LANGUAGE
        }
        ; optional display version field.
        if ExternalId.next_field(buf, lim, solidus, true, &next, &has_next, &fs, &fl)
        {
            if (tc = TC_CAPACITY) or (tc = TC_CHARSET)
                return FPI_ERR_ILLEGAL_DISPLAY_VERSION
            if (tc = TC_NOTATION) or (tc = TC_SYNTAX)
                return FPI_ERR_ILLEGAL_DISPLAY_VERSION
            set this.have_display_version: true
        }
        else
            set this.have_display_version: false
        ; anything after the display version is an extra field.
        if has_next
            return FPI_ERR_EXTRA_FIELD
        0
    }

    ; PublicId::initUrn (ExternalId.cxx:62). Returns 0 or a URN_ERR_* code.
    ; The nid/nss substrings are validated but not stored (see header note).
    function classify_urn(this: ref[ExternalId]) returns int
    {
        let pid this.public_id
        let buf pid.get_buffer()
        let lim pid.get_length()
        let sep: u8 0x3A
        var next: size_t 0
        var has_next true
        var fs: size_t 0
        var fl: size_t 0
        if ExternalId.next_field(buf, lim, sep, false, &next, &has_next, &fs, &fl) = false
            return URN_ERR_MISSING_FIELD
        ; the "urn" prefix, case-insensitive.
        var prefix_ok false
        if fl = 3
        {
            let c0 *(buf + fs)
            let c1 *(buf + fs + 1)
            let c2 *(buf + fs + 2)
            if (c0 = 0x75) or (c0 = 0x55)
            {
                if (c1 = 0x72) or (c1 = 0x52)
                {
                    if (c2 = 0x6E) or (c2 = 0x4E)
                        set prefix_ok: true
                }
            }
        }
        if prefix_ok = false
            return URN_ERR_MISSING_PREFIX
        ; the namespace identifier: nonempty, alphanumerics plus non-leading '-'.
        if ExternalId.next_field(buf, lim, sep, false, &next, &has_next, &fs, &fl) = false
            return URN_ERR_MISSING_FIELD
        if fl < 1
            return URN_ERR_INVALID_NID
        var i: size_t 0
        while i < fl
        {
            let c *(buf + fs + i)
            var ok ExternalId.is_alnum_byte(c)
            if ok = false
            {
                if c = 0x2D
                {
                    if i > 0
                        set ok: true
                }
            }
            if ok = false
                return URN_ERR_INVALID_NID
            set i: i + 1
        }
        ; the namespace-specific string = the REST (it may contain ':').
        if has_next = false
            return URN_ERR_MISSING_FIELD
        set fs: next
        set fl: lim - next
        if fl < 1
            return URN_ERR_INVALID_NSS
        set i: 0
        while i < fl
        {
            let c *(buf + fs + i)
            if c = 0x25
            {
                ; %-escape: exactly two hex digits, not both zero. (The
                ; reference checks only that the '%' is not the LAST char and
                ; then reads two — one past the string on "%X"-at-end; the
                ; port clamps that read to an invalid-NSS failure.)
                if (fl - i) < 2
                    return URN_ERR_INVALID_NSS
                var zeros true
                var j 0
                while j < 2
                {
                    set i: i + 1
                    if i >= fl
                        return URN_ERR_INVALID_NSS
                    let h *(buf + fs + i)
                    if ExternalId.is_hex_byte(h) = false
                        return URN_ERR_INVALID_NSS
                    if h <> 0x30
                        set zeros: false
                    set j: j + 1
                }
                if zeros
                    return URN_ERR_INVALID_NSS
            }
            else
            {
                var ok ExternalId.is_alnum_byte(c)
                if ok = false
                    set ok: ExternalId.is_nss_other_byte(c)
                if ok = false
                    return URN_ERR_INVALID_NSS
            }
            set i: i + 1
        }
        0
    }

    function test() returns int
    {
        ; PUBLIC + SYSTEM fallback, the corpus's common shape.
        let id ExternalId(true, "-//Example//DTD Model v1//EN", true, "model.dtd")
        if id.has_public_id() = false
            return -1

        if id.has_system_id() = false
            return -2

        if (id.get_system_id() = "model.dtd") = false
            return -3

        ; SYSTEM only.
        let sysonly ExternalId(false, String(), true, "grammar.dtd")
        if sysonly.has_public_id()
            return -4

        if (sysonly.get_system_id() = "grammar.dtd") = false
            return -5

        ; ---- PublicId classification ----------------------------------------
        let anchor String("x")
        let host Page.get(anchor.get_buffer())

        let c1 ExternalId.make_classified(host, "-//Example//DTD Model v1//EN")
        if c1.get_public_type() <> PUBLIC_FPI
            return -10
        if c1.get_text_class() <> TC_DTD
            return -11
        if c1.get_owner_type() <> OWNER_UNREGISTERED
            return -12
        if c1.get_unavailable()
            return -13
        if c1.get_have_display_version()
            return -14

        ; ISO owner (no -/+ indicator), display version present.
        let c2 ExternalId.make_classified(host, "ISO 8879:1986//ENTITIES Added Latin 1//EN//1.0")
        if c2.get_public_type() <> PUBLIC_FPI
            return -15
        if c2.get_owner_type() <> OWNER_ISO
            return -16
        if c2.get_have_display_version() = false
            return -17

        ; registered owner, unavailable text ("-" indicator; the real
        ; description is the NEXT field).
        let c3 ExternalId.make_classified(host, "+//IDN example.org//DTD -//Some DTD//EN")
        if c3.get_public_type() <> PUBLIC_FPI
            return -18
        if c3.get_owner_type() <> OWNER_REGISTERED
            return -19
        if c3.get_unavailable() = false
            return -40

        ; informal: no "//" at all — fpiMissingField, urnMissingPrefix.
        let c4 ExternalId.make_classified(host, "just a plain string")
        if c4.get_public_type() <> PUBLIC_INFORMAL
            return -20
        if c4.get_fpi_error() <> FPI_ERR_MISSING_FIELD
            return -21
        if c4.get_urn_error() <> URN_ERR_MISSING_PREFIX
            return -22

        ; no space after the text class.
        let c5 ExternalId.make_classified(host, "-//O//DTDX//EN")
        if c5.get_fpi_error() <> FPI_ERR_MISSING_TEXT_CLASS_SPACE
            return -23

        ; bad text class.
        let c6 ExternalId.make_classified(host, "-//O//BAD X//EN")
        if c6.get_fpi_error() <> FPI_ERR_INVALID_TEXT_CLASS
            return -24

        ; lower-case language.
        let c7 ExternalId.make_classified(host, "-//O//DTD X//en")
        if c7.get_fpi_error() <> FPI_ERR_INVALID_LANGUAGE
            return -25

        ; language field missing entirely.
        let c8 ExternalId.make_classified(host, "-//O//DTD X")
        if c8.get_fpi_error() <> FPI_ERR_MISSING_FIELD
            return -26

        ; display version not permitted for SYNTAX (also CAPACITY/CHARSET/NOTATION).
        let c9 ExternalId.make_classified(host, "-//O//SYNTAX X//EN//2")
        if c9.get_fpi_error() <> FPI_ERR_ILLEGAL_DISPLAY_VERSION
            return -27

        ; extra field after the display version.
        let c10 ExternalId.make_classified(host, "-//O//DTD X//EN//1//2")
        if c10.get_fpi_error() <> FPI_ERR_EXTRA_FIELD
            return -28

        ; CHARSET: designating sequence, NOT language-checked.
        let c11 ExternalId.make_classified(host, "-//O//CHARSET X//ESC 2/4")
        if c11.get_public_type() <> PUBLIC_FPI
            return -29
        if c11.get_text_class() <> TC_CHARSET
            return -30

        ; valid URNs.
        let u1 ExternalId.make_classified(host, "urn:example:mydoc-1")
        if u1.get_public_type() <> PUBLIC_URN
            return -31
        let u2 ExternalId.make_classified(host, "URN:a-b:x%2Ay:z")
        if u2.get_public_type() <> PUBLIC_URN
            return -32

        ; empty nid.
        let u3 ExternalId.make_classified(host, "urn::x")
        if u3.get_urn_error() <> URN_ERR_INVALID_NID
            return -33

        ; nid with a leading '-'.
        let u4 ExternalId.make_classified(host, "urn:-a:x")
        if u4.get_urn_error() <> URN_ERR_INVALID_NID
            return -34

        ; missing nss field ("urn:a" — no second ':').
        let u5 ExternalId.make_classified(host, "urn:a")
        if u5.get_urn_error() <> URN_ERR_MISSING_FIELD
            return -35

        ; empty nss.
        let u6 ExternalId.make_classified(host, "urn:a:")
        if u6.get_urn_error() <> URN_ERR_INVALID_NSS
            return -36

        ; nss %-escape: "%00" and truncated "%2" are invalid, space is invalid.
        let u7 ExternalId.make_classified(host, "urn:a:x%00y")
        if u7.get_urn_error() <> URN_ERR_INVALID_NSS
            return -37
        let u8 ExternalId.make_classified(host, "urn:a:x%2")
        if u8.get_urn_error() <> URN_ERR_INVALID_NSS
            return -38
        let u9 ExternalId.make_classified(host, "urn:a:x y")
        if u9.get_urn_error() <> URN_ERR_INVALID_NSS
            return -39

        0
    }

    ; heap-construct + classify a PUBLIC-only id (test/probe convenience —
    ; classify_public needs a pointer receiver).
    function make_classified(host: ref[Page], pub: String) returns ref[ExternalId]
    {
        let p &ExternalId^host(true, pub, false, String())
        p.classify_public()
        p
    }
}
