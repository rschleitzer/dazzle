use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use scaly.io.Path
use opensp.StringC.StringC
use opensp.ParserState.ParserState
use opensp.Event.Event
use opensp.Attribute.AttributeValue
use opensp.Attribute.Attribute
use opensp.Attribute.AttributeSemantics
use opensp.Attribute.Text
use opensp.AttributeList.AttributeList
use opensp.ElementType.ElementType
use opensp.Entity.Entity
use opensp.Entity.InternalEntity
use opensp.Entity.ExternalTextEntity
use opensp.Entity.ExternalDataEntity
use opensp.Entity.SubdocEntity
use opensp.Notation.Notation
use opensp.ExternalId.ExternalId

; Esis — the ESIS event-dump writer (Stage 4 Increment 3).
;
; Ports SgmlsEventHandler (nsgmls/SgmlsEventHandler.cxx — the C++ oracle, NOT
; the C# mirror, since escaping differs): walks the ParserState event queue and
; produces the byte-identical ESIS text that `onsgmls` writes to stdout. This is
; the harness the tests/sgml corpus counter measures — the true Stage-4 progress
; bar (ROADMAP-dazzle.md Stage 4 exit: "the corpus counter goes green model by
; model on an event-dump harness").
;
; ESIS grammar produced here (the content subset Increment 1/2 events cover):
;   A<NAME> <TYPE> <VALUE>   one per attribute with a value (before its (start)
;                            TYPE = IMPLIED | TOKEN <v> | CDATA <v>
;   (<GI>                    start element
;   )<GI>                    end element
;   -<data>                  character data (consecutive data coalesces; the
;                            trailing '\n' is written when the run is flushed)
;   C                        conforming document (only when errorCount == 0)
;
;   N/E/I/S/T + p/s/f      entity + notation definitions (printed inline, once
;                          per document, before the A-line / `&` reference that
;                          first needs them)
;   A<NAME> NOTATION/ENTITY <v>   typed tokenized values (AttributeSemantics)
;   &<NAME>                external data entity reference in content
;   D<ENAME> <NAME> <TYPE...>     data attributes of an external data entity
;
; DEFERRED (later increments): L location lines, _ comment, i/e/o flags,
; subdoc content parsing ({}).
;
; Escaping (outputString, SgmlsEventHandler.cxx): '\' -> '\\'; RE (0x0D) -> '\n';
; any char < 0x20 -> '\0' + two octal digits; everything else through the
; output coding system.
;
; Output coding system (CmdLineApp::makeStdOut -> EncodeOutputCharStream): the
; whole ESIS stream (names, data, attribute values) leaves through ONE encoder
; selected by CmdLineApp::initCodingSystem from the environment (see
; onsgmls.scaly). A char the encoder cannot represent triggers the stream's
; escaper (SgmlsEventHandler::escaper, set once via setEscaper) which writes
; escapePrefix numEscape <decimal> escapeEnd = `\#<N>;`. Two encoders are
; modeled (put_char):
;   Identity (the default, IdentityCodingSystem.cxx): c <= 0xFF -> the single
;   byte c; c > UCHAR_MAX -> handleUnencodable -> `\#N;`.
;   UTF-8 (SP_CHARSET_FIXED=YES + SP_ENCODING=XML/UTF-8): UTF8Encoder.output —
;   plain UTF-8 bytes; its 5/6-byte forms (c >= 0x200000) are unreachable
;   because parse_numeric_char_ref caps chars at charMax <= 0x10FFFF, so the
;   UTF-8 path never escapes. Surrogates encode blindly as 3-byte sequences,
;   exactly like the reference encoder.

define Esis
{
    function put(acc: pointer[Array[u8]], b: u8)
        acc.add(b)

    ; append an ASCII literal (a byte String) verbatim.
    function put_lit(acc: pointer[Array[u8]], s: String)
    {
        let n s.get_length()
        var i: size_t 0
        while i < n
        {
            acc.add(s.get(i))
            set i: i + 1
        }
    }

    ; decimal digits of n (the escaper prints `(unsigned long)c` — plain
    ; decimal, no padding).
    function put_dec(acc: pointer[Array[u8]], n: u32)
    {
        var digits u8[16]
        let dp digits as pointer[u8]
        var v n
        var count: size_t 0
        var go true
        while go
        {
            set *(dp + count): (((0x30 as u32) + (v % (10 as u32))) as u8)
            set count: count + (1 as size_t)
            set v: v / (10 as u32)
            if v = (0 as u32)
                set go: false
        }
        var i count
        while i > (0 as size_t)
        {
            set i: i - (1 as size_t)
            acc.add(*(dp + i))
        }
    }

    ; the unencodable-char escape (SgmlsEventHandler::escaper): `\#<decimal>;`.
    function put_esc(acc: pointer[Array[u8]], c: u32)
    {
        acc.add(0x5C as u8)
        acc.add(0x23 as u8)
        Esis.put_dec(acc, c)
        acc.add(0x3B as u8)
    }

    ; Encode one Char as UTF-8. The C++ handler never narrows a Char itself: it
    ; hands every Char to an OutputCharStream (`os().put(*p)`, `os() << name`)
    ; whose UTF-8 encoder this mirrors (UTF8CodingSystem.cxx; the 5/6-byte
    ; forms are unreachable, chars are capped at 0x10FFFF).
    function put_utf8(acc: pointer[Array[u8]], c: u32)
    {
        if c < (0x80 as u32)
            acc.add(c as u8)
        else if c < (0x800 as u32)
        {
            acc.add(((0xC0 as u32) | (c >> (6 as u32))) as u8)
            acc.add(((0x80 as u32) | (c & (0x3F as u32))) as u8)
        }
        else if c < (0x10000 as u32)
        {
            acc.add(((0xE0 as u32) | (c >> (12 as u32))) as u8)
            acc.add(((0x80 as u32) | ((c >> (6 as u32)) & (0x3F as u32))) as u8)
            acc.add(((0x80 as u32) | (c & (0x3F as u32))) as u8)
        }
        else
        {
            acc.add(((0xF0 as u32) | (c >> (18 as u32))) as u8)
            acc.add(((0x80 as u32) | ((c >> (12 as u32)) & (0x3F as u32))) as u8)
            acc.add(((0x80 as u32) | ((c >> (6 as u32)) & (0x3F as u32))) as u8)
            acc.add(((0x80 as u32) | (c & (0x3F as u32))) as u8)
        }
    }

    ; one Char through the active output coding system (see the header note):
    ; Identity emits the raw byte for c <= 0xFF and escapes the rest; UTF-8
    ; always encodes (nothing valid is unencodable there).
    function put_char(acc: pointer[Array[u8]], c: u32, utf8: bool)
    {
        if utf8
        {
            Esis.put_utf8(acc, c)
            return
        }
        if c < (0x100 as u32)
            acc.add(c as u8)
        else
            Esis.put_esc(acc, c)
    }

    ; append a StringC as a name (no escaping; GIs/attr names are already
    ; reference-syntax name characters) through the output encoder — the
    ; escaper is set on the whole stream, so names take the same path as data.
    function put_name(acc: pointer[Array[u8]], sc: StringC, utf8: bool)
    {
        let n sc.get_size()
        var i: size_t 0
        while i < n
        {
            Esis.put_char(acc, sc.get(i), utf8)
            set i: i + 1
        }
    }

    ; append a StringC as ESIS data with the C++ outputString escaping. The
    ; control-char / '\' / RE escapes run BEFORE the coding system (they are
    ; outputString's, upstream of the encoder); only the default arm is
    ; encoding-dependent.
    function put_data(acc: pointer[Array[u8]], sc: StringC, utf8: bool)
    {
        let n sc.get_size()
        var i: size_t 0
        while i < n
        {
            let c sc.get(i)
            if c = (0x5C as u32)
            {
                acc.add(0x5C as u8)
                acc.add(0x5C as u8)
            }
            else if c = (0x0D as u32)
            {
                acc.add(0x5C as u8)
                acc.add(0x6E as u8)
            }
            else if c < (0x20 as u32)
            {
                acc.add(0x5C as u8)
                acc.add(0x30 as u8)
                let d1 (c / (8 as u32)) % (8 as u32)
                let d2 c % (8 as u32)
                acc.add(((0x30 as u32) + d1) as u8)
                acc.add(((0x30 as u32) + d2) as u8)
            }
            else
                Esis.put_char(acc, c, utf8)
            set i: i + 1
        }
    }

    ; SgmlsEventHandler::markEntity/markNotation — StringSet::add: true when
    ; the name was already output this document, else remember it. Names alias
    ; run-page StringCs (stable for the writer's lifetime).
    function mark(seen: pointer[Array[StringC]], name: StringC) returns bool
    {
        let n seen.get_length()
        var i: size_t 0
        while i < n
        {
            let s *(seen.get_buffer() + i)
            if s.equals(name)
                return true
            set i: i + 1
        }
        seen.add(name)
        false
    }

    ; outputString over an 8-bit String (system/public identifiers) — the same
    ; escaping as put_data, byte-wise.
    function put_data_bytes(acc: pointer[Array[u8]], s: String, utf8: bool)
    {
        let n s.get_length()
        var i: size_t 0
        while i < n
        {
            let c s.get(i) as u32
            if c = (0x5C as u32)
            {
                acc.add(0x5C as u8)
                acc.add(0x5C as u8)
            }
            else if c = (0x0D as u32)
            {
                acc.add(0x5C as u8)
                acc.add(0x6E as u8)
            }
            else if c < (0x20 as u32)
            {
                acc.add(0x5C as u8)
                acc.add(0x30 as u8)
                let d1 (c / (8 as u32)) % (8 as u32)
                let d2 c % (8 as u32)
                acc.add(((0x30 as u32) + d1) as u8)
                acc.add(((0x30 as u32) + d2) as u8)
            }
            else
                Esis.put_char(acc, c, utf8)
            set i: i + 1
        }
    }

    ; SgmlsEventHandler::externalId (:585): p<pubid> / s<sysid> and, for
    ; entities (outputFile), f<effective system id>. The effective id is the
    ; storage manager's resolution: `<OSFILE>` + the declaring-directory join
    ; (PosixStorage resolveRelative) — printed only when a system id was
    ; declared (a public-only id already warned cannotGenerateSystemId at
    ; define time and has no effective id).
    function put_external_id(acc: pointer[Array[u8]], id: ExternalId, base_dir: String, output_file: bool, utf8: bool)
    {
        if id.has_public_id()
        {
            Esis.put(acc, 0x70 as u8)
            Esis.put_data_bytes(acc, id.get_public_id(), utf8)
            Esis.put(acc, 0x0A as u8)
        }
        if id.has_system_id()
        {
            Esis.put(acc, 0x73 as u8)
            Esis.put_data_bytes(acc, id.get_system_id(), utf8)
            Esis.put(acc, 0x0A as u8)
            if output_file
            {
                Esis.put(acc, 0x66 as u8)
                Esis.put_lit(acc, String("<OSFILE>"))
                let eff Path.join(base_dir, id.get_system_id())
                Esis.put_data_bytes(acc, eff, utf8)
                Esis.put(acc, 0x0A as u8)
            }
        }
    }

    ; SgmlsEventHandler::defineNotation (:575) — marks itself; a repeat is
    ; silent. No f-line: outputNotationSysid (-onotation-sysid) is off in the
    ; drop-in.
    function define_notation(acc: pointer[Array[u8]], nt: pointer[Notation], seen_n: pointer[Array[StringC]], utf8: bool)
    {
        let nm nt.get_name()
        if Esis.mark(seen_n, nm)
            return
        let id nt.get_external_id()
        Esis.put_external_id(acc, id, String(), false, utf8)
        Esis.put(acc, 0x4E as u8)
        Esis.put_name(acc, nm, utf8)
        Esis.put(acc, 0x0A as u8)
    }

    ; SgmlsEventHandler::defineEntity (:488) — the CALLER checks markEntity
    ; first (both the attribute and the `&` reference sites), exactly like the
    ; reference.
    ;   internal        I<name> <CDATA|SDATA|TEXT|PI> <text>
    ;   external data   the notation's definition, p/s/f, E<name> <TYPE> <not>,
    ;                   then the entity's data attributes as D records
    ;   subdoc          p/s/f, S<name>
    ;   external text   p/s/f, T<name> — only reachable with -oentity in the
    ;                   reference (sgml-text entities never make ENTITY-
    ;                   attribute semantics); ported blind for completeness.
    function define_entity(acc: pointer[Array[u8]], ent: pointer[Entity], seen_e: pointer[Array[StringC]], seen_n: pointer[Array[StringC]], utf8: bool)
    {
        choose *ent
            when i: Internal
            {
                Esis.put(acc, 0x49 as u8)
                Esis.put_name(acc, i.get_name(), utf8)
                Esis.put(acc, 0x20 as u8)
                let dt i.get_data_type()
                if dt = DT_CDATA
                    Esis.put_lit(acc, String("CDATA "))
                else if dt = DT_SDATA
                    Esis.put_lit(acc, String("SDATA "))
                else if dt = DT_PI
                    Esis.put_lit(acc, String("PI "))
                else
                    Esis.put_lit(acc, String("TEXT "))
                Esis.put_data(acc, i.get_text(), utf8)
                Esis.put(acc, 0x0A as u8)
            }
            when e: ExternalText
            {
                Esis.put_external_id(acc, e.get_external_id(), e.get_base_dir(), true, utf8)
                Esis.put(acc, 0x54 as u8)
                Esis.put_name(acc, e.get_name(), utf8)
                Esis.put(acc, 0x0A as u8)
            }
            when d: ExternalData
            {
                let nt d.get_notation() as pointer[Notation]
                Esis.define_notation(acc, nt, seen_n, utf8)
                Esis.put_external_id(acc, d.get_external_id(), d.get_base_dir(), true, utf8)
                Esis.put(acc, 0x45 as u8)
                let dname d.get_name()
                Esis.put_name(acc, dname, utf8)
                Esis.put(acc, 0x20 as u8)
                let ddt d.get_data_type()
                if ddt = DT_CDATA
                    Esis.put_lit(acc, String("CDATA "))
                else if ddt = DT_SDATA
                    Esis.put_lit(acc, String("SDATA "))
                else
                    Esis.put_lit(acc, String("NDATA "))
                let ntname nt.get_name()
                Esis.put_name(acc, ntname, utf8)
                Esis.put(acc, 0x0A as u8)
                let datts d.get_attributes() as pointer[AttributeList]
                Esis.put_attributes(acc, datts, 0x44 as u8, &dname, seen_e, seen_n, utf8)
            }
            when sub: Subdoc
            {
                Esis.put_external_id(acc, sub.get_external_id(), sub.get_base_dir(), true, utf8)
                Esis.put(acc, 0x53 as u8)
                Esis.put_name(acc, sub.get_name(), utf8)
                Esis.put(acc, 0x0A as u8)
            }
    }

    ; A<NAME> <TYPE> <VALUE> for each attribute in the list that has a value
    ; (SgmlsEventHandler::attributes, :330). `code` is 'A' for start-tag
    ; attributes, 'D' for an entity's data attributes (`owner` then prefixes
    ; the attribute name — startAttribute's ownerName). A tokenized value WITH
    ; semantics first prints the definitions its value references — the
    ; notation, or each not-yet-output entity — and types the line
    ; NOTATION / ENTITY instead of TOKEN.
    function put_attributes(acc: pointer[Array[u8]], atts: pointer[AttributeList], code: u8, owner: pointer[StringC], seen_e: pointer[Array[StringC]], seen_n: pointer[Array[StringC]], utf8: bool)
    {
        if atts = null
            return
        let n atts.size()
        var i: size_t 0
        while i < n
        {
            let v atts.value(i)
            if v <> null
            {
                let ty v.value_type()
                ; 0 TOKEN, 1 NOTATION, 2 ENTITY
                var tkind: int 0
                if ty = AVT_TOKENIZED
                {
                    let a atts.attribute(i)
                    let sem a.get_semantics()
                    if sem <> null
                    {
                        let ntv sem.get_notation()
                        if ntv <> null
                        {
                            Esis.define_notation(acc, ntv as pointer[Notation], seen_n, utf8)
                            set tkind: 1
                        }
                        else
                        {
                            let ne sem.n_entities()
                            if ne > (0 as size_t)
                            {
                                set tkind: 2
                                var j: size_t 0
                                while j < ne
                                {
                                    let ent sem.entity(j) as pointer[Entity]
                                    let en ent.get_name()
                                    if Esis.mark(seen_e, en) = false
                                        Esis.define_entity(acc, ent, seen_e, seen_n, utf8)
                                    set j: j + 1
                                }
                            }
                        }
                    }
                }
                Esis.put(acc, code)
                if owner <> null
                {
                    Esis.put_name(acc, *owner, utf8)
                    Esis.put(acc, 0x20 as u8)
                }
                Esis.put_name(acc, atts.name(i), utf8)
                Esis.put(acc, 0x20 as u8)
                if ty = AVT_IMPLIED
                    Esis.put_lit(acc, String("IMPLIED"))
                else if ty = AVT_CDATA
                {
                    Esis.put_lit(acc, String("CDATA "))
                    ; TextIter over the value (SgmlsEventHandler::attributes,
                    ; :396): data/cdata items print plain, sdata items between
                    ; `\|` markers. The port's Text carries the sdata runs as
                    ; flat (start,end) index pairs; no runs = one data item.
                    let vs v.get_string()
                    let vt v.get_text()
                    var runs: pointer[Array[size_t]] null
                    if vt <> null
                        set runs: (*vt).get_sdata_runs()
                    if runs = null
                        Esis.put_data(acc, vs, utf8)
                    else
                    {
                        let nr runs.get_length()
                        let vn vs.get_size()
                        var pos: size_t 0
                        var ri: size_t 0
                        while ri < nr
                        {
                            var rs *(runs.get_buffer() + ri)
                            var re *(runs.get_buffer() + ri + (1 as size_t))
                            ; clamp against the normalized size (a trailing-
                            ; space drop can shorten the string).
                            if rs > vn
                                set rs: vn
                            if re > vn
                                set re: vn
                            if rs > pos
                            {
                                let seg_before StringC(vs.data_ptr() + pos, rs - pos)
                                Esis.put_data(acc, seg_before, utf8)
                            }
                            Esis.put(acc, 0x5C as u8)
                            Esis.put(acc, 0x7C as u8)
                            if re > rs
                            {
                                let seg_sdata StringC(vs.data_ptr() + rs, re - rs)
                                Esis.put_data(acc, seg_sdata, utf8)
                            }
                            Esis.put(acc, 0x5C as u8)
                            Esis.put(acc, 0x7C as u8)
                            set pos: re
                            set ri: ri + (2 as size_t)
                        }
                        if vn > pos
                        {
                            let seg_after StringC(vs.data_ptr() + pos, vn - pos)
                            Esis.put_data(acc, seg_after, utf8)
                        }
                    }
                }
                else
                {
                    if tkind = 1
                        Esis.put_lit(acc, String("NOTATION "))
                    else if tkind = 2
                        Esis.put_lit(acc, String("ENTITY "))
                    else
                        Esis.put_lit(acc, String("TOKEN "))
                    Esis.put_data(acc, v.get_string(), utf8)
                }
                Esis.put(acc, 0x0A as u8)
            }
            set i: i + 1
        }
    }

    ; walk the event queue -> the ESIS byte String.
    function write(host: pointer[Page], ps: pointer[ParserState], conforming: bool) returns String
    {
        let acc Array[u8]^host()
        ; the output coding system (identity vs UTF-8), decided once from the
        ; environment by the driver (CmdLineApp::initCodingSystem).
        let utf8 ps.get_output_utf8()
        ; definedEntities_/definedNotations_ — each entity/notation definition
        ; prints ONCE per document, at its first use (attribute value or `&`
        ; reference).
        let seen_e Array[StringC]^host()
        let seen_n Array[StringC]^host()
        let n ps.n_events()
        var have_data false
        var k: size_t 0
        while k < n
        {
            let ev ps.get_event(k)
            let ty ev.get_type()
            if ty = EV_DATA
            {
                if have_data = false
                {
                    Esis.put(acc, 0x2D as u8)
                    set have_data: true
                }
                Esis.put_data(acc, ev.get_data(), utf8)
            }
            else if ty = EV_SDATA
            {
                ; SgmlsEventHandler::sdataEntity (:255) — startData() (the run
                ; CONTINUES), then `\|` + escaped text + `\|` inline.
                if have_data = false
                {
                    Esis.put(acc, 0x2D as u8)
                    set have_data: true
                }
                Esis.put(acc, 0x5C as u8)
                Esis.put(acc, 0x7C as u8)
                Esis.put_data(acc, ev.get_data(), utf8)
                Esis.put(acc, 0x5C as u8)
                Esis.put(acc, 0x7C as u8)
            }
            else if ty = EV_START_ELEMENT
            {
                if have_data
                {
                    Esis.put(acc, 0x0A as u8)
                    set have_data: false
                }
                ; link-rule attributes first (SgmlsEventHandler::startElement:
                ; the `a<lpdname> ...` records precede the `A` records).
                let latts ev.get_link_attributes()
                if latts <> null
                    Esis.put_attributes(acc, latts, 0x61 as u8, ev.get_link_owner(), &seen_e, &seen_n, utf8)
                Esis.put_attributes(acc, ev.get_attributes(), 0x41 as u8, null, &seen_e, &seen_n, utf8)
                Esis.put(acc, 0x28 as u8)
                Esis.put_name(acc, ev.get_element_type().get_name(), utf8)
                Esis.put(acc, 0x0A as u8)
            }
            else if ty = EV_END_ELEMENT
            {
                if have_data
                {
                    Esis.put(acc, 0x0A as u8)
                    set have_data: false
                }
                Esis.put(acc, 0x29 as u8)
                Esis.put_name(acc, ev.get_element_type().get_name(), utf8)
                Esis.put(acc, 0x0A as u8)
            }
            else if ty = EV_PI
            {
                ; SgmlsEventHandler::pi — flushData(), then `?` + data + RE.
                if have_data
                {
                    Esis.put(acc, 0x0A as u8)
                    set have_data: false
                }
                Esis.put(acc, 0x3F as u8)
                Esis.put_data(acc, ev.get_data(), utf8)
                Esis.put(acc, 0x0A as u8)
            }
            else if ty = EV_APPINFO
            {
                ; SgmlsEventHandler::appinfo — flushData(), `#` + literal + RE.
                if have_data
                {
                    Esis.put(acc, 0x0A as u8)
                    set have_data: false
                }
                Esis.put(acc, 0x23 as u8)
                Esis.put_data(acc, ev.get_data(), utf8)
                Esis.put(acc, 0x0A as u8)
            }
            else if ty = EV_ENTITY_REF
            {
                ; SgmlsEventHandler::externalDataEntity (:448): flush the data
                ; run, print the entity's definition on first use, then the
                ; `&name` reference line.
                if have_data
                {
                    Esis.put(acc, 0x0A as u8)
                    set have_data: false
                }
                let rent ev.get_entity()
                let rname rent.get_name()
                if Esis.mark(&seen_e, rname) = false
                    Esis.define_entity(acc, rent, &seen_e, &seen_n, utf8)
                Esis.put(acc, 0x26 as u8)
                Esis.put_name(acc, rname, utf8)
                Esis.put(acc, 0x0A as u8)
            }
            else if ty = EV_START_SUBDOC
            {
                ; SgmlsEventHandler::subdocEntity (:461): flush the data run,
                ; define the subdoc entity on first use (s/f/S records), then
                ; `{name`. The nested sub-parse's events follow in the queue.
                if have_data
                {
                    Esis.put(acc, 0x0A as u8)
                    set have_data: false
                }
                let sent ev.get_entity()
                let sname sent.get_name()
                if Esis.mark(&seen_e, sname) = false
                    Esis.define_entity(acc, sent, &seen_e, &seen_n, utf8)
                Esis.put(acc, 0x7B as u8)
                Esis.put_name(acc, sname, utf8)
                Esis.put(acc, 0x0A as u8)
            }
            else if ty = EV_END_PROLOG
            {
                ; SgmlsEventHandler::endProlog — the active SIMPLE link types'
                ; attribute lists print as `a<linkname> <att> ...` records
                ; (flushData per list; the complex-LPD half initialized the
                ; link process parser-side at queue time).
                let sl_names ev.get_simple_link_names()
                if sl_names <> null
                {
                    let sl_atts ev.get_simple_link_atts()
                    let nsl sl_names.get_length()
                    var sli: size_t 0
                    while sli < nsl
                    {
                        if have_data
                        {
                            Esis.put(acc, 0x0A as u8)
                            set have_data: false
                        }
                        let sname sl_names.get_buffer() + sli
                        let satts *(sl_atts.get_buffer() + sli)
                        Esis.put_attributes(acc, satts, 0x61 as u8, sname, &seen_e, &seen_n, utf8)
                        set sli: sli + 1
                    }
                }
            }
            else if ty = EV_END_SUBDOC
            {
                ; `}name` — closes the subdoc bracket after its events.
                if have_data
                {
                    Esis.put(acc, 0x0A as u8)
                    set have_data: false
                }
                Esis.put(acc, 0x7D as u8)
                Esis.put_name(acc, ev.get_entity().get_name(), utf8)
                Esis.put(acc, 0x0A as u8)
            }
            set k: k + 1
        }
        if have_data
            Esis.put(acc, 0x0A as u8)
        ; The conformance marker `C` is written iff the document conformed
        ; (SgmlsEventHandler dtor) — onsgmls's invariant is C present <=> exit 0.
        ; A failed parse that recorded no message (e.g. an unresolved external
        ; DTD subset) is still non-conforming, so `n_errors==0` alone is not
        ; enough — the caller passes the same decision that sets the exit code.
        if conforming
        {
            Esis.put(acc, 0x43 as u8)
            Esis.put(acc, 0x0A as u8)
        }
        let len acc.get_length()
        let out host.allocate(len + (1 as size_t), 1) as pointer[u8]
        let src acc.get_buffer()
        var j: size_t 0
        while j < len
        {
            set *(out + j): *(src + j)
            set j: j + 1
        }
        set *(out + len): (0 as u8)
        String(out as pointer[const_char], len)
    }

    ; ---- self-test: escaping over a controlled StringC --------------------
    function test() returns int
    {
        let anchor StringC("x")
        let host Page.get(anchor.data_ptr() as pointer[void])

        ; data escaping: "a<TAB>b\<RE>c" -> "a\011b\\\nc"
        let acc Array[u8]^host()
        var raw u32[5]
        let rp raw as pointer[u32]
        set *(rp + (0 as size_t)): 0x61 as u32
        set *(rp + (1 as size_t)): 0x09 as u32
        set *(rp + (2 as size_t)): 0x62 as u32
        set *(rp + (3 as size_t)): 0x5C as u32
        set *(rp + (4 as size_t)): 0x0D as u32
        let sc StringC(rp, 5 as size_t)
        Esis.put_data(acc, sc, false)
        let got String(acc.get_buffer() as pointer[const_char], acc.get_length())
        if got.equals(String("a\\011b\\\\\\n")) = false
            return -1

        ; UTF-8 output: U+00FC -> C3 BC, U+FFFD -> EF BF BD (the two shapes the
        ; XML-encoding decoder actually produces), ASCII still identity.
        let acc2 Array[u8]^host()
        var raw2 u32[3]
        let rp2 raw2 as pointer[u32]
        set *(rp2 + (0 as size_t)): 0x7A as u32     ; 'z'
        set *(rp2 + (1 as size_t)): 0xFC as u32     ; 'ü'
        set *(rp2 + (2 as size_t)): 0xFFFD as u32   ; U+FFFD
        let sc2 StringC(rp2, 3 as size_t)
        Esis.put_data(acc2, sc2, true)
        if acc2.get_length() <> (6 as size_t)
            return -2
        let b2 acc2.get_buffer()
        if *(b2 + (0 as size_t)) <> (0x7A as u8)
            return -3
        if *(b2 + (1 as size_t)) <> (0xC3 as u8)
            return -4
        if *(b2 + (2 as size_t)) <> (0xBC as u8)
            return -5
        if *(b2 + (3 as size_t)) <> (0xEF as u8)
            return -6
        if *(b2 + (4 as size_t)) <> (0xBF as u8)
            return -7
        if *(b2 + (5 as size_t)) <> (0xBD as u8)
            return -8

        ; identity output (the default coding system): c <= 0xFF -> the raw
        ; byte; c >= 0x100 -> the `\#N;` escape. Same input Chars as above:
        ; z ü U+FFFD -> 7A FC "\#65533;".
        let acc3 Array[u8]^host()
        Esis.put_data(acc3, sc2, false)
        let got3 String(acc3.get_buffer() as pointer[const_char], acc3.get_length())
        if got3.get_length() <> (10 as size_t)
            return -9
        if got3.get(0) <> (0x7A as u8)
            return -10
        if got3.get(1) <> (0xFC as u8)
            return -11
        let b3 acc3.get_buffer()
        let esc3 String((b3 + (2 as size_t)) as pointer[const_char], 8 as size_t)
        if esc3.equals(String("\\#65533;")) = false
            return -12
        0
    }
}
