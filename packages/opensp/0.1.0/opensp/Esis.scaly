use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use scaly.io.Path
use opensp.StringC.StringC
use opensp.ParserState.ParserState
use opensp.Event.Event
use opensp.Location.Location
use opensp.Location.Origin
use opensp.Attribute.AttributeValue
use opensp.Attribute.Attribute
use opensp.Attribute.AttributeSemantics
use opensp.Attribute.Text
use opensp.AttributeList.AttributeList
use opensp.ElementType.ElementType
use opensp.ElementType.ElementDefinition
use opensp.Entity.Entity
use opensp.Entity.InternalEntity
use opensp.Entity.ExternalTextEntity
use opensp.Entity.ExternalDataEntity
use opensp.Entity.SubdocEntity
use opensp.Notation.Notation
use opensp.ExternalId.ExternalId

; Esis — the ESIS event-dump writer (Stage 4 Increment 3 + the -o option axis).
;
; Ports SgmlsEventHandler (nsgmls/SgmlsEventHandler.cxx — the C++ oracle, NOT
; the C# mirror, since escaping differs): walks the ParserState event queue and
; produces the byte-identical ESIS text that `onsgmls` writes to stdout. This is
; the harness the tests/sgml corpus counter measures.
;
; ESIS grammar produced here:
;   A<NAME> <TYPE> <VALUE>   one per attribute with a value (before its (start)
;                            TYPE = IMPLIED | TOKEN/NOTATION/ENTITY/ID <v> |
;                            CDATA <v> | DATA <notation> <v> (-odata-attribute)
;   (<GI> / )<GI>            start / end element
;   -<data>                  character data (consecutive data coalesces; the
;                            trailing '\n' is written when the run is flushed)
;   C                        conforming document (only when errorCount == 0)
;   N/E/I/S/T + p/s/f        entity + notation definitions
;   &<NAME>                  external data entity reference in content
;   D<ENAME> <NAME> <TYPE…>  data attributes of an external data entity
;   ?<data> / #<appinfo>     processing instruction / APPINFO
;   {<NAME> }<NAME>          subdocument brackets
;   L<line> [<file>]         -oline location records
;   i / e / o                -oincluded / -oempty / -o(tag|attr)omit records
;   _<comment>               -ocomment records (instance comment declarations)
;   V…                       -oversion parser-information records
;
; The -o flags arrive as ParserState.output_flags (OF_*, Event.scaly). The
; mutable writer state (data-run flag, -oline line tracking, the per-document
; definedEntities/definedNotations sets, the inDocument_ comment gate) lives in
; one page-hosted EsisW record threaded through the helpers.
;
; Escaping (outputString, SgmlsEventHandler.cxx): '\' -> '\\'; RE (0x0D) -> '\n';
; any char < 0x20 -> '\0' + two octal digits; everything else through the
; output coding system.
;
; Output coding system (CmdLineApp::makeStdOut -> EncodeOutputCharStream): the
; whole ESIS stream (names, data, attribute values) leaves through ONE encoder
; selected by CmdLineApp::initCodingSystem from the environment (see
; onsgmls.scaly). A char the encoder cannot represent triggers the stream's
; escaper (SgmlsEventHandler::escaper, set once via setEscaper) which writes
; escapePrefix numEscape <decimal> escapeEnd = `\#<N>;`. Two encoders are
; modeled (put_char):
;   Identity (the default, IdentityCodingSystem.cxx): c <= 0xFF -> the single
;   byte c; c > UCHAR_MAX -> handleUnencodable -> `\#N;`.
;   UTF-8 (SP_CHARSET_FIXED=YES + SP_ENCODING=XML/UTF-8): UTF8Encoder.output —
;   plain UTF-8 bytes; its 5/6-byte forms (c >= 0x200000) are unreachable
;   because parse_numeric_char_ref caps chars at charMax <= 0x10FFFF, so the
;   UTF-8 path never escapes. Surrogates encode blindly as 3-byte sequences,
;   exactly like the reference encoder.

; The writer's mutable state (the SgmlsEventHandler data members).
define EsisW
(
    acc: pointer[Array[u8]]
    utf8: bool
    flags: u32
    ; haveData_ — a `-` data run is open.
    have_data: bool
    ; inDocument_ — set at endProlog when -ocomment; comment records print
    ; only afterwards (prolog comments are dropped). Never reset — a subdoc's
    ; DTD comments print, bug-for-bug with the reference.
    in_document: bool
    ; -oline: lastSos_/lastLineno_ — the resolved origin identity stands in
    ; for the reference's StorageObjectSpec pointer.
    last_sos: pointer[Origin]
    last_lineno: u32
    ps: pointer[ParserState]
    ; definedEntities_/definedNotations_ — swapped fresh per subdocument
    ; (SgmlsSubdocState::init/swap).
    seen_e: pointer[Array[StringC]]
    seen_n: pointer[Array[StringC]]
)

define Esis
{
    function put(acc: pointer[Array[u8]], b: u8)
        acc.add(b)

    ; append an ASCII literal (a byte String) verbatim.
    function put_lit(acc: pointer[Array[u8]], s: String)
    {
        let n s.get_length()
        var i: size_t 0
        while i < n
        {
            acc.add(s.get(i))
            set i: i + 1
        }
    }

    ; decimal digits of n (the escaper prints `(unsigned long)c` — plain
    ; decimal, no padding).
    function put_dec(acc: pointer[Array[u8]], n: u32)
    {
        var digits u8[16]
        let dp digits as pointer[u8]
        var v n
        var count: size_t 0
        var go true
        while go
        {
            set *(dp + count): (((0x30 as u32) + (v % (10 as u32))) as u8)
            set count: count + (1 as size_t)
            set v: v / (10 as u32)
            if v = (0 as u32)
                set go: false
        }
        var i count
        while i > (0 as size_t)
        {
            set i: i - (1 as size_t)
            acc.add(*(dp + i))
        }
    }

    ; the unencodable-char escape (SgmlsEventHandler::escaper): `\#<decimal>;`.
    function put_esc(acc: pointer[Array[u8]], c: u32)
    {
        acc.add(0x5C as u8)
        acc.add(0x23 as u8)
        Esis.put_dec(acc, c)
        acc.add(0x3B as u8)
    }

    ; Encode one Char as UTF-8. The C++ handler never narrows a Char itself: it
    ; hands every Char to an OutputCharStream (`os().put(*p)`, `os() << name`)
    ; whose UTF-8 encoder this mirrors (UTF8CodingSystem.cxx; the 5/6-byte
    ; forms are unreachable, chars are capped at 0x10FFFF).
    function put_utf8(acc: pointer[Array[u8]], c: u32)
    {
        if c < (0x80 as u32)
            acc.add(c as u8)
        else if c < (0x800 as u32)
        {
            acc.add(((0xC0 as u32) | (c >> (6 as u32))) as u8)
            acc.add(((0x80 as u32) | (c & (0x3F as u32))) as u8)
        }
        else if c < (0x10000 as u32)
        {
            acc.add(((0xE0 as u32) | (c >> (12 as u32))) as u8)
            acc.add(((0x80 as u32) | ((c >> (6 as u32)) & (0x3F as u32))) as u8)
            acc.add(((0x80 as u32) | (c & (0x3F as u32))) as u8)
        }
        else
        {
            acc.add(((0xF0 as u32) | (c >> (18 as u32))) as u8)
            acc.add(((0x80 as u32) | ((c >> (12 as u32)) & (0x3F as u32))) as u8)
            acc.add(((0x80 as u32) | ((c >> (6 as u32)) & (0x3F as u32))) as u8)
            acc.add(((0x80 as u32) | (c & (0x3F as u32))) as u8)
        }
    }

    ; one Char through the active output coding system (see the header note):
    ; Identity emits the raw byte for c <= 0xFF and escapes the rest; UTF-8
    ; always encodes (nothing valid is unencodable there).
    function put_char(acc: pointer[Array[u8]], c: u32, utf8: bool)
    {
        if utf8
        {
            Esis.put_utf8(acc, c)
            return
        }
        if c < (0x100 as u32)
            acc.add(c as u8)
        else
            Esis.put_esc(acc, c)
    }

    ; append a StringC as a name (no escaping; GIs/attr names are already
    ; reference-syntax name characters) through the output encoder — the
    ; escaper is set on the whole stream, so names take the same path as data.
    function put_name(acc: pointer[Array[u8]], sc: StringC, utf8: bool)
    {
        let n sc.get_size()
        var i: size_t 0
        while i < n
        {
            Esis.put_char(acc, sc.get(i), utf8)
            set i: i + 1
        }
    }

    ; append a StringC as ESIS data with the C++ outputString escaping. The
    ; control-char / '\' / RE escapes run BEFORE the coding system (they are
    ; outputString's, upstream of the encoder); only the default arm is
    ; encoding-dependent.
    function put_data(acc: pointer[Array[u8]], sc: StringC, utf8: bool)
    {
        let n sc.get_size()
        var i: size_t 0
        while i < n
        {
            let c sc.get(i)
            if c = (0x5C as u32)
            {
                acc.add(0x5C as u8)
                acc.add(0x5C as u8)
            }
            else if c = (0x0D as u32)
            {
                acc.add(0x5C as u8)
                acc.add(0x6E as u8)
            }
            else if c < (0x20 as u32)
            {
                acc.add(0x5C as u8)
                acc.add(0x30 as u8)
                let d1 (c / (8 as u32)) % (8 as u32)
                let d2 c % (8 as u32)
                acc.add(((0x30 as u32) + d1) as u8)
                acc.add(((0x30 as u32) + d2) as u8)
            }
            else
                Esis.put_char(acc, c, utf8)
            set i: i + 1
        }
    }

    ; outputString over an 8-bit String (system/public identifiers) — the same
    ; escaping as put_data, byte-wise.
    function put_data_bytes(acc: pointer[Array[u8]], s: String, utf8: bool)
    {
        let n s.get_length()
        var i: size_t 0
        while i < n
        {
            let c s.get(i) as u32
            if c = (0x5C as u32)
            {
                acc.add(0x5C as u8)
                acc.add(0x5C as u8)
            }
            else if c = (0x0D as u32)
            {
                acc.add(0x5C as u8)
                acc.add(0x6E as u8)
            }
            else if c < (0x20 as u32)
            {
                acc.add(0x5C as u8)
                acc.add(0x30 as u8)
                let d1 (c / (8 as u32)) % (8 as u32)
                let d2 c % (8 as u32)
                acc.add(((0x30 as u32) + d1) as u8)
                acc.add(((0x30 as u32) + d2) as u8)
            }
            else
                Esis.put_char(acc, c, utf8)
            set i: i + 1
        }
    }

    ; SgmlsEventHandler::markEntity/markNotation — StringSet::add: true when
    ; the name was already output this document, else remember it. Names alias
    ; run-page StringCs (stable for the writer's lifetime).
    function mark(seen: pointer[Array[StringC]], name: StringC) returns bool
    {
        let n seen.get_length()
        var i: size_t 0
        while i < n
        {
            let s *(seen.get_buffer() + i)
            if s.equals(name)
                return true
            set i: i + 1
        }
        seen.add(name)
        false
    }

    ; ---- stateful writers (the SgmlsEventHandler members) -----------------

    function start_data(w: pointer[EsisW])
    {
        if w.have_data = false
        {
            Esis.put(w.acc, 0x2D as u8)
            set w.have_data: true
        }
    }

    function flush_data(w: pointer[EsisW])
    {
        if w.have_data
        {
            Esis.put(w.acc, 0x0A as u8)
            set w.have_data: false
        }
    }

    ; outputString INSIDE the writer state: RE chars written while a data run
    ; is open advance the -oline line tracker (outputString's lastLineno_++ —
    ; multi-line data runs then need no L record per line).
    function w_data(w: pointer[EsisW], sc: StringC)
    {
        Esis.put_data(w.acc, sc, w.utf8)
        if w.have_data and ((w.flags & OF_LINE) <> (0 as u32))
        {
            let n sc.get_size()
            var i: size_t 0
            while i < n
            {
                if sc.get(i) = (0x0D as u32)
                    set w.last_lineno: w.last_lineno + (1 as u32)
                set i: i + 1
            }
        }
    }

    function w_data_bytes(w: pointer[EsisW], s: String)
    {
        Esis.put_data_bytes(w.acc, s, w.utf8)
        if w.have_data and ((w.flags & OF_LINE) <> (0 as u32))
        {
            let n s.get_length()
            var i: size_t 0
            while i < n
            {
                if (s.get(i) as u32) = (0x0D as u32)
                    set w.last_lineno: w.last_lineno + (1 as u32)
                set i: i + 1
            }
        }
    }

    ; SgmlsEventHandler::outputLocation/outputLocation1 (-oline): resolve the
    ; event's location to its real source (the same origin walk the message
    ; header uses); a change of source prints `L<line> <storage id>`, a change
    ; of line within the same source prints `L<line>`, anything else nothing.
    function out_loc(w: pointer[EsisW], loc: Location)
    {
        if (w.flags & OF_LINE) = (0 as u32)
            return
        var line: u32 0
        var col: u32 0
        let ps w.ps
        ; the outputLocation1 walk — NOT the message walk: parent index
        ; without the reference length, previous-line rule on inserted RS.
        let org ps.resolve_location_sos(loc, &line, &col)
        if org = null
            return
        if org = w.last_sos
        {
            if line = w.last_lineno
                return
            Esis.flush_data(w)
            Esis.put(w.acc, 0x4C as u8)
            Esis.put_dec(w.acc, line)
            Esis.put(w.acc, 0x0A as u8)
            set w.last_lineno: line
            return
        }
        Esis.flush_data(w)
        Esis.put(w.acc, 0x4C as u8)
        Esis.put_dec(w.acc, line)
        Esis.put(w.acc, 0x20 as u8)
        ; soLoc.actualStorageId — the storage object's id WITHOUT the manager
        ; prefix: the stdin document displays `<OSFD>0` in message headers but
        ; `0` here (probed). File names carry no prefix.
        var fname org.get_file_name()
        let pfx StringC("<OSFD>")
        let pn pfx.get_size()
        if fname.get_size() > pn
        {
            var is_fd true
            var pi: size_t 0
            while pi < pn
            {
                if fname.get(pi) <> pfx.get(pi)
                {
                    set is_fd: false
                    set pi: pn
                }
                else
                    set pi: pi + 1
            }
            if is_fd
                set fname: StringC(fname.data_ptr() + pn, fname.get_size() - pn)
        }
        Esis.w_data(w, fname)
        Esis.put(w.acc, 0x0A as u8)
        set w.last_lineno: line
        set w.last_sos: org
    }

    ; SgmlsEventHandler::externalId (:585): p<pubid> / s<sysid> and, when
    ; `output_file`, f<effective system id> — the storage id generateSystemId
    ; stamped (declared system id resolved against the declaring directory, or
    ; the catalog's SYSTEM/PUBLIC/name mapping), printed only when non-empty.
    ; `base_dir` backs the pre-stamping fallback (a declared system id whose
    ; entity never ran generateSystemId).
    function put_external_id(w: pointer[EsisW], id: ExternalId, base_dir: String, output_file: bool)
    {
        if id.has_public_id()
        {
            Esis.put(w.acc, 0x70 as u8)
            Esis.w_data_bytes(w, id.get_public_id())
            Esis.put(w.acc, 0x0A as u8)
        }
        if id.has_system_id()
        {
            Esis.put(w.acc, 0x73 as u8)
            Esis.w_data_bytes(w, id.get_system_id())
            Esis.put(w.acc, 0x0A as u8)
        }
        if output_file
        {
            if id.has_effective_system()
            {
                ; the effective system id is stored as the FULL FSI text
                ; (`<OSFILE>path`, `<CATALOG PUBLIC="...">...` for delegate
                ; hits) — printed verbatim.
                let eff id.get_effective_system()
                if eff.get_length() > (0 as size_t)
                {
                    Esis.put(w.acc, 0x66 as u8)
                    Esis.w_data_bytes(w, eff)
                    Esis.put(w.acc, 0x0A as u8)
                }
            }
            else if id.has_system_id()
            {
                Esis.put(w.acc, 0x66 as u8)
                Esis.put_lit(w.acc, String("<OSFILE>"))
                let joined Path.join(base_dir, id.get_system_id())
                Esis.w_data_bytes(w, joined)
                Esis.put(w.acc, 0x0A as u8)
            }
        }
    }

    ; SgmlsEventHandler::defineNotation (:575) — marks itself; a repeat is
    ; silent. The f-line prints only under -onotation-sysid.
    function define_notation(w: pointer[EsisW], nt: pointer[Notation])
    {
        let nm nt.get_name()
        if Esis.mark(w.seen_n, nm)
            return
        let id nt.get_external_id()
        Esis.put_external_id(w, id, String(), (w.flags & OF_NOTATION_SYSID) <> (0 as u32))
        Esis.put(w.acc, 0x4E as u8)
        Esis.put_name(w.acc, nm, w.utf8)
        Esis.put(w.acc, 0x0A as u8)
    }

    ; SgmlsEventHandler::defineEntity (:488) — the CALLER checks markEntity
    ; first (both the attribute and the `&` reference sites), exactly like the
    ; reference; the -oentity endProlog sweep and the entity-defaulted replay
    ; call it directly (no mark — reference behavior).
    ;   internal        I<name> <CDATA|SDATA|TEXT|PI> <text>
    ;   external data   the notation's definition, p/s/f, E<name> <TYPE> <not>,
    ;                   then the entity's data attributes as D records
    ;   subdoc          p/s/f, S<name>
    ;   external text   p/s/f, T<name>
    function define_entity(w: pointer[EsisW], ent: pointer[Entity])
    {
        choose *ent
            when i: Internal
            {
                Esis.put(w.acc, 0x49 as u8)
                Esis.put_name(w.acc, i.get_name(), w.utf8)
                Esis.put(w.acc, 0x20 as u8)
                let dt i.get_data_type()
                if dt = DT_CDATA
                    Esis.put_lit(w.acc, String("CDATA "))
                else if dt = DT_SDATA
                    Esis.put_lit(w.acc, String("SDATA "))
                else if dt = DT_PI
                    Esis.put_lit(w.acc, String("PI "))
                else
                    Esis.put_lit(w.acc, String("TEXT "))
                Esis.w_data(w, i.get_text())
                Esis.put(w.acc, 0x0A as u8)
            }
            when e: ExternalText
            {
                Esis.put_external_id(w, e.get_external_id(), e.get_base_dir(), true)
                Esis.put(w.acc, 0x54 as u8)
                Esis.put_name(w.acc, e.get_name(), w.utf8)
                Esis.put(w.acc, 0x0A as u8)
            }
            when d: ExternalData
            {
                let nt d.get_notation() as pointer[Notation]
                Esis.define_notation(w, nt)
                Esis.put_external_id(w, d.get_external_id(), d.get_base_dir(), true)
                Esis.put(w.acc, 0x45 as u8)
                let dname d.get_name()
                Esis.put_name(w.acc, dname, w.utf8)
                Esis.put(w.acc, 0x20 as u8)
                let ddt d.get_data_type()
                if ddt = DT_CDATA
                    Esis.put_lit(w.acc, String("CDATA "))
                else if ddt = DT_SDATA
                    Esis.put_lit(w.acc, String("SDATA "))
                else
                    Esis.put_lit(w.acc, String("NDATA "))
                let ntname nt.get_name()
                Esis.put_name(w.acc, ntname, w.utf8)
                Esis.put(w.acc, 0x0A as u8)
                let datts d.get_attributes() as pointer[AttributeList]
                Esis.put_attributes(w, datts, 0x44 as u8, &dname)
            }
            when sub: Subdoc
            {
                Esis.put_external_id(w, sub.get_external_id(), sub.get_base_dir(), true)
                Esis.put(w.acc, 0x53 as u8)
                Esis.put_name(w.acc, sub.get_name(), w.utf8)
                Esis.put(w.acc, 0x0A as u8)
            }
    }

    ; the CDATA value body (SgmlsEventHandler::attributes' TextIter loop):
    ; data segments print plain, sdata runs between `\|` markers, non-SGML
    ; items as `\%N;` under -ononsgml (dropped otherwise). Both item lists are
    ; flat position-sorted pairs into the value string.
    function put_value_cdata(w: pointer[EsisW], v: pointer[AttributeValue])
    {
        let vs v.get_string()
        let vt v.get_text()
        var runs: pointer[Array[size_t]] null
        var nsi: pointer[Array[size_t]] null
        if vt <> null
        {
            set runs: (*vt).get_sdata_runs()
            set nsi: (*vt).get_nonsgml_items()
        }
        if (runs = null) and (nsi = null)
        {
            Esis.w_data(w, vs)
            return
        }
        let vn vs.get_size()
        var nr: size_t 0
        if runs <> null
            set nr: runs.get_length()
        var nn: size_t 0
        if nsi <> null
            set nn: nsi.get_length()
        var pos: size_t 0
        var ri: size_t 0
        var ni: size_t 0
        var going true
        while going
        {
            if (ri >= nr) and (ni >= nn)
            {
                if vn > pos
                {
                    let tail StringC(vs.data_ptr() + pos, vn - pos)
                    Esis.w_data(w, tail)
                }
                set going: false
            }
            else
            {
                ; the next item by position (sdata wins a tie — insertion order).
                var next_s vn
                if ri < nr
                {
                    set next_s: *(runs.get_buffer() + ri)
                    if next_s > vn
                        set next_s: vn
                }
                var next_n vn
                if ni < nn
                {
                    set next_n: *(nsi.get_buffer() + ni)
                    if next_n > vn
                        set next_n: vn
                }
                var take_sdata ri < nr
                if take_sdata and (ni < nn)
                    if next_n < next_s
                        set take_sdata: false
                if take_sdata
                {
                    var rs next_s
                    var re *(runs.get_buffer() + ri + (1 as size_t))
                    if re > vn
                        set re: vn
                    if rs > pos
                    {
                        let seg_before StringC(vs.data_ptr() + pos, rs - pos)
                        Esis.w_data(w, seg_before)
                    }
                    Esis.put(w.acc, 0x5C as u8)
                    Esis.put(w.acc, 0x7C as u8)
                    if re > rs
                    {
                        let seg_sdata StringC(vs.data_ptr() + rs, re - rs)
                        Esis.w_data(w, seg_sdata)
                    }
                    Esis.put(w.acc, 0x5C as u8)
                    Esis.put(w.acc, 0x7C as u8)
                    set pos: re
                    set ri: ri + (2 as size_t)
                }
                else
                {
                    if next_n > pos
                    {
                        let seg_before StringC(vs.data_ptr() + pos, next_n - pos)
                        Esis.w_data(w, seg_before)
                    }
                    let nc *(nsi.get_buffer() + ni + (1 as size_t))
                    if (w.flags & OF_NONSGML) <> (0 as u32)
                    {
                        Esis.put(w.acc, 0x5C as u8)
                        Esis.put(w.acc, 0x25 as u8)
                        Esis.put_dec(w.acc, nc as u32)
                        Esis.put(w.acc, 0x3B as u8)
                    }
                    set pos: next_n
                    set ni: ni + (2 as size_t)
                }
            }
        }
    }

    ; A<NAME> <TYPE> <VALUE> for each attribute in the list that has a value
    ; (SgmlsEventHandler::attributes, :330). `code` is 'A' for start-tag
    ; attributes, 'D' for an entity's data attributes, 'a' for link-rule
    ; attributes (`owner` then prefixes the attribute name). A tokenized value
    ; WITH semantics first prints the definitions its value references — the
    ; notation, or (without -oentity) each not-yet-output entity — and types
    ; the line NOTATION / ENTITY instead of TOKEN; -oid types ID declared
    ; values as ID. -oattromit prints an `o` record before each attribute the
    ; instance did not specify.
    function put_attributes(w: pointer[EsisW], atts: pointer[AttributeList], code: u8, owner: pointer[StringC])
    {
        if atts = null
            return
        let n atts.size()
        var i: size_t 0
        while i < n
        {
            let v atts.value(i)
            if v <> null
            {
                if (w.flags & OF_ATTR_OMISSION) <> (0 as u32)
                {
                    if atts.specified(i) = false
                    {
                        Esis.put(w.acc, 0x6F as u8)
                        Esis.put(w.acc, 0x0A as u8)
                    }
                }
                let ty v.value_type()
                ; 0 TOKEN, 1 NOTATION, 2 ENTITY, 3 ID
                var tkind: int 0
                if ty = AVT_TOKENIZED
                {
                    let a atts.attribute(i)
                    let sem a.get_semantics()
                    if sem <> null
                    {
                        let ntv sem.get_notation()
                        if ntv <> null
                        {
                            Esis.define_notation(w, ntv as pointer[Notation])
                            set tkind: 1
                        }
                        else
                        {
                            let ne sem.n_entities()
                            if ne > (0 as size_t)
                            {
                                set tkind: 2
                                if (w.flags & OF_ENTITY) = (0 as u32)
                                {
                                    var j: size_t 0
                                    while j < ne
                                    {
                                        let ent sem.entity(j) as pointer[Entity]
                                        let en ent.get_name()
                                        if Esis.mark(w.seen_e, en) = false
                                            Esis.define_entity(w, ent)
                                        set j: j + 1
                                    }
                                }
                            }
                        }
                    }
                    ; outputId: an ID declared value types as ID.
                    if (w.flags & OF_ID) <> (0 as u32)
                    {
                        if atts.id(i)
                            set tkind: 3
                    }
                }
                ; -odata-attribute: a DATA declared value's CDATA carries its
                ; notation; the A line types `DATA <notation>` and the value's
                ; data attributes follow as D records.
                var data_nt: pointer[Notation] null
                if ty = AVT_CDATA
                {
                    if (w.flags & OF_DATA_ATT) <> (0 as u32)
                    {
                        let dntv v.get_cdata_notation()
                        if dntv <> null
                            set data_nt: dntv as pointer[Notation]
                    }
                }
                Esis.put(w.acc, code)
                if owner <> null
                {
                    Esis.put_name(w.acc, *owner, w.utf8)
                    Esis.put(w.acc, 0x20 as u8)
                }
                Esis.put_name(w.acc, atts.name(i), w.utf8)
                Esis.put(w.acc, 0x20 as u8)
                if ty = AVT_IMPLIED
                    Esis.put_lit(w.acc, String("IMPLIED"))
                else if ty = AVT_CDATA
                {
                    if data_nt <> null
                    {
                        Esis.put_lit(w.acc, String("DATA "))
                        Esis.put_name(w.acc, data_nt.get_name(), w.utf8)
                        Esis.put(w.acc, 0x20 as u8)
                    }
                    else
                        Esis.put_lit(w.acc, String("CDATA "))
                    Esis.put_value_cdata(w, v)
                }
                else
                {
                    if tkind = 1
                        Esis.put_lit(w.acc, String("NOTATION "))
                    else if tkind = 2
                        Esis.put_lit(w.acc, String("ENTITY "))
                    else if tkind = 3
                        Esis.put_lit(w.acc, String("ID "))
                    else
                        Esis.put_lit(w.acc, String("TOKEN "))
                    Esis.w_data(w, v.get_string())
                }
                Esis.put(w.acc, 0x0A as u8)
                if data_nt <> null
                {
                    Esis.define_notation(w, data_nt)
                    let datts2 v.get_data_attributes() as pointer[AttributeList]
                    let aname atts.name(i)
                    ; always the D code (dataAttributeCode), whatever `code`
                    ; the parent list used (SgmlsEventHandler.cxx:416).
                    Esis.put_attributes(w, datts2, 0x44 as u8, &aname)
                }
            }
            set i: i + 1
        }
    }

    ; StartElementEvent::mustOmitEnd — EMPTY declared content or a specified
    ; CONREF attribute (-oempty's `e` record).
    function must_omit_end(ev: pointer[Event]) returns bool
    {
        let e ev.get_element_type()
        if e <> null
        {
            let def e.get_definition()
            if def <> null
                if def.get_declared_content() = DC_EMPTY
                    return true
        }
        let atts ev.get_attributes()
        if atts <> null
            return atts.conref_of()
        false
    }

    ; SgmlsEventHandler::features (-oversion): the V parser-information block,
    ; written once before everything (handler construction time).
    function features(w: pointer[EsisW])
    {
        Esis.put_lit(w.acc, String("Vp OpenSP\n"))
        Esis.put_lit(w.acc, String("Vv 1.5.2\n"))
        Esis.put_lit(w.acc, String("Vc -?C#()&ADaNEISTps{}fLie_oV\n"))
        Esis.put_lit(w.acc, String("Vo esis"))
        ; the outputOptions table from index 1 (the leading "all" is skipped):
        ; every entry whose flag intersects prints — "omitted" fires on EITHER
        ; omission bit, and tagomit/attromit re-print their own names.
        if (w.flags & OF_LINE) <> (0 as u32)
            Esis.put_lit(w.acc, String(" line"))
        if (w.flags & OF_ENTITY) <> (0 as u32)
            Esis.put_lit(w.acc, String(" entity"))
        if (w.flags & OF_ID) <> (0 as u32)
            Esis.put_lit(w.acc, String(" id"))
        if (w.flags & OF_INCLUDED) <> (0 as u32)
            Esis.put_lit(w.acc, String(" included"))
        if (w.flags & OF_NOTATION_SYSID) <> (0 as u32)
            Esis.put_lit(w.acc, String(" notation-sysid"))
        if (w.flags & OF_NONSGML) <> (0 as u32)
            Esis.put_lit(w.acc, String(" nonsgml"))
        if (w.flags & OF_EMPTY) <> (0 as u32)
            Esis.put_lit(w.acc, String(" empty"))
        if (w.flags & OF_DATA_ATT) <> (0 as u32)
            Esis.put_lit(w.acc, String(" data-attribute"))
        if (w.flags & OF_COMMENT) <> (0 as u32)
            Esis.put_lit(w.acc, String(" comment"))
        if (w.flags & (OF_TAG_OMISSION | OF_ATTR_OMISSION)) <> (0 as u32)
            Esis.put_lit(w.acc, String(" omitted"))
        if (w.flags & OF_TAG_OMISSION) <> (0 as u32)
            Esis.put_lit(w.acc, String(" tagomit"))
        if (w.flags & OF_ATTR_OMISSION) <> (0 as u32)
            Esis.put_lit(w.acc, String(" attromit"))
        if (w.flags & OF_PARSER_INFO) <> (0 as u32)
            Esis.put_lit(w.acc, String(" version"))
        Esis.put(w.acc, 0x0A as u8)
    }

    ; walk the event queue -> the ESIS byte String.
    function write(host: pointer[Page], ps: pointer[ParserState], conforming: bool) returns String
    {
        let acc Array[u8]^host()
        let w host.allocate(sizeof EsisW, alignof EsisW) as pointer[EsisW]
        set w.acc: acc
        set w.utf8: ps.get_output_utf8()
        set w.flags: ps.get_output_flags()
        set w.have_data: false
        set w.in_document: false
        set w.last_sos: null
        set w.last_lineno: 0 as u32
        set w.ps: ps
        let se0 Array[StringC]^host()
        let sn0 Array[StringC]^host()
        set w.seen_e: se0
        set w.seen_n: sn0
        ; SgmlsSubdocState::swap — the saved outer seen-sets, one level per
        ; open subdocument (depth-indexed; Array has no remove, slots are
        ; overwritten on re-push).
        let stack_e Array[pointer[Array[StringC]]]^host()
        let stack_n Array[pointer[Array[StringC]]]^host()
        var sub_depth: size_t 0
        if (w.flags & OF_PARSER_INFO) <> (0 as u32)
            Esis.features(w)
        let n ps.n_events()
        var k: size_t 0
        while k < n
        {
            let ev ps.get_event(k)
            let ty ev.get_type()
            if ty = EV_DATA
            {
                Esis.out_loc(w, ev.get_loc())
                Esis.start_data(w)
                Esis.w_data(w, ev.get_data())
            }
            else if ty = EV_SDATA
            {
                ; SgmlsEventHandler::sdataEntity (:255) — startData() (the run
                ; CONTINUES), then `\|` + escaped text + `\|` inline.
                Esis.out_loc(w, ev.get_loc())
                Esis.start_data(w)
                Esis.put(w.acc, 0x5C as u8)
                Esis.put(w.acc, 0x7C as u8)
                Esis.w_data(w, ev.get_data())
                Esis.put(w.acc, 0x5C as u8)
                Esis.put(w.acc, 0x7C as u8)
            }
            else if ty = EV_NONSGML
            {
                ; SgmlsEventHandler::nonSgmlChar (:292) — only under -ononsgml:
                ; the run continues with the `\%N;` escape.
                if (w.flags & OF_NONSGML) <> (0 as u32)
                {
                    Esis.out_loc(w, ev.get_loc())
                    Esis.start_data(w)
                    let nsc ev.get_data()
                    Esis.put(w.acc, 0x5C as u8)
                    Esis.put(w.acc, 0x25 as u8)
                    Esis.put_dec(w.acc, nsc.get(0 as size_t))
                    Esis.put(w.acc, 0x3B as u8)
                }
            }
            else if ty = EV_START_ELEMENT
            {
                Esis.flush_data(w)
                ; link-rule attributes first (SgmlsEventHandler::startElement:
                ; the `a<lpdname> ...` records precede the `A` records).
                let latts ev.get_link_attributes()
                if latts <> null
                    Esis.put_attributes(w, latts, 0x61 as u8, ev.get_link_owner())
                Esis.put_attributes(w, ev.get_attributes(), 0x41 as u8, null)
                ; -otagomit / -oincluded / -oempty records, then the -oline
                ; L record, then the `(` line (reference order :320-327).
                if (w.flags & OF_TAG_OMISSION) <> (0 as u32)
                {
                    if ev.get_has_markup() = false
                    {
                        Esis.put(w.acc, 0x6F as u8)
                        Esis.put(w.acc, 0x0A as u8)
                    }
                }
                if (w.flags & OF_INCLUDED) <> (0 as u32)
                {
                    if ev.is_included()
                    {
                        Esis.put(w.acc, 0x69 as u8)
                        Esis.put(w.acc, 0x0A as u8)
                    }
                }
                if (w.flags & OF_EMPTY) <> (0 as u32)
                {
                    if Esis.must_omit_end(ev)
                    {
                        Esis.put(w.acc, 0x65 as u8)
                        Esis.put(w.acc, 0x0A as u8)
                    }
                }
                Esis.out_loc(w, ev.get_markup_loc())
                Esis.put(w.acc, 0x28 as u8)
                Esis.put_name(w.acc, ev.get_element_type().get_name(), w.utf8)
                Esis.put(w.acc, 0x0A as u8)
            }
            else if ty = EV_END_ELEMENT
            {
                ; reference order (:437): flush, L record, `o`, `)` line.
                Esis.flush_data(w)
                Esis.out_loc(w, ev.get_markup_loc())
                if (w.flags & OF_TAG_OMISSION) <> (0 as u32)
                {
                    if ev.get_has_markup() = false
                    {
                        Esis.put(w.acc, 0x6F as u8)
                        Esis.put(w.acc, 0x0A as u8)
                    }
                }
                Esis.put(w.acc, 0x29 as u8)
                Esis.put_name(w.acc, ev.get_element_type().get_name(), w.utf8)
                Esis.put(w.acc, 0x0A as u8)
            }
            else if ty = EV_PI
            {
                ; SgmlsEventHandler::pi — location, flushData(), `?` + data + RE.
                Esis.out_loc(w, ev.get_loc())
                Esis.flush_data(w)
                Esis.put(w.acc, 0x3F as u8)
                Esis.w_data(w, ev.get_data())
                Esis.put(w.acc, 0x0A as u8)
            }
            else if ty = EV_APPINFO
            {
                ; SgmlsEventHandler::appinfo — location, flushData(), `#` + RE.
                Esis.out_loc(w, ev.get_loc())
                Esis.flush_data(w)
                Esis.put(w.acc, 0x23 as u8)
                Esis.w_data(w, ev.get_data())
                Esis.put(w.acc, 0x0A as u8)
            }
            else if ty = EV_COMMENT
            {
                ; SgmlsEventHandler::commentDecl — only once the document has
                ; started (inDocument_), one `_` record per comment segment.
                if w.in_document
                {
                    Esis.out_loc(w, ev.get_loc())
                    Esis.flush_data(w)
                    let segs ev.get_comments()
                    if segs <> null
                    {
                        let nsg segs.get_length()
                        var sgi: size_t 0
                        while sgi < nsg
                        {
                            let seg *(segs.get_buffer() + sgi)
                            Esis.put(w.acc, 0x5F as u8)
                            Esis.w_data(w, seg)
                            Esis.put(w.acc, 0x0A as u8)
                            set sgi: sgi + 1
                        }
                    }
                }
            }
            else if ty = EV_ENTITY_REF
            {
                ; SgmlsEventHandler::externalDataEntity (:448): location, flush
                ; the data run, print the entity's definition on first use
                ; (suppressed under -oentity — the endProlog sweep already
                ; defined everything), then the `&name` reference line.
                Esis.out_loc(w, ev.get_loc())
                Esis.flush_data(w)
                let rent ev.get_entity()
                let rname rent.get_name()
                if (w.flags & OF_ENTITY) = (0 as u32)
                {
                    if Esis.mark(w.seen_e, rname) = false
                        Esis.define_entity(w, rent)
                }
                Esis.put(w.acc, 0x26 as u8)
                Esis.put_name(w.acc, rname, w.utf8)
                Esis.put(w.acc, 0x0A as u8)
            }
            else if ty = EV_ENTITY_DEFAULTED
            {
                ; SgmlsEventHandler::entityDefaulted + the lookup re-dispatch:
                ; -oentity re-prints the definition at every reference.
                if (w.flags & OF_ENTITY) <> (0 as u32)
                {
                    Esis.flush_data(w)
                    Esis.define_entity(w, ev.get_entity())
                }
            }
            else if ty = EV_START_SUBDOC
            {
                ; SgmlsEventHandler::subdocEntity (:461): location, flush,
                ; define the subdoc entity on first use, `{name`, then fresh
                ; per-subdocument seen-sets (SgmlsSubdocState::init).
                Esis.out_loc(w, ev.get_loc())
                Esis.flush_data(w)
                let sent ev.get_entity()
                let sname sent.get_name()
                if (w.flags & OF_ENTITY) = (0 as u32)
                {
                    if Esis.mark(w.seen_e, sname) = false
                        Esis.define_entity(w, sent)
                }
                Esis.put(w.acc, 0x7B as u8)
                Esis.put_name(w.acc, sname, w.utf8)
                Esis.put(w.acc, 0x0A as u8)
                if sub_depth < stack_e.get_length()
                {
                    stack_e.put(sub_depth, w.seen_e)
                    stack_n.put(sub_depth, w.seen_n)
                }
                else
                {
                    stack_e.add(w.seen_e)
                    stack_n.add(w.seen_n)
                }
                set sub_depth: sub_depth + (1 as size_t)
                let fe Array[StringC]^host()
                let fn Array[StringC]^host()
                set w.seen_e: fe
                set w.seen_n: fn
            }
            else if ty = EV_END_PROLOG
            {
                ; SgmlsEventHandler::endProlog — under -oentity first define
                ; EVERY general entity of the DTD (bucket order), then the
                ; comment gate opens, then the active SIMPLE link types'
                ; attribute lists print as `a<linkname> <att> ...` records.
                let ges ev.get_general_entities()
                if ges <> null
                {
                    if (w.flags & OF_ENTITY) <> (0 as u32)
                    {
                        Esis.flush_data(w)
                        let ngs ges.get_length()
                        var gei: size_t 0
                        while gei < ngs
                        {
                            let ge *(ges.get_buffer() + gei)
                            Esis.define_entity(w, ge)
                            set gei: gei + 1
                        }
                    }
                }
                if (w.flags & OF_COMMENT) <> (0 as u32)
                    set w.in_document: true
                let sl_names ev.get_simple_link_names()
                if sl_names <> null
                {
                    let sl_atts ev.get_simple_link_atts()
                    let nsl sl_names.get_length()
                    var sli: size_t 0
                    while sli < nsl
                    {
                        Esis.flush_data(w)
                        let sname sl_names.get_buffer() + sli
                        let satts *(sl_atts.get_buffer() + sli)
                        Esis.put_attributes(w, satts, 0x61 as u8, sname)
                        set sli: sli + 1
                    }
                }
            }
            else if ty = EV_END_SUBDOC
            {
                ; `}name` — restore the outer seen-sets first (the reference
                ; swaps back before writing the bracket).
                Esis.flush_data(w)
                if sub_depth > (0 as size_t)
                {
                    set sub_depth: sub_depth - (1 as size_t)
                    set w.seen_e: *(stack_e.get_buffer() + sub_depth)
                    set w.seen_n: *(stack_n.get_buffer() + sub_depth)
                }
                Esis.put(w.acc, 0x7D as u8)
                Esis.put_name(w.acc, ev.get_entity().get_name(), w.utf8)
                Esis.put(w.acc, 0x0A as u8)
            }
            set k: k + 1
        }
        Esis.flush_data(w)
        ; The conformance marker `C` is written iff the document conformed
        ; (SgmlsEventHandler dtor) — onsgmls's invariant is C present <=> exit 0.
        ; A failed parse that recorded no message (e.g. an unresolved external
        ; DTD subset) is still non-conforming, so `n_errors==0` alone is not
        ; enough — the caller passes the same decision that sets the exit code.
        if conforming
        {
            Esis.put(acc, 0x43 as u8)
            Esis.put(acc, 0x0A as u8)
        }
        let len acc.get_length()
        let out host.allocate(len + (1 as size_t), 1) as pointer[u8]
        let src acc.get_buffer()
        var j: size_t 0
        while j < len
        {
            set *(out + j): *(src + j)
            set j: j + 1
        }
        set *(out + len): (0 as u8)
        String(out as pointer[const_char], len)
    }

    ; ---- self-test: escaping over a controlled StringC --------------------
    function test() returns int
    {
        let anchor StringC("x")
        let host Page.get(anchor.data_ptr() as pointer[void])

        ; data escaping: "a<TAB>b\<RE>c" -> "a\011b\\\nc"
        let acc Array[u8]^host()
        var raw u32[5]
        let rp raw as pointer[u32]
        set *(rp + (0 as size_t)): 0x61 as u32
        set *(rp + (1 as size_t)): 0x09 as u32
        set *(rp + (2 as size_t)): 0x62 as u32
        set *(rp + (3 as size_t)): 0x5C as u32
        set *(rp + (4 as size_t)): 0x0D as u32
        let sc StringC(rp, 5 as size_t)
        Esis.put_data(acc, sc, false)
        let got String(acc.get_buffer() as pointer[const_char], acc.get_length())
        if got.equals(String("a\\011b\\\\\\n")) = false
            return -1

        ; UTF-8 output: U+00FC -> C3 BC, U+FFFD -> EF BF BD (the two shapes the
        ; XML-encoding decoder actually produces), ASCII still identity.
        let acc2 Array[u8]^host()
        var raw2 u32[3]
        let rp2 raw2 as pointer[u32]
        set *(rp2 + (0 as size_t)): 0x7A as u32     ; 'z'
        set *(rp2 + (1 as size_t)): 0xFC as u32     ; 'ü'
        set *(rp2 + (2 as size_t)): 0xFFFD as u32   ; U+FFFD
        let sc2 StringC(rp2, 3 as size_t)
        Esis.put_data(acc2, sc2, true)
        if acc2.get_length() <> (6 as size_t)
            return -2
        let b2 acc2.get_buffer()
        if *(b2 + (0 as size_t)) <> (0x7A as u8)
            return -3
        if *(b2 + (1 as size_t)) <> (0xC3 as u8)
            return -4
        if *(b2 + (2 as size_t)) <> (0xBC as u8)
            return -5
        if *(b2 + (3 as size_t)) <> (0xEF as u8)
            return -6
        if *(b2 + (4 as size_t)) <> (0xBF as u8)
            return -7
        if *(b2 + (5 as size_t)) <> (0xBD as u8)
            return -8

        ; identity output (the default coding system): c <= 0xFF -> the raw
        ; byte; c >= 0x100 -> the `\#N;` escape. Same input Chars as above:
        ; z ü U+FFFD -> 7A FC "\#65533;".
        let acc3 Array[u8]^host()
        Esis.put_data(acc3, sc2, false)
        let got3 String(acc3.get_buffer() as pointer[const_char], acc3.get_length())
        if got3.get_length() <> (10 as size_t)
            return -9
        if got3.get(0) <> (0x7A as u8)
            return -10
        if got3.get(1) <> (0xFC as u8)
            return -11
        let b3 acc3.get_buffer()
        let esc3 String((b3 + (2 as size_t)) as pointer[const_char], 8 as size_t)
        if esc3.equals(String("\\#65533;")) = false
            return -12
        0
    }
}
