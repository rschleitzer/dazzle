use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.Location.Location
use opensp.Location.Origin
use opensp.Location.InputSource

; Id — Id.cs (65 LOC). The id-table record for one ID attribute value: the name,
; the defining location (once the ID has been declared by an ELEMENT that
; carries it), and the list of pending IDREF locations recorded BEFORE the ID was
; defined (so forward references that never resolve can be reported). C++'s
; `Id : Named` base -> a `name` field; the `Vector<Location> pendingRefs_` -> an
; `Array[Location]` (grows within the run, never shrinks).
;
; PORT SHAPE: page-hosted flat struct (referenced by identity from the parser's
; NamedTable<Id> id table). `defined()` mirrors C++: an ID is defined once its
; defLocation_ has a non-null origin.

define Id (name: StringC, def_loc: Location, pending_refs: pointer[Array[Location]])
{
    function make(host: pointer[Page], name: StringC) returns pointer[Id]
    {
        let id host.allocate(sizeof Id, alignof Id) as pointer[Id]
        set id.name: name
        set id.def_loc: Location()
        set id.pending_refs: Array[Location]^host()
        id
    }

    function get_name(this: Id) returns StringC
        name

    ; define(loc) [renamed: `define` is a Scaly keyword]: record the defining
    ; location and release the pending refs (C++ swaps pendingRefs_ with a fresh
    ; empty vector — the arena makes the old one dead; we drop the reference to a
    ; fresh empty Array).
    function mark_defined(this: pointer[Id], loc: Location)
    {
        set this.def_loc: loc
        let pg Page.get(this as pointer[void])
        set this.pending_refs: Array[Location]^pg()
    }

    function defined(this: Id) returns bool
        def_loc.is_null() = false

    function def_location(this: Id) returns Location
        def_loc

    function add_pending_ref(this: pointer[Id], loc: Location)
        this.pending_refs.add(loc)

    ; noteIdref(loc): record a pending ref only while the ID is still undefined.
    function note_idref(this: pointer[Id], loc: Location)
    {
        if this.defined() = false
            this.pending_refs.add(loc)
    }

    function n_pending_refs(this: Id) returns size_t
        pending_refs.get_length()

    function first_ref_location(this: Id) returns Location
    {
        if pending_refs.get_length() > (0 as size_t)
            return *(pending_refs.get_buffer())

        Location()
    }

    function test() returns int
    {
        let anchor StringC("x")
        let host Page.get(anchor.data_ptr() as pointer[void])

        ; A brand-new id: undefined, no pending refs.
        let id Id.make(host, StringC("chap1"))
        if id.get_name().equals(StringC("chap1")) = false
            return -1
        if id.defined()
            return -2
        if id.n_pending_refs() <> (0 as size_t)
            return -3

        ; Two forward IDREFs arrive before the ID is defined -> both pend.
        var org_a Origin()
        var buf_a u32[1]
        set *(buf_a as pointer[u32]): (0x41 as u32)
        var src InputSource(&org_a, buf_a as pointer[u32], 1 as size_t)
        let ref1 src.current_location(3 as size_t)
        let ref2 src.current_location(7 as size_t)
        id.note_idref(ref1)
        id.note_idref(ref2)
        if id.n_pending_refs() <> (2 as size_t)
            return -4
        if id.first_ref_location().get_index() <> (3 as u32)
            return -5

        ; Defining the ID records the location and clears the pending refs.
        let def_at src.current_location(10 as size_t)
        id.mark_defined(def_at)
        if id.defined() = false
            return -6
        if id.def_location().get_index() <> (10 as u32)
            return -7
        if id.n_pending_refs() <> (0 as size_t)
            return -8

        ; Once defined, note_idref no longer pends.
        id.note_idref(ref1)
        if id.n_pending_refs() <> (0 as size_t)
            return -9

        0
    }
}
