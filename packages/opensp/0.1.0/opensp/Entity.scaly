use scaly.memory.Page
use opensp.StringC.StringC
use opensp.ExternalId.ExternalId
use opensp.Location.Location
use opensp.Location.InputSource
use opensp.Location.Origin
use opensp.AttributeList.AttributeList
use opensp.Notation.Notation
use opensp.EntityCatalog.EntityCatalog
use opensp.EntityCatalog.CatalogParser
use opensp.EntityManager.EntityManager
use opensp.Storage.Storage
use opensp.CodingSystem.CodingSystem

; Entities and entity stacking — EntityDecl.cs / Entity.cs.
;
; Stage-2 scope: the two entity kinds whose reference PUSHES an input source —
; InternalTextEntity (in-memory text) and ExternalTextEntity (resolved through
; the catalog + entity manager). Data entities (cdata/sdata/ndata/subdoc emit
; events instead of stacking), the DeclType/DataType breadth, and the parser-
; side recursion guard land with the parser stages. `stack()` is the
; normalReference path: it returns the pushed InputSource, whose origin carries
; the reference Location (so nested-source location tracking, Stage 1, works).

define DT_SGML: int 0
define DT_PI: int 1
define DT_CDATA: int 2
define DT_SDATA: int 3
define DT_NDATA: int 4
define DT_SUBDOC: int 5

define InternalEntity (name: StringC, text: StringC, data_type: int, def_locs: pointer[Location])
{
    init(name: StringC, text: StringC, data_type: int)
    {
        set this.name: name
        set this.text: text
        set this.data_type: data_type
        set this.def_locs: null
    }

    ; Heap-allocate an InternalEntity on `host`, DEEP-COPYING the name onto the
    ; host page so it does not alias the parser's transient folded-token buffer.
    function make(host: ref[Page], name: StringC, text: StringC, data_type: int) returns ref[InternalEntity]
    {
        let ie &InternalEntity^host(StringC^host(name.as_slice()), text, data_type, null)
        ie
    }

    ; Text::charLocation backing (InternalEntity::text_'s per-char locations,
    ; parallel to `text`): EntityOrigin::defLocation maps an offset inside the
    ; replacement text back to the literal source through this buffer — the
    ; -e (open-entities) reporter option anchors messages there. null =
    ; untracked (predefined/SGML-declaration/driver-synthesized entities);
    ; the walk then reports "(invalid location)", like a reference Text
    ; built from location-less addChars.
    function set_def_locs(this: ref[InternalEntity], locs: pointer[Location])
        set this.def_locs: locs

    ; ★A BUFFER, not a reference: the caller walks it with `*(dl + off)`
    ; (ParserState.scaly, the -e reporter). A ref carries no element stride, so
    ; this is the accessor position the doctrine names as staying a pointer --
    ; a `returns` has no name for a rule to read, which is why it needs saying.
    function get_def_locs(this: InternalEntity) returns pointer[Location]
        def_locs

    function get_name(this: InternalEntity) returns StringC
        name

    function get_text(this: InternalEntity) returns StringC
        text

    function get_data_type(this: InternalEntity) returns int
        data_type
}

; base_dir: the directory a relative SYSTEM id resolves against — captured at
; DECLARATION time (the file the <!ENTITY> is in), since the entity's content is
; opened later, after that file has been popped off the input stack. Mirrors
; PosixStorageManager::resolveRelative(base = the declaring file's directory).
; def_location: EntityDecl::defLocation_ — where the entity was declared (or, for
; an undefined entity, where it was first referenced). ExternalTextEntity::
; normalReference passes it as the auxiliary "entity was defined here" location of
; nonExistentEntityRef when the entity has no effective system id.
define ExternalTextEntity (name: StringC, external_id: ExternalId, base_dir: String, def_location: Location)
{
    init(name: StringC, external_id: ExternalId, base_dir: String, def_location: Location)
    {
        set this.name: name
        set this.external_id: external_id
        set this.base_dir: base_dir
        set this.def_location: def_location
    }

    function get_name(this: ExternalTextEntity) returns StringC
        name

    function get_external_id(this: ExternalTextEntity) returns ExternalId
        external_id

    function get_base_dir(this: ExternalTextEntity) returns String
        base_dir

    function get_def_location(this: ExternalTextEntity) returns Location
        def_location
}

; ExternalDataEntity — an external CDATA/SDATA/NDATA entity. Referenced in
; content it emits an ExternalDataEntityEvent (never stacks); as an ENTITY
; attribute value it is what makeSemantics admits. `notation` is the (possibly
; still undefined) Notation from lookupCreateNotation; `attributes` the entity's
; data-attribute list (built at declaration time from the notation's attribute
; definitions). Both are borrowed references into LATER modules, which the
; `use` clauses at the top of this file bridge.
define ExternalDataEntity (name: StringC, external_id: ExternalId, base_dir: String, def_location: Location, data_type: int, notation: ref[Notation]?, attributes: ref[AttributeList]?)
{
    init(name: StringC, external_id: ExternalId, base_dir: String, def_location: Location, data_type: int, notation: ref[Notation]?, attributes: ref[AttributeList]?)
    {
        set this.name: name
        set this.external_id: external_id
        set this.base_dir: base_dir
        set this.def_location: def_location
        set this.data_type: data_type
        set this.notation: notation
        set this.attributes: attributes
    }

    function get_name(this: ExternalDataEntity) returns StringC
        name

    function get_external_id(this: ExternalDataEntity) returns ExternalId
        external_id

    function get_base_dir(this: ExternalDataEntity) returns String
        base_dir

    function get_def_location(this: ExternalDataEntity) returns Location
        def_location

    function get_data_type(this: ExternalDataEntity) returns int
        data_type

    function get_notation(this: ExternalDataEntity) returns ref[Notation]?
        notation

    function get_attributes(this: ExternalDataEntity) returns ref[AttributeList]?
        attributes
}

; SubdocEntity — an external SGML-subdocument entity. Its content reference
; (the sub-parse) is the SUBDOC feature axis; declaration and ENTITY-attribute
; semantics (isDataOrSubdoc) are modeled here.
define SubdocEntity (name: StringC, external_id: ExternalId, base_dir: String, def_location: Location)
{
    init(name: StringC, external_id: ExternalId, base_dir: String, def_location: Location)
    {
        set this.name: name
        set this.external_id: external_id
        set this.base_dir: base_dir
        set this.def_location: def_location
    }

    function get_name(this: SubdocEntity) returns StringC
        name

    function get_external_id(this: SubdocEntity) returns ExternalId
        external_id

    function get_base_dir(this: SubdocEntity) returns String
        base_dir

    function get_def_location(this: SubdocEntity) returns Location
        def_location
}

define Entity union
(
    Internal: InternalEntity
    ExternalText: ExternalTextEntity
    ExternalData: ExternalDataEntity
    Subdoc: SubdocEntity
)
{
    ; EntityDecl::name — used to key the DTD's entity tables (StringC).
    function get_name(this: Entity) returns StringC
    {
        choose this
            when i: Internal
                return i.get_name()
            when e: ExternalText
                return e.get_name()
            when d: ExternalData
                return d.get_name()
            when s: Subdoc
                return s.get_name()
        StringC()
    }

    ; The Internal arm's per-char replacement-text locations (null for the
    ; external arms and for untracked internal text) — EntityOrigin::defLocation
    ; input for the -e reporter walk.
    function internal_def_locs(this: Entity) returns pointer[Location]
    {
        choose this
            when i: Internal
                return i.get_def_locs()
            else
                return null
        null
    }

    ; The Internal arm's replacement-text length (0 for external arms) — the
    ; def_locs buffer bound for the -e walk's charLocation extrapolation.
    function internal_text_size(this: Entity) returns size_t
    {
        choose this
            when i: Internal
                return i.get_text().get_size()
            else
                return 0 as size_t
        0 as size_t
    }

    ; Entity::asExternalEntity — whether this entity carries an ExternalId
    ; (generateSystemId only applies to external entities).
    function is_external(this: Entity) returns bool
    {
        choose this
            when i: Internal
                return false
        true
    }

    ; the declaring source's directory of an external entity (empty for
    ; internal ones) — generateSystemId's expandSystemId base.
    function get_base_dir(this: Entity) returns String
    {
        choose this
            when e: ExternalText
                return e.get_base_dir()
            when d: ExternalData
                return d.get_base_dir()
            when s: Subdoc
                return s.get_base_dir()
        String()
    }

    ; the external id of an external entity (an empty id for internal ones).
    function get_external_id(this: Entity) returns ExternalId
    {
        choose this
            when e: ExternalText
                return e.get_external_id()
            when d: ExternalData
                return d.get_external_id()
            when s: Subdoc
                return s.get_external_id()
        ExternalId()
    }

    ; the notation of an external data entity (null for every other kind) —
    ; checkDtd's notation-defined sweep and the ESIS writer read it.
    function get_data_notation(this: Entity) returns ref[Notation]?
    {
        choose this
            when d: ExternalData
                return d.get_notation()
        null
    }

    ; the data ATTRIBUTES of an external data entity (an AttributeList; null for
    ; every other kind) — Entity::asExternalDataEntity()->attributes(), which the
    ; grove hands out as the entity class's `attributes` named node list.
    function get_data_attributes(this: Entity) returns ref[AttributeList]?
    {
        choose this
            when d: ExternalData
                return d.get_attributes()
        null
    }

    ; Entity::asExternalDataEntity() as a PREDICATE. Asked instead of
    ; `get_data_notation() <> null` because the notation is what the caller is
    ; about to REPLACE (ArcProcessor.munge_data_entity) — a data entity whose
    ; notation slot happened to be null would then be silently skipped.
    function is_external_data(this: Entity) returns bool
    {
        choose this
            when d: ExternalData
                return true
        false
    }

    ; ExternalDataEntity::setNotation(notation, atts) — ArcProcessor::
    ; mungeDataEntity (ArcEngine.cxx:960) re-points a COPY of a document data
    ; entity at the architecture's own notation and its mapped data attributes,
    ; so the architectural stream declares `E<name> CDATA <arch notation>`.
    ; Rebuilt around a fresh payload for the same reason as
    ; set_effective_system: no in-place mutation of a choose-bound variant.
    function set_data_notation(this: ref[Entity], notation: ref[Notation]?, atts: ref[AttributeList]?)
    {
        choose this
            when d: ExternalData
            {
                let v ExternalDataEntity(d.get_name(), d.get_external_id(), d.get_base_dir(), d.get_def_location(), d.get_data_type(), notation, atts)
                set this: Entity.ExternalData(v)
            }
    }

    ; EntityDecl::dataType — the declared data type (DT_*). The external TEXT
    ; arm is sgmlText and the subdoc arm subdoc by construction; the grove's
    ; `entity-type` property maps these onto its own EntityType enum.
    function data_type(this: Entity) returns int
    {
        choose this
            when i: Internal
                return i.get_data_type()
            when d: ExternalData
                return d.get_data_type()
            when s: Subdoc
                return DT_SUBDOC
        DT_SGML
    }

    ; Entity::asInternalEntity()->string() — an INTERNAL entity's replacement
    ; text (the grove's `text` property; the external arms have none, which
    ; is_external above distinguishes).
    function internal_text(this: Entity) returns StringC
    {
        choose this
            when i: Internal
                return i.get_text()
        StringC()
    }

    ; EntityDecl::defLocation — the declaration's MDO (or, for an undefined
    ; entity, its first reference site).
    function get_def_location(this: Entity) returns Location
    {
        choose this
            when e: ExternalText
                return e.get_def_location()
            when d: ExternalData
                return d.get_def_location()
            when s: Subdoc
                return s.get_def_location()
        Location()
    }

    ; Entity::isDataOrSubdoc — what an ENTITY attribute value may name
    ; (EntityDeclaredValue::makeSemantics): internal CDATA/SDATA entities
    ; (InternalDataEntity minus PI), every ExternalNonTextEntity (external
    ; CDATA/SDATA/NDATA) and subdocument entities. PI and (internal or
    ; external) SGML-text entities are NOT data.
    function is_data_or_subdoc(this: Entity) returns bool
    {
        choose this
            when i: Internal
            {
                let dt i.data_type
                if dt = DT_CDATA
                    return true
                if dt = DT_SDATA
                    return true
                return false
            }
            when e: ExternalText
                return false
            when d: ExternalData
                return true
            when s: Subdoc
                return true
        false
    }

    ; Entity::copy() + setName(name) — the defaulted-entity clone (ParserState::
    ; lookupEntity's default-entity consult copies the default entity and renames
    ; it after the referenced name). The name is DEEP-COPIED onto the host page;
    ; every other field is shared (the port's entities are immutable after
    ; definition, so structural sharing is safe).
    function copy_with_name(this: Entity, host: ref[Page], name: StringC) returns ref[Entity]
    {
        let ent host.allocate(sizeof Entity, alignof Entity) as pointer[Entity]
        let pinned StringC^host(name.as_slice())
        choose this
            when i: Internal
            {
                var v InternalEntity(pinned, i.get_text(), i.get_data_type())
                set v.def_locs: i.get_def_locs()
                set *ent: Entity.Internal(v)
            }
            when e: ExternalText
            {
                let v ExternalTextEntity(pinned, e.get_external_id(), e.get_base_dir(), e.get_def_location())
                set *ent: Entity.ExternalText(v)
            }
            when d: ExternalData
            {
                let v ExternalDataEntity(pinned, d.get_external_id(), d.get_base_dir(), d.get_def_location(), d.get_data_type(), d.get_notation(), d.get_attributes())
                set *ent: Entity.ExternalData(v)
            }
            when s: Subdoc
            {
                let v SubdocEntity(pinned, s.get_external_id(), s.get_base_dir(), s.get_def_location())
                set *ent: Entity.Subdoc(v)
            }
        ent
    }

    ; Entity::generateSystemId's result — stamp the effective system id into
    ; the stored external id. The union payload is rebuilt around the modified
    ; ExternalId copy (no in-place mutation of a choose-bound variant). `eff`
    ; must already be pinned to the entity's page.
    function set_effective_system(this: ref[Entity], eff: String)
    {
        choose this
            when e: ExternalText
            {
                let v ExternalTextEntity(e.get_name(), ExternalId.with_effective(e.get_external_id(), eff), e.get_base_dir(), e.get_def_location())
                set this: Entity.ExternalText(v)
            }
            when d: ExternalData
            {
                let v ExternalDataEntity(d.get_name(), ExternalId.with_effective(d.get_external_id(), eff), d.get_base_dir(), d.get_def_location(), d.get_data_type(), d.get_notation(), d.get_attributes())
                set this: Entity.ExternalData(v)
            }
            when s: Subdoc
            {
                let v SubdocEntity(s.get_name(), ExternalId.with_effective(s.get_external_id(), eff), s.get_base_dir(), s.get_def_location())
                set this: Entity.Subdoc(v)
            }
    }

    ; normalReference: produce the input source this entity pushes. `origin`
    ; carries the reference location. Internal entities stack their own text;
    ; external entities resolve through the catalog and open via the manager.
    ; (cat/storage/cs/em are unused for the Internal arm.)
    function stack(this: Entity, cat: EntityCatalog, storage: Storage, cs: CodingSystem, em: EntityManager, origin: ref[Origin]) returns InputSource
    {
        choose this
            when i: Internal
            {
                let itext i.get_text()
                let idata itext.data_ptr()
                let ilen itext.get_size()
                return InputSource(origin, idata, ilen)
            }
            when e: ExternalText
            {
                let sysid cat.lookup(e.get_external_id())
                return em.open(sysid, storage, cs, origin)
            }
        InputSource(origin, null, 0)
    }

    function test() returns int
    {
        ; Shared machinery.
        let parser CatalogParser()
        let cat parser.parse("SYSTEM \"doc.dtd\" doc.dtd\n", "")
        let storage Storage.Literal("AB")
        let em EntityManager()

        ; --- internal entity "greeting" = "hi", pushed at parent location 3 ---
        let text StringC("hi")
        let ient Entity.Internal(InternalEntity(StringC("greeting"), text, DT_SGML))
        if ient.get_name().equals(StringC("greeting")) = false
            return -7
        var parent_org Origin()
        let ref_loc Location(&parent_org, 3)
        var ent_org Origin(ref_loc)

        let isrc ient.stack(cat, storage, CodingSystem.identity(), em, &ent_org)
        if isrc.char_at(0) <> 0x68
            return -1

        if isrc.char_at(1) <> 0x69
            return -2

        ; nested location: char at index 1 resolves up to parent index 3
        let up isrc.current_location(1).parent()
        if up.get_index() <> 3
            return -3

        if up.get_origin() <> (&parent_org)
            return -4

        ; --- external entity resolved via catalog + literal storage ---
        let eent Entity.ExternalText(ExternalTextEntity(StringC("e"), ExternalId(false, "", true, "doc.dtd"), String(), Location()))
        var ext_org Origin()
        let esrc eent.stack(cat, storage, CodingSystem.identity(), em, &ext_org)
        if esrc.char_at(0) <> 0x41
            return -5

        if esrc.char_at(1) <> 0x42
            return -6

        ; --- data / subdoc variants: name, classification, notation ---------
        let sub_ent Entity.Subdoc(SubdocEntity(StringC("sub"), ExternalId(false, "", true, "sub.sgm"), String(), Location()))
        if sub_ent.get_name().equals(StringC("sub")) = false
            return -8
        if sub_ent.is_data_or_subdoc() = false
            return -9
        if sub_ent.get_data_notation() <> null
            return -10
        let marker Notation.make(Page.get(StringC("x").data_ptr()), StringC("gif"), StringC("base"), true)
        let data_ent Entity.ExternalData(ExternalDataEntity(StringC("pic"), ExternalId(false, "", true, "pic.gif"), String(), Location(), DT_NDATA, marker, null))
        if data_ent.get_name().equals(StringC("pic")) = false
            return -11
        if data_ent.is_data_or_subdoc() = false
            return -12
        if data_ent.get_data_notation() <> marker
            return -13
        if ient.is_data_or_subdoc()
            return -14
        let cd_ent Entity.Internal(InternalEntity(StringC("c"), StringC("t"), DT_CDATA))
        if cd_ent.is_data_or_subdoc() = false
            return -15

        ; --- heap-stored union readback (the parser's `set *ent:` shape) ----
        let host Page.get(StringC("x").data_ptr())
        let hent_v Entity.Subdoc^host(SubdocEntity(StringC("sub2"), ExternalId(false, "", true, "sub.sgm"), String(), Location()))
        let hent &hent_v
        let hname hent.get_name()
        if hname.equals(StringC("sub2")) = false
            return -16
        if hent.is_data_or_subdoc() = false
            return -17

        0
    }
}
