use scaly.memory.Page
use opensp.StringC.StringC
use opensp.ExternalId.ExternalId
use opensp.Location.Location
use opensp.Location.InputSource
use opensp.Location.Origin
use opensp.EntityCatalog.EntityCatalog
use opensp.EntityCatalog.CatalogParser
use opensp.EntityManager.EntityManager
use opensp.Storage.Storage
use opensp.CodingSystem.CodingSystem

; Entities and entity stacking — EntityDecl.cs / Entity.cs.
;
; Stage-2 scope: the two entity kinds whose reference PUSHES an input source —
; InternalTextEntity (in-memory text) and ExternalTextEntity (resolved through
; the catalog + entity manager). Data entities (cdata/sdata/ndata/subdoc emit
; events instead of stacking), the DeclType/DataType breadth, and the parser-
; side recursion guard land with the parser stages. `stack()` is the
; normalReference path: it returns the pushed InputSource, whose origin carries
; the reference Location (so nested-source location tracking, Stage 1, works).

define DT_SGML: int 0
define DT_PI: int 1
define DT_CDATA: int 2
define DT_SDATA: int 3
define DT_NDATA: int 4
define DT_SUBDOC: int 5

define InternalEntity (name: StringC, text: StringC, data_type: int)
{
    init(name: StringC, text: StringC, data_type: int)
    {
        set this.name: name
        set this.text: text
        set this.data_type: data_type
    }

    ; Heap-allocate an InternalEntity on `host`, DEEP-COPYING the name onto the
    ; host page so it does not alias the parser's transient folded-token buffer.
    function make(host: pointer[Page], name: StringC, text: StringC, data_type: int) returns pointer[InternalEntity]
    {
        let ie host.allocate(sizeof InternalEntity, alignof InternalEntity) as pointer[InternalEntity]
        set ie.name: StringC^host(name.data_ptr(), name.get_size())
        set ie.text: text
        set ie.data_type: data_type
        ie
    }

    function get_name(this: InternalEntity) returns StringC
        name

    function get_text(this: InternalEntity) returns StringC
        text
}

; base_dir: the directory a relative SYSTEM id resolves against — captured at
; DECLARATION time (the file the <!ENTITY> is in), since the entity's content is
; opened later, after that file has been popped off the input stack. Mirrors
; PosixStorageManager::resolveRelative(base = the declaring file's directory).
; def_location: EntityDecl::defLocation_ — where the entity was declared (or, for
; an undefined entity, where it was first referenced). ExternalTextEntity::
; normalReference passes it as the auxiliary "entity was defined here" location of
; nonExistentEntityRef when the entity has no effective system id.
define ExternalTextEntity (name: StringC, external_id: ExternalId, base_dir: String, def_location: Location)
{
    init(name: StringC, external_id: ExternalId, base_dir: String, def_location: Location)
    {
        set this.name: name
        set this.external_id: external_id
        set this.base_dir: base_dir
        set this.def_location: def_location
    }

    function get_name(this: ExternalTextEntity) returns StringC
        name

    function get_external_id(this: ExternalTextEntity) returns ExternalId
        external_id

    function get_base_dir(this: ExternalTextEntity) returns String
        base_dir

    function get_def_location(this: ExternalTextEntity) returns Location
        def_location
}

; ExternalDataEntity — an external CDATA/SDATA/NDATA entity. Referenced in
; content it emits an ExternalDataEntityEvent (never stacks); as an ENTITY
; attribute value it is what makeSemantics admits. `notation` is the (possibly
; still undefined) Notation from lookupCreateNotation; `attributes` the entity's
; data-attribute list (built at declaration time from the notation's attribute
; definitions). Both are pointer[void]: Notation/AttributeList are declared in
; LATER modules (module order), exactly like AttributeSemantics' borrowed refs.
define ExternalDataEntity (name: StringC, external_id: ExternalId, base_dir: String, def_location: Location, data_type: int, notation: pointer[void], attributes: pointer[void])
{
    init(name: StringC, external_id: ExternalId, base_dir: String, def_location: Location, data_type: int, notation: pointer[void], attributes: pointer[void])
    {
        set this.name: name
        set this.external_id: external_id
        set this.base_dir: base_dir
        set this.def_location: def_location
        set this.data_type: data_type
        set this.notation: notation
        set this.attributes: attributes
    }

    function get_name(this: ExternalDataEntity) returns StringC
        name

    function get_external_id(this: ExternalDataEntity) returns ExternalId
        external_id

    function get_base_dir(this: ExternalDataEntity) returns String
        base_dir

    function get_def_location(this: ExternalDataEntity) returns Location
        def_location

    function get_data_type(this: ExternalDataEntity) returns int
        data_type

    function get_notation(this: ExternalDataEntity) returns pointer[void]
        notation

    function get_attributes(this: ExternalDataEntity) returns pointer[void]
        attributes
}

; SubdocEntity — an external SGML-subdocument entity. Its content reference
; (the sub-parse) is the SUBDOC feature axis; declaration and ENTITY-attribute
; semantics (isDataOrSubdoc) are modeled here.
define SubdocEntity (name: StringC, external_id: ExternalId, base_dir: String, def_location: Location)
{
    init(name: StringC, external_id: ExternalId, base_dir: String, def_location: Location)
    {
        set this.name: name
        set this.external_id: external_id
        set this.base_dir: base_dir
        set this.def_location: def_location
    }

    function get_name(this: SubdocEntity) returns StringC
        name

    function get_external_id(this: SubdocEntity) returns ExternalId
        external_id

    function get_base_dir(this: SubdocEntity) returns String
        base_dir

    function get_def_location(this: SubdocEntity) returns Location
        def_location
}

define Entity union
(
    Internal: InternalEntity
    ExternalText: ExternalTextEntity
    ExternalData: ExternalDataEntity
    Subdoc: SubdocEntity
)
{
    ; EntityDecl::name — used to key the DTD's entity tables (StringC).
    function get_name(this: Entity) returns StringC
    {
        choose this
            when i: Internal
                return i.get_name()
            when e: ExternalText
                return e.get_name()
            when d: ExternalData
                return d.get_name()
            when s: Subdoc
                return s.get_name()
        StringC()
    }

    ; Entity::asExternalEntity — whether this entity carries an ExternalId
    ; (generateSystemId only applies to external entities).
    function is_external(this: Entity) returns bool
    {
        choose this
            when i: Internal
                return false
        true
    }

    ; the external id of an external entity (an empty id for internal ones).
    function get_external_id(this: Entity) returns ExternalId
    {
        choose this
            when e: ExternalText
                return e.get_external_id()
            when d: ExternalData
                return d.get_external_id()
            when s: Subdoc
                return s.get_external_id()
        ExternalId()
    }

    ; the notation of an external data entity (null for every other kind) —
    ; checkDtd's notation-defined sweep and the ESIS writer read it.
    function get_data_notation(this: Entity) returns pointer[void]
    {
        choose this
            when d: ExternalData
                return d.get_notation()
        null
    }

    ; EntityDecl::defLocation — the declaration's MDO (or, for an undefined
    ; entity, its first reference site).
    function get_def_location(this: Entity) returns Location
    {
        choose this
            when e: ExternalText
                return e.get_def_location()
            when d: ExternalData
                return d.get_def_location()
            when s: Subdoc
                return s.get_def_location()
        Location()
    }

    ; Entity::isDataOrSubdoc — what an ENTITY attribute value may name
    ; (EntityDeclaredValue::makeSemantics): internal CDATA/SDATA entities
    ; (InternalDataEntity minus PI), every ExternalNonTextEntity (external
    ; CDATA/SDATA/NDATA) and subdocument entities. PI and (internal or
    ; external) SGML-text entities are NOT data.
    function is_data_or_subdoc(this: Entity) returns bool
    {
        choose this
            when i: Internal
            {
                let dt i.data_type
                if dt = DT_CDATA
                    return true
                if dt = DT_SDATA
                    return true
                return false
            }
            when e: ExternalText
                return false
            when d: ExternalData
                return true
            when s: Subdoc
                return true
        false
    }

    ; normalReference: produce the input source this entity pushes. `origin`
    ; carries the reference location. Internal entities stack their own text;
    ; external entities resolve through the catalog and open via the manager.
    ; (cat/storage/cs/em are unused for the Internal arm.)
    function stack(this: Entity, cat: EntityCatalog, storage: Storage, cs: CodingSystem, em: EntityManager, origin: pointer[Origin]) returns InputSource
    {
        choose this
            when i: Internal
            {
                let itext i.get_text()
                let idata itext.data_ptr()
                let ilen itext.get_size()
                return InputSource(origin, idata, ilen)
            }
            when e: ExternalText
            {
                let sysid cat.lookup(e.get_external_id())
                return em.open(sysid, storage, cs, origin)
            }
        InputSource(origin, null, 0 as size_t)
    }

    function test() returns int
    {
        ; Shared machinery.
        let parser CatalogParser()
        let cat parser.parse("SYSTEM \"doc.dtd\" doc.dtd\n", "")
        let storage Storage.Literal("AB")
        let em EntityManager()

        ; --- internal entity "greeting" = "hi", pushed at parent location 3 ---
        let text StringC("hi")
        let ient Entity.Internal(InternalEntity(StringC("greeting"), text, DT_SGML))
        if ient.get_name().equals(StringC("greeting")) = false
            return -7
        var parent_org Origin()
        let ref_loc Location(&parent_org, 3 as u32)
        var ent_org Origin(ref_loc)

        let isrc ient.stack(cat, storage, CodingSystem.Identity(), em, &ent_org)
        if isrc.char_at(0 as size_t) <> (0x68 as u32)
            return -1

        if isrc.char_at(1 as size_t) <> (0x69 as u32)
            return -2

        ; nested location: char at index 1 resolves up to parent index 3
        let up isrc.current_location(1 as size_t).parent()
        if up.get_index() <> (3 as u32)
            return -3

        if up.get_origin() <> (&parent_org)
            return -4

        ; --- external entity resolved via catalog + literal storage ---
        let eent Entity.ExternalText(ExternalTextEntity(StringC("e"), ExternalId(false, "", true, "doc.dtd"), String(), Location()))
        var ext_org Origin()
        let esrc eent.stack(cat, storage, CodingSystem.Identity(), em, &ext_org)
        if esrc.char_at(0 as size_t) <> (0x41 as u32)
            return -5

        if esrc.char_at(1 as size_t) <> (0x42 as u32)
            return -6

        ; --- data / subdoc variants: name, classification, notation ---------
        let sub_ent Entity.Subdoc(SubdocEntity(StringC("sub"), ExternalId(false, "", true, "sub.sgm"), String(), Location()))
        if sub_ent.get_name().equals(StringC("sub")) = false
            return -8
        if sub_ent.is_data_or_subdoc() = false
            return -9
        if sub_ent.get_data_notation() <> null
            return -10
        var marker: int 7
        let data_ent Entity.ExternalData(ExternalDataEntity(StringC("pic"), ExternalId(false, "", true, "pic.gif"), String(), Location(), DT_NDATA, &marker as pointer[void], null))
        if data_ent.get_name().equals(StringC("pic")) = false
            return -11
        if data_ent.is_data_or_subdoc() = false
            return -12
        if data_ent.get_data_notation() <> (&marker as pointer[void])
            return -13
        if ient.is_data_or_subdoc()
            return -14
        let cd_ent Entity.Internal(InternalEntity(StringC("c"), StringC("t"), DT_CDATA))
        if cd_ent.is_data_or_subdoc() = false
            return -15

        ; --- heap-stored union readback (the parser's `set *ent:` shape) ----
        let host Page.get(StringC("x").data_ptr() as pointer[void])
        let hent host.allocate(sizeof Entity, alignof Entity) as pointer[Entity]
        set *hent: Entity.Subdoc(SubdocEntity(StringC("sub2"), ExternalId(false, "", true, "sub.sgm"), String(), Location()))
        let hname hent.get_name()
        if hname.equals(StringC("sub2")) = false
            return -16
        if hent.is_data_or_subdoc() = false
            return -17

        0
    }
}
