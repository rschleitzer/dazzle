use scaly.memory.Page
use opensp.StringC.StringC
use opensp.ExternalId.ExternalId
use opensp.Location.Location
use opensp.Location.InputSource
use opensp.Location.Origin
use opensp.EntityCatalog.EntityCatalog
use opensp.EntityCatalog.CatalogParser
use opensp.EntityManager.EntityManager
use opensp.Storage.Storage
use opensp.CodingSystem.CodingSystem

; Entities and entity stacking — EntityDecl.cs / Entity.cs.
;
; Stage-2 scope: the two entity kinds whose reference PUSHES an input source —
; InternalTextEntity (in-memory text) and ExternalTextEntity (resolved through
; the catalog + entity manager). Data entities (cdata/sdata/ndata/subdoc emit
; events instead of stacking), the DeclType/DataType breadth, and the parser-
; side recursion guard land with the parser stages. `stack()` is the
; normalReference path: it returns the pushed InputSource, whose origin carries
; the reference Location (so nested-source location tracking, Stage 1, works).

define DT_SGML: int 0
define DT_PI: int 1
define DT_CDATA: int 2
define DT_SDATA: int 3
define DT_NDATA: int 4
define DT_SUBDOC: int 5

define InternalEntity (name: StringC, text: StringC, data_type: int)
{
    init(name: StringC, text: StringC, data_type: int)
    {
        set this.name: name
        set this.text: text
        set this.data_type: data_type
    }

    ; Heap-allocate an InternalEntity on `host`, DEEP-COPYING the name onto the
    ; host page so it does not alias the parser's transient folded-token buffer.
    function make(host: pointer[Page], name: StringC, text: StringC, data_type: int) returns pointer[InternalEntity]
    {
        let ie host.allocate(sizeof InternalEntity, alignof InternalEntity) as pointer[InternalEntity]
        set ie.name: StringC^host(name.data_ptr(), name.get_size())
        set ie.text: text
        set ie.data_type: data_type
        ie
    }

    function get_name(this: InternalEntity) returns StringC
        name

    function get_text(this: InternalEntity) returns StringC
        text
}

define ExternalTextEntity (name: StringC, external_id: ExternalId)
{
    init(name: StringC, external_id: ExternalId)
    {
        set this.name: name
        set this.external_id: external_id
    }

    function get_name(this: ExternalTextEntity) returns StringC
        name

    function get_external_id(this: ExternalTextEntity) returns ExternalId
        external_id
}

define Entity union
(
    Internal: InternalEntity
    ExternalText: ExternalTextEntity
)
{
    ; EntityDecl::name — used to key the DTD's entity tables (StringC).
    function get_name(this: Entity) returns StringC
    {
        choose this
            when i: Internal
                return i.get_name()
            when e: ExternalText
                return e.get_name()
        StringC()
    }

    ; normalReference: produce the input source this entity pushes. `origin`
    ; carries the reference location. Internal entities stack their own text;
    ; external entities resolve through the catalog and open via the manager.
    ; (cat/storage/cs/em are unused for the Internal arm.)
    function stack(this: Entity, cat: EntityCatalog, storage: Storage, cs: CodingSystem, em: EntityManager, origin: pointer[Origin]) returns InputSource
    {
        choose this
            when i: Internal
            {
                let itext i.get_text()
                let idata itext.data_ptr()
                let ilen itext.get_size()
                return InputSource(origin, idata, ilen)
            }
            when e: ExternalText
            {
                let sysid cat.lookup(e.get_external_id())
                return em.open(sysid, storage, cs, origin)
            }
        InputSource(origin, null, 0 as size_t)
    }

    function test() returns int
    {
        ; Shared machinery.
        let parser CatalogParser()
        let cat parser.parse("SYSTEM \"doc.dtd\" doc.dtd\n", "")
        let storage Storage.Literal("AB")
        let em EntityManager()

        ; --- internal entity "greeting" = "hi", pushed at parent location 3 ---
        let text StringC("hi")
        let ient Entity.Internal(InternalEntity(StringC("greeting"), text, DT_SGML))
        if ient.get_name().equals(StringC("greeting")) = false
            return -7
        var parent_org Origin()
        let ref_loc Location(&parent_org, 3 as u32)
        var ent_org Origin(ref_loc)

        let isrc ient.stack(cat, storage, CodingSystem.Identity(), em, &ent_org)
        if isrc.char_at(0 as size_t) <> (0x68 as u32)
            return -1

        if isrc.char_at(1 as size_t) <> (0x69 as u32)
            return -2

        ; nested location: char at index 1 resolves up to parent index 3
        let up isrc.current_location(1 as size_t).parent()
        if up.get_index() <> (3 as u32)
            return -3

        if up.get_origin() <> (&parent_org)
            return -4

        ; --- external entity resolved via catalog + literal storage ---
        let eent Entity.ExternalText(ExternalTextEntity(StringC("e"), ExternalId(false, "", true, "doc.dtd")))
        var ext_org Origin()
        let esrc eent.stack(cat, storage, CodingSystem.Identity(), em, &ext_org)
        if esrc.char_at(0 as size_t) <> (0x41 as u32)
            return -5

        if esrc.char_at(1 as size_t) <> (0x42 as u32)
            return -6

        0
    }
}
