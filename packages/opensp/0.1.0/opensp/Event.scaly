use scaly.memory.Page
use opensp.StringC.StringC
use opensp.Location.Location
use opensp.ElementType.ElementType
use opensp.AttributeList.AttributeList

; Event — the parser's output stream (Event.cs / Event.h). Clark's C++ has a
; deep virtual Event hierarchy (StartElementEvent/EndElementEvent/DataEvent/…)
; dispatched by an EventHandler; the Nsgmls app turns that stream into ESIS.
;
; PORT SHAPE: a single page-hosted FLAT TAGGED struct keyed by `event_type`
; (the same shape ContentToken.CmNode / the Attribute hierarchy use for mutable
; pointer-linked graphs). Events are immutable value records the parser appends
; to a queue (ParserState.events, an Array[pointer[Event]]) in document order;
; an event-dump / ESIS writer walks the queue. This replaces the C++ eventQueue
; + eventHandler indirection: the parser calls ps.queue_event(...) directly.
;
; STAGE 4 INCREMENT 1: the content events (startElement/endElement/characterData)
; the well-formed instance path produces. DEFERRED (later increments / Stage 5):
; the markup/declaration events (startDtd/endProlog/pi/entityStart/…), attribute
; payloads on start events, and the full Markup capture (wantInstanceMarkup).

define EV_START_ELEMENT: int 0
define EV_END_ELEMENT: int 1
define EV_DATA: int 2
define EV_PI: int 3

define Event
(
    event_type: int
    ; startElement / endElement: the element type (borrowed DTD identity).
    element_type: pointer[ElementType]
    ; characterData: the data chars (deep-copied onto the run page).
    data: StringC
    loc: Location
    ; whether this element was reached as an inclusion (ESIS "&" prefix).
    included: bool
    ; startElement: the specified + defaulted attribute values (null on end/data).
    attributes: pointer[AttributeList]
)
{
    ; ---- constructors (host = the run page) ------------------------------
    function make_start(host: pointer[Page], e: pointer[ElementType], loc: Location) returns pointer[Event]
    {
        let ev host.allocate(sizeof Event, alignof Event) as pointer[Event]
        set ev.event_type: EV_START_ELEMENT
        set ev.element_type: e
        set ev.data: StringC()
        set ev.loc: loc
        set ev.included: false
        set ev.attributes: null
        ev
    }

    function make_end(host: pointer[Page], e: pointer[ElementType], loc: Location) returns pointer[Event]
    {
        let ev host.allocate(sizeof Event, alignof Event) as pointer[Event]
        set ev.event_type: EV_END_ELEMENT
        set ev.element_type: e
        set ev.data: StringC()
        set ev.loc: loc
        set ev.included: false
        set ev.attributes: null
        ev
    }

    ; character data — deep-copy the source chars onto the run page (the
    ; StringC^host field-assign idiom; the source points into the lexer buffer).
    function make_data(host: pointer[Page], src: StringC, loc: Location) returns pointer[Event]
    {
        let ev host.allocate(sizeof Event, alignof Event) as pointer[Event]
        set ev.event_type: EV_DATA
        set ev.element_type: null
        set ev.data: StringC^host(src.data_ptr(), src.get_size())
        set ev.loc: loc
        set ev.included: false
        set ev.attributes: null
        ev
    }

    ; processing instruction — the raw content between PIO and PIC, deep-copied
    ; onto the run page (SgmlsEventHandler::pi emits `?` + data + RE).
    function make_pi(host: pointer[Page], src: StringC, loc: Location) returns pointer[Event]
    {
        let ev host.allocate(sizeof Event, alignof Event) as pointer[Event]
        set ev.event_type: EV_PI
        set ev.element_type: null
        set ev.data: StringC^host(src.data_ptr(), src.get_size())
        set ev.loc: loc
        set ev.included: false
        set ev.attributes: null
        ev
    }

    ; ---- accessors -------------------------------------------------------
    function get_type(this: Event) returns int
        event_type

    function get_element_type(this: Event) returns pointer[ElementType]
        element_type

    function get_data(this: Event) returns StringC
        data

    function get_loc(this: Event) returns Location
        loc

    function is_included(this: Event) returns bool
        included

    function set_included(this: pointer[Event])
        set this.included: true

    function get_attributes(this: Event) returns pointer[AttributeList]
        attributes

    function set_attributes(this: pointer[Event], atts: pointer[AttributeList])
        set this.attributes: atts
}
