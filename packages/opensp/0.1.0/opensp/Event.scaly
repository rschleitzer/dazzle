use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.Location.Location
use opensp.Entity.Entity
use opensp.ElementType.ElementType
use opensp.AttributeList.AttributeList

; Event — the parser's output stream (Event.cs / Event.h). Clark's C++ has a
; deep virtual Event hierarchy (StartElementEvent/EndElementEvent/DataEvent/…)
; dispatched by an EventHandler; the Nsgmls app turns that stream into ESIS.
;
; PORT SHAPE: a single page-hosted FLAT TAGGED struct keyed by `event_type`
; (the same shape ContentToken.CmNode / the Attribute hierarchy use for mutable
; pointer-linked graphs). Events are immutable value records the parser appends
; to a queue (ParserState.events, an Array[pointer[Event]]) in document order;
; an event-dump / ESIS writer walks the queue. This replaces the C++ eventQueue
; + eventHandler indirection: the parser calls ps.queue_event(...) directly.
;
; STAGE 4 INCREMENT 1: the content events (startElement/endElement/characterData)
; the well-formed instance path produces. DEFERRED (later increments / Stage 5):
; the markup/declaration events (startDtd/endProlog/pi/entityStart/…), attribute
; payloads on start events, and the full Markup capture (wantInstanceMarkup).

define EV_START_ELEMENT: int 0
define EV_END_ELEMENT: int 1
define EV_DATA: int 2
define EV_PI: int 3
; APPINFO minimum literal from the SGML declaration (AppinfoEvent)
define EV_APPINFO: int 5
define EV_ENTITY_REF: int 4
; SUBDOC entity reference in content (SubdocEntityEvent): brackets the nested
; sub-parse's events. The writer emits the subdoc entity's definition records
; (once per document) then `{name`; END emits `}name`. Both carry the entity.
define EV_START_SUBDOC: int 6
define EV_END_SUBDOC: int 7
; EndPrologEvent (LINK axis): carries the ACTIVE complex LPD (or null) that
; initializes the writer-side link process, and the active simple LPDs'
; names + finished attribute lists (printed as `a<linkname> ...` records).
define EV_END_PROLOG: int 8
; SDATA entity reference in content (SdataEntityEvent): the entity's
; replacement text, written INLINE into the surrounding data run between
; `\|` markers (SgmlsEventHandler::sdataEntity — startData(), not flushData()).
define EV_SDATA: int 9
; CommentDeclEvent: a comment declaration's comment segments (one StringC per
; `--…--` pair). Queued from parse_comment_decl only when -ocomment enabled;
; the writer prints `_<text>` per segment, but only once the prolog has ended
; (the reference's inDocument_ gate).
define EV_COMMENT: int 10
; NonSgmlCharEvent: a numeric char ref in content denoting a declared NON-SGML
; char — data holds the single char; -ononsgml renders `\%N;` inline in the
; data run, the default output drops it silently.
define EV_NONSGML: int 11
; EntityDefaultedEvent + the found-entity re-dispatch (ParserState::lookupEntity
; fires entityDefaulted for EVERY successful lookup outside the pass-2-prolog
; special case — probed: -oentity re-prints `Ifoo …` at each `&foo;`). Queued
; only when -oentity is on; the writer flushes the data run and re-emits the
; entity's definition (no markEntity consult — reference behavior).
define EV_ENTITY_DEFAULTED: int 12
; UselinkEvent (LINK axis, RAST only): a USELINK declaration changed the active
; complex LPD's current link set — link_set_after snapshots the post-uselink
; set (LinkSets are immutable once the prolog ends, so the pointer suffices).
; Queued only in RAST mode; the ESIS writer never sees one.
define EV_USELINK: int 13

; SgmlsEventHandler output flags (SgmlsEventHandler.h — octal in the
; reference): the -o option axis. outputAll = 07777 (posfix excluded there
; too). The driver mirrors these as ONS_OF_* (cross-package defines are not
; visible to a program).
define OF_LINE: u32 0x1
define OF_ENTITY: u32 0x2
define OF_ID: u32 0x4
define OF_INCLUDED: u32 0x8
define OF_NOTATION_SYSID: u32 0x10
define OF_NONSGML: u32 0x20
define OF_EMPTY: u32 0x40
define OF_DATA_ATT: u32 0x80
define OF_COMMENT: u32 0x100
define OF_TAG_OMISSION: u32 0x200
define OF_ATTR_OMISSION: u32 0x400
define OF_PARSER_INFO: u32 0x800
define OF_ALL: u32 0xFFF

define Event
(
    event_type: int
    ; startElement / endElement: the element type (borrowed DTD identity).
    element_type: pointer[ElementType]
    ; entityRef (ExternalDataEntityEvent): the referenced data entity — the
    ; writer prints its definition (once) and the `&name` reference line.
    entity: pointer[Entity]
    ; characterData: the data chars (deep-copied onto the run page).
    data: StringC
    loc: Location
    ; startElement: the MARKUP location — the STAGO of the start tag (onsgmls's
    ; markupLocation()), which is where OpenElement.startLocation comes from and
    ; what the "start tag was here" auxiliary diagnostic points at. Distinct from
    ; `loc` (captured after the GI name = the TAGC position, used by the
    ; elementNotAllowed diagnostic). Defaults to `loc` for implied / synthetic
    ; start events that have no real STAGO.
    markup_loc: Location
    ; whether this element was reached as an inclusion (ESIS "&" prefix).
    included: bool
    ; start/end element: whether a REAL tag produced this event (the
    ; reference's markupPtr() under wantInstanceMarkup — implied/auto-generated
    ; tags carry none). -otagomit prints `o` when false.
    has_markup: bool
    ; EV_COMMENT: the declaration's comment segments.
    comments: pointer[Array[StringC]]
    ; EV_END_PROLOG under -oentity: the DTD's general entities in the
    ; reference's NamedTable bucket order (the endProlog define sweep).
    general_entities: pointer[Array[pointer[Entity]]]
    ; startElement: the specified + defaulted attribute values (null on end/data).
    attributes: pointer[AttributeList]
    ; LINK axis — startElement: the link rule's attributes + the owning LPD's
    ; name (the `a<lpdname> <att> ...` records preceding the `A` records),
    ; attached by the link process when the event is queued.
    link_attributes: pointer[AttributeList]
    link_owner: pointer[StringC]
    ; LINK axis — endProlog: the active complex LPD (pointer[void] = Lpd,
    ; declared in a later module) and the active simple LPDs' names/attributes.
    end_prolog_lpd: pointer[void]
    simple_link_names: pointer[Array[StringC]]
    simple_link_atts: pointer[Array[pointer[AttributeList]]]
    ; RAST (-t) axis — start/end element: the SELECTED link rule (pointer[void]
    ; = SourceLinkRule) and the link process' current LinkSet AFTER this event
    ; (post-push on start, post-pop on end; also EV_USELINK's payload). The
    ; writer reads implied link rules / the result element spec from these.
    link_rule: pointer[void]
    link_set_after: pointer[void]
    ; RAST — start/end subdoc: whether the rast-parse-subdoc queue said to
    ; parse the referenced document, and the child parse's ParserState
    ; (pointer[void]; carries the child's PI-declared active link types for
    ; the writer's #ACTIVE-LINK rendering).
    subdoc_parsed: bool
    child_ps: pointer[void]
)
{
    ; ---- constructors (host = the run page) ------------------------------
    function make_start(host: pointer[Page], e: pointer[ElementType], loc: Location) returns pointer[Event]
    {
        let ev host.allocate(sizeof Event, alignof Event) as pointer[Event]
        set ev.event_type: EV_START_ELEMENT
        set ev.element_type: e
        set ev.entity: null
        set ev.data: StringC()
        set ev.loc: loc
        set ev.markup_loc: loc
        set ev.included: false
        set ev.has_markup: false
        set ev.comments: null
        set ev.general_entities: null
        set ev.attributes: null
        set ev.link_attributes: null
        set ev.link_owner: null
        set ev.end_prolog_lpd: null
        set ev.simple_link_names: null
        set ev.simple_link_atts: null
        set ev.link_rule: null
        set ev.link_set_after: null
        set ev.subdoc_parsed: false
        set ev.child_ps: null
        ev
    }

    function make_end(host: pointer[Page], e: pointer[ElementType], loc: Location) returns pointer[Event]
    {
        let ev host.allocate(sizeof Event, alignof Event) as pointer[Event]
        set ev.event_type: EV_END_ELEMENT
        set ev.element_type: e
        set ev.entity: null
        set ev.data: StringC()
        set ev.loc: loc
        set ev.markup_loc: loc
        set ev.included: false
        set ev.has_markup: false
        set ev.comments: null
        set ev.general_entities: null
        set ev.attributes: null
        set ev.link_attributes: null
        set ev.link_owner: null
        set ev.end_prolog_lpd: null
        set ev.simple_link_names: null
        set ev.simple_link_atts: null
        set ev.link_rule: null
        set ev.link_set_after: null
        set ev.subdoc_parsed: false
        set ev.child_ps: null
        ev
    }

    ; character data — deep-copy the source chars onto the run page (the
    ; StringC^host field-assign idiom; the source points into the lexer buffer).
    function make_data(host: pointer[Page], src: StringC, loc: Location) returns pointer[Event]
    {
        let ev host.allocate(sizeof Event, alignof Event) as pointer[Event]
        set ev.event_type: EV_DATA
        set ev.element_type: null
        set ev.entity: null
        set ev.data: StringC^host(src.data_ptr(), src.get_size())
        set ev.loc: loc
        set ev.markup_loc: loc
        set ev.included: false
        set ev.has_markup: false
        set ev.comments: null
        set ev.general_entities: null
        set ev.attributes: null
        set ev.link_attributes: null
        set ev.link_owner: null
        set ev.end_prolog_lpd: null
        set ev.simple_link_names: null
        set ev.simple_link_atts: null
        set ev.link_rule: null
        set ev.link_set_after: null
        set ev.subdoc_parsed: false
        set ev.child_ps: null
        ev
    }

    ; SDATA entity text (SdataEntityEvent — InternalSdataEntity::normalReference):
    ; written inline into the data run between `\|` markers.
    function make_sdata(host: pointer[Page], src: StringC, loc: Location) returns pointer[Event]
    {
        let ev host.allocate(sizeof Event, alignof Event) as pointer[Event]
        set ev.event_type: EV_SDATA
        set ev.element_type: null
        set ev.entity: null
        set ev.data: StringC^host(src.data_ptr(), src.get_size())
        set ev.loc: loc
        set ev.markup_loc: loc
        set ev.included: false
        set ev.has_markup: false
        set ev.comments: null
        set ev.general_entities: null
        set ev.attributes: null
        set ev.link_attributes: null
        set ev.link_owner: null
        set ev.end_prolog_lpd: null
        set ev.simple_link_names: null
        set ev.simple_link_atts: null
        set ev.link_rule: null
        set ev.link_set_after: null
        set ev.subdoc_parsed: false
        set ev.child_ps: null
        ev
    }

    ; processing instruction — the raw content between PIO and PIC, deep-copied
    ; onto the run page (SgmlsEventHandler::pi emits `?` + data + RE).
    ; Also carries a PI ENTITY's replacement text (PiEntityEvent is a PiEvent
    ; subclass — SgmlsEventHandler routes both through pi()).
    function make_pi(host: pointer[Page], src: StringC, loc: Location) returns pointer[Event]
    {
        let ev host.allocate(sizeof Event, alignof Event) as pointer[Event]
        set ev.event_type: EV_PI
        set ev.element_type: null
        set ev.entity: null
        set ev.data: StringC^host(src.data_ptr(), src.get_size())
        set ev.loc: loc
        set ev.markup_loc: loc
        set ev.included: false
        set ev.has_markup: false
        set ev.comments: null
        set ev.general_entities: null
        set ev.attributes: null
        set ev.link_attributes: null
        set ev.link_owner: null
        set ev.end_prolog_lpd: null
        set ev.simple_link_names: null
        set ev.simple_link_atts: null
        set ev.link_rule: null
        set ev.link_set_after: null
        set ev.subdoc_parsed: false
        set ev.child_ps: null
        ev
    }

    ; APPINFO literal (AppinfoEvent with a literal — sdParseAppinfo).
    function make_appinfo(host: pointer[Page], src: StringC, loc: Location) returns pointer[Event]
    {
        let ev host.allocate(sizeof Event, alignof Event) as pointer[Event]
        set ev.event_type: EV_APPINFO
        set ev.element_type: null
        set ev.entity: null
        set ev.data: StringC^host(src.data_ptr(), src.get_size())
        set ev.loc: loc
        set ev.markup_loc: loc
        set ev.included: false
        set ev.has_markup: false
        set ev.comments: null
        set ev.general_entities: null
        set ev.attributes: null
        set ev.link_attributes: null
        set ev.link_owner: null
        set ev.end_prolog_lpd: null
        set ev.simple_link_names: null
        set ev.simple_link_atts: null
        set ev.link_rule: null
        set ev.link_set_after: null
        set ev.subdoc_parsed: false
        set ev.child_ps: null
        ev
    }

    ; external data entity reference in content (ExternalDataEntityEvent):
    ; the writer emits the entity's definition records (once per document)
    ; followed by the `&name` reference line.
    function make_entity_ref(host: pointer[Page], ent: pointer[Entity], loc: Location) returns pointer[Event]
    {
        let ev host.allocate(sizeof Event, alignof Event) as pointer[Event]
        set ev.event_type: EV_ENTITY_REF
        set ev.element_type: null
        set ev.entity: ent
        set ev.data: StringC()
        set ev.loc: loc
        set ev.markup_loc: loc
        set ev.included: false
        set ev.has_markup: false
        set ev.comments: null
        set ev.general_entities: null
        set ev.attributes: null
        set ev.link_attributes: null
        set ev.link_owner: null
        set ev.end_prolog_lpd: null
        set ev.simple_link_names: null
        set ev.simple_link_atts: null
        set ev.link_rule: null
        set ev.link_set_after: null
        set ev.subdoc_parsed: false
        set ev.child_ps: null
        ev
    }

    ; SubdocEntityEvent bracket events (SgmlsEventHandler::subdocEntity): the
    ; START carries the subdoc entity (writer defines it once, then `{name`),
    ; the END carries the same entity (writer emits `}name`). The nested
    ; sub-parse's events sit between them in the queue.
    function make_start_subdoc(host: pointer[Page], ent: pointer[Entity], loc: Location) returns pointer[Event]
    {
        let ev host.allocate(sizeof Event, alignof Event) as pointer[Event]
        set ev.event_type: EV_START_SUBDOC
        set ev.element_type: null
        set ev.entity: ent
        set ev.data: StringC()
        set ev.loc: loc
        set ev.markup_loc: loc
        set ev.included: false
        set ev.has_markup: false
        set ev.comments: null
        set ev.general_entities: null
        set ev.attributes: null
        set ev.link_attributes: null
        set ev.link_owner: null
        set ev.end_prolog_lpd: null
        set ev.simple_link_names: null
        set ev.simple_link_atts: null
        set ev.link_rule: null
        set ev.link_set_after: null
        set ev.subdoc_parsed: false
        set ev.child_ps: null
        ev
    }

    function make_end_subdoc(host: pointer[Page], ent: pointer[Entity], loc: Location) returns pointer[Event]
    {
        let ev host.allocate(sizeof Event, alignof Event) as pointer[Event]
        set ev.event_type: EV_END_SUBDOC
        set ev.element_type: null
        set ev.entity: ent
        set ev.data: StringC()
        set ev.loc: loc
        set ev.markup_loc: loc
        set ev.included: false
        set ev.has_markup: false
        set ev.comments: null
        set ev.general_entities: null
        set ev.attributes: null
        set ev.link_attributes: null
        set ev.link_owner: null
        set ev.end_prolog_lpd: null
        set ev.simple_link_names: null
        set ev.simple_link_atts: null
        set ev.link_rule: null
        set ev.link_set_after: null
        set ev.subdoc_parsed: false
        set ev.child_ps: null
        ev
    }

    ; EndPrologEvent (LINK axis) — see the field comment.
    function make_end_prolog(host: pointer[Page], lpd: pointer[void], names: pointer[Array[StringC]], atts: pointer[Array[pointer[AttributeList]]], loc: Location) returns pointer[Event]
    {
        let ev host.allocate(sizeof Event, alignof Event) as pointer[Event]
        set ev.event_type: EV_END_PROLOG
        set ev.element_type: null
        set ev.entity: null
        set ev.data: StringC()
        set ev.loc: loc
        set ev.markup_loc: loc
        set ev.included: false
        set ev.has_markup: false
        set ev.comments: null
        set ev.general_entities: null
        set ev.attributes: null
        set ev.link_attributes: null
        set ev.link_owner: null
        set ev.end_prolog_lpd: lpd
        set ev.simple_link_names: names
        set ev.simple_link_atts: atts
        set ev.link_rule: null
        set ev.link_set_after: null
        set ev.subdoc_parsed: false
        set ev.child_ps: null
        ev
    }

    ; CommentDeclEvent — the comment segments of one declaration; `loc` is the
    ; MDO (markupLocation()).
    function make_comment(host: pointer[Page], segs: pointer[Array[StringC]], loc: Location) returns pointer[Event]
    {
        let ev host.allocate(sizeof Event, alignof Event) as pointer[Event]
        set ev.event_type: EV_COMMENT
        set ev.element_type: null
        set ev.entity: null
        set ev.data: StringC()
        set ev.loc: loc
        set ev.markup_loc: loc
        set ev.included: false
        set ev.has_markup: false
        set ev.comments: segs
        set ev.general_entities: null
        set ev.attributes: null
        set ev.link_attributes: null
        set ev.link_owner: null
        set ev.end_prolog_lpd: null
        set ev.simple_link_names: null
        set ev.simple_link_atts: null
        set ev.link_rule: null
        set ev.link_set_after: null
        set ev.subdoc_parsed: false
        set ev.child_ps: null
        ev
    }

    ; NonSgmlCharEvent — the single non-SGML char (in data), at the char ref's
    ; start location.
    function make_nonsgml(host: pointer[Page], src: StringC, loc: Location) returns pointer[Event]
    {
        let ev host.allocate(sizeof Event, alignof Event) as pointer[Event]
        set ev.event_type: EV_NONSGML
        set ev.element_type: null
        set ev.entity: null
        set ev.data: StringC^host(src.data_ptr(), src.get_size())
        set ev.loc: loc
        set ev.markup_loc: loc
        set ev.included: false
        set ev.has_markup: false
        set ev.comments: null
        set ev.general_entities: null
        set ev.attributes: null
        set ev.link_attributes: null
        set ev.link_owner: null
        set ev.end_prolog_lpd: null
        set ev.simple_link_names: null
        set ev.simple_link_atts: null
        set ev.link_rule: null
        set ev.link_set_after: null
        set ev.subdoc_parsed: false
        set ev.child_ps: null
        ev
    }

    ; EntityDefaultedEvent / the lookup re-dispatch — the writer re-emits the
    ; entity's definition (-oentity only; see EV_ENTITY_DEFAULTED).
    function make_entity_defaulted(host: pointer[Page], ent: pointer[Entity], loc: Location) returns pointer[Event]
    {
        let ev host.allocate(sizeof Event, alignof Event) as pointer[Event]
        set ev.event_type: EV_ENTITY_DEFAULTED
        set ev.element_type: null
        set ev.entity: ent
        set ev.data: StringC()
        set ev.loc: loc
        set ev.markup_loc: loc
        set ev.included: false
        set ev.has_markup: false
        set ev.comments: null
        set ev.general_entities: null
        set ev.attributes: null
        set ev.link_attributes: null
        set ev.link_owner: null
        set ev.end_prolog_lpd: null
        set ev.simple_link_names: null
        set ev.simple_link_atts: null
        set ev.link_rule: null
        set ev.link_set_after: null
        set ev.subdoc_parsed: false
        set ev.child_ps: null
        ev
    }

    ; UselinkEvent (RAST only) — ls is the post-uselink current LinkSet.
    function make_uselink(host: pointer[Page], ls: pointer[void], loc: Location) returns pointer[Event]
    {
        let ev host.allocate(sizeof Event, alignof Event) as pointer[Event]
        set ev.event_type: EV_USELINK
        set ev.element_type: null
        set ev.entity: null
        set ev.data: StringC()
        set ev.loc: loc
        set ev.markup_loc: loc
        set ev.included: false
        set ev.has_markup: false
        set ev.comments: null
        set ev.general_entities: null
        set ev.attributes: null
        set ev.link_attributes: null
        set ev.link_owner: null
        set ev.end_prolog_lpd: null
        set ev.simple_link_names: null
        set ev.simple_link_atts: null
        set ev.link_rule: null
        set ev.link_set_after: ls
        set ev.subdoc_parsed: false
        set ev.child_ps: null
        ev
    }

    ; ---- accessors -------------------------------------------------------
    function get_type(this: Event) returns int
        event_type

    function get_entity(this: Event) returns pointer[Entity]
        entity

    function get_element_type(this: Event) returns pointer[ElementType]
        element_type

    function get_data(this: Event) returns StringC
        data

    function get_loc(this: Event) returns Location
        loc

    function get_markup_loc(this: Event) returns Location
        markup_loc

    function set_markup_loc(this: pointer[Event], l: Location)
        set this.markup_loc: l

    function is_included(this: Event) returns bool
        included

    function set_included(this: pointer[Event])
        set this.included: true

    ; a REAL source tag produced this start/end event (markupPtr() analog).
    function get_has_markup(this: Event) returns bool
        has_markup

    function set_has_markup(this: pointer[Event])
        set this.has_markup: true

    function get_comments(this: Event) returns pointer[Array[StringC]]
        comments

    function get_general_entities(this: Event) returns pointer[Array[pointer[Entity]]]
        general_entities

    function set_general_entities(this: pointer[Event], ge: pointer[Array[pointer[Entity]]])
        set this.general_entities: ge

    function get_attributes(this: Event) returns pointer[AttributeList]
        attributes

    function set_attributes(this: pointer[Event], atts: pointer[AttributeList])
        set this.attributes: atts

    ; ---- LINK axis -------------------------------------------------------
    function get_link_attributes(this: Event) returns pointer[AttributeList]
        link_attributes

    function get_link_owner(this: Event) returns pointer[StringC]
        link_owner

    function set_link_attributes(this: pointer[Event], atts: pointer[AttributeList], owner: pointer[StringC])
    {
        set this.link_attributes: atts
        set this.link_owner: owner
    }

    ; ---- RAST axis -------------------------------------------------------
    function get_link_rule(this: Event) returns pointer[void]
        link_rule

    function set_link_rule(this: pointer[Event], r: pointer[void])
        set this.link_rule: r

    function get_link_set_after(this: Event) returns pointer[void]
        link_set_after

    function set_link_set_after(this: pointer[Event], ls: pointer[void])
        set this.link_set_after: ls

    function get_subdoc_parsed(this: Event) returns bool
        subdoc_parsed

    function set_subdoc_parsed(this: pointer[Event])
        set this.subdoc_parsed: true

    function get_child_ps(this: Event) returns pointer[void]
        child_ps

    function set_child_ps(this: pointer[Event], c: pointer[void])
        set this.child_ps: c

    function get_end_prolog_lpd(this: Event) returns pointer[void]
        end_prolog_lpd

    function get_simple_link_names(this: Event) returns pointer[Array[StringC]]
        simple_link_names

    function get_simple_link_atts(this: Event) returns pointer[Array[pointer[AttributeList]]]
        simple_link_atts
}
