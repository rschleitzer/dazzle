use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use opensp.StringC.StringC
use opensp.Location.Location
use opensp.ParserState.ParserState
use opensp.Event.Event
use opensp.Attribute.AttributeValue
use opensp.Attribute.AttributeContext
use opensp.Attribute.AttributeDefinition
use opensp.Attribute.DeclaredValue
use opensp.Attribute.Text
use opensp.ParserMessages.ParserMessages
use opensp.AttributeList.AttributeList
use opensp.AttributeList.AttributeDefinitionList
use opensp.ElementType.ElementType
use opensp.ElementType.ElementDefinition
use opensp.Entity.Entity
use opensp.Notation.Notation
use opensp.ExternalId.ExternalId
use opensp.Dtd.Dtd
use opensp.Syntax.Syntax
use opensp.Sd.Sd
use opensp.OpenElement.OpenElement
use opensp.ContentState.ContentState
use opensp.Parser.Parser
use opensp.ModeInfo.ModeInfo
use opensp.Location.InputSource
use opensp.Location.Origin
use opensp.Storage.Storage

; ArcEngine — a Scaly port of James Clark's OpenSP ArcEngine (lib/ArcEngine.cxx
; + lib/ArcProcessor.h), the -A architectural-form processor (ISO/IEC 10744
; AFDR). Unlike the reference's streaming EventHandler chain, this runs as a
; POST-PARSE PASS over the materialized event queue (ParserState.events) — the
; same shape the RAST writer uses (Rast.scaly). The base document's events
; drive one ArcProcessor per ArcBase architecture; the processor consults a
; META-DTD (parsed on demand from the architecture's ArcDTD entity), maps each
; base element/attribute onto its architectural form, and GENERATES a fresh
; event stream. For the -A <name> selection (SelectOneArcDirector) only the
; matching architecture's generated stream is rendered; the base stream and any
; non-selected architecture go to a null sink.
;
; STATUS: the af-1 core path (single ArcBase, ArcFormA=architecture name, plain
; CDATA/#REQUIRED attribute mapping via buildAttributeMapRest, no suppression /
; renamer / token-map / #CONTENT / notation-data-form). The remaining reference
; surface (considerSupr/considerIgnD/considerNamer, token maps, emitArcContent,
; autoForm bridge, ArcQuant, the full supportAttributes table, mungeMetaDtd
; data entities) lands as the af-2..19 fixtures are driven green.

; openElementFlags_ bits (ArcEngine.cxx suppressForm/…): only the ones the
; af-1 path needs plus the frame marker.
define ARC_IS_ARC: u32 0x0001
define ARC_IGNORE_DATA: u32 0x0002
define ARC_RECOVER_DATA: u32 0x0004

define ArcProcessor
(
    valid: bool
    name: StringC
    doc_dtd: pointer[Dtd]
    meta_dtd: pointer[Dtd]
    doc_sd: pointer[Sd]
    doc_syntax: pointer[Syntax]
    meta_syntax: pointer[Syntax]
    cs: pointer[ContentState]
    ctx: pointer[AttributeContext]
    form_att_name: StringC
    namer_att: StringC
    supr_att: StringC
    ignd_att: StringC
    arc_doc_f: StringC
    supr_f: StringC
    brid_f: StringC
    data_f: StringC
    arc_auto: bool
    host: pointer[Page]
    ps: pointer[ParserState]
    cur_loc: Location
    out: pointer[Array[pointer[Event]]]
    open_flags: pointer[Array[u32]]
    n_flags: size_t
)
{
    function make(host: pointer[Page], name: StringC) returns pointer[ArcProcessor]
    {
        let p host.allocate(sizeof ArcProcessor, alignof ArcProcessor) as pointer[ArcProcessor]
        set p.valid: false
        set p.name: name
        set p.doc_dtd: null
        set p.meta_dtd: null
        set p.doc_sd: null
        set p.doc_syntax: null
        set p.meta_syntax: null
        set p.cs: null
        set p.ctx: null
        set p.form_att_name: StringC()
        set p.namer_att: StringC()
        set p.supr_att: StringC()
        set p.ignd_att: StringC()
        set p.arc_doc_f: StringC()
        set p.supr_f: StringC()
        set p.brid_f: StringC()
        set p.data_f: StringC()
        set p.arc_auto: true
        set p.host: host
        set p.ps: null
        set p.cur_loc: Location()
        set p.out: null
        set p.open_flags: Array[u32]^host()
        set p.n_flags: 0
        p
    }

    function flags_push(this: pointer[ArcProcessor], v: u32)
    {
        if this.n_flags < this.open_flags.get_length()
            this.open_flags.put(this.n_flags, v)
        else
            this.open_flags.add(v)
        set this.n_flags: this.n_flags + 1
    }

    function flags_top(this: ArcProcessor) returns u32
    {
        if n_flags = 0
            return 0 as u32
        *(open_flags.get_buffer() + (n_flags - 1))
    }

    function flags_pop(this: pointer[ArcProcessor])
    {
        if this.n_flags > 0
            set this.n_flags: this.n_flags - 1
    }

    ; init (ArcProcessor::init, ArcEngine.cxx:779): resolve the ArcBase notation,
    ; read the ArcDTD support attribute, parse the meta-DTD, set up content state.
    function setup(this: pointer[ArcProcessor], host: pointer[Page], ps: pointer[ParserState], doc_dtd: pointer[Dtd], sd: pointer[Sd], syntax: pointer[Syntax])
    {
        set this.doc_dtd: doc_dtd
        set this.doc_sd: sd
        set this.doc_syntax: syntax
        set this.meta_syntax: syntax
        set this.host: host
        set this.ps: ps

        let notation doc_dtd.lookup_notation(this.name)
        if notation = null
            return

        ; read the support attributes off the notation's attribute definition
        ; (supportAttributes, ArcEngine.cxx:1093, notation column). The doc-side
        ; attribute names (ArcFormA/ArcNamrA/ArcSuprA/ArcIgnDA) fold with the doc
        ; general subst table; the meta-side element/notation names (ArcDocF/
        ; ArcSuprF/ArcBridF/ArcDataF) with the meta table (= doc table here).
        let nad notation.get_attribute_def()
        var arc_dtd StringC()
        if nad <> null
        {
            let al AttributeList.make(host, nad)
            let nctx AttributeContext.make(host, syntax, false, true)
            al.finish(nctx)
            set this.form_att_name: ArcEngine.support_att(host, syntax, al, StringC("ArcFormA"), true)
            set this.namer_att: ArcEngine.support_att(host, syntax, al, StringC("ArcNamrA"), true)
            set this.supr_att: ArcEngine.support_att(host, syntax, al, StringC("ArcSuprA"), true)
            set this.ignd_att: ArcEngine.support_att(host, syntax, al, StringC("ArcIgnDA"), true)
            set this.arc_doc_f: ArcEngine.support_att(host, syntax, al, StringC("ArcDocF"), true)
            set this.supr_f: ArcEngine.support_att(host, syntax, al, StringC("ArcSuprF"), true)
            set this.brid_f: ArcEngine.support_att(host, syntax, al, StringC("ArcBridF"), true)
            set this.data_f: ArcEngine.support_att(host, syntax, al, StringC("ArcDataF"), true)
            set arc_dtd: ArcEngine.support_att(host, syntax, al, StringC("ArcDTD"), false)
            ; ArcAuto: "ArcAuto" (default, auto on) vs "nArcAuto" (auto off).
            let auto_v ArcEngine.support_att(host, syntax, al, StringC("ArcAuto"), true)
            if auto_v.get_size() > 0
            {
                if auto_v.equals(ArcEngine.fold_sc(host, syntax, StringC("nArcAuto")))
                    set this.arc_auto: false
            }
        }
        if arc_dtd.get_size() = 0
            return

        ; ArcDocF and ArcFormA default to the architecture name (subst'd).
        if this.arc_doc_f.get_size() = 0
            set this.arc_doc_f: this.name
        if this.form_att_name.get_size() = 0
            set this.form_att_name: this.name

        ; the meta-DTD entity (ArcDTD names a general entity in the doc DTD).
        let ent doc_dtd.lookup_entity(false, arc_dtd)
        if ent = null
            return
        if ent.is_external() = false
            return
        let meta_sysid ent.get_external_id().get_system_id()
        let base_dir ps.get_decl_base_dir()

        let mdtd ArcEngine.parse_meta_dtd(host, ps, this.arc_doc_f, base_dir, meta_sysid, sd, syntax)
        if mdtd = null
            return
        set this.meta_dtd: mdtd

        let doc_et mdtd.get_document_element_type()
        if doc_et = null
            return
        let def doc_et.get_definition()
        if def = null
            return
        if def.undefined()
            return

        let cs ContentState.make(host)
        cs.start_content(host, mdtd)
        set this.cs: cs
        set this.ctx: AttributeContext.make(host, this.meta_syntax, true, true)
        set this.valid: true
    }

    ; considerForm (ArcEngine.cxx:1727, af-1 subset): the ArcFormA attribute on
    ; the base element names the architectural element type.
    function consider_form(this: pointer[ArcProcessor], atts: pointer[AttributeList], base_et: pointer[ElementType]) returns pointer[ElementType]
    {
        if atts <> null
        {
            let idx atts.attribute_index(this.form_att_name)
            if idx >= 0
            {
                let val atts.value(idx as size_t)
                if val <> null
                {
                    let txt val.get_text()
                    if txt <> null
                    {
                        let meta_name ArcEngine.fold_sc(this.host, this.meta_syntax, (*txt).string())
                        return this.meta_dtd.lookup_element_type(meta_name)
                    }
                }
            }
        }
        ; autoForm (ArcEngine.cxx:1782): no explicit ArcFormA — the document
        ; element maps to the meta document element; otherwise (ArcAuto on) the
        ; base element name selects the meta element type of the same name;
        ; failing that, a base element with a specified ID maps to ArcBridF.
        this.auto_form(base_et, atts)
    }

    function auto_form(this: pointer[ArcProcessor], base_et: pointer[ElementType], atts: pointer[AttributeList]) returns pointer[ElementType]
    {
        if this.n_flags = 0
            return this.meta_dtd.get_document_element_type()
        var et: pointer[ElementType] null
        if this.arc_auto
        {
            if base_et <> null
                set et: this.meta_dtd.lookup_element_type((*base_et).get_name())
        }
        if et <> null
            return et
        if (this.brid_f.get_size() > 0) and (atts <> null)
        {
            let def atts.get_def()
            if def <> null
            {
                let idx def.get_id_index()
                if idx <> ADL_NONE
                {
                    if atts.specified(idx)
                        return this.meta_dtd.lookup_element_type(this.brid_f)
                }
            }
        }
        null
    }

    ; mapAttributes (ArcEngine.cxx:1432) + buildAttributeMapRest (af-1 subset):
    ; each architectural attribute takes its value from the same-named base
    ; attribute.
    ; copy one base attribute's text value into the meta attribute at to_idx.
    function copy_att(this: pointer[ArcProcessor], host: pointer[Page], from_atts: pointer[AttributeList], from_idx: size_t, to: pointer[AttributeList], to_idx: size_t)
    {
        let val from_atts.value(from_idx)
        if val <> null
        {
            let txt val.get_text()
            if txt <> null
            {
                to.set_spec(to_idx, this.ctx)
                to.set_value(host, to_idx, txt, this.ctx)
            }
        }
    }

    ; buildAttributeMapRename (ArcEngine.cxx:1849, name-pair subset): the renamer
    ; attribute's value is space-separated pairs `metaAtt baseAtt` — map each meta
    ; attribute from the named base attribute and mark it renamed. (#ARCCONT /
    ; #CONTENT / #DEFAULT / #MAPTOKEN forms are not yet handled.)
    function apply_rename(this: pointer[ArcProcessor], host: pointer[Page], spec: StringC, from_atts: pointer[AttributeList], to: pointer[AttributeList], meta_def: pointer[AttributeDefinitionList], renamed: pointer[Array[u8]])
    {
        let toks ArcEngine.split_ws(host, this.doc_syntax, spec)
        let nt toks.get_length()
        var i: size_t 0
        while (i + 1) < nt
        {
            let to_name ArcEngine.fold_sc(host, this.meta_syntax, *(toks.get_buffer() + i))
            let from_name ArcEngine.fold_sc(host, this.doc_syntax, *(toks.get_buffer() + (i + 1)))
            let to_idx meta_def.attribute_index(to_name)
            let from_idx from_atts.attribute_index(from_name)
            if (to_idx >= 0) and (from_idx >= 0)
            {
                this.copy_att(host, from_atts, from_idx as size_t, to, to_idx as size_t)
                renamed.put(to_idx as size_t, 1)
            }
            set i: i + 2
        }
    }

    ; mapAttributes (ArcEngine.cxx:1432): apply the renamer (considerNamer +
    ; buildAttributeMapRename) then fill the remaining meta attributes by
    ; same-name match (buildAttributeMapRest).
    function map_attributes(this: pointer[ArcProcessor], host: pointer[Page], from_atts: pointer[AttributeList], meta_et: pointer[ElementType]) returns pointer[AttributeList]
    {
        let meta_def meta_et.get_attribute_def()
        let to AttributeList.make(host, meta_def)
        if (meta_def <> null) and (from_atts <> null)
        {
            let ndefs meta_def.size()
            let renamed Array[u8]^host()
            var ri: size_t 0
            while ri < ndefs
            {
                renamed.add(0)
                set ri: ri + 1
            }
            ; considerNamer: the renamer attribute on the base element.
            if this.namer_att.get_size() > 0
            {
                let nidx from_atts.attribute_index(this.namer_att)
                if nidx >= 0
                {
                    let nval from_atts.value(nidx as size_t)
                    if nval <> null
                    {
                        let ntext nval.get_text()
                        if ntext <> null
                            this.apply_rename(host, (*ntext).string(), from_atts, to, meta_def, renamed)
                    }
                }
            }
            ; buildAttributeMapRest: same-name for non-renamed meta attributes.
            var i: size_t 0
            while i < ndefs
            {
                if *(renamed.get_buffer() + i) = 0
                {
                    let mdef meta_def.def(i)
                    if mdef <> null
                    {
                        let fidx from_atts.attribute_index((*mdef).get_name())
                        if fidx >= 0
                            this.copy_att(host, from_atts, fidx as size_t, to, i)
                    }
                }
                set i: i + 1
            }
            ; validate enumerated (name-token-group) meta attributes against
            ; their allowed value list. The reference emits attributeValueNotInGroup
            ; from the parser's own attribute path; here it flows through the
            ; parent parser state, so it prints with the element's location and
            ; counts toward the exit status (a non-conforming arch instance).
            var vi: size_t 0
            while vi < ndefs
            {
                if to.specified(vi)
                {
                    let mdef2 meta_def.def(vi)
                    if mdef2 <> null
                    {
                        let dv (*mdef2).get_declared_value()
                        if dv <> null
                        {
                            let allowed (*dv).get_tokens()
                            if (allowed <> null) and ((*dv).is_notation() = false)
                            {
                                let vval to.value(vi)
                                if vval <> null
                                {
                                    let vs (*vval).get_string()
                                    if ArcEngine.in_group(vs, allowed) = false
                                    {
                                        let rep Parser.make(host, this.ps)
                                        rep.report2_vec_at(ParserMessages.attributeValueNotInGroup(), vs, (*mdef2).get_name(), allowed, this.cur_loc)
                                    }
                                }
                            }
                        }
                    }
                }
                set vi: vi + 1
            }
        }
        to.finish(this.ctx)
        to
    }

    ; processStartElement (ArcEngine.cxx:1286, af-1 subset).
    function process_start_element(this: pointer[ArcProcessor], host: pointer[Page], ev: pointer[Event])
    {
        set this.cur_loc: ev.get_markup_loc()
        let atts ev.get_attributes()
        let meta_et this.consider_form(atts, ev.get_element_type())
        if meta_et = null
        {
            this.flags_push(0)
            return
        }
        let to this.map_attributes(host, atts, meta_et)
        let gen Event.make_start(host, meta_et, ev.get_loc())
        gen.set_attributes(to)
        this.cs.current_element().try_transition(meta_et)
        this.cs.push_element(OpenElement.make(host, meta_et, false, false, this.cs.get_the_empty_map(), ev.get_loc()))
        this.out.add(gen)
        this.flags_push(ARC_IS_ARC)
    }

    ; processData (ArcEngine.cxx:1409, af-1 subset): architectural iff the
    ; current architectural element admits PCDATA.
    function process_data_arc(this: pointer[ArcProcessor]) returns bool
    {
        if (this.flags_top() & ARC_IGNORE_DATA) <> 0
            return false
        let ce this.cs.current_element()
        if (ce.declared_empty() = false) and ce.try_transition_pcdata()
            return true
        false
    }

    ; processEndElement (ArcEngine.cxx:2029).
    function process_end_element(this: pointer[ArcProcessor], host: pointer[Page], ev: pointer[Event])
    {
        let was_arc (this.flags_top() & ARC_IS_ARC) <> 0
        this.flags_pop()
        if was_arc
        {
            let et this.cs.current_element().get_type()
            let gen Event.make_end(host, et, ev.get_loc())
            this.out.add(gen)
            this.cs.pop_element()
        }
    }
}

define ArcEngine ( )
{
    ; fold a StringC through the general substitution table (NAMECASE GENERAL).
    ; ★The result must be PAGE-HOSTED on `host`, not built as the plain return
    ; expression: `StringC(buf, n)` runs the copying init, which allocates
    ; through `Page.get(this)` — and as a return value `this` is the CALLER's
    ; return slot, i.e. a stack temporary, so the characters land on the
    ; caller's region FRAME page and dangle the moment that frame pops
    ; (CLAUDE.md, "Strings"). `setup` stores these folded names in long-lived
    ; fields (form_att_name/namer_att/…), so the dangling buffer is read on
    ; every later element: `consider_form` stopped finding the ArcFormA
    ; attribute and silently dropped the element, which is exactly how
    ; synth-arc-07/08/11 lost their children — LATENT, because it only bites
    ; once something reuses the recycled frame page (more renamer tokens =
    ; more reuse = the second element fails where the first still worked).
    function fold_sc(host: pointer[Page], syntax: pointer[Syntax], s: StringC) returns StringC
    {
        let n s.get_size()
        let buf host.allocate((n + 1) * 4, 4) as pointer[u32]
        var i: size_t 0
        while i < n
        {
            set *(buf + i): syntax.fold(s.get(i))
            set i: i + 1
        }
        let p StringC^host(buf, n)
        *p
    }

    ; read a named support attribute's value from a finished attribute list.
    ; The lookup name folds through the general subst table; the returned value
    ; is folded too when do_fold (doc/meta names), left raw otherwise (ArcDTD =
    ; an entity name, entity-subst not general-subst — identity for the corpus).
    function support_att(host: pointer[Page], syntax: pointer[Syntax], al: pointer[AttributeList], name: StringC, do_fold: bool) returns StringC
    {
        let folded ArcEngine.fold_sc(host, syntax, name)
        let idx al.attribute_index(folded)
        if idx < 0
            return StringC()
        let v al.value(idx as size_t)
        if v = null
            return StringC()
        let t v.get_text()
        if t = null
            return StringC()
        let s (*t).string()
        if do_fold
            return ArcEngine.fold_sc(host, syntax, s)
        s
    }

    ; split a StringC on whitespace into raw (unfolded) tokens. ★The tokens are
    ; page-hosted for the same reason as fold_sc above: `substr` builds its
    ; result with the copying init, so as a plain temporary its characters would
    ; land on THIS frame's region page and dangle as soon as split_ws returns —
    ; and the array outlives the call by construction.
    function split_ws(host: pointer[Page], syntax: pointer[Syntax], s: StringC) returns pointer[Array[StringC]]
    {
        let out Array[StringC]^host()
        let n s.get_size()
        var i: size_t 0
        while i < n
        {
            while (i < n) and ArcEngine.is_s(syntax, s.get(i))
                set i: i + 1
            if i < n
            {
                let start i
                while (i < n) and (ArcEngine.is_s(syntax, s.get(i)) = false)
                    set i: i + 1
                let tok StringC^host(s.data_ptr() + start, i - start)
                out.add(*tok)
            }
        }
        out
    }

    function in_group(v: StringC, allowed: pointer[Array[StringC]]) returns bool
    {
        let n allowed.get_length()
        var i: size_t 0
        while i < n
        {
            if (*(allowed.get_buffer() + i)).equals(v)
                return true
            set i: i + 1
        }
        false
    }

    function is_s(syntax: pointer[Syntax], c: u32) returns bool
    {
        if c = syntax.standard_function(fSPACE)
            return true
        if c = syntax.standard_function(fRS)
            return true
        if c = syntax.standard_function(fRE)
            return true
        if c = 9
            return true
        false
    }

    ; parse an external meta-DTD file into a fresh Dtd (ArcProcessor::init's
    ; sub-parse; models SgmlParser::Params{entityType=dtd}). Reuses the port's
    ; declaration-subset parser on a child ParserState sharing the parent's
    ; entity manager / catalog / options; the Dtd is queried straight off the
    ; local pointer (no end_dtd, which would move it to the stack).
    function parse_meta_dtd(host: pointer[Page], ps: pointer[ParserState], doctype_name: StringC, base_dir: String, sysid: String, sd: pointer[Sd], syntax: pointer[Syntax]) returns pointer[Dtd]
    {
        let child ParserState.make(host, null, 0, PHASE_DECL_SUBSET)
        child.set_sd(sd)
        let meta_syn Syntax^host(*sd)
        ; the meta-DTD parses under the same (implied) SGML declaration as the
        ; document: an implied declaration uses the ParserOptions near-unlimited
        ; quantities (NAMELEN 99999999 etc.), not the reference set — otherwise a
        ; long parameter-entity name in the meta-DTD wrongly trips NAMELEN.
        meta_syn.set_options_quantities()
        child.set_syntax(meta_syn)

        let mdtd Dtd.make(host, doctype_name, true)
        child.set_def_dtd(mdtd)
        child.set_current_dtd(mdtd)

        let p Parser.make(host, child)
        let table ModeInfo.build_table(host)
        p.install_recognizers(table)

        let storage Storage.OsFile(base_dir)
        let bytes storage.read(sysid)
        if bytes.get_length() = 0
            return null

        ; a sentinel bottom input (empty) stands in for the document entity: the
        ; external-subset end-of-entity handling pops the meta-DTD source and
        ; checks input_level < subset_level, so the meta-DTD must sit ABOVE
        ; something — otherwise the pop empties the stack and the next
        ; current_input() dereferences null (parse_doctype keeps the doc entity
        ; below the external subset for the same reason).
        let borg host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *borg: Origin()
        let bbuf host.allocate(4, 4) as pointer[u32]
        let bsrc host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
        set *bsrc: InputSource(borg, bbuf, 0)
        child.push_input(bsrc)

        let bn bytes.get_length()
        let buf host.allocate(bn * 4, 4) as pointer[u32]
        var ci: size_t 0
        while ci < bn
        {
            set *(buf + ci): bytes.get(ci) as u32
            set ci: ci + 1
        }
        let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org: Origin()
        let src host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
        set *src: InputSource(org, buf, bn)
        child.push_input(src)
        p.parse_decl_subset(child.get_input_level(), true)
        mdtd
    }

    ; scan a PI's data for `IS10744 ArcBase name...` and append one ArcProcessor
    ; per architecture name (ArcEngineImpl::pi, ArcEngine.cxx:220, ArcBase form).
    function scan_arcbase_pi(host: pointer[Page], syntax: pointer[Syntax], data: StringC, is10744: StringC, arc_base: StringC, procs: pointer[Array[pointer[ArcProcessor]]])
    {
        let names Array[StringC]^host()
        ArcEngine.scan_arcbase_names(host, syntax, data, is10744, arc_base, names)
        let nn names.get_length()
        var ni: size_t 0
        while ni < nn
        {
            procs.add(ArcProcessor.make(host, *(names.get_buffer() + ni)))
            set ni: ni + 1
        }
    }

    ; the name half of scan_arcbase_pi: append each architecture name the PI
    ; declares as a BASE architecture (folded through the general subst table,
    ; the form lookupNotation then keys on).
    function scan_arcbase_names(host: pointer[Page], syntax: pointer[Syntax], data: StringC, is10744: StringC, arc_base: StringC, names: pointer[Array[StringC]])
    {
        let dn data.get_size()
        let i10n is10744.get_size()
        if dn <= i10n
            return
        var j: size_t 0
        while j < i10n
        {
            if syntax.fold(data.get(j)) <> is10744.get(j)
                return
            set j: j + 1
        }
        var i i10n
        if ArcEngine.is_s(syntax, data.get(i)) = false
            return
        while (i < dn) and ArcEngine.is_s(syntax, data.get(i))
            set i: i + 1
        if i >= dn
            return
        var start i
        while (i < dn) and (ArcEngine.is_s(syntax, data.get(i)) = false)
            set i: i + 1
        let tok ArcEngine.fold_sc(host, syntax, data.substr(start, i - start))
        if tok.equals(arc_base) = false
            return
        var more true
        while more
        {
            while (i < dn) and ArcEngine.is_s(syntax, data.get(i))
                set i: i + 1
            if i >= dn
                set more: false
            else
            {
                set start: i
                while (i < dn) and (ArcEngine.is_s(syntax, data.get(i)) = false)
                    set i: i + 1
                let nm ArcEngine.fold_sc(host, syntax, data.substr(start, i - start))
                names.add(nm)
            }
        }
    }

    ; declares_base_architecture — the gate the reference's gotArc_ flag records
    ; (style/DssslSpecEventHandler.cxx:88 loadDoc): does the document declare, as
    ; a BASE architecture, an architecture whose notation carries `pubid` as its
    ; public identifier?
    ;
    ; It is the conjunction of three reference steps, all of which must hold:
    ;   1. ArcEngineImpl::pi (ArcEngine.cxx:220) sees an `IS10744 ArcBase name…`
    ;      PI and builds one ArcProcessor per name;
    ;   2. ArcProcessor::init (ArcEngine.cxx:838) resolves that name against the
    ;      document DTD's notations — `docDtd_->lookupNotation(name_)`;
    ;   3. the nested ArcEngineImpl hands that notation to the director, and the
    ;      director matches on its public id (SelectOneArcDirector /
    ;      DssslSpecEventHandler::arcEventHandler, which sets gotArc_).
    ;
    ; ★DECLARING THE NOTATION IS NOT DECLARING THE ARCHITECTURE. Without an
    ; ArcBase PI no ArcProcessor exists, step 3 never runs, and the reference
    ; reports its "not a base architecture" error — the notation-only test this
    ; replaces passed such a document (tests/dazzle/cli/notarc.dsl).
    ;
    ; The PI-declared form (`<?IS10744 ArcDecl …>` / ArcPubid support attribute)
    ; deliberately does NOT count: there ArcProcessor::init leaves `notation`
    ; null and the DSSSL director returns 0 without setting gotArc_.
    ;
    ; DEVIATION: the reference recognizes an ArcBase PI only at stage_ == 1, i.e.
    ; between startDtd and endDtd; the port's event queue has no DTD brackets, so
    ; PIs are taken up to the first start element (the prolog). A PI sitting
    ; between the DTD and the document element would wrongly count.
    function declares_base_architecture(host: pointer[Page], ps: pointer[ParserState], pubid: pointer[const_char]) returns bool
    {
        let doc_dtd ps.base_dtd()
        if doc_dtd = null
            return false
        let syntax ps.get_instance_syntax()
        if syntax = null
            return false

        let arc_base ArcEngine.fold_sc(host, syntax, StringC("ArcBase"))
        let is10744 ArcEngine.fold_sc(host, syntax, StringC("IS10744"))

        let names Array[StringC]^host()
        let n ps.n_events()
        var k: size_t 0
        while k < n
        {
            let ev ps.get_event(k)
            let ty ev.get_type()
            if ty = EV_START_ELEMENT
                break
            if ty = EV_PI
                ArcEngine.scan_arcbase_names(host, syntax, ev.get_data(), is10744, arc_base, names)
            set k: k + 1
        }

        let nn names.get_length()
        var ni: size_t 0
        while ni < nn
        {
            let nt doc_dtd.lookup_notation(*(names.get_buffer() + ni))
            if nt <> null
            {
                let xid nt.get_external_id()
                if xid.has_public_id()
                {
                    let pid xid.get_public_id()
                    if pid.equals(pubid)
                        return true
                }
            }
            set ni: ni + 1
        }
        false
    }

    ; drive the base event stream through a processor, generating the
    ; architectural stream into p.out.
    function run_events(host: pointer[Page], ps: pointer[ParserState], p: pointer[ArcProcessor])
    {
        let n ps.n_events()
        var k: size_t 0
        while k < n
        {
            let ev ps.get_event(k)
            let ty ev.get_type()
            if ty = EV_START_ELEMENT
                p.process_start_element(host, ev)
            else if ty = EV_END_ELEMENT
                p.process_end_element(host, ev)
            else if ty = EV_DATA
            {
                if p.process_data_arc()
                    p.out.add(Event.make_data(host, ev.get_data(), ev.get_loc()))
            }
            else if ty = EV_SDATA
            {
                if p.process_data_arc()
                    p.out.add(Event.make_sdata(host, ev.get_data(), ev.get_loc()))
            }
            set k: k + 1
        }
    }

    ; ArcEngine::parseAll + SelectOneArcDirector (ArcEngine.cxx:147/157): build
    ; the processors from the ArcBase PIs, init each, and replace the event
    ; queue with the SELECTED architecture's generated stream (empty when the
    ; selection matches no architecture — the reference's null handler).
    function transform(host: pointer[Page], ps: pointer[ParserState], arc_names: pointer[Array[String]]) returns bool
    {
        if arc_names = null
            return false
        if arc_names.get_length() = 0
            return false
        let doc_dtd ps.base_dtd()
        if doc_dtd = null
            return false
        let sd ps.get_sd()
        let syntax ps.get_instance_syntax()
        if syntax = null
            return false

        let arc_base ArcEngine.fold_sc(host, syntax, StringC("ArcBase"))
        let is10744 ArcEngine.fold_sc(host, syntax, StringC("IS10744"))

        let procs Array[pointer[ArcProcessor]]^host()
        let n ps.n_events()
        var k: size_t 0
        while k < n
        {
            let ev ps.get_event(k)
            if ev.get_type() = EV_PI
                ArcEngine.scan_arcbase_pi(host, syntax, ev.get_data(), is10744, arc_base, procs)
            set k: k + 1
        }

        let sel ArcEngine.fold_sc(host, syntax, StringC((*(arc_names.get_buffer())).to_c_string()))
        let result Array[pointer[Event]]^host()
        var pi: size_t 0
        while pi < procs.get_length()
        {
            let p *(procs.get_buffer() + pi)
            p.setup(host, ps, doc_dtd, sd, syntax)
            if p.name.equals(sel)
            {
                if p.valid
                {
                    set p.out: result
                    ArcEngine.run_events(host, ps, p)
                }
            }
            set pi: pi + 1
        }
        ps.set_events(result)
        true
    }
}
