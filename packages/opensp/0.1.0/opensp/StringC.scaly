use scaly.memory.Page

; StringC — OpenSP's string of Char (Char = u32 codepoint). In C++ it is a
; String<Char> value type over a resizable buffer; here it is a small value
; { data, size } whose Char buffer is region-allocated on the value's own
; page (Page.get(this)), mirroring scaly.containers.String's residency but
; over u32 elements. Copies are shallow (fine inside one parse region); the
; byte<->Char boundary is handled by CodingSystems, never here.
;
; Char is u32 throughout; CHAR_BYTES is its element size for allocation.
define CHAR_BYTES: size_t 4

define StringC (data: pointer[u32](null), size: size_t(0))
{
    ; Empty string — no allocation.
    init()
    {
        set data: null
        set size: 0
    }

    ; Copy n Chars from a raw buffer onto this value's page.
    init(chars: pointer[u32], n: size_t)
    {
        set size: n
        if n = (0 as size_t)
        {
            set data: null
            return
        }

        let own_page Page.get(this as pointer[void])
        set data: own_page.allocate(n * CHAR_BYTES, CHAR_BYTES) as pointer[u32]
        memcpy(data as pointer[void], chars as pointer[void], n * CHAR_BYTES)
    }

    ; Widen an ASCII/Latin-1 C string to Char (StringC.cs's string ctor:
    ; per-char zero-extend). The byte<->Char boundary otherwise lives in
    ; CodingSystems; this is only for building literal message/diagnostic text.
    init(ascii: pointer[const_char])
    {
        let n strlen ascii
        set size: n
        if n = (0 as size_t)
        {
            set data: null
            return
        }

        let own_page Page.get(this as pointer[void])
        set data: own_page.allocate(n * CHAR_BYTES, CHAR_BYTES) as pointer[u32]
        var i: size_t 0
        while i < n
        {
            set *(data + i): (*((ascii as pointer[u8]) + i)) as u32
            set i: i + 1
        }
    }

    function get_size(this: StringC) returns size_t
        size

    ; Raw Char buffer (region-resident) — for handing content to an InputSource.
    function data_ptr(this: StringC) returns pointer[u32]
        data

    function get(this: StringC, index: size_t) returns u32
    {
        if index >= size
            return (0 as u32)

        *(data + index)
    }

    function equals(this: StringC, other: StringC) returns bool
    {
        if size <> other.size
            return false

        if size = (0 as size_t)
            return true

        memcmp(data as pointer[void], other.data as pointer[void], size * CHAR_BYTES) = 0
    }

    function test() returns int
    {
        ; empty
        var empty StringC()
        if empty.get_size() <> (0 as size_t)
            return -1

        ; build "AB" (0x41, 0x42) via a stack buffer
        var buf u32[2]
        set *(buf as pointer[u32]): (0x41 as u32)
        set *((buf as pointer[u32]) + (1 as size_t)): (0x42 as u32)
        var s StringC(buf as pointer[u32], 2 as size_t)
        if s.get_size() <> (2 as size_t)
            return -2

        if s.get(0 as size_t) <> (0x41 as u32)
            return -3

        if s.get(1 as size_t) <> (0x42 as u32)
            return -4

        ; equality
        var s2 StringC(buf as pointer[u32], 2 as size_t)
        if s.equals(s2) = false
            return -5

        if empty.equals(s)
            return -6

        ; ASCII widen ctor produces the same "AB"
        var s3 StringC("AB")
        if s3.get_size() <> (2 as size_t)
            return -7

        if s3.equals(s) = false
            return -8

        if s3.get(0 as size_t) <> (0x41 as u32)
            return -9

        0
    }
}
