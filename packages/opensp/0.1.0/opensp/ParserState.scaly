use opensp.ContentToken.CmNode
use opensp.ElementType.ElementType
use opensp.ElementType.RankStem
use opensp.Attribute.AttributeContext
use opensp.Attribute.AttributeValue
use opensp.Attribute.Text
use opensp.AttributeList.AttributeList
use opensp.Recognizer.Recognizer
use opensp.ModeInfo.ModeInfo
use opensp.XcharMap.XcharMap
use opensp.Id.Id
use opensp.Id.IdTable
use opensp.EntityManager.EntityManager
use opensp.EntityCatalog.EntityCatalog
use opensp.EntityManager.EmConfig
