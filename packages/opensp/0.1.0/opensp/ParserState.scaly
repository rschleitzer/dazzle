use opensp.Lpd.IdLinkRuleGroup
use opensp.Lpd.LinkSetTable

; ParserState — a slice of ParserState.cs (the 1627-LOC parser god-object). This
; increment ports the STATE SCAFFOLD the parse methods read and mutate — the
; pivot from standalone data structures (unit-tested programmatically) to the
; live parser's running state — without the event-emission or LINK machinery.
;
; COMPOSITION, NOT INHERITANCE. C++ builds ParserState : ContentState +
; AttributeContext (multiple inheritance). Scaly has neither MI nor those bases,
; so ParserState is a page-hosted flat struct that COMPOSES a ContentState and an
; AttributeContext (their state is disjoint — the content-state increment already
; recorded this resolution). The content-model open-element stack lives on the
; composed ContentState; the attribute-defaulting flags + cached implied value
; live on the composed AttributeContext. The DTD-backed AttributeContext "live
; half" (id table, notation/entity lookup, current-attribute store) — deferred by
; the attributes increment as "the live parser subclass" — lands here as
; ParserState methods (they need the DTD / id table that live on ParserState).
;
; PORTED SLICE:
;  - scaffold: Sd/prolog+instance Syntax, DTD stack (currentDtd/defDtd/dtd_) +
;    instantiateDtd, EntityManager/EntityCatalog handles, currentMode, phase +
;    tag flags (inInstance/inStartTag/inEndTag/enterTag/leaveTag/inTag).
;  - input stack: pushInput/popInputStack/currentInput/currentLocation/
;    inputLevel/inputLevelElementIndex (InputSource nesting threaded in; the
;    C++ intrusive IList<InputSource> -> Array[pointer[InputSource]] + live
;    input_level, the OpenElement-stack pattern).
;  - mode/recognizer table: setRecognizer/recognizers_[nModes]/getToken +
;    setNormalMap/normalMap_ (XcharMap ported alongside).
;  - token buffer: currentToken / getCurrentToken(SubstTable).
;  - AttributeContext live half: getAttributeNotation/getAttributeEntity (through
;    the current DTD), defineId/noteIdref (id table, Id ported alongside),
;    noteCurrentAttribute/getCurrentAttribute (current-value store),
;    attributeSyntax; the validate/mayDefault flags + implied value wired from Sd.
;  - Messenger half: initMessage/dispatchMessage + message counter / severity
;    tracking, accumulating a simple Message queue. NO EventHandler sink.
;
; DEFERRED (each needs the event/parse machinery that lands with the Parser
; increment; where the state field is cheap it exists here, only the driving
; logic is deferred):
;  - EventHandler/EventQueue/OutputState/Event.cs ESIS emission — the parser
;    emits events; this increment builds the state the emitter reads. queueRe/
;    noteMarkup/noteStartElement/noteEndElement/noteData/eventQueue* omitted.
;  - Lpd + LINK processing and Markup capture (LINK is absent from the XML/model-
;    DTD corpus; markup recording is a wantMarkup-gated event surface). The
;    allLpd_/lpd_/defLpd_/activeLinkTypes_ fields + startLpd/endLpd/
;    activateLinkType/checkEntityStability/noteReferencedEntity are omitted.
;  - Pass1/Pass2 (maybeStartPass2/setPass2Start/pass1Handler) — a two-pass
;    optimization, not needed for correctness; pass2()/pass1Dtd_ omitted, so
;    lookupEntity's pass1/pass2 base-DTD reconciliation collapses to a plain
;    current-DTD lookup (see getAttributeEntity).
;  - parse-FLOW methods a Parser drives: startInstance, startDtd/endDtd,
;    startMarkedSection/endMarkedSection/the special-parse state machine,
;    pcdataRecover, referenceDsEntity, checkEntityStability, noteReferencedEntity.
;    Their STATE fields (special_parse_input_level/mode, marked_section_level/
;    special_level, in_instance) exist here and the push/pop mode transitions
;    that read them are ported; the driving logic belongs to the Parser.
;  - Allocator — the arena makes it a no-op (allocate on the run page); dropped.

; Phase (ParserState.Phase enum) — modelled as int constants.
define PHASE_NONE: int 0
define PHASE_INIT: int 1
define PHASE_PROLOG: int 2
define PHASE_DECL_SUBSET: int 3
define PHASE_INSTANCE_START: int 4
define PHASE_CONTENT: int 5

; OutputState levels (OutputState.cxx) — the RS/RE record-boundary state machine
; that shapes character data. Ordered so `>= OS_PENDING_AFTER_RSRE` means "a
; pending RE is held" (C++ hasPendingRe). One state per open output level (a stack
; growing on included elements); the top drives the current run.
define OS_AFTER_START_TAG: int 0
define OS_AFTER_RSRE: int 1
define OS_AFTER_DATA: int 2
define OS_PENDING_AFTER_RSRE: int 3
define OS_PENDING_AFTER_MARKUP: int 4

; DEFAULT_ERROR_LIMIT (ParserApp.cxx): onsgmls cancels the parse once this many
; error messages have been reported. The -E driver option overrides it at
; runtime (ParserState.error_limit); 0 disables the limit.
define ERROR_LIMIT: u32 200

; MessageReporter::Option (MessageReporter.h) — the -e/-g/-n/-x reporter
; flags, a bit mask on ParserState.reporter_options.
define REP_OPEN_ENTITIES: u32 1
define REP_OPEN_ELEMENTS: u32 2
define REP_MESSAGE_NUMBERS: u32 4
define REP_CLAUSES: u32 8

; OpenElementInfo (Message.h:154) — one open element in the -g "open elements:"
; snapshot: its gi, the last-matched token's element name (or #PCDATA) and
; 1-based content-model type index, and whether the element was included.
define OeInfo
(
    gi: StringC
    match_type: StringC
    match_index: u32
    has_match: bool
    included: bool
)

; Message (Message.cs, minimal) — a dispatched diagnostic: its type
; (fragment + severity) and the source location where it occurred. The full C++
; Message also carries the MessageArg vector + auxiliary/open-element info; the
; parser stage fills those. Defined in this module (rather than Message.scaly)
; because it needs Location, whose module is declared after Message.
; PendingOpen — a storage object of the multi-file document entity
; (mergeSystemIds) that failed to open. The reference opens storage objects
; LAZILY (ExternalInputSource::fill) and reports the failure when reading
; first needs the object's data; the port pre-reads, so the failure is queued
; here with `boundary` = the merged-buffer offset where the object's content
; would have started, and flushed to stderr once the document scan crosses it
; (or unconditionally at parse end). is_find selects the message shape:
; cannotFind(spec, tried-list) after a search-dir walk, openSystemCall(spec,
; strerror text) for the single-candidate open. Both argument StringCs are
; widened and pinned at queue time.
define PendingOpen (boundary: size_t, is_find: bool, spec: StringC, detail: StringC)
{
    init()
    {
        set boundary: 0
        set is_find: false
        set spec: StringC()
        set detail: StringC()
    }
}

define Message (type: MessageType, loc: Location)
{
    init(type: MessageType, loc: Location)
    {
        set this.type: type
        set this.loc: loc
    }

    function get_type(this: Message) returns MessageType
        type

    function get_loc(this: Message) returns Location
        loc
}

; A buffered diagnostic (Messenger keepMessages / keptMessages_). While the
; parser speculates (OMITTAG tag inference, handleBadStartTag), every message
; is HELD here: released (emitted + counted) only when the speculation commits
; (queueElementEvents -> releaseKeptMessages), dropped wholesale when it is
; rolled back (discardKeptMessages) — a discarded message never counts toward
; the error limit or the exit code. Args are stored DECOMPOSED into fixed
; scalar slots (the widest kept message carries 3): a MessageArg UNION field
; inside an Array-stored struct does not survive the copy round-trip (payload
; corruption), while plain StringC/scalar fields do (the Array[Message] queue
; is the precedent). Every arg fired during speculation names a DTD-stable
; string (element/attribute names), so no deep copy is needed.
define KA_NONE: int 0
define KA_STR: int 1
define KA_NUM: int 2
define KA_ORD: int 3
define KA_VEC: int 4
define KA_RAW: int 5

define KS_INFO: int 0
define KS_WARNING: int 1
define KS_QUANTITY: int 2
define KS_IDREF: int 3
define KS_ERROR: int 4

define KeptMessage
(
    ; the MessageType, decomposed like the args (its nested fragment StringC
    ; does not survive the struct round-trip either).
    msg_number: u32
    msg_text: StringC
    msg_sev: int
    loc: Location
    a0_kind: int
    a0_str: StringC
    a0_num: u64
    a0_vec: pointer[Array[StringC]]
    a1_kind: int
    a1_str: StringC
    a1_num: u64
    a1_vec: pointer[Array[StringC]]
    a2_kind: int
    a2_str: StringC
    a2_num: u64
    a2_vec: pointer[Array[StringC]]
    ; message() (the count-only err path) produces no output when released.
    silent: bool
    has_aux: bool
    aux_text: StringC
    aux_loc: Location
    ; MessageType::clauses_ (-x): pinned like msg_text.
    msg_clauses: StringC
    ; the -g open-element snapshot taken at REPORT time (Messenger::message
    ; runs initMessage before keepMessages stores the Message, so a kept
    ; message replays the elements open when it FIRED, not when it released).
    ; null = option off / not in the instance.
    oe_info: pointer[Array[OeInfo]]
)

; LinkProcessOpenElement (LinkProcess.h:23) — one per open element while an
; active complex LPD drives link processing: the link set CURRENT for the
; element's content, the set to RESTORE on uselink #RESTORE, and the POSTLINK
; state applied when the element ends.
define LpOpen
(
    current: pointer[LinkSet]
    restore: pointer[LinkSet]
    post: pointer[LinkSet]
    post_restore: bool
)

; LpdEntityRef (LpdEntityRef.h) — one entity consulted through the pass-1 DTD
; during the pass-2 prolog; checkEntityStability re-resolves it at the end of
; the pass-2 prolog and reports unstableLpd*Entity on any difference.
define LpdEntityRef
(
    entity: pointer[Entity]
    is_parameter: bool
    looked_at_default: bool
    found_in_pass1: bool
)

; EntityDecl::setDeclIn's LPD half (EntityDecl.h): the port's Entity union
; carries no decl-in fields, so entities declared inside an LPD subset register
; here (keyed by pointer identity — every definition is a distinct object).
define LpdEntityDecl
(
    entity: pointer[Entity]
    active: bool
)

; EntityDecl::defLocation_ for INTERNAL entities as a side table (the Entity
; union's Internal arm carries no location; external arms have their own).
define EntityDefLoc
(
    entity: pointer[Entity]
    loc: Location
)

; one recorded S run of a marked-section status keyword spec (the
; -winstance-status-keyword-s replay — see note_ms_s below).
define MsSItem
(
    loc: Location
    synced: bool
)

; RAST (-t): one nested subdoc parse triggered from an ENTITY-attribute's
; semantics (RastEventHandler::attributeInfo -> subdocEntityInfo). The parse
; runs at event-queue time (the reference parses at delivery time — stderr
; interleaving); the writer pops these in FIFO order, which matches its own
; attribute walk exactly (both walks visit attributes in RAST sort order).
define RastSubdocParse
(
    parsed: bool
    events: pointer[Array[pointer[Event]]]
    child_ps: pointer[void]
)

; RAST state shared across a whole run (parent document + every nested subdoc
; parse — the RastEventHandler globals, as opposed to the per-document
; RastSubdocState whose fields live per-ParserState below).
define RastShared
(
    ; the attribute-subdoc FIFO (see RastSubdocParse).
    results: pointer[Array[RastSubdocParse]]
    ; piErrorCount_ — any message dispatched through the RAST handler's own
    ; Messenger counts; #RAST-PI-ERROR instead of #ERROR when non-zero.
    pi_errors: u32
)
{
    function make(host: pointer[Page]) returns pointer[RastShared]
    {
        let r host.allocate(sizeof RastShared, alignof RastShared) as pointer[RastShared]
        set r.results: Array[RastSubdocParse]^host()
        set r.pi_errors: 0 as u32
        r
    }

    function note_pi_error(this: pointer[RastShared])
        set this.pi_errors: this.pi_errors + (1 as u32)

    function get_pi_errors(this: RastShared) returns u32
        pi_errors

    function get_results(this: RastShared) returns pointer[Array[RastSubdocParse]]
        results
}

define ParserState
(
    host: pointer[Page]
    ; --- composition ---
    content_state: pointer[ContentState]
    attribute_context: pointer[AttributeContext]
    ; --- entity layer handles ---
    entity_manager: pointer[EntityManager]
    entity_catalog: pointer[EntityCatalog]
    em_config: pointer[EmConfig]
    ; --- SGML declaration + concrete syntaxes ---
    sd: pointer[Sd]
    syntax: pointer[Syntax]
    prolog_syntax: pointer[Syntax]
    instance_syntax: pointer[Syntax]
    ; --- DTD stack ---
    current_dtd: pointer[Dtd]
    def_dtd: pointer[Dtd]
    dtd_stack: Array[pointer[Dtd]]
    instantiated_dtds: u32
    ; --- phase + tag flags ---
    phase: int
    final_phase: int
    subdoc_level: u32
    in_instance: bool
    in_start_tag: bool
    in_end_tag: bool
    ; --- scanner mode + deferred special-parse/marked-section state ---
    current_mode: int
    special_parse_input_level: u32
    special_parse_mode: int
    marked_section_level: u32
    marked_section_special_level: u32
    ; --- input stack (Array + live input_level, the OpenElement-stack pattern) ---
    input_stack: Array[pointer[InputSource]]
    input_level: u32
    input_level_element_index: Array[u32]
    n_input_level_element_index: size_t
    ; undefinedEntityTable_ (ParserState.cxx): createUndefinedEntity caches the
    ; entity it fabricates for an undefined general-entity reference here (keyed by
    ; name) so a SECOND reference reuses it — cannotGenerateSystemId/entityUndefined
    ; fire once, at creation, while nonExistentEntityRef fires on every reference.
    undefined_entities: Array[pointer[Entity]]
    ; --- mode/recognizer table + normal map ---
    recognizers: Array[pointer[Recognizer]]
    normal_map: pointer[XcharMap]
    ; --- AttributeContext live half ---
    id_table: pointer[IdTable]
    current_attributes: Array[pointer[AttributeValue]]
    n_current_attributes: size_t
    ; currentRank_ (ParserState.cxx): per rank-stem the CURRENT rank suffix
    ; (null = none), sized to Dtd.n_rank_stem at start_instance under RANK YES.
    current_rank: Array[pointer[StringC]]
    ; --- Messenger half ---
    messages: Array[Message]
    n_messages: u32
    n_errors: u32
    ; keepMessages/releaseKeptMessages/discardKeptMessages (Messenger): while
    ; keeping_messages, report*/message() land in kept_messages instead of the
    ; stderr stream + counters. n_kept tracks the live prefix (put/add reuse).
    keeping_messages: bool
    kept_messages: Array[KeptMessage]
    n_kept: size_t
    ; pcdataRecovering_ (ParserState.cxx): data was reported not-allowed once;
    ; suppress further pcdataNotAllowed until an element is pushed or popped.
    pcdata_recovering: bool
    ; markedSectionStartLocation_ — one Location per open marked section (the
    ; MDO of its `<![`), feeding unclosedMarkedSection's auxiliary line.
    ms_start_locations: Array[Location]
    n_ms_start_locations: size_t
    ; --- error-limit abort (ErrorCountEventHandler): once n_errors reaches the
    ;     limit (DEFAULT_ERROR_LIMIT = 200) the parse is CANCELLED — the content
    ;     loop stops immediately without closing the open elements or emitting the
    ;     conformance marker, exactly as onsgmls does. ---
    cancelled: bool
    ; --- Event stream (Stage 4): the content events in document order ---
    events: Array[pointer[Event]]
    ; --- OutputState (RS/RE record-boundary shaping): a per-output-level state
    ;     stack + live depth (grows on an included element, shrinks on its end).
    ;     os_re_loc parallels os_state: the pending RE's OWN location
    ;     (OutputStateLevel::reLocation) — the flushed RE data event carries
    ;     it, not the flush position (-oline resolves it to the RE's line). ---
    os_state: Array[int]
    os_re_loc: Array[Location]
    os_depth: u32
    ; --- IMPLYDEF (set from Sd) ---
    implydef_element: int
    implydef_attlist: bool
    ; --- the document entity's directory: relative SYSTEM ids (the external DTD
    ;     subset, external text entities referenced in content) resolve against
    ;     it. Held here rather than threaded through every parse_* signature, so
    ;     do_content -> parse_entity_reference can see it. ---
    base_dir: String
    ; --- the directory a relative SYSTEM id in an entity DECLARATION resolves
    ;     against (PosixStorageManager::resolveRelative uses the base = the file
    ;     the declaration is in). It follows the external file currently being
    ;     parsed: document base while in the internal subset / document, the
    ;     external DTD subset's own directory while that subset is parsed. Each
    ;     external entity captures it at declaration time (its content is opened
    ;     LATER, after that file has been popped). ---
    decl_base_dir: String
    ; --- diagnostic prefix: the program name onsgmls prints before every
    ;     message (MessageReporter::programName_). Set from argv[0]; the harness
    ;     normalizes it away, so its exact value is not load-bearing. ---
    prog_name: String
    ; --- output coding system (CmdLineApp::initCodingSystem): false = identity
    ;     (the default — single byte per Char <= 0xFF), true = UTF-8
    ;     (SP_CHARSET_FIXED=YES + SP_ENCODING=XML/UTF-8). Decided once from the
    ;     environment by the driver (onsgmls.scaly); shared by the ESIS stdout
    ;     stream (Esis.write, which also escapes unencodable chars as `\#N;`)
    ;     and the message stderr stream (write_stderr — no escaper there:
    ;     makeStdErr never calls setEscaper, unencodable chars are dropped). ---
    out_utf8: bool
    ; --- outputCodingSystem_ — the run's OUTPUT coding system (environment
    ;     default, -b override), applied by Esis.encode_out / Rast over the
    ;     writers' internal UTF-8 streams. null = fall back to out_utf8's
    ;     historical identity/UTF-8 pair. stderr stays on out_utf8: makeStdErr
    ;     uses codingSystem(), never outputCodingSystem_. ---
    out_enc: pointer[OutputEncoder]
    ; --- MessageReporter::options_ — the -e/-g/-n/-x reporter flags (REP_*). ---
    reporter_options: u32
    ; --- SgmlsEventHandler output flags (OF_*, the -o axis): the writer reads
    ;     them, and the parser gates the -o-only event payloads (comment
    ;     capture, the endProlog entity sweep, entity-defaulted events). ---
    output_flags: u32
    ; --- ParserApp::errorLimit_ (-E): 0 = unlimited. ---
    error_limit: u32
    ; --- the message sink fd (-f error-file redirects it; default 2). ---
    msg_fd: int
    ; --- -p only-prolog (PrologMessageEventHandler::endProlog cancels the
    ;     parse when the end-prolog event is delivered). ---
    prolog_only: bool
    ; --- LINK axis (ParserState.cxx): the LPD being defined, the LPDs seen so
    ;     far (all) and the ACTIVE ones (lpd_), and the -a activation list. ---
    def_lpd: pointer[Lpd]
    had_lpd: bool
    active_lpds: Array[pointer[Lpd]]
    all_lpds: Array[pointer[Lpd]]
    active_link_types: Array[StringC]
    active_link_types_substed: bool
    ; resultAttributeSpecMode_ — result element specs in explicit link rules
    ; resolve entities/notations against the RESULT dtd.
    result_attribute_spec_mode: bool
    ; --- pass 1 / pass 2 (setPass2Start/maybeStartPass2): with LINK admitted
    ;     and link types activated, the whole document parses TWICE — pass 1
    ;     discovers which LPDs activate (its non-error messages buffer in
    ;     pass1_kept and are DISCARDED when pass 2 starts; errors pass through
    ;     immediately and veto pass 2), pass 2 re-parses with the pass-1 base
    ;     DTD available for entity-stability checking. ---
    pass2: bool
    allow_pass2: bool
    had_pass2_start: bool
    pass2_start_index: size_t
    pass1_dtd: pointer[Dtd]
    pass1_had_error: bool
    pass1_kept: Array[KeptMessage]
    n_pass1_kept: size_t
    pass1_events_mark: size_t
    ; --- entity-stability tracking (noteReferencedEntity/checkEntityStability)
    ;     + the entity->declared-in-LPD side table (see LpdEntityDecl). ---
    lpd_entity_refs: Array[LpdEntityRef]
    lpd_entity_decls: Array[LpdEntityDecl]
    ; --- defaulted entities (Entity::defaulted() as a side table — the Entity
    ;     union carries no flag fields, cf. lpd_entity_decls) + the per-instance
    ;     defaulted-copy cache (ParserState::instanceDefaultedEntityTable_). ---
    defaulted_entities: Array[pointer[Entity]]
    used_entities: Array[pointer[Entity]]
    entity_def_locs: Array[EntityDefLoc]
    ms_s_track: bool
    ms_s_synced: bool
    ms_s_have_last: bool
    ms_s_last_origin: pointer[Origin]
    ms_s_last_index: u32
    ms_s_items: Array[MsSItem]
    instance_defaulted: Array[pointer[Entity]]
    ; --- AFDR (Annex K): hadAfdrDecl_; errorAfdr now lives on parser_options. ---
    had_afdr_decl: bool
    ; --- the -w axis: ParserOptions (never null — make() installs the
    ;     defaults, the driver's set_options replaces them; a subdoc child
    ;     inherits the parent's pointer). ---
    parser_options: pointer[ParserOptions]
    ; --- the link process (LinkProcess.cxx; app-side in the reference, driven
    ;     here at event-queue time — the queue point IS the handler's stream
    ;     position). Initialized by the EndPrologEvent that carries an active
    ;     complex LPD. lp_open is the open-element stack (top = last). ---
    have_link_process: bool
    lp_lpd: pointer[Lpd]
    lp_name: pointer[StringC]
    lp_open: Array[LpOpen]
    lp_depth: size_t
    ; --- deferred open failures of the multi-file document entity (see
    ;     PendingOpen): flushed by scan position at every stderr emission,
    ;     unconditionally at parse end. ---
    pending_opens: pointer[Array[PendingOpen]]
    pending_open_next: size_t
    in_pending_flush: bool
    ; --- RAST (-t): the run-global shared half (null = RAST off) plus the
    ;     per-document RastSubdocState (RastEventHandler.h:73) — a subdoc
    ;     child ParserState starts these fresh, exactly like the reference's
    ;     swap/init around a nested parse. ---
    rast: pointer[RastShared]
    ; parseSubdocQueue_ (0/1 per rast-parse-subdoc PI) + consumed head.
    rast_psq: Array[int]
    rast_psq_head: size_t
    ; linkRuleQueue_ (the rast-link-rule: PI payloads) + consumed head.
    rast_lrq_pi: Array[StringC]
    rast_lrq_loc: Array[Location]
    rast_lrq_head: size_t
    ; hadActiveLpdOrDtd_ / activeLpdOrDtdLocation_ / activeLinkTypes_ — the
    ; PI-declared active link types (NOT the -a list, which never renders
    ; #ACTIVE-LINK blocks).
    rast_had_active: bool
    rast_active_loc: Location
    rast_active_types: Array[StringC]
    ; hadDocumentElement_ (parse-time half: the invalidActiveLinkType check).
    rast_had_doc_element: bool
    ; the endProlog simple-link stash (the writer reads the event; this feeds
    ; the parse-time first-element check).
    rast_simple_names: pointer[Array[StringC]]
    ; pass-1 interleave marks: events.length at each pass-1 kept message, so
    ; the no-pass2 replay interprets buffered rast PIs in stream order.
    pass1_kept_marks: Array[size_t]
)
{
    function make(host: pointer[Page], entity_manager: pointer[EntityManager], subdoc_level: u32, final_phase: int) returns pointer[ParserState]
    {
        let ps host.allocate(sizeof ParserState, alignof ParserState) as pointer[ParserState]
        set ps.host: host
        set ps.content_state: ContentState.make(host)
        set ps.attribute_context: AttributeContext.make(host, null as pointer[Syntax], false, false)
        set ps.entity_manager: entity_manager
        set ps.entity_catalog: null
        set ps.em_config: null
        set ps.sd: null
        set ps.syntax: null
        set ps.prolog_syntax: null
        set ps.instance_syntax: null
        set ps.current_dtd: null
        set ps.def_dtd: null
        set ps.dtd_stack: Array[pointer[Dtd]]^host()
        set ps.instantiated_dtds: 0 as u32
        set ps.phase: PHASE_NONE
        set ps.final_phase: final_phase
        set ps.subdoc_level: subdoc_level
        set ps.in_instance: false
        set ps.in_start_tag: false
        set ps.in_end_tag: false
        set ps.current_mode: proMode
        set ps.special_parse_input_level: 0 as u32
        set ps.special_parse_mode: proMode
        set ps.marked_section_level: 0 as u32
        set ps.marked_section_special_level: 0 as u32
        set ps.input_stack: Array[pointer[InputSource]]^host()
        set ps.input_level: 0 as u32
        set ps.input_level_element_index: Array[u32]^host()
        set ps.n_input_level_element_index: 0
        set ps.undefined_entities: Array[pointer[Entity]]^host()
        set ps.recognizers: Array[pointer[Recognizer]]^host()
        var i: int 0
        while i < N_MODES
        {
            ps.recognizers.add(null as pointer[Recognizer])
            set i: i + 1
        }
        set ps.normal_map: null
        set ps.id_table: IdTable.make(host)
        set ps.current_attributes: Array[pointer[AttributeValue]]^host()
        set ps.n_current_attributes: 0
        set ps.current_rank: Array[pointer[StringC]]^host()
        set ps.messages: Array[Message]^host()
        set ps.n_messages: 0 as u32
        set ps.n_errors: 0 as u32
        set ps.keeping_messages: false
        set ps.kept_messages: Array[KeptMessage]^host()
        set ps.n_kept: 0
        set ps.pcdata_recovering: false
        set ps.ms_start_locations: Array[Location]^host()
        set ps.n_ms_start_locations: 0
        set ps.cancelled: false
        set ps.events: Array[pointer[Event]]^host()
        set ps.os_state: Array[int]^host()
        ps.os_state.add(OS_AFTER_START_TAG)
        set ps.os_re_loc: Array[Location]^host()
        ps.os_re_loc.add(Location())
        set ps.os_depth: 1 as u32
        set ps.implydef_element: 0
        set ps.implydef_attlist: false
        set ps.base_dir: String()
        set ps.decl_base_dir: String()
        set ps.prog_name: String()
        set ps.out_utf8: false
        set ps.out_enc: null
        set ps.reporter_options: 0 as u32
        set ps.output_flags: 0 as u32
        set ps.error_limit: ERROR_LIMIT
        set ps.msg_fd: 2
        set ps.prolog_only: false
        set ps.def_lpd: null
        set ps.had_lpd: false
        set ps.active_lpds: Array[pointer[Lpd]]^host()
        set ps.all_lpds: Array[pointer[Lpd]]^host()
        set ps.active_link_types: Array[StringC]^host()
        set ps.active_link_types_substed: false
        set ps.result_attribute_spec_mode: false
        set ps.pass2: false
        set ps.allow_pass2: false
        set ps.had_pass2_start: false
        set ps.pass2_start_index: 0
        set ps.pass1_dtd: null
        set ps.pass1_had_error: false
        set ps.pass1_kept: Array[KeptMessage]^host()
        set ps.n_pass1_kept: 0
        set ps.pass1_events_mark: 0
        set ps.lpd_entity_refs: Array[LpdEntityRef]^host()
        set ps.lpd_entity_decls: Array[LpdEntityDecl]^host()
        set ps.defaulted_entities: Array[pointer[Entity]]^host()
        set ps.used_entities: Array[pointer[Entity]]^host()
        set ps.entity_def_locs: Array[EntityDefLoc]^host()
        set ps.ms_s_track: false
        set ps.ms_s_synced: false
        set ps.ms_s_have_last: false
        set ps.ms_s_last_origin: null
        set ps.ms_s_last_index: 0 as u32
        set ps.ms_s_items: Array[MsSItem]^host()
        set ps.instance_defaulted: Array[pointer[Entity]]^host()
        set ps.had_afdr_decl: false
        set ps.parser_options: ParserOptions.make(host)
        set ps.have_link_process: false
        set ps.lp_lpd: null
        set ps.lp_name: null
        set ps.lp_open: Array[LpOpen]^host()
        set ps.lp_depth: 0
        set ps.pending_opens: null
        set ps.pending_open_next: 0
        set ps.in_pending_flush: false
        set ps.rast: null
        set ps.rast_psq: Array[int]^host()
        set ps.rast_psq_head: 0
        set ps.rast_lrq_pi: Array[StringC]^host()
        set ps.rast_lrq_loc: Array[Location]^host()
        set ps.rast_lrq_head: 0
        set ps.rast_had_active: false
        set ps.rast_active_loc: Location()
        set ps.rast_active_types: Array[StringC]^host()
        set ps.rast_had_doc_element: false
        set ps.rast_simple_names: null
        set ps.pass1_kept_marks: Array[size_t]^host()
        ps
    }

    ; ---- RAST (-t) --------------------------------------------------------
    function set_rast(this: pointer[ParserState], r: pointer[RastShared])
        set this.rast: r

    function get_rast(this: ParserState) returns pointer[RastShared]
        rast

    function rast_on(this: ParserState) returns bool
        rast <> null

    function get_rast_active_types(this: pointer[ParserState]) returns pointer[Array[StringC]]
    {
        return &this.rast_active_types
    }

    ; the writer's raw view of the event queue.
    function events_buffer(this: ParserState) returns pointer[pointer[Event]]
        events.get_buffer()

    ; the queue itself (a captured attribute-subdoc parse hands its whole
    ; event array to the RAST FIFO).
    function get_events(this: pointer[ParserState]) returns pointer[Array[pointer[Event]]]
    {
        return &this.events
    }

    function get_lp_lpd(this: ParserState) returns pointer[Lpd]
        lp_lpd

    ; the current top link set (the RAST uselink event's snapshot source);
    ; null while no link process runs.
    function lp_current_set(this: ParserState) returns pointer[void]
    {
        if have_link_process = false
            return null
        if lp_depth = (0 as size_t)
            return null
        let top lp_open.get_buffer() + (lp_depth - (1 as size_t))
        top.current as pointer[void]
    }

    function get_have_link_process(this: ParserState) returns bool
        have_link_process

    ; RastLinkProcess / interpretRastPi dispatch their messages through the
    ; handler's own Messenger, whose dispatchMessage bumps piErrorCount_ for
    ; every error — the end() marker then reads #RAST-PI-ERROR.
    function rast_report0(this: pointer[ParserState], mt: MessageType, loc: Location)
    {
        let args Vector[MessageArg]()
        this.report_at(mt, args, loc)
        this.rast.note_pi_error()
    }

    function rast_report1(this: pointer[ParserState], mt: MessageType, arg: StringC, loc: Location)
    {
        var args Vector[MessageArg](1 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Str(arg)
        this.report_at(mt, args, loc)
        this.rast.note_pi_error()
    }

    ; parseNextSubdoc — pop the front of the parse-subdoc queue (empty = no).
    function rast_next_subdoc(this: pointer[ParserState]) returns bool
    {
        if this.rast_psq_head >= this.rast_psq.get_length()
            return false
        let v *(this.rast_psq.get_buffer() + this.rast_psq_head)
        set this.rast_psq_head: this.rast_psq_head + (1 as size_t)
        v <> 0
    }

    ; string equality / prefix over the PI data (RastEventHandler.cxx equal/
    ; prefix — the rast-* keyword strings are ASCII, execToInternal identity).
    function rast_lit_equal(data: StringC, lit: String) returns bool
    {
        let n lit.get_length()
        if data.get_size() <> n
            return false
        var i: size_t 0
        while i < n
        {
            if data.get(i) <> (lit.get(i) as u32)
                return false
            set i: i + 1
        }
        true
    }

    function rast_lit_prefix(data: StringC, lit: String) returns bool
    {
        let n lit.get_length()
        if data.get_size() < n
            return false
        var i: size_t 0
        while i < n
        {
            if data.get(i) <> (lit.get(i) as u32)
                return false
            set i: i + 1
        }
        true
    }

    ; interpretRastPi (RastEventHandler.cxx:362) — runs at the PI event's
    ; delivery point. Returns nothing; an uninterpretable rast-* PI reports
    ; invalidRastPiError at the event's location.
    function rast_interpret_pi(this: pointer[ParserState], e: pointer[Event])
    {
        let data e.get_data()
        ; the dispatch gate: dataLength >= 4 and the first 4 chars equal the
        ; first 4 of "rast-parse-subdoc:yes" (i.e. "rast").
        if data.get_size() < (4 as size_t)
            return
        if ParserState.rast_lit_prefix(data, String("rast")) = false
            return
        if ParserState.rast_lit_equal(data, String("rast-parse-subdoc:no"))
        {
            this.rast_psq.add(0)
            return
        }
        if ParserState.rast_lit_equal(data, String("rast-parse-subdoc:yes"))
        {
            this.rast_psq.add(1)
            return
        }
        if ParserState.rast_lit_prefix(data, String("rast-active-lpd:"))
        {
            ; one shot per document; later rast-active-lpd PIs are silently
            ; valid no-ops.
            if this.rast_had_active
                return
            set this.rast_had_active: true
            set this.rast_active_loc: e.get_loc()
            let hp this.host
            let pfx 16 as size_t
            let n data.get_size()
            var p pfx
            var start p
            var ok true
            var scanning true
            while scanning
            {
                var at_sep p >= n
                if at_sep = false
                {
                    if data.get(p) = (0x2C as u32)
                        set at_sep: true
                }
                if at_sep
                {
                    let len p - start
                    if len = (0 as size_t)
                    {
                        ; an empty name = an invalid PI (the whole PI reports).
                        set ok: false
                        set scanning: false
                    }
                    else
                    {
                        let name StringC^hp(data.data_ptr() + start, len)
                        ; duplicate check against the accumulated list.
                        let na this.rast_active_types.get_length()
                        var di: size_t 0
                        while di < na
                        {
                            let prev *(this.rast_active_types.get_buffer() + di)
                            if prev.equals(name)
                            {
                                (*this).rast_report1(RastEventHandlerMessages.duplicateActiveLinkType(), name, this.rast_active_loc)
                                set di: na
                            }
                            else
                                set di: di + 1
                        }
                        this.rast_active_types.add(name)
                        if p >= n
                            set scanning: false
                        else
                        {
                            set p: p + (1 as size_t)
                            set start: p
                        }
                    }
                }
                else
                    set p: p + (1 as size_t)
            }
            if ok = false
            {
                (*this).rast_report0(RastEventHandlerMessages.invalidRastPiError(), e.get_loc())
                return
            }
            ; parser_->activateLinkType for every accumulated name (the
            ; reference loops the whole list; linkActivateTooLate applies).
            let na2 this.rast_active_types.get_length()
            var ai: size_t 0
            while ai < na2
            {
                this.add_active_link_type(*(this.rast_active_types.get_buffer() + ai))
                set ai: ai + 1
            }
            return
        }
        if ParserState.rast_lit_prefix(data, String("rast-link-rule:"))
        {
            let hp2 this.host
            let pfx2 15 as size_t
            this.rast_lrq_pi.add(StringC^hp2(data.data_ptr() + pfx2, data.get_size() - pfx2))
            this.rast_lrq_loc.add(e.get_loc())
            return
        }
        (*this).rast_report0(RastEventHandlerMessages.invalidRastPiError(), e.get_loc())
    }

    ; RastLinkProcess::selectLinkRule — called only when more than one link
    ; rule applies. Consumes the front of the rast-link-rule PI queue; with an
    ; empty queue reports multipleLinkRules at the element's location. Returns
    ; the selected index (0 on any failure, like the reference).
    function rast_select_link_rule(this: pointer[ParserState], cands: pointer[Array[pointer[AttributeList]]], loc: Location) returns size_t
    {
        if this.rast_lrq_head >= this.rast_lrq_pi.get_length()
        {
            if cands.get_length() > (0 as size_t)
                (*this).rast_report0(RastEventHandlerMessages.multipleLinkRules(), loc)
            return 0 as size_t
        }
        let value *(this.rast_lrq_pi.get_buffer() + this.rast_lrq_head)
        let ploc *(this.rast_lrq_loc.get_buffer() + this.rast_lrq_head)
        set this.rast_lrq_head: this.rast_lrq_head + (1 as size_t)
        ; selectLinkRulePi: match the PI value against each candidate list's
        ; attribute values (cdata via the text string, tokenized via the
        ; tokenized string).
        var have false
        var selected: size_t 0
        let nc cands.get_length()
        var i: size_t 0
        while i < nc
        {
            let a *(cands.get_buffer() + i)
            var matched false
            let na a.size()
            var j: size_t 0
            while j < na
            {
                let v a.value(j)
                if v <> null
                {
                    let vt v.value_type()
                    if vt = AVT_CDATA
                    {
                        let t v.get_text()
                        if t <> null
                        {
                            if (*t).string().equals(value)
                                set matched: true
                        }
                    }
                    else if vt = AVT_TOKENIZED
                    {
                        if v.get_string().equals(value)
                            set matched: true
                    }
                }
                if matched
                    set j: na
                else
                    set j: j + 1
            }
            if matched
            {
                if have
                {
                    (*this).rast_report0(RastEventHandlerMessages.multipleLinkRuleMatch(), ploc)
                    return 0 as size_t
                }
                set have: true
                set selected: i
            }
            set i: i + 1
        }
        if have = false
        {
            (*this).rast_report0(RastEventHandlerMessages.noLinkRuleMatch(), ploc)
            return 0 as size_t
        }
        selected
    }

    ; the first-start-element activeLinks() check (RastEventHandler.cxx:220,
    ; message half): a PI-declared link type naming neither the active complex
    ; LPD nor an active simple LPD reports invalidActiveLinkType at the
    ; rast-active-lpd PI's location. The OUTPUT half renders in the writer.
    function rast_note_first_element(this: pointer[ParserState])
    {
        if this.rast_had_doc_element
            return
        set this.rast_had_doc_element: true
        let n this.rast_active_types.get_length()
        var i: size_t 0
        while i < n
        {
            let name *(this.rast_active_types.get_buffer() + i)
            var found false
            if this.have_link_process
            {
                let lname *(this.lp_name)
                if lname.equals(name)
                    set found: true
            }
            if found = false
            {
                if this.rast_simple_names <> null
                {
                    let ns this.rast_simple_names.get_length()
                    var j: size_t 0
                    while j < ns
                    {
                        let sn *(this.rast_simple_names.get_buffer() + j)
                        if sn.equals(name)
                        {
                            set found: true
                            set j: ns
                        }
                        else
                            set j: j + 1
                    }
                }
            }
            if found = false
                (*this).rast_report1(RastEventHandlerMessages.invalidActiveLinkType(), name, this.rast_active_loc)
            set i: i + 1
        }
    }

    ; the no-pass2 replay (maybeStartPass2's release loop): the reference
    ; replays pass-1 events and kept messages as ONE interleaved queue — the
    ; port emits each kept message after interpreting the buffered rast PIs
    ; that preceded it (pass1_kept_marks), then interprets the rest.
    function flush_pass1_messages_rast(this: pointer[ParserState])
    {
        var ei this.pass1_events_mark
        var i: size_t 0
        while i < this.n_pass1_kept
        {
            var mark this.events.get_length()
            if i < this.pass1_kept_marks.get_length()
                set mark: *(this.pass1_kept_marks.get_buffer() + i)
            while ei < mark
            {
                let ev *(this.events.get_buffer() + ei)
                if ev.get_type() = EV_PI
                    this.rast_interpret_pi(ev)
                set ei: ei + (1 as size_t)
            }
            let km this.pass1_kept.get_buffer() + i
            this.emit_kept_at(km)
            set i: i + (1 as size_t)
        }
        set this.n_pass1_kept: 0
        let ne this.events.get_length()
        while ei < ne
        {
            let ev2 *(this.events.get_buffer() + ei)
            if ev2.get_type() = EV_PI
                this.rast_interpret_pi(ev2)
            set ei: ei + (1 as size_t)
        }
    }

    ; ---- diagnostic program name -----------------------------------------
    ; The caller's String outlives the parse (argv[0] in the onsgmls program).
    function set_prog_name(this: pointer[ParserState], name: String)
        set this.prog_name: name

    function get_prog_name(this: ParserState) returns String
        prog_name

    ; ---- output coding system ---------------------------------------------
    function set_output_utf8(this: pointer[ParserState], utf8: bool)
        set this.out_utf8: utf8

    function get_output_utf8(this: ParserState) returns bool
        out_utf8

    function set_output_encoder(this: pointer[ParserState], enc: pointer[OutputEncoder])
        set this.out_enc: enc

    function get_output_encoder(this: ParserState) returns pointer[OutputEncoder]
        out_enc

    ; ---- reporter options / error limit / message sink (driver flags) ------
    function set_reporter_options(this: pointer[ParserState], opts: u32)
        set this.reporter_options: opts

    function reporter_option(this: ParserState, bit: u32) returns bool
        (reporter_options & bit) <> (0 as u32)

    ; ---- SgmlsEventHandler output flags (the -o axis) ----------------------
    function set_output_flags(this: pointer[ParserState], flags: u32)
        set this.output_flags: flags

    function get_output_flags(this: ParserState) returns u32
        output_flags

    function output_flag(this: ParserState, bit: u32) returns bool
        (output_flags & bit) <> (0 as u32)

    function set_error_limit(this: pointer[ParserState], limit: u32)
        set this.error_limit: limit

    function get_error_limit(this: ParserState) returns u32
        error_limit

    function set_msg_fd(this: pointer[ParserState], fd: int)
        set this.msg_fd: fd

    function set_prolog_only(this: pointer[ParserState], v: bool)
        set this.prolog_only: v

    ; ---- document base directory ------------------------------------------
    ; The caller's String outlives the parse (it is the onsgmls program's own
    ; document path), so the field aliases it rather than deep-copying.
    function set_base_dir(this: pointer[ParserState], bd: String)
        set this.base_dir: bd

    function get_base_dir(this: ParserState) returns String
        base_dir

    ; ---- declaration base directory (see the field comment) ---------------
    function set_decl_base_dir(this: pointer[ParserState], bd: String)
        set this.decl_base_dir: bd

    function get_decl_base_dir(this: ParserState) returns String
    {
        ; multi-file document (mergeSystemIds): a relative system id in a
        ; declaration resolves against the storage object the declaration
        ; sits in (the reference's FSIParser defLoc — probed: `<!ENTITY e
        ; SYSTEM "ent.txt">` in the second file resolves against ITS
        ; directory). Walk the current scan position to its backing origin
        ; (the resolve_location walk minus the line/col work); only the
        ; document origin ever carries segments — while the external DTD
        ; subset is parsed the resolved origin is the subset's own, so the
        ; stored override keeps winning exactly as before.
        let cl this.current_location()
        var index cl.get_index()
        var org cl.get_origin()
        var resolved: pointer[Origin] null
        var walking true
        while walking
        {
            if org = null
                set walking: false
            else if org.get_contents() <> null
            {
                set resolved: org
                set walking: false
            }
            else
            {
                let par org.parent()
                if par.get_origin() = null
                    set walking: false
                else
                {
                    if org.get_entity_decl() <> null
                        set index: par.get_index() + (org.get_ref_length() as u32)
                    else
                        set index: index + par.get_index()
                    set org: par.get_origin()
                }
            }
        }
        if resolved <> null
        {
            if resolved.has_segments()
                return resolved.base_dir_at(index as size_t)
        }
        decl_base_dir
    }

    ; ---- composition accessors -------------------------------------------
    function get_content_state(this: ParserState) returns pointer[ContentState]
        content_state

    ; ---- event stream (Stage 4) ------------------------------------------
    ; The queue point IS the reference handler's stream position: the LINK
    ; axis' link process (SgmlsEventHandler's linkProcess_) runs here on the
    ; element events (and initializes off the EndPrologEvent), attaching the
    ; matched rule's link attributes to the start event for the writer.
    function queue_event(this: pointer[ParserState], e: pointer[Event])
    {
        let ty e.get_type()
        if ty = EV_START_ELEMENT
        {
            if this.have_link_process
                this.lp_start_element(e)
        }
        else if ty = EV_END_ELEMENT
        {
            if this.have_link_process
                this.lp_end_element(e)
        }
        else if ty = EV_PI
        {
            ; RAST: rast-* PIs interpret at the event's DELIVERY point — not
            ; while pass-1 buffering (discarded events are never interpreted;
            ; the no-pass2 replay interprets them via flush_pass1_messages_rast).
            if this.rast <> null
            {
                if (*this).is_pass1_buffering() = false
                    this.rast_interpret_pi(e)
            }
        }
        else if ty = EV_END_PROLOG
        {
            let lpd e.get_end_prolog_lpd() as pointer[Lpd]
            if lpd <> null
                this.lp_init(lpd)
            ; RAST: stash the simple-link names for the first-start-element
            ; activeLinks check (the writer reads the event itself).
            if this.rast <> null
                set this.rast_simple_names: e.get_simple_link_names()
            ; -p (only-prolog): PrologMessageEventHandler::endProlog cancels
            ; the parse when the end-prolog event is delivered — the instance
            ; is never parsed and no output is produced (the driver skips the
            ; ESIS dump under -p).
            if this.prolog_only
                set this.cancelled: true
        }
        this.events.add(e)
    }

    ; a raw append that BYPASSES the link process — the subdoc splice (the
    ; child parse ran its own link process, mirroring SgmlsSubdocState's swap).
    function queue_event_raw(this: pointer[ParserState], e: pointer[Event])
        this.events.add(e)

    ; replace the whole event queue — the -A ArcEngine post-parse transform
    ; swaps in the architectural event stream before the ESIS writer runs.
    function set_events(this: pointer[ParserState], ev: pointer[Array[pointer[Event]]])
        set this.events: *ev

    function n_events(this: ParserState) returns size_t
        events.get_length()

    function get_event(this: ParserState, i: size_t) returns pointer[Event]
        *(events.get_buffer() + i)

    ; ---- OutputState (OutputState.cxx): the RS/RE record-boundary machine -----
    ; A per-output-level state stack shapes character data: a pending RE is held
    ; and only flushed as data (a 0x0D data event -> ESIS "\n") when more data
    ; follows; a trailing / leading / markup-only RE is ignored. queue_re/note_rs/
    ; note_markup/note_data/note_start_element/note_end_element are the parser hooks.
    function os_top(this: ParserState) returns int
        *(os_state.get_buffer() + ((os_depth - (1 as u32)) as size_t))

    function os_set_top(this: pointer[ParserState], s: int)
        this.os_state.put((this.os_depth - (1 as u32)) as size_t, s)

    function os_has_pending(this: ParserState) returns bool
        os_top() > OS_AFTER_DATA

    ; the pending RE's own location (OutputStateLevel::reLocation).
    function os_top_re_loc(this: ParserState) returns Location
        *(os_re_loc.get_buffer() + ((os_depth - (1 as u32)) as size_t))

    function os_set_top_re_loc(this: pointer[ParserState], loc: Location)
        this.os_re_loc.put((this.os_depth - (1 as u32)) as size_t, loc)

    ; emit one RE (0x0D) as a character-data event (the flushed pending RE) —
    ; located at the RE's OWN position (ReEvent(&re_, top().reLocation, …)).
    function os_emit_re(this: pointer[ParserState])
    {
        let re (*this.syntax).standard_function(fRE)
        var buf u32[1]
        let bp buf as pointer[u32]
        set *bp: re
        let sc StringC(bp, 1 as size_t)
        let loc (*this).os_top_re_loc()
        let ev Event.make_data(this.host, sc, loc)
        this.queue_event(ev)
    }

    ; handleRe — a record end (RE) at `loc` (OutputState.cxx:33).
    function queue_re(this: pointer[ParserState], loc: Location)
    {
        let st this.os_top()
        if st = OS_AFTER_START_TAG
            this.os_set_top(OS_AFTER_RSRE)
        else if (st = OS_AFTER_RSRE) or (st = OS_AFTER_DATA)
        {
            this.os_set_top(OS_PENDING_AFTER_RSRE)
            this.os_set_top_re_loc(loc)
        }
        else if st = OS_PENDING_AFTER_RSRE
        {
            this.os_emit_re()
            this.os_set_top(OS_PENDING_AFTER_RSRE)
            this.os_set_top_re_loc(loc)
        }
        else if st = OS_PENDING_AFTER_MARKUP
        {
            ; the NEW RE is the ignored one; the pending RE keeps its location.
            this.os_set_top(OS_PENDING_AFTER_RSRE)
        }
    }

    function note_rs(this: pointer[ParserState])
    {
        if this.os_has_pending()
            this.os_set_top(OS_PENDING_AFTER_RSRE)
        else
            this.os_set_top(OS_AFTER_RSRE)
    }

    function note_markup(this: pointer[ParserState])
    {
        if this.in_instance = false
            return
        let st this.os_top()
        if st = OS_AFTER_RSRE
            this.os_set_top(OS_AFTER_START_TAG)
        else if st = OS_PENDING_AFTER_RSRE
            this.os_set_top(OS_PENDING_AFTER_MARKUP)
    }

    function note_data(this: pointer[ParserState])
    {
        if this.os_has_pending()
            this.os_emit_re()
        this.os_set_top(OS_AFTER_DATA)
    }

    function note_start_element(this: pointer[ParserState], included: bool)
    {
        if included
        {
            if this.os_depth < (this.os_state.get_length() as u32)
            {
                this.os_state.put(this.os_depth as size_t, OS_AFTER_START_TAG)
                this.os_re_loc.put(this.os_depth as size_t, Location())
            }
            else
            {
                this.os_state.add(OS_AFTER_START_TAG)
                this.os_re_loc.add(Location())
            }
            set this.os_depth: this.os_depth + (1 as u32)
        }
        else
        {
            if this.os_has_pending()
                this.os_emit_re()
            this.os_set_top(OS_AFTER_START_TAG)
        }
    }

    function note_end_element(this: pointer[ParserState], included: bool)
    {
        ; a pending RE at an end tag is ignored (no data).
        if included
        {
            if this.os_depth > (1 as u32)
                set this.os_depth: this.os_depth - (1 as u32)
            this.note_markup()
        }
        else
            this.os_set_top(OS_AFTER_DATA)
    }

    ; ---- content-state push/pop that also track the scanner mode ----------
    ; C++ ParserState overrides pushElement/popSaveElement to recompute the
    ; current mode from the new content head (contentMode()). We compose a
    ; ContentState, so mirror that here: mutate the stack, then re-read the mode.
    function push_element_mode(this: pointer[ParserState], e: pointer[OpenElement])
    {
        this.content_state.push_element(e)
        set this.pcdata_recovering: false
        ; the start tag of this element may have been implied by data inside a
        ; cdata or rcdata marked section (ParserState::pushElement) — the mode
        ; stays the section's special mode then. A CDATA/RCDATA-content element
        ; enters its own special parse: entity ends inside it are diagnosed
        ; (specialParseEntityEnd) until the level unwinds.
        if this.marked_section_special_level = (0 as u32)
        {
            set this.current_mode: this.content_state.content_mode()
            if e.requires_special_parse()
            {
                set this.special_parse_mode: this.current_mode
                set this.special_parse_input_level: this.input_level
            }
        }
    }

    ; popSaveElement (ParserState.cxx) — pop, restore the enclosing content
    ; mode, leave any element-level special parse, and return the element (the
    ; OMITTAG undo machinery re-pushes it on rollback).
    function pop_save_element_mode(this: pointer[ParserState]) returns pointer[OpenElement]
    {
        let e this.content_state.pop_save_element()
        if this.marked_section_special_level = (0 as u32)
        {
            set this.current_mode: this.content_state.content_mode()
            set this.special_parse_input_level: 0 as u32
        }
        set this.pcdata_recovering: false
        e
    }

    function pop_element_mode(this: pointer[ParserState])
    {
        let discard this.pop_save_element_mode()
    }

    ; PCDATA was encountered where it is not allowed (acceptPcdata failed):
    ; switch to the mixed-content mode so subsequent data chars tokenize as
    ; data, and suppress further pcdataNotAllowed until an element pushes/pops.
    function pcdata_recover(this: pointer[ParserState])
    {
        if this.current_mode = econMode
            set this.current_mode: mconMode
        else if this.current_mode = econnetMode
            set this.current_mode: mconnetMode
        set this.pcdata_recovering: true
    }

    function is_pcdata_recovering(this: ParserState) returns bool
        pcdata_recovering

    ; startInstance (slice): select the instance's current DTD, build the
    ; synthetic document-element container, enter econMode, mark the content
    ; phase. ParserState.cxx:456 walks the DTD list for a doctype ACTIVATED by
    ; the application (shouldActivateLink / activeLinkTypes — the -a option;
    ; activeDocLink when link types are also active, sorryActiveDoctypes when
    ; two doctypes are activated); that surface arrives with the LINK axis.
    ; With no activated doctype the reference falls back to the BASE DTD.
    function start_instance(this: pointer[ParserState], host: pointer[Page])
    {
        ; the doctype-activation loop (ParserState.cxx:452): an ACTIVATED
        ; document type (-a naming a DOCTYPE) becomes the current DTD — at most
        ; one, and never alongside an activated link type.
        var dtd: pointer[Dtd] null
        let nd this.dtd_stack.get_length()
        var di: size_t 0
        var scanning true
        while scanning and (di < nd)
        {
            let cand *(this.dtd_stack.get_buffer() + di)
            let cname cand.get_name()
            if this.should_activate_link(cname)
            {
                if this.active_lpds.get_length() > (0 as size_t)
                {
                    let args0 Vector[MessageArg]()
                    this.report(ParserMessages.activeDocLink(), args0)
                    set scanning: false
                }
                else if dtd <> null
                {
                    let args1 Vector[MessageArg]()
                    this.report(ParserMessages.sorryActiveDoctypes(), args1)
                    set scanning: false
                }
                else
                    set dtd: cand
            }
            set di: di + 1
        }
        if dtd = null
            set dtd: this.base_dtd()
        set this.current_dtd: dtd
        ; idTable_.clear() (ParserState.cxx:476) — load-bearing for pass 2.
        set this.id_table: IdTable.make(host)
        this.content_state.start_content(host, dtd)
        set this.current_mode: econMode
        set this.in_instance: true
        set this.phase: PHASE_CONTENT
        ; currentAttributes_.resize(nCurrentAttribute) — ParserState.cxx:475;
        ; installing the store only here IS the reference's inInstance() gate
        ; on note/getCurrentAttribute.
        this.attribute_context.start_current_store(dtd.get_n_current_attribute())
        ; currentRank_.assign(nRankStem, StringC()) — ParserState.cxx:472,
        ; gated on the SGML declaration's RANK feature.
        if this.sd.rank()
            this.resize_current_rank(host, dtd.n_rank_stem())
    }

    function resize_current_rank(this: pointer[ParserState], host: pointer[Page], n: size_t)
    {
        let fresh Array[pointer[StringC]]^host()
        var i: size_t 0
        while i < n
        {
            fresh.add(null as pointer[StringC])
            set i: i + 1
        }
        set this.current_rank: fresh
    }

    ; appendCurrentRank (ParserState.cxx:674): append the rank stem's current
    ; suffix (if any) to `buf`; returns whether a suffix was present.
    function append_current_rank(this: ParserState, buf: pointer[Array[u32]], stem: pointer[RankStem]) returns bool
    {
        let suffix *(current_rank.get_buffer() + stem.get_index())
        if suffix = null
            return false
        let sz suffix.get_size()
        if sz = (0 as size_t)
            return false
        var i: size_t 0
        while i < sz
        {
            buf.add(suffix.get(i))
            set i: i + 1
        }
        true
    }

    ; setCurrentRank (ParserState.cxx:685): record the current suffix for a stem.
    function set_current_rank(this: pointer[ParserState], stem: pointer[RankStem], suffix: pointer[StringC])
        this.current_rank.put(stem.get_index(), suffix)

    function get_attribute_context(this: ParserState) returns pointer[AttributeContext]
        attribute_context

    ; ---- Sd / Syntax ------------------------------------------------------
    ; setSd derives the attribute-defaulting + validation flags and the IMPLYDEF
    ; state (Sd.cs), wiring them into the composed AttributeContext.
    function set_sd(this: pointer[ParserState], sd: pointer[Sd])
    {
        set this.sd: sd
        this.attribute_context.set_may_default(sd.omittag() or sd.attribute_default())
        this.attribute_context.set_validate(sd.type_valid())
        set this.implydef_element: sd.implydef_element()
        set this.implydef_attlist: sd.implydef_attlist()
    }

    function set_syntax(this: pointer[ParserState], syntax: pointer[Syntax])
    {
        set this.syntax: syntax
        set this.prolog_syntax: syntax
        set this.instance_syntax: syntax
        this.attribute_context.set_syntax(syntax)
    }

    function set_syntaxes(this: pointer[ParserState], prolog: pointer[Syntax], instance: pointer[Syntax])
    {
        set this.syntax: prolog
        set this.prolog_syntax: prolog
        set this.instance_syntax: instance
        this.attribute_context.set_syntax(prolog)
    }

    function get_sd(this: ParserState) returns pointer[Sd]
        sd

    function get_syntax(this: ParserState) returns pointer[Syntax]
        syntax

    function get_instance_syntax(this: ParserState) returns pointer[Syntax]
        instance_syntax

    ; the prolog syntax pointer (a subdoc parse inherits the parent's
    ; prolog/instance syntax pair, Parser.cxx:58).
    function get_prolog_syntax(this: ParserState) returns pointer[Syntax]
        prolog_syntax

    ; SCOPE INSTANCE: enter the instance syntax (setSyntaxes installed a
    ; prolog/instance pair; parse_document switches before compiling the
    ; content-mode recognizers).
    function switch_to_instance_syntax(this: pointer[ParserState])
    {
        set this.syntax: this.instance_syntax
        this.attribute_context.set_syntax(this.instance_syntax)
    }

    ; attributeSyntax() (AttributeContext) — the current syntax.
    function attribute_syntax(this: ParserState) returns pointer[Syntax]
        syntax

    ; ---- entity layer handles --------------------------------------------
    function get_entity_manager(this: ParserState) returns pointer[EntityManager]
        entity_manager

    function set_entity_catalog(this: pointer[ParserState], cat: pointer[EntityCatalog])
        set this.entity_catalog: cat

    function get_entity_catalog(this: ParserState) returns pointer[EntityCatalog]
        entity_catalog

    ; the driver's EntityApp surface (search dirs, -R, -C) — null outside the
    ; onsgmls driver (defaults: no search dirs, unrestricted).
    function set_em_config(this: pointer[ParserState], cfg: pointer[EmConfig])
        set this.em_config: cfg

    function get_em_config(this: ParserState) returns pointer[EmConfig]
        em_config

    ; PosixStorageManager::searchDirs_.size() > 0 — the switch that defers
    ; relative-system-id resolution to open time (the SOIBASE FSI form).
    function have_search_dirs(this: ParserState) returns bool
    {
        if em_config = null
            return false
        let sd2 em_config.search_dirs
        if sd2 = null
            return false
        sd2.get_length() > (0 as size_t)
    }

    ; ---- DTD stack --------------------------------------------------------
    function have_current_dtd(this: ParserState) returns bool
        current_dtd <> null

    function get_current_dtd(this: ParserState) returns pointer[Dtd]
        current_dtd

    ; State setter — startInstance/startDtd (the parse-flow methods that select
    ; the current DTD) are deferred, so the current DTD is set directly here.
    function set_current_dtd(this: pointer[ParserState], dtd: pointer[Dtd])
        set this.current_dtd: dtd

    function get_def_dtd(this: ParserState) returns pointer[Dtd]
        def_dtd

    function set_def_dtd(this: pointer[ParserState], dtd: pointer[Dtd])
        set this.def_dtd: dtd

    function push_dtd(this: pointer[ParserState], dtd: pointer[Dtd])
        this.dtd_stack.add(dtd)

    function had_dtd(this: ParserState) returns bool
        dtd_stack.get_length() > (0 as size_t)

    function lookup_dtd(this: ParserState, name: StringC) returns pointer[Dtd]
    {
        let n dtd_stack.get_length()
        let buf dtd_stack.get_buffer()
        var i: size_t 0
        while i < n
        {
            let p *(buf + i)
            if p <> null
            {
                if p.get_name().equals(name)
                    return p
            }
            set i: i + 1
        }
        null
    }

    ; instantiateDtd (ParserState.cxx:892), the counting half — mark the DTD
    ; instantiated and bump the counter; return the running count. The
    ; concurrentInstances quantity check reports from Parser::instantiate_dtd
    ; (the reporting machinery lives there).
    function instantiate_dtd(this: pointer[ParserState], dtd: pointer[Dtd]) returns u32
    {
        if dtd.get_is_instantiated() = false
        {
            dtd.instantiate()
            set this.instantiated_dtds: this.instantiated_dtds + (1 as u32)
        }
        this.instantiated_dtds
    }

    function get_instantiated_dtds(this: ParserState) returns u32
        instantiated_dtds

    ; endDtd (ParserState.cxx:249) — the completed DTD joins the document's DTD
    ; list; between prolog declarations no DTD is defined or current, and the
    ; scanner is back in prolog mode.
    function end_dtd(this: pointer[ParserState])
    {
        this.dtd_stack.add(this.def_dtd)
        set this.def_dtd: null
        set this.current_dtd: null
        set this.current_mode: proMode
    }

    ; baseDtd (ParserState.h:786) — the FIRST document type declared.
    function base_dtd(this: ParserState) returns pointer[Dtd]
    {
        if dtd_stack.get_length() = (0 as size_t)
            return null
        *(dtd_stack.get_buffer())
    }

    function n_dtds(this: ParserState) returns size_t
        dtd_stack.get_length()

    function dtd_at(this: ParserState, i: size_t) returns pointer[Dtd]
        *(dtd_stack.get_buffer() + i)

    ; ---- LINK axis: LPD registry (ParserState.cxx:258-273, 765-807) --------
    function have_def_lpd(this: ParserState) returns bool
        def_lpd <> null

    function get_def_lpd(this: ParserState) returns pointer[Lpd]
        def_lpd

    ; startLpd: while an LPD is being defined the DEF (and current) DTD is the
    ; LPD's SOURCE DTD — entity/attlist declarations in the subset act on it.
    function start_lpd(this: pointer[ParserState], lpd: pointer[Lpd])
    {
        set this.def_lpd: lpd
        set this.def_dtd: lpd.get_source_dtd()
        set this.current_dtd: lpd.get_source_dtd()
    }

    ; endLpd: an ACTIVE lpd joins the activation list, every lpd joins allLpd_;
    ; the current DTD stays the source DTD (the reference does not clear it).
    function end_lpd(this: pointer[ParserState])
    {
        set this.had_lpd: true
        let l this.def_lpd
        if l.is_active()
            this.active_lpds.add(l)
        this.all_lpds.add(l)
        set this.def_lpd: null
        set this.def_dtd: null
        set this.current_mode: proMode
    }

    function get_had_lpd(this: ParserState) returns bool
        had_lpd

    function lookup_lpd(this: ParserState, name: StringC) returns pointer[Lpd]
    {
        let n all_lpds.get_length()
        var i: size_t 0
        while i < n
        {
            let l *(all_lpds.get_buffer() + i)
            let lname l.get_name()
            if lname.equals(name)
                return l
            set i: i + 1
        }
        null
    }

    function n_active_lpds(this: ParserState) returns size_t
        active_lpds.get_length()

    function active_lpd_at(this: ParserState, i: size_t) returns pointer[Lpd]
        *(active_lpds.get_buffer() + i)

    ; activateLinkType (the -a option): only before parsing passes the first
    ; prolog declaration (linkActivateTooLate otherwise).
    function add_active_link_type(this: pointer[ParserState], name: StringC)
    {
        var too_late true
        if this.had_pass2_start = false
        {
            if this.pass2 = false
                set too_late: false
        }
        if too_late
        {
            let args Vector[MessageArg]()
            this.report(ParserMessages.linkActivateTooLate(), args)
            return
        }
        let hp this.host
        this.active_link_types.add(StringC^hp(name.data_ptr(), name.get_size()))
    }

    function n_active_link_types(this: ParserState) returns size_t
        active_link_types.get_length()

    function active_link_type_at(this: ParserState, i: size_t) returns StringC
        *(active_link_types.get_buffer() + i)

    ; a subdocument parse inherits the parent's activation list
    ; (inheritActiveLinkTypes, ParserState.cxx:83).
    function inherit_active_link_types(this: pointer[ParserState], parent: pointer[ParserState])
    {
        let n (*parent).n_active_link_types()
        var i: size_t 0
        while i < n
        {
            this.active_link_types.add((*parent).active_link_type_at(i))
            set i: i + 1
        }
    }

    ; shouldActivateLink (ParserState.cxx:773): the -a names fold through the
    ; general substitution table ONCE (first use), then plain equality.
    function should_activate_link(this: pointer[ParserState], name: StringC) returns bool
    {
        if this.active_link_types_substed = false
        {
            let syn this.syntax
            let hp this.host
            let n this.active_link_types.get_length()
            var i: size_t 0
            while i < n
            {
                let old *(this.active_link_types.get_buffer() + i)
                let sz old.get_size()
                let nb hp.allocate(sz * (4 as size_t), 4) as pointer[u32]
                var j: size_t 0
                while j < sz
                {
                    set *(nb + j): syn.fold(old.get(j))
                    set j: j + 1
                }
                ; bind the construction to a local before the put (the
                ; construction-as-argument silent-misplan class).
                let folded StringC^hp(nb, sz)
                this.active_link_types.put(i, *folded)
                set i: i + 1
            }
            set this.active_link_types_substed: true
        }
        let n2 this.active_link_types.get_length()
        var k: size_t 0
        while k < n2
        {
            let alt *(this.active_link_types.get_buffer() + k)
            if alt.equals(name)
                return true
            set k: k + 1
        }
        false
    }

    ; ---- resultAttributeSpecMode (result element specs resolve entities and
    ; notations against the RESULT dtd) ---------------------------------------
    function set_result_attribute_spec_mode(this: pointer[ParserState])
        set this.result_attribute_spec_mode: true

    function clear_result_attribute_spec_mode(this: pointer[ParserState])
        set this.result_attribute_spec_mode: false

    function in_result_attribute_spec_mode(this: ParserState) returns bool
        result_attribute_spec_mode

    ; ---- the link process (LinkProcess.cxx), driven at queue_event time ----
    function lp_init(this: pointer[ParserState], lpd: pointer[Lpd])
    {
        set this.have_link_process: true
        set this.lp_lpd: lpd
        let hp this.host
        ; the owner name printed on `a` records — one stable copy.
        let nm lpd.get_name()
        let sp hp.allocate(sizeof StringC, alignof StringC) as pointer[StringC]
        set *sp: StringC^hp(nm.data_ptr(), nm.get_size())
        set this.lp_name: sp
        set this.lp_open: Array[LpOpen]^hp()
        var top LpOpen()
        let ini lpd.initial_link_set_of()
        set top.current: ini
        set top.restore: ini
        set top.post: null
        set top.post_restore: false
        this.lp_open.add(top)
        set this.lp_depth: 1
    }

    function lp_push(this: pointer[ParserState], o: LpOpen)
    {
        if this.lp_depth < this.lp_open.get_length()
            this.lp_open.put(this.lp_depth, o)
        else
            this.lp_open.add(o)
        set this.lp_depth: this.lp_depth + (1 as size_t)
    }

    ; LinkProcess::startElement — select the applicable link rule (ID link
    ; rules first, then the current link set's rules for the element; onsgmls
    ; never overrides selectLinkRule, so with more than one rule index 0 is
    ; selected silently — under RAST (-t) the RastLinkProcess override consumes
    ; the rast-link-rule PI queue), push the open-element entry, attach the
    ; rule (and its link attributes) to the event, snapshot the post-push
    ; current link set for the RAST writer.
    function lp_start_element(this: pointer[ParserState], e: pointer[Event])
    {
        let lpd this.lp_lpd
        let element e.get_element_type()
        let atts e.get_attributes()
        var id StringC()
        if atts <> null
            set id: atts.get_id()
        if id.get_size() > (0 as size_t)
        {
            let grp lpd.lookup_id_link(id)
            if grp <> null
            {
                var sel: size_t 0
                let nr grp.n_link_rules()
                if (nr > (1 as size_t)) and (this.rast <> null)
                {
                    let hp this.host
                    let cands Array[pointer[AttributeList]]^hp()
                    var ci: size_t 0
                    while ci < nr
                    {
                        let r2 grp.link_rule(ci)
                        cands.add(r2.attributes())
                        set ci: ci + 1
                    }
                    set sel: this.rast_select_link_rule(cands, e.get_markup_loc())
                }
                let rule grp.link_rule(sel)
                this.lp_push_rule(rule)
                e.set_link_attributes(rule.attributes(), this.lp_name)
                e.set_link_rule(rule as pointer[void])
                this.lp_snapshot(e)
                if rule.is_associated_with(element) = false
                {
                    var args Vector[MessageArg](2 as size_t)
                    let ename element.get_name()
                    set *(args.get(0 as size_t)): MessageArg.Str(ename)
                    set *(args.get(1 as size_t)): MessageArg.Str(id)
                    this.report_at(ParserMessages.idlinkElementType(), args, e.get_markup_loc())
                }
                return
            }
        }
        let buf this.lp_open.get_buffer()
        let top buf + (this.lp_depth - (1 as size_t))
        let cur top.current
        let n cur.n_link_rules(element)
        if n > (0 as size_t)
        {
            var sel2: size_t 0
            if (n > (1 as size_t)) and (this.rast <> null)
            {
                let hp2 this.host
                let cands2 Array[pointer[AttributeList]]^hp2()
                var ci2: size_t 0
                while ci2 < n
                {
                    let r3 cur.link_rule(element, ci2)
                    cands2.add(r3.attributes())
                    set ci2: ci2 + 1
                }
                set sel2: this.rast_select_link_rule(cands2, e.get_markup_loc())
            }
            let rule cur.link_rule(element, sel2)
            this.lp_push_rule(rule)
            e.set_link_attributes(rule.attributes(), this.lp_name)
            e.set_link_rule(rule as pointer[void])
            this.lp_snapshot(e)
            return
        }
        ; no applicable rule: a plain open element, the current set carries.
        var plain LpOpen()
        set plain.current: cur
        set plain.restore: cur
        set plain.post: null
        set plain.post_restore: false
        this.lp_push(plain)
        this.lp_snapshot(e)
    }

    ; stamp the current (top) link set on the event (the RAST writer's view of
    ; the link process at this stream position).
    function lp_snapshot(this: pointer[ParserState], e: pointer[Event])
    {
        let buf this.lp_open.get_buffer()
        let top buf + (this.lp_depth - (1 as size_t))
        e.set_link_set_after(top.current as pointer[void])
    }

    ; LinkProcessOpenElement(cur, rule) — the rule's USELINK (if any) becomes
    ; current for the element's content; POSTLINK applies when it ends.
    function lp_push_rule(this: pointer[ParserState], rule: pointer[SourceLinkRule])
    {
        let buf this.lp_open.get_buffer()
        let top buf + (this.lp_depth - (1 as size_t))
        let cur top.current
        var o LpOpen()
        var eff cur
        let ul rule.get_uselink() as pointer[LinkSet]
        if ul <> null
            set eff: ul
        set o.current: eff
        set o.restore: cur
        set o.post: rule.get_postlink() as pointer[LinkSet]
        set o.post_restore: rule.get_postlink_restore()
        this.lp_push(o)
    }

    ; LinkProcess::endElement — pop; POSTLINK (or its #RESTORE form) rewrites
    ; the PARENT's current link set. Snapshots the post-pop set on the event
    ; for the RAST writer's end-element #LINK-SET-INFO block.
    function lp_end_element(this: pointer[ParserState], e: pointer[Event])
    {
        if this.lp_depth <= (1 as size_t)
        {
            this.lp_snapshot(e)
            return
        }
        let buf this.lp_open.get_buffer()
        let top buf + (this.lp_depth - (1 as size_t))
        set this.lp_depth: this.lp_depth - (1 as size_t)
        let head buf + (this.lp_depth - (1 as size_t))
        if top.post <> null
            set head.current: top.post
        else if top.post_restore
            set head.current: head.restore
        this.lp_snapshot(e)
    }

    ; LinkProcess::uselink — a USELINK declaration for the ACTIVE lpd rewrites
    ; the current open element's link set (#RESTORE restores the entry state).
    function lp_uselink(this: pointer[ParserState], link_set: pointer[LinkSet], restore: bool, lpd: pointer[Lpd])
    {
        if this.have_link_process = false
            return
        if lpd <> this.lp_lpd
            return
        let buf this.lp_open.get_buffer()
        let head buf + (this.lp_depth - (1 as size_t))
        if restore
            set head.current: head.restore
        else if link_set <> null
            set head.current: link_set
    }

    ; ---- pass 1 / pass 2 (setPass2Start / maybeStartPass2) ------------------
    ; Runs at every prolog markup declaration (once): with LINK admitted and
    ; link types activated, pass-1 buffering begins — the rewind point is the
    ; declaration's own token start.
    function set_pass2_start(this: pointer[ParserState])
    {
        if this.had_pass2_start
            return
        set this.had_pass2_start: true
        var want false
        if this.pass2 = false
        {
            let csd this.sd
            if csd.link()
            {
                if this.active_link_types.get_length() > (0 as size_t)
                    set want: true
            }
        }
        if want
        {
            set this.allow_pass2: true
            set this.pass1_had_error: false
            set this.n_pass1_kept: 0
            set this.pass1_events_mark: this.events.get_length()
            let ins this.current_input()
            let tsl ins.token_start_location()
            set this.pass2_start_index: tsl.get_index() as size_t
        }
        else
            set this.allow_pass2: false
    }

    function get_pass2(this: ParserState) returns bool
        pass2

    function get_allow_pass2(this: ParserState) returns bool
        allow_pass2

    function get_pass1_had_error(this: ParserState) returns bool
        pass1_had_error

    function get_pass2_start_index(this: ParserState) returns size_t
        pass2_start_index

    function get_pass1_dtd(this: ParserState) returns pointer[Dtd]
        pass1_dtd

    ; discard the events queued since setPass2Start (pass1Handler.clear()).
    function truncate_events(this: pointer[ParserState], n: size_t)
    {
        let hp this.host
        let fresh Array[pointer[Event]]^hp()
        let buf this.events.get_buffer()
        var i: size_t 0
        while i < n
        {
            fresh.add(*(buf + i))
            set i: i + 1
        }
        set this.events: fresh
    }

    ; maybeStartPass2's state reset (ParserState.cxx:140-185): the pass-1 base
    ; DTD survives as pass1_dtd, pass-1 events since the start point are
    ; discarded, everything else returns to the prolog state. The caller
    ; rewinds the input and re-runs the prolog.
    function reset_for_pass2(this: pointer[ParserState])
    {
        set this.special_parse_input_level: 0 as u32
        set this.marked_section_level: 0 as u32
        set this.marked_section_special_level: 0 as u32
        set this.n_ms_start_locations: 0
        set this.current_mode: proMode
        set this.had_lpd: false
        set this.allow_pass2: false
        set this.had_pass2_start: false
        set this.in_instance: false
        set this.in_start_tag: false
        set this.in_end_tag: false
        set this.def_dtd: null
        set this.def_lpd: null
        set this.pass1_dtd: this.base_dtd()
        let hp this.host
        set this.dtd_stack: Array[pointer[Dtd]]^hp()
        set this.current_dtd: null
        set this.phase: PHASE_PROLOG
        set this.pass2: true
        set this.active_lpds: Array[pointer[Lpd]]^hp()
        set this.all_lpds: Array[pointer[Lpd]]^hp()
        this.truncate_events(this.pass1_events_mark)
        ; syntax back to the PROLOG syntax (SCOPE INSTANCE may have switched).
        set this.syntax: this.prolog_syntax
        this.attribute_context.set_syntax(this.prolog_syntax)
        ; OutputState back to its initial single level.
        set this.os_state: Array[int]^hp()
        this.os_state.add(OS_AFTER_START_TAG)
        set this.os_re_loc: Array[Location]^hp()
        this.os_re_loc.add(Location())
        set this.os_depth: 1 as u32
        ; pop the whole input stack (the caller pushes the rewound document).
        set this.input_stack: Array[pointer[InputSource]]^hp()
        set this.input_level: 0 as u32
        set this.n_input_level_element_index: 0
    }

    ; ---- entity decl-in-LPD side table + stability tracking ----------------
    ; EntityDecl::setDeclIn's LPD half: the Entity union carries no decl-in
    ; fields, so LPD-subset definitions register here (pointer identity).
    function note_lpd_entity_decl(this: pointer[ParserState], ent: pointer[Entity], active: bool)
    {
        var d LpdEntityDecl()
        set d.entity: ent
        set d.active: active
        this.lpd_entity_decls.add(d)
    }

    function entity_decl_in_active_lpd(this: ParserState, ent: pointer[Entity]) returns bool
    {
        let n lpd_entity_decls.get_length()
        var i: size_t 0
        while i < n
        {
            let d lpd_entity_decls.get_buffer() + i
            if d.entity = ent
                return d.active
            set i: i + 1
        }
        false
    }

    ; Entity::defaulted() / setDefaulted() as a side table (the Entity union
    ; has no flag fields — same pattern as entity_decl_in_active_lpd).
    function note_defaulted_entity(this: pointer[ParserState], ent: pointer[Entity])
        this.defaulted_entities.add(ent)

    function entity_is_defaulted(this: ParserState, ent: pointer[Entity]) returns bool
    {
        let n defaulted_entities.get_length()
        var i: size_t 0
        while i < n
        {
            if *(defaulted_entities.get_buffer() + i) = ent
                return true
            set i: i + 1
        }
        false
    }

    ; ---- -winstance-status-keyword-s S-run recording (parseDecl.cxx:3506).
    ; The reference walks the DISCARD Markup it started WITHOUT the MDO/DSO
    ; delimiter entries, so replayed locations lag the actual positions by
    ; len(MDO)+len(DSO) until an entity boundary resynchronizes them (Markup-
    ; Iter's entityStart/entityEnd arms reset the location absolutely) —
    ; bug-for-bug: each recorded run carries its actual location plus a
    ; `synced` flag; the reporter shifts unsynced ones back. Consecutive S
    ; chars coalesce into ONE run (Markup::addS extends the last entry).
    function start_ms_s_tracking(this: pointer[ParserState])
    {
        set this.ms_s_track: true
        set this.ms_s_synced: false
        set this.ms_s_have_last: false
        let hp this.host
        set this.ms_s_items: Array[MsSItem]^hp()
    }

    function stop_ms_s_tracking(this: pointer[ParserState])
        set this.ms_s_track: false

    function note_ms_s_sync(this: pointer[ParserState])
    {
        if this.ms_s_track = false
            return
        set this.ms_s_synced: true
        set this.ms_s_have_last: false
    }

    function note_ms_s(this: pointer[ParserState], loc: Location)
    {
        if this.ms_s_track = false
            return
        if this.ms_s_have_last
        {
            if (loc.get_origin() = this.ms_s_last_origin) and (loc.get_index() = (this.ms_s_last_index + (1 as u32)))
            {
                set this.ms_s_last_index: loc.get_index()
                return
            }
        }
        var item MsSItem()
        set item.loc: loc
        set item.synced: this.ms_s_synced
        this.ms_s_items.add(item)
        set this.ms_s_have_last: true
        set this.ms_s_last_origin: loc.get_origin()
        set this.ms_s_last_index: loc.get_index()
    }

    function ms_s_count(this: ParserState) returns size_t
        ms_s_items.get_length()

    function ms_s_item_at(this: ParserState, i: size_t) returns pointer[MsSItem]
        ms_s_items.get_buffer() + i

    function note_entity_def_location(this: pointer[ParserState], ent: pointer[Entity], loc: Location)
    {
        var d EntityDefLoc()
        set d.entity: ent
        set d.loc: loc
        this.entity_def_locs.add(d)
    }

    function entity_def_location(this: ParserState, ent: pointer[Entity]) returns Location
    {
        let n entity_def_locs.get_length()
        var i: size_t 0
        while i < n
        {
            let d entity_def_locs.get_buffer() + i
            if d.entity = ent
                return d.loc
            set i: i + 1
        }
        (*ent).get_def_location()
    }

    ; Entity::used() / setUsed() as a side table (same union constraint) —
    ; feeds the -wunused-param sweep.
    function note_entity_used(this: pointer[ParserState], ent: pointer[Entity])
    {
        if (*this).entity_is_used(ent)
            return
        this.used_entities.add(ent)
    }

    function entity_is_used(this: ParserState, ent: pointer[Entity]) returns bool
    {
        let n used_entities.get_length()
        var i: size_t 0
        while i < n
        {
            if *(used_entities.get_buffer() + i) = ent
                return true
            set i: i + 1
        }
        false
    }

    ; instanceDefaultedEntityTable_ — the per-instance cache of defaulted
    ; copies, keyed by entity name (never iterated for messages, so a plain
    ; array + name scan is faithful).
    function lookup_instance_defaulted(this: ParserState, name: StringC) returns pointer[Entity]
    {
        let n instance_defaulted.get_length()
        var i: size_t 0
        while i < n
        {
            let e *(instance_defaulted.get_buffer() + i)
            let en e.get_name()
            if en.equals(name)
                return e
            set i: i + 1
        }
        null
    }

    function add_instance_defaulted(this: pointer[ParserState], ent: pointer[Entity])
        this.instance_defaulted.add(ent)

    ; hadAfdrDecl / setHadAfdrDecl (ParserState.h:837) + options().errorAfdr.
    function get_had_afdr_decl(this: ParserState) returns bool
        had_afdr_decl

    function set_had_afdr_decl(this: pointer[ParserState])
        set this.had_afdr_decl: true

    function get_error_afdr(this: ParserState) returns bool
        parser_options.error_afdr

    ; options() — the -w axis record; never null (make installs defaults).
    function get_options(this: ParserState) returns pointer[ParserOptions]
        parser_options

    function set_options(this: pointer[ParserState], opts: pointer[ParserOptions])
        set this.parser_options: opts

    ; noteReferencedEntity (ParserState.cxx:590) — a set keyed on the ref.
    function note_referenced_entity(this: pointer[ParserState], ent: pointer[Entity], is_parameter: bool, found_in_pass1: bool, looked_at_default: bool)
    {
        let n this.lpd_entity_refs.get_length()
        var i: size_t 0
        while i < n
        {
            let r this.lpd_entity_refs.get_buffer() + i
            if r.entity = ent
            {
                if (r.looked_at_default = looked_at_default) and (r.found_in_pass1 = found_in_pass1)
                    return
            }
            set i: i + 1
        }
        var nr LpdEntityRef()
        set nr.entity: ent
        set nr.is_parameter: is_parameter
        set nr.looked_at_default: looked_at_default
        set nr.found_in_pass1: found_in_pass1
        this.lpd_entity_refs.add(nr)
    }

    function n_lpd_entity_refs(this: ParserState) returns size_t
        lpd_entity_refs.get_length()

    function lpd_entity_ref_at(this: ParserState, i: size_t) returns pointer[LpdEntityRef]
        lpd_entity_refs.get_buffer() + i

    function clear_lpd_entity_refs(this: pointer[ParserState])
    {
        let hp this.host
        set this.lpd_entity_refs: Array[LpdEntityRef]^hp()
    }

    ; ---- pass-aware entity lookup (ParserState::lookupEntity's prolog slice:
    ; result-attribute mode resolves against the RESULT dtd; the pass-2 prolog
    ; consults the pass-1 base DTD for entities declared in active LPDs and
    ; notes every consult for checkEntityStability). ------------------------
    function lookup_entity_pass_aware(this: pointer[ParserState], is_parameter: bool, name: StringC) returns pointer[Entity]
    {
        var dtd this.current_dtd
        if this.result_attribute_spec_mode
        {
            set dtd: null
            let dl this.def_lpd
            if dl <> null
                set dtd: dl.get_result_dtd()
        }
        if dtd = null
            return null
        let entity dtd.lookup_entity(is_parameter, name)
        ; ParserState.cxx:522: the found-entity arm that is NOT the pass-2
        ; prolog consult dispatches an EntityDefaultedEvent — with -oentity the
        ; writer re-prints the entity's definition at EVERY reference (probed:
        ; each `&foo;` re-emits `Ifoo TEXT hello` and splits the data run).
        var pass2_consulted false
        if this.in_instance = false
        {
            if this.pass2 and dtd.get_is_base() and (this.result_attribute_spec_mode = false)
            {
                var consult true
                if entity <> null
                {
                    if (*this).entity_decl_in_active_lpd(entity)
                        set consult: false
                }
                if consult
                {
                    set pass2_consulted: true
                    let p1 this.pass1_dtd
                    if p1 <> null
                    {
                        let entity1 p1.lookup_entity(is_parameter, name)
                        if entity1 <> null
                        {
                            if (*this).entity_decl_in_active_lpd(entity1)
                            {
                                this.note_referenced_entity(entity1, is_parameter, true, false)
                                return entity1
                            }
                        }
                        if entity <> null
                            this.note_referenced_entity(entity, is_parameter, false, false)
                    }
                }
            }
        }
        ; ParserState.cxx:518/523: a lookup that finds the entity in the
        ; current DTD marks it used (the pass-1 active-LPD return above does
        ; NOT) — feeds the -wunused-param sweep.
        if entity <> null
        {
            this.note_entity_used(entity)
            if pass2_consulted = false
            {
                if (this.output_flags & OF_ENTITY) <> (0 as u32)
                {
                    let hp this.host
                    this.queue_event(Event.make_entity_defaulted(hp, entity, Location()))
                }
            }
        }
        entity
    }

    ; the default-entity half of the same consult (ParserState.cxx:529-543).
    function default_entity_pass_aware(this: pointer[ParserState], dtd: pointer[Dtd]) returns pointer[Entity]
    {
        var entity dtd.get_default_entity()
        if this.in_instance = false
        {
            if this.pass2 and dtd.get_is_base() and (this.result_attribute_spec_mode = false)
            {
                var consult true
                if entity <> null
                {
                    if (*this).entity_decl_in_active_lpd(entity)
                        set consult: false
                }
                if consult
                {
                    let p1 this.pass1_dtd
                    if p1 <> null
                    {
                        let entity1 p1.get_default_entity()
                        var used_pass1 false
                        if entity1 <> null
                        {
                            if (*this).entity_decl_in_active_lpd(entity1)
                            {
                                set used_pass1: true
                                set entity: entity1
                            }
                        }
                        if entity <> null
                            this.note_referenced_entity(entity, false, used_pass1, true)
                    }
                }
            }
        }
        entity
    }

    ; ---- phase + tag flags ------------------------------------------------
    function set_phase(this: pointer[ParserState], phase: int)
        set this.phase: phase

    function get_phase(this: ParserState) returns int
        phase

    function get_final_phase(this: ParserState) returns int
        final_phase

    function get_subdoc_level(this: ParserState) returns u32
        subdoc_level

    function is_in_instance(this: ParserState) returns bool
        in_instance

    ; startInstance sets inInstance_; it is deferred, so the flag is set directly.
    function set_in_instance(this: pointer[ParserState], b: bool)
        set this.in_instance: b

    function enter_tag(this: pointer[ParserState], start: bool)
    {
        if start
            set this.in_start_tag: true
        else
            set this.in_end_tag: true
    }

    function leave_tag(this: pointer[ParserState])
    {
        set this.in_start_tag: false
        set this.in_end_tag: false
    }

    ; inTag(ref start): true if in a start OR end tag; `start` out-param says which.
    function in_tag(this: ParserState, start: pointer[bool]) returns bool
    {
        set *start: in_start_tag
        in_start_tag || in_end_tag
    }

    ; ---- input stack ------------------------------------------------------
    function current_input(this: ParserState) returns pointer[InputSource]
    {
        if input_level = (0 as u32)
            return null
        *(input_stack.get_buffer() + ((input_level - (1 as u32)) as size_t))
    }

    ; currentLocation() — the scan-cursor location of the top input (a null
    ; location when the stack is empty), resolving through nested sources via
    ; the origin chain (parent()).
    function current_location(this: ParserState) returns Location
    {
        let ins this.current_input()
        if ins = null
            return Location()
        ins.here_location()
    }

    function get_special_parse_input_level(this: ParserState) returns u32
        special_parse_input_level

    function get_input_level(this: ParserState) returns u32
        input_level

    ; entityIsOpen (ParserState.cxx): is this entity declaration already on the
    ; input stack? Walks the open sources comparing their origin's entity_decl by
    ; identity — Entity::checkNotOpen's recursion guard.
    function entity_is_open(this: ParserState, decl: pointer[void]) returns bool
    {
        if decl = null
            return false
        var i: u32 0
        while i < input_level
        {
            let ins *(input_stack.get_buffer() + (i as size_t))
            if ins <> null
            {
                let org ins.get_origin()
                if org <> null
                {
                    if org.get_entity_decl() = decl
                        return true
                }
            }
            set i: i + (1 as u32)
        }
        false
    }

    function push_input(this: pointer[ParserState], ins: pointer[InputSource])
    {
        if ins = null
            return

        ; (handler.inputOpened + the multicode markup-scan-table install are
        ; event/streaming surface -> deferred; no EventHandler sink here.)
        if this.input_level < (this.input_stack.get_length() as u32)
            this.input_stack.put(this.input_level as size_t, ins)
        else
            this.input_stack.add(ins)
        set this.input_level: this.input_level + (1 as u32)

        if (this.special_parse_input_level > (0 as u32)) && (this.input_level > this.special_parse_input_level)
            set this.current_mode: rcconeMode
        else if this.current_mode = dsMode
            set this.current_mode: dsiMode

        ; inputLevelElementIndex (ParserState.cxx:341): pushed only under
        ; inInstance_ && integrallyStored(); tagLevel()>0 ? element index : 0.
        if this.in_instance && this.sd.integrally_stored()
        {
            var idx: u32 0
            if this.content_state.tag_level_of() > (0 as u32)
                set idx: this.content_state.current_element().get_index() as u32
            if this.n_input_level_element_index < this.input_level_element_index.get_length()
                this.input_level_element_index.put(this.n_input_level_element_index, idx)
            else
                this.input_level_element_index.add(idx)
            set this.n_input_level_element_index: this.n_input_level_element_index + (1 as size_t)
        }
    }

    function pop_input_stack(this: pointer[ParserState])
    {
        ; ASSERT(inputLevel_ > 0). handler.inputClosed -> deferred. Guarded
        ; against underflow so a mis-stacked construct degrades to a graceful
        ; end rather than wrapping input_level to a huge value.
        if this.input_level = (0 as u32)
            return
        set this.input_level: this.input_level - (1 as u32)
        if (this.special_parse_input_level > (0 as u32)) && (this.input_level = this.special_parse_input_level)
            set this.current_mode: this.special_parse_mode
        if (this.current_mode = dsiMode) && (this.input_level = (1 as u32)) && (this.marked_section_level = (0 as u32))
            set this.current_mode: dsMode
        if this.n_input_level_element_index > (0 as size_t)
            set this.n_input_level_element_index: this.n_input_level_element_index - (1 as size_t)
    }

    function current_input_element_index(this: ParserState) returns u32
    {
        if n_input_level_element_index = (0 as size_t)
            return 0 as u32
        *(input_level_element_index.get_buffer() + (n_input_level_element_index - (1 as size_t)))
    }

    ; undefinedEntityTable_.lookupConst(name): the undefined entity a prior
    ; reference to `name` fabricated, or null on the first reference.
    function lookup_undefined_entity(this: ParserState, name: StringC) returns pointer[Entity]
    {
        var i: size_t 0
        let n undefined_entities.get_length()
        while i < n
        {
            let e *(undefined_entities.get_buffer() + i)
            if e <> null
            {
                if e.get_name().equals(name)
                    return e
            }
            set i: i + 1
        }
        null
    }

    function add_undefined_entity(this: pointer[ParserState], ent: pointer[Entity])
        this.undefined_entities.add(ent)

    ; ---- marked-section state machine (ParserState.cxx) -------------------
    ; markedSectionStartLocation_ tracks each open section's MDO for the
    ; unclosedMarkedSection auxiliary. contentMode() reads the live content head.
    function get_marked_section_level(this: ParserState) returns u32
        marked_section_level

    function get_marked_section_special_level(this: ParserState) returns u32
        marked_section_special_level

    function push_ms_start_location(this: pointer[ParserState], loc: Location)
    {
        if this.n_ms_start_locations < this.ms_start_locations.get_length()
            this.ms_start_locations.put(this.n_ms_start_locations, loc)
        else
            this.ms_start_locations.add(loc)
        set this.n_ms_start_locations: this.n_ms_start_locations + (1 as size_t)
    }

    function current_marked_section_start_location(this: ParserState) returns Location
    {
        if n_ms_start_locations = (0 as size_t)
            return Location()
        *(ms_start_locations.get_buffer() + (n_ms_start_locations - (1 as size_t)))
    }

    function start_marked_section(this: pointer[ParserState], loc: Location)
    {
        set this.marked_section_level: this.marked_section_level + (1 as u32)
        this.push_ms_start_location(loc)
        if this.current_mode = dsMode
            set this.current_mode: dsiMode
        if this.marked_section_special_level > (0 as u32)
            set this.marked_section_special_level: this.marked_section_special_level + (1 as u32)
    }

    function start_special_marked_section(this: pointer[ParserState], mode: int, loc: Location)
    {
        set this.marked_section_level: this.marked_section_level + (1 as u32)
        this.push_ms_start_location(loc)
        set this.special_parse_input_level: this.input_level
        set this.marked_section_special_level: 1 as u32
        set this.special_parse_mode: mode
        set this.current_mode: mode
    }

    function end_marked_section(this: pointer[ParserState])
    {
        set this.marked_section_level: this.marked_section_level - (1 as u32)
        if this.n_ms_start_locations > (0 as size_t)
            set this.n_ms_start_locations: this.n_ms_start_locations - (1 as size_t)
        if this.marked_section_special_level > (0 as u32)
        {
            set this.marked_section_special_level: this.marked_section_special_level - (1 as u32)
            if this.marked_section_special_level > (0 as u32)
                return
            set this.special_parse_input_level: 0 as u32
            if this.in_instance
                set this.current_mode: this.content_state.content_mode()
            else
                set this.current_mode: dsiMode
        }
        if (this.current_mode = dsiMode) && (this.input_level = (1 as u32)) && (this.marked_section_level = (0 as u32))
            set this.current_mode: dsMode
    }

    ; ---- mode / recognizer table + normal map ----------------------------
    function get_current_mode(this: ParserState) returns int
        current_mode

    ; The parser drives currentMode directly at several sites (start of prolog/
    ; instance/dtd); exposed as a setter (the flow methods are deferred).
    function set_current_mode(this: pointer[ParserState], mode: int)
        set this.current_mode: mode

    function set_recognizer(this: pointer[ParserState], mode: int, r: pointer[Recognizer])
        this.recognizers.put(mode as size_t, r)

    ; getToken(mode) — the scanner choke point: run the mode's recognizer over
    ; the top input source.
    function get_token(this: ParserState, mode: int) returns u32
    {
        ; Empty input stack -> end-of-entity, never a null-deref in the
        ; recognizer. The stack should not underflow during a conforming parse;
        ; an unhandled construct (e.g. an external entity reference this
        ; increment doesn't include) can leave it empty, and the token loops
        ; terminate on tokenEe rather than crashing.
        let ins this.current_input()
        if ins = null
            return tokenEe
        ; A mode with no installed recognizer (a construct this increment does
        ; not drive) yields end-of-entity rather than a null-deref.
        if (mode < 0) or ((mode as size_t) >= recognizers.get_length())
            return tokenEe
        let r *(recognizers.get_buffer() + (mode as size_t))
        if r = null
            return tokenEe
        r.recognize(ins)
    }

    function set_normal_map(this: pointer[ParserState], map: pointer[XcharMap])
        set this.normal_map: map

    function get_normal_map(this: ParserState) returns pointer[XcharMap]
        normal_map

    ; ---- token buffer -----------------------------------------------------
    function current_token(this: ParserState) returns StringC
    {
        let ins this.current_input()
        if ins = null
            return StringC#()
        ins.current_token_string#()
    }

    ; getCurrentToken(const SubstTable*): the SubstTable in OpenSP is the syntax's
    ; namecase substitution (Syntax.fold); fold each Char of the current token.
    function current_token_subst(this: ParserState, syn: pointer[Syntax]) returns StringC
    {
        let ins this.current_input()
        if ins = null
            return StringC#()
        let raw ins.current_token_string()
        let n raw.get_size()
        if n = (0 as size_t)
            return StringC#()
        let buf host.allocate(n * (4 as size_t), 4) as pointer[u32]
        var i: size_t 0
        while i < n
        {
            set *(buf + i): syn.fold(raw.get(i))
            set i: i + 1
        }
        StringC#(buf, n)
    }

    ; ---- IMPLYDEF (ParserState.h) -----------------------------------------
    ; The live copies of the SGML declaration's IMPLYDEF ELEMENT / ATTLIST values.
    ; They start as the declaration says (both NO) and enableImplydef flips them
    ; for the rest of the parse — once the document has been declared unvalidated
    ; (implyDtd's noDtd branch), an element with no declaration is no longer an
    ; error and an undeclared attribute gets an implied CDATA definition.
    function get_implydef_element(this: ParserState) returns int
        implydef_element

    function get_implydef_attlist(this: ParserState) returns bool
        implydef_attlist

    function enable_implydef(this: pointer[ParserState])
    {
        set this.implydef_element: IMPLYDEF_ELEMENT_YES
        set this.implydef_attlist: true
    }

    ; ---- AttributeContext live half ---------------------------------------
    function validate(this: ParserState) returns bool
        this.attribute_context.validate()

    function may_default_attribute(this: ParserState) returns bool
        this.attribute_context.may_default_attribute()

    function make_implied_attribute_value(this: ParserState) returns pointer[AttributeValue]
        this.attribute_context.make_implied_attribute_value()

    ; getAttributeNotation — look up a notation in the current DTD. The
    ; implydefNotation auto-creation branch (setExternalId + generateSystemId +
    ; implicitNotationAttributeDef) needs catalog-backed generateSystemId and is
    ; driven by the parser stage -> deferred.
    function get_attribute_notation(this: ParserState, name: StringC, loc: Location) returns pointer[Notation]
    {
        if this.have_current_dtd() = false
            return null
        this.current_dtd.lookup_notation(name)
    }

    ; getAttributeEntity — a general-entity lookup through the current DTD. The
    ; full lookupEntity (pass1/pass2 base-DTD reconciliation, defaulted-entity
    ; copy + entityDefaulted events, warnDefaultEntityReference) needs the
    ; pass2/LPD/event machinery and lands with the parser stage.
    function get_attribute_entity(this: ParserState, name: StringC, loc: Location) returns pointer[Entity]
    {
        if this.have_current_dtd() = false
            return null
        this.current_dtd.lookup_entity(false, name)
    }

    ; lookupCreateId — find or insert an Id by name in the id table (an
    ; IdTable: the PointerTable/Hash port whose bucket order IS the missingId
    ; message order — see Id.scaly).
    function lookup_create_id(this: pointer[ParserState], name: StringC) returns pointer[Id]
        this.id_table.lookup_create(this.host, name)

    function get_id_table(this: ParserState) returns pointer[IdTable]
        id_table

    ; defineId(str, loc, ref prevLoc) — outside an instance or a non-validating
    ; parse, IDs are not tracked (return true). Otherwise: first define wins
    ; (true); a duplicate reports the previous location (out-param) and fails.
    function define_id(this: pointer[ParserState], name: StringC, loc: Location, prev_loc: pointer[Location]) returns bool
    {
        if (this.in_instance = false) || (this.validate() = false)
            return true
        let id this.lookup_create_id(name)
        if id.defined()
        {
            set *prev_loc: id.def_location^this()
            return false
        }
        id.mark_defined(loc)
        true
    }

    ; noteIdref (ParserState.cxx:865) — record a forward IDREF while the
    ; target ID is undefined; gated on inInstance + options().errorIdref
    ; (-wno-idref clears it) + validate.
    function note_idref(this: pointer[ParserState], name: StringC, loc: Location)
    {
        if (this.in_instance = false) || (this.parser_options.error_idref = false) || (this.validate() = false)
            return
        let id this.lookup_create_id(name)
        if id.defined() = false
            id.add_pending_ref(loc)
    }

    ; startInstance does currentAttributes_.clear(); .resize(nCurrentAttribute).
    ; The flow method is deferred; this rebuilds the store as n null slots.
    function resize_current_attributes(this: pointer[ParserState], n: size_t)
    {
        let pg this.host
        let fresh Array[pointer[AttributeValue]]^pg()
        var i: size_t 0
        while i < n
        {
            fresh.add(null as pointer[AttributeValue])
            set i: i + 1
        }
        set this.current_attributes: fresh
        set this.n_current_attributes: n
    }

    function note_current_attribute(this: pointer[ParserState], i: size_t, value: pointer[AttributeValue])
    {
        if this.in_instance
            this.current_attributes.put(i, value)
    }

    function get_current_attribute(this: ParserState, i: size_t) returns pointer[AttributeValue]
    {
        if in_instance = false
            return null
        *(current_attributes.get_buffer() + i)
    }

    ; ---- Messenger half ---------------------------------------------------
    ; initMessage(msg) — stamp the message location (currentLocation). The
    ; open-element-info fill (inInstance) is message-formatting surface -> deferred.
    function init_message(this: pointer[ParserState], msg: pointer[Message])
        set msg.loc: this.current_location^this()

    ; dispatchMessage(msg) — queue it (no EventHandler sink) and track counts.
    function dispatch_message(this: pointer[ParserState], msg: Message)
    {
        this.messages.add(msg)
        set this.n_messages: this.n_messages + (1 as u32)
        if msg.get_type().is_error()
        {
            set this.n_errors: this.n_errors + (1 as u32)
            ; ErrorCountEventHandler::noteMessage — cancel exactly when the count
            ; reaches the limit (`++errorCount_ == maxErrors_`; -E overrides,
            ; 0 = unlimited).
            if (this.error_limit <> (0 as u32)) and (this.n_errors = this.error_limit)
                set this.cancelled: true
        }
    }

    ; cancelled() — the parse hit the error limit; the content loop must stop.
    function is_cancelled(this: ParserState) returns bool
        cancelled

    ; message(type) — build a Message, init its location, dispatch it (the
    ; Messenger::message entry the parse methods call, minus the arg vector).
    function message(this: pointer[ParserState], type: MessageType)
    {
        ; ErrorCountEventHandler cancel semantics: parseAll stops delivering
        ; events once cancelled, so a message generated AFTER the limit-
        ; reaching error (or the -p end-prolog cancel) is queued but never
        ; printed or counted — the port swallows it at the Messenger.
        if this.cancelled
            return
        var msg Message(type, Location())
        this.init_message(&msg)
        if this.keeping_messages
        {
            let args Vector[MessageArg]()
            this.keep_message(type, args, msg.get_loc(), true, false, StringC(), Location(), false)
            return
        }
        if this.is_pass1_buffering()
        {
            if type.is_error() = false
            {
                let args Vector[MessageArg]()
                this.keep_message(type, args, msg.get_loc(), true, false, StringC(), Location(), true)
                return
            }
            set this.pass1_had_error: true
        }
        this.dispatch_message(msg)
    }

    ; report(type, args) — the MessageReporter path for a message with real
    ; text: stamp its location, WRITE it to stderr now (onsgmls emits each
    ; message immediately, independent of the ESIS stream), then queue+count it.
    function report(this: pointer[ParserState], type: MessageType, args: Vector[MessageArg])
    {
        ; ErrorCountEventHandler cancel semantics: parseAll stops delivering
        ; events once cancelled, so a message generated AFTER the limit-
        ; reaching error (or the -p end-prolog cancel) is queued but never
        ; printed or counted — the port swallows it at the Messenger.
        if this.cancelled
            return
        var msg Message(type, Location())
        this.init_message(&msg)
        if this.keeping_messages
        {
            this.keep_message(type, args, msg.get_loc(), false, false, StringC(), Location(), false)
            return
        }
        if this.is_pass1_buffering()
        {
            if type.is_error() = false
            {
                this.keep_message(type, args, msg.get_loc(), false, false, StringC(), Location(), true)
                return
            }
            set this.pass1_had_error: true
        }
        this.emit_message(&msg, args)
        this.emit_oe_after(msg.get_loc(), this.capture_oe_info())
        this.dispatch_message(msg)
    }

    ; a LOCATION-LESS diagnostic through the parser Messenger (a storage-layer
    ; message with no parent location, e.g. a missing -c catalog): renders the
    ; app shape `<prog>:<sev>: <text>` but COUNTS toward the error count like
    ; any dispatched message (probed: `-c nosuchcat` alone makes exit 1 and
    ; suppresses the conformance C line).
    function report_noloc(this: pointer[ParserState], type: MessageType, args: Vector[MessageArg])
    {
        ; ErrorCountEventHandler cancel semantics: parseAll stops delivering
        ; events once cancelled, so a message generated AFTER the limit-
        ; reaching error (or the -p end-prolog cancel) is queued but never
        ; printed or counted — the port swallows it at the Messenger.
        if this.cancelled
            return
        this.emit_message_noloc(type.get_text(), args, type.severity_char(), type.get_number())
        var msg Message(type, Location())
        this.dispatch_message(msg)
    }

    ; ---- deferred multi-file open failures (see PendingOpen) ---------------
    ; Queue one failed storage-object open of the document entity. spec and
    ; detail must already be widened AND pinned on the parser's page.
    function queue_pending_open(this: pointer[ParserState], boundary: size_t, is_find: bool, spec: StringC, detail: StringC)
    {
        if this.pending_opens = null
        {
            let hp this.host
            set this.pending_opens: Array[PendingOpen]^hp()
        }
        var po PendingOpen()
        set po.boundary: boundary
        set po.is_find: is_find
        set po.spec: spec
        set po.detail: detail
        this.pending_opens.add(po)
    }

    function has_pending_opens(this: ParserState) returns bool
    {
        if pending_opens = null
            return false
        pending_open_next < pending_opens.get_length()
    }

    ; Flush every queued open failure whose boundary the document scan has
    ; crossed (force = all of them — the parse-end sweep). The reference
    ; reports the failure from fill() the moment reading needs the missing
    ; object's data; the observable effect is its position in the stderr
    ; stream, so flushing right before the next emitted message (and at
    ; parse end) reproduces the byte stream. Reads the BOTTOM input's scan
    ; cursor — the document entity's own read position, which pauses at a
    ; reference site while pushed entities parse, exactly like the
    ; reference's per-storage-object read.
    function flush_pending_opens(this: pointer[ParserState], force: bool)
    {
        if this.in_pending_flush
            return
        if this.has_pending_opens() = false
            return
        var pos: size_t 0
        if force = false
        {
            if this.input_level < (1 as u32)
            {
                ; the document input has already been popped (its final Ee) —
                ; reading finished, every boundary was crossed. Pendings are
                ; only ever queued right before the document is pushed, so a
                ; pre-push message can't land here with an empty stack.
                set pos: 0xFFFFFFFFFFFFFFFF as size_t
            }
            else
            {
                let bot *(this.input_stack.get_buffer())
                set pos: bot.get_cur_index()
            }
        }
        set this.in_pending_flush: true
        let n this.pending_opens.get_length()
        var k this.pending_open_next
        var advancing true
        while advancing
        {
            if k >= n
                set advancing: false
            else
            {
                let po *(this.pending_opens.get_buffer() + k)
                var due force
                if due = false
                {
                    if po.boundary <= pos
                        set due: true
                }
                if due
                {
                    var args Vector[MessageArg](2 as size_t)
                    set *(args.get(0 as size_t)): MessageArg.Str(po.spec)
                    set *(args.get(1 as size_t)): MessageArg.Raw(po.detail)
                    if po.is_find
                        this.report_noloc(PosixStorageMessages.cannotFind(), args)
                    else
                        this.report_noloc(PosixStorageMessages.openSystemCall(), args)
                    ; -g: the reference's dispatchMessage appends the open-
                    ; elements trailer to this message too (fired in-instance
                    ; through the parser messenger, location-less shape).
                    this.emit_oe_noloc(this.capture_oe_info())
                    set k: k + 1
                }
                else
                    set advancing: false
            }
        }
        set this.pending_open_next: k
        set this.in_pending_flush: false
    }

    ; report at an EXPLICIT location (a construct's captured start location, e.g. a
    ; start tag's) rather than the current scan cursor — Messenger::setNextLocation.
    function report_at(this: pointer[ParserState], type: MessageType, args: Vector[MessageArg], loc: Location)
    {
        ; ErrorCountEventHandler cancel semantics: parseAll stops delivering
        ; events once cancelled, so a message generated AFTER the limit-
        ; reaching error (or the -p end-prolog cancel) is queued but never
        ; printed or counted — the port swallows it at the Messenger.
        if this.cancelled
            return
        if this.keeping_messages
        {
            this.keep_message(type, args, loc, false, false, StringC(), Location(), false)
            return
        }
        if this.is_pass1_buffering()
        {
            if type.is_error() = false
            {
                this.keep_message(type, args, loc, false, false, StringC(), Location(), true)
                return
            }
            set this.pass1_had_error: true
        }
        var msg Message(type, loc)
        this.emit_message(&msg, args)
        this.emit_oe_after(loc, this.capture_oe_info())
        this.dispatch_message(msg)
    }

    ; report at an explicit location WITH an auxiliary location line. onsgmls's
    ; dispatchMessage prints a second, severity-less line for a message whose
    ; auxLoc is non-null (`<prog>:<file>:<line>:<col>: <auxText>`). Used by the
    ; omitted-end-tag diagnostics whose aux fragment is "start tag was here",
    ; pointing at the open element's start location. Counts as ONE message.
    function report_aux(this: pointer[ParserState], type: MessageType, args: Vector[MessageArg], loc: Location, aux_text: StringC, aux_loc: Location)
    {
        ; ErrorCountEventHandler cancel semantics: parseAll stops delivering
        ; events once cancelled, so a message generated AFTER the limit-
        ; reaching error (or the -p end-prolog cancel) is queued but never
        ; printed or counted — the port swallows it at the Messenger.
        if this.cancelled
            return
        if this.keeping_messages
        {
            this.keep_message(type, args, loc, false, true, aux_text, aux_loc, false)
            return
        }
        if this.is_pass1_buffering()
        {
            if type.is_error() = false
            {
                this.keep_message(type, args, loc, false, true, aux_text, aux_loc, true)
                return
            }
            set this.pass1_had_error: true
        }
        var msg Message(type, loc)
        this.emit_message(&msg, args)
        this.emit_aux_line(aux_text, args, aux_loc)
        ; -g: after the aux line (dispatchMessage order: message, clauses,
        ; aux, open elements).
        this.emit_oe_after(loc, this.capture_oe_info())
        this.dispatch_message(msg)
    }

    ; ---- keepMessages / releaseKeptMessages / discardKeptMessages ----------
    ; (Messenger, Message.cxx) — buffer diagnostics while the parser speculates.
    function keep_messages(this: pointer[ParserState])
        set this.keeping_messages: true

    ; to_pass1: store into the Pass1EventHandler buffer instead of the
    ; speculation buffer (non-error messages during pass-1 buffering).
    function keep_message(this: pointer[ParserState], type: MessageType, args: Vector[MessageArg], loc: Location, silent: bool, has_aux: bool, aux_text: StringC, aux_loc: Location, to_pass1: bool)
    {
        var km KeptMessage()
        set km.msg_number: type.fragment.number
        ; the table accessor's text (and any fired arg) is REGION-TRANSIENT —
        ; valid at fire time, reused by release time. Pin every kept StringC
        ; on the parser's page.
        let hp this.host
        let ttxt type.get_text()
        set km.msg_text: StringC^hp(ttxt.data_ptr(), ttxt.get_size())
        let tcls type.get_clauses()
        set km.msg_clauses: StringC^hp(tcls.data_ptr(), tcls.get_size())
        ; -g snapshot at FIRE time (Messenger::message runs initMessage before
        ; the Message is stored) — null when the option is off.
        set km.oe_info: this.capture_oe_info()
        var sev_code KS_ERROR
        choose type.severity
            when x: Severity.Info
                set sev_code: KS_INFO
            when x: Severity.Warning
                set sev_code: KS_WARNING
            when x: Severity.QuantityError
                set sev_code: KS_QUANTITY
            when x: Severity.IdrefError
                set sev_code: KS_IDREF
            else
                set sev_code: KS_ERROR
        set km.msg_sev: sev_code
        set km.loc: loc
        set km.a0_kind: KA_NONE
        set km.a1_kind: KA_NONE
        set km.a2_kind: KA_NONE
        var n args.length
        if n > (3 as size_t)
            set n: 3 as size_t
        if n > (0 as size_t)
        {
            let a *args.get(0 as size_t)
            choose a
                when s: MessageArg.Str
                {
                    set km.a0_kind: KA_STR
                    set km.a0_str: StringC^hp(s.data_ptr(), s.get_size())
                }
                when nu: MessageArg.Num
                {
                    set km.a0_kind: KA_NUM
                    set km.a0_num: nu
                }
                when o: MessageArg.Ord
                {
                    set km.a0_kind: KA_ORD
                    set km.a0_num: o
                }
                when v: MessageArg.Vec
                {
                    set km.a0_kind: KA_VEC
                    set km.a0_vec: v
                }
                when r: MessageArg.Raw
                {
                    set km.a0_kind: KA_RAW
                    set km.a0_str: StringC^hp(r.data_ptr(), r.get_size())
                }
        }
        if n > (1 as size_t)
        {
            let a *args.get(1 as size_t)
            choose a
                when s: MessageArg.Str
                {
                    set km.a1_kind: KA_STR
                    set km.a1_str: StringC^hp(s.data_ptr(), s.get_size())
                }
                when nu: MessageArg.Num
                {
                    set km.a1_kind: KA_NUM
                    set km.a1_num: nu
                }
                when o: MessageArg.Ord
                {
                    set km.a1_kind: KA_ORD
                    set km.a1_num: o
                }
                when v: MessageArg.Vec
                {
                    set km.a1_kind: KA_VEC
                    set km.a1_vec: v
                }
                when r: MessageArg.Raw
                {
                    set km.a1_kind: KA_RAW
                    set km.a1_str: StringC^hp(r.data_ptr(), r.get_size())
                }
        }
        if n > (2 as size_t)
        {
            let a *args.get(2 as size_t)
            choose a
                when s: MessageArg.Str
                {
                    set km.a2_kind: KA_STR
                    set km.a2_str: StringC^hp(s.data_ptr(), s.get_size())
                }
                when nu: MessageArg.Num
                {
                    set km.a2_kind: KA_NUM
                    set km.a2_num: nu
                }
                when o: MessageArg.Ord
                {
                    set km.a2_kind: KA_ORD
                    set km.a2_num: o
                }
                when v: MessageArg.Vec
                {
                    set km.a2_kind: KA_VEC
                    set km.a2_vec: v
                }
                when r: MessageArg.Raw
                {
                    set km.a2_kind: KA_RAW
                    set km.a2_str: StringC^hp(r.data_ptr(), r.get_size())
                }
        }
        set km.silent: silent
        set km.has_aux: has_aux
        set km.aux_text: StringC^hp(aux_text.data_ptr(), aux_text.get_size())
        set km.aux_loc: aux_loc
        if to_pass1
        {
            if this.n_pass1_kept < this.pass1_kept.get_length()
                this.pass1_kept.put(this.n_pass1_kept, km)
            else
                this.pass1_kept.add(km)
            ; RAST interleave mark: how many events were queued when this
            ; message was kept (flush_pass1_messages_rast's replay order).
            if this.n_pass1_kept < this.pass1_kept_marks.get_length()
                this.pass1_kept_marks.put(this.n_pass1_kept, this.events.get_length())
            else
                this.pass1_kept_marks.add(this.events.get_length())
            set this.n_pass1_kept: this.n_pass1_kept + (1 as size_t)
        }
        else
        {
            if this.n_kept < this.kept_messages.get_length()
                this.kept_messages.put(this.n_kept, km)
            else
                this.kept_messages.add(km)
            set this.n_kept: this.n_kept + (1 as size_t)
        }
    }

    function discard_kept_messages(this: pointer[ParserState])
    {
        set this.keeping_messages: false
        set this.n_kept: 0
    }

    ; whether pass-1 buffering is live (allowPass2 set, pass 2 not yet started):
    ; non-error messages divert into pass1_kept, errors pass through and veto
    ; pass 2 (Pass1EventHandler::message).
    function is_pass1_buffering(this: ParserState) returns bool
    {
        if allow_pass2 = false
            return false
        pass2 = false
    }

    ; emit + count ONE kept message (the release path's per-entry body, shared
    ; with the pass-1 flush).
    function emit_kept_at(this: pointer[ParserState], km: pointer[KeptMessage])
    {
        var n_args: size_t 0
        if km.a0_kind <> KA_NONE
            set n_args: 1
        if km.a1_kind <> KA_NONE
            set n_args: 2
        if km.a2_kind <> KA_NONE
            set n_args: 3
        var args Vector[MessageArg](n_args)
        ; rebuild each slot with a DIRECT construction — a MessageArg
        ; returned from a helper reads as a local-page reference to the
        ; escape checker when stored through the vector pointer.
        if n_args > (0 as size_t)
        {
            if km.a0_kind = KA_STR
                set *(args.get(0 as size_t)): MessageArg.Str(km.a0_str)
            else if km.a0_kind = KA_NUM
                set *(args.get(0 as size_t)): MessageArg.Num(km.a0_num)
            else if km.a0_kind = KA_ORD
                set *(args.get(0 as size_t)): MessageArg.Ord(km.a0_num)
            else if km.a0_kind = KA_VEC
                set *(args.get(0 as size_t)): MessageArg.Vec(km.a0_vec)
            else
                set *(args.get(0 as size_t)): MessageArg.Raw(km.a0_str)
        }
        if n_args > (1 as size_t)
        {
            if km.a1_kind = KA_STR
                set *(args.get(1 as size_t)): MessageArg.Str(km.a1_str)
            else if km.a1_kind = KA_NUM
                set *(args.get(1 as size_t)): MessageArg.Num(km.a1_num)
            else if km.a1_kind = KA_ORD
                set *(args.get(1 as size_t)): MessageArg.Ord(km.a1_num)
            else if km.a1_kind = KA_VEC
                set *(args.get(1 as size_t)): MessageArg.Vec(km.a1_vec)
            else
                set *(args.get(1 as size_t)): MessageArg.Raw(km.a1_str)
        }
        if n_args > (2 as size_t)
        {
            if km.a2_kind = KA_STR
                set *(args.get(2 as size_t)): MessageArg.Str(km.a2_str)
            else if km.a2_kind = KA_NUM
                set *(args.get(2 as size_t)): MessageArg.Num(km.a2_num)
            else if km.a2_kind = KA_ORD
                set *(args.get(2 as size_t)): MessageArg.Ord(km.a2_num)
            else if km.a2_kind = KA_VEC
                set *(args.get(2 as size_t)): MessageArg.Vec(km.a2_vec)
            else
                set *(args.get(2 as size_t)): MessageArg.Raw(km.a2_str)
        }
        var sev Severity.Error
        if km.msg_sev = KS_INFO
            set sev: Severity.Info
        else if km.msg_sev = KS_WARNING
            set sev: Severity.Warning
        else if km.msg_sev = KS_QUANTITY
            set sev: Severity.QuantityError
        else if km.msg_sev = KS_IDREF
            set sev: Severity.IdrefError
        let mt MessageType(MessageFragment(km.msg_number, km.msg_text), sev, km.msg_clauses)
        var msg Message(mt, km.loc)
        if km.silent = false
        {
            this.emit_message(&msg, args)
            if km.has_aux
                this.emit_aux_line(km.aux_text, args, km.aux_loc)
            ; -g: the snapshot taken when the message FIRED (keep time).
            this.emit_oe_after(km.loc, km.oe_info)
        }
        this.dispatch_message(msg)
    }

    ; field-wise copy of a kept message into the pass-1 buffer (a by-value
    ; load of the wide struct does not round-trip — the S27 rule).
    function pass1_store(this: pointer[ParserState], km: pointer[KeptMessage])
    {
        var km2 KeptMessage()
        set km2.msg_number: km.msg_number
        set km2.msg_text: km.msg_text
        set km2.msg_sev: km.msg_sev
        set km2.loc: km.loc
        set km2.a0_kind: km.a0_kind
        set km2.a0_str: km.a0_str
        set km2.a0_num: km.a0_num
        set km2.a0_vec: km.a0_vec
        set km2.a1_kind: km.a1_kind
        set km2.a1_str: km.a1_str
        set km2.a1_num: km.a1_num
        set km2.a1_vec: km.a1_vec
        set km2.a2_kind: km.a2_kind
        set km2.a2_str: km.a2_str
        set km2.a2_num: km.a2_num
        set km2.a2_vec: km.a2_vec
        set km2.silent: km.silent
        set km2.has_aux: km.has_aux
        set km2.aux_text: km.aux_text
        set km2.aux_loc: km.aux_loc
        set km2.msg_clauses: km.msg_clauses
        set km2.oe_info: km.oe_info
        if this.n_pass1_kept < this.pass1_kept.get_length()
            this.pass1_kept.put(this.n_pass1_kept, km2)
        else
            this.pass1_kept.add(km2)
        set this.n_pass1_kept: this.n_pass1_kept + (1 as size_t)
    }

    function release_kept_messages(this: pointer[ParserState])
    {
        set this.keeping_messages: false
        var i: size_t 0
        while i < this.n_kept
        {
            ; access the entry through a POINTER — a by-value load of the wide
            ; struct does not round-trip (see the decomposed-args note above).
            let km this.kept_messages.get_buffer() + i
            ; released messages route through the pass-1 filter exactly like
            ; directly-reported ones (the handler sits downstream of release).
            var to_pass1 false
            if this.is_pass1_buffering()
            {
                if (km.msg_sev = KS_INFO) or (km.msg_sev = KS_WARNING)
                    set to_pass1: true
            }
            if to_pass1
                this.pass1_store(km)
            else
            {
                if this.is_pass1_buffering()
                    set this.pass1_had_error: true
                this.emit_kept_at(km)
            }
            set i: i + (1 as size_t)
        }
        set this.n_kept: 0
    }

    ; maybeStartPass2's no-pass-2 arm: replay the buffered pass-1 messages
    ; through the real stream, in buffered order (they trail any pass-through
    ; errors, exactly like the reference's queue drain).
    function flush_pass1_messages(this: pointer[ParserState])
    {
        var i: size_t 0
        while i < this.n_pass1_kept
        {
            let km this.pass1_kept.get_buffer() + i
            this.emit_kept_at(km)
            set i: i + (1 as size_t)
        }
        set this.n_pass1_kept: 0
    }

    function discard_pass1_messages(this: pointer[ParserState])
        set this.n_pass1_kept: 0

    ; errorLimitExceeded (ParserApp.cxx): emitted once, after the parse, iff the
    ; error count reached the limit. Severity Info (does NOT raise the error
    ; count) and LOCATIONLESS (`<prog>:I: <text>`), %1 = the limit (unquoted).
    function report_error_limit(this: pointer[ParserState], limit: u32)
    {
        let mt ParserAppMessages.errorLimitExceeded()
        let txt mt.get_text()
        let sev mt.severity_char()
        var args Vector[MessageArg](1 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Num(limit as u64)
        this.emit_message_noloc(txt, args, sev, mt.get_number())
    }

    ; resolve_location — a port of MessageReporter::locationHeader (the default
    ; !openEntities path, MessageReporter.cxx). A diagnostic reported while the
    ; current input is an INTERNAL entity / parameter entity / literal expansion
    ; must print the file:line:col of the ENTITY REFERENCE in the enclosing source,
    ; not a position inside the replacement text. The reference walks the origin
    ; chain until it reaches an origin that has an externalInfo (a real backing
    ; source), taking the display file name AND line/col from THAT origin's own
    ; position data — never from the live input stack. Our stand-in for
    ; externalInfo is the normalized buffer make_char_source stashes on a real
    ; source's origin (get_contents); an internal-expansion origin builds its
    ; InputSource directly and leaves it null. At each internal step the index is
    ; recomputed exactly as the reference does:
    ;   entity origin: index = refLocation.index + refLength   (the position just
    ;                  past the reference — parseCommon.cxx builds refLength as the
    ;                  full span of `&name;`)
    ;   other origin:  index += refLocation.index              (proxy re-run; not
    ;                  produced yet, ported for fidelity)
    ; When the chain reaches no real source (loc.origin() null — the reference's
    ; defLocation branch, which we do not model), fall back to the current top
    ; input at the original index (a mis-stacked construct degrades gracefully).
    ; Returns the resolved real-source origin (whose file_name the caller reads
    ; into a local — a StringC carries a region pointer that cannot be stored
    ; through an out-parameter), and fills line/col (scalars) through the pointers.
    ; Returns null when the chain named no real source: line/col then come from the
    ; current top input at the original index (the pre-resolution fallback) and the
    ; caller leaves the file name empty. This null branch is now DEAD for any real
    ; parse: EVERY backing source is built through make_char_source, which stashes
    ; both the normalized buffer (get_contents) AND — as of the external-source
    ; display-name work — a file_name, on its origin (document, SGML declaration,
    ; external DTD subset, external text entity). So the chain always terminates on
    ; an origin with contents, and resolved is never null. Kept as a defensive
    ; branch against a future construct that stacks an input without an origin.
    ; `rs_next_line` — how an index resolving ONTO an inserted RS renders
    ; (MAIN message: previous line + col; AUX line: next line, col omitted);
    ; see Origin.line_col.
    ; out_index receives the index WITHIN the resolved origin's buffer — the
    ; caller needs it to pick the storage-object name of a multi-file
    ; document origin (Origin.file_name_at).
    function resolve_location(this: ParserState, loc: Location, rs_next_line: bool, out_line: pointer[u32], out_col: pointer[u32], out_index: pointer[size_t]) returns pointer[Origin]
    {
        var index loc.get_index()
        var org loc.get_origin()
        var resolved: pointer[Origin] null
        var walking true
        while walking
        {
            if org = null
                set walking: false
            else if org.get_contents() <> null
            {
                set resolved: org
                set walking: false
            }
            else if org.is_unopened()
            {
                ; a never-opened external source: the reference's externalInfo
                ; exists but externalize() fails (empty position_ table) —
                ; printLocation renders "(invalid location)" instead of
                ; resolving up to the reference site.
                set walking: false
            }
            else
            {
                let par org.parent()
                if par.get_origin() = null
                    set walking: false
                else
                {
                    if org.get_entity_decl() <> null
                        set index: par.get_index() + (org.get_ref_length() as u32)
                    else
                        set index: index + par.get_index()
                    set org: par.get_origin()
                }
            }
        }
        set *out_index: index as size_t
        if resolved <> null
        {
            resolved.line_col(index as size_t, rs_next_line, out_line, out_col)
            return resolved
        }
        set *out_line: 0 as u32
        set *out_col: 0 as u32
        let ins this.current_input()
        if ins <> null
            ins.line_col(loc.get_index() as size_t, rs_next_line, out_line, out_col)
        null
    }

    ; resolve_location_sos — SgmlsEventHandler::outputLocation1's walk (the
    ; -oline L records): like resolve_location it walks to the first origin
    ; with a real backing source, but each step takes the PARENT'S OWN index
    ; (`index = loc.index()` — outputLocation1 never adds the reference
    ; length, unlike the message walk), and an index sitting ON an inserted
    ; RS resolves to the line the RS STARTS (probed: a `&#RS;B`-shortref
    ; replacement anchors on the NEW line; keeprsre RS data chunks likewise).
    function resolve_location_sos(this: ParserState, loc: Location, out_line: pointer[u32], out_col: pointer[u32], out_index: pointer[size_t]) returns pointer[Origin]
    {
        var index loc.get_index()
        var org loc.get_origin()
        var resolved: pointer[Origin] null
        var walking true
        while walking
        {
            if org = null
                set walking: false
            else if org.get_contents() <> null
            {
                set resolved: org
                set walking: false
            }
            else
            {
                let par org.parent()
                if par.get_origin() = null
                    set walking: false
                else
                {
                    set index: par.get_index()
                    set org: par.get_origin()
                }
            }
        }
        set *out_index: index as size_t
        if resolved <> null
        {
            resolved.line_col(index as size_t, true, out_line, out_col)
            return resolved
        }
        set *out_line: 0 as u32
        set *out_col: 0 as u32
        null
    }

    ; resolve_location_open — MessageReporter::locationHeader's openEntities
    ; branch (-e): instead of resolving an entity-internal location up to the
    ; reference site, STOP at the innermost named entity origin, print one
    ; "In entity <name> included from <loc>" header line (the %2 location is
    ; resolved recursively through this same walk, so nested references print
    ; their own headers first), and anchor the message INSIDE the entity — an
    ; external entity at its own file position, an internal one through the
    ; per-char definition-location buffer (EntityOrigin::defLocation /
    ; Text::charLocation) at the literal's source. emit_headers=false is the
    ; follow-on-line variant (clauses/open-elements reuse the main line's
    ; resolved position without reprinting headers).
    function resolve_location_open(this: pointer[ParserState], loc: Location, rs_next_line: bool, emit_headers: bool, out_line: pointer[u32], out_col: pointer[u32], out_index: pointer[size_t]) returns pointer[Origin]
    {
        var index loc.get_index()
        var org loc.get_origin()
        var resolved: pointer[Origin] null
        var done_header false
        var walking true
        while walking
        {
            if org = null
                set walking: false
            else
            {
                let ed org.get_entity_decl()
                let par org.parent()
                var head_arm false
                if ed <> null
                    set head_arm: true
                if par.get_origin() = null
                    set head_arm: true
                if head_arm
                {
                    if done_header = false
                    {
                        ; reference: header only when the parent location names
                        ; a real source (`if (parentInfo)`); the document
                        ; origin (null parent) prints none.
                        if (ed <> null) and emit_headers
                        {
                            if par.get_origin() <> null
                            {
                                let pidx par.get_index() + (org.get_ref_length() as u32)
                                this.emit_in_entity_header(ed, Location(par.get_origin(), pidx), rs_next_line)
                            }
                        }
                        set done_header: true
                    }
                    if org.get_contents() <> null
                    {
                        set resolved: org
                        set walking: false
                    }
                    else
                    {
                        ; EntityOrigin::defLocation — map the offset in the
                        ; replacement text through the entity's per-char
                        ; location buffer (Text::charLocation: an offset past
                        ; the last char extrapolates from it), then continue
                        ; the walk from the literal's source. No buffer (an
                        ; untracked internal text) = no real source, exactly
                        ; like a reference Text built without locations.
                        var have_def false
                        if ed <> null
                        {
                            let entp ed as pointer[Entity]
                            let dl (*entp).internal_def_locs()
                            let tsz (*entp).internal_text_size()
                            if dl <> null
                            {
                                if tsz > (0 as size_t)
                                {
                                    var off index as size_t
                                    var extra: u32 0
                                    if off >= tsz
                                    {
                                        set extra: (off - (tsz - (1 as size_t))) as u32
                                        set off: tsz - (1 as size_t)
                                    }
                                    let nl *(dl + off)
                                    if nl.get_origin() <> null
                                    {
                                        set org: nl.get_origin()
                                        set index: nl.get_index() + extra
                                        set have_def: true
                                    }
                                }
                            }
                        }
                        if have_def = false
                            set walking: false
                    }
                }
                else
                {
                    if org.get_entity_decl() <> null
                        set index: par.get_index() + (org.get_ref_length() as u32)
                    else
                        set index: index + par.get_index()
                    set org: par.get_origin()
                }
            }
        }
        set *out_index: index as size_t
        if resolved <> null
        {
            resolved.line_col(index as size_t, rs_next_line, out_line, out_col)
            return resolved
        }
        set *out_line: 0 as u32
        set *out_col: 0 as u32
        let ins this.current_input()
        if ins <> null
            ins.line_col(loc.get_index() as size_t, rs_next_line, out_line, out_col)
        null
    }

    ; One "In entity <name> included from <file>:<line>[:<col>]" line — the
    ; MessageReporterMessages::inNamedEntity header the -e walk prints (no
    ; program-name prefix, %2 rendered with printLocation's column rules).
    ; Prints nothing when the parent location resolves to no real source.
    function emit_in_entity_header(this: pointer[ParserState], ed: pointer[void], parent_loc: Location, rs_next_line: bool)
    {
        var pline: u32 0
        var pcol: u32 0
        var pridx: size_t 0
        ; the header's %2 inherits the ON-RS rendering convention of the LINE
        ; it decorates (probed on the shortref-RE parent): a MAIN message's
        ; header renders the previous record's trailing position
        ; (`file:8:8`), an AUX line's header the line the RS opens with the
        ; column omitted (`file:9`) — so the caller's rs_next_line threads
        ; through unchanged.
        let presolved this.resolve_location_open(parent_loc, rs_next_line, true, &pline, &pcol, &pridx)
        if presolved = null
            return
        var pfname StringC()
        set pfname: presolved.file_name_at(pridx)

        var buf u32[2048]
        let bp buf as pointer[u32]
        let cap 2048 as size_t
        var p: size_t 0
        let pre StringC("In entity ")
        var i: size_t 0
        while i < pre.get_size()
        {
            set p: ParserState.put_char(bp, cap, p, pre.get(i))
            set i: i + 1
        }
        let entp ed as pointer[Entity]
        let nm (*entp).get_name()
        var ni: size_t 0
        while ni < nm.get_size()
        {
            set p: ParserState.put_char(bp, cap, p, nm.get(ni))
            set ni: ni + 1
        }
        let mid StringC(" included from ")
        var mi: size_t 0
        while mi < mid.get_size()
        {
            set p: ParserState.put_char(bp, cap, p, mid.get(mi))
            set mi: mi + 1
        }
        var fi: size_t 0
        while fi < pfname.get_size()
        {
            set p: ParserState.put_char(bp, cap, p, pfname.get(fi))
            set fi: fi + 1
        }
        set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
        set p: ParserState.put_dec(bp, cap, p, pline as u64)
        var omit false
        if (parent_loc.get_index() = (0 as u32)) and (pline = (1 as u32)) and (pcol = (0 as u32))
        {
            if presolved.get_buf_length() > (0 as size_t)
                set omit: true
        }
        if presolved.on_segment_leading_rs(pridx)
            set omit: true
        if pcol = COL_OMITTED
            set omit: true
        if omit = false
        {
            set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
            set p: ParserState.put_dec(bp, cap, p, pcol as u64)
        }
        set p: ParserState.put_char(bp, cap, p, 0x0A as u32)
        ParserState.write_stderr(bp, p, this.out_utf8, this.msg_fd)
    }

    ; ContentState::getOpenElementInfo (-g): one OeInfo per open element,
    ; OUTERMOST FIRST, excluding the synthetic document-element container
    ; (the reference sizes the vector to tagLevel). matchType/matchIndex
    ; describe the element's last-matched content-model token: the matched
    ; element's name (or RNI+PCDATA for a pcdata leaf) and typeIndex()+1;
    ; both unset while the match state still sits on the initial position.
    ; Returns null when the option is off or outside the instance
    ; (ParserState::initMessage captures only inInstance).
    function capture_oe_info(this: pointer[ParserState]) returns pointer[Array[OeInfo]]
    {
        if this.reporter_option(REP_OPEN_ELEMENTS) = false
            return null
        if this.in_instance = false
            return null
        let hp this.host
        let v Array[OeInfo]^hp()
        let cs this.content_state
        let tl cs.tag_level_of() as size_t
        ; rniPcdata — delimGeneral(dRNI) + reservedName(rPCDATA) ("#PCDATA").
        let syn this.syntax
        let pcb Array[u32]^hp()
        if syn <> null
        {
            let rl syn.delim_general_len(dRNI)
            var ri: size_t 0
            while ri < rl
            {
                pcb.add(syn.delim_general_char(dRNI, ri))
                set ri: ri + 1
            }
            ; R_PCDATA (Parser.scaly's reserved-name index; Syntax::rPCDATA).
            let pn syn.reserved_name(39)
            var pi: size_t 0
            while pi < pn.get_size()
            {
                pcb.add(pn.get(pi))
                set pi: pi + 1
            }
        }
        let rni_pcdata StringC^hp(pcb.get_buffer(), pcb.get_length())
        var j: size_t 0
        while j < tl
        {
            ; v[0] = outermost real element = stack offset tl-1 from the top.
            let oe cs.at_top(tl - (1 as size_t) - j)
            var info OeInfo()
            set info.gi: oe.get_type().get_name()
            set info.match_type: StringC()
            set info.match_index: 0 as u32
            set info.has_match: false
            set info.included: oe.get_included()
            let tok oe.current_position()
            if tok <> null
            {
                if tok.is_initial = false
                {
                    set info.match_index: tok.type_index + (1 as u32)
                    set info.has_match: true
                    if tok.element <> null
                    {
                        let et tok.element
                        set info.match_type: et.get_name()
                    }
                    else
                        set info.match_type: rni_pcdata
                }
            }
            v.add(info)
            set j: j + 1
        }
        v
    }

    ; The -g "open elements:" trailer line — MessageFormatter::formatOpenElements
    ; rendered at the MAIN message's location (quiet resolve: -e headers are
    ; not repeated). oe = the snapshot captured when the message fired.
    function emit_oe_after(this: pointer[ParserState], loc: Location, oe: pointer[Array[OeInfo]])
    {
        if oe = null
            return
        if oe.get_length() = (0 as size_t)
            return
        var line: u32 0
        var col: u32 0
        var ridx: size_t 0
        var resolved: pointer[Origin] null
        if this.reporter_option(REP_OPEN_ENTITIES)
            set resolved: this.resolve_location_open(loc, false, false, &line, &col, &ridx)
        else
            set resolved: this.resolve_location(loc, false, &line, &col, &ridx)
        var fname StringC()
        if resolved <> null
            set fname: resolved.file_name_at(ridx)

        let payload this.build_oe_payload(oe)
        this.emit_ref_line(resolved, fname, line, col, loc.get_index(), ridx, StringC("open elements:"), payload)
    }

    ; formatOpenElements (MessageFormatter.cxx:38): ` gi` per element;
    ; a non-included element after the first appends `[n]` with the
    ; PREVIOUS element's match index; at each included boundary (and at
    ; the end) the previous element's last match renders as
    ; ` (type[index])`.
    function build_oe_payload(this: pointer[ParserState], oe: pointer[Array[OeInfo]]) returns StringC
    {
        var pay u32[1024]
        let pp pay as pointer[u32]
        let pcap 1024 as size_t
        var p: size_t 0
        let n oe.get_length()
        var i: size_t 0
        var brk false
        while brk = false
        {
            var at_boundary false
            if i > (0 as size_t)
            {
                if i = n
                    set at_boundary: true
                else
                {
                    let e2 *(oe.get_buffer() + i)
                    if e2.included
                        set at_boundary: true
                }
            }
            if at_boundary
            {
                let prev *(oe.get_buffer() + (i - (1 as size_t)))
                if prev.has_match
                {
                    set p: ParserState.put_char(pp, pcap, p, 0x20 as u32)
                    set p: ParserState.put_char(pp, pcap, p, 0x28 as u32)
                    var mi: size_t 0
                    let mt prev.match_type
                    while mi < mt.get_size()
                    {
                        set p: ParserState.put_char(pp, pcap, p, mt.get(mi))
                        set mi: mi + 1
                    }
                    if prev.match_index <> (0 as u32)
                    {
                        set p: ParserState.put_char(pp, pcap, p, 0x5B as u32)
                        set p: ParserState.put_dec(pp, pcap, p, prev.match_index as u64)
                        set p: ParserState.put_char(pp, pcap, p, 0x5D as u32)
                    }
                    set p: ParserState.put_char(pp, pcap, p, 0x29 as u32)
                }
            }
            if i = n
                set brk: true
            else
            {
                let e *(oe.get_buffer() + i)
                set p: ParserState.put_char(pp, pcap, p, 0x20 as u32)
                var gi2: size_t 0
                let g e.gi
                while gi2 < g.get_size()
                {
                    set p: ParserState.put_char(pp, pcap, p, g.get(gi2))
                    set gi2: gi2 + 1
                }
                if (i > (0 as size_t)) and (e.included = false)
                {
                    let prev2 *(oe.get_buffer() + (i - (1 as size_t)))
                    if prev2.match_index <> (0 as u32)
                    {
                        set p: ParserState.put_char(pp, pcap, p, 0x5B as u32)
                        set p: ParserState.put_dec(pp, pcap, p, prev2.match_index as u64)
                        set p: ParserState.put_char(pp, pcap, p, 0x5D as u32)
                    }
                }
                set i: i + 1
            }
        }
        let hp this.host
        StringC^hp(pp, p)
    }

    ; the -g trailer under a LOCATION-LESS message (a deferred multi-file
    ; open failure fired mid-instance): `<prog>:open elements: <payload>` —
    ; no location segment, no space after the program colon (probed).
    function emit_oe_noloc(this: pointer[ParserState], oe: pointer[Array[OeInfo]])
    {
        if oe = null
            return
        if oe.get_length() = (0 as size_t)
            return
        let payload this.build_oe_payload(oe)
        var buf u32[2048]
        let bp buf as pointer[u32]
        let cap 2048 as size_t
        var p: size_t 0
        let pn this.prog_name
        var pi: size_t 0
        while pi < pn.get_length()
        {
            set p: ParserState.put_char(bp, cap, p, (*(pn.get_buffer() + pi)) as u32)
            set pi: pi + 1
        }
        set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
        let lbl StringC("open elements:")
        var li: size_t 0
        while li < lbl.get_size()
        {
            set p: ParserState.put_char(bp, cap, p, lbl.get(li))
            set li: li + 1
        }
        var yi: size_t 0
        while yi < payload.get_size()
        {
            set p: ParserState.put_char(bp, cap, p, payload.get(yi))
            set yi: yi + 1
        }
        set p: ParserState.put_char(bp, cap, p, 0x0A as u32)
        ParserState.write_stderr(bp, p, this.out_utf8, this.msg_fd)
    }

    ; emit_message — one diagnostic line to stderr, byte-identical to onsgmls's
    ; plain MessageReporter::dispatchMessage:
    ;   <prog>:<file>:<line>:<col>:<sev>: <formatted text>\n
    ; line 1-based, col 0-based (printLocation prints its 1-based columnNumber
    ; minus 1). resolve_location turns the stamped location into file/line/col,
    ; resolving an entity-internal location up the origin chain to its reference.
    function emit_message(this: pointer[ParserState], msg: pointer[Message], args: Vector[MessageArg])
    {
        ; a queued multi-file open failure whose boundary the scan has crossed
        ; prints BEFORE this message (the reference reported it from fill()).
        this.flush_pending_opens(false)
        let loc msg.get_loc()
        var line: u32 0
        var col: u32 0
        ; -e (open-entities): the walk variant prints the "In entity ..."
        ; header lines and anchors inside the entity's definition instead of
        ; resolving up to the reference.
        var resolved: pointer[Origin] null
        var ridx: size_t 0
        if this.reporter_option(REP_OPEN_ENTITIES)
            set resolved: this.resolve_location_open(loc, false, true, &line, &col, &ridx)
        else
            set resolved: this.resolve_location(loc, false, &line, &col, &ridx)
        var fname StringC()
        if resolved <> null
            set fname: resolved.file_name_at(ridx)

        var buf u32[2048]
        let bp buf as pointer[u32]
        let cap 2048 as size_t
        var p: size_t 0

        ; program name (raw ASCII bytes) + ':'
        let pn this.prog_name
        var pi: size_t 0
        while pi < pn.get_length()
        {
            set p: ParserState.put_char(bp, cap, p, (*(pn.get_buffer() + pi)) as u32)
            set pi: pi + 1
        }
        set p: ParserState.put_char(bp, cap, p, 0x3A as u32)

        if resolved = null
        {
            ; MessageReporter::printLocation with a null externalInfo — the
            ; location named no real backing source (a diagnostic raised before
            ; any input is read, e.g. a subdocument's subdocLevel / end-of-
            ; prolog). onsgmls prints "(invalid location)" in place of the
            ; file:line:col header (MessageReporterMessages::invalidLocation).
            let il StringC("(invalid location)")
            var ii: size_t 0
            while ii < il.get_size()
            {
                set p: ParserState.put_char(bp, cap, p, il.get(ii))
                set ii: ii + 1
            }
            set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
        }
        else
        {
            ; file name + ':'
            var fi: size_t 0
            while fi < fname.get_size()
            {
                set p: ParserState.put_char(bp, cap, p, fname.get(fi))
                set fi: fi + 1
            }
            set p: ParserState.put_char(bp, cap, p, 0x3A as u32)

            ; line ':' [col ':'] — a location at buffer index 0 sits on the
            ; synthetic leading RS, BEFORE the first record position; onsgmls's
            ; columnNumber is 0 there and printLocation omits the column entirely
            ; (badDefaultSgmlDecl anchors there, `file:1:E: ...`). A MID-stream
            ; RS position renders in a MAIN message as the previous line + col
            ; (rs_next_line=false above); only the AUX line uses the next-line/
            ; omitted-column form.
            set p: ParserState.put_dec(bp, cap, p, line as u64)
            set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
            var omit_col false
            if (loc.get_index() = (0 as u32)) and (line = (1 as u32)) and (col = (0 as u32))
            {
                ; only when the position sits ON the synthetic leading RS —
                ; an EMPTY entity has none (buffer length 0) and renders a
                ; real column 0 (`file:1:0:E: end of document in prolog`).
                if resolved.get_buf_length() > (0 as size_t)
                    set omit_col: true
            }
            ; a later storage object's leading RS is the same rule (its
            ; columnNumber is 0 in the reference formula).
            if resolved.on_segment_leading_rs(ridx)
                set omit_col: true
            if col = COL_OMITTED
                set omit_col: true
            if omit_col = false
            {
                set p: ParserState.put_dec(bp, cap, p, col as u64)
                set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
            }
        }

        ; -n (message numbers): `<module>.<number>:` between the location and
        ; the severity tag. The reference prints `(unsigned long)type->module()`
        ; — the ADDRESS of libModule, different on every run under ASLR (probed:
        ; two invocations render two values). Byte-fidelity is impossible for a
        ; nondeterministic reference; the port renders the deterministic
        ; stand-in 0. The number half is the .msg catalog number (per-file
        ; bases: Parser=0, CmdLineApp=4000, EntityApp=4100, ParserApp=4200,
        ; Reporter=5000) and matches the reference exactly.
        if this.reporter_option(REP_MESSAGE_NUMBERS)
        {
            set p: ParserState.put_char(bp, cap, p, 0x30 as u32)
            set p: ParserState.put_char(bp, cap, p, 0x2E as u32)
            set p: ParserState.put_dec(bp, cap, p, msg.get_type().get_number() as u64)
            set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
        }

        ; severity ':' ' '
        set p: ParserState.put_char(bp, cap, p, msg.get_type().severity_char())
        set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
        set p: ParserState.put_char(bp, cap, p, 0x20 as u32)

        ; formatted message text (%1.. args substituted, String args quoted)
        let fmt MessageFormatter()
        let txt msg.get_type().get_text()
        let added fmt.format(txt, args, bp + p, cap - p, false)
        set p: p + added

        set p: ParserState.put_char(bp, cap, p, 0x0A as u32)

        ParserState.write_stderr(bp, p, this.out_utf8, this.msg_fd)

        ; -x (references): a second, severity-less line `<prog>:<file>:<line>:
        ; <col>: relevant clauses:  <clauses>` for a message whose type carries
        ; an ISO clause reference — same resolved location as the main line
        ; (dispatchMessage reuses externalInfo+off; note the double space: the
        ; relevantClauses fragment ends in ": " and the renderer adds " ").
        if this.reporter_option(REP_CLAUSES)
        {
            let cls msg.get_type().get_clauses()
            ; two spaces: the relevantClauses fragment text ends in ": " and
            ; the reference appends `" " << clauses` after it.
            if cls.get_size() > (0 as size_t)
                this.emit_ref_line(resolved, fname, line, col, loc.get_index(), ridx, StringC("relevant clauses:  "), cls)
        }
    }

    ; The shared -x/-g trailer-line renderer: `<prog>:<file>:<line>[:<col>]:
    ; <label><payload>` at the MAIN message's already-resolved location (no
    ; fresh origin walk — the reference prints these with the main line's
    ; externalInfo/off pair, so -e headers are not repeated).
    function emit_ref_line(this: pointer[ParserState], resolved: pointer[Origin], fname: StringC, line: u32, col: u32, loc_index: u32, ridx: size_t, lbl: StringC, payload: StringC)
    {
        var buf u32[2048]
        let bp buf as pointer[u32]
        let cap 2048 as size_t
        var p: size_t 0

        let pn this.prog_name
        var pi: size_t 0
        while pi < pn.get_length()
        {
            set p: ParserState.put_char(bp, cap, p, (*(pn.get_buffer() + pi)) as u32)
            set pi: pi + 1
        }
        set p: ParserState.put_char(bp, cap, p, 0x3A as u32)

        if resolved <> null
        {
            var fi: size_t 0
            while fi < fname.get_size()
            {
                set p: ParserState.put_char(bp, cap, p, fname.get(fi))
                set fi: fi + 1
            }
            set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
            set p: ParserState.put_dec(bp, cap, p, line as u64)
            var omit_col false
            if (loc_index = (0 as u32)) and (line = (1 as u32)) and (col = (0 as u32))
            {
                if resolved.get_buf_length() > (0 as size_t)
                    set omit_col: true
            }
            if resolved.on_segment_leading_rs(ridx)
                set omit_col: true
            if col = COL_OMITTED
                set omit_col: true
            if omit_col = false
            {
                set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
                set p: ParserState.put_dec(bp, cap, p, col as u64)
            }
            set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
        }
        else
        {
            ; the main line rendered "(invalid location)" (externalInfo
            ; present, externalize failed) — the trailer line reuses the same
            ; externalInfo/off pair, so it prints the same marker:
            ; `(invalid location): relevant clauses:  ...`.
            let il StringC("(invalid location)")
            var ii: size_t 0
            while ii < il.get_size()
            {
                set p: ParserState.put_char(bp, cap, p, il.get(ii))
                set ii: ii + 1
            }
            set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
        }
        set p: ParserState.put_char(bp, cap, p, 0x20 as u32)

        var li: size_t 0
        while li < lbl.get_size()
        {
            set p: ParserState.put_char(bp, cap, p, lbl.get(li))
            set li: li + 1
        }
        var yi: size_t 0
        while yi < payload.get_size()
        {
            set p: ParserState.put_char(bp, cap, p, payload.get(yi))
            set yi: yi + 1
        }
        set p: ParserState.put_char(bp, cap, p, 0x0A as u32)
        ParserState.write_stderr(bp, p, this.out_utf8, this.msg_fd)
    }

    ; emit_aux_line — the auxiliary line onsgmls prints under a message with a
    ; non-null auxLoc: `<prog>:<file>:<line>:<col>: <aux text>` (NO severity tag),
    ; with the aux loc's own file/line/col and the same arg vector substituted
    ; into the aux fragment text.
    function emit_aux_line(this: pointer[ParserState], text: StringC, args: Vector[MessageArg], loc: Location)
    {
        var line: u32 0
        var col: u32 0
        ; -e: the aux location gets its own locationHeader call in the
        ; reference — so its "In entity ..." header lines print here too.
        var resolved: pointer[Origin] null
        var ridx: size_t 0
        if this.reporter_option(REP_OPEN_ENTITIES)
            set resolved: this.resolve_location_open(loc, true, true, &line, &col, &ridx)
        else
            set resolved: this.resolve_location(loc, true, &line, &col, &ridx)
        var fname StringC()
        if resolved <> null
            set fname: resolved.file_name_at(ridx)

        var buf u32[2048]
        let bp buf as pointer[u32]
        let cap 2048 as size_t
        var p: size_t 0

        let pn this.prog_name
        var pi: size_t 0
        while pi < pn.get_length()
        {
            set p: ParserState.put_char(bp, cap, p, (*(pn.get_buffer() + pi)) as u32)
            set pi: pi + 1
        }
        set p: ParserState.put_char(bp, cap, p, 0x3A as u32)

        var fi: size_t 0
        while fi < fname.get_size()
        {
            set p: ParserState.put_char(bp, cap, p, fname.get(fi))
            set fi: fi + 1
        }
        set p: ParserState.put_char(bp, cap, p, 0x3A as u32)

        set p: ParserState.put_dec(bp, cap, p, line as u64)
        set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
        ; same column-omission rule as emit_message (COL_OMITTED = the
        ; position sits on a record start; `file:10: start tag was here`).
        if col <> COL_OMITTED
        {
            set p: ParserState.put_dec(bp, cap, p, col as u64)
            set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
        }
        set p: ParserState.put_char(bp, cap, p, 0x20 as u32)

        let fmt MessageFormatter()
        let added fmt.format(text, args, bp + p, cap - p, false)
        set p: p + added

        set p: ParserState.put_char(bp, cap, p, 0x0A as u32)
        ParserState.write_stderr(bp, p, this.out_utf8, this.msg_fd)
    }

    ; emit_message_noloc — a diagnostic with NO source location (a Messenger
    ; message issued by the driver, e.g. errorLimitExceeded): `<prog>:<sev>: <text>`.
    ; onsgmls's dispatchMessage omits the file:line:col entirely when the location
    ; has a null origin.
    function emit_message_noloc(this: pointer[ParserState], text: StringC, args: Vector[MessageArg], sev_char: u32, number: u32)
    {
        ; same crossing rule as emit_message (the in_pending_flush guard keeps
        ; the flush's own report_noloc lines out of here).
        this.flush_pending_opens(false)
        var buf u32[2048]
        let bp buf as pointer[u32]
        let cap 2048 as size_t
        var p: size_t 0

        let pn this.prog_name
        var pi: size_t 0
        while pi < pn.get_length()
        {
            set p: ParserState.put_char(bp, cap, p, (*(pn.get_buffer() + pi)) as u32)
            set pi: pi + 1
        }
        set p: ParserState.put_char(bp, cap, p, 0x3A as u32)

        ; -n: `<module>.<number>:` directly after the program name when the
        ; message has no location (probed: `onsgmls:<addr>.4202:I: maximum
        ; number of errors ...`); module stand-in 0, see emit_message.
        if this.reporter_option(REP_MESSAGE_NUMBERS)
        {
            set p: ParserState.put_char(bp, cap, p, 0x30 as u32)
            set p: ParserState.put_char(bp, cap, p, 0x2E as u32)
            set p: ParserState.put_dec(bp, cap, p, number as u64)
            set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
        }

        set p: ParserState.put_char(bp, cap, p, sev_char)
        set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
        set p: ParserState.put_char(bp, cap, p, 0x20 as u32)

        let fmt MessageFormatter()
        let added fmt.format(text, args, bp + p, cap - p, false)
        set p: p + added

        set p: ParserState.put_char(bp, cap, p, 0x0A as u32)
        ParserState.write_stderr(bp, p, this.out_utf8, this.msg_fd)
    }

    ; append one Char to a u32 buffer (bounds-checked).
    function put_char(out: pointer[u32], cap: size_t, pos: size_t, c: u32) returns size_t
    {
        if pos < cap
        {
            set *(out + pos): c
            return pos + (1 as size_t)
        }
        pos
    }

    ; append a decimal u64.
    function put_dec(out: pointer[u32], cap: size_t, pos: size_t, v: u64) returns size_t
    {
        var tmp u32[24]
        let t tmp as pointer[u32]
        var count: size_t 0
        var n v
        if n = (0 as u64)
        {
            set *t: (0x30 as u32)
            set count: 1
        }
        else
            while n > (0 as u64)
            {
                set *(t + count): (((0x30 as u64) + (n % (10 as u64))) as u32)
                set n: n / (10 as u64)
                set count: count + 1
            }
        var p pos
        var i count
        while i > (0 as size_t)
        {
            set i: i - 1
            set p: ParserState.put_char(out, cap, p, *(t + i))
        }
        p
    }

    ; Encode n Chars per the output coding system and write them to the
    ; message sink (fd 2, or the -f error file) in one blocking write, exactly
    ; as onsgmls flushes each formatted message. The stderr stream
    ; (CmdLineApp::makeStdErr) uses the same coding system as stdout but has
    ; NO escaper, so under identity a Char > 0xFF in a diagnostic is silently
    ; dropped (handleUnencodable with a null escaper).
    function write_stderr(out: pointer[u32], n: size_t, utf8: bool, fd: int)
    {
        var bytes u8[8192]
        let b bytes as pointer[u8]
        var w: size_t 0
        var i: size_t 0
        while i < n
        {
            let c *(out + i)
            if utf8 = false
            {
                if c < (0x100 as u32)
                {
                    set *(b + w): (c as u8)
                    set w: w + (1 as size_t)
                }
            }
            else if c < (0x80 as u32)
            {
                set *(b + w): (c as u8)
                set w: w + (1 as size_t)
            }
            else if c < (0x800 as u32)
            {
                set *(b + w): (((0xC0 as u32) | (c >> (6 as u32))) as u8)
                set *(b + (w + (1 as size_t))): (((0x80 as u32) | (c & (0x3F as u32))) as u8)
                set w: w + (2 as size_t)
            }
            else if c < (0x10000 as u32)
            {
                set *(b + w): (((0xE0 as u32) | (c >> (12 as u32))) as u8)
                set *(b + (w + (1 as size_t))): (((0x80 as u32) | ((c >> (6 as u32)) & (0x3F as u32))) as u8)
                set *(b + (w + (2 as size_t))): (((0x80 as u32) | (c & (0x3F as u32))) as u8)
                set w: w + (3 as size_t)
            }
            else
            {
                set *(b + w): (((0xF0 as u32) | (c >> (18 as u32))) as u8)
                set *(b + (w + (1 as size_t))): (((0x80 as u32) | ((c >> (12 as u32)) & (0x3F as u32))) as u8)
                set *(b + (w + (2 as size_t))): (((0x80 as u32) | ((c >> (6 as u32)) & (0x3F as u32))) as u8)
                set *(b + (w + (3 as size_t))): (((0x80 as u32) | (c & (0x3F as u32))) as u8)
                set w: w + (4 as size_t)
            }
            set i: i + (1 as size_t)
        }
        write(fd, b as pointer[void], w)
    }

    function get_n_messages(this: ParserState) returns u32
        n_messages

    function get_n_errors(this: ParserState) returns u32
        n_errors

    ; roll a completed subdoc parse's message/error counts into this (parent)
    ; state. The reference shares ONE messenger across parent + subdocument, so
    ; its global error count — which decides conformance ('C') and the exit
    ; code — sees the subdoc's diagnostics; the subdoc's messages already went
    ; to the shared stderr stream as they were reported.
    function add_subdoc_counts(this: pointer[ParserState], child: pointer[ParserState])
    {
        set this.n_messages: this.n_messages + child.get_n_messages()
        ; the reference error counter is the APP's, shared across the child
        ; parse (SgmlsEventHandler IS the ErrorCountEventHandler); the child
        ; parseAll ignores the cancel (no cancel pointer), so its messages
        ; all print — but once the CUMULATIVE count reaches the limit the
        ; parent's delivery loop stops. Absorbing can jump PAST the limit,
        ; so the crossing check is >=, not the per-message equality.
        let before this.n_errors
        set this.n_errors: this.n_errors + child.get_n_errors()
        if this.error_limit <> (0 as u32)
        {
            if before < this.error_limit
            {
                if this.n_errors >= this.error_limit
                    set this.cancelled: true
            }
        }
    }

    ; ---- self-test --------------------------------------------------------
    function test() returns int
    {
        let anchor StringC("x")
        let host Page.get(anchor.data_ptr() as pointer[void])

        let ps ParserState.make(host, null as pointer[EntityManager], 0 as u32, PHASE_CONTENT)

        ; --- Sd wiring: setSd derives validate/mayDefault (typeValid=true,
        ;     omittag||attributeDefault: reference SGML OMITTAG YES -> true) ---
        let sd host.allocate(sizeof Sd, alignof Sd) as pointer[Sd]
        set *sd: Sd()
        ps.set_sd(sd)
        if ps.validate() = false
            return -1
        if ps.may_default_attribute() = false
            return -2

        ; --- Syntax wiring ---
        let syn Syntax^host(Sd())
        ps.set_syntax(syn)
        if ps.get_syntax() <> syn
            return -3
        if ps.attribute_syntax() <> syn
            return -4

        ; --- phase + tag flags ---
        if ps.get_phase() <> PHASE_NONE
            return -5
        ps.set_phase(PHASE_PROLOG)
        if ps.get_phase() <> PHASE_PROLOG
            return -6
        var st false
        if ps.in_tag(&st)
            return -7
        ps.enter_tag(true)
        if ps.in_tag(&st) = false
            return -8
        if st = false
            return -9
        ps.leave_tag()
        if ps.in_tag(&st)
            return -10

        ; --- input stack + currentLocation through nesting ---
        ; The input sources are pushed into ps (run-page-lived), so origins,
        ; char buffers and sources are region-allocated on host (not the stack).
        let org_a host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org_a: Origin()
        let pca host.allocate((5 as size_t) * (4 as size_t), 4) as pointer[u32]
        set *(pca + (0 as size_t)): (0x68 as u32)
        set *(pca + (1 as size_t)): (0x65 as u32)
        set *(pca + (2 as size_t)): (0x6C as u32)
        set *(pca + (3 as size_t)): (0x6C as u32)
        set *(pca + (4 as size_t)): (0x6F as u32)
        let src_a host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
        set *src_a: InputSource(org_a, pca, 5 as size_t)
        ps.push_input(src_a)
        if ps.get_input_level() <> (1 as u32)
            return -11
        if ps.current_input() <> src_a
            return -12

        ; push B, referenced at A index 2.
        let ref_in_a src_a.current_location(2 as size_t)
        let org_b host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org_b: Origin(ref_in_a)
        let pcb host.allocate((2 as size_t) * (4 as size_t), 4) as pointer[u32]
        set *(pcb + (0 as size_t)): (0x58 as u32)
        set *(pcb + (1 as size_t)): (0x59 as u32)
        let src_b host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
        set *src_b: InputSource(org_b, pcb, 2 as size_t)
        ps.push_input(src_b)
        if ps.get_input_level() <> (2 as u32)
            return -13
        let cl ps.current_location()
        if cl.get_origin() <> org_b
            return -14
        let up cl.parent()
        if up.get_index() <> (2 as u32)
            return -15
        if up.get_origin() <> org_a
            return -16
        ps.pop_input_stack()
        if ps.get_input_level() <> (1 as u32)
            return -17
        if ps.current_input() <> src_a
            return -18

        ; --- scanner mode + recognizer table + getToken + currentToken ---
        if ps.get_current_mode() <> proMode
            return -19
        ps.set_current_mode(econMode)
        if ps.get_current_mode() <> econMode
            return -20

        let table ModeInfo.build_table(host)
        let sdv Sd()
        let synv Syntax^host(sdv)
        let grp Recognizer.build_recognizer(host, grpMode, sdv, synv, table)
        ps.set_recognizer(grpMode, grp)

        let pg host.allocate((3 as size_t) * (4 as size_t), 4) as pointer[u32]
        set *(pg + (0 as size_t)): (0x28 as u32)   ; (
        set *(pg + (1 as size_t)): (0x61 as u32)   ; a
        set *(pg + (2 as size_t)): (0x29 as u32)   ; )
        let org_g host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org_g: Origin()
        let gsrc host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
        set *gsrc: InputSource(org_g, pg, 3 as size_t)
        ps.push_input(gsrc)
        if ps.get_token(grpMode) <> tokenGrpo
            return -21
        let tok ps.current_token()
        if tok.get_size() <> (1 as size_t)
            return -22
        if tok.get(0 as size_t) <> (0x28 as u32)
            return -23
        if ps.get_token(grpMode) <> tokenNameStart
            return -24
        ps.pop_input_stack()

        ; --- normal map ---
        let nm XcharMap.make(host, 0 as u8)
        nm.set_char(0x41 as u32, 1 as u8)
        ps.set_normal_map(nm)
        if ps.get_normal_map().get(0x41 as i32) <> (1 as u8)
            return -25

        ; --- DTD-backed AttributeContext: notation + entity lookup ---
        let dtd Dtd.make(host, StringC("doc"), true)
        let gif Notation.make(host, StringC("gif"), StringC("doc"), true)
        dtd.insert_notation(gif)
        let ent host.allocate(sizeof Entity, alignof Entity) as pointer[Entity]
        set *ent: Entity.Internal(InternalEntity(StringC("amp"), StringC("&"), DT_SGML))
        dtd.insert_entity(ent, false, false)

        if ps.have_current_dtd()
            return -26
        ps.set_current_dtd(dtd)
        if ps.have_current_dtd() = false
            return -27
        if ps.get_attribute_notation(StringC("gif"), Location()) <> gif
            return -28
        if ps.get_attribute_notation(StringC("nope"), Location()) <> null
            return -29
        if ps.get_attribute_entity(StringC("amp"), Location()) <> ent
            return -30

        ; --- id table: defineId / noteIdref ---
        var prev Location()
        ; outside an instance -> IDs untracked (defineId returns true).
        if ps.define_id(StringC("a"), Location(), &prev) = false
            return -31
        ps.set_in_instance(true)
        ; loc1/loc2 below are stored into the id table via define_id, so the
        ; origin/buffer/source outlive this frame -> region-allocate on host.
        let org_i host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org_i: Origin()
        let ib host.allocate((1 as size_t) * (4 as size_t), 4) as pointer[u32]
        set *ib: (0x41 as u32)
        let isrc host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
        set *isrc: InputSource(org_i, ib, 1 as size_t)
        let loc1 isrc.current_location(1 as size_t)
        if ps.define_id(StringC("x"), loc1, &prev) = false
            return -32
        ; duplicate define fails and reports the previous location.
        let loc2 isrc.current_location(5 as size_t)
        if ps.define_id(StringC("x"), loc2, &prev)
            return -33
        if prev.get_index() <> (1 as u32)
            return -34

        ; --- current-attribute store round-trip ---
        ps.resize_current_attributes(3 as size_t)
        if ps.get_current_attribute(1 as size_t) <> null
            return -35
        let av AttributeValue.make_implied(host)
        ps.note_current_attribute(1 as size_t, av)
        if ps.get_current_attribute(1 as size_t) <> av
            return -36

        ; --- messenger: dispatch bumps message + error counters ---
        if ps.get_n_messages() <> (0 as u32)
            return -37
        ps.message(MessageType(MessageFragment(1 as u32, StringC("info")), Severity.Info))
        ps.message(MessageType(MessageFragment(2 as u32, StringC("boom")), Severity.Error))
        if ps.get_n_messages() <> (2 as u32)
            return -38
        if ps.get_n_errors() <> (1 as u32)
            return -39

        ; --- dtd stack + instantiateDtd ---
        ps.push_dtd(dtd)
        if ps.had_dtd() = false
            return -40
        if ps.lookup_dtd(StringC("doc")) <> dtd
            return -41
        if ps.lookup_dtd(StringC("zzz")) <> null
            return -42
        let r1 ps.instantiate_dtd(dtd)
        if dtd.get_is_instantiated() = false
            return -43
        if r1 <> (1 as u32)
            return -44
        if ps.get_instantiated_dtds() <> (1 as u32)
            return -45
        if ps.base_dtd() <> dtd
            return -46
        ; end_dtd moves the defined DTD onto the list and clears def/current.
        let dtd2 Dtd.make(host, StringC("aux"), false)
        ps.set_def_dtd(dtd2)
        ps.set_current_dtd(dtd2)
        ps.end_dtd()
        if ps.n_dtds() <> (2 as size_t)
            return -47
        if ps.dtd_at(1 as size_t) <> dtd2
            return -48
        if ps.get_def_dtd() <> null
            return -49
        if ps.get_current_dtd() <> null
            return -50
        if ps.base_dtd() <> dtd
            return -51

        0
    }
}
