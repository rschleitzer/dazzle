use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.ISet.ISet

; Partition — the character equivalence-code map (Partition.cs). The scanner
; never indexes its trie by raw character (that would need a 2^16+ wide array);
; instead every char that behaves identically to the lexer collapses to one
; EquivCode. Partition computes the coarsest such classification consistent
; with (a) each specific delimiter/function char being distinguishable and
; (b) each required character SET being a union of whole classes.
;
; SCOPE: C++ starts with ONE class spanning 0..charMax (0x10FFFF) and refines it,
; so EVERY char — including a wide one — lands in a real class and only the
; end-of-entity sentinel keeps code 0. Refining a 0x110000-wide table per mode
; would be far too slow here, so this port classifies the 256 8-bit chars
; INDIVIDUALLY plus ONE extra slot (index 256, `HIGH_SLOT`) standing for every
; char >= 256.
;
; That single slot is exact, not an approximation: no delimiter, function char or
; character set of the reference/XML syntax as this port models it reaches beyond
; 0xFF except sgmlChar (the document character set, which runs to U+FFFD), so all
; chars >= 256 have identical membership everywhere and C++ would put them in one
; class anyway. Membership of the slot is probed with CHAR_HIGH_REP rather than
; special-cased, so the slot simply falls into the "in sgmlChar, in nothing else,
; not a delimiter" class — the undistinguished-DATA class, shared with e.g. 0xFC.
; Getting a NONZERO code here is what stops a decoded U+FFFD from being read as
; the eE sentinel (code 0) and truncating the content.
;
; KNOWN GAP (pre-existing, orthogonal): XML's NAMESTRT reaches past 0xFF (192-214,
; ...); this port's Syntax hardcodes A-Za-z, so a wide char is never a name char.
; Wide chars in NAMES would need a real wide partition, not just this slot.
;
; The equivalence CODE integers are internal labels — any correct refinement
; produces identical tokenization — so this port uses an O(257) class-id
; refinement (a `class_of[257]` table split by a distinguisher each round)
; rather than C++'s interval-list `EquivClass` machinery; the observable
; result (map + per-set code lists) is the same. Delimiter namecase folding is
; not applied: delimiters match as spelled (the corpus uses canonical spelling).

; The classification domain: the 256 8-bit chars + one slot for all chars >= 256.
define N_CHAR8: size_t 256
define HIGH_SLOT: size_t 256
define PART_DOMAIN: size_t 257

; The representative char used to probe set membership for HIGH_SLOT. U+FFFD is
; the char the UTF-8 decoder produces for every undecodable byte, and the only
; Char >= 256 the corpus yields; every set that contains it contains the whole
; high range (sgmlChar), so probing with it classifies the slot correctly.
define CHAR_HIGH_REP: u32 0xFFFD

define Partition
(
    class_of: pointer[u16]              ; class id per domain slot (0..256)
    n_classes: u16                      ; number of classes; codes are class+1
    n_sets: int                         ; number of input sets
    set_codes: pointer[pointer[Array[u16]]]  ; per used-set: the EquivCodes in it
)
{
    ; chars = specific chars to distinguish; sets = the n_sets char sets (used
    ; positions), each a pointer[ISet].
    ; chars is BY VALUE (const ISet<Char>& in C++). A `pointer[ISet]` param
    ; here fails init overload resolution against an ISet-value arg (from
    ; `ISet^host()`), so the construction silently field-fills instead of
    ; calling init — class_of/set_codes end up null → SEGV. Keep it a value.
    init(chars: ISet, sets: pointer[pointer[ISet]], n_sets: int)
    {
        let host Page.get(this as pointer[void])
        set this.n_sets: n_sets
        set class_of: host.allocate(PART_DOMAIN * (2 as size_t), 2) as pointer[u16]

        ; in_sets[class] = bitmask of the input-set positions this class lies in
        var in_sets: pointer[u32] host.allocate(PART_DOMAIN * (4 as size_t), 4) as pointer[u32]
        var dist: pointer[u8] host.allocate(PART_DOMAIN, 1) as pointer[u8]

        ; one class over the whole domain (the 8-bit chars + the high slot)
        var c: size_t 0
        while c < PART_DOMAIN
        {
            set *(class_of + c): 0
            set c: c + 1
        }
        set *(in_sets + (0 as size_t)): 0
        set n_classes: 1

        ; refine so each specific char is its own class (set_flag 0). The
        ; distinguished chars are delimiter/function chars — all ASCII, so the
        ; ranges are tiny, ch never approaches u32 wraparound, and HIGH_SLOT is
        ; never singled out (no wide char is a delimiter).
        var ci: size_t 0
        while ci < chars.get_count()
        {
            var ch chars.range_min(ci)
            let hi chars.range_max(ci)
            while ch <= hi
            {
                var k: size_t 0
                while k < PART_DOMAIN
                {
                    set *(dist + k): 0
                    set k: k + 1
                }
                if ch < (N_CHAR8 as u32)
                    set *(dist + (ch as size_t)): 1
                resplit(dist, in_sets, 0)
                set ch: ch + 1
            }
            set ci: ci + 1
        }

        ; refine by each set's membership, tagging the in-part with 1<<i. The
        ; high slot is probed with CHAR_HIGH_REP (see the header).
        var i: int 0
        while i < n_sets
        {
            let s *(sets + (i as size_t))
            var k: size_t 0
            while k < N_CHAR8
            {
                if s.contains(k as u32)
                    set *(dist + k): 1
                else
                    set *(dist + k): 0
                set k: k + 1
            }
            if s.contains(CHAR_HIGH_REP)
                set *(dist + HIGH_SLOT): 1
            else
                set *(dist + HIGH_SLOT): 0
            resplit(dist, in_sets, (1 as u32) << (i as u32))
            set i: i + 1
        }

        ; build the per-set code lists
        set set_codes: host.allocate((n_sets as size_t) * (sizeof pointer[void]), alignof pointer[void]) as pointer[pointer[Array[u16]]]
        set i: 0
        while i < n_sets
        {
            let arr Array[u16]^host()
            var cls: u16 0
            while cls < n_classes
            {
                if ((*(in_sets + (cls as size_t)) >> (i as u32)) & (1 as u32)) <> 0
                    arr.add(cls + (1 as u16))
                set cls: cls + 1
            }
            set *(set_codes + (i as size_t)): arr
            set i: i + 1
        }
    }

    ; Split every class by `dist` (a 0/1 flag per char): chars with the same
    ; (old class, dist bit) stay together; the dist-1 part of each class gains
    ; `set_flag` in its membership mask.
    function resplit(this: Partition, dist: pointer[u8], in_sets: pointer[u32], set_flag: u32)
    {
        let host Page.get(this as pointer[void])
        let old_n n_classes
        ; keymap is int (i64), not i32: it holds a -1 sentinel and is tested
        ; `< 0`. A narrow signed slot read then widened for the compare is
        ; zero-extended (i32 -1 → 4294967295), so `< 0` never fires and the
        ; refinement collapses every char to one class. Keep it i64.
        let keymap host.allocate(((old_n as size_t) * (2 as size_t)) * (8 as size_t), 8) as pointer[int]
        let new_in host.allocate(PART_DOMAIN * (4 as size_t), 4) as pointer[u32]
        let new_class host.allocate(PART_DOMAIN * (2 as size_t), 2) as pointer[u16]

        var k: size_t 0
        while k < ((old_n as size_t) * (2 as size_t))
        {
            set *(keymap + k): -1
            set k: k + 1
        }

        var n_new: u16 0
        var c: size_t 0
        while c < PART_DOMAIN
        {
            let d *(dist + c) as size_t
            let key ((*(class_of + c)) as size_t) * (2 as size_t) + d
            if *(keymap + key) < 0
            {
                set *(keymap + key): n_new as int
                var flags *(in_sets + ((*(class_of + c)) as size_t))
                if d = 1
                    set flags: flags | set_flag
                set *(new_in + (n_new as size_t)): flags
                set n_new: n_new + 1
            }
            set *(new_class + c): *(keymap + key) as u16
            set c: c + 1
        }

        set c: 0
        while c < PART_DOMAIN
        {
            set *(class_of + c): *(new_class + c)
            set c: c + 1
        }
        set c: 0
        while c < (n_new as size_t)
        {
            set *(in_sets + c): *(new_in + c)
            set c: c + 1
        }
        set n_classes: n_new
    }

    function max_code(this: Partition) returns u16
        n_classes

    ; EquivCode of a Char. Chars >= 256 share HIGH_SLOT's class — the
    ; undistinguished-DATA class, NOT code 0: code 0 is the eE sentinel alone
    ; (C++ classifies every char up to charMax, so no real char ever gets it),
    ; and handing a decoded U+FFFD the eE code would end the entity mid-content.
    function char_code(this: Partition, c: u32) returns u16
    {
        if c >= (N_CHAR8 as u32)
            return *(class_of + HIGH_SLOT) + (1 as u16)

        *(class_of + (c as size_t)) + (1 as u16)
    }

    ; EquivCode of an Xchar: the end-of-entity sentinel (< 0) is code 0.
    function code_of_xchar(this: Partition, x: i32) returns u16
    {
        if x < 0
            return (0 as u16)

        char_code(x as u32)
    }

    function ee_code(this: Partition) returns u16
        (0 as u16)

    ; set_codes is pointer[pointer[Array[u16]]]; `*(set_codes+pos)` must be
    ; LOADED to a local pointer before a method call — a `(*(pp)).method()`
    ; receiver where pp is pointer[pointer[T]] otherwise passes &pp[pos]
    ; (the slot address) as `this` instead of the stored Array* (SEGV).
    function set_code_count(this: Partition, pos: int) returns size_t
    {
        let arr *(set_codes + (pos as size_t))
        arr.get_length()
    }

    function set_code(this: Partition, pos: int, k: size_t) returns u16
    {
        let arr *(set_codes + (pos as size_t))
        *(arr.get_buffer() + k)
    }

    function set_codes_buffer(this: Partition, pos: int) returns pointer[u16]
    {
        let arr *(set_codes + (pos as size_t))
        arr.get_buffer()
    }

    function test() returns int
    {
        let anchor StringC("x")
        let host Page.get(anchor.data_ptr() as pointer[void])

        ; distinguish '<' and '>'; set 0 = {A..Z} (a name-start-like set)
        let chars ISet^host()
        chars.add(0x3C)   ; '<'
        chars.add(0x3E)   ; '>'

        let letters ISet^host()
        letters.add_range(0x41, 0x5A)   ; A..Z

        let sets host.allocate(1 * (sizeof pointer[void]), alignof pointer[void]) as pointer[pointer[ISet]]
        set *(sets + (0 as size_t)): letters

        let p Partition^host(chars, sets, 1)

        ; '<' and '>' must be distinct codes, both nonzero
        let lt p.char_code(0x3C)
        let gt p.char_code(0x3E)
        if lt = 0
            return -1
        if gt = 0
            return -2
        if lt = gt
            return -3

        ; all letters share ONE code (indistinguishable), != '<','>'
        let ca p.char_code(0x41)
        let cz p.char_code(0x5A)
        if ca <> cz
            return -4
        if (ca = lt) or (ca = gt)
            return -5

        ; that shared code is exactly the one listed in set 0
        if p.set_code_count(0) <> 1
            return -6
        if p.set_code(0, 0) <> ca
            return -7

        ; ONLY the eE sentinel is code 0
        if p.code_of_xchar(-1) <> 0
            return -8

        ; a char in no set and not distinguished shares the "everything else"
        ; class, distinct from letters and the delimiters
        let other p.char_code(0x20)   ; space (not in letters, not '<'/'>')
        if (other = lt) or (other = gt) or (other = ca)
            return -9

        ; a char >= 256 is NEVER the eE code: it is undistinguished data, so it
        ; shares the "everything else" class here (letters is the only set, and
        ; it holds no wide char). This is what keeps a decoded U+FFFD a data char.
        let hi_code p.char_code(0x1000)
        if hi_code = 0
            return -10
        if hi_code <> other
            return -11
        if p.char_code(CHAR_HIGH_REP) <> other
            return -12

        ; a wide char that IS in a set joins that set's class instead
        let wide ISet^host()
        wide.add_range(0x41, 0x5A)     ; A..Z
        wide.add_range(0x100, 0xFFFD)  ; the whole high range
        let sets2 host.allocate(1 * (sizeof pointer[void]), alignof pointer[void]) as pointer[pointer[ISet]]
        set *(sets2 + (0 as size_t)): wide
        let p2 Partition^host(chars, sets2, 1)
        ; the high slot is in the set, so its code is listed in set 0 ...
        let hc p2.char_code(CHAR_HIGH_REP)
        if hc = 0
            return -13
        ; ... and it is NOT the class of a char outside the set (space)
        if hc = p2.char_code(0x20)
            return -14

        0
    }
}
