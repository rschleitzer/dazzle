use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.ISet.ISet

; CharsetDecl — the CHARSET section of an SGML declaration (CharsetDecl.h /
; CharsetDecl.cxx): sections (one per BASESET, carrying the baseset's public
; id) of DESCSET ranges, each range mapping `count` document character numbers
; from `desc_min` onto base-set numbers from `base_min` (type number), onto a
; minimum-literal description (type string), or declaring them UNUSED.
;
; The declared set (charDeclared) counts EVERY range type INCLUDING UNUSED
; (CharsetDecl::addRange feeds declaredSet_ for all three variants): an UNUSED
; char ref is a DECLARED non-SGML character (silently dropped by content /
; CDATA-attribute contexts), NOT a characterNumber error. Do not "simplify"
; UNUSED out of the declared set.
;
; UnivCharsetDesc is the document-charset desc->univ mapping the reference
; builds from DESCSET x baseset (sdParseDocumentCharset -> desc.addBaseRange,
; parseSd.cxx:814). Reduced here to the number-range walk: the registrations
; the port covers (CharsetRegistry.cxx) are all IDENTITY maps into ISO 10646 —
;   ISO646_ASCII_G0 {0,128,0} (ESC 2/5 4/0, 2/8 4/0, 2/8 4/2)
;   ISO646_C0       {0,32,0} {127,1,127} (ESC 2/1 4/0)
;   ISO10646_UCS2   {0,65536,0} (ESC 2/5 2/15 4/0|4/3|4/5)
;   ISO10646_UCS4   {0,0x80000000,0} (ESC 2/5 2/15 4/1|4/4|4/6)
; — so univ = base number wherever the baseset covers it. Any other
; registration (8859-x, JIS, KSC, ...) is UNKNOWN: its number ranges stay out
; of the desc, so under SP_CHARSET_FIXED a char ref into them reports
; numericCharRefUnknownBase; in the default mode (the internal charset IS the
; document charset) the desc is never consulted at all.

; charMax (include/constant.h:12) — the top of SP's internal Char range under
; SP_MULTI_BYTE. A CONSTANT, not a charset-derived value: the numeric-char-ref
; digit fold guards against it, and the implied document charset declares
; exactly [0, CHAR_MAX]. Out-of-charset numbers BELOW it are caught by
; charDeclared, not by this cap.
define CHAR_MAX: u32 1114111

; The fixed-mode INTERNAL (system) charset bound: CodingSystemKit::make builds
; the system charset from iso10646Desc = { ISO10646_UCS2, 0 } — identity over
; 0..0xFFFF ("SP only supports 16-bit characters", CodingSystemKit.cxx:136).
; univToDesc into it succeeds iff univ <= this bound (verified vs onsgmls
; 1.5.2: &#65535; converts, &#65536; reports numericCharRefNoInternal).
define INTERNAL_CHAR_MAX: u32 65535

define CHARSET_RANGE_NUMBER: int 0
define CHARSET_RANGE_STRING: int 1
define CHARSET_RANGE_UNUSED: int 2

; The identity registrations covered (CharsetRegistry::ISORegistrationNumber).
define BASESET_UNKNOWN: int 0
define BASESET_ASCII: int 1
define BASESET_C0: int 2
define BASESET_UCS2: int 3
define BASESET_UCS4: int 4

; One DESCSET row (CharsetDeclRange). `section` indexes the owning BASESET's
; public id in CharsetDecl.section_ids (the reference nests ranges inside
; CharsetDeclSection; a flat list in declaration order walks identically).
define CharsetDeclRange (desc_min: u32, count: u32, base_min: u32, range_type: int, str: StringC, section: size_t)
{
    init(desc_min: u32, count: u32, base_min: u32, range_type: int, str: StringC, section: size_t)
    {
        set this.desc_min: desc_min
        set this.count: count
        set this.base_min: base_min
        set this.range_type: range_type
        set this.str: str
        set this.section: section
    }
}

; Page-hosted (construct via CharsetDecl^host()) — init resolves its arena
; page from `this`, like ISet.
define CharsetDecl (section_ids: ref[Array[StringC]], section_desigs: ref[Array[StringC]], ranges: ref[Array[CharsetDeclRange]], declared: ref[ISet])
{
    init()
    {
        let host Page.get(this)
        set section_ids: Array[StringC]^host()
        set section_desigs: Array[StringC]^host()
        set ranges: Array[CharsetDeclRange]^host()
        set declared: ISet^host()
    }

    function add_section(this: CharsetDecl, id: StringC)
    {
        section_ids.add(id)
        section_desigs.add(StringC())
    }

    ; add_section with the baseset's ISO designating sequence (empty when the
    ; id is not an ISO CHARSET-class FPI) — numberToChar treats two ISO sets
    ; with equal designating sequences as the same set (CharsetDecl.cxx:130).
    function add_section(this: CharsetDecl, id: StringC, desig: StringC)
    {
        section_ids.add(id)
        section_desigs.add(desig)
    }

    function section_desig(this: CharsetDecl, i: size_t) returns StringC
        section_desigs[i]

    function declared_set(this: CharsetDecl) returns ref[ISet]
        declared

    ; CharsetDeclRange::usedSet — desc spans of every non-UNUSED range,
    ; clipped at charMax.
    function used_set(this: CharsetDecl, out_set: ref[ISet])
    {
        var i: size_t 0
        let n ranges.get_length()
        while i < n
        {
            let r ranges.get_buffer() + i
            if (r.range_type <> CHARSET_RANGE_UNUSED) and (r.count > 0) and (r.desc_min <= CHAR_MAX)
            {
                var mx r.desc_min + (r.count - (1 as u32))
                if (CHAR_MAX - r.desc_min) < (r.count - (1 as u32))
                    set mx: CHAR_MAX
                out_set.add_range(r.desc_min, mx)
            }
            set i: i + 1
        }
    }

    ; CharsetDeclRange::rangeDeclared — the overlap of [min, min+count) with
    ; every already-declared range (the multiply-declared collector).
    function range_declared(this: CharsetDecl, min: u32, count: u32, out_set: ref[ISet])
    {
        if count = 0
            return
        var i: size_t 0
        let n ranges.get_length()
        while i < n
        {
            let r ranges.get_buffer() + i
            if (r.count > 0) and ((min + count) > r.desc_min) and (min < (r.desc_min + r.count))
            {
                var comm_min r.desc_min
                if min > comm_min
                    set comm_min: min
                var comm_max min + (count - (1 as u32))
                let rmax r.desc_min + (r.count - (1 as u32))
                if rmax < comm_max
                    set comm_max: rmax
                out_set.add_range(comm_min, comm_max)
            }
            set i: i + 1
        }
    }

    ; CharsetDeclRange::stringToChar — desc spans of string rows with this text.
    function string_to_char(this: CharsetDecl, str: StringC, out_set: ref[ISet])
    {
        var i: size_t 0
        let n ranges.get_length()
        while i < n
        {
            let r ranges.get_buffer() + i
            if (r.range_type = CHARSET_RANGE_STRING) and (r.count > 0)
            {
                if r.str.equals(str)
                    out_set.add_range(r.desc_min, r.desc_min + (r.count - (1 as u32)))
            }
            set i: i + 1
        }
    }

    ; CharsetDeclSection::numberToChar — base number n of the section whose
    ; baseset matches (same public id, or two ISO sets with equal designating
    ; sequences) mapped to its desc chars; out_count = the smallest contiguous
    ; run among the matches.
    function number_to_char(this: CharsetDecl, id: StringC, desig: StringC, n: u32, out_set: ref[ISet], out_count: ref[u32])
    {
        var i: size_t 0
        let nr ranges.get_length()
        while i < nr
        {
            let r ranges.get_buffer() + i
            var sec_match false
            let sid section_ids[r.section]
            if sid.equals(id)
                set sec_match: true
            else
            {
                let sdg section_desigs[r.section]
                if (sdg.get_size() > 0) and (desig.get_size() > 0)
                {
                    if sdg.equals(desig)
                        set sec_match: true
                }
            }
            if sec_match and (r.range_type = CHARSET_RANGE_NUMBER)
            {
                if (n >= r.base_min) and ((n - r.base_min) < r.count)
                {
                    let this_count r.count - (n - r.base_min)
                    if out_set.is_empty() or (this_count < out_count)
                        set out_count: this_count
                    out_set.add(r.desc_min + (n - r.base_min))
                }
            }
            set i: i + 1
        }
    }

    function section_count(this: CharsetDecl) returns size_t
        section_ids.get_length()

    function range_count(this: CharsetDecl) returns size_t
        ranges.get_length()

    function section_pubid(this: CharsetDecl, i: size_t) returns StringC
        section_ids[i]

    ; addRange (CharsetDecl.cxx): every variant — number, string, UNUSED —
    ; records [min, min+count) in the declared set.
    function add_range_number(this: CharsetDecl, min: u32, count: u32, base_min: u32)
    {
        if count > 0
            declared.add_range(min, min + count - (1 as u32))
        let sec section_ids.get_length() - 1
        ranges.add(CharsetDeclRange(min, count, base_min, CHARSET_RANGE_NUMBER, StringC(), sec))
    }

    function add_range_unused(this: CharsetDecl, min: u32, count: u32)
    {
        if count > 0
            declared.add_range(min, min + count - (1 as u32))
        let sec section_ids.get_length() - 1
        ranges.add(CharsetDeclRange(min, count, 0, CHARSET_RANGE_UNUSED, StringC(), sec))
    }

    function add_range_string(this: CharsetDecl, min: u32, count: u32, str: StringC)
    {
        if count > 0
            declared.add_range(min, min + count - (1 as u32))
        let sec section_ids.get_length() - 1
        ranges.add(CharsetDeclRange(min, count, 0, CHARSET_RANGE_STRING, str, sec))
    }

    ; charDeclared (CharsetDecl.h:133) — declaredSet_.contains.
    function char_declared(this: CharsetDecl, c: u32) returns bool
        declared.contains(c)

    ; getCharInfo (CharsetDecl.cxx): the first range containing c, sections in
    ; declaration order. Returns null when no range covers c (the reference's
    ; CANNOT_HAPPEN after a passed charDeclared).
    function find_range(this: CharsetDecl, c: u32) returns ref[CharsetDeclRange]?
    {
        var i: size_t 0
        let n ranges.get_length()
        while i < n
        {
            let r ranges.get_buffer() + i
            if (c >= r.desc_min) and ((c - r.desc_min) < r.count)
                return r
            set i: i + 1
        }
        null
    }

    ; The IMPLIED docCharsetDecl (Parser.cxx:46-52, document parse with no SGML
    ; declaration): ONE section with an EMPTY public id + ONE base range
    ; addRange(0, charMax+1, 0) — which is why the no-declaration fixed-mode
    ; diagnostic reads `... from baseset "" unknown`.
    function make_implied(host: ref[Page]) returns ref[CharsetDecl]
    {
        let decl CharsetDecl^host()
        decl.add_section(StringC())
        decl.add_range_number(0, CHAR_MAX + (1 as u32), 0)
        decl
    }

    function test() returns int
    {
        let anchor StringC("x")
        let r Page.get(anchor.data_ptr())

        ; the corpus xml.dcl shape: UNUSED head rows + identity body capped at
        ; 65535 (the "SP only supports 16-bit characters" DESCSET).
        let decl CharsetDecl^r()
        let sid StringC^r("dummy-ucs4-id")
        decl.add_section(sid)
        decl.add_range_unused(0, 9)
        decl.add_range_number(9, 2, 9)
        decl.add_range_number(160, 65374, 160)
        decl.add_range_unused(65534, 2)
        ; UNUSED counts as declared (an UNUSED ref drops silently, it does NOT
        ; report characterNumber)
        if decl.char_declared(0) = false
            return -1
        if decl.char_declared(65535) = false
            return -2
        if decl.char_declared(65536)
            return -3
        if decl.char_declared(100)
            return -4
        let ru decl.find_range(4)
        if ru = null
            return -5
        if ru.range_type <> CHARSET_RANGE_UNUSED
            return -6
        let rn decl.find_range(200)
        if rn = null
            return -7
        if rn.range_type <> CHARSET_RANGE_NUMBER
            return -8
        if (rn.base_min + ((200 as u32) - rn.desc_min)) <> 200
            return -9
        if decl.find_range(70000) <> null
            return -10

        ; the implied declaration: everything in [0, charMax] declared as a
        ; number range of the empty-pubid section
        let imp CharsetDecl.make_implied(r)
        if imp.char_declared(CHAR_MAX) = false
            return -11
        if imp.char_declared(CHAR_MAX + (1 as u32))
            return -12
        let ri imp.find_range(65536)
        if ri = null
            return -13
        if (ri.base_min + ((65536 as u32) - ri.desc_min)) <> 65536
            return -14
        let pid imp.section_pubid(ri.section)
        if pid.get_size() <> 0
            return -15

        ; desc: a full-range UCS-4 mapping (the scaly.dcl shape) + clipping
        let desc UnivCharsetDesc^r()
        desc.add_base_range(BASESET_UCS4, 65536, 1048576, 65536)
        var univ: u32 0
        if desc.desc_to_univ(70000, &univ) = false
            return -16
        if univ <> 70000
            return -17
        if desc.desc_to_univ(127, &univ)
            return -18
        ; ASCII G0 covers base numbers 0..127 only: a row reaching past 128
        ; is clipped (the reference's baseMissing)
        let desc2 UnivCharsetDesc^r()
        desc2.add_base_range(BASESET_ASCII, 0, 256, 0)
        if desc2.desc_to_univ(127, &univ) = false
            return -19
        if univ <> 127
            return -20
        if desc2.desc_to_univ(128, &univ)
            return -21
        ; the system (implied/fixed internal) charset: identity 0..0xFFFF
        let sys UnivCharsetDesc.make_system(r)
        if sys.desc_to_univ(65535, &univ) = false
            return -22
        if univ <> 65535
            return -23
        if sys.desc_to_univ(65536, &univ)
            return -24

        0
    }
}

; One desc->univ range. `is_const` models the minimum-literal DESCSET rows
; (parseSd.cxx:988): every char of the row maps to the SAME univ char (the
; named char's nameToUniv slot), unlike number rows which map linearly.
define UnivDescRange (desc_min: u32, count: u32, univ_min: u32, is_const: bool)
{
    init(desc_min: u32, count: u32, univ_min: u32, is_const: bool)
    {
        set this.desc_min: desc_min
        set this.count: count
        set this.univ_min: univ_min
        set this.is_const: is_const
    }
}

; The document charset's desc->univ mapping (UnivCharsetDesc / CharsetInfo,
; reduced — see the header comment). Page-hosted (UnivCharsetDesc^host()).
define UnivCharsetDesc (ranges: ref[Array[UnivDescRange]])
{
    init()
    {
        let host Page.get(this)
        set ranges: Array[UnivDescRange]^host()
    }

    function add_range(this: UnivCharsetDesc, desc_min: u32, count: u32, univ_min: u32, is_const: bool)
    {
        if count > 0
            ranges.add(UnivDescRange(desc_min, count, univ_min, is_const))
    }

    ; UnivCharsetDesc::addBaseRange, identity-baseset form: clip the base-number
    ; run [base_min, base_min+count) against the registration's covered ranges;
    ; covered sub-runs map identically (univ = base number). Base numbers the
    ; registration does not cover stay unmapped — the reference collects them
    ; as baseMissing (a warnSgmlDecl-only warning, not ported). An UNKNOWN
    ; registration covers nothing.
    function add_base_range(this: UnivCharsetDesc, baseset: int, desc_min: u32, count: u32, base_min: u32)
    {
        if baseset = BASESET_ASCII
            this.add_clipped(desc_min, count, base_min, 0, 128)
        else if baseset = BASESET_C0
        {
            this.add_clipped(desc_min, count, base_min, 0, 32)
            this.add_clipped(desc_min, count, base_min, 127, 1)
        }
        else if baseset = BASESET_UCS2
            this.add_clipped(desc_min, count, base_min, 0, 65536)
        else if baseset = BASESET_UCS4
            this.add_clipped(desc_min, count, base_min, 0, 0x80000000)
    }

    ; add the part of the row whose base numbers fall inside [b_min, b_min+b_count)
    function add_clipped(this: UnivCharsetDesc, desc_min: u32, count: u32, base_min: u32, b_min: u32, b_count: u32)
    {
        if count = 0
            return
        var lo base_min
        if b_min > lo
            set lo: b_min
        var hi base_min + count
        let bhi b_min + b_count
        if bhi < hi
            set hi: bhi
        if lo >= hi
            return
        this.add_range(desc_min + (lo - base_min), hi - lo, lo, false)
    }

    ; descToUniv (UnivCharsetDesc.h:93, first-match walk).
    function desc_to_univ(this: UnivCharsetDesc, c: u32, out_univ: ref[u32]) returns bool
    {
        var i: size_t 0
        let n ranges.get_length()
        while i < n
        {
            let r ranges.get_buffer() + i
            if (c >= r.desc_min) and ((c - r.desc_min) < r.count)
            {
                if r.is_const
                    set out_univ: r.univ_min
                else
                    set out_univ: r.univ_min + (c - r.desc_min)
                return true
            }
            set i: i + 1
        }
        false
    }

    ; The system charset as a doc-charset mapping (Sd.cxx ctor:
    ; docCharset_(entityManager->charset())) — what descToUniv consults when no
    ; SGML declaration provided a CHARSET section: identity over 0..0xFFFF.
    function make_system(host: ref[Page]) returns ref[UnivCharsetDesc]
    {
        let desc UnivCharsetDesc^host()
        desc.add_range(0, INTERNAL_CHAR_MAX + (1 as u32), 0, false)
        desc
    }

    ; the identity syntax-reference charset setStandardSyntax uses
    ; (parseSd.cxx:279: { 0, 128, 0 }).
    function make_identity128(host: ref[Page]) returns ref[UnivCharsetDesc]
    {
        let desc UnivCharsetDesc^host()
        desc.add_range(0, 128, 0, false)
        desc
    }

    ; descToUniv(from, to, alsoMax): alsoMax = the last char that maps
    ; contiguously in the same range (or, on a miss, the last char before the
    ; next mapped range).
    function desc_to_univ_also_max(this: UnivCharsetDesc, c: u32, out_univ: ref[u32], out_also_max: ref[u32]) returns bool
    {
        var i: size_t 0
        let n ranges.get_length()
        var next_min: u32 0xFFFFFFFF
        while i < n
        {
            let r ranges.get_buffer() + i
            if (c >= r.desc_min) and ((c - r.desc_min) < r.count)
            {
                if r.is_const
                {
                    set out_univ: r.univ_min
                    set out_also_max: c
                }
                else
                {
                    set out_univ: r.univ_min + (c - r.desc_min)
                    set out_also_max: r.desc_min + (r.count - (1 as u32))
                }
                return true
            }
            if (r.desc_min > c) and (r.desc_min < next_min)
                set next_min: r.desc_min
            set i: i + 1
        }
        if next_min = 0xFFFFFFFF
            set out_also_max: 0xFFFFFFFF
        else
            set out_also_max: next_min - (1 as u32)
        false
    }

    ; univToDesc: the desc chars mapping to `univ`. Returns the number of
    ; matches; *out_c/*out_count describe the FIRST match (count = contiguous
    ; run length); every match lands in out_set when non-null.
    function univ_to_desc(this: UnivCharsetDesc, univ: u32, out_c: ref[u32], out_count: ref[u32], out_set: ref[ISet]?) returns u32
    {
        var matches: u32 0
        var i: size_t 0
        let n ranges.get_length()
        while i < n
        {
            let r ranges.get_buffer() + i
            if r.is_const
            {
                if univ = r.univ_min
                {
                    if matches = 0
                    {
                        set out_c: r.desc_min
                        set out_count: 1
                    }
                    if out_set <> null
                        out_set.add_range(r.desc_min, r.desc_min + (r.count - (1 as u32)))
                    set matches: matches + r.count
                }
            }
            else
            {
                if (univ >= r.univ_min) and ((univ - r.univ_min) < r.count)
                {
                    let dc r.desc_min + (univ - r.univ_min)
                    if matches = 0
                    {
                        set out_c: dc
                        set out_count: r.count - (univ - r.univ_min)
                    }
                    if out_set <> null
                        out_set.add(dc)
                    set matches: matches + (1 as u32)
                }
            }
            set i: i + 1
        }
        matches
    }

    function range_count(this: UnivCharsetDesc) returns size_t
        ranges.get_length()

    ; range i decomposed (the ISO 646 identity walk in sdParseCharset).
    function range_at2(this: UnivCharsetDesc, i: size_t, out_min: ref[u32], out_count: ref[u32], out_univ: ref[u32])
    {
        let r ranges.get_buffer() + i
        set out_min: r.desc_min
        set out_count: r.count
        set out_univ: r.univ_min
    }

    ; CharsetInfo::getDescSet — every mapped desc char.
    function get_desc_set(this: UnivCharsetDesc, out_set: ref[ISet])
    {
        var i: size_t 0
        let n ranges.get_length()
        while i < n
        {
            let r ranges.get_buffer() + i
            if r.count > 0
                out_set.add_range(r.desc_min, r.desc_min + (r.count - (1 as u32)))
            set i: i + 1
        }
    }

    ; UnivCharsetDesc::addBaseRange (the full form): base positions
    ; [basenum, basenum+count) of the REGISTERED set `base` map doc chars
    ; [dmin, dmin+count) through the registration's position->univ ranges;
    ; uncovered base positions land in out_missing.
    function add_base_desc_range(this: UnivCharsetDesc, base: ref[UnivCharsetDesc], dmin: u32, count: u32, basenum: u32, out_missing: ref[ISet])
    {
        if count = 0
            return
        let own_page Page.get(ranges)
        let covered ISet^own_page()
        var i: size_t 0
        let n base.ranges.get_length()
        while i < n
        {
            let r base.ranges.get_buffer() + i
            if r.count > 0
            {
                ; intersect [basenum, basenum+count) with the base range
                var lo basenum
                if r.desc_min > lo
                    set lo: r.desc_min
                var hi basenum + count
                let rhi r.desc_min + r.count
                if rhi < hi
                    set hi: rhi
                if lo < hi
                {
                    this.add_range(dmin + (lo - basenum), hi - lo, r.univ_min + (lo - r.desc_min), false)
                    covered.add_range(lo, hi - (1 as u32))
                }
            }
            set i: i + 1
        }
        ; gaps of [basenum, basenum+count) not covered by any base range
        var pos basenum
        let lim basenum + (count - (1 as u32))
        var ci: size_t 0
        let cn covered.get_count()
        while ci < cn
        {
            let cmin covered.range_min(ci)
            let cmax covered.range_max(ci)
            if pos < cmin
                out_missing.add_range(pos, cmin - (1 as u32))
            if cmax >= pos
                set pos: cmax + (1 as u32)
            set ci: ci + 1
        }
        if pos <= lim
            out_missing.add_range(pos, lim)
    }
}
