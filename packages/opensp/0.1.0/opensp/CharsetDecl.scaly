use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.ISet.ISet

; CharsetDecl — the CHARSET section of an SGML declaration (CharsetDecl.h /
; CharsetDecl.cxx): sections (one per BASESET, carrying the baseset's public
; id) of DESCSET ranges, each range mapping `count` document character numbers
; from `desc_min` onto base-set numbers from `base_min` (type number), onto a
; minimum-literal description (type string), or declaring them UNUSED.
;
; The declared set (charDeclared) counts EVERY range type INCLUDING UNUSED
; (CharsetDecl::addRange feeds declaredSet_ for all three variants): an UNUSED
; char ref is a DECLARED non-SGML character (silently dropped by content /
; CDATA-attribute contexts), NOT a characterNumber error. Do not "simplify"
; UNUSED out of the declared set.
;
; UnivCharsetDesc is the document-charset desc->univ mapping the reference
; builds from DESCSET x baseset (sdParseDocumentCharset -> desc.addBaseRange,
; parseSd.cxx:814). Reduced here to the number-range walk: the registrations
; the port covers (CharsetRegistry.cxx) are all IDENTITY maps into ISO 10646 —
;   ISO646_ASCII_G0 {0,128,0} (ESC 2/5 4/0, 2/8 4/0, 2/8 4/2)
;   ISO646_C0       {0,32,0} {127,1,127} (ESC 2/1 4/0)
;   ISO10646_UCS2   {0,65536,0} (ESC 2/5 2/15 4/0|4/3|4/5)
;   ISO10646_UCS4   {0,0x80000000,0} (ESC 2/5 2/15 4/1|4/4|4/6)
; — so univ = base number wherever the baseset covers it. Any other
; registration (8859-x, JIS, KSC, ...) is UNKNOWN: its number ranges stay out
; of the desc, so under SP_CHARSET_FIXED a char ref into them reports
; numericCharRefUnknownBase; in the default mode (the internal charset IS the
; document charset) the desc is never consulted at all.

; charMax (include/constant.h:12) — the top of SP's internal Char range under
; SP_MULTI_BYTE. A CONSTANT, not a charset-derived value: the numeric-char-ref
; digit fold guards against it, and the implied document charset declares
; exactly [0, CHAR_MAX]. Out-of-charset numbers BELOW it are caught by
; charDeclared, not by this cap.
define CHAR_MAX: u32 1114111

; The fixed-mode INTERNAL (system) charset bound: CodingSystemKit::make builds
; the system charset from iso10646Desc = { ISO10646_UCS2, 0 } — identity over
; 0..0xFFFF ("SP only supports 16-bit characters", CodingSystemKit.cxx:136).
; univToDesc into it succeeds iff univ <= this bound (verified vs onsgmls
; 1.5.2: &#65535; converts, &#65536; reports numericCharRefNoInternal).
define INTERNAL_CHAR_MAX: u32 65535

define CHARSET_RANGE_NUMBER: int 0
define CHARSET_RANGE_STRING: int 1
define CHARSET_RANGE_UNUSED: int 2

; The identity registrations covered (CharsetRegistry::ISORegistrationNumber).
define BASESET_UNKNOWN: int 0
define BASESET_ASCII: int 1
define BASESET_C0: int 2
define BASESET_UCS2: int 3
define BASESET_UCS4: int 4

; One DESCSET row (CharsetDeclRange). `section` indexes the owning BASESET's
; public id in CharsetDecl.section_ids (the reference nests ranges inside
; CharsetDeclSection; a flat list in declaration order walks identically).
define CharsetDeclRange (desc_min: u32, count: u32, base_min: u32, range_type: int, str: StringC, section: size_t)
{
    init(desc_min: u32, count: u32, base_min: u32, range_type: int, str: StringC, section: size_t)
    {
        set this.desc_min: desc_min
        set this.count: count
        set this.base_min: base_min
        set this.range_type: range_type
        set this.str: str
        set this.section: section
    }
}

; Page-hosted (construct via CharsetDecl^host()) — init resolves its arena
; page from `this`, like ISet.
define CharsetDecl (section_ids: pointer[Array[StringC]], ranges: pointer[Array[CharsetDeclRange]], declared: pointer[ISet])
{
    init()
    {
        let host Page.get(this as pointer[void])
        set section_ids: Array[StringC]^host()
        set ranges: Array[CharsetDeclRange]^host()
        set declared: ISet^host()
    }

    function add_section(this: CharsetDecl, id: StringC)
        section_ids.add(id)

    function section_count(this: CharsetDecl) returns size_t
        section_ids.get_length()

    function range_count(this: CharsetDecl) returns size_t
        ranges.get_length()

    function section_pubid(this: CharsetDecl, i: size_t) returns StringC
        *(section_ids.get_buffer() + i)

    ; addRange (CharsetDecl.cxx): every variant — number, string, UNUSED —
    ; records [min, min+count) in the declared set.
    function add_range_number(this: CharsetDecl, min: u32, count: u32, base_min: u32)
    {
        if count > (0 as u32)
            declared.add_range(min, min + count - (1 as u32))
        let sec section_ids.get_length() - (1 as size_t)
        ranges.add(CharsetDeclRange(min, count, base_min, CHARSET_RANGE_NUMBER, StringC(), sec))
    }

    function add_range_unused(this: CharsetDecl, min: u32, count: u32)
    {
        if count > (0 as u32)
            declared.add_range(min, min + count - (1 as u32))
        let sec section_ids.get_length() - (1 as size_t)
        ranges.add(CharsetDeclRange(min, count, 0 as u32, CHARSET_RANGE_UNUSED, StringC(), sec))
    }

    function add_range_string(this: CharsetDecl, min: u32, count: u32, str: StringC)
    {
        if count > (0 as u32)
            declared.add_range(min, min + count - (1 as u32))
        let sec section_ids.get_length() - (1 as size_t)
        ranges.add(CharsetDeclRange(min, count, 0 as u32, CHARSET_RANGE_STRING, str, sec))
    }

    ; charDeclared (CharsetDecl.h:133) — declaredSet_.contains.
    function char_declared(this: CharsetDecl, c: u32) returns bool
        declared.contains(c)

    ; getCharInfo (CharsetDecl.cxx): the first range containing c, sections in
    ; declaration order. Returns null when no range covers c (the reference's
    ; CANNOT_HAPPEN after a passed charDeclared).
    function find_range(this: CharsetDecl, c: u32) returns pointer[CharsetDeclRange]
    {
        var i: size_t 0
        let n ranges.get_length()
        while i < n
        {
            let r ranges.get_buffer() + i
            if (c >= r.desc_min) and ((c - r.desc_min) < r.count)
                return r
            set i: i + 1
        }
        null
    }

    ; The IMPLIED docCharsetDecl (Parser.cxx:46-52, document parse with no SGML
    ; declaration): ONE section with an EMPTY public id + ONE base range
    ; addRange(0, charMax+1, 0) — which is why the no-declaration fixed-mode
    ; diagnostic reads `... from baseset "" unknown`.
    function make_implied(host: pointer[Page]) returns pointer[CharsetDecl]
    {
        let decl CharsetDecl^host()
        decl.add_section(StringC())
        decl.add_range_number(0 as u32, CHAR_MAX + (1 as u32), 0 as u32)
        decl
    }

    function test() returns int
    {
        let anchor StringC("x")
        let r Page.get(anchor.data_ptr() as pointer[void])

        ; the corpus xml.dcl shape: UNUSED head rows + identity body capped at
        ; 65535 (the "SP only supports 16-bit characters" DESCSET).
        let decl CharsetDecl^r()
        let sid StringC^r("dummy-ucs4-id")
        decl.add_section(sid)
        decl.add_range_unused(0 as u32, 9 as u32)
        decl.add_range_number(9 as u32, 2 as u32, 9 as u32)
        decl.add_range_number(160 as u32, 65374 as u32, 160 as u32)
        decl.add_range_unused(65534 as u32, 2 as u32)
        ; UNUSED counts as declared (an UNUSED ref drops silently, it does NOT
        ; report characterNumber)
        if decl.char_declared(0 as u32) = false
            return -1
        if decl.char_declared(65535 as u32) = false
            return -2
        if decl.char_declared(65536 as u32)
            return -3
        if decl.char_declared(100 as u32)
            return -4
        let ru decl.find_range(4 as u32)
        if ru = null
            return -5
        if ru.range_type <> CHARSET_RANGE_UNUSED
            return -6
        let rn decl.find_range(200 as u32)
        if rn = null
            return -7
        if rn.range_type <> CHARSET_RANGE_NUMBER
            return -8
        if (rn.base_min + ((200 as u32) - rn.desc_min)) <> (200 as u32)
            return -9
        if decl.find_range(70000 as u32) <> null
            return -10

        ; the implied declaration: everything in [0, charMax] declared as a
        ; number range of the empty-pubid section
        let imp CharsetDecl.make_implied(r)
        if imp.char_declared(CHAR_MAX) = false
            return -11
        if imp.char_declared(CHAR_MAX + (1 as u32))
            return -12
        let ri imp.find_range(65536 as u32)
        if ri = null
            return -13
        if (ri.base_min + ((65536 as u32) - ri.desc_min)) <> (65536 as u32)
            return -14
        let pid imp.section_pubid(ri.section)
        if pid.get_size() <> (0 as size_t)
            return -15

        ; desc: a full-range UCS-4 mapping (the scaly.dcl shape) + clipping
        let desc UnivCharsetDesc^r()
        desc.add_base_range(BASESET_UCS4, 65536 as u32, 1048576 as u32, 65536 as u32)
        var univ: u32 0
        if desc.desc_to_univ(70000 as u32, &univ) = false
            return -16
        if univ <> (70000 as u32)
            return -17
        if desc.desc_to_univ(127 as u32, &univ)
            return -18
        ; ASCII G0 covers base numbers 0..127 only: a row reaching past 128
        ; is clipped (the reference's baseMissing)
        let desc2 UnivCharsetDesc^r()
        desc2.add_base_range(BASESET_ASCII, 0 as u32, 256 as u32, 0 as u32)
        if desc2.desc_to_univ(127 as u32, &univ) = false
            return -19
        if univ <> (127 as u32)
            return -20
        if desc2.desc_to_univ(128 as u32, &univ)
            return -21
        ; the system (implied/fixed internal) charset: identity 0..0xFFFF
        let sys UnivCharsetDesc.make_system(r)
        if sys.desc_to_univ(65535 as u32, &univ) = false
            return -22
        if univ <> (65535 as u32)
            return -23
        if sys.desc_to_univ(65536 as u32, &univ)
            return -24

        0
    }
}

; One desc->univ range. `is_const` models the minimum-literal DESCSET rows
; (parseSd.cxx:988): every char of the row maps to the SAME univ char (the
; named char's nameToUniv slot), unlike number rows which map linearly.
define UnivDescRange (desc_min: u32, count: u32, univ_min: u32, is_const: bool)
{
    init(desc_min: u32, count: u32, univ_min: u32, is_const: bool)
    {
        set this.desc_min: desc_min
        set this.count: count
        set this.univ_min: univ_min
        set this.is_const: is_const
    }
}

; The document charset's desc->univ mapping (UnivCharsetDesc / CharsetInfo,
; reduced — see the header comment). Page-hosted (UnivCharsetDesc^host()).
define UnivCharsetDesc (ranges: pointer[Array[UnivDescRange]])
{
    init()
    {
        let host Page.get(this as pointer[void])
        set ranges: Array[UnivDescRange]^host()
    }

    function add_range(this: UnivCharsetDesc, desc_min: u32, count: u32, univ_min: u32, is_const: bool)
    {
        if count > (0 as u32)
            ranges.add(UnivDescRange(desc_min, count, univ_min, is_const))
    }

    ; UnivCharsetDesc::addBaseRange, identity-baseset form: clip the base-number
    ; run [base_min, base_min+count) against the registration's covered ranges;
    ; covered sub-runs map identically (univ = base number). Base numbers the
    ; registration does not cover stay unmapped — the reference collects them
    ; as baseMissing (a warnSgmlDecl-only warning, not ported). An UNKNOWN
    ; registration covers nothing.
    function add_base_range(this: UnivCharsetDesc, baseset: int, desc_min: u32, count: u32, base_min: u32)
    {
        if baseset = BASESET_ASCII
            this.add_clipped(desc_min, count, base_min, 0 as u32, 128 as u32)
        else if baseset = BASESET_C0
        {
            this.add_clipped(desc_min, count, base_min, 0 as u32, 32 as u32)
            this.add_clipped(desc_min, count, base_min, 127 as u32, 1 as u32)
        }
        else if baseset = BASESET_UCS2
            this.add_clipped(desc_min, count, base_min, 0 as u32, 65536 as u32)
        else if baseset = BASESET_UCS4
            this.add_clipped(desc_min, count, base_min, 0 as u32, 0x80000000 as u32)
    }

    ; add the part of the row whose base numbers fall inside [b_min, b_min+b_count)
    function add_clipped(this: UnivCharsetDesc, desc_min: u32, count: u32, base_min: u32, b_min: u32, b_count: u32)
    {
        if count = (0 as u32)
            return
        var lo base_min
        if b_min > lo
            set lo: b_min
        var hi base_min + count
        let bhi b_min + b_count
        if bhi < hi
            set hi: bhi
        if lo >= hi
            return
        this.add_range(desc_min + (lo - base_min), hi - lo, lo, false)
    }

    ; descToUniv (UnivCharsetDesc.h:93, first-match walk).
    function desc_to_univ(this: UnivCharsetDesc, c: u32, out_univ: pointer[u32]) returns bool
    {
        var i: size_t 0
        let n ranges.get_length()
        while i < n
        {
            let r ranges.get_buffer() + i
            if (c >= r.desc_min) and ((c - r.desc_min) < r.count)
            {
                if r.is_const
                    set *out_univ: r.univ_min
                else
                    set *out_univ: r.univ_min + (c - r.desc_min)
                return true
            }
            set i: i + 1
        }
        false
    }

    ; The system charset as a doc-charset mapping (Sd.cxx ctor:
    ; docCharset_(entityManager->charset())) — what descToUniv consults when no
    ; SGML declaration provided a CHARSET section: identity over 0..0xFFFF.
    function make_system(host: pointer[Page]) returns pointer[UnivCharsetDesc]
    {
        let desc UnivCharsetDesc^host()
        desc.add_range(0 as u32, INTERNAL_CHAR_MAX + (1 as u32), 0 as u32, false)
        desc
    }
}
