; Parser — the FIRST slice of Parser.cs (the 11801-LOC integration tail): the
; prolog + DTD declaration-subset parser. It drives ParserState.get_token(mode)
; over real markup-declaration text and builds a Dtd, exercising the whole
; declaration stack end-to-end for the first time (scanner -> Sd/Syntax ->
; parseParam -> the markup-declaration parsers -> Dtd tables + content-model
; compile + attribute-def build).
;
; COMPOSITION: C++ Parser : ParserState. Here a Parser HOLDS a pointer[ParserState]
; (+ the run page); every currentInput()/getToken()/message() delegates to it.
;
; PORTED SLICE (doDeclSubset drive + the declaration parsers):
;  - the declaration-subset driver (doDeclSubset, scoped): the dsMode/dsiMode
;    token loop that dispatches each <!...> markup declaration, + tokenEe/tokenDsc/
;    tokenS and declSubsetRecover.
;  - parseParam — the parameter workhorse (Param.cs / parseParam.cxx): names,
;    name tokens, literals, numbers, reserved-name/indicated-reserved-name and
;    delimiter parameters, each declaration's AllowedParams.
;  - the group parser (Group.cs / parseGroup*): parseGroupToken / parseGroupConnector
;    / parseGroup / parseModelGroup / getOccurrenceIndicator / parseNameGroup /
;    parseNameTokenGroup / parseElementNameGroup, building the ContentToken node
;    graph that ContentToken.compile consumes.
;  - the markup-declaration parsers: parseElementDecl (+parseExceptions),
;    parseAttlistDecl (+parseAttributed), parseDeclaredValue, parseDefaultValue,
;    parseNotationDecl, parseEntityDecl (+parseExternalEntity), parseShortrefDecl.
;  - parseExternalId, parseDeclarationName, the literal parsers (parseLiteral).
;
; DEFERRED (documented; each needs machinery a later Parser sub-increment lands):
;  - Instance/content parsing (doContent, start/end-tag + attribute-spec parsing,
;    the content-model transition + tag-omission recovery automaton, marked
;    sections, pcdataRecover) -> Increment 2.
;  - Event.cs ESIS emission (eventHandler().*/currentMarkup()); declarations
;    produce Dtd state, not ESIS output. All currentMarkup()!=null branches drop.
;  - Lpd + LINK + Markup capture, Pass1/Pass2 (haveDefLpd() is always false here).
;  - ParserOptions warnings (options().warn*): all dropped (advisory).
;  - PARAMETER-ENTITY REFERENCES inside declarations/groups/literals
;    (tokenPero*/entity.declReference/litReference) and COMMENTS inside markup
;    declarations (tokenCom / parseComment): a decl-subset with %-refs or PS
;    comments recovers rather than resolving. Corpus DTDs that need them light up
;    with the entity-stacking drive in Increment 2.
;  - value NORMALISATION/VALIDATION (DeclaredValue.makeValue's category/length
;    checks, allowed-value/entity/notation/id resolution): make_attribute_value
;    here is the PURE part (CDATA -> cdata value; tokenized -> space-split value);
;    the message-emitting validation lands with instance parsing.
;  - data attributes (rDATA / NDATA DSO attribute-spec), rank stems, exotic
;    bracketed entities, generateSystemId (catalog): each recovers/defers loudly.
;  - the reserved-name table lives HERE (lookup_reserved_name), not in the Syntax
;    value type, to keep Syntax's init untouched (faithful behavior, different
;    residence — cf. the Message record living in the ParserState module).

; ---- Param types (Param.cs) -------------------------------------------------
define P_INVALID: int 0
define P_SILENT: int 1
define P_DSO: int 2
define P_MDC: int 3
define P_MINUS: int 4
define P_PERO: int 5
define P_INCLUSIONS: int 6
define P_EXCLUSIONS: int 7
define P_NAMEGROUP: int 8
define P_NAMETOKENGROUP: int 9
define P_MODELGROUP: int 10
define P_NUMBER: int 11
define P_MINIMUMLITERAL: int 12
define P_ATTRIBUTEVALUELITERAL: int 13
define P_TOKENIZEDATTRIBUTEVALUELITERAL: int 14
define P_SYSTEMIDENTIFIER: int 15
define P_PARAMLITERAL: int 16
define P_NAME: int 17
define P_ENTITYNAME: int 18
define P_PARAMENTITYNAME: int 19
define P_ATTRIBUTEVALUE: int 20
define P_RESERVED_NAME: int 21
; Syntax.ReservedName ordinals (the enum order; nNames = 58).
define N_NAMES: int 58
define P_INDICATED_RESERVED_NAME: int 79

; MarkedSectionEvent::Status (parseDecl.cxx) — ordered so the parser can take the
; MAX status seen across the keyword list (include < cdata < rcdata < ignore).
define MS_INCLUDE: int 0
define MS_CDATA: int 1
define MS_RCDATA: int 2
define MS_IGNORE: int 3

; Syntax.ReservedName (rALL..rUSEMAP).
define R_ALL: int 0
define R_ANY: int 1
define R_ATTLIST: int 2
define R_CDATA: int 3
define R_CONREF: int 4
define R_CURRENT: int 5
define R_DATA: int 6
define R_DEFAULT: int 7
define R_DOCTYPE: int 8
define R_ELEMENT: int 9
define R_EMPTY: int 10
define R_ENDTAG: int 11
define R_ENTITIES: int 12
define R_ENTITY: int 13
define R_FIXED: int 14
define R_ID: int 15
define R_IDLINK: int 16
define R_IDREF: int 17
define R_IDREFS: int 18
define R_IGNORE: int 19
define R_IMPLICIT: int 20
define R_IMPLIED: int 21
define R_INCLUDE: int 22
define R_INITIAL: int 23
define R_LINK: int 24
define R_LINKTYPE: int 25
define R_MD: int 26
define R_MS: int 27
define R_NAME: int 28
define R_NAMES: int 29
define R_NDATA: int 30
define R_NMTOKEN: int 31
define R_NMTOKENS: int 32
define R_NOTATION: int 33
define R_NUMBER: int 34
define R_NUMBERS: int 35
define R_NUTOKEN: int 36
define R_NUTOKENS: int 37
define R_O: int 38
define R_PCDATA: int 39
define R_PI: int 40
define R_POSTLINK: int 41
define R_PUBLIC: int 42
define R_RCDATA: int 43
define R_RE: int 44
define R_REQUIRED: int 45
define R_RESTORE: int 46
define R_RS: int 47
define R_SDATA: int 48
define R_SHORTREF: int 49
define R_SIMPLE: int 50
define R_SPACE: int 51
define R_STARTTAG: int 52
define R_SUBDOC: int 53
define R_SYSTEM: int 54
define R_TEMP: int 55
define R_USELINK: int 56
define R_USEMAP: int 57

; GroupToken.Type (Group.cs).
define GT_INVALID: int 0
define GT_NAMETOKEN: int 1
define GT_NAME: int 2
define GT_DATATAGLITERAL: int 3
define GT_DATATAGGROUP: int 4
define GT_ELEMENTTOKEN: int 5
define GT_MODELGROUP: int 6
define GT_PCDATA: int 7
define GT_DATATAGTEMPLATEGROUP: int 8
define GT_ALL: int 9
define GT_IMPLICIT: int 10

; GroupConnector.Type (Group.cs).
define GC_AND: int 0
define GC_OR: int 1
define GC_SEQ: int 2
define GC_GRPC: int 3
define GC_DTGC: int 4

; A group member of a name/name-token group (with its original spelling + loc).
define NameToken (name: StringC, orig_name: StringC, loc: Location)
{
    init(name: StringC, orig_name: StringC, loc: Location)
    {
        set this.name: name
        set this.orig_name: orig_name
        set this.loc: loc
    }
}

; Param — the workhorse's output (Param.cs), reused/mutated across parseParam
; calls, so page-hosted.
define Param
(
    kind: int
    token: StringC
    orig_token: StringC
    literal_text: pointer[Text]
    lita: bool
    model_group: pointer[CmNode]
    name_tokens: pointer[Array[NameToken]]
    elements: pointer[Array[pointer[ElementType]]]
)
{
    function make(host: pointer[Page]) returns pointer[Param]
    {
        let p host.allocate(sizeof Param, alignof Param) as pointer[Param]
        set p.kind: P_INVALID
        set p.token: StringC()
        set p.orig_token: StringC()
        set p.literal_text: null
        set p.lita: false
        set p.model_group: null
        set p.name_tokens: Array[NameToken]^host()
        set p.elements: Array[pointer[ElementType]]^host()
        p
    }
}

; AllowedParams (Param.cs) — the per-call allowed-parameter set. Built by make +
; allow() (mirroring the C++ ctor). Page-hosted (holds a reserved-name bitset).
define AllowedParams
(
    silent: bool
    mdc_ok: bool
    rni_ok: bool
    dso_ok: bool
    inclusions_ok: bool
    exclusions_ok: bool
    extra_delimiter: int
    group_type: int
    name_start_type: int
    digit_type: int
    nmchar_type: int
    literal_type: int
    reserved_names: pointer[u8]
    main_mode: int
)
{
    function make(host: pointer[Page]) returns pointer[AllowedParams]
    {
        let a host.allocate(sizeof AllowedParams, alignof AllowedParams) as pointer[AllowedParams]
        set a.silent: false
        set a.mdc_ok: false
        set a.rni_ok: false
        set a.dso_ok: false
        set a.inclusions_ok: false
        set a.exclusions_ok: false
        set a.extra_delimiter: P_INVALID
        set a.group_type: P_INVALID
        set a.name_start_type: P_INVALID
        set a.digit_type: P_INVALID
        set a.nmchar_type: P_INVALID
        set a.literal_type: P_INVALID
        set a.main_mode: mdMode
        let rn host.allocate(N_NAMES as size_t, 1) as pointer[u8]
        var i: size_t 0
        while i < (N_NAMES as size_t)
        {
            set *(rn + i): (0 as u8)
            set i: i + 1
        }
        set a.reserved_names: rn
        a
    }

    function allow(this: pointer[AllowedParams], p: int)
    {
        if p = P_INVALID
            return
        if p = P_SILENT
            set this.silent: true
        else if p = P_DSO
            set this.dso_ok: true
        else if p = P_MDC
            set this.mdc_ok: true
        else if p = P_MINUS
        {
            set this.main_mode: mdMinusMode
            set this.extra_delimiter: p
        }
        else if p = P_PERO
        {
            set this.main_mode: mdPeroMode
            set this.extra_delimiter: p
        }
        else if p = P_INCLUSIONS
            set this.inclusions_ok: true
        else if p = P_EXCLUSIONS
            set this.exclusions_ok: true
        else if (p = P_NAMEGROUP) or (p = P_NAMETOKENGROUP) or (p = P_MODELGROUP)
            set this.group_type: p
        else if p = P_NUMBER
            set this.digit_type: p
        else if (p = P_MINIMUMLITERAL) or (p = P_TOKENIZEDATTRIBUTEVALUELITERAL) or (p = P_ATTRIBUTEVALUELITERAL) or (p = P_SYSTEMIDENTIFIER) or (p = P_PARAMLITERAL)
            set this.literal_type: p
        else if (p = P_NAME) or (p = P_ENTITYNAME) or (p = P_PARAMENTITYNAME)
            set this.name_start_type: p
        else if p = P_ATTRIBUTEVALUE
        {
            set this.name_start_type: p
            set this.digit_type: p
            set this.nmchar_type: p
        }
        else if p < P_INDICATED_RESERVED_NAME
        {
            set this.name_start_type: P_RESERVED_NAME
            set *(this.reserved_names + ((p - P_RESERVED_NAME) as size_t)): (1 as u8)
        }
        else
        {
            set this.rni_ok: true
            set *(this.reserved_names + ((p - P_INDICATED_RESERVED_NAME) as size_t)): (1 as u8)
        }
    }

    function reserved_name_allowed(this: AllowedParams, i: int) returns bool
        *(reserved_names + (i as size_t)) <> (0 as u8)

    ; convenience builders (fixed arity; the C++ ctor takes up to 10 codes)
    function a1(host: pointer[Page], p1: int) returns pointer[AllowedParams]
    {
        let a make(host)
        a.allow(p1)
        a
    }
    function a2(host: pointer[Page], p1: int, p2: int) returns pointer[AllowedParams]
    {
        let a make(host)
        a.allow(p1)
        a.allow(p2)
        a
    }
    function a3(host: pointer[Page], p1: int, p2: int, p3: int) returns pointer[AllowedParams]
    {
        let a make(host)
        a.allow(p1)
        a.allow(p2)
        a.allow(p3)
        a
    }
    function a4(host: pointer[Page], p1: int, p2: int, p3: int, p4: int) returns pointer[AllowedParams]
    {
        let a make(host)
        a.allow(p1)
        a.allow(p2)
        a.allow(p3)
        a.allow(p4)
        a
    }
    function a5(host: pointer[Page], p1: int, p2: int, p3: int, p4: int, p5: int) returns pointer[AllowedParams]
    {
        let a make(host)
        a.allow(p1)
        a.allow(p2)
        a.allow(p3)
        a.allow(p4)
        a.allow(p5)
        a
    }
    function a7(host: pointer[Page], p1: int, p2: int, p3: int, p4: int, p5: int, p6: int, p7: int) returns pointer[AllowedParams]
    {
        let a make(host)
        a.allow(p1)
        a.allow(p2)
        a.allow(p3)
        a.allow(p4)
        a.allow(p5)
        a.allow(p6)
        a.allow(p7)
        a
    }
    function a8(host: pointer[Page], p1: int, p2: int, p3: int, p4: int, p5: int, p6: int, p7: int, p8: int) returns pointer[AllowedParams]
    {
        let a make(host)
        a.allow(p1)
        a.allow(p2)
        a.allow(p3)
        a.allow(p4)
        a.allow(p5)
        a.allow(p6)
        a.allow(p7)
        a.allow(p8)
        a
    }
    function an(host: pointer[Page], codes: pointer[int], n: int) returns pointer[AllowedParams]
    {
        let a make(host)
        var i: int 0
        while i < n
        {
            a.allow(*(codes + (i as size_t)))
            set i: i + 1
        }
        a
    }
}

; A parsed group token (Group.cs GroupToken, scoped: no data-tag templates).
define GroupToken
(
    kind: int
    token: StringC
    model: pointer[CmNode]
    content_token: pointer[CmNode]
)
{
    function make(host: pointer[Page]) returns pointer[GroupToken]
    {
        let g host.allocate(sizeof GroupToken, alignof GroupToken) as pointer[GroupToken]
        set g.kind: GT_INVALID
        set g.token: StringC()
        set g.model: null
        set g.content_token: null
        g
    }
}

; AttributeParameter::Type — the classification parse_attribute_parameter returns
; for each token it reads inside a start-tag attribute specification.
define APT_END: int 0
define APT_NAME: int 1
define APT_NAMETOKEN: int 2
define APT_VI: int 3
define APT_RECOVER_UNQUOTED: int 4

; ExternalInputSource::RecordType — how an entity's records are delimited. Detected
; from its first CR/LF (make_char_source); see the record-normalization comment
; there. `unknown`/`crUnknown` are the reference's streaming-only intermediates: a
; whole-buffer source decides in one look.
define RT_LF: int 0
define RT_CRLF: int 1
define RT_CR: int 2
define RT_ASIS: int 3

define Parser (host: pointer[Page], ps: pointer[ParserState])
{
    function make(host: pointer[Page], ps: pointer[ParserState]) returns Parser
        Parser(host, ps)

    ; ---- delegating helpers ----------------------------------------------
    function err(this: Parser, code: int)
        ps.message(MessageType(MessageFragment(code as u32, StringC()), Severity.Error))

    ; report a message with REAL text (written to stderr, MessageReporter path).
    ; report0: no arguments; report1: one String argument, substituted for %1
    ; (String args are quoted by the formatter). `mt` is the MessageType from a
    ; GENERATED table (e.g. ParserMessages.elementNotAllowed()) — text, severity
    ; and number all sourced from the reference .msg (see *Messages.scaly).
    function report0(this: Parser, mt: MessageType)
    {
        let args Vector[MessageArg]()
        ps.report(mt, args)
    }

    function report1(this: Parser, mt: MessageType, a1: StringC)
    {
        var args Vector[MessageArg](1 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Str(a1)
        ps.report(mt, args)
    }

    ; report1 at an explicit location (a captured construct location).
    function report1_at(this: Parser, mt: MessageType, a1: StringC, loc: Location)
    {
        var args Vector[MessageArg](1 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Str(a1)
        ps.report_at(mt, args, loc)
    }

    ; report a message whose %1 is a NUMBER (decimal, unquoted — NumberMessageArg)
    ; at an explicit location.
    function report_num_at(this: Parser, mt: MessageType, a1: u64, loc: Location)
    {
        var args Vector[MessageArg](1 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Num(a1)
        ps.report_at(mt, args, loc)
    }

    ; report1 at a location WITH an auxiliary "start tag was here"-style line at
    ; aux_loc (the omitted-end-tag diagnostics). %1 is the String a1 (quoted).
    ; `aux` is the companion fragment from the table (e.g. omitEndTagOmittag_aux()).
    function report1_aux(this: Parser, mt: MessageType, a1: StringC, loc: Location, aux: MessageFragment, aux_loc: Location)
    {
        var args Vector[MessageArg](1 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Str(a1)
        let aux_text aux.text
        ps.report_aux(mt, args, loc, aux_text, aux_loc)
    }

    ; reportNonSgmlCharacter (parseCommon.cxx) in a markup-declaration context
    ; (parseParam / parseGroupToken / parseGroupConnector): if the unrecognized
    ; token is a non-SGML character, report it. Our scanner admits C0/DEL as
    ; sgmlChar, so such a char reaches the tokenUnrecognized arms; the reference
    ; skips it and continues, we then fail the declaration and recover to the same
    ; ESIS — only the diagnostic was owed.
    function report_non_sgml_param(this: Parser)
    {
        let pc ps.current_input().current_char()
        if this.is_non_sgml_char(pc)
        {
            let mt ParserMessages.nonSgmlCharacter()
            let loc ps.current_input().token_start_location()
            this.report_num_at(mt, pc as u64, loc)
        }
    }

    function namelen(this: Parser) returns size_t
        ps.get_syntax().get_quantity(qNAMELEN) as size_t

    ; void extendNameToken(maxLength, tooLong): grow the current token over
    ; name characters (the quantity-limit "too long" message is deferred).
    function extend_name_token(this: Parser, maxlen: size_t)
    {
        let ins ps.current_input()
        if ins = null
            return
        var length ins.current_token_length()
        let syn ps.get_syntax()
        var scanning true
        while scanning
        {
            let ch ins.token_char()
            if syn.is_name_character(ch as u32) = false
                set scanning: false
            else
                set length: length + (1 as size_t)
        }
        ins.end_token(length)
    }

    ; folded (namecase general) current token / its original spelling.
    function name_folded(this: Parser) returns StringC
        ps.current_token_subst#(ps.get_syntax())

    ; ---- reserved-name lookup (Syntax.lookupReservedName, resident here) ---
    ; Returns the ReservedName ordinal, or -1 if the (folded) name is not one.
    function lookup_reserved_name(this: Parser, name: StringC) returns int
    {
        if name.equals(StringC("ALL"))
            return R_ALL
        if name.equals(StringC("ANY"))
            return R_ANY
        if name.equals(StringC("ATTLIST"))
            return R_ATTLIST
        if name.equals(StringC("CDATA"))
            return R_CDATA
        if name.equals(StringC("CONREF"))
            return R_CONREF
        if name.equals(StringC("CURRENT"))
            return R_CURRENT
        if name.equals(StringC("DATA"))
            return R_DATA
        if name.equals(StringC("DEFAULT"))
            return R_DEFAULT
        if name.equals(StringC("DOCTYPE"))
            return R_DOCTYPE
        if name.equals(StringC("ELEMENT"))
            return R_ELEMENT
        if name.equals(StringC("EMPTY"))
            return R_EMPTY
        if name.equals(StringC("ENDTAG"))
            return R_ENDTAG
        if name.equals(StringC("ENTITIES"))
            return R_ENTITIES
        if name.equals(StringC("ENTITY"))
            return R_ENTITY
        if name.equals(StringC("FIXED"))
            return R_FIXED
        if name.equals(StringC("ID"))
            return R_ID
        if name.equals(StringC("IDLINK"))
            return R_IDLINK
        if name.equals(StringC("IDREF"))
            return R_IDREF
        if name.equals(StringC("IDREFS"))
            return R_IDREFS
        if name.equals(StringC("IGNORE"))
            return R_IGNORE
        if name.equals(StringC("IMPLICIT"))
            return R_IMPLICIT
        if name.equals(StringC("IMPLIED"))
            return R_IMPLIED
        if name.equals(StringC("INCLUDE"))
            return R_INCLUDE
        if name.equals(StringC("INITIAL"))
            return R_INITIAL
        if name.equals(StringC("LINK"))
            return R_LINK
        if name.equals(StringC("LINKTYPE"))
            return R_LINKTYPE
        if name.equals(StringC("MD"))
            return R_MD
        if name.equals(StringC("MS"))
            return R_MS
        if name.equals(StringC("NAME"))
            return R_NAME
        if name.equals(StringC("NAMES"))
            return R_NAMES
        if name.equals(StringC("NDATA"))
            return R_NDATA
        if name.equals(StringC("NMTOKEN"))
            return R_NMTOKEN
        if name.equals(StringC("NMTOKENS"))
            return R_NMTOKENS
        if name.equals(StringC("NOTATION"))
            return R_NOTATION
        if name.equals(StringC("NUMBER"))
            return R_NUMBER
        if name.equals(StringC("NUMBERS"))
            return R_NUMBERS
        if name.equals(StringC("NUTOKEN"))
            return R_NUTOKEN
        if name.equals(StringC("NUTOKENS"))
            return R_NUTOKENS
        if name.equals(StringC("O"))
            return R_O
        if name.equals(StringC("PCDATA"))
            return R_PCDATA
        if name.equals(StringC("PI"))
            return R_PI
        if name.equals(StringC("POSTLINK"))
            return R_POSTLINK
        if name.equals(StringC("PUBLIC"))
            return R_PUBLIC
        if name.equals(StringC("RCDATA"))
            return R_RCDATA
        if name.equals(StringC("RE"))
            return R_RE
        if name.equals(StringC("REQUIRED"))
            return R_REQUIRED
        if name.equals(StringC("RESTORE"))
            return R_RESTORE
        if name.equals(StringC("RS"))
            return R_RS
        if name.equals(StringC("SDATA"))
            return R_SDATA
        if name.equals(StringC("SHORTREF"))
            return R_SHORTREF
        if name.equals(StringC("SIMPLE"))
            return R_SIMPLE
        if name.equals(StringC("SPACE"))
            return R_SPACE
        if name.equals(StringC("STARTTAG"))
            return R_STARTTAG
        if name.equals(StringC("SUBDOC"))
            return R_SUBDOC
        if name.equals(StringC("SYSTEM"))
            return R_SYSTEM
        if name.equals(StringC("TEMP"))
            return R_TEMP
        if name.equals(StringC("USELINK"))
            return R_USELINK
        if name.equals(StringC("USEMAP"))
            return R_USEMAP
        -1
    }

    ; ---- build a StringC from a growing u32 buffer ------------------------
    function build_stringc(this: Parser, buf: pointer[Array[u32]]) returns StringC
    {
        let n buf.get_length()
        if n = (0 as size_t)
            return StringC()
        ; Build the StringC page-resident on `host` (^host) so its init's
        ; Page.get(this) resolves to a valid region page. Constructing it as a
        ; by-VALUE return (StringC(cb, n)) instead puts `this` on a stack sret
        ; slot whose Page.get masks to a bogus, per-call-IDENTICAL header — so
        ; every literal's buffer aliased the same address (the Page.get-on-by-
        ; value hazard). ^host copies buf into a fresh host buffer; *scp returns
        ; the {data,size} value pointing at it.
        let scp StringC^host(buf.get_buffer(), n)
        *scp
    }

    ; StringC (u32 content) -> byte String (ASCII narrowing for external ids).
    function stringc_to_bytes(this: Parser, sc: StringC) returns String
    {
        let n sc.get_size()
        let buf host.allocate(n + (1 as size_t), 1) as pointer[u8]
        var i: size_t 0
        while i < n
        {
            set *(buf + i): sc.get(i) as u8
            set i: i + 1
        }
        set *(buf + n): (0 as u8)
        String(buf as pointer[const_char], n)
    }

    ; ---- lookup-create helpers (Parser::lookupCreate*) --------------------
    function lookup_create_element(this: Parser, name: StringC) returns pointer[ElementType]
    {
        let dtd ps.get_def_dtd()
        let existing dtd.lookup_element_type(name)
        if existing <> null
            return existing
        let idx dtd.alloc_element_type_index()
        let e ElementType.make(host, name, idx)
        dtd.insert_element_type(e)
        e
    }

    function lookup_create_notation(this: Parser, name: StringC) returns pointer[Notation]
    {
        let dtd ps.get_def_dtd()
        let existing dtd.lookup_notation(name)
        if existing <> null
            return existing
        let nt Notation.make(host, name, dtd.get_name(), dtd.get_is_base())
        dtd.insert_notation(nt)
        nt
    }

    function lookup_create_map(this: Parser, name: StringC) returns pointer[ShortReferenceMap]
    {
        let dtd ps.get_def_dtd()
        let existing dtd.lookup_short_reference_map(name)
        if existing <> null
            return existing
        let map ShortReferenceMap.make(host, name)
        dtd.insert_short_reference_map(map)
        map
    }

    ; ---- literal parsing (parseLiteral, scoped) ---------------------------
    ; Accumulates literal content; single_space collapses runs of space to one.
    ; Entity/char references inside literals are DEFERRED (recover + false).
    ; The `e` (in-entity) variant of a literal mode: parseCommon.cxx switches the
    ; scan mode to this while inside a pushed entity, where LIT/LITA are NOT
    ; delimiters (so a `"` produced by `&quot;` does not close the literal).
    function lite_mode_for(this: Parser, lit_mode: int) returns int
    {
        if (lit_mode = alitMode) or (lit_mode = alitaMode)
            return aliteMode
        if (lit_mode = talitMode) or (lit_mode = talitaMode)
            return taliteMode
        if (lit_mode = plitMode) or (lit_mode = plitaMode)
            return pliteMode
        lit_mode
    }

    function parse_literal(this: Parser, lit_mode: int, single_space: bool, out_text: pointer[Text]) returns bool
    {
        let start_level ps.get_input_level()
        let lite_mode this.lite_mode_for(lit_mode)
        ; currentMode (parseCommon.cxx): starts at lit_mode, flips to the `e`
        ; variant while an entity reference is open (inputLevel > startLevel),
        ; and back once the entity ends and we return to startLevel.
        var cur_mode lit_mode
        let buf Array[u32]^host()
        let space (0x20 as u32)
        var running true
        var ok true
        while running
        {
            let token ps.get_token(cur_mode)
            if (token = tokenLit) or (token = tokenLita)
                set running: false
            else if token = tokenEe
            {
                if ps.get_input_level() = start_level
                {
                    this.err(1)
                    set ok: false
                    set running: false
                }
                else
                {
                    ps.pop_input_stack()
                    ; back at the base input level → LIT/LITA are delimiters again.
                    if ps.get_input_level() = start_level
                        set cur_mode: lit_mode
                }
            }
            else if token = tokenRs
            {
                ; ignore record start
            }
            else if (token = tokenRe) or (token = tokenSepchar)
            {
                if single_space and ((buf.get_length() = (0 as size_t)) or (this.last_char(buf) = space))
                {
                    ; ignore
                }
                else
                    buf.add(space)
            }
            else if token = tokenSpace
            {
                if single_space and ((buf.get_length() = (0 as size_t)) or (this.last_char(buf) = space))
                {
                    ; ignore
                }
                else
                    buf.add(ps.current_input().current_char())
            }
            else if token = tokenChar
            {
                ; a non-SGML character in a literal (attribute value / parameter
                ; literal). Our scanner admits C0/DEL as sgmlChar (they stay data
                ; in content), so they arrive as tokenChar rather than the
                ; reference's tokenUnrecognized; report each and DROP it from the
                ; literal, exactly as reportNonSgmlCharacter does in parseCommon.
                let lc ps.current_input().current_char()
                if this.is_non_sgml_char(lc)
                {
                    let mt ParserMessages.nonSgmlCharacter()
                    let loc ps.current_input().token_start_location()
                    this.report_num_at(mt, lc as u64, loc)
                }
                else
                    buf.add(lc)
            }
            else if (token = tokenEroNameStart) or (token = tokenEroGrpo)
            {
                ; Entity::litReference — a general entity reference in a literal
                ; STACKS the entity like a content reference; its chars then scan
                ; as literal content (the tokenEe arm above pops it). This is how
                ; `&lt;` inside an attribute value becomes a literal `<`.
                if ps.get_current_dtd() = null
                {
                    this.err(2)
                    set ok: false
                    set running: false
                }
                else
                {
                    this.parse_entity_reference()
                    ; entity pushed → scan its chars in the `e` variant, where a
                    ; `"`/`'` (e.g. from `&quot;`) is data, not a literal close.
                    if ps.get_input_level() > start_level
                        set cur_mode: lite_mode
                }
            }
            else if (token = tokenCroDigit) or (token = tokenHcroHexDigit)
            {
                var ch: u32 0
                if this.parse_numeric_char_ref(&ch)
                    buf.add(ch)
                else
                {
                    this.err(2)
                    set ok: false
                    set running: false
                }
            }
            else if token = tokenPeroNameStart
            {
                ; parseLiteral case tokenPeroNameStart: Entity::litReference for a
                ; parameter entity -> `%pe;` inside a parameter literal STACKS the
                ; PE like a content reference; its chars then scan as literal
                ; content in the `e` variant (the tokenEe arm above pops it).
                ; Parameter literals occur only in declarations, so the reference
                ; is always valid for the corpus's external DTDs.
                if ps.get_current_dtd() = null
                {
                    this.err(2)
                    set ok: false
                    set running: false
                }
                else
                {
                    if this.parse_parameter_entity_reference() = false
                    {
                        set ok: false
                        set running: false
                    }
                    else if ps.get_input_level() > start_level
                        set cur_mode: lite_mode
                }
            }
            else if token = tokenCroNameStart
            {
                ; DEFERRED: named char refs inside literals.
                this.err(2)
                set ok: false
                set running: false
            }
            else if token = tokenUnrecognized
                buf.add(ps.current_input().current_char())
            else
            {
                ; other tokens in literal context: treat first char as data.
                buf.add(ps.current_input().current_char())
            }
        }
        if ok = false
            return false
        let sc this.build_stringc(buf)
        set *out_text: Text(sc)
        true
    }

    function last_char(this: Parser, buf: pointer[Array[u32]]) returns u32
    {
        let n buf.get_length()
        if n = (0 as size_t)
            return 0 as u32
        *(buf.get_buffer() + (n - (1 as size_t)))
    }

    ; ---- parseParam (parseParam.cxx) --------------------------------------
    function parse_param(this: Parser, allow: pointer[AllowedParams], decl_input_level: u32, parm: pointer[Param]) returns bool
    {
        var looping true
        while looping
        {
            let token ps.get_token(allow.main_mode)
            if token = tokenUnrecognized
            {
                this.report_non_sgml_param()
                this.err(3)
                return false
            }
            else if token = tokenEe
            {
                if ps.get_input_level() <= decl_input_level
                {
                    this.err(4)
                    return false
                }
                ps.pop_input_stack()
            }
            else if token = tokenCom
            {
                ; DEFERRED: comments inside markup declarations.
                this.err(5)
                return false
            }
            else if token = tokenDso
            {
                if allow.dso_ok = false
                {
                    this.err(6)
                    return false
                }
                set parm.kind: P_DSO
                return true
            }
            else if token = tokenGrpo
            {
                if allow.group_type = P_MODELGROUP
                {
                    var grp: pointer[CmNode] null
                    if this.parse_model_group((1 as u32), decl_input_level, &grp, grpsufMode) = false
                        return false
                    set parm.model_group: grp
                    set parm.kind: P_MODELGROUP
                    return true
                }
                else if allow.group_type = P_NAMEGROUP
                {
                    if this.parse_name_group(decl_input_level, parm) = false
                        return false
                    set parm.kind: P_NAMEGROUP
                    return true
                }
                else if allow.group_type = P_NAMETOKENGROUP
                {
                    if this.parse_name_token_group(decl_input_level, parm) = false
                        return false
                    set parm.kind: P_NAMETOKENGROUP
                    return true
                }
                else
                {
                    this.err(7)
                    return false
                }
            }
            else if (token = tokenLit) or (token = tokenLita)
            {
                set parm.kind: allow.literal_type
                set parm.lita: token = tokenLita
                if allow.literal_type = P_INVALID
                {
                    this.err(8)
                    return false
                }
                let txt host.allocate(sizeof Text, alignof Text) as pointer[Text]
                var lmode: int mlitMode
                var single false
                if allow.literal_type = P_MINIMUMLITERAL
                {
                    set lmode: mlitMode
                    if parm.lita
                        set lmode: mlitaMode
                    set single: true
                }
                else if allow.literal_type = P_SYSTEMIDENTIFIER
                {
                    set lmode: slitMode
                    if parm.lita
                        set lmode: slitaMode
                }
                else if allow.literal_type = P_PARAMLITERAL
                {
                    set lmode: plitMode
                    if parm.lita
                        set lmode: plitaMode
                }
                else if allow.literal_type = P_ATTRIBUTEVALUELITERAL
                {
                    set lmode: alitMode
                    if parm.lita
                        set lmode: alitaMode
                }
                else if allow.literal_type = P_TOKENIZEDATTRIBUTEVALUELITERAL
                {
                    set lmode: talitMode
                    if parm.lita
                        set lmode: talitaMode
                    set single: true
                }
                if this.parse_literal(lmode, single, txt) = false
                    return false
                set parm.literal_text: txt
                return true
            }
            else if token = tokenMdc
            {
                if allow.mdc_ok = false
                {
                    this.err(9)
                    return false
                }
                set parm.kind: P_MDC
                return true
            }
            else if token = tokenMinus
            {
                set parm.kind: P_MINUS
                return true
            }
            else if token = tokenMinusGrpo
            {
                if allow.exclusions_ok = false
                {
                    this.err(10)
                    return false
                }
                set parm.kind: P_EXCLUSIONS
                return this.parse_element_name_group(decl_input_level, parm)
            }
            else if token = tokenPero
            {
                set parm.kind: P_PERO
                return true
            }
            else if (token = tokenPeroNameStart) or (token = tokenPeroGrpo)
            {
                ; parseParam case tokenPeroNameStart: a parameter-entity reference
                ; where a parameter is expected -> declReference stacks it; the
                ; loop continues, reading the replacement text as the parameter
                ; (the tokenEe arm above pops the entity when it is exhausted).
                if this.parse_parameter_entity_reference() = false
                    return false
            }
            else if token = tokenPlusGrpo
            {
                if allow.inclusions_ok = false
                {
                    this.err(12)
                    return false
                }
                set parm.kind: P_INCLUSIONS
                return this.parse_element_name_group(decl_input_level, parm)
            }
            else if token = tokenRni
            {
                if allow.rni_ok = false
                {
                    this.err(13)
                    return false
                }
                return this.parse_indicated_reserved_name(allow, parm)
            }
            else if token = tokenS
            {
                ; whitespace between parameters: skip
            }
            else if token = tokenNameStart
            {
                if allow.name_start_type = P_INVALID
                {
                    this.err(14)
                    return false
                }
                else if allow.name_start_type = P_RESERVED_NAME
                    return this.parse_reserved_name(allow, parm)
                else if allow.name_start_type = P_NAME
                {
                    this.extend_name_token(this.namelen())
                    set parm.kind: P_NAME
                    set parm.orig_token: ps.current_token^host()
                    set parm.token: this.name_folded^host()
                    return true
                }
                else if allow.name_start_type = P_ENTITYNAME
                {
                    this.extend_name_token(this.namelen())
                    set parm.kind: P_ENTITYNAME
                    ; NAMECASE ENTITY NO: entity names stay case-exact (unlike
                    ; P_NAME above, which folds under NAMECASE GENERAL YES).
                    set parm.token: ps.current_token^host()
                    return true
                }
                else if allow.name_start_type = P_PARAMENTITYNAME
                {
                    this.extend_name_token(this.namelen())
                    set parm.kind: P_PARAMENTITYNAME
                    ; NAMECASE ENTITY NO: parameter-entity names stay case-exact.
                    set parm.token: ps.current_token^host()
                    return true
                }
                else if allow.name_start_type = P_ATTRIBUTEVALUE
                    return this.parse_attribute_value_param(parm)
                else
                {
                    this.err(15)
                    return false
                }
            }
            else if token = tokenDigit
            {
                if allow.digit_type = P_NUMBER
                {
                    this.extend_number(this.namelen())
                    set parm.kind: P_NUMBER
                    set parm.token: ps.current_token^host()
                    return true
                }
                else if allow.digit_type = P_ATTRIBUTEVALUE
                    return this.parse_attribute_value_param(parm)
                else
                {
                    this.err(16)
                    return false
                }
            }
            else if token = tokenLcUcNmchar
            {
                if allow.nmchar_type = P_ATTRIBUTEVALUE
                    return this.parse_attribute_value_param(parm)
                else
                {
                    this.err(17)
                    return false
                }
            }
            else
            {
                this.err(18)
                return false
            }
        }
        false
    }

    function extend_number(this: Parser, maxlen: size_t)
    {
        let ins ps.current_input()
        if ins = null
            return
        var length ins.current_token_length()
        let syn ps.get_syntax()
        var scanning true
        while scanning
        {
            let ch ins.token_char()
            if syn.is_digit(ch as u32) = false
                set scanning: false
            else
                set length: length + (1 as size_t)
        }
        ins.end_token(length)
    }

    ; parseAttributeValueParam — an unquoted attribute value (name/number/nmchar).
    function parse_attribute_value_param(this: Parser, parm: pointer[Param]) returns bool
    {
        this.extend_name_token(this.namelen())
        set parm.kind: P_ATTRIBUTEVALUE
        ; Copy the token onto the stable run region (^host), not the transient
        ; caller page: a default attribute value parsed here is stored in the DTD
        ; and read back at instance time, long after this DTD-parsing frame's
        ; region is reclaimed — ps.current_token() alone would dangle.
        let sc ps.current_token^host()
        let txt host.allocate(sizeof Text, alignof Text) as pointer[Text]
        set *txt: Text(sc)
        set parm.literal_text: txt
        true
    }

    ; parseReservedName — a plain reserved name in name-start position.
    function parse_reserved_name(this: Parser, allow: pointer[AllowedParams], parm: pointer[Param]) returns bool
    {
        var rn: int 0
        if this.get_reserved_name(&rn) = false
            return false
        if allow.reserved_name_allowed(rn) = false
        {
            this.err(19)
            return false
        }
        set parm.kind: P_RESERVED_NAME + rn
        true
    }

    function get_reserved_name(this: Parser, out_rn: pointer[int]) returns bool
    {
        this.extend_name_token(this.namelen())
        let buffer this.name_folded()
        let rn this.lookup_reserved_name(buffer)
        if rn < 0
        {
            this.err(20)
            return false
        }
        set *out_rn: rn
        true
    }

    ; parseIndicatedReservedName — after RNI (`#`), the reserved name.
    function parse_indicated_reserved_name(this: Parser, allow: pointer[AllowedParams], parm: pointer[Param]) returns bool
    {
        var rn: int 0
        if this.get_indicated_reserved_name(&rn) = false
            return false
        if allow.reserved_name_allowed(rn) = false
        {
            this.err(21)
            return false
        }
        set parm.kind: P_INDICATED_RESERVED_NAME + rn
        true
    }

    function get_indicated_reserved_name(this: Parser, out_rn: pointer[int]) returns bool
    {
        let ins ps.current_input()
        ins.start_token()
        let first ins.token_char()
        if ps.get_syntax().is_name_start_character(first as u32) = false
        {
            this.err(22)
            return false
        }
        this.extend_name_token(this.namelen())
        let buffer this.name_folded()
        let rn this.lookup_reserved_name(buffer)
        if rn < 0
        {
            this.err(23)
            return false
        }
        set *out_rn: rn
        true
    }

    ; ---- group parser (Group.cs) ------------------------------------------
    function has_gt(this: Parser, allow: int, t: int) returns bool
        (allow & (1 << t)) <> 0

    function gt_group(this: Parser, allow: int) returns int
    {
        if this.has_gt(allow, GT_MODELGROUP)
            return GT_MODELGROUP
        if this.has_gt(allow, GT_DATATAGTEMPLATEGROUP)
            return GT_DATATAGTEMPLATEGROUP
        GT_INVALID
    }

    function gt_name_start(this: Parser, allow: int) returns int
    {
        if this.has_gt(allow, GT_ELEMENTTOKEN)
            return GT_ELEMENTTOKEN
        if this.has_gt(allow, GT_NAMETOKEN)
            return GT_NAMETOKEN
        if this.has_gt(allow, GT_NAME)
            return GT_NAME
        GT_INVALID
    }

    function has_gc(this: Parser, allow: int, c: int) returns bool
        (allow & (1 << c)) <> 0

    ; getOccurrenceIndicator(oiMode)
    function get_occurrence_indicator(this: Parser, oi_mode: int) returns int
    {
        let token ps.get_token(oi_mode)
        if token = tokenPlus
            return OI_PLUS
        if token = tokenOpt
            return OI_OPT
        if token = tokenRep
            return OI_REP
        ps.current_input().unget_token()
        OI_NONE
    }

    ; parseGroupToken(allow, nestingLevel, declInputLevel, groupInputLevel, gt)
    function parse_group_token(this: Parser, allow: int, nesting_level: u32, decl_input_level: u32, group_input_level: u32, gt: pointer[GroupToken]) returns bool
    {
        var looping true
        while looping
        {
            let token ps.get_token(grpMode)
            if token = tokenEe
            {
                if ps.get_input_level() <= group_input_level
                {
                    this.err(30)
                    if ps.get_input_level() <= decl_input_level
                        return false
                }
                ps.pop_input_stack()
            }
            else if (token = tokenPeroNameStart) or (token = tokenPeroGrpo)
            {
                ; parseGroupToken case tokenPeroNameStart: a parameter-entity
                ; reference IN a model group (`(%pe;)*`) -> declReference stacks it;
                ; the loop continues, reading the group tokens from the replacement
                ; text (the tokenEe arm above pops the entity when exhausted).
                if this.parse_parameter_entity_reference() = false
                    return false
            }
            else if token = tokenUnrecognized
            {
                this.report_non_sgml_param()
                this.err(32)
                return false
            }
            else if token = tokenDtgo
            {
                ; DEFERRED: data-tag groups (rare SGML, absent from corpus).
                this.err(33)
                return false
            }
            else if token = tokenGrpo
            {
                if this.gt_group(allow) = GT_MODELGROUP
                {
                    var mg: pointer[CmNode] null
                    if this.parse_model_group(nesting_level + (1 as u32), decl_input_level, &mg, grpMode) = false
                        return false
                    set gt.model: mg
                    set gt.kind: GT_MODELGROUP
                    return true
                }
                else
                {
                    this.err(34)
                    return false
                }
            }
            else if token = tokenRni
            {
                if (this.has_gt(allow, GT_PCDATA) = false) and (this.has_gt(allow, GT_ALL) = false) and (this.has_gt(allow, GT_IMPLICIT) = false)
                {
                    this.err(35)
                    return false
                }
                var rn: int 0
                if this.get_indicated_reserved_name(&rn) = false
                    return false
                if (rn = R_PCDATA) and this.has_gt(allow, GT_PCDATA)
                {
                    set gt.kind: GT_PCDATA
                    ; PcdataToken() : LeafContentToken(0, rep) — pcdata is
                    ; inherently optional AND repeatable (the self-loop that lets
                    ; (#PCDATA) admit any run of data). OI_REP, never OI_NONE.
                    set gt.content_token: ContentToken.make_leaf(host, null as pointer[ElementType], OI_REP, true, false)
                    return true
                }
                else
                {
                    this.err(36)
                    return false
                }
            }
            else if token = tokenS
            {
                ; whitespace in group: skip
            }
            else if token = tokenNameStart
            {
                let ns this.gt_name_start(allow)
                if ns = GT_ELEMENTTOKEN
                {
                    this.extend_name_token(this.namelen())
                    let buffer this.name_folded()
                    let e this.lookup_create_element(buffer)
                    let oi this.get_occurrence_indicator(grpMode)
                    set gt.kind: GT_ELEMENTTOKEN
                    set gt.content_token: ContentToken.make_leaf(host, e, oi, false, false)
                    return true
                }
                else if (ns = GT_NAME) or (ns = GT_NAMETOKEN)
                {
                    this.extend_name_token(this.namelen())
                    set gt.token: this.name_folded^host()
                    set gt.kind: ns
                    return true
                }
                else
                {
                    this.err(37)
                    return false
                }
            }
            else if (token = tokenDigit) or (token = tokenLcUcNmchar)
            {
                if this.has_gt(allow, GT_NAMETOKEN) = false
                {
                    this.err(38)
                    return false
                }
                this.extend_name_token(this.namelen())
                set gt.token: this.name_folded^host()
                set gt.kind: GT_NAMETOKEN
                return true
            }
            else
            {
                ; connectors and occurrence indicators are not group tokens here
                this.err(39)
                return false
            }
        }
        false
    }

    ; parseGroupConnector(allow, declInputLevel, groupInputLevel, gc)
    function parse_group_connector(this: Parser, allow: int, decl_input_level: u32, group_input_level: u32, out_gc: pointer[int]) returns bool
    {
        var looping true
        while looping
        {
            let token ps.get_token(grpMode)
            if token = tokenEe
            {
                if ps.get_input_level() <= group_input_level
                {
                    this.err(40)
                    if ps.get_input_level() <= decl_input_level
                        return false
                }
                ps.pop_input_stack()
            }
            else if token = tokenS
            {
                ; skip
            }
            else if (token = tokenPeroNameStart) or (token = tokenPeroGrpo)
            {
                ; parseGroupConnector case tokenPeroNameStart: a parameter-entity
                ; reference in connector position. Only allowed under WWW (the XML
                ; profile); otherwise groupEntityReference. Under WWW, declReference
                ; stacks it and the loop reads the connector from the expansion.
                if ps.get_sd().www() = false
                {
                    this.err(41)
                    return false
                }
                if this.parse_parameter_entity_reference() = false
                    return false
            }
            else if token = tokenUnrecognized
            {
                this.report_non_sgml_param()
                this.err(42)
                return false
            }
            else if token = tokenAnd
            {
                if this.has_gc(allow, GC_AND) = false
                {
                    this.err(43)
                    return false
                }
                set *out_gc: GC_AND
                return true
            }
            else if token = tokenSeq
            {
                if this.has_gc(allow, GC_SEQ) = false
                {
                    this.err(44)
                    return false
                }
                set *out_gc: GC_SEQ
                return true
            }
            else if token = tokenOr
            {
                if this.has_gc(allow, GC_OR) = false
                {
                    this.err(45)
                    return false
                }
                set *out_gc: GC_OR
                return true
            }
            else if token = tokenGrpc
            {
                if this.has_gc(allow, GC_GRPC) = false
                {
                    this.err(46)
                    return false
                }
                set *out_gc: GC_GRPC
                return true
            }
            else
            {
                this.err(47)
                return false
            }
        }
        false
    }

    ; parseModelGroup(nestingLevel, declInputLevel, group, oiMode)
    function parse_model_group(this: Parser, nesting_level: u32, decl_input_level: u32, out_group: pointer[pointer[CmNode]], oi_mode: int) returns bool
    {
        let group_input_level ps.get_input_level()
        let members ContentToken.new_node_vec(host)
        var connector: int GC_GRPC
        let gt GroupToken.make(host)
        ; allowed content tokens: pcdata, elementToken, modelGroup (data-tag deferred).
        let allow_content (1 << GT_PCDATA) | ((1 << GT_ELEMENTTOKEN) | (1 << GT_MODELGROUP))
        ; connector allow-sets
        let allow_any ((1 << GC_OR) | (1 << GC_AND)) | ((1 << GC_SEQ) | (1 << GC_GRPC))
        let allow_or (1 << GC_OR) | (1 << GC_GRPC)
        let allow_and (1 << GC_AND) | (1 << GC_GRPC)
        let allow_seq (1 << GC_SEQ) | (1 << GC_GRPC)
        var connectorp: int allow_any
        var gc: int GC_GRPC
        var first true
        var running true
        while running
        {
            if this.parse_group_token(allow_content, nesting_level, decl_input_level, group_input_level, gt) = false
                return false
            var content_token: pointer[CmNode] null
            if gt.kind = GT_MODELGROUP
                set content_token: gt.model
            else
                set content_token: gt.content_token
            members.add(content_token)
            if this.parse_group_connector(connectorp, decl_input_level, group_input_level, &gc) = false
                return false
            if first
            {
                set first: false
                set connector: gc
                if gc = GC_OR
                    set connectorp: allow_or
                else if gc = GC_SEQ
                    set connectorp: allow_seq
                else if gc = GC_AND
                    set connectorp: allow_and
            }
            if gc = GC_GRPC
                set running: false
        }
        let oi this.get_occurrence_indicator(oi_mode)
        var conn: int CONN_SEQ
        if connector = GC_OR
            set conn: CONN_OR
        else if connector = GC_AND
            set conn: CONN_AND
        else
            set conn: CONN_SEQ
        set *out_group: ContentToken.make_group(host, conn, members, oi)
        true
    }

    ; parseGroup(allowToken, declInputLevel, parm) — a name/nametoken group.
    function parse_group(this: Parser, allow_token: int, decl_input_level: u32, parm: pointer[Param]) returns bool
    {
        let group_input_level ps.get_input_level()
        let vec Array[NameToken]^host()
        let gt GroupToken.make(host)
        var running true
        while running
        {
            if this.parse_group_token(allow_token, 0 as u32, decl_input_level, group_input_level, gt) = false
                return false
            if this.group_contains(vec, gt.token) = false
                vec.add(NameToken(gt.token, ps.current_token(), ps.current_location()))
            var gc: int GC_GRPC
            let allow_any ((1 << GC_OR) | (1 << GC_AND)) | ((1 << GC_SEQ) | (1 << GC_GRPC))
            if this.parse_group_connector(allow_any, decl_input_level, group_input_level, &gc) = false
                return false
            if gc = GC_GRPC
                set running: false
        }
        set parm.name_tokens: vec
        true
    }

    function group_contains(this: Parser, vec: pointer[Array[NameToken]], str: StringC) returns bool
    {
        let n vec.get_length()
        let buf vec.get_buffer()
        var i: size_t 0
        while i < n
        {
            let nt *(buf + i)
            if nt.name.equals(str)
                return true
            set i: i + 1
        }
        false
    }

    function parse_name_group(this: Parser, decl_input_level: u32, parm: pointer[Param]) returns bool
        this.parse_group(1 << GT_NAME, decl_input_level, parm)

    function parse_name_token_group(this: Parser, decl_input_level: u32, parm: pointer[Param]) returns bool
        this.parse_group(1 << GT_NAMETOKEN, decl_input_level, parm)

    ; parseElementNameGroup — a name group, then resolve to element types.
    function parse_element_name_group(this: Parser, decl_input_level: u32, parm: pointer[Param]) returns bool
    {
        if this.parse_group(1 << GT_NAME, decl_input_level, parm) = false
            return false
        let elems Array[pointer[ElementType]]^host()
        let nt parm.name_tokens
        let n nt.get_length()
        let buf nt.get_buffer()
        var i: size_t 0
        while i < n
        {
            let entry *(buf + i)
            elems.add(this.lookup_create_element(entry.name))
            set i: i + 1
        }
        set parm.elements: elems
        true
    }

    ; ---- parseExternalId (scoped) -----------------------------------------
    function parse_external_id(this: Parser, sysid_allow: pointer[AllowedParams], end_allow: pointer[AllowedParams], decl_input_level: u32, parm: pointer[Param], out_id: pointer[ExternalId]) returns bool
    {
        var has_public false
        var public_str String()
        if parm.kind = (P_RESERVED_NAME + R_PUBLIC)
        {
            let allow_min AllowedParams.a1(host, P_MINIMUMLITERAL)
            if this.parse_param(allow_min, decl_input_level, parm) = false
                return false
            set has_public: true
            set public_str: this.stringc_to_bytes(parm.literal_text.string())
        }
        if this.parse_param(sysid_allow, decl_input_level, parm) = false
            return false
        var has_system false
        var system_str String()
        if parm.kind = P_SYSTEMIDENTIFIER
        {
            set has_system: true
            set system_str: this.stringc_to_bytes(parm.literal_text.string())
            if this.parse_param(end_allow, decl_input_level, parm) = false
                return false
        }
        set *out_id: ExternalId(has_public, public_str, has_system, system_str)
        true
    }

    ; ---- parseElementDecl --------------------------------------------------
    function parse_element_decl(this: Parser) returns bool
    {
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        let allow_name_namegroup AllowedParams.a2(host, P_NAME, P_NAMEGROUP)
        if this.parse_param(allow_name_namegroup, decl_input_level, parm) = false
            return false

        var names Array[NameToken]^host()
        if parm.kind = P_NAMEGROUP
        {
            let src parm.name_tokens
            let n src.get_length()
            let buf src.get_buffer()
            var i: size_t 0
            while i < n
            {
                let ent *(buf + i)
                names.add(ent)
                set i: i + 1
            }
        }
        else
        {
            let loc ps.current_location()
            let nt NameToken(parm.token, parm.orig_token, loc)
            names.add(nt)
        }

        let allow_roc AllowedParams.a8(host, P_NUMBER, P_RESERVED_NAME + R_O, P_MINUS, P_RESERVED_NAME + R_CDATA, P_RESERVED_NAME + R_RCDATA, P_RESERVED_NAME + R_EMPTY, P_RESERVED_NAME + R_ANY, P_MODELGROUP)
        if this.parse_param(allow_roc, decl_input_level, parm) = false
            return false

        if parm.kind = P_NUMBER
        {
            ; DEFERRED: rank stems.
            this.err(50)
            return false
        }

        ; resolve element types.
        var elements Array[pointer[ElementType]]^host()
        let nn names.get_length()
        let nbuf names.get_buffer()
        var k: size_t 0
        while k < nn
        {
            let entry *(nbuf + k)
            let e this.lookup_create_element(entry.name)
            e.set_orig_name(entry.orig_name)
            elements.add(e)
            set k: k + 1
        }

        ; omitted-tag minimization.
        var omit_flags: u8 0
        if (parm.kind = P_MINUS) or (parm.kind = (P_RESERVED_NAME + R_O))
        {
            set omit_flags: OMIT_SPEC
            if parm.kind <> P_MINUS
                set omit_flags: omit_flags | OMIT_START
            let allow_omission AllowedParams.a2(host, P_RESERVED_NAME + R_O, P_MINUS)
            if this.parse_param(allow_omission, decl_input_level, parm) = false
                return false
            if parm.kind <> P_MINUS
                set omit_flags: omit_flags | OMIT_END
            let allow_content AllowedParams.a5(host, P_RESERVED_NAME + R_CDATA, P_RESERVED_NAME + R_RCDATA, P_RESERVED_NAME + R_EMPTY, P_RESERVED_NAME + R_ANY, P_MODELGROUP)
            if this.parse_param(allow_content, decl_input_level, parm) = false
                return false
        }

        let dtd ps.get_def_dtd()
        let loc ps.current_location()
        let allow_mdc AllowedParams.a1(host, P_MDC)
        var def: pointer[ElementDefinition] null

        if parm.kind = (P_RESERVED_NAME + R_CDATA)
        {
            set def: ElementDefinition.make(host, loc, dtd.alloc_element_definition_index(), omit_flags, DC_CDATA, false)
            if this.parse_param(allow_mdc, decl_input_level, parm) = false
                return false
        }
        else if parm.kind = (P_RESERVED_NAME + R_RCDATA)
        {
            set def: ElementDefinition.make(host, loc, dtd.alloc_element_definition_index(), omit_flags, DC_RCDATA, false)
            if this.parse_param(allow_mdc, decl_input_level, parm) = false
                return false
        }
        else if parm.kind = (P_RESERVED_NAME + R_EMPTY)
        {
            set def: ElementDefinition.make(host, loc, dtd.alloc_element_definition_index(), omit_flags, DC_EMPTY, false)
            if this.parse_param(allow_mdc, decl_input_level, parm) = false
                return false
        }
        else if parm.kind = (P_RESERVED_NAME + R_ANY)
        {
            set def: ElementDefinition.make(host, loc, dtd.alloc_element_definition_index(), omit_flags, DC_ANY, false)
            if this.parse_exceptions(decl_input_level, def) = false
                return false
        }
        else if parm.kind = P_MODELGROUP
        {
            let ambiguities ContentToken.new_amb_vec(host)
            var pcdata_unreachable false
            let compiled ContentToken.compile(host, parm.model_group, dtd.n_element_type_index(), ambiguities, &pcdata_unreachable)
            set def: ElementDefinition.make_with_model(host, loc, dtd.alloc_element_definition_index(), omit_flags, DC_MODEL_GROUP, compiled)
            if this.parse_exceptions(decl_input_level, def) = false
                return false
        }
        else
        {
            this.err(51)
            return false
        }

        def.compute_mode()

        var e_index: size_t 0
        let ecount elements.get_length()
        let ebuf elements.get_buffer()
        while e_index < ecount
        {
            let e *(ebuf + e_index)
            if e.get_definition() = null
                e.set_element_definition(def, e_index)
            set e_index: e_index + 1
        }
        true
    }

    ; parseExceptions(declInputLevel, def)
    function parse_exceptions(this: Parser, decl_input_level: u32, def: pointer[ElementDefinition]) returns bool
    {
        let parm Param.make(host)
        let allow_exc AllowedParams.a3(host, P_MDC, P_EXCLUSIONS, P_INCLUSIONS)
        if this.parse_param(allow_exc, decl_input_level, parm) = false
            return false
        if parm.kind = P_EXCLUSIONS
        {
            def.set_exclusions(parm.elements)
            let allow_inc AllowedParams.a2(host, P_MDC, P_INCLUSIONS)
            if this.parse_param(allow_inc, decl_input_level, parm) = false
                return false
        }
        if parm.kind = P_INCLUSIONS
        {
            def.set_inclusions(parm.elements)
            let allow_mdc AllowedParams.a1(host, P_MDC)
            if this.parse_param(allow_mdc, decl_input_level, parm) = false
                return false
        }
        true
    }

    ; ---- parseAttlistDecl (scoped: no Lpd/notation-fanout/afdr/events) ----
    function parse_attlist_decl(this: Parser) returns bool
    {
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        var attributed Array[pointer[void]]^host()
        var is_notation false
        if this.parse_attributed(decl_input_level, parm, &attributed, &is_notation) = false
            return false

        var defs Array[pointer[AttributeDefinition]]^host()
        var any_current false
        let allow_name AllowedParams.a1(host, P_NAME)
        if this.parse_param(allow_name, decl_input_level, parm) = false
            return false

        while parm.kind <> P_MDC
        {
            let attribute_name parm.token
            let orig_attribute_name parm.orig_token

            let declared_value this.parse_declared_value(decl_input_level, is_notation, parm)
            if declared_value = null
                return false

            var def: pointer[AttributeDefinition] null
            if this.parse_default_value(decl_input_level, is_notation, parm, attribute_name, declared_value, &def, &any_current) = false
                return false
            def.set_orig_name(orig_attribute_name)
            defs.add(def)

            let allow_name_mdc AllowedParams.a2(host, P_NAME, P_MDC)
            if this.parse_param(allow_name_mdc, decl_input_level, parm) = false
                return false
        }

        let dtd ps.get_def_dtd()
        let adl AttributeDefinitionList.make(host, dtd.alloc_attribute_definition_list_index())
        let nd defs.get_length()
        let dbuf defs.get_buffer()
        var i: size_t 0
        while i < nd
        {
            adl.append(*(dbuf + i))
            set i: i + 1
        }

        let na attributed.get_length()
        let abuf attributed.get_buffer()
        var j: size_t 0
        while j < na
        {
            let a *(abuf + j)
            if is_notation
            {
                let nt a as pointer[Notation]
                nt.set_attribute_def(adl)
            }
            else
            {
                let e a as pointer[ElementType]
                if e.get_attribute_def() = null
                    e.set_attribute_def(adl)
            }
            set j: j + 1
        }
        true
    }

    ; parseAttributed(declInputLevel, parm, attributed, isNotation) — scoped:
    ; NOTATION data-attributes + element (name / name group). ALL / IMPLICIT and
    ; the Lpd branches are deferred.
    function parse_attributed(this: Parser, decl_input_level: u32, parm: pointer[Param], attributed: pointer[Array[pointer[void]]], out_is_notation: pointer[bool]) returns bool
    {
        let ind_notation P_INDICATED_RESERVED_NAME + R_NOTATION
        let allow AllowedParams.a3(host, P_NAME, P_NAMEGROUP, ind_notation)
        if this.parse_param(allow, decl_input_level, parm) = false
        {
            set *out_is_notation: false
            return false
        }
        if parm.kind = ind_notation
        {
            set *out_is_notation: true
            let allow2 AllowedParams.a2(host, P_NAME, P_NAMEGROUP)
            if this.parse_param(allow2, decl_input_level, parm) = false
                return false
            if parm.kind = P_NAMEGROUP
            {
                let nt parm.name_tokens
                let n nt.get_length()
                let buf nt.get_buffer()
                var i: size_t 0
                while i < n
                {
                    let entry *(buf + i)
                    let nt_ptr this.lookup_create_notation(entry.name)
                    attributed.add(nt_ptr as pointer[void])
                    set i: i + 1
                }
            }
            else
            {
                let nt_ptr this.lookup_create_notation(parm.token)
                attributed.add(nt_ptr as pointer[void])
            }
        }
        else
        {
            set *out_is_notation: false
            if parm.kind = P_NAMEGROUP
            {
                let nt parm.name_tokens
                let n nt.get_length()
                let buf nt.get_buffer()
                var i: size_t 0
                while i < n
                {
                    let entry *(buf + i)
                    let el_ptr this.lookup_create_element(entry.name)
                    attributed.add(el_ptr as pointer[void])
                    set i: i + 1
                }
            }
            else
            {
                let el_ptr this.lookup_create_element(parm.token)
                attributed.add(el_ptr as pointer[void])
            }
        }
        true
    }

    ; parseDeclaredValue -> a DeclaredValue (null on failure). rDATA deferred.
    function parse_declared_value(this: Parser, decl_input_level: u32, is_notation: bool, parm: pointer[Param]) returns pointer[DeclaredValue]
    {
        var codes int[17]
        let cp codes as pointer[int]
        set *(cp + (0 as size_t)): P_RESERVED_NAME + R_CDATA
        set *(cp + (1 as size_t)): P_RESERVED_NAME + R_ENTITY
        set *(cp + (2 as size_t)): P_RESERVED_NAME + R_ENTITIES
        set *(cp + (3 as size_t)): P_RESERVED_NAME + R_ID
        set *(cp + (4 as size_t)): P_RESERVED_NAME + R_IDREF
        set *(cp + (5 as size_t)): P_RESERVED_NAME + R_IDREFS
        set *(cp + (6 as size_t)): P_RESERVED_NAME + R_NAME
        set *(cp + (7 as size_t)): P_RESERVED_NAME + R_NAMES
        set *(cp + (8 as size_t)): P_RESERVED_NAME + R_NMTOKEN
        set *(cp + (9 as size_t)): P_RESERVED_NAME + R_NMTOKENS
        set *(cp + (10 as size_t)): P_RESERVED_NAME + R_NUMBER
        set *(cp + (11 as size_t)): P_RESERVED_NAME + R_NUMBERS
        set *(cp + (12 as size_t)): P_RESERVED_NAME + R_NUTOKEN
        set *(cp + (13 as size_t)): P_RESERVED_NAME + R_NUTOKENS
        set *(cp + (14 as size_t)): P_RESERVED_NAME + R_NOTATION
        set *(cp + (15 as size_t)): P_NAMETOKENGROUP
        set *(cp + (16 as size_t)): P_RESERVED_NAME + R_DATA
        let allow AllowedParams.an(host, cp, 16)
        if this.parse_param(allow, decl_input_level, parm) = false
            return null

        let k parm.kind
        if k = (P_RESERVED_NAME + R_CDATA)
            return DeclaredValue.make_cdata(host)
        if k = (P_RESERVED_NAME + R_ENTITY)
            return DeclaredValue.make_entity(host, false)
        if k = (P_RESERVED_NAME + R_ENTITIES)
            return DeclaredValue.make_entity(host, true)
        if k = (P_RESERVED_NAME + R_ID)
            return DeclaredValue.make_id(host)
        if k = (P_RESERVED_NAME + R_IDREF)
            return DeclaredValue.make_idref(host, false)
        if k = (P_RESERVED_NAME + R_IDREFS)
            return DeclaredValue.make_idref(host, true)
        if k = (P_RESERVED_NAME + R_NAME)
            return DeclaredValue.make_tokenized(host, TT_NAME, false)
        if k = (P_RESERVED_NAME + R_NAMES)
            return DeclaredValue.make_tokenized(host, TT_NAME, true)
        if k = (P_RESERVED_NAME + R_NMTOKEN)
            return DeclaredValue.make_tokenized(host, TT_NAMETOKEN, false)
        if k = (P_RESERVED_NAME + R_NMTOKENS)
            return DeclaredValue.make_tokenized(host, TT_NAMETOKEN, true)
        if k = (P_RESERVED_NAME + R_NUMBER)
            return DeclaredValue.make_tokenized(host, TT_NUMBER, false)
        if k = (P_RESERVED_NAME + R_NUMBERS)
            return DeclaredValue.make_tokenized(host, TT_NUMBER, true)
        if k = (P_RESERVED_NAME + R_NUTOKEN)
            return DeclaredValue.make_tokenized(host, TT_NUMBERTOKEN, false)
        if k = (P_RESERVED_NAME + R_NUTOKENS)
            return DeclaredValue.make_tokenized(host, TT_NUMBERTOKEN, true)
        if k = (P_RESERVED_NAME + R_NOTATION)
        {
            let allow_ng AllowedParams.a1(host, P_NAMEGROUP)
            if this.parse_param(allow_ng, decl_input_level, parm) = false
                return null
            let group this.group_names(parm)
            return DeclaredValue.make_notation(host, group)
        }
        if k = P_NAMETOKENGROUP
        {
            let group this.group_names(parm)
            return DeclaredValue.make_name_token_group(host, group)
        }
        ; rDATA and anything else: deferred.
        this.err(52)
        null
    }

    function group_names(this: Parser, parm: pointer[Param]) returns pointer[Array[StringC]]
    {
        let out Array[StringC]^host()
        let nt parm.name_tokens
        let n nt.get_length()
        let buf nt.get_buffer()
        var i: size_t 0
        while i < n
        {
            let entry *(buf + i)
            out.add(entry.name)
            set i: i + 1
        }
        out
    }

    ; parseDefaultValue -> writes *out_def. scoped makeValue (pure part only).
    function parse_default_value(this: Parser, decl_input_level: u32, is_notation: bool, parm: pointer[Param], attribute_name: StringC, declared_value: pointer[DeclaredValue], out_def: pointer[pointer[AttributeDefinition]], any_current: pointer[bool]) returns bool
    {
        let ind_fixed P_INDICATED_RESERVED_NAME + R_FIXED
        let ind_required P_INDICATED_RESERVED_NAME + R_REQUIRED
        let ind_current P_INDICATED_RESERVED_NAME + R_CURRENT
        let ind_conref P_INDICATED_RESERVED_NAME + R_CONREF
        let ind_implied P_INDICATED_RESERVED_NAME + R_IMPLIED
        var lit_type: int P_ATTRIBUTEVALUELITERAL
        if declared_value.tokenized()
            set lit_type: P_TOKENIZEDATTRIBUTEVALUELITERAL
        let allow AllowedParams.a7(host, ind_fixed, ind_required, ind_current, ind_conref, ind_implied, P_ATTRIBUTEVALUE, lit_type)
        if this.parse_param(allow, decl_input_level, parm) = false
            return false

        let dtd ps.get_def_dtd()
        if parm.kind = ind_fixed
        {
            let allow_val AllowedParams.a2(host, P_ATTRIBUTEVALUE, lit_type)
            if this.parse_param(allow_val, decl_input_level, parm) = false
                return false
            let value this.make_attribute_value(declared_value, parm.literal_text)
            set *out_def: AttributeDefinition.make_fixed(host, attribute_name, declared_value, value)
        }
        else if (parm.kind = P_ATTRIBUTEVALUE) or (parm.kind = P_ATTRIBUTEVALUELITERAL) or (parm.kind = P_TOKENIZEDATTRIBUTEVALUELITERAL)
        {
            let value this.make_attribute_value(declared_value, parm.literal_text)
            set *out_def: AttributeDefinition.make_default(host, attribute_name, declared_value, value)
        }
        else if parm.kind = ind_required
            set *out_def: AttributeDefinition.make_required(host, attribute_name, declared_value)
        else if parm.kind = ind_current
        {
            set *any_current: true
            set *out_def: AttributeDefinition.make_current(host, attribute_name, declared_value, dtd.alloc_current_attribute_index())
        }
        else if parm.kind = ind_conref
            set *out_def: AttributeDefinition.make_conref(host, attribute_name, declared_value)
        else if parm.kind = ind_implied
            set *out_def: AttributeDefinition.make_implied(host, attribute_name, declared_value)
        else
        {
            this.err(53)
            return false
        }
        true
    }

    ; makeValue (pure part): CDATA -> cdata value; tokenized -> space-split value.
    ; Full normalisation/validation (category/length checks, allowed-value/entity/
    ; notation/id resolution) is deferred to instance parsing.
    function make_attribute_value(this: Parser, dv: pointer[DeclaredValue], text: pointer[Text]) returns pointer[AttributeValue]
    {
        if dv.tokenized() = false
            return AttributeValue.make_cdata(host, text)
        ; tokenized: NAMECASE-fold the value (general subst — TokenizedDeclaredValue
        ; ::makeTokenizedValue), then record the single-space separator positions.
        ; A default/fixed value is built here (not through set_value), so its fold
        ; happens here (e.g. an enumerated default `a` -> `A`).
        let raw text.string()
        let rn raw.get_size()
        if rn > (0 as size_t)
        {
            let syn ps.get_syntax()
            let fbuf host.allocate(rn * (4 as size_t), 4) as pointer[u32]
            var fi: size_t 0
            while fi < rn
            {
                set *(fbuf + fi): syn.fold(raw.get(fi))
                set fi: fi + 1
            }
            set *text: Text(StringC^host(fbuf, rn))
        }
        let sc text.string()
        let n sc.get_size()
        let space_index Array[size_t]^host()
        var i: size_t 0
        while i < n
        {
            if sc.get(i) = (0x20 as u32)
                space_index.add(i)
            set i: i + 1
        }
        AttributeValue.make_tokenized(host, text, space_index)
    }

    ; ---- parseNotationDecl -------------------------------------------------
    function parse_notation_decl(this: Parser) returns bool
    {
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        let allow_name AllowedParams.a1(host, P_NAME)
        if this.parse_param(allow_name, decl_input_level, parm) = false
            return false
        let nt this.lookup_create_notation(parm.token)
        let allow_pub_sys AllowedParams.a2(host, P_RESERVED_NAME + R_PUBLIC, P_RESERVED_NAME + R_SYSTEM)
        if this.parse_param(allow_pub_sys, decl_input_level, parm) = false
            return false
        let allow_sys_mdc AllowedParams.a2(host, P_SYSTEMIDENTIFIER, P_MDC)
        let allow_mdc AllowedParams.a1(host, P_MDC)
        var id ExternalId()
        if this.parse_external_id(allow_sys_mdc, allow_mdc, decl_input_level, parm, &id) = false
            return false
        if nt.is_defined() = false
            nt.set_external_id(id, ps.current_location())
        true
    }

    ; ---- parseEntityDecl ---------------------------------------------------
    function parse_entity_decl(this: Parser) returns bool
    {
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        let ind_default P_INDICATED_RESERVED_NAME + R_DEFAULT
        let allow_start AllowedParams.a3(host, P_ENTITYNAME, ind_default, P_PERO)
        if this.parse_param(allow_start, decl_input_level, parm) = false
            return false

        ; The entity name is captured NOW (parm.token is valid here and gets
        ; overwritten by the later text/MDC reads) by deep-copying it into a
        ; heap InternalEntity's name FIELD — the only `^host` form that lowers
        ; correctly (local/return forms mis-lower to empty/garbage).
        var is_parameter false
        var iep: pointer[InternalEntity] null
        if parm.kind = P_PERO
        {
            set is_parameter: true
            let allow_pen AllowedParams.a1(host, P_PARAMENTITYNAME)
            if this.parse_param(allow_pen, decl_input_level, parm) = false
                return false
            set iep: InternalEntity.make(host, parm.token, StringC(), DT_SGML)
        }
        else if parm.kind = P_ENTITYNAME
            set iep: InternalEntity.make(host, parm.token, StringC(), DT_SGML)
        else
            set iep: InternalEntity.make(host, StringC(), StringC(), DT_SGML)
        ; (indDEFAULT -> empty name, the default entity)
        let name iep.get_name()

        let allow_text AllowedParams.a8(host, P_PARAMLITERAL, P_RESERVED_NAME + R_CDATA, P_RESERVED_NAME + R_SDATA, P_RESERVED_NAME + R_PI, P_RESERVED_NAME + R_SYSTEM, P_RESERVED_NAME + R_PUBLIC, P_RESERVED_NAME + R_STARTTAG, P_RESERVED_NAME + R_ENDTAG)
        if this.parse_param(allow_text, decl_input_level, parm) = false
            return false

        if (parm.kind = (P_RESERVED_NAME + R_SYSTEM)) or (parm.kind = (P_RESERVED_NAME + R_PUBLIC))
            return this.parse_external_entity(name, is_parameter, decl_input_level, parm)

        var data_type: int DT_SGML
        if parm.kind = (P_RESERVED_NAME + R_CDATA)
            set data_type: DT_CDATA
        else if parm.kind = (P_RESERVED_NAME + R_SDATA)
            set data_type: DT_SDATA
        else if parm.kind = (P_RESERVED_NAME + R_PI)
            set data_type: DT_PI
        else if (parm.kind = (P_RESERVED_NAME + R_STARTTAG)) or (parm.kind = (P_RESERVED_NAME + R_ENDTAG))
        {
            ; DEFERRED: bracketed (STARTTAG/ENDTAG/MS/MD) entities.
            this.err(60)
            return false
        }

        if parm.kind <> P_PARAMLITERAL
        {
            let allow_pl AllowedParams.a1(host, P_PARAMLITERAL)
            if this.parse_param(allow_pl, decl_input_level, parm) = false
                return false
        }
        let lt parm.literal_text
        let text_sc lt.string()
        ; DEEP-COPY the replacement text onto the host page — like the name — so it
        ; does not alias the transient literal buffer (which later parsing reuses;
        ; a shallow store corrupted it to a later token by reference time).
        set iep.text: StringC^host(text_sc.data_ptr(), text_sc.get_size())

        let allow_mdc AllowedParams.a1(host, P_MDC)
        if this.parse_param(allow_mdc, decl_input_level, parm) = false
            return false

        set iep.data_type: data_type
        set iep.data_type: data_type
        let ent host.allocate(sizeof Entity, alignof Entity) as pointer[Entity]
        let iev *iep
        set *ent: Entity.Internal(iev)
        this.maybe_define_entity(ent, is_parameter)
        true
    }

    ; parseExternalEntity(name, isParameter, declInputLevel, parm)
    function parse_external_entity(this: Parser, name: StringC, is_parameter: bool, decl_input_level: u32, parm: pointer[Param]) returns bool
    {
        let allow_sys AllowedParams.a5(host, P_SYSTEMIDENTIFIER, P_RESERVED_NAME + R_CDATA, P_RESERVED_NAME + R_SDATA, P_RESERVED_NAME + R_NDATA, P_MDC)
        let allow_end AllowedParams.a3(host, P_RESERVED_NAME + R_CDATA, P_RESERVED_NAME + R_NDATA, P_MDC)
        var id ExternalId()
        if this.parse_external_id(allow_sys, allow_end, decl_input_level, parm, &id) = false
            return false

        if parm.kind = P_MDC
        {
            ; the entity is referenced LATER: pin its system/public id to the run
            ; page (ExternalId.make) — `id` still points into the literal buffer
            ; the next declaration reuses. Capture the CURRENT declaration base
            ; directory too (this <!ENTITY>'s file) so its relative system id
            ; resolves against the right directory when opened during content —
            ; by then the declaring file is off the input stack.
            let hid ExternalId.make(host, id)
            let hbase String^host(ps.get_decl_base_dir())
            let ent host.allocate(sizeof Entity, alignof Entity) as pointer[Entity]
            set *ent: Entity.ExternalText(ExternalTextEntity(name, *hid, hbase))
            this.maybe_define_entity(ent, is_parameter)
            return true
        }

        if parm.kind = (P_RESERVED_NAME + R_NDATA)
        {
            let allow_notname AllowedParams.a1(host, P_NAME)
            if this.parse_param(allow_notname, decl_input_level, parm) = false
                return false
            ; (notation reference recorded; ExternalDataEntity variant deferred)
            let allow_dso_mdc AllowedParams.a2(host, P_DSO, P_MDC)
            if this.parse_param(allow_dso_mdc, decl_input_level, parm) = false
                return false
            if parm.kind = P_DSO
            {
                ; DEFERRED: data-attribute spec on an external data entity.
                this.err(61)
                return false
            }
            ; DEFERRED: ExternalDataEntity (NDATA) entity object.
            this.err(62)
            return true
        }
        ; CDATA/SDATA external entities: deferred (data-entity events).
        this.err(63)
        true
    }

    ; maybeDefineEntity (scoped): insert into the def DTD (Lpd/defaulted/events/
    ; generateSystemId deferred).
    function maybe_define_entity(this: Parser, entity: pointer[Entity], is_parameter: bool)
    {
        let dtd ps.get_def_dtd()
        let name entity.get_name()
        if name.get_size() = (0 as size_t)
            dtd.set_default_entity(entity)
        else
            dtd.insert_entity(entity, is_parameter, false)
    }

    ; ---- parseShortrefDecl -------------------------------------------------
    function parse_shortref_decl(this: Parser) returns bool
    {
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        let allow_name AllowedParams.a1(host, P_NAME)
        if this.parse_param(allow_name, decl_input_level, parm) = false
            return false
        let map this.lookup_create_map(parm.token)
        if map.defined() = false
            map.set_def_location(ps.current_location())

        let allow_pl AllowedParams.a1(host, P_PARAMLITERAL)
        if this.parse_param(allow_pl, decl_input_level, parm) = false
            return false

        let dtd ps.get_def_dtd()
        let vec Array[StringC]^host()
        var running true
        while running
        {
            let delim parm.literal_text.string()
            let sr_index dtd.intern_shortref(delim)
            ; grow vec to sr_index+1
            while vec.get_length() <= sr_index
                vec.add(StringC())
            let allow_ent AllowedParams.a1(host, P_ENTITYNAME)
            if this.parse_param(allow_ent, decl_input_level, parm) = false
                return false
            vec.put(sr_index, parm.token)
            let allow_pl_mdc AllowedParams.a2(host, P_PARAMLITERAL, P_MDC)
            if this.parse_param(allow_pl_mdc, decl_input_level, parm) = false
                return false
            if parm.kind = P_MDC
                set running: false
        }
        map.set_name_map(vec)
        true
    }

    ; ---- parseDeclarationName (after MDO) ---------------------------------
    function parse_declaration_name(this: Parser, out_rn: pointer[int]) returns bool
    {
        ps.current_input().discard_initial()
        this.extend_name_token(this.namelen())
        let name this.name_folded()
        let rn this.lookup_reserved_name(name)
        if rn < 0
        {
            this.err(70)
            return false
        }
        set *out_rn: rn
        true
    }

    ; parseComment (parseCommon.cxx): read a comment body up to the closing COM
    ; (`--`). The markup capture is not wanted for ESIS; just consume the chars.
    ; tokenEe inside a comment is an error.
    function parse_comment(this: Parser, mode: int) returns bool
    {
        var running true
        var ok true
        while running
        {
            let token ps.get_token(mode)
            if token = tokenCom
                set running: false
            else if token = tokenEe
            {
                this.err(0)
                set ok: false
                set running: false
            }
            ; else: a comment character (already consumed by get_token) — continue
        }
        ok
    }

    ; parseProcessingInstruction (parseCommon.cxx): the PIO (`<?`) is already
    ; consumed; read chars in piMode up to the PIC (`?>` / `>`), accumulating the
    ; raw PI content, then queue a PI event. SgmlsEventHandler::pi emits it as
    ; `?` + data + RE. onsgmls treats an XML declaration (`<?xml ...?>`) as a
    ; perfectly ordinary PI — no special-casing.
    function parse_processing_instruction(this: Parser) returns bool
    {
        let loc ps.current_location()
        let buf Array[u32]^host()
        var running true
        var ok true
        while running
        {
            let token ps.get_token(piMode)
            if token = tokenPic
                set running: false
            else if token = tokenEe
            {
                ; processingInstructionEntityEnd
                this.err(0)
                set ok: false
                set running: false
            }
            else
            {
                ; tokenChar / tokenUnrecognized — accumulate the char(s).
                let ins ps.current_input()
                let ts ins.current_token_string()
                let m ts.get_size()
                var i: size_t 0
                while i < m
                {
                    buf.add(ts.get(i))
                    set i: i + 1
                }
            }
        }
        if ok
        {
            let cnt buf.get_length()
            var sc: StringC StringC()
            if cnt > (0 as size_t)
            {
                let cb host.allocate(cnt * (4 as size_t), 4) as pointer[u32]
                let src buf.get_buffer()
                var j: size_t 0
                while j < cnt
                {
                    set *(cb + j): *(src + j)
                    set j: j + 1
                }
                set sc: StringC^host(cb, cnt)
            }
            let ev Event.make_pi(host, sc, loc)
            ps.queue_event(ev)
        }
        ok
    }

    ; parseCommentDecl (parseDecl.cxx): a `<!-- ... -->` comment declaration. The
    ; opening MDO+COM (tokenMdoCom `<!--`) is already consumed; read the first
    ; comment body, then in mdMode allow whitespace / further comments before the
    ; closing MDC (`>`).
    function parse_comment_decl(this: Parser) returns bool
    {
        if this.parse_comment(comMode) = false
            return false
        var running true
        var ok true
        while running
        {
            let token ps.get_token(mdMode)
            if token = tokenS
            {
                ; whitespace between comments / before the MDC: skip
            }
            else if token = tokenCom
            {
                if this.parse_comment(comMode) = false
                {
                    set ok: false
                    set running: false
                }
            }
            else if token = tokenMdc
                set running: false
            else
            {
                ; tokenEe or an invalid token in a comment declaration.
                this.err(0)
                set ok: false
                set running: false
            }
        }
        ok
    }

    ; ---- doDeclSubset (scoped driver) -------------------------------------
    ; Drives a declaration subset (internal or external). `subset_level` is the
    ; input level the subset itself occupies (1 for the document's internal
    ; subset; the pushed entity's level for an external subset); an end-of-entity
    ; that pops BELOW that level ends the subset. `external` selects the external
    ; subset's termination (end-of-entity, no DSC). Returns 0 at end of subset.
    ; PIs / PE-refs / marked sections recover rather than resolving (deferred).
    function parse_decl_subset(this: Parser, subset_level: u32, external: bool) returns int
    {
        ps.set_current_mode(dsMode)
        var running true
        var rc: int 0
        while running
        {
            let token ps.get_token(ps.get_current_mode())
            let start_level ps.get_input_level()
            if token = tokenEe
            {
                ; end of an entity: pop it. When we drop below the subset's own
                ; level the subset is finished (an external subset ends here; a
                ; nested parameter entity just returns to the subset).
                ps.pop_input_stack()
                if ps.get_input_level() < subset_level
                    set running: false
            }
            else if token = tokenDsc
            {
                if external
                    this.decl_subset_recover(start_level)
                else
                    set running: false
            }
            else if token = tokenMdoCom
            {
                if this.parse_comment_decl() = false
                    this.decl_subset_recover(start_level)
            }
            else if token = tokenMdoNameStart
            {
                var decl_name: int 0
                if this.parse_declaration_name(&decl_name)
                {
                    var result false
                    if decl_name = R_ELEMENT
                        set result: this.parse_element_decl()
                    else if decl_name = R_ATTLIST
                        set result: this.parse_attlist_decl()
                    else if decl_name = R_ENTITY
                        set result: this.parse_entity_decl()
                    else if decl_name = R_NOTATION
                        set result: this.parse_notation_decl()
                    else if decl_name = R_SHORTREF
                        set result: this.parse_shortref_decl()
                    else
                    {
                        this.err(71)
                        set result: false
                    }
                    if result = false
                        this.decl_subset_recover(start_level)
                }
                else
                    this.decl_subset_recover(start_level)
            }
            else if token = tokenS
            {
                ; whitespace between declarations: skip
            }
            else if token = tokenMdoMdc
            {
                ; empty comment declaration: skip
            }
            else if token = tokenPio
            {
                ; a processing instruction in the declaration subset (doDeclSubset
                ; case tokenPio) — e.g. an external DTD that opens with `<?xml?>`.
                if this.parse_processing_instruction() = false
                    this.decl_subset_recover(start_level)
            }
            else if (token = tokenPeroNameStart) or (token = tokenPeroGrpo)
            {
                ; doDeclSubset case tokenPeroNameStart: a parameter-entity reference
                ; BETWEEN declarations -> dsReference stacks it; its tokens (whole
                ; declarations) then flow into this same loop, and the tokenEe arm
                ; above pops it when exhausted.
                if this.parse_parameter_entity_reference() = false
                    this.decl_subset_recover(start_level)
            }
            else
            {
                ; a stray character between declarations (doDeclSubset's
                ; tokenUnrecognized): if it is a non-SGML char (C0/DEL — sgmlChar
                ; in our scanner, so it reaches here) reportNonSgmlCharacter and
                ; break; otherwise declSubsetCharacter (the token spelling, quoted)
                ; — matching parseDecl.cxx:246. Then recover past it either way.
                let dc ps.current_input().current_char()
                let loc ps.current_input().token_start_location()
                if this.is_non_sgml_char(dc)
                    this.report_num_at(ParserMessages.nonSgmlCharacter(), dc as u64, loc)
                else
                {
                    ; currentToken() is the single unrecognized char (the scanner
                    ; leaves the token zero-length here, so build it from the char).
                    var cbuf u32[1]
                    set *(cbuf as pointer[u32]): dc
                    let tok StringC^host(cbuf as pointer[u32], 1 as size_t)
                    this.report1_at(ParserMessages.declSubsetCharacter(), tok, loc)
                }
                this.decl_subset_recover(start_level)
            }
        }
        rc
    }

    ; declSubsetRecover(startLevel) — skip to the next declaration boundary.
    function decl_subset_recover(this: Parser, start_level: u32)
    {
        var running true
        while running
        {
            let token ps.get_token(ps.get_current_mode())
            if token = tokenEe
            {
                if ps.get_input_level() <= start_level
                    set running: false
                else
                    ps.pop_input_stack()
            }
            else if (token = tokenMdoCom) or (token = tokenDsc) or (token = tokenMdoNameStart) or (token = tokenMdoMdc) or (token = tokenMdoDso) or (token = tokenMscMdc) or (token = tokenPio)
            {
                if ps.get_input_level() = start_level
                {
                    ps.current_input().unget_token()
                    set running: false
                }
            }
            else if token = tokenUnrecognized
            {
                ; consume one char to make progress.
                var advc ps.current_input().token_char()
                ps.current_input().end_token(1 as size_t)
            }
            else
            {
                ; other tokens already consumed; keep scanning.
            }
        }
    }

    ; ---- mode setup: install the recognizers the decl parser drives -------
    function install_recognizers(this: Parser, table: pointer[Array[PackedTokenInfo]])
    {
        let sdv *ps.get_sd()
        let synv *ps.get_syntax()
        var modes int[24]
        let mp modes as pointer[int]
        set *(mp + (0 as size_t)): dsMode
        set *(mp + (1 as size_t)): dsiMode
        set *(mp + (2 as size_t)): mdMode
        set *(mp + (3 as size_t)): mdMinusMode
        set *(mp + (4 as size_t)): mdPeroMode
        set *(mp + (5 as size_t)): grpMode
        set *(mp + (6 as size_t)): grpsufMode
        set *(mp + (7 as size_t)): plitMode
        set *(mp + (8 as size_t)): plitaMode
        set *(mp + (9 as size_t)): slitMode
        set *(mp + (10 as size_t)): slitaMode
        set *(mp + (11 as size_t)): mlitMode
        set *(mp + (12 as size_t)): mlitaMode
        set *(mp + (13 as size_t)): proMode
        set *(mp + (14 as size_t)): comMode
        set *(mp + (15 as size_t)): refMode
        ; Attribute-value-literal modes (modeUsedInProlog | modeUsedInInstance in
        ; the reference): an ATTLIST default value literal (`x CDATA "y"`) is a
        ; literal parsed DURING the declaration subset, so these must be present
        ; here, not only in the content-mode set. Without them parse_literal reads
        ; a null-recognizer tokenEe and the whole ATTLIST is dropped.
        set *(mp + (16 as size_t)): alitMode
        set *(mp + (17 as size_t)): alitaMode
        set *(mp + (18 as size_t)): aliteMode
        set *(mp + (19 as size_t)): talitMode
        set *(mp + (20 as size_t)): talitaMode
        set *(mp + (21 as size_t)): taliteMode
        ; piMode: a processing instruction (`<?...?>`) can appear in the prolog and
        ; in a declaration subset; parse_processing_instruction reads it in piMode.
        set *(mp + (22 as size_t)): piMode
        ; pliteMode: the `e` variant of the parameter-literal mode — parse_literal
        ; switches to it while an entity reference is open inside a param literal.
        set *(mp + (23 as size_t)): pliteMode
        var i: int 0
        while i < 24
        {
            let m *(mp + (i as size_t))
            let r Recognizer.build_recognizer(host, m, sdv, synv, table)
            ps.set_recognizer(m, r)
            set i: i + 1
        }
    }

    ; ======================================================================
    ; Instance / content parsing — Stage 4, Increment 1 (the well-formed path).
    ;
    ; Ports the core of parseInstance.cxx doContent: the token-dispatch loop that
    ; walks instance content, drives the ContentState transition automaton
    ; (already ported), and appends StartElement/EndElement/characterData events
    ; in document order. Scoped to the well-formed, explicit-markup case that the
    ; simplest corpus models and the self-test exercise.
    ;
    ; OMITTAG minimization (tryImplyTag imply loop — end- and start-tag omission)
    ; landed Stage 4 Inc 4; the speculative Undo/eventList rollback is still
    ; deferred (see try_imply_tag — unreachable for conforming documents).
    ; DEFERRED to later increments (each a distinct parseInstance.cxx region):
    ;  - tag MINIMIZATION: SHORTTAG empty start/end tags, NET, ranked elements,
    ;    group tags; the tryImplyTag undo rollback for invalid documents.
    ;  - attribute-spec parsing in start tags (parseAttributeSpec); events carry
    ;    no attribute payload yet — a start tag with an attribute spec is left
    ;    unconsumed (ungetToken) for the attribute increment.
    ;  - entity/character references in content, PIs, comments, marked sections,
    ;    shortref (handleShortref), CDATA/RCDATA special parse.
    ;  - ID/IDREF checking (checkIdrefs), inclusion/exclusion recovery, the RS/RE
    ;    record-boundary event semantics (Re/Rs are treated as ignorable seps).

    ; must this element's end tag be omitted (EMPTY content)? CONREF check
    ; deferred (needs the attribute list on the event).
    function must_omit_end(this: Parser, e: pointer[ElementType]) returns bool
    {
        let def e.get_definition()
        if def = null
            return false
        def.get_declared_content() = DC_EMPTY
    }

    ; ---- attribute-spec parsing (parseAttribute.cxx) ---------------------
    ; The quoted/unquoted attribute-value path. DEFERRED: SHORTTAG name-token
    ; minimization (handleAttributeNameToken), the data-attribute / newAttDef
    ; branch (undeclared attrs), recoverUnquoted recovery, piPasMode, Markup
    ; capture, and the full makeValue validation (folding/category/id/idref/
    ; entity/notation — see AttributeList.set_value).

    function parse_attribute_value_literal(this: Parser, lita: bool, out_text: pointer[Text]) returns bool
    {
        var m alitMode
        if lita
            set m: alitaMode
        this.parse_literal(m, false, out_text)
    }

    function parse_tokenized_attribute_value_literal(this: Parser, lita: bool, out_text: pointer[Text]) returns bool
    {
        var m talitMode
        if lita
            set m: talitaMode
        this.parse_literal(m, true, out_text)
    }

    ; parseAttributeParameter — read the next attribute-spec token, classify it,
    ; and skip separators. allow_vi permits a value-indicator (`=`).
    function parse_attribute_parameter(this: Parser, mode: int, allow_vi: bool, result: pointer[int], net: pointer[bool]) returns bool
    {
        var token ps.get_token(mode)
        while token = tokenS
            set token: ps.get_token(mode)
        if token = tokenEe
        {
            this.err(0)
            return false
        }
        else if (token = tokenEtago) or (token = tokenStago)
        {
            let ins ps.current_input()
            ins.unget_token()
            set *net: false
            set *result: APT_END
        }
        else if token = tokenNestc
        {
            ; NESTC (`/`) closes a net-enabling start tag. Under NETENABL IMMEDNET
            ; the NET (`>`) must immediately follow (`/>`): peek it and unget so
            ; do_content sees the tokenNet that closes the element. NETENABL ALL
            ; net-enables with no immediate requirement; NETENABL NO is illegal.
            let ne ps.get_sd().start_tag_net_enable()
            if ne = NET_ENABLE_NO
                this.err(0)
            else if ne = NET_ENABLE_IMMEDNET
            {
                if ps.get_token(econnetMode) <> tokenNet
                    this.err(0)
                ps.current_input().unget_token()
            }
            set *net: true
            set *result: APT_END
        }
        else if token = tokenTagc
        {
            set *net: false
            set *result: APT_END
        }
        else if token = tokenDsc
            set *result: APT_END
        else if token = tokenNameStart
        {
            this.extend_name_token(this.namelen())
            set *result: APT_NAME
        }
        else if (token = tokenDigit) or (token = tokenLcUcNmchar)
        {
            this.extend_name_token(this.namelen())
            set *result: APT_NAMETOKEN
        }
        else if (token = tokenLit) or (token = tokenLita)
        {
            this.err(0)
            return false
        }
        else if token = tokenVi
        {
            if allow_vi = false
            {
                this.err(0)
                return false
            }
            set *result: APT_VI
        }
        else
        {
            this.err(0)
            return false
        }
        true
    }

    ; parseAttributeValueSpec — after a VI, resolve the attribute and read its
    ; value (quoted literal, or an unquoted name token via SHORTTAG).
    ; `new_att_def` is the reference's `Ptr<AttributeDefinitionList> &newAttDef`:
    ; null until an undeclared attribute forces a private, grown copy of the
    ; element's definition list. It is threaded through the whole start tag (all
    ; its undeclared attributes append to the same copy) and installed on the
    ; element type by do_parse_start_tag.
    function parse_attribute_value_spec(this: Parser, mode: int, name: StringC, atts: pointer[AttributeList], spec_length: pointer[size_t], new_att_def: pointer[pointer[AttributeDefinitionList]]) returns bool
    {
        var token ps.get_token(mode)
        while token = tokenS
            set token: ps.get_token(mode)
        let idx atts.attribute_index(name)
        var index: size_t 0
        if idx < 0
        {
            ; An attribute no ATTLIST declares. Under IMPLYDEF ATTLIST (which
            ; enableImplydef turns on for a document with no DOCTYPE) it is not an
            ; error: it gets an implied CDATA definition appended to a COPY of the
            ; element's definition list. Because the copy is installed on the
            ; element type afterwards, a LATER occurrence of the same element finds
            ; the attribute declared — and if that occurrence omits it, ESIS reports
            ; `A <name> IMPLIED`, exactly as onsgmls does. (The data-attribute
            ; branch — an undeclared attribute in a NOTATION's spec — is deferred.)
            if ps.get_implydef_attlist() = false
            {
                ; noSuchAttribute
                this.err(0)
                return false
            }
            if *new_att_def = null
            {
                let cur atts.get_def()
                set *new_att_def: AttributeDefinitionList.copy(host, cur)
            }
            let nad *new_att_def
            let cdv DeclaredValue.make_cdata(host)
            let nd AttributeDefinition.make_implied(host, name, cdv)
            nad.append(nd)
            atts.change_def(host, nad)
            set index: atts.size() - (1 as size_t)
        }
        else
            set index: idx as size_t
        let ctx ps.get_attribute_context()
        atts.set_spec(index, ctx)
        let text host.allocate(sizeof Text, alignof Text) as pointer[Text]
        set *text: Text(StringC())
        var ok true
        if (token = tokenLit) or (token = tokenLita)
        {
            let lita token = tokenLita
            if atts.tokenized(index)
                set ok: this.parse_tokenized_attribute_value_literal(lita, text)
            else
                set ok: this.parse_attribute_value_literal(lita, text)
        }
        else if (token = tokenNameStart) or (token = tokenDigit) or (token = tokenLcUcNmchar)
        {
            ; unquoted (SHORTTAG) value — extend over name-token characters.
            ; Copy the token onto the run page: current_token_string's buffer is
            ; transient, and a CDATA value is stored verbatim (no fold-copy in
            ; set_value), so it would dangle and read as later token bytes.
            this.extend_name_token(this.namelen())
            let ins ps.current_input()
            let ts ins.current_token_string()
            set *text: Text(StringC^host(ts.data_ptr(), ts.get_size()))
        }
        else
        {
            this.err(0)
            return false
        }
        if ok = false
            return false
        let tlen (*text).size()
        set *spec_length: *spec_length + tlen
        atts.set_value(host, index, text, ctx)
    }

    ; handleAttributeNameToken (parseAttribute.cxx) — SHORTTAG attribute-name
    ; minimization: a bare token whose attribute name was omitted (`<content
    ; multiple optional>`). Resolve the attribute whose declared enumerated /
    ; notation / nametoken value set contains `token` and record it as that
    ; attribute's value. First-match; under WebSGML a non-unique token is an
    ; error. `token` is the already-folded current name.
    function handle_attribute_name_token(this: Parser, token: StringC, atts: pointer[AttributeList], spec_length: pointer[size_t]) returns bool
    {
        let idx atts.token_index(token)
        if idx < 0
        {
            ; noSuchAttributeToken — no attribute declares this value.
            this.err(0)
            return false
        }
        if ps.get_sd().www()
        {
            if atts.token_index_unique(token, idx) = false
            {
                ; attributeTokenNotUnique (WebSGML).
                this.err(0)
                return false
            }
        }
        let index idx as size_t
        ; attributeNameShorttag: OMITNAME disabled makes the shorthand illegal
        ; (the reference/scaly declarations enable it).
        if ps.get_sd().attribute_omit_name() = false
            this.err(0)
        let ctx ps.get_attribute_context()
        atts.set_spec(index, ctx)
        let text host.allocate(sizeof Text, alignof Text) as pointer[Text]
        set *text: Text(token)
        set *spec_length: *spec_length + token.get_size()
        atts.set_value(host, index, text, ctx)
    }

    ; parseAttributeSpec — the attribute-spec loop: (name VI value)* up to the
    ; close delimiter, then finish the list (fill defaults).
    function parse_attribute_spec(this: Parser, mode: int, atts: pointer[AttributeList], net: pointer[bool], new_att_def: pointer[pointer[AttributeDefinitionList]]) returns bool
    {
        var spec_length: size_t 0
        var cur_parm: int 0
        if this.parse_attribute_parameter(mode, false, &cur_parm, net) = false
            return false
        var running true
        var ok true
        while running
        {
            if cur_parm = APT_END
                set running: false
            else if cur_parm = APT_NAME
            {
                let nm this.name_folded()
                if this.parse_attribute_parameter(mode, true, &cur_parm, net) = false
                {
                    set ok: false
                    set running: false
                }
                else if cur_parm = APT_VI
                {
                    if this.parse_attribute_value_spec(mode, nm, atts, &spec_length, new_att_def) = false
                    {
                        set ok: false
                        set running: false
                    }
                    else if this.parse_attribute_parameter(mode, false, &cur_parm, net) = false
                    {
                        set ok: false
                        set running: false
                    }
                }
                else
                {
                    ; SHORTTAG name value shorthand: `nm` was a NAME not followed
                    ; by a VI, so it is a value with the attribute name omitted.
                    ; The lookahead parameter (cur_parm) is reused as-is.
                    if this.handle_attribute_name_token(nm, atts, &spec_length) = false
                    {
                        set ok: false
                        set running: false
                    }
                }
            }
            else if cur_parm = APT_NAMETOKEN
            {
                ; a NAMETOKEN can never be an attribute name -> always an omitted-
                ; name value; read the next parameter afterwards.
                let nt this.name_folded()
                if this.handle_attribute_name_token(nt, atts, &spec_length) = false
                {
                    set ok: false
                    set running: false
                }
                else if this.parse_attribute_parameter(mode, false, &cur_parm, net) = false
                {
                    set ok: false
                    set running: false
                }
            }
            else
            {
                ; a VI with no preceding name — genuine syntax error.
                this.err(0)
                set ok: false
                set running: false
            }
        }
        if ok = false
            return false
        let ctx ps.get_attribute_context()
        atts.finish(ctx)
        true
    }

    function do_parse_start_tag(this: Parser, out_net: pointer[bool]) returns pointer[Event]
    {
        let ins ps.current_input()
        ; markupLocation() — the STAGO of the start tag. do_content's get_token
        ; already consumed the STAGO+name-start token, so the scan cursor sits
        ; past it; the token's START location is the STAGO. This becomes the open
        ; element's start location (and the "start tag was here" aux); `loc` below
        ; (after the GI name) is the TAGC position elementNotAllowed reports at.
        let mloc ins.token_start_location()
        ins.discard_initial()
        this.extend_name_token(this.namelen())
        let name this.name_folded()
        let dtd ps.get_current_dtd()
        var e dtd.lookup_element_type(name)
        if e = null
        {
            let cs ps.get_content_state()
            let uloc ps.current_location()
            set e: cs.lookup_create_undefined_element(host, name, uloc, dtd, true)
        }
        let loc ps.current_location()
        let adl e.get_attribute_def()
        let atts AttributeList.make(host, adl)
        let ctx ps.get_attribute_context()
        var net false
        ; grown by an undeclared attribute (IMPLYDEF ATTLIST) — see
        ; parse_attribute_value_spec.
        var new_att_def: pointer[AttributeDefinitionList] null
        let close_token ps.get_token(tagMode)
        if close_token = tokenTagc
            atts.finish(ctx)
        else
        {
            ins.unget_token()
            let okatt this.parse_attribute_spec(tagMode, atts, &net, &new_att_def)
            ; parse_attribute_spec finishes the list (mirrors C++ parseAttributeSpec).
        }
        ; doParseStartTag: give the grown definition list its own DTD index and
        ; install it on the element type, so it survives this start tag.
        if new_att_def <> null
        {
            let didx dtd.alloc_attribute_definition_list_index()
            new_att_def.set_index(didx)
            e.set_attribute_def(new_att_def)
        }
        set *out_net: net
        let ev Event.make_start(host, e, loc)
        ev.set_markup_loc(mloc)
        ev.set_attributes(atts)
        ev
    }

    function parse_start_tag(this: Parser)
    {
        var net false
        let event this.do_parse_start_tag(&net)
        let e event.get_element_type()
        this.accept_start_tag(e, event, net)
    }

    ; tryImplyTag — one OMITTAG inference step at the current position. Either
    ; implies an END tag (current element finished + its end tag omissible: emit
    ; end, pop) or a START tag (a uniquely-required next element with an omissible
    ; start tag: advance the parent cursor, push the implied element). Returns
    ; true if a tag was implied (retry the pending token), false otherwise.
    ;
    ; SCOPE: events are queued DIRECTLY. The reference speculatively pushes onto
    ; Undo/eventList lists and rolls back (undo) when the implied chain fails to
    ; admit the pending token — that rollback is DEFERRED. It is unreachable for
    ; a conforming document: every implied tag on valid content leads to a
    ; successful transition, so nothing needs undoing. Invalid documents (whose
    ; expected exit is non-zero) may therefore diverge until the undo lands.
    function try_imply_tag(this: Parser, loc: Location, start_implied: pointer[u32]) returns bool
    {
        let cs ps.get_content_state()
        let ce cs.current_element()
        if ce.is_finished()
        {
            if cs.tag_level_of() = (0 as u32)
                return false
            let def ce.get_type().get_definition()
            if def <> null
                if def.can_omit_end_tag() = false
                    return false
            if *start_implied > (0 as u32)
                set *start_implied: *start_implied - (1 as u32)
            let e ce.get_type()
            ps.note_end_element(ce.get_included())
            let endev Event.make_end(host, e, loc)
            if ce.get_included()
                endev.set_included()
            ps.queue_event(endev)
            ps.pop_element_mode()
            return true
        }
        let e ce.implied_start_tag()
        if e = null
            return false
        ce.do_required_transition()
        ; (declared-content / canOmitStartTag / undefined diagnostics deferred)
        let adl e.get_attribute_def()
        let atts AttributeList.make(host, adl)
        let ctx ps.get_attribute_context()
        atts.finish(ctx)
        set *start_implied: *start_implied + (1 as u32)
        let stev Event.make_start(host, e, loc)
        stev.set_attributes(atts)
        this.push_element_check(e, stev, false)
        true
    }

    function accept_start_tag(this: Parser, e: pointer[ElementType], event: pointer[Event], net: bool)
    {
        let cs ps.get_content_state()
        let ce cs.current_element()
        if ce.try_transition(e)
        {
            this.push_element_check(e, event, net)
            return
        }
        if cs.element_is_included(e)
        {
            event.set_included()
            this.push_element_check(e, event, net)
            return
        }
        ; OMITTAG: imply end/start tags until e is admissible.
        var start_implied: u32 0
        var guard: int 0
        while this.try_imply_tag(event.get_loc(), &start_implied)
        {
            let cei cs.current_element()
            if cei.try_transition(e)
            {
                this.push_element_check(e, event, net)
                return
            }
            if cs.element_is_included(e)
            {
                event.set_included()
                this.push_element_check(e, event, net)
                return
            }
            set guard: guard + 1
            if guard > 100
                return
        }
        ; Not admissible even after minimization: elementNotAllowed
        ; (parseInstance.cxx). Reported at the start tag's location, then recover
        ; by forcing the transition and pushing so parsing continues (onsgmls
        ; likewise emits the start-element event and reads on).
        let ce3 cs.current_element()
        let gi e.get_name()
        let eloc event.get_loc()
        let mt_notallowed ParserMessages.elementNotAllowed()
        this.report1_at(mt_notallowed, gi, eloc)
        let discard ce3.try_transition(e)
        this.push_element_check(e, event, net)
    }

    function push_element_check(this: Parser, e: pointer[ElementType], event: pointer[Event], net: bool)
    {
        ps.note_start_element(event.is_included())
        if this.must_omit_end(e)
        {
            if ps.get_sd().empty_element_normal()
            {
                ; EMPTYNRM: emit start, then consume the empty-element tag's
                ; closing NET (`<x/>`) / end tag before implying the end.
                let included event.is_included()
                let sloc event.get_loc()
                ps.queue_event(event)
                this.end_tag_empty_element(e, net, included, sloc)
            }
            else
            {
                ; EMPTY element: emit start immediately followed by an implied end.
                ps.note_end_element(event.is_included())
                ps.queue_event(event)
                let endev Event.make_end(host, e, event.get_loc())
                if event.is_included()
                    endev.set_included()
                ps.queue_event(endev)
            }
            return
        }
        let cs ps.get_content_state()
        let ce cs.current_element()
        var map e.get_map()
        if map = null
            set map: ce.get_map()
        let oe OpenElement.make(host, e, net, event.is_included(), map, event.get_markup_loc())
        ps.push_element_mode(oe)
        ps.queue_event(event)
    }

    function parse_end_tag(this: Parser) returns pointer[Event]
    {
        let ins ps.current_input()
        ins.discard_initial()
        this.extend_name_token(this.namelen())
        let name this.name_folded()
        let dtd ps.get_current_dtd()
        let e dtd.lookup_element_type(name)
        let loc ps.current_location()
        let close_token ps.get_token(tagMode)
        if close_token <> tokenTagc
            ins.unget_token()
        if e = null
        {
            ; an end tag naming an UNDECLARED element: it is nowhere open, so
            ; onsgmls likewise reports elementNotOpen (with the folded GI) and
            ; drops the tag. Reported here since the null type reaches no
            ; acceptEndTag. Location is the end tag's (before its TAGC).
            let mt_notopen ParserMessages.elementNotOpen()
            this.report1_at(mt_notopen, name, loc)
            return null
        }
        Event.make_end(host, e, loc)
    }

    ; endTagEmptyElement (EMPTYNRM) — an EMPTY element's start tag is immediately
    ; followed by the tag that ends it: a NET (`<x/>`), an empty end tag (`</>`)
    ; or a matching `</x>`. Consume that token and emit the end; anything else
    ; is ungotten and the end implied. (Mismatch-recovery is scoped to the
    ; conforming corpus: an implied end at the start location.)
    function end_tag_empty_element(this: Parser, e: pointer[ElementType], net: bool, included: bool, start_loc: Location)
    {
        var m econMode
        if net
            set m: econnetMode
        let token ps.get_token(m)
        if (token = tokenNet) and net
        {
            let endev Event.make_end(host, e, ps.current_location())
            if included
                endev.set_included()
            ps.queue_event(endev)
            ps.note_end_element(included)
            return
        }
        if token = tokenEtagoTagc
        {
            let endev Event.make_end(host, e, ps.current_location())
            if included
                endev.set_included()
            ps.queue_event(endev)
            ps.note_end_element(included)
            return
        }
        if token = tokenEtagoNameStart
        {
            let end this.parse_end_tag()
            if (end <> null) and (end.get_element_type() = e)
            {
                if included
                    end.set_included()
                ps.queue_event(end)
                ps.note_end_element(included)
                return
            }
            ; the following end tag names a DIFFERENT element. If that element is
            ; open, this empty element's (implied) end comes first, then the end
            ; tag closes the enclosing element (endTagEmptyElement: implyEmptyElementEnd
            ; then acceptEndTag). Dropping it here (the old behavior) left the
            ; enclosing element to be closed at document end — a spurious
            ; omitEndTag/notFinished diagnostic. `parse_end_tag` already returns null
            ; (and reports elementNotOpen) for an UNDECLARED name.
            if end <> null
            {
                let cs ps.get_content_state()
                if cs.element_is_open(end.get_element_type())
                {
                    let endev2 Event.make_end(host, e, start_loc)
                    if included
                        endev2.set_included()
                    ps.queue_event(endev2)
                    ps.note_end_element(included)
                    this.accept_end_tag(end)
                    return
                }
                ; declared but not open: elementNotOpen, then imply this end.
                let mt_notopen ParserMessages.elementNotOpen()
                let gi_notopen end.get_element_type().get_name()
                this.report1_at(mt_notopen, gi_notopen, end.get_loc())
            }
            let endev4 Event.make_end(host, e, start_loc)
            if included
                endev4.set_included()
            ps.queue_event(endev4)
            ps.note_end_element(included)
            return
        }
        ; not the element's end: unget and imply the end at the start location.
        ps.current_input().unget_token()
        let endev3 Event.make_end(host, e, start_loc)
        if included
            endev3.set_included()
        ps.queue_event(endev3)
        ps.note_end_element(included)
    }

    ; implyCurrentElementEnd — emit an implied end for the current element and
    ; pop it (used when an end tag or document end closes elements above it whose
    ; own end tags were omitted). omitEndTag diagnostics deferred.
    function imply_current_element_end(this: Parser, loc: Location)
    {
        let cs ps.get_content_state()
        let ce cs.current_element()
        let e ce.get_type()
        ; implyCurrentElementEnd (parseInstance.cxx): an end tag is being OMITTED
        ; for the current element. If OMITTAG NO is in force it may never be
        ; omitted (omitEndTagOmittag); otherwise the element's declaration must
        ; permit omission (omitEndTagDeclare when it does not). Both carry a
        ; "start tag was here" auxiliary line at the element's start location.
        let gi_omit e.get_name()
        let start_here ce.get_start_location()
        if ps.get_sd().omittag() = false
        {
            let mt_omittag ParserMessages.omitEndTagOmittag()
            let aux_omittag ParserMessages.omitEndTagOmittag_aux()
            this.report1_aux(mt_omittag, gi_omit, loc, aux_omittag, start_here)
        }
        else
        {
            let def e.get_definition()
            if def <> null
                if def.can_omit_end_tag() = false
                {
                    let mt_declare ParserMessages.omitEndTagDeclare()
                    let aux_declare ParserMessages.omitEndTagDeclare_aux()
                    this.report1_aux(mt_declare, gi_omit, loc, aux_declare, start_here)
                }
        }
        ps.note_end_element(ce.get_included())
        let endev Event.make_end(host, e, loc)
        if ce.get_included()
            endev.set_included()
        ps.queue_event(endev)
        ps.pop_element_mode()
    }

    ; close the current element WITHOUT an omitted-end-tag diagnostic — used when
    ; the end is genuinely marked (a NET null end tag closing its net-enabling
    ; element), where onsgmls emits a real EndElementEvent via acceptEndTag rather
    ; than implyCurrentElementEnd.
    function close_current_element(this: Parser, loc: Location)
    {
        let cs ps.get_content_state()
        let ce cs.current_element()
        let e ce.get_type()
        ps.note_end_element(ce.get_included())
        let endev Event.make_end(host, e, loc)
        if ce.get_included()
            endev.set_included()
        ps.queue_event(endev)
        ps.pop_element_mode()
    }

    ; parseNullEndTag — a NET delimiter (`>` under the XML/scaly syntax) closes
    ; the nearest net-enabling element on the stack, implying ends of any
    ; INTERVENING open elements first (each via implyCurrentElementEnd, which
    ; complains if it is unfinished / may not be omitted). The net-enabling
    ; element itself is closed by a genuine (null) end tag — no omission
    ; diagnostic — but still elementEndTagNotFinished if its model is unsatisfied.
    function parse_null_end_tag(this: Parser)
    {
        let cs ps.get_content_state()
        var guard: int 0
        var running true
        while running and (cs.tag_level_of() > (0 as u32))
        {
            let ce cs.current_element()
            if ce.get_net_enabling()
            {
                if (ce.is_finished() = false) and ps.validate()
                {
                    let mt_endnotfin ParserMessages.elementEndTagNotFinished()
                    let gi_endnotfin ce.get_type().get_name()
                    this.report1(mt_endnotfin, gi_endnotfin)
                }
                this.close_current_element(ps.current_location())
                set running: false
            }
            else
            {
                if (ce.is_finished() = false) and ps.validate()
                {
                    let mt_notfin ParserMessages.elementNotFinished()
                    let gi_notfin ce.get_type().get_name()
                    this.report1(mt_notfin, gi_notfin)
                }
                this.imply_current_element_end(ps.current_location())
            }
            set guard: guard + 1
            if guard > 100000
                set running: false
        }
    }

    function accept_end_tag(this: Parser, event: pointer[Event])
    {
        if event = null
            return
        let e event.get_element_type()
        let cs ps.get_content_state()
        if cs.element_is_open(e) = false
        {
            ; a stray end tag naming an element that is nowhere open
            ; (acceptEndTag, parseInstance.cxx): elementNotOpen, drop the tag.
            ; Reported at the end tag's location (captured before its TAGC).
            let gi e.get_name()
            let eloc event.get_loc()
            let mt_notopen ParserMessages.elementNotOpen()
            this.report1_at(mt_notopen, gi, eloc)
            return
        }
        ; Close intervening open elements (OMITTAG end-tag omission) until the
        ; current element is the one this end tag names.
        var guard: int 0
        var running true
        while running
        {
            let ce cs.current_element()
            if ce.get_type() = e
                set running: false
            else
            {
                ; an intervening open element is being closed by omission: if its
                ; own content model is unsatisfied, elementNotFinished.
                if (ce.is_finished() = false) and ps.validate()
                {
                    let mt_notfin ParserMessages.elementNotFinished()
                    let gi_notfin ce.get_type().get_name()
                    this.report1_at(mt_notfin, gi_notfin, event.get_loc())
                }
                this.imply_current_element_end(event.get_loc())
                set guard: guard + 1
                if guard > 100000
                    return
            }
        }
        let cef cs.current_element()
        ; the named element itself: if its content model is unsatisfied at its
        ; explicit end tag, elementEndTagNotFinished.
        if (cef.is_finished() = false) and ps.validate()
        {
            let mt_endnotfin ParserMessages.elementEndTagNotFinished()
            let gi_endnotfin cef.get_type().get_name()
            this.report1_at(mt_endnotfin, gi_endnotfin, event.get_loc())
        }
        if cef.get_included()
            event.set_included()
        ps.note_end_element(event.is_included())
        ps.queue_event(event)
        ps.pop_element_mode()
    }

    function accept_pcdata(this: Parser, loc: Location)
    {
        let cs ps.get_content_state()
        let ce cs.current_element()
        if ce.try_transition_pcdata()
            return
        ; OMITTAG: imply end/start tags until #PCDATA is admissible.
        var start_implied: u32 0
        var guard: int 0
        while this.try_imply_tag(loc, &start_implied)
        {
            let cei cs.current_element()
            if cei.try_transition_pcdata()
                return
            set guard: guard + 1
            if guard > 100
                return
        }
        ; pcdataNotAllowed diagnostic + pcdataRecover deferred.
    }

    function parse_pcdata(this: Parser)
    {
        let ins ps.current_input()
        let ts ins.current_token_string()
        let loc ps.current_location()
        this.accept_pcdata(loc)
        ps.note_data()
        let ev Event.make_data(host, ts, loc)
        ps.queue_event(ev)
        ; reportNonSgmlCharacter (parseInstance.cxx): a non-SGML char in the data
        ; run is still emitted as data (onsgmls does the same) but reported at its
        ; own location. The token slice maps 1:1 onto [start_index, cur_index).
        this.check_non_sgml(ts, ins.get_origin(), ins.current_token_start_index())
    }

    ; a document character NOT in the SGML character set. The reference concrete
    ; syntax's non-SGML chars are the C0 controls other than TAB/RS/RE (9/10/13)
    ; plus DEL (127); xml.dcl agrees on this C0 range (chars >= 128 differ between
    ; declarations but do not occur in the corpus). Kept separate from
    ; Syntax.setSgmlChar (deliberately 0..U+FFFD so a stray decoded char stays
    ; DATA rather than aborting) — this predicate only drives the diagnostic.
    function is_non_sgml_char(this: Parser, c: u32) returns bool
    {
        if c <= (8 as u32)
            return true
        if (c = (11 as u32)) or (c = (12 as u32))
            return true
        if (c >= (14 as u32)) and (c <= (31 as u32))
            return true
        if c = (127 as u32)
            return true
        false
    }

    function check_non_sgml(this: Parser, ts: StringC, origin: pointer[Origin], start: size_t)
    {
        var i: size_t 0
        let n ts.get_size()
        let mt ParserMessages.nonSgmlCharacter()
        while i < n
        {
            let c ts.get(i)
            if this.is_non_sgml_char(c)
            {
                let cloc Location(origin, (start + i) as u32)
                this.report_num_at(mt, c as u64, cloc)
            }
            set i: i + 1
        }
    }

    ; reportNonSgmlCharacter over the SGML DECLARATION (parseSd.cxx). onsgmls
    ; reads the declaration through the same record machinery as the document
    ; and reports every non-SGML char it tokenizes up to the declaration-closing
    ; MDC (`>`) — INCLUDING chars inside `--…--` comments and quoted literals
    ; (verified against onsgmls 1.5.2); a trailing comment AFTER the MDC is never
    ; reached. Our SdParser is a scoped byte tokenizer with no report path, so
    ; this is a dedicated pass over the declaration's normalized buffer (pushed
    ; as the current input, so emit_message reads line/col + file from it). The
    ; comment/literal state is used ONLY to find the MDC: a `>` inside a literal
    ; (e.g. `NET ">"`) or a comment does not end the declaration.
    function scan_sd_non_sgml(this: Parser)
    {
        let ins ps.current_input()
        if ins = null
            return
        let origin ins.get_origin()
        let n ins.get_length()
        let mt ParserMessages.nonSgmlCharacter()
        var state: int 0
        var quote: u32 0
        var i: size_t 0
        while i < n
        {
            let c ins.char_at(i)
            if this.is_non_sgml_char(c)
                this.report_num_at(mt, c as u64, Location(origin, i as u32))
            if state = (0 as int)
            {
                if c = (0x3E as u32)
                    return
                else if (c = (0x22 as u32)) or (c = (0x27 as u32))
                {
                    set state: 1 as int
                    set quote: c
                }
                else if c = (0x2D as u32)
                {
                    if (i + (1 as size_t)) < n
                    {
                        if ins.char_at(i + (1 as size_t)) = (0x2D as u32)
                        {
                            set state: 2 as int
                            set i: i + (1 as size_t)
                        }
                    }
                }
            }
            else if state = (1 as int)
            {
                if c = quote
                    set state: 0 as int
            }
            else
            {
                if c = (0x2D as u32)
                {
                    if (i + (1 as size_t)) < n
                    {
                        if ins.char_at(i + (1 as size_t)) = (0x2D as u32)
                        {
                            set state: 0 as int
                            set i: i + (1 as size_t)
                        }
                    }
                }
            }
            set i: i + (1 as size_t)
        }
    }

    ; endAllElements (parseInstance.cxx:1118). Closes every still-open element,
    ; complaining about each one whose content model is unsatisfied, and then —
    ; once the stack is back down to the synthetic document-element container —
    ; complains if even THAT is unfinished, i.e. the document element never
    ; appeared. That last check is what makes a prolog-only document (a DOCTYPE
    ; and nothing else) non-conforming: `E: no document element`, exit 1, and an
    ; empty ESIS because the `C` marker is gated on conformance.
    function end_all_elements(this: Parser)
    {
        let cs ps.get_content_state()
        var running true
        while running
        {
            if cs.tag_level_of() = (0 as u32)
                set running: false
            else
            {
                let ce cs.current_element()
                if ce.is_finished() = false
                {
                    ; elementNotFinishedDocumentEnd (no validate() guard in the
                    ; reference) — the open element's content model is unsatisfied
                    ; at end of document. Reported at the current scan cursor.
                    let mt_docend ParserMessages.elementNotFinishedDocumentEnd()
                    let gi_docend ce.get_type().get_name()
                    this.report1(mt_docend, gi_docend)
                }
                ; implyCurrentElementEnd — closes it (and complains if its end tag
                ; may not be omitted here).
                this.imply_current_element_end(ps.current_location())
            }
        }
        let root cs.current_element()
        if root.is_finished() = false
            if ps.validate()
            {
                this.report0(ParserMessages.noDocumentElement())
            }
    }

    function end_instance(this: Parser)
    {
        this.end_all_elements()
        ; checkIdrefs + unclosed-marked-section cleanup deferred.
        ps.pop_input_stack()
    }

    ; parseMarkedSectionDeclStart (parseDecl.cxx) — after tokenMdoDso, read the
    ; status keywords up to the DSO that opens the section body, then enter the
    ; section: INCLUDE parses normally; CDATA/RCDATA/IGNORE switch to a special
    ; parse mode until the matching `]]>` (handleMarkedSectionEnd). A `<![` nested
    ; inside an already-special (ignored) section is itself ignored content.
    function parse_marked_section_decl_start(this: Parser) returns bool
    {
        if ps.get_marked_section_special_level() > (0 as u32)
        {
            ps.start_marked_section()
            return true
        }
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        var codes int[6]
        let cp codes as pointer[int]
        set *(cp + (0 as size_t)): P_DSO
        set *(cp + (1 as size_t)): P_RESERVED_NAME + R_CDATA
        set *(cp + (2 as size_t)): P_RESERVED_NAME + R_RCDATA
        set *(cp + (3 as size_t)): P_RESERVED_NAME + R_IGNORE
        set *(cp + (4 as size_t)): P_RESERVED_NAME + R_INCLUDE
        set *(cp + (5 as size_t)): P_RESERVED_NAME + R_TEMP
        let allow AllowedParams.an(host, cp, 6)
        if this.parse_param(allow, decl_input_level, parm) = false
            return false
        var status: int MS_INCLUDE
        var running true
        while running
        {
            if parm.kind = P_DSO
                set running: false
            else
            {
                if parm.kind = (P_RESERVED_NAME + R_CDATA)
                {
                    if status < MS_CDATA
                        set status: MS_CDATA
                }
                else if parm.kind = (P_RESERVED_NAME + R_RCDATA)
                {
                    if status < MS_RCDATA
                        set status: MS_RCDATA
                }
                else if parm.kind = (P_RESERVED_NAME + R_IGNORE)
                {
                    if status < MS_IGNORE
                        set status: MS_IGNORE
                }
                ; INCLUDE / TEMP: no status bump (include is the minimum).
                if this.parse_param(allow, decl_input_level, parm) = false
                    return false
            }
        }
        if status = MS_INCLUDE
            ps.start_marked_section()
        else if status = MS_CDATA
            ps.start_special_marked_section(cmsMode)
        else if status = MS_RCDATA
            ps.start_special_marked_section(rcmsMode)
        else
            ps.start_special_marked_section(imsMode)
        true
    }

    ; handleMarkedSectionEnd (parseDecl.cxx) — a `]]>`: close the innermost open
    ; marked section (the state machine restores the enclosing mode). The markup /
    ; ignored-chars events are not wanted for ESIS.
    function handle_marked_section_end(this: Parser)
    {
        if ps.get_marked_section_level() = (0 as u32)
            this.err(0)
        else
            ps.end_marked_section()
    }

    ; parseEntityReference (parseCommon.cxx, scoped): `&name;` in content. Read the
    ; entity name (NAMECASE ENTITY NO -> raw), consume the REFC, look it up, and
    ; push its text as a new input source (contentReference -> normalReference):
    ; an internal entity stacks its replacement text, an external text entity is
    ; opened from disk. Char-data (CDATA/SDATA/NDATA/subdoc) entities emit events
    ; instead of stacking and are deferred.
    ;
    ; Entity::checkEntlvl + checkNotOpen guard the two ways a reference can fail to
    ; terminate: nesting deeper than ENTLVL, and an entity that (transitively)
    ; references itself — the latter is caught by identity against the open input
    ; stack (ParserState.entity_is_open), so the entity's decl travels in the
    ; source's Origin.
    function parse_entity_reference(this: Parser) returns bool
    {
        let ins ps.current_input()
        let start_loc ps.current_location()
        ins.discard_initial()
        this.extend_name_token(this.namelen())
        let name ps.current_token^host()
        let dtd ps.get_current_dtd()
        var ent dtd.lookup_entity(false, name)
        ; consume the REFC (`;`) or record-end that terminates the reference.
        let refc ps.get_token(refMode)
        if ent = null
        {
            ; entityUndefined: not declared and no default entity. onsgmls reports
            ; it (exit 1) but keeps parsing, dropping the reference.
            if ps.get_sd().implydef_entity() = false
                this.err(86)
            return true
        }

        ; checkEntlvl: nesting deeper than ENTLVL is a diagnostic only — the entity
        ; is still stacked (C++ Entity::checkEntlvl messages and falls through; the
        ; document entity is not counted). Recursion stays bounded by checkNotOpen,
        ; which cannot let the same entity open twice.
        let entlvl ps.get_syntax().get_quantity(qENTLVL)
        if (ps.get_input_level() - (1 as u32)) = entlvl
            this.err(82)
        ; checkNotOpen: a recursive entity reference.
        if ps.entity_is_open(ent as pointer[void])
        {
            this.err(83)
            return true
        }

        let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org: Origin(start_loc, ent as pointer[void])
        choose *ent
            when i: Internal
            {
                let itext i.get_text()
                let isrc host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
                set *isrc: InputSource(org, itext.data_ptr(), itext.get_size())
                ps.push_input(isrc)
            }
            when e: ExternalText
            {
                ; ExternalTextEntity::normalReference — open the effective system
                ; id (resolved against the document's directory) and stack it. An
                ; external TEXT entity produces NO ESIS event: its content is
                ; included inline (only external DATA entities emit `&name`).
                let id e.get_external_id()
                if id.has_system_id() = false
                {
                    ; nonExistentEntityRef (no system id to open).
                    this.err(84)
                    return true
                }
                let ebase e.get_base_dir()
                let esys id.get_system_id()
                let esrc this.open_external_text(ebase, esys, org)
                if esrc = null
                {
                    ; the entity's file could not be opened.
                    this.err(85)
                    return true
                }
                ps.push_input(esrc)
            }
        true
    }

    ; parseEntityReference(isParameter=1) (parseCommon.cxx:428) + the declReference/
    ; dsReference push (entity.cxx). A `%name;` parameter-entity reference inside
    ; a markup declaration or the declaration subset: look the PE up, then STACK
    ; its replacement text as an InputSource so its tokens flow transparently into
    ; the running parse. The enclosing loop's tokenEe arm pops it when exhausted —
    ; EXACTLY the general-entity content path (parse_entity_reference above), only
    ; with is_parameter=true. The target DTDs are EXTERNAL, where PE references
    ; inside declarations are allowed. Only internal TEXT entities occur here (a
    ; PE with an external / non-text body is not exercised by the corpus).
    function parse_parameter_entity_reference(this: Parser) returns bool
    {
        let ins ps.current_input()
        let start_loc ps.current_location()
        ; discard_initial drops the PERO (`%`); the name grows over name chars.
        ; extend_name_token's length limit is deferred (penamelen == namelen - the
        ; PERO length, but the limit is never enforced), so namelen is exact here.
        ins.discard_initial()
        this.extend_name_token(this.namelen())
        let name ps.current_token^host()
        let dtd ps.get_current_dtd()
        var ent dtd.lookup_entity(true, name)
        ; consume the REFC (`;`) or record-end that terminates the reference.
        let refc ps.get_token(refMode)
        if ent = null
        {
            ; parameterEntityUndefined — reported (exit 1), reference dropped.
            this.err(87)
            return true
        }

        ; checkEntlvl: nesting deeper than ENTLVL is a diagnostic only.
        let entlvl ps.get_syntax().get_quantity(qENTLVL)
        if (ps.get_input_level() - (1 as u32)) = entlvl
            this.err(82)
        ; checkNotOpen: a recursive parameter-entity reference.
        if ps.entity_is_open(ent as pointer[void])
        {
            this.err(83)
            return true
        }

        let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org: Origin(start_loc, ent as pointer[void])
        choose *ent
            when i: Internal
            {
                let itext i.get_text()
                let isrc host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
                set *isrc: InputSource(org, itext.data_ptr(), itext.get_size())
                ps.push_input(isrc)
            }
            when e: ExternalText
            {
                let id e.get_external_id()
                if id.has_system_id() = false
                {
                    this.err(84)
                    return true
                }
                let ebase e.get_base_dir()
                let esys id.get_system_id()
                let esrc this.open_external_text(ebase, esys, org)
                if esrc = null
                {
                    this.err(85)
                    return true
                }
                ps.push_input(esrc)
            }
        true
    }

    ; parseNumericCharRef (parseCommon.cxx, scoped): a decimal `&#NN;` reference
    ; in content -> the referenced Char (returned via out_ch). discard_initial
    ; drops the CRO; extend_number grows the digits; the digits fold to a value;
    ; the REFC (`;`) or record-end terminating the reference is consumed. HEX
    ; refs (`&#xNN;`), charset/non-SGML validation and the markup capture are
    ; deferred (the corpus's char refs are decimal into ASCII, e.g. `&#60;`=`<`).
    function parse_numeric_char_ref(this: Parser, out_ch: pointer[u32]) returns bool
    {
        let ins ps.current_input()
        ins.discard_initial()
        this.extend_number(this.namelen())
        let tok ps.current_token()
        let n tok.get_size()
        var c: u32 0
        var i: size_t 0
        while i < n
        {
            let d tok.get(i) - (0x30 as u32)
            set c: c * (10 as u32) + d
            set i: i + 1
        }
        set *out_ch: c
        let refc ps.get_token(refMode)
        true
    }

    ; doContent — the instance token-dispatch loop (well-formed subset).
    function do_content(this: Parser)
    {
        var running true
        while running
        {
            ; doContent (parseInstance.cxx): the error limit was reached — STOP
            ; without closing the open elements or ending the instance. onsgmls
            ; truncates the ESIS here (no closing tags, no conformance marker).
            if ps.is_cancelled()
                return
            let token ps.get_token(ps.get_current_mode())
            if token = tokenEe
            {
                if ps.get_input_level() <= (1 as u32)
                {
                    this.end_instance()
                    set running: false
                }
                else
                    ps.pop_input_stack()
            }
            else if (token = tokenEroNameStart) or (token = tokenEroGrpo)
                this.parse_entity_reference()
            else if token = tokenNet
                this.parse_null_end_tag()
            else if (token = tokenCroDigit) or (token = tokenHcroHexDigit)
            {
                let loc ps.current_location()
                var ch: u32 0
                if this.parse_numeric_char_ref(&ch)
                {
                    this.accept_pcdata(loc)
                    ps.note_data()
                    let scp StringC^host(&ch, 1 as size_t)
                    let cev Event.make_data(host, *scp, loc)
                    ps.queue_event(cev)
                }
            }
            else if token = tokenStagoNameStart
                this.parse_start_tag()
            else if token = tokenEtagoNameStart
            {
                let ee this.parse_end_tag()
                this.accept_end_tag(ee)
            }
            else if token = tokenMdoCom
            {
                ; a comment declaration in the instance (doContent): markup, no
                ; event — the data on either side of it is ONE data run.
                this.parse_comment_decl()
                ps.note_markup()
            }
            else if token = tokenMdoMdc
            {
                ; the empty comment declaration `<!>` (emptyCommentDecl).
                ps.note_markup()
            }
            else if token = tokenMdoDso
            {
                this.parse_marked_section_decl_start()
                ps.note_markup()
            }
            else if token = tokenMscMdc
            {
                this.handle_marked_section_end()
                ps.note_markup()
            }
            else if token = tokenRe
            {
                this.accept_pcdata(ps.current_location())
                ps.queue_re()
            }
            else if token = tokenRs
            {
                this.accept_pcdata(ps.current_location())
                ps.note_rs()
            }
            else if token = tokenChar
                this.parse_pcdata()
            else if token = tokenCharDelim
                this.parse_pcdata()
            else if token = tokenIgnoredChar
                ; content of an IGNORE marked section: extend + discard.
                set running: running
            else if token = tokenPio
            {
                ; a processing instruction in content (doContent case tokenPio).
                this.parse_processing_instruction()
                ps.note_markup()
            }
            else if token = tokenS
                set running: running
            else
                ; Unhandled token in this increment (PIs, comments, shortref,
                ; empty/net/group tags, char refs). Bail rather than risk a
                ; non-advancing loop; later increments handle these.
                set running: false
        }
    }

    ; install the content-mode recognizers doContent drives (in addition to the
    ; declaration/prolog modes install_recognizers builds). Kept separate so the
    ; declaration-parser path stays byte-identical.
    function install_content_recognizers(this: Parser, table: pointer[Array[PackedTokenInfo]])
    {
        let sdv *ps.get_sd()
        let synv *ps.get_syntax()
        var modes int[17]
        let mp modes as pointer[int]
        set *(mp + (0 as size_t)): econMode
        set *(mp + (1 as size_t)): econnetMode
        set *(mp + (2 as size_t)): mconMode
        set *(mp + (3 as size_t)): mconnetMode
        set *(mp + (4 as size_t)): tagMode
        set *(mp + (5 as size_t)): cconMode
        set *(mp + (6 as size_t)): rcconMode
        set *(mp + (7 as size_t)): alitMode
        set *(mp + (8 as size_t)): alitaMode
        set *(mp + (9 as size_t)): talitMode
        set *(mp + (10 as size_t)): talitaMode
        set *(mp + (11 as size_t)): imsMode
        set *(mp + (12 as size_t)): cmsMode
        set *(mp + (13 as size_t)): rcmsMode
        set *(mp + (14 as size_t)): refMode
        set *(mp + (15 as size_t)): rcconeMode
        ; piMode: processing instructions in content (doContent case tokenPio).
        set *(mp + (16 as size_t)): piMode
        ; the `e` (in-entity) literal variants: an attribute value in the instance
        ; can reference an entity (`x="&quot;..."`); parse_literal switches to the
        ; matching e-mode while the entity is open, so a `"` in the replacement is
        ; data, not the literal close. Without these installed, get_token(e-mode)
        ; would run to EOF (a null recognizer returns tokenChar forever).
        set *(mp + (17 as size_t)): aliteMode
        set *(mp + (18 as size_t)): taliteMode
        set *(mp + (19 as size_t)): pliteMode
        var i: int 0
        while i < 20
        {
            let m *(mp + (i as size_t))
            let r Recognizer.build_recognizer(host, m, sdv, synv, table)
            ps.set_recognizer(m, r)
            set i: i + 1
        }
    }

    ; ======================================================================
    ; Prolog + full-document driver — Stage 4, Increment 3 (external subset: 6).
    ;
    ; A SCOPED port of doProlog + parseDoctypeDeclStart (Parser.cs): drives the
    ; document from the first token through the DOCTYPE declaration into content
    ; parsing, so a whole SGML document parses end-to-end and the event queue
    ; feeds the ESIS writer (Esis.write) — the tests/sgml corpus harness. Handles
    ; both an INTERNAL DTD subset (`<!DOCTYPE name [ ... ]>`) and an EXTERNAL one
    ; (`<!DOCTYPE name SYSTEM "sub.dtd">` / `PUBLIC "..." "sub.dtd"`), resolved
    ; relative to the document's base directory.
    ;
    ; DEFERRED: catalog resolution of a PUBLIC id with no system id
    ; (generateSystemId), an implied DTD from the first start tag (implyDtd),
    ; LINKTYPE, prolog PIs/comments, the startDtd/endProlog markup events.

    ; Build an InputSource from raw entity bytes: DECODE them as UTF-8 to Chars and
    ; apply the `lf` record normalization, so declaration-subset whitespace
    ; tokenizes as separators. The Char buffer lives on `host`.
    ;
    ; RECORD NORMALIZATION (ExtendEntityManager.cxx, ExternalInputSource::fill +
    ; init): a source's records are RS-delimited. `insertRS_` starts TRUE for EVERY
    ; external input source — the document entity, the external DTD subset AND a
    ; text entity included in content — and is re-armed after every record end, so
    ; the Char stream is
    ;
    ;     RS line1 RE RS line2 RE RS line3 ...
    ;
    ; i.e. one RS (0x0A) before the first record, each source LF (0x0A) translated
    ; to RE (0x0D), and one RS inserted before the NEXT char after each RE. A
    ; pending RS at end of entity is dropped (fill returns eE without flushing it),
    ; so a file ending in a newline ends with RE, not RE RS.
    ;
    ; That is the `lf` RECORD TYPE. The reference DETECTS the type per entity from
    ; its first CR/LF (recordType_ starts `unknown`), and the three types reach the
    ; same RE-RS shape by different routes — note that RS *is* LF and RE *is* CR:
    ;   lf     LF -> RE, an RS is INSERTED after it        (Unix)
    ;   crlf   CR already IS the RE, LF already IS the RS  (Windows) — nothing is
    ;          translated or inserted at all; a final LF at end of entity is dropped
    ;          (the reference deletes the RS "not followed by anything"), so a CRLF
    ;          file also ends with RE.
    ;   cr     CR already IS the RE, an RS is INSERTED     (classic Mac)
    ; A source with no CR and no LF at all is `asis`: no records, nothing inserted
    ; but the leading RS. Getting this wrong on a CRLF file emits RE RE RS per line
    ; (the CR passing through as a second record end).
    ;
    ; The inserted RSs are load-bearing under KEEPRSRE YES (xml.dcl): RS and RE are
    ; then ordinary DATA chars, and onsgmls prints them in ESIS as `\012` and `\n`
    ; respectively (SgmlsEventHandler::outputString) — so `x<LF>y` in mixed content
    ; is the data `x` RE RS `y`. Under KEEPRSRE NO they tokenize as tokenRs and the
    ; OutputState machine drops them.
    ;
    ; onsgmls under SP_ENCODING=XML decodes EVERY entity as UTF-8 (XMLCodingSystem
    ; -> UTF8CodingSystem): a well-formed sequence yields its Char, a byte that
    ; cannot start or continue one yields U+FFFD and is consumed ALONE (so a
    ; Latin-1 `ü` in an otherwise-ASCII file becomes exactly one U+FFFD and the
    ; following chars still scan normally), and a leading BOM is stripped. That
    ; U+FFFD is the only Char >= 256 the corpus produces; see Partition's high-char
    ; slot for how it stays a DATA char rather than colliding with the eE sentinel.
    ;
    ; Continuation bytes are all >= 0x80, so no multibyte sequence can hide an LF —
    ; the record normalization stays correct after decoding.
    function make_char_source(host: pointer[Page], bytes: String, org: pointer[Origin]) returns pointer[InputSource]
    {
        let n bytes.get_length()
        ; upper bound: at most one Char per input byte (multibyte sequences only
        ; ever shrink) plus its inserted RS (an all-LF source doubles), + slack.
        let buf host.allocate(((n * (2 as size_t)) + (2 as size_t)) * (4 as size_t), 4) as pointer[u32]
        var out: size_t 0
        ; the leading RS: armed at entity start, flushed before the first Char.
        var pending_rs true

        var i: size_t 0
        ; strip a leading UTF-8 BOM (EF BB BF).
        if n >= (3 as size_t)
        {
            if bytes.get(0 as size_t) = (0xEF as u8)
            {
                if bytes.get(1 as size_t) = (0xBB as u8)
                {
                    if bytes.get(2 as size_t) = (0xBF as u8)
                        set i: 3 as size_t
                }
            }
        }

        ; recordType_: the first CR or LF in the entity decides it (CR and LF are
        ; ASCII, so the raw bytes answer this — no multibyte sequence can hide one).
        var rt: int RT_ASIS
        var s i
        while s < n
        {
            let b bytes.get(s) as u32
            if b = (0x0A as u32)
            {
                set rt: RT_LF
                set s: n
            }
            else if b = (0x0D as u32)
            {
                ; a CR with nothing after it is the reference's crUnknown -> cr.
                set rt: RT_CR
                if (s + (1 as size_t)) < n
                {
                    let b2 bytes.get(s + (1 as size_t)) as u32
                    if b2 = (0x0A as u32)
                        set rt: RT_CRLF
                }
                set s: n
            }
            else
                set s: s + (1 as size_t)
        }

        while i < n
        {
            let b0 bytes.get(i) as u32
            ; default: an invalid byte decodes to U+FFFD and consumes just itself.
            var ch: u32 0xFFFD as u32
            var len: size_t 1
            if b0 < (0x80 as u32)
            {
                set ch: b0
            }
            else
            {
                ; lead byte -> how many continuations follow, and its payload bits.
                ; 0xC0/0xC1 (overlong) and > 0xF4 (out of range) are not leads.
                var need: size_t 0
                var acc: u32 0
                if b0 >= (0xC2 as u32)
                {
                    if b0 <= (0xDF as u32)
                    {
                        set need: 1 as size_t
                        set acc: b0 & (0x1F as u32)
                    }
                }
                if b0 >= (0xE0 as u32)
                {
                    if b0 <= (0xEF as u32)
                    {
                        set need: 2 as size_t
                        set acc: b0 & (0x0F as u32)
                    }
                }
                if b0 >= (0xF0 as u32)
                {
                    if b0 <= (0xF4 as u32)
                    {
                        set need: 3 as size_t
                        set acc: b0 & (0x07 as u32)
                    }
                }
                if need > (0 as size_t)
                {
                    var ok true
                    var k: size_t 1
                    while k <= need
                    {
                        if (i + k) >= n
                            set ok: false
                        else
                        {
                            let bc bytes.get(i + k) as u32
                            if (bc & (0xC0 as u32)) <> (0x80 as u32)
                                set ok: false
                            else
                                set acc: (acc << (6 as u32)) | (bc & (0x3F as u32))
                        }
                        set k: k + 1
                    }
                    if ok
                    {
                        set ch: acc
                        set len: need + (1 as size_t)
                    }
                }
            }
            ; flush the RS armed by the entity start / the previous record end.
            if pending_rs
            {
                set *(buf + out): 0x0A as u32
                set out: out + (1 as size_t)
                set pending_rs: false
            }
            ; the record end, per record type. `lf`: the LF becomes RE and arms the
            ; next record's RS (which stays unflushed — and so is dropped — at end
            ; of entity). `cr`: the CR already IS the RE, it only arms the RS.
            ; `crlf` / `asis`: nothing — CR and LF are already RE and RS.
            if rt = RT_LF
            {
                if ch = (0x0A as u32)
                {
                    set ch: 0x0D as u32
                    set pending_rs: true
                }
            }
            else if rt = RT_CR
            {
                if ch = (0x0D as u32)
                    set pending_rs: true
            }
            set *(buf + out): ch
            set out: out + (1 as size_t)
            set i: i + len
        }

        ; crlf: "Need to delete final RS if not followed by anything" — a source
        ; ending in CRLF ends with the RE, like every other record type.
        if rt = RT_CRLF
        {
            if out > (0 as size_t)
            {
                if *(buf + (out - (1 as size_t))) = (0x0A as u32)
                    set out: out - (1 as size_t)
            }
        }

        let src host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
        set *src: InputSource(org, buf, out)
        src
    }

    ; Load an external DTD subset named by a system id, resolved relative to the
    ; document's base directory (Storage.OsFile), into an InputSource (not yet
    ; pushed). Returns null if the file is missing / empty.
    function load_external_subset(this: Parser, base_dir: String, system_id: String) returns pointer[InputSource]
    {
        let storage Storage.OsFile(base_dir)
        let bytes storage.read(system_id)
        if bytes.get_length() = (0 as size_t)
            return null
        let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org: Origin()
        Parser.make_char_source(host, bytes, org)
    }

    ; EntityManager::open for an external TEXT entity: resolve its (relative)
    ; system id against `base_dir` (the directory of the file the entity was
    ; DECLARED in — see ExternalTextEntity.base_dir) and decode the file into an
    ; InputSource carrying `org` (whose entity_decl arms the recursion guard). The
    ; SAME record normalization as the document entity applies — an included text
    ; entity is an external input source like any other. Null if not readable.
    function open_external_text(this: Parser, base_dir: String, system_id: String, org: pointer[Origin]) returns pointer[InputSource]
    {
        let storage Storage.OsFile(base_dir)
        let bytes storage.read(system_id)
        if bytes.get_length() = (0 as size_t)
            return null
        Parser.make_char_source(host, bytes, org)
    }

    ; ParserState::startDtd's PredefinedEntity loop: every entity the SGML
    ; declaration's SYNTAX ENTITIES section names (xml.dcl: "amp" 38, "lt" 60,
    ; "gt" 62, "quot" 34, "apos" 39) is inserted into the new DTD as an internal
    ; text entity whose replacement text is that one Char. `&lt;` in content then
    ; resolves through the ordinary entity path. The reference declaration names
    ; none, so a catalog-less document is unaffected.
    function insert_predefined_entities(this: Parser, dtd: pointer[Dtd])
    {
        let syn ps.get_syntax()
        let n syn.n_entities()
        var i: size_t 0
        while i < n
        {
            var ch: u32 0
            set ch: syn.entity_char(i)
            let nm syn.entity_name(i)
            let text StringC^host(&ch, 1 as size_t)
            let iep InternalEntity.make(host, nm, text, DT_SGML)
            let iev *iep
            let ent host.allocate(sizeof Entity, alignof Entity) as pointer[Entity]
            set *ent: Entity.Internal(iev)
            dtd.insert_entity(ent, false, false)
            set i: i + 1
        }
    }

    ; parseDoctypeDeclStart (scoped): name -> def/current Dtd; an optional external
    ; identifier (PUBLIC/SYSTEM), then the internal subset (`[ ... ]`), then the
    ; external subset (parsed AFTER the internal one — SGML order), then the MDC.
    function parse_doctype_decl_start(this: Parser, base_dir: String) returns bool
    {
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        let allow_name AllowedParams.a1(host, P_NAME)
        if this.parse_param(allow_name, decl_input_level, parm) = false
            return false
        let docname parm.token
        let dtd Dtd.make(host, docname, true)
        ps.set_def_dtd(dtd)
        ps.set_current_dtd(dtd)
        this.insert_predefined_entities(dtd)

        let allow_ext AllowedParams.a4(host, P_DSO, P_MDC, P_RESERVED_NAME + R_SYSTEM, P_RESERVED_NAME + R_PUBLIC)
        if this.parse_param(allow_ext, decl_input_level, parm) = false
            return false

        ; ---- external identifier (PUBLIC/SYSTEM), if present ----
        var ext_src: pointer[InputSource] null
        ; the external subset's own directory — the base that relative SYSTEM ids
        ; in ITS declarations resolve against (extractDir of the DTD's system id,
        ; combined with the document base). Defaults to the document base.
        var ext_base base_dir
        if (parm.kind = (P_RESERVED_NAME + R_SYSTEM)) or (parm.kind = (P_RESERVED_NAME + R_PUBLIC))
        {
            var id ExternalId()
            let allow_sys AllowedParams.a3(host, P_SYSTEMIDENTIFIER, P_DSO, P_MDC)
            let allow_end AllowedParams.a2(host, P_DSO, P_MDC)
            if this.parse_external_id(allow_sys, allow_end, decl_input_level, parm, &id) = false
                return false
            if id.has_system_id()
            {
                ; pin the DTD's system id onto host before load_external_subset —
                ; id.get_system_id() aliases the transient literal buffer, which the
                ; file read reuses (it read as garbage by the time we take its dir).
                let dtd_sys String^host(id.get_system_id())
                set ext_src: this.load_external_subset(base_dir, dtd_sys)
                if ext_src = null
                {
                    ; the external subset file could not be opened.
                    this.err(80)
                    return false
                }
                let dtd_dir Path.get_directory_name(dtd_sys)
                set ext_base: Path.join(base_dir, dtd_dir)
            }
            ; parm.kind is now P_DSO or P_MDC (the end token).
        }

        ps.set_phase(PHASE_DECL_SUBSET)

        ; ---- internal subset (`[ ... ]`), if a DSO opened it ----
        var has_internal false
        if parm.kind = P_DSO
        {
            let inner_level ps.get_input_level()
            let rc this.parse_decl_subset(inner_level, false)
            if rc <> 0
                return false
            set has_internal: true
        }

        ; ---- external subset, parsed AFTER the internal subset (SGML order) ----
        if ext_src <> null
        {
            ; relative SYSTEM ids in the external subset's declarations resolve
            ; against the DTD's own directory while it is parsed; restore the
            ; document base afterwards (content-level refs use it again).
            ps.set_decl_base_dir(ext_base)
            ps.push_input(ext_src)
            let ext_level ps.get_input_level()
            this.parse_decl_subset(ext_level, true)
            ps.set_decl_base_dir(base_dir)
        }

        ; ---- the closing MDC ----
        ; In the MDC-only case (no internal subset) the MDC was already consumed
        ; by allow_ext / parse_external_id; otherwise it follows the DSC.
        if has_internal
        {
            let allow_mdc AllowedParams.a1(host, P_MDC)
            if this.parse_param(allow_mdc, decl_input_level, parm) = false
                return false
        }
        true
    }

    ; lookingAtStartTag (parseDecl.cxx) — "This is harder than might be expected
    ; since we may not have compiled the recognizers for the instance yet": in the
    ; prolog a start tag is NOT a token (proMode has no STAGO), so the unrecognized
    ; token at the cursor is peeked by hand — does the input read STAGO followed by
    ; a name-start character? If so the general identifier is collected (folded
    ; through the instance syntax's substitution table, like every element name).
    ; The scan cursor is left where the peek stopped; the caller ungets the token.
    ; Returns the general identifier, EMPTY when the input is not a start tag (an
    ; out-parameter would make the escape checker reject the store — the returned
    ; StringC's characters live on `host`, but the checker is field-insensitive).
    function looking_at_start_tag(this: Parser) returns StringC
    {
        let ins ps.current_input()
        if ins = null
            return StringC()
        let syn ps.get_instance_syntax()
        let dlen syn.delim_general_len(dSTAGO)
        if dlen = (0 as size_t)
            return StringC()
        var i: size_t 0
        while i < dlen
        {
            let c ins.token_char()
            if c < 0
                return StringC()
            let f syn.fold(c as u32)
            if f <> syn.delim_general_char(dSTAGO, i)
                return StringC()
            set i: i + 1
        }
        var c2 ins.token_char()
        if c2 < 0
            return StringC()
        if syn.is_name_start_character(c2 as u32) = false
            return StringC()
        let buf Array[u32]^host()
        var scanning true
        while scanning
        {
            let f2 syn.fold(c2 as u32)
            buf.add(f2)
            set c2: ins.token_char()
            if c2 < 0
                set scanning: false
            else if syn.is_name_character(c2 as u32) = false
                set scanning: false
        }
        this.build_stringc(buf)
    }

    ; checkDtd (parseDecl.cxx), reduced to the half an implied DTD needs: every
    ; element type that was only ever REFERENCED (no <!ELEMENT> declared it) gets
    ; the undefined definition — ANY content, end tag omissible, undefined index —
    ; so the content checker admits it instead of tripping over a null definition.
    ; For an implied DTD that is exactly the document element. The shortref-map /
    ; ID / notation checks of the full checkDtd land with their declarations.
    function check_dtd(this: Parser, dtd: pointer[Dtd])
    {
        let allow_recursion ps.get_implydef_element() <> IMPLYDEF_ELEMENT_ANYOTHER
        let n dtd.n_element_types()
        var i: size_t 0
        while i < n
        {
            let p dtd.get_element_type_at(i)
            if p <> null
            {
                if p.get_definition() = null
                {
                    let loc ps.current_location()
                    let def ElementDefinition.make(host, loc, ELEMENT_UNDEFINED_INDEX, OMIT_END, DC_ANY, allow_recursion)
                    p.set_element_definition(def, 0 as size_t)
                }
            }
            set i: i + 1
        }
    }

    ; implyDtd (parseDecl.cxx) — the document has no document type declaration at
    ; all: the first thing in the prolog is the document element's start tag.
    ;
    ; Two errors, in this order (both hard — the parse continues but the document
    ; does NOT conform, so onsgmls exits 1 and writes no trailing `C`):
    ;   omittedProlog  the prolog may only be omitted with CONCUR NO, LINK EXPLICIT
    ;                  NO and IMPLYDEF ELEMENT or DOCTYPE YES. xml.dcl and the
    ;                  reference declaration say IMPLYDEF NO -> always reported.
    ;   noDtd          "no document type declaration; will parse without validation"
    ;                  — the reference reaches it when the catalog has no DTD filed
    ;                  under the document element's name. We do not wire that
    ;                  lookup: no corpus catalog declares a DOCTYPE entry, so the
    ;                  lookup would always fail and this is the only branch.
    ;
    ; Then enableImplydef: for the rest of the parse an undeclared element is
    ; implied (ANY content) rather than an error, and an undeclared attribute gets
    ; an implied CDATA definition. The DTD itself is a base Dtd named after the GI,
    ; carrying only the syntax's predefined entities.
    function imply_dtd(this: Parser, gi: StringC)
    {
        let sd ps.get_sd()
        if sd.implydef_element() = IMPLYDEF_ELEMENT_NO
        {
            if sd.implydef_doctype() = false
            {
                this.report0(ParserMessages.omittedProlog())
            }
        }
        this.report0(ParserMessages.noDtd())
        ps.enable_implydef()

        let dtd Dtd.make(host, gi, true)
        ps.set_def_dtd(dtd)
        ps.set_current_dtd(dtd)
        this.insert_predefined_entities(dtd)
        this.check_dtd(dtd)
    }

    ; doProlog (scoped): skip separators, dispatch the DOCTYPE declaration, and
    ; leave the input positioned at the first instance token.
    function parse_prolog(this: Parser, base_dir: String) returns bool
    {
        ps.set_current_mode(proMode)
        ps.set_phase(PHASE_PROLOG)
        var running true
        var ok true
        while running
        {
            let token ps.get_token(proMode)
            if token = tokenS
            {
                ; separator between prolog constructs: skip
            }
            else if (token = tokenRe) or (token = tokenRs)
            {
                ; record boundary in the prolog: ignore
            }
            else if token = tokenMdoNameStart
            {
                var decl_name: int 0
                if this.parse_declaration_name(&decl_name) = false
                {
                    set ok: false
                    set running: false
                }
                else if decl_name = R_DOCTYPE
                {
                    set ok: this.parse_doctype_decl_start(base_dir)
                    set running: false
                }
                else
                {
                    ; only DOCTYPE is handled in the prolog here.
                    this.err(81)
                    set ok: false
                    set running: false
                }
            }
            else if token = tokenPio
            {
                ; a processing instruction in the prolog (e.g. an XML declaration
                ; `<?xml ...?>` before the document element). doProlog: parse it
                ; and keep scanning the prolog. Must precede the unrecognized /
                ; implyDtd arm so a leading PI does not derail No-DOCTYPE detection.
                if this.parse_processing_instruction() = false
                {
                    set ok: false
                    set running: false
                }
            }
            else if token = tokenEe
            {
                ; end of the document before any content.
                set running: false
            }
            else if token = tokenUnrecognized
            {
                ; proMode has no STAGO recognizer, so the document element's start
                ; tag arrives here as an unrecognized token. With a DTD in hand the
                ; instance simply begins (unget, let do_content rescan it); WITHOUT
                ; one this is a document with no DOCTYPE — peek for the start tag
                ; and imply the DTD from its general identifier (doProlog).
                if ps.get_current_dtd() = null
                {
                    let gi this.looking_at_start_tag()
                    if gi.get_size() > (0 as size_t)
                    {
                        ps.current_input().unget_token()
                        this.imply_dtd(gi)
                    }
                    else
                    {
                        ; prologCharacter — a character that can neither open a
                        ; declaration nor start the instance. The reference retries
                        ; (prologRecover, up to 10 tries); with no DTD to fall back
                        ; on we stop here.
                        this.err(46)
                        set ok: false
                    }
                    set running: false
                }
                else
                {
                    ps.current_input().unget_token()
                    set running: false
                }
            }
            else
            {
                ; the instance begins (data / another instance token): unget and stop.
                ps.current_input().unget_token()
                set running: false
            }
        }
        ok
    }

    ; the full document drive: prolog (DOCTYPE) -> content events.
    ; The caller installs the prolog/decl recognizers (install_recognizers) and
    ; pushes the document InputSource; parse_document adds the content-mode
    ; recognizers, enters the instance, and runs doContent over the SAME input.
    function parse_document(this: Parser, table: pointer[Array[PackedTokenInfo]], base_dir: String) returns bool
    {
        if this.parse_prolog(base_dir) = false
            return false
        let dtd ps.get_current_dtd()
        if dtd = null
            return false
        this.install_content_recognizers(table)
        ps.start_instance(host, dtd)
        this.do_content()
        true
    }

    ; ---- top-level entry: document bytes -> ESIS -------------------------
    ; The whole-document event-dump entry the onsgmls program calls: widen the
    ; input bytes to Char (identity/ASCII), set up ParserState (reference Sd +
    ; Syntax), drive parse_document, and return the ESIS text. *out_conforming
    ; is true iff the parse produced no errors (the onsgmls exit-0 condition).
    ; A concept STATIC so a user program resolves it across packages. `base_dir`
    ; is the document's directory — external DTD subsets (SYSTEM/PUBLIC) resolve
    ; their (relative) system ids against it.
    function parse_to_esis(host: pointer[Page], doc_bytes: String, base_dir: String, doc_name: StringC, prog_name: String, out_conforming: pointer[bool]) returns String
    {
        ; Record normalization (ExtendEntityManager, `lf` record type — the whole
        ; Unix corpus): insert one RS (0x0A) at the entity start, and translate
        ; each source LF (0x0A) to RE (0x0D). Content newlines then tokenize as
        ; tokenRe (record ends the OutputState machine shapes into data); the
        ; leading RS + declaration-subset newlines are separators in prolog modes.
        ; A raw CR (0x0D) already IS the RE char and passes through. (crlf / cr-only
        ; record types are deferred; the corpus is LF.)
        let ps ParserState.make(host, null, 0 as u32, PHASE_PROLOG)
        ps.set_prog_name(prog_name)
        ; the document's directory: every relative SYSTEM id (external DTD subset,
        ; external text entity in content) resolves against it. The declaration
        ; base starts here too and follows the external subset while it is parsed.
        ps.set_base_dir(base_dir)
        ps.set_decl_base_dir(base_dir)

        ; SGML declaration binding (onsgmls behavior): look for a `catalog` file
        ; in the document's directory; if it names an SGMLDECL, parse that
        ; declaration into the Sd + Syntax (e.g. scaly.sgm's catalog -> scaly.dcl,
        ; NAMECASE GENERAL NO + SHORTTAG OMITNAME). No catalog / no SGMLDECL ->
        ; the reference implied declaration (Sd() + reference Syntax), byte-
        ; identical to the previous behavior for every catalog-less corpus model.
        var sd: pointer[Sd] null
        var syn: pointer[Syntax] null
        ; the declaration file (if any) is scanned for non-SGML characters after
        ; the parser is built (reportNonSgmlCharacter over the SD — see
        ; scan_sd_non_sgml); keep its bytes and display name for that pass.
        var have_decl false
        var decl_text String()
        var decl_name StringC()
        var cat_path base_dir
        if base_dir.get_length() = (0 as size_t)
            set cat_path: String("catalog")
        else
            set cat_path: Path.join(base_dir, String("catalog"))
        if File.exists(cat_path)
        {
            let cat_text File.read_to_string(cat_path)
            let catalog CatalogParser().parse(cat_text, base_dir)
            let decl_path catalog.lookup_sgmldecl()
            if (decl_path.get_length() <> (0 as size_t)) and File.exists(decl_path)
            {
                let dtext File.read_to_string(decl_path)
                let pair SdParser().build(host, dtext)
                set sd: pair.sd
                set syn: pair.syn
                set have_decl: true
                set decl_text: dtext
                set decl_name: StringC(decl_path.to_c_string())
            }
        }
        if sd = null
        {
            set sd: host.allocate(sizeof Sd, alignof Sd) as pointer[Sd]
            set *sd: Sd()
            set syn: Syntax^host(*sd)
        }
        ps.set_sd(sd)
        ps.set_syntax(syn)

        let parser Parser.make(host, ps)
        let table ModeInfo.build_table(host)
        parser.install_recognizers(table)

        ; reportNonSgmlCharacter over the SGML declaration (parseSd.cxx): push the
        ; declaration's normalized buffer as the current input so emit_message
        ; resolves line/col + file name from it, scan it, then pop. current_mode
        ; is proMode here (input_level 0), which push/pop leave untouched.
        if have_decl
        {
            let dorg host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
            set *dorg: Origin()
            dorg.set_file_name(decl_name)
            let dsrc Parser.make_char_source(host, decl_text, dorg)
            ps.push_input(dsrc)
            parser.scan_sd_non_sgml()
            ps.pop_input_stack()
        }

        let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org: Origin()
        ; the storage id onsgmls displays for a location in the document entity.
        org.set_file_name(doc_name)
        let src Parser.make_char_source(host, doc_bytes, org)
        ps.push_input(src)

        let ok parser.parse_document(table, base_dir)
        ; errorLimitExceeded (ParserApp.cxx): after the parse, if the error count
        ; reached the limit, emit the locationless Info line (once). onsgmls prints
        ; this last, after every queued diagnostic.
        if (ERROR_LIMIT <> (0 as u32)) and (ps.get_n_errors() >= ERROR_LIMIT)
            ps.report_error_limit(ERROR_LIMIT)
        let conforming ok and (ps.get_n_errors() = (0 as u32))
        set *out_conforming: conforming
        Esis.write(host, ps, conforming)
    }

    ; ---- self-test: parse a synthetic DTD subset, assert the built Dtd -----
    function test() returns int
    {
        let anchor StringC("x")
        let host Page.get(anchor.data_ptr() as pointer[void])

        ; --- assemble the DTD subset text as an in-memory InputSource ---
        ;   <!ELEMENT doc (title, para+)>
        ;   <!ELEMENT title (#PCDATA)>
        ;   <!ELEMENT para (#PCDATA)>
        ;   <!ATTLIST doc id ID #IMPLIED>
        ;   <!ENTITY logo "LOGO">
        ;   <!NOTATION gif SYSTEM "gif.exe">
        let dtext StringC("<!ELEMENT doc (title, para+)> <!ELEMENT title (#PCDATA)> <!ELEMENT para (#PCDATA)> <!ATTLIST doc id ID #IMPLIED> <!ENTITY logo \"LOGO\"> <!NOTATION gif SYSTEM \"gif.exe\"> ]")
        let n dtext.get_size()
        let buf host.allocate(n * (4 as size_t), 4) as pointer[u32]
        var ci: size_t 0
        while ci < n
        {
            set *(buf + ci): dtext.get(ci)
            set ci: ci + 1
        }

        ; --- ParserState + Sd + Syntax ---
        let ps ParserState.make(host, null, 0 as u32, PHASE_DECL_SUBSET)
        let sd host.allocate(sizeof Sd, alignof Sd) as pointer[Sd]
        set *sd: Sd()
        ps.set_sd(sd)
        let syn Syntax^host(*sd)
        ps.set_syntax(syn)

        ; --- the def/current DTD (document element "DOC" auto-inserted at 1;
        ;     names fold to uppercase under NAMECASE GENERAL YES) ---
        let dtd Dtd.make(host, StringC("DOC"), true)
        ps.set_def_dtd(dtd)
        ps.set_current_dtd(dtd)

        ; --- recognizers + input source ---
        let parser Parser.make(host, ps)
        let table ModeInfo.build_table(host)
        parser.install_recognizers(table)

        let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org: Origin()
        let src host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
        set *src: InputSource(org, buf, n)
        ps.push_input(src)

        ; --- drive the declaration-subset parser (internal subset at level 1) ---
        let rc parser.parse_decl_subset(1 as u32, false)
        if rc <> 0
            return -1
        if ps.get_n_errors() <> (0 as u32)
            return -2

        ; --- assert element types + declared content (folded names) ---
        let doc dtd.lookup_element_type(StringC("DOC"))
        if doc = null
            return -3
        let title dtd.lookup_element_type(StringC("TITLE"))
        if title = null
            return -4
        let para dtd.lookup_element_type(StringC("PARA"))
        if para = null
            return -5
        let doc_def doc.get_definition()
        if doc_def = null
            return -6
        if doc_def.get_declared_content() <> DC_MODEL_GROUP
            return -7
        let title_def title.get_definition()
        if title_def = null
            return -8
        if title_def.get_declared_content() <> DC_MODEL_GROUP
            return -9

        ; --- drive the compiled content model of doc: (title, para+) ---
        let cmg doc_def.compiled_model_group()
        if cmg = null
            return -10
        let ms ContentToken.make_match_state(host, cmg)
        if ContentToken.ms_try_transition(ms, title) = false
            return -11
        if ContentToken.ms_try_transition(ms, para) = false
            return -12
        if ContentToken.ms_is_finished(ms) = false
            return -13
        ; para+ repeats
        if ContentToken.ms_try_transition(ms, para) = false
            return -14

        ; --- assert the ATTLIST on doc ---
        let adl doc.get_attribute_def()
        if adl = null
            return -15
        if adl.size() <> (1 as size_t)
            return -16
        let iddef adl.def(0 as size_t)
        if iddef = null
            return -17
        if iddef.get_name().equals(StringC("ID")) = false
            return -18

        ; --- assert the ENTITY (NAMECASE ENTITY NO: name stays lowercase) ---
        let logo dtd.lookup_entity(false, StringC("logo"))
        if logo = null
            return -19

        ; --- assert the NOTATION (folded) ---
        let gif dtd.lookup_notation(StringC("GIF"))
        if gif = null
            return -20
        if gif.is_defined() = false
            return -21
        if gif.has_system_id() = false
            return -22

        ; ================= Stage 4: instance parsing =====================
        ; Parse a well-formed instance against the DTD just built and assert the
        ; event stream for  <doc><title>Hi</title><para>X</para></doc>  (names
        ; fold to uppercase): START DOC, START TITLE, "Hi", END TITLE, START
        ; PARA, "X", END PARA, END DOC.
        let itext StringC("<doc id=\"D1\"><title>Hi</title><para>X</para></doc>")
        let ni itext.get_size()
        let ibuf host.allocate(ni * (4 as size_t), 4) as pointer[u32]
        var ii: size_t 0
        while ii < ni
        {
            set *(ibuf + ii): itext.get(ii)
            set ii: ii + 1
        }

        ; content-mode recognizers, then enter the instance
        parser.install_content_recognizers(table)
        ; drop the (exhausted) declaration-subset input so the instance parses at
        ; input level 1 (end-of-entity there ends the instance).
        ps.pop_input_stack()
        ps.start_instance(host, dtd)

        let iorg host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *iorg: Origin()
        let isrc host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
        set *isrc: InputSource(iorg, ibuf, ni)
        ps.push_input(isrc)

        parser.do_content()

        if ps.get_n_errors() <> (0 as u32)
            return -30

        ; walk the event queue: match the 6 structural events in order, and sum
        ; the total character-data length (robust to data-token coalescing).
        let n_ev ps.n_events()
        var si: int 0
        var data_total: size_t 0
        var k: size_t 0
        while k < n_ev
        {
            let ev ps.get_event(k)
            let ty ev.get_type()
            if ty = EV_DATA
            {
                let d ev.get_data()
                set data_total: data_total + d.get_size()
            }
            else
            {
                let et ev.get_element_type()
                let nm et.get_name()
                if si = 0
                {
                    if ty <> EV_START_ELEMENT
                        return -31
                    if nm.equals(StringC("DOC")) = false
                        return -32
                }
                else if si = 1
                {
                    if ty <> EV_START_ELEMENT
                        return -33
                    if nm.equals(StringC("TITLE")) = false
                        return -34
                }
                else if si = 2
                {
                    if ty <> EV_END_ELEMENT
                        return -35
                    if nm.equals(StringC("TITLE")) = false
                        return -36
                }
                else if si = 3
                {
                    if ty <> EV_START_ELEMENT
                        return -37
                    if nm.equals(StringC("PARA")) = false
                        return -38
                }
                else if si = 4
                {
                    if ty <> EV_END_ELEMENT
                        return -39
                    if nm.equals(StringC("PARA")) = false
                        return -40
                }
                else if si = 5
                {
                    if ty <> EV_END_ELEMENT
                        return -41
                    if nm.equals(StringC("DOC")) = false
                        return -42
                }
                else
                    return -43
                set si: si + 1
            }
            set k: k + 1
        }
        if si <> 6
            return -44
        if data_total <> (3 as size_t)
            return -45

        ; --- assert the attribute on the <doc> start event ---
        let ev0 ps.get_event(0 as size_t)
        let atts0 ev0.get_attributes()
        if atts0 = null
            return -46
        let ai atts0.attribute_index(StringC("ID"))
        if ai < 0
            return -47
        let av atts0.value(ai as size_t)
        if av = null
            return -48
        let avs av.get_string()
        if avs.equals(StringC("D1")) = false
            return -49

        ; ============= Stage 4 Increment 3: full document -> ESIS ==========
        ; Drive a whole SGML document (prolog DOCTYPE + internal subset +
        ; instance, ONE InputSource) through parse_document and assert the ESIS
        ; dump is byte-identical to the reference onsgmls output.
        let esis_rc parser_esis_check()
        if esis_rc <> 0
            return esis_rc

        0
    }

    ; a fresh-ParserState full-document drive + ESIS byte comparison.
    function parser_esis_check() returns int
    {
        let anchor StringC("y")
        let host Page.get(anchor.data_ptr() as pointer[void])

        let doc StringC("<!DOCTYPE doc [<!ELEMENT doc - - (title, para+)> <!ELEMENT title - - (#PCDATA)> <!ELEMENT para - - (#PCDATA)> <!ATTLIST doc id ID #IMPLIED>]><doc id=\"D1\"><title>Hi</title><para>X</para></doc>")
        let n doc.get_size()
        let buf host.allocate(n * (4 as size_t), 4) as pointer[u32]
        var ci: size_t 0
        while ci < n
        {
            set *(buf + ci): doc.get(ci)
            set ci: ci + 1
        }

        let ps ParserState.make(host, null, 0 as u32, PHASE_PROLOG)
        let sd host.allocate(sizeof Sd, alignof Sd) as pointer[Sd]
        set *sd: Sd()
        ps.set_sd(sd)
        let syn Syntax^host(*sd)
        ps.set_syntax(syn)

        let parser Parser.make(host, ps)
        let table ModeInfo.build_table(host)
        parser.install_recognizers(table)

        let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org: Origin()
        let src host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
        set *src: InputSource(org, buf, n)
        ps.push_input(src)

        if parser.parse_document(table, String()) = false
            return -60

        let got Esis.write(host, ps, ps.get_n_errors() = (0 as u32))
        let want String("AID TOKEN D1\n(DOC\n(TITLE\n-Hi\n)TITLE\n(PARA\n-X\n)PARA\n)DOC\nC\n")
        if got.equals(want) = false
            return -61
        0
    }
}
