; A group member of a name/name-token group (with its original spelling + loc).
define NameToken (name: StringC, orig_name: StringC, loc: Location)
{
    init(name: StringC, orig_name: StringC, loc: Location)
    {
        set this.name: name
        set this.orig_name: orig_name
        set this.loc: loc
    }
}

; Param — the workhorse's output (Param.cs), reused/mutated across parseParam
; calls, so page-hosted.
define Param
(
    kind: int
    token: StringC
    orig_token: StringC
    literal_text: ref[Text]?
    lita: bool
    model_group: ref[CmNode]?
    name_tokens: ref[Array[NameToken]]
    elements: ref[Array[ref[ElementType]?]]
)
{
    function make(host: ref[Page]) returns ref[Param]
    {
        let p host.allocate(sizeof Param, alignof Param) as pointer[Param]
        set p.kind: P_INVALID
        set p.token: StringC()
        set p.orig_token: StringC()
        set p.literal_text: null
        set p.lita: false
        set p.model_group: null
        set p.name_tokens: Array[NameToken]^host()
        set p.elements: Array[ref[ElementType]?]^host()
        p
    }
}

; AllowedParams (Param.cs) — the per-call allowed-parameter set. Built by make +
; allow() (mirroring the C++ ctor). Page-hosted (holds a reserved-name bitset).
define AllowedParams
(
    silent: bool
    mdc_ok: bool
    rni_ok: bool
    dso_ok: bool
    inclusions_ok: bool
    exclusions_ok: bool
    extra_delimiter: int
    group_type: int
    name_start_type: int
    digit_type: int
    nmchar_type: int
    literal_type: int
    reserved_names: pointer[u8]
    main_mode: int
)
{
    function make(host: ref[Page]) returns ref[AllowedParams]
    {
        let a host.allocate(sizeof AllowedParams, alignof AllowedParams) as pointer[AllowedParams]
        set a.silent: false
        set a.mdc_ok: false
        set a.rni_ok: false
        set a.dso_ok: false
        set a.inclusions_ok: false
        set a.exclusions_ok: false
        set a.extra_delimiter: P_INVALID
        set a.group_type: P_INVALID
        set a.name_start_type: P_INVALID
        set a.digit_type: P_INVALID
        set a.nmchar_type: P_INVALID
        set a.literal_type: P_INVALID
        set a.main_mode: mdMode
        let rn host.allocate(N_NAMES as size_t, 1) as pointer[u8]
        var i: size_t 0
        while i < (N_NAMES as size_t)
        {
            set *(rn + i): 0
            set i: i + 1
        }
        set a.reserved_names: rn
        a
    }

    function allow(this: ref[AllowedParams], p: int)
    {
        if p = P_INVALID
            return
        if p = P_SILENT
            set this.silent: true
        else if p = P_DSO
            set this.dso_ok: true
        else if p = P_MDC
            set this.mdc_ok: true
        else if p = P_MINUS
        {
            set this.main_mode: mdMinusMode
            set this.extra_delimiter: p
        }
        else if p = P_PERO
        {
            set this.main_mode: mdPeroMode
            set this.extra_delimiter: p
        }
        else if p = P_INCLUSIONS
            set this.inclusions_ok: true
        else if p = P_EXCLUSIONS
            set this.exclusions_ok: true
        else if (p = P_NAMEGROUP) or (p = P_NAMETOKENGROUP) or (p = P_MODELGROUP)
            set this.group_type: p
        else if p = P_NUMBER
            set this.digit_type: p
        else if (p = P_MINIMUMLITERAL) or (p = P_TOKENIZEDATTRIBUTEVALUELITERAL) or (p = P_ATTRIBUTEVALUELITERAL) or (p = P_SYSTEMIDENTIFIER) or (p = P_PARAMLITERAL)
            set this.literal_type: p
        else if (p = P_NAME) or (p = P_ENTITYNAME) or (p = P_PARAMENTITYNAME)
            set this.name_start_type: p
        else if p = P_ATTRIBUTEVALUE
        {
            set this.name_start_type: p
            set this.digit_type: p
            set this.nmchar_type: p
        }
        else if p < P_INDICATED_RESERVED_NAME
        {
            set this.name_start_type: P_RESERVED_NAME
            set *(this.reserved_names + ((p - P_RESERVED_NAME) as size_t)): 1
        }
        else
        {
            set this.rni_ok: true
            set *(this.reserved_names + ((p - P_INDICATED_RESERVED_NAME) as size_t)): 1
        }
    }

    function reserved_name_allowed(this: AllowedParams, i: int) returns bool
        *(reserved_names + (i as size_t)) <> 0

    ; convenience builders (fixed arity; the C++ ctor takes up to 10 codes)
    function a1(host: ref[Page], p1: int) returns ref[AllowedParams]
    {
        let a make(host)
        a.allow(p1)
        a
    }
    function a2(host: ref[Page], p1: int, p2: int) returns ref[AllowedParams]
    {
        let a make(host)
        a.allow(p1)
        a.allow(p2)
        a
    }
    function a3(host: ref[Page], p1: int, p2: int, p3: int) returns ref[AllowedParams]
    {
        let a make(host)
        a.allow(p1)
        a.allow(p2)
        a.allow(p3)
        a
    }
    function a4(host: ref[Page], p1: int, p2: int, p3: int, p4: int) returns ref[AllowedParams]
    {
        let a make(host)
        a.allow(p1)
        a.allow(p2)
        a.allow(p3)
        a.allow(p4)
        a
    }
    function a5(host: ref[Page], p1: int, p2: int, p3: int, p4: int, p5: int) returns ref[AllowedParams]
    {
        let a make(host)
        a.allow(p1)
        a.allow(p2)
        a.allow(p3)
        a.allow(p4)
        a.allow(p5)
        a
    }
    function a7(host: ref[Page], p1: int, p2: int, p3: int, p4: int, p5: int, p6: int, p7: int) returns ref[AllowedParams]
    {
        let a make(host)
        a.allow(p1)
        a.allow(p2)
        a.allow(p3)
        a.allow(p4)
        a.allow(p5)
        a.allow(p6)
        a.allow(p7)
        a
    }
    function a8(host: ref[Page], p1: int, p2: int, p3: int, p4: int, p5: int, p6: int, p7: int, p8: int) returns ref[AllowedParams]
    {
        let a make(host)
        a.allow(p1)
        a.allow(p2)
        a.allow(p3)
        a.allow(p4)
        a.allow(p5)
        a.allow(p6)
        a.allow(p7)
        a.allow(p8)
        a
    }
    function an(host: ref[Page], codes: pointer[int], n: int) returns ref[AllowedParams]
    {
        let a make(host)
        var i: int 0
        while i < n
        {
            a.allow(*(codes + (i as size_t)))
            set i: i + 1
        }
        a
    }
}

; A parsed group token (Group.cs GroupToken). text carries a data-tag
; parameter literal (dataTagLiteral); text_vector the templates of a
; dataTagTemplateGroup (parseParam.cxx:796).
define GroupToken
(
    kind: int
    token: StringC
    model: ref[CmNode]?
    content_token: ref[CmNode]?
    text: ref[Text]?
    text_vector: ref[Array[Text]]?
)
{
    function make(host: ref[Page]) returns ref[GroupToken]
    {
        let g host.allocate(sizeof GroupToken, alignof GroupToken) as pointer[GroupToken]
        set g.kind: GT_INVALID
        set g.token: StringC()
        set g.model: null
        set g.content_token: null
        set g.text: null
        set g.text_vector: null
        g
    }
}

; AttributeParameter::Type — the classification parse_attribute_parameter returns
; for each token it reads inside a start-tag attribute specification.
define APT_END: int 0
define APT_NAME: int 1
define APT_NAMETOKEN: int 2
define APT_VI: int 3
define APT_RECOVER_UNQUOTED: int 4

; (ExternalInputSource::RecordType — RT_LF/RT_CRLF/RT_CR/RT_ASIS moved to
; Location.scaly with the streaming source that carries one; see the
; record-normalization comment on make_char_source below.)

; Text-item tracking for AttributeValue::handleAsUnterminated (Attribute.cxx:
; 1377) inside parse_literal. The reference iterates the Text's ITEM list and
; remembers the last data item that is not a single space (lastStr/lastLen);
; our Text is a flat buffer, so parse_literal reconstructs the item boundaries
; while it accumulates: contiguous same-origin chars merge into one data item
; (Text::addChar's merge rule), separator-replacement spaces stand alone and
; never become the candidate, and entity boundaries / non-SGML chars RESET the
; candidate (they are non-data items — the reference's `default:` arm).
define HuState (item_start: size_t(0), item_open: bool(false), last_start: size_t(0), last_len: size_t(0), have_last: bool(false), prev_org: ref[Origin](null), prev_idx: u32(0))
{
    ; close the open data item; a closed item that is not a single space
    ; becomes the candidate last data item.
    function close(this: ref[HuState], buf: ref[Array[u32]])
    {
        if this.item_open = false
            return
        set this.item_open: false
        let n buf.get_length() - this.item_start
        if (n = 1) and (*(buf.get_buffer() + this.item_start) = 0x20)
            return
        set this.last_start: this.item_start
        set this.last_len: n
        set this.have_last: true
    }

    ; a data char is about to be appended at buf's end: merge into the open
    ; item when its location follows contiguously, else start a new item.
    function note_data(this: ref[HuState], buf: ref[Array[u32]], loc: Location)
    {
        var merge false
        if this.item_open
        {
            if (loc.get_origin() = this.prev_org) and (loc.get_index() = (this.prev_idx + (1 as u32)))
                set merge: true
        }
        if merge = false
        {
            this.close(buf)
            set this.item_start: buf.get_length()
            set this.item_open: true
        }
        set this.prev_org: loc.get_origin() as ref[Origin]
        set this.prev_idx: loc.get_index()
    }

    ; a separator-replacement space is about to be appended: it is its own
    ; single-space item — close the open item, leave the candidate untouched.
    function note_space(this: ref[HuState], buf: ref[Array[u32]])
        this.close(buf)

    ; a non-data item (entity start/end, non-SGML char): close and RESET.
    function note_reset(this: ref[HuState], buf: ref[Array[u32]])
    {
        this.close(buf)
        set this.have_last: false
    }
}

; ---- OMITTAG speculation rollback (Undo.h/Undo.cxx) ------------------------
; While tags are implied the content state is mutated in place; each mutation
; records its inverse. On rollback the entries run newest-first:
;   START_TAG   an element was pushed          -> pop it
;   END_TAG     an element was popped (saved)  -> re-push it
;   TRANSITION  a required transition advanced -> restore the snapshot cursor
define UNDO_START_TAG: int 0
define UNDO_END_TAG: int 1
define UNDO_TRANSITION: int 2

define UndoEntry
(
    kind: int
    element: ref[OpenElement]?
    state: ref[MatchState]?
)

; DocFileRes — one file argument of the multi-file document entity
; (mergeSystemIds) after the storage candidate walk: found -> the display
; path + the raw bytes; failed -> the deferred message shape (is_find
; selects cannotFind vs openSystemCall, detail its %2 payload — see
; Parser.resolve_doc_file / ParserState.queue_pending_open).
define DocFileRes (found: bool, path: String, bytes: String, is_find: bool, detail: String)
{
    init()
    {
        set found: false
        set path: String()
        set bytes: String()
        set is_find: false
        set detail: String()
    }
}

define Parser (host: pointer[Page], ps: ref[ParserState]?)
{
    function make(host: ref[Page], ps: ref[ParserState]) returns Parser
        Parser(host, ps)

    ; ---- delegating helpers ----------------------------------------------
    ; (the err(N) numbered-stub helper is GONE: every reference message the
    ; ported code paths reach now renders through the generated tables.)

    ; report a message with REAL text (written to stderr, MessageReporter path).
    ; report0: no arguments; report1: one String argument, substituted for %1
    ; (String args are quoted by the formatter). `mt` is the MessageType from a
    ; GENERATED table (e.g. ParserMessages.elementNotAllowed()) — text, severity
    ; and number all sourced from the reference .msg (see *Messages.scaly).
    function report0(this: Parser, mt: MessageType)
    {
        let args Vector[MessageArg]()
        ps.report(mt, args)
    }

    ; report0 at an explicit location (a captured construct location).
    function report0_at(this: Parser, mt: MessageType, loc: Location)
    {
        let args Vector[MessageArg]()
        ps.report_at(mt, args, loc)
    }

    function report1(this: Parser, mt: MessageType, a1: StringC)
    {
        var args Vector[MessageArg](1)
        set *(args.get(0)): MessageArg.Str(a1)
        ps.report(mt, args)
    }

    ; report1 at an explicit location (a captured construct location).
    function report1_at(this: Parser, mt: MessageType, a1: StringC, loc: Location)
    {
        var args Vector[MessageArg](1)
        set *(args.get(0)): MessageArg.Str(a1)
        ps.report_at(mt, args, loc)
    }

    ; E2 with two String args (%1, %2, both quoted) — entityNotationUndefined.
    function report2_at(this: Parser, mt: MessageType, a1: StringC, a2: StringC, loc: Location)
    {
        var args Vector[MessageArg](2)
        set *(args.get(0)): MessageArg.Str(a1)
        set *(args.get(1)): MessageArg.Str(a2)
        ps.report_at(mt, args, loc)
    }

    ; PosixStorageManager's open-failure report, openSystemCall "cannot open %1
    ; (%2)": %1 the effective system id (quoted StringMessageArg), %2 the
    ; strerror text (unquoted — ErrnoMessageArg). Reported at the location of
    ; the reference that opened the entity (ParentLocationMessenger).
    function report_open_failure(this: Parser, sysid: StringC, emsg: pointer[const_char], loc: Location)
    {
        var args Vector[MessageArg](2)
        set *(args.get(0)): MessageArg.Str(sysid)
        set *(args.get(1)): MessageArg.Raw(StringC(emsg))
        ps.report_at(PosixStorageMessages.openSystemCall(), args, loc)
    }

    ; report a message whose %1 is a NUMBER (decimal, unquoted — NumberMessageArg)
    ; at an explicit location.
    function report_num_at(this: Parser, mt: MessageType, a1: u64, loc: Location)
    {
        var args Vector[MessageArg](1)
        set *(args.get(0)): MessageArg.Num(a1)
        ps.report_at(mt, args, loc)
    }

    ; E2 with %1 Number, %2 String (quoted) — numericCharRefUnknownDesc.
    function report_num_str_at(this: Parser, mt: MessageType, a1: u64, a2: StringC, loc: Location)
    {
        var args Vector[MessageArg](2)
        set *(args.get(0)): MessageArg.Num(a1)
        set *(args.get(1)): MessageArg.Str(a2)
        ps.report_at(mt, args, loc)
    }

    ; two NUMBER args (%1, %2, unquoted) — normalizedAttributeValueLength /
    ; attsplen (the limit, then the actual length).
    function report_num_num_at(this: Parser, mt: MessageType, a1: u64, a2: u64, loc: Location)
    {
        var args Vector[MessageArg](2)
        set *(args.get(0)): MessageArg.Num(a1)
        set *(args.get(1)): MessageArg.Num(a2)
        ps.report_at(mt, args, loc)
    }

    ; %1 String, %2 String, %3 StringVector (each item quoted, ", "-separated)
    ; — attributeValueNotInGroup (value, attribute name, allowed tokens).
    function report2_vec_at(this: Parser, mt: MessageType, a1: StringC, a2: StringC, a3: ref[Array[StringC]], loc: Location)
    {
        var args Vector[MessageArg](3)
        set *(args.get(0)): MessageArg.Str(a1)
        set *(args.get(1)): MessageArg.Str(a2)
        set *(args.get(2)): MessageArg.Vec(a3)
        ps.report_at(mt, args, loc)
    }

    ; E3 with %1 Number, %2 Number, %3 String (quoted) —
    ; numericCharRefUnknownBase (doc number, base number, baseset public id).
    function report_num_num_str_at(this: Parser, mt: MessageType, a1: u64, a2: u64, a3: StringC, loc: Location)
    {
        var args Vector[MessageArg](3)
        set *(args.get(0)): MessageArg.Num(a1)
        set *(args.get(1)): MessageArg.Num(a2)
        set *(args.get(2)): MessageArg.Str(a3)
        ps.report_at(mt, args, loc)
    }

    ; E2 with both args pre-rendered (unquoted) — the *InvalidToken messages,
    ; whose args (TokenMessageArg / Allowed*MessageArg) mix quoted delimiter
    ; text with unquoted fragment text; the quotes are already IN the strings.
    function report_raw_raw_at(this: Parser, mt: MessageType, a1: StringC, a2: StringC, loc: Location)
    {
        var args Vector[MessageArg](2)
        set *(args.get(0)): MessageArg.Raw(a1)
        set *(args.get(1)): MessageArg.Raw(a2)
        ps.report_at(mt, args, loc)
    }

    ; E2 with %1 String (quoted), %2 pre-rendered (unquoted) —
    ; markupDeclarationCharacter / groupCharacter (char, allowed list).
    function report_str_raw_at(this: Parser, mt: MessageType, a1: StringC, a2: StringC, loc: Location)
    {
        var args Vector[MessageArg](2)
        set *(args.get(0)): MessageArg.Str(a1)
        set *(args.get(1)): MessageArg.Raw(a2)
        ps.report_at(mt, args, loc)
    }

    ; a single RAW (pre-rendered, unquoted) %1 — endTagInvalidToken.
    function report_raw_at(this: Parser, mt: MessageType, a1: StringC, loc: Location)
    {
        var args Vector[MessageArg](1)
        set *(args.get(0)): MessageArg.Raw(a1)
        ps.report_at(mt, args, loc)
    }

    ; report0 WITH an auxiliary line at aux_loc — commentEntityEnd
    ; ("comment started here" at the COM that opened the comment).
    function report0_aux(this: Parser, mt: MessageType, loc: Location, aux: MessageFragment, aux_loc: Location)
    {
        let args Vector[MessageArg]()
        let aux_text aux.text
        ps.report_aux(mt, args, loc, aux_text, aux_loc)
    }

    ; ordinal %1 + two quoted names — requiredElementExcluded / invalidExclusion.
    function report_ord2_at(this: Parser, mt: MessageType, n: u64, a1: StringC, a2: StringC, loc: Location)
    {
        var args Vector[MessageArg](3)
        set *(args.get(0)): MessageArg.Ord(n)
        set *(args.get(1)): MessageArg.Str(a1)
        set *(args.get(2)): MessageArg.Str(a2)
        ps.report_at(mt, args, loc)
    }

    ; quoted name %1 + quoted name list %2 — missingElementMultiple.
    function report_str_vec_at(this: Parser, mt: MessageType, a1: StringC, v: ref[Array[StringC]], loc: Location)
    {
        var args Vector[MessageArg](2)
        set *(args.get(0)): MessageArg.Str(a1)
        set *(args.get(1)): MessageArg.Vec(v)
        ps.report_at(mt, args, loc)
    }

    ; The display name of a leaf content token for the ambiguousModel*
    ; family (reportAmbiguity, parseDecl.cxx:748): the element name, or
    ; RNI + PCDATA for the #PCDATA pseudo-element.
    function leaf_token_name(this: Parser, leaf: ref[CmNode]) returns StringC
    {
        if leaf.element <> null
        {
            let e leaf.element
            return e.get_name()
        }
        let buf Array[u32]^host()
        this.append_delim_chars(buf, dRNI)
        let ps_spell this.reserved_name_spelling(R_PCDATA)
        this.arg_append(buf, ps_spell)
        this.arg_to_string(buf)
    }

    ; Parser::reportAmbiguity (parseDecl.cxx:742): one detected content-model
    ; ambiguity, split over four message shapes by from-token kind and the
    ; number of AND groups that must have been matched (from's AND depth minus
    ; the ambiguity's AND depth). Ordinals are typeIndex + 1.
    function report_ambiguity(this: Parser, from: ref[CmNode], to1: ref[CmNode], to2: ref[CmNode], ambig_and_depth: u32, loc: Location)
    {
        let to_name this.leaf_token_name(to1)
        let to1_index (to1.type_index as u64) + 1
        let to2_index (to2.type_index as u64) + 1
        if from.is_initial
        {
            var args Vector[MessageArg](3)
            set *(args.get(0)): MessageArg.Str(to_name)
            set *(args.get(1)): MessageArg.Ord(to1_index)
            set *(args.get(2)): MessageArg.Ord(to2_index)
            ps.report_at(ParserMessages.ambiguousModelInitial(), args, loc)
            return
        }
        let from_name this.leaf_token_name(from)
        let from_index (from.type_index as u64) + 1
        var from_depth: u32 0
        if from.has_and_info
            set from_depth: ContentToken.and_depth_of(from.ai_ancestor)
        let and_matches (from_depth - ambig_and_depth) as u64
        if and_matches = 0
        {
            var args Vector[MessageArg](5)
            set *(args.get(0)): MessageArg.Str(from_name)
            set *(args.get(1)): MessageArg.Ord(from_index)
            set *(args.get(2)): MessageArg.Str(to_name)
            set *(args.get(3)): MessageArg.Ord(to1_index)
            set *(args.get(4)): MessageArg.Ord(to2_index)
            ps.report_at(ParserMessages.ambiguousModel(), args, loc)
            return
        }
        if and_matches = 1
        {
            var args Vector[MessageArg](5)
            set *(args.get(0)): MessageArg.Str(from_name)
            set *(args.get(1)): MessageArg.Ord(from_index)
            set *(args.get(2)): MessageArg.Str(to_name)
            set *(args.get(3)): MessageArg.Ord(to1_index)
            set *(args.get(4)): MessageArg.Ord(to2_index)
            ps.report_at(ParserMessages.ambiguousModelSingleAnd(), args, loc)
            return
        }
        var args Vector[MessageArg](6)
        set *(args.get(0)): MessageArg.Str(from_name)
        set *(args.get(1)): MessageArg.Ord(from_index)
        set *(args.get(2)): MessageArg.Num(and_matches)
        set *(args.get(3)): MessageArg.Str(to_name)
        set *(args.get(4)): MessageArg.Ord(to1_index)
        set *(args.get(5)): MessageArg.Ord(to2_index)
        ps.report_at(ParserMessages.ambiguousModelMultipleAnd(), args, loc)
    }

    ; report1 with a RAW %1 plus an auxiliary line — commentDeclInvalidToken
    ; (TokenMessageArg %1, "comment declaration started here" at the MDO).
    function report_raw_aux(this: Parser, mt: MessageType, a1: StringC, loc: Location, aux: MessageFragment, aux_loc: Location)
    {
        var args Vector[MessageArg](1)
        set *(args.get(0)): MessageArg.Raw(a1)
        let aux_text aux.text
        ps.report_aux(mt, args, loc, aux_text, aux_loc)
    }

    ; report1 at a location WITH an auxiliary "start tag was here"-style line at
    ; aux_loc (the omitted-end-tag diagnostics). %1 is the String a1 (quoted).
    ; `aux` is the companion fragment from the table (e.g. omitEndTagOmittag_aux()).
    function report1_aux(this: Parser, mt: MessageType, a1: StringC, loc: Location, aux: MessageFragment, aux_loc: Location)
    {
        var args Vector[MessageArg](1)
        set *(args.get(0)): MessageArg.Str(a1)
        let aux_text aux.text
        ps.report_aux(mt, args, loc, aux_text, aux_loc)
    }

    ; reportNonSgmlCharacter (parseCommon.cxx) in a markup-declaration context
    ; (parseParam / parseGroupToken / parseGroupConnector): if the unrecognized
    ; token is a non-SGML character, report it and return true — the caller then
    ; CONTINUES its loop (the reference `break`s); only a genuine SGML character
    ; falls through to the context's own invalid-character message.
    function report_non_sgml_param(this: Parser) returns bool
    {
        let ins ps.current_input()
        ; the unrecognized token has length 0 — CONSUME the offending character
        ; (the reference's getChar()), so the caller's loop moves past it and
        ; currentToken() carries it into the invalid-character message.
        if ins.current_token_length() = 0
            ins.end_token(1)
        let pc ins.current_char()
        if this.is_non_sgml_char(pc)
        {
            let mt ParserMessages.nonSgmlCharacter()
            let loc ins.token_start_location()
            this.report_num_at(mt, pc as u64, loc)
            return true
        }
        false
    }

    ; ---- message-argument builders (TokenMessageArg.cxx / Param.cxx /
    ; Group.cxx) -------------------------------------------------------------
    ; The reference renders these args through MessageBuilder: appendChars
    ; output is QUOTED, appendFragment output (catalog fragments 1000+) is not.
    ; Here each arg is pre-rendered into a StringC with the quotes inline and
    ; passed as MessageArg.Raw.

    function arg_append(this: Parser, buf: ref[Array[u32]], s: StringC)
    {
        let n s.get_size()
        var i: size_t 0
        while i < n
        {
            let c s.get(i)
            buf.add(c)
            set i: i + 1
        }
    }

    ; appendChars — quoted text.
    function arg_append_quoted(this: Parser, buf: ref[Array[u32]], s: StringC)
    {
        buf.add(0x22)
        this.arg_append(buf, s)
        buf.add(0x22)
    }

    ; the characters of a general delimiter, appended bare.
    function append_delim_chars(this: Parser, buf: ref[Array[u32]], d: int)
    {
        let syn ps.get_syntax()
        let n syn.delim_general_len(d)
        var i: size_t 0
        while i < n
        {
            let c syn.delim_general_char(d, i)
            buf.add(c)
            set i: i + 1
        }
    }

    ; delimStart fragment + the delimiter's text (quoted): `delimiter "X"`.
    function arg_append_delim(this: Parser, buf: ref[Array[u32]], d: int)
    {
        this.arg_append(buf, StringC("delimiter "))
        buf.add(0x22)
        this.append_delim_chars(buf, d)
        buf.add(0x22)
    }

    ; listSep fragment.
    function arg_append_sep(this: Parser, buf: ref[Array[u32]], first: ref[bool])
    {
        if first
        {
            set first: false
            return
        }
        this.arg_append(buf, StringC(", "))
    }

    function arg_to_string(this: Parser, buf: ref[Array[u32]]) returns StringC
        StringC^host(buf.get_buffer(), buf.get_length())

    ; the canonical (reference concrete syntax) spelling of a reserved name —
    ; Syntax::reservedName(i); the inverse of lookup_reserved_name.
    function reserved_name_spelling(this: Parser, rn: int) returns StringC
    {
        if rn = R_ALL
            return StringC("ALL")
        if rn = R_ANY
            return StringC("ANY")
        if rn = R_ATTLIST
            return StringC("ATTLIST")
        if rn = R_CDATA
            return StringC("CDATA")
        if rn = R_CONREF
            return StringC("CONREF")
        if rn = R_CURRENT
            return StringC("CURRENT")
        if rn = R_DATA
            return StringC("DATA")
        if rn = R_DEFAULT
            return StringC("DEFAULT")
        if rn = R_DOCTYPE
            return StringC("DOCTYPE")
        if rn = R_ELEMENT
            return StringC("ELEMENT")
        if rn = R_EMPTY
            return StringC("EMPTY")
        if rn = R_ENDTAG
            return StringC("ENDTAG")
        if rn = R_ENTITIES
            return StringC("ENTITIES")
        if rn = R_ENTITY
            return StringC("ENTITY")
        if rn = R_FIXED
            return StringC("FIXED")
        if rn = R_ID
            return StringC("ID")
        if rn = R_IDLINK
            return StringC("IDLINK")
        if rn = R_IDREF
            return StringC("IDREF")
        if rn = R_IDREFS
            return StringC("IDREFS")
        if rn = R_IGNORE
            return StringC("IGNORE")
        if rn = R_IMPLICIT
            return StringC("IMPLICIT")
        if rn = R_IMPLIED
            return StringC("IMPLIED")
        if rn = R_INCLUDE
            return StringC("INCLUDE")
        if rn = R_INITIAL
            return StringC("INITIAL")
        if rn = R_LINK
            return StringC("LINK")
        if rn = R_LINKTYPE
            return StringC("LINKTYPE")
        if rn = R_MD
            return StringC("MD")
        if rn = R_MS
            return StringC("MS")
        if rn = R_NAME
            return StringC("NAME")
        if rn = R_NAMES
            return StringC("NAMES")
        if rn = R_NDATA
            return StringC("NDATA")
        if rn = R_NMTOKEN
            return StringC("NMTOKEN")
        if rn = R_NMTOKENS
            return StringC("NMTOKENS")
        if rn = R_NOTATION
            return StringC("NOTATION")
        if rn = R_NUMBER
            return StringC("NUMBER")
        if rn = R_NUMBERS
            return StringC("NUMBERS")
        if rn = R_NUTOKEN
            return StringC("NUTOKEN")
        if rn = R_NUTOKENS
            return StringC("NUTOKENS")
        if rn = R_O
            return StringC("O")
        if rn = R_PCDATA
            return StringC("PCDATA")
        if rn = R_PI
            return StringC("PI")
        if rn = R_POSTLINK
            return StringC("POSTLINK")
        if rn = R_PUBLIC
            return StringC("PUBLIC")
        if rn = R_RCDATA
            return StringC("RCDATA")
        if rn = R_RE
            return StringC("RE")
        if rn = R_REQUIRED
            return StringC("REQUIRED")
        if rn = R_RESTORE
            return StringC("RESTORE")
        if rn = R_RS
            return StringC("RS")
        if rn = R_SDATA
            return StringC("SDATA")
        if rn = R_SHORTREF
            return StringC("SHORTREF")
        if rn = R_SIMPLE
            return StringC("SIMPLE")
        if rn = R_SPACE
            return StringC("SPACE")
        if rn = R_STARTTAG
            return StringC("STARTTAG")
        if rn = R_SUBDOC
            return StringC("SUBDOC")
        if rn = R_SYSTEM
            return StringC("SYSTEM")
        if rn = R_TEMP
            return StringC("TEMP")
        if rn = R_USELINK
            return StringC("USELINK")
        if rn = R_USEMAP
            return StringC("USEMAP")
        StringC()
    }

    ; TokenMessageArg::append (TokenMessageArg.cxx): render a token as
    ; `delimiter "X"` / a character-class fragment / `entity end`, resolved
    ; through the mode's token table against the live syntax.
    function token_message_arg(this: Parser, token: u32, mode: int) returns StringC
    {
        if token >= tokenFirstShortref
            return StringC("short reference delimiter")
        if token = tokenEe
            return StringC("entity end")
        let buf Array[u32]^host()
        let table ModeInfo.build_table(host)
        let sdv *ps.get_sd()
        var mi ModeInfo(mode, sdv, table)
        var info TokenInfo()
        var scanning true
        while scanning and mi.next_token(&info)
        {
            if info.token = token
            {
                set scanning: false
                if (info.kind = TT_DELIM) or (info.kind = TT_DELIMDELIM) or (info.kind = TT_DELIMSET)
                    this.arg_append_delim(buf, info.delim1)
                else if info.kind = TT_SET
                {
                    if info.set_idx = setDigit
                        this.arg_append(buf, StringC("digit"))
                    else if info.set_idx = setNameStart
                        this.arg_append(buf, StringC("name start character"))
                    else if info.set_idx = setSepchar
                        this.arg_append(buf, StringC("sepchar"))
                    else if info.set_idx = setS
                        this.arg_append(buf, StringC("separator"))
                    else if info.set_idx = setNmchar
                        this.arg_append(buf, StringC("name character"))
                    else if info.set_idx = setSgmlChar
                        this.arg_append(buf, StringC("data character"))
                    else if info.set_idx = setMinimumData
                        this.arg_append(buf, StringC("minimum data character"))
                    else if info.set_idx = setSignificant
                        this.arg_append(buf, StringC("significant character"))
                }
                else if info.kind = TT_FUNCTION
                {
                    if info.func_idx = fRE
                        this.arg_append(buf, StringC("record end character"))
                    else if info.func_idx = fRS
                        this.arg_append(buf, StringC("record start character"))
                    else if info.func_idx = fSPACE
                        this.arg_append(buf, StringC("space character"))
                }
            }
        }
        this.arg_to_string(buf)
    }

    ; AllowedParamsMessageArg::append (Param.cxx): the "only ..." list of
    ; paramInvalidToken / markupDeclarationCharacter.
    function allowed_params_message_arg(this: Parser, allow: ref[AllowedParams]) returns StringC
    {
        let buf Array[u32]^host()
        var first true
        if allow.mdc_ok
        {
            this.arg_append_sep(buf, &first)
            this.arg_append_delim(buf, dMDC)
        }
        if allow.dso_ok
        {
            this.arg_append_sep(buf, &first)
            this.arg_append_delim(buf, dDSO)
        }
        if allow.main_mode = mdMinusMode
        {
            this.arg_append_sep(buf, &first)
            this.arg_append_delim(buf, dMINUS)
        }
        else if allow.main_mode = mdPeroMode
        {
            this.arg_append_sep(buf, &first)
            this.arg_append_delim(buf, dPERO)
        }
        if allow.inclusions_ok
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("inclusions"))
        }
        if allow.exclusions_ok
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("exclusions"))
        }
        if allow.literal_type = P_MINIMUMLITERAL
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("minimum literal"))
        }
        else if (allow.literal_type = P_ATTRIBUTEVALUELITERAL) or (allow.literal_type = P_TOKENIZEDATTRIBUTEVALUELITERAL)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("attribute value literal"))
        }
        else if allow.literal_type = P_SYSTEMIDENTIFIER
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("system identifier"))
        }
        else if allow.literal_type = P_PARAMLITERAL
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("parameter literal"))
        }
        if (allow.name_start_type = P_NAME) or (allow.name_start_type = P_ENTITYNAME) or (allow.name_start_type = P_PARAMENTITYNAME)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("name"))
        }
        else if allow.name_start_type = P_ATTRIBUTEVALUE
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("attribute value"))
        }
        if allow.digit_type = P_NUMBER
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("number"))
        }
        if allow.rni_ok or (allow.name_start_type = P_RESERVED_NAME)
        {
            var i 0
            while i < N_NAMES
            {
                if (*(allow.reserved_names + (i as size_t))) <> 0
                {
                    this.arg_append_sep(buf, &first)
                    buf.add(0x22)
                    if allow.rni_ok
                    {
                        let syn ps.get_syntax()
                        let rl syn.delim_general_len(dRNI)
                        var j: size_t 0
                        while j < rl
                        {
                            let rc syn.delim_general_char(dRNI, j)
                            buf.add(rc)
                            set j: j + 1
                        }
                    }
                    let spell this.reserved_name_spelling(i)
                    this.arg_append(buf, spell)
                    buf.add(0x22)
                }
                set i: i + 1
            }
        }
        this.arg_to_string(buf)
    }

    ; AllowedGroupTokensMessageArg::append (Group.cxx). NB the reference never
    ; clears `first` in the #PCDATA/#ALL/#IMPLICIT arms — reproduced faithfully
    ; (only visible when no fragment precedes them, where it drops a listSep).
    function allowed_group_tokens_message_arg(this: Parser, allow: int) returns StringC
    {
        let buf Array[u32]^host()
        var first true
        if this.has_gt(allow, GT_DATATAGLITERAL)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("parameter literal"))
        }
        if this.has_gt(allow, GT_DATATAGGROUP)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("data tag group"))
        }
        if this.has_gt(allow, GT_MODELGROUP)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("model group"))
        }
        else if this.has_gt(allow, GT_DATATAGTEMPLATEGROUP)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("data tag template group"))
        }
        if this.has_gt(allow, GT_ELEMENTTOKEN)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("element token"))
        }
        else if this.has_gt(allow, GT_NAMETOKEN)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("name token"))
        }
        else if this.has_gt(allow, GT_NAME)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("name"))
        }
        let syn ps.get_syntax()
        if this.has_gt(allow, GT_PCDATA)
        {
            if first = false
                this.arg_append(buf, StringC(", "))
            buf.add(0x22)
            let rl syn.delim_general_len(dRNI)
            var j: size_t 0
            while j < rl
            {
                let rc syn.delim_general_char(dRNI, j)
                buf.add(rc)
                set j: j + 1
            }
            let ps_spell this.reserved_name_spelling(R_PCDATA)
            this.arg_append(buf, ps_spell)
            buf.add(0x22)
        }
        if this.has_gt(allow, GT_ALL)
        {
            if first = false
                this.arg_append(buf, StringC(", "))
            buf.add(0x22)
            let rl syn.delim_general_len(dRNI)
            var j: size_t 0
            while j < rl
            {
                let rc syn.delim_general_char(dRNI, j)
                buf.add(rc)
                set j: j + 1
            }
            let all_spell this.reserved_name_spelling(R_ALL)
            this.arg_append(buf, all_spell)
            buf.add(0x22)
        }
        if this.has_gt(allow, GT_IMPLICIT)
        {
            if first = false
                this.arg_append(buf, StringC(", "))
            buf.add(0x22)
            let rl syn.delim_general_len(dRNI)
            var j: size_t 0
            while j < rl
            {
                let rc syn.delim_general_char(dRNI, j)
                buf.add(rc)
                set j: j + 1
            }
            let imp_spell this.reserved_name_spelling(R_IMPLICIT)
            this.arg_append(buf, imp_spell)
            buf.add(0x22)
        }
        this.arg_to_string(buf)
    }

    ; AllowedGroupConnectorsMessageArg::append (Group.cxx): AND, OR, SEQ,
    ; GRPC, DTGC in that order, each as `delimiter "X"`.
    function allowed_group_connectors_message_arg(this: Parser, allow: int) returns StringC
    {
        let buf Array[u32]^host()
        var first true
        if this.has_gc(allow, GC_AND)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append_delim(buf, dAND)
        }
        if this.has_gc(allow, GC_OR)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append_delim(buf, dOR)
        }
        if this.has_gc(allow, GC_SEQ)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append_delim(buf, dSEQ)
        }
        if this.has_gc(allow, GC_GRPC)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append_delim(buf, dGRPC)
        }
        if this.has_gc(allow, GC_DTGC)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append_delim(buf, dDTGC)
        }
        this.arg_to_string(buf)
    }

    ; paramInvalidToken (parseParam.cxx:271) — `%1 invalid: only %2 and
    ; parameter separators are allowed`; suppressed for silent allow sets.
    function param_invalid_token(this: Parser, token: u32, allow: ref[AllowedParams])
    {
        if allow.silent
            return
        let a1 this.token_message_arg(token, allow.main_mode)
        let a2 this.allowed_params_message_arg(allow)
        this.report_raw_raw_at(ParserMessages.paramInvalidToken(), a1, a2, ps.current_input().token_start_location())
    }

    ; groupTokenInvalidToken (parseParam.cxx:475).
    function group_token_invalid_token(this: Parser, token: u32, allow: int)
    {
        let a1 this.token_message_arg(token, grpMode)
        let a2 this.allowed_group_tokens_message_arg(allow)
        this.report_raw_raw_at(ParserMessages.groupTokenInvalidToken(), a1, a2, ps.current_input().token_start_location())
    }

    ; groupConnectorInvalidToken (parseParam.cxx:589).
    function group_connector_invalid_token(this: Parser, token: u32, allow: int)
    {
        let a1 this.token_message_arg(token, grpMode)
        let a2 this.allowed_group_connectors_message_arg(allow)
        this.report_raw_raw_at(ParserMessages.connectorInvalidToken(), a1, a2, ps.current_input().token_start_location())
    }

    function namelen(this: Parser) returns size_t
        ps.get_syntax().get_quantity(qNAMELEN) as size_t

    ; Syntax::penamelen — NAMELEN less the length of the PERO delimiter.
    function penamelen(this: Parser) returns size_t
    {
        let n this.namelen()
        let pn ps.get_syntax().delim_general_len(dPERO)
        n - pn
    }

    ; void extendNameToken(maxLength, tooLong): grow the current token over
    ; name characters; past maxLength report the site's quantity message
    ; (nameLength / nameTokenLength / parameterEntityNameLength /
    ; attributeValueLength) at the token start.
    function extend_name_token(this: Parser, maxlen: size_t, too_long: MessageType)
    {
        let ins ps.current_input()
        if ins = null
            return
        var length ins.current_token_length()
        let syn ps.get_syntax()
        var scanning true
        while scanning
        {
            let ch ins.token_char()
            if syn.is_name_character(ch as u32) = false
                set scanning: false
            else
                set length: length + 1
        }
        if length > maxlen
            this.report_num_at(too_long, maxlen as u64, ins.token_start_location())
        ins.end_token(length)
    }

    ; folded (namecase general) current token / its original spelling.
    function name_folded(this: Parser) returns StringC
        ps.current_token_subst#(ps.get_syntax())

    ; ---- reserved-name lookup (Syntax.lookupReservedName, resident here) ---
    ; Returns the ReservedName ordinal, or -1 if the (folded) name is not one.
    function lookup_reserved_name(this: Parser, name: StringC) returns int
    {
        if name.equals(StringC("ALL"))
            return R_ALL
        if name.equals(StringC("ANY"))
            return R_ANY
        if name.equals(StringC("ATTLIST"))
            return R_ATTLIST
        if name.equals(StringC("CDATA"))
            return R_CDATA
        if name.equals(StringC("CONREF"))
            return R_CONREF
        if name.equals(StringC("CURRENT"))
            return R_CURRENT
        if name.equals(StringC("DATA"))
            return R_DATA
        if name.equals(StringC("DEFAULT"))
            return R_DEFAULT
        if name.equals(StringC("DOCTYPE"))
            return R_DOCTYPE
        if name.equals(StringC("ELEMENT"))
            return R_ELEMENT
        if name.equals(StringC("EMPTY"))
            return R_EMPTY
        if name.equals(StringC("ENDTAG"))
            return R_ENDTAG
        if name.equals(StringC("ENTITIES"))
            return R_ENTITIES
        if name.equals(StringC("ENTITY"))
            return R_ENTITY
        if name.equals(StringC("FIXED"))
            return R_FIXED
        if name.equals(StringC("ID"))
            return R_ID
        if name.equals(StringC("IDLINK"))
            return R_IDLINK
        if name.equals(StringC("IDREF"))
            return R_IDREF
        if name.equals(StringC("IDREFS"))
            return R_IDREFS
        if name.equals(StringC("IGNORE"))
            return R_IGNORE
        if name.equals(StringC("IMPLICIT"))
            return R_IMPLICIT
        if name.equals(StringC("IMPLIED"))
            return R_IMPLIED
        if name.equals(StringC("INCLUDE"))
            return R_INCLUDE
        if name.equals(StringC("INITIAL"))
            return R_INITIAL
        if name.equals(StringC("LINK"))
            return R_LINK
        if name.equals(StringC("LINKTYPE"))
            return R_LINKTYPE
        if name.equals(StringC("MD"))
            return R_MD
        if name.equals(StringC("MS"))
            return R_MS
        if name.equals(StringC("NAME"))
            return R_NAME
        if name.equals(StringC("NAMES"))
            return R_NAMES
        if name.equals(StringC("NDATA"))
            return R_NDATA
        if name.equals(StringC("NMTOKEN"))
            return R_NMTOKEN
        if name.equals(StringC("NMTOKENS"))
            return R_NMTOKENS
        if name.equals(StringC("NOTATION"))
            return R_NOTATION
        if name.equals(StringC("NUMBER"))
            return R_NUMBER
        if name.equals(StringC("NUMBERS"))
            return R_NUMBERS
        if name.equals(StringC("NUTOKEN"))
            return R_NUTOKEN
        if name.equals(StringC("NUTOKENS"))
            return R_NUTOKENS
        if name.equals(StringC("O"))
            return R_O
        if name.equals(StringC("PCDATA"))
            return R_PCDATA
        if name.equals(StringC("PI"))
            return R_PI
        if name.equals(StringC("POSTLINK"))
            return R_POSTLINK
        if name.equals(StringC("PUBLIC"))
            return R_PUBLIC
        if name.equals(StringC("RCDATA"))
            return R_RCDATA
        if name.equals(StringC("RE"))
            return R_RE
        if name.equals(StringC("REQUIRED"))
            return R_REQUIRED
        if name.equals(StringC("RESTORE"))
            return R_RESTORE
        if name.equals(StringC("RS"))
            return R_RS
        if name.equals(StringC("SDATA"))
            return R_SDATA
        if name.equals(StringC("SHORTREF"))
            return R_SHORTREF
        if name.equals(StringC("SIMPLE"))
            return R_SIMPLE
        if name.equals(StringC("SPACE"))
            return R_SPACE
        if name.equals(StringC("STARTTAG"))
            return R_STARTTAG
        if name.equals(StringC("SUBDOC"))
            return R_SUBDOC
        if name.equals(StringC("SYSTEM"))
            return R_SYSTEM
        if name.equals(StringC("TEMP"))
            return R_TEMP
        if name.equals(StringC("USELINK"))
            return R_USELINK
        if name.equals(StringC("USEMAP"))
            return R_USEMAP
        -1
    }

    ; ---- build a StringC from a growing u32 buffer ------------------------
    function build_stringc(this: Parser, buf: ref[Array[u32]]) returns StringC
    {
        let n buf.get_length()
        if n = 0
            return StringC()
        ; Build the StringC page-resident on `host` (^host) so its init's
        ; Page.get(this) resolves to a valid region page. Constructing it as a
        ; by-VALUE return (StringC(cb, n)) instead puts `this` on a stack sret
        ; slot whose Page.get masks to a bogus, per-call-IDENTICAL header — so
        ; every literal's buffer aliased the same address (the Page.get-on-by-
        ; value hazard). ^host copies buf into a fresh host buffer; *scp returns
        ; the {data,size} value pointing at it.
        let scp StringC^host(buf.get_buffer(), n)
        *scp
    }

    ; StringC (u32 content) -> byte String (ASCII narrowing for external ids).
    function stringc_to_bytes(this: Parser, sc: StringC) returns String
    {
        let n sc.get_size()
        let buf host.allocate(n + 1, 1) as pointer[u8]
        var i: size_t 0
        while i < n
        {
            set *(buf + i): sc.get(i) as u8
            set i: i + 1
        }
        set *(buf + n): 0
        String(buf as pointer[const_char], n)
    }

    ; ---- lookup-create helpers (Parser::lookupCreate*) --------------------
    function lookup_create_element(this: Parser, name: StringC) returns ref[ElementType]?
    {
        let dtd ps.get_def_dtd()
        let existing dtd.lookup_element_type(name)
        if existing <> null
            return existing
        ; parseDecl.cxx:837: inside an LPD, an element type absent from the
        ; SOURCE dtd is never created — noSuchSourceElement, null.
        if ps.have_def_lpd()
        {
            this.report1_at(ParserMessages.noSuchSourceElement(), name, ps.current_input().token_start_location())
            return null
        }
        let idx dtd.alloc_element_type_index()
        let e ElementType.make(host, name, idx)
        dtd.insert_element_type(e)
        e
    }

    ; lookupCreateRankStem (parseDecl.cxx:846) — find or create the rank stem
    ; named `name`. A NEWLY-created stem whose name is already a DEFINED element
    ; type's generic identifier is a rankStemGenericIdentifier error (reported
    ; here UNCONDITIONALLY, unlike the validate-gated loop in parseElementDecl).
    function lookup_create_rank_stem(this: Parser, name: StringC) returns ref[RankStem]
    {
        let dtd ps.get_def_dtd()
        let existing dtd.lookup_rank_stem(name)
        if existing <> null
            return existing as ref[RankStem]
        let nidx dtd.n_rank_stem()
        let r RankStem.make(host, name, nidx)
        dtd.insert_rank_stem(r)
        let e dtd.lookup_element_type(name)
        if e <> null
            if e.get_definition() <> null
                this.report1_at(ParserMessages.rankStemGenericIdentifier(), name, ps.current_input().token_start_location())
        r
    }

    ; completeRankStem (parseInstance.cxx:475) — a GI that is not itself an
    ; element type may be a rank stem: build stem-name + current-rank-suffix and
    ; look that up. noCurrentRank when the stem has no current rank suffix.
    function complete_rank_stem(this: Parser, name: StringC) returns ref[ElementType]?
    {
        let dtd ps.get_current_dtd()
        let rank_stem dtd.lookup_rank_stem(name)
        if rank_stem = null
            return null
        let buf Array[u32]^host()
        this.arg_append(buf, rank_stem.get_name())
        if ps.append_current_rank(buf, rank_stem) = false
        {
            ; append failed — buf still holds just the stem name (the message arg).
            let stem_name StringC^host(buf.get_buffer(), buf.get_length())
            this.report1(ParserMessages.noCurrentRank(), stem_name)
            return null
        }
        let full StringC^host(buf.get_buffer(), buf.get_length())
        dtd.lookup_element_type(full)
    }

    ; handleRankedElement (parseInstance.cxx:488) — the element's rank suffix
    ; becomes the current rank for every stem in every definition of its stem.
    function handle_ranked_element(this: Parser, e: ref[ElementType])
    {
        let def e.get_definition()
        let rank_suffix def.get_rank_suffix()
        let suf_ptr StringC^host(rank_suffix.data_ptr(), rank_suffix.get_size())
        let rank_stem e.ranked_element_rank_stem()
        var i: size_t 0
        let nd rank_stem.n_definitions()
        while i < nd
        {
            let d rank_stem.definition(i)
            var j: size_t 0
            let njs d.n_rank_stems()
            while j < njs
            {
                ps.set_current_rank(d.rank_stem(j), suf_ptr)
                set j: j + 1
            }
            set i: i + 1
        }
    }

    function lookup_create_notation(this: Parser, name: StringC) returns ref[Notation]
    {
        let dtd ps.get_def_dtd()
        let existing dtd.lookup_notation(name)
        if existing <> null
            return existing as ref[Notation]
        let nt Notation.make(host, name, dtd.get_name(), dtd.get_is_base())
        dtd.insert_notation(nt)
        nt
    }

    function lookup_create_map(this: Parser, name: StringC) returns ref[ShortReferenceMap]
    {
        let dtd ps.get_def_dtd()
        let existing dtd.lookup_short_reference_map(name)
        if existing <> null
            return existing as ref[ShortReferenceMap]
        let map ShortReferenceMap.make(host, name)
        dtd.insert_short_reference_map(map)
        map
    }

    ; ---- literal parsing (parseLiteral, scoped) ---------------------------
    ; Accumulates literal content; single_space collapses runs of space to one.
    ; Entity/char references inside literals are DEFERRED (recover + false).
    ; The `e` (in-entity) variant of a literal mode: parseCommon.cxx switches the
    ; scan mode to this while inside a pushed entity, where LIT/LITA are NOT
    ; delimiters (so a `"` produced by `&quot;` does not close the literal).
    function lite_mode_for(this: Parser, lit_mode: int) returns int
    {
        if (lit_mode = alitMode) or (lit_mode = alitaMode)
            return aliteMode
        if (lit_mode = talitMode) or (lit_mode = talitaMode)
            return taliteMode
        if (lit_mode = plitMode) or (lit_mode = plitaMode)
            return pliteMode
        lit_mode
    }

    function parse_literal(this: Parser, lit_mode: int, single_space: bool, data_tag: bool, max_length: size_t, too_long: MessageType, out_text: ref[Text]) returns bool
    {
        let start_level ps.get_input_level()
        let lite_mode this.lite_mode_for(lit_mode)
        ; currentMode (parseCommon.cxx): starts at lit_mode, flips to the `e`
        ; variant while an entity reference is open (inputLevel > startLevel),
        ; and back once the entity ends and we return to startLevel.
        var cur_mode lit_mode
        ; Every buffer below lives on the page of the TEXT WE ARE FILLING, not
        ; on the run page. Three of them have to: `set *out_text: Text(sc,
        ; locbuf.get_buffer(), srp, nsp)` at the end of this function BORROWS
        ; locbuf/sruns/nsitems — only `sc` is a copy — so they share the Text's
        ; lifetime, not this call's. `buf` and `hu` follow for free.
        ;
        ; Measured 2026-08-02 (tests/dazzle/PERFORMANCE.md): with everything on
        ; the run page this was the largest single retainer of a parse — the
        ; location spur alone is 16 bytes PER CHARACTER, more than the text it
        ; annotates, and it never died before the parse did. Deriving the page
        ; from out_text puts an instance attribute's literal on the drainable
        ; attribute scratch and a declaration's on the run page, without this
        ; function knowing which is which. Every caller allocates its Text with
        ; <page>.allocate (never a stack local), so Page.get is sound here.
        let text_page Page.get(out_text as pointer[void])
        let buf Array[u32]^text_page()
        ; per-char source locations, parallel to buf (Text::addChar's Location
        ; argument): the ID/IDREF token locations must survive entity expansion
        ; and normalization, so every stored char carries where it came from.
        let locbuf Array[Location]^text_page()
        ; SDATA item runs (Text::addSdata): flat (start,end) index pairs into
        ; buf — filled by lit_reference_entity's non-squeeze SDATA arm, the
        ; ESIS attribute writer renders those ranges between `\|` markers.
        let sruns Array[size_t]^text_page()
        ; non-SGML items (Text::addNonSgmlChar): flat (index, char) pairs —
        ; the CDATA-attribute-literal arm below records where a non-SGML
        ; numeric char ref sat; -ononsgml renders `\%N;` there.
        let nsitems Array[size_t]^text_page()
        let space: u32 0x20
        ; startLoc (parseCommon.cxx:78) — the opening LIT/LITA delimiter, the
        ; token the caller consumed just before calling: the location of the
        ; guessed-unterminated-literal recovery message.
        let start_loc ps.current_input().token_start_location()
        ; reallyMaxLength (parseCommon.cxx:74): past twice the limit, a record
        ; end at the base input level is taken as a missing closing delimiter.
        ; The "no limit" sentinel, and the type is load-bearing: as an
        ; UNTYPED binding this took its type from the initializer, so the
        ; casts that used to sit on the literals were the type annotation in
        ; disguise. Written as an `int` it holds -1 and the `really_max / 2`
        ; below answers 0 instead of half of SIZE_MAX (sdiv, not udiv).
        var really_max: size_t 0 - 1
        if max_length <= (really_max / 2)
            set really_max: max_length * 2
        let hu text_page.allocate(sizeof HuState, alignof HuState) as pointer[HuState]
        set *hu: HuState()
        var running true
        var ok true
        while running
        {
            let token ps.get_token(cur_mode)
            if (token = tokenLit) or (token = tokenLita)
                set running: false
            else if token = tokenEe
            {
                if ps.get_input_level() = start_level
                {
                    ; literalLevel (parseCommon.cxx:86): the entity that opened
                    ; the literal ended inside it.
                    this.report0_at(ParserMessages.literalLevel(), ps.current_input().token_start_location())
                    set ok: false
                    set running: false
                }
                else
                {
                    ps.pop_input_stack()
                    ; entity-end item (Text::addEntityEnd) — resets the
                    ; unterminated-guess candidate.
                    hu.note_reset(buf)
                    ; back at the base input level → LIT/LITA are delimiters again.
                    if ps.get_input_level() = start_level
                        set cur_mode: lit_mode
                }
            }
            else if token = tokenRs
            {
                ; ignore record start
            }
            else if (token = tokenRe) or (token = tokenSepchar)
            {
                ; a record end past twice the limit at the base input level:
                ; guess that the closing delimiter has been omitted
                ; (parseCommon.cxx:130) — report at the opening delimiter and
                ; fail the literal; the caller recovers.
                if token = tokenRe
                {
                    if (buf.get_length() > really_max) and (ps.get_input_level() = start_level)
                    {
                        this.report0_at(ParserMessages.literalClosingDelimiter(), start_loc)
                        return false
                    }
                }
                if single_space and ((buf.get_length() = 0) or (this.last_char(buf) = space))
                {
                    ; ignore
                }
                else
                {
                    hu.note_space(buf)
                    buf.add(space)
                    locbuf.add(ps.current_input().token_start_location())
                }
            }
            else if token = tokenSpace
            {
                if single_space and ((buf.get_length() = 0) or (this.last_char(buf) = space))
                {
                    ; ignore
                }
                else
                {
                    hu.note_space(buf)
                    buf.add(ps.current_input().current_char())
                    locbuf.add(ps.current_input().token_start_location())
                }
            }
            else if (token = tokenChar) or (token = tokenCharDelim)
            {
                ; parseCommon.cxx:198: a data char that starts a delimiter
                ; (recognized only under -wdata-delim) warns, then joins the
                ; literal exactly like tokenChar (the reference falls through).
                if token = tokenCharDelim
                {
                    let dd_str ps.current_token^host()
                    this.report1_at(ParserMessages.dataCharDelim(), dd_str, ps.current_input().token_start_location())
                }
                ; a data RE char past twice the limit at the base input level
                ; (parseCommon.cxx:204): same missing-closing-delimiter guess
                ; as the tokenRe arm.
                let lc0 ps.current_input().current_char()
                if (buf.get_length() > really_max) and (ps.get_input_level() = start_level) and (lc0 = 0x0D)
                {
                    this.report0_at(ParserMessages.literalClosingDelimiter(), start_loc)
                    return false
                }
                ; a non-SGML character in a literal (attribute value / parameter
                ; literal). Our scanner admits C0/DEL as sgmlChar (they stay data
                ; in content), so they arrive as tokenChar rather than the
                ; reference's tokenUnrecognized; report each and DROP it from the
                ; literal, exactly as reportNonSgmlCharacter does in parseCommon.
                let lc ps.current_input().current_char()
                if this.is_non_sgml_char(lc)
                {
                    let mt ParserMessages.nonSgmlCharacter()
                    let loc ps.current_input().token_start_location()
                    this.report_num_at(mt, lc as u64, loc)
                }
                else
                {
                    let dloc ps.current_input().token_start_location()
                    hu.note_data(buf, dloc)
                    buf.add(lc)
                    locbuf.add(dloc)
                }
            }
            else if token = tokenEroGrpo
            {
                ; parseLiteral case tokenEroGrpo (parseCommon.cxx:167): an ERO
                ; with a name group is not allowed in a literal — one message
                ; (start-tag flavor in the instance), the `&(` is dropped, and
                ; the literal scan continues.
                let gloc ps.current_input().token_start_location()
                if ps.is_in_instance()
                    this.report0_at(ParserMessages.eroGrpoStartTag(), gloc)
                else
                    this.report0_at(ParserMessages.eroGrpoProlog(), gloc)
            }
            else if token = tokenPeroGrpo
            {
                ; parseLiteral case tokenPeroGrpo (parseCommon.cxx:195).
                this.report0_at(ParserMessages.peroGrpoProlog(), ps.current_input().token_start_location())
            }
            else if token = tokenEroNameStart
            {
                ; Entity::litReference — a general entity reference in a
                ; literal: a TEXT entity STACKS like a content reference (its
                ; chars then scan as literal content; the tokenEe arm above
                ; pops it — this is how `&lt;` inside an attribute value
                ; becomes a literal `<`); CDATA/SDATA entities join the
                ; literal directly; PI / external non-text entities report.
                ; The no-DTD guard has no reference counterpart (parseEntityReference
                ; assumes a DTD): every literal mode that recognizes an ERO runs
                ; inside a DOCTYPE declaration or an instance, where a DTD exists —
                ; unreachable, kept only to protect lookup_entity from a null DTD.
                if ps.get_current_dtd() = null
                {
                    set ok: false
                    set running: false
                }
                else
                {
                    var lit_ent: pointer[Entity] null
                    var lit_ename StringC()
                    var lit_ref_start Location()
                    var lit_ref_len: size_t 0
                    var lit_refc_loc Location()
                    if this.resolve_general_entity_ref(false, &lit_ent, &lit_ename, &lit_ref_start, &lit_ref_len, &lit_refc_loc) = false
                    {
                        set ok: false
                        set running: false
                    }
                    else
                    {
                        if lit_ent <> null
                            this.lit_reference_entity(lit_ent, lit_ename, lit_ref_start, lit_ref_len, lit_refc_loc, buf, locbuf, sruns, hu, single_space)
                        ; entity-start item (Entity::litReference) — resets the
                        ; unterminated-guess candidate.
                        hu.note_reset(buf)
                        ; entity pushed → scan its chars in the `e` variant, where a
                        ; `"`/`'` (e.g. from `&quot;`) is data, not a literal close.
                        if ps.get_input_level() > start_level
                            set cur_mode: lite_mode
                    }
                }
            }
            else if (token = tokenCroDigit) or (token = tokenHcroHexDigit)
            {
                var ch: u32 0
                var refc_loc Location()
                let is_hex_ref token = tokenHcroHexDigit
                ; the CRO/HCRO token start — the reference stores the char with
                ; parseNumericCharRef's startLocation (parseCommon.cxx:135).
                let cro_loc ps.current_input().token_start_location()
                if this.parse_numeric_char_ref(is_hex_ref, &ch, &refc_loc)
                {
                    var is_sgml true
                    if this.translate_numeric_char_ref(&ch, &is_sgml, refc_loc)
                    {
                        if is_sgml
                        {
                            ; literalDataTag (parseCommon.cxx:149): a numeric
                            ; char ref in a data-tag parameter literal may not
                            ; denote a non-SGML char (dataTagPatternNonSgml) nor
                            ; a function char — RE/RS/SPACE (dataTagPatternFunction);
                            ; reported at the REFC, the char is still added.
                            if data_tag
                            {
                                if this.is_non_sgml_char(ch)
                                    this.report0_at(ParserMessages.dataTagPatternNonSgml(), refc_loc)
                                else
                                {
                                    let fset ps.get_syntax().char_set(setFunctionChar)
                                    if fset.contains(ch)
                                        this.report0_at(ParserMessages.dataTagPatternFunction(), refc_loc)
                                }
                            }
                            hu.note_data(buf, cro_loc)
                            buf.add(ch)
                            ; the char's location is the CRO start (the
                            ; reference stores parseNumericCharRef's
                            ; startLocation) — NOT the post-ref token.
                            locbuf.add(cro_loc)
                        }
                        else
                        {
                            ; non-SGML-char item (Text::addNonSgmlChar) —
                            ; resets the unterminated-guess candidate.
                            hu.note_reset(buf)
                            ; parseLiteral (parseCommon.cxx:139): a declared
                            ; non-SGML char (UNUSED range) in a literal. CDATA
                            ; attribute values carry the literalNonSgml flag
                            ; (parseAttribute.cxx:398) and admit it SILENTLY
                            ; (Text::addNonSgmlChar — the ESIS attribute writer
                            ; drops it; verified vs onsgmls 1.5.2, exit 0);
                            ; every other literal — tokenized attribute values,
                            ; parameter literals — reports
                            ; numericCharRefLiteralNonSgml (E1, at the REFC)
                            ; and drops the char, the literal continuing.
                            if (lit_mode = alitMode) or (lit_mode = alitaMode)
                            {
                                ; Text::addNonSgmlChar — remember the item's
                                ; position for the -ononsgml attribute writer.
                                nsitems.add(buf.get_length())
                                nsitems.add(ch as size_t)
                            }
                            else
                                this.report_num_at(ParserMessages.numericCharRefLiteralNonSgml(), ch as u64, refc_loc)
                        }
                    }
                    ; translate false: already reported, char dropped, literal
                    ; continues (the reference case's `break`)
                }
                else
                {
                    ; parseNumericCharRef failed (characterNumber, reported
                    ; there) -> the WHOLE literal parse fails (the reference
                    ; returns 0 from parseLiteral); the caller recovers.
                    set ok: false
                    set running: false
                }
            }
            else if token = tokenPeroNameStart
            {
                ; parseLiteral case tokenPeroNameStart: Entity::litReference for a
                ; parameter entity -> `%pe;` inside a parameter literal STACKS the
                ; PE like a content reference; its chars then scan as literal
                ; content in the `e` variant (the tokenEe arm above pops it).
                ; Parameter literals occur only in declarations, so a DTD always
                ; exists; the null guard is unreachable (see the ERO arm above).
                ; parseCommon.cxx:176: a PE reference in a literal at the top
                ; level of the internal subset warns under
                ; -winternal-subset-literal-param-entity.
                let opt_il ps.get_options()
                if opt_il.warn_internal_subset_literal_param_entity_ref and (ps.get_input_level() = 1)
                    this.report0_at(ParserMessages.internalSubsetLiteralParamEntityRef(), ps.current_input().token_start_location())
                if ps.get_current_dtd() = null
                {
                    set ok: false
                    set running: false
                }
                else
                {
                    if this.parse_parameter_entity_reference(false, PE_CTX_LIT) = false
                    {
                        set ok: false
                        set running: false
                    }
                    else
                    {
                        ; entity-start item — resets the unterminated-guess
                        ; candidate (as in the general-entity arm).
                        hu.note_reset(buf)
                        if ps.get_input_level() > start_level
                            set cur_mode: lite_mode
                    }
                }
            }
            else if token = tokenCroNameStart
            {
                ; a named function char ref in a literal (parseLiteral,
                ; parseCommon.cxx:163): the char is pushed back and re-scans
                ; as literal content in the current mode (`&#SPACE;` in an
                ; attribute value contributes a space through the tokenSepchar
                ; arm above).
                this.parse_named_char_ref()
            }
            else if token = tokenUnrecognized
            {
                ; parseLiteral (parseCommon.cxx:94): a genuine non-SGML
                ; character reports nonSgmlCharacter; any other unrecognized
                ; character is not minimum data in this literal's mode —
                ; literalMinimumData, arg = the char. Either way the char is
                ; consumed and DROPPED (it is not literal data). The zero-
                ; length unrecognized token used to loop here forever ('%' in
                ; a minimum literal) — report_non_sgml_param consumes it.
                if this.report_non_sgml_param() = false
                {
                    let ins ps.current_input()
                    let ts ins.current_token_string()
                    let cs StringC^host(ts.data_ptr(), ts.get_size())
                    this.report1_at(ParserMessages.literalMinimumData(), *cs, ins.token_start_location())
                }
            }
            else
            {
                ; other tokens in literal context: treat first char as data.
                let oloc ps.current_input().token_start_location()
                hu.note_data(buf, oloc)
                buf.add(ps.current_input().current_char())
                locbuf.add(oloc)
            }
        }
        if ok = false
            return false
        ; parseLiteral's `done:` epilogue (parseCommon.cxx:219): under
        ; literalSingleSpace a TRAILING space is dropped — ignoreLastChar
        ; tests only the last char, so a space entered via `&#32;` is dropped
        ; too. An all-space/empty tokenized value therefore ends up EMPTY,
        ; which is what makes attributeValueSyntax reachable.
        var out_n buf.get_length()
        if single_space
        {
            if out_n > 0
            {
                if this.last_char(buf) = 0x20
                    set out_n: out_n - 1
            }
        }
        ; the maxLength check (parseCommon.cxx:223), on the size AFTER the
        ; trailing-space drop. For attribute-value literals the reference
        ; first tries the unterminated-literal guess
        ; (AttributeValue::handleAsUnterminated): if the last data item, its
        ; trailing spaces stripped, ends with the VI delimiter, report
        ; literalClosingDelimiter at the literal's FIRST item location and
        ; fail the literal; otherwise the too-long quantity message.
        if out_n > max_length
        {
            if (lit_mode = alitMode) or (lit_mode = alitaMode) or (lit_mode = talitMode) or (lit_mode = talitaMode)
            {
                hu.close(buf)
                if hu.have_last
                {
                    var ll hu.last_len
                    while (ll > 0) and (*(buf.get_buffer() + hu.last_start + ll - 1) = space)
                        set ll: ll - 1
                    let syn ps.get_syntax()
                    let vn syn.delim_general_len(dVI)
                    if (vn > 0) and (ll >= vn)
                    {
                        var vi_match true
                        var vj: size_t 0
                        while vj < vn
                        {
                            if *(buf.get_buffer() + hu.last_start + ll - vn + vj) <> syn.delim_general_char(dVI, vj)
                                set vi_match: false
                            set vj: vj + 1
                        }
                        if vi_match
                        {
                            let first_loc *(locbuf.get_buffer())
                            this.report0_at(ParserMessages.literalClosingDelimiter(), first_loc)
                            return false
                        }
                    }
                }
            }
            this.report_num_at(too_long, max_length as u64, ps.current_input().token_start_location())
        }
        var sc StringC()
        if out_n > 0
        {
            let scp StringC^text_page(buf.get_buffer(), out_n)
            set sc: *scp
        }
        var srp: ref[Array[size_t]]? null
        if sruns.get_length() > 0
            set srp: sruns
        var nsp: ref[Array[size_t]]? null
        if nsitems.get_length() > 0
            set nsp: nsitems
        set out_text: Text(sc, locbuf.get_buffer(), srp, nsp)
        true
    }

    function last_char(this: Parser, buf: ref[Array[u32]]) returns u32
    {
        let n buf.get_length()
        if n = 0
            return 0 as u32
        *(buf.get_buffer() + (n - 1))
    }

    ; parseDataTagParameterLiteral (parseParam.cxx:985): a parameter literal in
    ; a data-tag pattern — plit(a)Mode, the DTEMPLEN limit, and the
    ; literalDataTag flag (the pattern char-ref restrictions).
    function parse_data_tag_parameter_literal(this: Parser, lita: bool, out_text: ref[Text]) returns bool
    {
        var m: int plitMode
        if lita
            set m: plitaMode
        let dtemplen ps.get_syntax().get_quantity(qDTEMPLEN) as size_t
        this.parse_literal(m, false, true, dtemplen, ParserMessages.dataTagPatternLiteralLength(), out_text)
    }

    ; ---- parseParam (parseParam.cxx) --------------------------------------
    function parse_param(this: Parser, allow: ref[AllowedParams], decl_input_level: u32, parm: ref[Param]) returns bool
    {
        var looping true
        while looping
        {
            let token ps.get_token(allow.main_mode)
            if token = tokenUnrecognized
            {
                ; a reported non-SGML character is skipped and the loop continues
                ; (parseParam.cxx:27); an SGML character is a hard error.
                if this.report_non_sgml_param() = false
                {
                    let ct ps.current_token()
                    let a2 this.allowed_params_message_arg(allow)
                    this.report_str_raw_at(ParserMessages.markupDeclarationCharacter(), ct, a2, ps.current_input().token_start_location())
                    return false
                }
            }
            else if token = tokenEe
            {
                if ps.get_input_level() <= decl_input_level
                {
                    ; declarationLevel: the entity that opened the declaration
                    ; ended inside a parameter separator.
                    this.report0_at(ParserMessages.declarationLevel(), ps.current_input().token_start_location())
                    return false
                }
                ps.pop_input_stack()
                ps.note_ms_s_sync()
            }
            else if token = tokenCom
            {
                ; a comment in a parameter separator (parseParam.cxx:44): parse
                ; it and continue; it warns under -wps-comment AFTER the parse.
                if this.parse_comment(comMode, null) = false
                    return false
                let opt_pc ps.get_options()
                if opt_pc.warn_ps_comment
                    this.report0_at(ParserMessages.psComment(), ps.current_input().token_start_location())
            }
            else if token = tokenDso
            {
                if allow.dso_ok = false
                {
                    this.param_invalid_token(tokenDso, allow)
                    return false
                }
                set parm.kind: P_DSO
                return true
            }
            else if token = tokenGrpo
            {
                if allow.group_type = P_MODELGROUP
                {
                    var grp: pointer[CmNode] null
                    if this.parse_model_group(1, decl_input_level, &grp, grpsufMode) = false
                        return false
                    set parm.model_group: grp
                    set parm.kind: P_MODELGROUP
                    return true
                }
                else if allow.group_type = P_NAMEGROUP
                {
                    if this.parse_name_group(decl_input_level, parm) = false
                        return false
                    set parm.kind: P_NAMEGROUP
                    return true
                }
                else if allow.group_type = P_NAMETOKENGROUP
                {
                    if this.parse_name_token_group(decl_input_level, parm) = false
                        return false
                    set parm.kind: P_NAMETOKENGROUP
                    return true
                }
                else
                {
                    this.param_invalid_token(tokenGrpo, allow)
                    return false
                }
            }
            else if (token = tokenLit) or (token = tokenLita)
            {
                set parm.kind: allow.literal_type
                set parm.lita: token = tokenLita
                if allow.literal_type = P_INVALID
                {
                    this.param_invalid_token(token, allow)
                    return false
                }
                let txt host.allocate(sizeof Text, alignof Text) as pointer[Text]
                ; each literal kind carries its own maxLength + quantity
                ; message (parseParam.cxx:954-991 / parseAttribute.cxx:389):
                ; minimum literal = the REFERENCE LITLEN (240), system id /
                ; param literal = LITLEN, attribute values = LITLEN - NORMSEP
                ; (via the shared wrappers, including the negative-limit edge).
                var lit_ok true
                if allow.literal_type = P_MINIMUMLITERAL
                {
                    var lmode: int mlitMode
                    if parm.lita
                        set lmode: mlitaMode
                    let syn ps.get_syntax()
                    set lit_ok: this.parse_literal(lmode, true, false, syn.reference_quantity(qLITLEN) as size_t, ParserMessages.minimumLiteralLength(), txt)
                }
                else if allow.literal_type = P_SYSTEMIDENTIFIER
                {
                    var lmode: int slitMode
                    if parm.lita
                        set lmode: slitaMode
                    set lit_ok: this.parse_literal(lmode, false, false, ps.get_syntax().get_quantity(qLITLEN) as size_t, ParserMessages.systemIdentifierLength(), txt)
                }
                else if allow.literal_type = P_ATTRIBUTEVALUELITERAL
                    set lit_ok: this.parse_attribute_value_literal(parm.lita, txt)
                else if allow.literal_type = P_TOKENIZEDATTRIBUTEVALUELITERAL
                    set lit_ok: this.parse_tokenized_attribute_value_literal(parm.lita, txt)
                else
                {
                    var lmode: int plitMode
                    if parm.lita
                        set lmode: plitaMode
                    set lit_ok: this.parse_literal(lmode, false, false, ps.get_syntax().get_quantity(qLITLEN) as size_t, ParserMessages.parameterLiteralLength(), txt)
                }
                if lit_ok = false
                    return false
                set parm.literal_text: txt
                return true
            }
            else if token = tokenMdc
            {
                if allow.mdc_ok = false
                {
                    this.param_invalid_token(tokenMdc, allow)
                    return false
                }
                ; parameterEntityNotEnded (parseParam.cxx:126): a PE referenced
                ; in a parameter separator must end in the same declaration.
                if ps.get_input_level() > decl_input_level
                    this.report0_at(ParserMessages.parameterEntityNotEnded(), ps.current_input().token_start_location())
                set parm.kind: P_MDC
                return true
            }
            else if token = tokenMinus
            {
                set parm.kind: P_MINUS
                return true
            }
            else if token = tokenMinusGrpo
            {
                if allow.exclusions_ok = false
                {
                    this.param_invalid_token(tokenMinusGrpo, allow)
                    return false
                }
                set parm.kind: P_EXCLUSIONS
                return this.parse_element_name_group(decl_input_level, parm)
            }
            else if token = tokenPero
            {
                set parm.kind: P_PERO
                return true
            }
            else if (token = tokenPeroNameStart) or (token = tokenPeroGrpo)
            {
                ; parseParam case tokenPeroNameStart: a parameter-entity reference
                ; where a parameter is expected -> declReference stacks it; the
                ; loop continues, reading the replacement text as the parameter
                ; (the tokenEe arm above pops the entity when it is exhausted).
                ; A name group in the reference (`%(`, CONCUR/LINK) is not
                ; allowed OUTSIDE the instance (parseParam.cxx:152); the group
                ; still parses, and an inactive one ignores the reference.
                if token = tokenPeroGrpo
                {
                    if ps.is_in_instance() = false
                        this.report0_at(ParserMessages.peroGrpoProlog(), ps.current_input().token_start_location())
                }
                ; parseParam.cxx:158-165: a PE reference in the instance warns
                ; under -winstance-param-entity, one at the top level of the
                ; internal subset under -winternal-subset-ps-param-entity.
                let opt_pe ps.get_options()
                if ps.is_in_instance()
                {
                    if opt_pe.warn_instance_param_entity_ref
                        this.report0_at(ParserMessages.instanceParamEntityRef(), ps.current_input().token_start_location())
                }
                else if opt_pe.warn_internal_subset_ps_param_entity_ref and (ps.get_input_level() = 1)
                    this.report0_at(ParserMessages.internalSubsetPsParamEntityRef(), ps.current_input().token_start_location())
                if this.parse_parameter_entity_reference(token = tokenPeroGrpo, PE_CTX_DECL) = false
                    return false
                ps.note_ms_s_sync()
            }
            else if token = tokenPlusGrpo
            {
                if allow.inclusions_ok = false
                {
                    this.param_invalid_token(tokenPlusGrpo, allow)
                    return false
                }
                set parm.kind: P_INCLUSIONS
                return this.parse_element_name_group(decl_input_level, parm)
            }
            else if token = tokenRni
            {
                if allow.rni_ok = false
                {
                    this.param_invalid_token(tokenRni, allow)
                    return false
                }
                return this.parse_indicated_reserved_name(allow, parm)
            }
            else if token = tokenS
            {
                ; whitespace between parameters: skip (recorded during a
                ; marked-section status parse — -winstance-status-keyword-s).
                ps.note_ms_s(ps.current_input().token_start_location())
            }
            else if token = tokenNameStart
            {
                if allow.name_start_type = P_INVALID
                {
                    this.param_invalid_token(tokenNameStart, allow)
                    return false
                }
                else if allow.name_start_type = P_RESERVED_NAME
                    return this.parse_reserved_name(allow, parm)
                else if allow.name_start_type = P_NAME
                {
                    this.extend_name_token(this.namelen(), ParserMessages.nameLength())
                    set parm.kind: P_NAME
                    set parm.orig_token: ps.current_token^host()
                    set parm.token: this.name_folded^host()
                    return true
                }
                else if allow.name_start_type = P_ENTITYNAME
                {
                    this.extend_name_token(this.namelen(), ParserMessages.nameLength())
                    set parm.kind: P_ENTITYNAME
                    ; NAMECASE ENTITY NO: entity names stay case-exact (unlike
                    ; P_NAME above, which folds under NAMECASE GENERAL YES).
                    set parm.token: ps.current_token^host()
                    return true
                }
                else if allow.name_start_type = P_PARAMENTITYNAME
                {
                    this.extend_name_token(this.penamelen(), ParserMessages.parameterEntityNameLength())
                    set parm.kind: P_PARAMENTITYNAME
                    ; NAMECASE ENTITY NO: parameter-entity names stay case-exact.
                    set parm.token: ps.current_token^host()
                    return true
                }
                else if allow.name_start_type = P_ATTRIBUTEVALUE
                    return this.parse_attribute_value_param(parm)
                else
                {
                    ; every name-start type is handled above — the reference
                    ; switch has no further case (CANNOT_HAPPEN).
                    return false
                }
            }
            else if token = tokenDigit
            {
                if allow.digit_type = P_NUMBER
                {
                    this.extend_number(this.namelen())
                    set parm.kind: P_NUMBER
                    set parm.token: ps.current_token^host()
                    return true
                }
                else if allow.digit_type = P_ATTRIBUTEVALUE
                    return this.parse_attribute_value_param(parm)
                else
                {
                    this.param_invalid_token(tokenDigit, allow)
                    return false
                }
            }
            else if token = tokenLcUcNmchar
            {
                if allow.nmchar_type = P_ATTRIBUTEVALUE
                    return this.parse_attribute_value_param(parm)
                else
                {
                    this.param_invalid_token(tokenLcUcNmchar, allow)
                    return false
                }
            }
            else
            {
                ; the modes parse_param scans with produce no other token —
                ; the reference's CANNOT_HAPPEN.
                return false
            }
        }
        false
    }

    function extend_number(this: Parser, maxlen: size_t)
    {
        let ins ps.current_input()
        if ins = null
            return
        var length ins.current_token_length()
        let syn ps.get_syntax()
        var scanning true
        while scanning
        {
            let ch ins.token_char()
            if syn.is_digit(ch as u32) = false
                set scanning: false
            else
                set length: length + 1
        }
        ; parseCommon.cxx:580 — a number longer than NAMELEN.
        if length > maxlen
            this.report_num_at(ParserMessages.numberLength(), maxlen as u64, ins.token_start_location())
        ins.end_token(length)
    }

    ; extendHexNumber (parseCommon.cxx:584): grow the current token over hex
    ; digits (0-9 a-f A-F per Syntax::isHexDigit), reporting hexNumberLength
    ; past NAMELEN.
    function extend_hex_number(this: Parser, maxlen: size_t)
    {
        let ins ps.current_input()
        if ins = null
            return
        var length ins.current_token_length()
        let syn ps.get_syntax()
        var scanning true
        while scanning
        {
            let ch ins.token_char()
            if syn.is_hex_digit(ch as u32) = false
                set scanning: false
            else
                set length: length + 1
        }
        if length > maxlen
            this.report_num_at(ParserMessages.hexNumberLength(), maxlen as u64, ins.token_start_location())
        ins.end_token(length)
    }

    ; CharsetInfo::hexDigitWeight (CharsetInfo.cxx:117) reduced to the identity
    ; charset: the callers only pass chars admitted by Syntax.is_hex_digit.
    function hex_digit_weight(this: Parser, c: u32) returns u32
    {
        if (c >= 0x30) and (c <= 0x39)
            return c - (0x30 as u32)
        if (c >= 0x41) and (c <= 0x46)
            return c - (0x41 as u32) + (10 as u32)
        c - (0x61 as u32) + (10 as u32)
    }

    ; parseAttributeValueParam — an unquoted attribute value (name/number/nmchar).
    function parse_attribute_value_param(this: Parser, parm: ref[Param]) returns bool
    {
        this.extend_name_token(this.attribute_value_max_length(), ParserMessages.attributeValueLength())
        set parm.kind: P_ATTRIBUTEVALUE
        ; Copy the token onto the stable run region (^host), not the transient
        ; caller page: a default attribute value parsed here is stored in the DTD
        ; and read back at instance time, long after this DTD-parsing frame's
        ; region is reclaimed — ps.current_token() alone would dangle.
        let sc ps.current_token^host()
        let txt host.allocate(sizeof Text, alignof Text) as pointer[Text]
        ; per-char locations (linear: the value is one source token) — the
        ; makeValue category messages point INTO the default value.
        let ins ps.current_input()
        let tn sc.get_size()
        let tstart ins.current_token_start_index()
        let torg ins.get_origin()
        let tlb host.allocate(tn * sizeof Location, alignof Location) as pointer[Location]
        var tli: size_t 0
        while tli < tn
        {
            set *(tlb + tli): Location(torg, (tstart + tli) as u32)
            set tli: tli + 1
        }
        set *txt: Text(sc, tlb)
        set parm.literal_text: txt
        true
    }

    ; parseReservedName — a plain reserved name in name-start position.
    function parse_reserved_name(this: Parser, allow: ref[AllowedParams], parm: ref[Param]) returns bool
    {
        var rn: int 0
        if this.get_reserved_name(&rn) = false
            return false
        if allow.reserved_name_allowed(rn) = false
        {
            ; invalidReservedName (parseParam.cxx:1019): arg = the CANONICAL
            ; spelling (syntax().reservedName(rn)), not the scanned token.
            let spell this.reserved_name_spelling(rn)
            this.report1_at(ParserMessages.invalidReservedName(), spell, ps.current_input().token_start_location())
            return false
        }
        set parm.kind: P_RESERVED_NAME + rn
        true
    }

    function get_reserved_name(this: Parser, out_rn: ref[int]) returns bool
    {
        this.extend_name_token(this.namelen(), ParserMessages.nameLength())
        let buffer this.name_folded()
        let rn this.lookup_reserved_name(buffer)
        if rn < 0
        {
            ; noSuchReservedName (parseParam.cxx:1059): the name is not a reserved
            ; name. Arg = the folded name (quoted); location = the name token start.
            let loc ps.current_input().token_start_location()
            this.report1_at(ParserMessages.noSuchReservedName(), buffer, loc)
            return false
        }
        set out_rn: rn
        true
    }

    ; parseIndicatedReservedName — after RNI (`#`), the reserved name.
    function parse_indicated_reserved_name(this: Parser, allow: ref[AllowedParams], parm: ref[Param]) returns bool
    {
        var rn: int 0
        if this.get_indicated_reserved_name(&rn) = false
            return false
        if allow.reserved_name_allowed(rn) = false
        {
            ; invalidReservedName (parseParam.cxx:1004): arg = currentToken(),
            ; the scanned name as written (the RNI is a separate token).
            let ct ps.current_token()
            this.report1_at(ParserMessages.invalidReservedName(), ct, ps.current_input().token_start_location())
            return false
        }
        set parm.kind: P_INDICATED_RESERVED_NAME + rn
        true
    }

    function get_indicated_reserved_name(this: Parser, out_rn: ref[int]) returns bool
    {
        let ins ps.current_input()
        ins.start_token()
        let first ins.token_char()
        if ps.get_syntax().is_name_start_character(first as u32) = false
        {
            ; rniNameStart (parseParam.cxx:1052).
            this.report0_at(ParserMessages.rniNameStart(), ins.token_start_location())
            return false
        }
        this.extend_name_token(this.namelen(), ParserMessages.nameLength())
        let buffer this.name_folded()
        let rn this.lookup_reserved_name(buffer)
        if rn < 0
        {
            ; noSuchReservedName (parseParam.cxx:1059): the folded name, quoted.
            this.report1_at(ParserMessages.noSuchReservedName(), buffer, ps.current_input().token_start_location())
            return false
        }
        set out_rn: rn
        true
    }

    ; ---- group parser (Group.cs) ------------------------------------------
    function has_gt(this: Parser, allow: int, t: int) returns bool
        (allow & (1 << t)) <> 0

    function gt_group(this: Parser, allow: int) returns int
    {
        if this.has_gt(allow, GT_MODELGROUP)
            return GT_MODELGROUP
        if this.has_gt(allow, GT_DATATAGTEMPLATEGROUP)
            return GT_DATATAGTEMPLATEGROUP
        GT_INVALID
    }

    function gt_name_start(this: Parser, allow: int) returns int
    {
        if this.has_gt(allow, GT_ELEMENTTOKEN)
            return GT_ELEMENTTOKEN
        if this.has_gt(allow, GT_NAMETOKEN)
            return GT_NAMETOKEN
        if this.has_gt(allow, GT_NAME)
            return GT_NAME
        GT_INVALID
    }

    function has_gc(this: Parser, allow: int, c: int) returns bool
        (allow & (1 << c)) <> 0

    ; getOccurrenceIndicator(oiMode)
    function get_occurrence_indicator(this: Parser, oi_mode: int) returns int
    {
        let token ps.get_token(oi_mode)
        if token = tokenPlus
            return OI_PLUS
        if token = tokenOpt
            return OI_OPT
        if token = tokenRep
            return OI_REP
        ps.current_input().unget_token()
        OI_NONE
    }

    ; parseGroupToken(allow, nestingLevel, declInputLevel, groupInputLevel, gt)
    function parse_group_token(this: Parser, allow: int, nesting_level: u32, decl_input_level: u32, group_input_level: u32, gt: ref[GroupToken]) returns bool
    {
        var looping true
        while looping
        {
            let token ps.get_token(grpMode)
            if token = tokenEe
            {
                if ps.get_input_level() <= group_input_level
                {
                    ; groupLevel: an entity end in a token separator must
                    ; terminate an entity referenced in the same group.
                    this.report0_at(ParserMessages.groupLevel(), ps.current_input().token_start_location())
                    if ps.get_input_level() <= decl_input_level
                        return false
                }
                else if ps.get_sd().www() = false
                {
                    ; groupEntityEnd (parseParam.cxx:293): an entity end in a
                    ; token separator that does not follow a token (non-WWW).
                    this.report0_at(ParserMessages.groupEntityEnd(), ps.current_input().token_start_location())
                }
                ps.pop_input_stack()
            }
            else if (token = tokenPeroNameStart) or (token = tokenPeroGrpo)
            {
                ; parseGroupToken case tokenPeroNameStart: a parameter-entity
                ; reference IN a group (`(%pe;)*`) -> declReference stacks it;
                ; the loop continues, reading the group tokens from the replacement
                ; text (the tokenEe arm above pops the entity when exhausted).
                ; A name group (`%(`, CONCUR/LINK) is not allowed outside the
                ; instance (parseParam.cxx:298); inside a CONCUR tag's name
                ; group the in-tag flavor reports instead.
                if token = tokenPeroGrpo
                {
                    if ps.is_in_instance() = false
                        this.report0_at(ParserMessages.peroGrpoProlog(), ps.current_input().token_start_location())
                    var tag_start false
                    if ps.in_tag(&tag_start)
                    {
                        if tag_start
                            this.report0_at(ParserMessages.peroGrpoStartTag(), ps.current_input().token_start_location())
                        else
                            this.report0_at(ParserMessages.peroGrpoEndTag(), ps.current_input().token_start_location())
                    }
                }
                ; parseParam.cxx:312: a PE reference in a token separator at the
                ; top level of the internal subset warns under
                ; -winternal-subset-ts-param-entity.
                let opt_ts ps.get_options()
                if opt_ts.warn_internal_subset_ts_param_entity_ref and (ps.get_input_level() = 1)
                    this.report0_at(ParserMessages.internalSubsetTsParamEntityRef(), ps.current_input().token_start_location())
                if this.parse_parameter_entity_reference(token = tokenPeroGrpo, PE_CTX_DECL) = false
                    return false
            }
            else if token = tokenUnrecognized
            {
                ; a reported non-SGML character is skipped (parseParam.cxx:321).
                if this.report_non_sgml_param() = false
                {
                    let ct ps.current_token()
                    let a2 this.allowed_group_tokens_message_arg(allow)
                    this.report_str_raw_at(ParserMessages.groupCharacter(), ct, a2, ps.current_input().token_start_location())
                    return false
                }
            }
            else if token = tokenDtgo
            {
                ; data-tag group (parseParam.cxx:330). datatagNotImplemented
                ; fires when the SGML declaration enabled DATATAG (the runtime
                ; matching is unimplemented — the group is still parsed and
                ; compiled as a SeqModelGroup); datatagBaseDtd when the group
                ; appears outside the base document type (an LPD — blind until
                ; the LINK axis lands). Both at the DTGO token start.
                if this.has_gt(allow, GT_DATATAGGROUP) = false
                {
                    this.group_token_invalid_token(tokenDtgo, allow)
                    return false
                }
                if ps.get_sd().datatag()
                    this.report0_at(ParserMessages.datatagNotImplemented(), ps.current_input().token_start_location())
                let ddtd ps.get_def_dtd()
                if ddtd.get_is_base() = false
                    this.report0_at(ParserMessages.datatagBaseDtd(), ps.current_input().token_start_location())
                return this.parse_data_tag_group(nesting_level + (1 as u32), decl_input_level, gt)
            }
            else if token = tokenGrpo
            {
                let grp this.gt_group(allow)
                if grp = GT_MODELGROUP
                {
                    var mg: pointer[CmNode] null
                    if this.parse_model_group(nesting_level + (1 as u32), decl_input_level, &mg, grpMode) = false
                        return false
                    set gt.model: mg
                    set gt.kind: GT_MODELGROUP
                    return true
                }
                else if grp = GT_DATATAGTEMPLATEGROUP
                    return this.parse_data_tag_template_group(nesting_level + (1 as u32), decl_input_level, gt)
                else
                {
                    ; any other group kind is invalid here (parseParam.cxx:358).
                    this.group_token_invalid_token(tokenGrpo, allow)
                    return false
                }
            }
            else if token = tokenRni
            {
                if (this.has_gt(allow, GT_PCDATA) = false) and (this.has_gt(allow, GT_ALL) = false) and (this.has_gt(allow, GT_IMPLICIT) = false)
                {
                    this.group_token_invalid_token(tokenRni, allow)
                    return false
                }
                var rn: int 0
                if this.get_indicated_reserved_name(&rn) = false
                    return false
                if (rn = R_PCDATA) and this.has_gt(allow, GT_PCDATA)
                {
                    set gt.kind: GT_PCDATA
                    ; PcdataToken() : LeafContentToken(0, rep) — pcdata is
                    ; inherently optional AND repeatable (the self-loop that lets
                    ; (#PCDATA) admit any run of data). OI_REP, never OI_NONE.
                    set gt.content_token: ContentToken.make_leaf(host, null as pointer[ElementType], OI_REP, true, false)
                    return true
                }
                else if ((rn = R_ALL) and this.has_gt(allow, GT_ALL)) or ((rn = R_IMPLICIT) and this.has_gt(allow, GT_IMPLICIT))
                {
                    ; the reference itself does not implement these
                    ; (parseParam.cxx:379).
                    this.report0_at(ParserMessages.sorryAllImplicit(), ps.current_input().token_start_location())
                    return false
                }
                else
                {
                    ; invalidToken (parseParam.cxx:389): arg = RNI + the
                    ; canonical reserved-name spelling, quoted.
                    let buf Array[u32]^host()
                    let syn ps.get_syntax()
                    let rl syn.delim_general_len(dRNI)
                    var j: size_t 0
                    while j < rl
                    {
                        let rc syn.delim_general_char(dRNI, j)
                        buf.add(rc)
                        set j: j + 1
                    }
                    let spell this.reserved_name_spelling(rn)
                    this.arg_append(buf, spell)
                    let tok this.arg_to_string(buf)
                    this.report1_at(ParserMessages.invalidToken(), tok, ps.current_input().token_start_location())
                    return false
                }
            }
            else if token = tokenS
            {
                ; whitespace in group: skip
            }
            else if token = tokenNameStart
            {
                let ns this.gt_name_start(allow)
                if ns = GT_ELEMENTTOKEN
                {
                    this.extend_name_token(this.namelen(), ParserMessages.nameLength())
                    let buffer this.name_folded()
                    let e this.lookup_create_element(buffer)
                    let oi this.get_occurrence_indicator(grpMode)
                    set gt.kind: GT_ELEMENTTOKEN
                    set gt.content_token: ContentToken.make_leaf(host, e, oi, false, false)
                    return true
                }
                else if (ns = GT_NAME) or (ns = GT_NAMETOKEN)
                {
                    this.extend_name_token(this.namelen(), ParserMessages.nameLength())
                    set gt.token: this.name_folded^host()
                    set gt.kind: ns
                    return true
                }
                else
                {
                    this.group_token_invalid_token(tokenNameStart, allow)
                    return false
                }
            }
            else if (token = tokenDigit) or (token = tokenLcUcNmchar)
            {
                if this.has_gt(allow, GT_NAMETOKEN) = false
                {
                    this.group_token_invalid_token(token, allow)
                    return false
                }
                this.extend_name_token(this.namelen(), ParserMessages.nameTokenLength())
                set gt.token: this.name_folded^host()
                set gt.kind: GT_NAMETOKEN
                return true
            }
            else if (token = tokenLit) or (token = tokenLita)
            {
                ; a parameter literal in a data-tag pattern (parseParam.cxx:445).
                if this.has_gt(allow, GT_DATATAGLITERAL) = false
                {
                    this.group_token_invalid_token(token, allow)
                    return false
                }
                let txt host.allocate(sizeof Text, alignof Text) as pointer[Text]
                if this.parse_data_tag_parameter_literal(token = tokenLita, txt) = false
                    return false
                set gt.text: txt
                set gt.kind: GT_DATATAGLITERAL
                return true
            }
            else
            {
                ; connectors, occurrence indicators where a group token is
                ; expected (parseParam.cxx:458-475).
                this.group_token_invalid_token(token, allow)
                return false
            }
        }
        false
    }

    ; parseGroupConnector(allow, declInputLevel, groupInputLevel, gc)
    function parse_group_connector(this: Parser, allow: int, decl_input_level: u32, group_input_level: u32, out_gc: ref[int]) returns bool
    {
        var looping true
        while looping
        {
            let token ps.get_token(grpMode)
            if token = tokenEe
            {
                if ps.get_input_level() <= group_input_level
                {
                    ; groupLevel (parseParam.cxx:491).
                    this.report0_at(ParserMessages.groupLevel(), ps.current_input().token_start_location())
                    if ps.get_input_level() <= decl_input_level
                        return false
                }
                ps.pop_input_stack()
            }
            else if token = tokenS
            {
                ; skip
            }
            else if (token = tokenPeroNameStart) or (token = tokenPeroGrpo)
            {
                ; parseGroupConnector case tokenPeroGrpo (parseParam.cxx:505): in
                ; the INSTANCE (a CONCUR tag's name group) a `%(` in connector
                ; position is peroGrpoProlog and the token is dropped — no
                ; reference parse. Otherwise (and for a plain `%pe;`) it is only
                ; allowed under WWW; else groupEntityReference — reported, the
                ; token dropped, and the loop continues (parseParam.cxx:513).
                var connector_dropped false
                if token = tokenPeroGrpo
                {
                    if ps.is_in_instance()
                    {
                        this.report0_at(ParserMessages.peroGrpoProlog(), ps.current_input().token_start_location())
                        set connector_dropped: true
                    }
                }
                if connector_dropped = false
                {
                    if ps.get_sd().www() = false
                        this.report0_at(ParserMessages.groupEntityReference(), ps.current_input().token_start_location())
                    else if this.parse_parameter_entity_reference(token = tokenPeroGrpo, PE_CTX_DECL) = false
                        return false
                }
            }
            else if token = tokenUnrecognized
            {
                ; a reported non-SGML character is skipped (parseParam.cxx:523).
                if this.report_non_sgml_param() = false
                {
                    let ct ps.current_token()
                    let a2 this.allowed_group_connectors_message_arg(allow)
                    this.report_str_raw_at(ParserMessages.groupCharacter(), ct, a2, ps.current_input().token_start_location())
                    return false
                }
            }
            else if token = tokenAnd
            {
                if this.has_gc(allow, GC_AND) = false
                {
                    this.group_connector_invalid_token(tokenAnd, allow)
                    return false
                }
                set out_gc: GC_AND
                return true
            }
            else if token = tokenSeq
            {
                if this.has_gc(allow, GC_SEQ) = false
                {
                    this.group_connector_invalid_token(tokenSeq, allow)
                    return false
                }
                set out_gc: GC_SEQ
                return true
            }
            else if token = tokenOr
            {
                if this.has_gc(allow, GC_OR) = false
                {
                    this.group_connector_invalid_token(tokenOr, allow)
                    return false
                }
                set out_gc: GC_OR
                return true
            }
            else if token = tokenGrpc
            {
                if this.has_gc(allow, GC_GRPC) = false
                {
                    this.group_connector_invalid_token(tokenGrpc, allow)
                    return false
                }
                ; groupParameterEntityNotEnded (parseParam.cxx:577): a PE
                ; referenced in a token separator must end in the same group.
                if ps.get_input_level() > group_input_level
                    this.report0_at(ParserMessages.groupParameterEntityNotEnded(), ps.current_input().token_start_location())
                set out_gc: GC_GRPC
                return true
            }
            else if token = tokenDtgc
            {
                ; the data-tag group close (parseParam.cxx:559) — like grpc, a
                ; PE opened in a token separator must end in the same group.
                if this.has_gc(allow, GC_DTGC) = false
                {
                    this.group_connector_invalid_token(tokenDtgc, allow)
                    return false
                }
                if ps.get_input_level() > group_input_level
                    this.report0_at(ParserMessages.groupParameterEntityNotEnded(), ps.current_input().token_start_location())
                set out_gc: GC_DTGC
                return true
            }
            else
            {
                ; any other token where a connector is expected
                ; (parseParam.cxx:581, the switch default).
                this.group_connector_invalid_token(token, allow)
                return false
            }
        }
        false
    }

    ; parseModelGroup(nestingLevel, declInputLevel, group, oiMode)
    function parse_model_group(this: Parser, nesting_level: u32, decl_input_level: u32, out_group: pointer[pointer[CmNode]], oi_mode: int) returns bool
    {
        ; parseParam.cxx:824 — model groups nest against GRPLVL (fires once,
        ; when the nesting depth reaches exactly the limit).
        let grplvl_q ps.get_syntax().get_quantity(qGRPLVL)
        if (nesting_level - (1 as u32)) = grplvl_q
            this.report_num_at(ParserMessages.grplvl(), grplvl_q as u64, ps.current_input().token_start_location())
        let group_input_level ps.get_input_level()
        let members ContentToken.new_node_vec(host)
        var connector: int GC_GRPC
        let gt GroupToken.make(host)
        ; allowed content tokens: pcdata, dataTagGroup, elementToken, modelGroup
        ; (parseParam.cxx:831 allowContentToken).
        let allow_content ((1 << GT_PCDATA) | (1 << GT_DATATAGGROUP)) | ((1 << GT_ELEMENTTOKEN) | (1 << GT_MODELGROUP))
        ; connector allow-sets
        let allow_any ((1 << GC_OR) | (1 << GC_AND)) | ((1 << GC_SEQ) | (1 << GC_GRPC))
        let allow_or (1 << GC_OR) | (1 << GC_GRPC)
        let allow_and (1 << GC_AND) | (1 << GC_GRPC)
        let allow_seq (1 << GC_SEQ) | (1 << GC_GRPC)
        var connectorp: int allow_any
        var gc: int GC_GRPC
        var first true
        var pcdata_check false
        let opt_mg ps.get_options()
        var running true
        while running
        {
            if this.parse_group_token(allow_content, nesting_level, decl_input_level, group_input_level, gt) = false
                return false
            var content_token: ref[CmNode]? null
            if gt.kind = GT_MODELGROUP
                set content_token: gt.model
            else
                set content_token: gt.content_token
            ; parseParam.cxx:865 — fires once, at exactly GRPCNT tokens,
            ; BEFORE this token is appended.
            let mg_grpcnt_q ps.get_syntax().get_quantity(qGRPCNT) as size_t
            if members.get_length() = mg_grpcnt_q
                this.report_num_at(ParserMessages.groupCount(), mg_grpcnt_q as u64, ps.current_input().token_start_location())
            members.add(content_token)
            if this.parse_group_connector(connectorp, decl_input_level, group_input_level, &gc) = false
                return false
            ; parseParam.cxx:872: the -wmixed-content-xml #PCDATA placement
            ; checks (pcdataCheck arms only under the option).
            if opt_mg.warn_mixed_content_rep_or_group and (gt.kind = GT_PCDATA)
            {
                if members.get_length() <> 1
                    this.report0_at(ParserMessages.pcdataNotFirstInGroup(), ps.current_input().token_start_location())
                else if gc = GC_SEQ
                    this.report0_at(ParserMessages.pcdataInSeqGroup(), ps.current_input().token_start_location())
                else
                    set pcdata_check: true
                if nesting_level <> 1
                    this.report0_at(ParserMessages.pcdataInNestedModelGroup(), ps.current_input().token_start_location())
            }
            else if pcdata_check
            {
                if gt.kind = GT_MODELGROUP
                    this.report0_at(ParserMessages.pcdataGroupMemberModelGroup(), ps.current_input().token_start_location())
                if content_token.occurrence <> OI_NONE
                    this.report0_at(ParserMessages.pcdataGroupMemberOccurrenceIndicator(), ps.current_input().token_start_location())
            }
            if first
            {
                set first: false
                set connector: gc
                if gc = GC_OR
                    set connectorp: allow_or
                else if gc = GC_SEQ
                    set connectorp: allow_seq
                else if gc = GC_AND
                {
                    set connectorp: allow_and
                    ; parseParam.cxx:899: an AND group warns under -wand-group.
                    if opt_mg.warn_and_group
                        this.report0_at(ParserMessages.andGroup(), ps.current_input().token_start_location())
                }
            }
            if gc = GC_GRPC
                set running: false
        }
        let oi this.get_occurrence_indicator(oi_mode)
        ; parseParam.cxx:911/915: an OR (or single-token) #PCDATA group whose
        ; occurrence indicator is not REP.
        if pcdata_check
        {
            if connector = GC_OR
            {
                if oi <> OI_REP
                    this.report0_at(ParserMessages.pcdataGroupNotRep(), ps.current_input().token_start_location())
            }
            else if connector = GC_GRPC
            {
                if (oi <> OI_REP) and (oi <> OI_NONE)
                    this.report0_at(ParserMessages.pcdataGroupNotRep(), ps.current_input().token_start_location())
            }
        }
        var conn: int CONN_SEQ
        if connector = GC_OR
            set conn: CONN_OR
        else if connector = GC_AND
            set conn: CONN_AND
        else
            set conn: CONN_SEQ
        set *out_group: ContentToken.make_group(host, conn, members, oi)
        true
    }

    ; parseDataTagGroup(nestingLevel, declInputLevel, result) — parseParam.cxx:730.
    ; A data-tag group `[name, template[, padding]]` compiles to a SeqModelGroup
    ; of [DataTagElementToken, PcdataToken] (the reference builds exactly this);
    ; the templates ride on the element token but drive nothing (the DATATAG
    ; runtime is unimplemented). The template may be a single literal or a
    ; dataTagTemplateGroup `("t1" | "t2")`.
    function parse_data_tag_group(this: Parser, nesting_level: u32, decl_input_level: u32, result: ref[GroupToken]) returns bool
    {
        let grplvl_q ps.get_syntax().get_quantity(qGRPLVL)
        if (nesting_level - (1 as u32)) = grplvl_q
            this.report_num_at(ParserMessages.grplvl(), grplvl_q as u64, ps.current_input().token_start_location())
        let group_input_level ps.get_input_level()
        let gt GroupToken.make(host)
        ; the data-tag element name (allowName)
        if this.parse_group_token(1 << GT_NAME, nesting_level, decl_input_level, group_input_level, gt) = false
            return false
        let element this.lookup_create_element(gt.token)
        var gc: int GC_SEQ
        ; the SEQ connector after the name (allowSeq)
        if this.parse_group_connector(1 << GC_SEQ, decl_input_level, group_input_level, &gc) = false
            return false
        ; the template — a single literal or a dataTagTemplateGroup
        let allow_lit_tmpl (1 << GT_DATATAGLITERAL) | (1 << GT_DATATAGTEMPLATEGROUP)
        if this.parse_group_token(allow_lit_tmpl, nesting_level, decl_input_level, group_input_level, gt) = false
            return false
        var templates: ref[Array[Text]]? null
        if gt.kind = GT_DATATAGTEMPLATEGROUP
            set templates: gt.text_vector
        else
        {
            set templates: Array[Text]^host()
            templates.add(*gt.text)
        }
        ; the connector after the template: SEQ (a padding template follows) or
        ; DTGC (the group closes) — allowSeqDtgc
        let allow_seq_dtgc (1 << GC_SEQ) | (1 << GC_DTGC)
        if this.parse_group_connector(allow_seq_dtgc, decl_input_level, group_input_level, &gc) = false
            return false
        let members ContentToken.new_node_vec(host)
        var elem_tok: ref[CmNode]? null
        if gc <> GC_DTGC
        {
            ; a padding template literal, then the DTGC (allowDataTagLiteral, allowDtgc)
            if this.parse_group_token(1 << GT_DATATAGLITERAL, nesting_level, decl_input_level, group_input_level, gt) = false
                return false
            set elem_tok: ContentToken.make_data_tag_element(host, element, templates, true, gt.text)
            if this.parse_group_connector(1 << GC_DTGC, decl_input_level, group_input_level, &gc) = false
                return false
        }
        else
            set elem_tok: ContentToken.make_data_tag_element(host, element, templates, false, null)
        ; vec[0] = DataTagElementToken, vec[1] = PcdataToken (parseParam.cxx:766)
        members.add(elem_tok)
        members.add(ContentToken.make_leaf(host, null as pointer[ElementType], OI_REP, true, false))
        let oi this.get_occurrence_indicator(grpMode)
        set result.content_token: ContentToken.make_group(host, CONN_SEQ, members, oi)
        set result.kind: GT_DATATAGGROUP
        true
    }

    ; parseDataTagTemplateGroup(nestingLevel, declInputLevel, result) —
    ; parseParam.cxx:789. `("t1" | "t2" | ...)` — one or more literals joined by
    ; OR connectors; the collected templates land in result.text_vector.
    function parse_data_tag_template_group(this: Parser, nesting_level: u32, decl_input_level: u32, result: ref[GroupToken]) returns bool
    {
        let grplvl_q ps.get_syntax().get_quantity(qGRPLVL)
        if (nesting_level - (1 as u32)) = grplvl_q
            this.report_num_at(ParserMessages.grplvl(), grplvl_q as u64, ps.current_input().token_start_location())
        let group_input_level ps.get_input_level()
        let vec Array[Text]^host()
        let gt GroupToken.make(host)
        var running true
        while running
        {
            if this.parse_group_token(1 << GT_DATATAGLITERAL, nesting_level, decl_input_level, group_input_level, gt) = false
                return false
            let grpcnt_q ps.get_syntax().get_quantity(qGRPCNT) as size_t
            if vec.get_length() = grpcnt_q
                this.report_num_at(ParserMessages.groupCount(), grpcnt_q as u64, ps.current_input().token_start_location())
            vec.add(*gt.text)
            var gc: int GC_GRPC
            let allow_or_grpc (1 << GC_OR) | (1 << GC_GRPC)
            if this.parse_group_connector(allow_or_grpc, decl_input_level, group_input_level, &gc) = false
                return false
            if gc = GC_GRPC
                set running: false
        }
        set result.text_vector: vec
        set result.kind: GT_DATATAGTEMPLATEGROUP
        true
    }

    ; parseGroup(allowToken, declInputLevel, parm) — a name/nametoken group.
    function parse_group(this: Parser, allow_token: int, decl_input_level: u32, parm: ref[Param]) returns bool
    {
        let group_input_level ps.get_input_level()
        let vec Array[NameToken]^host()
        let gt GroupToken.make(host)
        var n_duplicates: size_t 0
        var connector: int GC_GRPC
        var running true
        while running
        {
            if this.parse_group_token(allow_token, 0, decl_input_level, group_input_level, gt) = false
                return false
            if this.group_contains(vec, gt.token) = false
                vec.add(NameToken(gt.token, ps.current_token(), ps.current_location()))
            else
            {
                ; duplicateGroupToken (parseParam.cxx:692): this token already
                ; occurred in the group. Arg = the folded token (quoted); location =
                ; the token's start.
                set n_duplicates: n_duplicates + 1
                let dtok gt.token
                let dloc ps.current_input().token_start_location()
                this.report1_at(ParserMessages.duplicateGroupToken(), dtok, dloc)
            }
            var gc: int GC_GRPC
            let allow_any ((1 << GC_OR) | (1 << GC_AND)) | ((1 << GC_SEQ) | (1 << GC_GRPC))
            if this.parse_group_connector(allow_any, decl_input_level, group_input_level, &gc) = false
                return false
            if gc = GC_GRPC
                set running: false
            else
            {
                ; parseParam.cxx:712: non-OR connectors warn under
                ; -wname-group-not-or; otherwise MIXED connectors warn under
                ; -wshould.
                let opt_ng ps.get_options()
                if opt_ng.warn_name_group_not_or
                {
                    if gc <> GC_OR
                        this.report0_at(ParserMessages.nameGroupNotOr(), ps.current_input().token_start_location())
                }
                else if opt_ng.warn_should
                {
                    if connector = GC_GRPC
                        set connector: gc
                    else if gc <> connector
                    {
                        this.report0_at(ParserMessages.mixedConnectors(), ps.current_input().token_start_location())
                        set connector: gc
                    }
                }
            }
        }
        ; parseParam.cxx:725 — group tokens (duplicates included) vs GRPCNT.
        let grpcnt_q ps.get_syntax().get_quantity(qGRPCNT) as size_t
        if (n_duplicates + vec.get_length()) > grpcnt_q
            this.report_num_at(ParserMessages.groupCount(), grpcnt_q as u64, ps.current_input().token_start_location())
        set parm.name_tokens: vec
        true
    }

    function group_contains(this: Parser, vec: ref[Array[NameToken]], str: StringC) returns bool
    {
        let n vec.get_length()
        let buf vec.get_buffer()
        var i: size_t 0
        while i < n
        {
            let nt *(buf + i)
            if nt.name.equals(str)
                return true
            set i: i + 1
        }
        false
    }

    function parse_name_group(this: Parser, decl_input_level: u32, parm: ref[Param]) returns bool
        this.parse_group(1 << GT_NAME, decl_input_level, parm)

    function parse_name_token_group(this: Parser, decl_input_level: u32, parm: ref[Param]) returns bool
        this.parse_group(1 << GT_NAMETOKEN, decl_input_level, parm)

    ; parseElementNameGroup — a name group, then resolve to element types.
    function parse_element_name_group(this: Parser, decl_input_level: u32, parm: ref[Param]) returns bool
    {
        if this.parse_group(1 << GT_NAME, decl_input_level, parm) = false
            return false
        let elems Array[ref[ElementType]?]^host()
        let nt parm.name_tokens
        let n nt.get_length()
        let buf nt.get_buffer()
        var i: size_t 0
        while i < n
        {
            let entry *(buf + i)
            elems.add(this.lookup_create_element(entry.name))
            set i: i + 1
        }
        set parm.elements: elems
        true
    }

    ; instantiateDtd (ParserState.cxx:892), the reporting half: the moment a
    ; name group instantiates one more document instance than the CONCUR
    ; quantity admits, concurrentInstances fires (a Q-severity message; the
    ; count itself lives in ParserState).
    function instantiate_dtd(this: Parser, dtd: ref[Dtd])
    {
        if dtd.get_is_instantiated()
            return
        let ncc ps.get_sd().concur()
        if ps.get_instantiated_dtds() = (ncc as u32)
            this.report_num_at(ParserMessages.concurrentInstances(), ncc as u64, ps.current_input().token_start_location())
        ps.instantiate_dtd(dtd)
    }

    ; parseEntityReferenceNameGroup (parseParam.cxx:611) — the `(name,...)`
    ; group after an ERO/PERO under CONCUR or LINK: in the instance the
    ; reference APPLIES when a group name is an active link type or names the
    ; current document type; every named document type is instantiated either
    ; way. Outside the instance the reference is always ignored. (The Lpd
    ; lookup joins with the LINK axis — no LPD can exist yet.)
    function parse_entity_reference_name_group(this: Parser, out_ignore: ref[bool]) returns bool
    {
        let parm Param.make(host)
        if this.parse_name_group(ps.get_input_level(), parm) = false
            return false
        set out_ignore: true
        if ps.is_in_instance()
        {
            let nt parm.name_tokens
            let n nt.get_length()
            let buf nt.get_buffer()
            var i: size_t 0
            while i < n
            {
                let entry *(buf + i)
                let dtd ps.lookup_dtd(entry.name)
                if dtd <> null
                {
                    this.instantiate_dtd(dtd)
                    if ps.get_current_dtd() = dtd
                    {
                        set out_ignore: false
                        return true
                    }
                }
                set i: i + 1
            }
        }
        true
    }

    ; parseTagNameGroup (parseParam.cxx:637) — the `<(name,...)` document-type
    ; name group of a CONCUR start/end tag: every named document type is
    ; instantiated; the tag is ACTIVE when one of them is the current
    ; (base/activated) document type. The in-tag flags make a `%(` inside the
    ; group report peroGrpoStartTag/peroGrpoEndTag.
    function parse_tag_name_group(this: Parser, out_active: ref[bool], start: bool) returns bool
    {
        let parm Param.make(host)
        ps.enter_tag(start)
        let ret this.parse_name_group(ps.get_input_level(), parm)
        ps.leave_tag()
        if ret = false
            return false
        set out_active: false
        let nt parm.name_tokens
        let n nt.get_length()
        let buf nt.get_buffer()
        var i: size_t 0
        while i < n
        {
            let entry *(buf + i)
            let dtd ps.lookup_dtd(entry.name)
            if dtd <> null
            {
                this.instantiate_dtd(dtd)
                if ps.get_current_dtd() = dtd
                    set out_active: true
            }
            set i: i + 1
        }
        true
    }

    ; PublicId::init's MessageType1* out-params, reporting side: map a
    ; classification error code to its fpi* / urn* message (arg = the public
    ; id string, quoted). Code 0 is unreachable here (the switch below only
    ; reports the LOSING decomposition's error) — the missing-field message
    ; keeps it total.
    function report_fpi_error(this: Parser, code: int, arg: StringC, loc: Location)
    {
        if code = FPI_ERR_MISSING_TEXT_CLASS_SPACE
            this.report1_at(ParserMessages.fpiMissingTextClassSpace(), arg, loc)
        else if code = FPI_ERR_INVALID_TEXT_CLASS
            this.report1_at(ParserMessages.fpiInvalidTextClass(), arg, loc)
        else if code = FPI_ERR_INVALID_LANGUAGE
            this.report1_at(ParserMessages.fpiInvalidLanguage(), arg, loc)
        else if code = FPI_ERR_ILLEGAL_DISPLAY_VERSION
            this.report1_at(ParserMessages.fpiIllegalDisplayVersion(), arg, loc)
        else if code = FPI_ERR_EXTRA_FIELD
            this.report1_at(ParserMessages.fpiExtraField(), arg, loc)
        else
            this.report1_at(ParserMessages.fpiMissingField(), arg, loc)
    }

    function report_urn_error(this: Parser, code: int, arg: StringC, loc: Location)
    {
        if code = URN_ERR_MISSING_PREFIX
            this.report1_at(ParserMessages.urnMissingPrefix(), arg, loc)
        else if code = URN_ERR_INVALID_NID
            this.report1_at(ParserMessages.urnInvalidNid(), arg, loc)
        else if code = URN_ERR_INVALID_NSS
            this.report1_at(ParserMessages.urnInvalidNss(), arg, loc)
        else
            this.report1_at(ParserMessages.urnMissingField(), arg, loc)
    }

    ; ---- parseExternalId (scoped) -----------------------------------------
    ; maybe_warn_missing_system_id: parseDecl.cxx:1511 — the notation decl
    ; passes "the keyword was SYSTEM" (a public-only notation never warns);
    ; entity/doctype/linktype pass true.
    function parse_external_id(this: Parser, sysid_allow: ref[AllowedParams], end_allow: ref[AllowedParams], maybe_warn_missing_system_id: bool, decl_input_level: u32, parm: ref[Param], out_id: ref[ExternalId]) returns bool
    {
        if parm.kind = (P_RESERVED_NAME + R_PUBLIC)
        {
            let allow_min AllowedParams.a1(host, P_MINIMUMLITERAL)
            if this.parse_param(allow_min, decl_input_level, parm) = false
                return false
            ; Pin the identifier to the run page: `stringc_to_bytes` returns its
            ; String on THIS frame's region page, and out_id belongs to the
            ; CALLER, which reads the strings after this frame is released
            ; (parse_notation_decl reports its own message and only then copies
            ; via ExternalId.make) — the same discipline sd_parse_external_id
            ; already applies.
            let pub0 this.stringc_to_bytes(parm.literal_text.string())
            let public_str String^host(pub0)
            set out_id: ExternalId(true, *public_str, false, String())
            ; PublicId::init (id.setPublic) + the FORMAL/URN reporting switch
            ; (parseDecl.cxx:1523-1543): under FORMAL YES a non-FPI public id
            ; reports the FPI decomposition's error, under URN YES a non-URN
            ; one the URN error; a valid FPI whose text class is SD needs a
            ; WWW declaration. Arg = the public id, location = the minimum
            ; literal's token start (plain message()).
            out_id.classify_public()
            let sdp ps.get_sd()
            let pub_sc parm.literal_text.string()
            let msg_loc ps.current_input().token_start_location()
            let ptype out_id.get_public_type()
            if ptype = PUBLIC_FPI
            {
                if sdp.formal()
                {
                    if out_id.get_text_class() = TC_SD
                        this.report0_at(ParserMessages.wwwRequired(), msg_loc)
                }
                if sdp.urn()
                {
                    if sdp.formal() = false
                        this.report_urn_error(out_id.get_urn_error(), pub_sc, msg_loc)
                }
            }
            else if ptype = PUBLIC_URN
            {
                if sdp.formal()
                {
                    if sdp.urn() = false
                        this.report_fpi_error(out_id.get_fpi_error(), pub_sc, msg_loc)
                }
            }
            else
            {
                if sdp.formal()
                    this.report_fpi_error(out_id.get_fpi_error(), pub_sc, msg_loc)
                if sdp.urn()
                    this.report_urn_error(out_id.get_urn_error(), pub_sc, msg_loc)
            }
        }
        else
            set out_id: ExternalId()
        if this.parse_param(sysid_allow, decl_input_level, parm) = false
            return false
        if parm.kind = P_SYSTEMIDENTIFIER
        {
            ; host-pinned for the same reason as the public id above.
            let sys0 this.stringc_to_bytes(parm.literal_text.string())
            let system_str String^host(sys0)
            out_id.set_system(*system_str)
            if this.parse_param(end_allow, decl_input_level, parm) = false
                return false
        }
        else
        {
            ; parseDecl.cxx:1553: no system identifier warns under
            ; -wmissing-system-id.
            let opt_ms ps.get_options()
            if opt_ms.warn_missing_system_id and maybe_warn_missing_system_id
                this.report0_at(ParserMessages.missingSystemId(), ps.current_input().token_start_location())
        }
        true
    }

    ; ---- parseElementDecl --------------------------------------------------
    function parse_element_decl(this: Parser) returns bool
    {
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        let allow_name_namegroup AllowedParams.a2(host, P_NAME, P_NAMEGROUP)
        if this.parse_param(allow_name_namegroup, decl_input_level, parm) = false
            return false

        var names Array[NameToken]^host()
        if parm.kind = P_NAMEGROUP
        {
            ; parseDecl.cxx:547: a name-group ELEMENT declaration warns under
            ; -welement-group-decl.
            let opt_eg ps.get_options()
            if opt_eg.warn_element_group_decl
                this.report0_at(ParserMessages.elementGroupDecl(), ps.current_input().token_start_location())
            let src parm.name_tokens
            let n src.get_length()
            let buf src.get_buffer()
            var i: size_t 0
            while i < n
            {
                let ent *(buf + i)
                names.add(ent)
                set i: i + 1
            }
        }
        else
        {
            let loc ps.current_location()
            let nt NameToken(parm.token, parm.orig_token, loc)
            names.add(nt)
        }

        let allow_roc AllowedParams.a8(host, P_NUMBER, P_RESERVED_NAME + R_O, P_MINUS, P_RESERVED_NAME + R_CDATA, P_RESERVED_NAME + R_RCDATA, P_RESERVED_NAME + R_EMPTY, P_RESERVED_NAME + R_ANY, P_MODELGROUP)
        if this.parse_param(allow_roc, decl_input_level, parm) = false
            return false

        ; resolve element types. rank_suffix/rank_stems stay empty unless the
        ; RANK branch below fills them (parseDecl.cxx:566-609).
        let elements Array[ref[ElementType]?]^host()
        let rank_stems Array[ref[RankStem]?]^host()
        var rank_suffix StringC()
        let nn names.get_length()
        let nbuf names.get_buffer()

        if parm.kind = P_NUMBER
        {
            ; RANK (parseDecl.cxx:571): the number is the rank suffix. Element
            ; types are named GI+suffix; each name also creates a rank stem.
            ; The ranked form itself warns under -wrank.
            let opt_rk ps.get_options()
            if opt_rk.warn_rank
                this.report0_at(ParserMessages.rank(), ps.current_input().token_start_location())
            set rank_suffix: parm.token
            let namelen_q ps.get_syntax().get_quantity(qNAMELEN) as size_t
            var k: size_t 0
            while k < nn
            {
                let entry *(nbuf + k)
                let sbuf Array[u32]^host()
                this.arg_append(sbuf, entry.name)
                this.arg_append(sbuf, rank_suffix)
                let suffixed StringC^host(sbuf.get_buffer(), sbuf.get_length())
                ; genericIdentifierLength (parseDecl.cxx:578): only when the
                ; SUFFIXED name exceeds NAMELEN but the plain name did not. Plain
                ; message() = the current token's start (the rank number).
                if (suffixed.get_size() > namelen_q) and (entry.name.get_size() <= namelen_q)
                    this.report_num_at(ParserMessages.genericIdentifierLength(), namelen_q as u64, ps.current_input().token_start_location())
                elements.add(this.lookup_create_element(suffixed))
                rank_stems.add(this.lookup_create_rank_stem(entry.name))
                set k: k + 1
            }
            ; a parameter separator is required between the rank suffix and the
            ; omitted-tag/content parameter (parseDecl.cxx:594).
            let peek ps.get_token(mdMinusMode)
            if peek = tokenNameStart
                this.report0(ParserMessages.psRequired())
            ps.current_input().unget_token()
            let allow_oc AllowedParams.a7(host, P_RESERVED_NAME + R_O, P_MINUS, P_RESERVED_NAME + R_CDATA, P_RESERVED_NAME + R_RCDATA, P_RESERVED_NAME + R_EMPTY, P_RESERVED_NAME + R_ANY, P_MODELGROUP)
            if this.parse_param(allow_oc, decl_input_level, parm) = false
                return false
        }
        else
        {
            var k: size_t 0
            while k < nn
            {
                let entry *(nbuf + k)
                let e this.lookup_create_element(entry.name)
                e.set_orig_name(entry.orig_name)
                elements.add(e)
                set k: k + 1
            }
        }

        ; rankStemGenericIdentifier (parseDecl.cxx:611): an element type whose GI
        ; is also a rank stem name (validate-gated). Plain message() = the
        ; current token's start (the last-parsed omission/content token).
        if ps.validate()
        {
            let ddtd ps.get_def_dtd()
            let rsloc ps.current_input().token_start_location()
            var ri: size_t 0
            let re elements.get_length()
            let rbuf elements.get_buffer()
            while ri < re
            {
                let el *(rbuf + ri)
                if ddtd.lookup_rank_stem(el.get_name()) <> null
                    this.report1_at(ParserMessages.rankStemGenericIdentifier(), el.get_name(), rsloc)
                set ri: ri + 1
            }
        }

        ; omitted-tag minimization.
        var omit_flags: u8 0
        if (parm.kind = P_MINUS) or (parm.kind = (P_RESERVED_NAME + R_O))
        {
            ; parseDecl.cxx:618: an explicit omission spec warns under
            ; -wmin-param.
            let opt_mp ps.get_options()
            if opt_mp.warn_minimization_param
                this.report0_at(ParserMessages.minimizationParam(), ps.current_input().token_start_location())
            set omit_flags: OMIT_SPEC
            if parm.kind <> P_MINUS
                set omit_flags: omit_flags | OMIT_START
            let allow_omission AllowedParams.a2(host, P_RESERVED_NAME + R_O, P_MINUS)
            if this.parse_param(allow_omission, decl_input_level, parm) = false
                return false
            if parm.kind <> P_MINUS
                set omit_flags: omit_flags | OMIT_END
            let allow_content AllowedParams.a5(host, P_RESERVED_NAME + R_CDATA, P_RESERVED_NAME + R_RCDATA, P_RESERVED_NAME + R_EMPTY, P_RESERVED_NAME + R_ANY, P_MODELGROUP)
            if this.parse_param(allow_content, decl_input_level, parm) = false
                return false
        }
        else
        {
            ; missingTagMinimization (parseDecl.cxx:639): the omitted-tag
            ; minimization parameter was omitted, which is only allowed under
            ; OMITTAG NO. Reported at the current cursor (just past the content
            ; token). E0 — no argument.
            if ps.get_sd().omittag()
                this.report0(ParserMessages.missingTagMinimization())
        }

        let dtd ps.get_def_dtd()
        let loc ps.current_location()
        let allow_mdc AllowedParams.a1(host, P_MDC)
        var def: ref[ElementDefinition]? null

        if parm.kind = (P_RESERVED_NAME + R_CDATA)
        {
            set def: ElementDefinition.make(host, loc, dtd.alloc_element_definition_index(), omit_flags, DC_CDATA, false)
            if this.parse_param(allow_mdc, decl_input_level, parm) = false
                return false
            let opt_cd ps.get_options()
            if opt_cd.warn_cdata_content
                this.report0_at(ParserMessages.cdataContent(), ps.current_input().token_start_location())
        }
        else if parm.kind = (P_RESERVED_NAME + R_RCDATA)
        {
            set def: ElementDefinition.make(host, loc, dtd.alloc_element_definition_index(), omit_flags, DC_RCDATA, false)
            if this.parse_param(allow_mdc, decl_input_level, parm) = false
                return false
            let opt_rc ps.get_options()
            if opt_rc.warn_rcdata_content
                this.report0_at(ParserMessages.rcdataContent(), ps.current_input().token_start_location())
        }
        else if parm.kind = (P_RESERVED_NAME + R_EMPTY)
        {
            set def: ElementDefinition.make(host, loc, dtd.alloc_element_definition_index(), omit_flags, DC_EMPTY, false)
            ; parseDecl.cxx:668: an EMPTY element whose omission spec does not
            ; omit the end tag warns under -wshould.
            if (omit_flags & OMIT_SPEC) <> 0
            {
                if (omit_flags & OMIT_END) = 0
                {
                    let opt_eo ps.get_options()
                    if opt_eo.warn_should
                        this.report0_at(ParserMessages.emptyOmitEndTag(), ps.current_input().token_start_location())
                }
            }
            if this.parse_param(allow_mdc, decl_input_level, parm) = false
                return false
        }
        else if parm.kind = (P_RESERVED_NAME + R_ANY)
        {
            set def: ElementDefinition.make(host, loc, dtd.alloc_element_definition_index(), omit_flags, DC_ANY, false)
            if this.parse_exceptions(decl_input_level, def) = false
                return false
        }
        else if parm.kind = P_MODELGROUP
        {
            ; parseDecl.cxx:685 — the grand total of content tokens vs
            ; GRPGTCNT; the outermost model group isn't formally a token.
            let gtcnt ContentToken.grpgtcnt_of(parm.model_group)
            let grpgtcnt_q ps.get_syntax().get_quantity(qGRPGTCNT)
            if (gtcnt - 1) > (grpgtcnt_q as u64)
                this.report_num_at(ParserMessages.grpgtcnt(), grpgtcnt_q as u64, ps.current_input().token_start_location())
            let ambiguities ContentToken.new_amb_vec(host)
            var pcdata_unreachable false
            let compiled ContentToken.compile(host, parm.model_group, dtd.n_element_type_index(), ambiguities, &pcdata_unreachable)
            ; parseDecl.cxx:695: #PCDATA unreachable in the compiled model warns
            ; under -wmixed.
            if pcdata_unreachable
            {
                let opt_pu ps.get_options()
                if opt_pu.warn_mixed_content
                    this.report0_at(ParserMessages.pcdataUnreachable(), ps.current_input().token_start_location())
            }
            ; reportAmbiguity loop (parseDecl.cxx:697): validate-gated; plain
            ; message() = the current token's start (the just-consumed group
            ; close, verified 2:25/2:28/2:31/2:38 against real onsgmls).
            if ps.validate()
            {
                let amb_loc ps.current_input().token_start_location()
                var a_i: size_t 0
                let a_n ambiguities.get_length()
                let a_buf ambiguities.get_buffer()
                while a_i < a_n
                {
                    let amb a_buf + a_i
                    this.report_ambiguity(amb.from, amb.to1, amb.to2, amb.and_depth, amb_loc)
                    set a_i: a_i + 1
                }
            }
            set def: ElementDefinition.make_with_model(host, loc, dtd.alloc_element_definition_index(), omit_flags, DC_MODEL_GROUP, compiled)
            if this.parse_exceptions(decl_input_level, def) = false
                return false
        }
        else
        {
            ; the allow set admits only CDATA/RCDATA/EMPTY/ANY/model group,
            ; all handled above — the reference has no further case.
            return false
        }

        def.compute_mode()

        ; setRank (parseDecl.cxx:716): a ranked definition carries its suffix and
        ; the full rank-stem group.
        if rank_suffix.get_size() > 0
            def.set_rank(rank_suffix, rank_stems)

        let n_rank_stems rank_stems.get_length()
        var e_index: size_t 0
        let ecount elements.get_length()
        let ebuf elements.get_buffer()
        while e_index < ecount
        {
            let e *(ebuf + e_index)
            if e.get_definition() = null
            {
                e.set_element_definition(def, e_index)
                ; parseDecl.cxx:723-725: an ATTLIST seen BEFORE this element
                ; declaration gets its compatibility checked now.
                if e.get_attribute_def() <> null
                    this.check_element_attribute(e, 0)
            }
            else
            {
                ; duplicateElementDefinition (parseDecl.cxx:719): this element type
                ; already has a definition. Gated on validate(); arg = element name
                ; (quoted); location = the just-consumed MDC (current_location is one
                ; past it, so use the current token's start).
                if ps.validate()
                {
                    let gi e.get_name()
                    let loc ps.current_input().token_start_location()
                    this.report1_at(ParserMessages.duplicateElementDefinition(), gi, loc)
                }
            }
            ; addDefinition (parseDecl.cxx:729): register the definition on this
            ; element's rank stem (ranked declarations only). Bind the stem to a
            ; local — a dereferenced-slot method receiver mis-plans (the slot
            ; ADDRESS reaches the method as `this` instead of the pointer).
            if n_rank_stems > 0
            {
                let rs rank_stems[e_index]
                rs.add_definition(def)
            }
            set e_index: e_index + 1
        }
        true
    }

    ; parseExceptions(declInputLevel, def)
    function parse_exceptions(this: Parser, decl_input_level: u32, def: ref[ElementDefinition]) returns bool
    {
        let parm Param.make(host)
        let allow_exc AllowedParams.a3(host, P_MDC, P_EXCLUSIONS, P_INCLUSIONS)
        if this.parse_param(allow_exc, decl_input_level, parm) = false
            return false
        if parm.kind = P_EXCLUSIONS
        {
            ; parseDecl.cxx:868: an exclusion group warns under -wexclusion.
            let opt_ex ps.get_options()
            if opt_ex.warn_exclusion
                this.report0_at(ParserMessages.exclusion(), ps.current_input().token_start_location())
            def.set_exclusions(parm.elements)
            let allow_inc AllowedParams.a2(host, P_MDC, P_INCLUSIONS)
            if this.parse_param(allow_inc, decl_input_level, parm) = false
                return false
        }
        if parm.kind = P_INCLUSIONS
        {
            ; parseDecl.cxx:876: an inclusion group warns under -winclusion.
            let opt_in ps.get_options()
            if opt_in.warn_inclusion
                this.report0_at(ParserMessages.inclusion(), ps.current_input().token_start_location())
            def.set_inclusions(parm.elements)
            ; excludeIncludeSame (parseDecl.cxx:880-887): an element type in
            ; BOTH exception groups — W per pair, at the just-parsed inclusion
            ; group's close (the current token's start; verified 2:40).
            let n_inc def.n_inclusions()
            let n_exc def.n_exclusions()
            if n_exc > 0
            {
                var ii: size_t 0
                while ii < n_inc
                {
                    let ie def.inclusion(ii)
                    var jj: size_t 0
                    while jj < n_exc
                    {
                        if def.exclusion(jj) = ie
                        {
                            let ien ie.get_name()
                            this.report1_at(ParserMessages.excludeIncludeSame(), ien, ps.current_input().token_start_location())
                        }
                        set jj: jj + 1
                    }
                    set ii: ii + 1
                }
            }
            let allow_mdc AllowedParams.a1(host, P_MDC)
            if this.parse_param(allow_mdc, decl_input_level, parm) = false
                return false
        }
        true
    }

    ; ---- parseAttlistDecl (scoped: no Lpd/notation-fanout/afdr/events) ----
    function parse_attlist_decl(this: Parser) returns bool
    {
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        var attributed Array[pointer[void]]^host()
        var is_notation false
        if this.parse_attributed(decl_input_level, parm, &attributed, &is_notation) = false
            return false

        var defs Array[ref[AttributeDefinition]?]^host()
        var any_current false
        ; parseDecl.cxx:899 — one per attribute name, plus one per group token.
        var attcnt: size_t 0
        let allow_name AllowedParams.a1(host, P_NAME)
        if this.parse_param(allow_name, decl_input_level, parm) = false
            return false

        ; parseDecl.cxx:901-903 — the running ID/NOTATION attribute indexes
        ; (LAST-wins; passed into the definition list after the loop).
        var id_index ADL_NONE
        var notation_index ADL_NONE
        while parm.kind <> P_MDC
        {
            let attribute_name parm.token
            let orig_attribute_name parm.orig_token
            set attcnt: attcnt + 1

            ; duplicateAttributeDef (parseDecl.cxx:920): a name already in this
            ; list — W at the name token, and the duplicate definition is
            ; DROPPED (parsed but never appended).
            var duplicate false
            let dup_n defs.get_length()
            let dup_b defs.get_buffer()
            var dup_i: size_t 0
            while dup_i < dup_n
            {
                let d0 *(dup_b + dup_i)
                let d0n d0.get_name()
                if d0n.equals(attribute_name)
                {
                    this.report1_at(ParserMessages.duplicateAttributeDef(), attribute_name, ps.current_input().token_start_location())
                    set duplicate: true
                    set dup_i: dup_n
                }
                else
                    set dup_i: dup_i + 1
            }

            var allowed_flags: int 0
            let declared_value this.parse_declared_value(decl_input_level, is_notation, parm, &allowed_flags)
            if declared_value = null
                return false
            if duplicate = false
            {
                ; multipleIdAttributes / multipleNotationAttributes (parseDecl.
                ; cxx:931-941): arg = the PREVIOUS such attribute's name; the
                ; index moves to this definition (last wins).
                if (*declared_value).is_id()
                {
                    if id_index <> ADL_NONE
                    {
                        let prev0 defs[id_index]
                        let pn0 prev0.get_name()
                        this.report1_at(ParserMessages.multipleIdAttributes(), pn0, ps.current_input().token_start_location())
                    }
                    set id_index: defs.get_length()
                }
                else if (*declared_value).is_notation()
                {
                    if notation_index <> ADL_NONE
                    {
                        let prev1 defs[notation_index]
                        let pn1 prev1.get_name()
                        this.report1_at(ParserMessages.multipleNotationAttributes(), pn1, ps.current_input().token_start_location())
                    }
                    set notation_index: defs.get_length()
                }
            }
            let group_tokens (*declared_value).get_tokens()
            if group_tokens <> null
            {
                ; duplicateAttributeToken (parseDecl.cxx:945-956): each group
                ; token must be unique across the whole list (not under WWW).
                if ps.get_sd().www() = false
                {
                    let tn group_tokens.get_length()
                    let tb group_tokens.get_buffer()
                    var ti: size_t 0
                    while ti < tn
                    {
                        let tok *(tb + ti)
                        let dn2 defs.get_length()
                        let db2 defs.get_buffer()
                        var dj: size_t 0
                        while dj < dn2
                        {
                            let d1 *(db2 + dj)
                            if d1.contains_token(tok)
                            {
                                this.report1_at(ParserMessages.duplicateAttributeToken(), tok, ps.current_input().token_start_location())
                                set dj: dn2
                            }
                            else
                                set dj: dj + 1
                        }
                        set ti: ti + 1
                    }
                }
                set attcnt: attcnt + group_tokens.get_length()
            }
            ; the declared-value/attribute-kind compatibility switch (parseDecl.
            ; cxx:1384-1389): data attributes reject ENTITY/ID/IDREF/NOTATION
            ; classes; link attributes reject the ID/IDREF/NOTATION classes.
            if is_notation
            {
                if (allowed_flags & AS_DATA_ATTRIBUTE) = 0
                    this.report0_at(ParserMessages.dataAttributeDeclaredValue(), ps.current_input().token_start_location())
            }
            else if ps.have_def_lpd()
            {
                if (allowed_flags & AS_LINK_ATTRIBUTE) = 0
                    this.report0_at(ParserMessages.linkAttributeDeclaredValue(), ps.current_input().token_start_location())
            }

            var def: pointer[AttributeDefinition] null
            if this.parse_default_value(decl_input_level, is_notation, parm, attribute_name, declared_value, &def, &any_current) = false
                return false
            ; simple link attributes must be #FIXED (parseDecl.cxx:964).
            if ps.have_def_lpd()
            {
                let dl0 ps.get_def_lpd()
                if dl0.get_kind() = LPD_SIMPLE
                {
                    if def.is_fixed() = false
                        this.report0_at(ParserMessages.simpleLinkFixedAttribute(), ps.current_input().token_start_location())
                }
            }
            def.set_orig_name(orig_attribute_name)
            if duplicate = false
                defs.add(def)

            let allow_name_mdc AllowedParams.a2(host, P_NAME, P_MDC)
            if this.parse_param(allow_name_mdc, decl_input_level, parm) = false
                return false
        }
        ; parseDecl.cxx:975 — the accumulated count vs ATTCNT (both numbers).
        let attcnt_q ps.get_syntax().get_quantity(qATTCNT) as size_t
        if attcnt > attcnt_q
            this.report_num_num_at(ParserMessages.attcnt(), attcnt as u64, attcnt_q as u64, ps.current_input().token_start_location())

        let na0 attributed.get_length()
        let abuf0 attributed.get_buffer()
        if ps.have_def_lpd() and (is_notation = false)
        {
            let lpd0 ps.get_def_lpd()
            if lpd0.get_kind() = LPD_SIMPLE
            {
                ; parseDecl.cxx:980: a simple LPD's ATTLIST attaches to the LPD
                ; itself, keyed by the SOURCE document type's name.
                let sadl AttributeDefinitionList.make(host, 0)
                let nd0 defs.get_length()
                let dbuf0 defs.get_buffer()
                var di0: size_t 0
                while di0 < nd0
                {
                    sadl.append(*(dbuf0 + di0))
                    set di0: di0 + 1
                }
                let sdtd lpd0.get_source_dtd()
                let sdtd_name sdtd.get_name()
                var j0: size_t 0
                while j0 < na0
                {
                    let a0 *(abuf0 + j0)
                    if a0 <> null
                    {
                        let e0 a0 as ref[ElementType]
                        let e0name e0.get_name()
                        let mdc_loc0 ps.current_input().token_start_location()
                        if e0name.equals(sdtd_name)
                        {
                            if lpd0.get_attribute_def() = null
                                lpd0.set_attribute_def(sadl)
                            else
                                this.report1_at(ParserMessages.duplicateAttlistElement(), e0name, mdc_loc0)
                        }
                        else
                            this.report1_at(ParserMessages.simpleLinkAttlistElement(), e0name, mdc_loc0)
                    }
                    set j0: j0 + 1
                }
            }
            else
            {
                ; parseDecl.cxx:998: a complex LPD's ATTLIST fills its link-
                ; attribute slots (one shared list; first ATTLIST wins).
                let cadl AttributeDefinitionList.make(host, lpd0.alloc_attribute_definition_list_index())
                let nd1 defs.get_length()
                let dbuf1 defs.get_buffer()
                var di1: size_t 0
                while di1 < nd1
                {
                    cadl.append(*(dbuf1 + di1))
                    set di1: di1 + 1
                }
                var j1: size_t 0
                while j1 < na0
                {
                    let a1 *(abuf0 + j1)
                    if a1 <> null
                    {
                        let e1 a1 as ref[ElementType]
                        if lpd0.link_attribute_def(e1) = null
                            lpd0.set_link_attribute_def(e1, cadl)
                        else
                        {
                            let e1name e1.get_name()
                            this.report1_at(ParserMessages.duplicateAttlistElement(), e1name, ps.current_input().token_start_location())
                        }
                    }
                    set j1: j1 + 1
                }
            }
            return true
        }
        let dtd ps.get_def_dtd()
        let adl AttributeDefinitionList.make(host, dtd.alloc_attribute_definition_list_index())
        let nd defs.get_length()
        let dbuf defs.get_buffer()
        var i: size_t 0
        while i < nd
        {
            adl.append(*(dbuf + i))
            set i: i + 1
        }
        ; the reference ctor takes the loop-tracked LAST-wins indexes
        ; (parseDecl.cxx:1016) — override append()'s first-wins tracking.
        adl.set_id_index(id_index)
        adl.set_notation_index(notation_index)

        let na attributed.get_length()
        let abuf attributed.get_buffer()
        var j: size_t 0
        while j < na
        {
            let a *(abuf + j)
            ; a second ATTLIST for the same element/notation is a duplicate
            ; attribute definition list (parseDecl.cxx:1009/1034) — reported at
            ; the just-consumed MDC (current_location is one past it). Under
            ; WWW (or errorAfdr off) it MERGES instead (Annex K / AFDR).
            let mdc_loc ps.current_input().token_start_location()
            var cur_adl: ref[AttributeDefinitionList]? null
            if is_notation
            {
                let nt a as ref[Notation]
                set cur_adl: nt.get_attribute_def()
                if cur_adl = null
                    nt.set_attribute_def(adl)
                else if ps.get_error_afdr() and (ps.get_sd().www() = false)
                {
                    let nn nt.get_name()
                    this.report1_at(ParserMessages.duplicateAttlistNotation(), nn, mdc_loc)
                    set cur_adl: null
                }
            }
            else
            {
                let e a as ref[ElementType]
                set cur_adl: e.get_attribute_def()
                if cur_adl = null
                {
                    e.set_attribute_def(adl)
                    ; parseDecl.cxx:1026-1029: an already-defined element gets
                    ; its definition/attribute compatibility checked now.
                    if e.get_definition() <> null
                        this.check_element_attribute(e, 0)
                }
                else if ps.get_error_afdr() and (ps.get_sd().www() = false)
                {
                    let en e.get_name()
                    this.report1_at(ParserMessages.duplicateAttlistElement(), en, mdc_loc)
                    set cur_adl: null
                }
            }
            if cur_adl <> null
            {
                ; the AFDR merge (parseDecl.cxx:1038-1093). missingAfdrDecl is
                ; the errorAfdr==0 path's pointer to <!AFDR> (suppressed under
                ; WWW); first occurrence only.
                if (ps.get_had_afdr_decl() = false) and (ps.get_sd().www() = false)
                {
                    this.report0_at(ParserMessages.missingAfdrDecl(), mdc_loc)
                    ps.set_had_afdr_decl()
                }
                let old_size cur_adl.size()
                ; copy-on-write: the reference copies when the list is shared
                ; (count != 1). The port always copies — observationally
                ; identical (same defs land on this element; other sharers keep
                ; the un-merged list), and the port tracks no refcounts.
                let merged AttributeDefinitionList.copy(host, cur_adl)
                merged.set_index(dtd.alloc_attribute_definition_list_index())
                merged.set_id_index(cur_adl.get_id_index())
                merged.set_notation_index(cur_adl.get_notation_index())
                if is_notation
                {
                    let nt2 a as ref[Notation]
                    nt2.set_attribute_def(merged)
                }
                else
                {
                    let e2 a as ref[ElementType]
                    e2.set_attribute_def(merged)
                }
                var mj: size_t 0
                let mn adl.size()
                while mj < mn
                {
                    let nd2 adl.def(mj)
                    let nd2_name nd2.get_name()
                    let have merged.attribute_index(nd2_name)
                    if have < 0
                    {
                        let mid merged.get_id_index()
                        if (mid <> ADL_NONE) and nd2.is_id()
                        {
                            let midd merged.def(mid)
                            let midn midd.get_name()
                            this.report1_at(ParserMessages.multipleIdAttributes(), midn, mdc_loc)
                        }
                        let mnt merged.get_notation_index()
                        if (mnt <> ADL_NONE) and nd2.is_notation()
                        {
                            let mntd merged.def(mnt)
                            let mntn mntd.get_name()
                            this.report1_at(ParserMessages.multipleNotationAttributes(), mntn, mdc_loc)
                        }
                        let ndc (*nd2).copy(host)
                        merged.append(ndc)
                    }
                    else
                    {
                        ; specifiedAttributeRedeclared (parseDecl.cxx:1078): an
                        ; attribute both SPECIFIED (data-attribute spec against
                        ; the #IMPLICIT/#ALL common defs) and redeclared.
                        let hd merged.def(have as size_t)
                        var spec_implicit false
                        if hd.is_specified(&spec_implicit)
                            this.report1_at(ParserMessages.specifiedAttributeRedeclared(), nd2_name, mdc_loc)
                    }
                    set mj: mj + 1
                }
                if is_notation = false
                {
                    let e3 a as ref[ElementType]
                    if e3.get_definition() <> null
                        this.check_element_attribute(e3, old_size)
                }
            }
            set j: j + 1
        }
        true
    }

    ; checkElementAttribute (parseDecl.cxx:802): the compatibility of an
    ; element's attribute definitions with its element definition — a NOTATION
    ; attribute and a CONREF attribute each conflict with declared content
    ; EMPTY. check_from > 0 restricts to freshly merged definitions. Location =
    ; the current token's start (the decl's MDC — verified 5:51 / 5:21).
    function check_element_attribute(this: Parser, e: ref[ElementType], check_from: size_t)
    {
        if ps.validate() = false
            return
        let att_def e.get_attribute_def()
        if att_def = null
            return
        let edef e.get_definition()
        if edef = null
            return
        var conref false
        let n att_def.size()
        var i check_from
        while i < n
        {
            let d att_def.def(i)
            if d.is_conref()
                set conref: true
            if d.is_notation()
            {
                if edef.get_declared_content() = DC_EMPTY
                {
                    let en e.get_name()
                    this.report1_at(ParserMessages.notationEmpty(), en, ps.current_input().token_start_location())
                }
            }
            set i: i + 1
        }
        if conref
        {
            ; the conrefOmitEndTag arm is in the reference's #if 0.
            if edef.get_declared_content() = DC_EMPTY
            {
                let en2 e.get_name()
                this.report1_at(ParserMessages.conrefEmpty(), en2, ps.current_input().token_start_location())
            }
        }
    }

    ; parseAttributed (parseDecl.cxx:1144): NOTATION data-attributes + element
    ; (name / name group) + the Annex-K #ALL/#IMPLICIT forms (non-LPD only —
    ; the LPD allow sets exclude them). An RNI form without a preceding
    ; <!AFDR> declaration reports missingAfdrDecl once (suppressed under WWW).
    ; The attributed object is then NAMED "#ALL"/"#IMPLICIT" (rniReservedName);
    ; checkDtd's addCommonAttributes sweep fans its definitions out.
    function parse_attributed(this: Parser, decl_input_level: u32, parm: ref[Param], attributed: ref[Array[pointer[void]]], out_is_notation: ref[bool]) returns bool
    {
        let ind_notation P_INDICATED_RESERVED_NAME + R_NOTATION
        let ind_all P_INDICATED_RESERVED_NAME + R_ALL
        let ind_implicit P_INDICATED_RESERVED_NAME + R_IMPLICIT
        var allow AllowedParams.a5(host, P_NAME, P_NAMEGROUP, ind_notation, ind_all, ind_implicit)
        if ps.have_def_lpd()
            set allow: AllowedParams.a3(host, P_NAME, P_NAMEGROUP, ind_notation)
        if this.parse_param(allow, decl_input_level, parm) = false
        {
            set out_is_notation: false
            return false
        }
        if parm.kind = ind_notation
        {
            set out_is_notation: true
            ; parseDecl.cxx:1169: a data-attribute ATTLIST warns under
            ; -wdata-atts.
            let opt_dat ps.get_options()
            if opt_dat.warn_data_attributes
                this.report0_at(ParserMessages.dataAttributes(), ps.current_input().token_start_location())
            var allow2 AllowedParams.a4(host, P_NAME, P_NAMEGROUP, ind_all, ind_implicit)
            if ps.have_def_lpd()
                set allow2: AllowedParams.a2(host, P_NAME, P_NAMEGROUP)
            if this.parse_param(allow2, decl_input_level, parm) = false
                return false
            if parm.kind = P_NAMEGROUP
            {
                let nt parm.name_tokens
                let n nt.get_length()
                let buf nt.get_buffer()
                var i: size_t 0
                while i < n
                {
                    let entry *(buf + i)
                    let nt_ptr this.lookup_create_notation(entry.name)
                    attributed.add(nt_ptr as pointer[void])
                    set i: i + 1
                }
            }
            else
            {
                var nname parm.token
                if parm.kind <> P_NAME
                {
                    if (ps.get_had_afdr_decl() = false) and (ps.get_sd().www() = false)
                    {
                        this.report0_at(ParserMessages.missingAfdrDecl(), ps.current_input().token_start_location())
                        ps.set_had_afdr_decl()
                    }
                    set nname: this.rni_reserved_name(parm.kind - P_INDICATED_RESERVED_NAME)
                }
                let nt_ptr this.lookup_create_notation(nname)
                attributed.add(nt_ptr as pointer[void])
            }
        }
        else
        {
            set out_is_notation: false
            if parm.kind = P_NAMEGROUP
            {
                ; parseDecl.cxx:1202: a name-group ATTLIST warns under
                ; -wattlist-group-decl.
                let opt_ag ps.get_options()
                if opt_ag.warn_attlist_group_decl
                    this.report0_at(ParserMessages.attlistGroupDecl(), ps.current_input().token_start_location())
                let nt parm.name_tokens
                let n nt.get_length()
                let buf nt.get_buffer()
                var i: size_t 0
                while i < n
                {
                    let entry *(buf + i)
                    let el_ptr this.lookup_create_element(entry.name)
                    attributed.add(el_ptr as pointer[void])
                    set i: i + 1
                }
            }
            else
            {
                var ename parm.token
                if parm.kind <> P_NAME
                {
                    if (ps.get_had_afdr_decl() = false) and (ps.get_sd().www() = false)
                    {
                        this.report0_at(ParserMessages.missingAfdrDecl(), ps.current_input().token_start_location())
                        ps.set_had_afdr_decl()
                    }
                    set ename: this.rni_reserved_name(parm.kind - P_INDICATED_RESERVED_NAME)
                }
                let el_ptr this.lookup_create_element(ename)
                attributed.add(el_ptr as pointer[void])
            }
        }
        true
    }

    ; parseDeclaredValue -> a DeclaredValue (null on failure). out_allowed_flags
    ; is the reference's allowedFlags bit set (parseDecl.cxx:1254): bit 1 =
    ; usable as a DATA attribute, bit 2 = usable as a LINK attribute — the
    ; dataAttributeDeclaredValue / linkAttributeDeclaredValue switch reads it.
    function parse_declared_value(this: Parser, decl_input_level: u32, is_notation: bool, parm: ref[Param], out_allowed_flags: ref[int]) returns ref[DeclaredValue]?
    {
        set out_allowed_flags: AS_DATA_ATTRIBUTE | AS_LINK_ATTRIBUTE
        var codes int[17]
        let cp codes as pointer[int]
        set *(cp + 0): P_RESERVED_NAME + R_CDATA
        set *(cp + 1): P_RESERVED_NAME + R_ENTITY
        set *(cp + 2): P_RESERVED_NAME + R_ENTITIES
        set *(cp + 3): P_RESERVED_NAME + R_ID
        set *(cp + 4): P_RESERVED_NAME + R_IDREF
        set *(cp + 5): P_RESERVED_NAME + R_IDREFS
        set *(cp + 6): P_RESERVED_NAME + R_NAME
        set *(cp + 7): P_RESERVED_NAME + R_NAMES
        set *(cp + 8): P_RESERVED_NAME + R_NMTOKEN
        set *(cp + 9): P_RESERVED_NAME + R_NMTOKENS
        set *(cp + 10): P_RESERVED_NAME + R_NUMBER
        set *(cp + 11): P_RESERVED_NAME + R_NUMBERS
        set *(cp + 12): P_RESERVED_NAME + R_NUTOKEN
        set *(cp + 13): P_RESERVED_NAME + R_NUTOKENS
        set *(cp + 14): P_RESERVED_NAME + R_NOTATION
        set *(cp + 15): P_NAMETOKENGROUP
        set *(cp + 16): P_RESERVED_NAME + R_DATA
        ; the DATA declared value is admitted only under WWW extensions
        ; (parseDecl.cxx:1250: allowDeclaredValueData vs allowDeclaredValue).
        var n_allowed: int 16
        if ps.get_sd().www()
            set n_allowed: 17
        let allow AllowedParams.an(host, cp, n_allowed)
        if this.parse_param(allow, decl_input_level, parm) = false
            return null
        let opt_dv ps.get_options()

        let k parm.kind
        if k = (P_RESERVED_NAME + R_CDATA)
            return DeclaredValue.make_cdata(host)
        if k = (P_RESERVED_NAME + R_ENTITY)
        {
            set out_allowed_flags: AS_LINK_ATTRIBUTE
            return DeclaredValue.make_entity(host, false)
        }
        if k = (P_RESERVED_NAME + R_ENTITIES)
        {
            set out_allowed_flags: AS_LINK_ATTRIBUTE
            return DeclaredValue.make_entity(host, true)
        }
        if k = (P_RESERVED_NAME + R_ID)
        {
            set out_allowed_flags: 0
            return DeclaredValue.make_id(host)
        }
        if k = (P_RESERVED_NAME + R_IDREF)
        {
            set out_allowed_flags: 0
            return DeclaredValue.make_idref(host, false)
        }
        if k = (P_RESERVED_NAME + R_IDREFS)
        {
            set out_allowed_flags: 0
            return DeclaredValue.make_idref(host, true)
        }
        if k = (P_RESERVED_NAME + R_NAME)
        {
            if opt_dv.warn_name_declared_value
                this.report0_at(ParserMessages.nameDeclaredValue(), ps.current_input().token_start_location())
            return DeclaredValue.make_tokenized(host, TT_NAME, false)
        }
        if k = (P_RESERVED_NAME + R_NAMES)
        {
            if opt_dv.warn_name_declared_value
                this.report0_at(ParserMessages.nameDeclaredValue(), ps.current_input().token_start_location())
            return DeclaredValue.make_tokenized(host, TT_NAME, true)
        }
        if k = (P_RESERVED_NAME + R_NMTOKEN)
            return DeclaredValue.make_tokenized(host, TT_NAMETOKEN, false)
        if k = (P_RESERVED_NAME + R_NMTOKENS)
            return DeclaredValue.make_tokenized(host, TT_NAMETOKEN, true)
        if k = (P_RESERVED_NAME + R_NUMBER)
        {
            if opt_dv.warn_number_declared_value
                this.report0_at(ParserMessages.numberDeclaredValue(), ps.current_input().token_start_location())
            return DeclaredValue.make_tokenized(host, TT_NUMBER, false)
        }
        if k = (P_RESERVED_NAME + R_NUMBERS)
        {
            if opt_dv.warn_number_declared_value
                this.report0_at(ParserMessages.numberDeclaredValue(), ps.current_input().token_start_location())
            return DeclaredValue.make_tokenized(host, TT_NUMBER, true)
        }
        if k = (P_RESERVED_NAME + R_NUTOKEN)
        {
            if opt_dv.warn_nutoken_declared_value
                this.report0_at(ParserMessages.nutokenDeclaredValue(), ps.current_input().token_start_location())
            return DeclaredValue.make_tokenized(host, TT_NUMBERTOKEN, false)
        }
        if k = (P_RESERVED_NAME + R_NUTOKENS)
        {
            if opt_dv.warn_nutoken_declared_value
                this.report0_at(ParserMessages.nutokenDeclaredValue(), ps.current_input().token_start_location())
            return DeclaredValue.make_tokenized(host, TT_NUMBERTOKEN, true)
        }
        if k = (P_RESERVED_NAME + R_NOTATION)
        {
            let allow_ng AllowedParams.a1(host, P_NAMEGROUP)
            if this.parse_param(allow_ng, decl_input_level, parm) = false
                return null
            let group this.group_names(parm)
            set out_allowed_flags: 0
            return DeclaredValue.make_notation(host, group)
        }
        if k = P_NAMETOKENGROUP
        {
            let group this.group_names(parm)
            return DeclaredValue.make_name_token_group(host, group)
        }
        if k = (P_RESERVED_NAME + R_DATA)
        {
            ; the WWW DATA declared value (parseDecl.cxx:1352): a notation name,
            ; then optionally a DSO data-attribute spec (tried with a SILENT
            ; allow set — anything else is the default value, ungot for the
            ; caller). Mirrors the NDATA entity path above.
            let allow_name AllowedParams.a1(host, P_NAME)
            if this.parse_param(allow_name, decl_input_level, parm) = false
                return null
            let nt this.lookup_create_notation(parm.token)
            let adl nt.get_attribute_def()
            let atts AttributeList.make(host, adl)
            let ctx ps.get_attribute_context()
            let allow_dso AllowedParams.a2(host, P_DSO, P_SILENT)
            var got_dso false
            if this.parse_param(allow_dso, decl_input_level, parm)
            {
                if parm.kind = P_DSO
                    set got_dso: true
            }
            if got_dso
            {
                if atts.size() = 0
                    if ps.get_sd().www() = false
                    {
                        let nnm nt.get_name()
                        this.report1(ParserMessages.notationNoAttributes(), nnm)
                    }
                var net false
                var new_att_def: pointer[AttributeDefinitionList] null
                if this.parse_attribute_spec(asMode, atts, &net, &new_att_def) = false
                    return null
                if new_att_def <> null
                {
                    let dtd ps.get_def_dtd()
                    new_att_def.set_index(dtd.alloc_attribute_definition_list_index())
                    nt.set_attribute_def(new_att_def)
                }
                if atts.n_spec_of() = 0
                    this.report0(ParserMessages.emptyDataAttributeSpec())
            }
            else
            {
                atts.finish(ctx)
                this.check_missing_semantics(atts)
                ; unget the first token of the default value (parseDecl.cxx:1374).
                ps.current_input().unget_token()
            }
            return DeclaredValue.make_data(host, nt as pointer[void], atts as pointer[void])
        }
        ; Every allowed kind is handled above — the reference's CANNOT_HAPPEN.
        null
    }

    function group_names(this: Parser, parm: ref[Param]) returns ref[Array[StringC]]
    {
        let out Array[StringC]^host()
        let nt parm.name_tokens
        let n nt.get_length()
        let buf nt.get_buffer()
        var i: size_t 0
        while i < n
        {
            let entry *(buf + i)
            out.add(entry.name)
            set i: i + 1
        }
        out
    }

    ; parseDefaultValue -> writes *out_def. scoped makeValue (pure part only).
    function parse_default_value(this: Parser, decl_input_level: u32, is_notation: bool, parm: ref[Param], attribute_name: StringC, declared_value: ref[DeclaredValue], out_def: pointer[pointer[AttributeDefinition]], any_current: ref[bool]) returns bool
    {
        let ind_fixed P_INDICATED_RESERVED_NAME + R_FIXED
        let ind_required P_INDICATED_RESERVED_NAME + R_REQUIRED
        let ind_current P_INDICATED_RESERVED_NAME + R_CURRENT
        let ind_conref P_INDICATED_RESERVED_NAME + R_CONREF
        let ind_implied P_INDICATED_RESERVED_NAME + R_IMPLIED
        var lit_type: int P_ATTRIBUTEVALUELITERAL
        if declared_value.tokenized()
            set lit_type: P_TOKENIZEDATTRIBUTEVALUELITERAL
        let allow AllowedParams.a7(host, ind_fixed, ind_required, ind_current, ind_conref, ind_implied, P_ATTRIBUTEVALUE, lit_type)
        if this.parse_param(allow, decl_input_level, parm) = false
            return false

        let dtd ps.get_def_dtd()
        if parm.kind = ind_fixed
        {
            let allow_val AllowedParams.a2(host, P_ATTRIBUTEVALUE, lit_type)
            if this.parse_param(allow_val, decl_input_level, parm) = false
                return false
            let value this.make_attribute_value(declared_value, parm.literal_text, attribute_name)
            ; idDeclaredValue (parseDecl.cxx:1439): an ID attribute may only
            ; default to IMPLIED or REQUIRED.
            if declared_value.is_id()
                this.report0_at(ParserMessages.idDeclaredValue(), ps.current_input().token_start_location())
            set *out_def: AttributeDefinition.make_fixed(host, attribute_name, declared_value, value)
        }
        else if (parm.kind = P_ATTRIBUTEVALUE) or (parm.kind = P_ATTRIBUTEVALUELITERAL) or (parm.kind = P_TOKENIZEDATTRIBUTEVALUELITERAL)
        {
            ; parseDecl.cxx:1447: an unquoted default value warns under
            ; -watt-value-not-literal.
            if parm.kind = P_ATTRIBUTEVALUE
            {
                let opt_al ps.get_options()
                if opt_al.warn_attribute_value_not_literal
                    this.report0_at(ParserMessages.attributeValueNotLiteral(), ps.current_input().token_start_location())
            }
            let value this.make_attribute_value(declared_value, parm.literal_text, attribute_name)
            if declared_value.is_id()
                this.report0_at(ParserMessages.idDeclaredValue(), ps.current_input().token_start_location())
            set *out_def: AttributeDefinition.make_default(host, attribute_name, declared_value, value)
        }
        else if parm.kind = ind_required
            set *out_def: AttributeDefinition.make_required(host, attribute_name, declared_value)
        else if parm.kind = ind_current
        {
            set any_current: true
            ; parseDecl.cxx:1471: #CURRENT on an ID attribute.
            if declared_value.is_id()
                this.report0_at(ParserMessages.idDeclaredValue(), ps.current_input().token_start_location())
            set *out_def: AttributeDefinition.make_current(host, attribute_name, declared_value, dtd.alloc_current_attribute_index())
            ; parseDecl.cxx:1476-1481: #CURRENT is not allowed for a data
            ; attribute (isNotation) nor a link attribute; otherwise it warns
            ; under -wcurrent. Reference order: isNotation FIRST.
            if is_notation
                this.report0_at(ParserMessages.dataAttributeDefaultValue(), ps.current_input().token_start_location())
            else if ps.have_def_lpd()
                this.report0_at(ParserMessages.linkAttributeDefaultValue(), ps.current_input().token_start_location())
            else
            {
                let opt_cu ps.get_options()
                if opt_cu.warn_current
                    this.report0_at(ParserMessages.currentAttribute(), ps.current_input().token_start_location())
            }
        }
        else if parm.kind = ind_conref
        {
            ; parseDecl.cxx:1484-1487: #CONREF on an ID / NOTATION attribute.
            if declared_value.is_id()
                this.report0_at(ParserMessages.idDeclaredValue(), ps.current_input().token_start_location())
            if declared_value.is_notation()
                this.report0_at(ParserMessages.notationConref(), ps.current_input().token_start_location())
            set *out_def: AttributeDefinition.make_conref(host, attribute_name, declared_value)
            ; parseDecl.cxx:1490-1495 — #CONREF likewise, isNotation first;
            ; otherwise it warns under -wconref.
            if is_notation
                this.report0_at(ParserMessages.dataAttributeDefaultValue(), ps.current_input().token_start_location())
            else if ps.have_def_lpd()
                this.report0_at(ParserMessages.linkAttributeDefaultValue(), ps.current_input().token_start_location())
            else
            {
                let opt_cr ps.get_options()
                if opt_cr.warn_conref
                    this.report0_at(ParserMessages.conrefAttribute(), ps.current_input().token_start_location())
            }
        }
        else if parm.kind = ind_implied
            set *out_def: AttributeDefinition.make_implied(host, attribute_name, declared_value)
        else
        {
            ; every kind the allow set admits is handled above — the
            ; reference's CANNOT_HAPPEN (parseDecl.cxx parseDefaultValue).
            return false
        }
        true
    }

    ; makeValue for a DTD default/FIXED value (parseDefaultValue calls
    ; declaredValue->makeValue): CDATA -> cdata value; tokenized -> fold +
    ; space-split. The validation half (category/length checks, group
    ; membership) runs here at DECLARATION time, exactly like the reference —
    ; entity/notation/id RESOLUTION stays instance-side (makeSemantics).
    function make_attribute_value(this: Parser, dv: ref[DeclaredValue], text: ref[Text], attribute_name: StringC) returns ref[AttributeValue]
    {
        ; parseDefaultValue's specLength is local and discarded.
        var dummy_spec: size_t 0
        if dv.tokenized() = false
        {
            this.validate_attribute_value(dv, text, attribute_name, &dummy_spec)
            ; DataDeclaredValue::makeValue — see AttributeList.set_value.
            let dnt dv.get_data_notation()
            if dnt <> null
                return AttributeValue.make_cdata_data(host, text, dnt, dv.get_data_attributes())
            return AttributeValue.make_cdata(host, text)
        }
        ; tokenized: NAMECASE-fold the value (general subst — TokenizedDeclaredValue
        ; ::makeTokenizedValue), then record the single-space separator positions.
        ; A default/fixed value is built here (not through set_value), so its fold
        ; happens here (e.g. an enumerated default `a` -> `A`). Entity-name values
        ; go through entitySubstTable = identity (NAMECASE ENTITY NO), like
        ; set_value — a folded default would name the wrong entity.
        let fold_general dv.is_entity() = false
        let raw text.string()
        let rn raw.get_size()
        if rn > 0
        {
            let syn ps.get_syntax()
            let fbuf host.allocate(rn * 4, 4) as pointer[u32]
            ; ★the per-char locations must ride ALONG through the fold, exactly
            ; as they do in AttributeList.set_value: the one-argument Text
            ; constructor drops them, and a DEFAULT value's locations are read
            ; by anything that diagnoses the default itself. First consumer:
            ; ArcEngineMessages.noArcDataF, which anchors at
            ; supportAttsText_[rArcDataF]->charLocation(0) (ArcEngine.cxx:940)
            ; — with the locations dropped it printed "(invalid location)"
            ; where the reference names the ATTLIST's line and column. The
            ; support attributes are FIXED defaults, so this fold is the only
            ; path they take.
            let tlocs text.get_locs()
            var lbuf: pointer[Location] null
            if tlocs <> null
                set lbuf: host.allocate(rn * sizeof Location, alignof Location) as pointer[Location]
            var fi: size_t 0
            while fi < rn
            {
                var fc raw.get(fi)
                if fold_general
                    set fc: syn.fold(fc)
                set *(fbuf + fi): fc
                if lbuf <> null
                    set *(lbuf + fi): *(tlocs + fi)
                set fi: fi + 1
            }
            set text: Text(StringC^host(fbuf, rn), lbuf)
        }
        this.validate_attribute_value(dv, text, attribute_name, &dummy_spec)
        let sc text.string()
        let n sc.get_size()
        let space_index Array[size_t]^host()
        var i: size_t 0
        while i < n
        {
            if sc.get(i) = 0x20
                space_index.add(i)
            set i: i + 1
        }
        AttributeValue.make_tokenized(host, text, space_index)
    }

    ; ---- parseNotationDecl -------------------------------------------------
    ; mdo_loc: the declaration's MDO (markupLocation()) — the notation's
    ; defLocation_, exactly as parse_entity_decl and parse_shortref_decl take
    ; it. ★It used to be `ps.current_location()`, i.e. the position AFTER the
    ; declaration, which is the same two-locations confusion as the missingPart
    ; anchor and the end tag's markup position. First consumer that could tell:
    ; ArcEngineMessages.noArcDataF/noArcDTDAtt, which anchor at the ArcBase
    ; notation's declaration — the reference names its `<!NOTATION` column, the
    ; port named the column past the closing MDC.
    function parse_notation_decl(this: Parser, mdo_loc: Location) returns bool
    {
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        let allow_name AllowedParams.a1(host, P_NAME)
        if this.parse_param(allow_name, decl_input_level, parm) = false
            return false
        let name_loc ps.current_input().token_start_location()
        let nt this.lookup_create_notation(parm.token)
        ; duplicateNotationDeclaration (parseDecl.cxx:1566): gated on validate();
        ; arg = notation name (quoted); location = the name token's start.
        if ps.validate() and nt.is_defined()
        {
            let nn parm.token
            this.report1_at(ParserMessages.duplicateNotationDeclaration(), nn, name_loc)
        }
        ; notationMustNotBeDeclared (parseDecl.cxx:1568-1577): a data-attribute
        ; spec against this then-undefined notation pulled in #IMPLICIT common
        ; definitions (isSpecified && implicit) — declaring the notation NOW
        ; contradicts that. E at the name token, first hit only.
        let ndl nt.get_attribute_def()
        if ndl <> null
        {
            let ndl_n ndl.size()
            var ndl_i: size_t 0
            while ndl_i < ndl_n
            {
                let ndl_d ndl.def(ndl_i)
                var ndl_implicit false
                var ndl_hit false
                if ndl_d.is_specified(&ndl_implicit)
                {
                    if ndl_implicit
                        set ndl_hit: true
                }
                if ndl_hit
                {
                    let nn2 parm.token
                    this.report1_at(ParserMessages.notationMustNotBeDeclared(), nn2, name_loc)
                    set ndl_i: ndl_n
                }
                else
                    set ndl_i: ndl_i + 1
            }
        }
        let allow_pub_sys AllowedParams.a2(host, P_RESERVED_NAME + R_PUBLIC, P_RESERVED_NAME + R_SYSTEM)
        if this.parse_param(allow_pub_sys, decl_input_level, parm) = false
            return false
        let allow_sys_mdc AllowedParams.a2(host, P_SYSTEMIDENTIFIER, P_MDC)
        let allow_mdc AllowedParams.a1(host, P_MDC)
        var id ExternalId()
        let maybe_ms parm.kind = (P_RESERVED_NAME + R_SYSTEM)
        if this.parse_external_id(allow_sys_mdc, allow_mdc, maybe_ms, decl_input_level, parm, &id) = false
            return false
        ; parseDecl.cxx:1593: under FORMAL YES a notation's public id that IS a
        ; formal public identifier must have text class NOTATION (getTextClass
        ; yields one only for type fpi). Plain message() = the MDC token start.
        if ps.validate()
        {
            let sdp ps.get_sd()
            if sdp.formal()
            {
                if id.get_public_type() = PUBLIC_FPI
                {
                    if id.get_text_class() <> TC_NOTATION
                        this.report0_at(ParserMessages.notationIdentifierTextClass(), ps.current_input().token_start_location())
                }
            }
        }
        if nt.is_defined() = false
        {
            ; pin the id strings to the run page (ExternalId.make) — `id` aliases
            ; the transient literal buffer (cf. parse_entity_decl); the ESIS
            ; writer reads them long after this declaration (the notation's
            ; p/s definition lines).
            let hid ExternalId.make(host, id)
            nt.set_external_id(hid, mdo_loc)
            ; Notation::generateSystemId (Notation.cxx:36, called from
            ; parseDecl.cxx:1603): the catalog lookup (system id / PUBLIC /
            ; NOTATION-name tables, SOEntityCatalog.cxx:427) resolves the
            ; external id and stamps the EFFECTIVE system id (the
            ; -onotation-sysid f-record, stored as the full FSI text) — a
            ; declared system id always resolves (expandSystemId, against the
            ; declaring source's directory); a miss with neither warns under
            ; -wnotation-sysid (W, arg = the folded notation name, at the MDC
            ; token start — probed 4:64/5:25 vs real onsgmls).
            let nn8 this.stringc_to_bytes(nt.get_name())
            let ndecl_file this.file_id_of_loc(ps.current_location())
            let eff this.catalog_effective_id(hid.has_system_id(), hid.get_system_id(), hid.has_public_id(), hid.get_public_id(), nn8, CAT_NOTATION, ps.get_sd().namecase_general(), ps.get_decl_base_dir(), ndecl_file)
            if eff.get_length() > 0
            {
                let heff String^host(eff)
                nt.set_effective_system(*heff)
            }
            else
            {
                let opt ps.get_options()
                if opt.warn_notation_system_id
                {
                    let wname nt.get_name()
                    this.report1_at(ParserMessages.cannotGenerateSystemIdNotation(), wname, ps.current_input().token_start_location())
                }
            }
        }
        true
    }

    ; ---- parseEntityDecl ---------------------------------------------------
    ; mdo_loc: the declaration's MDO (markupLocation()) — the entity's defLocation_.
    function parse_entity_decl(this: Parser, mdo_loc: Location) returns bool
    {
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        let ind_default P_INDICATED_RESERVED_NAME + R_DEFAULT
        let allow_start AllowedParams.a3(host, P_ENTITYNAME, ind_default, P_PERO)
        if this.parse_param(allow_start, decl_input_level, parm) = false
            return false

        ; The entity name is captured NOW (parm.token is valid here and gets
        ; overwritten by the later text/MDC reads) by deep-copying it into a
        ; heap InternalEntity's name FIELD — the only `^host` form that lowers
        ; correctly (local/return forms mis-lower to empty/garbage).
        var is_parameter false
        var iep: ref[InternalEntity]? null
        if parm.kind = P_PERO
        {
            set is_parameter: true
            let allow_pen AllowedParams.a1(host, P_PARAMENTITYNAME)
            if this.parse_param(allow_pen, decl_input_level, parm) = false
                return false
            set iep: InternalEntity.make(host, parm.token, StringC(), DT_SGML)
        }
        else if parm.kind = P_ENTITYNAME
            set iep: InternalEntity.make(host, parm.token, StringC(), DT_SGML)
        else
        {
            ; indDEFAULT -> empty name, the default entity. Under IMPLYDEF
            ; ENTITY YES a default entity makes no sense (parseDecl.cxx:1639);
            ; otherwise the declaration warns under -wdefault-entity. Location
            ; = the DEFAULT name token's start (after the RNI).
            if ps.get_sd().implydef_entity()
                this.report0_at(ParserMessages.implydefEntityDefault(), ps.current_input().token_start_location())
            else
            {
                let opt_dd ps.get_options()
                if opt_dd.warn_default_entity_decl
                    this.report0_at(ParserMessages.defaultEntityDecl(), ps.current_input().token_start_location())
            }
            set iep: InternalEntity.make(host, StringC(), StringC(), DT_SGML)
        }
        let name iep.get_name()

        var text_codes int[10]
        let tcp text_codes as pointer[int]
        set *(tcp + 0): P_PARAMLITERAL
        set *(tcp + 1): P_RESERVED_NAME + R_CDATA
        set *(tcp + 2): P_RESERVED_NAME + R_SDATA
        set *(tcp + 3): P_RESERVED_NAME + R_PI
        set *(tcp + 4): P_RESERVED_NAME + R_STARTTAG
        set *(tcp + 5): P_RESERVED_NAME + R_ENDTAG
        set *(tcp + 6): P_RESERVED_NAME + R_MS
        set *(tcp + 7): P_RESERVED_NAME + R_MD
        set *(tcp + 8): P_RESERVED_NAME + R_SYSTEM
        set *(tcp + 9): P_RESERVED_NAME + R_PUBLIC
        let allow_text AllowedParams.an(host, tcp, 10)
        if this.parse_param(allow_text, decl_input_level, parm) = false
            return false

        if (parm.kind = (P_RESERVED_NAME + R_SYSTEM)) or (parm.kind = (P_RESERVED_NAME + R_PUBLIC))
            return this.parse_external_entity(name, is_parameter, decl_input_level, parm, mdo_loc)

        ; bracketed text (parseDecl.cxx:68-134): STARTTAG/ENDTAG/MS/MD wrap the
        ; parameter literal in the corresponding delimiters at reference time.
        var data_type: int DT_SGML
        var bracketed: int 0
        let opt_et ps.get_options()
        if parm.kind = (P_RESERVED_NAME + R_CDATA)
        {
            set data_type: DT_CDATA
            if opt_et.warn_internal_cdata_entity
                this.report0_at(ParserMessages.internalCdataEntity(), ps.current_input().token_start_location())
        }
        else if parm.kind = (P_RESERVED_NAME + R_SDATA)
        {
            set data_type: DT_SDATA
            if opt_et.warn_internal_sdata_entity
                this.report0_at(ParserMessages.internalSdataEntity(), ps.current_input().token_start_location())
        }
        else if parm.kind = (P_RESERVED_NAME + R_PI)
        {
            set data_type: DT_PI
            if opt_et.warn_pi_entity
                this.report0_at(ParserMessages.piEntity(), ps.current_input().token_start_location())
        }
        ; typeLocation (parseDecl.cxx:1678) — the bracket keyword's own token
        ; start: the reference's BracketOrigin parents the synthesized open/
        ; close delimiter chars there (the -e def-location walk lands on it).
        var type_loc Location()
        if parm.kind = (P_RESERVED_NAME + R_STARTTAG)
        {
            set bracketed: 1
            set type_loc: ps.current_input().token_start_location()
            if opt_et.warn_bracket_entity
                this.report0_at(ParserMessages.bracketEntity(), ps.current_input().token_start_location())
        }
        else if parm.kind = (P_RESERVED_NAME + R_ENDTAG)
        {
            set bracketed: 2
            set type_loc: ps.current_input().token_start_location()
            if opt_et.warn_bracket_entity
                this.report0_at(ParserMessages.bracketEntity(), ps.current_input().token_start_location())
        }
        else if parm.kind = (P_RESERVED_NAME + R_MS)
        {
            set bracketed: 3
            set type_loc: ps.current_input().token_start_location()
            if opt_et.warn_bracket_entity
                this.report0_at(ParserMessages.bracketEntity(), ps.current_input().token_start_location())
        }
        else if parm.kind = (P_RESERVED_NAME + R_MD)
        {
            set bracketed: 4
            set type_loc: ps.current_input().token_start_location()
            if opt_et.warn_bracket_entity
                this.report0_at(ParserMessages.bracketEntity(), ps.current_input().token_start_location())
        }

        if parm.kind <> P_PARAMLITERAL
        {
            let allow_pl AllowedParams.a1(host, P_PARAMLITERAL)
            if this.parse_param(allow_pl, decl_input_level, parm) = false
                return false
        }
        let lt parm.literal_text
        let text_sc lt.string()
        ; DEEP-COPY the replacement text onto the host page — like the name — so it
        ; does not alias the transient literal buffer (which later parsing reuses;
        ; a shallow store corrupted it to a later token by reference time).
        if bracketed = 0
        {
            set iep.text: StringC^host(text_sc.data_ptr(), text_sc.get_size())
            ; per-char replacement-text locations (Text::charLocation) — the -e
            ; reporter's EntityOrigin::defLocation walk anchors messages inside
            ; the entity at these. parse_literal built the buffer on host, so
            ; the pointer is stable.
            iep.set_def_locs(lt.get_locs())
        }
        else
        {
            ; open/close delimiter strings per bracket kind (parseDecl.cxx:98).
            let wrap Array[u32]^host()
            if bracketed = 1
                this.append_delim_chars(wrap, dSTAGO)
            else if bracketed = 2
                this.append_delim_chars(wrap, dETAGO)
            else if bracketed = 3
            {
                this.append_delim_chars(wrap, dMDO)
                this.append_delim_chars(wrap, dDSO)
            }
            else
                this.append_delim_chars(wrap, dMDO)
            let open_len wrap.get_length()
            this.arg_append(wrap, text_sc)
            if bracketed = 1
                this.append_delim_chars(wrap, dTAGC)
            else if bracketed = 2
                this.append_delim_chars(wrap, dTAGC)
            else if bracketed = 3
            {
                this.append_delim_chars(wrap, dMSC)
                this.append_delim_chars(wrap, dMDC)
            }
            else
                this.append_delim_chars(wrap, dMDC)
            let total wrap.get_length()
            set iep.text: StringC^host(wrap.get_buffer(), total)
            ; per-char locations for the wrapped text: the literal chars keep
            ; their parse_literal locations; the synthesized delimiter chars
            ; carry the bracket keyword's location + chunk-relative offset —
            ; the value the reference's BracketOrigin walk (parent typeLocation,
            ; `index += loc.index()`) resolves to.
            let wlocs Array[Location]^host()
            var wi: size_t 0
            while wi < open_len
            {
                wlocs.add(Location(type_loc.get_origin(), type_loc.get_index() + (wi as u32)))
                set wi: wi + 1
            }
            let lit_locs lt.get_locs()
            var li: size_t 0
            while li < text_sc.get_size()
            {
                if lit_locs <> null
                    wlocs.add(*(lit_locs + li))
                else
                    wlocs.add(Location())
                set li: li + 1
            }
            var ci: size_t 0
            while (open_len + text_sc.get_size() + ci) < total
            {
                wlocs.add(Location(type_loc.get_origin(), type_loc.get_index() + (ci as u32)))
                set ci: ci + 1
            }
            iep.set_def_locs(wlocs.get_buffer())
            ; bracketedLitlen (parseDecl.cxx:134): only when the DELIMITERS
            ; push the interpreted text past LITLEN (the literal alone fits).
            let litlen ps.get_syntax().get_quantity(qLITLEN) as size_t
            if (total > litlen) and (text_sc.get_size() <= litlen)
                this.report_num_at(ParserMessages.bracketedLitlen(), litlen as u64, ps.current_input().token_start_location())
        }

        let allow_mdc AllowedParams.a1(host, P_MDC)
        if this.parse_param(allow_mdc, decl_input_level, parm) = false
            return false

        ; internalParameterDataEntity (parseDecl.cxx:141): an internal parameter
        ; entity cannot be CDATA or SDATA — reported at the MDC, NOT defined.
        if is_parameter and ((data_type = DT_CDATA) or (data_type = DT_SDATA))
        {
            this.report1_at(ParserMessages.internalParameterDataEntity(), name, ps.current_input().token_start_location())
            return true
        }

        set iep.data_type: data_type
        let ent host.allocate(sizeof Entity, alignof Entity) as pointer[Entity]
        let iev *iep
        set *ent: Entity.Internal(iev)
        ; defLocation_ for the internal entity = the declaration's MDO (side
        ; table — the Internal arm carries no location; -wunused-param anchor).
        ps.note_entity_def_location(ent, mdo_loc)
        this.maybe_define_entity(ent, is_parameter)
        true
    }

    ; parseExternalEntity(name, isParameter, declInputLevel, parm, mdo_loc).
    ; mdo_loc = markupLocation() — every entity built here carries it as its
    ; defLocation_ (where entityNotationUndefined and the "entity was defined
    ; here" auxiliary point: the declaration's MDO, verified col 0).
    function parse_external_entity(this: Parser, name: StringC, is_parameter: bool, decl_input_level: u32, parm: ref[Param], mdo_loc: Location) returns bool
    {
        var sys_codes int[6]
        let scp sys_codes as pointer[int]
        set *(scp + 0): P_SYSTEMIDENTIFIER
        set *(scp + 1): P_RESERVED_NAME + R_SUBDOC
        set *(scp + 2): P_RESERVED_NAME + R_CDATA
        set *(scp + 3): P_RESERVED_NAME + R_SDATA
        set *(scp + 4): P_RESERVED_NAME + R_NDATA
        set *(scp + 5): P_MDC
        let allow_sys AllowedParams.an(host, scp, 6)
        let allow_end AllowedParams.a5(host, P_RESERVED_NAME + R_SUBDOC, P_RESERVED_NAME + R_CDATA, P_RESERVED_NAME + R_SDATA, P_RESERVED_NAME + R_NDATA, P_MDC)
        var id ExternalId()
        if this.parse_external_id(allow_sys, allow_end, true, decl_input_level, parm, &id) = false
            return false
        ; pin the id strings to the run page IMMEDIATELY (ExternalId.make) —
        ; `id` points into the literal buffer, which the very next parse_param
        ; (the notation name / DSO / MDC of the data arms) reuses; a late copy
        ; pins garbage. Capture the CURRENT declaration base directory too
        ; (this <!ENTITY>'s file) so a relative system id resolves against the
        ; right directory when used later — by then the declaring file is off
        ; the input stack.
        let hid ExternalId.make(host, id)
        let hbase String^host(ps.get_decl_base_dir())

        if parm.kind = P_MDC
        {
            let ent host.allocate(sizeof Entity, alignof Entity) as pointer[Entity]
            set *ent: Entity.ExternalText(ExternalTextEntity(name, hid, hbase, mdo_loc))
            this.maybe_define_entity(ent, is_parameter)
            return true
        }

        let allow_mdc AllowedParams.a1(host, P_MDC)
        let ent host.allocate(sizeof Entity, alignof Entity) as pointer[Entity]
        if parm.kind = (P_RESERVED_NAME + R_SUBDOC)
        {
            ; parseDecl.cxx:1808 — a SUBDOC entity declared while the SGML
            ; declaration allows no subdocuments (SUBDOC NO -> subdoc()==0) is
            ; reported (the entity is still built). The implied declaration
            ; carries the ParserOptions default subdoc quantity (99999999), so
            ; a catalog-less document never trips this; xml.dcl's SUBDOC NO does.
            ; Location = the SUBDOC reserved-name token just parsed (its token
            ; start — current_location is one-past, at the following MDC).
            if ps.get_sd().subdoc() = 0
                this.report1_at(ParserMessages.subdocEntity(), name, ps.current_input().token_start_location())
            if this.parse_param(allow_mdc, decl_input_level, parm) = false
                return false
            set *ent: Entity.Subdoc(SubdocEntity(name, hid, hbase, mdo_loc))
        }
        else
        {
            var data_type: int DT_NDATA
            let opt_ee ps.get_options()
            if parm.kind = (P_RESERVED_NAME + R_CDATA)
            {
                set data_type: DT_CDATA
                ; parseDecl.cxx:1819: warns under -wexternal-cdata-entity.
                if opt_ee.warn_external_cdata_entity
                    this.report0_at(ParserMessages.externalCdataEntity(), ps.current_input().token_start_location())
            }
            else if parm.kind = (P_RESERVED_NAME + R_SDATA)
            {
                set data_type: DT_SDATA
                ; parseDecl.cxx:1824: warns under -wexternal-sdata-entity.
                if opt_ee.warn_external_sdata_entity
                    this.report0_at(ParserMessages.externalSdataEntity(), ps.current_input().token_start_location())
            }
            let allow_notname AllowedParams.a1(host, P_NAME)
            if this.parse_param(allow_notname, decl_input_level, parm) = false
                return false
            let nt this.lookup_create_notation(parm.token)
            let allow_dso_mdc AllowedParams.a2(host, P_DSO, P_MDC)
            if this.parse_param(allow_dso_mdc, decl_input_level, parm) = false
                return false
            ; the entity's data attributes: an AttributeList over the notation's
            ; attribute definitions — either specified in a DSO group here or
            ; defaulted by finish() (the writer's D records read them).
            let adl nt.get_attribute_def()
            let atts AttributeList.make(host, adl)
            let ctx ps.get_attribute_context()
            if parm.kind = P_DSO
            {
                if atts.size() = 0
                    if ps.get_sd().www() = false
                    {
                        ; notationNoAttributes — a data attribute specification
                        ; for a notation that defined none.
                        let nnm nt.get_name()
                        this.report1(ParserMessages.notationNoAttributes(), nnm)
                    }
                var net false
                var new_att_def: pointer[AttributeDefinitionList] null
                if this.parse_attribute_spec(asMode, atts, &net, &new_att_def) = false
                    return false
                if new_att_def <> null
                {
                    let dtd ps.get_def_dtd()
                    new_att_def.set_index(dtd.alloc_attribute_definition_list_index())
                    nt.set_attribute_def(new_att_def)
                }
                if atts.n_spec_of() = 0
                    this.report0(ParserMessages.emptyDataAttributeSpec())
                if this.parse_param(allow_mdc, decl_input_level, parm) = false
                    return false
            }
            else
            {
                atts.finish(ctx)
                this.check_missing_semantics(atts)
            }
            set *ent: Entity.ExternalData(ExternalDataEntity(name, hid, hbase, mdo_loc, data_type, nt as pointer[void], atts as pointer[void]))
        }
        ; external CDATA/SDATA/NDATA/SUBDOC parameter entities are rejected
        ; (reported, NOT defined) unless WWW extensions are on. Plain message()
        ; = the MDC token's start (verified 3:35 vs real onsgmls).
        if is_parameter
            if ps.get_sd().www() = false
            {
                this.report1_at(ParserMessages.externalParameterDataSubdocEntity(), name, ps.current_input().token_start_location())
                return true
            }
        this.maybe_define_entity(ent, is_parameter)
        true
    }

    ; maybeDefineEntity (scoped): insert into the def DTD (the Lpd/defaulted
    ; arms are LINK-axis); a FRESH insert runs generateSystemId (a duplicate
    ; keeps the old definition and generates nothing).
    function maybe_define_entity(this: Parser, entity: ref[Entity], is_parameter: bool)
    {
        let dtd ps.get_def_dtd()
        ; setDeclIn's LPD half (parseDecl.cxx:1885): an entity declared while
        ; an LPD is being defined registers in the side table with the LPD's
        ; activity (the Entity union carries no decl-in fields).
        if ps.have_def_lpd()
        {
            let dl ps.get_def_lpd()
            ps.note_lpd_entity_decl(entity, dl.is_active())
        }
        let name entity.get_name()
        if name.get_size() = 0
        {
            ; the default entity (parseDecl.cxx:1896): the FIRST declaration
            ; wins, unless the new one comes from an ACTIVE LPD and the old
            ; one does not. (The reference's defaulted-copy replacement sweep
            ; in Dtd::setDefaultEntity operates on defaulted-entity copies the
            ; port does not create.)
            let old dtd.get_default_entity()
            var replace old = null
            if replace = false
            {
                if ps.entity_decl_in_active_lpd(old) = false
                {
                    if ps.entity_decl_in_active_lpd(entity)
                        set replace: true
                }
            }
            if replace = false
            {
                ; parseDecl.cxx:1900: the losing re-declaration of #DEFAULT
                ; warns under -wduplicate, arg = the RNI-rendered name.
                let opt ps.get_options()
                if opt.warn_duplicate_entity
                {
                    let dflt this.rni_reserved_name(R_DEFAULT)
                    this.report1_at(ParserMessages.duplicateEntityDeclaration(), dflt, ps.current_input().token_start_location())
                }
            }
            if replace
            {
                dtd.set_default_entity(entity)
                ; Dtd::setDefaultEntity's replacement sweep (Dtd.cxx:58-80): a
                ; default entity from an ACTIVE LPD replaces every DEFAULTED
                ; general entity with a fresh copy of the NEW default (pass-1
                ; defaulted entities must not leak stale text into pass 2).
                if ps.entity_decl_in_active_lpd(entity)
                {
                    let ng dtd.n_entities(false)
                    var gi: size_t 0
                    while gi < ng
                    {
                        let old dtd.entity_at(false, gi)
                        var is_dflt false
                        if old <> null
                            set is_dflt: ps.entity_is_defaulted(old)
                        if is_dflt
                        {
                            let oname old.get_name()
                            let repl entity.copy_with_name(host, oname)
                            ps.note_defaulted_entity(repl)
                            this.generate_system_id(repl, false)
                            dtd.insert_entity(repl, false, true)
                        }
                        set gi: gi + 1
                    }
                }
            }
        }
        else
        {
            let inserted dtd.insert_entity(entity, is_parameter, false)
            if inserted = entity
                this.generate_system_id(entity, is_parameter)
            else if ps.entity_is_defaulted(inserted)
            {
                ; parseDecl.cxx:1910: the earlier "definition" was a defaulted
                ; copy from a reference through the default entity — the real
                ; declaration replaces it, with a pointed warning at the MDC.
                dtd.insert_entity(entity, is_parameter, true)
                this.report1_at(ParserMessages.defaultedEntityDefined(), name, ps.current_input().token_start_location())
                this.generate_system_id(entity, is_parameter)
            }
            else
            {
                ; parseDecl.cxx:1917: a definition from an ACTIVE LPD REPLACES
                ; an earlier one that is not from an active LPD (this is what
                ; makes the LPD's entities win in pass 2's instance).
                var replaced false
                if ps.entity_decl_in_active_lpd(entity)
                {
                    if ps.entity_decl_in_active_lpd(inserted) = false
                    {
                        dtd.insert_entity(entity, is_parameter, true)
                        this.generate_system_id(entity, is_parameter)
                        set replaced: true
                    }
                }
                if replaced = false
                {
                    ; parseDecl.cxx:1922: the ignored re-declaration warns
                    ; under -wduplicate (parameter vs general by declType).
                    let opt ps.get_options()
                    if opt.warn_duplicate_entity
                    {
                        if is_parameter
                            this.report1_at(ParserMessages.duplicateParameterEntityDeclaration(), name, ps.current_input().token_start_location())
                        else
                            this.report1_at(ParserMessages.duplicateEntityDeclaration(), name, ps.current_input().token_start_location())
                    }
                }
            }
        }
    }

    ; SOEntityCatalog::lookup + the effective-id FSI rendering: resolve an
    ; external id through the catalog (SYSTEM entry -> PUBLIC entry with the
    ; override gate and DELEGATE prefixes -> name-table entry, cross-kind
    ; contests won by the lower catalog number) and return the effective
    ; system id as the FULL formal-system-identifier text the f-record
    ; prints: `<OSFILE>path` for a resolved entry or the declared-system-id
    ; fallback (expandSystemId against the declaring source's directory), and
    ; `<CATALOG PUBLIC="pub"><OSFILE>delegate.cat` for a DELEGATE hit (the
    ; reference defers delegate resolution to open time — probed verbatim).
    ; Empty = total miss (the caller warns).
    function catalog_effective_id(this: Parser, has_sys: bool, sys8: String, has_pub: bool, pub8: String, name_key: String, name_decl_type: int, name_subst: bool, decl_base: String, decl_file: String) returns String
    {
        let cat ps.get_entity_catalog()
        if cat <> null
        {
            let lk cat.lookup_external(has_sys, sys8, has_pub, pub8, name_key, name_decl_type, name_subst)
            if lk.found
            {
                let fsi Array[u8]^host()
                if lk.delegated
                {
                    this.append_bytes(fsi, String("<CATALOG PUBLIC=\""))
                    this.append_bytes(fsi, pub8)
                    this.append_bytes(fsi, String("\"><OSFILE>"))
                    this.append_bytes(fsi, lk.delegate_catalog)
                }
                else if this.defer_resolution(lk.target, lk.base_file)
                {
                    ; search dirs configured: resolveRelative defers — the FSI
                    ; keeps the entry target with the CATALOG file as SOIBASE
                    ; (probed: `f<OSFILE SOIBASE='pf.cat'>chunk.txt` under -D).
                    this.append_bytes(fsi, String("<OSFILE SOIBASE='"))
                    this.append_bytes(fsi, lk.base_file)
                    this.append_bytes(fsi, String("'>"))
                    this.append_bytes(fsi, lk.target)
                }
                else
                {
                    this.append_bytes(fsi, String("<OSFILE>"))
                    this.append_bytes(fsi, lk.path)
                }
                let out String^host(fsi.get_buffer() as pointer[const_char], fsi.get_length())
                return *out
            }
        }
        if has_sys
        {
            let fsi2 Array[u8]^host()
            if this.defer_resolution(sys8, decl_file)
            {
                ; probed: `f<OSFILE SOIBASE='entsys.sgm'>sch.txt` under -D.
                this.append_bytes(fsi2, String("<OSFILE SOIBASE='"))
                this.append_bytes(fsi2, decl_file)
                this.append_bytes(fsi2, String("'>"))
                this.append_bytes(fsi2, sys8)
            }
            else
            {
                this.append_bytes(fsi2, String("<OSFILE>"))
                this.append_bytes(fsi2, EntityCatalog.resolve_target(decl_base, sys8))
            }
            let out2 String^host(fsi2.get_buffer() as pointer[const_char], fsi2.get_length())
            return *out2
        }
        String()
    }

    ; resolveRelative defers exactly when search dirs exist and the spec is
    ; relative (PosixStorageManager::resolveRelative returning 0); a missing
    ; base file id falls back to eager resolution.
    function defer_resolution(this: Parser, spec: String, base_file: String) returns bool
    {
        if ps.have_search_dirs() = false
            return false
        if base_file.get_length() = 0
            return false
        if spec.get_length() > 0
        {
            if spec.get(0) = 0x2F
                return false
        }
        true
    }

    ; the file id of the source a location sits in (the SOIBASE base): walk
    ; the origin chain to the nearest origin with a storage id, tracking the
    ; index so a multi-file document origin names the storage object the
    ; location actually sits in.
    function file_id_of_loc(this: Parser, loc: Location) returns String
    {
        var org loc.get_origin()
        var index loc.get_index()
        while org <> null
        {
            let fn org.file_name_at(index as size_t)
            if fn.get_size() > 0
                return this.stringc_to_bytes(fn)
            let rl org.get_ref_location()
            if rl.get_origin() <> null
            {
                if org.get_entity_decl() <> null
                    set index: rl.get_index() + (org.get_ref_length() as u32)
                else
                    set index: index + rl.get_index()
            }
            set org: rl.get_origin()
        }
        String()
    }

    function append_bytes(this: Parser, acc: ref[Array[u8]], s: String)
    {
        var i: size_t 0
        while i < s.get_length()
        {
            acc.add(s.get(i))
            set i: i + 1
        }
    }

    ; ExternalEntity::generateSystemId (Entity.cxx:127), run at define time.
    ; With a system id the storage manager resolves it (our effective id is the
    ; base-dir join computed lazily at use sites) — silent. With only a public
    ; id there is no catalog mapping → cannotGenerateSystemIdPublic (W, arg =
    ; the public id text). With neither → cannotGenerateSystemIdGeneral /
    ; ...Parameter (W, arg = the entity name). All at the current token start
    ; (the MDC — verified 3:19/4:20 vs real onsgmls). Internal entities and
    ; notation declarations generate nothing (notations verified silent).
    function generate_system_id(this: Parser, entity: ref[Entity], is_parameter: bool)
    {
        if entity.is_external() = false
            return
        let id entity.get_external_id()
        ; ExternalEntity::generateSystemId (Entity.cxx:127): the catalog lookup
        ; (SOEntityCatalog::lookup, :427) resolves the external id — SYSTEM
        ; entry keyed by the declared system id, then PUBLIC entry (with a
        ; declared system id only an OVERRIDE entry applies), then ENTITY-name
        ; entry (parameter entities keyed `%name`; namecase entity is off by
        ; default so the match is exact), else the declared system id itself
        ; expands against the declaring source's directory. A hit stamps the
        ; effective system id (the ESIS f-record, stored as the FULL FSI text
        ; — the writer prints it verbatim); only a total miss warns.
        let nm8 this.stringc_to_bytes(entity.get_name())
        var key nm8
        if is_parameter
        {
            ; the parameter-entity table key is peroDelim() + name.
            let kb Array[u8]^host()
            let syn ps.get_syntax()
            let pl syn.delim_general_len(dPERO)
            var pj: size_t 0
            while pj < pl
            {
                kb.add(syn.delim_general_char(dPERO, pj) as u8)
                set pj: pj + 1
            }
            var ki: size_t 0
            while ki < nm8.get_length()
            {
                kb.add(nm8.get(ki))
                set ki: ki + 1
            }
            let kp String^host(kb.get_buffer() as pointer[const_char], kb.get_length())
            set key: *kp
        }
        ; NAMECASE ENTITY is NO in every syntax the port models — entity-name
        ; entries match exactly (syntax.namecaseEntity() default).
        let decl_file this.file_id_of_loc(entity.get_def_location())
        let eff this.catalog_effective_id(id.has_system_id(), id.get_system_id(), id.has_public_id(), id.get_public_id(), key, CAT_ENTITY, false, entity.get_base_dir(), decl_file)
        if eff.get_length() > 0
        {
            let heff String^host(eff)
            entity.set_effective_system(*heff)
            return
        }
        let loc ps.current_input().token_start_location()
        if id.has_public_id()
        {
            ; widen the (8-bit) public id String into a StringC message arg.
            let pub id.get_public_id()
            let pn pub.get_length()
            let pbuf host.allocate(pn * 4, 4) as pointer[u32]
            var pi: size_t 0
            while pi < pn
            {
                set *(pbuf + pi): pub.get(pi) as u32
                set pi: pi + 1
            }
            let parg StringC(pbuf, pn)
            this.report1_at(ParserMessages.cannotGenerateSystemIdPublic(), parg, loc)
            return
        }
        let ename entity.get_name()
        if is_parameter
            this.report1_at(ParserMessages.cannotGenerateSystemIdParameter(), ename, loc)
        else
            this.report1_at(ParserMessages.cannotGenerateSystemIdGeneral(), ename, loc)
    }

    ; prettifyDelim (parseDecl.cxx:2007): render each function char in a
    ; shortref delimiter as CRO name REFC (`&#TAB;`) for the diagnostics.
    function prettify_delim(this: Parser, delim: StringC) returns StringC
    {
        let syn ps.get_syntax()
        let out Array[u32]^host()
        let n delim.get_size()
        var i: size_t 0
        while i < n
        {
            let c delim.get(i)
            let fname syn.char_function_name(c)
            if fname.get_size() > 0
            {
                var j: size_t 0
                let cl syn.delim_general_len(dCRO)
                while j < cl
                {
                    out.add(syn.delim_general_char(dCRO, j))
                    set j: j + 1
                }
                var k: size_t 0
                let fl fname.get_size()
                while k < fl
                {
                    out.add(fname.get(k))
                    set k: k + 1
                }
                var m: size_t 0
                let rl syn.delim_general_len(dREFC)
                while m < rl
                {
                    out.add(syn.delim_general_char(dREFC, m))
                    set m: m + 1
                }
            }
            else
                out.add(c)
            set i: i + 1
        }
        StringC^host(out.get_buffer(), out.get_length())
    }

    ; instanceSyntax() — the declared instance syntax under SCOPE INSTANCE,
    ; otherwise the (single) current syntax.
    function instance_syntax_ref(this: Parser) returns ref[Syntax]?
    {
        let inst ps.get_instance_syntax()
        if inst <> null
            return inst
        ps.get_syntax()
    }

    ; ---- parseShortrefDecl (parseDecl.cxx:1938) ----------------------------
    ; `mdo_loc` = the declaration's MDO (markupLocation()): a fresh map's
    ; defLocation — where the duplicate-declaration auxiliary and checkDtd's
    ; map-entity-resolution messages point.
    function parse_shortref_decl(this: Parser, mdo_loc: Location) returns bool
    {
        let dtd ps.get_def_dtd()
        if dtd.get_is_base() = false
            this.report0_at(ParserMessages.shortrefOnlyInBaseDtd(), ps.current_input().token_start_location())
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        let allow_name AllowedParams.a1(host, P_NAME)
        if this.parse_param(allow_name, decl_input_level, parm) = false
            return false
        let map this.lookup_create_map(parm.token)
        var valid true
        if map.defined()
        {
            this.report1_aux(ParserMessages.duplicateShortrefDeclaration(), parm.token, ps.current_input().token_start_location(), ParserMessages.duplicateShortrefDeclaration_aux(), map.get_def_location())
            set valid: false
        }
        else
            map.set_def_location(mdo_loc)

        let allow_pl AllowedParams.a1(host, P_PARAMLITERAL)
        if this.parse_param(allow_pl, decl_input_level, parm) = false
            return false

        let inst_syn this.instance_syntax_ref()
        let vec Array[StringC]^host()
        var running true
        while running
        {
            ; the delimiter string, folded through the instance syntax's
            ; general substitution table (instanceSyntax().generalSubstTable()
            ; ->subst(delim)).
            let lit parm.literal_text.string()
            let dn lit.get_size()
            let dbuf host.allocate(dn * 4, 4) as pointer[u32]
            var di: size_t 0
            while di < dn
            {
                set *(dbuf + di): inst_syn.fold(lit.get(di))
                set di: di + 1
            }
            let delim StringC^host(dbuf, dn)
            ; shortrefIndex validates against the instance syntax and interns
            ; only known delimiters.
            var sr_index: size_t 0
            if dtd.shortref_index(delim, *inst_syn, &sr_index) = false
            {
                let pretty this.prettify_delim(delim)
                this.report1_at(ParserMessages.unknownShortrefDelim(), pretty, ps.current_input().token_start_location())
                set valid: false
            }
            let allow_ent AllowedParams.a1(host, P_ENTITYNAME)
            if this.parse_param(allow_ent, decl_input_level, parm) = false
                return false
            if valid
            {
                while vec.get_length() <= sr_index
                    vec.add(StringC())
                if (vec[sr_index]).get_size() > 0
                {
                    let pretty2 this.prettify_delim(delim)
                    this.report1_at(ParserMessages.delimDuplicateMap(), pretty2, ps.current_input().token_start_location())
                    set valid: false
                }
                else
                    vec.put(sr_index, parm.token)
            }
            let allow_pl_mdc AllowedParams.a2(host, P_PARAMLITERAL, P_MDC)
            if this.parse_param(allow_pl_mdc, decl_input_level, parm) = false
                return false
            if parm.kind = P_MDC
                set running: false
        }
        if valid
            map.set_name_map(vec)
        true
    }

    ; ---- parseUsemapDecl (parseDecl.cxx:2026) -------------------------------
    ; Both contexts: in a DTD it associates a map with element types; in the
    ; instance it switches the CURRENT element's active map (`<!USEMAP m>` /
    ; `<!USEMAP #EMPTY>`).
    function parse_usemap_decl(this: Parser) returns bool
    {
        let in_instance ps.is_in_instance()
        if in_instance = false
        {
            let ddtd ps.get_def_dtd()
            if ddtd.get_is_base() = false
                this.report0_at(ParserMessages.usemapOnlyInBaseDtd(), ps.current_input().token_start_location())
        }
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        let allow_name_empty AllowedParams.a2(host, P_NAME, P_INDICATED_RESERVED_NAME + R_EMPTY)
        if this.parse_param(allow_name_empty, decl_input_level, parm) = false
            return false
        let cs ps.get_content_state()
        var map: ref[ShortReferenceMap]? null
        if parm.kind = P_NAME
        {
            if in_instance
            {
                let cdtd ps.get_current_dtd()
                set map: cdtd.lookup_short_reference_map(parm.token)
                if map = null
                    this.report1_at(ParserMessages.undefinedShortrefMapInstance(), parm.token, ps.current_input().token_start_location())
            }
            else
            {
                let tem this.lookup_create_map(parm.token)
                tem.set_used()
                set map: tem
            }
        }
        else
            set map: cs.get_the_empty_map()
        let allow_name_group_mdc AllowedParams.a3(host, P_NAME, P_NAMEGROUP, P_MDC)
        if this.parse_param(allow_name_group_mdc, decl_input_level, parm) = false
            return false
        if parm.kind <> P_MDC
        {
            if in_instance
            {
                this.report0_at(ParserMessages.usemapAssociatedElementTypeInstance(), ps.current_input().token_start_location())
                let allow_mdc AllowedParams.a1(host, P_MDC)
                if this.parse_param(allow_mdc, decl_input_level, parm) = false
                    return false
            }
            else
            {
                ; associate: every named element type without a map yet gets
                ; this one (first USEMAP wins — `if (!e->map())`).
                if parm.kind = P_NAME
                {
                    let e this.lookup_create_element(parm.token)
                    if e.get_map() = null
                        e.set_map(map)
                }
                else
                {
                    let src parm.name_tokens
                    let gn src.get_length()
                    let gbuf src.get_buffer()
                    var gi: size_t 0
                    while gi < gn
                    {
                        let nt *(gbuf + gi)
                        let e2 this.lookup_create_element(nt.name)
                        if e2.get_map() = null
                            e2.set_map(map)
                        set gi: gi + 1
                    }
                }
                let allow_mdc2 AllowedParams.a1(host, P_MDC)
                if this.parse_param(allow_mdc2, decl_input_level, parm) = false
                    return false
            }
        }
        else
        {
            if in_instance = false
                this.report0_at(ParserMessages.usemapAssociatedElementTypeDtd(), ps.current_input().token_start_location())
            else if map <> null
            {
                if (map <> cs.get_the_empty_map()) and (map.defined() = false)
                {
                    let mname map.get_name()
                    this.report1_at(ParserMessages.undefinedShortrefMapInstance(), mname, ps.current_input().token_start_location())
                }
                else
                    cs.current_element().set_map(map)
            }
        }
        true
    }

    ; The reserved-name-in-context dispatch of the "declaration not allowed in X"
    ; trio (parseDecl.cxx doProlog/doDtdSubset, parseInstance.cxx doContent). Each
    ; predicate names EXACTLY the declaration reserved names the reference reports
    ; as not-allowed in that context; every other recognized reserved name falls to
    ; the switch's noSuchDeclarationType default at the call site.
    ; doProlog: only DOCTYPE (and the deferred LINKTYPE) start a prolog declaration.
    function prolog_declaration_not_allowed(this: Parser, rn: int) returns bool
    {
        if rn = R_ELEMENT
            return true
        if rn = R_ATTLIST
            return true
        if rn = R_ENTITY
            return true
        if rn = R_NOTATION
            return true
        if rn = R_SHORTREF
            return true
        if rn = R_USEMAP
            return true
        if rn = R_USELINK
            return true
        if rn = R_LINK
            return true
        if rn = R_IDLINK
            return true
        false
    }

    ; doDtdSubset (inDtd): ELEMENT/ATTLIST/ENTITY/NOTATION/SHORTREF/USEMAP belong in
    ; a DTD; DOCTYPE/LINKTYPE/USELINK/LINK/IDLINK do not.
    function dtd_subset_declaration_not_allowed(this: Parser, rn: int) returns bool
    {
        if rn = R_DOCTYPE
            return true
        if rn = R_LINKTYPE
            return true
        if rn = R_USELINK
            return true
        if rn = R_LINK
            return true
        if rn = R_IDLINK
            return true
        false
    }

    ; doContent: USEMAP/USELINK are the only markup declarations allowed in the
    ; instance; DOCTYPE/LINKTYPE/ELEMENT/ATTLIST/ENTITY/NOTATION/SHORTREF/LINK/IDLINK
    ; are not.
    function instance_declaration_not_allowed(this: Parser, rn: int) returns bool
    {
        if rn = R_DOCTYPE
            return true
        if rn = R_LINKTYPE
            return true
        if rn = R_ELEMENT
            return true
        if rn = R_ATTLIST
            return true
        if rn = R_ENTITY
            return true
        if rn = R_NOTATION
            return true
        if rn = R_SHORTREF
            return true
        if rn = R_LINK
            return true
        if rn = R_IDLINK
            return true
        false
    }

    ; ---- parseDeclarationName (after MDO) ---------------------------------
    ; allow_afdr (parseDecl.cxx:522): in a DTD subset with errorAfdr OFF, the
    ; non-reserved name AFDR maps to rANY — the doDeclSubset dispatcher's
    ; <!AFDR "ISO/IEC 10744:1997"> arm.
    function parse_declaration_name(this: Parser, out_rn: ref[int], allow_afdr: bool) returns bool
    {
        ps.current_input().discard_initial()
        this.extend_name_token(this.namelen(), ParserMessages.nameLength())
        let name this.name_folded()
        let rn this.lookup_reserved_name(name)
        if rn < 0
        {
            if allow_afdr and name.equals(StringC("AFDR"))
            {
                set out_rn: R_ANY
                return true
            }
            ; noSuchDeclarationType (parseDecl.cxx:529): the reserved name read is
            ; not a declaration type. Arg = the folded name (quoted); location =
            ; the name token's start.
            let loc ps.current_input().token_start_location()
            this.report1_at(ParserMessages.noSuchDeclarationType(), name, loc)
            return false
        }
        set out_rn: rn
        true
    }

    ; parseAfdrDecl (parseDecl.cxx:3640): <!AFDR "ISO/IEC 10744:1997"> — only
    ; reachable with errorAfdr off (the -w wiring); records hadAfdrDecl and
    ; validates the version literal.
    function parse_afdr_decl(this: Parser) returns bool
    {
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        ps.set_had_afdr_decl()
        let allow_lit AllowedParams.a1(host, P_MINIMUMLITERAL)
        if this.parse_param(allow_lit, decl_input_level, parm) = false
            return false
        let lit parm.literal_text
        let lit_sc lit.string()
        if lit_sc.equals(StringC("ISO/IEC 10744:1997")) = false
        {
            let larg StringC^host(lit_sc.data_ptr(), lit_sc.get_size())
            this.report1_at(ParserMessages.afdrVersion(), larg, ps.current_input().token_start_location())
        }
        let allow_mdc AllowedParams.a1(host, P_MDC)
        if this.parse_param(allow_mdc, decl_input_level, parm) = false
            return false
        true
    }

    ; parseComment (parseCommon.cxx): read a comment body up to the closing COM
    ; (`--`). The markup capture is not wanted for ESIS; just consume the chars.
    ; tokenEe inside a comment is an error.
    ; `collect` (non-null only from parse_comment_decl under -ocomment) gathers
    ; the comment's chars — the reference's Markup::addCommentChar capture.
    function parse_comment(this: Parser, mode: int, collect: ref[Array[u32]]?) returns bool
    {
        ; startLoc (parseCommon.cxx:537) — where the comment opened; the
        ; auxiliary "comment started here" line points at it. The reference's
        ; currentLocation() is the current TOKEN START (InputSource::
        ; startLocation_), i.e. the `<` of the just-consumed `<!--` (or the
        ; first `-` of an in-declaration COM) — not the cursor behind it.
        let start_loc ps.current_input().token_start_location()
        var running true
        var ok true
        while running
        {
            let token ps.get_token(mode)
            if token = tokenCom
                set running: false
            else if token = tokenEe
            {
                ; commentEntityEnd (parseCommon.cxx:550): unterminated comment.
                this.report0_aux(ParserMessages.commentEntityEnd(), ps.current_input().token_start_location(), ParserMessages.commentEntityEnd_aux(), start_loc)
                set ok: false
                set running: false
            }
            else if token = tokenUnrecognized
            {
                ; parseComment's tokenUnrecognized arm (parseCommon.cxx:546):
                ; a non-SGML char reports nonSgmlCharacter; a valid SGML char
                ; that is not significant in the SD comment mode reports
                ; sdCommentSignificant. report_non_sgml_param CONSUMES the
                ; char either way (a zero-length unrecognized token would
                ; loop forever otherwise — only reachable in sdcomMode, whose
                ; tokenChar set is significant, not sgmlChar).
                if this.report_non_sgml_param() = false
                {
                    let ins ps.current_input()
                    let ts ins.current_token_string()
                    this.report1_at(ParserMessages.sdCommentSignificant(), ts, ins.token_start_location())
                }
            }
            else
            {
                ; a comment character run (already consumed by get_token) —
                ; captured only when a collector rides along (-ocomment).
                if collect <> null
                {
                    let cins ps.current_input()
                    let cts cins.current_token_string()
                    let ctn cts.get_size()
                    var cti: size_t 0
                    while cti < ctn
                    {
                        collect.add(cts.get(cti))
                        set cti: cti + 1
                    }
                }
            }
        }
        ok
    }

    ; parseProcessingInstruction (parseCommon.cxx): the PIO (`<?`) is already
    ; consumed; read chars in piMode up to the PIC (`?>` / `>`), accumulating the
    ; raw PI content, then queue a PI event. SgmlsEventHandler::pi emits it as
    ; `?` + data + RE. onsgmls treats an XML declaration (`<?xml ...?>`) as a
    ; perfectly ordinary PI — no special-casing.
    function parse_processing_instruction(this: Parser) returns bool
    {
        let loc ps.current_location()
        let buf Array[u32]^host()
        var running true
        var ok true
        while running
        {
            let token ps.get_token(piMode)
            if token = tokenPic
                set running: false
            else if token = tokenEe
            {
                ; processingInstructionEntityEnd (parseCommon.cxx:28).
                this.report0_at(ParserMessages.processingInstructionEntityEnd(), ps.current_input().token_start_location())
                set ok: false
                set running: false
            }
            else
            {
                ; tokenChar / tokenUnrecognized — accumulate the char(s).
                let ins ps.current_input()
                let ts ins.current_token_string()
                let m ts.get_size()
                let pilen_q ps.get_syntax().get_quantity(qPILEN) as size_t
                var i: size_t 0
                while i < m
                {
                    buf.add(ts.get(i))
                    ; parseCommon.cxx:35 — past TWICE the limit the PIC is
                    ; assumed missing: report the length AND the missing
                    ; delimiter, abandon the PI (the rest re-scans as content).
                    if (buf.get_length() / 2) > pilen_q
                    {
                        let ploc ps.current_input().token_start_location()
                        this.report_num_at(ParserMessages.processingInstructionLength(), pilen_q as u64, ploc)
                        this.report0_at(ParserMessages.processingInstructionClose(), ploc)
                        return false
                    }
                    set i: i + 1
                }
            }
        }
        if ok
        {
            let cnt buf.get_length()
            ; parseCommon.cxx:44 — the closed PI's data over PILEN.
            let pilen_q ps.get_syntax().get_quantity(qPILEN) as size_t
            if cnt > pilen_q
                this.report_num_at(ParserMessages.processingInstructionLength(), pilen_q as u64, ps.current_input().token_start_location())
            ; parseCommon.cxx:47: under -wpi-missing-name the PI data must
            ; start with a name, optionally followed by an S.
            let opt_pm ps.get_options()
            if opt_pm.warn_pi_missing_name
            {
                let syn_pi ps.get_syntax()
                var pi_i: size_t 0
                if cnt > 0
                {
                    if syn_pi.is_name_start_character(*(buf.get_buffer()))
                    {
                        set pi_i: 1
                        while pi_i < cnt
                        {
                            if syn_pi.is_name_character(*(buf.get_buffer() + pi_i)) = false
                                break
                            set pi_i: pi_i + 1
                        }
                    }
                }
                var pi_bad pi_i = 0
                if pi_bad = false
                {
                    if pi_i < cnt
                    {
                        let sset_pi syn_pi.char_set(setS)
                        if sset_pi.contains(*(buf.get_buffer() + pi_i)) = false
                            set pi_bad: true
                    }
                }
                if pi_bad
                    this.report0_at(ParserMessages.piMissingName(), ps.current_input().token_start_location())
            }
            var sc: StringC StringC()
            if cnt > 0
            {
                let cb host.allocate(cnt * 4, 4) as pointer[u32]
                let src buf.get_buffer()
                var j: size_t 0
                while j < cnt
                {
                    set *(cb + j): *(src + j)
                    set j: j + 1
                }
                set sc: StringC^host(cb, cnt)
            }
            let ev Event.make_pi(ps.event_host(), sc, loc)
            ps.queue_event(ev)
        }
        ok
    }

    ; parseCommentDecl (parseDecl.cxx): a `<!-- ... -->` comment declaration. The
    ; opening MDO+COM (tokenMdoCom `<!--`) is already consumed; read the first
    ; comment body, then in mdMode allow whitespace / further comments before the
    ; closing MDC (`>`).
    function parse_comment_decl(this: Parser) returns bool
    {
        ; markupLocation() — the MDO that opened the declaration (the tokenMdoCom
        ; the caller just consumed); the "comment declaration started here"
        ; auxiliaries point at it.
        let mdo_loc ps.current_input().token_start_location()
        ; -ocomment (eventsWanted().wantCommentDecls()): capture the comment
        ; segments and queue a CommentDeclEvent at the end — in EVERY context
        ; (prolog events too; the writer's inDocument_ gate drops those).
        var segs: ref[Array[StringC]]? null
        if ps.output_flag(OF_COMMENT)
            set segs: Array[StringC]^host()
        var col: ref[Array[u32]]? null
        if segs <> null
            set col: Array[u32]^host()
        if this.parse_comment(comMode, col) = false
            return false
        if segs <> null
        {
            let s0 StringC^host(col.get_buffer(), col.get_length())
            segs.add(*s0)
        }
        var running true
        var ok true
        while running
        {
            let token ps.get_token(mdMode)
            if token = tokenS
            {
                ; parseDecl.cxx:3596: S in a comment declaration warns under
                ; -wcomment-decl-s.
                let opt_cs ps.get_options()
                if opt_cs.warn_comment_decl_s
                    this.report0_at(ParserMessages.commentDeclS(), ps.current_input().token_start_location())
            }
            else if token = tokenCom
            {
                var col2: ref[Array[u32]]? null
                if segs <> null
                    set col2: Array[u32]^host()
                if this.parse_comment(comMode, col2) = false
                {
                    set ok: false
                    set running: false
                }
                else
                {
                    if segs <> null
                    {
                        let s2 StringC^host(col2.get_buffer(), col2.get_length())
                        segs.add(*s2)
                    }
                    ; parseDecl.cxx:3602: a second comment warns under
                    ; -wcomment-decl-multiple.
                    let opt_cm ps.get_options()
                    if opt_cm.warn_comment_decl_multiple
                        this.report0_at(ParserMessages.commentDeclMultiple(), ps.current_input().token_start_location())
                }
            }
            else if token = tokenMdc
                set running: false
            else if token = tokenEe
            {
                ; declarationLevel (parseDecl.cxx parseCommentDecl tokenEe).
                this.report0_at(ParserMessages.declarationLevel(), ps.current_input().token_start_location())
                set ok: false
                set running: false
            }
            else if token = tokenUnrecognized
            {
                ; commentDeclarationCharacter + "comment declaration started
                ; here" at the MDO; a non-SGML character reports separately
                ; and continues (parseDecl.cxx parseCommentDecl).
                if this.report_non_sgml_param() = false
                {
                    let ct ps.current_token()
                    this.report1_aux(ParserMessages.commentDeclarationCharacter(), ct, ps.current_input().token_start_location(), ParserMessages.commentDeclarationCharacter_aux(), mdo_loc)
                    set ok: false
                    set running: false
                }
            }
            else
            {
                ; commentDeclInvalidToken: any other markup-declaration token.
                let a1 this.token_message_arg(token, mdMode)
                this.report_raw_aux(ParserMessages.commentDeclInvalidToken(), a1, ps.current_input().token_start_location(), ParserMessages.commentDeclInvalidToken_aux(), mdo_loc)
                set ok: false
                set running: false
            }
        }
        ; the CommentDeclEvent (parseDecl.cxx end of parseCommentDecl) — only a
        ; successfully terminated declaration emits.
        if ok and (segs <> null)
            ps.queue_event(Event.make_comment(ps.event_host(), segs, mdo_loc))
        ok
    }

    ; ---- doDeclSubset (scoped driver) -------------------------------------
    ; Drives a declaration subset (internal or external). `subset_level` is the
    ; input level the subset itself occupies (1 for the document's internal
    ; subset; the pushed entity's level for an external subset); an end-of-entity
    ; that pops BELOW that level ends the subset. `external` selects the external
    ; subset's termination (end-of-entity, no DSC). Returns 0 at end of subset.
    ; PIs / PE-refs / marked sections recover rather than resolving (deferred).
    function parse_decl_subset(this: Parser, subset_level: u32, external: bool) returns int
    {
        ps.set_current_mode(dsMode)
        var running true
        var rc: int 0
        while running
        {
            let token ps.get_token(ps.get_current_mode())
            let start_level ps.get_input_level()
            if token = tokenEe
            {
                if (external = false) and (ps.get_input_level() = subset_level)
                {
                    ; documentEndDtdSubset / documentEndLpdSubset (doDeclSubset
                    ; tokenEe, inputLevel 1): the DOCUMENT entity ended inside
                    ; the internal subset — message BEFORE popping, then abort
                    ; the run (allDone()). Without this the caller went on to
                    ; read the DSC from an empty input stack (segfault).
                    if ps.have_def_lpd()
                        this.report0_at(ParserMessages.documentEndLpdSubset(), ps.current_input().token_start_location())
                    else
                        this.report0_at(ParserMessages.documentEndDtdSubset(), ps.current_input().token_start_location())
                    ps.pop_input_stack()
                    set rc: 1
                    set running: false
                }
                else
                {
                    ; end of an entity: pop it. When we drop below the subset's
                    ; own level the subset is finished (an external subset ends
                    ; here; a nested parameter entity returns to the subset).
                    ps.pop_input_stack()
                    if ps.get_input_level() < subset_level
                        set running: false
                }
            }
            else if token = tokenDsc
            {
                if external
                    this.decl_subset_recover(start_level)
                else
                    set running: false
            }
            else if token = tokenMdoCom
            {
                if this.parse_comment_decl() = false
                    this.decl_subset_recover(start_level)
            }
            else if token = tokenMdoNameStart
            {
                ; markupLocation() — the MDO of the declaration (the token start
                ; BEFORE parse_declaration_name re-tokenizes the name). It becomes
                ; an entity's defLocation_ (EntityDecl ctor takes markup.location()),
                ; where entityNotationUndefined and the "entity was defined here"
                ; auxiliary point.
                let mdo_loc ps.current_input().token_start_location()
                var decl_name: int 0
                var afdr_ok ps.have_def_lpd() = false
                if ps.get_error_afdr()
                    set afdr_ok: false
                if this.parse_declaration_name(&decl_name, afdr_ok)
                {
                    ; doDeclSubset (parseDecl.cxx:243): inDtd = no LPD is being
                    ; defined — an LPD subset admits ATTLIST/ENTITY/LINK/IDLINK
                    ; (+ NOTATION, flagged unless WWW) and rejects the DTD-only
                    ; declarations with lpdSubsetDeclaration.
                    let in_lpd ps.have_def_lpd()
                    var result false
                    if decl_name = R_ANY
                    {
                        ; rANY stands in for <!AFDR (parseDecl.cxx:308).
                        set result: this.parse_afdr_decl()
                    }
                    else if decl_name = R_ELEMENT
                    {
                        if in_lpd
                        {
                            let spell_e this.name_folded()
                            this.report1_at(ParserMessages.lpdSubsetDeclaration(), spell_e, ps.current_input().token_start_location())
                        }
                        else
                            set result: this.parse_element_decl()
                    }
                    else if decl_name = R_ATTLIST
                        set result: this.parse_attlist_decl()
                    else if decl_name = R_ENTITY
                        set result: this.parse_entity_decl(mdo_loc)
                    else if decl_name = R_NOTATION
                    {
                        set result: this.parse_notation_decl(mdo_loc)
                        ; parseDecl.cxx:328 — flagged AFTER parsing, and only
                        ; without the WWW extensions. The token has moved past
                        ; the declaration, so the arg is the SYNTAX's reserved
                        ; name (the reference's syntax().reservedName(name)).
                        if in_lpd
                        {
                            if ps.get_sd().www() = false
                            {
                                let syn_n ps.get_syntax()
                                let spell_n syn_n.reserved_name(R_NOTATION)
                                this.report1_at(ParserMessages.lpdSubsetDeclaration(), spell_n, ps.current_input().token_start_location())
                            }
                        }
                    }
                    else if decl_name = R_SHORTREF
                    {
                        if in_lpd
                        {
                            let spell_s this.name_folded()
                            this.report1_at(ParserMessages.lpdSubsetDeclaration(), spell_s, ps.current_input().token_start_location())
                        }
                        else
                            set result: this.parse_shortref_decl(mdo_loc)
                    }
                    else if decl_name = R_USEMAP
                    {
                        if in_lpd
                        {
                            let spell_u this.name_folded()
                            this.report1_at(ParserMessages.lpdSubsetDeclaration(), spell_u, ps.current_input().token_start_location())
                        }
                        else
                            set result: this.parse_usemap_decl()
                    }
                    else if decl_name = R_LINK
                    {
                        if in_lpd
                            set result: this.parse_link_decl()
                        else
                        {
                            let spell_l this.name_folded()
                            this.report1_at(ParserMessages.dtdSubsetDeclaration(), spell_l, ps.current_input().token_start_location())
                        }
                    }
                    else if decl_name = R_IDLINK
                    {
                        if in_lpd
                            set result: this.parse_idlink_decl()
                        else
                        {
                            let spell_i this.name_folded()
                            this.report1_at(ParserMessages.dtdSubsetDeclaration(), spell_i, ps.current_input().token_start_location())
                        }
                    }
                    else
                    {
                        ; doDtdSubset (parseDecl.cxx:368): a declaration reserved
                        ; name not allowed in this subset -> dtdSubsetDeclaration
                        ; / lpdSubsetDeclaration; any other recognized reserved
                        ; name -> noSuchDeclarationType.
                        let spell this.name_folded()
                        let dloc ps.current_input().token_start_location()
                        if this.dtd_subset_declaration_not_allowed(decl_name)
                        {
                            if in_lpd
                                this.report1_at(ParserMessages.lpdSubsetDeclaration(), spell, dloc)
                            else
                                this.report1_at(ParserMessages.dtdSubsetDeclaration(), spell, dloc)
                        }
                        else
                            this.report1_at(ParserMessages.noSuchDeclarationType(), spell, dloc)
                        set result: false
                    }
                    if result = false
                        this.decl_subset_recover(start_level)
                }
                else
                    this.decl_subset_recover(start_level)
            }
            else if token = tokenS
            {
                ; whitespace between declarations: skip
            }
            else if token = tokenMdoMdc
            {
                ; empty comment declaration (parseDecl.cxx:3577): warns under
                ; -wempty-comment-decl.
                let opt_ec ps.get_options()
                if opt_ec.warn_empty_comment_decl
                    this.report0_at(ParserMessages.emptyCommentDecl(), ps.current_input().token_start_location())
            }
            else if token = tokenMdoDso
            {
                ; doDeclSubset case tokenMdoDso: a marked section declaration
                ; (`<![ status [`). The ParserState marked-section machine already
                ; handles the dsMode<->dsiMode switching (startMarkedSection).
                if this.parse_marked_section_decl_start() = false
                    this.decl_subset_recover(start_level)
            }
            else if token = tokenMscMdc
            {
                ; doDeclSubset case tokenMscMdc: a `]]>` closing the innermost
                ; open marked section (endMarkedSection restores dsMode).
                this.handle_marked_section_end()
            }
            else if token = tokenIgnoredChar
            {
                ; a char inside an IGNORE marked section (imsMode) — no event
                ; wanted for ESIS; skip.
            }
            else if (token = tokenRe) or (token = tokenRs) or (token = tokenCroNameStart) or (token = tokenCroDigit) or (token = tokenHcroHexDigit) or (token = tokenEroNameStart) or (token = tokenEroGrpo) or (token = tokenChar)
            {
                ; doDeclSubset: these occur only inside a CDATA or RCDATA marked
                ; section (cmsMode/rcmsMode) — data is not allowed in a
                ; declaration subset. One message at the first data token, then
                ; recover to the section's `]]>`.
                let dloc ps.current_input().token_start_location()
                this.report0_at(ParserMessages.dataMarkedSectionDeclSubset(), dloc)
                this.decl_subset_recover(start_level)
            }
            else if token = tokenPio
            {
                ; a processing instruction in the declaration subset (doDeclSubset
                ; case tokenPio) — e.g. an external DTD that opens with `<?xml?>`.
                if this.parse_processing_instruction() = false
                    this.decl_subset_recover(start_level)
            }
            else if (token = tokenPeroNameStart) or (token = tokenPeroGrpo)
            {
                ; doDeclSubset case tokenPeroNameStart: a parameter-entity reference
                ; BETWEEN declarations -> dsReference stacks it; its tokens (whole
                ; declarations) then flow into this same loop, and the tokenEe arm
                ; above pops it when exhausted. A name group in the reference
                ; (`%(`, CONCUR/LINK) is peroGrpoProlog (parseDecl.cxx:448) —
                ; the group still parses, and the reference is ignored.
                if token = tokenPeroGrpo
                    this.report0_at(ParserMessages.peroGrpoProlog(), ps.current_input().token_start_location())
                if this.parse_parameter_entity_reference(token = tokenPeroGrpo, PE_CTX_DS) = false
                    this.decl_subset_recover(start_level)
            }
            else
            {
                ; a stray character between declarations (doDeclSubset's
                ; tokenUnrecognized): if it is a non-SGML char (C0/DEL — sgmlChar
                ; in our scanner, so it reaches here) reportNonSgmlCharacter and
                ; break; otherwise declSubsetCharacter (the token spelling, quoted)
                ; — matching parseDecl.cxx:246. Then recover past it either way.
                let dc ps.current_input().current_char()
                let loc ps.current_input().token_start_location()
                if this.is_non_sgml_char(dc)
                    this.report_num_at(ParserMessages.nonSgmlCharacter(), dc as u64, loc)
                else
                {
                    ; currentToken() is the single unrecognized char (the scanner
                    ; leaves the token zero-length here, so build it from the char).
                    var cbuf u32[1]
                    set *(cbuf as pointer[u32]): dc
                    let tok StringC^host(cbuf as pointer[u32], 1)
                    this.report1_at(ParserMessages.declSubsetCharacter(), tok, loc)
                }
                this.decl_subset_recover(start_level)
            }
        }
        rc
    }

    ; declSubsetRecover(startLevel) — skip to the next declaration boundary.
    function decl_subset_recover(this: Parser, start_level: u32)
    {
        var running true
        while running
        {
            let token ps.get_token(ps.get_current_mode())
            if token = tokenEe
            {
                if ps.get_input_level() <= start_level
                    set running: false
                else
                    ps.pop_input_stack()
            }
            else if (token = tokenMdoCom) or (token = tokenDsc) or (token = tokenMdoNameStart) or (token = tokenMdoMdc) or (token = tokenMdoDso) or (token = tokenMscMdc) or (token = tokenPio)
            {
                if ps.get_input_level() = start_level
                {
                    ps.current_input().unget_token()
                    set running: false
                }
            }
            else if token = tokenUnrecognized
            {
                ; consume one char to make progress.
                var advc ps.current_input().token_char()
                ps.current_input().end_token(1)
            }
            else
            {
                ; other tokens already consumed; keep scanning.
            }
        }
    }

    ; skipDeclaration (parseInstance.cxx): after a markup declaration that is not
    ; allowed / not handled in the current context, consume tokens in mdMode until
    ; the closing MDC (`>`) at the starting input level, so parsing resumes cleanly
    ; on the token that follows the declaration. (The reference's proMode-scanning
    ; prologRecover converges on the same resume point for a well-formed but
    ; misplaced declaration, so the prolog reuses this.)
    function skip_declaration(this: Parser, start_level: u32)
    {
        var running true
        while running
        {
            let token ps.get_token(mdMode)
            if token = tokenUnrecognized
            {
                ; a stray char: consume one to make progress (getChar()).
                var advc ps.current_input().token_char()
                ps.current_input().end_token(1)
            }
            else if token = tokenEe
            {
                if ps.get_input_level() <= start_level
                    set running: false
                else
                    ps.pop_input_stack()
            }
            else if token = tokenMdc
            {
                if ps.get_input_level() = start_level
                    set running: false
            }
            ; else: an ordinary declaration token, already consumed — keep scanning.
        }
    }

    ; compileModes' ambiguity reporting (parseMode.cxx:396): each pair the
    ; TrieBuilder collected is one lexicalAmbiguity, both tokens rendered
    ; through the mode's token table (TokenMessageArg). The SD-mode compile
    ; (install_sd_recognizers) is skipped: it always runs on the fixed
    ; reference syntax, which is unambiguous.
    function report_mode_ambiguities(this: Parser, amb: ref[Array[u32]], mode: int)
    {
        let n amb.get_length()
        if n < 2
            return
        if ps.current_input() = null
            return
        var j: size_t 0
        while (j + 1) < n
        {
            let t1 amb[j]
            let t2 amb[(j + 1)]
            let a1 this.token_message_arg(t1, mode)
            let a2 this.token_message_arg(t2, mode)
            this.report_raw_raw_at(ParserMessages.lexicalAmbiguity(), a1, a2, ps.current_input().token_start_location())
            set j: j + 2
        }
    }

    ; dataDelimCodes (parseMode.cxx:263): under -wdata-delim the FIRST chars of
    ; every mconMode delimiter (except the MSC-MDC pair) become tokenCharDelim
    ; candidates. Null when the option is off.
    function data_delim_chars(this: Parser, table: ref[Array[PackedTokenInfo]], sdv: Sd, synv: Syntax) returns ref[ISet]?
    {
        let opt_dd ps.get_options()
        if opt_dd.warn_data_delim = false
            return null
        let dd ISet^host()
        let mi ModeInfo^host(mconMode, sdv, table)
        var t TokenInfo()
        while mi.next_token(&t)
        {
            if (t.kind = TT_DELIM) or (t.kind = TT_DELIMDELIM) or (t.kind = TT_DELIMSET)
            {
                if t.token <> tokenMscMdc
                {
                    if synv.delim_general_len(t.delim1) > 0
                        dd.add(synv.delim_general_char(t.delim1, 0))
                }
            }
        }
        dd
    }

    ; Parser::compileNormalMap (parseMode.cxx:406) — the map `extend_data`
    ; scans. 1 = this character cannot BEGIN any token in mconnetMode, so a
    ; data run may swallow it without consulting the recognizer; 0 = the run
    ; ends here. Built once per instance, right after the instance recognizers,
    ; because it depends on the syntax AND on the current DTD's short
    ; references.
    ;
    ; ★The reference clears the case variants of every stop character through
    ; `generalSubstTable()->inverse(c)`. This port has no inverse table, so the
    ; equivalent set is computed FORWARD once at setup: a character whose fold
    ; lands on a stop character is itself a stop. Same set, one 64 K sweep at
    ; parse start instead of a table.
    ;
    ; ★★REGRESSION 2026-08-05, worth the paragraph because the shape recurs:
    ; this function shipped complete — shortref loop included — but was only ever
    ; CALLED from install_recognizers with `dtd` null, and nothing called it for
    ; the instance. The shortref stops were therefore never in the map, a data run
    ; swallowed `+` or `--`, and seven corpus entries lost their short references
    ; SILENTLY (the delimiter arrives as data, which is valid output). Delimiters
    ; whose first char is RS/RE kept working, because a function char is already a
    ; stop for other reasons — so the breakage looked like a partial feature gap
    ; rather than a missing call. ★The lesson: a `dtd` parameter that every call
    ; site passes null is not a parameter, it is dead code with a plausible name;
    ; grep the CALL SITES of anything that takes the current DTD.
    function compile_normal_map(this: Parser, table: ref[Array[PackedTokenInfo]], sdv: Sd, synv: Syntax, dtd: ref[Dtd]?)
    {
        let map XcharMap.make(host, 0)
        let sc synv.char_set(setSgmlChar)
        let ns sc.get_count()
        var i: size_t 0
        while i < ns
        {
            map.set_range(sc.range_min(i), sc.range_max(i), 1)
            set i: i + 1
        }
        let stops ISet^host()
        let mi ModeInfo^host(mconnetMode, sdv, table)
        var t TokenInfo()
        while mi.next_token(&t)
        {
            if (t.kind = TT_DELIM) or (t.kind = TT_DELIMDELIM) or (t.kind = TT_DELIMSET)
            {
                if synv.delim_general_len(t.delim1) > 0
                    stops.add(synv.delim_general_char(t.delim1, 0))
            }
            if t.kind = TT_SET
            {
                if t.token <> tokenChar
                {
                    let st synv.char_set(t.set_idx)
                    let nst st.get_count()
                    var k: size_t 0
                    while k < nst
                    {
                        stops.add_range(st.range_min(k), st.range_max(k))
                        set k: k + 1
                    }
                }
            }
            if t.kind = TT_FUNCTION
            {
                if t.token <> tokenChar
                    stops.add(synv.standard_function(t.func_idx))
            }
        }
        ; the short references of the CURRENT dtd: a B-initial delimiter stops
        ; the run on the whole blank set, any other on its first character.
        if dtd <> null
        {
            let nsr dtd.n_shortref()
            var r: size_t 0
            while r < nsr
            {
                let str dtd.shortref(r)
                if str.get_size() > 0
                {
                    let c0 str.get(0)
                    if c0 = sdv.exec_to_internal(66)
                    {
                        let bl synv.char_set(setBlank)
                        let nbl bl.get_count()
                        var k: size_t 0
                        while k < nbl
                        {
                            stops.add_range(bl.range_min(k), bl.range_max(k))
                            set k: k + 1
                        }
                    }
                    else
                        stops.add(c0)
                }
                set r: r + 1
            }
        }
        ; the stop characters themselves, by RANGE — the sweep below must not
        ; pay a set lookup for each of 64 K characters (measured: 5 M
        ; instructions per parse, +13 % on a 25 K document).
        let nstops stops.get_count()
        var q: size_t 0
        while q < nstops
        {
            map.set_range(stops.range_min(q), stops.range_max(q), 0)
            set q: q + 1
        }
        ; ...and their case variants. Only a character whose fold MOVES it can
        ; be one, which is a handful in any real syntax, so the set lookup runs
        ; only for those.
        var c: u32 0
        let hi XCHARMAP_HI as u32
        while c <= hi
        {
            let f synv.fold(c)
            if f <> c
            {
                if stops.contains(f)
                    map.set_char(c, 0)
            }
            set c: c + (1 as u32)
        }
        ps.set_normal_map(map)
    }

    ; ---- mode setup: install the recognizers the decl parser drives -------
    function install_recognizers(this: Parser, table: ref[Array[PackedTokenInfo]])
    {
        let sdv *ps.get_sd()
        let synv *ps.get_syntax()
        let ddch this.data_delim_chars(table, sdv, synv)
        var modes int[28]
        let mp modes as pointer[int]
        set *(mp + 0): dsMode
        set *(mp + 1): dsiMode
        set *(mp + 2): mdMode
        set *(mp + 3): mdMinusMode
        set *(mp + 4): mdPeroMode
        set *(mp + 5): grpMode
        set *(mp + 6): grpsufMode
        set *(mp + 7): plitMode
        set *(mp + 8): plitaMode
        set *(mp + 9): slitMode
        set *(mp + 10): slitaMode
        set *(mp + 11): mlitMode
        set *(mp + 12): mlitaMode
        set *(mp + 13): proMode
        set *(mp + 14): comMode
        set *(mp + 15): refMode
        ; Attribute-value-literal modes (modeUsedInProlog | modeUsedInInstance in
        ; the reference): an ATTLIST default value literal (`x CDATA "y"`) is a
        ; literal parsed DURING the declaration subset, so these must be present
        ; here, not only in the content-mode set. Without them parse_literal reads
        ; a null-recognizer tokenEe and the whole ATTLIST is dropped.
        set *(mp + 16): alitMode
        set *(mp + 17): alitaMode
        set *(mp + 18): aliteMode
        set *(mp + 19): talitMode
        set *(mp + 20): talitaMode
        set *(mp + 21): taliteMode
        ; piMode: a processing instruction (`<?...?>`) can appear in the prolog and
        ; in a declaration subset; parse_processing_instruction reads it in piMode.
        set *(mp + 22): piMode
        ; pliteMode: the `e` variant of the parameter-literal mode — parse_literal
        ; switches to it while an entity reference is open inside a param literal.
        set *(mp + 23): pliteMode
        ; Marked-section content modes: a marked section can open inside a
        ; declaration subset (doDeclSubset tokenMdoDso), so the IGNORE/CDATA/
        ; RCDATA scan modes must be installed for the prolog too, not only for
        ; the instance (same null-recognizer trap as piMode above: without them
        ; get_token yields tokenEe and the subset is silently abandoned).
        set *(mp + 24): imsMode
        set *(mp + 25): cmsMode
        set *(mp + 26): rcmsMode
        ; asMode is a PROLOG mode in the reference (parseMode.cxx:62): link
        ; rules parse DSO-delimited attribute specs inside LPD subsets (same
        ; null-recognizer trap as piMode without it).
        set *(mp + 27): asMode
        var i: int 0
        while i < 28
        {
            let m *(mp + (i as size_t))
            var amb Array[u32]^host()
            let r Recognizer.build_recognizer_sr(host, m, sdv, synv, table, null, amb, ddch)
            ps.set_recognizer(m, r)
            this.report_mode_ambiguities(amb, m)
            set i: i + 1
        }
        ; NO normal map here. `extend_data` — its only reader — runs from
        ; parse_pcdata, which only the CONTENT dispatch loop calls, so the map the
        ; instance compiles (install_content_recognizers, against the current DTD)
        ; is the only one that is ever read. The reference agrees: its single
        ; compileNormalMap() call sits in compileInstanceModes, not in the prolog.
        ; Compiling one here too was both dead and misleading — it is what hid the
        ; missing shortref stops behind a map that looked built.
    }

    ; ======================================================================
    ; Instance / content parsing (parseInstance.cxx doContent).
    ;
    ; The token-dispatch loop that walks instance content, drives the
    ; ContentState transition automaton and appends StartElement/EndElement/
    ; characterData events in document order.
    ;
    ; This block used to carry a Stage-4 "DEFERRED to later increments" list.
    ; Every item on it has since landed and the list was measured stale on
    ; 2026-08-01 — do not reinstate it: tag minimization (SHORTTAG, NET, ranked
    ; elements, group tags), attribute-spec parsing (parse_attribute_spec,
    ; handle_attribute_name_token, recover_unquoted, data attributes),
    ; entity/character references, PIs, comments, marked sections,
    ; handle_shortref, CDATA/RCDATA, check_idrefs and the RS/RE record-boundary
    ; semantics are all here.
    ;
    ; OMITTAG minimization is the tryImplyTag imply loop, and its speculative
    ; rollback IS ported: see UndoEntry/undo_all above and the three rollback
    ; sites accept_start_tag / accept_pcdata / handle_bad_start_tag. The
    ; speculation itself runs on conforming OMITTAG documents; only the ROLLBACK
    ; needs an invalid one, which is what corpus/synth-omittag-undo{1,2,3} pin.
    ; The one unported undoList site is getAllowedElementTypes
    ; (parseInstance.cxx:1353) — dead code in the reference, no caller anywhere.

    ; must this element's end tag be omitted (EMPTY content)? CONREF check
    ; deferred (needs the attribute list on the event).
    function must_omit_end(this: Parser, e: ref[ElementType]) returns bool
    {
        let def e.get_definition()
        if def = null
            return false
        def.get_declared_content() = DC_EMPTY
    }

    ; ---- attribute-spec parsing (parseAttribute.cxx) ---------------------
    ; The quoted/unquoted attribute-value path. Its old "DEFERRED" list was
    ; measured stale on 2026-08-01 and removed: SHORTTAG name-token minimization
    ; (handle_attribute_name_token), the data-attribute / new_att_def branch,
    ; recover_unquoted, piPasMode (ModeInfo.scaly), markup capture
    ; (ParserState.note_markup) and the value validation
    ; (AttributeList.set_value + Parser.check_value_semantics) are all ported.

    ; maxLength of an attribute value literal (parseAttribute.cxx:391):
    ; LITLEN less NORMSEP, clamped at zero.
    function attribute_value_max_length(this: Parser) returns size_t
    {
        let syn ps.get_syntax()
        let litlen syn.get_quantity(qLITLEN) as size_t
        let normsep syn.get_quantity(qNORMSEP) as size_t
        if litlen > normsep
            return litlen - normsep
        0 as size_t
    }

    ; the NORMSEP > LITLEN edge (parseAttribute.cxx:402): an EMPTY value still
    ; exceeds the (negative) limit — report with the shortfall as argument.
    function report_attribute_value_length_neg(this: Parser, text: ref[Text], neg_mt: MessageType)
    {
        if text.size() <> 0
            return
        let syn ps.get_syntax()
        let litlen syn.get_quantity(qLITLEN) as size_t
        let normsep syn.get_quantity(qNORMSEP) as size_t
        if normsep > litlen
            this.report_num_at(neg_mt, (normsep - litlen) as u64, ps.current_input().token_start_location())
    }

    function parse_attribute_value_literal(this: Parser, lita: bool, out_text: ref[Text]) returns bool
    {
        var m alitMode
        if lita
            set m: alitaMode
        let maxlen this.attribute_value_max_length()
        if this.parse_literal(m, false, false, maxlen, ParserMessages.attributeValueLength(), out_text) = false
            return false
        this.report_attribute_value_length_neg(out_text, ParserMessages.attributeValueLengthNeg())
        true
    }

    function parse_tokenized_attribute_value_literal(this: Parser, lita: bool, out_text: ref[Text]) returns bool
    {
        var m talitMode
        if lita
            set m: talitaMode
        let maxlen this.attribute_value_max_length()
        if this.parse_literal(m, true, false, maxlen, ParserMessages.tokenizedAttributeValueLength(), out_text) = false
            return false
        this.report_attribute_value_length_neg(out_text, ParserMessages.tokenizedAttributeValueLengthNeg())
        true
    }

    ; extendUnquotedAttributeValue (parseAttribute.cxx:373): grow the current
    ; token to the next S / non-SGML char / entity end / first TAGC char.
    function extend_unquoted_attribute_value(this: Parser)
    {
        let ins ps.current_input()
        var length ins.current_token_length()
        let syn ps.get_syntax()
        let tagc syn.delim_general_char(dTAGC, 0)
        let sset syn.char_set(setS)
        var scanning true
        while scanning
        {
            let c ins.token_char()
            if c < 0
                set scanning: false
            else
            {
                let is_s sset.contains(c as u32)
                let is_non_sgml this.is_non_sgml_char(c as u32)
                if (is_s or is_non_sgml) or ((c as u32) = tagc)
                    set scanning: false
                else
                    set length: length + 1
            }
        }
        ins.end_token(length)
    }

    ; copy the current token into `text` as an attribute value with linear
    ; per-char locations. The copy pins the run page: current_token_string's
    ; buffer is transient, and a CDATA value is stored verbatim (no fold-copy
    ; in set_value), so it would dangle and read as later token bytes.
    function copy_unquoted_value(this: Parser, text: ref[Text])
    {
        let ins ps.current_input()
        let ts ins.current_token_string()
        let tn ts.get_size()
        let tstart ins.current_token_start_index()
        let tlb host.allocate(tn * sizeof Location, alignof Location) as pointer[Location]
        let torg ins.get_origin()
        var tli: size_t 0
        while tli < tn
        {
            set *(tlb + tli): Location(torg, (tstart + tli) as u32)
            set tli: tli + 1
        }
        set text: Text(StringC^host(ts.data_ptr(), ts.get_size()), tlb)
    }

    ; parseAttributeParameter — read the next attribute-spec token, classify it,
    ; and skip separators. allow_vi permits a value-indicator (`=`).
    function parse_attribute_parameter(this: Parser, mode: int, allow_vi: bool, result: ref[int], net: ref[bool]) returns bool
    {
        var token ps.get_token(mode)
        while token = tokenS
            set token: ps.get_token(mode)
        if token = tokenEe
        {
            ; attributeSpecEntityEnd (parseAttribute.cxx): entity end outside
            ; an attribute value literal.
            this.report0_at(ParserMessages.attributeSpecEntityEnd(), ps.current_input().token_start_location())
            return false
        }
        else if (token = tokenEtago) or (token = tokenStago)
        {
            ; unclosedStartTagShorttag (parseAttribute.cxx:304): a STAGO/ETAGO
            ; inside the spec ends the tag; legal only under SHORTTAG STARTTAG
            ; UNCLOSED YES (message only — the tag still ends here).
            if ps.get_sd().start_tag_unclosed() = false
                this.report0_at(ParserMessages.unclosedStartTagShorttag(), ps.current_input().token_start_location())
            let ins ps.current_input()
            ins.unget_token()
            set net: false
            set result: APT_END
        }
        else if token = tokenNestc
        {
            ; NESTC (`/`) closes a net-enabling start tag. Under NETENABL IMMEDNET
            ; the NET (`>`) must immediately follow (`/>`): peek it and unget so
            ; do_content sees the tokenNet that closes the element. NETENABL ALL
            ; net-enables with no immediate requirement; NETENABL NO requires
            ; SHORTTAG YES (netEnablingStartTagShorttag, message only).
            let ne ps.get_sd().start_tag_net_enable()
            if ne = NET_ENABLE_NO
                this.report0_at(ParserMessages.netEnablingStartTagShorttag(), ps.current_input().token_start_location())
            else if ne = NET_ENABLE_IMMEDNET
            {
                ; nestcWithoutNet: the NET must immediately follow the NESTC.
                if ps.get_token(econnetMode) <> tokenNet
                    this.report0_at(ParserMessages.nestcWithoutNet(), ps.current_input().token_start_location())
                ps.current_input().unget_token()
            }
            set net: true
            set result: APT_END
        }
        else if token = tokenTagc
        {
            set net: false
            set result: APT_END
        }
        else if token = tokenDsc
            set result: APT_END
        else if token = tokenNameStart
        {
            this.extend_name_token(this.namelen(), ParserMessages.nameTokenLength())
            set result: APT_NAME
        }
        else if (token = tokenDigit) or (token = tokenLcUcNmchar)
        {
            this.extend_name_token(this.namelen(), ParserMessages.nameTokenLength())
            set result: APT_NAMETOKEN
        }
        else if (token = tokenLit) or (token = tokenLita)
        {
            ; a literal can only follow a VI (parseAttribute.cxx:~140).
            if allow_vi
                this.report0_at(ParserMessages.attributeSpecLiteral(), ps.current_input().token_start_location())
            else
                this.report0_at(ParserMessages.attributeSpecNameTokenExpected(), ps.current_input().token_start_location())
            return false
        }
        else if token = tokenVi
        {
            if allow_vi = false
            {
                this.report0_at(ParserMessages.attributeSpecNameTokenExpected(), ps.current_input().token_start_location())
                return false
            }
            set result: APT_VI
        }
        else
        {
            ; tokenUnrecognized (parseAttribute.cxx:289): a genuine non-SGML
            ; character is reported and aborts the spec; any other character is
            ; recovered as an unquoted-value chunk — extended to the next
            ; S / non-SGML / TAGC — for AttributeList::recoverUnquoted.
            if this.report_non_sgml_param()
                return false
            this.extend_unquoted_attribute_value()
            set result: APT_RECOVER_UNQUOTED
        }
        true
    }

    ; parseAttributeValueSpec — after a VI, resolve the attribute and read its
    ; value (quoted literal, or an unquoted name token via SHORTTAG).
    ; `new_att_def` is the reference's `Ptr<AttributeDefinitionList> &newAttDef`:
    ; null until an undeclared attribute forces a private, grown copy of the
    ; element's definition list. It is threaded through the whole start tag (all
    ; its undeclared attributes append to the same copy) and installed on the
    ; element type by do_parse_start_tag.
    function parse_attribute_value_spec(this: Parser, mode: int, name: StringC, atts: ref[AttributeList], spec_length: pointer[size_t], new_att_def: pointer[pointer[AttributeDefinitionList]]) returns bool
    {
        var token ps.get_token(mode)
        while token = tokenS
            set token: ps.get_token(mode)
        let idx atts.attribute_index(name)
        var index: size_t 0
        if idx < 0
        {
            ; An attribute no ATTLIST declares. Under IMPLYDEF ATTLIST (which
            ; enableImplydef turns on for a document with no DOCTYPE) it is not an
            ; error: it gets an implied CDATA definition appended to a COPY of the
            ; element's definition list. Because the copy is installed on the
            ; element type afterwards, a LATER occurrence of the same element finds
            ; the attribute declared — and if that occurrence omits it, ESIS reports
            ; `A <name> IMPLIED`, exactly as onsgmls does.
            if *new_att_def = null
            {
                let cur atts.get_def()
                set *new_att_def: AttributeDefinitionList.copy(host, cur)
            }
            var new_def: ref[AttributeDefinition]? null
            if ps.is_in_instance() = false
            {
                ; a DATA attribute spec in the prolog (parseAttribute.cxx:150):
                ; find the notation owning this definition list; if it is still
                ; UNDEFINED, its #IMPLICIT common definitions apply (specified-
                ; implicit); the #ALL common definitions apply to any notation.
                ; (The reference ASSERTs a notation is found — an LPD link-rule
                ; spec reaching here has none and real onsgmls 1.5.2 crashes;
                ; the port falls through to the implied-definition arm.)
                let dtd0 ps.get_def_dtd()
                var owner: ref[Notation]? null
                if dtd0 <> null
                {
                    let atts_def atts.get_def()
                    let nnot dtd0.n_notations()
                    var oi: size_t 0
                    while oi < nnot
                    {
                        let cand dtd0.notation_at(oi)
                        var hit false
                        if cand <> null
                        {
                            if cand.get_attribute_def() = atts_def
                                set hit: true
                        }
                        if hit
                        {
                            set owner: cand
                            set oi: nnot
                        }
                        else
                            set oi: oi + 1
                    }
                }
                var owner_undefined false
                if owner <> null
                {
                    if owner.is_defined() = false
                        set owner_undefined: true
                }
                if owner_undefined
                {
                    let rni_implicit this.rni_reserved_name(R_IMPLICIT)
                    let int0 this.lookup_create_notation(rni_implicit)
                    let common0 int0.get_attribute_def()
                    if common0 <> null
                    {
                        let ci0 common0.attribute_index(name)
                        if ci0 >= 0
                        {
                            let cd0 common0.def(ci0 as size_t)
                            set new_def: (*cd0).copy(host)
                            new_def.set_specified(true)
                        }
                    }
                }
                if (new_def = null) and (owner <> null)
                {
                    let rni_all this.rni_reserved_name(R_ALL)
                    let ant0 this.lookup_create_notation(rni_all)
                    let common1 ant0.get_attribute_def()
                    if common1 <> null
                    {
                        let ci1 common1.attribute_index(name)
                        if ci1 >= 0
                        {
                            let cd1 common1.def(ci1 as size_t)
                            set new_def: (*cd1).copy(host)
                            new_def.set_specified(false)
                        }
                    }
                }
            }
            if new_def = null
            {
                if ps.get_implydef_attlist() = false
                {
                    ; noSuchAttribute (parseAttribute.cxx:182): the element has no
                    ; such attribute. Reported, but onsgmls STILL appends an implied
                    ; CDATA definition and processes the value (ESIS shows
                    ; `A<name> CDATA …`), so do NOT bail.
                    let loc ps.current_input().token_start_location()
                    this.report1_at(ParserMessages.noSuchAttribute(), name, loc)
                }
                let cdv DeclaredValue.make_cdata(host)
                set new_def: AttributeDefinition.make_implied(host, name, cdv)
            }
            let nad *new_att_def
            nad.append(new_def)
            let atts_host Page.get(atts as pointer[void])
            atts.change_def(atts_host, nad)
            set index: atts.size() - 1
        }
        else
            set index: idx as size_t
        let ctx ps.get_attribute_context()
        ; duplicateAttributeSpec (Attribute.cxx:1274): this attribute was already
        ; specified in this start tag. Reported (arg = attr name, quoted; location =
        ; the value-token start); onsgmls still overwrites with the new value.
        if atts.specified(index)
        {
            let dloc ps.current_input().token_start_location()
            this.report1_at(ParserMessages.duplicateAttributeSpec(), name, dloc)
        }
        atts.set_spec(index, ctx)
        ; The value's Text lands on the page of its own attribute LIST, and
        ; parse_literal below derives ITS buffers from this Text (Page.get) —
        ; so the whole value, including the per-char location spur, follows the
        ; list onto the drainable attribute scratch.
        let atts_text_host Page.get(atts as pointer[void])
        let text atts_text_host.allocate(sizeof Text, alignof Text) as pointer[Text]
        set *text: Text(StringC())
        var ok true
        if (token = tokenLit) or (token = tokenLita)
        {
            let lita token = tokenLita
            ; literalDelimInfo (parseAttribute.cxx / parseCommon.cxx:79): with
            ; markup capture on, the literal's opening delimiter becomes the
            ; Text's FIRST item — handleAsUnterminated then anchors at the
            ; QUOTE, not the first char (probed: -otagomit shifts the
            ; reference's column by one). Start-tag specs (tagMode) capture
            ; under instance markup = -otagomit; declaration specs (asMode)
            ; under prolog markup = -ocomment.
            let lit_open ps.current_input().token_start_location()
            if atts.tokenized(index)
                set ok: this.parse_tokenized_attribute_value_literal(lita, text)
            else
                set ok: this.parse_attribute_value_literal(lita, text)
            if ok
            {
                var delim_info false
                if mode = tagMode
                    set delim_info: ps.output_flag(OF_TAG_OMISSION)
                else
                    set delim_info: ps.output_flag(OF_COMMENT)
                if delim_info
                    text.set_delim_loc(lit_open)
            }
        }
        else if (token = tokenNameStart) or (token = tokenDigit) or (token = tokenLcUcNmchar)
        {
            ; unquoted (SHORTTAG) value — legal only under SHORTTAG ATTRIB
            ; VALUE YES (parseAttribute.cxx:221; message at the value's first
            ; char, the un-extended token start, verified 5:7 on `v=xy`);
            ; otherwise it warns under -watt-value-not-literal.
            if ps.get_sd().attribute_value_not_literal() = false
                this.report0_at(ParserMessages.attributeValueShorttag(), ps.current_input().token_start_location())
            else
            {
                let opt_av ps.get_options()
                if opt_av.warn_attribute_value_not_literal
                    this.report0_at(ParserMessages.attributeValueNotLiteral(), ps.current_input().token_start_location())
            }
            this.extend_name_token(this.attribute_value_max_length(), ParserMessages.attributeValueLength())
            this.copy_unquoted_value(text)
        }
        else if (token = tokenUnrecognized) or (token = tokenEtago) or (token = tokenStago) or (token = tokenNestc)
        {
            ; unquotedAttributeValue (parseAttribute.cxx:~200): recovered as an
            ; unquoted value running to the next separator/TAGC.
            this.report0_at(ParserMessages.unquotedAttributeValue(), ps.current_input().token_start_location())
            this.extend_unquoted_attribute_value()
            this.copy_unquoted_value(text)
        }
        else if token = tokenEe
        {
            this.report0_at(ParserMessages.attributeSpecEntityEnd(), ps.current_input().token_start_location())
            return false
        }
        else if (token = tokenTagc) or (token = tokenDsc) or (token = tokenVi)
        {
            ; attributeValueExpected: the VI was not followed by a value.
            this.report0_at(ParserMessages.attributeValueExpected(), ps.current_input().token_start_location())
            return false
        }
        else
        {
            ; no other token is possible here (the reference's CANNOT_HAPPEN).
            return false
        }
        if ok = false
            return false
        ; set_value folds the value in place; the makeValue validation half
        ; (validate_attribute_value: categories / lengths / group membership)
        ; then runs on the folded text and accumulates the NORMALIZED length
        ; into spec_length (the reference's specLength += normalizedLength),
        ; and the makeSemantics half follows — the reference's message order.
        ; The value lands on the page of its own LIST, not on the run page: an
        ; instance list sits on the drainable attribute scratch
        ; (ParserState.attribute_host), a declaration list on the run page, and
        ; a value must not outlive — or under-live — the list that owns it.
        ; This is where the bytes are: the fold buffer is 4 bytes per character
        ; and the per-char location array 16, so an attribute value costs ~20x
        ; its text (measured 2026-08-02: ~450 MB of a 507 MB document body).
        let atts_host Page.get(atts as pointer[void])
        let sv_ok atts.set_value(atts_host, index, text, ctx)
        this.validate_attribute_value(atts.declared_value(index), text, name, spec_length)
        ; checkValue wraps makeValue (Attribute.h:637): notFixedValue /
        ; noteCurrentAttribute fire after the validation messages, before the
        ; makeSemantics ones.
        this.check_attribute_value(atts, index)
        this.check_value_semantics(atts, index, text)
        sv_ok
    }

    ; ParserState::lookupEntity's default-entity consult (ParserState.cxx:529):
    ; an undefined GENERAL entity resolves to a COPY of the DTD's default
    ; entity, renamed after the referenced name — cached per name in the
    ; instance (instanceDefaultedEntityTable_), inserted into the DTD itself in
    ; the prolog (which is what a later real declaration trips over —
    ; defaultedEntityDefined). The EntityDefaultedEvent is emitted always (the
    ; ESIS writer gates it on -oentity, the grove builder reads it). The option-off
    ; warnDefaultEntityReference warning at the use site stays with the -w block.
    function lookup_entity_or_default(this: Parser, is_parameter: bool, name: StringC) returns ref[Entity]?
    {
        let found ps.lookup_entity_pass_aware(is_parameter, name)
        if found <> null
            return found
        if is_parameter
            return null
        ; NULLABLE here even though the accessor never answers null: the
        ; result-attribute branch below clears it and re-derives it from the
        ; def LPD, and the `dtd = null` test after the branch is the reader.
        var dtd: ref[Dtd]? ps.get_current_dtd()
        if ps.in_result_attribute_spec_mode()
        {
            set dtd: null
            let dl ps.get_def_lpd()
            if dl <> null
                set dtd: dl.get_result_dtd()
        }
        if dtd = null
            return null
        let dflt ps.default_entity_pass_aware(dtd)
        if dflt = null
            return null
        if ps.is_in_instance()
        {
            let cached ps.lookup_instance_defaulted(name)
            if cached <> null
                return cached
        }
        let copy (*dflt).copy_with_name(host, name)
        this.generate_system_id(copy, false)
        ps.note_defaulted_entity(copy)
        if ps.is_in_instance()
        {
            ps.add_instance_defaulted(copy)
            ; ParserState.cxx:560: the freshly-copied instance default fires
            ; EntityDefaultedEvent (the -oentity `I<name> …` at first use; a
            ; cache hit above does NOT re-fire — probed: `&bar; &bar;` = one I).
            ; Unconditional like the reference: the ESIS writer gates on
            ; -oentity itself, and the grove's defaulted-entity table is fed
            ; from this event (see ParserState.lookup_entity_pass_aware).
            ps.queue_event(Event.make_entity_defaulted(ps.event_host(), copy, Location()))
        }
        else
            dtd.insert_entity(copy, false, false)
        copy
    }

    ; ParserState::getAttributeEntity (ParserState.cxx:837) — lookupEntity
    ; (incl. the defaulted-copy consult above), routed through the pass-aware/
    ; result-mode resolver (LINK axis). A defaulted resolution warns under
    ; -wdefault at the attribute token's location (setNextLocation(loc)).
    function get_attribute_entity(this: Parser, name: StringC, loc: Location) returns ref[Entity]?
    {
        let ent this.lookup_entity_or_default(false, name)
        if ent <> null
        {
            if ps.entity_is_defaulted(ent)
            {
                let opt_da ps.get_options()
                if opt_da.warn_default_entity_reference
                    this.report1_at(ParserMessages.defaultEntityInAttribute(), name, loc)
            }
        }
        ent
    }

    ; ParserState::getAttributeNotation (ParserState.cxx:810) — currentDtd
    ; lookupNotation. The implydefNotation auto-create branch is unreachable
    ; (our Sd never sets IMPLYDEF NOTATION — constant, like implydef_doctype);
    ; the resultAttributeSpecMode arm is LINK-axis.
    function get_attribute_notation(this: Parser, name: StringC) returns ref[Notation]?
    {
        ; resultAttributeSpecMode (ParserState.cxx:828): result element specs
        ; resolve notations against the RESULT dtd.
        if ps.in_result_attribute_spec_mode()
        {
            let lpd ps.get_def_lpd()
            if lpd = null
                return null
            let rdtd lpd.get_result_dtd()
            if rdtd = null
                return null
            return rdtd.lookup_notation(name)
        }
        let dtd ps.get_current_dtd()
        dtd.lookup_notation(name)
    }

    ; Text::charLocation(i) for the makeValue message locations. i == size
    ; resolves to one past the last char (the reference's per-item run
    ; arithmetic yields the same for the trailing position); untracked text
    ; yields the null Location (defensive — every validated Text carries
    ; per-char locations).
    function text_char_location(this: Parser, text: ref[Text], i: size_t) returns Location
    {
        let locs text.get_locs()
        if locs = null
            return Location()
        let n text.size()
        if n = 0
            return Location()
        if i < n
            return *(locs + i)
        let last *(locs + (n - 1))
        Location(last.get_origin(), last.get_index() + (1 as u32))
    }

    ; The validation half of DeclaredValue::makeValue — reported from the
    ; parser (the check_value_semantics precedent). Runs over the FOLDED value
    ; Text (after AttributeList.set_value / the make_attribute_value fold) for
    ; BOTH instance values and DTD default/FIXED values (the reference calls
    ; makeValue from parseDefaultValue too).
    ;   CDATA/DATA (checkNormalizedLength, Attribute.cxx:90): the normalized
    ;   length (size + NORMSEP) accumulates into spec_length, with the LITLEN
    ;   overflow message.
    ;   tokenized (makeTokenizedValue, :189): per token, the declared value's
    ;   initial/subsequent character-category checks — attributeValueChar (a
    ;   char allowed nowhere), attributeValueNumberToken / attributeValueName
    ;   (a char that cannot START a number token / name) — validate-gated, at
    ;   the offending char; the NAMELEN check (nameTokenLength, NOT gated, at
    ;   the char just past the token). An empty value or one ending in a
    ;   space (only enterable via a numeric char ref — parse_literal collapses
    ;   plain spaces) reports attributeValueSyntax; a second token in a
    ;   non-list value reports attributeValueMultiple at the first space. The
    ;   normalized length (NORMSEP + size, list adjustment per token) then
    ;   accumulates with the LITLEN check.
    ;   group (GroupDeclaredValue::makeValue, :350): the whole folded value
    ;   must be one of the declared tokens — attributeValueNotInGroup
    ;   (validate-gated; %3 lists the group). NOTATION shares this (it IS a
    ;   GroupDeclaredValue); its unknown-notation check stays in
    ;   check_value_semantics (makeSemantics).
    ; Messages with no per-char anchor (syntax / normalized-length / group)
    ; report at the current parse location, like the reference's unlocated
    ; context.message.
    function validate_attribute_value(this: Parser, dv: ref[DeclaredValue]?, text: ref[Text], attribute_name: StringC, spec_length: pointer[size_t])
    {
        if dv = null
            return
        let syn ps.get_syntax()
        let normsep syn.get_quantity(qNORMSEP) as size_t
        let litlen syn.get_quantity(qLITLEN) as size_t
        let vn text.size()
        if dv.tokenized() = false
        {
            let cn vn + normsep
            set *spec_length: *spec_length + cn
            if litlen >= normsep
            {
                if vn <= litlen - normsep
                {
                    if cn > litlen
                        this.report_num_num_at(ParserMessages.normalizedAttributeValueLength(), litlen as u64, cn as u64, ps.current_input().token_start_location())
                }
            }
            return
        }
        let s text.string()
        let initial dv.get_initial_categories()
        let subsequent dv.get_subsequent_categories()
        let namelen_q syn.get_quantity(qNAMELEN) as size_t
        let space: u32 0x20
        let validate ps.validate()
        var nspaces: size_t 0
        var i: size_t 0
        var running true
        while running
        {
            if i >= vn
            {
                ; empty value, or one that ends with a space.
                if validate
                    this.report0_at(ParserMessages.attributeValueSyntax(), ps.current_input().token_start_location())
                set running: false
            }
            else
            {
                let start_index i
                if validate
                {
                    let c0 s.get(i)
                    if (syn.category_of(c0) & initial) = 0
                    {
                        let cs StringC^host(s.data_ptr() + i, 1)
                        let cloc this.text_char_location(text, i)
                        if (syn.category_of(c0) & subsequent) = 0
                            this.report2_at(ParserMessages.attributeValueChar(), *cs, attribute_name, cloc)
                        else if initial = CAT_DIGIT
                            this.report2_at(ParserMessages.attributeValueNumberToken(), *cs, attribute_name, cloc)
                        else
                            this.report2_at(ParserMessages.attributeValueName(), *cs, attribute_name, cloc)
                    }
                    else
                    {
                        set i: i + 1
                        var in_token true
                        while in_token
                        {
                            if i >= vn
                                set in_token: false
                            else if (syn.category_of(s.get(i)) & subsequent) = 0
                                set in_token: false
                            else
                                set i: i + 1
                        }
                        if i < vn
                        {
                            if s.get(i) <> space
                            {
                                ; this char is not allowed anywhere in the value
                                let cs2 StringC^host(s.data_ptr() + i, 1)
                                let cloc2 this.text_char_location(text, i)
                                this.report2_at(ParserMessages.attributeValueChar(), *cs2, attribute_name, cloc2)
                            }
                        }
                    }
                }
                var to_space true
                while to_space
                {
                    if i >= vn
                        set to_space: false
                    else if s.get(i) = space
                        set to_space: false
                    else
                        set i: i + 1
                }
                if i - start_index > namelen_q
                {
                    let nloc this.text_char_location(text, i)
                    this.report_num_at(ParserMessages.nameTokenLength(), namelen_q as u64, nloc)
                }
                if i = vn
                    set running: false
                else
                {
                    if dv.get_is_list() = false
                    {
                        if validate
                        {
                            if nspaces = 0
                            {
                                let mloc this.text_char_location(text, i)
                                this.report1_at(ParserMessages.attributeValueMultiple(), attribute_name, mloc)
                            }
                        }
                    }
                    set nspaces: nspaces + 1
                    set i: i + 1
                }
            }
        }
        var tn normsep + vn
        if dv.get_is_list()
        {
            set tn: tn + 1
            if normsep > 0
                set tn: tn + ((normsep - 1) * (nspaces + 1))
            else
                set tn: tn - (nspaces + 1)
        }
        set *spec_length: *spec_length + tn
        ; a length error will already have been given if vn > litlen - normsep.
        if litlen >= normsep
        {
            if vn <= litlen - normsep
            {
                if tn > litlen
                    this.report_num_num_at(ParserMessages.normalizedAttributeValueLength(), litlen as u64, tn as u64, ps.current_input().token_start_location())
            }
        }
        let allowed dv.get_tokens()
        if allowed <> null
        {
            if validate
            {
                if dv.contains_token(s) = false
                    this.report2_vec_at(ParserMessages.attributeValueNotInGroup(), s, attribute_name, allowed, ps.current_input().token_start_location())
            }
        }
    }

    ; The makeSemantics half of makeValue (Attribute.cxx) — reported from the
    ; parser (the duplicateAttributeSpec precedent).
    ;   ID/IDREF (IdDeclaredValue/IdrefDeclaredValue, :534/:556): an ID value
    ;   defines its id — a repeat reports duplicateId (E1, at the value token)
    ;   with the "ID %1 first defined here" auxiliary at the FIRST definition;
    ;   each IDREF token books a pending reference, resolved at document end
    ;   (check_idrefs -> missingId). define_id/note_idref gate themselves on
    ;   inInstance+validate, so DTD default/FIXED values never book anything.
    ;   ENTITY/ENTITIES (EntityDeclaredValue, :472): per token,
    ;   getAttributeEntity — unknown reports invalidEntityAttribute, a non-data
    ;   entity notDataOrSubdocEntity (both E1, validate-gated, at the token
    ;   start); the token count accumulates into nEntityNames (GRPCNT check in
    ;   finish); ALL tokens valid -> EntityAttributeSemantics on the Attribute,
    ;   any invalid -> NO semantics (the ESIS A-line then says TOKEN).
    ;   NOTATION (NotationDeclaredValue, :430): the WHOLE value is the name;
    ;   unknown reports invalidNotationAttribute (E1, validate-gated, at the
    ;   first token) and leaves no semantics.
    ; Values are single-space-normalized by parse_literal, so tokens split on
    ; one 0x20; token locations come from the value Text's per-char locations
    ; (verified vs real onsgmls: each message points at its token's first
    ; char, entity-expanded tokens resolving through the origin chain).
    ; nIdrefs/nEntityNames accumulate on the AttributeList; the GRPCNT checks
    ; run in the finish tail (check_missing_semantics).
    function check_value_semantics(this: Parser, atts: ref[AttributeList], index: size_t, text: ref[Text])
    {
        ; TokenizedAttributeValue::makeSemantics (Attribute.cxx:1077): an
        ; empty value has no semantics — no lookups, no messages, no counts.
        if text.size() = 0
            return
        let is_id atts.id(index)
        let is_idref atts.idref(index)
        let is_ent atts.entity(index)
        if atts.notation(index)
        {
            let s text.string()
            let nt this.get_attribute_notation(s)
            if nt = null
            {
                if ps.validate()
                {
                    let tloc0 text.loc_at(0)
                    let sc StringC^host(s.data_ptr(), s.get_size())
                    this.report1_at(ParserMessages.invalidNotationAttribute(), *sc, tloc0)
                }
                return
            }
            let a atts.attribute(index)
            let sem AttributeSemantics.make_notation(host, nt as pointer[void])
            a.set_semantics(sem)
            return
        }
        if (is_id = false) and (is_idref = false) and (is_ent = false)
            return
        let s text.string()
        let n s.get_size()
        var valid true
        var ntokens: u32 0
        let ents Array[pointer[void]]^host()
        var start: size_t 0
        while start < n
        {
            var e start
            var scanning true
            while scanning
            {
                if e >= n
                    set scanning: false
                else if s.get(e) = 0x20
                    set scanning: false
                else
                    set e: e + 1
            }
            let tok StringC^host(s.data_ptr() + start, e - start)
            let tloc text.loc_at(start)
            set ntokens: ntokens + (1 as u32)
            if is_id
            {
                var prev_loc Location()
                if ps.define_id(*tok, tloc, &prev_loc) = false
                    this.report1_aux(ParserMessages.duplicateId(), *tok, tloc, ParserMessages.duplicateId_aux(), prev_loc)
            }
            else if is_idref
            {
                ps.note_idref(*tok, tloc)
                ; IdrefDeclaredValue::makeSemantics (Attribute.cxx:564).
                atts.add_idrefs(1)
            }
            else
            {
                let ent this.get_attribute_entity(*tok, tloc)
                if ent = null
                {
                    if ps.validate()
                        this.report1_at(ParserMessages.invalidEntityAttribute(), *tok, tloc)
                    set valid: false
                }
                else if ent.is_data_or_subdoc() = false
                {
                    if ps.validate()
                        this.report1_at(ParserMessages.notDataOrSubdocEntity(), *tok, tloc)
                    set valid: false
                }
                else
                    ents.add(ent as pointer[void])
            }
            set start: e + 1
        }
        if is_ent
        {
            atts.add_entity_names(ntokens)
            if valid
            {
                let a atts.attribute(index)
                let sem AttributeSemantics.make_entity(host, &ents)
                a.set_semantics(sem)
            }
        }
    }

    ; AttributeDefinition::checkValue (Attribute.cxx:617) — the wrapper around
    ; makeValue for SPECIFIED values; two overrides exist:
    ;   CURRENT (:719) noteCurrentAttribute — remember the value so a later tag
    ;   omitting the attribute reuses it (ESIS-visible);
    ;   FIXED (:840) — compare against the declared default, notFixedValue
    ;   (E1, validate-gated) when they differ. The reference compares
    ;   Text::fixedEqual (string + entity-item structure) for CDATA and the
    ;   normalized strings for tokenized values; our Text carries no item
    ;   structure, so both arms compare the value strings (value and default
    ;   share one DeclaredValue, so their types always agree). Location:
    ;   unlocated context.message = current token START (the literal's closing
    ;   quote — same convention as the other makeValue messages, verified
    ;   5:11 on `<doc v="2.0">`).
    function check_attribute_value(this: Parser, atts: ref[AttributeList], index: size_t)
    {
        let d atts.definition(index)
        if d = null
            return
        if d.is_current()
        {
            let ctx ps.get_attribute_context()
            let v atts.value(index)
            ctx.note_current_attribute(d.get_current_index(), v)
        }
        if d.is_fixed()
        {
            if ps.validate()
            {
                let v atts.value(index)
                let fixed d.get_default_value()
                if (v <> null) and (fixed <> null)
                {
                    let vt v.get_text()
                    let ft fixed.get_text()
                    if (vt <> null) and (ft <> null)
                    {
                        let vs (*vt).string()
                        let fs (*ft).string()
                        if vs.equals(fs) = false
                            this.report1_at(ParserMessages.notFixedValue(), d.get_name(), ps.current_input().token_start_location())
                    }
                }
            }
        }
    }

    ; AttributeList::recoverUnquoted (Attribute.cxx:1338) + the AttributeValue
    ; overrides (TokenizedAttributeValue :289, CdataAttributeValue :1100): the
    ; junk after the last specified value is adopted when that value is a
    ; SINGLE contiguous data item ending exactly where the junk begins —
    ; CDATA appends the junk (unquotedAttributeValue E0 at the junk start),
    ; tokenized only reports (attributeValueChar E2: first junk char + attr
    ; name). Item test under our per-char-location Text: same-origin
    ; consecutive locations, abutting the junk token, AND byte-equal to the
    ; origin's source chars — a folded char got its item location wrapped in a
    ; MultiReplacementOrigin by Text::subst (Text.cxx:183), so the reference's
    ; origin-pointer comparison FAILS then (verified: `t=a,b` aborts with
    ; attributeSpecCharacter, `t=A,B` recovers with attributeValueChar).
    ; Returns the reference's recoverUnquoted verdict: true = recovered, keep
    ; parsing the spec; false = caller runs the unterminated-literal guess.
    function recover_unquoted_spec(this: Parser, atts: ref[AttributeList]) returns bool
    {
        let ins ps.current_input()
        let nspec atts.n_spec_of()
        if nspec = 0
            return false
        ; the LAST specified attribute (specIndex == nSpec-1); none found or a
        ; null value -> the reference breaks out and returns 1 (recovered,
        ; junk silently dropped).
        let n_att atts.size()
        var found false
        var ai: size_t 0
        var i: size_t 0
        while i < n_att
        {
            if atts.specified(i)
            {
                if atts.spec_index(i) = nspec - 1
                {
                    set found: true
                    set ai: i
                    set i: n_att
                }
                else
                    set i: i + 1
            }
            else
                set i: i + 1
        }
        if found = false
            return true
        let val atts.value(ai)
        if val = null
            return true
        if val.value_type() = AVT_IMPLIED
            return false
        let t val.get_text()
        if t = null
            return false
        let n (*t).size()
        let locs (*t).get_locs()
        if (n = 0) or (locs = null)
            return false
        let str_loc ins.token_start_location()
        let org0 (*locs).get_origin()
        let idx0 (*locs).get_index()
        if org0 = null
            return false
        if org0 <> str_loc.get_origin()
            return false
        if idx0 + (n as u32) <> str_loc.get_index()
            return false
        let vs (*t).string()
        var j: size_t 0
        while j < n
        {
            let lj *(locs + j)
            if (lj.get_origin() <> org0) or (lj.get_index() <> idx0 + (j as u32))
                return false
            ; cross-check the value against the source chars while they are
            ; still in the input window (the value sits immediately before the
            ; junk token, so normally all of it is); once decoded over, the
            ; location check above stands on its own — the reference holds no
            ; more of the entity than we do.
            var sch: u32 0
            if ins.window_char((idx0 as size_t) + j, &sch)
            {
                if sch <> vs.get(j)
                    return false
            }
            set j: j + 1
        }
        ; the junk token (transient — deep-copy before touching the input).
        let ts ins.current_token_string()
        let sn ts.get_size()
        let sc StringC^host(ts.data_ptr(), sn)
        if atts.tokenized(ai)
        {
            let c1 StringC^host(sc.data_ptr(), 1)
            this.report2_at(ParserMessages.attributeValueChar(), *c1, atts.name(ai), str_loc)
            return true
        }
        ; CDATA: append the junk chars (linear locations from the junk start).
        let comb host.allocate((n + sn) * (sizeof u32), alignof u32) as pointer[u32]
        let clocs host.allocate((n + sn) * (sizeof Location), alignof Location) as pointer[Location]
        var k: size_t 0
        while k < n
        {
            set *(comb + k): vs.get(k)
            set *(clocs + k): *(locs + k)
            set k: k + 1
        }
        var m: size_t 0
        while m < sn
        {
            set *(comb + n + m): sc.get(m)
            set *(clocs + n + m): Location(org0, str_loc.get_index() + (m as u32))
            set m: m + 1
        }
        let nsc StringC^host(comb, n + sn)
        set *t: Text(*nsc, clocs)
        this.report0_at(ParserMessages.unquotedAttributeValue(), str_loc)
        true
    }

    ; AttributeValue::handleAsUnterminated (Attribute.cxx:1377) on a COMPLETED
    ; value Text — the missing-closing-quote guess: reconstruct the item
    ; structure (HuState replay over the per-char locations — contiguous
    ; same-origin runs merge, exactly parse_literal's tracking), tail-strip
    ; spaces from the last data item, and when it ends with the VI delimiter
    ; report literalClosingDelimiter at the text's FIRST located char.
    function value_handle_as_unterminated(this: Parser, t: ref[Text]) returns bool
    {
        let n t.size()
        if n = 0
            return false
        let locs t.get_locs()
        if locs = null
            return false
        let s t.string()
        let buf Array[u32]^host()
        let hu host.allocate(sizeof HuState, alignof HuState) as pointer[HuState]
        set *hu: HuState()
        var i: size_t 0
        while i < n
        {
            hu.note_data(buf, *(locs + i))
            buf.add(s.get(i))
            set i: i + 1
        }
        hu.close(buf)
        if hu.have_last = false
            return false
        var ll hu.last_len
        while (ll > 0) and (*(buf.get_buffer() + hu.last_start + ll - 1) = 0x20)
            set ll: ll - 1
        let syn ps.get_syntax()
        let vn syn.delim_general_len(dVI)
        if (vn = 0) or (ll < vn)
            return false
        var vj: size_t 0
        while vj < vn
        {
            if *(buf.get_buffer() + hu.last_start + ll - vn + vj) <> syn.delim_general_char(dVI, vj)
                return false
            set vj: vj + 1
        }
        ; startLoc = the first ITEM location with a real origin (:1389) — the
        ; startDelim item (markup capture on) precedes every char.
        var first_loc t.get_delim_loc()
        if first_loc.get_origin() = null
        {
            var fi: size_t 0
            while fi < n
            {
                let fl *(locs + fi)
                if fl.get_origin() <> null
                {
                    set first_loc: fl
                    set fi: n
                }
                else
                    set fi: fi + 1
            }
        }
        this.report0_at(ParserMessages.literalClosingDelimiter(), first_loc)
        true
    }

    ; AttributeList::handleAsUnterminated (Attribute.cxx:1357) — run the guess
    ; on the last specified attribute's value text.
    function atts_handle_as_unterminated(this: Parser, atts: ref[AttributeList]) returns bool
    {
        let nspec atts.n_spec_of()
        if nspec = 0
            return false
        let n_att atts.size()
        var i: size_t 0
        while i < n_att
        {
            if atts.specified(i)
            {
                if atts.spec_index(i) = nspec - 1
                {
                    let val atts.value(i)
                    if val = null
                        return false
                    let t val.get_text()
                    if t = null
                        return false
                    return this.value_handle_as_unterminated(t)
                }
            }
            set i: i + 1
        }
        false
    }

    ; the makeSemantics half of AttributeList::finish (Attribute.cxx:1246):
    ; an UNSPECIFIED attribute whose missing value is a real tokenized value
    ; gets its semantics (ID/IDREF booking, entity/notation resolution + the
    ; validation messages) exactly like a specified one — message locations
    ; come from the DTD default literal's Text locations. Runs right after
    ; finish, in definition order, mirroring the reference's loop.
    function check_missing_semantics(this: Parser, atts: ref[AttributeList])
    {
        let n atts.size()
        var i: size_t 0
        while i < n
        {
            if atts.specified(i) = false
            {
                ; the makeMissingValue message half (finish's loop fires it in
                ; the same iteration as the value's makeSemantics — Attribute
                ; .cxx:1247): re-derive the virtual dispatch from the kind.
                ; The CONREF exclusion (conref specified -> the NOTATION slot
                ; gets NO makeMissingValue call at all, :1248) is skipped the
                ; same way. Locations: unlocated context.message = the current
                ; token's START (the TAGC — verified 5:4 / 7:21).
                var mm_skip false
                if atts.conref_of()
                {
                    let adl atts.get_def()
                    if adl <> null
                    {
                        if adl.get_notation_index() = i
                            set mm_skip: true
                    }
                }
                if mm_skip = false
                {
                    let d atts.definition(i)
                    if d <> null
                    {
                        let kind d.get_ad_kind()
                        let ctx ps.get_attribute_context()
                        if kind = ADK_REQUIRED
                        {
                            if ps.validate()
                                this.report1_at(ParserMessages.requiredAttributeMissing(), d.get_name(), ps.current_input().token_start_location())
                        }
                        else if kind = ADK_CURRENT
                        {
                            if ctx.may_default_attribute()
                            {
                                ; finish stored getCurrentAttribute's result:
                                ; still null = no occurrence specified yet.
                                if atts.value(i) = null
                                {
                                    if ps.validate()
                                        this.report1_at(ParserMessages.currentAttributeMissing(), d.get_name(), ps.current_input().token_start_location())
                                }
                            }
                            else if ps.validate()
                                this.report1_at(ParserMessages.attributeMissing(), d.get_name(), ps.current_input().token_start_location())
                        }
                        else if (kind = ADK_DEFAULT) or (kind = ADK_FIXED)
                        {
                            if ctx.may_default_attribute() = false
                            {
                                if ps.validate()
                                    this.report1_at(ParserMessages.attributeMissing(), d.get_name(), ps.current_input().token_start_location())
                            }
                        }
                    }
                }
                let v atts.value(i)
                if v <> null
                {
                    if v.value_type() = AVT_TOKENIZED
                    {
                        let t v.get_text()
                        if t <> null
                            this.check_value_semantics(atts, i, t)
                    }
                }
            }
            set i: i + 1
        }
        ; the tail of AttributeList::finish (Attribute.cxx:1259) — runs here
        ; so the GRPCNT totals include the defaulted values' counts:
        ; idrefGrpcnt / entityNameGrpcnt (quantity errors, not validate-gated)
        ; and the CONREF/NOTATION exclusion (validate-gated).
        let syn ps.get_syntax()
        let grpcnt_q syn.get_quantity(qGRPCNT)
        if atts.n_idrefs_of() > grpcnt_q
            this.report_num_at(ParserMessages.idrefGrpcnt(), grpcnt_q as u64, ps.current_input().token_start_location())
        if atts.n_entity_names_of() > grpcnt_q
            this.report_num_at(ParserMessages.entityNameGrpcnt(), grpcnt_q as u64, ps.current_input().token_start_location())
        if ps.validate()
        {
            if atts.conref_notation_specified()
                this.report0_at(ParserMessages.conrefNotation(), ps.current_input().token_start_location())
        }
    }

    ; handleAttributeNameToken (parseAttribute.cxx) — SHORTTAG attribute-name
    ; minimization: a bare token whose attribute name was omitted (`<content
    ; multiple optional>`). Resolve the attribute whose declared enumerated /
    ; notation / nametoken value set contains `token` and record it as that
    ; attribute's value. First-match; under WebSGML a non-unique token is an
    ; error. `token` is the already-folded current name.
    function handle_attribute_name_token(this: Parser, token: StringC, atts: ref[AttributeList], spec_length: pointer[size_t]) returns bool
    {
        let idx atts.token_index(token)
        if idx < 0
        {
            ; noSuchAttributeToken (parseAttribute.cxx:105): this token is not a
            ; member of any attribute's group. onsgmls reports it (arg = the folded
            ; token, quoted), marks the spec invalid, and CONTINUES (the attribute
            ; stays unspecified → defaults). Location = the token's start.
            let loc ps.current_input().token_start_location()
            this.report1_at(ParserMessages.noSuchAttributeToken(), token, loc)
            return true
        }
        if ps.get_sd().www()
        {
            if atts.token_index_unique(token, idx) = false
            {
                ; attributeTokenNotUnique (parseAttribute.cxx:110): the spec is
                ; noted invalid and parsing CONTINUES (the reference returns 1).
                atts.note_invalid_spec()
                this.report1_at(ParserMessages.attributeTokenNotUnique(), token, ps.current_input().token_start_location())
                return true
            }
        }
        let index idx as size_t
        ; attributeNameShorttag (parseAttribute.cxx:115): OMITNAME disabled
        ; makes the shorthand illegal (message only; the value still books);
        ; otherwise the omitted name warns under -wmissing-att-name.
        if ps.get_sd().attribute_omit_name() = false
            this.report0_at(ParserMessages.attributeNameShorttag(), ps.current_input().token_start_location())
        else
        {
            let opt_mn ps.get_options()
            if opt_mn.warn_missing_attribute_name
                this.report0_at(ParserMessages.missingAttributeName(), ps.current_input().token_start_location())
        }
        let ctx ps.get_attribute_context()
        atts.set_spec(index, ctx)
        ; The value's Text lands on the page of its own attribute LIST, and
        ; parse_literal below derives ITS buffers from this Text (Page.get) —
        ; so the whole value, including the per-char location spur, follows the
        ; list onto the drainable attribute scratch.
        let atts_text_host Page.get(atts as pointer[void])
        let text atts_text_host.allocate(sizeof Text, alignof Text) as pointer[Text]
        set *text: Text(token)
        ; GroupDeclaredValue::makeValueFromToken (Attribute.cxx:369): no
        ; category/group validation (the token matched the group) — only the
        ; LITLEN check and the normalized-length accounting (size + NORMSEP).
        let syn ps.get_syntax()
        let normsep syn.get_quantity(qNORMSEP) as size_t
        let litlen syn.get_quantity(qLITLEN) as size_t
        let tsz token.get_size()
        if (normsep > litlen) or (tsz > litlen - normsep)
            this.report_num_num_at(ParserMessages.normalizedAttributeValueLength(), litlen as u64, (tsz + normsep) as u64, ps.current_input().token_start_location())
        set *spec_length: *spec_length + tsz + normsep
        ; checkValue wraps makeValueFromToken too (Attribute.h:648) — bind the
        ; set_value result: it is this function's return value (tail position).
        ; The value lands on the page of its own LIST, not on the run page: an
        ; instance list sits on the drainable attribute scratch
        ; (ParserState.attribute_host), a declaration list on the run page, and
        ; a value must not outlive — or under-live — the list that owns it.
        ; This is where the bytes are: the fold buffer is 4 bytes per character
        ; and the per-char location array 16, so an attribute value costs ~20x
        ; its text (measured 2026-08-02: ~450 MB of a 507 MB document body).
        let atts_host Page.get(atts as pointer[void])
        let sv_ok atts.set_value(atts_host, index, text, ctx)
        this.check_attribute_value(atts, index)
        sv_ok
    }

    ; parseAttributeSpec — the attribute-spec loop: (name VI value)* up to the
    ; close delimiter, then finish the list (fill defaults).
    function parse_attribute_spec(this: Parser, mode: int, atts: ref[AttributeList], net: pointer[bool], new_att_def: pointer[pointer[AttributeDefinitionList]]) returns bool
    {
        var spec_length: size_t 0
        var cur_parm: int 0
        if this.parse_attribute_parameter(mode, false, &cur_parm, net) = false
            return false
        var running true
        var ok true
        while running
        {
            if cur_parm = APT_END
                set running: false
            else if cur_parm = APT_NAME
            {
                let nm this.name_folded()
                if this.parse_attribute_parameter(mode, true, &cur_parm, net) = false
                {
                    set ok: false
                    set running: false
                }
                else if cur_parm = APT_VI
                {
                    ; the attribute NAME contributes its size + NORMSEP to the
                    ; spec length (parseAttribute.cxx:41).
                    let normsep_n ps.get_syntax().get_quantity(qNORMSEP) as size_t
                    set spec_length: spec_length + nm.get_size() + normsep_n
                    if this.parse_attribute_value_spec(mode, nm, atts, &spec_length, new_att_def) = false
                    {
                        set ok: false
                        set running: false
                    }
                    else if this.parse_attribute_parameter(mode, false, &cur_parm, net) = false
                    {
                        set ok: false
                        set running: false
                    }
                }
                else
                {
                    ; SHORTTAG name value shorthand: `nm` was a NAME not followed
                    ; by a VI, so it is a value with the attribute name omitted.
                    ; The lookahead parameter (cur_parm) is reused as-is.
                    if this.handle_attribute_name_token(nm, atts, &spec_length) = false
                    {
                        set ok: false
                        set running: false
                    }
                }
            }
            else if cur_parm = APT_NAMETOKEN
            {
                ; a NAMETOKEN can never be an attribute name -> always an omitted-
                ; name value; read the next parameter afterwards.
                let nt this.name_folded()
                if this.handle_attribute_name_token(nt, atts, &spec_length) = false
                {
                    set ok: false
                    set running: false
                }
                else if this.parse_attribute_parameter(mode, false, &cur_parm, net) = false
                {
                    set ok: false
                    set running: false
                }
            }
            else if cur_parm = APT_RECOVER_UNQUOTED
            {
                ; parseAttributeSpec's recoverUnquoted arm (parseAttribute.cxx
                ; :70): adopted junk continues the spec loop; otherwise shrink
                ; the token to its first character, try the missing-closing-
                ; quote guess, and failing that report attributeSpecCharacter
                ; (arg = that character) — the spec is abandoned either way.
                if this.recover_unquoted_spec(atts)
                {
                    if this.parse_attribute_parameter(mode, false, &cur_parm, net) = false
                    {
                        set ok: false
                        set running: false
                    }
                }
                else
                {
                    let ins ps.current_input()
                    ins.end_token(1)
                    if this.atts_handle_as_unterminated(atts) = false
                    {
                        let ts ins.current_token_string()
                        let cs StringC^host(ts.data_ptr(), ts.get_size())
                        this.report1_at(ParserMessages.attributeSpecCharacter(), *cs, ins.token_start_location())
                    }
                    set ok: false
                    set running: false
                }
            }
            else
            {
                ; cur_parm can only be APT_VI here, and every head-position
                ; parse_attribute_parameter call passes allow_vi = false, which
                ; already rejects a bare VI (attributeSpecNameTokenExpected) —
                ; unreachable (the reference's CANNOT_HAPPEN).
                set ok: false
                set running: false
            }
        }
        if ok = false
            return false
        let ctx ps.get_attribute_context()
        atts.finish(ctx)
        this.check_missing_semantics(atts)
        ; parseAttributeSpec tail (parseAttribute.cxx:89): the ATTSPLEN check
        ; over the accumulated normalized spec length.
        let attsplen_q ps.get_syntax().get_quantity(qATTSPLEN) as size_t
        if spec_length > attsplen_q
            this.report_num_num_at(ParserMessages.attsplen(), attsplen_q as u64, spec_length as u64, ps.current_input().token_start_location())
        true
    }

    function do_parse_start_tag(this: Parser, out_net: ref[bool]) returns ref[Event]
    {
        let ins ps.current_input()
        ; markupLocation() — the STAGO of the start tag. do_content's get_token
        ; already consumed the STAGO+name-start token, so the scan cursor sits
        ; past it; the token's START location is the STAGO. This becomes the open
        ; element's start location (and the "start tag was here" aux); `loc` below
        ; (after the GI name) is the TAGC position elementNotAllowed reports at.
        let mloc ins.token_start_location()
        ins.discard_initial()
        this.extend_name_token(this.namelen(), ParserMessages.nameLength())
        let name this.name_folded()
        let dtd ps.get_current_dtd()
        var e dtd.lookup_element_type(name)
        ; RANK (parseInstance.cxx:433): an unknown GI may complete a rank stem;
        ; a ranked element updates the current rank for its stem group.
        if ps.get_sd().rank()
        {
            if e = null
                set e: this.complete_rank_stem(name)
            else if e.is_ranked_element()
                this.handle_ranked_element(e)
        }
        if e = null
        {
            let cs ps.get_content_state()
            let uloc ps.current_location()
            set e: cs.lookup_create_undefined_element(host, name, uloc, dtd, true)
        }
        let loc ps.current_location()
        let adl e.get_attribute_def()
        let atts AttributeList.make(ps.attribute_host(), adl)
        let ctx ps.get_attribute_context()
        var net false
        ; grown by an undeclared attribute (IMPLYDEF ATTLIST) — see
        ; parse_attribute_value_spec.
        var new_att_def: pointer[AttributeDefinitionList] null
        let close_token ps.get_token(tagMode)
        if close_token = tokenTagc
        {
            ; parseInstance.cxx:444 — the GI alone over TAGLEN (the cheap
            ; pre-check; check_taglen re-measures from the tag start).
            if name.get_size() > (ps.get_syntax().get_quantity(qTAGLEN) as size_t)
                this.check_taglen(mloc.get_index())
            atts.finish(ctx)
            this.check_missing_semantics(atts)
        }
        else
        {
            ins.unget_token()
            let okatt this.parse_attribute_spec(tagMode, atts, &net, &new_att_def)
            ; parse_attribute_spec finishes the list (mirrors C++ parseAttributeSpec).
            ; parseInstance.cxx:456 — the whole start tag over TAGLEN.
            if okatt
            {
                let cur_idx ps.current_input().token_start_location()
                if (cur_idx.get_index() - mloc.get_index()) > (ps.get_syntax().get_quantity(qTAGLEN) as u32)
                    this.check_taglen(mloc.get_index())
            }
        }
        ; doParseStartTag: give the grown definition list its own DTD index and
        ; install it on the element type, so it survives this start tag.
        if new_att_def <> null
        {
            let didx dtd.alloc_attribute_definition_list_index()
            new_att_def.set_index(didx)
            e.set_attribute_def(new_att_def)
        }
        set out_net: net
        let ev Event.make_start(ps.event_host(), e, loc)
        ev.set_markup_loc(mloc)
        ev.set_attributes(atts)
        ; a REAL start tag (the reference's markup under wantInstanceMarkup) —
        ; -otagomit prints `o` only for events WITHOUT this.
        ev.set_has_markup()
        ev
    }

    ; checkTaglen (parseInstance.cxx:499): measure the start tag from past the
    ; STAGO to the current token and report taglen when it exceeds TAGLEN. The
    ; reference converts indexes to source offsets (startOffset — one extra per
    ; named char ref); our index model is 1:1, so the plain difference serves.
    function check_taglen(this: Parser, tag_start_index: u32)
    {
        let syn ps.get_syntax()
        let taglen_q syn.get_quantity(qTAGLEN)
        let stago_len syn.delim_general_len(dSTAGO) as u32
        let cur ps.current_input().token_start_location()
        if (cur.get_index() - (tag_start_index + stago_len)) > taglen_q
            this.report_num_at(ParserMessages.taglen(), taglen_q as u64, cur)
    }

    function parse_start_tag(this: Parser)
    {
        var net false
        let event this.do_parse_start_tag(&net)
        let e event.get_element_type()
        this.accept_start_tag(e, event, net)
    }

    ; tryImplyTag (parseInstance.cxx:748) — one OMITTAG inference step at the
    ; current position, SPECULATIVE: events buffer into `events`, every content
    ; mutation records its inverse in `undo`. The caller commits the chain with
    ; queue_element_events (releasing kept messages) or rolls it back with
    ; undo_all + discard_kept_messages. Either implies an END tag (current
    ; element finished + its end tag omissible) or a START tag (the uniquely
    ; required next element). Returns true if a tag was implied (retry the
    ; pending token).
    function try_imply_tag(this: Parser, loc: Location, start_implied: pointer[u32], undo: ref[Array[UndoEntry]], events: ref[Array[ref[Event]?]]) returns bool
    {
        if ps.get_sd().omittag() = false
            return false
        let cs ps.get_content_state()
        let ce cs.current_element()
        if ce.is_finished()
        {
            if cs.tag_level_of() = 0
                return false
            let def ce.get_type().get_definition()
            if def <> null
                if def.can_omit_end_tag() = false
                    return false
            ; an end tag is implied for an element whose START tag was itself
            ; implied in this chain: the element was implied empty.
            if *start_implied > 0
            {
                let gi_empty ce.get_type().get_name()
                this.report1_at(ParserMessages.startTagEmptyElement(), gi_empty, ps.current_input().token_start_location())
                set *start_implied: *start_implied - (1 as u32)
            }
            let e ce.get_type()
            let endev Event.make_end(ps.event_host(), e, loc)
            events.add(endev)
            var ue UndoEntry()
            set ue.kind: UNDO_END_TAG
            set ue.element: ps.pop_save_element_mode()
            set ue.state: null
            undo.add(ue)
            return true
        }
        let tok ce.implied_start_token()
        if tok = null
            return false
        let e ContentToken.token_element(tok)
        if e = null
            return false
        ; the required element is excluded — contextually required elements may
        ; not be excluded (E3); the imply proceeds regardless (reference).
        if cs.element_is_excluded(e)
        {
            let ord_req (ContentToken.token_type_index(tok) as u64) + 1
            this.report_ord2_at(ParserMessages.requiredElementExcluded(), ord_req, e.get_name(), ce.get_type().get_name(), ps.current_input().token_start_location())
        }
        if cs.tag_level_of() <> 0
        {
            var ut UndoEntry()
            set ut.kind: UNDO_TRANSITION
            set ut.element: null
            set ut.state: ce.copy_match_state(host)
            undo.add(ut)
        }
        ce.do_required_transition()
        let def2 e.get_definition()
        ; start-tag omission diagnostics (parseInstance.cxx:799-807): declared
        ; content other than a model group / ANY; an undefined element (the
        ; OMITTAG-inference undefinedElement — probe g1); a declaration that
        ; does not permit start-tag omission.
        if def2 <> null
        {
            let dc def2.get_declared_content()
            if (dc <> DC_MODEL_GROUP) and (dc <> DC_ANY)
                this.report1_at(ParserMessages.omitStartTagDeclaredContent(), e.get_name(), ps.current_input().token_start_location())
            if def2.undefined()
                this.report1_at(ParserMessages.undefinedElement(), e.get_name(), ps.current_input().token_start_location())
            else if def2.can_omit_start_tag() = false
                this.report1_at(ParserMessages.omitStartTagDeclare(), e.get_name(), ps.current_input().token_start_location())
        }
        let adl e.get_attribute_def()
        let atts AttributeList.make(ps.attribute_host(), adl)
        let ctx ps.get_attribute_context()
        atts.finish(ctx)
        ; gives an error if the element has a required attribute (kept while
        ; speculating, like the reference's finish under keepMessages).
        this.check_missing_semantics(atts)
        set *start_implied: *start_implied + (1 as u32)
        let stev Event.make_start(ps.event_host(), e, loc)
        stev.set_attributes(atts)
        this.push_element_check_spec(e, stev, undo, events)
        ; checkImplyLoop (parseInstance.cxx:821): break a non-advancing infinite
        ; imply chain after a fairly arbitrary limit.
        if *start_implied > 30
            if cs.check_imply_loop(*start_implied) = false
                return false
        true
    }

    ; pushElementCheck (parseInstance.cxx:973), the SPECULATIVE variant: the
    ; start event buffers into the event list; a mustOmitEnd (EMPTY) element
    ; buffers its end event right behind it and is never pushed; otherwise the
    ; element is pushed live and the undo list records the pop.
    function push_element_check_spec(this: Parser, e: ref[ElementType], event: ref[Event], undo: ref[Array[UndoEntry]], events: ref[Array[ref[Event]?]])
    {
        let taglvl_q ps.get_syntax().get_quantity(qTAGLVL)
        if ps.get_content_state().tag_level_of() = taglvl_q
            this.report_num_at(ParserMessages.taglvlOpenElements(), taglvl_q as u64, ps.current_input().token_start_location())
        events.add(event)
        if this.must_omit_end(e)
        {
            let endev Event.make_end(ps.event_host(), e, event.get_loc())
            if event.is_included()
                endev.set_included()
            events.add(endev)
        }
        else
        {
            var ue UndoEntry()
            set ue.kind: UNDO_START_TAG
            set ue.element: null
            set ue.state: null
            undo.add(ue)
            let cs ps.get_content_state()
            let ce cs.current_element()
            var map e.get_map()
            if map = null
                set map: ce.get_map()
            let oe cs.acquire_element(host, e, false, event.is_included(), map, event.get_markup_loc())
            ps.push_element_mode(oe)
        }
    }

    ; queueElementEvents (parseInstance.cxx:693) — the speculation commits:
    ; release the kept diagnostics, then emit the buffered events in document
    ; order, noting each start/end.
    function queue_element_events(this: Parser, events: ref[Array[ref[Event]?]])
    {
        ps.release_kept_messages()
        let n events.get_length()
        var i: size_t 0
        while i < n
        {
            let ev events[i]
            if ev.get_type() = EV_START_ELEMENT
            {
                ps.note_start_element(ev.is_included())
                this.rast_pre_start(ev)
                ps.queue_event(ev)
                this.rast_post_start(ev)
            }
            else
            {
                ps.note_end_element(ev.is_included())
                ps.queue_event(ev)
            }
            set i: i + 1
        }
    }

    ; undo (parseInstance.cxx:684) — roll the speculation back, newest first.
    function undo_all(this: Parser, undo: ref[Array[UndoEntry]])
    {
        var i undo.get_length()
        while i > 0
        {
            set i: i - 1
            let ue undo[i]
            if ue.kind = UNDO_START_TAG
                ps.pop_element_mode()
            else if ue.kind = UNDO_END_TAG
                ps.push_element_mode(ue.element)
            else
            {
                let cs ps.get_content_state()
                let ce cs.current_element()
                ce.set_match_state(ue.state)
            }
        }
    }

    ; checkExclusion (parseInstance.cxx:715) — the excluded element's transition
    ; token exists but is neither inherently optional nor an OR-group member:
    ; the exclusion is invalid (E3).
    function check_exclusion(this: Parser, e: ref[ElementType])
    {
        let cs ps.get_content_state()
        let ce cs.current_element()
        let tok ce.invalid_exclusion(e)
        if tok <> null
        {
            let ord_exc (ContentToken.token_type_index(tok) as u64) + 1
            let tname ContentToken.token_element(tok)
            var tgi StringC()
            if tname <> null
                set tgi: tname.get_name()
            this.report_ord2_at(ParserMessages.invalidExclusion(), ord_exc, tgi, ce.get_type().get_name(), ps.current_input().token_start_location())
        }
    }

    ; tryStartTag (parseInstance.cxx:725) — one admission attempt for the
    ; pending start tag after an imply step: exclusion refutes it (with the
    ; invalid-exclusion check), a clean transition or an inclusion admits it
    ; (committing the buffered chain).
    function try_start_tag(this: Parser, e: ref[ElementType], event: ref[Event], net: bool, events: ref[Array[ref[Event]?]]) returns bool
    {
        let cs ps.get_content_state()
        if cs.element_is_excluded(e)
        {
            this.check_exclusion(e)
            return false
        }
        let ce cs.current_element()
        if ce.try_transition(e)
        {
            this.queue_element_events(events)
            this.push_element_check(e, event, net)
            return true
        }
        if cs.element_is_included(e)
        {
            this.queue_element_events(events)
            event.set_included()
            this.push_element_check(e, event, net)
            return true
        }
        false
    }

    function accept_start_tag(this: Parser, e: ref[ElementType], event: ref[Event], net: bool)
    {
        ; undefinedElement (parseInstance.cxx:643): the element's definition is
        ; the checkDtd/lookupCreate UNDEFINED one and elements may not be
        ; implied (IMPLYDEF ELEMENT NO). onsgmls reports it and ADMITS the
        ; element (undefined content pre-empts elementNotAllowed below);
        ; location = the LIVE current token start (reference message() stamps
        ; in->currentLocation() = the start tag's TAGC — with attributes the
        ; event's own loc sits right after the NAME, columns diverge).
        let def e.get_definition()
        var undefined false
        if def <> null
            set undefined: def.undefined()
        if undefined and (ps.get_implydef_element() = IMPLYDEF_ELEMENT_NO)
        {
            let uname e.get_name()
            this.report1_at(ParserMessages.undefinedElement(), uname, ps.current_input().token_start_location())
        }
        let cs ps.get_content_state()
        if cs.element_is_excluded(e)
        {
            ps.keep_messages()
            if ps.validate()
                this.check_exclusion(e)
        }
        else
        {
            let ce cs.current_element()
            if ce.try_transition(e)
            {
                this.push_element_check(e, event, net)
                return
            }
            if cs.element_is_included(e)
            {
                event.set_included()
                this.push_element_check(e, event, net)
                return
            }
            ps.keep_messages()
        }
        ; OMITTAG: imply end/start tags speculatively until e is admissible.
        ; Implied tags carry the pending event's MARKUP location (its STAGO) —
        ; the reference's event->location().
        var start_implied: u32 0
        let undo Array[UndoEntry]^host()
        let events Array[ref[Event]?]^host()
        while this.try_imply_tag(event.get_markup_loc(), &start_implied, undo, events)
        {
            if this.try_start_tag(e, event, net, events)
                return
        }
        ; Not admissible even after minimization: roll the speculation back.
        ps.discard_kept_messages()
        this.undo_all(undo)
        if ps.validate() and (undefined = false)
            this.handle_bad_start_tag(e, event, net)
        else
        {
            ; elementNotAllowed (parseInstance.cxx:676) — a plain message() at
            ; the CURRENT scan token (normally the start tag's TAGC). Gated:
            ; validating parses report it only when elements may be implied
            ; (IMPLYDEF), non-validating ones only after the document element.
            var say_not_allowed false
            if ps.validate()
                set say_not_allowed: ps.get_implydef_element() <> IMPLYDEF_ELEMENT_NO
            else
                set say_not_allowed: cs.after_document_element()
            if say_not_allowed
            {
                let gi e.get_name()
                let eloc ps.current_input().token_start_location()
                this.report1_at(ParserMessages.elementNotAllowed(), gi, eloc)
            }
            ; if the element could not occur because it was excluded, do the
            ; transition here; then force-push so parsing continues.
            let ce3 cs.current_element()
            let discard ce3.try_transition(e)
            this.push_element_check(e, event, net)
        }
    }

    ; handleBadStartTag (parseInstance.cxx:1206) — the validating recovery for
    ; a defined element the model rejects: search the possible transitions for
    ; element(s) whose own content admits it. Exactly one candidate -> report
    ; missingElementInferred, push the inferred element, then the pending one.
    ; Several -> report missingElementMultiple (candidate list in DTD order)
    ; and force-push. None -> imply an end tag (if permitted) and retry one
    ; level up; when that runs dry, elementNotAllowed + force-push.
    function handle_bad_start_tag(this: Parser, e: ref[ElementType], event: ref[Event], net: bool)
    {
        let cs ps.get_content_state()
        let undo Array[UndoEntry]^host()
        let events Array[ref[Event]?]^host()
        ps.keep_messages()
        var looping true
        while looping
        {
            let missing Array[ref[ElementType]?]^host()
            this.find_missing_tag(e, missing)
            if missing.get_length() = 1
            {
                this.queue_element_events(events)
                let m missing[0]
                this.report2_at(ParserMessages.missingElementInferred(), e.get_name(), m.get_name(), ps.current_input().token_start_location())
                let adl m.get_attribute_def()
                let atts AttributeList.make(ps.attribute_host(), adl)
                let ctx ps.get_attribute_context()
                atts.finish(ctx)
                this.check_missing_semantics(atts)
                let inferev Event.make_start(ps.event_host(), m, event.get_markup_loc())
                inferev.set_attributes(atts)
                let ce_i cs.current_element()
                if ce_i.try_transition(m) = false
                    inferev.set_included()
                this.push_element_check(m, inferev, false)
                let ce_e cs.current_element()
                if ce_e.try_transition(e) = false
                    event.set_included()
                this.push_element_check(e, event, net)
                return
            }
            if missing.get_length() > 0
            {
                this.queue_element_events(events)
                let names Array[StringC]^host()
                let nm missing.get_length()
                var i: size_t 0
                while i < nm
                {
                    let mi missing[i]
                    names.add(mi.get_name())
                    set i: i + 1
                }
                this.report_str_vec_at(ParserMessages.missingElementMultiple(), e.get_name(), names, ps.current_input().token_start_location())
                this.push_element_check(e, event, net)
                return
            }
            let ce cs.current_element()
            var can_pop false
            if ps.get_sd().omittag() and ce.is_finished() and (cs.tag_level_of() <> 0)
            {
                let def ce.get_type().get_definition()
                if def <> null
                    set can_pop: def.can_omit_end_tag()
            }
            if can_pop
            {
                let endev Event.make_end(ps.event_host(), ce.get_type(), event.get_markup_loc())
                events.add(endev)
                var ue UndoEntry()
                set ue.kind: UNDO_END_TAG
                set ue.element: ps.pop_save_element_mode()
                set ue.state: null
                undo.add(ue)
            }
            else
                set looping: false
        }
        ps.discard_kept_messages()
        this.undo_all(undo)
        let gi e.get_name()
        this.report1_at(ParserMessages.elementNotAllowed(), gi, ps.current_input().token_start_location())
        let ce4 cs.current_element()
        let discard ce4.try_transition(e)
        this.push_element_check(e, event, net)
    }

    ; findMissingTag (parseInstance.cxx:1273) — the candidate elements whose
    ; own content model (or inclusions) admit `e` (e = null searches for a
    ; #PCDATA host), filtered by the live exclusions, sorted in DTD declaration
    ; order (insertion sort, like the reference).
    function find_missing_tag(this: Parser, e: ref[ElementType]?, v: ref[Array[ref[ElementType]?]])
    {
        let cs ps.get_content_state()
        let ce cs.current_element()
        if ce.current_position() = null
        {
            if e = null
                v.add(null as pointer[ElementType])
            return
        }
        if e <> null
            if cs.element_is_excluded(e)
                return
        let cands Array[ref[ElementType]?]^host()
        ce.possible_transitions(cands)
        let n cands.get_length()
        var i: size_t 0
        while i < n
        {
            let cand cands[i]
            if cand <> null
            {
                if cs.element_is_excluded(cand) = false
                {
                    var success false
                    let cdef cand.get_definition()
                    if cdef <> null
                    {
                        let dc cdef.get_declared_content()
                        if dc = DC_MODEL_GROUP
                        {
                            let grp cdef.compiled_model_group()
                            let state ContentToken.make_match_state(host, grp)
                            if e = null
                                set success: ContentToken.ms_try_transition_pcdata(state)
                            else
                            {
                                if ContentToken.ms_try_transition(state, e)
                                    set success: true
                                if success = false
                                {
                                    let ni cdef.n_inclusions()
                                    var j: size_t 0
                                    while j < ni
                                    {
                                        if cdef.inclusion(j) = e
                                        {
                                            set success: true
                                            set j: ni
                                        }
                                        else
                                            set j: j + 1
                                    }
                                }
                                if success
                                {
                                    let ne cdef.n_exclusions()
                                    var k: size_t 0
                                    while k < ne
                                    {
                                        if cdef.exclusion(k) = e
                                        {
                                            set success: false
                                            set k: ne
                                        }
                                        else
                                            set k: k + 1
                                    }
                                }
                            }
                        }
                        else if (dc = DC_CDATA) or (dc = DC_RCDATA)
                        {
                            if e = null
                                set success: true
                        }
                    }
                    if success
                        v.add(cand)
                }
            }
            set i: i + 1
        }
        ; insertion sort by DTD declaration order (ElementType::index).
        var s: size_t 1
        while s < v.get_length()
        {
            let tem v[s]
            var j2 s
            var moving true
            while moving
            {
                if j2 > 0
                {
                    let prev v[(j2 - 1)]
                    if prev.get_index() > tem.get_index()
                    {
                        v.put(j2, prev)
                        set j2: j2 - 1
                    }
                    else
                        set moving: false
                }
                else
                    set moving: false
            }
            v.put(j2, tem)
            set s: s + 1
        }
    }

    function push_element_check(this: Parser, e: ref[ElementType], event: ref[Event], net: bool)
    {
        ; pushElementCheck (parseInstance.cxx:831) — open elements vs TAGLVL.
        let taglvl_q ps.get_syntax().get_quantity(qTAGLVL)
        if ps.get_content_state().tag_level_of() = taglvl_q
            this.report_num_at(ParserMessages.taglvlOpenElements(), taglvl_q as u64, ps.current_input().token_start_location())
        ps.note_start_element(event.is_included())
        this.rast_pre_start(event)
        if this.must_omit_end(e)
        {
            if ps.get_sd().empty_element_normal()
            {
                ; EMPTYNRM: emit start, then consume the empty-element tag's
                ; closing NET (`<x/>`) / end tag before implying the end.
                let included event.is_included()
                let sloc event.get_loc()
                ps.queue_event(event)
                this.rast_post_start(event)
                this.end_tag_empty_element(e, net, included, sloc)
            }
            else
            {
                ; EMPTY element: emit start immediately followed by an implied end.
                ps.note_end_element(event.is_included())
                ps.queue_event(event)
                this.rast_post_start(event)
                let endev Event.make_end(ps.event_host(), e, event.get_loc())
                if event.is_included()
                    endev.set_included()
                ps.queue_event(endev)
            }
            return
        }
        let cs ps.get_content_state()
        let ce cs.current_element()
        var map e.get_map()
        if map = null
            set map: ce.get_map()
        ; parseInstance.cxx:862: an element immediately containing itself warns
        ; under -wimmediate-recursion.
        if e = ce.get_type()
        {
            let opt_ir ps.get_options()
            if opt_ir.warn_immediate_recursion
                this.report0_at(ParserMessages.immediateRecursion(), ps.current_input().token_start_location())
        }
        let oe cs.acquire_element(host, e, net, event.is_included(), map, event.get_markup_loc())
        ps.push_element_mode(oe)
        ps.queue_event(event)
        this.rast_post_start(event)
    }

    function parse_end_tag(this: Parser) returns ref[Event]?
    {
        let ins ps.current_input()
        ; markupLocation() — the ETAGO (doParseEndTag, parseInstance.cxx:1032,
        ; builds the event with it). Same split as do_parse_start_tag: `loc`
        ; below is the position after the GI name, which the elementNotOpen
        ; diagnostic reports at, while the EVENT's location is the tag's start.
        let mloc ins.token_start_location()
        ins.discard_initial()
        this.extend_name_token(this.namelen(), ParserMessages.nameLength())
        let name this.name_folded()
        let dtd ps.get_current_dtd()
        var e dtd.lookup_element_type(name)
        ; RANK (parseInstance.cxx:1022): an unknown end-tag GI may complete a
        ; rank stem (end tags do NOT update the current rank).
        if ps.get_sd().rank()
            if e = null
                set e: this.complete_rank_stem(name)
        let loc ps.current_location()
        this.parse_end_tag_close()
        if e = null
        {
            ; an end tag naming an UNDECLARED element: it is nowhere open, so
            ; onsgmls likewise reports elementNotOpen (with the folded GI) and
            ; drops the tag. Reported here since the null type reaches no
            ; acceptEndTag. Location is the end tag's (before its TAGC).
            let mt_notopen ParserMessages.elementNotOpen()
            this.report1_at(mt_notopen, name, loc)
            return null
        }
        let ee Event.make_end(ps.event_host(), e, loc)
        ee.set_markup_loc(mloc)
        ; a REAL end tag — see do_parse_start_tag's has_markup note.
        ee.set_has_markup()
        ee
    }

    ; parseEndTagClose (parseInstance.cxx:1036) — consume the end tag's close:
    ; S separators up to the TAGC; an ETAGO/STAGO leaves the tag unclosed
    ; (legal only under SHORTTAG YES / ENDTAG UNCLOSED); anything else is
    ; diagnosed and ends the tag.
    function parse_end_tag_close(this: Parser)
    {
        var looping true
        while looping
        {
            let token ps.get_token(tagMode)
            if token = tokenUnrecognized
            {
                ; a single character not recognized in tag mode: non-SGML chars
                ; report as such; anything else is endTagCharacter.
                let ins ps.current_input()
                if ins.current_token_length() = 0
                    ins.end_token(1)
                let ts ins.current_token_string()
                let c ts.get(0)
                let cloc ins.token_start_location()
                if this.is_non_sgml_char(c)
                    this.report_num_at(ParserMessages.nonSgmlCharacter(), c as u64, cloc)
                else
                    this.report1_at(ParserMessages.endTagCharacter(), ts, cloc)
                return
            }
            else if token = tokenEe
            {
                this.report0_at(ParserMessages.endTagEntityEnd(), ps.current_input().token_start_location())
                return
            }
            else if (token = tokenEtago) or (token = tokenStago)
            {
                if ps.get_sd().end_tag_unclosed() = false
                    this.report0_at(ParserMessages.unclosedEndTagShorttag(), ps.current_input().token_start_location())
                ps.current_input().unget_token()
                return
            }
            else if token = tokenTagc
                return
            else if token = tokenS
                set looping: looping
            else
            {
                let targ this.token_message_arg(token, tagMode)
                this.report_raw_at(ParserMessages.endTagInvalidToken(), targ, ps.current_input().token_start_location())
                return
            }
        }
    }

    ; endTagEmptyElement (EMPTYNRM) — an EMPTY element's start tag is immediately
    ; followed by the tag that ends it: a NET (`<x/>`), an empty end tag (`</>`)
    ; or a matching `</x>`. Consume that token and emit the end; anything else
    ; is ungotten and the end implied. (Mismatch-recovery is scoped to the
    ; conforming corpus: an implied end at the start location.)
    function end_tag_empty_element(this: Parser, e: ref[ElementType], net: bool, included: bool, start_loc: Location)
    {
        var m econMode
        if net
            set m: econnetMode
        let token ps.get_token(m)
        if (token = tokenNet) and net
        {
            let endev Event.make_end(ps.event_host(), e, ps.current_location())
            endev.set_has_markup()
            if included
                endev.set_included()
            ps.queue_event(endev)
            ps.note_end_element(included)
            return
        }
        if token = tokenEtagoTagc
        {
            ; endTagEmptyElement (parseInstance.cxx:900): `</>` closing an
            ; EMPTYNRM element warns under -wempty.
            let opt_e ps.get_options()
            if opt_e.warn_empty_tag
                this.report0_at(ParserMessages.emptyEndTag(), ps.current_input().token_start_location())
            let endev Event.make_end(ps.event_host(), e, ps.current_location())
            endev.set_has_markup()
            if included
                endev.set_included()
            ps.queue_event(endev)
            ps.note_end_element(included)
            return
        }
        if token = tokenEtagoNameStart
        {
            let end this.parse_end_tag()
            if (end <> null) and (end.get_element_type() = e)
            {
                if included
                    end.set_included()
                ps.queue_event(end)
                ps.note_end_element(included)
                return
            }
            ; the following end tag names a DIFFERENT element. If that element is
            ; open, this empty element's (implied) end comes first, then the end
            ; tag closes the enclosing element (endTagEmptyElement: implyEmptyElementEnd
            ; then acceptEndTag). Dropping it here (the old behavior) left the
            ; enclosing element to be closed at document end — a spurious
            ; omitEndTag/notFinished diagnostic. `parse_end_tag` already returns null
            ; (and reports elementNotOpen) for an UNDECLARED name.
            if end <> null
            {
                let cs ps.get_content_state()
                if cs.element_is_open(end.get_element_type())
                {
                    ; implyEmptyElementEnd (parseInstance.cxx:947): the implied
                    ; end event carries the CURRENT location, not the start's
                    ; (probed: -oline anchors `)content` on the line of the
                    ; token that implied it).
                    let endev2 Event.make_end(ps.event_host(), e, ps.current_location())
                    if included
                        endev2.set_included()
                    ps.queue_event(endev2)
                    ps.note_end_element(included)
                    this.accept_end_tag(end)
                    return
                }
                ; declared but not open: elementNotOpen, then imply this end.
                let mt_notopen ParserMessages.elementNotOpen()
                let gi_notopen end.get_element_type().get_name()
                this.report1_at(mt_notopen, gi_notopen, end.get_loc())
            }
            let endev4 Event.make_end(ps.event_host(), e, ps.current_location())
            if included
                endev4.set_included()
            ps.queue_event(endev4)
            ps.note_end_element(included)
            return
        }
        ; not the element's end: imply the end at the CURRENT location — the
        ; peeked token's start (implyEmptyElementEnd runs BEFORE ungetToken) —
        ; then unget.
        let imply_loc ps.current_input().token_start_location()
        ps.current_input().unget_token()
        let endev3 Event.make_end(ps.event_host(), e, imply_loc)
        if included
            endev3.set_included()
        ps.queue_event(endev3)
        ps.note_end_element(included)
    }

    ; implyCurrentElementEnd — emit an implied end for the current element and
    ; pop it (used when an end tag or document end closes elements above it whose
    ; own end tags were omitted). omitEndTag diagnostics deferred.
    function imply_current_element_end(this: Parser, loc: Location)
    {
        let cs ps.get_content_state()
        let ce cs.current_element()
        let e ce.get_type()
        ; implyCurrentElementEnd (parseInstance.cxx): an end tag is being OMITTED
        ; for the current element. If OMITTAG NO is in force it may never be
        ; omitted (omitEndTagOmittag); otherwise the element's declaration must
        ; permit omission (omitEndTagDeclare when it does not). Both carry a
        ; "start tag was here" auxiliary line at the element's start location.
        let gi_omit e.get_name()
        let start_here ce.get_start_location()
        if ps.get_sd().omittag() = false
        {
            let mt_omittag ParserMessages.omitEndTagOmittag()
            let aux_omittag ParserMessages.omitEndTagOmittag_aux()
            this.report1_aux(mt_omittag, gi_omit, loc, aux_omittag, start_here)
        }
        else
        {
            let def e.get_definition()
            if def <> null
                if def.can_omit_end_tag() = false
                {
                    let mt_declare ParserMessages.omitEndTagDeclare()
                    let aux_declare ParserMessages.omitEndTagDeclare_aux()
                    this.report1_aux(mt_declare, gi_omit, loc, aux_declare, start_here)
                }
        }
        ps.note_end_element(ce.get_included())
        let endev Event.make_end(ps.event_host(), e, loc)
        if ce.get_included()
            endev.set_included()
        ps.queue_event(endev)
        ps.pop_element_mode()
    }

    ; close the current element WITHOUT an omitted-end-tag diagnostic — used when
    ; the end is genuinely marked (a NET null end tag closing its net-enabling
    ; element), where onsgmls emits a real EndElementEvent via acceptEndTag rather
    ; than implyCurrentElementEnd.
    function close_current_element(this: Parser, loc: Location)
    {
        let cs ps.get_content_state()
        let ce cs.current_element()
        let e ce.get_type()
        ps.note_end_element(ce.get_included())
        let endev Event.make_end(ps.event_host(), e, loc)
        ; the NET null end tag carries markup (parseNullEndTag: dNET).
        endev.set_has_markup()
        if ce.get_included()
            endev.set_included()
        ps.queue_event(endev)
        ps.pop_element_mode()
    }

    ; parseNullEndTag — a NET delimiter (`>` under the XML/scaly syntax) closes
    ; the nearest net-enabling element on the stack, implying ends of any
    ; INTERVENING open elements first (each via implyCurrentElementEnd, which
    ; complains if it is unfinished / may not be omitted). The net-enabling
    ; element itself is closed by a genuine (null) end tag — no omission
    ; diagnostic — but still elementEndTagNotFinished if its model is unsatisfied.
    function parse_null_end_tag(this: Parser)
    {
        let cs ps.get_content_state()
        var guard: int 0
        var running true
        while running and (cs.tag_level_of() > 0)
        {
            let ce cs.current_element()
            if ce.get_net_enabling()
            {
                if (ce.is_finished() = false) and ps.validate()
                {
                    let mt_endnotfin ParserMessages.elementEndTagNotFinished()
                    let gi_endnotfin ce.get_type().get_name()
                    this.report1(mt_endnotfin, gi_endnotfin)
                }
                this.close_current_element(ps.current_location())
                set running: false
            }
            else
            {
                if (ce.is_finished() = false) and ps.validate()
                {
                    let mt_notfin ParserMessages.elementNotFinished()
                    let gi_notfin ce.get_type().get_name()
                    this.report1(mt_notfin, gi_notfin)
                }
                this.imply_current_element_end(ps.current_location())
            }
            set guard: guard + 1
            if guard > 100000
                set running: false
        }
    }

    function accept_end_tag(this: Parser, event: ref[Event]?)
    {
        if event = null
            return
        let e event.get_element_type()
        let cs ps.get_content_state()
        if cs.element_is_open(e) = false
        {
            ; a stray end tag naming an element that is nowhere open
            ; (acceptEndTag, parseInstance.cxx): elementNotOpen, drop the tag.
            ; Reported at the end tag's location (captured before its TAGC).
            let gi e.get_name()
            let eloc event.get_loc()
            let mt_notopen ParserMessages.elementNotOpen()
            this.report1_at(mt_notopen, gi, eloc)
            return
        }
        ; Close intervening open elements (OMITTAG end-tag omission) until the
        ; current element is the one this end tag names.
        var guard: int 0
        var running true
        while running
        {
            let ce cs.current_element()
            if ce.get_type() = e
                set running: false
            else
            {
                ; an intervening open element is being closed by omission: if its
                ; own content model is unsatisfied, elementNotFinished.
                if (ce.is_finished() = false) and ps.validate()
                {
                    let mt_notfin ParserMessages.elementNotFinished()
                    let gi_notfin ce.get_type().get_name()
                    this.report1_at(mt_notfin, gi_notfin, event.get_loc())
                }
                this.imply_current_element_end(event.get_loc())
                set guard: guard + 1
                if guard > 100000
                    return
            }
        }
        let cef cs.current_element()
        ; the named element itself: if its content model is unsatisfied at its
        ; explicit end tag, elementEndTagNotFinished.
        if (cef.is_finished() = false) and ps.validate()
        {
            let mt_endnotfin ParserMessages.elementEndTagNotFinished()
            let gi_endnotfin cef.get_type().get_name()
            this.report1_at(mt_endnotfin, gi_endnotfin, event.get_loc())
        }
        if cef.get_included()
            event.set_included()
        ps.note_end_element(event.is_included())
        ps.queue_event(event)
        ps.pop_element_mode()
    }

    function accept_pcdata(this: Parser, loc: Location)
    {
        let cs ps.get_content_state()
        let ce cs.current_element()
        if ce.try_transition_pcdata()
            return
        ; need to test here since implying tags may turn off pcdataRecovering.
        if ps.is_pcdata_recovering()
            return
        ; OMITTAG: imply end/start tags speculatively until #PCDATA is admissible.
        var start_implied: u32 0
        let undo Array[UndoEntry]^host()
        let events Array[ref[Event]?]^host()
        ps.keep_messages()
        while this.try_imply_tag(loc, &start_implied, undo, events)
        {
            let cei cs.current_element()
            if cei.try_transition_pcdata()
            {
                this.queue_element_events(events)
                return
            }
        }
        ps.discard_kept_messages()
        this.undo_all(undo)
        ; pcdataNotAllowed (parseInstance.cxx:635) — a plain message() at the
        ; current token; then recover (switch to the mixed-content mode and
        ; suppress repeats until an element pushes or pops).
        if ps.validate() or cs.after_document_element()
            this.report0_at(ParserMessages.pcdataNotAllowed(), ps.current_input().token_start_location())
        ps.pcdata_recover()
    }

    ; Parser::extendData (parseInstance.cxx:1181) — grow the data token over the
    ; whole run of NORMAL characters. The reference calls this "one of the
    ; parser's inner loops, so it needs to be fast", and it is the difference
    ; between one data event per RUN and one per CHARACTER.
    ;
    ; ★Measured 2026-08-05, before this existed: a 1 MB text run produced
    ; 1 000 000 data events, 5.0 allocations and 214 bytes of region churn PER
    ; INPUT BYTE. On the large-model tier (6.16 MB in, 17 files out) that
    ; was 19.3 M allocations and 865 MB of churn — the reason that tier was the
    ; port's worst instruction ratio against openjade (4.1x).
    ;
    ; The scan deliberately reads ONE character too far (the non-normal one that
    ; ends the run) and `end_token` puts it back: cur = start + length, exactly
    ; as InputSource::endToken does.
    function extend_data(this: Parser)
    {
        let map ps.get_normal_map()
        if map = null
            return
        let ins ps.current_input()
        if ins = null
            return
        var length ins.current_token_length()
        var scanning true
        while scanning
        {
            let c ins.token_char_in_buffer()
            if map.get(c) = 0
                set scanning: false
            else
                set length: length + 1
        }
        ins.end_token(length)
    }

    function parse_pcdata(this: Parser)
    {
        this.extend_data()
        let ins ps.current_input()
        let ts ins.current_token_string()
        ; the data token's START (the reference's currentLocation()) — an
        ; element implied by this data carries it as its start location.
        let loc ins.token_start_location()
        this.accept_pcdata(loc)
        ps.note_data()
        let ev Event.make_data(ps.event_host(), ts, loc)
        ps.queue_event(ev)
        ; reportNonSgmlCharacter (parseInstance.cxx): a non-SGML char in the data
        ; run is still emitted as data (onsgmls does the same) but reported at its
        ; own location. The token slice maps 1:1 onto [start_index, cur_index).
        this.check_non_sgml(ts, ins.get_origin(), ins.current_token_start_index())
    }

    ; a document character NOT in the SGML character set — the set the
    ; DECLARATION describes (CharsetDecl::usedSet: every non-UNUSED range).
    ; A document with its own SGML declaration installs its set (xml.dcl's, for
    ; instance, runs to U+FFFD), and without one the built-in REFERENCE
    ; declaration applies: DESCSET leaves the C0 controls other than
    ; TAB/RS/RE (9/10/13) UNUSED, then DEL (127) and the whole C1 range
    ; 128..159 (the ECMA-94 right part starts at 160), so those are the
    ; non-SGML chars. Measured against onsgmls: bytes 0x82 and 0x9F in an
    ; 8-bit-read document report nonSgmlCharacter, 0xA0..0xFF do not.
    ;
    ; This stays SEPARATE from Syntax.setSgmlChar (deliberately widened to
    ; 0..U+FFFD in this port so a stray decoded char stays DATA rather than
    ; aborting tokenization) — the predicate only drives the diagnostic.
    function is_non_sgml_char(this: Parser, c: u32) returns bool
    {
        let declared ps.get_declared_sgml_chars()
        if declared <> null
            return declared.contains(c) = false
        if c <= 8
            return true
        if (c = 11) or (c = 12)
            return true
        if (c >= 14) and (c <= 31)
            return true
        if c = 127
            return true
        if (c >= 128) and (c <= 159)
            return true
        ; ★and 255: the reference declaration's right part is the ECMA-94 one,
        ; 160..254 — 0xFF is left UNUSED. Measured byte by byte against onsgmls:
        ; of 0x80..0xFF exactly 0x80..0x9F and 0xFF report nonSgmlCharacter.
        if c = 255
            return true
        false
    }

    function check_non_sgml(this: Parser, ts: StringC, origin: ref[Origin], start: size_t)
    {
        var i: size_t 0
        let n ts.get_size()
        while i < n
        {
            let c ts.get(i)
            if this.is_non_sgml_char(c)
            {
                ; construct the MessageType lazily — this loop runs per data
                ; token, and a speculative construction widens the message
                ; literal onto the run arena millions of times per parse.
                let mt ParserMessages.nonSgmlCharacter()
                let cloc Location(origin, (start + i) as u32)
                this.report_num_at(mt, c as u64, cloc)
            }
            set i: i + 1
        }
    }


    ; endAllElements (parseInstance.cxx:1118). Closes every still-open element,
    ; complaining about each one whose content model is unsatisfied, and then —
    ; once the stack is back down to the synthetic document-element container —
    ; complains if even THAT is unfinished, i.e. the document element never
    ; appeared. That last check is what makes a prolog-only document (a DOCTYPE
    ; and nothing else) non-conforming: `E: no document element`, exit 1, and an
    ; empty ESIS because the `C` marker is gated on conformance.
    function end_all_elements(this: Parser)
    {
        let cs ps.get_content_state()
        var running true
        while running
        {
            if cs.tag_level_of() = 0
                set running: false
            else
            {
                let ce cs.current_element()
                if ce.is_finished() = false
                {
                    ; elementNotFinishedDocumentEnd (no validate() guard in the
                    ; reference) — the open element's content model is unsatisfied
                    ; at end of document. Reported at the current scan cursor.
                    let mt_docend ParserMessages.elementNotFinishedDocumentEnd()
                    let gi_docend ce.get_type().get_name()
                    this.report1(mt_docend, gi_docend)
                }
                ; implyCurrentElementEnd — closes it (and complains if its end tag
                ; may not be omitted here).
                this.imply_current_element_end(ps.current_location())
            }
        }
        let root cs.current_element()
        if root.is_finished() = false
            if ps.validate()
            {
                this.report0(ParserMessages.noDocumentElement())
            }
    }

    function end_instance(this: Parser)
    {
        this.end_all_elements()
        ; unclosedMarkedSection (parseInstance.cxx:60): every still-open marked
        ; section reports "missing marked section end" at the current location
        ; (EOF) with a "marked section started here" auxiliary at its MDO.
        while ps.get_marked_section_level() > 0
        {
            let ms_loc ps.current_marked_section_start_location()
            this.report0_aux(ParserMessages.unclosedMarkedSection(), ps.current_location(), ParserMessages.unclosedMarkedSection_aux(), ms_loc)
            ps.end_marked_section()
        }
        this.check_idrefs()
        ps.pop_input_stack()
    }

    ; checkIdrefs (parseInstance.cxx:70): at document end, every pending IDREF
    ; whose target ID was never defined reports missingId (X1, IdrefError —
    ; counts toward the error exit like any error) at the REFERENCE's location.
    ; The iteration is the id table's raw bucket order (PointerTableIter), NOT
    ; document order — the IdTable port preserves the reference's hash layout
    ; precisely so this message order is byte-identical.
    function check_idrefs(this: Parser)
    {
        let t ps.get_id_table()
        let n (*t).bucket_count()
        var i: size_t 0
        while i < n
        {
            let id (*t).bucket_at(i)
            if id <> null
            {
                let m id.n_pending_refs()
                var j: size_t 0
                while j < m
                {
                    let rloc id.pending_ref_at(j)
                    this.report1_at(ParserMessages.missingId(), id.get_name(), rloc)
                    set j: j + 1
                }
            }
            set i: i + 1
        }
    }

    ; parseMarkedSectionDeclStart (parseDecl.cxx) — after tokenMdoDso, read the
    ; status keywords up to the DSO that opens the section body, then enter the
    ; section: INCLUDE parses normally; CDATA/RCDATA/IGNORE switch to a special
    ; parse mode until the matching `]]>` (handleMarkedSectionEnd). A `<![` nested
    ; inside an already-special (ignored) section is itself ignored content.
    function parse_marked_section_decl_start(this: Parser) returns bool
    {
        ; the section's start (its MDO-DSO) — the unclosedMarkedSection aux.
        let ms_start ps.current_input().token_start_location()
        ; parseDecl.cxx:3404 — marked sections nest against TAGLVL.
        let mstaglvl_q ps.get_syntax().get_quantity(qTAGLVL)
        if ps.get_marked_section_level() = mstaglvl_q
            this.report_num_at(ParserMessages.markedSectionLevel(), mstaglvl_q as u64, ps.current_input().token_start_location())
        ; parseDecl.cxx:3407: a marked section in the internal DTD subset warns
        ; under -winternal-subset-ms (top-level input only).
        let opt_ms ps.get_options()
        if ps.is_in_instance() = false
        {
            if opt_ms.warn_internal_subset_marked_section and (ps.get_input_level() = 1)
                this.report0_at(ParserMessages.internalSubsetMarkedSection(), ms_start)
        }
        if ps.get_marked_section_special_level() > 0
        {
            ps.start_marked_section(ms_start)
            return true
        }
        ; parseDecl.cxx:3433: the warn-only discard Markup that feeds the
        ; -winstance-status-keyword-s replay (see note_ms_s).
        var track_s false
        if opt_ms.warn_instance_status_keyword_spec_s
        {
            if ps.is_in_instance()
                set track_s: true
        }
        if track_s
            ps.start_ms_s_tracking()
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        var codes int[6]
        let cp codes as pointer[int]
        set *(cp + 0): P_DSO
        set *(cp + 1): P_RESERVED_NAME + R_CDATA
        set *(cp + 2): P_RESERVED_NAME + R_RCDATA
        set *(cp + 3): P_RESERVED_NAME + R_IGNORE
        set *(cp + 4): P_RESERVED_NAME + R_INCLUDE
        set *(cp + 5): P_RESERVED_NAME + R_TEMP
        let allow AllowedParams.an(host, cp, 6)
        if this.parse_param(allow, decl_input_level, parm) = false
        {
            ps.stop_ms_s_tracking()
            return false
        }
        ; parseDecl.cxx:3449: a bare `<![[` warns under -wmissing-status-keyword.
        if opt_ms.warn_missing_status_keyword and (parm.kind = P_DSO)
            this.report0_at(ParserMessages.missingStatusKeyword(), ps.current_input().token_start_location())
        var status: int MS_INCLUDE
        var running true
        while running
        {
            if parm.kind = P_DSO
                set running: false
            else
            {
                if parm.kind = (P_RESERVED_NAME + R_CDATA)
                {
                    if status < MS_CDATA
                        set status: MS_CDATA
                }
                else if parm.kind = (P_RESERVED_NAME + R_RCDATA)
                {
                    if status < MS_RCDATA
                        set status: MS_RCDATA
                    ; parseDecl.cxx:3460: warns under -wrcdata-ms.
                    if opt_ms.warn_rcdata_marked_section
                        this.report0_at(ParserMessages.rcdataMarkedSection(), ps.current_input().token_start_location())
                }
                else if parm.kind = (P_RESERVED_NAME + R_IGNORE)
                {
                    if status < MS_IGNORE
                        set status: MS_IGNORE
                    ; parseDecl.cxx:3466: warns under -winstance-ignore-ms.
                    if ps.is_in_instance() and opt_ms.warn_instance_ignore_marked_section
                        this.report0_at(ParserMessages.instanceIgnoreMarkedSection(), ps.current_input().token_start_location())
                }
                else if parm.kind = (P_RESERVED_NAME + R_INCLUDE)
                {
                    ; parseDecl.cxx:3470: warns under -winstance-include-ms
                    ; (no status bump — include is the minimum).
                    if ps.is_in_instance() and opt_ms.warn_instance_include_marked_section
                        this.report0_at(ParserMessages.instanceIncludeMarkedSection(), ps.current_input().token_start_location())
                }
                else if parm.kind = (P_RESERVED_NAME + R_TEMP)
                {
                    ; parseDecl.cxx:3474: warns under -wtemp-ms.
                    if opt_ms.warn_temp_marked_section
                        this.report0_at(ParserMessages.tempMarkedSection(), ps.current_input().token_start_location())
                }
                if this.parse_param(allow, decl_input_level, parm) = false
                {
                    ps.stop_ms_s_tracking()
                    return false
                }
                ; parseDecl.cxx:3481: a second status keyword warns under
                ; -wmultiple-status-keyword (at the NEW keyword's start).
                if opt_ms.warn_multiple_status_keyword and (parm.kind <> P_DSO)
                    this.report0_at(ParserMessages.multipleStatusKeyword(), ps.current_input().token_start_location())
            }
        }
        ps.stop_ms_s_tracking()
        if status = MS_INCLUDE
            ps.start_marked_section(ms_start)
        else if status = MS_CDATA
            ps.start_special_marked_section(cmsMode, ms_start)
        else if status = MS_RCDATA
            ps.start_special_marked_section(rcmsMode, ms_start)
        else
            ps.start_special_marked_section(imsMode, ms_start)
        ; parseDecl.cxx:3506: replay the recorded S runs (see note_ms_s for the
        ; reference's shifted-location artifact).
        if track_s
        {
            let syn_ms ps.get_syntax()
            let shift ((syn_ms.delim_general_len(dMDO) + syn_ms.delim_general_len(dDSO)) as u32)
            ; with instance markup wanted (-otagomit: addInstanceMarkup sets
            ; markedSections_) the reference's markup is REAL — it carries the
            ; MDO/DSO entries and the walk reports TRUE positions; the shift
            ; artifact exists only on the warn-only discard markup (probed:
            ; -otagomit renders 5:8 where the plain run renders 5:5).
            let no_shift ps.output_flag(OF_TAG_OMISSION)
            var si: size_t 0
            let sn ps.ms_s_count()
            while si < sn
            {
                let item ps.ms_s_item_at(si)
                let iloc item.loc
                var rloc iloc
                if (item.synced = false) and (no_shift = false)
                    set rloc: Location(iloc.get_origin(), iloc.get_index() - shift)
                this.report0_at(ParserMessages.instanceStatusKeywordSpecS(), rloc)
                set si: si + 1
            }
        }
        true
    }

    ; handleMarkedSectionEnd (parseDecl.cxx) — a `]]>`: close the innermost open
    ; marked section (the state machine restores the enclosing mode). The markup /
    ; ignored-chars events are not wanted for ESIS.
    function handle_marked_section_end(this: Parser)
    {
        if ps.get_marked_section_level() = 0
        {
            ; markedSectionEnd (parseDecl.cxx:3528): a `]]>` outside any marked
            ; section declaration. E0 — no argument; location = the MSC token start.
            let loc ps.current_input().token_start_location()
            this.report0_at(ParserMessages.markedSectionEnd(), loc)
        }
        else
            ps.end_marked_section()
    }

    ; parseEntityReference (parseCommon.cxx, scoped): `&name;` in content. Read the
    ; entity name (NAMECASE ENTITY NO -> raw), consume the REFC, look it up, and
    ; push its text as a new input source (contentReference -> normalReference):
    ; an internal entity stacks its replacement text, an external text entity is
    ; opened from disk. Char-data (CDATA/SDATA/NDATA/subdoc) entities emit events
    ; instead of stacking and are deferred.
    ;
    ; Entity::checkEntlvl + checkNotOpen guard the two ways a reference can fail to
    ; terminate: nesting deeper than ENTLVL, and an entity that (transitively)
    ; references itself — the latter is caught by identity against the open input
    ; stack (ParserState.entity_is_open), so the entity's decl travels in the
    ; source's Origin.
    ; createUndefinedEntity (ParserState.cxx): fabricate an undefined external text
    ; entity with an EMPTY external id (no system id), remember it in the
    ; undefined-entity table keyed by name (so subsequent references reuse it), and
    ; run generateSystemId — with no entity catalog to map the name to a storage id
    ; it always fails, reporting cannotGenerateSystemIdGeneral (Warning) at the
    ; entity-name location. def_loc (the reference site) becomes the entity's
    ; defLocation, later used as the nonExistentEntityRef auxiliary. Returns the
    ; entity so the reference proceeds (and fails to open → nonExistentEntityRef).
    function create_undefined_entity(this: Parser, name: StringC, def_loc: Location, name_loc: Location) returns ref[Entity]
    {
        let hname StringC^host(name.data_ptr(), name.get_size())
        let ent host.allocate(sizeof Entity, alignof Entity) as pointer[Entity]
        set *ent: Entity.ExternalText(ExternalTextEntity(hname, ExternalId(), String(), def_loc))
        ps.add_undefined_entity(ent)
        this.report1_at(ParserMessages.cannotGenerateSystemIdGeneral(), hname, name_loc)
        ent
    }

    ; the RESOLUTION half of parseEntityReference (parseCommon.cxx:429),
    ; shared by the content context (contentReference/rcdataReference — the
    ; parse_entity_reference wrapper below) and the literal context
    ; (litReference — parse_literal's ERO arm): read the name (+ optional name
    ; group), consume the REFC, resolve through the defaulted/undefined-entity
    ; machinery. Returns false on a hard parse failure; *out_ent = null means
    ; the reference was consumed and dropped (ignored name group / no
    ; applicable DTD / IMPLYDEF-implied).
    function resolve_general_entity_ref(this: Parser, name_group: bool, out_ent: pointer[pointer[Entity]], out_name: ref[StringC], out_ref_start: ref[Location], out_ref_len: ref[size_t], out_refc_loc: ref[Location]) returns bool
    {
        set *out_ent: null
        let ins ps.current_input()
        ; the reference start (the CRO `&`) is the current token's start, captured
        ; BEFORE discard_initial peels the delimiter — EntityOrigin's refLocation.
        ; (Out-params are written straight from the accessor call — a Location
        ; held in a LOCAL reads as local-page to the escape checker when stored
        ; through a pointer.)
        let ref_start ins.token_start_location()
        set out_ref_start: ps.current_input().token_start_location()
        ; parseEntityReference ignoreLevel 1 (parseCommon.cxx:440): an ERO with
        ; a name group (`&(doc)name;`, CONCUR/LINK) — parse the group first; an
        ; inactive group turns the whole reference into an IgnoredEntity.
        var ignore false
        if name_group
        {
            if this.parse_entity_reference_name_group(&ignore) = false
                return false
            ins.start_token()
            let gc ins.token_char()
            var gns false
            if gc >= 0
                set gns: ps.get_syntax().is_name_start_character(gc as u32)
            if gns = false
            {
                this.report0_at(ParserMessages.entityReferenceMissingName(), ins.token_start_location())
                return false
            }
        }
        ins.discard_initial()
        this.extend_name_token(this.namelen(), ParserMessages.nameLength())
        let name ps.current_token^host()
        ; the entity-name start (cannotGenerateSystemId + entityUndefined point here).
        let name_loc ins.token_start_location()
        let dtd ps.get_current_dtd()
        var ent: ref[Entity]? null
        if ignore = false
            set ent: this.lookup_entity_or_default(false, name)
        ; consume the REFC (`;`) or record-end that terminates the reference.
        let refc ps.get_token(refMode)
        ; the REFC location (nonExistentEntityRef points here) — the current token
        ; start, before the cursor advances past `;`.
        let refc_loc ins.token_start_location()
        set out_refc_loc: ps.current_input().token_start_location()
        ; parseCommon.cxx:517: a reference not closed by the REFC warns under
        ; -wrefc.
        let opt_rf2 ps.get_options()
        if opt_rf2.warn_refc and (refc <> tokenRefc)
            this.report0_at(ParserMessages.refc(), refc_loc)
        ; refLength = the full span of `&name;` (parseCommon.cxx): the cursor now
        ; sits just past the reference, so end − start is its length.
        let ref_len (ins.here_location().get_index() - ref_start.get_index()) as size_t
        if ignore
        {
            ; an inactive name group makes this an IgnoredEntity reference
            ; (parseCommon.cxx:476): name and REFC consumed, no event, no
            ; undefined-entity machinery.
            return true
        }
        if ent = null
        {
            ; lookupEntity with no applicable DTD (parseCommon.cxx:494) —
            ; entityApplicableDtd instead of the undefined-entity handling.
            ; Content always has a current DTD; this mirrors the reference's
            ; branch for the no-DTD windows.
            if dtd = null
            {
                this.report0_at(ParserMessages.entityApplicableDtd(), name_loc)
                return true
            }
            ; parseCommon.cxx: an undefined general-entity reference. IMPLYDEF
            ; ENTITY implies undefined entities (that handling is deferred — drop).
            if ps.get_sd().implydef_entity()
                return true
            ; createUndefinedEntity, cached by name: on the FIRST reference build the
            ; undefined entity (which reports cannotGenerateSystemIdGeneral) + report
            ; entityUndefined; a later reference reuses it silently. Either way the
            ; entity is referenced below and, having no system id, fails to open →
            ; nonExistentEntityRef fires on EVERY reference.
            var uent ps.lookup_undefined_entity(name)
            if uent = null
            {
                set uent: this.create_undefined_entity(name, ref_start, name_loc)
                this.report1_at(ParserMessages.entityUndefined(), name, name_loc)
            }
            set ent: uent
        }
        else if ps.entity_is_defaulted(ent)
        {
            ; parseCommon.cxx:496: a reference resolving through the default
            ; entity warns under -wdefault.
            let opt_de ps.get_options()
            if opt_de.warn_default_entity_reference
                this.report1_at(ParserMessages.defaultEntityReference(), name, name_loc)
        }
        set *out_ent: ent
        set out_name: name
        set out_ref_len: ref_len
        true
    }

    ; parseEntityReference in CONTENT (doContent's ERO arm, parseInstance.cxx
    ; :142): character-data entities accept pcdata at the reference position;
    ; the special (RCDATA) parse dispatches rcdataReference instead of
    ; contentReference (inputLevel == specialParseInputLevel).
    function parse_entity_reference(this: Parser, name_group: bool) returns bool
    {
        var ent: pointer[Entity] null
        var name StringC()
        var ref_start Location()
        var ref_len: size_t 0
        var refc_loc Location()
        if this.resolve_general_entity_ref(name_group, &ent, &name, &ref_start, &ref_len, &refc_loc) = false
            return false
        if ent = null
            return true
        ; acceptPcdata(Location(origin, 0)) — the reference passes offset 0 of
        ; a fresh EntityOrigin, NOT the flattened cursor: in default mode both
        ; display as the position just past `&name;` (the walk discards the
        ; entity-internal index at the origin hop), but under -e the walk
        ; resolves INTO the entity via defLocation, so an implied start tag's
        ; "start tag was here" auxiliary must point at the replacement text's
        ; definition site with an "In entity" header.
        if this.entity_is_character_data(ent)
        {
            let porg host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
            set *porg: Origin(ref_start, ent as pointer[void], ref_len)
            this.accept_pcdata(Location(porg, 0))
        }
        let rcdata ps.get_input_level() = ps.get_special_parse_input_level()
        this.content_reference_entity(ent, name, ref_start, ref_len, refc_loc, rcdata)
    }

    ; Entity::checkRef (Entity.cxx:601/607) — the WWW `ENTITIES REF` feature:
    ; NONE forbids every entity reference, INTERNAL additionally allows only
    ; internal ones. Runs per reference in every context (content, rcdata,
    ; literal, declaration); PiEntity and IgnoredEntity run NO check.
    function check_ref_internal(this: Parser, loc: Location)
    {
        if ps.get_sd().entity_ref() = ENTITY_REF_NONE
            this.report0_at(ParserMessages.entityRefNone(), loc)
    }

    function check_ref_external(this: Parser, loc: Location)
    {
        if ps.get_sd().entity_ref() <> ENTITY_REF_ANY
            this.report0_at(ParserMessages.entityRefInternal(), loc)
    }

    ; Entity::checkEntlvl (Entity.cxx:583): nesting deeper than ENTLVL is a
    ; diagnostic only — the entity is still stacked (the document entity is
    ; not counted). Recursion stays bounded by checkNotOpen.
    function check_entlvl(this: Parser)
    {
        let entlvl ps.get_syntax().get_quantity(qENTLVL)
        if (ps.get_input_level() - (1 as u32)) = entlvl
            this.report_num_at(ParserMessages.entlvl(), entlvl as u64, ps.current_input().token_start_location())
    }

    ; Entity::isCharacterData (per-class): internal CDATA with non-empty text,
    ; internal SDATA, external non-text (data/subdoc).
    function entity_is_character_data(this: Parser, ent: ref[Entity]) returns bool
    {
        choose ent
            when i: Internal
            {
                let dt i.get_data_type()
                if dt = DT_CDATA
                {
                    let it i.get_text()
                    return it.get_size() > 0
                }
                if dt = DT_SDATA
                    return true
                return false
            }
            when d: ExternalData
                return true
            when sub: Subdoc
                return true
        false
    }

    ; Entity::contentReference / rcdataReference and the normalReference
    ; dispatch (Entity.cxx) — shared by named general-entity references
    ; (parse_entity_reference) and short references (handle_shortref, whose
    ; "reference" is the shortref delimiter token itself; always content
    ; context). The reference checks (checkRef, checkEntlvl, checkNotOpen)
    ; run INSIDE the per-class arms, in reference order; a PI entity runs
    ; NO checks (PiEntity::normalReference).
    function content_reference_entity(this: Parser, ent: ref[Entity], name: StringC, ref_start: Location, ref_len: size_t, refc_loc: Location, rcdata: bool) returns bool
    {
        choose ent
            when i: Internal
            {
                let dt i.get_data_type()
                if dt = DT_PI
                {
                    ; PiEntity::rcdataReference (Entity.cxx:322): a PI entity
                    ; is not allowed in replaceable character data.
                    if rcdata
                    {
                        this.report0_at(ParserMessages.piEntityRcdata(), refc_loc)
                        return true
                    }
                    ; PiEntity::normalReference (Entity.cxx:307): noteMarkup +
                    ; a PiEntityEvent (the writer's `?text` line) — no checks,
                    ; nothing stacks.
                    ps.note_markup()
                    let ptext i.get_text()
                    let pev Event.make_pi(ps.event_host(), ptext, ref_start)
                    ; PiEntityEvent carries the entity (PiEvent::entity()) —
                    ; the grove builds a PiEntityNode from it, whose
                    ; entity-name / entity are non-null where a plain PI's are
                    ; accessNull (spgrove/GroveBuilder.cxx PiNode::add).
                    set pev.entity: ent
                    ps.queue_event(pev)
                    return true
                }
                if dt = DT_CDATA
                {
                    ; InternalCdataEntity::normalReference (Entity.cxx:339):
                    ; checkRef + checkEntlvl; non-empty text emits a
                    ; CdataEntityEvent — a DataEvent, the chars are DATA and
                    ; are never re-scanned as markup; empty text emits nothing.
                    ; The event's location is Location(entityOrigin, 0) — the
                    ; reference's DataEntityEvent ctor — NOT the reference
                    ; site: the grove keys data-chunk coalescing on the loc
                    ; origin, so a CDATA entity always lands in its own chunk.
                    this.check_ref_internal(refc_loc)
                    this.check_entlvl()
                    let ctext i.get_text()
                    if ctext.get_size() > 0
                    {
                        ps.note_data()
                        let corg host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
                        set *corg: Origin(ref_start, ent as pointer[void], ref_len)
                        let cev Event.make_data(ps.event_host(), ctext, Location(corg, 0))
                        ps.queue_event(cev)
                    }
                    return true
                }
                if dt = DT_SDATA
                {
                    ; InternalSdataEntity::normalReference (Entity.cxx:376):
                    ; checkRef + checkEntlvl + an SdataEntityEvent (written
                    ; inline into the data run between `\|` markers).
                    this.check_ref_internal(refc_loc)
                    this.check_entlvl()
                    ps.note_data()
                    let stext i.get_text()
                    let sev Event.make_sdata(ps.event_host(), stext, ref_start)
                    ; SdataEntityEvent::entity() — the grove's sdata node keeps
                    ; it for `entity-name` / `entity`, and the SdataMapper folds
                    ; the entity NAME before the replacement text.
                    set sev.entity: ent
                    ps.queue_event(sev)
                    return true
                }
                ; InternalTextEntity::normalReference (Entity.cxx:411):
                ; checkRef + checkEntlvl + checkNotOpen, then the replacement
                ; text stacks as a new input source. checkNotOpen fires from
                ; INSIDE the entity's replacement text on recursion;
                ; resolve_location walks the origin chain (ref_start + ref_len
                ; on the pushed origin) so the reported file:line:col is
                ; byte-identical to onsgmls.
                this.check_ref_internal(refc_loc)
                this.check_entlvl()
                if ps.entity_is_open(ent as pointer[void])
                {
                    this.report1_at(ParserMessages.recursiveEntityReference(), name, refc_loc)
                    return true
                }
                let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
                set *org: Origin(ref_start, ent as pointer[void], ref_len)
                let itext i.get_text()
                let isrc host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
                set *isrc: InputSource(org, itext.data_ptr(), itext.get_size())
                ps.push_input(isrc)
            }
            when e: ExternalText
            {
                ; ExternalTextEntity::normalReference (Entity.cxx:435) — open
                ; the effective system id (resolved against the document's
                ; directory) and stack it. An external TEXT entity produces NO
                ; ESIS event: its content is included inline (only external
                ; DATA entities emit `&name`).
                this.check_ref_external(refc_loc)
                this.check_entlvl()
                if ps.entity_is_open(ent as pointer[void])
                {
                    this.report1_at(ParserMessages.recursiveEntityReference(), name, refc_loc)
                    return true
                }
                let id e.get_external_id()
                let fsi this.entity_fsi(id, e.get_base_dir())
                if fsi.get_length() = 0
                {
                    ; ExternalTextEntity::normalReference: no effective system id to
                    ; open → nonExistentEntityRef, at the REFC, with the entity's
                    ; declaration/first-reference site as the "entity was defined
                    ; here" auxiliary.
                    let ename e.get_name()
                    let edef e.get_def_location()
                    this.report1_aux(ParserMessages.nonExistentEntityRef(), ename, refc_loc, ParserMessages.nonExistentEntityRef_aux(), edef)
                    return true
                }
                let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
                set *org: Origin(ref_start, ent as pointer[void], ref_len)
                ; open through the effective id (catalog mappings, search
                ; dirs, -R); a failure reports at the reference site (the
                ; ParentLocationMessenger parent = the ERO) and drops the ref.
                var found String()
                let esrc this.fsi_open(fsi, org, ref_start, refc_loc, 0, &found)
                if esrc = null
                    return true
                ps.push_input(esrc)
            }
            when d: ExternalData
            {
                ; ExternalNonTextEntity::rcdataReference (Entity.cxx:520): a
                ; data entity is not allowed in replaceable character data.
                if rcdata
                {
                    this.report0_at(ParserMessages.externalNonTextEntityRcdata(), refc_loc)
                    return true
                }
                ; ExternalDataEntity::contentReference (Entity.cxx:476):
                ; checkRef + checkEntlvl (no checkNotOpen — nothing stacks),
                ; then an ExternalDataEntityEvent; the writer prints the
                ; entity's definition records (once per document) and the
                ; `&name` line. Warns under -wexternal-data-entity-ref first.
                let opt_ed ps.get_options()
                if opt_ed.warn_external_data_entity_ref
                    this.report0_at(ParserMessages.externalDataEntityRef(), refc_loc)
                this.check_ref_external(refc_loc)
                this.check_entlvl()
                ps.note_data()
                let dev Event.make_entity_ref(ps.event_host(), ent, ref_start)
                ps.queue_event(dev)
            }
            when sub: Subdoc
            {
                if rcdata
                {
                    this.report0_at(ParserMessages.externalNonTextEntityRcdata(), refc_loc)
                    return true
                }
                ; SubdocEntity::contentReference (Entity.cxx:526) — checkRef +
                ; checkEntlvl + a SubdocEntityEvent. onsgmls handles it by
                ; defining the subdoc entity, emitting `{name`, running a
                ; NESTED parser over the referenced document (its events
                ; stream inline), then `}name` (SgmlsEventHandler::
                ; subdocEntity). The preceding data run is already queued as
                ; an EV_DATA event; the writer's have_data flush breaks it
                ; before the `{` (like the `&name` data path).
                this.check_ref_external(refc_loc)
                this.check_entlvl()
                ps.note_data()
                this.parse_subdoc(ent, ref_start, ref_len)
            }
        true
    }

    ; Entity::litReference dispatch (Entity.cxx:287/300/357/393/426/459/512) —
    ; a general entity reference inside a literal (parse_literal's ERO arm).
    ; TEXT entities stack their replacement text like a content reference (the
    ; caller flips to the `e` mode variant); CDATA/SDATA entities add their
    ; text to the literal DIRECTLY — it is never re-scanned: with squeeze
    ; (literalSingleSpace, tokenized values) via Text::addCharsTokenize (a
    ; space that begins the value or follows a space is dropped), otherwise as
    ; a cdata/sdata ITEM (sdata items render between `\|` markers in the ESIS
    ; A record). PI entities are not allowed in literals (piEntityReference);
    ; external non-text entities report externalNonTextEntityRcdata (no
    ; checks, exactly like the reference).
    function lit_reference_entity(this: Parser, ent: ref[Entity], name: StringC, ref_start: Location, ref_len: size_t, refc_loc: Location, buf: ref[Array[u32]], locbuf: ref[Array[Location]], sruns: ref[Array[size_t]], hu: ref[HuState], squeeze: bool)
    {
        choose ent
            when i: Internal
            {
                let dt i.get_data_type()
                if dt = DT_PI
                {
                    ; PiEntity::litReference (Entity.cxx:300).
                    this.report0_at(ParserMessages.piEntityReference(), refc_loc)
                    return
                }
                if (dt = DT_CDATA) or (dt = DT_SDATA)
                {
                    ; InternalCdataEntity/InternalSdataEntity::litReference
                    ; (Entity.cxx:357/393): checkRef + checkEntlvl, then the
                    ; text joins the literal. Stored chars carry per-char
                    ; locations inside the entity (Location(origin, i) — the
                    ; reference's addCharsTokenize/addCdata loc threading).
                    ; The inserted chars are their own item (data chars under
                    ; squeeze, a cdata/sdata item otherwise) — either way the
                    ; unterminated-guess candidate resets around them.
                    this.check_ref_internal(refc_loc)
                    this.check_entlvl()
                    let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
                    set *org: Origin(ref_start, ent as pointer[void], ref_len)
                    let itext i.get_text()
                    let n itext.get_size()
                    hu.note_reset(buf)
                    if squeeze
                    {
                        ; Text::addCharsTokenize (Text.cxx:74).
                        let space: u32 0x20
                        var ci: size_t 0
                        while ci < n
                        {
                            let c itext.get(ci)
                            var drop false
                            if c = space
                            {
                                if (buf.get_length() = 0) or (this.last_char(buf) = space)
                                    set drop: true
                            }
                            if drop = false
                            {
                                buf.add(c)
                                locbuf.add(Location(org, ci as u32))
                            }
                            set ci: ci + 1
                        }
                    }
                    else
                    {
                        let run_start buf.get_length()
                        var ci: size_t 0
                        while ci < n
                        {
                            buf.add(itext.get(ci))
                            locbuf.add(Location(org, ci as u32))
                            set ci: ci + 1
                        }
                        if dt = DT_SDATA
                        {
                            sruns.add(run_start)
                            sruns.add(buf.get_length())
                        }
                    }
                    hu.note_reset(buf)
                    return
                }
                ; InternalTextEntity::litReference (Entity.cxx:426): an
                ; entity-start item, then normalReference with no event —
                ; checkRef + checkEntlvl + checkNotOpen + stack.
                this.check_ref_internal(refc_loc)
                this.check_entlvl()
                if ps.entity_is_open(ent as pointer[void])
                {
                    this.report1_at(ParserMessages.recursiveEntityReference(), name, refc_loc)
                    return
                }
                let torg host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
                set *torg: Origin(ref_start, ent as pointer[void], ref_len)
                let ttext i.get_text()
                let tsrc host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
                set *tsrc: InputSource(torg, ttext.data_ptr(), ttext.get_size())
                ps.push_input(tsrc)
            }
            when e: ExternalText
            {
                ; ExternalTextEntity::litReference (Entity.cxx:459) →
                ; normalReference: open the effective system id and stack it,
                ; or nonExistentEntityRef. An external entity in an attribute
                ; value literal warns under -watt-value-external-entity-ref
                ; (declType is always generalEntity on this path — PEs route
                ; through parse_parameter_entity_reference).
                let opt_ave ps.get_options()
                if opt_ave.warn_attribute_value_external_entity_ref
                    this.report0_at(ParserMessages.attributeValueExternalEntityRef(), refc_loc)
                this.check_ref_external(refc_loc)
                this.check_entlvl()
                if ps.entity_is_open(ent as pointer[void])
                {
                    this.report1_at(ParserMessages.recursiveEntityReference(), name, refc_loc)
                    return
                }
                let id e.get_external_id()
                let fsi this.entity_fsi(id, e.get_base_dir())
                if fsi.get_length() = 0
                {
                    let ename e.get_name()
                    let edef e.get_def_location()
                    this.report1_aux(ParserMessages.nonExistentEntityRef(), ename, refc_loc, ParserMessages.nonExistentEntityRef_aux(), edef)
                    return
                }
                let eorg host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
                set *eorg: Origin(ref_start, ent as pointer[void], ref_len)
                var found String()
                let esrc this.fsi_open(fsi, eorg, ref_start, refc_loc, 0, &found)
                if esrc = null
                    return
                ps.push_input(esrc)
            }
            when d: ExternalData
            {
                ; ExternalNonTextEntity::litReference (Entity.cxx:512).
                this.report0_at(ParserMessages.externalNonTextEntityRcdata(), refc_loc)
            }
            when sub: Subdoc
                this.report0_at(ParserMessages.externalNonTextEntityRcdata(), refc_loc)
    }

    ; The subdocument sub-parse (SgmlsEventHandler::subdocEntity, :461 + a fresh
    ; SgmlParser whose entityType is `subdoc`, Parser.cxx:104). onsgmls brackets
    ; the sub-parse's ESIS with `{name` … `}name`; the events stream inline to
    ; the same handler. The port batches events, so the bracket events wrap the
    ; nested parse's events IN THE PARENT QUEUE: queue START (the writer defines
    ; the entity + emits `{name`), run a CHILD ParserState to completion, splice
    ; its events, roll up its counts, queue END (`}name`).
    ;
    ; A subdoc INHERITS the parent's Sd + prolog/instance syntaxes (Parser.cxx:56)
    ; and starts in prologPhase — it does NOT re-scan an SGML declaration; it
    ; parses its own DOCTYPE + instance. subdocLevel is parent+1; when it equals
    ; sd.subdoc()+1 the nesting exceeds the SUBDOC quantity (subdocLevel message,
    ; at an invalid location — it fires before the child reads any token).
    function parse_subdoc(this: Parser, ent: ref[Entity], ref_start: Location, ref_len: size_t)
    {
        ; the subdoc's effective system id (catalog-resolved FSI) + its
        ; declaring-directory base (captured at decl).
        var fsi String()
        var sbase String()
        choose ent
            when s: Subdoc
            {
                let id s.get_external_id()
                let f0 this.entity_fsi(id, s.get_base_dir())
                set fsi: String^host(f0)
                set sbase: String^host(s.get_base_dir())
            }
            else
                return

        ; START bracket — the writer flushes the parent data run, defines the
        ; subdoc entity on first use (s/f/S), then emits `{name`.
        let start_ev Event.make_start_subdoc(ps.event_host(), ent, ref_start)
        ps.queue_event(start_ev)

        ; An application that does NOT sub-parse (the grove: its
        ; GroveBuilderEventHandler::subdocEntity only adds a subdocument node)
        ; gets the bare SubdocEntityEvent and nothing else — no child parser,
        ; no END bracket, and the referenced document is never even opened.
        if ps.app_parses_subdocs_on() = false
            return

        ; RAST (-t): whether the referenced document parses at all is decided
        ; by the rast-parse-subdoc PI queue (RastEventHandler::subdocEntityInfo
        ; -> parseNextSubdoc; an empty queue means NO). An unparsed subdoc is
        ; never opened — no SgmlParser exists, so no open failure reports.
        if ps.rast_on()
        {
            if ps.rast_next_subdoc() = false
            {
                ps.queue_event(Event.make_end_subdoc(ps.event_host(), ent, ref_start))
                return
            }
            start_ev.set_subdoc_parsed()
        }

        ; the child ParserState: fresh input/DTD/element stacks, subdocLevel + 1,
        ; inheriting the parent's Sd + syntaxes. Same host page, prog name and
        ; output coding so its stderr lines match the parent's. Created BEFORE
        ; the document open: the reference child SgmlParser opens its sysid
        ; itself, so the open-failure diagnostic carries the CHILD's (empty)
        ; open-element stack under -g, not the parent's.
        let child ParserState.make(host, null, ps.get_subdoc_level() + (1 as u32), PHASE_PROLOG)
        child.set_prog_name(ps.get_prog_name())
        child.set_output_utf8(ps.get_output_utf8())
        child.set_output_encoder(ps.get_output_encoder())
        ; the reporter options, -E limit, -f sink and -o output flags are
        ; app-global too.
        child.set_reporter_options(ps.reporter_options)
        child.set_output_flags(ps.get_output_flags())
        ; NO error limit on the child: the reference's subdoc parseAll gets
        ; no cancel pointer, so the child delivers every message even past
        ; the app counter's limit; the CUMULATIVE crossing cancels the
        ; PARENT when the counts are absorbed (add_subdoc_counts).
        child.set_error_limit(0)
        child.set_msg_fd(ps.msg_fd)
        ; the subdoc parser shares the invoking parser's options (Parser.cxx
        ; params carry no options; the app's ParserOptions are global).
        child.set_options(ps.get_options())
        child.set_sd(ps.get_sd())
        child.set_syntaxes(ps.get_prolog_syntax(), ps.get_instance_syntax())
        ; the entity manager's -D/-R configuration is app-global too.
        child.set_em_config(ps.get_em_config())
        ; subdocInheritActiveLinkTypes (SgmlsEventHandler::subdocEntity): the
        ; child inherits the -a activation list — the RAST handler passes 0
        ; (activation comes from the child's own rast-active-lpd PIs).
        if ps.rast_on()
        {
            child.set_rast(ps.get_rast())
            start_ev.set_child_ps(child as pointer[void])
        }
        else
            child.inherit_active_link_types(ps)
        let cat ps.get_entity_catalog()
        if cat <> null
            child.set_entity_catalog(cat)
        let sub_parser Parser.make(host, child)

        ; Parser::init (Parser.cxx:107): the subdoc-nesting-depth check fires
        ; before any token is read. Its location in the reference is
        ; currentLocation() of the LAZILY-opened document input — the entity
        ; origin whose externalize still fails ("(invalid location)"), but
        ; whose chain gives -e its "In entity <name> included from <ref>"
        ; header. The eager-open port anchors these pre-parse messages on a
        ; dedicated unopened twin of the entity origin.
        let anchor_org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *anchor_org: Origin(ref_start, ent as pointer[void], ref_len)
        anchor_org.set_unopened()
        if child.get_subdoc_level() = (ps.get_sd().subdoc() + (1 as u32))
            sub_parser.report_num_at(ParserMessages.subdocLevel(), ps.get_sd().subdoc() as u64, Location(anchor_org, 0))

        ; open the referenced document (effective system id = sysid resolved
        ; against the declaring file's directory) THROUGH THE CHILD parser —
        ; the reference child opens it in its own ctor/fill. On failure the
        ; openSystemCall diagnostic ("cannot open ...") is reported at the
        ; reference site. The document-entity origin is an EntityOrigin
        ; naming the SUBDOC entity with the reference site as parent
        ; (`params.origin = event->entityOrigin()->copy()`), so -e prints
        ; "In entity <name> included from <ref>" for the child's messages.
        var src: ref[InputSource]? null
        var sfound String()
        let sorg host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *sorg: Origin(ref_start, ent as pointer[void], ref_len)
        if fsi.get_length() <> 0
            set src: sub_parser.fsi_open(fsi, sorg, ref_start, ref_start, 0, &sfound)
        ; relative system ids inside the subdocument resolve against the
        ; OPENED file's directory (which is the declaring dir joined with the
        ; subdoc's own path — or the catalog-mapped location).
        if sfound.get_length() > 0
        {
            let sfdir Path.get_directory_name(sfound)
            let sb2 String^host(sfdir)
            set sbase: sb2
        }
        child.set_base_dir(sbase)
        child.set_decl_base_dir(sbase)

        if src = null
        {
            ; the open failed (openSystemCall already reported at the reference
            ; site). The subdoc parser runs on empty input and immediately meets
            ; end-of-document in the prolog, at the unopened document entity.
            sub_parser.report0_at(ParserMessages.documentEndProlog(), Location(anchor_org, 0))
        }
        else
        {
            child.push_input(src)
            let table ModeInfo.build_table(host)
            sub_parser.install_recognizers(table)
            sub_parser.parse_document(table, sbase)
            ; splice the subdoc's events into the parent queue, in order —
            ; RAW: the child ran its own link process (SgmlsSubdocState swaps
            ; linkProcess_ around a subdoc parse), the parent's must not see
            ; the spliced events.
            let ne child.n_events()
            var ei: size_t 0
            while ei < ne
            {
                ps.queue_event_raw(child.get_event(ei))
                set ei: ei + 1
            }
        }
        ; the subdoc's diagnostics count toward the whole document's conformance.
        ps.add_subdoc_counts(child)

        ; END bracket — `}name`.
        ps.queue_event(Event.make_end_subdoc(ps.event_host(), ent, ref_start))
    }

    ; ---- RAST (-t): the start-element delivery hooks -----------------------
    ; The reference RastEventHandler processes a StartElementEvent at delivery
    ; time: activeLinks() at the first element, then attributeInfo over the
    ; DTD attributes (whose ENTITY semantics may nested-parse subdocuments),
    ; then the link process (selectLinkRule — run by lp_start_element inside
    ; queue_event), then the link rule's own attribute lists. The message and
    ; nested-parse SIDE EFFECTS run here at the queue position; the writer
    ; renders the text later from the events + the shared FIFO.
    function rast_pre_start(this: Parser, event: ref[Event])
    {
        if ps.rast_on() = false
            return
        ps.rast_note_first_element()
        this.rast_scan_attrs(event.get_attributes())
    }

    function rast_post_start(this: Parser, event: ref[Event])
    {
        if ps.rast_on() = false
            return
        let rulev event.get_link_rule()
        if rulev = null
            return
        let rule rulev as ref[SourceLinkRule]
        this.rast_scan_attrs(rule.attributes())
        ; #RESULT attributes render only for an EXPLICIT lpd with a present
        ; result element — mirror the writer's consumption exactly.
        let lpd ps.get_lp_lpd()
        if lpd <> null
        {
            if lpd.get_kind() = LPD_EXPLICIT
            {
                if rule.get_result_type() <> null
                    this.rast_scan_attrs(rule.get_result_attributes())
            }
        }
    }

    ; walk an attribute list exactly like the writer's attributeInfo (RAST
    ; sort order, then each attribute's ENTITY semantics in value order),
    ; running the parse-time side effects: an external data entity recurses
    ; into its data attributes, a subdoc entity consumes the parse-subdoc
    ; queue and (maybe) nested-parses.
    function rast_scan_attrs(this: Parser, atts: ref[AttributeList]?)
    {
        if atts = null
            return
        let length atts.size()
        if length = 0
            return
        let order Array[size_t]^host()
        var i0: size_t 0
        while i0 < length
        {
            order.add(i0)
            set i0: i0 + 1
        }
        var i1: size_t 1
        while i1 < length
        {
            let tem order[i1]
            let tname atts.name(tem)
            var j i1
            var moving true
            while moving
            {
                if j > 0
                {
                    let prev order[(j - 1)]
                    if Rast.lex_cmp(atts.name(prev), tname) <= 0
                        set moving: false
                    else
                    {
                        order.put(j, prev)
                        set j: j - 1
                    }
                }
                else
                    set moving: false
            }
            order.put(j, tem)
            set i1: i1 + 1
        }
        var j2: size_t 0
        while j2 < length
        {
            let i order[j2]
            let a atts.attribute(i)
            let sem a.get_semantics()
            if sem <> null
            {
                let ne sem.n_entities()
                var k: size_t 0
                while k < ne
                {
                    let entv sem.entity(k)
                    if entv <> null
                    {
                        let ent entv as ref[Entity]
                        choose ent
                            when x: ExternalData
                                this.rast_scan_attrs(x.get_attributes() as ref[AttributeList]?)
                            when s: Subdoc
                            {
                                ; the nested parse's origin anchors at the
                                ; k-th value token (TokenizedAttributeValue::
                                ; tokenLocation — EntityOrigin::make's loc).
                                var tok_loc ps.current_location()
                                let v2 atts.value(i)
                                if v2 <> null
                                {
                                    let t2 v2.get_text()
                                    if t2 <> null
                                    {
                                        var tstart: size_t 0
                                        if k > 0
                                        {
                                            let si v2.get_space_index()
                                            if si <> null
                                            {
                                                if (k - 1) < si.get_length()
                                                    set tstart: si[(k - 1)] + 1
                                            }
                                        }
                                        if (*t2).has_locs()
                                            set tok_loc: (*t2).loc_at(tstart)
                                    }
                                }
                                this.rast_parse_attr_subdoc(ent, tok_loc)
                            }
                            else
                            {
                            }
                    }
                    set k: k + 1
                }
            }
            set j2: j2 + 1
        }
    }

    ; RastEventHandler::subdocEntityInfo for an ENTITY-attribute subdoc: pop
    ; the parse-subdoc queue; when it says yes, run the nested parse NOW (the
    ; reference parses inside attributeInfo — message order) and capture the
    ; child's events for the writer's FIFO.
    function rast_parse_attr_subdoc(this: Parser, ent: ref[Entity], tok_loc: Location)
    {
        var entry RastSubdocParse()
        set entry.parsed: ps.rast_next_subdoc()
        set entry.events: null
        set entry.child_ps: null
        let rsh ps.get_rast()
        if entry.parsed = false
        {
            rsh.get_results().add(entry)
            return
        }
        var fsi String()
        var sbase String()
        choose ent
            when s: Subdoc
            {
                let id s.get_external_id()
                let f0 this.entity_fsi(id, s.get_base_dir())
                set fsi: String^host(f0)
                set sbase: String^host(s.get_base_dir())
            }
            else
                return
        var src: ref[InputSource]? null
        var sfound String()
        if fsi.get_length() <> 0
        {
            let sorg host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
            set *sorg: Origin()
            set src: this.fsi_open(fsi, sorg, tok_loc, tok_loc, 0, &sfound)
        }
        if sfound.get_length() > 0
        {
            let sfdir Path.get_directory_name(sfound)
            let sb2 String^host(sfdir)
            set sbase: sb2
        }
        let child ParserState.make(host, null, ps.get_subdoc_level() + (1 as u32), PHASE_PROLOG)
        child.set_prog_name(ps.get_prog_name())
        child.set_output_utf8(ps.get_output_utf8())
        child.set_output_encoder(ps.get_output_encoder())
        child.set_reporter_options(ps.reporter_options)
        child.set_output_flags(ps.get_output_flags())
        ; NO error limit on the child: the reference's subdoc parseAll gets
        ; no cancel pointer, so the child delivers every message even past
        ; the app counter's limit; the CUMULATIVE crossing cancels the
        ; PARENT when the counts are absorbed (add_subdoc_counts).
        child.set_error_limit(0)
        child.set_msg_fd(ps.msg_fd)
        child.set_options(ps.get_options())
        child.set_base_dir(sbase)
        child.set_decl_base_dir(sbase)
        child.set_sd(ps.get_sd())
        child.set_syntaxes(ps.get_prolog_syntax(), ps.get_instance_syntax())
        ; subdocInheritActiveLinkTypes = 0 under RAST; the shared half threads.
        child.set_rast(rsh)
        let cat ps.get_entity_catalog()
        if cat <> null
            child.set_entity_catalog(cat)
        let sub_parser Parser.make(host, child)
        if child.get_subdoc_level() = (ps.get_sd().subdoc() + (1 as u32))
            sub_parser.report_num_at(ParserMessages.subdocLevel(), ps.get_sd().subdoc() as u64, Location())
        if src = null
            sub_parser.report0_at(ParserMessages.documentEndProlog(), Location())
        else
        {
            child.push_input(src)
            let table ModeInfo.build_table(host)
            sub_parser.install_recognizers(table)
            sub_parser.parse_document(table, sbase)
        }
        ps.add_subdoc_counts(child)
        set entry.events: child.get_events()
        set entry.child_ps: child as pointer[void]
        rsh.get_results().add(entry)
    }

    ; parseEntityReference(isParameter=1) (parseCommon.cxx:428) + the declReference/
    ; dsReference push (entity.cxx). A `%name;` parameter-entity reference inside
    ; a markup declaration or the declaration subset: look the PE up, then STACK
    ; its replacement text as an InputSource so its tokens flow transparently into
    ; the running parse. The enclosing loop's tokenEe arm pops it when exhausted —
    ; EXACTLY the general-entity content path (parse_entity_reference above), only
    ; with is_parameter=true. The target DTDs are EXTERNAL, where PE references
    ; inside declarations are allowed. Only internal TEXT entities occur here (a
    ; PE with an external / non-text body is not exercised by the corpus).
    function parse_parameter_entity_reference(this: Parser, name_group: bool, ref_ctx: int) returns bool
    {
        let ins ps.current_input()
        ; the reference start (the PERO `%`) is the current token's start, before
        ; discard_initial peels it — EntityOrigin's refLocation.
        let ref_start ins.token_start_location()
        ; parseEntityReference ignoreLevel 1 (parseCommon.cxx:440): a PERO with
        ; a name group (`%(doc)name;`, CONCUR/LINK). Outside the instance the
        ; group NEVER applies (parseEntityReferenceNameGroup) — the reference
        ; is consumed and ignored.
        var ignore false
        if name_group
        {
            if this.parse_entity_reference_name_group(&ignore) = false
                return false
            ins.start_token()
            let gc ins.token_char()
            var gns false
            if gc >= 0
                set gns: ps.get_syntax().is_name_start_character(gc as u32)
            if gns = false
            {
                this.report0_at(ParserMessages.entityReferenceMissingName(), ins.token_start_location())
                return false
            }
        }
        ; discard_initial drops the PERO (`%`); the name grows over name chars.
        ; extend_name_token's length limit is deferred (penamelen == namelen - the
        ; PERO length, but the limit is never enforced), so namelen is exact here.
        ins.discard_initial()
        this.extend_name_token(this.penamelen(), ParserMessages.parameterEntityNameLength())
        let name ps.current_token^host()
        let name_loc ins.token_start_location()
        let dtd ps.get_current_dtd()
        var ent: ref[Entity]? null
        if ignore = false
            set ent: ps.lookup_entity_pass_aware(true, name)
        ; consume the REFC (`;`) or record-end that terminates the reference.
        let refc ps.get_token(refMode)
        let refc_loc ins.token_start_location()
        ; parseCommon.cxx:517: -wrefc, as for general references.
        let opt_rf3 ps.get_options()
        if opt_rf3.warn_refc and (refc <> tokenRefc)
            this.report0_at(ParserMessages.refc(), refc_loc)
        ; refLength = the full span of `%name;` (parseCommon.cxx).
        let ref_len (ins.here_location().get_index() - ref_start.get_index()) as size_t
        if ignore
        {
            ; an IgnoredEntity reference: name and REFC consumed, nothing stacked.
            return true
        }
        if ent = null
        {
            ; lookupEntity with no applicable DTD (parseCommon.cxx:494): only
            ; reachable between the `]` and `>` of a document type declaration,
            ; where endDtd has already run — entityApplicableDtd instead of the
            ; undefined-entity handling; the reference is dropped.
            if dtd = null
            {
                this.report0_at(ParserMessages.entityApplicableDtd(), name_loc)
                return true
            }
            ; parameterEntityUndefined (parseCommon.cxx:490): the PE is not defined.
            ; Reported (exit 1), reference dropped. Arg = name (quoted); location =
            ; the name token's start.
            this.report1_at(ParserMessages.parameterEntityUndefined(), name, name_loc)
            return true
        }

        let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org: Origin(ref_start, ent as pointer[void], ref_len)
        choose *ent
            when i: Internal
            {
                let dt i.get_data_type()
                if dt = DT_PI
                {
                    ; PiEntity::declReference/litReference (Entity.cxx:316/300)
                    ; both report piEntityReference; dsReference (between
                    ; declarations) falls through to PiEntity::normalReference
                    ; (:307) — noteMarkup + a PiEntityEvent (`?text`), no checks.
                    if ref_ctx = PE_CTX_DS
                    {
                        ps.note_markup()
                        let ptext i.get_text()
                        let pev Event.make_pi(ps.event_host(), ptext, ref_start)
                        ps.queue_event(pev)
                    }
                    else
                        this.report0_at(ParserMessages.piEntityReference(), refc_loc)
                    return true
                }
                if (dt = DT_CDATA) or (dt = DT_SDATA)
                {
                    ; InternalDataEntity::declReference (Entity.cxx:328). An
                    ; internal data PARAMETER entity is rejected at its own
                    ; declaration (internalParameterDataEntity, parseDecl.cxx
                    ; :1751) and never defined, so this arm is blind — ported
                    ; for shape-fidelity to the reference dispatch.
                    this.report0_at(ParserMessages.internalDataEntityReference(), refc_loc)
                    return true
                }
                ; InternalTextEntity::normalReference (Entity.cxx:411, reached
                ; via declReference/dsReference/litReference): checkRef +
                ; checkEntlvl + checkNotOpen, then the replacement text stacks.
                ; checkNotOpen: a recursive parameter-entity reference —
                ; reported like the general-entity case; resolve_location
                ; fixes up the location up the chain. (Hard to provoke cleanly
                ; — a self-referential PE literal is expanded at declaration
                ; time and errors as parameterEntityUndefined first — so no
                ; fixture, per the task's testcase directive; wired for
                ; fidelity.)
                this.check_ref_internal(refc_loc)
                this.check_entlvl()
                if ps.entity_is_open(ent as pointer[void])
                {
                    this.report1_at(ParserMessages.recursiveEntityReference(), name, refc_loc)
                    return true
                }
                let itext i.get_text()
                let isrc host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
                set *isrc: InputSource(org, itext.data_ptr(), itext.get_size())
                ps.push_input(isrc)
            }
            when e: ExternalText
            {
                this.check_ref_external(refc_loc)
                this.check_entlvl()
                if ps.entity_is_open(ent as pointer[void])
                {
                    this.report1_at(ParserMessages.recursiveEntityReference(), name, refc_loc)
                    return true
                }
                let id e.get_external_id()
                let fsi this.entity_fsi(id, e.get_base_dir())
                if fsi.get_length() = 0
                {
                    ; normalReference: no effective system id → nonExistentEntityRef,
                    ; at the REFC, aux at the entity's declaration site.
                    let ename e.get_name()
                    let edef e.get_def_location()
                    this.report1_aux(ParserMessages.nonExistentEntityRef(), ename, refc_loc, ParserMessages.nonExistentEntityRef_aux(), edef)
                    return true
                }
                ; open through the effective id; a failure reports at the
                ; PERO reference site and drops the reference.
                var found String()
                let esrc this.fsi_open(fsi, org, ref_start, refc_loc, 0, &found)
                if esrc = null
                    return true
                ps.push_input(esrc)
            }
            when d: ExternalData
            {
                ; ExternalNonTextEntity (a data PE — only definable under WWW,
                ; where external data parameter entities are admitted):
                ; declReference → normalReference → externalNonTextEntity-
                ; Reference (Entity.cxx:505); litReference → ...Rcdata (:512);
                ; dsReference (between declarations) → dtdDataEntityReference
                ; (:499). No checks in any of the three.
                if ref_ctx = PE_CTX_DS
                    this.report0_at(ParserMessages.dtdDataEntityReference(), refc_loc)
                else if ref_ctx = PE_CTX_LIT
                    this.report0_at(ParserMessages.externalNonTextEntityRcdata(), refc_loc)
                else
                    this.report0_at(ParserMessages.externalNonTextEntityReference(), refc_loc)
            }
            when sub: Subdoc
            {
                if ref_ctx = PE_CTX_DS
                    this.report0_at(ParserMessages.dtdDataEntityReference(), refc_loc)
                else if ref_ctx = PE_CTX_LIT
                    this.report0_at(ParserMessages.externalNonTextEntityRcdata(), refc_loc)
                else
                    this.report0_at(ParserMessages.externalNonTextEntityReference(), refc_loc)
            }
        true
    }

    ; parseNamedCharRef (parseCommon.cxx:239): `&#NAME;` — NAME must be a
    ; function name (RE/RS/SPACE plus declared FUNCTION names); the named char
    ; is re-injected into the input (push_char_ref) and scanned as an ordinary
    ; source char, so RE/RS/SPACE semantics fall out of the normal record and
    ; data machinery. An unknown name reports functionName (E1, at the
    ; name-token start; the arg is the namecase-folded name — verified vs real
    ; onsgmls: `&#x41;` under the reference syntax reports "X41", `&#space;`
    ; under xml.dcl's NAMECASE NO reports "space") and produces nothing. The
    ; terminating REFC (or RE) is consumed either way; always returns true
    ; like the reference. warnNamedCharRef/warnRefc and the markup capture
    ; (wantMarkup, incl. the origin's NamedCharRef notes) are only observable
    ; under options the drop-in does not expose — not ported.
    function parse_named_char_ref(this: Parser) returns bool
    {
        ; parseCommon.cxx:241: any named character reference warns under
        ; -wnamed-char-ref.
        let opt_nc ps.get_options()
        if opt_nc.warn_named_char_ref
            this.report0_at(ParserMessages.namedCharRef(), ps.current_input().token_start_location())
        let ins ps.current_input()
        ins.discard_initial()
        this.extend_name_token(this.namelen(), ParserMessages.nameLength())
        let name_loc ins.token_start_location()
        let name this.name_folded()
        var c: u32 0
        var valid true
        if ps.get_syntax().lookup_function_char(name, &c) = false
        {
            this.report1_at(ParserMessages.functionName(), name, name_loc)
            set valid: false
        }
        let refc ps.get_token(refMode)
        ; parseCommon.cxx:267: a reference not closed by the REFC warns under
        ; -wrefc.
        if opt_nc.warn_refc and (refc <> tokenRefc)
            this.report0_at(ParserMessages.refc(), ins.token_start_location())
        ins.start_token()
        if valid
            ins.push_char_ref(c)
        true
    }

    ; parseNumericCharRef (parseCommon.cxx:282, scoped): a decimal `&#NN;` or
    ; hex `&#xNN;` reference -> the referenced document-charset Char (via
    ; out_ch). is_hex = the dispatch token was tokenHcroHexDigit (parseCommon
    ; passes token==tokenHcroHexDigit at both call sites). The digits fold to
    ; a value guarded against the CONSTANT charMax = 0x10FFFF (constant.h:12 —
    ; the internal Char range, NOT a charset-derived cap); then the number
    ; must be DECLARED in the document character set
    ; (sd().docCharsetDecl().charDeclared — UNUSED ranges count as declared),
    ; else characterNumber. Both failures report at the number token's start
    ; (verified vs real onsgmls: the first digit — for hex the char after the
    ; HCRO `&#x`, message arg = the digits WITHOUT the x, e.g. "110000") and
    ; return false with no char produced; the REFC is consumed either way.
    ; out_refc_loc = the start of the reference-terminating token (the REFC
    ; `;`) — where the translate-stage diagnostics point (verified: real
    ; onsgmls reports numericCharRefNoInternal/UnknownBase at the `;`).
    ; The markup capture (wantMarkup) is still deferred.
    function parse_numeric_char_ref(this: Parser, is_hex: bool, out_ch: ref[u32], out_refc_loc: ref[Location]) returns bool
    {
        let ins ps.current_input()
        ins.discard_initial()
        if is_hex
            this.extend_hex_number(this.namelen())
        else
            this.extend_number(this.namelen())
        ; the number token's start — where characterNumber points.
        let numloc ins.token_start_location()
        let tok ps.current_token()
        let n tok.get_size()
        var c: u32 0
        var valid true
        var i: size_t 0
        if is_hex
        {
            while (i < n) and valid
            {
                let d this.hex_digit_weight(tok.get(i))
                ; the base-16 fold, guarded exactly like the decimal one below.
                if (c <= (CHAR_MAX / (16 as u32))) and ((c * (16 as u32)) <= (CHAR_MAX - d))
                    set c: c * (16 as u32) + d
                else
                {
                    this.report1_at(ParserMessages.characterNumber(), tok, numloc)
                    set valid: false
                }
                set i: i + 1
            }
        }
        else
        {
            while (i < n) and valid
            {
                let d tok.get(i) - (0x30 as u32)
                ; fold guarded against charMax (parseCommon.cxx): the instant the next
                ; digit would exceed charMax, report characterNumber and stop, so a long
                ; digit run cannot overflow and the char is not produced.
                if (c <= (CHAR_MAX / (10 as u32))) and ((c * (10 as u32)) <= (CHAR_MAX - d))
                    set c: c * (10 as u32) + d
                else
                {
                    this.report1_at(ParserMessages.characterNumber(), tok, numloc)
                    set valid: false
                }
                set i: i + 1
            }
        }
        ; the fold stayed in range, but the number must be a DECLARED character
        ; of the document charset (charDeclared counts UNUSED ranges — an
        ; UNUSED number passes here and is dropped by translate, NOT an error).
        if valid
        {
            if ps.get_sd().doc_charset_decl().char_declared(c) = false
            {
                this.report1_at(ParserMessages.characterNumber(), tok, numloc)
                set valid: false
            }
        }
        ; consume the REFC (`;`) or record-end that terminates the reference (always,
        ; valid or not — the reference is recovered past either way).
        let refc ps.get_token(refMode)
        set out_refc_loc: ps.current_input().token_start_location()
        ; parseCommon.cxx:341: a reference not closed by the REFC warns under
        ; -wrefc.
        let opt_rf ps.get_options()
        if opt_rf.warn_refc and (refc <> tokenRefc)
            this.report0_at(ParserMessages.refc(), ps.current_input().token_start_location())
        if valid = false
            return false
        set out_ch: c
        true
    }

    ; translateNumericCharRef (parseCommon.cxx:360): translate a character
    ; number in the DOCUMENT character set into the INTERNAL character set.
    ; In the default mode the internal charset IS the doc charset — no
    ; translation, every declared ref is an SGML char (the reference's
    ; warnNonSgmlCharRef refinement is a non-default option, not ported).
    ; Under SP_CHARSET_FIXED (internalCharsetIsDocCharset false):
    ;   - docCharset().descToUniv succeeds -> internalCharset().univToDesc:
    ;     the fixed internal charset is the system charset, identity over
    ;     0..INTERNAL_CHAR_MAX (see CharsetDecl.scaly) — in range translates
    ;     the char, beyond it reports numericCharRefNoInternal (E1, at the
    ;     REFC). The reference's numericCharRefBadInternal arm (ambiguous /
    ;     over-charMax internal mapping) is unreachable with an identity map.
    ;   - descToUniv fails -> getCharInfo classifies the number: an UNUSED
    ;     range is a declared NON-SGML char (return true, is_sgml_char false —
    ;     the callers drop it silently); a string-described range reports
    ;     numericCharRefUnknownDesc (E2); a number range whose base char the
    ;     baseset does not cover reports numericCharRefUnknownBase (E3, args:
    ;     doc number, base number, QUOTED baseset public id).
    ; Returns false when the char could not be translated (already reported).
    function translate_numeric_char_ref(this: Parser, ch: ref[u32], is_sgml_char: ref[bool], refc_loc: Location) returns bool
    {
        let sd ps.get_sd()
        if sd.internal_charset_is_doc_charset()
        {
            ; parseCommon.cxx:366: a reference to a non-SGML char warns under
            ; -wnon-sgml-char-ref.
            let opt_ns ps.get_options()
            if opt_ns.warn_non_sgml_char_ref
            {
                let sgset ps.get_syntax().char_set(setSgmlChar)
                if sgset.contains(ch) = false
                    this.report0_at(ParserMessages.nonSgmlCharRef(), refc_loc)
            }
            set is_sgml_char: true
            return true
        }
        let c: u32 ch
        var univ: u32 0
        if sd.doc_charset_desc().desc_to_univ(c, &univ)
        {
            if univ <= INTERNAL_CHAR_MAX
            {
                set ch: univ
                set is_sgml_char: true
                return true
            }
            this.report_num_at(ParserMessages.numericCharRefNoInternal(), c as u64, refc_loc)
            return false
        }
        let r sd.doc_charset_decl().find_range(c)
        if r = null
        {
            ; CANNOT_HAPPEN (parseCommon.cxx:381): charDeclared passed in
            ; parse_numeric_char_ref, so a covering range exists. Defensive:
            ; report as an unknown base char of an anonymous baseset.
            this.report_num_num_str_at(ParserMessages.numericCharRefUnknownBase(), c as u64, c as u64, StringC(), refc_loc)
            return false
        }
        if r.range_type = CHARSET_RANGE_UNUSED
        {
            ; parseCommon.cxx:380: an UNUSED (non-SGML) char warns under
            ; -wnon-sgml-char-ref.
            let opt_ns2 ps.get_options()
            if opt_ns2.warn_non_sgml_char_ref
                this.report0_at(ParserMessages.nonSgmlCharRef(), refc_loc)
            set is_sgml_char: false
            return true
        }
        if r.range_type = CHARSET_RANGE_STRING
        {
            let dstr r.str
            this.report_num_str_at(ParserMessages.numericCharRefUnknownDesc(), c as u64, dstr, refc_loc)
            return false
        }
        let base_n r.base_min + (c - r.desc_min)
        let pid ps.get_sd().doc_charset_decl().section_pubid(r.section)
        this.report_num_num_str_at(ParserMessages.numericCharRefUnknownBase(), c as u64, base_n as u64, pid, refc_loc)
        false
    }

    ; doContent — the instance token-dispatch loop (well-formed subset).
    ; handleShortref (parseInstance.cxx:333). `index` = token − tokenFirstShortref;
    ; the current token IS the matched shortref delimiter string. A delimiter
    ; the active map binds to an entity is referenced exactly like `&name;`
    ; (Entity::contentReference — the shared helper); an unmapped delimiter
    ; falls back to DATA: leading separators in element content stay separators
    ; (the reference's SSepEvent is instance markup — no ESIS), the remainder is
    ; accepted as pcdata, with RS/RE routed through the record machine unless
    ; KEEPRSRE keeps the whole run as plain data.
    function handle_shortref(this: Parser, index: int)
    {
        let cs ps.get_content_state()
        let map cs.current_element().get_map()
        if map <> null
        {
            let ent map.entity(index as size_t)
            if ent <> null
            {
                let ins0 ps.current_input()
                let ref_start ins0.token_start_location()
                let ref_len ins0.current_token_length()
                let ename ent.get_name()
                var rc this.content_reference_entity(ent, ename, ref_start, ref_len, ref_start, false)
                return
            }
        }
        let ins ps.current_input()
        let ts ins.current_token_string()
        let length ts.get_size()
        let start_idx ins.current_token_start_index()
        let org ins.get_origin()
        let syn ps.get_syntax()
        var i: size_t 0
        let mode ps.get_current_mode()
        if (mode = econMode) or (mode = econnetMode)
        {
            while running_s_scan(syn, ts, i, length)
                set i: i + 1
        }
        if i < length
        {
            let loc Location(org, (start_idx + i) as u32)
            this.accept_pcdata(loc)
            if ps.get_sd().keeprsre()
            {
                ps.note_data()
                let rest StringC^host(ts.data_ptr() + i, length - i)
                let ev Event.make_data(ps.event_host(), rest, loc)
                ps.queue_event(ev)
                return
            }
            let rs syn.standard_function(fRS)
            let re syn.standard_function(fRE)
            var j: size_t i
            while j < length
            {
                let c ts.get(j)
                if c = rs
                    ps.note_rs()
                else if c = re
                    ps.queue_re(Location(org, (start_idx + j) as u32))
                else
                {
                    ps.note_data()
                    let cb host.allocate(4, 4) as pointer[u32]
                    set *cb: c
                    let sc StringC^host(cb, 1)
                    let cloc Location(org, (start_idx + j) as u32)
                    let cev Event.make_data(ps.event_host(), sc, cloc)
                    ps.queue_event(cev)
                }
                set j: j + 1
            }
        }
    }

    ; `i < length && syntax().isS(s[i])` — the loop guard of handleShortref's
    ; leading-separator scan, extracted because the port's `and` operands must
    ; be simple (chained calls as operands mis-plan).
    function running_s_scan(syn: ref[Syntax], ts: StringC, i: size_t, length: size_t) returns bool
    {
        if i >= length
            return false
        let sset syn.char_set(setS)
        sset.contains(ts.get(i))
    }

    ; streaming ESIS delivery (memory Front B): render every event queued
    ; since the last drain into the pre-built writer, then reset the event
    ; scratch region — the queue entries below `drained` become dangling and
    ; are never read again. Bails while a pass-2 replay is still possible
    ; (its discard would need the queued events; only reachable with -a,
    ; where streaming is off anyway — belt and suspenders).
    function stream_drain(this: Parser)
    {
        if ps.is_streaming() = false
            return
        if ps.get_allow_pass2()
            return
        let n ps.n_events()
        let d ps.get_drained()
        if (n - d) < EV_STREAM_CHUNK
            return
        let cb ps.get_stream_cb()
        if cb <> null
        {
            ; custom sink (dazzle grove builder): consumes [drained, n).
            let pv ps as pointer[void]
            scaly_call_ptr(cb, pv)
        }
        else
        {
            let w ps.get_stream_w() as ref[EsisW]
            Esis.write_events(w, ps, d, n)
            ; the rendered bytes are final — hand them to the output and empty
            ; the accumulator BEFORE the scratch reset below, which is what
            ; frees flush_out's transcode temporaries.
            Esis.flush_out(w, ps)
        }
        ; the drain consumed the queue in full, and the scratch reset below
        ; frees the events it pointed at — so the queue is dead entirely, not
        ; just below the cursor. Dropping it keeps the queue chunk-sized instead
        ; of document-sized (see ParserState.clear_events).
        ps.clear_events()
        ps.reset_event_scratch()
    }

    function do_content(this: Parser)
    {
        var running true
        while running
        {
            ; doContent (parseInstance.cxx): the error limit was reached — STOP
            ; without closing the open elements or ending the instance. onsgmls
            ; truncates the ESIS here (no closing tags, no conformance marker).
            if ps.is_cancelled()
                return
            ; streaming ESIS delivery: between tokens no event pointer is
            ; live outside the queue, so a full chunk can drain into the
            ; writer and the event scratch region can reset.
            this.stream_drain()
            let token ps.get_token(ps.get_current_mode())
            if token = tokenEe
            {
                if ps.get_input_level() <= 1
                {
                    this.end_instance()
                    set running: false
                }
                else
                {
                    ; an entity ends inside CDATA/RCDATA content or an ignored
                    ; marked section (the special parse) — parseInstance.cxx:96.
                    if ps.get_input_level() = ps.get_special_parse_input_level()
                        this.report0_at(ParserMessages.specialParseEntityEnd(), ps.current_input().token_start_location())
                    if ps.get_content_state().after_document_element()
                        this.report0_at(ParserMessages.afterDocumentElementEntityEnd(), ps.current_input().token_start_location())
                    ; parseInstance.cxx:106: under VALIDITY ... INTEGRAL YES an
                    ; entity must end in the element its reference started in
                    ; (integrally stored); the index recorded at push_input is
                    ; compared against the element open at entity end.
                    if ps.get_sd().integrally_stored()
                    {
                        let cs ps.get_content_state()
                        if cs.tag_level_of() > 0
                        {
                            let ce cs.current_element()
                            if (ce.get_index() as u32) <> ps.current_input_element_index()
                                this.report0_at(ParserMessages.contentAsyncEntityRef(), ps.current_input().token_start_location())
                        }
                    }
                    ps.pop_input_stack()
                }
            }
            else if (token = tokenEroNameStart) or (token = tokenEroGrpo)
            {
                if ps.get_content_state().after_document_element()
                    this.report0_at(ParserMessages.entityReferenceAfterDocumentElement(), ps.current_input().token_start_location())
                ; an ERO with a name group (`&(doc)e;`, CONCUR/LINK) parses the
                ; group and ignores the reference unless it applies to the
                ; current document type (parseInstance.cxx:149).
                this.parse_entity_reference(token = tokenEroGrpo)
            }
            else if token = tokenNet
                this.parse_null_end_tag()
            else if (token = tokenCroDigit) or (token = tokenHcroHexDigit)
            {
                if ps.get_content_state().after_document_element()
                    this.report0_at(ParserMessages.characterReferenceAfterDocumentElement(), ps.current_input().token_start_location())
                let loc ps.current_location()
                var ch: u32 0
                var refc_loc Location()
                let is_hex_ref token = tokenHcroHexDigit
                if this.parse_numeric_char_ref(is_hex_ref, &ch, &refc_loc)
                {
                    ; doContent (parseInstance.cxx:119): pcdata is accepted and
                    ; data noted BEFORE translation; a char the fixed internal
                    ; charset cannot represent (translate false) emits nothing;
                    ; a declared NON-SGML char (UNUSED range — is_sgml false)
                    ; emits a NonSgmlCharEvent (parseInstance.cxx:126): the
                    ; default output drops it, -ononsgml renders `\%N;` inline.
                    this.accept_pcdata(loc)
                    ps.note_data()
                    var is_sgml true
                    if this.translate_numeric_char_ref(&ch, &is_sgml, refc_loc)
                    {
                        if is_sgml
                        {
                            let scp StringC^host(&ch, 1)
                            let cev Event.make_data(ps.event_host(), *scp, loc)
                            ps.queue_event(cev)
                        }
                        else
                        {
                            let nsp StringC^host(&ch, 1)
                            ps.queue_event(Event.make_nonsgml(ps.event_host(), *nsp, loc))
                        }
                    }
                }
            }
            else if token = tokenCroNameStart
            {
                ; doContent (parseInstance.cxx:137): a named function char ref;
                ; the pushed char re-scans through the normal token dispatch
                ; (an RE lands in the tokenRe arm and the record machinery).
                if ps.get_content_state().after_document_element()
                    this.report0_at(ParserMessages.characterReferenceAfterDocumentElement(), ps.current_input().token_start_location())
                this.parse_named_char_ref()
            }
            else if token = tokenStagoNameStart
                this.parse_start_tag()
            else if token = tokenStagoTagc
                this.parse_empty_start_tag()
            else if token = tokenStagoGrpo
            {
                ; a start tag with a document-type name group (doContent,
                ; parseInstance.cxx:248) — CONCUR.
                this.parse_group_start_tag()
            }
            else if token = tokenEtagoNameStart
            {
                let ee this.parse_end_tag()
                this.accept_end_tag(ee)
            }
            else if token = tokenEtagoTagc
                this.parse_empty_end_tag()
            else if token = tokenEtagoGrpo
            {
                ; an end tag with a document-type name group (parseInstance.cxx:167).
                this.parse_group_end_tag()
            }
            else if token = tokenMdoCom
            {
                ; a comment declaration in the instance (doContent): markup, no
                ; event — the data on either side of it is ONE data run.
                this.parse_comment_decl()
                ps.note_markup()
            }
            else if token = tokenMdoNameStart
            {
                ; doContent (parseInstance.cxx:196): a markup declaration in the
                ; instance. USEMAP parses (parseUsemapDecl — it consumes its own
                ; MDC on success); DOCTYPE/LINKTYPE/ELEMENT/ATTLIST/ENTITY/
                ; NOTATION/SHORTREF/LINK/IDLINK are not allowed here ->
                ; instanceDeclaration; any other recognized reserved name ->
                ; noSuchDeclarationType. A failed/disallowed declaration is
                ; skipped to its MDC.
                let inst_decl_level ps.get_input_level()
                var decl_name: int 0
                var md_result false
                if this.parse_declaration_name(&decl_name, false)
                {
                    let spell this.name_folded()
                    let dloc ps.current_input().token_start_location()
                    if decl_name = R_USEMAP
                    {
                        if ps.get_content_state().after_document_element()
                            this.report1_at(ParserMessages.declarationAfterDocumentElement(), spell, dloc)
                        set md_result: this.parse_usemap_decl()
                    }
                    else if decl_name = R_USELINK
                    {
                        ; parseUselinkDecl (parseInstance.cxx:185), after the
                        ; same after-document-element check.
                        if ps.get_content_state().after_document_element()
                            this.report1_at(ParserMessages.declarationAfterDocumentElement(), spell, dloc)
                        set md_result: this.parse_uselink_decl()
                    }
                    else if this.instance_declaration_not_allowed(decl_name)
                        this.report1_at(ParserMessages.instanceDeclaration(), spell, dloc)
                    else
                        this.report1_at(ParserMessages.noSuchDeclarationType(), spell, dloc)
                }
                if md_result = false
                    this.skip_declaration(inst_decl_level)
                ps.note_markup()
            }
            else if token = tokenMdoMdc
            {
                ; the empty comment declaration `<!>` (parseDecl.cxx:3577):
                ; warns under -wempty-comment-decl.
                let opt_ec2 ps.get_options()
                if opt_ec2.warn_empty_comment_decl
                    this.report0_at(ParserMessages.emptyCommentDecl(), ps.current_input().token_start_location())
                ps.note_markup()
            }
            else if token = tokenMdoDso
            {
                if ps.get_content_state().after_document_element()
                    this.report0_at(ParserMessages.markedSectionAfterDocumentElement(), ps.current_input().token_start_location())
                this.parse_marked_section_decl_start()
                ps.note_markup()
            }
            else if token = tokenMscMdc
            {
                this.handle_marked_section_end()
                ps.note_markup()
            }
            else if token = tokenRe
            {
                this.accept_pcdata(ps.current_input().token_start_location())
                ps.queue_re(ps.current_input().token_start_location())
            }
            else if token = tokenRs
            {
                this.accept_pcdata(ps.current_input().token_start_location())
                ps.note_rs()
            }
            else if token = tokenChar
                this.parse_pcdata()
            else if token = tokenCharDelim
            {
                ; parseInstance.cxx:286: a data char that starts a delimiter
                ; (recognized only under -wdata-delim) warns, then parses as
                ; pcdata.
                let dd_str2 ps.current_token^host()
                this.report1_at(ParserMessages.dataCharDelim(), dd_str2, ps.current_input().token_start_location())
                this.parse_pcdata()
            }
            else if token = tokenIgnoredChar
                ; content of an IGNORE marked section: extend + discard.
                set running: running
            else if token = tokenPio
            {
                ; a processing instruction in content (doContent case tokenPio).
                this.parse_processing_instruction()
                ps.note_markup()
            }
            else if token = tokenS
                set running: running
            else if token = tokenUnrecognized
            {
                ; reportNonSgmlCharacter + parsePcdata (parseInstance.cxx:281):
                ; the unmatched char joins the data run; parse_pcdata's
                ; check_non_sgml reports any non-SGML chars in the run at their
                ; own locations. A zero-length unrecognized token must consume
                ; its character or the loop would not advance.
                let ins_u ps.current_input()
                if ins_u.current_token_length() = 0
                    ins_u.end_token(1)
                this.parse_pcdata()
            }
            else if token >= tokenFirstShortref
                ; ASSERT(token >= tokenFirstShortref) — the doContent default arm.
                this.handle_shortref((token - tokenFirstShortref) as int)
            else
                ; Unhandled token in this increment (group tags).
                ; Bail rather than risk a non-advancing loop; the axes handle
                ; these.
                set running: false
        }
    }

    ; parseEmptyStartTag (parseInstance.cxx:511) — `<>`: the empty start tag
    ; names the most recently ended element under OMITTAG NO, the currently
    ; open element otherwise, falling back to the document element type.
    function parse_empty_start_tag(this: Parser)
    {
        let opt ps.get_options()
        if opt.warn_empty_tag
            this.report0_at(ParserMessages.emptyStartTag(), ps.current_input().token_start_location())
        let dtd_b ps.get_current_dtd()
        if dtd_b <> null
        {
            if dtd_b.is_base = false
                this.report0_at(ParserMessages.emptyStartTagBaseDtd(), ps.current_input().token_start_location())
        }
        let cs ps.get_content_state()
        var e: ref[ElementType]? null
        if ps.get_sd().omittag() = false
            set e: cs.last_ended_element_type()
        else if cs.tag_level_of() > 0
            set e: cs.current_element().get_type()
        if e = null
        {
            let dtd ps.get_current_dtd()
            set e: dtd.get_document_element_type()
        }
        if e = null
            return
        let adl e.get_attribute_def()
        let atts AttributeList.make(ps.attribute_host(), adl)
        let ctx ps.get_attribute_context()
        atts.finish(ctx)
        this.check_missing_semantics(atts)
        let loc ps.current_input().token_start_location()
        let stev Event.make_start(ps.event_host(), e, loc)
        stev.set_attributes(atts)
        stev.set_has_markup()
        this.accept_start_tag(e, stev, false)
    }

    ; parseEmptyEndTag (parseInstance.cxx:1070) — `</>`: ends the currently
    ; open element; with no open elements it is an error and is dropped.
    function parse_empty_end_tag(this: Parser)
    {
        let opt ps.get_options()
        if opt.warn_empty_tag
            this.report0_at(ParserMessages.emptyEndTag(), ps.current_input().token_start_location())
        let dtd_b ps.get_current_dtd()
        if dtd_b <> null
        {
            if dtd_b.is_base = false
                this.report0_at(ParserMessages.emptyEndTagBaseDtd(), ps.current_input().token_start_location())
        }
        let cs ps.get_content_state()
        if cs.tag_level_of() = 0
        {
            this.report0_at(ParserMessages.emptyEndTagNoOpenElements(), ps.current_input().token_start_location())
            return
        }
        let e cs.current_element().get_type()
        let endev Event.make_end(ps.event_host(), e, ps.current_input().token_start_location())
        endev.set_has_markup()
        this.accept_end_tag(endev)
    }

    ; parseGroupStartTag (parseInstance.cxx:542) — `<(doc,...)gi ...>` under
    ; CONCUR: when the group names the ACTIVE document type the tag parses as a
    ; normal start tag (net-enabling is startTagGroupNet — a NET would be
    ; ambiguous across instances); otherwise the whole tag is IGNORED MARKUP:
    ; the name and attribute spec are consumed, checked for spec-level errors,
    ; and dropped (no event).
    function parse_group_start_tag(this: Parser)
    {
        let ins ps.current_input()
        ; the `<(` position — the markup location of a group start tag.
        let gloc ins.token_start_location()
        var active false
        if this.parse_tag_name_group(&active, true) = false
            return
        ; the general identifier follows the group's GRPC: peek its first
        ; character by hand (the tag modes expect the STAGO to precede a name).
        ins.start_token()
        let c ins.token_char()
        var is_name_start false
        if c >= 0
            set is_name_start: ps.get_syntax().is_name_start_character(c as u32)
        if is_name_start = false
        {
            this.report0_at(ParserMessages.startTagMissingName(), ins.token_start_location())
            return
        }
        if active
        {
            var net false
            let event this.do_parse_start_tag(&net)
            event.set_markup_loc(gloc)
            if net
                this.report0_at(ParserMessages.startTagGroupNet(), ps.current_input().token_start_location())
            let e event.get_element_type()
            this.accept_start_tag(e, event, net)
        }
        else
        {
            ins.discard_initial()
            this.extend_name_token(this.namelen(), ParserMessages.nameLength())
            this.skip_attribute_spec()
        }
    }

    ; parseGroupEndTag (parseInstance.cxx:581) — `</(doc,...)gi>` under CONCUR:
    ; active -> a normal end tag; inactive -> the name is consumed, the tag
    ; close parsed for its own errors, and the whole tag dropped.
    function parse_group_end_tag(this: Parser)
    {
        let ins ps.current_input()
        var active false
        if this.parse_tag_name_group(&active, false) = false
            return
        ins.start_token()
        let c ins.token_char()
        var is_name_start false
        if c >= 0
            set is_name_start: ps.get_syntax().is_name_start_character(c as u32)
        if is_name_start = false
        {
            this.report0_at(ParserMessages.endTagMissingName(), ins.token_start_location())
            return
        }
        if active
        {
            let ee this.parse_end_tag()
            this.accept_end_tag(ee)
        }
        else
        {
            ins.discard_initial()
            this.extend_name_token(this.namelen(), ParserMessages.nameLength())
            this.parse_end_tag_close()
        }
    }

    ; skipAttributeSpec (parseAttribute.cxx:433) — consume an IGNORED group
    ; start tag's attribute spec: names, VIs and values parse (their spec-level
    ; errors report as usual) but nothing is resolved against a definition or
    ; stored. A net-enabling close is startTagGroupNet, like the active path.
    function skip_attribute_spec(this: Parser) returns bool
    {
        var parm: int APT_END
        var net false
        if this.parse_attribute_parameter(tagMode, false, &parm, &net) = false
            return false
        while parm <> APT_END
        {
            if parm = APT_NAME
            {
                if this.parse_attribute_parameter(tagMode, true, &parm, &net) = false
                    return false
                if parm = APT_VI
                {
                    var token ps.get_token(tagMode)
                    while token = tokenS
                        set token: ps.get_token(tagMode)
                    if token = tokenUnrecognized
                    {
                        if this.report_non_sgml_param() = false
                        {
                            let ct ps.current_token()
                            this.report1_at(ParserMessages.attributeSpecCharacter(), ct, ps.current_input().token_start_location())
                        }
                        return false
                    }
                    else if token = tokenEe
                    {
                        this.report0_at(ParserMessages.attributeSpecEntityEnd(), ps.current_input().token_start_location())
                        return false
                    }
                    else if (token = tokenEtago) or (token = tokenStago) or (token = tokenNestc) or (token = tokenTagc) or (token = tokenDsc) or (token = tokenVi)
                    {
                        this.report0_at(ParserMessages.attributeValueExpected(), ps.current_input().token_start_location())
                        return false
                    }
                    else if (token = tokenNameStart) or (token = tokenDigit) or (token = tokenLcUcNmchar)
                    {
                        ; an unquoted value (SHORTTAG); extended to LITLEN-NORMSEP.
                        ; (skipAttributeSpec has NO -watt-value-not-literal arm —
                        ; parseAttribute.cxx:473.)
                        if ps.get_sd().attribute_value_not_literal() = false
                            this.report0_at(ParserMessages.attributeValueShorttag(), ps.current_input().token_start_location())
                        this.extend_name_token(this.attribute_value_max_length(), ParserMessages.attributeValueLength())
                    }
                    else if (token = tokenLit) or (token = tokenLita)
                    {
                        let text host.allocate(sizeof Text, alignof Text) as pointer[Text]
                        set *text: Text(StringC())
                        let lita token = tokenLita
                        if this.parse_tokenized_attribute_value_literal(lita, text) = false
                            return false
                    }
                    if this.parse_attribute_parameter(tagMode, false, &parm, &net) = false
                        return false
                }
                else
                {
                    ; a name with no VI (SHORTTAG omitted attribute name).
                    if ps.get_sd().attribute_omit_name() = false
                        this.report0_at(ParserMessages.attributeNameShorttag(), ps.current_input().token_start_location())
                }
            }
            else
            {
                ; a name token (an omitted-name value).
                if this.parse_attribute_parameter(tagMode, false, &parm, &net) = false
                    return false
                if ps.get_sd().attribute_omit_name() = false
                    this.report0_at(ParserMessages.attributeNameShorttag(), ps.current_input().token_start_location())
            }
        }
        if net
            this.report0_at(ParserMessages.startTagGroupNet(), ps.current_input().token_start_location())
        true
    }

    ; install the content-mode recognizers doContent drives (in addition to the
    ; declaration/prolog modes install_recognizers builds). Kept separate so the
    ; declaration-parser path stays byte-identical. The shortref-including
    ; modes (econ/mcon/econnet/mconnet — compileInstanceModes' modeUsesSr set)
    ; compile against the current DTD so its interned shortref delimiters
    ; tokenize as tokenFirstShortref+j.
    function install_content_recognizers(this: Parser, table: ref[Array[PackedTokenInfo]])
    {
        let sdv *ps.get_sd()
        let synv *ps.get_syntax()
        let ddch this.data_delim_chars(table, sdv, synv)
        let dtd ps.get_current_dtd()
        var modes int[20]
        let mp modes as pointer[int]
        set *(mp + 0): econMode
        set *(mp + 1): econnetMode
        set *(mp + 2): mconMode
        set *(mp + 3): mconnetMode
        set *(mp + 4): tagMode
        set *(mp + 5): cconMode
        set *(mp + 6): rcconMode
        set *(mp + 7): alitMode
        set *(mp + 8): alitaMode
        set *(mp + 9): talitMode
        set *(mp + 10): talitaMode
        set *(mp + 11): imsMode
        set *(mp + 12): cmsMode
        set *(mp + 13): rcmsMode
        set *(mp + 14): refMode
        set *(mp + 15): rcconeMode
        ; piMode: processing instructions in content (doContent case tokenPio).
        set *(mp + 16): piMode
        ; the `e` (in-entity) literal variants: an attribute value in the instance
        ; can reference an entity (`x="&quot;..."`); parse_literal switches to the
        ; matching e-mode while the entity is open, so a `"` in the replacement is
        ; data, not the literal close. Without these installed, get_token(e-mode)
        ; would run to EOF (a null recognizer returns tokenChar forever).
        set *(mp + 17): aliteMode
        set *(mp + 18): taliteMode
        set *(mp + 19): pliteMode
        var i: int 0
        while i < 20
        {
            let m *(mp + (i as size_t))
            var srdtd: ref[Dtd]? null
            if (m = econMode) or (m = mconMode) or (m = econnetMode) or (m = mconnetMode)
                set srdtd: dtd
            var amb Array[u32]^host()
            let r Recognizer.build_recognizer_sr(host, m, sdv, synv, table, srdtd, amb, ddch)
            ps.set_recognizer(m, r)
            this.report_mode_ambiguities(amb, m)
            set i: i + 1
        }
        ; ...and RECOMPILE the normal map against this DTD. compileInstanceModes
        ; (parseMode.cxx:117) does exactly this, and it is not optional: the map
        ; is what `extend_data` scans, so a shortref delimiter's first character
        ; must STOP a data run or the recognizer never sees the delimiter and the
        ; short reference silently arrives as data. install_recognizers builds the
        ; map with no DTD (the prolog has no short references); this call is the
        ; instance's. See the regression note on compile_normal_map.
        this.compile_normal_map(table, sdv, synv, dtd)
    }

    ; ======================================================================
    ; Prolog + full-document driver — Stage 4, Increment 3 (external subset: 6).
    ;
    ; A SCOPED port of doProlog + parseDoctypeDeclStart (Parser.cs): drives the
    ; document from the first token through the DOCTYPE declaration into content
    ; parsing, so a whole SGML document parses end-to-end and the event queue
    ; feeds the ESIS writer (Esis.write) — the tests/sgml corpus harness. Handles
    ; both an INTERNAL DTD subset (`<!DOCTYPE name [ ... ]>`) and an EXTERNAL one
    ; (`<!DOCTYPE name SYSTEM "sub.dtd">` / `PUBLIC "..." "sub.dtd"`), resolved
    ; relative to the document's base directory.
    ;
    ; DEFERRED: catalog resolution of a PUBLIC id with no system id
    ; (generateSystemId), an implied DTD from the first start tag (implyDtd),
    ; LINKTYPE, prolog PIs/comments, the startDtd/endProlog markup events.

    ; Build an InputSource from raw entity bytes: DECODE them as UTF-8 to Chars and
    ; apply the `lf` record normalization, so declaration-subset whitespace
    ; tokenizes as separators. The Char buffer lives on `host`.
    ;
    ; RECORD NORMALIZATION (ExtendEntityManager.cxx, ExternalInputSource::fill +
    ; init): a source's records are RS-delimited. `insertRS_` starts TRUE for EVERY
    ; external input source — the document entity, the external DTD subset AND a
    ; text entity included in content — and is re-armed after every record end, so
    ; the Char stream is
    ;
    ;     RS line1 RE RS line2 RE RS line3 ...
    ;
    ; i.e. one RS (0x0A) before the first record, each source LF (0x0A) translated
    ; to RE (0x0D), and one RS inserted before the NEXT char after each RE. A
    ; pending RS at end of entity is dropped (fill returns eE without flushing it),
    ; so a file ending in a newline ends with RE, not RE RS.
    ;
    ; That is the `lf` RECORD TYPE. The reference DETECTS the type per entity from
    ; its first CR/LF (recordType_ starts `unknown`), and the three types reach the
    ; same RE-RS shape by different routes — note that RS *is* LF and RE *is* CR:
    ;   lf     LF -> RE, an RS is INSERTED after it        (Unix)
    ;   crlf   CR already IS the RE, LF already IS the RS  (Windows) — nothing is
    ;          translated or inserted at all; a final LF at end of entity is dropped
    ;          (the reference deletes the RS "not followed by anything"), so a CRLF
    ;          file also ends with RE.
    ;   cr     CR already IS the RE, an RS is INSERTED     (classic Mac)
    ; A source with no CR and no LF at all is `asis`: no records, nothing inserted
    ; but the leading RS. Getting this wrong on a CRLF file emits RE RE RS per line
    ; (the CR passing through as a second record end).
    ;
    ; The inserted RSs are load-bearing under KEEPRSRE YES (xml.dcl): RS and RE are
    ; then ordinary DATA chars, and onsgmls prints them in ESIS as `\012` and `\n`
    ; respectively (SgmlsEventHandler::outputString) — so `x<LF>y` in mixed content
    ; is the data `x` RE RS `y`. Under KEEPRSRE NO they tokenize as tokenRs and the
    ; OutputState machine drops them.
    ;
    ; onsgmls under SP_ENCODING=XML decodes EVERY entity as UTF-8 (XMLCodingSystem
    ; -> UTF8CodingSystem): a well-formed sequence yields its Char, a byte that
    ; cannot start or continue one yields U+FFFD and is consumed ALONE (so a
    ; Latin-1 `ü` in an otherwise-ASCII file becomes exactly one U+FFFD and the
    ; following chars still scan normally), and a leading BOM is stripped. That
    ; U+FFFD is the only Char >= 256 the corpus produces; see Partition's high-char
    ; slot for how it stays a DATA char rather than colliding with the eE sentinel.
    ;
    ; Continuation bytes are all >= 0x80, so no multibyte sequence can hide an LF —
    ; the record normalization stays correct after decoding.
    function make_char_source(host: ref[Page], bytes: String, org: ref[Origin]) returns ref[InputSource]
        Parser.make_char_source_block(host, bytes, org, 8192)

    ; ...with an explicit input coding system (the app's codingSystem(), which
    ; ExtendEntityManager::make hands the entity manager).
    function make_char_source_cs(host: ref[Page], bytes: String, org: ref[Origin], cs: CodingSystem) returns ref[InputSource]
        Parser.make_char_source_block_cs(host, bytes, org, 8192, cs)

    ; `block` = the storage object's read-block size (st_blksize of the file;
    ; 8192 for non-files) — the reference reads in blocks of this many RAW
    ; BYTES, and a data token never crosses a block edge.
    function make_char_source_block(host: ref[Page], bytes: String, org: ref[Origin], block: size_t) returns ref[InputSource]
        Parser.make_char_source_block_cs(host, bytes, org, block, CodingSystem.simple(IENC_UTF8))

    ; ---- the STREAMING form (ExternalInputSource) --------------------------
    ; What every external source is built with. The source keeps a WINDOW of the
    ; entity and decodes the next read block on demand (InputSource.fill), so the
    ; document costs a window plus its RS-offset list instead of 4 bytes per char
    ; — plus as much again in worst-case reserve — for the whole text.
    ;
    ; `raw`/`raw_len` MUST OUTLIVE the source: it decodes from them for the whole
    ; parse. The eager form below could be handed a transient String; this one
    ; cannot, so its callers pin the bytes on `host`.
    ;
    ; Everything that needs CodingSystemKit (declared after Location) or the
    ; whole object at once happens HERE, once: the decoder split and the record
    ; type. fill() then only calls CodingSystem.decode_one.
    function make_char_source_stream_cs(host: ref[Page], raw: pointer[u8], raw_len: size_t, org: ref[Origin], block: size_t, cs: CodingSystem) returns ref[InputSource]
    {
        var skip: size_t 0
        var cs_first CodingSystem.identity()
        var switch_at raw_len
        var cs_rest CodingSystem.identity()
        CodingSystemKit.resolve_input(host, cs, raw, raw_len, &skip, &cs_first, &switch_at, &cs_rest)
        let start skip + cs_first.bom_skip(raw + skip, raw_len - skip)
        let rt Parser.detect_record_type(raw, raw_len, start, cs_first, switch_at, cs_rest)
        var blk block
        if blk = 0
            set blk: 8192
        ; the origin's two tables grow as the entity decodes; `contents` stays
        ; null — a windowed source has text without having the whole buffer.
        org.set_stream(Array[u32]^host(), Array[size_t]^host())
        InputSource.make_stream(host, org, raw, raw_len, start, cs_first, switch_at, cs_rest, rt, blk)
    }

    ; recordType_: the first CR or LF in the entity decides it — over DECODED
    ; chars, not raw bytes: under a fixed-width system an ASCII char's OTHER
    ; bytes are zero and a raw scan would mistake the pieces of one char for a
    ; record boundary.
    function detect_record_type(raw: pointer[u8], n: size_t, from: size_t, cs_first: CodingSystem, switch_at: size_t, cs_rest: CodingSystem) returns int
    {
        var rt: int RT_ASIS
        var s from
        while s < n
        {
            var sch: u32 IENC_NO_CHAR
            var slen: size_t 0
            if s >= switch_at
                set slen: cs_rest.decode_one(raw, n, s, &sch)
            else
                set slen: cs_first.decode_one(raw, n, s, &sch)
            if slen = 0
                set s: n
            else if sch = 0x0A
            {
                set rt: RT_LF
                set s: n
            }
            else if sch = 0x0D
            {
                ; a CR with nothing after it is the reference's crUnknown -> cr.
                set rt: RT_CR
                let s2 s + slen
                if s2 < n
                {
                    var sch2: u32 IENC_NO_CHAR
                    var slen2: size_t 0
                    if s2 >= switch_at
                        set slen2: cs_rest.decode_one(raw, n, s2, &sch2)
                    else
                        set slen2: cs_first.decode_one(raw, n, s2, &sch2)
                    if slen2 > 0
                    {
                        if sch2 = 0x0A
                            set rt: RT_CRLF
                    }
                }
                set s: n
            }
            else
                set s: s + slen
        }
        rt
    }

    ; ---- the FILE-BACKED streaming form (PosixStorageObject) ----------------
    ; The entity stays on DISK: only a window of raw bytes and a window of decoded
    ; Chars are ever in memory. This is what the reference does — its
    ; StorageObject::read hands the parser one read block at a time and nothing
    ; keeps the object's bytes — and it is the difference between a parse costing
    ; ONE BYTE PER INPUT BYTE for the whole run and costing a window: measured on
    ; the 13.7 MB corpus document, the eager form pinned the full 13.7 MB on the
    ; run region even in prolog-only mode (`-p`), where none of the instance is
    ; ever looked at.
    ;
    ; The two pre-passes (`resolve_input`'s decoder split, the record type) run on
    ; the FIRST BUFFER instead of the whole object, and both can decline: a
    ; decoder switch that would fall outside the prefix, or an entity with no
    ; record boundary in it at all, returns null here and the caller reads the
    ; object whole as before. So this is an optimization of the COMMON case with
    ; the general case intact, not a narrowing of what the parser accepts.
    ;
    ; Null means "cannot stream this one" — the caller reads the object whole.
    function make_char_source_path_cs(host: ref[Page], path: String, org: ref[Origin], block: size_t, cs: CodingSystem) returns ref[InputSource]?
    {
        var blk block
        if blk = 0
            set blk: 8192
        ; the raw window spans several read blocks so that a per-block fill() does
        ; not mean a read(2) per block; it must hold one block plus the lookahead
        ; one char may need across the block edge.
        var cap (blk * 2) + RAW_CHAR_MAX
        if cap < 65536
            set cap: 65536
        let hpath String^host(path)
        let fp fopen(hpath.to_c_string(), "rb")
        if fp = null
            return null
        ; the entity's length, from the descriptor we already hold (2 = SEEK_END,
        ; the literal EntityCatalog spells the same way)
        let ended scaly_eio_seek(fp, 0 as i64, 2)
        let told scaly_eio_tell(fp)
        if told < 0
        {
            let closed fclose(fp)
            return null
        }
        let raw_len told as size_t
        ; an EMPTY entity is handed to the whole-object path: it is a valid
        ; zero-char source there, the pre-passes below have no bytes to judge, and
        ; a streaming source over it would never reach the end of entity that
        ; closes the descriptor.
        if raw_len = 0
        {
            let closed0 fclose(fp)
            return null
        }
        let rewound scaly_eio_seek(fp, 0 as i64, 0)
        let buf host.allocate(cap, 1) as pointer[u8]
        let got fread(buf as pointer[void], 1 as size_t, cap, fp)

        var skip: size_t 0
        var cs_first CodingSystem.identity()
        var switch_at got
        var cs_rest CodingSystem.identity()
        CodingSystemKit.resolve_input(host, cs, buf, got, &skip, &cs_first, &switch_at, &cs_rest)
        ; resolve_input answers switch_at = its own `n` when there is NO switch, so
        ; on a prefix that answer has to be re-read against the whole entity: same
        ; decoder on both sides means no switch and the split is the entity end;
        ; different decoders with the switch at the prefix edge means the
        ; declaration may run past what was read — decline rather than guess.
        if switch_at >= got
        {
            if cs_first.get_kind() = cs_rest.get_kind()
                set switch_at: raw_len
            else if got < raw_len
            {
                let closed fclose(fp)
                return null
            }
        }
        let start skip + cs_first.bom_skip(buf + skip, got - skip)
        let rt Parser.detect_record_type_prefix(buf, got, raw_len, start, cs_first, switch_at, cs_rest)
        if rt = RT_UNKNOWN
        {
            let closed fclose(fp)
            return null
        }
        org.set_stream(Array[u32]^host(), Array[size_t]^host())
        InputSource.make_stream_file(host, org, buf, cap, got, raw_len, fp, *hpath, start, cs_first, switch_at, cs_rest, rt, blk)
    }

    ; detect_record_type over a PREFIX of `valid` bytes of a `total`-byte entity:
    ; the same scan, but a prefix that ends without a record boundary while the
    ; entity goes on cannot answer `asis` — it answers RT_UNKNOWN and the caller
    ; falls back to the whole-object form. (The reference has no such case: its
    ; recordType_ starts `unknown` and is decided as it decodes.)
    function detect_record_type_prefix(raw: pointer[u8], valid: size_t, total: size_t, from: size_t, cs_first: CodingSystem, switch_at: size_t, cs_rest: CodingSystem) returns int
    {
        let rt Parser.detect_record_type(raw, valid, from, cs_first, switch_at, cs_rest)
        if rt <> RT_ASIS
            return rt
        ; `asis` from a partial read is "no boundary in the prefix", not a verdict.
        if valid < total
            return RT_UNKNOWN
        rt
    }

    ; ---- the EAGER form ----------------------------------------------------
    ; Decodes the whole object up front. Kept for the CATALOG, whose parser
    ; reads the normalized buffer directly rather than scanning it through an
    ; InputSource (parse_catalog hands it org.get_contents()), and for the
    ; MULTI-FILE document entity, whose storage objects are merged into one
    ; buffer with a segment table before any of them is scanned.
    function make_char_source_block_cs(host: ref[Page], bytes: String, org: ref[Origin], block: size_t, cs: CodingSystem) returns ref[InputSource]
    {
        let n bytes.get_length()
        ; upper bound: at most one Char per input byte (multibyte sequences only
        ; ever shrink) plus its inserted RS (an all-LF source doubles), + slack.
        let buf host.allocate(((n * 2) + 2) * 4, 4) as pointer[u32]
        var out: size_t 0
        ; the leading RS: armed at entity start, flushed before the first Char.
        var pending_rs true
        ; (single storage object: the returned startsWithRS is implicit in the
        ; non-empty buffer's leading RS — only segmented documents store it.)
        let bounds Array[size_t]^host()
        let flushed Parser.normalize_append_bounds_cs(host, bytes, buf, &out, &pending_rs, bounds, block, cs)

        ; stash the normalized buffer on the origin so a diagnostic that resolves
        ; to this source (possibly below the current top input) can compute line/col
        ; from it — MessageReporter::printLocation's origin-chain resolution.
        org.set_buffer(buf, out, Parser.build_rs_list(host, buf, out))
        org.set_fill_bounds(bounds)
        let src host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
        set *src: InputSource(org, buf, out)
        src
    }

    ; The RS-offset list of a finished normalized buffer (ExternalInfoImpl's
    ; rsList_, built by noteRS as fill() inserts each record start). Collected
    ; by a scan of the buffer rather than at the write sites on purpose: the
    ; `crlf` record type DELETES a trailing record start again at the end of a
    ; storage object, and a scan of the finished bytes cannot disagree with
    ; what the buffer holds. It is also exactly what the line/col scan this
    ; list replaced used to see, which is what keeps line/col byte-identical.
    function build_rs_list(host: ref[Page], buf: pointer[u32], n: size_t) returns ref[Array[u32]]
    {
        let rs Array[u32]^host()
        var i: size_t 0
        while i < n
        {
            if *(buf + i) = 0x0A
                rs.add(i as u32)
            set i: i + 1
        }
        rs
    }

    ; Normalize ONE storage object's bytes into the shared decoded buffer —
    ; the per-object half of make_char_source (BOM strip, per-object record-
    ; type detection, UTF-8 decode, RS/RE record normalization), appending at
    ; *out_pos. The record-start RS pending at the previous object's end
    ; carries IN through *pending_rs and a trailing record end carries it OUT
    ; (ExternalInputSource::insertRS_ survives the storage-object switch in
    ; fill(); the entity's very first object enters with it armed). Returns
    ; whether the pending RS flushed as this object's FIRST char — the
    ; segment's startsWithRS (an object with no decoded chars never flushes;
    ; the RS then belongs to the NEXT object, like ExternalInfoImpl::noteRS's
    ; boundary-offset rule).
    function normalize_append(host: ref[Page], bytes: String, buf: pointer[u32], out_pos: pointer[size_t], pending_rs: pointer[bool]) returns bool
        Parser.normalize_append_bounds(host, bytes, buf, out_pos, pending_rs, null, 8192)

    function normalize_append_bounds(host: ref[Page], bytes: String, buf: pointer[u32], out_pos: pointer[size_t], pending_rs: pointer[bool], bounds: ref[Array[size_t]]?, block: size_t) returns bool
        Parser.normalize_append_bounds_cs(host, bytes, buf, out_pos, pending_rs, bounds, block, CodingSystem.simple(IENC_UTF8))

    ; `host` is where the coding system's own working state goes (an XML
    ; declaration's text and, if it names one, a translate decoder's map) — it
    ; must be a REAL region page: `Page.get(buf)` is NOT one, because `buf` is an
    ; oversized allocation for every entity past a few hundred bytes (see
    ; CodingSystemKit.resolve_input).
    function normalize_append_bounds_cs(host: ref[Page], bytes: String, buf: pointer[u32], out_pos: ref[size_t], pending_rs: ref[bool], bounds: ref[Array[size_t]]?, block: size_t, cs: CodingSystem) returns bool
    {
        let n bytes.get_length()
        var out: size_t out_pos
        let seg_start out
        var pending: bool pending_rs
        let entered_pending pending

        ; the INPUT CODING SYSTEM (CmdLineApp::initCodingSystem -> the entity
        ; manager). The two stateful systems are resolved first: XMLDecoder's
        ; autodetect + `<?xml … encoding="…"?>` and UnicodeDecoder's byte-order
        ; mark both answer with a byte offset to skip, the decoder for the region
        ; up to a switch point (an XML declaration is read at the GUESSED width)
        ; and the decoder for everything after it. Note that only the UTF-8
        ; decoder strips a byte-order mark of its own — under the identity system
        ; those three bytes are DATA, as in the reference.
        let raw bytes.get_buffer()
        var skip: size_t 0
        var cs_first CodingSystem.identity()
        var switch_at n
        var cs_rest CodingSystem.identity()
        CodingSystemKit.resolve_input(host, cs, raw, n, &skip, &cs_first, &switch_at, &cs_rest)
        var i skip + cs_first.bom_skip(raw + skip, n - skip)

        let rt Parser.detect_record_type(raw, n, i, cs_first, switch_at, cs_rest)

        ; reference read-block tracking: fill() reads 8192 RAW BYTES per
        ; block; a char whose last byte falls past the block edge is carried
        ; into the next block (decoder leftover), and a pending RS always
        ; materializes at the START of the freshly read block. Record the
        ; normalized index where each new block begins.
        var next_bound: size_t block
        if next_bound = 0
            set next_bound: 8192
        while i < n
        {
            var ch: u32 IENC_NO_CHAR
            var len: size_t 0
            ; bytes that carry NO character at all (the SJIS decoder has three
            ; such classes) are consumed and emit nothing, so skip forward until
            ; a real char, the end of the buffer, or a truncated tail.
            var truncated false
            while ch = IENC_NO_CHAR
            {
                if i >= n
                {
                    set truncated: true
                    break
                }
                ; the region before `switch_at` is read with the first decoder
                ; (an XML declaration at its guessed width), the rest with the
                ; one that declaration selected.
                if i >= switch_at
                    set len: cs_rest.decode_one(raw, n, i, &ch)
                else
                    set len: cs_first.decode_one(raw, n, i, &ch)
                if len = 0
                {
                    set truncated: true
                    break
                }
                if ch = IENC_NO_CHAR
                    set i: i + len
            }
            if truncated
                break
            ; this char's last raw byte crosses the read-block edge: the char
            ; (and any pending RS) belongs to the NEXT block.
            if bounds <> null
            {
                while (i + len) > next_bound
                {
                    bounds.add(out)
                    set next_bound: next_bound + block
                }
            }
            ; flush the RS armed by the entity start / the previous record end.
            if pending
            {
                set *(buf + out): 0x0A
                set out: out + 1
                set pending: false
            }
            ; the record end, per record type. `lf`: the LF becomes RE and arms the
            ; next record's RS (which stays unflushed at end of object — it either
            ; carries into the next storage object or is dropped at entity end).
            ; `cr`: the CR already IS the RE, it only arms the RS.
            ; `crlf` / `asis`: nothing — CR and LF are already RE and RS.
            if rt = RT_LF
            {
                if ch = 0x0A
                {
                    set ch: 0x0D
                    set pending: true
                }
            }
            else if rt = RT_CR
            {
                if ch = 0x0D
                    set pending: true
            }
            set *(buf + out): ch
            set out: out + 1
            set i: i + len
        }

        ; crlf: "Need to delete final RS if not followed by anything" — a source
        ; ending in CRLF ends with the RE, like every other record type; the
        ; deleted RS re-arms the pending record start (insertRS_ = true), which
        ; a FOLLOWING storage object then re-inserts at the boundary.
        if rt = RT_CRLF
        {
            if out > seg_start
            {
                if *(buf + (out - 1)) = 0x0A
                {
                    set out: out - 1
                    set pending: true
                }
            }
        }

        set out_pos: out
        set pending_rs: pending
        ; startsWithRS: the pending RS this object entered with flushed as its
        ; first char (some char decoded — an empty object carries it onward).
        if entered_pending and (out > seg_start)
            return true
        false
    }

    ; Load an external DTD subset named by a system id, resolved relative to the
    ; document's base directory (Storage.OsFile), into an InputSource (not yet
    ; pushed). Returns null ONLY if the file cannot be opened (the caller
    ; reports openSystemCall and parses on with the internal subset alone); an
    ; existing-but-EMPTY file is a valid zero-char subset, as in real onsgmls.
    function load_external_subset(this: Parser, base_dir: String, system_id: String) returns ref[InputSource]?
    {
        let storage Storage.OsFile(base_dir)
        let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org: Origin()
        ; the storage id onsgmls displays for a location in this external subset:
        ; ExternalEntity::generateSystemId's effective system id = the relative
        ; SYSTEM literal resolved against the document's directory (base_dir).
        ; Verified vs real onsgmls: a diagnostic in dtd/model.dtd prints
        ; `dtd/model.dtd`, the RESOLVED path — Path.join(base_dir, system_id). Pin
        ; the widened StringC on host (^host) so it outlives the transient String.
        let disp Path.join(base_dir, system_id)
        let dblk scaly_eio_blksize_path(disp.to_c_string()) as size_t
        org.set_file_name(StringC^host(disp.to_c_string()))
        ; stream off the file when we can. The whole-object read below stays the
        ; fallback AND the path that reports an open failure, so a missing file is
        ; diagnosed exactly where it was: streaming just answers null for it.
        ; `storage.resolve` — not Path.join — so the file streamed is the file the
        ; fallback would read (they differ for an empty base_dir).
        let rpath storage.resolve(base_dir, system_id)
        let streamed Parser.make_char_source_path_cs(host, rpath, org, dblk, ps.input_coding())
        if streamed <> null
            return streamed
        let bytes storage.read(system_id)
        if bytes.get_length() = 0
        {
            let emsg storage.open_error(system_id)
            if emsg <> null
                return null
        }
        ; the streaming source decodes from these bytes for the whole parse, so
        ; they must live on the region, not in this frame.
        let pinned String^host(bytes)
        Parser.make_char_source_stream_cs(host, pinned.get_buffer(), pinned.get_length(), org, dblk, ps.input_coding())
    }

    ; EntityManager::open for an external TEXT entity: resolve its (relative)
    ; system id against `base_dir` (the directory of the file the entity was
    ; DECLARED in — see ExternalTextEntity.base_dir) and decode the file into an
    ; InputSource carrying `org` (whose entity_decl arms the recursion guard). The
    ; SAME record normalization as the document entity applies — an included text
    ; entity is an external input source like any other. Null ONLY if the file
    ; cannot be opened (the caller reports openSystemCall at the reference site);
    ; an existing-but-empty entity file is valid, zero-char content.
    function open_external_text(this: Parser, base_dir: String, system_id: String, org: ref[Origin]) returns ref[InputSource]?
    {
        let storage Storage.OsFile(base_dir)
        ; the storage id onsgmls displays for a location in this external text
        ; entity: its effective system id = the entity's SYSTEM literal resolved
        ; against the DECLARING file's directory (base_dir = ExternalTextEntity's
        ; captured base_dir). Verified vs real onsgmls: an entity declared in
        ; dtd/model.dtd as SYSTEM "chap.sgm" prints `dtd/chap.sgm`, the RESOLVED
        ; path — Path.join(base_dir, system_id). Pin the widened StringC on host.
        let disp Path.join(base_dir, system_id)
        let dblk scaly_eio_blksize_path(disp.to_c_string()) as size_t
        org.set_file_name(StringC^host(disp.to_c_string()))
        ; as in load_external_subset: stream when we can, read whole otherwise.
        ; This is the site that carries the volume on an entity-split corpus — the
        ; module codegens reach ~6 MB of input through external text entities.
        let rpath storage.resolve(base_dir, system_id)
        let streamed Parser.make_char_source_path_cs(host, rpath, org, dblk, ps.input_coding())
        if streamed <> null
            return streamed
        let bytes storage.read(system_id)
        if bytes.get_length() = 0
        {
            let emsg storage.open_error(system_id)
            if emsg <> null
                return null
        }
        let pinned String^host(bytes)
        Parser.make_char_source_stream_cs(host, pinned.get_buffer(), pinned.get_length(), org, dblk, ps.input_coding())
    }

    ; ---- effective-system-id (FSI) opening --------------------------------
    ; The port's effective system ids are FULL formal-system-identifier texts
    ; (catalog_effective_id builds them, the f-record prints them verbatim):
    ;   <OSFILE>path                        resolved at stamp time
    ;   <OSFILE SOIBASE='base'>spec         deferred (search dirs configured)
    ;   <CATALOG PUBLIC="pub"><OSFILE>cat   a DELEGATE map (resolved at open)
    ; fsi_parse decomposes one; kind 0 = plain path (a), 1 = SOIBASE deferred
    ; (a = base file id, b = spec), 2 = delegate (a = public id, b = catalog).
    ; decompose into (start,len) slices of fsi — the OUT params stay scalar
    ; (the escape checker rejects call-result Strings stored through out
    ; pointers); callers slice with substr into locals.
    function fsi_parse(this: Parser, fsi: String, out_kind: ref[int], out_a_start: ref[size_t], out_a_len: ref[size_t], out_b_start: ref[size_t], out_b_len: ref[size_t])
    {
        set out_kind: 0
        set out_a_start: 0
        set out_a_len: fsi.get_length()
        set out_b_start: 0
        set out_b_len: 0
        let dprefix String("<CATALOG PUBLIC=\"")
        if this.starts_with(fsi, dprefix)
        {
            let dsep String("\"><OSFILE>")
            let cut this.find_sub(fsi, dsep, dprefix.get_length())
            if cut < fsi.get_length()
            {
                set out_kind: 2
                set out_a_start: dprefix.get_length()
                set out_a_len: cut - dprefix.get_length()
                let boff cut + dsep.get_length()
                set out_b_start: boff
                set out_b_len: fsi.get_length() - boff
                return
            }
        }
        let sprefix String("<OSFILE SOIBASE='")
        if this.starts_with(fsi, sprefix)
        {
            let ssep String("'>")
            let cut2 this.find_sub(fsi, ssep, sprefix.get_length())
            if cut2 < fsi.get_length()
            {
                set out_kind: 1
                set out_a_start: sprefix.get_length()
                set out_a_len: cut2 - sprefix.get_length()
                let boff2 cut2 + ssep.get_length()
                set out_b_start: boff2
                set out_b_len: fsi.get_length() - boff2
                return
            }
        }
        let oprefix String("<OSFILE>")
        if this.starts_with(fsi, oprefix)
        {
            set out_a_start: oprefix.get_length()
            set out_a_len: fsi.get_length() - oprefix.get_length()
        }
    }

    function starts_with(this: Parser, s: String, prefix: String) returns bool
    {
        let n prefix.get_length()
        if s.get_length() < n
            return false
        var i: size_t 0
        while i < n
        {
            if s.get(i) <> prefix.get(i)
                return false
            set i: i + 1
        }
        true
    }

    function find_sub(this: Parser, s: String, needle: String, from: size_t) returns size_t
    {
        let n s.get_length()
        let m needle.get_length()
        var i from
        while (i + m) <= n
        {
            var same true
            var j: size_t 0
            while j < m
            {
                if s.get(i + j) <> needle.get(j)
                {
                    set same: false
                    set j: m
                }
                else
                    set j: j + 1
            }
            if same
                return i
            set i: i + 1
        }
        n
    }

    function substr(this: Parser, s: String, start: size_t, len: size_t) returns String
    {
        let out String^host((s.get_buffer() + start) as pointer[const_char], len)
        *out
    }

    ; PosixStorageManager::extractDir — up to and INCLUDING the last slash
    ; (the root case keeps its slash).
    function extract_dir(this: Parser, s: String) returns String
    {
        var i s.get_length()
        while i > 0
        {
            if s.get(i - 1) = 0x2F
                return this.substr(s, 0, i)
            set i: i - 1
        }
        String()
    }

    ; PosixStorageManager::isSafe (-R): only [a-zA-Z0-9/.-_], no `..`, and
    ; the file's directory must sit under one of the -D search directories.
    function is_safe_path(this: Parser, file: String) returns bool
        Parser.path_safe(ps, file)

    ; the fd-0 pseudo-spec EntityApp::makeSystemId builds for a `-` file
    ; argument (the driver converts before merging).
    function spec_is_fd0(spec: String) returns bool
        spec.equals("<OSFD>0")

    ; Resolve ONE document file spec through the storage candidate walk (the
    ; spec itself, then each -D search dir; -R filters) — the document half
    ; of PosixStorageManager::makeStorageObject. true: *out_path = the found
    ; path (the displayed storage id). false: *out_is_find selects the
    ; message shape (cannotFind after a search walk, openSystemCall for the
    ; single candidate) and *out_detail carries its %2 payload (the quoted
    ; tried-list / the strerror text, captured at open time). Outputs are
    ; pinned on the parser's page.
    function resolve_doc_file(this: Parser, em_cfg: ref[EmConfig], dspec: String, out_path: pointer[String], out_is_find: ref[bool], out_detail: pointer[String]) returns bool
    {
        let hp this.host
        var dabs false
        if dspec.get_length() > 0
        {
            if dspec.get(0) = 0x2F
                set dabs: true
        }
        let dcands Array[String]^hp()
        var dsingle true
        dcands.add(dspec)
        if dabs = false
        {
            let sds3 em_cfg.search_dirs
            if sds3 <> null
            {
                let nsd3 sds3.get_length()
                if nsd3 > 0
                    set dsingle: false
                var k3: size_t 0
                while k3 < nsd3
                {
                    let sd3 sds3[k3]
                    dcands.add(EntityCatalog.resolve_target(sd3, dspec))
                    set k3: k3 + 1
                }
            }
        }
        var drestrict false
        set drestrict: em_cfg.restrict_reading
        let dtried Array[u8]^hp()
        var dtried_any false
        let ndc dcands.get_length()
        var dci: size_t 0
        while dci < ndc
        {
            let dcand dcands[dci]
            var dskip false
            if drestrict
            {
                if Parser.path_safe(this.ps, dcand) = false
                    set dskip: true
            }
            if dskip = false
            {
                let dhc String^hp(dcand)
                let df fopen(dhc.to_c_string(), "rb")
                if df <> null
                {
                    let dclosed fclose(df)
                    set *out_path: *dhc
                    return true
                }
                if dsingle and (drestrict = false)
                {
                    let derr String^hp(strerror(scaly_eio_errno()) as pointer[const_char])
                    set out_is_find: false
                    set *out_detail: *derr
                    return false
                }
                if drestrict = false
                {
                    if dtried_any
                    {
                        dtried.add(0x2C)
                        dtried.add(0x20)
                    }
                    dtried.add(0x22)
                    var dti: size_t 0
                    while dti < dcand.get_length()
                    {
                        dtried.add(dcand.get(dti))
                        set dti: dti + 1
                    }
                    dtried.add(0x22)
                    set dtried_any: true
                }
            }
            set dci: dci + 1
        }
        let dtstr String^hp(dtried.get_buffer() as pointer[const_char], dtried.get_length())
        set out_is_find: true
        set *out_detail: *dtstr
        false
    }

    function path_safe(ps: ref[ParserState], file: String) returns bool
    {
        let n file.get_length()
        var i: size_t 0
        while i < n
        {
            let c file.get(i)
            if (c = 0x2E) and (i > 0)
            {
                if file.get(i - 1) = 0x2E
                    return false
            }
            var ok false
            if (c >= 0x61) and (c <= 0x7A)
                set ok: true
            if (c >= 0x41) and (c <= 0x5A)
                set ok: true
            if (c >= 0x30) and (c <= 0x39)
                set ok: true
            if (c = 0x2F) or (c = 0x2E) or (c = 0x2D) or (c = 0x5F)
                set ok: true
            if ok = false
                return false
            set i: i + 1
        }
        ; extractDir keeps the trailing slash (root case).
        var dlen: size_t 0
        var di n
        while di > 0
        {
            if file.get(di - 1) = 0x2F
            {
                set dlen: di
                set di: 0
            }
            else
                set di: di - 1
        }
        let cfg ps.get_em_config()
        if cfg = null
            return false
        let sds cfg.search_dirs
        if sds = null
            return false
        let nsd sds.get_length()
        var k: size_t 0
        while k < nsd
        {
            let sd2 sds[k]
            let sn sd2.get_length()
            if dlen >= sn
            {
                var same true
                var j: size_t 0
                while j < sn
                {
                    if sd2.get(j) <> file.get(j)
                    {
                        set same: false
                        set j: sn
                    }
                    else
                        set j: j + 1
                }
                if same
                {
                    if dlen = sn
                        return true
                    if file.get(sn) = 0x2F
                        return true
                }
            }
            set k: k + 1
        }
        false
    }

    ; PosixStorageManager::combineDir — dir may carry its trailing slash.
    function combine_dir(this: Parser, dir: String, spec: String) returns String
    {
        if dir.get_length() = 0
            return spec
        if dir.get(dir.get_length() - 1) = 0x2F
        {
            let acc Array[u8]^host()
            this.append_bytes(acc, dir)
            this.append_bytes(acc, spec)
            let out String^host(acc.get_buffer() as pointer[const_char], acc.get_length())
            return *out
        }
        Path.join(dir, spec)
    }

    ; PosixStorageManager::makeStorageObject over an effective-id FSI: walk
    ; the candidates (a plain path stands alone; a SOIBASE spec combines with
    ; the base file's directory, then each -D search directory), honoring -R
    ; (unsafe candidates are skipped and never listed). On success the FOUND
    ; path becomes the origin's display name (and *out_found). On failure the
    ; reference's message split: the single-candidate arm (plain / absolute,
    ; unrestricted) reports openSystemCall with the live errno; the searched
    ; arm reports cannotFind with the tried list (EMPTY under -R). A DELEGATE
    ; FSI parses the delegate catalog and resolves the public id through it
    ; (noPublicEntry at fail_loc on a miss), then opens the result.
    ; fail_loc anchors storage-open failures; map_loc anchors the DELEGATE
    ; map's noPublicEntry (the REFC-token start at a content reference —
    ; probed 4:14 — where open failures anchor at the reference START).
    function fsi_open(this: Parser, fsi: String, org: ref[Origin], fail_loc: Location, map_loc: Location, depth: int, out_found: pointer[String]) returns ref[InputSource]?
    {
        set *out_found: String()
        var kind 0
        var pas: size_t 0
        var pal: size_t 0
        var pbs: size_t 0
        var pbl: size_t 0
        this.fsi_parse(fsi, &kind, &pas, &pal, &pbs, &pbl)
        var pa this.substr(fsi, pas, pal)
        var pb this.substr(fsi, pbs, pbl)
        if kind = 2
        {
            if depth > 20
                return null
            let dcat EntityCatalog.make(host)
            Parser.parse_catalog_file(host, ps, dcat, pb, String(), true, true, null, false, Location())
            var pd false
            let de dcat.find_public_entry(pa, false, &pd)
            if de = null
            {
                var nargs Vector[MessageArg](2)
                set *(nargs.get(0)): MessageArg.Str(Parser.widen_arg(host, pa))
                let catfsi Array[u8]^host()
                this.append_bytes(catfsi, String("<OSFILE>"))
                this.append_bytes(catfsi, pb)
                let catarg String^host(catfsi.get_buffer() as pointer[const_char], catfsi.get_length())
                set *(nargs.get(1)): MessageArg.Str(Parser.widen_arg(host, *catarg))
                ps.report_at(CatalogMessages.noPublicEntry(), nargs, map_loc)
                return null
            }
            let sub Array[u8]^host()
            if pd
            {
                this.append_bytes(sub, String("<CATALOG PUBLIC=\""))
                this.append_bytes(sub, pa)
                this.append_bytes(sub, String("\"><OSFILE>"))
                this.append_bytes(sub, dcat.resolve(de))
            }
            else
            {
                this.append_bytes(sub, String("<OSFILE>"))
                this.append_bytes(sub, dcat.resolve(de))
            }
            let subfsi String^host(sub.get_buffer() as pointer[const_char], sub.get_length())
            return this.fsi_open(*subfsi, org, fail_loc, map_loc, depth + 1, out_found)
        }

        var spec pa
        var single true
        let cands Array[String]^host()
        if kind = 1
        {
            set spec: pb
            var absolute false
            if pb.get_length() > 0
            {
                if pb.get(0) = 0x2F
                    set absolute: true
            }
            if absolute
                cands.add(pb)
            else
            {
                set single: false
                cands.add(this.combine_dir(this.extract_dir(pa), pb))
                let cfg ps.get_em_config()
                if cfg <> null
                {
                    let sds cfg.search_dirs
                    if sds <> null
                    {
                        let nsd sds.get_length()
                        var k: size_t 0
                        while k < nsd
                        {
                            let sd2 sds[k]
                            cands.add(this.combine_dir(sd2, pb))
                            set k: k + 1
                        }
                    }
                }
            }
        }
        else
            cands.add(pa)

        var restrict false
        let cfg2 ps.get_em_config()
        if cfg2 <> null
            set restrict: cfg2.restrict_reading

        let tried Array[u8]^host()
        var tried_any false
        let nc cands.get_length()
        var ci: size_t 0
        while ci < nc
        {
            let cand cands[ci]
            var skip false
            if restrict
            {
                if this.is_safe_path(cand) = false
                    set skip: true
            }
            if skip = false
            {
                let hcand String^host(cand)
                let f fopen(hcand.to_c_string(), "rb")
                if f <> null
                {
                    let closed fclose(f)
                    ; the FOUND path is the storage id diagnostics display.
                    let cblk scaly_eio_blksize_path(hcand.to_c_string()) as size_t
                    org.set_file_name(StringC^host(hcand.to_c_string()))
                    set *out_found: *hcand
                    ; stream off the found file; read it whole only if that
                    ; declines (see make_char_source_path_cs).
                    let cstream Parser.make_char_source_path_cs(host, *hcand, org, cblk, ps.input_coding())
                    if cstream <> null
                        return cstream
                    let bytes File.read_to_string(*hcand)
                    let pinned String^host(bytes)
                    return Parser.make_char_source_stream_cs(host, pinned.get_buffer(), pinned.get_length(), org, cblk, ps.input_coding())
                }
                if single and (restrict = false)
                {
                    this.report_open_failure(StringC^host(hcand.to_c_string()), strerror(scaly_eio_errno()), fail_loc)
                    return null
                }
                if restrict = false
                {
                    if tried_any
                        this.append_bytes(tried, String(", "))
                    this.append_bytes(tried, String("\""))
                    this.append_bytes(tried, cand)
                    this.append_bytes(tried, String("\""))
                    set tried_any: true
                }
            }
            set ci: ci + 1
        }
        var fargs Vector[MessageArg](2)
        set *(fargs.get(0)): MessageArg.Str(Parser.widen_arg(host, spec))
        let tstr String^host(tried.get_buffer() as pointer[const_char], tried.get_length())
        set *(fargs.get(1)): MessageArg.Raw(Parser.widen_arg(host, *tstr))
        ps.report_at(PosixStorageMessages.cannotFind(), fargs, fail_loc)
        null
    }

    ; the FSI an external entity opens: its stamped effective system id, or —
    ; when generateSystemId never ran on it (defensive) — the declared system
    ; id joined with its base directory. Empty = nothing to open
    ; (ExternalTextEntity::normalReference's nonExistentEntityRef case).
    function entity_fsi(this: Parser, id: ExternalId, base: String) returns String
    {
        if id.has_effective_system()
        {
            let eff id.get_effective_system()
            if eff.get_length() > 0
                return eff
        }
        if id.has_system_id() = false
            return String()
        let acc Array[u8]^host()
        this.append_bytes(acc, String("<OSFILE>"))
        this.append_bytes(acc, EntityCatalog.resolve_target(base, id.get_system_id()))
        let out String^host(acc.get_buffer() as pointer[const_char], acc.get_length())
        *out
    }

    ; ParserState::startDtd's includes loop (-i): every name the driver's -i
    ; options collected is defined in the new DTD as a parameter entity whose
    ; replacement text is the reserved name INCLUDE — first-wins, so it
    ; preempts the DTD's own declaration (which then reports duplicate under
    ; -wduplicate). The name is folded through the entity subst table
    ; (identity under NAMECASE ENTITY NO); the entity is marked used so
    ; -wunused-param stays quiet; its definition location is null.
    function insert_include_entities(this: Parser, dtd: ref[Dtd])
    {
        let opts ps.get_options()
        let inc opts.includes
        if inc = null
            return
        let syn ps.get_syntax()
        let rtext syn.reserved_name(R_INCLUDE)
        let n inc.get_length()
        var i: size_t 0
        while i < n
        {
            let raw inc[i]
            let fb Array[u32]^host()
            var ci: size_t 0
            while ci < raw.get_size()
            {
                fb.add(syn.fold_entity(raw.get(ci)))
                set ci: ci + 1
            }
            let nm StringC^host(fb.get_buffer(), fb.get_length())
            let text StringC^host(rtext.data_ptr(), rtext.get_size())
            let iep InternalEntity.make(host, nm, text, DT_SGML)
            ; ★ The ANNOTATION is what performs the load: an untyped `let iev
            ; iep` ALIASES the borrow, and the variant construction below then
            ; stores the POINTER into the payload instead of the entity.
            let iev: InternalEntity iep
            let ent host.allocate(sizeof Entity, alignof Entity) as pointer[Entity]
            set *ent: Entity.Internal(iev)
            dtd.insert_entity(ent, true, false)
            ps.note_entity_used(ent)
            set i: i + 1
        }
    }

    ; ParserState::startDtd's PredefinedEntity loop: every entity the SGML
    ; declaration's SYNTAX ENTITIES section names (xml.dcl: "amp" 38, "lt" 60,
    ; "gt" 62, "quot" 34, "apos" 39) is inserted into the new DTD as an internal
    ; CDATA entity (PredefinedEntity : InternalCdataEntity — the -oentity
    ; I-record types CDATA, and a content reference emits a DataEvent, never
    ; re-scans) whose replacement text is that one Char. The reference
    ; declaration names none, so a catalog-less document is unaffected.
    function insert_predefined_entities(this: Parser, dtd: ref[Dtd])
    {
        let syn ps.get_syntax()
        let n syn.n_entities()
        var i: size_t 0
        while i < n
        {
            var ch: u32 0
            set ch: syn.entity_char(i)
            let nm syn.entity_name(i)
            let text StringC^host(&ch, 1)
            let iep InternalEntity.make(host, nm, text, DT_CDATA)
            let iev: InternalEntity iep
            let ent host.allocate(sizeof Entity, alignof Entity) as pointer[Entity]
            set *ent: Entity.Internal(iev)
            dtd.insert_entity(ent, false, false)
            set i: i + 1
        }
    }

    ; parseDoctypeDeclStart (scoped): name -> def/current Dtd; an optional external
    ; identifier (PUBLIC/SYSTEM), then the internal subset (`[ ... ]`), then the
    ; external subset (parsed AFTER the internal one — SGML order), then the MDC.
    function parse_doctype_decl_start(this: Parser, base_dir: String, mdo_loc: Location) returns bool
    {
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        ; multipleDtds (parseDecl.cxx:2117): a second document type declaration
        ; needs CONCUR > 0 or LINK EXPLICIT > 0.
        if ps.had_dtd()
        {
            let csd ps.get_sd()
            if (csd.concur() = 0) and (csd.explicit_link() = 0)
                this.report0_at(ParserMessages.multipleDtds(), ps.current_input().token_start_location())
        }
        ; dtdAfterLpd (parseDecl.cxx:2119): every DOCTYPE must precede the
        ; first LINKTYPE.
        if ps.get_had_lpd()
            this.report0_at(ParserMessages.dtdAfterLpd(), ps.current_input().token_start_location())
        ; `<!DOCTYPE #IMPLIED` is admitted only under WWW (parseDecl.cxx:2124);
        ; it is not implemented in the reference either (sorryImpliedDoctype),
        ; and under CONCUR/LINK EXPLICIT it would be invalid to begin with.
        var allow_name AllowedParams.a1(host, P_NAME)
        if ps.get_sd().www()
            set allow_name: AllowedParams.a2(host, P_INDICATED_RESERVED_NAME + R_IMPLIED, P_NAME)
        if this.parse_param(allow_name, decl_input_level, parm) = false
            return false
        if parm.kind = (P_INDICATED_RESERVED_NAME + R_IMPLIED)
        {
            let iloc ps.current_input().token_start_location()
            let isd ps.get_sd()
            if (isd.concur() > 0) or (isd.explicit_link() > 0)
                this.report0_at(ParserMessages.impliedDoctypeConcurLink(), iloc)
            this.report0_at(ParserMessages.sorryImpliedDoctype(), iloc)
            return false
        }
        let docname parm.token
        ; duplicateDtd (parseDecl.cxx:2136): a document type of this name exists.
        if ps.lookup_dtd(docname) <> null
            this.report1_at(ParserMessages.duplicateDtd(), docname, ps.current_input().token_start_location())
        ; the FIRST document type declared is the base (Dtd ctor arg,
        ; ParserState.cxx:201: dtd_.size() == 0).
        let dtd Dtd.make(host, docname, ps.had_dtd() = false)
        ps.set_def_dtd(dtd)
        ps.set_current_dtd(dtd)
        this.insert_include_entities(dtd)
        this.insert_predefined_entities(dtd)

        let allow_ext AllowedParams.a4(host, P_DSO, P_MDC, P_RESERVED_NAME + R_SYSTEM, P_RESERVED_NAME + R_PUBLIC)
        if this.parse_param(allow_ext, decl_input_level, parm) = false
            return false

        ; ---- external identifier (PUBLIC/SYSTEM), if present ----
        ; the file itself is NOT opened here: the reference stashes the doctype
        ; entity (setDsEntity) and references it only when the internal subset
        ; ends — at the DSC (referenceDsEntity in the tokenDsc arm) or, with no
        ; internal subset, at the MDC. Only the system id is captured now.
        var has_ext false
        var has_data_entity false
        ; the doctype entity's generateSystemId failed (no literal system id,
        ; no catalog mapping) — the dsReference at the DSC/MDC will report
        ; nonExistentEntityRef with the DOCTYPE's MDO as the definition site.
        var subset_gen_failed false
        var dtd_sys String()
        ; the doctype subset entity (ExternalTextEntity(name, EntityDecl::
        ; doctype, ...), parseDecl.cxx:2183) — never inserted into a table,
        ; it exists to be referenced at the DSC/MDC; its name on the subset's
        ; EntityOrigin makes -e print "In entity DOC included from ...".
        var subset_ent: ref[Entity]? null
        if (parm.kind = (P_RESERVED_NAME + R_SYSTEM)) or (parm.kind = (P_RESERVED_NAME + R_PUBLIC))
        {
            var id ExternalId()
            ; under WWW the external subset may name a DTD notation
            ; (parseDecl.cxx:2154: `SYSTEM "x" CDATA n` — the subset is data,
            ; never parsed; referencing it reports dtdDataEntityReference).
            var allow_sys AllowedParams.a3(host, P_SYSTEMIDENTIFIER, P_DSO, P_MDC)
            var allow_end AllowedParams.a2(host, P_DSO, P_MDC)
            if ps.get_sd().www()
            {
                var sys_codes int[6]
                let scp sys_codes as pointer[int]
                set *(scp + 0): P_SYSTEMIDENTIFIER
                set *(scp + 1): P_DSO
                set *(scp + 2): P_MDC
                set *(scp + 3): P_RESERVED_NAME + R_CDATA
                set *(scp + 4): P_RESERVED_NAME + R_SDATA
                set *(scp + 5): P_RESERVED_NAME + R_NDATA
                set allow_sys: AllowedParams.an(host, scp, 6)
                set allow_end: AllowedParams.a5(host, P_DSO, P_MDC, P_RESERVED_NAME + R_CDATA, P_RESERVED_NAME + R_SDATA, P_RESERVED_NAME + R_NDATA)
            }
            if this.parse_external_id(allow_sys, allow_end, true, decl_input_level, parm, &id) = false
                return false
            var data_type: int 0 - 1
            if parm.kind = (P_RESERVED_NAME + R_CDATA)
                set data_type: DT_CDATA
            else if parm.kind = (P_RESERVED_NAME + R_SDATA)
                set data_type: DT_SDATA
            else if parm.kind = (P_RESERVED_NAME + R_NDATA)
                set data_type: DT_NDATA
            if data_type >= 0
            {
                ; parseDecl.cxx:2194-2200 + 2230-2247: notation name, then the
                ; entity (its NAME explicitly emptied) joins the PARAMETER
                ; entity table — the checkDtd notation sweep's doctype arm
                ; (dsEntityNotationUndefined) reads it there.
                let allow_nname AllowedParams.a1(host, P_NAME)
                if this.parse_param(allow_nname, decl_input_level, parm) = false
                    return false
                let dnot this.lookup_create_notation(parm.token)
                let datts AttributeList.make(host, dnot.get_attribute_def())
                let dctx ps.get_attribute_context()
                datts.finish(dctx)
                this.check_missing_semantics(datts)
                let hid ExternalId.make(host, id)
                let dent host.allocate(sizeof Entity, alignof Entity) as pointer[Entity]
                let hbase String^host(ps.get_decl_base_dir())
                set *dent: Entity.ExternalData(ExternalDataEntity(StringC(), hid, hbase, mdo_loc, data_type, dnot as pointer[void], datts as pointer[void]))
                ; generateSystemId, doctype flavor (Entity.cxx:127): the full
                ; catalog lookup (the entity's name is EMPTY, so only the
                ; SYSTEM/PUBLIC tables apply); a hit stamps the effective id
                ; and is silent; a miss warns — public-only with the public
                ; id, neither with the doctype name.
                ; hid holds the host-pinned copy — the raw id's strings
                ; alias the transient literal buffer.
                let gdecl_file this.file_id_of_loc(ps.current_location())
                let geff this.catalog_effective_id(hid.has_system_id(), hid.get_system_id(), hid.has_public_id(), hid.get_public_id(), String(), CAT_ENTITY, false, ps.get_decl_base_dir(), gdecl_file)
                if geff.get_length() > 0
                {
                    let hgeff String^host(geff)
                    dent.set_effective_system(*hgeff)
                }
                else
                {
                    let gloc ps.current_input().token_start_location()
                    if hid.has_public_id()
                    {
                        let gparg Parser.widen_arg(host, hid.get_public_id())
                        this.report1_at(ParserMessages.cannotGenerateSystemIdPublic(), gparg, gloc)
                    }
                    else
                        this.report1_at(ParserMessages.cannotGenerateSystemIdDoctype(), docname, gloc)
                }
                dtd.insert_entity(dent, true, false)
                set has_data_entity: true
                let allow_dso_mdc AllowedParams.a2(host, P_DSO, P_MDC)
                if this.parse_param(allow_dso_mdc, decl_input_level, parm) = false
                    return false
            }
            else
            {
                ; ExternalTextEntity(name, doctype) + generateSystemId
                ; (parseDecl.cxx:2183 / Entity.cxx:127): the doctype subset
                ; entity resolves through the FULL catalog lookup — SYSTEM
                ; entries keyed by the declared system id, PUBLIC entries
                ; (override-gated beside a declared id), DOCTYPE-name entries
                ; (probed: `DOCTYPE doc doc.dtd` catches a PUBLIC-only
                ; doctype and, with OVERRIDE YES, a declared one) — with the
                ; declared system id itself as the fallback. A total miss
                ; warns cannotGenerateSystemIdPublic (public-only) or
                ; ...Doctype (`SYSTEM` with no literal) at the token after
                ; the external id, and the subset entity keeps NO system id —
                ; the dsReference at the DSC/MDC then fails with
                ; nonExistentEntityRef (+ "entity was defined here" at the MDO).
                ; pin the id's strings onto host FIRST — they alias the
                ; transient literal buffer, and any allocation (the byte
                ; conversions below) clobbers them.
                let dsys String^host(id.get_system_id())
                let dpub String^host(id.get_public_id())
                let hdid ExternalId.make(host, id)
                let dn8 this.stringc_to_bytes(docname)
                let ddecl_file this.file_id_of_loc(ps.current_location())
                let dfsi this.catalog_effective_id(id.has_system_id(), *dsys, id.has_public_id(), *dpub, dn8, CAT_DOCTYPE, ps.get_sd().namecase_general(), ps.get_decl_base_dir(), ddecl_file)
                if dfsi.get_length() > 0
                {
                    set dtd_sys: String^host(dfsi)
                    set has_ext: true
                    let dsent host.allocate(sizeof Entity, alignof Entity) as pointer[Entity]
                    let dsbase String^host(ps.get_decl_base_dir())
                    set *dsent: Entity.ExternalText(ExternalTextEntity(docname, hdid, dsbase, mdo_loc))
                    set subset_ent: dsent
                }
                else
                {
                    let gloc ps.current_input().token_start_location()
                    if id.has_public_id()
                    {
                        let gparg Parser.widen_arg(host, *dpub)
                        this.report1_at(ParserMessages.cannotGenerateSystemIdPublic(), gparg, gloc)
                    }
                    else
                        this.report1_at(ParserMessages.cannotGenerateSystemIdDoctype(), docname, gloc)
                    set subset_gen_failed: true
                }
            }
            ; parm.kind is now P_DSO or P_MDC (the end token).
        }
        else if ps.get_sd().implydef_doctype()
        {
            ; parseDecl.cxx:2204-2210: no external id, IMPLYDEF DOCTYPE YES —
            ; the doctype entity's system id is implied (generateSystemId =
            ; a DOCTYPE catalog entry); a miss warns and parses on with the
            ; internal subset alone.
            let cat ps.get_entity_catalog()
            var csys String()
            if cat <> null
            {
                let dn8 this.stringc_to_bytes(docname)
                set csys: cat.lookup_doctype(dn8, ps.get_sd().namecase_general())
            }
            if csys.get_length() > 0
            {
                let ifsi Array[u8]^host()
                this.append_bytes(ifsi, String("<OSFILE>"))
                this.append_bytes(ifsi, csys)
                let ifs String^host(ifsi.get_buffer() as pointer[const_char], ifsi.get_length())
                set dtd_sys: *ifs
                set has_ext: true
                let isent host.allocate(sizeof Entity, alignof Entity) as pointer[Entity]
                let isbase String^host(ps.get_decl_base_dir())
                set *isent: Entity.ExternalText(ExternalTextEntity(docname, ExternalId(), isbase, mdo_loc))
                set subset_ent: isent
            }
            else
                this.report1_at(ParserMessages.cannotGenerateSystemIdDoctype(), docname, ps.current_input().token_start_location())
        }
        else if parm.kind = P_MDC
        {
            ; noDtdSubset (parseDecl.cxx:2211-2215): `<!DOCTYPE name>` with no
            ; subset at all — E at the MDC, then imply definitions (parse
            ; without validation).
            if ps.get_sd().implydef_element() = IMPLYDEF_ELEMENT_NO
            {
                this.report0_at(ParserMessages.noDtdSubset(), ps.current_input().token_start_location())
                ps.enable_implydef()
            }
        }

        ps.set_phase(PHASE_DECL_SUBSET)

        ; ---- internal subset (`[ ... ]`), if a DSO opened it ----
        var has_internal false
        if parm.kind = P_DSO
        {
            let inner_level ps.get_input_level()
            let rc this.parse_decl_subset(inner_level, false)
            if rc <> 0
                return false
            set has_internal: true
        }

        ; a DATA external subset is never parsed — referencing it (at the DSC,
        ; or the MDC when there is no internal subset) is an error
        ; (ExternalNonTextEntity::dsReference, Entity.cxx:499).
        if has_data_entity
            this.report0_at(ParserMessages.dtdDataEntityReference(), ps.current_input().token_start_location())

        ; referenceDsEntity of a subset entity with no effective system id
        ; (ExternalTextEntity::normalReference, Entity.cxx:452): E at the
        ; DSC/MDC, aux = the DOCTYPE declaration's MDO ("entity was defined
        ; here"). Verified vs real onsgmls: `<!DOCTYPE doc PUBLIC "-//x//" [`
        ; → W at the DSO, E at the `]`, aux at 1:0.
        if subset_gen_failed
            this.report1_aux(ParserMessages.nonExistentEntityRef(), docname, ps.current_input().token_start_location(), ParserMessages.nonExistentEntityRef_aux(), mdo_loc)

        ; ---- external subset, parsed AFTER the internal subset (SGML order) ----
        if has_ext
        {
            ; dtd_sys carries the subset entity's effective id (an FSI).
            ; A failed open reports through the entity manager at the point
            ; the doctype entity is referenced — the DSC's (or, without an
            ; internal subset, the MDC's) token start, which IS the current
            ; token here — and the parse continues with the internal subset
            ; alone (referenceDsEntity returns 0).
            let ins ps.current_input()
            let floc ins.token_start_location()
            ; EntityOrigin::make(entity, currentLocation()) — referenceDsEntity
            ; at the DSC (or the ungotten MDC): the subset stacks as a NAMED
            ; entity origin (refLength 0), so -e prints "In entity DOC
            ; included from <DSC/MDC>" for messages inside the subset.
            let dorg host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
            set *dorg: Origin(floc, subset_ent as pointer[void])
            var dfound String()
            let ext_src this.fsi_open(dtd_sys, dorg, floc, floc, 0, &dfound)
            if ext_src <> null
            {
                ; relative SYSTEM ids in the external subset's declarations
                ; resolve against the DTD's own directory while it is parsed
                ; (extractDir of the OPENED path); restore the document base
                ; afterwards.
                let ext_base Path.get_directory_name(dfound)
                ps.set_decl_base_dir(ext_base)
                ps.push_input(ext_src)
                let ext_level ps.get_input_level()
                this.parse_decl_subset(ext_level, true)
                ps.set_decl_base_dir(base_dir)
            }
        }

        ; ---- checkDtd (parseDecl.cxx:2352) ----
        ; parseDoctypeDeclEnd calls checkDtd BEFORE parsing the final MDC, so a
        ; current-location diagnostic (attlistNotationUndefined) points at the
        ; DSC. Element sweep first (undefined definitions), then the
        ; entity/notation sweeps.
        this.check_dtd(dtd)
        this.check_dtd_notations(dtd)

        ; ---- endDtd BEFORE the closing MDC (parseDecl.cxx:2354) ----
        ; "End DTD before parsing final param so parameter entity reference
        ; not allowed between ] and >": with no current DTD a `%pe;` there
        ; reports entityApplicableDtd. The DTD joins the document's list; a
        ; further DOCTYPE (CONCUR) or the instance follows in prolog mode.
        ps.end_dtd()

        ; ---- the closing MDC ----
        ; In the MDC-only case (no internal subset) the MDC was already consumed
        ; by allow_ext / parse_external_id; otherwise it follows the DSC. A
        ; failure here is parseDoctypeDeclEnd returning 0 at the tokenDsc arm
        ; (parseDecl.cxx:295) — the reference does NOT give up, it re-enters the
        ; prolog after the reported parameter error.
        if has_internal
        {
            let allow_mdc AllowedParams.a1(host, P_MDC)
            let mdc_ok this.parse_param(allow_mdc, decl_input_level, parm)
        }
        true
    }

    ; ======================================================================
    ; The LINK feature axis (parseDecl.cxx:2737-3400): LINKTYPE declarations,
    ; LPD subsets, LINK/IDLINK link sets, USELINK, activation (-a) and the
    ; two-pass machinery.

    ; the RNI-prefixed form of a reserved name (#INITIAL/#EMPTY) — the names
    ; of a complex LPD's built-in link sets (Syntax::rniReservedName).
    function rni_reserved_name(this: Parser, rn: int) returns StringC
    {
        let syn ps.get_syntax()
        let buf Array[u32]^host()
        var i: size_t 0
        let dl syn.delim_general_len(dRNI)
        while i < dl
        {
            buf.add(syn.delim_general_char(dRNI, i))
            set i: i + 1
        }
        let nm syn.reserved_name(rn)
        var j: size_t 0
        let nl nm.get_size()
        while j < nl
        {
            buf.add(nm.get(j))
            set j: j + 1
        }
        this.build_stringc(buf)
    }

    ; the activation checks (parseDecl.cxx:2838): counts against the FEATURES
    ; LINK quantities; at most one implicit chain, and the one-explicit-chain
    ; form must source from the base DTD (sorryLink for the multi-process
    ; forms the reference itself does not implement).
    function activate_lpd(this: Parser, lpd: ref[Lpd], simple: bool, implied: bool)
    {
        let csd ps.get_sd()
        let n_active ps.n_active_lpds()
        let loc ps.current_input().token_start_location()
        if simple
        {
            var n_simple: size_t 0
            var i: size_t 0
            while i < n_active
            {
                let a ps.active_lpd_at(i)
                if a.get_kind() = LPD_SIMPLE
                    set n_simple: n_simple + 1
                set i: i + 1
            }
            if n_simple = (csd.simple_link() as size_t)
                this.report_num_at(ParserMessages.simpleLinkCount(), csd.simple_link() as u64, loc)
            lpd.activate()
            return
        }
        var have_implicit false
        var have_explicit false
        var j: size_t 0
        while j < n_active
        {
            let a2 ps.active_lpd_at(j)
            if a2.get_kind() = LPD_IMPLICIT
                set have_implicit: true
            else if a2.get_kind() = LPD_EXPLICIT
                set have_explicit: true
            set j: j + 1
        }
        let source_dtd lpd.get_source_dtd()
        if implied and have_implicit
            this.report0_at(ParserMessages.oneImplicitLink(), loc)
        else if (csd.explicit_link() <= 1) and (source_dtd <> ps.base_dtd())
        {
            let lname lpd.get_name()
            if csd.explicit_link() = 0
                this.report1_at(ParserMessages.explicitNoRequiresSourceTypeBase(), lname, loc)
            else
                this.report1_at(ParserMessages.explicit1RequiresSourceTypeBase(), lname, loc)
        }
        else if ((csd.explicit_link() = 1) and have_explicit) and (implied = false)
            this.report0_at(ParserMessages.duplicateExplicitChain(), loc)
        else if (have_explicit or have_implicit) or (source_dtd <> ps.base_dtd())
        {
            let lname2 lpd.get_name()
            this.report1_at(ParserMessages.sorryLink(), lname2, loc)
        }
        else
            lpd.activate()
    }

    ; parseLinktypeDeclEnd's check half (parseDecl.cxx:2911): a complex LPD
    ; must have defined its initial link set, and every link set the rules
    ; referenced (table sweep in bucket order).
    function check_linktype_decl_end(this: Parser)
    {
        let lpd ps.get_def_lpd()
        if lpd.get_kind() = LPD_SIMPLE
            return
        let ini lpd.initial_link_set_of()
        if ini.is_defined() = false
        {
            let lname lpd.get_name()
            this.report1_at(ParserMessages.noInitialLinkSet(), lname, ps.current_input().token_start_location())
        }
        let table lpd.get_link_sets()
        let nb table.bucket_count()
        var b: size_t 0
        while b < nb
        {
            let ls table.bucket_at(b)
            if ls <> null
            {
                if ls.is_defined() = false
                {
                    let lsname ls.get_name()
                    this.report1_at(ParserMessages.undefinedLinkSet(), lsname, ps.current_input().token_start_location())
                }
            }
            set b: b + 1
        }
    }

    ; ---- parseLinktypeDeclStart (parseDecl.cxx:2737), restructured like the
    ; port's parse_doctype_decl_start: header, activation, subsets (internal
    ; then external), end checks, final MDC. ----
    function parse_linktype_decl_start(this: Parser, base_dir: String, mdo_loc: Location) returns bool
    {
        if ps.base_dtd() = null
            this.report0_at(ParserMessages.lpdBeforeBaseDtd(), ps.current_input().token_start_location())
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        let allow_name AllowedParams.a1(host, P_NAME)
        if this.parse_param(allow_name, decl_input_level, parm) = false
            return false
        let ntok parm.token
        let name StringC^host(ntok.data_ptr(), ntok.get_size())
        if ps.lookup_dtd(name) <> null
            this.report1_at(ParserMessages.duplicateDtdLpd(), name, ps.current_input().token_start_location())
        else if ps.lookup_lpd(name) <> null
            this.report1_at(ParserMessages.duplicateLpd(), name, ps.current_input().token_start_location())
        let allow_simple_name AllowedParams.a2(host, P_INDICATED_RESERVED_NAME + R_SIMPLE, P_NAME)
        if this.parse_param(allow_simple_name, decl_input_level, parm) = false
            return false
        var simple false
        var source_dtd: ref[Dtd]? null
        if parm.kind = (P_INDICATED_RESERVED_NAME + R_SIMPLE)
        {
            set simple: true
            set source_dtd: ps.base_dtd()
            if source_dtd = null
                set source_dtd: Dtd.make(host, StringC(), true)
        }
        else
        {
            let stok parm.token
            let sname StringC^host(stok.data_ptr(), stok.get_size())
            set source_dtd: ps.lookup_dtd(sname)
            if source_dtd = null
            {
                this.report1_at(ParserMessages.noSuchDtd(), sname, ps.current_input().token_start_location())
                set source_dtd: Dtd.make(host, sname, false)
            }
        }
        let allow_implied_name AllowedParams.a2(host, P_INDICATED_RESERVED_NAME + R_IMPLIED, P_NAME)
        if this.parse_param(allow_implied_name, decl_input_level, parm) = false
            return false
        var result_dtd: ref[Dtd]? null
        var implied false
        let csd ps.get_sd()
        if parm.kind = (P_INDICATED_RESERVED_NAME + R_IMPLIED)
        {
            if simple
            {
                if csd.simple_link() = 0
                    this.report0_at(ParserMessages.simpleLinkFeature(), ps.current_input().token_start_location())
            }
            else
            {
                set implied: true
                if csd.implicit_link() = false
                    this.report0_at(ParserMessages.implicitLinkFeature(), ps.current_input().token_start_location())
            }
        }
        else
        {
            if simple
                this.report0_at(ParserMessages.simpleLinkResultNotImplied(), ps.current_input().token_start_location())
            else
            {
                if csd.explicit_link() = 0
                    this.report0_at(ParserMessages.explicitLinkFeature(), ps.current_input().token_start_location())
                let rtok parm.token
                let rname StringC^host(rtok.data_ptr(), rtok.get_size())
                set result_dtd: ps.lookup_dtd(rname)
                if result_dtd = null
                    this.report1_at(ParserMessages.noSuchDtd(), rname, ps.current_input().token_start_location())
            }
        }
        let allow_ext AllowedParams.a4(host, P_DSO, P_MDC, P_RESERVED_NAME + R_SYSTEM, P_RESERVED_NAME + R_PUBLIC)
        if this.parse_param(allow_ext, decl_input_level, parm) = false
            return false
        ; ---- external identifier for the LPD subset entity ----
        var had_ext_id false
        var has_ext false
        ; the LPD subset entity's generateSystemId failed — the dsReference at
        ; the DSC/MDC reports nonExistentEntityRef (aux = the LINKTYPE's MDO).
        var subset_gen_failed false
        var lpd_sys String()
        if (parm.kind = (P_RESERVED_NAME + R_SYSTEM)) or (parm.kind = (P_RESERVED_NAME + R_PUBLIC))
        {
            set had_ext_id: true
            var id ExternalId()
            let allow_sys AllowedParams.a3(host, P_SYSTEMIDENTIFIER, P_DSO, P_MDC)
            let allow_end AllowedParams.a2(host, P_DSO, P_MDC)
            if this.parse_external_id(allow_sys, allow_end, true, decl_input_level, parm, &id) = false
                return false
            ; ExternalTextEntity(name, linktype) + generateSystemId
            ; (parseDecl.cxx:2818 / Entity.cxx:127): the full catalog lookup
            ; (SYSTEM entries, override-gated PUBLIC entries, LINKTYPE-name
            ; entries), the declared system id as fallback; a total miss
            ; warns cannotGenerateSystemIdPublic (public-only) or ...Linktype
            ; (SYSTEM with no literal) at the token after the external id.
            ; pin the id's strings onto host FIRST (transient-literal alias).
            let lsys String^host(id.get_system_id())
            let lpub String^host(id.get_public_id())
            let ln8 this.stringc_to_bytes(name)
            let ldecl_file this.file_id_of_loc(ps.current_location())
            let lfsi this.catalog_effective_id(id.has_system_id(), *lsys, id.has_public_id(), *lpub, ln8, CAT_LINKTYPE, ps.get_sd().namecase_general(), ps.get_decl_base_dir(), ldecl_file)
            if lfsi.get_length() > 0
            {
                set lpd_sys: String^host(lfsi)
                set has_ext: true
            }
            else
            {
                let gloc ps.current_input().token_start_location()
                if id.has_public_id()
                {
                    let gparg Parser.widen_arg(host, *lpub)
                    this.report1_at(ParserMessages.cannotGenerateSystemIdPublic(), gparg, gloc)
                }
                else
                    this.report1_at(ParserMessages.cannotGenerateSystemIdLinktype(), name, gloc)
                set subset_gen_failed: true
            }
        }
        ; ---- construct + (maybe) activate the LPD ----
        var lpd: ref[Lpd]? null
        let lpd_loc ps.current_input().token_start_location()
        if simple
            set lpd: Lpd.make_simple(host, name, lpd_loc, source_dtd)
        else
        {
            var kind LPD_EXPLICIT
            if implied
                set kind: LPD_IMPLICIT
            let ini this.rni_reserved_name(R_INITIAL)
            let emp this.rni_reserved_name(R_EMPTY)
            set lpd: Lpd.make_complex(host, name, kind, lpd_loc, ini, emp, source_dtd, result_dtd)
        }
        if ps.base_dtd() <> null
        {
            if ps.should_activate_link(name)
                this.activate_lpd(lpd, simple, implied)
        }
        ps.start_lpd(lpd)
        ps.set_phase(PHASE_DECL_SUBSET)
        ; ---- the LPD subset: internal (DSO), then external entity ----
        var has_internal false
        if parm.kind = P_DSO
        {
            set has_internal: true
            let inner_level ps.get_input_level()
            let rc this.parse_decl_subset(inner_level, false)
            if rc <> 0
                return false
        }
        else if had_ext_id = false
        {
            ; `<!LINKTYPE name ... >` with neither subset nor external id
            ; (parseDecl.cxx:2891): noLpdSubset, the end checks still run.
            this.report1_at(ParserMessages.noLpdSubset(), name, ps.current_input().token_start_location())
        }
        ; referenceDsEntity of an LPD subset entity with no effective system
        ; id (parseDecl.cxx:2899/2906 → Entity.cxx:452): nonExistentEntityRef
        ; at the DSC/MDC, aux = the LINKTYPE declaration's MDO.
        if subset_gen_failed
            this.report1_aux(ParserMessages.nonExistentEntityRef(), name, ps.current_input().token_start_location(), ParserMessages.nonExistentEntityRef_aux(), mdo_loc)
        if has_ext
        {
            ; lpd_sys carries the LPD subset entity's effective id (an FSI).
            let lorg host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
            set *lorg: Origin()
            let ins2 ps.current_input()
            let floc2 ins2.token_start_location()
            var lfound String()
            let ext_src this.fsi_open(lpd_sys, lorg, floc2, floc2, 0, &lfound)
            if ext_src <> null
            {
                let ext_base Path.get_directory_name(lfound)
                ps.set_decl_base_dir(ext_base)
                ps.push_input(ext_src)
                let ext_level ps.get_input_level()
                this.parse_decl_subset(ext_level, true)
                ps.set_decl_base_dir(base_dir)
            }
        }
        ; ---- parseLinktypeDeclEnd: checks, endLpd, the final MDC (already
        ; consumed when the header ended at the MDC) ----
        this.check_linktype_decl_end()
        ps.end_lpd()
        if has_internal
        {
            let allow_mdc AllowedParams.a1(host, P_MDC)
            let mdc_ok this.parse_param(allow_mdc, decl_input_level, parm)
        }
        true
    }

    ; ---- lookupCreateLinkSet (parseDecl.cxx:3392) --------------------------
    function lookup_create_link_set(this: Parser, name: StringC) returns ref[LinkSet]
    {
        let lpd ps.get_def_lpd()
        let found lpd.lookup_link_set(name)
        if found <> null
            return found as ref[LinkSet]
        let ls LinkSet.make(host, name, lpd.get_source_dtd())
        lpd.insert_link_set(host, ls)
        ls
    }

    ; ---- lookupResultElementType (parseDecl.cxx:3329) ----------------------
    function lookup_result_element_type(this: Parser, name: StringC) returns ref[ElementType]?
    {
        let lpd ps.get_def_lpd()
        let dtd lpd.get_result_dtd()
        if dtd = null
            return null
        let e dtd.lookup_element_type(name)
        if e = null
            this.report1_at(ParserMessages.noSuchResultElement(), name, ps.current_input().token_start_location())
        e
    }

    ; ---- addIdLinkRule (parseDecl.cxx:3223) --------------------------------
    function add_id_link_rule(this: Parser, id: StringC, rule: ref[SourceLinkRule])
    {
        let lpd ps.get_def_lpd()
        let group lpd.lookup_create_id_link(host, id)
        let n_rules group.n_link_rules()
        var dup false
        if n_rules = 1
        {
            let r0 group.link_rule(0)
            let r0a r0.attributes()
            if r0a.n_spec_of() = 0
                set dup: true
        }
        if (dup = false) and (n_rules >= 1)
        {
            let ra rule.attributes()
            if ra.n_spec_of() = 0
                set dup: true
        }
        if dup
            this.report1_at(ParserMessages.multipleIdLinkRuleAttribute(), id, ps.current_input().token_start_location())
        group.add_link_rule(rule)
    }

    ; ---- addLinkRule (parseDecl.cxx:3235) ----------------------------------
    function add_link_rule_checked(this: Parser, link_set: ref[LinkSet], source_element: ref[ElementType], rule: ref[SourceLinkRule])
    {
        let n_rules link_set.n_link_rules(source_element)
        var dup false
        if n_rules = 1
        {
            let r0 link_set.link_rule(source_element, 0)
            let r0a r0.attributes()
            if r0a.n_spec_of() = 0
                set dup: true
        }
        if (dup = false) and (n_rules >= 1)
        {
            let ra rule.attributes()
            if ra.n_spec_of() = 0
                set dup: true
        }
        if dup
        {
            let sname source_element.get_name()
            this.report1_at(ParserMessages.multipleLinkRuleAttribute(), sname, ps.current_input().token_start_location())
        }
        link_set.add_link_rule(host, source_element, rule)
    }

    ; ---- parseResultElementSpec (parseDecl.cxx:3264) -----------------------
    function parse_result_element_spec(this: Parser, decl_input_level: u32, parm: ref[Param], idlink: bool, out_implied: ref[bool], out_type: pointer[pointer[ElementType]], out_atts: pointer[pointer[AttributeList]]) returns bool
    {
        set *out_type: null
        set *out_atts: null
        if parm.kind = (P_INDICATED_RESERVED_NAME + R_IMPLIED)
        {
            if idlink
            {
                let allow_nm AllowedParams.a2(host, P_NAME, P_MDC)
                if this.parse_param(allow_nm, decl_input_level, parm) = false
                    return false
            }
            else
            {
                let allow_elrm AllowedParams.a4(host, P_MDC, P_NAME, P_NAMEGROUP, P_INDICATED_RESERVED_NAME + R_IMPLIED)
                if this.parse_param(allow_elrm, decl_input_level, parm) = false
                    return false
            }
            set out_implied: true
            return true
        }
        set out_implied: false
        let e this.lookup_result_element_type(parm.token)
        set *out_type: e
        if idlink
        {
            let allow_ndm AllowedParams.a3(host, P_DSO, P_MDC, P_NAME)
            if this.parse_param(allow_ndm, decl_input_level, parm) = false
                return false
        }
        else
        {
            let allow5 AllowedParams.a5(host, P_DSO, P_MDC, P_NAME, P_NAMEGROUP, P_INDICATED_RESERVED_NAME + R_IMPLIED)
            if this.parse_param(allow5, decl_input_level, parm) = false
                return false
        }
        var att_def: ref[AttributeDefinitionList]? null
        if e <> null
            set att_def: e.get_attribute_def()
        let attributes AttributeList.make(host, att_def)
        if parm.kind = P_DSO
        {
            ; result attribute specs resolve entities/notations against the
            ; RESULT dtd (ResultAttributeSpecModeSetter).
            ps.set_result_attribute_spec_mode()
            var net false
            var new_att_def: pointer[AttributeDefinitionList] null
            if this.parse_attribute_spec(asMode, attributes, &net, &new_att_def) = false
            {
                ps.clear_result_attribute_spec_mode()
                return false
            }
            if new_att_def <> null
            {
                let lpd ps.get_def_lpd()
                let rdtd lpd.get_result_dtd()
                if rdtd <> null
                {
                    new_att_def.set_index(rdtd.alloc_attribute_definition_list_index())
                    if e <> null
                        e.set_attribute_def(new_att_def)
                }
            }
            ps.clear_result_attribute_spec_mode()
            if attributes.n_spec_of() = 0
                this.report0_at(ParserMessages.emptyResultAttributeSpec(), ps.current_input().token_start_location())
            if idlink
            {
                let allow_nm2 AllowedParams.a2(host, P_NAME, P_MDC)
                if this.parse_param(allow_nm2, decl_input_level, parm) = false
                    return false
            }
            else
            {
                let allow_elrm2 AllowedParams.a4(host, P_MDC, P_NAME, P_NAMEGROUP, P_INDICATED_RESERVED_NAME + R_IMPLIED)
                if this.parse_param(allow_elrm2, decl_input_level, parm) = false
                    return false
            }
        }
        else
        {
            ; for entity and notation attributes (parseDecl.cxx:3320).
            ps.set_result_attribute_spec_mode()
            let ctx ps.get_attribute_context()
            attributes.finish(ctx)
            this.check_missing_semantics(attributes)
            ps.clear_result_attribute_spec_mode()
        }
        set *out_atts: attributes
        true
    }

    ; ---- parseLinkSet (parseDecl.cxx:2947); LINK = idlink false, IDLINK =
    ; idlink true. Only reachable while a complex LPD is being defined. ----
    function parse_link_decl(this: Parser) returns bool
        this.parse_link_set(false)

    function parse_idlink_decl(this: Parser) returns bool
        this.parse_link_set(true)

    function parse_link_set(this: Parser, idlink: bool) returns bool
    {
        let lpd ps.get_def_lpd()
        if lpd.get_kind() = LPD_SIMPLE
        {
            if idlink
                this.report0_at(ParserMessages.idlinkDeclSimple(), ps.current_input().token_start_location())
            else
                this.report0_at(ParserMessages.linkDeclSimple(), ps.current_input().token_start_location())
            return false
        }
        if idlink
        {
            if lpd.had_id_link_set_of()
                this.report0_at(ParserMessages.duplicateIdLinkSet(), ps.current_input().token_start_location())
            else
                lpd.set_had_id_link_set()
        }
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        let is_explicit lpd.get_kind() = LPD_EXPLICIT
        var link_set: ref[LinkSet]? null
        if idlink
        {
            let allow_name AllowedParams.a1(host, P_NAME)
            if this.parse_param(allow_name, decl_input_level, parm) = false
                return false
        }
        else
        {
            let allow_name_initial AllowedParams.a2(host, P_NAME, P_INDICATED_RESERVED_NAME + R_INITIAL)
            if this.parse_param(allow_name_initial, decl_input_level, parm) = false
                return false
            if parm.kind = P_NAME
                set link_set: this.lookup_create_link_set(parm.token)
            else
                set link_set: lpd.initial_link_set_of()
            if link_set.is_defined()
            {
                let lsname link_set.get_name()
                this.report1_at(ParserMessages.duplicateLinkSet(), lsname, ps.current_input().token_start_location())
            }
            if is_explicit
            {
                let allow_elr AllowedParams.a3(host, P_NAME, P_NAMEGROUP, P_INDICATED_RESERVED_NAME + R_IMPLIED)
                if this.parse_param(allow_elr, decl_input_level, parm) = false
                    return false
            }
            else
            {
                let allow_nng AllowedParams.a2(host, P_NAME, P_NAMEGROUP)
                if this.parse_param(allow_nng, decl_input_level, parm) = false
                    return false
            }
        }
        var looping true
        while looping
        {
            var id StringC()
            if idlink
            {
                let itok parm.token
                set id: StringC^host(itok.data_ptr(), itok.get_size())
                if is_explicit
                {
                    let allow_elrm AllowedParams.a4(host, P_MDC, P_NAME, P_NAMEGROUP, P_INDICATED_RESERVED_NAME + R_IMPLIED)
                    if this.parse_param(allow_elrm, decl_input_level, parm) = false
                        return false
                }
                else
                {
                    let allow_nngm AllowedParams.a3(host, P_NAME, P_NAMEGROUP, P_MDC)
                    if this.parse_param(allow_nngm, decl_input_level, parm) = false
                        return false
                }
            }
            if parm.kind = (P_INDICATED_RESERVED_NAME + R_IMPLIED)
            {
                ; `#IMPLIED source` — a result element spec for implied source
                ; elements (parseDecl.cxx:2998).
                let allow_name2 AllowedParams.a1(host, P_NAME)
                if this.parse_param(allow_name2, decl_input_level, parm) = false
                    return false
                var result_implied false
                var result_type: pointer[ElementType] null
                var result_atts: pointer[AttributeList] null
                if this.parse_result_element_spec(decl_input_level, parm, idlink, &result_implied, &result_type, &result_atts) = false
                    return false
                if result_type <> null
                {
                    if link_set.has_implied_result(result_type)
                    {
                        let rtname result_type.get_name()
                        this.report1_at(ParserMessages.duplicateImpliedResult(), rtname, ps.current_input().token_start_location())
                    }
                    else
                        link_set.add_implied(host, result_type, result_atts)
                }
            }
            else
            {
                ; a source link rule (parseDecl.cxx:3020).
                let rule SourceLinkRule.make(host)
                let assoc Array[ref[ElementType]?]^host()
                if parm.kind = P_NAME
                {
                    let se this.lookup_create_element(parm.token)
                    assoc.add(se)
                }
                else
                {
                    let nt parm.name_tokens
                    let ntn nt.get_length()
                    var ni: size_t 0
                    while ni < ntn
                    {
                        let entry nt[ni]
                        let se2 this.lookup_create_element(entry.name)
                        assoc.add(se2)
                        set ni: ni + 1
                    }
                }
                ; allow2e / allow2id / allow2i (parseDecl.cxx:3041).
                if is_explicit
                {
                    let allow2e AllowedParams.a5(host, P_INDICATED_RESERVED_NAME + R_USELINK, P_INDICATED_RESERVED_NAME + R_POSTLINK, P_DSO, P_NAME, P_INDICATED_RESERVED_NAME + R_IMPLIED)
                    if this.parse_param(allow2e, decl_input_level, parm) = false
                        return false
                }
                else if idlink
                {
                    let allow2id AllowedParams.a5(host, P_INDICATED_RESERVED_NAME + R_USELINK, P_INDICATED_RESERVED_NAME + R_POSTLINK, P_DSO, P_MDC, P_NAME)
                    if this.parse_param(allow2id, decl_input_level, parm) = false
                        return false
                }
                else
                {
                    var codes2 int[6]
                    let cp2 codes2 as pointer[int]
                    set *(cp2 + 0): P_INDICATED_RESERVED_NAME + R_USELINK
                    set *(cp2 + 1): P_INDICATED_RESERVED_NAME + R_POSTLINK
                    set *(cp2 + 2): P_DSO
                    set *(cp2 + 3): P_MDC
                    set *(cp2 + 4): P_NAME
                    set *(cp2 + 5): P_NAMEGROUP
                    let allow2i AllowedParams.an(host, cp2, 6)
                    if this.parse_param(allow2i, decl_input_level, parm) = false
                        return false
                }
                if parm.kind = (P_INDICATED_RESERVED_NAME + R_USELINK)
                {
                    let allow_lse AllowedParams.a3(host, P_NAME, P_INDICATED_RESERVED_NAME + R_INITIAL, P_INDICATED_RESERVED_NAME + R_EMPTY)
                    if this.parse_param(allow_lse, decl_input_level, parm) = false
                        return false
                    var uselink: ref[LinkSet]? null
                    if parm.kind = P_NAME
                        set uselink: this.lookup_create_link_set(parm.token)
                    else if parm.kind = (P_INDICATED_RESERVED_NAME + R_INITIAL)
                        set uselink: lpd.initial_link_set_of()
                    else
                        set uselink: lpd.empty_link_set_of()
                    rule.set_uselink(uselink as pointer[void])
                    ; allow3e / allow3id / allow3i (parseDecl.cxx:3080).
                    if is_explicit
                    {
                        let allow3e AllowedParams.a4(host, P_INDICATED_RESERVED_NAME + R_POSTLINK, P_DSO, P_NAME, P_INDICATED_RESERVED_NAME + R_IMPLIED)
                        if this.parse_param(allow3e, decl_input_level, parm) = false
                            return false
                    }
                    else if idlink
                    {
                        let allow3id AllowedParams.a4(host, P_INDICATED_RESERVED_NAME + R_POSTLINK, P_DSO, P_MDC, P_NAME)
                        if this.parse_param(allow3id, decl_input_level, parm) = false
                            return false
                    }
                    else
                    {
                        let allow3i AllowedParams.a5(host, P_INDICATED_RESERVED_NAME + R_POSTLINK, P_DSO, P_MDC, P_NAME, P_NAMEGROUP)
                        if this.parse_param(allow3i, decl_input_level, parm) = false
                            return false
                    }
                }
                if parm.kind = (P_INDICATED_RESERVED_NAME + R_POSTLINK)
                {
                    ; allowLinkSetSpec (parseDecl.cxx:36).
                    let allow_lss AllowedParams.a4(host, P_NAME, P_INDICATED_RESERVED_NAME + R_INITIAL, P_INDICATED_RESERVED_NAME + R_EMPTY, P_INDICATED_RESERVED_NAME + R_RESTORE)
                    if this.parse_param(allow_lss, decl_input_level, parm) = false
                        return false
                    if parm.kind = (P_INDICATED_RESERVED_NAME + R_RESTORE)
                        rule.set_postlink_restore()
                    else
                    {
                        var postlink: ref[LinkSet]? null
                        if parm.kind = P_NAME
                            set postlink: this.lookup_create_link_set(parm.token)
                        else if parm.kind = (P_INDICATED_RESERVED_NAME + R_INITIAL)
                            set postlink: lpd.initial_link_set_of()
                        else
                            set postlink: lpd.empty_link_set_of()
                        rule.set_postlink(postlink as pointer[void])
                    }
                    ; allow4e / allow4id / allow4i (parseDecl.cxx:3119).
                    if is_explicit
                    {
                        let allow4e AllowedParams.a3(host, P_DSO, P_NAME, P_INDICATED_RESERVED_NAME + R_IMPLIED)
                        if this.parse_param(allow4e, decl_input_level, parm) = false
                            return false
                    }
                    else if idlink
                    {
                        let allow4id AllowedParams.a3(host, P_DSO, P_MDC, P_NAME)
                        if this.parse_param(allow4id, decl_input_level, parm) = false
                            return false
                    }
                    else
                    {
                        let allow4i AllowedParams.a4(host, P_DSO, P_MDC, P_NAME, P_NAMEGROUP)
                        if this.parse_param(allow4i, decl_input_level, parm) = false
                            return false
                    }
                }
                ; the associated elements must share ONE link attribute
                ; definition list (parseDecl.cxx:3140).
                var att_def: ref[AttributeDefinitionList]? null
                let na assoc.get_length()
                var ai: size_t 0
                while ai < na
                {
                    let ae assoc[ai]
                    if ae <> null
                    {
                        if ai = 0
                            set att_def: lpd.link_attribute_def(ae)
                        else if att_def <> lpd.link_attribute_def(ae)
                            this.report0_at(ParserMessages.assocElementDifferentAtts(), ps.current_input().token_start_location())
                    }
                    set ai: ai + 1
                }
                let attributes AttributeList.make(host, att_def)
                if parm.kind = P_DSO
                {
                    var net false
                    var new_att_def: pointer[AttributeDefinitionList] null
                    if this.parse_attribute_spec(asMode, attributes, &net, &new_att_def) = false
                        return false
                    if new_att_def <> null
                    {
                        new_att_def.set_index(lpd.alloc_attribute_definition_list_index())
                        var ai2: size_t 0
                        while ai2 < na
                        {
                            let ae2 assoc[ai2]
                            if ae2 <> null
                            {
                                if lpd.link_attribute_def(ae2) = att_def
                                    lpd.set_link_attribute_def(ae2, new_att_def)
                            }
                            set ai2: ai2 + 1
                        }
                    }
                    ; allow5e / allowNameMdc / allowNameNameGroupMdc.
                    if is_explicit
                    {
                        let allow5e AllowedParams.a2(host, P_NAME, P_INDICATED_RESERVED_NAME + R_IMPLIED)
                        if this.parse_param(allow5e, decl_input_level, parm) = false
                            return false
                    }
                    else if idlink
                    {
                        let allow_nm AllowedParams.a2(host, P_NAME, P_MDC)
                        if this.parse_param(allow_nm, decl_input_level, parm) = false
                            return false
                    }
                    else
                    {
                        let allow_nngm2 AllowedParams.a3(host, P_NAME, P_NAMEGROUP, P_MDC)
                        if this.parse_param(allow_nngm2, decl_input_level, parm) = false
                            return false
                    }
                }
                else
                {
                    let ctx ps.get_attribute_context()
                    attributes.finish(ctx)
                    this.check_missing_semantics(attributes)
                }
                rule.set_link_attributes(attributes)
                if is_explicit
                {
                    var result_implied2 false
                    var result_type2: pointer[ElementType] null
                    var result_atts2: pointer[AttributeList] null
                    if this.parse_result_element_spec(decl_input_level, parm, idlink, &result_implied2, &result_type2, &result_atts2) = false
                        return false
                    if result_implied2 = false
                        rule.set_result(result_type2, result_atts2)
                }
                ; install the link rule (parseDecl.cxx:3191).
                if idlink
                {
                    rule.set_assoc_element_types(assoc)
                    this.add_id_link_rule(id, rule)
                }
                else
                {
                    if link_set.is_defined() = false
                    {
                        var ai3: size_t 0
                        while ai3 < na
                        {
                            let ae3 assoc[ai3]
                            if ae3 <> null
                                this.add_link_rule_checked(link_set, ae3, rule)
                            set ai3: ai3 + 1
                        }
                    }
                }
            }
            if parm.kind = P_MDC
                set looping: false
        }
        if link_set <> null
            link_set.set_defined()
        true
    }

    ; ---- parseUselinkDecl (parseDecl.cxx:3340) -----------------------------
    function parse_uselink_decl(this: Parser) returns bool
    {
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        let allow_lss AllowedParams.a4(host, P_NAME, P_INDICATED_RESERVED_NAME + R_INITIAL, P_INDICATED_RESERVED_NAME + R_EMPTY, P_INDICATED_RESERVED_NAME + R_RESTORE)
        if this.parse_param(allow_lss, decl_input_level, parm) = false
            return false
        let spec_kind parm.kind
        var spec_name StringC()
        if spec_kind = P_NAME
        {
            let sptok parm.token
            set spec_name: StringC^host(sptok.data_ptr(), sptok.get_size())
        }
        let allow_name AllowedParams.a1(host, P_NAME)
        if this.parse_param(allow_name, decl_input_level, parm) = false
            return false
        let lttok parm.token
        let link_type StringC^host(lttok.data_ptr(), lttok.get_size())
        let allow_mdc AllowedParams.a1(host, P_MDC)
        if this.parse_param(allow_mdc, decl_input_level, parm) = false
            return false
        let lpd ps.lookup_lpd(link_type)
        if lpd = null
        {
            this.report1_at(ParserMessages.uselinkBadLinkType(), link_type, ps.current_input().token_start_location())
            return true
        }
        if lpd.get_kind() = LPD_SIMPLE
        {
            this.report1_at(ParserMessages.uselinkSimpleLpd(), link_type, ps.current_input().token_start_location())
            return true
        }
        var link_set: ref[LinkSet]? null
        var restore false
        if spec_kind = P_NAME
        {
            set link_set: lpd.lookup_link_set(spec_name)
            if link_set = null
            {
                let lname lpd.get_name()
                this.report2_at(ParserMessages.uselinkBadLinkSet(), lname, spec_name, ps.current_input().token_start_location())
                return true
            }
        }
        else if spec_kind = (P_INDICATED_RESERVED_NAME + R_INITIAL)
            set link_set: lpd.initial_link_set_of()
        else if spec_kind = (P_INDICATED_RESERVED_NAME + R_EMPTY)
            set link_set: lpd.empty_link_set_of()
        else
            set restore: true
        ; UselinkEvent only for an ACTIVE lpd (else ignored markup) — the
        ; port drives the link process at parse time (the queue position).
        if lpd.is_active()
        {
            ps.lp_uselink(link_set, restore, lpd)
            ; RAST: the writer's uselink block (post-uselink snapshot; the
            ; reference prints #LINK-SET-INFO off the CURRENT set even when
            ; the uselink named another lpd and was a no-op).
            if ps.rast_on()
                ps.queue_event_raw(Event.make_uselink(ps.event_host(), ps.lp_current_set(), ps.current_location()))
        }
        true
    }

    ; ---- maybeStartPass2 (ParserState.cxx:120) -----------------------------
    ; Start the second pass when link types were activated, an LPD actually
    ; activated, and pass 1 was error-free; otherwise replay the buffered
    ; pass-1 messages. Returns whether the caller re-runs the prolog.
    function maybe_start_pass2(this: Parser) returns bool
    {
        if ps.get_pass2()
            return false
        if ps.get_allow_pass2() = false
            return false
        var no_pass2 false
        if ps.n_active_lpds() = 0
            set no_pass2: true
        if ps.get_pass1_had_error()
            set no_pass2: true
        if no_pass2
        {
            ; RAST: the reference replays pass-1 events and kept messages as
            ; one interleaved queue — buffered rast PIs interpret in order.
            if ps.rast_on()
                ps.flush_pass1_messages_rast()
            else
                ps.flush_pass1_messages()
            return false
        }
        ps.discard_pass1_messages()
        ; (pass2Ee — the reference's offset re-skip hitting end-of-entity —
        ; cannot occur here: the re-decode covers the same bytes pass 1 read, so
        ; the recorded start index is always reachable.)
        let start_index ps.get_pass2_start_index()
        ; the document source sits at the BOTTOM of the input stack; rebuild a
        ; fresh source over the same origin/buffer, positioned at the first
        ; prolog declaration (the reference rewinds and re-gets the offset).
        var doc_src ps.current_input()
        while ps.get_input_level() > 1
        {
            ps.pop_input_stack()
            set doc_src: ps.current_input()
        }
        ps.reset_for_pass2()
        let src InputSource.make_rewound(host, doc_src, start_index)
        ps.push_input(src)
        true
    }

    ; the data-type tag of an entity definition (sameEntityDef's dataType).
    function entity_data_kind(this: Parser, e: ref[Entity]) returns int
    {
        choose e
            when i: Internal
                return i.get_data_type()
            when x: ExternalText
                return DT_SGML
            when d: ExternalData
                return d.get_data_type()
            when sub: Subdoc
                return DT_SUBDOC
        DT_SGML
    }

    ; sameEntityDef (ParserState.cxx:607) — e1 is the pass-1 original.
    function same_entity_def(this: Parser, e1: ref[Entity], e2: ref[Entity]) returns bool
    {
        if this.entity_data_kind(e1) <> this.entity_data_kind(e2)
            return false
        var i1_is false
        var i1_text StringC()
        choose e1
            when i: Internal
            {
                set i1_is: true
                set i1_text: i.get_text()
            }
        var i2_is false
        var i2_text StringC()
        choose e2
            when i: Internal
            {
                set i2_is: true
                set i2_text: i.get_text()
            }
        if i1_is
        {
            if i2_is = false
                return false
            return i1_text.equals(i2_text)
        }
        if i2_is
            return false
        let id1 e1.get_external_id()
        let id2 e2.get_external_id()
        if id1.has_system_id() <> id2.has_system_id()
            return false
        if id1.has_system_id()
        {
            let s1 id1.get_system_id()
            let s2 id2.get_system_id()
            if s1.equals(s2) = false
                return false
        }
        if id1.has_public_id() <> id2.has_public_id()
            return false
        if id1.has_public_id()
        {
            let p1 id1.get_public_id()
            let p2 id2.get_public_id()
            if p1.equals(p2) = false
                return false
        }
        true
    }

    ; checkEntityStability (ParserState.cxx:647) — after the pass-2 prolog,
    ; every entity consulted through the pass-1 DTD must resolve identically
    ; in the pass-2 base DTD.
    function check_entity_stability(this: Parser)
    {
        let base ps.base_dtd()
        if base = null
            return
        let n ps.n_lpd_entity_refs()
        var i: size_t 0
        while i < n
        {
            let r ps.lpd_entity_ref_at(i)
            let rent r.entity
            let rname rent.get_name()
            var entity base.lookup_entity(r.is_parameter, rname)
            if (entity = null) and r.looked_at_default
                set entity: base.get_default_entity()
            var unstable false
            if entity = null
                set unstable: r.found_in_pass1
            else
            {
                if this.same_entity_def(rent, entity) = false
                    set unstable: true
            }
            if unstable
            {
                if r.is_parameter
                    this.report1_at(ParserMessages.unstableLpdParameterEntity(), rname, ps.current_input().token_start_location())
                else
                    this.report1_at(ParserMessages.unstableLpdGeneralEntity(), rname, ps.current_input().token_start_location())
            }
            set i: i + 1
        }
        ps.clear_lpd_entity_refs()
    }

    ; the EndPrologEvent (parseDecl.cxx:175-193): the active SIMPLE LPDs'
    ; finished attribute lists (printed as `a` records) + the active complex
    ; LPD (if any) that initializes the link process.
    function queue_end_prolog_event(this: Parser)
    {
        var complex_lpd: ref[Lpd]? null
        let names Array[StringC]^host()
        let atts_list Array[ref[AttributeList]?]^host()
        let n ps.n_active_lpds()
        var i: size_t 0
        while i < n
        {
            let l ps.active_lpd_at(i)
            if l.get_kind() = LPD_SIMPLE
            {
                let lname l.get_name()
                names.add(lname)
                let al AttributeList.make(host, l.get_attribute_def())
                let ctx ps.get_attribute_context()
                al.finish(ctx)
                this.check_missing_semantics(al)
                atts_list.add(al)
            }
            else
                set complex_lpd: l
            set i: i + 1
        }
        let ev Event.make_end_prolog(ps.event_host(), complex_lpd as pointer[void], names, atts_list, ps.current_location())
        ; -oentity (SgmlsEventHandler::endProlog): the writer defines EVERY
        ; general entity of the DTD up front, in the reference's
        ; Dtd::generalEntityIter order = the NamedTable BUCKET order —
        ; re-derived through an IdTable exactly like check_dtd_notations
        ; (insertion order feeds the same hash/growth).
        if ps.output_flag(OF_ENTITY)
        {
            let dtd_ge ps.get_current_dtd()
            if dtd_ge <> null
            {
                let nge dtd_ge.n_entities(false)
                let t IdTable.make(host)
                var gi: size_t 0
                while gi < nge
                {
                    let ge dtd_ge.entity_at(false, gi)
                    if ge <> null
                    {
                        let gname ge.get_name()
                        t.lookup_create(host, gname)
                    }
                    set gi: gi + 1
                }
                let ges Array[ref[Entity]?]^host()
                let nb t.bucket_count()
                var b: size_t 0
                while b < nb
                {
                    let slot t.bucket_at(b)
                    if slot <> null
                    {
                        let sname slot.get_name()
                        let ent dtd_ge.lookup_entity(false, sname)
                        if ent <> null
                            ges.add(ent)
                    }
                    set b: b + 1
                }
                ev.set_general_entities(ges)
            }
        }
        ps.queue_event(ev)
    }

    ; lookingAtStartTag (parseDecl.cxx) — "This is harder than might be expected
    ; since we may not have compiled the recognizers for the instance yet": in the
    ; prolog a start tag is NOT a token (proMode has no STAGO), so the unrecognized
    ; token at the cursor is peeked by hand — does the input read STAGO followed by
    ; a name-start character? If so the general identifier is collected (folded
    ; through the instance syntax's substitution table, like every element name).
    ; The scan cursor is left where the peek stopped; the caller ungets the token.
    ; Returns the general identifier, EMPTY when the input is not a start tag (an
    ; out-parameter would make the escape checker reject the store — the returned
    ; StringC's characters live on `host`, but the checker is field-insensitive).
    function looking_at_start_tag(this: Parser) returns StringC
    {
        let ins ps.current_input()
        if ins = null
            return StringC()
        let syn ps.get_instance_syntax()
        let dlen syn.delim_general_len(dSTAGO)
        if dlen = 0
            return StringC()
        var i: size_t 0
        while i < dlen
        {
            let c ins.token_char()
            if c < 0
                return StringC()
            let f syn.fold(c as u32)
            if f <> syn.delim_general_char(dSTAGO, i)
                return StringC()
            set i: i + 1
        }
        var c2 ins.token_char()
        if c2 < 0
            return StringC()
        if syn.is_name_start_character(c2 as u32) = false
            return StringC()
        let buf Array[u32]^host()
        var scanning true
        while scanning
        {
            let f2 syn.fold(c2 as u32)
            buf.add(f2)
            set c2: ins.token_char()
            if c2 < 0
                set scanning: false
            else if syn.is_name_character(c2 as u32) = false
                set scanning: false
        }
        this.build_stringc(buf)
    }

    ; checkDtd's ELEMENT sweep (parseDecl.cxx:2389): every element type that was
    ; only ever REFERENCED (no <!ELEMENT> declared it) gets the shared undefined
    ; definition — ANY content, end tag omissible, undefined index — so the
    ; content checker admits it instead of tripping over a null definition, and
    ; acceptStartTag / tryImplyTag report undefinedElement off the flag. The
    ; definition-less DOCUMENT element additionally reports
    ; documentElementUndefined (validating + IMPLYDEF ELEMENT NO); other
    ; undefined elements are warn-gated (warnUndefinedElement, off). Runs for
    ; every DTD (parseDoctypeDeclEnd + implyDtd), like the reference.
    ; shortrefCanPreemptDelim (parseMode.cxx:525): can the shortref delimiter
    ; `sr` (with 'B' = blank sequence) preempt the delimiter `d` at some offset?
    ; `d_is_sr` = d is itself a shortref string (its 'B's are blank sequences).
    function shortref_can_preempt_delim(this: Parser, sr: StringC, d: StringC, d_is_sr: bool, syn: ref[Syntax]) returns bool
    {
        let srn sr.get_size()
        let dn d.get_size()
        var i: size_t 0
        while i < srn
        {
            var j: size_t 0
            var k: size_t i
            var walking true
            while walking
            {
                if j = dn
                    return true
                if k >= srn
                    set walking: false
                else
                {
                    let sc sr.get(k)
                    let dc d.get(j)
                    if sc = 0x42
                    {
                        var d_is_b false
                        if d_is_sr
                        {
                            if dc = 0x42
                                set d_is_b: true
                        }
                        if d_is_b
                        {
                            set j: j + 1
                            set k: k + 1
                        }
                        else if syn.is_b(dc)
                        {
                            set j: j + 1
                            set k: k + 1
                            var last_b true
                            if k < srn
                            {
                                if sr.get(k) = 0x42
                                    set last_b: false
                            }
                            if last_b
                            {
                                ; it was the last B in the sequence
                                while this.b_run_continues(syn, d, j, dn)
                                    set j: j + 1
                            }
                        }
                        else
                            set walking: false
                    }
                    else if d_is_sr and (dc = 0x42)
                    {
                        if syn.is_b(sc)
                        {
                            set j: j + 1
                            set k: k + 1
                            var tail_b false
                            if j < dn
                            {
                                if d.get(j) <> 0x42
                                    set tail_b: true
                            }
                            if tail_b
                            {
                                while this.sr_b_run_continues(syn, sr, k, srn)
                                    set k: k + 1
                            }
                        }
                        else
                            set walking: false
                    }
                    else if dc = sc
                    {
                        set j: j + 1
                        set k: k + 1
                    }
                    else
                        set walking: false
                }
            }
            set i: i + 1
        }
        false
    }

    ; `j < d.size() && syntax.isB(d[j])` — extracted loop guards (chained calls
    ; as `and` operands mis-plan).
    function b_run_continues(this: Parser, syn: ref[Syntax], d: StringC, j: size_t, dn: size_t) returns bool
    {
        if j >= dn
            return false
        syn.is_b(d.get(j))
    }

    function sr_b_run_continues(this: Parser, syn: ref[Syntax], sr: StringC, k: size_t, srn: size_t) returns bool
    {
        if k >= srn
            return false
        syn.is_b(sr.get(k))
    }

    ; addNeededShortrefs (parseMode.cxx:463): intern into the DTD every shortref
    ; delimiter that must take part in the content-mode compile even though no
    ; SHORTREF declaration maps it — PIO/NET-shaped shortrefs (so the ambiguity
    ; is reported) and complex shortrefs that can preempt a relevant general
    ; delimiter or a used shortref.
    function add_needed_shortrefs(this: Parser, dtd: ref[Dtd], syn: ref[Syntax])
    {
        if syn.has_shortrefs() = false
            return
        let sdv *ps.get_sd()
        let table ModeInfo.build_table(host)
        let delim_relevant host.allocate(N_DELIM_GENERAL as size_t, 1) as pointer[u8]
        var z: int 0
        while z < N_DELIM_GENERAL
        {
            set *(delim_relevant + (z as size_t)): 0
            set z: z + 1
        }
        let mi ModeInfo^host(mconnetMode, sdv, table)
        var ti TokenInfo()
        while mi.next_token(&ti)
        {
            if (ti.kind = TT_DELIM) or (ti.kind = TT_DELIMDELIM) or (ti.kind = TT_DELIMSET)
                set *(delim_relevant + (ti.delim1 as size_t)): 1
        }
        ; PIO and NET are the only delimiters recognized in con mode without
        ; context; a shortref identical to one of them must be needed so the
        ; ambiguity is reported.
        ; (the interned strings are deep-copied to the parser page — the C++
        ; Vector<StringC> push_back copies too, and the escape checker wants
        ; the frame-transient StringC values pinned.)
        let pio syn.delim_string(dPIO)
        if syn.is_valid_shortref(pio)
        {
            let pio_p StringC^host(pio.data_ptr(), pio.get_size())
            var d1 dtd.intern_shortref(pio_p)
        }
        let net syn.delim_string(dNET)
        if syn.is_valid_shortref(net)
        {
            let net_p StringC^host(net.data_ptr(), net.get_size())
            var d2 dtd.intern_shortref(net_p)
        }
        let ncx syn.n_delim_shortref_complex()
        var i: size_t 0
        while i < ncx
        {
            let cx syn.delim_shortref_complex(i)
            var needed false
            var j: int 0
            while j < N_DELIM_GENERAL
            {
                if (*(delim_relevant + (j as size_t))) <> 0
                {
                    let dg syn.delim_string(j)
                    if this.shortref_can_preempt_delim(cx, dg, false, syn)
                    {
                        set needed: true
                        set j: N_DELIM_GENERAL
                    }
                    else
                        set j: j + 1
                }
                else
                    set j: j + 1
            }
            if needed = false
            {
                var k: size_t 0
                let nsr dtd.n_shortref()
                while k < nsr
                {
                    let used_sr dtd.shortref(k)
                    if this.shortref_can_preempt_delim(cx, used_sr, true, syn)
                    {
                        set needed: true
                        set k: nsr
                    }
                    else
                        set k: k + 1
                }
            }
            if needed
            {
                let cx_p StringC^host(cx.data_ptr(), cx.get_size())
                var d3 dtd.intern_shortref(cx_p)
            }
            set i: i + 1
        }
    }

    ; addCommonAttributes (parseDecl.cxx:2589, the live #else version): fan the
    ; #IMPLICIT / #ALL common attribute definitions out over every element type
    ; and notation. Slot layout: 0 = element #IMPLICIT (skip defined elements),
    ; 1 = element #ALL (always merge), 2 = notation #IMPLICIT (skip defined
    ; notations; a specified-#ALL attribute redeclared here is an error),
    ; 3 = notation #ALL. The #ALL carriers are REMOVED from their tables here;
    ; the #IMPLICIT carriers at the end (their lists stashed on the Dtd for
    ; undefined elements/notations created later in the instance).
    function add_common_attributes(this: Parser, dtd: ref[Dtd])
    {
        let rni_implicit this.rni_reserved_name(R_IMPLICIT)
        let rni_all this.rni_reserved_name(R_ALL)
        var common0: ref[AttributeDefinitionList]? null
        var common1: ref[AttributeDefinitionList]? null
        var common2: ref[AttributeDefinitionList]? null
        var common3: ref[AttributeDefinitionList]? null
        let e_imp this.lookup_create_element(rni_implicit)
        set common0: e_imp.get_attribute_def()
        let e_all dtd.remove_element_type(rni_all)
        if e_all <> null
            set common1: e_all.get_attribute_def()
        let n_imp this.lookup_create_notation(rni_implicit)
        set common2: n_imp.get_attribute_def()
        let n_all dtd.remove_notation(rni_all)
        if n_all <> null
            set common3: n_all.get_attribute_def()

        ; done1Adl (#ALL passes) / done2Adl (#IMPLICIT passes), indexed by the
        ; definition-list alloc index — a shared list merges only once per kind.
        let n_adl dtd.get_n_attribute_definition_list()
        let done1 host.allocate(n_adl + 1, 1) as pointer[u8]
        let done2 host.allocate(n_adl + 1, 1) as pointer[u8]
        var zi: size_t 0
        while zi <= n_adl
        {
            set *(done1 + zi): 0
            set *(done2 + zi): 0
            set zi: zi + 1
        }
        var slot: int 0
        while slot < 4
        {
            var common: ref[AttributeDefinitionList]? null
            if slot = 0
                set common: common0
            else if slot = 1
                set common: common1
            else if slot = 2
                set common: common2
            else
                set common: common3
            if common <> null
            {
                let is_all (slot = 1) or (slot = 3)
                let cidx common.get_index()
                if cidx < n_adl
                {
                    if is_all
                        set *(done1 + cidx): 1
                    else
                        set *(done2 + cidx): 1
                }
                let is_notation_slot slot >= 2
                var count dtd.n_element_types()
                if is_notation_slot
                    set count: dtd.n_notations()
                var ai: size_t 0
                while ai < count
                {
                    var adl: ref[AttributeDefinitionList]? null
                    var skip false
                    var present false
                    if is_notation_slot
                    {
                        let nt dtd.notation_at(ai)
                        if nt <> null
                        {
                            set present: true
                            set adl: nt.get_attribute_def()
                            if is_all = false
                                set skip: nt.is_defined()
                        }
                    }
                    else
                    {
                        let et dtd.get_element_type_at(ai)
                        if et <> null
                        {
                            set present: true
                            set adl: et.get_attribute_def()
                            if is_all = false
                            {
                                if et.get_definition() <> null
                                    set skip: true
                            }
                        }
                    }
                    if present
                    {
                        if adl = null
                        {
                            if skip = false
                            {
                                if is_notation_slot
                                {
                                    let nt2 dtd.notation_at(ai)
                                    nt2.set_attribute_def(common)
                                }
                                else
                                {
                                    let et2 dtd.get_element_type_at(ai)
                                    et2.set_attribute_def(common)
                                }
                            }
                        }
                        else
                        {
                            let aidx adl.get_index()
                            var done true
                            if aidx < n_adl
                            {
                                if is_all
                                {
                                    if *(done1 + aidx) = 0
                                    {
                                        set done: false
                                        set *(done1 + aidx): 1
                                    }
                                }
                                else
                                {
                                    if *(done2 + aidx) = 0
                                    {
                                        set done: false
                                        set *(done2 + aidx): 1
                                    }
                                }
                            }
                            if (done = false) and (skip = false)
                            {
                                var cj: size_t 0
                                let cn common.size()
                                while cj < cn
                                {
                                    let cdef common.def(cj)
                                    let cname cdef.get_name()
                                    let have adl.attribute_index(cname)
                                    if have < 0
                                    {
                                        let cc (*cdef).copy(host)
                                        adl.append(cc)
                                    }
                                    else if slot = 2
                                    {
                                        ; parseDecl.cxx:2678: an #ALL data
                                        ; attribute that was SPECIFIED and is
                                        ; now redeclared as #IMPLICIT.
                                        let hd adl.def(have as size_t)
                                        var him false
                                        var hspec false
                                        if hd.is_specified(&him)
                                        {
                                            if him = false
                                                set hspec: true
                                        }
                                        if hspec
                                        {
                                            let hdn hd.get_name()
                                            this.report1_at(ParserMessages.specifiedAttributeRedeclared(), hdn, ps.current_input().token_start_location())
                                        }
                                    }
                                    set cj: cj + 1
                                }
                            }
                        }
                    }
                    set ai: ai + 1
                }
            }
            set slot: slot + 1
        }
        let e_imp2 dtd.remove_element_type(rni_implicit)
        if e_imp2 <> null
            dtd.set_implicit_element_attribute_def(e_imp2.get_attribute_def())
        let n_imp2 dtd.remove_notation(rni_implicit)
        if n_imp2 <> null
            dtd.set_implicit_notation_attribute_def(n_imp2.get_attribute_def())
    }

    function check_dtd(this: Parser, dtd: ref[Dtd])
    {
        ; checkDtd (parseDecl.cxx:2385): the base DTD interns the shortref
        ; delimiters the content-mode compile must consider beyond the declared
        ; ones.
        if dtd.get_is_base()
            this.add_needed_shortrefs(dtd, this.instance_syntax_ref())
        ; parseDecl.cxx:2387: the #IMPLICIT/#ALL fan-out (Annex K) — under WWW
        ; or with errorAfdr off.
        var afdr_on ps.get_sd().www()
        if ps.get_error_afdr() = false
            set afdr_on: true
        if afdr_on
            this.add_common_attributes(dtd)
        let allow_recursion ps.get_implydef_element() <> IMPLYDEF_ELEMENT_ANYOTHER
        let det dtd.get_document_element_type()
        let n dtd.n_element_types()
        var def: ref[ElementDefinition]? null
        var di: size_t 0
        var i: size_t 0
        while i < n
        {
            let p dtd.get_element_type_at(i)
            if p <> null
            {
                if p.get_definition() = null
                {
                    if p = det
                    {
                        if ps.validate() and (ps.get_implydef_element() = IMPLYDEF_ELEMENT_NO)
                        {
                            ; currentLocation() = the START of the current token
                            ; (the DSC / MDC that ended the subset).
                            let ins ps.current_input()
                            let cloc ins.token_start_location()
                            this.report0_at(ParserMessages.documentElementUndefined(), cloc)
                        }
                    }
                    else
                    {
                        ; parseDecl.cxx:2399: any OTHER referenced-but-never-
                        ; declared element warns under -wundefined.
                        let opt ps.get_options()
                        if opt.warn_undefined_element
                        {
                            let un p.get_name()
                            this.report1_at(ParserMessages.dtdUndefinedElement(), un, ps.current_input().token_start_location())
                        }
                    }
                    if def = null
                    {
                        let loc ps.current_location()
                        set def: ElementDefinition.make(host, loc, ELEMENT_UNDEFINED_INDEX, OMIT_END, DC_ANY, allow_recursion)
                    }
                    p.set_element_definition(def, di)
                    set di: di + 1
                }
                ; the map half of the element sweep (parseDecl.cxx:2408): a
                ; USEMAP named this map for the element but no SHORTREF
                ; declaration ever defined it.
                let emap p.get_map()
                if emap <> null
                {
                    if (emap <> ps.get_content_state().get_the_empty_map()) and (emap.defined() = false)
                    {
                        if ps.validate()
                        {
                            let mn emap.get_name()
                            let en p.get_name()
                            this.report2_at(ParserMessages.undefinedShortrefMapDtd(), mn, en, ps.current_input().token_start_location())
                        }
                        p.set_map(null)
                    }
                }
            }
            set i: i + 1
        }

        ; --- the shortref-map sweep (parseDecl.cxx:2418): resolve each map's
        ; entity names to general entities; an unresolved name reports
        ; mapEntityUndefined at the map's declaration MDO (setNextLocation
        ; (map->defLocation())). Iteration follows the reference's NamedTable
        ; BUCKET order — re-derived through an IdTable like check_dtd_notations.
        ; (warnDefaultEntityReference / warnUnusedMap are option-gated off.)
        let nmaps dtd.n_short_reference_maps()
        if nmaps > 0
        {
            let nsr dtd.n_shortref()
            let t IdTable.make(host)
            var mi: size_t 0
            while mi < nmaps
            {
                let m dtd.short_reference_map_at(mi)
                if m <> null
                {
                    let mn2 m.get_name()
                    t.lookup_create(host, mn2)
                }
                set mi: mi + 1
            }
            let nb t.bucket_count()
            var b: size_t 0
            while b < nb
            {
                let slot t.bucket_at(b)
                if slot <> null
                {
                    let sname slot.get_name()
                    let m2 dtd.lookup_short_reference_map(sname)
                    if m2 <> null
                    {
                        let emv Array[ref[Entity]?]^host()
                        var ei: size_t 0
                        while ei < nsr
                        {
                            emv.add(null)
                            set ei: ei + 1
                        }
                        var ej: size_t 0
                        while ej < nsr
                        {
                            if m2.has_entity_name(ej)
                            {
                                let ename m2.entity_name(ej)
                                ; the reference resolves map entities through
                                ; lookupEntity (parseDecl.cxx:2429) — including
                                ; the defaulted-copy consult (mapDefaultEntity,
                                ; the option-gated warning, stays with -w).
                                let ent this.lookup_entity_or_default(false, ename)
                                if ent = null
                                {
                                    let mn3 m2.get_name()
                                    this.report2_at(ParserMessages.mapEntityUndefined(), ename, mn3, m2.get_def_location())
                                }
                                else
                                {
                                    ; parseDecl.cxx:2437: a map entry resolving
                                    ; to a defaulted entity warns under
                                    ; -wdefault, at the map's declaration MDO.
                                    if ps.entity_is_defaulted(ent)
                                    {
                                        let opt_md ps.get_options()
                                        if opt_md.warn_default_entity_reference
                                        {
                                            let mn4 m2.get_name()
                                            this.report2_at(ParserMessages.mapDefaultEntity(), ename, mn4, m2.get_def_location())
                                        }
                                    }
                                    emv.put(ej, ent)
                                }
                            }
                            set ej: ej + 1
                        }
                        m2.set_entity_map(emv)
                        ; parseDecl.cxx:2448: a declared map never named by a
                        ; USEMAP warns under -wunused-map, at its declaration.
                        if m2.used = false
                        {
                            let opt_um ps.get_options()
                            if opt_um.warn_unused_map
                            {
                                let mn5 m2.get_name()
                                this.report1_at(ParserMessages.unusedMap(), mn5, m2.get_def_location())
                            }
                        }
                    }
                }
                set b: b + 1
            }
        }
        ; parseDecl.cxx:2453: parameter entities never referenced warn under
        ; -wunused-param, at their declaration — unless the entity text could
        ; be a marked-section status keyword (INCLUDE/IGNORE).
        let opt_up ps.get_options()
        if opt_up.warn_unused_param
        {
            let npe dtd.n_entities(true)
            let tp IdTable.make(host)
            var pi: size_t 0
            while pi < npe
            {
                let pent dtd.entity_at(true, pi)
                if pent <> null
                {
                    let pname pent.get_name()
                    if pname.get_size() > 0
                        tp.lookup_create(host, pname)
                }
                set pi: pi + 1
            }
            let npb tp.bucket_count()
            var pb: size_t 0
            while pb < npb
            {
                let pslot tp.bucket_at(pb)
                if pslot <> null
                {
                    let psname pslot.get_name()
                    let pent2 dtd.lookup_entity(true, psname)
                    if pent2 <> null
                    {
                        if ps.entity_is_used(pent2) = false
                        {
                            if this.maybe_status_keyword(pent2) = false
                                this.report1_at(ParserMessages.unusedParamEntity(), psname, ps.entity_def_location(pent2))
                        }
                    }
                }
                set pb: pb + 1
            }
        }
    }

    ; maybeStatusKeyword (parseDecl.cxx:2707): an internal entity whose text is
    ; (S*, INCLUDE or IGNORE, S*) under the instance syntax's general subst.
    function maybe_status_keyword(this: Parser, ent: ref[Entity]) returns bool
    {
        var text StringC()
        var is_internal false
        choose ent
            when ie: Internal
            {
                set text: ie.get_text()
                set is_internal: true
            }
        if is_internal = false
            return false
        let syn ps.get_instance_syntax()
        let sset syn.char_set(setS)
        var w: int 0
        while w < 2
        {
            var kw_name R_INCLUDE
            if w = 1
                set kw_name: R_IGNORE
            let keyword syn.reserved_name(kw_name)
            var j: size_t 0
            let tsize text.get_size()
            while j < tsize
            {
                if sset.contains(text.get(j)) = false
                    break
                set j: j + 1
            }
            var k: size_t 0
            let ksize keyword.get_size()
            while (j < tsize) and (k < ksize)
            {
                if syn.fold(text.get(j)) <> keyword.get(k)
                    break
                set j: j + 1
                set k: k + 1
            }
            if k = ksize
            {
                while j < tsize
                {
                    if sset.contains(text.get(j)) = false
                        break
                    set j: j + 1
                }
                if j = tsize
                    return true
            }
            set w: w + 1
        }
        false
    }

    ; checkDtd (parseDecl.cxx:2466-2520), the ENTITY/NOTATION halves — the
    ; element half stays with the implied-DTD check_dtd above. Runs at DOCTYPE
    ; end BEFORE the closing MDC is parsed (so a current-location message points
    ; at the DSC, verified vs real onsgmls). Two sweeps:
    ;   - every external data entity whose notation is still undefined reports
    ;     entityNotationUndefined (notation, entity) at the entity's declaration
    ;     MDO (its defLocation);
    ;   - every undefined notation that carries an attribute definition list
    ;     reports attlistNotationUndefined at the current location.
    ; Both sweeps iterate the reference's NamedTable BUCKET order, NOT
    ; declaration order (verified: zebra/mike/alpha) — re-derived by inserting
    ; the names in declaration order into an IdTable (the faithful
    ; Hash/PointerTable port) and walking its buckets. The reference's
    ; implydefNotation branch (auto-define instead of report) is unreachable:
    ; our Sd never sets IMPLYDEF NOTATION (constant, like implydef_doctype).
    ; Under WWW the reference sweeps parameter entities too.
    function check_dtd_notations(this: Parser, dtd: ref[Dtd])
    {
        ; the sweeps themselves run unconditionally (the IMPLYDEF NOTATION
        ; auto-define must happen even without validation); only the messages
        ; are validate-gated (parseDecl.cxx:2482/2516).
        ; (the element sweep — undefined definitions + documentElementUndefined —
        ; runs just before this in check_dtd, reference order.)
        var passes: int 1
        if ps.get_sd().www()
            set passes: 2
        var pass: int 0
        while pass < passes
        {
            let is_parameter pass = 1
            let n dtd.n_entities(is_parameter)
            let t IdTable.make(host)
            var i: size_t 0
            while i < n
            {
                let ent dtd.entity_at(is_parameter, i)
                if ent <> null
                {
                    let ename ent.get_name()
                    t.lookup_create(host, ename)
                }
                set i: i + 1
            }
            let nb t.bucket_count()
            var b: size_t 0
            while b < nb
            {
                let slot t.bucket_at(b)
                if slot <> null
                {
                    let sname slot.get_name()
                    let ent2 dtd.lookup_entity(is_parameter, sname)
                    if ent2 <> null
                    {
                        let ntv ent2.get_data_notation()
                        if ntv <> null
                        {
                            let nt ntv as ref[Notation]
                            if nt.is_defined() = false
                            {
                                ; IMPLYDEF NOTATION YES (parseDecl.cxx:2477):
                                ; auto-define with an empty external id instead
                                ; of reporting (generateSystemId's miss warning
                                ; is warnNotationSystemId-gated — silent).
                                if ps.get_sd().implydef_notation()
                                {
                                    let empty_id ExternalId()
                                    nt.set_external_id(empty_id, Location())
                                }
                                else if ps.validate()
                                {
                                    let nn nt.get_name()
                                    let en ent2.get_name()
                                    let dl ent2.get_def_location()
                                    ; the reference switches on declType (parseDecl.
                                    ; cxx:2484): parameterEntity -> the "parameter
                                    ; entity" form; doctype -> dsEntityNotation-
                                    ; Undefined. Both live in the PARAMETER table
                                    ; (Dtd.h:162), the doctype data entity with an
                                    ; explicitly EMPTIED name (parseDecl.cxx:2240) —
                                    ; the empty name IS the declType discriminant.
                                    if is_parameter
                                    {
                                        if en.get_size() = 0
                                            this.report1_at(ParserMessages.dsEntityNotationUndefined(), nn, dl)
                                        else
                                            this.report2_at(ParserMessages.parameterEntityNotationUndefined(), nn, en, dl)
                                    }
                                    else
                                        this.report2_at(ParserMessages.entityNotationUndefined(), nn, en, dl)
                                }
                            }
                        }
                    }
                }
                set b: b + 1
            }
            set pass: pass + 1
        }
        let nnot dtd.n_notations()
        let tn IdTable.make(host)
        var j: size_t 0
        while j < nnot
        {
            let ntj dtd.notation_at(j)
            if ntj <> null
            {
                let nname ntj.get_name()
                tn.lookup_create(host, nname)
            }
            set j: j + 1
        }
        let nb2 tn.bucket_count()
        var b2: size_t 0
        while b2 < nb2
        {
            let slot2 tn.bucket_at(b2)
            if slot2 <> null
            {
                let sname2 slot2.get_name()
                let nt2 dtd.lookup_notation(sname2)
                if nt2 <> null
                {
                    if nt2.is_defined() = false
                        if nt2.get_attribute_def() <> null
                        {
                            ; IMPLYDEF NOTATION YES: auto-define instead
                            ; (parseDecl.cxx:2511).
                            if ps.get_sd().implydef_notation()
                            {
                                let empty_id2 ExternalId()
                                nt2.set_external_id(empty_id2, Location())
                            }
                            else if ps.validate()
                            {
                                ; current-location message: the current TOKEN start
                                ; (the DSC — verified 7:0 vs real onsgmls; report1's
                                ; cursor position is one past it).
                                let nn2 nt2.get_name()
                                let nloc ps.current_input().token_start_location()
                                this.report1_at(ParserMessages.attlistNotationUndefined(), nn2, nloc)
                            }
                        }
                }
            }
            set b2: b2 + 1
        }
    }

    ; implyDtd (parseDecl.cxx) — the document has no document type declaration at
    ; all: the first thing in the prolog is the document element's start tag.
    ;
    ; Two errors, in this order (both hard — the parse continues but the document
    ; does NOT conform, so onsgmls exits 1 and writes no trailing `C`):
    ;   omittedProlog  the prolog may only be omitted with CONCUR NO, LINK EXPLICIT
    ;                  NO and IMPLYDEF ELEMENT or DOCTYPE YES. xml.dcl and the
    ;                  reference declaration say IMPLYDEF NO -> always reported.
    ;   noDtd          "no document type declaration; will parse without validation"
    ;                  — the reference reaches it when the catalog has no DTD filed
    ;                  under the document element's name. We do not wire that
    ;                  lookup: no corpus catalog declares a DOCTYPE entry, so the
    ;                  lookup would always fail and this is the only branch.
    ;
    ; Then enableImplydef: for the rest of the parse an undeclared element is
    ; implied (ANY content) rather than an error, and an undeclared attribute gets
    ; an implied CDATA definition. The DTD itself is a base Dtd named after the GI,
    ; carrying only the syntax's predefined entities.
    function imply_dtd(this: Parser, gi: StringC)
    {
        let sd ps.get_sd()
        ; parseDecl.cxx:2278 — the prolog may only be omitted with CONCUR NO,
        ; LINK EXPLICIT NO and IMPLYDEF ELEMENT or DOCTYPE YES.
        var omitted_prolog false
        if (sd.concur() > 0) or (sd.explicit_link() > 0)
            set omitted_prolog: true
        if sd.implydef_element() = IMPLYDEF_ELEMENT_NO
        {
            if sd.implydef_doctype() = false
                set omitted_prolog: true
        }
        if omitted_prolog
            this.report0(ParserMessages.omittedProlog())

        ; parseDecl.cxx:2283: with IMPLYDEF ELEMENT YES/ANYOTHER and no
        ; IMPLYDEF DOCTYPE, definitions are implied anyway — an empty implied
        ; DTD, no message, no subset.
        var skip_catalog false
        if sd.implydef_element() <> IMPLYDEF_ELEMENT_NO
        {
            if sd.implydef_doctype() = false
                set skip_catalog: true
        }
        var csys String()
        if skip_catalog = false
        {
            ; the implied doctype entity's system id: a DOCTYPE catalog entry
            ; (generateSystemId for declType doctype / the direct lookup at
            ; parseDecl.cxx:2300).
            let cat ps.get_entity_catalog()
            if cat <> null
            {
                let gi8 this.stringc_to_bytes(gi)
                set csys: String^host(cat.lookup_doctype(gi8, sd.namecase_general()))
            }
            if csys.get_length() = 0
            {
                if sd.implydef_doctype()
                    this.report1(ParserMessages.cannotGenerateSystemIdDoctype(), gi)
                else
                {
                    this.report0(ParserMessages.noDtd())
                    ps.enable_implydef()
                }
            }
            else if sd.implydef_doctype() = false
            {
                ; implyingDtd (parseDecl.cxx:2334): the catalog supplied a DTD —
                ; announce the implied declaration `<!DOCTYPE gi SYSTEM>`.
                let syn ps.get_syntax()
                let dbuf Array[u32]^host()
                this.append_delim_chars(dbuf, dMDO)
                let rn_doctype syn.reserved_name(R_DOCTYPE)
                this.arg_append(dbuf, rn_doctype)
                dbuf.add(0x20)
                this.arg_append(dbuf, gi)
                dbuf.add(0x20)
                let rn_system syn.reserved_name(R_SYSTEM)
                this.arg_append(dbuf, rn_system)
                this.append_delim_chars(dbuf, dMDC)
                let decl_str StringC^host(dbuf.get_buffer(), dbuf.get_length())
                this.report1(ParserMessages.implyingDtd(), decl_str)
            }
        }

        let dtd Dtd.make(host, gi, true)
        ps.set_def_dtd(dtd)
        ps.set_current_dtd(dtd)
        this.insert_include_entities(dtd)
        this.insert_predefined_entities(dtd)
        if csys.get_length() > 0
        {
            ; dsReference on the implied doctype entity: parse the catalog-
            ; resolved DTD as the (external) declaration subset. Catalog system
            ; ids resolve against the CWD (empty base, cf. sd_reference_public).
            ps.set_phase(PHASE_DECL_SUBSET)
            let cfsi Array[u8]^host()
            this.append_bytes(cfsi, String("<OSFILE>"))
            this.append_bytes(cfsi, csys)
            let cfs String^host(cfsi.get_buffer() as pointer[const_char], cfsi.get_length())
            let corg host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
            set *corg: Origin()
            var cfound String()
            let ext_src this.fsi_open(*cfs, corg, ps.current_input().token_start_location(), ps.current_input().token_start_location(), 0, &cfound)
            if ext_src <> null
            {
                let dtd_dir Path.get_directory_name(cfound)
                ps.set_decl_base_dir(dtd_dir)
                ps.push_input(ext_src)
                let ext_level ps.get_input_level()
                this.parse_decl_subset(ext_level, true)
                ps.set_decl_base_dir(ps.get_base_dir())
            }
            ps.set_phase(PHASE_PROLOG)
        }
        this.check_dtd(dtd)
        this.check_dtd_notations(dtd)
        ; implyDtd ends through parseDoctypeDeclEnd(1) — checkDtd then endDtd
        ; (parseDecl.cxx:2352): the implied DTD joins the document's list.
        ps.end_dtd()
    }

    ; doProlog (scoped): skip separators, dispatch the DOCTYPE declaration, and
    ; leave the input positioned at the first instance token.
    ; prologRecover (parseDecl.cxx): after an invalid prolog character, skip
    ; ahead to something that could open a declaration / PI / the instance.
    function prolog_recover(this: Parser)
    {
        var skip_count: u32 0
        let re_ch ps.get_syntax().standard_function(fRE)
        var looping true
        while looping
        {
            var token ps.get_token(proMode)
            set skip_count: skip_count + (1 as u32)
            if token = tokenUnrecognized
            {
                ; the `]>`-of-a-lost-subset heuristic: an MDC followed by S
                ; ends the recovery.
                set token: ps.get_token(mdMode)
                if token = tokenMdc
                {
                    set token: ps.get_token(proMode)
                    if token = tokenS
                        return
                }
            }
            if token = tokenUnrecognized
            {
                ; getChar() — consume the unmatched character.
                let ins ps.current_input()
                if ins.current_token_length() = 0
                    ins.end_token(1)
            }
            else if token = tokenEe
                return
            else if (token = tokenMdoMdc) or (token = tokenMdoCom) or (token = tokenMdoNameStart) or (token = tokenPio)
            {
                ps.current_input().unget_token()
                return
            }
            else if token = tokenS
            {
                let cc ps.current_input().current_char()
                if (cc = re_ch) and (skip_count >= 250)
                    return
            }
        }
    }

    function parse_prolog(this: Parser, base_dir: String) returns bool
    {
        ps.set_current_mode(proMode)
        ps.set_phase(PHASE_PROLOG)
        var running true
        var ok true
        var prolog_tries: u32 0
        while running
        {
            ; error-limit abort applies to the prolog too (the reference's
            ; parseAll checks the handler's cancel pointer on every event
            ; delivery, prolog declarations included).
            if ps.is_cancelled()
                return false
            let token ps.get_token(proMode)
            if token = tokenS
            {
                ; separator between prolog constructs: skip
            }
            else if (token = tokenRe) or (token = tokenRs)
            {
                ; record boundary in the prolog: ignore
            }
            else if token = tokenMdoNameStart
            {
                ; setPass2Start (parseDecl.cxx:94) — at the FIRST prolog markup
                ; declaration; begins pass-1 buffering when LINK is admitted
                ; and link types were activated (-a).
                ps.set_pass2_start()
                ; the MDO of this declaration (markupLocation()) — a DOCTYPE
                ; data entity's defLocation_ points here.
                let prolog_mdo_loc ps.current_input().token_start_location()
                let prolog_decl_level ps.get_input_level()
                var decl_name: int 0
                if this.parse_declaration_name(&decl_name, false) = false
                {
                    set ok: false
                    set running: false
                }
                else if decl_name = R_DOCTYPE
                {
                    ; doProlog keeps scanning after the DOCTYPE: the separators
                    ; between `]>` and the instance are PROLOG separators, and
                    ; under CONCUR / LINK EXPLICIT a FURTHER document type
                    ; declaration may follow (parse_doctype_decl_start ends the
                    ; DTD; the instance's first token stops the loop below). On
                    ; failure the reference gives up (parseDecl.cxx:100) — except
                    ; when the DOCUMENT itself ended inside the subset: that path
                    ; is allDone() (documentEndDtdSubset already reported, the
                    ; input stack popped), with no giveUp.
                    if this.parse_doctype_decl_start(base_dir, prolog_mdo_loc) = false
                    {
                        if ps.current_input() <> null
                        {
                            ; giveUp anchors at the failing token's start (the
                            ; plain-message location convention).
                            let gv_loc ps.current_input().token_start_location()
                            if ps.get_subdoc_level() > 0
                                this.report0_at(ParserMessages.subdocGiveUp(), gv_loc)
                            else
                                this.report0_at(ParserMessages.giveUp(), gv_loc)
                        }
                        set ok: false
                        set running: false
                    }
                }
                else if decl_name = R_LINKTYPE
                {
                    ; parseLinktypeDeclStart (parseDecl.cxx:104): a failure
                    ; gives up exactly like the DOCTYPE arm (same doc-end-in-
                    ; subset exception).
                    if this.parse_linktype_decl_start(base_dir, prolog_mdo_loc) = false
                    {
                        if ps.current_input() <> null
                        {
                            let gv_loc2 ps.current_input().token_start_location()
                            if ps.get_subdoc_level() > 0
                                this.report0_at(ParserMessages.subdocGiveUp(), gv_loc2)
                            else
                                this.report0_at(ParserMessages.giveUp(), gv_loc2)
                        }
                        set ok: false
                        set running: false
                    }
                }
                else
                {
                    ; doProlog (parseDecl.cxx:108): a declaration reserved name that
                    ; is not allowed in the prolog. ELEMENT/ATTLIST/ENTITY/NOTATION/
                    ; SHORTREF/USEMAP/USELINK/LINK/IDLINK -> prologDeclaration; any
                    ; other recognized reserved name -> noSuchDeclarationType (the
                    ; switch default). Then recover past the declaration and keep
                    ; scanning the prolog (DOCTYPE / the instance may still follow).
                    let spell this.name_folded()
                    let dloc ps.current_input().token_start_location()
                    if this.prolog_declaration_not_allowed(decl_name)
                    {
                        this.report1_at(ParserMessages.prologDeclaration(), spell, dloc)
                        ; parseDecl.cxx:119 — only BEFORE the DOCTYPE does a
                        ; misplaced declaration count toward giving up.
                        if ps.had_dtd() = false
                            set prolog_tries: prolog_tries + (1 as u32)
                    }
                    else
                        this.report1_at(ParserMessages.noSuchDeclarationType(), spell, dloc)
                    this.skip_declaration(prolog_decl_level)
                }
            }
            else if token = tokenPio
            {
                ; a processing instruction in the prolog (e.g. an XML declaration
                ; `<?xml ...?>` before the document element). doProlog: parse it
                ; and keep scanning the prolog. Must precede the unrecognized /
                ; implyDtd arm so a leading PI does not derail No-DOCTYPE detection.
                if this.parse_processing_instruction() = false
                {
                    set ok: false
                    set running: false
                }
            }
            else if token = tokenMdoCom
            {
                ; doProlog case tokenMdoCom (parseDecl.cxx:89): a comment
                ; declaration in the prolog; keep scanning.
                if this.parse_comment_decl() = false
                {
                    set ok: false
                    set running: false
                }
            }
            else if token = tokenMdoMdc
            {
                ; doProlog case tokenMdoMdc (parseDecl.cxx:85): the empty
                ; comment declaration `<!>` — warns under -wempty-comment-decl,
                ; the prolog continues.
                let opt_ec3 ps.get_options()
                if opt_ec3.warn_empty_comment_decl
                    this.report0_at(ParserMessages.emptyCommentDecl(), ps.current_input().token_start_location())
            }
            else if token = tokenEe
            {
                ; doProlog tokenEe: with a DTD in hand the prolog simply ends
                ; (endProlog) — the instance begins at EOF and noDocumentElement
                ; follows from end_all_elements. Without one the document ended
                ; before any content: documentEndProlog.
                if ps.had_dtd()
                    set running: false
                else
                {
                    this.report0_at(ParserMessages.documentEndProlog(), ps.current_input().token_start_location())
                    set ok: false
                    set running: false
                }
            }
            else if token = tokenUnrecognized
            {
                ; proMode has no STAGO recognizer, so the document element's start
                ; tag arrives here as an unrecognized token. With a DTD in hand the
                ; instance simply begins (unget, let do_content rescan it); WITHOUT
                ; one this is a document with no DOCTYPE — peek for the start tag
                ; and imply the DTD from its general identifier (doProlog).
                if ps.had_dtd() = false
                {
                    let gi this.looking_at_start_tag()
                    if gi.get_size() > 0
                    {
                        ps.current_input().unget_token()
                        this.imply_dtd(gi)
                        set running: false
                    }
                    else
                    {
                        ; prologCharacter (parseDecl.cxx:74) — a character that can
                        ; neither open a declaration nor start the instance; a
                        ; non-SGML character reports its own message instead. Then
                        ; recover (prologRecover) and keep scanning the prolog —
                        ; after maxTries (10) rounds give up (notSgml).
                        if this.report_non_sgml_param() = false
                        {
                            set prolog_tries: prolog_tries + (1 as u32)
                            if prolog_tries >= 10
                            {
                                this.report0_at(ParserMessages.notSgml(), ps.current_input().token_start_location())
                                ; Parser::giveUp (Parser.cxx:183): inside a
                                ; subdocument this is subdocGiveUp, not giveUp.
                                if ps.get_subdoc_level() > 0
                                    this.report0(ParserMessages.subdocGiveUp())
                                else
                                    this.report0(ParserMessages.giveUp())
                                set ok: false
                                set running: false
                            }
                            else
                            {
                                let ct ps.current_token()
                                this.report1_at(ParserMessages.prologCharacter(), ct, ps.current_input().token_start_location())
                                this.prolog_recover()
                            }
                        }
                    }
                }
                else
                {
                    ps.current_input().unget_token()
                    set running: false
                }
            }
            else
            {
                ; the instance begins (data / another instance token): unget and stop.
                ps.current_input().unget_token()
                set running: false
            }
        }
        ok
    }

    ; doInstanceStart (parseInstance.cxx:16) — the instance's FIRST token: when
    ; it is not a tag (or entity end), the document element's start tag is
    ; implied under OMITTAG YES; under OMITTAG NO the instance must start with
    ; the document element (instanceStartOmittag) and the data stays outside.
    ; The token is ungotten either way and re-dispatched by do_content.
    function do_instance_start(this: Parser)
    {
        let token ps.get_token(ps.get_current_mode())
        var needs_imply true
        if token = tokenEe
            set needs_imply: false
        else if (token = tokenStagoNameStart) or (token = tokenStagoTagc) or (token = tokenStagoGrpo)
            set needs_imply: false
        else if (token = tokenEtagoNameStart) or (token = tokenEtagoTagc) or (token = tokenEtagoGrpo)
            set needs_imply: false
        if needs_imply
        {
            if ps.get_sd().omittag()
            {
                var start_implied: u32 0
                let undo Array[UndoEntry]^host()
                let events Array[ref[Event]?]^host()
                let discard this.try_imply_tag(ps.current_input().token_start_location(), &start_implied, undo, events)
                this.queue_element_events(events)
            }
            else
                this.report0_at(ParserMessages.instanceStartOmittag(), ps.current_input().token_start_location())
        }
        ps.current_input().unget_token()
    }

    ; the full document drive: prolog (DOCTYPE) -> content events.
    ; The caller installs the prolog/decl recognizers (install_recognizers) and
    ; pushes the document InputSource; parse_document adds the content-mode
    ; recognizers, enters the instance, and runs doContent over the SAME input.
    function parse_document(this: Parser, table: ref[Array[PackedTokenInfo]], base_dir: String) returns bool
    {
        if this.parse_prolog(base_dir) = false
            return false
        ; endProlog (parseDecl.cxx:152): no base DTD -> give up.
        if ps.base_dtd() = null
            return false
        ; maybeStartPass2: with LINK activation the whole document re-parses;
        ; the pass-1 events/messages since setPass2Start were discarded.
        if this.maybe_start_pass2()
        {
            if this.parse_prolog(base_dir) = false
                return false
            if ps.base_dtd() = null
                return false
        }
        ; endProlog (parseDecl.cxx:171): the pass-2 prolog verifies that the
        ; entities consulted through the pass-1 DTD were stable.
        if ps.get_pass2()
            this.check_entity_stability()
        ; SCOPE INSTANCE: the instance parses with the DECLARED syntax; the
        ; content-mode recognizers compile from it.
        let inst ps.get_instance_syntax()
        let cur_syn ps.get_syntax()
        if (inst <> null) and (inst <> cur_syn)
            ps.switch_to_instance_syntax()
        ; startInstance selects the current DTD (endProlog, parseDecl.cxx:174)
        ; BEFORE the content recognizers compile from it (compileInstanceModes
        ; reads the current DTD's shortref maps).
        ps.start_instance(host)
        this.install_content_recognizers(table)
        ; the EndPrologEvent (simple-link attributes + the active complex LPD
        ; that initializes the link process).
        this.queue_end_prolog_event()
        this.do_instance_start()
        this.do_content()
        true
    }

    ; ======================================================================
    ; The SGML-declaration parser (parseSd.cxx) — parseSdParam tokenizer
    ; level. Sections and the parseSgmlDecl driver follow below.

    ; every plain message() in the SD context anchors at the current token's
    ; start (the S27 location convention).
    function sd_loc(this: Parser) returns Location
    {
        let ins ps.current_input()
        ins.token_start_location()
    }

    ; StringMessageArg + NumberMessageArg pair (delimiterLength).
    function report_str_num_at(this: Parser, mt: MessageType, a1: StringC, a2: u64, loc: Location)
    {
        var args Vector[MessageArg](2)
        set *(args.get(0)): MessageArg.Str(a1)
        set *(args.get(1)): MessageArg.Num(a2)
        ps.report_at(mt, args, loc)
    }

    function arg_append_dec(this: Parser, buf: ref[Array[u32]], v: u64)
    {
        var digits u32[24]
        let dp digits as pointer[u32]
        var n: size_t 0
        var x v
        if x = 0
        {
            buf.add(0x30)
            return
        }
        while x > 0
        {
            set *(dp + n): (0x30 + (x % 10)) as u32
            set x: x / 10
            set n: n + 1
        }
        while n > 0
        {
            set n: n - 1
            buf.add(*(dp + n))
        }
    }

    ; CharsetMessageArg (parseSd.cxx:3456): number list, "a" / "a, b" for an
    ; adjacent pair / "a-b" for a longer range; ", " between entries. Rendered
    ; via appendNumber/appendFragment — UNQUOTED.
    function charset_message_arg(this: Parser, cset: ref[ISet]) returns StringC
    {
        let buf Array[u32]^host()
        var first true
        var i: size_t 0
        let n cset.get_count()
        while i < n
        {
            let mn cset.range_min(i)
            let mx cset.range_max(i)
            this.arg_append_sep(buf, &first)
            this.arg_append_dec(buf, mn as u64)
            if mx <> mn
            {
                if mx = (mn + (1 as u32))
                    this.arg_append(buf, StringC(", "))
                else
                    this.arg_append(buf, StringC("-"))
                this.arg_append_dec(buf, mx as u64)
            }
            set i: i + 1
        }
        this.arg_to_string(buf)
    }

    ; AllowedSdParamsMessageArg (parseSd.cxx:3313): fragments unquoted,
    ; appendChars pieces quoted, listSep between entries.
    function sd_allow_arg(this: Parser, allow: AllowedSdParams) returns StringC
    {
        let buf Array[u32]^host()
        var first true
        var i: int 0
        while i < 6
        {
            let t allow.get(i)
            if t = SDP_INVALID
                break
            this.arg_append_sep(buf, &first)
            if t = SDP_EE
                this.arg_append(buf, StringC("entity end"))
            else if t = SDP_MINIMUM_LITERAL
                this.arg_append(buf, StringC("minimum literal"))
            else if t = SDP_MDC
            {
                this.arg_append(buf, StringC("delimiter "))
                this.arg_append_quoted(buf, StringC(">"))
            }
            else if t = SDP_NUMBER
                this.arg_append(buf, StringC("number"))
            else if t = SDP_NAME
                this.arg_append(buf, StringC("name"))
            else if t = SDP_PARAM_LITERAL
                this.arg_append(buf, StringC("parameter literal"))
            else if t = SDP_SYSTEM_IDENTIFIER
                this.arg_append(buf, StringC("system identifier"))
            else if t = SDP_CAPACITY_NAME
                this.arg_append(buf, StringC("name of capacity"))
            else if t = SDP_GENERAL_DELIMITER_NAME
                this.arg_append(buf, StringC("name of general delimiter role"))
            else if t = SDP_REFERENCE_RESERVED_NAME
                this.arg_append(buf, StringC("reference reserved name"))
            else if t = SDP_QUANTITY_NAME
                this.arg_append(buf, StringC("name of quantity"))
            else if t = SDP_MINUS
                this.arg_append_quoted(buf, StringC("..."))
            else
            {
                let sdv ps.get_sd()
                let spell sdv.sd_reserved_name(t - SDP_RESERVED_NAME)
                this.arg_append_quoted(buf, spell)
            }
            set i: i + 1
        }
        this.arg_to_string(buf)
    }

    ; Parser::sdParamInvalidToken (parseSd.cxx:3251).
    function sd_param_invalid_token(this: Parser, token: u32, allow: AllowedSdParams)
    {
        let tok_arg this.token_message_arg(token, sdMode)
        let allow_arg this.sd_allow_arg(allow)
        this.report_raw_raw_at(ParserMessages.sdParamInvalidToken(), tok_arg, allow_arg, this.sd_loc())
    }

    ; Parser::stringToNumber over the current token (u64 accumulation with the
    ; reference's overflow guard).
    function sd_token_number(this: Parser, out_n: ref[u64]) returns bool
    {
        let ins ps.current_input()
        let start ins.current_token_start_index()
        let len ins.current_token_length()
        var n: u64 0
        var i: size_t 0
        while i < len
        {
            let c ins.char_at(start + i)
            let d (c - (0x30 as u32)) as u64
            if n > 0x1999999999999999
                return false
            set n: n * 10
            if n > (0xFFFFFFFFFFFFFFFF - d)
                return false
            set n: n + d
            set i: i + 1
        }
        set out_n: n
        true
    }

    ; Parser::parseSdParam (parseSd.cxx:2882) — the SD tokenizer/dispatcher.
    function parse_sd_param(this: Parser, allow: AllowedSdParams, parm: ref[SdParam]) returns bool
    {
        while true
        {
            let token ps.get_token(sdMode)
            if token = tokenUnrecognized
            {
                if this.report_non_sgml_param()
                {
                    ; reported + consumed; keep scanning.
                }
                else
                {
                    let ins ps.current_input()
                    let ts ins.current_token_string()
                    let allow_arg this.sd_allow_arg(allow)
                    this.report_str_raw_at(ParserMessages.markupDeclarationCharacter(), ts, allow_arg, this.sd_loc())
                    return false
                }
            }
            else if token = tokenEe
            {
                if allow.param(SDP_EE)
                {
                    set parm.kind: SDP_EE
                    ps.pop_input_stack()
                    return true
                }
                let allow_arg this.sd_allow_arg(allow)
                this.report_raw_at(ParserMessages.sdEntityEnd(), allow_arg, this.sd_loc())
                return false
            }
            else if token = tokenS
            {
                ; separator — keep scanning.
            }
            else if token = tokenCom
            {
                if this.parse_comment(sdcomMode, null) = false
                    return false
            }
            else if (token = tokenDso) or (token = tokenGrpo) or (token = tokenMinusGrpo) or (token = tokenPlusGrpo) or (token = tokenRni) or (token = tokenPeroNameStart) or (token = tokenPeroGrpo)
            {
                this.sd_param_invalid_token(token, allow)
                return false
            }
            else if token = tokenMinus
            {
                if allow.param(SDP_MINUS)
                {
                    set parm.kind: SDP_MINUS
                    return true
                }
                this.sd_param_invalid_token(tokenMinus, allow)
                return false
            }
            else if (token = tokenLit) or (token = tokenLita)
            {
                let lita token = tokenLita
                if allow.param(SDP_MINIMUM_LITERAL)
                {
                    var lmode: int mlitMode
                    if lita
                        set lmode: mlitaMode
                    let txt host.allocate(sizeof Text, alignof Text) as pointer[Text]
                    let syn ps.get_syntax()
                    if this.parse_literal(lmode, true, false, syn.reference_quantity(qLITLEN) as size_t, ParserMessages.minimumLiteralLength(), txt) = false
                        return false
                    set parm.kind: SDP_MINIMUM_LITERAL
                    set parm.literal_text: txt
                }
                else if allow.param(SDP_PARAM_LITERAL)
                {
                    if this.parse_sd_param_literal(lita, parm) = false
                        return false
                    set parm.kind: SDP_PARAM_LITERAL
                }
                else if allow.param(SDP_SYSTEM_IDENTIFIER)
                {
                    let txt host.allocate(sizeof Text, alignof Text) as pointer[Text]
                    if this.parse_sd_system_identifier(lita, txt) = false
                        return false
                    set parm.kind: SDP_SYSTEM_IDENTIFIER
                    set parm.literal_text: txt
                }
                else
                {
                    this.sd_param_invalid_token(token, allow)
                    return false
                }
                return true
            }
            else if token = tokenMdc
            {
                if allow.param(SDP_MDC)
                {
                    set parm.kind: SDP_MDC
                    return true
                }
                this.sd_param_invalid_token(tokenMdc, allow)
                return false
            }
            else if token = tokenNameStart
            {
                let syn ps.get_syntax()
                let namelen syn.get_quantity(qNAMELEN) as size_t
                this.extend_name_token(namelen, ParserMessages.nameLength())
                ; NB: `#` here resolves to parse_sd_param's FRAME page (no
                ; _rp in the chain — the s196 local-page fallback), and
                ; StringC.init(chars, n) deep-copies the chars onto the
                ; StringC's OWN page — so the host-allocated buffer inside
                ; current_token_subst does NOT survive into tok; its
                ; payload sits on this frame's page, released on return.
                ; parm outlives this frame, so pin the content onto host.
                ; (The corpus does not reliably provoke the dangle —
                ; page reuse is timing-dependent — but the lifetime
                ; analysis is unambiguous; S30 crashed here: 0x4500000053
                ; = packed 'S','E' u32s read from a reused page.)
                let tok ps.current_token_subst#(syn)
                set parm.token: StringC^host(tok.data_ptr(), tok.get_size())
                let sdv ps.get_sd()
                if allow.param(SDP_CAPACITY_NAME)
                {
                    let ci sdv.lookup_capacity_name(parm.token)
                    if ci >= 0
                    {
                        set parm.kind: SDP_CAPACITY_NAME
                        set parm.idx: ci
                        return true
                    }
                }
                if allow.param(SDP_REFERENCE_RESERVED_NAME)
                {
                    let rr syn.lookup_reserved_name(parm.token)
                    if rr >= 0
                    {
                        set parm.kind: SDP_REFERENCE_RESERVED_NAME
                        set parm.idx: rr
                        return true
                    }
                }
                if allow.param(SDP_GENERAL_DELIMITER_NAME)
                {
                    let di sdv.lookup_general_delimiter_name(parm.token)
                    if di >= 0
                    {
                        set parm.kind: SDP_GENERAL_DELIMITER_NAME
                        set parm.idx: di
                        return true
                    }
                }
                if allow.param(SDP_QUANTITY_NAME)
                {
                    let qi sdv.lookup_quantity_name(parm.token)
                    if qi >= 0
                    {
                        set parm.kind: SDP_QUANTITY_NAME
                        set parm.idx: qi
                        return true
                    }
                }
                var ai: int 0
                while ai < 6
                {
                    let t allow.get(ai)
                    if t = SDP_INVALID
                        break
                    if t >= SDP_RESERVED_NAME
                    {
                        let spell sdv.sd_reserved_name(t - SDP_RESERVED_NAME)
                        if parm.token.equals(spell)
                        {
                            set parm.kind: t
                            return true
                        }
                    }
                    set ai: ai + 1
                }
                if allow.param(SDP_NAME)
                {
                    set parm.kind: SDP_NAME
                    return true
                }
                let allow_arg this.sd_allow_arg(allow)
                this.report_str_raw_at(ParserMessages.sdInvalidNameToken(), parm.token, allow_arg, this.sd_loc())
                return false
            }
            else if token = tokenDigit
            {
                if allow.param(SDP_NUMBER)
                {
                    let syn ps.get_syntax()
                    let nlen syn.get_quantity(qNAMELEN) as size_t
                    this.extend_number(nlen)
                    set parm.kind: SDP_NUMBER
                    var n64: u64 0
                    var num_ok this.sd_token_number(&n64)
                    if num_ok
                    {
                        if n64 > 4294967295
                            set num_ok: false
                    }
                    if num_ok = false
                    {
                        let ins ps.current_input()
                        let ts ins.current_token_string()
                        this.report1_at(ParserMessages.numberTooBig(), ts, this.sd_loc())
                        set parm.n: 4294967295
                    }
                    else
                        set parm.n: n64 as u32
                    ; a name start directly after a number needs a separator
                    ; (parseSd.cxx:3053).
                    let peek ps.get_token(sdMode)
                    if peek = tokenNameStart
                        this.report0_at(ParserMessages.psRequired(), this.sd_loc())
                    let ins2 ps.current_input()
                    ins2.unget_token()
                    return true
                }
                this.sd_param_invalid_token(tokenDigit, allow)
                return false
            }
            else
            {
                ; CANNOT_HAPPEN in the reference; treat as invalid.
                this.sd_param_invalid_token(token, allow)
                return false
            }
        }
        false
    }

    ; Parser::parseSdParamLiteral (parseSd.cxx:3070) — a parameter literal in
    ; the SGML declaration; chars are SYNTAX chars (numeric refs bounded by
    ; syntaxCharMax, not the document charset).
    function parse_sd_param_literal(this: Parser, lita: bool, parm: ref[SdParam]) returns bool
    {
        var lmode: int sdplitMode
        if lita
            set lmode: sdplitaMode
        let syn ps.get_syntax()
        let ref_litlen syn.reference_quantity(qLITLEN) as size_t
        let buf Array[u32]^host()
        var running true
        while running
        {
            let token ps.get_token(lmode)
            if token = tokenEe
            {
                this.report0_at(ParserMessages.literalLevel(), this.sd_loc())
                return false
            }
            else if token = tokenUnrecognized
            {
                if this.report_non_sgml_param()
                {
                    ; non-SGML char reported + consumed (dropped).
                }
                else
                {
                    ; parseSd.cxx:3088: an SGML char that is not significant in
                    ; the reference concrete syntax is an E1 by DEFAULT
                    ; (errorSignificant defaults 1; -wno-significant clears);
                    ; the char joins the literal either way.
                    let opt_sig ps.get_options()
                    if opt_sig.error_significant
                    {
                        let sig_tok ps.current_token^host()
                        this.report1_at(ParserMessages.sdLiteralSignificant(), sig_tok, this.sd_loc())
                    }
                    let ins ps.current_input()
                    let pc ins.current_char()
                    buf.add(pc)
                }
            }
            else if token = tokenCroDigit
            {
                let ins ps.current_input()
                ins.discard_initial()
                let nlen2 syn.get_quantity(qNAMELEN) as size_t
                this.extend_number(nlen2)
                var n64: u64 0
                var valid this.sd_token_number(&n64)
                if valid
                {
                    if n64 > 4294967295
                        set valid: false
                }
                if valid = false
                {
                    let ts ins.current_token_string()
                    this.report1_at(ParserMessages.syntaxCharacterNumber(), ts, this.sd_loc())
                }
                ; consume the reference end (REFC / RE / neither); parseSd.cxx
                ; :3131: not closing with the REFC warns under -wrefc.
                let rt ps.get_token(refMode)
                let opt_rf4 ps.get_options()
                if opt_rf4.warn_refc and (rt <> tokenRefc)
                    this.report0_at(ParserMessages.refc(), ins.token_start_location())
                if valid
                    buf.add(n64 as u32)
            }
            else if token = tokenCroNameStart
            {
                if this.parse_named_char_ref() = false
                    return false
            }
            else if (token = tokenLit) or (token = tokenLita)
                set running: false
            else if (token = tokenPeroNameStart) or (token = tokenPeroGrpo)
            {
                this.report0_at(ParserMessages.sdParameterEntity(), this.sd_loc())
                let ins ps.current_input()
                let start ins.current_token_start_index()
                let len ins.current_token_length()
                var i: size_t 0
                while i < len
                {
                    let c ins.char_at(start + i)
                    buf.add(c)
                    set i: i + 1
                }
            }
            else if token = tokenChar
            {
                let ins ps.current_input()
                let pc ins.current_char()
                if buf.get_length() > ref_litlen
                {
                    let re_char syn.standard_function(fRE)
                    if pc = re_char
                    {
                        this.report_num_at(ParserMessages.parameterLiteralLength(), ref_litlen as u64, this.sd_loc())
                        ; guess that the closing delimiter has been omitted
                        this.report0_at(ParserMessages.literalClosingDelimiter(), this.sd_loc())
                        return false
                    }
                }
                buf.add(pc)
            }
            else
            {
                ; no other token is recognized in the sdplit modes.
                set running: false
            }
        }
        if buf.get_length() > ref_litlen
            this.report_num_at(ParserMessages.parameterLiteralLength(), ref_litlen as u64, this.sd_loc())
        set parm.param_literal: StringC^host(buf.get_buffer(), buf.get_length())
        true
    }

    ; Parser::parseSdSystemIdentifier (parseSd.cxx:3191).
    function parse_sd_system_identifier(this: Parser, lita: bool, txt: ref[Text]) returns bool
    {
        var lmode: int sdslitMode
        if lita
            set lmode: sdslitaMode
        let syn ps.get_syntax()
        let ref_litlen syn.reference_quantity(qLITLEN) as size_t
        let buf Array[u32]^host()
        var running true
        while running
        {
            let token ps.get_token(lmode)
            if token = tokenEe
            {
                this.report0_at(ParserMessages.literalLevel(), this.sd_loc())
                return false
            }
            else if token = tokenUnrecognized
            {
                if this.report_non_sgml_param()
                {
                    ; reported + consumed (dropped).
                }
                else
                {
                    ; parseSd.cxx:3207: same errorSignificant default as the
                    ; parameter-literal arm above.
                    let opt_sig2 ps.get_options()
                    if opt_sig2.error_significant
                    {
                        let sig_tok2 ps.current_token^host()
                        this.report1_at(ParserMessages.sdLiteralSignificant(), sig_tok2, this.sd_loc())
                    }
                    let ins ps.current_input()
                    let pc ins.current_char()
                    buf.add(pc)
                }
            }
            else if (token = tokenLit) or (token = tokenLita)
                set running: false
            else if token = tokenChar
            {
                let ins ps.current_input()
                let pc ins.current_char()
                buf.add(pc)
            }
            else
                set running: false
        }
        if buf.get_length() > ref_litlen
            this.report_num_at(ParserMessages.systemIdentifierLength(), ref_litlen as u64, this.sd_loc())
        let s StringC^host(buf.get_buffer(), buf.get_length())
        set txt: Text(s)
        true
    }

    ; the modes the SGML-declaration parse drives, compiled from the
    ; PROVISIONAL (reference) syntax before the declaration is parsed
    ; (compileSdModes).
    function install_sd_recognizers(this: Parser, table: ref[Array[PackedTokenInfo]])
    {
        let sdv *ps.get_sd()
        let synv *ps.get_syntax()
        var modes int[9]
        let mp modes as pointer[int]
        set *(mp + 0): sdMode
        set *(mp + 1): sdcomMode
        set *(mp + 2): sdplitMode
        set *(mp + 3): sdplitaMode
        set *(mp + 4): sdslitMode
        set *(mp + 5): sdslitaMode
        set *(mp + 6): mlitMode
        set *(mp + 7): mlitaMode
        set *(mp + 8): refMode
        var i: int 0
        while i < 9
        {
            let m *(mp + (i as size_t))
            let r Recognizer.build_recognizer(host, m, sdv, synv, table)
            ps.set_recognizer(m, r)
            set i: i + 1
        }
    }

    ; Parser::scanForSgmlDecl (parseSd.cxx:593) — does the current input open
    ; with `<!SGML` + non-name-char? Consumes the prefix on success (pushing
    ; the last peeked char back); the CALLER ungets the token on failure.
    function scan_for_sgml_decl(this: Parser) returns bool
    {
        let ins ps.current_input()
        ins.start_token_no_multicode()
        var c ins.token_char()
        while (c = 10) or (c = 13) or (c = 32) or (c = 9)
            set c: ins.token_char()
        if c <> 60
            return false
        if ins.token_char() <> 33
            return false
        set c: ins.token_char()
        if (c <> 83) and (c <> 115)
            return false
        set c: ins.token_char()
        if (c <> 71) and (c <> 103)
            return false
        set c: ins.token_char()
        if (c <> 77) and (c <> 109)
            return false
        set c: ins.token_char()
        if (c <> 76) and (c <> 108)
            return false
        set c: ins.token_char()
        if c < 0
            return true
        let tl ins.current_token_length()
        ins.end_token(tl - 1)
        if c = 45
            return false
        if c = 46
            return false
        if (c >= 97) and (c < 123)
            return false
        if (c >= 65) and (c < 91)
            return false
        if (c >= 48) and (c < 58)
            return false
        true
    }

    ; Parser::findMissingMinimum (parseSd.cxx:652): the minimum-data chars a
    ; charset must map — letters, digits and the special minimum-data chars.
    function find_missing_minimum(this: Parser, charset: ref[UnivCharsetDesc], missing: ref[ISet])
    {
        ; goes through univToDescCheck (parseSd.cxx:658): ambiguous mappings of
        ; a minimum data char warn under -wsgmldecl, and a match above charMax
        ; counts as missing.
        var to: u32 0
        var i: u32 0
        while i < 26
        {
            let uc (65 as u32) + i
            if this.univ_to_desc_check(charset, uc, &to) = false
                missing.add(uc)
            let lc (97 as u32) + i
            if this.univ_to_desc_check(charset, lc, &to) = false
                missing.add(lc)
            set i: i + (1 as u32)
        }
        set i: 0
        while i < 10
        {
            let dc (48 as u32) + i
            if this.univ_to_desc_check(charset, dc, &to) = false
                missing.add(dc)
            set i: i + (1 as u32)
        }
        var special u32[11]
        let sp special as pointer[u32]
        set *(sp + 0): 39
        set *(sp + 1): 40
        set *(sp + 2): 41
        set *(sp + 3): 43
        set *(sp + 4): 44
        set *(sp + 5): 45
        set *(sp + 6): 46
        set *(sp + 7): 47
        set *(sp + 8): 58
        set *(sp + 9): 61
        set *(sp + 10): 63
        var j: size_t 0
        while j < 11
        {
            let sc *(sp + j)
            if this.univ_to_desc_check(charset, sc, &to) = false
                missing.add(sc)
            set j: j + 1
        }
    }

    ; Parser::intersectCharSets (parseSd.cxx:1899).
    function intersect_char_sets(this: Parser, s1: ref[ISet], s2: ref[ISet], inter: ref[ISet])
    {
        var i: size_t 0
        let n1 s1.get_count()
        while i < n1
        {
            let a_min s1.range_min(i)
            let a_max s1.range_max(i)
            var j: size_t 0
            let n2 s2.get_count()
            while j < n2
            {
                let b_min s2.range_min(j)
                let b_max s2.range_max(j)
                var lo a_min
                if b_min > lo
                    set lo: b_min
                var hi a_max
                if b_max < hi
                    set hi: b_max
                if lo <= hi
                    inter.add_range(lo, hi)
                set j: j + 1
            }
            set i: i + 1
        }
    }

    ; ---- SD charset translation (parseSd.cxx:2505-2701) -------------------

    ; the internal charset of an Sd as a desc->univ mapping: the document
    ; charset in the default mode, the fixed system charset otherwise.
    function sd_internal_of(this: Parser, sdp: ref[Sd], sys: ref[UnivCharsetDesc]) returns ref[UnivCharsetDesc]
    {
        if sdp.internal_charset_is_doc_charset()
        {
            let d sdp.doc_charset_desc()
            if d <> null
                return d as ref[UnivCharsetDesc]
        }
        sys
    }

    ; univToDescCheck (parseSd.cxx:2844): >1 matches warn ambiguousDocCharacter
    ; under -wsgmldecl; success needs a match at or below charMax.
    function univ_to_desc_check(this: Parser, charset: ref[UnivCharsetDesc], from: u32, out_to: ref[u32]) returns bool
    {
        var c: u32 0
        var cnt: u32 0
        let dset ISet^host()
        let m charset.univ_to_desc(from, &c, &cnt, dset)
        if m > 1
        {
            let opt_a ps.get_options()
            if opt_a.warn_sgml_decl
            {
                let arg_a this.charset_message_arg(dset)
                this.report_raw_at(ParserMessages.ambiguousDocCharacter(), arg_a, this.sd_loc())
            }
        }
        if (m > 0) and (c <= CHAR_MAX)
        {
            set out_to: c
            return true
        }
        false
    }

    function univ_to_desc_check_count(this: Parser, charset: ref[UnivCharsetDesc], from: u32, out_to: ref[u32], out_count: ref[u32]) returns bool
    {
        var c: u32 0
        var cnt: u32 0
        let dset ISet^host()
        let m charset.univ_to_desc(from, &c, &cnt, dset)
        if m > 1
        {
            let opt_a ps.get_options()
            if opt_a.warn_sgml_decl
            {
                let arg_a this.charset_message_arg(dset)
                this.report_raw_at(ParserMessages.ambiguousDocCharacter(), arg_a, this.sd_loc())
            }
        }
        if (m > 0) and (c <= CHAR_MAX)
        {
            set out_to: c
            set out_count: cnt
            return true
        }
        false
    }

    ; the translateSyntaxCharDoc/translateSyntaxCharInternal pair — selected
    ; by the CURRENT parser sd's internal-charset mode (the reference's sd()).
    function report_translate_syntax_char(this: Parser, c: u32)
    {
        let sdp ps.get_sd()
        if sdp.internal_charset_is_doc_charset()
            this.report_num_at(ParserMessages.translateSyntaxCharDoc(), c as u64, this.sd_loc())
        else
            this.report_num_at(ParserMessages.translateSyntaxCharInternal(), c as u64, this.sd_loc())
    }

    ; Parser::translateUniv (parseSd.cxx:2683).
    function translate_univ(this: Parser, univ: u32, switcher: ref[CharSwitcher], syn_charset: ref[UnivCharsetDesc]) returns u32
    {
        var sc: u32 0
        var cnt: u32 0
        let m syn_charset.univ_to_desc(univ, &sc, &cnt, null)
        if m <> 1
        {
            this.report_num_at(ParserMessages.missingSyntaxChar(), univ as u64, this.sd_loc())
            return univ
        }
        let tem switcher.subst(sc)
        if tem <> sc
        {
            var univ2: u32 0
            if syn_charset.desc_to_univ(tem, &univ2)
                return univ2
            this.report_translate_syntax_char(tem)
        }
        univ
    }

    ; Parser::translateSyntaxNoSwitch (parseSd.cxx:2582).
    function translate_syntax_no_switch(this: Parser, b: ref[SdBuilder], syntax_char: u32, out_doc: ref[u32], out_count: ref[u32]) returns bool
    {
        if b.sd.internal_charset_is_doc_charset()
        {
            let r b.syntax_charset_decl.find_range(syntax_char)
            if r <> null
            {
                let doc_chars ISet^host()
                var count r.count - (syntax_char - r.desc_min)
                if r.range_type = CHARSET_RANGE_STRING
                {
                    let ddecl b.sd.doc_charset_decl()
                    ddecl.string_to_char(r.str, doc_chars)
                }
                else if r.range_type = CHARSET_RANGE_NUMBER
                {
                    let n r.base_min + (syntax_char - r.desc_min)
                    var count2: u32 0
                    let sid b.syntax_charset_decl.section_pubid(r.section)
                    let sdg b.syntax_charset_decl.section_desig(r.section)
                    let ddecl b.sd.doc_charset_decl()
                    ddecl.number_to_char(sid, sdg, n, doc_chars, &count2)
                    if doc_chars.is_empty() = false
                    {
                        if count2 < count
                            set count: count2
                    }
                }
                if doc_chars.is_empty() = false
                {
                    ; parseSd.cxx:2616: >1 doc chars warn under -wsgmldecl.
                    if doc_chars.is_singleton() = false
                    {
                        let opt_g ps.get_options()
                        if opt_g.warn_sgml_decl
                        {
                            let arg_g this.charset_message_arg(doc_chars)
                            this.report_raw_at(ParserMessages.ambiguousDocCharacter(), arg_g, this.sd_loc())
                        }
                    }
                    let mn doc_chars.range_min(0)
                    if mn <= CHAR_MAX
                    {
                        set out_doc: mn
                        set out_count: count
                        return true
                    }
                }
            }
        }
        var univ: u32 0
        var also_max: u32 0
        if b.syntax_charset.desc_to_univ_also_max(syntax_char, &univ, &also_max)
        {
            let internal this.sd_internal_of(b.sd, b.sys_desc)
            var doc: u32 0
            var count2: u32 0
            if this.univ_to_desc_check_count(internal, univ, &doc, &count2)
            {
                var count (also_max - syntax_char) + (1 as u32)
                if count2 < count
                    set count: count2
                set out_doc: doc
                set out_count: count
                return true
            }
        }
        set b.valid: false
        this.report_translate_syntax_char(syntax_char)
        false
    }

    ; Parser::translateSyntax(SdBuilder&, WideChar, Char&) (parseSd.cxx:2572).
    function translate_syntax(this: Parser, b: ref[SdBuilder], syntax_char: u32, out_doc: pointer[u32]) returns bool
    {
        var count: u32 0
        let subst b.switcher.subst(syntax_char)
        this.translate_syntax_no_switch(b, subst, out_doc, &count)
    }

    ; Parser::translateSyntax over a syntax string (parseSd.cxx:2646).
    function translate_syntax_string(this: Parser, b: ref[SdBuilder], s: StringC, out_str: ref[StringC]) returns bool
    {
        let buf Array[u32]^host()
        var ret true
        var i: size_t 0
        let n s.get_size()
        while i < n
        {
            var c: u32 0
            let sc s.get(i)
            if this.translate_syntax(b, sc, &c)
                buf.add(c)
            else
                set ret: false
            set i: i + 1
        }
        set out_str: StringC^host(buf.get_buffer(), buf.get_length())
        ret
    }

    ; Parser::translateName (parseSd.cxx:2662) — a name spelled in the
    ; CURRENT internal charset carried into the new syntax.
    function translate_name(this: Parser, b: ref[SdBuilder], name: StringC, out_str: ref[StringC]) returns bool
    {
        let cur_sd ps.get_sd()
        let cur_internal this.sd_internal_of(cur_sd, b.sys_desc)
        let new_internal this.sd_internal_of(b.sd, b.sys_desc)
        let buf Array[u32]^host()
        var i: size_t 0
        let n name.get_size()
        while i < n
        {
            var univ: u32 0
            let nc name.get(i)
            let got cur_internal.desc_to_univ(nc, &univ)
            let univ2 this.translate_univ(univ, b.switcher, b.syntax_charset)
            var c: u32 0
            if this.univ_to_desc_check(new_internal, univ2, &c) = false
            {
                this.report_num_at(ParserMessages.translateDocChar(), univ2 as u64, this.sd_loc())
                set b.valid: false
                set out_str: StringC()
                return false
            }
            buf.add(c)
            set i: i + 1
        }
        set out_str: StringC^host(buf.get_buffer(), buf.get_length())
        true
    }

    ; Parser::translateRange (parseSd.cxx:2523) — switch-aware bulk range
    ; translation.
    function translate_range(this: Parser, b: ref[SdBuilder], start_in: u32, end: u32, chars: ref[ISet])
    {
        var start start_in
        var running true
        while running
        {
            var done_up_to end
            var got_switch false
            var first_switch: u32 0
            var i: size_t 0
            let nsw b.switcher.n_switches()
            while i < nsw
            {
                let c b.switcher.switch_from(i)
                if (start <= c) and (c <= end)
                {
                    if got_switch = false
                    {
                        set got_switch: true
                        set first_switch: c
                    }
                    else if c < first_switch
                        set first_switch: c
                }
                set i: i + 1
            }
            if got_switch and (first_switch = start)
            {
                set done_up_to: start
                var doc_char: u32 0
                if this.translate_syntax(b, start, &doc_char)
                    chars.add(doc_char)
            }
            else
            {
                if got_switch
                    set done_up_to: first_switch - (1 as u32)
                var doc_char: u32 0
                var count: u32 0
                if this.translate_syntax_no_switch(b, start, &doc_char, &count)
                {
                    if (count - (1 as u32)) < (done_up_to - start)
                        set done_up_to: start + (count - (1 as u32))
                    chars.add_range(doc_char, doc_char + (done_up_to - start))
                }
            }
            if done_up_to = end
                set running: false
            else
                set start: done_up_to + (1 as u32)
        }
    }

    ; ---- SD syntax checks (parseSd.cxx:2703-2842) --------------------------

    function check_not_function(this: Parser, syn: ref[Syntax], c: u32) returns bool
    {
        let fset syn.char_set(setFunctionChar)
        if fset.contains(c)
        {
            this.report_num_at(ParserMessages.oneFunction(), c as u64, this.sd_loc())
            return false
        }
        true
    }

    ; checkShortrefDelim: at most one B sequence, not adjacent to blanks.
    function check_shortref_delim(this: Parser, syn: ref[Syntax], delim: StringC) returns bool
    {
        var had_b false
        let bset syn.char_set(setBlank)
        let n delim.get_size()
        var i: size_t 0
        while i < n
        {
            if delim.get(i) = 66
            {
                if had_b
                {
                    this.report1_at(ParserMessages.multipleBSequence(), delim, this.sd_loc())
                    return false
                }
                set had_b: true
                if i > 0
                {
                    let prev delim.get(i - 1)
                    if bset.contains(prev)
                    {
                        this.report1_at(ParserMessages.blankAdjacentBSequence(), delim, this.sd_loc())
                        return false
                    }
                }
                while ((i + 1) < n) and (delim.get(i + 1) = 66)
                    set i: i + 1
                if (i + 1) < n
                {
                    let nxt delim.get(i + 1)
                    if bset.contains(nxt)
                    {
                        this.report1_at(ParserMessages.blankAdjacentBSequence(), delim, this.sd_loc())
                        return false
                    }
                }
            }
            set i: i + 1
        }
        true
    }

    function check_general_delim(this: Parser, syn: ref[Syntax], delim: StringC) returns bool
    {
        let fset syn.char_set(setFunctionChar)
        let n delim.get_size()
        if n > 0
        {
            var all_function true
            var i: size_t 0
            while i < n
            {
                if fset.contains(delim.get(i)) = false
                    set all_function: false
                set i: i + 1
            }
            if all_function
            {
                this.report1_at(ParserMessages.generalDelimAllFunction(), delim, this.sd_loc())
                return false
            }
        }
        true
    }

    ; checkSwitches: neither side of a switch may be a letter or digit.
    function check_switches(this: Parser, switcher: ref[CharSwitcher], syn_charset: ref[UnivCharsetDesc]) returns bool
    {
        var valid true
        var i: size_t 0
        let n switcher.n_switches()
        while i < n
        {
            var j: int 0
            while j < 2
            {
                var c switcher.switch_from(i)
                if j = 1
                    set c: switcher.switch_to(i)
                var univ: u32 0
                if syn_charset.desc_to_univ(c, &univ)
                {
                    var bad false
                    if (univ >= 97) and (univ < 123)
                        set bad: true
                    if (univ >= 65) and (univ < 91)
                        set bad: true
                    if (univ >= 48) and (univ < 58)
                        set bad: true
                    if bad
                    {
                        this.report_num_at(ParserMessages.switchLetterDigit(), univ as u64, this.sd_loc())
                        set valid: false
                    }
                }
                set j: j + 1
            }
            set i: i + 1
        }
        valid
    }

    function check_switches_markup(this: Parser, switcher: ref[CharSwitcher]) returns bool
    {
        var valid true
        var i: size_t 0
        let n switcher.n_switches()
        while i < n
        {
            if switcher.switch_used(i) = false
            {
                let c switcher.switch_from(i)
                this.report_num_at(ParserMessages.switchNotMarkup(), c as u64, this.sd_loc())
                set valid: false
            }
            set i: i + 1
        }
        valid
    }

    ; checkSyntaxNames: every function name must be a valid name in the
    ; declared syntax.
    function check_syntax_names(this: Parser, syn: ref[Syntax])
    {
        var i: size_t 0
        let n syn.n_funcs()
        while i < n
        {
            let fname syn.func_name(i)
            var k: size_t 1
            let fn fname.get_size()
            while k < fn
            {
                if syn.is_name_character(fname.get(k)) = false
                {
                    this.report1_at(ParserMessages.reservedNameSyntax(), fname, this.sd_loc())
                    set k: fn
                }
                else
                    set k: k + 1
            }
            set i: i + 1
        }
    }

    ; checkSyntaxNamelen: delimiters (general + complex shortref) longer than
    ; NAMELEN; over-long reserved names are -wsgmldecl only.
    function check_syntax_namelen(this: Parser, syn: ref[Syntax])
    {
        let namelen syn.get_quantity(qNAMELEN)
        var i: int 0
        while i < N_DELIM_GENERAL
        {
            let dl syn.delim_general_len(i)
            if dl > (namelen as size_t)
            {
                let ds syn.delim_string(i)
                this.report_str_num_at(ParserMessages.delimiterLength(), ds, namelen as u64, this.sd_loc())
            }
            set i: i + 1
        }
        var j: size_t 0
        let nc syn.n_delim_shortref_complex()
        while j < nc
        {
            let sc syn.delim_shortref_complex(j)
            if sc.get_size() > (namelen as size_t)
                this.report_str_num_at(ParserMessages.delimiterLength(), sc, namelen as u64, this.sd_loc())
            set j: j + 1
        }
        ; parseSd.cxx:2836: reserved names longer than NAMELEN warn under
        ; -wsgmldecl.
        let opt_rn ps.get_options()
        if opt_rn.warn_sgml_decl
        {
            var r: int 0
            while r < N_NAMES
            {
                let rn syn.reserved_name(r)
                if rn.get_size() > (namelen as size_t)
                    this.report_str_num_at(ParserMessages.reservedNameLength(), rn, namelen as u64, this.sd_loc())
                set r: r + 1
            }
        }
    }

    ; checkNmchars (parseSd.cxx:1857): declared naming chars must not collide
    ; with letters, digits, RE/RS/SPACE or SEPCHARs.
    function check_nmchars(this: Parser, cset: ref[ISet], syn: ref[Syntax]) returns bool
    {
        var valid true
        let bad ISet^host()
        this.intersect_char_sets(cset, syn.char_set(setNameStart), bad)
        if bad.is_empty() = false
        {
            let arg this.charset_message_arg(bad)
            this.report_raw_at(ParserMessages.nmcharLetter(), arg, this.sd_loc())
            set valid: false
            bad.clear()
        }
        this.intersect_char_sets(cset, syn.char_set(setDigit), bad)
        if bad.is_empty() = false
        {
            let arg2 this.charset_message_arg(bad)
            this.report_raw_at(ParserMessages.nmcharDigit(), arg2, this.sd_loc())
            set valid: false
            bad.clear()
        }
        var fc: u32 0
        if syn.get_standard_function(fRE, &fc)
        {
            if cset.contains(fc)
            {
                this.report_num_at(ParserMessages.nmcharRe(), fc as u64, this.sd_loc())
                set valid: false
            }
        }
        if syn.get_standard_function(fRS, &fc)
        {
            if cset.contains(fc)
            {
                this.report_num_at(ParserMessages.nmcharRs(), fc as u64, this.sd_loc())
                set valid: false
            }
        }
        if syn.get_standard_function(fSPACE, &fc)
        {
            if cset.contains(fc)
            {
                this.report_num_at(ParserMessages.nmcharSpace(), fc as u64, this.sd_loc())
                set valid: false
            }
        }
        this.intersect_char_sets(cset, syn.char_set(setSepchar), bad)
        if bad.is_empty() = false
        {
            let arg3 this.charset_message_arg(bad)
            this.report_raw_at(ParserMessages.nmcharSepchar(), arg3, this.sd_loc())
            set valid: false
        }
        valid
    }

    ; setRefNames (parseSd.cxx:433): enter the reference reserved-name
    ; spellings into empty slots; rDATA/rIMPLICIT are WWW-only (rALL would be
    ; gated by --errorAfdr, which the drop-in does not model).
    function set_ref_names(this: Parser, syn: ref[Syntax], www: bool)
    {
        var i: int 0
        while i < N_SYNTAX_NAMES
        {
            var skip false
            if (i = R_DATA) or (i = R_IMPLICIT)
            {
                if www = false
                    set skip: true
            }
            if skip = false
            {
                let doc_name syn.ref_reserved_name(i)
                let existing syn.lookup_reserved_name(doc_name)
                if existing >= 0
                    this.report1_at(ParserMessages.nameReferenceReservedName(), doc_name, this.sd_loc())
                let cur syn.reserved_name(i)
                if cur.get_size() = 0
                    syn.set_name(i, doc_name)
            }
            set i: i + 1
        }
    }

    ; setRefDelimGeneral (parseSd.cxx:363): fill every UNSPECIFIED slot from
    ; Figure 3 column 3 (the Syntax module's DELIM_LEN/DELIM_CHARS seed),
    ; translated through the switcher; delims whose chars the internal charset
    ; lacks collect into missingSignificant646.
    function set_ref_delim_general(this: Parser, b: ref[SdBuilder], syn: ref[Syntax], syn_charset: ref[UnivCharsetDesc], specified: pointer[u8]) returns bool
    {
        var valid true
        let missing ISet^host()
        let internal this.sd_internal_of(b.sd, b.sys_desc)
        var i: int 0
        while i < N_DELIM_GENERAL
        {
            var is_spec false
            if specified <> null
            {
                if (*(specified + (i as size_t))) <> 0
                    set is_spec: true
            }
            if is_spec = false
            {
                let dp host.allocate(12, 4) as pointer[u32]
                let want *(DELIM_LEN + (i as size_t)) as size_t
                var got: size_t 0
                var j: size_t 0
                while j < want
                {
                    let fig_char *(DELIM_CHARS + ((i as size_t) * MAX_DELIM_LEN + j))
                    let univ this.translate_univ(fig_char, b.switcher, syn_charset)
                    var c: u32 0
                    if this.univ_to_desc_check(internal, univ, &c)
                    {
                        set *(dp + got): c
                        set got: got + 1
                    }
                    else
                    {
                        missing.add(univ)
                        set valid: false
                    }
                    set j: j + 1
                }
                if got = want
                {
                    let ds StringC^host(dp, got)
                    if this.check_general_delim(syn, ds)
                        syn.set_delim_general(i, dp, got)
                    else
                        set valid: false
                }
            }
            set i: i + 1
        }
        if missing.is_empty() = false
        {
            let arg this.charset_message_arg(missing)
            this.report_raw_at(ParserMessages.missingSignificant646(), arg, this.sd_loc())
        }
        valid
    }

    ; addRefDelimShortref (parseSd.cxx:522): the 31 Figure-4 short reference
    ; delimiters ('B' = a blank sequence position).
    function add_ref_delim_shortref(this: Parser, b: ref[SdBuilder], syn: ref[Syntax], syn_charset: ref[UnivCharsetDesc]) returns bool
    {
        let missing ISet^host()
        let internal this.sd_internal_of(b.sd, b.sys_desc)
        var row: int 0
        while row < 32
        {
            let dp host.allocate(12, 4) as pointer[u32]
            let want *(SHORTREF_DELIM_LEN + (row as size_t)) as size_t
            var got: size_t 0
            var j: size_t 0
            while j < want
            {
                let fig_char *(SHORTREF_DELIM_CHARS + ((row as size_t) * 3 + j))
                let univ this.translate_univ(fig_char, b.switcher, syn_charset)
                var c: u32 0
                if this.univ_to_desc_check(internal, univ, &c)
                {
                    set *(dp + got): c
                    set got: got + 1
                }
                else
                    missing.add(univ)
                set j: j + 1
            }
            if got = want
            {
                let ds StringC^host(dp, got)
                var dup false
                let nsw b.switcher.n_switches()
                if nsw > 0
                {
                    if syn.is_valid_shortref(ds)
                        set dup: true
                }
                if dup
                    this.report1_at(ParserMessages.duplicateDelimShortref(), ds, this.sd_loc())
                else
                    syn.add_delim_shortref(ds)
            }
            set row: row + 1
        }
        if missing.is_empty() = false
        {
            let arg this.charset_message_arg(missing)
            this.report_raw_at(ParserMessages.missingSignificant646(), arg, this.sd_loc())
        }
        true
    }

    ; The Figure-4 shortref delimiters for the IMPLIED SGML declaration:
    ; implySgmlDecl (parseSd.cxx:258) applies the refSyntax spec whenever
    ; options().shortref is on (the onsgmls default), so an implied-decl
    ; document CAN declare SHORTREF maps. The implied internal charset is the
    ; identity, so the spec chars install untranslated.
    function add_implied_shortref_delims(this: Parser, syn: ref[Syntax])
    {
        var row: int 0
        while row < 32
        {
            let want *(SHORTREF_DELIM_LEN + (row as size_t)) as size_t
            let dp host.allocate(12, 4) as pointer[u32]
            var j: size_t 0
            while j < want
            {
                set *(dp + j): *(SHORTREF_DELIM_CHARS + ((row as size_t) * 3 + j))
                set j: j + 1
            }
            let ds StringC^host(dp, want)
            syn.add_delim_shortref(ds)
            set row: row + 1
        }
    }

    ; setStandardSyntax (parseSd.cxx:273) over a bare syntax: shunned
    ; controls, standard + TAB functions, '-'/'.' name chars, namecase, the
    ; reference delimiters/names, and (refSyntax only) the Figure-4 shortrefs.
    function set_standard_syntax(this: Parser, b: ref[SdBuilder], syn: ref[Syntax], shortref: bool, www: bool) returns bool
    {
        let id128 UnivCharsetDesc.make_identity128(host)
        var valid true
        if this.check_switches(b.switcher, id128) = false
            set valid: false
        var si: size_t 0
        let nsw b.switcher.n_switches()
        while si < nsw
        {
            let sto b.switcher.switch_to(si)
            if sto >= 128
                this.report_num_at(ParserMessages.switchNotInCharset(), sto as u64, this.sd_loc())
            set si: si + 1
        }
        var shc: u32 0
        while shc < 32
        {
            syn.add_shunchar(shc)
            set shc: shc + (1 as u32)
        }
        syn.add_shunchar(127)
        syn.add_shunchar(255)
        syn.set_shunchar_controls()
        var fi: int 0
        while fi < 3
        {
            var fig: u32 13
            if fi = 1
                set fig: 10
            else if fi = 2
                set fig: 32
            var doc_char: u32 0
            if this.translate_syntax_switcher(b, fig, id128, &doc_char)
            {
                if this.check_not_function(syn, doc_char)
                    syn.set_standard_function(fi, doc_char)
                else
                    set valid: false
            }
            else
                set valid: false
            set fi: fi + 1
        }
        ; added function TAB SEPCHAR 9 (coreFunctions).
        var tab_char: u32 0
        if this.translate_syntax_switcher(b, 9, id128, &tab_char)
        {
            if this.check_not_function(syn, tab_char)
                syn.add_function_char(StringC("TAB"), cSEPCHAR, tab_char)
            else
                set valid: false
        }
        else
            set valid: false
        ; name characters '-' '.'
        let name_char_set ISet^host()
        var nci: int 0
        while nci < 2
        {
            var fig2: u32 45
            if nci = 1
                set fig2: 46
            var doc2: u32 0
            if this.translate_syntax_switcher(b, fig2, id128, &doc2)
                name_char_set.add(doc2)
            else
                set valid: false
            set nci: nci + 1
        }
        if this.check_nmchars(name_char_set, syn) = false
            set valid: false
        else
            this.apply_name_chars(syn, name_char_set)
        syn.set_namecase_general(true)
        syn.set_namecase_entity(false)
        if this.set_ref_delim_general(b, syn, id128, null) = false
            set valid: false
        this.set_ref_names(syn, www)
        syn.enter_standard_function_names()
        if shortref
        {
            if this.add_ref_delim_shortref(b, syn, id128) = false
                set valid: false
        }
        valid
    }

    ; translateSyntax(CharSwitcher&, syntaxCharset, internalCharset, ...)
    ; (parseSd.cxx:2505) — the standard-syntax flavor: switch, map through
    ; the syntax charset to univ, then into the internal charset.
    function translate_syntax_switcher(this: Parser, b: ref[SdBuilder], syntax_char: u32, syn_charset: ref[UnivCharsetDesc], out_doc: pointer[u32]) returns bool
    {
        let sc b.switcher.subst(syntax_char)
        var univ: u32 0
        if syn_charset.desc_to_univ(sc, &univ)
        {
            let internal this.sd_internal_of(b.sd, b.sys_desc)
            if this.univ_to_desc_check(internal, univ, out_doc)
                return true
        }
        this.report_translate_syntax_char(sc)
        false
    }

    ; apply an ISet of name characters to the syntax (nmchar set + category).
    function apply_name_chars(this: Parser, syn: ref[Syntax], cset: ref[ISet])
    {
        let nm syn.char_set(setNmchar)
        var i: size_t 0
        let n cset.get_count()
        while i < n
        {
            let lo cset.range_min(i)
            let hi cset.range_max(i)
            nm.add_range(lo, hi)
            syn.add_name_characters(lo, hi)
            set i: i + 1
        }
    }

    function apply_name_start_chars(this: Parser, syn: ref[Syntax], cset: ref[ISet])
    {
        let ns syn.char_set(setNameStart)
        var i: size_t 0
        let n cset.get_count()
        while i < n
        {
            let lo cset.range_min(i)
            let hi cset.range_max(i)
            ns.add_range(lo, hi)
            syn.add_name_start_characters(lo, hi)
            set i: i + 1
        }
    }

    ; Syntax::checkSgmlChar (Syntax.cxx:343): a shunned char that is not
    ; significant (in either syntax) yet declared an SGML char is invalid.
    function check_sgml_char(this: Parser, syn: ref[Syntax], sdp: ref[Sd], other: ref[Syntax]?, sys: ref[UnivCharsetDesc], invalid: ref[ISet])
    {
        let shun syn.shunchar_set()
        let sig syn.char_set(setSignificant)
        let sgml syn.char_set(setSgmlChar)
        var i: size_t 0
        let n shun.get_count()
        while i < n
        {
            var c shun.range_min(i)
            let mx shun.range_max(i)
            var scanning true
            while scanning
            {
                ; internal != doc translation is skipped: with the identity
                ; system charset a shunned doc char IS the internal char when
                ; it is mapped at all.
                var sig_ok sig.contains(c)
                if (sig_ok = false) and (other <> null)
                {
                    let osig other.char_set(setSignificant)
                    set sig_ok: osig.contains(c)
                }
                if (sig_ok = false) and sgml.contains(c)
                    invalid.add(c)
                if c = mx
                    set scanning: false
                else
                    set c: c + (1 as u32)
            }
            set i: i + 1
        }
        if syn.shunchar_controls()
        {
            var u: u32 0
            while u < 32
            {
                this.check_univ_control_char(u, syn, other, sdp, sys, invalid)
                set u: u + (1 as u32)
            }
            set u: 127
            while u < 160
            {
                this.check_univ_control_char(u, syn, other, sdp, sys, invalid)
                set u: u + (1 as u32)
            }
        }
    }

    function check_univ_control_char(this: Parser, univ: u32, syn: ref[Syntax], other: ref[Syntax]?, sdp: ref[Sd], sys: ref[UnivCharsetDesc], invalid: ref[ISet])
    {
        let charset this.sd_internal_of(sdp, sys)
        var c: u32 0
        if this.univ_to_desc_check(charset, univ, &c) = false
            return
        let sig syn.char_set(setSignificant)
        var sig_ok sig.contains(c)
        if (sig_ok = false) and (other <> null)
        {
            let osig other.char_set(setSignificant)
            set sig_ok: osig.contains(c)
        }
        let sgml syn.char_set(setSgmlChar)
        if (sig_ok = false) and sgml.contains(c)
            invalid.add(c)
    }

    ; ---- SD section parsers (parseSd.cxx:781-2503) --------------------------

    ; widen a byte substring of an ExternalId's public id into a StringC.
    function bytes_to_stringc(this: Parser, s: String, start: size_t, len: size_t) returns StringC
    {
        if len = 0
            return StringC^host(null as pointer[u32], 0)
        let cb host.allocate(len * 4, 4) as pointer[u32]
        var i: size_t 0
        while i < len
        {
            set *(cb + i): s.get(start + i) as u32
            set i: i + 1
        }
        StringC^host(cb, len)
    }

    ; PublicId::init over a minimum literal + the SD formal-error queueing:
    ; a non-FPI id queues its FPI decomposition error; a valid FPI whose text
    ; class differs from the section's required one queues the class message.
    function sd_classify_public(this: Parser, b: ref[SdBuilder], parm: ref[SdParam], tc_required: int, class_kind: int, out_id: ref[ExternalId])
    {
        let pub_sc parm.literal_text.string()
        ; pin the byte copy on host: the classified id is read again LATER
        ; (lookupSyntax, referencePublic) — a frame-transient String buffer
        ; would be reused by then (the ExternalId.make discipline).
        let pb0 this.stringc_to_bytes(pub_sc)
        let pub_bytes String^host(pb0)
        set out_id: ExternalId(true, pub_bytes, false, String())
        out_id.classify_public()
        if out_id.get_public_type() <> PUBLIC_FPI
        {
            let fe out_id.get_fpi_error()
            b.add_formal_error(SDFE_FPI, fe, pub_sc, this.sd_loc())
        }
        else if out_id.get_text_class() <> tc_required
            b.add_formal_error(class_kind, 0, pub_sc, this.sd_loc())
    }

    ; the ISO designating sequence of a CHARSET-class FPI (empty otherwise).
    function sd_designating_sequence(this: Parser, id: ref[ExternalId]) returns StringC
    {
        var ds_start: size_t 0
        var ds_len: size_t 0
        if id.get_owner_type() <> OWNER_ISO
            return StringC^host(null as pointer[u32], 0)
        if id.get_designating_sequence_bytes(&ds_start, &ds_len)
        {
            let pub id.get_public_id()
            return this.bytes_to_stringc(pub, ds_start, ds_len)
        }
        StringC^host(null as pointer[u32], 0)
    }

    ; Parser::referencePublic (parseSd.cxx:1185): resolve the public id
    ; through the entity catalog and push the file as the current input.
    ; given_error = an open failure was already reported.
    function sd_reference_public(this: Parser, id: ref[ExternalId], out_given: ref[bool]) returns bool
    {
        set out_given: false
        let cat ps.get_entity_catalog()
        if cat = null
            return false
        let pub id.get_public_id()
        let sysid cat.lookup_public(pub)
        if sysid.get_length() = 0
            return false
        let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org: Origin()
        let pfsi Array[u8]^host()
        this.append_bytes(pfsi, String("<OSFILE>"))
        this.append_bytes(pfsi, sysid)
        let pfs String^host(pfsi.get_buffer() as pointer[const_char], pfsi.get_length())
        var pfound String()
        let src this.fsi_open(*pfs, org, this.sd_loc(), this.sd_loc(), 0, &pfound)
        if src = null
        {
            set out_given: true
            return false
        }
        ps.push_input(src)
        true
    }

    ; Parser::sdParseSgmlDeclRef (parseSd.cxx:781) — `<!SGML name SYSTEM/PUBLIC ...>`.
    function sd_parse_sgml_decl_ref(this: Parser, b: ref[SdBuilder], parm: ref[SdParam], out_id: ref[ExternalId]) returns bool
    {
        let allow1 AllowedSdParams(SDP_RESERVED_NAME + SDR_SYSTEM, SDP_RESERVED_NAME + SDR_PUBLIC, SDP_MDC)
        if this.parse_sd_param(allow1, parm) = false
            return false
        if parm.kind = SDP_MDC
            return true
        if parm.kind = (SDP_RESERVED_NAME + SDR_PUBLIC)
        {
            let allow2 AllowedSdParams(SDP_MINIMUM_LITERAL)
            if this.parse_sd_param(allow2, parm) = false
                return false
            this.sd_classify_public(b, parm, TC_SD, SDFE_TEXTCLASS_SD, out_id)
        }
        let allow3 AllowedSdParams(SDP_SYSTEM_IDENTIFIER, SDP_MDC)
        if this.parse_sd_param(allow3, parm) = false
            return false
        if parm.kind = SDP_MDC
            return true
        let sb0 this.stringc_to_bytes(parm.literal_text.string())
        let sys_bytes String^host(sb0)
        out_id.set_system(sys_bytes)
        let allow4 AllowedSdParams(SDP_MDC)
        this.parse_sd_param(allow4, parm)
    }

    ; Parser::sdParseDocumentCharset (parseSd.cxx:814).
    function sd_parse_document_charset(this: Parser, b: ref[SdBuilder], parm: ref[SdParam]) returns bool
    {
        let allow1 AllowedSdParams(SDP_RESERVED_NAME + SDR_CHARSET)
        if this.parse_sd_param(allow1, parm) = false
            return false
        let allow2 AllowedSdParams(SDP_RESERVED_NAME + SDR_BASESET)
        if this.parse_sd_param(allow2, parm) = false
            return false
        let decl CharsetDecl^host()
        let desc UnivCharsetDesc^host()
        if this.sd_parse_charset(b, parm, true, decl, desc) = false
            return false
        let missing ISet^host()
        this.find_missing_minimum(desc, missing)
        if missing.is_empty() = false
        {
            let arg this.charset_message_arg(missing)
            this.report_raw_at(ParserMessages.missingMinimumChars(), arg, this.sd_loc())
            return false
        }
        let sgml_char ISet^host()
        decl.used_set(sgml_char)
        ; the declaration's own answer to "is this a non-SGML character?" — it
        ; replaces the built-in reference set for the rest of the parse.
        ps.set_declared_sgml_chars(sgml_char)
        b.sd.set_doc_charset_desc(desc)
        b.sd.set_doc_charset_decl(decl)
        let syn Syntax^host(*(b.sd))
        syn.reset_to_bare(*(b.sd))
        set b.syntax: syn
        let cur_sd ps.get_sd()
        if cur_sd.internal_charset_is_doc_charset()
            syn.set_sgml_char_set(sgml_char)
        else
        {
            ; translateDocSet (parseSd.cxx:849): doc charset -> internal.
            let internal_sgml ISet^host()
            this.translate_doc_set(desc, b.sys_desc, sgml_char, internal_sgml)
            syn.set_sgml_char_set(internal_sgml)
        }
        true
    }

    ; Parser::translateDocSet (parseSd.cxx:849).
    function translate_doc_set(this: Parser, from_charset: ref[UnivCharsetDesc], to_charset: ref[UnivCharsetDesc], from_set: ref[ISet], to_set: ref[ISet])
    {
        var i: size_t 0
        let n from_set.get_count()
        while i < n
        {
            var min from_set.range_min(i)
            let max from_set.range_max(i)
            var scanning true
            while scanning
            {
                var univ: u32 0
                var also_max: u32 0
                if from_charset.desc_to_univ_also_max(min, &univ, &also_max) = false
                {
                    if also_max >= max
                        set scanning: false
                    else
                        set min: also_max + (1 as u32)
                }
                else
                {
                    var internal_char: u32 0
                    var count2: u32 0
                    let n_map this.univ_to_desc_check_count(to_charset, univ, &internal_char, &count2)
                    var upto also_max
                    if upto > max
                        set upto: max
                    if (upto - min) > (count2 - (1 as u32))
                        set upto: min + (count2 - (1 as u32))
                    if n_map
                        to_set.add_range(internal_char, internal_char + (upto - min))
                    if upto >= max
                        set scanning: false
                    else
                        set min: upto + (1 as u32)
                }
            }
            set i: i + 1
        }
    }

    ; Parser::sdParseCharset (parseSd.cxx:882) — BASESET/DESCSET section list.
    function sd_parse_charset(this: Parser, b: ref[SdBuilder], parm: ref[SdParam], is_document: bool, decl: ref[CharsetDecl], desc: ref[UnivCharsetDesc]) returns bool
    {
        let multiply_declared ISet^host()
        var maybe_iso646 true
        var outer true
        while outer
        {
            let allow_lit AllowedSdParams(SDP_MINIMUM_LITERAL)
            if this.parse_sd_param(allow_lit, parm) = false
                return false
            let base_desc UnivCharsetDesc^host()
            let id host.allocate(sizeof ExternalId, alignof ExternalId) as pointer[ExternalId]
            this.sd_classify_public(b, parm, TC_CHARSET, SDFE_TEXTCLASS_BASESET, id)
            let id_sc parm.literal_text.string()
            var found false
            var given_error false
            if this.sd_reference_public(id, &given_error)
            {
                if this.sd_parse_external_charset(b, base_desc) = false
                    return false
                set found: true
            }
            else if given_error = false
            {
                if id.get_owner_type() = OWNER_ISO
                {
                    let desig this.sd_designating_sequence(id)
                    if desig.get_size() > 0
                    {
                        let reg CharsetRegistry.get_registration_number(host, desig)
                        if reg <> CR_UNREGISTERED
                        {
                            var iter CharsetRegistryIter()
                            if CharsetRegistry.make_iter(reg, &iter)
                            {
                                set found: true
                                var mn: u32 0
                                var mx: u32 0
                                var uv: u32 0
                                while iter.next(&mn, &mx, &uv)
                                    base_desc.add_range(mn, (mx - mn) + (1 as u32), uv, false)
                            }
                        }
                    }
                }
                if found = false
                    this.report1_at(ParserMessages.unknownBaseset(), id_sc, this.sd_loc())
            }
            if found = false
                set maybe_iso646: false
            let desig2 this.sd_designating_sequence(id)
            ; pin both onto host — the literal buffer is transient and the
            ; escape checker treats call results as frame-local.
            let id_pin StringC^host(id_sc.data_ptr(), id_sc.get_size())
            let desig_pin StringC^host(desig2.data_ptr(), desig2.get_size())
            decl.add_section(id_pin, desig_pin)
            let allow_descset AllowedSdParams(SDP_RESERVED_NAME + SDR_DESCSET)
            if this.parse_sd_param(allow_descset, parm) = false
                return false
            let allow_num AllowedSdParams(SDP_NUMBER)
            if this.parse_sd_param(allow_num, parm) = false
                return false
            var inner true
            while inner
            {
                let min parm.n
                if this.parse_sd_param(allow_num, parm) = false
                    return false
                let count parm.n
                var adj_count count
                let opt_z ps.get_options()
                if opt_z.warn_sgml_decl and (count = 0)
                    this.report0_at(ParserMessages.zeroNumberOfCharacters(), this.sd_loc())
                decl.range_declared(min, count, multiply_declared)
                if is_document and (count > 0)
                {
                    var over false
                    if min > CHAR_MAX
                        set over: true
                    else if (count - (1 as u32)) > (CHAR_MAX - min)
                        set over: true
                    if over
                    {
                        this.report_num_at(ParserMessages.documentCharMax(), CHAR_MAX as u64, this.sd_loc())
                        if min > CHAR_MAX
                            set adj_count: 0
                        else
                            set adj_count: (CHAR_MAX - min) + (1 as u32)
                        set maybe_iso646: false
                    }
                }
                let allow_val AllowedSdParams(SDP_NUMBER, SDP_MINIMUM_LITERAL, SDP_RESERVED_NAME + SDR_UNUSED)
                if this.parse_sd_param(allow_val, parm) = false
                    return false
                if parm.kind = SDP_NUMBER
                {
                    decl.add_range_number(min, count, parm.n)
                    if found and (adj_count > 0)
                    {
                        let base_missing ISet^host()
                        desc.add_base_desc_range(base_desc, min, adj_count, parm.n, base_missing)
                        if base_missing.is_empty() = false
                        {
                            let opt_b ps.get_options()
                            if opt_b.warn_sgml_decl
                            {
                                let arg_bm this.charset_message_arg(base_missing)
                                this.report_raw_at(ParserMessages.basesetCharsMissing(), arg_bm, this.sd_loc())
                            }
                        }
                    }
                }
                else if parm.kind = (SDP_RESERVED_NAME + SDR_UNUSED)
                    decl.add_range_unused(min, count)
                else
                {
                    let name_sc parm.literal_text.string()
                    let c b.sd.name_to_univ(name_sc)
                    var adj2 adj_count
                    if adj2 > 256
                    {
                        this.report0_at(ParserMessages.tooManyCharsMinimumLiteral(), this.sd_loc())
                        set adj2: 256
                    }
                    if adj2 > 0
                        desc.add_range(min, adj2, c, true)
                    set maybe_iso646: false
                    let name_pin StringC^host(name_sc.data_ptr(), name_sc.get_size())
                    decl.add_range_string(min, count, name_pin)
                }
                var follow SDP_RESERVED_NAME + SDR_CAPACITY
                if is_document = false
                    set follow: SDP_RESERVED_NAME + SDR_FUNCTION
                let allow_next AllowedSdParams(SDP_NUMBER, SDP_RESERVED_NAME + SDR_BASESET, follow)
                if this.parse_sd_param(allow_next, parm) = false
                    return false
                if parm.kind <> SDP_NUMBER
                    set inner: false
            }
            if parm.kind <> (SDP_RESERVED_NAME + SDR_BASESET)
                set outer: false
        }
        if multiply_declared.is_empty() = false
        {
            let arg this.charset_message_arg(multiply_declared)
            this.report_raw_at(ParserMessages.duplicateCharNumbers(), arg, this.sd_loc())
        }
        let declared decl.declared_set()
        let holes ISet^host()
        var hi: size_t 0
        let hn declared.get_count()
        while hi < hn
        {
            if hi > 0
            {
                let prev_max declared.range_max(hi - 1)
                let cur_min declared.range_min(hi)
                if (cur_min - prev_max) > 1
                    holes.add_range(prev_max + (1 as u32), cur_min - (1 as u32))
            }
            set hi: hi + 1
        }
        if holes.is_empty() = false
        {
            let harg this.charset_message_arg(holes)
            this.report_raw_at(ParserMessages.codeSetHoles(), harg, this.sd_loc())
        }
        if (is_document = false) and b.sd.scope_instance()
        {
            ; SCOPE INSTANCE requires the syntax reference charset to be
            ; ISO 646 (parseSd.cxx:1031) — an ordered identity walk to 128.
            var next_min: u32 0
            var ri: size_t 0
            let rn desc.range_count()
            while maybe_iso646 and (ri <= rn)
            {
                if ri = rn
                {
                    if next_min <> 128
                        set maybe_iso646: false
                    set ri: ri + 1
                }
                else
                {
                    var dmin: u32 0
                    var dcount: u32 0
                    var duniv: u32 0
                    desc.range_at2(ri, &dmin, &dcount, &duniv)
                    if (dmin <> next_min) or (duniv <> dmin)
                        set maybe_iso646: false
                    set next_min: dmin + dcount
                    set ri: ri + 1
                }
            }
            if maybe_iso646 = false
                this.report0_at(ParserMessages.scopeInstanceSyntaxCharset(), this.sd_loc())
        }
        true
    }

    ; Parser::sdParseExternalCharset (parseSd.cxx:1054) — rows from a catalog-
    ; resolved external charset entity.
    function sd_parse_external_charset(this: Parser, b: ref[SdBuilder], desc: ref[UnivCharsetDesc]) returns bool
    {
        let parm2 host.allocate(sizeof SdParam, alignof SdParam) as pointer[SdParam]
        set *parm2: SdParam()
        var running true
        while running
        {
            let allow1 AllowedSdParams(SDP_NUMBER, SDP_EE)
            if this.parse_sd_param(allow1, parm2) = false
            {
                ps.pop_input_stack()
                return false
            }
            if parm2.kind = SDP_EE
                return true
            let min parm2.n
            let allow_num AllowedSdParams(SDP_NUMBER)
            if this.parse_sd_param(allow_num, parm2) = false
            {
                ps.pop_input_stack()
                return false
            }
            var count parm2.n
            let allow_val AllowedSdParams(SDP_NUMBER, SDP_MINIMUM_LITERAL, SDP_RESERVED_NAME + SDR_UNUSED)
            if this.parse_sd_param(allow_val, parm2) = false
            {
                ps.pop_input_stack()
                return false
            }
            if parm2.kind = SDP_NUMBER
            {
                if count > 0
                    desc.add_range(min, count, parm2.n, false)
            }
            else if parm2.kind = SDP_MINIMUM_LITERAL
            {
                let name_sc parm2.literal_text.string()
                let c b.sd.name_to_univ(name_sc)
                if count > 256
                {
                    this.report0_at(ParserMessages.tooManyCharsMinimumLiteral(), this.sd_loc())
                    set count: 256
                }
                if count > 0
                    desc.add_range(min, count, c, true)
            }
        }
        true
    }

    ; Parser::sdParseCapacity (parseSd.cxx:1099).
    ; NB there is NO runtime capacity enforcement to port: the reference reads
    ; Sd::capacity() only in the TOTALCAP check below — OpenSP 1.5.2 never
    ; counts capacity points during parsing (SGMLApplication's ErrorEvent
    ; capacity type is produced by nothing). Verified against real onsgmls:
    ; a document vastly exceeding consistent tiny capacities parses silently
    ; (corpus synth-sd-capacity-*).
    function sd_parse_capacity(this: Parser, b: ref[SdBuilder], parm: ref[SdParam]) returns bool
    {
        if b.www
        {
            let allow_www AllowedSdParams(SDP_RESERVED_NAME + SDR_NONE, SDP_RESERVED_NAME + SDR_PUBLIC, SDP_RESERVED_NAME + SDR_SGMLREF)
            if this.parse_sd_param(allow_www, parm) = false
                return false
        }
        else
        {
            let allow_std AllowedSdParams(SDP_RESERVED_NAME + SDR_PUBLIC, SDP_RESERVED_NAME + SDR_SGMLREF)
            if this.parse_sd_param(allow_std, parm) = false
                return false
        }
        var pushed false
        if parm.kind = (SDP_RESERVED_NAME + SDR_NONE)
        {
            let allow_scope AllowedSdParams(SDP_RESERVED_NAME + SDR_SCOPE)
            return this.parse_sd_param(allow_scope, parm)
        }
        if parm.kind = (SDP_RESERVED_NAME + SDR_PUBLIC)
        {
            let allow_lit AllowedSdParams(SDP_MINIMUM_LITERAL)
            if this.parse_sd_param(allow_lit, parm) = false
                return false
            let id host.allocate(sizeof ExternalId, alignof ExternalId) as pointer[ExternalId]
            this.sd_classify_public(b, parm, TC_CAPACITY, SDFE_TEXTCLASS_CAPACITY, id)
            let id_sc parm.literal_text.string()
            var is_ref false
            if id_sc.equals(StringC("ISO 8879-1986//CAPACITY Reference//EN"))
                set is_ref: true
            if id_sc.equals(StringC("ISO 8879:1986//CAPACITY Reference//EN"))
                set is_ref: true
            if is_ref = false
            {
                var given_error false
                if this.sd_reference_public(id, &given_error)
                    set pushed: true
                else if given_error = false
                    this.report1_at(ParserMessages.unknownCapacitySet(), id_sc, this.sd_loc())
            }
            if pushed = false
            {
                let allow_scope2 AllowedSdParams(SDP_RESERVED_NAME + SDR_SCOPE)
                return this.parse_sd_param(allow_scope2, parm)
            }
        }
        let specified host.allocate(N_CAPACITY as size_t, 1) as pointer[u8]
        var ci: int 0
        while ci < N_CAPACITY
        {
            set *(specified + (ci as size_t)): 0
            set ci: ci + 1
        }
        var final SDP_RESERVED_NAME + SDR_SCOPE
        if pushed
            set final: SDP_EE
        if b.www
        {
            let allow_first AllowedSdParams(SDP_CAPACITY_NAME, final)
            if this.parse_sd_param(allow_first, parm) = false
                return false
        }
        else
        {
            let allow_first2 AllowedSdParams(SDP_CAPACITY_NAME)
            if this.parse_sd_param(allow_first2, parm) = false
                return false
        }
        while parm.kind = SDP_CAPACITY_NAME
        {
            let cap_idx parm.idx
            let allow_num AllowedSdParams(SDP_NUMBER)
            if this.parse_sd_param(allow_num, parm) = false
                return false
            if (*(specified + (cap_idx as size_t))) = 0
            {
                b.sd.set_capacity(cap_idx, parm.n)
                set *(specified + (cap_idx as size_t)): 1
            }
            else
            {
                ; parseSd.cxx:1168 renders capacityName(i) with i left at
                ; nCapacity by the earlier init loop — an OOB read that in the
                ; reference binary deterministically lands on quantityName_[0]
                ; = "ATTCNT" (probed against real onsgmls 1.5.2, no crash,
                ; every duplicate reports "ATTCNT"). Bug-for-bug fidelity.
                let opt_dc ps.get_options()
                if opt_dc.warn_sgml_decl
                    this.report1_at(ParserMessages.duplicateCapacity(), StringC("ATTCNT"), this.sd_loc())
            }
            let allow_more AllowedSdParams(SDP_CAPACITY_NAME, final)
            if this.parse_sd_param(allow_more, parm) = false
                return false
        }
        let sdv b.sd
        let totalcap sdv.capacity(0)
        var k: int 1
        while k < N_CAPACITY
        {
            let cv sdv.capacity(k)
            if cv > totalcap
            {
                let cn sdv.capacity_name(k)
                this.report1_at(ParserMessages.capacityExceedsTotalcap(), cn, this.sd_loc())
            }
            set k: k + 1
        }
        if pushed
        {
            let allow_scope3 AllowedSdParams(SDP_RESERVED_NAME + SDR_SCOPE)
            return this.parse_sd_param(allow_scope3, parm)
        }
        true
    }

    ; Parser::sdParseScope (parseSd.cxx:1221).
    function sd_parse_scope(this: Parser, b: ref[SdBuilder], parm: ref[SdParam]) returns bool
    {
        let allow AllowedSdParams(SDP_RESERVED_NAME + SDR_INSTANCE, SDP_RESERVED_NAME + SDR_DOCUMENT)
        if this.parse_sd_param(allow, parm) = false
            return false
        if parm.kind = (SDP_RESERVED_NAME + SDR_INSTANCE)
            b.sd.set_scope_instance()
        true
    }

    ; Parser::lookupSyntax (parseSd.cxx:1348) — the two standard public
    ; syntaxes; out_shortref selects refSyntax vs coreSyntax.
    function sd_lookup_syntax(this: Parser, id: ref[ExternalId], out_shortref: ref[bool]) returns bool
    {
        if id.get_public_type() <> PUBLIC_FPI
            return false
        if id.get_owner_type() <> OWNER_ISO
            return false
        var o_start: size_t 0
        var o_len: size_t 0
        if id.get_owner_bytes(&o_start, &o_len) = false
            return false
        let pub id.get_public_id()
        let owner this.bytes_to_stringc(pub, o_start, o_len)
        var owner_ok false
        if owner.equals(StringC("ISO 8879:1986"))
            set owner_ok: true
        if owner.equals(StringC("ISO 8879-1986"))
            set owner_ok: true
        if owner_ok = false
            return false
        if id.get_text_class() <> TC_SYNTAX
            return false
        var d_start: size_t 0
        var d_len: size_t 0
        if id.get_description_bytes(&d_start, &d_len) = false
            return false
        let descr this.bytes_to_stringc(pub, d_start, d_len)
        if descr.equals(StringC("Reference"))
        {
            set out_shortref: true
            return true
        }
        if descr.equals(StringC("Core"))
        {
            set out_shortref: false
            return true
        }
        false
    }

    ; Parser::sdParseSyntax (parseSd.cxx:1232).
    function sd_parse_syntax(this: Parser, b: ref[SdBuilder], parm: ref[SdParam]) returns bool
    {
        let allow1 AllowedSdParams(SDP_RESERVED_NAME + SDR_SYNTAX)
        if this.parse_sd_param(allow1, parm) = false
            return false
        let allow2 AllowedSdParams(SDP_RESERVED_NAME + SDR_SHUNCHAR, SDP_RESERVED_NAME + SDR_PUBLIC)
        if this.parse_sd_param(allow2, parm) = false
            return false
        if parm.kind = (SDP_RESERVED_NAME + SDR_PUBLIC)
        {
            let allow_lit AllowedSdParams(SDP_MINIMUM_LITERAL)
            if this.parse_sd_param(allow_lit, parm) = false
                return false
            let id host.allocate(sizeof ExternalId, alignof ExternalId) as pointer[ExternalId]
            this.sd_classify_public(b, parm, TC_SYNTAX, SDFE_TEXTCLASS_SYNTAX, id)
            let id_sc parm.literal_text.string()
            let allow3 AllowedSdParams(SDP_RESERVED_NAME + SDR_FEATURES, SDP_RESERVED_NAME + SDR_SWITCHES)
            if this.parse_sd_param(allow3, parm) = false
                return false
            if parm.kind = (SDP_RESERVED_NAME + SDR_SWITCHES)
            {
                let allow_num AllowedSdParams(SDP_NUMBER)
                if this.parse_sd_param(allow_num, parm) = false
                    return false
                var switching true
                while switching
                {
                    let c parm.n
                    if this.parse_sd_param(allow_num, parm) = false
                        return false
                    b.switcher.add_switch(c, parm.n)
                    let allow_more AllowedSdParams(SDP_NUMBER, SDP_RESERVED_NAME + SDR_FEATURES)
                    if this.parse_sd_param(allow_more, parm) = false
                        return false
                    if parm.kind <> SDP_NUMBER
                        set switching: false
                }
            }
            var spec_shortref false
            if this.sd_lookup_syntax(id, &spec_shortref)
            {
                if this.set_standard_syntax(b, b.syntax, spec_shortref, b.www) = false
                    set b.valid: false
            }
            else
            {
                var given_error false
                if this.sd_reference_public(id, &given_error)
                {
                    set b.external_syntax: true
                    let parm2 host.allocate(sizeof SdParam, alignof SdParam) as pointer[SdParam]
                    set *parm2: SdParam()
                    let allow_shun AllowedSdParams(SDP_RESERVED_NAME + SDR_SHUNCHAR)
                    if this.parse_sd_param(allow_shun, parm2) = false
                        return false
                    if this.sd_parse_explicit_syntax(b, parm2) = false
                        return false
                }
                else
                {
                    if given_error = false
                        this.report1_at(ParserMessages.unknownPublicSyntax(), id_sc, this.sd_loc())
                    set b.valid: false
                }
            }
        }
        else
        {
            if this.sd_parse_explicit_syntax(b, parm) = false
                return false
        }
        if b.sd.scope_instance() = false
        {
            let invalid ISet^host()
            this.check_sgml_char(b.syntax, b.sd, null, b.sys_desc, invalid)
            if invalid.is_empty() = false
            {
                let arg this.charset_message_arg(invalid)
                this.report_raw_at(ParserMessages.invalidSgmlChar(), arg, this.sd_loc())
            }
        }
        this.check_syntax_names(b.syntax)
        this.check_syntax_namelen(b.syntax)
        this.check_switches_markup(b.switcher)
        true
    }

    ; Parser::sdParseExplicitSyntax (parseSd.cxx:1329).
    function sd_parse_explicit_syntax(this: Parser, b: ref[SdBuilder], parm: ref[SdParam]) returns bool
    {
        if this.sd_parse_shunchar(b, parm) = false
            return false
        if this.sd_parse_syntax_charset(b, parm) = false
            return false
        if this.sd_parse_function(b, parm) = false
            return false
        if this.sd_parse_naming(b, parm) = false
            return false
        if this.sd_parse_delim(b, parm) = false
            return false
        if this.sd_parse_names(b, parm) = false
            return false
        if this.sd_parse_quantity(b, parm) = false
            return false
        true
    }

    ; Parser::sdParseSyntaxCharset (parseSd.cxx:1371).
    function sd_parse_syntax_charset(this: Parser, b: ref[SdBuilder], parm: ref[SdParam]) returns bool
    {
        if this.sd_parse_charset(b, parm, false, b.syntax_charset_decl, b.syntax_charset) = false
            return false
        this.check_switches(b.switcher, b.syntax_charset)
        var i: size_t 0
        let n b.switcher.n_switches()
        while i < n
        {
            let sto b.switcher.switch_to(i)
            if b.syntax_charset_decl.char_declared(sto) = false
                this.report_num_at(ParserMessages.switchNotInCharset(), sto as u64, this.sd_loc())
            set i: i + 1
        }
        let missing ISet^host()
        this.find_missing_minimum(b.syntax_charset, missing)
        if missing.is_empty() = false
        {
            let arg this.charset_message_arg(missing)
            this.report_raw_at(ParserMessages.missingMinimumChars(), arg, this.sd_loc())
        }
        true
    }

    ; Parser::sdParseShunchar (parseSd.cxx:1390).
    function sd_parse_shunchar(this: Parser, b: ref[SdBuilder], parm: ref[SdParam]) returns bool
    {
        let allow1 AllowedSdParams(SDP_RESERVED_NAME + SDR_NONE, SDP_RESERVED_NAME + SDR_CONTROLS, SDP_NUMBER)
        if this.parse_sd_param(allow1, parm) = false
            return false
        if parm.kind = (SDP_RESERVED_NAME + SDR_NONE)
        {
            let allow_bs AllowedSdParams(SDP_RESERVED_NAME + SDR_BASESET)
            return this.parse_sd_param(allow_bs, parm)
        }
        if parm.kind = (SDP_RESERVED_NAME + SDR_CONTROLS)
            b.syntax.set_shunchar_controls()
        else
        {
            if parm.n <= CHAR_MAX
                b.syntax.add_shunchar(parm.n)
        }
        var running true
        while running
        {
            let allow_more AllowedSdParams(SDP_RESERVED_NAME + SDR_BASESET, SDP_NUMBER)
            if this.parse_sd_param(allow_more, parm) = false
                return false
            if parm.kind <> SDP_NUMBER
                set running: false
            else
            {
                if parm.n <= CHAR_MAX
                    b.syntax.add_shunchar(parm.n)
            }
        }
        true
    }

    ; Parser::sdParseFunction (parseSd.cxx:1420).
    function sd_parse_function(this: Parser, b: ref[SdBuilder], parm: ref[SdParam]) returns bool
    {
        var fi: int 0
        while fi < 3
        {
            var std_name SDR_RE
            if fi = 1
                set std_name: SDR_RS
            else if fi = 2
                set std_name: SDR_SPACE
            let allow_std AllowedSdParams(SDP_RESERVED_NAME + std_name)
            if this.parse_sd_param(allow_std, parm) = false
                return false
            let allow_num AllowedSdParams(SDP_NUMBER)
            if this.parse_sd_param(allow_num, parm) = false
                return false
            var c: u32 0
            if this.translate_syntax(b, parm.n, &c)
            {
                if this.check_not_function(b.syntax, c)
                    b.syntax.set_standard_function(fi, c)
                else
                    set b.valid: false
            }
            set fi: fi + 1
        }
        var have_msichar false
        var have_msochar false
        var running true
        while running
        {
            if b.external_syntax
            {
                let allow_name AllowedSdParams(SDP_NAME, SDP_PARAM_LITERAL)
                if this.parse_sd_param(allow_name, parm) = false
                    return false
            }
            else
            {
                let allow_name2 AllowedSdParams(SDP_NAME)
                if this.parse_sd_param(allow_name2, parm) = false
                    return false
            }
            var name_was_literal false
            var invalid_name false
            var name StringC()
            if parm.kind = SDP_PARAM_LITERAL
            {
                set name_was_literal: true
                if this.translate_syntax_string(b, parm.param_literal, &name) = false
                    set invalid_name: true
            }
            else
            {
                ; NB a plain struct assignment from the pointer field
                ; mis-copied here (size garbage) — copy via the accessors.
                let tdp parm.token.data_ptr()
                let tdn parm.token.get_size()
                set name: StringC^host(tdp, tdn)
            }
            if name_was_literal
            {
                let allow_cls AllowedSdParams(SDP_RESERVED_NAME + SDR_FUNCHAR, SDP_RESERVED_NAME + SDR_MSICHAR, SDP_RESERVED_NAME + SDR_MSOCHAR, SDP_RESERVED_NAME + SDR_MSSCHAR, SDP_RESERVED_NAME + SDR_SEPCHAR)
                if this.parse_sd_param(allow_cls, parm) = false
                    return false
            }
            else
            {
                let allow_cls2 AllowedSdParams(SDP_RESERVED_NAME + SDR_FUNCHAR, SDP_RESERVED_NAME + SDR_MSICHAR, SDP_RESERVED_NAME + SDR_MSOCHAR, SDP_RESERVED_NAME + SDR_MSSCHAR, SDP_RESERVED_NAME + SDR_SEPCHAR, SDP_RESERVED_NAME + SDR_LCNMSTRT)
                if this.parse_sd_param(allow_cls2, parm) = false
                    return false
            }
            if parm.kind = (SDP_RESERVED_NAME + SDR_LCNMSTRT)
            {
                let sdv ps.get_sd()
                let naming_spell sdv.sd_reserved_name(SDR_NAMING)
                if name.equals(naming_spell) = false
                    this.report1_at(ParserMessages.namingBeforeLcnmstrt(), name, this.sd_loc())
                set running: false
            }
            else
            {
                if name_was_literal = false
                {
                    var trans StringC()
                    if this.translate_name(b, name, &trans) = false
                        set invalid_name: true
                    else
                        set name: trans
                }
                var fcls cFUNCHAR
                if parm.kind = (SDP_RESERVED_NAME + SDR_MSICHAR)
                {
                    set have_msichar: true
                    set fcls: cMSICHAR
                }
                else if parm.kind = (SDP_RESERVED_NAME + SDR_MSOCHAR)
                {
                    set have_msochar: true
                    set fcls: cMSOCHAR
                }
                else if parm.kind = (SDP_RESERVED_NAME + SDR_MSSCHAR)
                    set fcls: cMSSCHAR
                else if parm.kind = (SDP_RESERVED_NAME + SDR_SEPCHAR)
                    set fcls: cSEPCHAR
                let allow_num2 AllowedSdParams(SDP_NUMBER)
                if this.parse_sd_param(allow_num2, parm) = false
                    return false
                var c2: u32 0
                var ok this.translate_syntax(b, parm.n, &c2)
                if ok
                    set ok: this.check_not_function(b.syntax, c2)
                if ok and (invalid_name = false)
                {
                    var tem: u32 0
                    if b.syntax.lookup_declared_function_char(name, &tem)
                        this.report1_at(ParserMessages.duplicateFunctionName(), name, this.sd_loc())
                    else
                        b.syntax.add_function_char(name, fcls, c2)
                }
            }
        }
        if have_msochar and (have_msichar = false)
            this.report0_at(ParserMessages.msocharRequiresMsichar(), this.sd_loc())
        true
    }

    ; Parser::sdParamConvertToLiteral (parseSd.cxx:3259).
    function sd_param_convert_to_literal(this: Parser, parm: ref[SdParam])
    {
        if parm.kind = SDP_NUMBER
        {
            set parm.kind: SDP_PARAM_LITERAL
            let cb host.allocate(4, 4) as pointer[u32]
            set *cb: parm.n
            set parm.param_literal: StringC^host(cb, 1)
        }
    }

    ; Parser::requireWWW (parseSd.cxx:3268).
    function sd_require_www(this: Parser, b: ref[SdBuilder])
    {
        if b.www = false
        {
            this.report0_at(ParserMessages.wwwRequired(), this.sd_loc())
            set b.www: true
        }
    }

    ; Parser::sdParseNaming (parseSd.cxx:1531) — LCNMSTRT/UCNMSTRT (+WWW
    ; NAMESTRT) then LCNMCHAR/UCNMCHAR (+NAMECHAR), with the LC/UC pairing and
    ; range machinery, terminated by NAMECASE GENERAL/ENTITY.
    function sd_parse_naming(this: Parser, b: ref[SdBuilder], parm: ref[SdParam]) returns bool
    {
        let name_start_char ISet^host()
        let name_char ISet^host()
        var is_namechar: int 0
        var iterating true
        while iterating
        {
            ; keys[isNamechar*3 + k]: 0 -> UCNMSTRT/UCNMCHAR, 1 -> NAMESTRT/
            ; NAMECHAR, 2 -> LCNMCHAR/NAMECASE.
            var key0 SDR_UCNMSTRT
            var key1 SDR_NAMESTRT
            var key2 SDR_LCNMCHAR
            if is_namechar = 1
            {
                set key0: SDR_UCNMCHAR
                set key1: SDR_NAMECHAR
                set key2: SDR_NAMECASE
            }
            let lc Array[u32]^host()
            let range_index Array[u32]^host()
            ; --- LC side ---
            var prev_param: int 0
            var lc_running true
            while lc_running
            {
                if prev_param = 0
                {
                    let allow_a AllowedSdParams(SDP_PARAM_LITERAL, SDP_NUMBER)
                    if this.parse_sd_param(allow_a, parm) = false
                        return false
                }
                else if prev_param = 1
                {
                    let allow_b AllowedSdParams(SDP_RESERVED_NAME + key0, SDP_PARAM_LITERAL, SDP_NUMBER, SDP_MINUS)
                    if this.parse_sd_param(allow_b, parm) = false
                        return false
                }
                else
                {
                    let allow_c AllowedSdParams(SDP_RESERVED_NAME + key0, SDP_PARAM_LITERAL, SDP_NUMBER)
                    if this.parse_sd_param(allow_c, parm) = false
                        return false
                }
                ; numbers (and non-leading literals) are ENR extensions.
                var enr_hit false
                if parm.kind = SDP_NUMBER
                    set enr_hit: true
                else if (parm.kind = SDP_PARAM_LITERAL) and (prev_param <> 0)
                    set enr_hit: true
                if enr_hit and (b.external_syntax = false) and (b.enr = false)
                {
                    this.report0_at(ParserMessages.enrRequired(), this.sd_loc())
                    set b.enr: true
                }
                if parm.kind = SDP_NUMBER
                    set prev_param: 1
                else
                    set prev_param: 2
                if parm.kind = SDP_MINUS
                {
                    let allow_num AllowedSdParams(SDP_NUMBER)
                    if this.parse_sd_param(allow_num, parm) = false
                        return false
                    let lc_len lc.get_length()
                    let last lc[lc_len - 1]
                    if parm.n < last
                        this.report0_at(ParserMessages.sdInvalidRange(), this.sd_loc())
                    else
                    {
                        if parm.n > (last + (1 as u32))
                            range_index.add((lc_len - 1) as u32)
                        lc.add(parm.n)
                    }
                }
                else
                {
                    this.sd_param_convert_to_literal(parm)
                    if parm.kind <> SDP_PARAM_LITERAL
                        set lc_running: false
                    else
                    {
                        var pi: size_t 0
                        let pn parm.param_literal.get_size()
                        while pi < pn
                        {
                            lc.add(parm.param_literal.get(pi))
                            set pi: pi + 1
                        }
                    }
                }
            }
            ; --- UC side ---
            var lc_pos: size_t 0
            var range_index_pos: size_t 0
            var range_left: u32 0
            var next_range_char: u32 0
            ; explicit pointer type: an untyped var here COPIES the ISet
            ; value (the parm.token footgun class) and the adds vanish.
            var target: ref[ISet] name_start_char
            if is_namechar = 1
                set target: name_char
            var chars Array[u32]^host()
            var run_out false
            set prev_param: 0
            var uc_running true
            while uc_running
            {
                if prev_param = 0
                {
                    let allow_d AllowedSdParams(SDP_PARAM_LITERAL, SDP_NUMBER)
                    if this.parse_sd_param(allow_d, parm) = false
                        return false
                }
                else if prev_param = 1
                {
                    let allow_e AllowedSdParams(SDP_RESERVED_NAME + key1, SDP_RESERVED_NAME + key2, SDP_PARAM_LITERAL, SDP_NUMBER, SDP_MINUS)
                    if this.parse_sd_param(allow_e, parm) = false
                        return false
                }
                else
                {
                    let allow_f AllowedSdParams(SDP_RESERVED_NAME + key1, SDP_RESERVED_NAME + key2, SDP_PARAM_LITERAL, SDP_NUMBER)
                    if this.parse_sd_param(allow_f, parm) = false
                        return false
                }
                var enr_hit2 false
                if parm.kind = SDP_NUMBER
                    set enr_hit2: true
                else if (parm.kind = SDP_PARAM_LITERAL) and (prev_param <> 0)
                    set enr_hit2: true
                if enr_hit2 and (b.external_syntax = false) and (b.enr = false)
                {
                    this.report0_at(ParserMessages.enrRequired(), this.sd_loc())
                    set b.enr: true
                }
                if parm.kind = SDP_NUMBER
                    set prev_param: 1
                else
                    set prev_param: 2
                if parm.kind = SDP_MINUS
                {
                    let allow_num2 AllowedSdParams(SDP_NUMBER)
                    if this.parse_sd_param(allow_num2, parm) = false
                        return false
                    let start0 chars[0]
                    var start start0
                    let end parm.n
                    if start > end
                        this.report0_at(ParserMessages.sdInvalidRange(), this.sd_loc())
                    else
                    {
                        var count (end + (1 as u32)) - start
                        while count > 0
                        {
                            if range_left = 0
                            {
                                if range_index_pos < range_index.get_length()
                                {
                                    let ri_val range_index[range_index_pos]
                                    if (ri_val as size_t) = lc_pos
                                    {
                                        let lo lc[lc_pos]
                                        let hi lc[lc_pos + 1]
                                        set range_left: (hi - lo) + (1 as u32)
                                        set next_range_char: lo
                                        set lc_pos: lc_pos + 2
                                        set range_index_pos: range_index_pos + 1
                                    }
                                }
                            }
                            var c: u32 0
                            if range_left > 0
                            {
                                set range_left: range_left - (1 as u32)
                                set c: next_range_char
                                set next_range_char: next_range_char + (1 as u32)
                            }
                            else if lc_pos < lc.get_length()
                            {
                                set c: lc[lc_pos]
                                set lc_pos: lc_pos + 1
                            }
                            else
                            {
                                set c: start
                                set run_out: true
                            }
                            var bulk false
                            if (c = start) and (count > 1)
                            {
                                if run_out or (range_left > 0)
                                    set bulk: true
                            }
                            if bulk
                            {
                                var n: u32 0
                                if run_out
                                    set n: count
                                else if range_left < count
                                {
                                    set n: range_left + (1 as u32)
                                    set range_left: 0
                                }
                                else
                                {
                                    set n: count
                                    set range_left: range_left - (n - (1 as u32))
                                    set next_range_char: next_range_char + (n - (1 as u32))
                                }
                                this.translate_range(b, start, start + (n - (1 as u32)), target)
                                set count: count - n
                                set start: start + n
                            }
                            else
                            {
                                var trans_lc: u32 0
                                var trans_uc: u32 0
                                var ok1 this.translate_syntax(b, c, &trans_lc)
                                if ok1
                                {
                                    if this.translate_syntax(b, start, &trans_uc)
                                    {
                                        target.add(trans_lc)
                                        if trans_lc <> trans_uc
                                        {
                                            target.add(trans_uc)
                                            b.syntax.add_subst(trans_lc, trans_uc)
                                        }
                                    }
                                }
                                set count: count - (1 as u32)
                                set start: start + (1 as u32)
                            }
                        }
                    }
                    set chars: Array[u32]^host()
                }
                else
                {
                    var ci: size_t 0
                    let cn chars.get_length()
                    while ci < cn
                    {
                        if range_left = 0
                        {
                            if range_index_pos < range_index.get_length()
                            {
                                let ri_val2 range_index[range_index_pos]
                                if (ri_val2 as size_t) = lc_pos
                                {
                                    let lo2 lc[lc_pos]
                                    let hi2 lc[lc_pos + 1]
                                    set range_left: (hi2 - lo2) + (1 as u32)
                                    set next_range_char: lo2
                                    set lc_pos: lc_pos + 2
                                    set range_index_pos: range_index_pos + 1
                                }
                            }
                        }
                        var c2: u32 0
                        if range_left > 0
                        {
                            set range_left: range_left - (1 as u32)
                            set c2: next_range_char
                            set next_range_char: next_range_char + (1 as u32)
                        }
                        else if lc_pos < lc.get_length()
                        {
                            set c2: lc[lc_pos]
                            set lc_pos: lc_pos + 1
                        }
                        else
                        {
                            set run_out: true
                            set c2: chars[ci]
                        }
                        var trans_lc2: u32 0
                        var trans_uc2: u32 0
                        var ok2 this.translate_syntax(b, c2, &trans_lc2)
                        if ok2
                        {
                            let uc_char chars[ci]
                            if this.translate_syntax(b, uc_char, &trans_uc2)
                            {
                                target.add(trans_lc2)
                                if trans_lc2 <> trans_uc2
                                {
                                    target.add(trans_uc2)
                                    b.syntax.add_subst(trans_lc2, trans_uc2)
                                }
                            }
                        }
                        set ci: ci + 1
                    }
                    this.sd_param_convert_to_literal(parm)
                    if parm.kind <> SDP_PARAM_LITERAL
                        set uc_running: false
                    else
                    {
                        set chars: Array[u32]^host()
                        var pi2: size_t 0
                        let pn2 parm.param_literal.get_size()
                        while pi2 < pn2
                        {
                            chars.add(parm.param_literal.get(pi2))
                            set pi2: pi2 + 1
                        }
                    }
                }
            }
            var length_err false
            if run_out and (b.external_syntax = false)
                set length_err: true
            if range_left > 0
                set length_err: true
            if lc_pos < lc.get_length()
                set length_err: true
            if length_err
            {
                if is_namechar = 1
                    this.report0_at(ParserMessages.nmcharLength(), this.sd_loc())
                else
                    this.report0_at(ParserMessages.nmstrtLength(), this.sd_loc())
            }
            ; the WWW NAMESTRT/NAMECHAR extension list.
            if parm.kind = (SDP_RESERVED_NAME + key1)
            {
                if (b.external_syntax = false) and (b.enr = false)
                {
                    this.report0_at(ParserMessages.enrRequired(), this.sd_loc())
                    set b.enr: true
                }
                set prev_param: 0
                var ext_running true
                while ext_running
                {
                    if prev_param = 0
                    {
                        let allow_g AllowedSdParams(SDP_PARAM_LITERAL, SDP_NUMBER)
                        if this.parse_sd_param(allow_g, parm) = false
                            return false
                    }
                    else if prev_param = 1
                    {
                        let allow_h AllowedSdParams(SDP_RESERVED_NAME + key2, SDP_PARAM_LITERAL, SDP_NUMBER, SDP_MINUS)
                        if this.parse_sd_param(allow_h, parm) = false
                            return false
                    }
                    else
                    {
                        let allow_i AllowedSdParams(SDP_RESERVED_NAME + key2, SDP_PARAM_LITERAL, SDP_NUMBER)
                        if this.parse_sd_param(allow_i, parm) = false
                            return false
                    }
                    let was_number parm.kind = SDP_NUMBER
                    if parm.kind = SDP_MINUS
                    {
                        let prev_number parm.n
                        let allow_num3 AllowedSdParams(SDP_NUMBER)
                        if this.parse_sd_param(allow_num3, parm) = false
                            return false
                        if parm.n < prev_number
                            this.report0_at(ParserMessages.sdInvalidRange(), this.sd_loc())
                        else if parm.n > prev_number
                            this.translate_range(b, prev_number + (1 as u32), parm.n, target)
                    }
                    else
                    {
                        this.sd_param_convert_to_literal(parm)
                        if parm.kind <> SDP_PARAM_LITERAL
                            set ext_running: false
                        else
                        {
                            var pi3: size_t 0
                            let pn3 parm.param_literal.get_size()
                            while pi3 < pn3
                            {
                                var trans3: u32 0
                                let plc parm.param_literal.get(pi3)
                                if this.translate_syntax(b, plc, &trans3)
                                    target.add(trans3)
                                set pi3: pi3 + 1
                            }
                            if was_number
                                set prev_param: 1
                            else
                                set prev_param: 2
                        }
                    }
                }
            }
            if this.check_nmchars(target, b.syntax) = false
                set b.valid: false
            if is_namechar = 1
                set iterating: false
            set is_namechar: is_namechar + 1
        }
        let bad ISet^host()
        this.intersect_char_sets(name_start_char, name_char, bad)
        if bad.is_empty() = false
        {
            set b.valid: false
            let arg this.charset_message_arg(bad)
            this.report_raw_at(ParserMessages.nmcharNmstrt(), arg, this.sd_loc())
        }
        this.apply_name_start_chars(b.syntax, name_start_char)
        this.apply_name_chars(b.syntax, name_char)
        let allow_gen AllowedSdParams(SDP_RESERVED_NAME + SDR_GENERAL)
        if this.parse_sd_param(allow_gen, parm) = false
            return false
        let allow_yn AllowedSdParams(SDP_RESERVED_NAME + SDR_NO, SDP_RESERVED_NAME + SDR_YES)
        if this.parse_sd_param(allow_yn, parm) = false
            return false
        b.syntax.set_namecase_general(parm.kind = (SDP_RESERVED_NAME + SDR_YES))
        let allow_ent AllowedSdParams(SDP_RESERVED_NAME + SDR_ENTITY)
        if this.parse_sd_param(allow_ent, parm) = false
            return false
        if this.parse_sd_param(allow_yn, parm) = false
            return false
        b.syntax.set_namecase_entity(parm.kind = (SDP_RESERVED_NAME + SDR_YES))
        true
    }

    ; fold a string through the builder syntax's general substitution table.
    function sd_general_subst(this: Parser, b: ref[SdBuilder], s: StringC) returns StringC
    {
        let n s.get_size()
        if n = 0
            return StringC^host(null as pointer[u32], 0)
        let cb host.allocate(n * 4, 4) as pointer[u32]
        var i: size_t 0
        while i < n
        {
            set *(cb + i): b.syntax.fold(s.get(i))
            set i: i + 1
        }
        StringC^host(cb, n)
    }

    ; Parser::sdParseDelim (parseSd.cxx:1936).
    function sd_parse_delim(this: Parser, b: ref[SdBuilder], parm: ref[SdParam]) returns bool
    {
        let allow_delim AllowedSdParams(SDP_RESERVED_NAME + SDR_DELIM)
        if this.parse_sd_param(allow_delim, parm) = false
            return false
        let allow_general AllowedSdParams(SDP_RESERVED_NAME + SDR_GENERAL)
        if this.parse_sd_param(allow_general, parm) = false
            return false
        let allow_sgmlref AllowedSdParams(SDP_RESERVED_NAME + SDR_SGMLREF)
        if this.parse_sd_param(allow_sgmlref, parm) = false
            return false
        let specified host.allocate(N_DELIM_GENERAL as size_t, 1) as pointer[u8]
        var di: int 0
        while di < N_DELIM_GENERAL
        {
            set *(specified + (di as size_t)): 0
            set di: di + 1
        }
        var general_running true
        while general_running
        {
            let allow_role AllowedSdParams(SDP_GENERAL_DELIMITER_NAME, SDP_RESERVED_NAME + SDR_SHORTREF)
            if this.parse_sd_param(allow_role, parm) = false
                return false
            if parm.kind = (SDP_RESERVED_NAME + SDR_SHORTREF)
                set general_running: false
            else
            {
                let dg parm.idx
                if (*(specified + (dg as size_t))) <> 0
                {
                    let sdv ps.get_sd()
                    let dn sdv.general_delimiter_name(dg)
                    this.report1_at(ParserMessages.duplicateDelimGeneral(), dn, this.sd_loc())
                }
                if (dg = dHCRO) or (dg = dNESTC)
                    this.sd_require_www(b)
                if b.external_syntax
                {
                    let allow_val AllowedSdParams(SDP_PARAM_LITERAL, SDP_NUMBER)
                    if this.parse_sd_param(allow_val, parm) = false
                        return false
                }
                else
                {
                    let allow_val2 AllowedSdParams(SDP_PARAM_LITERAL)
                    if this.parse_sd_param(allow_val2, parm) = false
                        return false
                }
                this.sd_param_convert_to_literal(parm)
                if parm.param_literal.get_size() = 0
                    this.report0_at(ParserMessages.sdEmptyDelimiter(), this.sd_loc())
                else
                {
                    var str StringC()
                    if this.translate_syntax_string(b, parm.param_literal, &str)
                    {
                        let folded this.sd_general_subst(b, str)
                        var ok this.check_general_delim(b.syntax, folded)
                        if ok
                        {
                            if (*(specified + (dg as size_t))) = 0
                            {
                                let fdp folded.data_ptr()
                                let fdn folded.get_size()
                                b.syntax.set_delim_general(dg, fdp, fdn)
                            }
                            else
                            {
                                ; a re-specified role invalidates the declaration
                                ; (parseSd.cxx:1981's && arm).
                                set b.valid: false
                            }
                        }
                        else
                            set b.valid: false
                    }
                }
                set *(specified + (dg as size_t)): 1
            }
        }
        ; NET declared without NESTC: NESTC defaults to NET (parseSd.cxx:1989).
        if (b.syntax.delim_general_len(dNET) > 0) and (b.syntax.delim_general_len(dNESTC) = 0)
        {
            ; specified[] gates the reference fill below; NET's chars stand in.
            let net_len b.syntax.delim_general_len(dNET)
            let net_buf host.allocate(net_len * 4, 4) as pointer[u32]
            var ni: size_t 0
            while ni < net_len
            {
                set *(net_buf + ni): b.syntax.delim_general_char(dNET, ni)
                set ni: ni + 1
            }
            b.syntax.set_delim_general(dNESTC, net_buf, net_len)
            set *(specified + (dNESTC as size_t)): 1
        }
        ; HCRO stays empty unless declared: mark every still-empty slot whose
        ; Figure-3 row is empty as specified so the fill skips it faithfully.
        if this.set_ref_delim_general(b, b.syntax, b.syntax_charset, specified) = false
            set b.valid: false
        let allow_sr AllowedSdParams(SDP_RESERVED_NAME + SDR_SGMLREF, SDP_RESERVED_NAME + SDR_NONE)
        if this.parse_sd_param(allow_sr, parm) = false
            return false
        if parm.kind = (SDP_RESERVED_NAME + SDR_SGMLREF)
        {
            if this.add_ref_delim_shortref(b, b.syntax, b.syntax_charset) = false
                set b.valid: false
        }
        var last_literal StringC()
        var have_last false
        var sr_running true
        while sr_running
        {
            if b.external_syntax
            {
                let allow_sr2 AllowedSdParams(SDP_PARAM_LITERAL, SDP_NUMBER, SDP_MINUS, SDP_RESERVED_NAME + SDR_NAMES)
                if this.parse_sd_param(allow_sr2, parm) = false
                    return false
            }
            else
            {
                let allow_sr3 AllowedSdParams(SDP_PARAM_LITERAL, SDP_RESERVED_NAME + SDR_NAMES)
                if this.parse_sd_param(allow_sr3, parm) = false
                    return false
            }
            this.sd_param_convert_to_literal(parm)
            if parm.kind = SDP_MINUS
            {
                let allow_hi AllowedSdParams(SDP_PARAM_LITERAL, SDP_NUMBER)
                if this.parse_sd_param(allow_hi, parm) = false
                    return false
                this.sd_param_convert_to_literal(parm)
                if parm.param_literal.get_size() = 0
                    this.report0_at(ParserMessages.sdEmptyDelimiter(), this.sd_loc())
                else
                {
                    var not_single false
                    if have_last = false
                        set not_single: true
                    else if last_literal.get_size() <> 1
                        set not_single: true
                    if parm.param_literal.get_size() <> 1
                        set not_single: true
                    if not_single
                        this.report0_at(ParserMessages.sdRangeNotSingleChar(), this.sd_loc())
                    else
                    {
                        let lo_c last_literal.get(0)
                        let hi_c parm.param_literal.get(0)
                        if hi_c < lo_c
                            this.report0_at(ParserMessages.sdInvalidRange(), this.sd_loc())
                        else if hi_c <> lo_c
                        {
                            let shortref_chars ISet^host()
                            this.translate_range(b, lo_c + (1 as u32), hi_c, shortref_chars)
                            let duplicates ISet^host()
                            this.intersect_char_sets(shortref_chars, b.syntax.delim_shortref_simple(), duplicates)
                            var ki: size_t 0
                            let kn b.syntax.n_delim_shortref_complex()
                            while ki < kn
                            {
                                let cd b.syntax.delim_shortref_complex(ki)
                                if cd.get_size() = 1
                                {
                                    let cc cd.get(0)
                                    if shortref_chars.contains(cc)
                                        duplicates.add(cc)
                                }
                                set ki: ki + 1
                            }
                            if duplicates.is_empty() = false
                            {
                                let arg this.charset_message_arg(duplicates)
                                this.report_raw_at(ParserMessages.duplicateDelimShortrefSet(), arg, this.sd_loc())
                            }
                            b.syntax.add_delim_shortrefs_set(shortref_chars)
                        }
                    }
                }
                set have_last: false
            }
            else if parm.kind = SDP_PARAM_LITERAL
            {
                ; same struct-assignment footgun as parm.token — copy via
                ; the accessors.
                let lldp parm.param_literal.data_ptr()
                let lldn parm.param_literal.get_size()
                set last_literal: StringC^host(lldp, lldn)
                set have_last: true
                if last_literal.get_size() = 0
                    this.report0_at(ParserMessages.sdEmptyDelimiter(), this.sd_loc())
                else
                {
                    var str2 StringC()
                    if this.translate_syntax_string(b, last_literal, &str2)
                    {
                        let folded2 this.sd_general_subst(b, str2)
                        var sr_ok folded2.get_size() = 1
                        if sr_ok = false
                            set sr_ok: this.check_shortref_delim(b.syntax, folded2)
                        if sr_ok
                        {
                            if b.syntax.is_valid_shortref(folded2)
                                this.report1_at(ParserMessages.duplicateDelimShortref(), folded2, this.sd_loc())
                            else
                                b.syntax.add_delim_shortref(folded2)
                        }
                    }
                }
            }
            else
                set sr_running: false
        }
        true
    }

    ; Parser::sdParseNames (parseSd.cxx:2084).
    function sd_parse_names(this: Parser, b: ref[SdBuilder], parm: ref[SdParam]) returns bool
    {
        let allow_sgmlref AllowedSdParams(SDP_RESERVED_NAME + SDR_SGMLREF)
        if this.parse_sd_param(allow_sgmlref, parm) = false
            return false
        var running true
        while running
        {
            let allow_rn AllowedSdParams(SDP_RESERVED_NAME + SDR_QUANTITY, SDP_REFERENCE_RESERVED_NAME)
            if this.parse_sd_param(allow_rn, parm) = false
                return false
            if parm.kind = (SDP_RESERVED_NAME + SDR_QUANTITY)
                set running: false
            else
            {
                let rn parm.idx
                if (rn = R_ALL) or (rn = R_DATA) or (rn = R_IMPLICIT)
                    this.sd_require_www(b)
                if b.external_syntax
                {
                    let allow_nm AllowedSdParams(SDP_NAME, SDP_PARAM_LITERAL)
                    if this.parse_sd_param(allow_nm, parm) = false
                        return false
                }
                else
                {
                    let allow_nm2 AllowedSdParams(SDP_NAME)
                    if this.parse_sd_param(allow_nm2, parm) = false
                        return false
                }
                var trans_name StringC()
                var trans_ok false
                if parm.kind = SDP_NAME
                    set trans_ok: this.translate_name(b, parm.token, &trans_name)
                else
                    set trans_ok: this.translate_syntax_string(b, parm.param_literal, &trans_name)
                if trans_ok
                {
                    let existing b.syntax.lookup_reserved_name(trans_name)
                    if existing >= 0
                        this.report1_at(ParserMessages.ambiguousReservedName(), trans_name, this.sd_loc())
                    else
                    {
                        var bad_name false
                        if trans_name.get_size() = 0
                            set bad_name: true
                        else if b.syntax.is_name_start_character(trans_name.get(0)) = false
                            set bad_name: true
                        if bad_name
                        {
                            this.report1_at(ParserMessages.reservedNameSyntax(), trans_name, this.sd_loc())
                            set trans_name: StringC^host(null as pointer[u32], 0)
                        }
                        var ni: size_t 1
                        let nn trans_name.get_size()
                        while ni < nn
                        {
                            if b.syntax.is_name_character(trans_name.get(ni)) = false
                            {
                                this.report1_at(ParserMessages.reservedNameSyntax(), trans_name, this.sd_loc())
                                set trans_name: StringC^host(null as pointer[u32], 0)
                                set ni: nn
                            }
                            else
                                set ni: ni + 1
                        }
                        let folded this.sd_general_subst(b, trans_name)
                        let cur b.syntax.reserved_name(rn)
                        if cur.get_size() > 0
                        {
                            let syn ps.get_syntax()
                            let spell syn.reserved_name(rn)
                            this.report1_at(ParserMessages.duplicateReservedName(), spell, this.sd_loc())
                        }
                        else if folded.get_size() > 0
                            b.syntax.set_name(rn, folded)
                        else
                            set b.valid: false
                    }
                }
            }
        }
        this.set_ref_names(b.syntax, b.www)
        var fi: int 0
        while fi < 3
        {
            var rn_idx R_RE
            if fi = 1
                set rn_idx: R_RS
            else if fi = 2
                set rn_idx: R_SPACE
            let fname b.syntax.reserved_name(rn_idx)
            var tem: u32 0
            if b.syntax.lookup_declared_function_char(fname, &tem)
                this.report1_at(ParserMessages.duplicateFunctionName(), fname, this.sd_loc())
            set fi: fi + 1
        }
        b.syntax.enter_standard_function_names()
        true
    }

    ; Parser::sdParseQuantity (parseSd.cxx:2162).
    function sd_parse_quantity(this: Parser, b: ref[SdBuilder], parm: ref[SdParam]) returns bool
    {
        if b.www
        {
            let allow_a AllowedSdParams(SDP_RESERVED_NAME + SDR_NONE, SDP_RESERVED_NAME + SDR_SGMLREF)
            if this.parse_sd_param(allow_a, parm) = false
                return false
        }
        else
        {
            let allow_b AllowedSdParams(SDP_RESERVED_NAME + SDR_SGMLREF)
            if this.parse_sd_param(allow_b, parm) = false
                return false
        }
        var final SDP_RESERVED_NAME + SDR_FEATURES
        if b.external_syntax
            set final: SDP_EE
        if parm.kind = (SDP_RESERVED_NAME + SDR_NONE)
        {
            var qi: int 0
            while (qi as size_t) < N_QUANTITY
            {
                if qi <> qNORMSEP
                    b.syntax.set_quantity(qi, SYNTAX_UNLIMITED)
                set qi: qi + 1
            }
            let allow_end AllowedSdParams(final, SDP_RESERVED_NAME + SDR_ENTITIES)
            if this.parse_sd_param(allow_end, parm) = false
                return false
        }
        else
        {
            var q_running true
            while q_running
            {
                if b.www
                {
                    let allow_q AllowedSdParams(SDP_QUANTITY_NAME, final, SDP_RESERVED_NAME + SDR_ENTITIES)
                    if this.parse_sd_param(allow_q, parm) = false
                        return false
                }
                else
                {
                    let allow_q2 AllowedSdParams(SDP_QUANTITY_NAME, final)
                    if this.parse_sd_param(allow_q2, parm) = false
                        return false
                }
                if parm.kind <> SDP_QUANTITY_NAME
                    set q_running: false
                else
                {
                    let quantity parm.idx
                    let allow_num AllowedSdParams(SDP_NUMBER)
                    if this.parse_sd_param(allow_num, parm) = false
                        return false
                    b.syntax.set_quantity(quantity, parm.n)
                }
            }
            if b.sd.scope_instance()
            {
                let syn ps.get_syntax()
                let sdv ps.get_sd()
                var qi2: int 0
                while (qi2 as size_t) < N_QUANTITY
                {
                    let nv b.syntax.get_quantity(qi2)
                    let pv syn.get_quantity(qi2)
                    if nv < pv
                    {
                        let qn sdv.quantity_name(qi2)
                        this.report1_at(ParserMessages.scopeInstanceQuantity(), qn, this.sd_loc())
                    }
                    set qi2: qi2 + 1
                }
            }
        }
        if parm.kind = (SDP_RESERVED_NAME + SDR_ENTITIES)
            return this.sd_parse_entities(b, parm)
        true
    }

    ; Parser::sdParseEntities (parseSd.cxx:2211).
    function sd_parse_entities(this: Parser, b: ref[SdBuilder], parm: ref[SdParam]) returns bool
    {
        var final SDP_RESERVED_NAME + SDR_FEATURES
        if b.external_syntax
            set final: SDP_EE
        var running true
        while running
        {
            let allow_e AllowedSdParams(final, SDP_PARAM_LITERAL)
            if this.parse_sd_param(allow_e, parm) = false
                return false
            if parm.kind <> SDP_PARAM_LITERAL
                set running: false
            else
            {
                var name StringC()
                var name_ok this.translate_syntax_string(b, parm.param_literal, &name)
                if name_ok
                {
                    var bad false
                    if name.get_size() = 0
                        set bad: true
                    else if b.syntax.is_name_start_character(name.get(0)) = false
                        set bad: true
                    if bad
                    {
                        this.report1_at(ParserMessages.entityNameSyntax(), name, this.sd_loc())
                        set name_ok: false
                    }
                    else
                    {
                        var ni: size_t 1
                        let nn name.get_size()
                        while ni < nn
                        {
                            if b.syntax.is_name_character(name.get(ni)) = false
                            {
                                this.report1_at(ParserMessages.entityNameSyntax(), name, this.sd_loc())
                                set name_ok: false
                                set ni: nn
                            }
                            else
                                set ni: ni + 1
                        }
                    }
                }
                let allow_num AllowedSdParams(SDP_NUMBER)
                if this.parse_sd_param(allow_num, parm) = false
                    return false
                var c: u32 0
                if this.translate_syntax(b, parm.n, &c)
                {
                    if name_ok
                    {
                        if name.get_size() > 0
                            b.syntax.add_entity_str(name, c)
                    }
                }
            }
        }
        true
    }

    ; Parser::sdParseFeatures (parseSd.cxx:2247) — the ordered FEATURES table.
    function sd_parse_features(this: Parser, b: ref[SdBuilder], parm: ref[SdParam]) returns bool
    {
        ; the FeatureInfo table: SD reserved name + argument kind
        ; (0 none, 1 boolean, 2 number, 3 netenabl, 4 implyelt).
        var feat_names int[34]
        var feat_args int[34]
        let fn feat_names as pointer[int]
        let fa feat_args as pointer[int]
        this.sd_fill_features(fn, fa)
        var boolean_feature: int 0
        var number_feature: int 0
        var i: int 0
        while i < 34
        {
            let name_i *(fn + (i as size_t))
            var arg_i *(fa + (i as size_t))
            var handled false
            if name_i = SDR_STARTTAG
            {
                ; SHORTTAG YES/NO or the Annex-K sub-form.
                let allow_st AllowedSdParams(SDP_RESERVED_NAME + SDR_STARTTAG, SDP_RESERVED_NAME + SDR_NO, SDP_RESERVED_NAME + SDR_YES)
                if this.parse_sd_param(allow_st, parm) = false
                    return false
                ; STARTTAG itself was consumed here (the reference's switch
                ; break) — don't parse the keyword again below.
                if parm.kind = (SDP_RESERVED_NAME + SDR_STARTTAG)
                    set handled: true
                if parm.kind <> (SDP_RESERVED_NAME + SDR_STARTTAG)
                {
                    b.sd.set_shorttag(parm.kind = (SDP_RESERVED_NAME + SDR_YES))
                    ; skip the sub-features up to EMPTYNRM, counting booleans.
                    set i: i + 1
                    while (*(fn + (i as size_t))) <> SDR_EMPTYNRM
                    {
                        if (*(fa + (i as size_t))) = 1
                            set boolean_feature: boolean_feature + 1
                        set i: i + 1
                    }
                    ; fall into the EMPTYNRM|LINK choice below.
                    let allow_el AllowedSdParams(SDP_RESERVED_NAME + SDR_EMPTYNRM, SDP_RESERVED_NAME + SDR_LINK)
                    if this.parse_sd_param(allow_el, parm) = false
                        return false
                    if parm.kind = (SDP_RESERVED_NAME + SDR_EMPTYNRM)
                        this.sd_require_www(b)
                    else
                    {
                        set boolean_feature: boolean_feature + 5
                        set i: i + 7
                    }
                    set arg_i: *(fa + (i as size_t))
                    set handled: true
                }
            }
            else if name_i = SDR_EMPTYNRM
            {
                let allow_el2 AllowedSdParams(SDP_RESERVED_NAME + SDR_EMPTYNRM, SDP_RESERVED_NAME + SDR_LINK)
                if this.parse_sd_param(allow_el2, parm) = false
                    return false
                if parm.kind = (SDP_RESERVED_NAME + SDR_EMPTYNRM)
                    this.sd_require_www(b)
                else
                {
                    set boolean_feature: boolean_feature + 5
                    set i: i + 7
                }
                set arg_i: *(fa + (i as size_t))
                set handled: true
            }
            else if name_i = SDR_URN
            {
                let allow_urn AllowedSdParams(SDP_RESERVED_NAME + SDR_URN, SDP_RESERVED_NAME + SDR_APPINFO)
                if this.parse_sd_param(allow_urn, parm) = false
                    return false
                if parm.kind = (SDP_RESERVED_NAME + SDR_APPINFO)
                    return true
                this.sd_require_www(b)
                set handled: true
            }
            if handled = false
            {
                let allow_kw AllowedSdParams(SDP_RESERVED_NAME + name_i)
                if this.parse_sd_param(allow_kw, parm) = false
                    return false
            }
            if arg_i = 2
            {
                ; number feature: NO or YES n.
                let allow_yn AllowedSdParams(SDP_RESERVED_NAME + SDR_NO, SDP_RESERVED_NAME + SDR_YES)
                if this.parse_sd_param(allow_yn, parm) = false
                    return false
                if parm.kind = (SDP_RESERVED_NAME + SDR_YES)
                {
                    let allow_num AllowedSdParams(SDP_NUMBER)
                    if this.parse_sd_param(allow_num, parm) = false
                        return false
                    b.sd.set_number_feature(number_feature, parm.n)
                }
                else
                    b.sd.set_number_feature(number_feature, 0)
                set number_feature: number_feature + 1
            }
            else if arg_i = 3
            {
                let allow_ne AllowedSdParams(SDP_RESERVED_NAME + SDR_NO, SDP_RESERVED_NAME + SDR_IMMEDNET, SDP_RESERVED_NAME + SDR_ALL)
                if this.parse_sd_param(allow_ne, parm) = false
                    return false
                if parm.kind = (SDP_RESERVED_NAME + SDR_NO)
                    b.sd.set_start_tag_net_enable(NET_ENABLE_NO)
                else if parm.kind = (SDP_RESERVED_NAME + SDR_IMMEDNET)
                    b.sd.set_start_tag_net_enable(NET_ENABLE_IMMEDNET)
                else
                    b.sd.set_start_tag_net_enable(NET_ENABLE_ALL)
            }
            else if arg_i = 4
            {
                let allow_ie AllowedSdParams(SDP_RESERVED_NAME + SDR_NO, SDP_RESERVED_NAME + SDR_YES, SDP_RESERVED_NAME + SDR_ANYOTHER)
                if this.parse_sd_param(allow_ie, parm) = false
                    return false
                if parm.kind = (SDP_RESERVED_NAME + SDR_NO)
                    b.sd.set_implydef_element(IMPLYDEF_ELEMENT_NO)
                else if parm.kind = (SDP_RESERVED_NAME + SDR_YES)
                    b.sd.set_implydef_element(IMPLYDEF_ELEMENT_YES)
                else
                    b.sd.set_implydef_element(IMPLYDEF_ELEMENT_ANYOTHER)
            }
            else if arg_i = 1
            {
                let allow_yn2 AllowedSdParams(SDP_RESERVED_NAME + SDR_NO, SDP_RESERVED_NAME + SDR_YES)
                if this.parse_sd_param(allow_yn2, parm) = false
                    return false
                let cur_name *(fn + (i as size_t))
                if cur_name = SDR_EMPTYNRM
                {
                    if (parm.kind = (SDP_RESERVED_NAME + SDR_NO)) and (b.sd.start_tag_net_enable() = NET_ENABLE_IMMEDNET)
                    {
                        this.report0_at(ParserMessages.immednetRequiresEmptynrm(), this.sd_loc())
                        set b.valid: false
                    }
                }
                b.sd.set_boolean_feature(boolean_feature, parm.kind = (SDP_RESERVED_NAME + SDR_YES))
                set boolean_feature: boolean_feature + 1
            }
            set i: i + 1
        }
        let allow_val AllowedSdParams(SDP_RESERVED_NAME + SDR_NOASSERT, SDP_RESERVED_NAME + SDR_TYPE)
        if this.parse_sd_param(allow_val, parm) = false
            return false
        b.sd.set_type_valid(parm.kind = (SDP_RESERVED_NAME + SDR_TYPE))
        let allow_ent AllowedSdParams(SDP_RESERVED_NAME + SDR_ENTITIES)
        if this.parse_sd_param(allow_ent, parm) = false
            return false
        let allow_ref AllowedSdParams(SDP_RESERVED_NAME + SDR_NOASSERT, SDP_RESERVED_NAME + SDR_REF)
        if this.parse_sd_param(allow_ref, parm) = false
            return false
        if parm.kind = (SDP_RESERVED_NAME + SDR_NOASSERT)
        {
            b.sd.set_integrally_stored(false)
            b.sd.set_entity_ref(ENTITY_REF_ANY)
        }
        else
        {
            let allow_refv AllowedSdParams(SDP_RESERVED_NAME + SDR_NONE, SDP_RESERVED_NAME + SDR_INTERNAL, SDP_RESERVED_NAME + SDR_ANY)
            if this.parse_sd_param(allow_refv, parm) = false
                return false
            if parm.kind = (SDP_RESERVED_NAME + SDR_NONE)
                b.sd.set_entity_ref(ENTITY_REF_NONE)
            else if parm.kind = (SDP_RESERVED_NAME + SDR_INTERNAL)
                b.sd.set_entity_ref(ENTITY_REF_INTERNAL)
            else
                b.sd.set_entity_ref(ENTITY_REF_ANY)
            let allow_int AllowedSdParams(SDP_RESERVED_NAME + SDR_INTEGRAL)
            if this.parse_sd_param(allow_int, parm) = false
                return false
            let allow_yn3 AllowedSdParams(SDP_RESERVED_NAME + SDR_NO, SDP_RESERVED_NAME + SDR_YES)
            if this.parse_sd_param(allow_yn3, parm) = false
                return false
            b.sd.set_integrally_stored(parm.kind = (SDP_RESERVED_NAME + SDR_YES))
        }
        let allow_app AllowedSdParams(SDP_RESERVED_NAME + SDR_APPINFO)
        this.parse_sd_param(allow_app, parm)
    }

    ; the FeatureInfo table (parseSd.cxx:2259) — names + argument kinds.
    function sd_fill_features(this: Parser, fn: pointer[int], fa: pointer[int])
    {
        set *(fn + 0): SDR_MINIMIZE
        set *(fa + 0): 0
        set *(fn + 1): SDR_DATATAG
        set *(fa + 1): 1
        set *(fn + 2): SDR_OMITTAG
        set *(fa + 2): 1
        set *(fn + 3): SDR_RANK
        set *(fa + 3): 1
        set *(fn + 4): SDR_SHORTTAG
        set *(fa + 4): 0
        set *(fn + 5): SDR_STARTTAG
        set *(fa + 5): 0
        set *(fn + 6): SDR_EMPTY
        set *(fa + 6): 1
        set *(fn + 7): SDR_UNCLOSED
        set *(fa + 7): 1
        set *(fn + 8): SDR_NETENABL
        set *(fa + 8): 3
        set *(fn + 9): SDR_ENDTAG
        set *(fa + 9): 0
        set *(fn + 10): SDR_EMPTY
        set *(fa + 10): 1
        set *(fn + 11): SDR_UNCLOSED
        set *(fa + 11): 1
        set *(fn + 12): SDR_ATTRIB
        set *(fa + 12): 0
        set *(fn + 13): SDR_DEFAULT
        set *(fa + 13): 1
        set *(fn + 14): SDR_OMITNAME
        set *(fa + 14): 1
        set *(fn + 15): SDR_VALUE
        set *(fa + 15): 1
        set *(fn + 16): SDR_EMPTYNRM
        set *(fa + 16): 1
        set *(fn + 17): SDR_IMPLYDEF
        set *(fa + 17): 0
        set *(fn + 18): SDR_ATTLIST
        set *(fa + 18): 1
        set *(fn + 19): SDR_DOCTYPE
        set *(fa + 19): 1
        set *(fn + 20): SDR_ELEMENT
        set *(fa + 20): 4
        set *(fn + 21): SDR_ENTITY
        set *(fa + 21): 1
        set *(fn + 22): SDR_NOTATION
        set *(fa + 22): 1
        set *(fn + 23): SDR_LINK
        set *(fa + 23): 0
        set *(fn + 24): SDR_SIMPLE
        set *(fa + 24): 2
        set *(fn + 25): SDR_IMPLICIT
        set *(fa + 25): 1
        set *(fn + 26): SDR_EXPLICIT
        set *(fa + 26): 2
        set *(fn + 27): SDR_OTHER
        set *(fa + 27): 0
        set *(fn + 28): SDR_CONCUR
        set *(fa + 28): 2
        set *(fn + 29): SDR_SUBDOC
        set *(fa + 29): 2
        set *(fn + 30): SDR_FORMAL
        set *(fa + 30): 1
        set *(fn + 31): SDR_URN
        set *(fa + 31): 1
        set *(fn + 32): SDR_KEEPRSRE
        set *(fa + 32): 1
        set *(fn + 33): SDR_VALIDITY
        set *(fa + 33): 0
    }

    ; Parser::sdParseAppinfo (parseSd.cxx:2469).
    function sd_parse_appinfo(this: Parser, b: ref[SdBuilder], parm: ref[SdParam]) returns bool
    {
        let loc this.sd_loc()
        let allow AllowedSdParams(SDP_RESERVED_NAME + SDR_NONE, SDP_MINIMUM_LITERAL)
        if this.parse_sd_param(allow, parm) = false
            return false
        if parm.kind = SDP_MINIMUM_LITERAL
        {
            let text parm.literal_text.string()
            let ev Event.make_appinfo(ps.event_host(), text, loc)
            ps.queue_event(ev)
        }
        true
    }

    ; Parser::sdParseSeealso (parseSd.cxx:2485).
    function sd_parse_seealso(this: Parser, b: ref[SdBuilder], parm: ref[SdParam]) returns bool
    {
        var final SDP_MDC
        if b.external
            set final: SDP_EE
        let allow AllowedSdParams(SDP_RESERVED_NAME + SDR_SEEALSO, final)
        if this.parse_sd_param(allow, parm) = false
            return false
        if parm.kind = final
            return true
        this.sd_require_www(b)
        let allow2 AllowedSdParams(SDP_MINIMUM_LITERAL, SDP_RESERVED_NAME + SDR_NONE)
        if this.parse_sd_param(allow2, parm) = false
            return false
        if parm.kind = (SDP_RESERVED_NAME + SDR_NONE)
        {
            let allow_end AllowedSdParams(final)
            return this.parse_sd_param(allow_end, parm)
        }
        var running true
        while running
        {
            let allow3 AllowedSdParams(SDP_MINIMUM_LITERAL, final)
            if this.parse_sd_param(allow3, parm) = false
                return false
            if parm.kind = final
                set running: false
        }
        true
    }

    ; Parser::parseSgmlDecl (parseSd.cxx:678) — the driver. On success the
    ; built Sd + the prolog/instance syntaxes are returned (they differ only
    ; under SCOPE INSTANCE).
    function parse_sgml_decl(this: Parser, out_sd: pointer[pointer[Sd]], out_pro: pointer[pointer[Syntax]], out_inst: pointer[pointer[Syntax]]) returns bool
    {
        let parm host.allocate(sizeof SdParam, alignof SdParam) as pointer[SdParam]
        set *parm: SdParam()
        let b host.allocate(sizeof SdBuilder, alignof SdBuilder) as pointer[SdBuilder]
        set *b: SdBuilder(host)
        let allow_ver AllowedSdParams(SDP_MINIMUM_LITERAL, SDP_NAME)
        if this.parse_sd_param(allow_ver, parm) = false
            return false
        if parm.kind = SDP_NAME
        {
            ; `<!SGML name ...>` — a WWW SGML-declaration reference.
            set b.external: true
            ; capture the NAME before the ref parse advances parm — it keys
            ; the catalog's SGML-name table.
            let ntok parm.token
            let nsc StringC^host(ntok.data_ptr(), ntok.get_size())
            ; `Location loc(currentLocation())` (parseSd.cxx:686) — the NAME
            ; token's start, the reference site the -e header prints
            ; (`In entity MYDECL included from doc.sgm:1:7`).
            let name_loc ps.current_input().token_start_location()
            let sgml_name0 this.stringc_to_bytes(*nsc)
            let id host.allocate(sizeof ExternalId, alignof ExternalId) as pointer[ExternalId]
            set *id: ExternalId()
            if this.sd_parse_sgml_decl_ref(b, parm, id) = false
                return false
            ; the `<!SGML name SYSTEM/PUBLIC ...>` reference entity: the
            ; full catalog lookup (SYSTEM entries, override-gated PUBLIC
            ; entries, SGML-name entries), declared system id as fallback.
            let sgml_name sgml_name0
            let sdecl_file this.file_id_of_loc(this.sd_loc())
            let sfsi this.catalog_effective_id(id.has_system_id(), id.get_system_id(), id.has_public_id(), id.get_public_id(), sgml_name, CAT_SGML, false, ps.get_decl_base_dir(), sdecl_file)
            if sfsi.get_length() = 0
            {
                this.report0_at(ParserMessages.cannotGenerateSystemIdSgml(), this.sd_loc())
                return false
            }
            ; ExternalTextEntity(name, EntityDecl::sgml, loc, id) +
            ; EntityOrigin::make(entity, loc) (parseSd.cxx:693/701): the
            ; SGML-declaration reference stacks as a NAMED entity origin, so
            ; -e prints "In entity <NAME> included from <name loc>" for every
            ; message inside the referenced .dcl.
            let hsid ExternalId.make(host, *id)
            let sent host.allocate(sizeof Entity, alignof Entity) as pointer[Entity]
            let sbase String^host(ps.get_decl_base_dir())
            set *sent: Entity.ExternalText(ExternalTextEntity(nsc, hsid, sbase, name_loc))
            let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
            set *org: Origin(name_loc, sent as pointer[void])
            var sfound String()
            let src this.fsi_open(sfsi, org, this.sd_loc(), this.sd_loc(), 0, &sfound)
            if src = null
                return false
            ps.push_input(src)
            let allow_ver2 AllowedSdParams(SDP_MINIMUM_LITERAL)
            if this.parse_sd_param(allow_ver2, parm) = false
                return false
        }
        let version parm.literal_text.string()
        if version.equals(StringC("ISO 8879:1986 (ENR)"))
            set b.enr: true
        else if version.equals(StringC("ISO 8879:1986 (WWW)"))
        {
            set b.enr: true
            set b.www: true
        }
        else
        {
            if version.equals(StringC("ISO 8879:1986")) = false
                this.report1_at(ParserMessages.standardVersion(), version, this.sd_loc())
        }
        if b.external and (b.www = false)
            this.report0_at(ParserMessages.sgmlDeclRefRequiresWww(), this.sd_loc())
        ; the raw Sd under construction (features all off until FEATURES).
        let bsd host.allocate(sizeof Sd, alignof Sd) as pointer[Sd]
        set *bsd: Sd()
        bsd.set_raw_defaults()
        let cur_sd ps.get_sd()
        if cur_sd.internal_charset_is_doc_charset() = false
            bsd.set_internal_charset_is_doc_charset(false)
        set b.sd: bsd
        if b.www
            bsd.set_www(true)
        if this.sd_parse_document_charset(b, parm) = false
            return false
        if b.valid = false
            return false
        if this.sd_parse_capacity(b, parm) = false
            return false
        if b.valid = false
            return false
        if this.sd_parse_scope(b, parm) = false
            return false
        if b.valid = false
            return false
        if this.sd_parse_syntax(b, parm) = false
            return false
        if b.valid = false
            return false
        if this.sd_parse_features(b, parm) = false
            return false
        if b.valid = false
            return false
        if this.sd_parse_appinfo(b, parm) = false
            return false
        if b.valid = false
            return false
        if this.sd_parse_seealso(b, parm) = false
            return false
        if b.valid = false
            return false
        ; setSdOverrides (parseSd.cxx:745): the -w validation flags override
        ; the freshly built declaration.
        Parser.apply_sd_overrides(ps.get_options(), b.sd)
        if b.sd.formal()
        {
            var fe: size_t 0
            while fe < b.n_ferr
            {
                let kind *(b.ferr_kind + fe)
                let code *(b.ferr_code + fe)
                let fid *(b.ferr_id + fe)
                let floc *(b.ferr_loc + fe)
                if kind = SDFE_FPI
                    this.report_fpi_error(code, fid, floc)
                else if kind = SDFE_TEXTCLASS_SD
                    this.report1_at(ParserMessages.sdTextClass(), fid, floc)
                else if kind = SDFE_TEXTCLASS_BASESET
                    this.report1_at(ParserMessages.basesetTextClass(), fid, floc)
                else if kind = SDFE_TEXTCLASS_CAPACITY
                    this.report1_at(ParserMessages.capacityTextClass(), fid, floc)
                else
                    this.report1_at(ParserMessages.syntaxTextClass(), fid, floc)
                set fe: fe + 1
            }
        }
        set *out_sd: b.sd
        if b.sd.scope_instance()
        {
            ; SCOPE INSTANCE: the prolog parses with the reference syntax
            ; (setStandardSyntax over a fresh syntax), the instance with the
            ; declared one; each must accept the other's SGML chars.
            let prosyn Syntax^host(*(b.sd))
            let inst_sgml b.syntax.char_set(setSgmlChar)
            prosyn.set_sgml_char_set(inst_sgml)
            let invalid ISet^host()
            this.check_sgml_char(prosyn, b.sd, b.syntax, b.sys_desc, invalid)
            this.check_sgml_char(b.syntax, b.sd, prosyn, b.sys_desc, invalid)
            if invalid.is_empty() = false
            {
                let arg this.charset_message_arg(invalid)
                this.report_raw_at(ParserMessages.invalidSgmlChar(), arg, this.sd_loc())
            }
            set *out_pro: prosyn
            set *out_inst: b.syntax
        }
        else
        {
            set *out_pro: b.syntax
            set *out_inst: b.syntax
        }
        ; a multicode syntax's markup scan table belongs to the CONCUR axis.
        true
    }

    ; ---- top-level entry: document bytes -> ESIS -------------------------
    ; The whole-document event-dump entry the onsgmls program calls: widen the
    ; input bytes to Char (identity/ASCII), set up ParserState (reference Sd +
    ; Syntax), drive parse_document, and return the ESIS text. *out_conforming
    ; is true iff the parse produced no errors (the onsgmls exit-0 condition).
    ; A concept STATIC so a user program resolves it across packages. `base_dir`
    ; is the document's directory — external DTD subsets (SYSTEM/PUBLIC) resolve
    ; their (relative) system ids against it.
    ; setSdOverrides (Parser.cxx:124) — the -w validation flags override the
    ; SGML declaration; applied to the implied Sd (Parser.cxx:48) AND to the
    ; freshly built one after a parsed declaration (parseSd.cxx:745).
    function apply_sd_overrides(opt: ref[ParserOptions], sd: ref[Sd])
    {
        if opt.type_valid <> OPT_SGML_DECL_TYPE_VALID
        {
            let tv opt.type_valid <> 0
            sd.set_type_valid(tv)
            sd.set_boolean_feature(SDF_IMPLYDEFATTLIST, not tv)
            if tv
                sd.set_implydef_element(IMPLYDEF_ELEMENT_NO)
            else
                sd.set_implydef_element(IMPLYDEF_ELEMENT_YES)
            sd.set_boolean_feature(SDF_IMPLYDEFENTITY, not tv)
            sd.set_boolean_feature(SDF_IMPLYDEFNOTATION, not tv)
        }
        if opt.fully_declared
        {
            sd.set_boolean_feature(SDF_IMPLYDEFATTLIST, false)
            sd.set_implydef_element(IMPLYDEF_ELEMENT_NO)
            sd.set_boolean_feature(SDF_IMPLYDEFENTITY, false)
            sd.set_boolean_feature(SDF_IMPLYDEFNOTATION, false)
        }
        if opt.fully_tagged
        {
            sd.set_boolean_feature(SDF_DATATAG, false)
            sd.set_boolean_feature(SDF_RANK, false)
            sd.set_boolean_feature(SDF_OMITTAG, false)
            sd.set_boolean_feature(SDF_STARTTAGEMPTY, false)
            sd.set_boolean_feature(SDF_ATTRIBOMITNAME, false)
        }
        if opt.amply_tagged
        {
            sd.set_boolean_feature(SDF_DATATAG, false)
            sd.set_boolean_feature(SDF_RANK, false)
            sd.set_boolean_feature(SDF_OMITTAG, false)
            sd.set_boolean_feature(SDF_ATTRIBOMITNAME, false)
            sd.set_implydef_element(IMPLYDEF_ELEMENT_YES)
        }
        if opt.amply_tagged_anyother
        {
            sd.set_boolean_feature(SDF_DATATAG, false)
            sd.set_boolean_feature(SDF_RANK, false)
            sd.set_boolean_feature(SDF_OMITTAG, false)
            sd.set_boolean_feature(SDF_ATTRIBOMITNAME, false)
            sd.set_implydef_element(IMPLYDEF_ELEMENT_ANYOTHER)
        }
        if opt.valid
            sd.set_type_valid(true)
        if opt.entity_ref
            sd.set_entity_ref(ENTITY_REF_NONE)
        if opt.external_entity_ref
            sd.set_entity_ref(ENTITY_REF_INTERNAL)
        if opt.integral
            sd.set_integrally_stored(true)
        if opt.no_unclosed_tag
        {
            sd.set_boolean_feature(SDF_STARTTAGUNCLOSED, false)
            sd.set_boolean_feature(SDF_ENDTAGUNCLOSED, false)
        }
        if opt.no_net
            sd.set_start_tag_net_enable(NET_ENABLE_NO)
    }

    ; widen a byte identifier into a host-pinned StringC message arg.
    function widen_arg(host: ref[Page], s: String) returns StringC
    {
        let n s.get_length()
        let buf host.allocate(n * 4, 4) as pointer[u32]
        var i: size_t 0
        while i < n
        {
            set *(buf + i): s.get(i) as u32
            set i: i + 1
        }
        ; ^host for the same reason as build_stringc above: a by-VALUE return
        ; runs the copying init with `this` on the sret slot, whose Page.get
        ; masks to a bogus, per-call-IDENTICAL header — so two widen_arg results
        ; in ONE diagnostic (the two-argument message-arg sites below) aliased
        ; the same buffer and the second overwrote the first.
        let scp StringC^host(buf, n)
        *scp
    }

    ; replay the diagnostics one catalog file collected, in fire order,
    ; through the parser Messenger: located messages render `file:line:col`
    ; against the catalog file's origin, unlocated ones (a BASE probe
    ; failure) render the app shape — both count.
    function replay_catalog_msgs(host: ref[Page], ps: ref[ParserState], msgs: ref[Array[CatMsg]])
    {
        let n msgs.get_length()
        var i: size_t 0
        while i < n
        {
            let m msgs[i]
            var args Vector[MessageArg]()
            if m.kind = CMK_STR
            {
                var a1 Vector[MessageArg](1)
                set *(a1.get(0)): MessageArg.Str(Parser.widen_arg(host, m.a1))
                set args: a1
            }
            else if m.kind = CMK_STR_RAW
            {
                var a2 Vector[MessageArg](2)
                set *(a2.get(0)): MessageArg.Str(Parser.widen_arg(host, m.a1))
                set *(a2.get(1)): MessageArg.Raw(Parser.widen_arg(host, m.a2))
                set args: a2
            }
            if m.has_loc
                ps.report_at(m.mt, args, m.loc)
            else
                ps.report_noloc(m.mt, args)
            set i: i + 1
        }
    }

    ; CatalogParser::parseCatalog driven from the outside (the port's
    ; CatalogParser is a pure collector): open + decode one catalog file,
    ; scan it into `cat`, replay its diagnostics, then recurse into its
    ; CATALOG chain requests (each must exist; a failed open reports at the
    ; CATALOG entry's location — the reference's ParentLocationMessenger).
    ; `chain` is the inclusion ancestry for the loop check; a file already in
    ; its own ancestry reports inLoop at its inclusion location and parses no
    ; further (the reference break at the first CATALOG entry).
    ; `spec` resolves like any storage object: against its base file's
    ; directory first (empty for command-line catalogs — the CWD), then each
    ; -D/SGML_SEARCH_PATH directory (probed: a -c catalog living only in a
    ; -D directory IS found); `search` is off for the document's implicit
    ; `catalog` (the reference's resolveRelative(..., 0) there). -R filters
    ; unsafe candidates. A must-exist miss reports the reference's message
    ; split (openSystemCall / cannotFind) — location-less for command-line
    ; catalogs, at the CATALOG entry for chained ones.
    function parse_catalog_file(host: ref[Page], ps: ref[ParserState], cat: ref[EntityCatalog], spec: String, base_file: String, search: bool, must_exist: bool, chain: ref[CatChain]?, has_incl: bool, incl_loc: Location)
    {
        var absolute false
        if spec.get_length() > 0
        {
            if spec.get(0) = 0x2F
                set absolute: true
        }
        let cands Array[String]^host()
        var single true
        if absolute or (search = false)
            cands.add(spec)
        else
        {
            var base_dir String()
            if base_file.get_length() > 0
                set base_dir: Path.get_directory_name(base_file)
            cands.add(EntityCatalog.resolve_target(base_dir, spec))
            let cfg ps.get_em_config()
            if cfg <> null
            {
                let sds cfg.search_dirs
                if sds <> null
                {
                    let nsd sds.get_length()
                    if nsd > 0
                        set single: false
                    var k: size_t 0
                    while k < nsd
                    {
                        let sd2 sds[k]
                        cands.add(EntityCatalog.resolve_target(sd2, spec))
                        set k: k + 1
                    }
                }
            }
        }
        var restrict false
        let cfg2 ps.get_em_config()
        if cfg2 <> null
            set restrict: cfg2.restrict_reading

        var hpath String^host(String())
        var found false
        let tried Array[u8]^host()
        var tried_any false
        var perr: pointer[const_char] null
        let nc cands.get_length()
        var ci: size_t 0
        while (found = false) and (ci < nc)
        {
            let cand cands[ci]
            var skip false
            if restrict
            {
                ; is_safe_path is a Parser member; replicate the check via a
                ; throwaway Parser? — no: the static walk uses the config
                ; directly through the shared helper below.
                if Parser.path_safe(ps, cand) = false
                    set skip: true
            }
            if skip = false
            {
                let hc String^host(cand)
                let f fopen(hc.to_c_string(), "rb")
                if f <> null
                {
                    let closed fclose(f)
                    set hpath: hc
                    set found: true
                }
                else
                {
                    set perr: strerror(scaly_eio_errno())
                    if single and (restrict = false)
                    {
                        if must_exist
                        {
                            var args Vector[MessageArg](2)
                            set *(args.get(0)): MessageArg.Str(Parser.widen_arg(host, cand))
                            set *(args.get(1)): MessageArg.Raw(StringC(perr))
                            if has_incl
                                ps.report_at(PosixStorageMessages.openSystemCall(), args, incl_loc)
                            else
                                ps.report_noloc(PosixStorageMessages.openSystemCall(), args)
                        }
                        return
                    }
                    if restrict = false
                    {
                        if tried_any
                        {
                            tried.add(0x2C)
                            tried.add(0x20)
                        }
                        tried.add(0x22)
                        var ti: size_t 0
                        while ti < cand.get_length()
                        {
                            tried.add(cand.get(ti))
                            set ti: ti + 1
                        }
                        tried.add(0x22)
                        set tried_any: true
                    }
                }
            }
            set ci: ci + 1
        }
        if found = false
        {
            if must_exist
            {
                var fargs Vector[MessageArg](2)
                set *(fargs.get(0)): MessageArg.Str(Parser.widen_arg(host, spec))
                let tstr String^host(tried.get_buffer() as pointer[const_char], tried.get_length())
                set *(fargs.get(1)): MessageArg.Raw(Parser.widen_arg(host, *tstr))
                if has_incl
                    ps.report_at(PosixStorageMessages.cannotFind(), fargs, incl_loc)
                else
                    ps.report_noloc(PosixStorageMessages.cannotFind(), fargs)
            }
            return
        }
        let text File.read_to_string(*hpath)

        let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        ; a CATALOG-chained sub-catalog's origin carries its inclusion
        ; location as parent (parseCatalog's InputSourceOrigin::make(
        ; subSysidLocs[i])): the -e walk treats the unNAMED external origin
        ; as transparent and re-anchors a message in the sub-catalog at the
        ; parent's include entry via the additive index arm (bug-for-bug:
        ; message index + parent index, e.g. inLoop at loopa.cat:1:17).
        if has_incl
            set *org: Origin(incl_loc)
        else
            set *org: Origin()
        org.set_file_name(StringC^host(hpath.to_c_string()))
        let src Parser.make_char_source_cs(host, text, org, ps.input_coding())

        let cat_dir Path.get_directory_name(*hpath)
        var in_loop false
        if chain <> null
            set in_loop: chain.contains(*hpath)
        let link host.allocate(sizeof CatChain, alignof CatChain) as pointer[CatChain]
        set *link: CatChain(*hpath, chain)

        let msgs Array[CatMsg]^host()
        let subs Array[SubCatalog]^host()
        let cp CatalogParser()
        cp.parse_into(host, cat, org.get_contents(), org.get_buf_length(), org, cat_dir, *hpath, in_loop, incl_loc, msgs, subs)
        cat.end_catalog()
        Parser.replay_catalog_msgs(host, ps, msgs)

        let nsubs subs.get_length()
        var si: size_t 0
        while si < nsubs
        {
            let sub subs[si]
            Parser.parse_catalog_file(host, ps, cat, sub.raw, *hpath, true, true, link, true, sub.loc)
            set si: si + 1
        }
    }

    ; error_limit: ParserApp::errorLimit_ (-E, 0 = unlimited); reporter_options:
    ; the REP_* mask (-e/-g/-n/-x); msg_fd: the message sink (-f, default 2);
    ; prolog_only: -p (cancel at end-prolog).
    ; doc_specs: the file arguments (null = stdin, doc_bytes/doc_name carry
    ; the pre-read `<OSFD>0` content). The document opens HERE, after the
    ; catalog build (Parser.cxx:67-99): -C maps it through the catalogs'
    ; DOCUMENT entry, search dirs and -R apply, and open failures report
    ; through the parser Messenger (no ESIS at all on a failed open).
    ; parse a document to its ParserState (events populated), stopping before
    ; the ESIS/RAST rendering — the seam both the onsgmls driver (Esis.write)
    ; and the dazzle style engine (DssslSpecEventHandler walk over ps.events)
    ; consume. Returns the ParserState; *early_empty is set true on the error
    ; paths that produce NO output (a cannot-open/first-get-fail document), so
    ; the ESIS wrapper reproduces the reference's empty stdout exactly (a
    ; feature-info-only Esis.write would otherwise differ). arc_names, rast and
    ; out_conforming behave as before (the transform mutates ps.events in place;
    ; the caller renders).
    function parse_document_to_state(host: ref[Page], doc_bytes: String, base_dir: String, doc_name: StringC, prog_name: String, output_utf8: bool, out_enc: ref[OutputEncoder]?, charset_fixed: bool, active_links: ref[Array[String]]?, options: ref[ParserOptions]?, error_limit: u32, reporter_options: u32, output_flags: u32, msg_fd: int, prolog_only: bool, rast: bool, em_cfg: ref[EmConfig], doc_specs: ref[Array[String]]?, out_conforming: ref[bool], arc_names: ref[Array[String]]?, stream_esis: bool, stream_cb: pointer[void], stream_ctx: pointer[void], early_empty: ref[bool], app_subdocs: bool, esis_fd: int) returns ref[ParserState]
    {
        set early_empty: false
        ; Record normalization (ExtendEntityManager, `lf` record type — the whole
        ; Unix corpus): insert one RS (0x0A) at the entity start, and translate
        ; each source LF (0x0A) to RE (0x0D). Content newlines then tokenize as
        ; tokenRe (record ends the OutputState machine shapes into data); the
        ; leading RS + declaration-subset newlines are separators in prolog modes.
        ; A raw CR (0x0D) already IS the RE char and passes through. (crlf / cr-only
        ; record types are deferred; the corpus is LF.)
        let ps ParserState.make(host, null, 0, PHASE_PROLOG)
        ps.set_prog_name(prog_name)
        ; does the APPLICATION sub-parse a SUBDOC entity reference? onsgmls and
        ; the RAST writer do (SgmlsEventHandler::subdocEntity opens a nested
        ; SgmlParser); the grove and the DSSSL spec reader do not — they see
        ; one SubdocEntityEvent and nothing else.
        ps.set_app_parses_subdocs(app_subdocs)
        ; the -w axis: the driver's ParserOptions (enableWarning already
        ; applied); null keeps the defaults ParserState.make installed.
        if options <> null
            ps.set_options(options)
        ; the output coding systems: out_utf8 (environment) still governs the
        ; stderr encoding; out_enc (environment default or -b override) is the
        ; outputCodingSystem_ the ESIS/RAST writers re-encode through.
        ps.set_output_utf8(output_utf8)
        ps.set_output_encoder(out_enc)
        ps.set_error_limit(error_limit)
        ps.set_reporter_options(reporter_options)
        ; the -o output flags (SgmlsEventHandler outputFlags): the ESIS writer
        ; reads them, and the parser gates the -o-only event payloads.
        ps.set_output_flags(output_flags)
        ps.set_msg_fd(msg_fd)
        ps.set_prolog_only(prolog_only)
        ; -t: the returned string is the RAST file's content instead of the
        ; ESIS stream (XRastEventHandler replaces SgmlsEventHandler); the
        ; parse-time RAST semantics key off ps.rast.
        if rast
            ps.set_rast(RastShared.make(host))
        ; the EntityApp surface (-D search dirs, -R) — every entity open
        ; resolves through it.
        ps.set_em_config(em_cfg)
        ; the document's directory: every relative SYSTEM id (external DTD subset,
        ; external text entity in content) resolves against it. The declaration
        ; base starts here too and follows the external subset while it is
        ; parsed. (Re-stamped below once a file document resolves — the -C
        ; DOCUMENT mapping and the -D search change it.)
        var eff_base String^host(base_dir)
        ps.set_base_dir(*eff_base)
        ps.set_decl_base_dir(*eff_base)
        ; -a link-type activation (ParserApp.cxx:58, activateLinkType before
        ; the parse): each 8-bit argument widens into a StringC; case folding
        ; happens lazily at first use (shouldActivateLink).
        if active_links <> null
        {
            let nal active_links.get_length()
            var ali: size_t 0
            while ali < nal
            {
                let alv active_links[ali]
                let aln alv.get_length()
                let alb host.allocate(aln * 4, 4) as pointer[u32]
                var alj: size_t 0
                while alj < aln
                {
                    set *(alb + alj): alv.get(alj) as u32
                    set alj: alj + 1
                }
                ps.add_active_link_type(StringC(alb, aln))
                set ali: ali + 1
            }
        }

        ; ---- the SGML declaration (Parser::doInit, parseSd.cxx:144) --------
        ; A PROVISIONAL Sd + reference Syntax parse the declaration itself
        ; (ParserOptions defaults: SHORTTAG YES, OMITTAG YES, FORMAL YES; the
        ; SD-parsing syntax keeps the Syntax-ctor REFERENCE quantities).
        var sd: ref[Sd]? null
        set sd: host.allocate(sizeof Sd, alignof Sd) as pointer[Sd]
        set *sd: Sd()
        sd.set_formal(true)
        ; RANK YES is the ParserOptions default (Parser.cxx:39, opt.rank=1), so
        ; the implied SGML declaration enables the RANK feature.
        sd.set_rank(true)
        ; the SUBDOC quantity default (Parser.cxx:46, opt.subdoc = 99999999):
        ; a catalog-less document admits subdocuments (so a SUBDOC entity
        ; declaration does NOT trip subdocEntity, and subdocLevel never fires).
        sd.set_subdoc(99999999)
        ; the LINK feature defaults (ParserOptions.cxx:21, Parser.cxx:42-44):
        ; the implied declaration admits SIMPLE YES 1000, IMPLICIT YES,
        ; EXPLICIT YES 1.
        sd.set_number_feature(SDNF_SIMPLE, 1000)
        sd.set_boolean_feature(SDF_IMPLICIT, true)
        sd.set_number_feature(SDNF_EXPLICIT, 1)
        ; setSdOverrides on the implied/provisional Sd (Parser.cxx:48) — the
        ; -w validation flags apply even while the SGML declaration parses.
        Parser.apply_sd_overrides(ps.get_options(), sd)
        ; the document charset machinery (Parser.cxx:46-52): the implied
        ; declaration — one section with an EMPTY public id declaring
        ; 0..charMax — and the system-charset identity mapping. An explicit
        ; CHARSET section replaces both on the BUILT sd.
        sd.set_doc_charset_decl(CharsetDecl.make_implied(host))
        sd.set_doc_charset_desc(UnivCharsetDesc.make_system(host))
        ; SP_CHARSET_FIXED=YES/1 (the driver's charset_fixed): the internal
        ; charset is the FIXED system charset, no longer the document charset.
        if charset_fixed
            sd.set_internal_charset_is_doc_charset(false)
        var syn: ref[Syntax]? null
        set syn: Syntax^host(*sd)
        ps.set_sd(sd)
        ps.set_syntax(syn)

        ; ---- streaming event delivery (memory Front B) ---------------------
        ; Only the plain paths stream; RAST/-A/-a/-p need the whole event
        ; queue (see ParserState.streaming). The sink exists before the
        ; parse; the do_content pump drains chunks into it — the ESIS writer
        ; (stream_esis) or a custom callback sink (stream_cb, e.g. the
        ; dazzle grove builder).
        if stream_esis or (stream_cb <> null)
        {
            if rast = false
            {
                var stream_ok true
                if prolog_only
                    set stream_ok: false
                if arc_names <> null
                {
                    if arc_names.get_length() > 0
                        set stream_ok: false
                }
                if active_links <> null
                {
                    if active_links.get_length() > 0
                        set stream_ok: false
                }
                if stream_ok
                {
                    if stream_esis
                    {
                        let w Esis.begin(host, ps, esis_fd)
                        ps.enable_streaming(w as pointer[void])
                    }
                    else
                        ps.enable_streaming_cb(stream_cb, stream_ctx)
                }
            }
        }

        let parser Parser.make(host, ps)
        let table ModeInfo.build_table(host)

        ; ---- the entity catalog (SOCatalogManagerImpl::makeCatalog) --------
        ; ONE merged catalog per run, files in the reference order: the -c/-m
        ; command-line catalogs (must exist — a missing one reports the
        ; location-less openSystemCall E and counts), then the document's
        ; implicit `catalog` (unless SP_USE_DOCUMENT_CATALOG said NO), then
        ; the SGML_CATALOG_FILES entries (silent when missing). CATALOG
        ; entries chain depth-first after their own file, with the ancestry
        ; loop check. The catalog is installed even when empty — lookups on a
        ; catalog with no entries all miss, like the reference's.
        let catalog EntityCatalog.make(host)
        var n_must: size_t 0
        var n_cats: size_t 0
        set n_must: em_cfg.n_must_exist
        let cs em_cfg.catalog_sysids
        if cs <> null
            set n_cats: cs.get_length()
        var ci: size_t 0
        while ci < n_must
        {
            if ci < n_cats
            {
                let cs2 em_cfg.catalog_sysids
                let cp cs2[ci]
                Parser.parse_catalog_file(host, ps, catalog, cp, String(), true, true, null, false, Location())
            }
            set ci: ci + 1
        }
        var use_doc_cat true
        var map_doc false
        set use_doc_cat: em_cfg.use_doc_catalog
        set map_doc: em_cfg.map_catalog_document
        if map_doc and (doc_specs <> null)
        {
            ; -C (SOCatalogManagerImpl::addCatalogsForDocument, maps arm):
            ; the file arguments ARE catalogs — parse them (must exist) into
            ; the merged catalog; the document comes from their first
            ; DOCUMENT entry. The implicit `catalog` file is NOT consulted.
            let nds doc_specs.get_length()
            var di: size_t 0
            while di < nds
            {
                let dsp doc_specs[di]
                Parser.parse_catalog_file(host, ps, catalog, dsp, String(), true, true, null, false, Location())
                set di: di + 1
            }
        }
        else if use_doc_cat and (doc_specs <> null)
        {
            ; the implicit `catalog` beside EVERY file argument AS GIVEN
            ; (SOCatalogManagerImpl::addCatalogsForDocument loops the parsed
            ; sysid's storage objects, resolveRelative against each spec, no
            ; search), DEDUPED on the resolved path. The fd-0 pseudo-spec
            ; contributes NOTHING: the reference gates on
            ; storageManager->inheritable(), and the fd manager is not —
            ; a stdin document consults NO implicit catalog (S54 root cause:
            ; the port used to read the CWD's `catalog` here, so a stray
            ; cwd catalog's SGMLDECL silently re-declared stdin parses).
            let seen_cats Array[String]^host()
            let ndc0 doc_specs.get_length()
            var dc0: size_t 0
            while dc0 < ndc0
            {
                let spx doc_specs[dc0]
                if Parser.spec_is_fd0(spx) = false
                {
                    var cat_path String("catalog")
                    let spdir Path.get_directory_name(spx)
                    if spdir.get_length() > 0
                        set cat_path: Path.join(spdir, String("catalog"))
                    var dup false
                    let nsc seen_cats.get_length()
                    var sc: size_t 0
                    while sc < nsc
                    {
                        if (seen_cats[sc]).equals(cat_path)
                            set dup: true
                        set sc: sc + 1
                    }
                    if dup = false
                    {
                        seen_cats.add(cat_path)
                        Parser.parse_catalog_file(host, ps, catalog, cat_path, String(), false, false, null, false, Location())
                    }
                }
                set dc0: dc0 + 1
            }
        }
        set ci: n_must
        while ci < n_cats
        {
            let cs3 em_cfg.catalog_sysids
            let cp2 cs3[ci]
            Parser.parse_catalog_file(host, ps, catalog, cp2, String(), true, false, null, false, Location())
            set ci: ci + 1
        }
        ps.set_entity_catalog(catalog)

        ; ---- open the document (Parser.cxx:81-99) --------------------------
        ; stdin arrives pre-read (doc_specs null); a file document resolves
        ; here: with -C through the catalogs' DOCUMENT entry (noDocumentEntry
        ; E + no ESIS at all when absent), then the storage candidate walk
        ; (the spec, then each -D search dir; -R filters; failures report
        ; location-less openSystemCall / cannotFind). The FOUND path becomes
        ; the displayed storage id and its directory the base.
        var doc_text String^host(doc_bytes)
        var doc_id doc_name
        ; the resolved FILE the document entity lives in, empty for stdin (which
        ; arrives pre-read and cannot be seeked). Non-empty means the source can
        ; stream off disk instead of holding the object's bytes for the run — the
        ; whole-object read then happens only if streaming declines.
        var doc_path String()
        ; the document storage object's read-block size (stdin = fd 0's).
        var doc_block: size_t scaly_eio_blksize_fd(0) as size_t
        ; the multi-file (mergeSystemIds) document's prebuilt buffer +
        ; storage-object table; null/0 = the historical single-file path.
        var multi_segs: ref[Array[DocSegment]]? null
        var multi_bounds: ref[Array[size_t]]? null
        var multi_buf: pointer[u32] null
        var multi_out: size_t 0
        var multi false
        if doc_specs <> null
        {
            if map_doc = false
            {
                if doc_specs.get_length() > 1
                    set multi: true
            }
        }
        if (doc_specs <> null) and (multi = false)
        {
            var dspec String()
            if map_doc
            {
                let mapped catalog.lookup_document()
                if mapped.get_length() = 0
                {
                    ; noDocumentEntry %1 = the catalogs' FSI (unparse).
                    let cfsi Array[u8]^host()
                    let nds2 doc_specs.get_length()
                    var d2: size_t 0
                    while d2 < nds2
                    {
                        let osf String("<OSFILE>")
                        var oi: size_t 0
                        while oi < osf.get_length()
                        {
                            cfsi.add(osf.get(oi))
                            set oi: oi + 1
                        }
                        let sp3 doc_specs[d2]
                        var si3: size_t 0
                        while si3 < sp3.get_length()
                        {
                            cfsi.add(sp3.get(si3))
                            set si3: si3 + 1
                        }
                        set d2: d2 + 1
                    }
                    let cfstr String^host(cfsi.get_buffer() as pointer[const_char], cfsi.get_length())
                    var nargs Vector[MessageArg](1)
                    set *(nargs.get(0)): MessageArg.Str(Parser.widen_arg(host, *cfstr))
                    ps.report_noloc(CatalogMessages.noDocumentEntry(), nargs)
                    set out_conforming: false
                    set early_empty: true
                    return ps
                }
                set dspec: mapped
            }
            else
            {
                if doc_specs.get_length() > 0
                    set dspec: *(doc_specs.get_buffer())
            }
            ; the candidate walk (spec, then search dirs; -R filter).
            var rpath String()
            var risf false
            var rdet String()
            if parser.resolve_doc_file(em_cfg, dspec, &rpath, &risf, &rdet) = false
            {
                var eargs Vector[MessageArg](2)
                set *(eargs.get(0)): MessageArg.Str(Parser.widen_arg(host, dspec))
                set *(eargs.get(1)): MessageArg.Raw(Parser.widen_arg(host, rdet))
                if risf
                    ps.report_noloc(PosixStorageMessages.cannotFind(), eargs)
                else
                    ps.report_noloc(PosixStorageMessages.openSystemCall(), eargs)
                set out_conforming: false
                set early_empty: true
                return ps
            }
            let dpath String^host(rpath)
            set doc_block: scaly_eio_blksize_path(dpath.to_c_string()) as size_t
            set doc_path: *dpath
            set doc_id: StringC^host(dpath.to_c_string())
            let dpdir Path.get_directory_name(*dpath)
            set eff_base: String^host(dpdir)
            ps.set_base_dir(*eff_base)
            ps.set_decl_base_dir(*eff_base)
        }
        else if doc_specs <> null
        {
            ; ---- mergeSystemIds: every file argument is ONE storage object
            ;      of the single document entity — per-file storage ids and
            ;      line numbers (the Origin segment table), open failures
            ;      deferred to their boundary crossing (PendingOpen). ----
            let nspec doc_specs.get_length()
            let files Array[DocFileRes]^host()
            var used_stdin false
            var sum_bytes: size_t 0
            var mi: size_t 0
            while mi < nspec
            {
                let msp doc_specs[mi]
                var fr DocFileRes()
                if Parser.spec_is_fd0(msp)
                {
                    ; the fd-0 pseudo-object: pre-read content, `<OSFD>0`
                    ; display id, CWD base; a SECOND fd-0 object reads the
                    ; already-drained stream — empty.
                    set fr.found: true
                    set fr.path: *(String^host("<OSFD>0"))
                    if used_stdin = false
                        set fr.bytes: *(String^host(doc_bytes))
                    set used_stdin: true
                }
                else
                {
                    var rpath2 String()
                    var risf2 false
                    var rdet2 String()
                    if parser.resolve_doc_file(em_cfg, msp, &rpath2, &risf2, &rdet2)
                    {
                        set fr.found: true
                        set fr.path: *(String^host(rpath2))
                        let rb2 File.read_to_string(rpath2)
                        set fr.bytes: *(String^host(rb2))
                    }
                    else
                    {
                        set fr.found: false
                        set fr.path: *(String^host(msp))
                        set fr.is_find: risf2
                        set fr.detail: *(String^host(rdet2))
                    }
                }
                set sum_bytes: sum_bytes + fr.bytes.get_length()
                files.add(fr)
                set mi: mi + 1
            }
            ; one shared normalized buffer (the per-file upper bound summed).
            set multi_buf: host.allocate(((sum_bytes * 2) + (nspec * 2) + 2) * 4, 4) as pointer[u32]
            let segs Array[DocSegment]^host()
            let mbounds Array[size_t]^host()
            var mout: size_t 0
            var mpending true
            var any_fail false
            var mk: size_t 0
            while mk < nspec
            {
                let frv files[mk]
                if frv.found
                {
                    var sg DocSegment()
                    set sg.start: mout
                    let fblk_p String^host(frv.path)
                    var fblk: size_t 8192
                    if frv.path.equals("<OSFD>0") = false
                        set fblk: scaly_eio_blksize_path(fblk_p.to_c_string()) as size_t
                    else
                        set fblk: scaly_eio_blksize_fd(0) as size_t
                    let msw Parser.normalize_append_bounds_cs(host, frv.bytes, multi_buf, &mout, &mpending, mbounds, fblk, ps.input_coding())
                    set sg.starts_with_rs: msw
                    let sgp String^host(frv.path)
                    set sg.name: StringC^host(sgp.to_c_string())
                    let sgd Path.get_directory_name(frv.path)
                    set sg.base_dir: *(String^host(sgd))
                    segs.add(sg)
                }
                else
                {
                    ; queue the failure at the boundary where the object's
                    ; content would have started (fill() reports it there).
                    set any_fail: true
                    ps.queue_pending_open(mout, frv.is_find, Parser.widen_arg(host, frv.path), Parser.widen_arg(host, frv.detail))
                }
                set mk: mk + 1
            }
            set multi_segs: segs
            set multi_bounds: mbounds
            set multi_out: mout
            ; the display id / global base fallbacks: the FIRST FOUND object.
            var stamped false
            var mf: size_t 0
            while mf < nspec
            {
                if stamped = false
                {
                    let frf files[mf]
                    if frf.found
                    {
                        let fpath String^host(frf.path)
                        set doc_id: StringC^host(fpath.to_c_string())
                        let fdir Path.get_directory_name(*fpath)
                        set eff_base: String^host(fdir)
                        ps.set_base_dir(*eff_base)
                        ps.set_decl_base_dir(*eff_base)
                        set stamped: true
                    }
                }
                set mf: mf + 1
            }
            ; doInit (parseSd.cxx:152): the very first get returning eE with
            ; an access error stops silently — every queued failure reports
            ; (in order), nothing else, no ESIS.
            if (mout = 0) and any_fail
            {
                ps.flush_pending_opens(true)
                set out_conforming: false
                set early_empty: true
                return ps
            }
        }

        ; catalog: SGMLDECL binding for the SD parse (first-wins entry).
        var have_decl false
        var decl_text String()
        var decl_name StringC()
        let decl_path catalog.lookup_sgmldecl()
        if (decl_path.get_length() <> 0) and File.exists(decl_path)
        {
            set decl_text: File.read_to_string(decl_path)
            set decl_name: StringC(decl_path.to_c_string())
            set have_decl: true
        }

        let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org: Origin()
        ; the storage id onsgmls displays for a location in the document entity
        ; (a multi-file document displays per-segment names; file_name is the
        ; first found object's — the fallback).
        org.set_file_name(doc_id)
        var src: ref[InputSource]? null
        if multi
        {
            ; mergeSystemIds: the buffer and segment table were built above.
            org.set_segments(multi_segs)
            org.set_buffer(multi_buf, multi_out, Parser.build_rs_list(host, multi_buf, multi_out))
            org.set_fill_bounds(multi_bounds)
            set src: host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
            set *src: InputSource(org, multi_buf, multi_out)
        }
        else
        {
            ; the document entity streams straight off the file when it has one
            ; (doc_path empty = stdin, which arrives pre-read and cannot be
            ; seeked). Only if streaming declines is the object read whole — that
            ; order is the point of the change: on the corpus's 13.7 MB document
            ; the eager read pinned every input byte on the run region for the
            ; whole parse, even under -p.
            if doc_path.get_length() > 0
            {
                set src: Parser.make_char_source_path_cs(host, doc_path, org, doc_block, ps.input_coding())
                if src = null
                {
                    let dread File.read_to_string(doc_path)
                    set doc_text: String^host(dread)
                }
            }
            if src = null
                set src: Parser.make_char_source_stream_cs(host, doc_text.get_buffer(), doc_text.get_length(), org, doc_block, ps.input_coding())
        }
        ps.push_input(src)

        ; doInit's findMissingMinimum over the initial internal charset
        ; (parseSd.cxx:160): fatal when minimum-data chars are unmappable.
        ; The port's initial charset is the identity system charset, so the
        ; set is always empty — kept for fidelity of the check's shape.
        let init_missing ISet^host()
        let init_internal UnivCharsetDesc.make_system(host)
        parser.find_missing_minimum(init_internal, init_missing)
        if init_missing.is_empty() = false
        {
            let init_arg parser.charset_message_arg(init_missing)
            parser.report_raw_at(ParserMessages.sdMissingCharacters(), init_arg, ps.current_location())
            parser.report0_at(ParserMessages.giveUp(), ps.current_location())
            set out_conforming: false
            return ps
        }

        ; scanForSgmlDecl: the document itself first, then the catalog's
        ; SGMLDECL (badDefaultSgmlDecl when that file is no SGML declaration).
        var sd_found parser.scan_for_sgml_decl()
        if sd_found
        {
            ; parseSd.cxx:171: an explicit in-document SGML declaration warns
            ; under -wexplicit-sgml-decl.
            let opt_ex ps.get_options()
            if opt_ex.warn_explicit_sgml_decl
                parser.report0_at(ParserMessages.explicitSgmlDecl(), ps.current_input().token_start_location())
        }
        if sd_found = false
        {
            let dins ps.current_input()
            dins.unget_token()
            if have_decl
            {
                let dorg host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
                set *dorg: Origin()
                dorg.set_file_name(decl_name)
                let dpin String^host(decl_text)
                let dsrc Parser.make_char_source_stream_cs(host, dpin.get_buffer(), dpin.get_length(), dorg, 8192, ps.input_coding())
                ps.push_input(dsrc)
                if parser.scan_for_sgml_decl()
                    set sd_found: true
                else
                {
                    let dins2 ps.current_input()
                    dins2.unget_token()
                    parser.report0_at(ParserMessages.badDefaultSgmlDecl(), parser.sd_loc())
                    ps.pop_input_stack()
                }
            }
        }
        var sd_failed false
        if sd_found
        {
            parser.install_sd_recognizers(table)
            var new_sd: pointer[Sd] null
            var new_pro: pointer[Syntax] null
            var new_inst: pointer[Syntax] null
            if parser.parse_sgml_decl(&new_sd, &new_pro, &new_inst)
            {
                ps.set_sd(new_sd)
                if new_inst <> new_pro
                    ps.set_syntaxes(new_pro, new_inst)
                else
                    ps.set_syntax(new_pro)
                if ps.get_input_level() = 2
                    ps.pop_input_stack()
            }
            else
            {
                set sd_failed: true
                ; Parser::giveUp (Parser.cxx:183) — the SD parse is fatal.
                parser.report0_at(ParserMessages.giveUp(), parser.sd_loc())
            }
        }
        else
        {
            ; implySgmlDecl: the implied declaration parses with the OPTIONS
            ; quantities (NAMELEN 99999999, LITLEN 24000, ...), not the
            ; reference set the Syntax ctor installs — and with the refSyntax
            ; spec's Figure-4 shortref delimiters (options().shortref default).
            syn.set_options_quantities()
            parser.add_implied_shortref_delims(syn)
            ; ... and the spec's added function (coreFunctions: TAB SEPCHAR 9),
            ; so `&#TAB;` resolves in literals under the implied declaration.
            syn.add_function_char(StringC("TAB"), cSEPCHAR, 9)
        }

        parser.install_recognizers(table)

        var ok false
        if sd_failed = false
            set ok: parser.parse_document(table, *eff_base)
        ; multi-file document: report every queued open failure whose boundary
        ; reading actually crossed (a give-up/cancel that never reached a
        ; missing object stays silent about it, like the reference's unopened
        ; storage object).
        ps.flush_pending_opens(false)
        ; errorLimitExceeded (ParserApp.cxx): after the parse, if the error count
        ; reached the limit (-E overrides the 200 default; 0 = unlimited), emit
        ; the locationless Info line (once). onsgmls prints this last, after
        ; every queued diagnostic.
        ; -A architectural-form processing: replace the base event stream with
        ; the selected architecture's generated stream before rendering.
        if arc_names <> null
            ArcEngine.transform(host, ps, arc_names)
        let elim ps.get_error_limit()
        if (elim <> 0) and (ps.get_n_errors() >= elim)
            ps.report_error_limit(elim)
        let conforming ok and (ps.get_n_errors() = 0)
        set out_conforming: conforming
        ps
    }

    ; parse a document and render its ESIS/RAST — the onsgmls driver's entry.
    ; A thin wrapper over parse_document_to_state that renders the returned
    ; ParserState exactly as before (byte-identical: the empty-output error
    ; paths stay empty via early_empty; every other path renders ps).
    function parse_to_esis(host: ref[Page], doc_bytes: String, base_dir: String, doc_name: StringC, prog_name: String, output_utf8: bool, out_enc: ref[OutputEncoder], charset_fixed: bool, active_links: ref[Array[String]], options: ref[ParserOptions], error_limit: u32, reporter_options: u32, output_flags: u32, msg_fd: int, prolog_only: bool, rast: bool, em_cfg: ref[EmConfig], doc_specs: ref[Array[String]], out_conforming: ref[bool], arc_names: ref[Array[String]], esis_fd: int) returns String
    {
        var early_empty false
        let ps Parser.parse_document_to_state(host, doc_bytes, base_dir, doc_name, prog_name, output_utf8, out_enc, charset_fixed, active_links, options, error_limit, reporter_options, output_flags, msg_fd, prolog_only, rast, em_cfg, doc_specs, out_conforming, arc_names, true, null, null, &early_empty, true, esis_fd)
        if rast
            return Rast.write(host, ps)
        if early_empty
            return String()
        Esis.write(host, ps, out_conforming)
    }

    ; parse_simple — the dazzle style engine's convenience entry: parse a
    ; document FILE to a ParserState with the reference defaults (no RAST, no
    ; architecture, default options, the CWD catalog only). The document is
    ; opened via the doc_specs storage-candidate walk — the same working path
    ; onsgmls uses for a file argument — so the reference concrete syntax's
    ; reserved names and the internal DTD subset parse correctly. (The
    ; doc_bytes/stdin path has a pre-existing reserved-name defect; see the
    ; opensp completeness backlog.) The DssslSpecEventHandler walks ps.events.
    function parse_simple(host: ref[Page], doc_path: String, prog_name: String) returns ref[ParserState]
    {
        let em host.allocate(sizeof EmConfig, alignof EmConfig) as pointer[EmConfig]
        set *em: EmConfig()
        let specs Array[String]^host()
        specs.add(String^host(doc_path))
        let doc_name StringC^host(doc_path.to_c_string())
        var conforming false
        var early_empty false
        Parser.parse_document_to_state(host, String(), String(), doc_name, prog_name, true, null, false, null, null, 0, 0, 0, 2, false, false, em, specs, &conforming, null, false, null, null, &early_empty, false, -1)
    }

    ; parse_simple with a streaming sink: cb (C-shaped fn(ParserState*)->void*,
    ; called via scaly_call_ptr at every chunk drain) consumes queued events
    ; [get_drained(), n_events()) and reaches its own state via get_stream_w()
    ; = ctx; the event scratch region resets after each drain, so the sink
    ; must deep-copy anything it keeps (run-page payloads like AttributeList
    ; pointers are safe — only Event records + their data StringCs live on
    ; the scratch). The caller consumes the final tail after this returns.
    ; This is the dazzle CLI's DOCUMENT parse — unlike the spec parses
    ; (parse_simple/parse_simple_cat, reference: DssslSpecEventHandler's
    ; unlimited ErrorCountEventHandler), it carries ParserApp's error limit
    ; (-E; default 200 = DEFAULT_ERROR_LIMIT, 0 = unlimited; processSysid sets
    ; it on the handler, generateEvents prints errorLimitExceeded once it's
    ; reached), plus the rest of the ParserApp/EntityApp option surface the
    ; dazzle CLI scans (-w/-i ParserOptions, -e/-g/-n/-x reporter options,
    ; -a active links, -A architectures, -c/-C/-D/-R + env EmConfig, -f
    ; message fd). doc_specs null = the pre-read doc_bytes/stdin path
    ; (`<OSFD>0`); doc_bytes is ignored when doc_specs is set. Non-empty
    ; arc_names/active_links disable the chunk streaming internally (the
    ; ArcEngine transform replaces the whole event stream after the parse),
    ; so the caller's post-parse feed sees the full transformed queue.
    function parse_simple_stream(host: ref[Page], doc_bytes: String, doc_specs: ref[Array[String]], doc_name: StringC, prog_name: String, cb: pointer[void], ctx: pointer[void], error_limit: u32, options: ref[ParserOptions], reporter_options: u32, active_links: ref[Array[String]], arc_names: ref[Array[String]], em_cfg: ref[EmConfig], msg_fd: int) returns ref[ParserState]
    {
        var conforming false
        var early_empty false
        ; charset_fixed = TRUE, unconditionally: the DSSSL app REQUIRES the
        ; unicode internal code (`DssslApp: GroveApp("unicode")`), and
        ; CmdLineApp::initCodingSystem clears internalCharsetIsDocCharset_
        ; whenever a required internal code is set — with no environment
        ; variable involved. So a dazzle parse always translates the document
        ; charset, which is what makes a character reference into an UNUSED
        ; range a NON-SGML character (and a non-sgml grove node) where the
        ; 8-bit onsgmls build takes them all for SGML characters. Measured
        ; against both reference binaries; tests/dazzle/grove/props5 pins it.
        Parser.parse_document_to_state(host, doc_bytes, String(), doc_name, prog_name, true, null, true, active_links, options, error_limit, reporter_options, 0, msg_fd, false, false, em_cfg, doc_specs, &conforming, arc_names, false, cb, ctx, &early_empty, false, -1)
    }

    ; parse_simple with an explicit (must-exist) catalog file — resolves PUBLIC
    ; external ids through it (SYSTEM entries stay relative to their declaring
    ; file, as always). The dazzle CLI needs this to resolve the DSSSL
    ; style-sheet DTD's PUBLIC id to the shipped style-sheet.dtd (which in turn
    ; declares the DSSSL architecture notation the spec-reader gates on). A
    ; blank catalog path degrades to plain parse_simple behaviour.
    ; extra_cats/search_dirs/restrict: the CLI's -c/-D/-R surface (EntityApp:
    ; -c catalogs are must-exist and consulted BEFORE the bundled default,
    ; mirroring `-c ...` before the compiled-in catalog path). Nulls/false =
    ; the historical single-catalog behaviour (DssslSpecEventHandler).
    function parse_simple_cat(host: ref[Page], doc_path: String, prog_name: String, catalog_path: String, extra_cats: ref[Array[String]]?, search_dirs: ref[Array[String]]?, restrict_reading: bool) returns ref[ParserState]
    {
        let em host.allocate(sizeof EmConfig, alignof EmConfig) as pointer[EmConfig]
        set *em: EmConfig()
        let cats Array[String]^host()
        var n_must: size_t 0
        if extra_cats <> null
        {
            let nx extra_cats.get_length()
            var xi: size_t 0
            while xi < nx
            {
                cats.add(extra_cats[xi])
                set xi: xi + 1
            }
            set n_must: nx
        }
        if catalog_path.get_length() > 0
        {
            cats.add(String^host(catalog_path))
            set n_must: n_must + 1
        }
        set em.catalog_sysids: cats
        set em.n_must_exist: n_must
        if search_dirs <> null
            set em.search_dirs: search_dirs
        set em.restrict_reading: restrict_reading
        let specs Array[String]^host()
        specs.add(String^host(doc_path))
        let doc_name StringC^host(doc_path.to_c_string())
        var conforming false
        var early_empty false
        Parser.parse_document_to_state(host, String(), String(), doc_name, prog_name, true, null, false, null, null, 0, 0, 0, 2, false, false, em, specs, &conforming, null, false, null, null, &early_empty, false, -1)
    }

    ; ---- self-test: parse a synthetic DTD subset, assert the built Dtd -----
    function test() returns int
    {
        let anchor StringC("x")
        let host Page.get(anchor.data_ptr() as pointer[void])

        ; --- assemble the DTD subset text as an in-memory InputSource ---
        ;   <!ELEMENT doc (title, para+)>
        ;   <!ELEMENT title (#PCDATA)>
        ;   <!ELEMENT para (#PCDATA)>
        ;   <!ATTLIST doc id ID #IMPLIED>
        ;   <!ENTITY logo "LOGO">
        ;   <!NOTATION gif SYSTEM "gif.exe">
        let dtext StringC("<!ELEMENT doc - - (title, para+)> <!ELEMENT title - - (#PCDATA)> <!ELEMENT para - - (#PCDATA)> <!ATTLIST doc id ID #IMPLIED> <!ENTITY logo \"LOGO\"> <!NOTATION gif SYSTEM \"gif.exe\"> ]")
        let n dtext.get_size()
        let buf host.allocate(n * 4, 4) as pointer[u32]
        var ci: size_t 0
        while ci < n
        {
            set *(buf + ci): dtext.get(ci)
            set ci: ci + 1
        }

        ; --- ParserState + Sd + Syntax ---
        let ps ParserState.make(host, null, 0, PHASE_DECL_SUBSET)
        let sd host.allocate(sizeof Sd, alignof Sd) as pointer[Sd]
        set *sd: Sd()
        sd.set_doc_charset_decl(CharsetDecl.make_implied(host))
        sd.set_doc_charset_desc(UnivCharsetDesc.make_system(host))
        ps.set_sd(sd)
        let syn Syntax^host(*sd)
        ps.set_syntax(syn)

        ; --- the def/current DTD (document element "DOC" auto-inserted at 1;
        ;     names fold to uppercase under NAMECASE GENERAL YES) ---
        let dtd Dtd.make(host, StringC("DOC"), true)
        ps.set_def_dtd(dtd)
        ps.set_current_dtd(dtd)

        ; --- recognizers + input source ---
        let parser Parser.make(host, ps)
        let table ModeInfo.build_table(host)
        parser.install_recognizers(table)

        let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org: Origin()
        let src host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
        set *src: InputSource(org, buf, n)
        ps.push_input(src)

        ; --- drive the declaration-subset parser (internal subset at level 1) ---
        let rc parser.parse_decl_subset(1, false)
        if rc <> 0
            return -1
        if ps.get_n_errors() <> 0
            return -2

        ; --- assert element types + declared content (folded names) ---
        let doc dtd.lookup_element_type(StringC("DOC"))
        if doc = null
            return -3
        let title dtd.lookup_element_type(StringC("TITLE"))
        if title = null
            return -4
        let para dtd.lookup_element_type(StringC("PARA"))
        if para = null
            return -5
        let doc_def doc.get_definition()
        if doc_def = null
            return -6
        if doc_def.get_declared_content() <> DC_MODEL_GROUP
            return -7
        let title_def title.get_definition()
        if title_def = null
            return -8
        if title_def.get_declared_content() <> DC_MODEL_GROUP
            return -9

        ; --- drive the compiled content model of doc: (title, para+) ---
        let cmg doc_def.compiled_model_group()
        if cmg = null
            return -10
        let ms ContentToken.make_match_state(host, cmg)
        if ContentToken.ms_try_transition(ms, title) = false
            return -11
        if ContentToken.ms_try_transition(ms, para) = false
            return -12
        if ContentToken.ms_is_finished(ms) = false
            return -13
        ; para+ repeats
        if ContentToken.ms_try_transition(ms, para) = false
            return -14

        ; --- assert the ATTLIST on doc ---
        let adl doc.get_attribute_def()
        if adl = null
            return -15
        if adl.size() <> 1
            return -16
        let iddef adl.def(0)
        if iddef = null
            return -17
        if iddef.get_name().equals(StringC("ID")) = false
            return -18

        ; --- assert the ENTITY (NAMECASE ENTITY NO: name stays lowercase) ---
        let logo dtd.lookup_entity(false, StringC("logo"))
        if logo = null
            return -19

        ; --- assert the NOTATION (folded) ---
        let gif dtd.lookup_notation(StringC("GIF"))
        if gif = null
            return -20
        if gif.is_defined() = false
            return -21
        if gif.has_system_id() = false
            return -22

        ; ================= Stage 4: instance parsing =====================
        ; Parse a well-formed instance against the DTD just built and assert the
        ; event stream for  <doc><title>Hi</title><para>X</para></doc>  (names
        ; fold to uppercase): START DOC, START TITLE, "Hi", END TITLE, START
        ; PARA, "X", END PARA, END DOC.
        let itext StringC("<doc id=\"D1\"><title>Hi</title><para>X</para></doc>")
        let ni itext.get_size()
        let ibuf host.allocate(ni * 4, 4) as pointer[u32]
        var ii: size_t 0
        while ii < ni
        {
            set *(ibuf + ii): itext.get(ii)
            set ii: ii + 1
        }

        ; content-mode recognizers, then enter the instance
        parser.install_content_recognizers(table)
        ; drop the (exhausted) declaration-subset input so the instance parses at
        ; input level 1 (end-of-entity there ends the instance).
        ps.pop_input_stack()
        ; the DTD joins the document list (endDtd), and start_instance selects
        ; the base DTD from it.
        ps.end_dtd()
        ps.start_instance(host)

        let iorg host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *iorg: Origin()
        let isrc host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
        set *isrc: InputSource(iorg, ibuf, ni)
        ps.push_input(isrc)

        parser.do_instance_start()
        parser.do_content()

        if ps.get_n_errors() <> 0
            return -30

        ; walk the event queue: match the 6 structural events in order, and sum
        ; the total character-data length (robust to data-token coalescing).
        let n_ev ps.n_events()
        var si: int 0
        var data_total: size_t 0
        var k: size_t 0
        while k < n_ev
        {
            let ev ps.get_event(k)
            let ty ev.get_type()
            if ty = EV_DATA
            {
                let d ev.get_data()
                set data_total: data_total + d.get_size()
            }
            else
            {
                let et ev.get_element_type()
                let nm et.get_name()
                if si = 0
                {
                    if ty <> EV_START_ELEMENT
                        return -31
                    if nm.equals(StringC("DOC")) = false
                        return -32
                }
                else if si = 1
                {
                    if ty <> EV_START_ELEMENT
                        return -33
                    if nm.equals(StringC("TITLE")) = false
                        return -34
                }
                else if si = 2
                {
                    if ty <> EV_END_ELEMENT
                        return -35
                    if nm.equals(StringC("TITLE")) = false
                        return -36
                }
                else if si = 3
                {
                    if ty <> EV_START_ELEMENT
                        return -37
                    if nm.equals(StringC("PARA")) = false
                        return -38
                }
                else if si = 4
                {
                    if ty <> EV_END_ELEMENT
                        return -39
                    if nm.equals(StringC("PARA")) = false
                        return -40
                }
                else if si = 5
                {
                    if ty <> EV_END_ELEMENT
                        return -41
                    if nm.equals(StringC("DOC")) = false
                        return -42
                }
                else
                    return -43
                set si: si + 1
            }
            set k: k + 1
        }
        if si <> 6
            return -44
        if data_total <> 3
            return -45

        ; --- assert the attribute on the <doc> start event ---
        let ev0 ps.get_event(0)
        let atts0 ev0.get_attributes()
        if atts0 = null
            return -46
        let ai atts0.attribute_index(StringC("ID"))
        if ai < 0
            return -47
        let av atts0.value(ai as size_t)
        if av = null
            return -48
        let avs av.get_string()
        if avs.equals(StringC("D1")) = false
            return -49

        ; ============= Stage 4 Increment 3: full document -> ESIS ==========
        ; Drive a whole SGML document (prolog DOCTYPE + internal subset +
        ; instance, ONE InputSource) through parse_document and assert the ESIS
        ; dump is byte-identical to the reference onsgmls output.
        let esis_rc parser_esis_check()
        if esis_rc <> 0
            return esis_rc

        0
    }

    ; a fresh-ParserState full-document drive + ESIS byte comparison.
    function parser_esis_check() returns int
    {
        let anchor StringC("y")
        let host Page.get(anchor.data_ptr() as pointer[void])

        let doc StringC("<!DOCTYPE doc [<!ELEMENT doc - - (title, para+)> <!ELEMENT title - - (#PCDATA)> <!ELEMENT para - - (#PCDATA)> <!ATTLIST doc id ID #IMPLIED>]><doc id=\"D1\"><title>Hi</title><para>X</para></doc>")
        let n doc.get_size()
        let buf host.allocate(n * 4, 4) as pointer[u32]
        var ci: size_t 0
        while ci < n
        {
            set *(buf + ci): doc.get(ci)
            set ci: ci + 1
        }

        let ps ParserState.make(host, null, 0, PHASE_PROLOG)
        let sd host.allocate(sizeof Sd, alignof Sd) as pointer[Sd]
        set *sd: Sd()
        sd.set_doc_charset_decl(CharsetDecl.make_implied(host))
        sd.set_doc_charset_desc(UnivCharsetDesc.make_system(host))
        ps.set_sd(sd)
        let syn Syntax^host(*sd)
        ps.set_syntax(syn)

        let parser Parser.make(host, ps)
        let table ModeInfo.build_table(host)
        parser.install_recognizers(table)

        let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org: Origin()
        let src host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
        set *src: InputSource(org, buf, n)
        ps.push_input(src)

        if parser.parse_document(table, String()) = false
            return -60

        let got Esis.write(host, ps, ps.get_n_errors() = (0 as u32))
        let want String("AID TOKEN D1\n(DOC\n(TITLE\n-Hi\n)TITLE\n(PARA\n-X\n)PARA\n)DOC\nC\n")
        if got.equals(want) = false
            return -61
        0
    }
}
