        if name.equals(StringC("DATA"))
            return R_DATA
        if name.equals(StringC("DEFAULT"))
            return R_DEFAULT
        if name.equals(StringC("DOCTYPE"))
            return R_DOCTYPE
        if name.equals(StringC("ELEMENT"))
            return R_ELEMENT
        if name.equals(StringC("EMPTY"))
            return R_EMPTY
        if name.equals(StringC("ENDTAG"))
            return R_ENDTAG
        if name.equals(StringC("ENTITIES"))
            return R_ENTITIES
        if name.equals(StringC("ENTITY"))
            return R_ENTITY
        if name.equals(StringC("FIXED"))
            return R_FIXED
        if name.equals(StringC("ID"))
            return R_ID
        if name.equals(StringC("IDLINK"))
            return R_IDLINK
        if name.equals(StringC("IDREF"))
            return R_IDREF
        if name.equals(StringC("IDREFS"))
            return R_IDREFS
        if name.equals(StringC("IGNORE"))
            return R_IGNORE
        if name.equals(StringC("IMPLICIT"))
            return R_IMPLICIT
        if name.equals(StringC("IMPLIED"))
            return R_IMPLIED
        if name.equals(StringC("INCLUDE"))
            return R_INCLUDE
        if name.equals(StringC("INITIAL"))
            return R_INITIAL
        if name.equals(StringC("LINK"))
            return R_LINK
        if name.equals(StringC("LINKTYPE"))
            return R_LINKTYPE
        if name.equals(StringC("MD"))
            return R_MD
        if name.equals(StringC("MS"))
            return R_MS
        if name.equals(StringC("NAME"))
            return R_NAME
        if name.equals(StringC("NAMES"))
            return R_NAMES
        if name.equals(StringC("NDATA"))
            return R_NDATA
        if name.equals(StringC("NMTOKEN"))
            return R_NMTOKEN
        if name.equals(StringC("NMTOKENS"))
            return R_NMTOKENS
        if name.equals(StringC("NOTATION"))
            return R_NOTATION
        if name.equals(StringC("NUMBER"))
            return R_NUMBER
        if name.equals(StringC("NUMBERS"))
            return R_NUMBERS
        if name.equals(StringC("NUTOKEN"))
            return R_NUTOKEN
        if name.equals(StringC("NUTOKENS"))
            return R_NUTOKENS
        if name.equals(StringC("O"))
            return R_O
        if name.equals(StringC("PCDATA"))
            return R_PCDATA
        if name.equals(StringC("PI"))
            return R_PI
        if name.equals(StringC("POSTLINK"))
            return R_POSTLINK
        if name.equals(StringC("PUBLIC"))
