; A group member of a name/name-token group (with its original spelling + loc).
define NameToken (name: StringC, orig_name: StringC, loc: Location)
{
    init(name: StringC, orig_name: StringC, loc: Location)
    {
        set this.name: name
        set this.orig_name: orig_name
        set this.loc: loc
    }
}

; Param — the workhorse's output (Param.cs), reused/mutated across parseParam
; calls, so page-hosted.
define Param
(
    kind: int
    token: StringC
    orig_token: StringC
    literal_text: pointer[Text]
    lita: bool
    model_group: pointer[CmNode]
    name_tokens: pointer[Array[NameToken]]
    elements: pointer[Array[pointer[ElementType]]]
)
{
    function make(host: pointer[Page]) returns pointer[Param]
    {
        let p host.allocate(sizeof Param, alignof Param) as pointer[Param]
        set p.kind: P_INVALID
        set p.token: StringC()
        set p.orig_token: StringC()
        set p.literal_text: null
        set p.lita: false
        set p.model_group: null
        set p.name_tokens: Array[NameToken]^host()
        set p.elements: Array[pointer[ElementType]]^host()
        p
    }
}

; AllowedParams (Param.cs) — the per-call allowed-parameter set. Built by make +
; allow() (mirroring the C++ ctor). Page-hosted (holds a reserved-name bitset).
define AllowedParams
(
    silent: bool
    mdc_ok: bool
    rni_ok: bool
    dso_ok: bool
    inclusions_ok: bool
    exclusions_ok: bool
    extra_delimiter: int
    group_type: int
    name_start_type: int
    digit_type: int
    nmchar_type: int
    literal_type: int
    reserved_names: pointer[u8]
    main_mode: int
)
{
    function make(host: pointer[Page]) returns pointer[AllowedParams]
    {
        let a host.allocate(sizeof AllowedParams, alignof AllowedParams) as pointer[AllowedParams]
        set a.silent: false
        set a.mdc_ok: false
        set a.rni_ok: false
        set a.dso_ok: false
        set a.inclusions_ok: false
        set a.exclusions_ok: false
        set a.extra_delimiter: P_INVALID
        set a.group_type: P_INVALID
        set a.name_start_type: P_INVALID
        set a.digit_type: P_INVALID
        set a.nmchar_type: P_INVALID
        set a.literal_type: P_INVALID
        set a.main_mode: mdMode
        let rn host.allocate(N_NAMES as size_t, 1) as pointer[u8]
        var i: size_t 0
        while i < (N_NAMES as size_t)
        {
            set *(rn + i): (0 as u8)
            set i: i + 1
        }
        set a.reserved_names: rn
        a
    }

    function allow(this: pointer[AllowedParams], p: int)
    {
        if p = P_INVALID
            return
        if p = P_SILENT
            set this.silent: true
        else if p = P_DSO
            set this.dso_ok: true
        else if p = P_MDC
            set this.mdc_ok: true
        else if p = P_MINUS
        {
            set this.main_mode: mdMinusMode
            set this.extra_delimiter: p
        }
        else if p = P_PERO
        {
            set this.main_mode: mdPeroMode
            set this.extra_delimiter: p
        }
        else if p = P_INCLUSIONS
            set this.inclusions_ok: true
        else if p = P_EXCLUSIONS
            set this.exclusions_ok: true
        else if (p = P_NAMEGROUP) or (p = P_NAMETOKENGROUP) or (p = P_MODELGROUP)
            set this.group_type: p
        else if p = P_NUMBER
            set this.digit_type: p
        else if (p = P_MINIMUMLITERAL) or (p = P_TOKENIZEDATTRIBUTEVALUELITERAL) or (p = P_ATTRIBUTEVALUELITERAL) or (p = P_SYSTEMIDENTIFIER) or (p = P_PARAMLITERAL)
            set this.literal_type: p
        else if (p = P_NAME) or (p = P_ENTITYNAME) or (p = P_PARAMENTITYNAME)
            set this.name_start_type: p
        else if p = P_ATTRIBUTEVALUE
        {
            set this.name_start_type: p
            set this.digit_type: p
            set this.nmchar_type: p
        }
        else if p < P_INDICATED_RESERVED_NAME
        {
            set this.name_start_type: P_RESERVED_NAME
            set *(this.reserved_names + ((p - P_RESERVED_NAME) as size_t)): (1 as u8)
        }
        else
        {
            set this.rni_ok: true
            set *(this.reserved_names + ((p - P_INDICATED_RESERVED_NAME) as size_t)): (1 as u8)
        }
    }

    function reserved_name_allowed(this: AllowedParams, i: int) returns bool
        *(reserved_names + (i as size_t)) <> (0 as u8)

    ; convenience builders (fixed arity; the C++ ctor takes up to 10 codes)
    function a1(host: pointer[Page], p1: int) returns pointer[AllowedParams]
    {
        let a make(host)
        a.allow(p1)
        a
    }
    function a2(host: pointer[Page], p1: int, p2: int) returns pointer[AllowedParams]
    {
        let a make(host)
        a.allow(p1)
        a.allow(p2)
        a
    }
    function a3(host: pointer[Page], p1: int, p2: int, p3: int) returns pointer[AllowedParams]
    {
        let a make(host)
        a.allow(p1)
        a.allow(p2)
        a.allow(p3)
        a
    }
    function a4(host: pointer[Page], p1: int, p2: int, p3: int, p4: int) returns pointer[AllowedParams]
    {
        let a make(host)
        a.allow(p1)
        a.allow(p2)
        a.allow(p3)
        a.allow(p4)
        a
    }
    function a5(host: pointer[Page], p1: int, p2: int, p3: int, p4: int, p5: int) returns pointer[AllowedParams]
    {
        let a make(host)
        a.allow(p1)
        a.allow(p2)
        a.allow(p3)
        a.allow(p4)
        a.allow(p5)
        a
    }
    function a7(host: pointer[Page], p1: int, p2: int, p3: int, p4: int, p5: int, p6: int, p7: int) returns pointer[AllowedParams]
    {
        let a make(host)
        a.allow(p1)
        a.allow(p2)
        a.allow(p3)
        a.allow(p4)
        a.allow(p5)
        a.allow(p6)
        a.allow(p7)
        a
    }
    function a8(host: pointer[Page], p1: int, p2: int, p3: int, p4: int, p5: int, p6: int, p7: int, p8: int) returns pointer[AllowedParams]
    {
        let a make(host)
        a.allow(p1)
        a.allow(p2)
        a.allow(p3)
        a.allow(p4)
        a.allow(p5)
        a.allow(p6)
        a.allow(p7)
        a.allow(p8)
        a
    }
    function an(host: pointer[Page], codes: pointer[int], n: int) returns pointer[AllowedParams]
    {
        let a make(host)
        var i: int 0
        while i < n
        {
            a.allow(*(codes + (i as size_t)))
            set i: i + 1
        }
        a
    }
}

; A parsed group token (Group.cs GroupToken, scoped: no data-tag templates).
define GroupToken
(
    kind: int
    token: StringC
    model: pointer[CmNode]
    content_token: pointer[CmNode]
)
{
    function make(host: pointer[Page]) returns pointer[GroupToken]
    {
        let g host.allocate(sizeof GroupToken, alignof GroupToken) as pointer[GroupToken]
        set g.kind: GT_INVALID
        set g.token: StringC()
        set g.model: null
        set g.content_token: null
        g
    }
}

; AttributeParameter::Type — the classification parse_attribute_parameter returns
; for each token it reads inside a start-tag attribute specification.
define APT_END: int 0
define APT_NAME: int 1
define APT_NAMETOKEN: int 2
define APT_VI: int 3
define APT_RECOVER_UNQUOTED: int 4

; ExternalInputSource::RecordType — how an entity's records are delimited. Detected
; from its first CR/LF (make_char_source); see the record-normalization comment
; there. `unknown`/`crUnknown` are the reference's streaming-only intermediates: a
; whole-buffer source decides in one look.
define RT_LF: int 0
define RT_CRLF: int 1
define RT_CR: int 2
define RT_ASIS: int 3

; Text-item tracking for AttributeValue::handleAsUnterminated (Attribute.cxx:
; 1377) inside parse_literal. The reference iterates the Text's ITEM list and
; remembers the last data item that is not a single space (lastStr/lastLen);
; our Text is a flat buffer, so parse_literal reconstructs the item boundaries
; while it accumulates: contiguous same-origin chars merge into one data item
; (Text::addChar's merge rule), separator-replacement spaces stand alone and
; never become the candidate, and entity boundaries / non-SGML chars RESET the
; candidate (they are non-data items — the reference's `default:` arm).
define HuState (item_start: size_t(0), item_open: bool(false), last_start: size_t(0), last_len: size_t(0), have_last: bool(false), prev_org: pointer[Origin](null), prev_idx: u32(0))
{
    ; close the open data item; a closed item that is not a single space
    ; becomes the candidate last data item.
    function close(this: pointer[HuState], buf: pointer[Array[u32]])
    {
        if this.item_open = false
            return
        set this.item_open: false
        let n buf.get_length() - this.item_start
        if (n = (1 as size_t)) and (*(buf.get_buffer() + this.item_start) = (0x20 as u32))
            return
        set this.last_start: this.item_start
        set this.last_len: n
        set this.have_last: true
    }

    ; a data char is about to be appended at buf's end: merge into the open
    ; item when its location follows contiguously, else start a new item.
    function note_data(this: pointer[HuState], buf: pointer[Array[u32]], loc: Location)
    {
        var merge false
        if this.item_open
        {
            if (loc.get_origin() = this.prev_org) and (loc.get_index() = (this.prev_idx + (1 as u32)))
                set merge: true
        }
        if merge = false
        {
            this.close(buf)
            set this.item_start: buf.get_length()
            set this.item_open: true
        }
        set this.prev_org: loc.get_origin()
        set this.prev_idx: loc.get_index()
    }

    ; a separator-replacement space is about to be appended: it is its own
    ; single-space item — close the open item, leave the candidate untouched.
    function note_space(this: pointer[HuState], buf: pointer[Array[u32]])
        this.close(buf)

    ; a non-data item (entity start/end, non-SGML char): close and RESET.
    function note_reset(this: pointer[HuState], buf: pointer[Array[u32]])
    {
        this.close(buf)
        set this.have_last: false
    }
}

; ---- OMITTAG speculation rollback (Undo.h/Undo.cxx) ------------------------
; While tags are implied the content state is mutated in place; each mutation
; records its inverse. On rollback the entries run newest-first:
;   START_TAG   an element was pushed          -> pop it
;   END_TAG     an element was popped (saved)  -> re-push it
;   TRANSITION  a required transition advanced -> restore the snapshot cursor
define UNDO_START_TAG: int 0
define UNDO_END_TAG: int 1
define UNDO_TRANSITION: int 2

define UndoEntry
(
    kind: int
    element: pointer[OpenElement]
    state: pointer[MatchState]
)

define Parser (host: pointer[Page], ps: pointer[ParserState])
{
    function make(host: pointer[Page], ps: pointer[ParserState]) returns Parser
        Parser(host, ps)

    ; ---- delegating helpers ----------------------------------------------
    function err(this: Parser, code: int)
        ps.message(MessageType(MessageFragment(code as u32, StringC()), Severity.Error))

    ; report a message with REAL text (written to stderr, MessageReporter path).
    ; report0: no arguments; report1: one String argument, substituted for %1
    ; (String args are quoted by the formatter). `mt` is the MessageType from a
    ; GENERATED table (e.g. ParserMessages.elementNotAllowed()) — text, severity
    ; and number all sourced from the reference .msg (see *Messages.scaly).
    function report0(this: Parser, mt: MessageType)
    {
        let args Vector[MessageArg]()
        ps.report(mt, args)
    }

    ; report0 at an explicit location (a captured construct location).
    function report0_at(this: Parser, mt: MessageType, loc: Location)
    {
        let args Vector[MessageArg]()
        ps.report_at(mt, args, loc)
    }

    function report1(this: Parser, mt: MessageType, a1: StringC)
    {
        var args Vector[MessageArg](1 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Str(a1)
        ps.report(mt, args)
    }

    ; report1 at an explicit location (a captured construct location).
    function report1_at(this: Parser, mt: MessageType, a1: StringC, loc: Location)
    {
        var args Vector[MessageArg](1 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Str(a1)
        ps.report_at(mt, args, loc)
    }

    ; E2 with two String args (%1, %2, both quoted) — entityNotationUndefined.
    function report2_at(this: Parser, mt: MessageType, a1: StringC, a2: StringC, loc: Location)
    {
        var args Vector[MessageArg](2 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Str(a1)
        set *(args.get(1 as size_t)): MessageArg.Str(a2)
        ps.report_at(mt, args, loc)
    }

    ; PosixStorageManager's open-failure report, openSystemCall "cannot open %1
    ; (%2)": %1 the effective system id (quoted StringMessageArg), %2 the
    ; strerror text (unquoted — ErrnoMessageArg). Reported at the location of
    ; the reference that opened the entity (ParentLocationMessenger).
    function report_open_failure(this: Parser, sysid: StringC, emsg: pointer[const_char], loc: Location)
    {
        var args Vector[MessageArg](2 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Str(sysid)
        set *(args.get(1 as size_t)): MessageArg.Raw(StringC(emsg))
        ps.report_at(PosixStorageMessages.openSystemCall(), args, loc)
    }

    ; report a message whose %1 is a NUMBER (decimal, unquoted — NumberMessageArg)
    ; at an explicit location.
    function report_num_at(this: Parser, mt: MessageType, a1: u64, loc: Location)
    {
        var args Vector[MessageArg](1 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Num(a1)
        ps.report_at(mt, args, loc)
    }

    ; E2 with %1 Number, %2 String (quoted) — numericCharRefUnknownDesc.
    function report_num_str_at(this: Parser, mt: MessageType, a1: u64, a2: StringC, loc: Location)
    {
        var args Vector[MessageArg](2 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Num(a1)
        set *(args.get(1 as size_t)): MessageArg.Str(a2)
        ps.report_at(mt, args, loc)
    }

    ; two NUMBER args (%1, %2, unquoted) — normalizedAttributeValueLength /
    ; attsplen (the limit, then the actual length).
    function report_num_num_at(this: Parser, mt: MessageType, a1: u64, a2: u64, loc: Location)
    {
        var args Vector[MessageArg](2 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Num(a1)
        set *(args.get(1 as size_t)): MessageArg.Num(a2)
        ps.report_at(mt, args, loc)
    }

    ; %1 String, %2 String, %3 StringVector (each item quoted, ", "-separated)
    ; — attributeValueNotInGroup (value, attribute name, allowed tokens).
    function report2_vec_at(this: Parser, mt: MessageType, a1: StringC, a2: StringC, a3: pointer[Array[StringC]], loc: Location)
    {
        var args Vector[MessageArg](3 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Str(a1)
        set *(args.get(1 as size_t)): MessageArg.Str(a2)
        set *(args.get(2 as size_t)): MessageArg.Vec(a3)
        ps.report_at(mt, args, loc)
    }

    ; E3 with %1 Number, %2 Number, %3 String (quoted) —
    ; numericCharRefUnknownBase (doc number, base number, baseset public id).
    function report_num_num_str_at(this: Parser, mt: MessageType, a1: u64, a2: u64, a3: StringC, loc: Location)
    {
        var args Vector[MessageArg](3 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Num(a1)
        set *(args.get(1 as size_t)): MessageArg.Num(a2)
        set *(args.get(2 as size_t)): MessageArg.Str(a3)
        ps.report_at(mt, args, loc)
    }

    ; E2 with both args pre-rendered (unquoted) — the *InvalidToken messages,
    ; whose args (TokenMessageArg / Allowed*MessageArg) mix quoted delimiter
    ; text with unquoted fragment text; the quotes are already IN the strings.
    function report_raw_raw_at(this: Parser, mt: MessageType, a1: StringC, a2: StringC, loc: Location)
    {
        var args Vector[MessageArg](2 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Raw(a1)
        set *(args.get(1 as size_t)): MessageArg.Raw(a2)
        ps.report_at(mt, args, loc)
    }

    ; E2 with %1 String (quoted), %2 pre-rendered (unquoted) —
    ; markupDeclarationCharacter / groupCharacter (char, allowed list).
    function report_str_raw_at(this: Parser, mt: MessageType, a1: StringC, a2: StringC, loc: Location)
    {
        var args Vector[MessageArg](2 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Str(a1)
        set *(args.get(1 as size_t)): MessageArg.Raw(a2)
        ps.report_at(mt, args, loc)
    }

    ; a single RAW (pre-rendered, unquoted) %1 — endTagInvalidToken.
    function report_raw_at(this: Parser, mt: MessageType, a1: StringC, loc: Location)
    {
        var args Vector[MessageArg](1 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Raw(a1)
        ps.report_at(mt, args, loc)
    }

    ; report0 WITH an auxiliary line at aux_loc — commentEntityEnd
    ; ("comment started here" at the COM that opened the comment).
    function report0_aux(this: Parser, mt: MessageType, loc: Location, aux: MessageFragment, aux_loc: Location)
    {
        let args Vector[MessageArg]()
        let aux_text aux.text
        ps.report_aux(mt, args, loc, aux_text, aux_loc)
    }

    ; ordinal %1 + two quoted names — requiredElementExcluded / invalidExclusion.
    function report_ord2_at(this: Parser, mt: MessageType, n: u64, a1: StringC, a2: StringC, loc: Location)
    {
        var args Vector[MessageArg](3 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Ord(n)
        set *(args.get(1 as size_t)): MessageArg.Str(a1)
        set *(args.get(2 as size_t)): MessageArg.Str(a2)
        ps.report_at(mt, args, loc)
    }

    ; quoted name %1 + quoted name list %2 — missingElementMultiple.
    function report_str_vec_at(this: Parser, mt: MessageType, a1: StringC, v: pointer[Array[StringC]], loc: Location)
    {
        var args Vector[MessageArg](2 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Str(a1)
        set *(args.get(1 as size_t)): MessageArg.Vec(v)
        ps.report_at(mt, args, loc)
    }

    ; The display name of a leaf content token for the ambiguousModel*
    ; family (reportAmbiguity, parseDecl.cxx:748): the element name, or
    ; RNI + PCDATA for the #PCDATA pseudo-element.
    function leaf_token_name(this: Parser, leaf: pointer[CmNode]) returns StringC
    {
        if leaf.element <> null
        {
            let e leaf.element
            return e.get_name()
        }
        let buf Array[u32]^host()
        this.append_delim_chars(buf, dRNI)
        let ps_spell this.reserved_name_spelling(R_PCDATA)
        this.arg_append(buf, ps_spell)
        this.arg_to_string(buf)
    }

    ; Parser::reportAmbiguity (parseDecl.cxx:742): one detected content-model
    ; ambiguity, split over four message shapes by from-token kind and the
    ; number of AND groups that must have been matched (from's AND depth minus
    ; the ambiguity's AND depth). Ordinals are typeIndex + 1.
    function report_ambiguity(this: Parser, from: pointer[CmNode], to1: pointer[CmNode], to2: pointer[CmNode], ambig_and_depth: u32, loc: Location)
    {
        let to_name this.leaf_token_name(to1)
        let to1_index (to1.type_index as u64) + (1 as u64)
        let to2_index (to2.type_index as u64) + (1 as u64)
        if from.is_initial
        {
            var args Vector[MessageArg](3 as size_t)
            set *(args.get(0 as size_t)): MessageArg.Str(to_name)
            set *(args.get(1 as size_t)): MessageArg.Ord(to1_index)
            set *(args.get(2 as size_t)): MessageArg.Ord(to2_index)
            ps.report_at(ParserMessages.ambiguousModelInitial(), args, loc)
            return
        }
        let from_name this.leaf_token_name(from)
        let from_index (from.type_index as u64) + (1 as u64)
        var from_depth: u32 0
        if from.has_and_info
            set from_depth: ContentToken.and_depth_of(from.ai_ancestor)
        let and_matches (from_depth - ambig_and_depth) as u64
        if and_matches = (0 as u64)
        {
            var args Vector[MessageArg](5 as size_t)
            set *(args.get(0 as size_t)): MessageArg.Str(from_name)
            set *(args.get(1 as size_t)): MessageArg.Ord(from_index)
            set *(args.get(2 as size_t)): MessageArg.Str(to_name)
            set *(args.get(3 as size_t)): MessageArg.Ord(to1_index)
            set *(args.get(4 as size_t)): MessageArg.Ord(to2_index)
            ps.report_at(ParserMessages.ambiguousModel(), args, loc)
            return
        }
        if and_matches = (1 as u64)
        {
            var args Vector[MessageArg](5 as size_t)
            set *(args.get(0 as size_t)): MessageArg.Str(from_name)
            set *(args.get(1 as size_t)): MessageArg.Ord(from_index)
            set *(args.get(2 as size_t)): MessageArg.Str(to_name)
            set *(args.get(3 as size_t)): MessageArg.Ord(to1_index)
            set *(args.get(4 as size_t)): MessageArg.Ord(to2_index)
            ps.report_at(ParserMessages.ambiguousModelSingleAnd(), args, loc)
            return
        }
        var args Vector[MessageArg](6 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Str(from_name)
        set *(args.get(1 as size_t)): MessageArg.Ord(from_index)
        set *(args.get(2 as size_t)): MessageArg.Num(and_matches)
        set *(args.get(3 as size_t)): MessageArg.Str(to_name)
        set *(args.get(4 as size_t)): MessageArg.Ord(to1_index)
        set *(args.get(5 as size_t)): MessageArg.Ord(to2_index)
        ps.report_at(ParserMessages.ambiguousModelMultipleAnd(), args, loc)
    }

    ; report1 with a RAW %1 plus an auxiliary line — commentDeclInvalidToken
    ; (TokenMessageArg %1, "comment declaration started here" at the MDO).
    function report_raw_aux(this: Parser, mt: MessageType, a1: StringC, loc: Location, aux: MessageFragment, aux_loc: Location)
    {
        var args Vector[MessageArg](1 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Raw(a1)
        let aux_text aux.text
        ps.report_aux(mt, args, loc, aux_text, aux_loc)
    }

    ; report1 at a location WITH an auxiliary "start tag was here"-style line at
    ; aux_loc (the omitted-end-tag diagnostics). %1 is the String a1 (quoted).
    ; `aux` is the companion fragment from the table (e.g. omitEndTagOmittag_aux()).
    function report1_aux(this: Parser, mt: MessageType, a1: StringC, loc: Location, aux: MessageFragment, aux_loc: Location)
    {
        var args Vector[MessageArg](1 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Str(a1)
        let aux_text aux.text
        ps.report_aux(mt, args, loc, aux_text, aux_loc)
    }

    ; reportNonSgmlCharacter (parseCommon.cxx) in a markup-declaration context
    ; (parseParam / parseGroupToken / parseGroupConnector): if the unrecognized
    ; token is a non-SGML character, report it and return true — the caller then
    ; CONTINUES its loop (the reference `break`s); only a genuine SGML character
    ; falls through to the context's own invalid-character message.
    function report_non_sgml_param(this: Parser) returns bool
    {
        let ins ps.current_input()
        ; the unrecognized token has length 0 — CONSUME the offending character
        ; (the reference's getChar()), so the caller's loop moves past it and
        ; currentToken() carries it into the invalid-character message.
        if ins.current_token_length() = (0 as size_t)
            ins.end_token(1 as size_t)
        let pc ins.current_char()
        if this.is_non_sgml_char(pc)
        {
            let mt ParserMessages.nonSgmlCharacter()
            let loc ins.token_start_location()
            this.report_num_at(mt, pc as u64, loc)
            return true
        }
        false
    }

    ; ---- message-argument builders (TokenMessageArg.cxx / Param.cxx /
    ; Group.cxx) -------------------------------------------------------------
    ; The reference renders these args through MessageBuilder: appendChars
    ; output is QUOTED, appendFragment output (catalog fragments 1000+) is not.
    ; Here each arg is pre-rendered into a StringC with the quotes inline and
    ; passed as MessageArg.Raw.

    function arg_append(this: Parser, buf: pointer[Array[u32]], s: StringC)
    {
        let n s.get_size()
        var i: size_t 0
        while i < n
        {
            let c s.get(i)
            buf.add(c)
            set i: i + 1
        }
    }

    ; appendChars — quoted text.
    function arg_append_quoted(this: Parser, buf: pointer[Array[u32]], s: StringC)
    {
        buf.add(0x22 as u32)
        this.arg_append(buf, s)
        buf.add(0x22 as u32)
    }

    ; the characters of a general delimiter, appended bare.
    function append_delim_chars(this: Parser, buf: pointer[Array[u32]], d: int)
    {
        let syn ps.get_syntax()
        let n syn.delim_general_len(d)
        var i: size_t 0
        while i < n
        {
            let c syn.delim_general_char(d, i)
            buf.add(c)
            set i: i + 1
        }
    }

    ; delimStart fragment + the delimiter's text (quoted): `delimiter "X"`.
    function arg_append_delim(this: Parser, buf: pointer[Array[u32]], d: int)
    {
        this.arg_append(buf, StringC("delimiter "))
        buf.add(0x22 as u32)
        this.append_delim_chars(buf, d)
        buf.add(0x22 as u32)
    }

    ; listSep fragment.
    function arg_append_sep(this: Parser, buf: pointer[Array[u32]], first: pointer[bool])
    {
        if *first
        {
            set *first: false
            return
        }
        this.arg_append(buf, StringC(", "))
    }

    function arg_to_string(this: Parser, buf: pointer[Array[u32]]) returns StringC
        StringC^host(buf.get_buffer(), buf.get_length())

    ; the canonical (reference concrete syntax) spelling of a reserved name —
    ; Syntax::reservedName(i); the inverse of lookup_reserved_name.
    function reserved_name_spelling(this: Parser, rn: int) returns StringC
    {
        if rn = R_ALL
            return StringC("ALL")
        if rn = R_ANY
            return StringC("ANY")
        if rn = R_ATTLIST
            return StringC("ATTLIST")
        if rn = R_CDATA
            return StringC("CDATA")
        if rn = R_CONREF
            return StringC("CONREF")
        if rn = R_CURRENT
            return StringC("CURRENT")
        if rn = R_DATA
            return StringC("DATA")
        if rn = R_DEFAULT
            return StringC("DEFAULT")
        if rn = R_DOCTYPE
            return StringC("DOCTYPE")
        if rn = R_ELEMENT
            return StringC("ELEMENT")
        if rn = R_EMPTY
            return StringC("EMPTY")
        if rn = R_ENDTAG
            return StringC("ENDTAG")
        if rn = R_ENTITIES
            return StringC("ENTITIES")
        if rn = R_ENTITY
            return StringC("ENTITY")
        if rn = R_FIXED
            return StringC("FIXED")
        if rn = R_ID
            return StringC("ID")
        if rn = R_IDLINK
            return StringC("IDLINK")
        if rn = R_IDREF
            return StringC("IDREF")
        if rn = R_IDREFS
            return StringC("IDREFS")
        if rn = R_IGNORE
            return StringC("IGNORE")
        if rn = R_IMPLICIT
            return StringC("IMPLICIT")
        if rn = R_IMPLIED
            return StringC("IMPLIED")
        if rn = R_INCLUDE
            return StringC("INCLUDE")
        if rn = R_INITIAL
            return StringC("INITIAL")
        if rn = R_LINK
            return StringC("LINK")
        if rn = R_LINKTYPE
            return StringC("LINKTYPE")
        if rn = R_MD
            return StringC("MD")
        if rn = R_MS
            return StringC("MS")
        if rn = R_NAME
            return StringC("NAME")
        if rn = R_NAMES
            return StringC("NAMES")
        if rn = R_NDATA
            return StringC("NDATA")
        if rn = R_NMTOKEN
            return StringC("NMTOKEN")
        if rn = R_NMTOKENS
            return StringC("NMTOKENS")
        if rn = R_NOTATION
            return StringC("NOTATION")
        if rn = R_NUMBER
            return StringC("NUMBER")
        if rn = R_NUMBERS
            return StringC("NUMBERS")
        if rn = R_NUTOKEN
            return StringC("NUTOKEN")
        if rn = R_NUTOKENS
            return StringC("NUTOKENS")
        if rn = R_O
            return StringC("O")
        if rn = R_PCDATA
            return StringC("PCDATA")
        if rn = R_PI
            return StringC("PI")
        if rn = R_POSTLINK
            return StringC("POSTLINK")
        if rn = R_PUBLIC
            return StringC("PUBLIC")
        if rn = R_RCDATA
            return StringC("RCDATA")
        if rn = R_RE
            return StringC("RE")
        if rn = R_REQUIRED
            return StringC("REQUIRED")
        if rn = R_RESTORE
            return StringC("RESTORE")
        if rn = R_RS
            return StringC("RS")
        if rn = R_SDATA
            return StringC("SDATA")
        if rn = R_SHORTREF
            return StringC("SHORTREF")
        if rn = R_SIMPLE
            return StringC("SIMPLE")
        if rn = R_SPACE
            return StringC("SPACE")
        if rn = R_STARTTAG
            return StringC("STARTTAG")
        if rn = R_SUBDOC
            return StringC("SUBDOC")
        if rn = R_SYSTEM
            return StringC("SYSTEM")
        if rn = R_TEMP
            return StringC("TEMP")
        if rn = R_USELINK
            return StringC("USELINK")
        if rn = R_USEMAP
            return StringC("USEMAP")
        StringC()
    }

    ; TokenMessageArg::append (TokenMessageArg.cxx): render a token as
    ; `delimiter "X"` / a character-class fragment / `entity end`, resolved
    ; through the mode's token table against the live syntax.
    function token_message_arg(this: Parser, token: u32, mode: int) returns StringC
    {
        if token >= tokenFirstShortref
            return StringC("short reference delimiter")
        if token = tokenEe
            return StringC("entity end")
        let buf Array[u32]^host()
        let table ModeInfo.build_table(host)
        let sdv *ps.get_sd()
        var mi ModeInfo(mode, sdv, table)
        var info TokenInfo()
        var scanning true
        while scanning and mi.next_token(&info)
        {
            if info.token = token
            {
                set scanning: false
                if (info.kind = TT_DELIM) or (info.kind = TT_DELIMDELIM) or (info.kind = TT_DELIMSET)
                    this.arg_append_delim(buf, info.delim1)
                else if info.kind = TT_SET
                {
                    if info.set_idx = setDigit
                        this.arg_append(buf, StringC("digit"))
                    else if info.set_idx = setNameStart
                        this.arg_append(buf, StringC("name start character"))
                    else if info.set_idx = setSepchar
                        this.arg_append(buf, StringC("sepchar"))
                    else if info.set_idx = setS
                        this.arg_append(buf, StringC("separator"))
                    else if info.set_idx = setNmchar
                        this.arg_append(buf, StringC("name character"))
                    else if info.set_idx = setSgmlChar
                        this.arg_append(buf, StringC("data character"))
                    else if info.set_idx = setMinimumData
                        this.arg_append(buf, StringC("minimum data character"))
                    else if info.set_idx = setSignificant
                        this.arg_append(buf, StringC("significant character"))
                }
                else if info.kind = TT_FUNCTION
                {
                    if info.func_idx = fRE
                        this.arg_append(buf, StringC("record end character"))
                    else if info.func_idx = fRS
                        this.arg_append(buf, StringC("record start character"))
                    else if info.func_idx = fSPACE
                        this.arg_append(buf, StringC("space character"))
                }
            }
        }
        this.arg_to_string(buf)
    }

    ; AllowedParamsMessageArg::append (Param.cxx): the "only ..." list of
    ; paramInvalidToken / markupDeclarationCharacter.
    function allowed_params_message_arg(this: Parser, allow: pointer[AllowedParams]) returns StringC
    {
        let buf Array[u32]^host()
        var first true
        if allow.mdc_ok
        {
            this.arg_append_sep(buf, &first)
            this.arg_append_delim(buf, dMDC)
        }
        if allow.dso_ok
        {
            this.arg_append_sep(buf, &first)
            this.arg_append_delim(buf, dDSO)
        }
        if allow.main_mode = mdMinusMode
        {
            this.arg_append_sep(buf, &first)
            this.arg_append_delim(buf, dMINUS)
        }
        else if allow.main_mode = mdPeroMode
        {
            this.arg_append_sep(buf, &first)
            this.arg_append_delim(buf, dPERO)
        }
        if allow.inclusions_ok
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("inclusions"))
        }
        if allow.exclusions_ok
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("exclusions"))
        }
        if allow.literal_type = P_MINIMUMLITERAL
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("minimum literal"))
        }
        else if (allow.literal_type = P_ATTRIBUTEVALUELITERAL) or (allow.literal_type = P_TOKENIZEDATTRIBUTEVALUELITERAL)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("attribute value literal"))
        }
        else if allow.literal_type = P_SYSTEMIDENTIFIER
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("system identifier"))
        }
        else if allow.literal_type = P_PARAMLITERAL
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("parameter literal"))
        }
        if (allow.name_start_type = P_NAME) or (allow.name_start_type = P_ENTITYNAME) or (allow.name_start_type = P_PARAMENTITYNAME)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("name"))
        }
        else if allow.name_start_type = P_ATTRIBUTEVALUE
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("attribute value"))
        }
        if allow.digit_type = P_NUMBER
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("number"))
        }
        if allow.rni_ok or (allow.name_start_type = P_RESERVED_NAME)
        {
            var i 0
            while i < N_NAMES
            {
                if (*(allow.reserved_names + (i as size_t))) <> (0 as u8)
                {
                    this.arg_append_sep(buf, &first)
                    buf.add(0x22 as u32)
                    if allow.rni_ok
                    {
                        let syn ps.get_syntax()
                        let rl syn.delim_general_len(dRNI)
                        var j: size_t 0
                        while j < rl
                        {
                            let rc syn.delim_general_char(dRNI, j)
                            buf.add(rc)
                            set j: j + 1
                        }
                    }
                    let spell this.reserved_name_spelling(i)
                    this.arg_append(buf, spell)
                    buf.add(0x22 as u32)
                }
                set i: i + 1
            }
        }
        this.arg_to_string(buf)
    }

    ; AllowedGroupTokensMessageArg::append (Group.cxx). NB the reference never
    ; clears `first` in the #PCDATA/#ALL/#IMPLICIT arms — reproduced faithfully
    ; (only visible when no fragment precedes them, where it drops a listSep).
    function allowed_group_tokens_message_arg(this: Parser, allow: int) returns StringC
    {
        let buf Array[u32]^host()
        var first true
        if this.has_gt(allow, GT_DATATAGLITERAL)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("parameter literal"))
        }
        if this.has_gt(allow, GT_DATATAGGROUP)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("data tag group"))
        }
        if this.has_gt(allow, GT_MODELGROUP)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("model group"))
        }
        else if this.has_gt(allow, GT_DATATAGTEMPLATEGROUP)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("data tag template group"))
        }
        if this.has_gt(allow, GT_ELEMENTTOKEN)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("element token"))
        }
        else if this.has_gt(allow, GT_NAMETOKEN)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("name token"))
        }
        else if this.has_gt(allow, GT_NAME)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append(buf, StringC("name"))
        }
        let syn ps.get_syntax()
        if this.has_gt(allow, GT_PCDATA)
        {
            if first = false
                this.arg_append(buf, StringC(", "))
            buf.add(0x22 as u32)
            let rl syn.delim_general_len(dRNI)
            var j: size_t 0
            while j < rl
            {
                let rc syn.delim_general_char(dRNI, j)
                buf.add(rc)
                set j: j + 1
            }
            let ps_spell this.reserved_name_spelling(R_PCDATA)
            this.arg_append(buf, ps_spell)
            buf.add(0x22 as u32)
        }
        if this.has_gt(allow, GT_ALL)
        {
            if first = false
                this.arg_append(buf, StringC(", "))
            buf.add(0x22 as u32)
            let rl syn.delim_general_len(dRNI)
            var j: size_t 0
            while j < rl
            {
                let rc syn.delim_general_char(dRNI, j)
                buf.add(rc)
                set j: j + 1
            }
            let all_spell this.reserved_name_spelling(R_ALL)
            this.arg_append(buf, all_spell)
            buf.add(0x22 as u32)
        }
        if this.has_gt(allow, GT_IMPLICIT)
        {
            if first = false
                this.arg_append(buf, StringC(", "))
            buf.add(0x22 as u32)
            let rl syn.delim_general_len(dRNI)
            var j: size_t 0
            while j < rl
            {
                let rc syn.delim_general_char(dRNI, j)
                buf.add(rc)
                set j: j + 1
            }
            let imp_spell this.reserved_name_spelling(R_IMPLICIT)
            this.arg_append(buf, imp_spell)
            buf.add(0x22 as u32)
        }
        this.arg_to_string(buf)
    }

    ; AllowedGroupConnectorsMessageArg::append (Group.cxx): AND, OR, SEQ,
    ; GRPC, DTGC in that order, each as `delimiter "X"`.
    function allowed_group_connectors_message_arg(this: Parser, allow: int) returns StringC
    {
        let buf Array[u32]^host()
        var first true
        if this.has_gc(allow, GC_AND)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append_delim(buf, dAND)
        }
        if this.has_gc(allow, GC_OR)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append_delim(buf, dOR)
        }
        if this.has_gc(allow, GC_SEQ)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append_delim(buf, dSEQ)
        }
        if this.has_gc(allow, GC_GRPC)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append_delim(buf, dGRPC)
        }
        if this.has_gc(allow, GC_DTGC)
        {
            this.arg_append_sep(buf, &first)
            this.arg_append_delim(buf, dDTGC)
        }
        this.arg_to_string(buf)
    }

    ; paramInvalidToken (parseParam.cxx:271) — `%1 invalid: only %2 and
    ; parameter separators are allowed`; suppressed for silent allow sets.
    function param_invalid_token(this: Parser, token: u32, allow: pointer[AllowedParams])
    {
        if allow.silent
            return
        let a1 this.token_message_arg(token, allow.main_mode)
        let a2 this.allowed_params_message_arg(allow)
        this.report_raw_raw_at(ParserMessages.paramInvalidToken(), a1, a2, ps.current_input().token_start_location())
    }

    ; groupTokenInvalidToken (parseParam.cxx:475).
    function group_token_invalid_token(this: Parser, token: u32, allow: int)
    {
        let a1 this.token_message_arg(token, grpMode)
        let a2 this.allowed_group_tokens_message_arg(allow)
        this.report_raw_raw_at(ParserMessages.groupTokenInvalidToken(), a1, a2, ps.current_input().token_start_location())
    }

    ; groupConnectorInvalidToken (parseParam.cxx:589).
    function group_connector_invalid_token(this: Parser, token: u32, allow: int)
    {
        let a1 this.token_message_arg(token, grpMode)
        let a2 this.allowed_group_connectors_message_arg(allow)
        this.report_raw_raw_at(ParserMessages.connectorInvalidToken(), a1, a2, ps.current_input().token_start_location())
    }

    function namelen(this: Parser) returns size_t
        ps.get_syntax().get_quantity(qNAMELEN) as size_t

    ; Syntax::penamelen — NAMELEN less the length of the PERO delimiter.
    function penamelen(this: Parser) returns size_t
    {
        let n this.namelen()
        let pn ps.get_syntax().delim_general_len(dPERO)
        n - pn
    }

    ; void extendNameToken(maxLength, tooLong): grow the current token over
    ; name characters; past maxLength report the site's quantity message
    ; (nameLength / nameTokenLength / parameterEntityNameLength /
    ; attributeValueLength) at the token start.
    function extend_name_token(this: Parser, maxlen: size_t, too_long: MessageType)
    {
        let ins ps.current_input()
        if ins = null
            return
        var length ins.current_token_length()
        let syn ps.get_syntax()
        var scanning true
        while scanning
        {
            let ch ins.token_char()
            if syn.is_name_character(ch as u32) = false
                set scanning: false
            else
                set length: length + (1 as size_t)
        }
        if length > maxlen
            this.report_num_at(too_long, maxlen as u64, ins.token_start_location())
        ins.end_token(length)
    }

    ; folded (namecase general) current token / its original spelling.
    function name_folded(this: Parser) returns StringC
        ps.current_token_subst#(ps.get_syntax())

    ; ---- reserved-name lookup (Syntax.lookupReservedName, resident here) ---
    ; Returns the ReservedName ordinal, or -1 if the (folded) name is not one.
    function lookup_reserved_name(this: Parser, name: StringC) returns int
    {
        if name.equals(StringC("ALL"))
            return R_ALL
        if name.equals(StringC("ANY"))
            return R_ANY
        if name.equals(StringC("ATTLIST"))
            return R_ATTLIST
