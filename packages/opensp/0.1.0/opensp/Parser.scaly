    ; ---- build a StringC from a growing u32 buffer ------------------------
    function build_stringc(this: Parser, buf: pointer[Array[u32]]) returns StringC
    {
        let n buf.get_length()
        if n = (0 as size_t)
            return StringC()
        ; Build the StringC page-resident on `host` (^host) so its init's
        ; Page.get(this) resolves to a valid region page. Constructing it as a
        ; by-VALUE return (StringC(cb, n)) instead puts `this` on a stack sret
        ; slot whose Page.get masks to a bogus, per-call-IDENTICAL header — so
        ; every literal's buffer aliased the same address (the Page.get-on-by-
        ; value hazard). ^host copies buf into a fresh host buffer; *scp returns
        ; the {data,size} value pointing at it.
        let scp StringC^host(buf.get_buffer(), n)
        *scp
    }

    ; StringC (u32 content) -> byte String (ASCII narrowing for external ids).
    function stringc_to_bytes(this: Parser, sc: StringC) returns String
    {
        let n sc.get_size()
        let buf host.allocate(n + (1 as size_t), 1) as pointer[u8]
        var i: size_t 0
        while i < n
        {
            set *(buf + i): sc.get(i) as u8
            set i: i + 1
        }
        set *(buf + n): (0 as u8)
        String(buf as pointer[const_char], n)
    }

    ; ---- lookup-create helpers (Parser::lookupCreate*) --------------------
    function lookup_create_element(this: Parser, name: StringC) returns pointer[ElementType]
    {
        let dtd ps.get_def_dtd()
        let existing dtd.lookup_element_type(name)
        if existing <> null
            return existing
        let idx dtd.alloc_element_type_index()
        let e ElementType.make(host, name, idx)
        dtd.insert_element_type(e)
        e
    }

    function lookup_create_notation(this: Parser, name: StringC) returns pointer[Notation]
    {
        let dtd ps.get_def_dtd()
        let existing dtd.lookup_notation(name)
        if existing <> null
            return existing
        let nt Notation.make(host, name, dtd.get_name(), dtd.get_is_base())
        dtd.insert_notation(nt)
        nt
    }

    function lookup_create_map(this: Parser, name: StringC) returns pointer[ShortReferenceMap]
    {
        let dtd ps.get_def_dtd()
        let existing dtd.lookup_short_reference_map(name)
        if existing <> null
            return existing
        let map ShortReferenceMap.make(host, name)
        dtd.insert_short_reference_map(map)
        map
    }

    ; ---- literal parsing (parseLiteral, scoped) ---------------------------
    ; Accumulates literal content; single_space collapses runs of space to one.
    ; Entity/char references inside literals are DEFERRED (recover + false).
    ; The `e` (in-entity) variant of a literal mode: parseCommon.cxx switches the
    ; scan mode to this while inside a pushed entity, where LIT/LITA are NOT
    ; delimiters (so a `"` produced by `&quot;` does not close the literal).
    function lite_mode_for(this: Parser, lit_mode: int) returns int
    {
        if (lit_mode = alitMode) or (lit_mode = alitaMode)
            return aliteMode
        if (lit_mode = talitMode) or (lit_mode = talitaMode)
            return taliteMode
        if (lit_mode = plitMode) or (lit_mode = plitaMode)
            return pliteMode
        lit_mode
    }

    function parse_literal(this: Parser, lit_mode: int, single_space: bool, max_length: size_t, too_long: MessageType, out_text: pointer[Text]) returns bool
    {
        let start_level ps.get_input_level()
        let lite_mode this.lite_mode_for(lit_mode)
        ; currentMode (parseCommon.cxx): starts at lit_mode, flips to the `e`
        ; variant while an entity reference is open (inputLevel > startLevel),
        ; and back once the entity ends and we return to startLevel.
        var cur_mode lit_mode
        let buf Array[u32]^host()
        ; per-char source locations, parallel to buf (Text::addChar's Location
        ; argument): the ID/IDREF token locations must survive entity expansion
        ; and normalization, so every stored char carries where it came from.
        let locbuf Array[Location]^host()
        let space (0x20 as u32)
        ; startLoc (parseCommon.cxx:78) — the opening LIT/LITA delimiter, the
        ; token the caller consumed just before calling: the location of the
        ; guessed-unterminated-literal recovery message.
        let start_loc ps.current_input().token_start_location()
        ; reallyMaxLength (parseCommon.cxx:74): past twice the limit, a record
        ; end at the base input level is taken as a missing closing delimiter.
        var really_max (0 as size_t) - (1 as size_t)
        if max_length <= (really_max / (2 as size_t))
            set really_max: max_length * (2 as size_t)
        let hu host.allocate(sizeof HuState, alignof HuState) as pointer[HuState]
        set *hu: HuState()
        var running true
        var ok true
        while running
        {
            let token ps.get_token(cur_mode)
            if (token = tokenLit) or (token = tokenLita)
                set running: false
            else if token = tokenEe
            {
                if ps.get_input_level() = start_level
                {
                    ; literalLevel (parseCommon.cxx:86): the entity that opened
                    ; the literal ended inside it.
                    this.report0_at(ParserMessages.literalLevel(), ps.current_input().token_start_location())
                    set ok: false
                    set running: false
                }
                else
                {
                    ps.pop_input_stack()
                    ; entity-end item (Text::addEntityEnd) — resets the
                    ; unterminated-guess candidate.
                    hu.note_reset(buf)
                    ; back at the base input level → LIT/LITA are delimiters again.
                    if ps.get_input_level() = start_level
                        set cur_mode: lit_mode
                }
            }
            else if token = tokenRs
            {
                ; ignore record start
            }
            else if (token = tokenRe) or (token = tokenSepchar)
            {
                ; a record end past twice the limit at the base input level:
                ; guess that the closing delimiter has been omitted
                ; (parseCommon.cxx:130) — report at the opening delimiter and
                ; fail the literal; the caller recovers.
                if token = tokenRe
                {
                    if (buf.get_length() > really_max) and (ps.get_input_level() = start_level)
                    {
                        this.report0_at(ParserMessages.literalClosingDelimiter(), start_loc)
                        return false
                    }
                }
                if single_space and ((buf.get_length() = (0 as size_t)) or (this.last_char(buf) = space))
                {
                    ; ignore
                }
                else
                {
                    hu.note_space(buf)
                    buf.add(space)
                    locbuf.add(ps.current_input().token_start_location())
                }
            }
            else if token = tokenSpace
            {
                if single_space and ((buf.get_length() = (0 as size_t)) or (this.last_char(buf) = space))
                {
                    ; ignore
                }
                else
                {
                    hu.note_space(buf)
                    buf.add(ps.current_input().current_char())
                    locbuf.add(ps.current_input().token_start_location())
                }
            }
            else if token = tokenChar
            {
                ; a data RE char past twice the limit at the base input level
                ; (parseCommon.cxx:204): same missing-closing-delimiter guess
                ; as the tokenRe arm.
                let lc0 ps.current_input().current_char()
                if (buf.get_length() > really_max) and (ps.get_input_level() = start_level) and (lc0 = (0x0D as u32))
                {
                    this.report0_at(ParserMessages.literalClosingDelimiter(), start_loc)
                    return false
                }
                ; a non-SGML character in a literal (attribute value / parameter
                ; literal). Our scanner admits C0/DEL as sgmlChar (they stay data
                ; in content), so they arrive as tokenChar rather than the
                ; reference's tokenUnrecognized; report each and DROP it from the
                ; literal, exactly as reportNonSgmlCharacter does in parseCommon.
                let lc ps.current_input().current_char()
                if this.is_non_sgml_char(lc)
                {
                    let mt ParserMessages.nonSgmlCharacter()
                    let loc ps.current_input().token_start_location()
                    this.report_num_at(mt, lc as u64, loc)
                }
                else
                {
                    let dloc ps.current_input().token_start_location()
                    hu.note_data(buf, dloc)
                    buf.add(lc)
                    locbuf.add(dloc)
                }
            }
            else if (token = tokenEroNameStart) or (token = tokenEroGrpo)
            {
                ; Entity::litReference — a general entity reference in a literal
                ; STACKS the entity like a content reference; its chars then scan
                ; as literal content (the tokenEe arm above pops it). This is how
                ; `&lt;` inside an attribute value becomes a literal `<`.
                ; The no-DTD guard has no reference counterpart (parseEntityReference
                ; assumes a DTD): every literal mode that recognizes an ERO runs
                ; inside a DOCTYPE declaration or an instance, where a DTD exists —
                ; unreachable, kept only to protect lookup_entity from a null DTD.
                if ps.get_current_dtd() = null
                {
                    set ok: false
                    set running: false
                }
                else
                {
                    this.parse_entity_reference()
                    ; entity-start item (Entity::litReference) — resets the
                    ; unterminated-guess candidate.
                    hu.note_reset(buf)
                    ; entity pushed → scan its chars in the `e` variant, where a
                    ; `"`/`'` (e.g. from `&quot;`) is data, not a literal close.
                    if ps.get_input_level() > start_level
                        set cur_mode: lite_mode
                }
            }
            else if (token = tokenCroDigit) or (token = tokenHcroHexDigit)
            {
                var ch: u32 0
                var refc_loc Location()
                let is_hex_ref token = tokenHcroHexDigit
                ; the CRO/HCRO token start — the reference stores the char with
                ; parseNumericCharRef's startLocation (parseCommon.cxx:135).
                let cro_loc ps.current_input().token_start_location()
                if this.parse_numeric_char_ref(is_hex_ref, &ch, &refc_loc)
                {
                    var is_sgml true
                    if this.translate_numeric_char_ref(&ch, &is_sgml, refc_loc)
                    {
                        if is_sgml
                        {
                            hu.note_data(buf, cro_loc)
                            buf.add(ch)
                            ; the char's location is the CRO start (the
                            ; reference stores parseNumericCharRef's
                            ; startLocation) — NOT the post-ref token.
                            locbuf.add(cro_loc)
                        }
                        else
                        {
                            ; non-SGML-char item (Text::addNonSgmlChar) —
                            ; resets the unterminated-guess candidate.
                            hu.note_reset(buf)
                            ; parseLiteral (parseCommon.cxx:139): a declared
                            ; non-SGML char (UNUSED range) in a literal. CDATA
                            ; attribute values carry the literalNonSgml flag
                            ; (parseAttribute.cxx:398) and admit it SILENTLY
                            ; (Text::addNonSgmlChar — the ESIS attribute writer
                            ; drops it; verified vs onsgmls 1.5.2, exit 0);
                            ; every other literal — tokenized attribute values,
                            ; parameter literals — reports
                            ; numericCharRefLiteralNonSgml (E1, at the REFC)
                            ; and drops the char, the literal continuing.
                            if ((lit_mode = alitMode) or (lit_mode = alitaMode)) = false
                                this.report_num_at(ParserMessages.numericCharRefLiteralNonSgml(), ch as u64, refc_loc)
                        }
                    }
                    ; translate false: already reported, char dropped, literal
                    ; continues (the reference case's `break`)
                }
                else
                {
                    ; parseNumericCharRef failed (characterNumber, reported
                    ; there) -> the WHOLE literal parse fails (the reference
                    ; returns 0 from parseLiteral); the caller recovers.
                    set ok: false
                    set running: false
                }
            }
            else if token = tokenPeroNameStart
            {
                ; parseLiteral case tokenPeroNameStart: Entity::litReference for a
                ; parameter entity -> `%pe;` inside a parameter literal STACKS the
                ; PE like a content reference; its chars then scan as literal
                ; content in the `e` variant (the tokenEe arm above pops it).
                ; Parameter literals occur only in declarations, so a DTD always
                ; exists; the null guard is unreachable (see the ERO arm above).
                if ps.get_current_dtd() = null
                {
                    set ok: false
                    set running: false
                }
                else
                {
                    if this.parse_parameter_entity_reference() = false
                    {
                        set ok: false
                        set running: false
                    }
                    else
                    {
                        ; entity-start item — resets the unterminated-guess
                        ; candidate (as in the general-entity arm).
                        hu.note_reset(buf)
                        if ps.get_input_level() > start_level
                            set cur_mode: lite_mode
                    }
                }
            }
            else if token = tokenCroNameStart
            {
                ; a named function char ref in a literal (parseLiteral,
                ; parseCommon.cxx:163): the char is pushed back and re-scans
                ; as literal content in the current mode (`&#SPACE;` in an
                ; attribute value contributes a space through the tokenSepchar
                ; arm above).
                this.parse_named_char_ref()
            }
            else if token = tokenUnrecognized
            {
                ; parseLiteral (parseCommon.cxx:94): a genuine non-SGML
                ; character reports nonSgmlCharacter; any other unrecognized
                ; character is not minimum data in this literal's mode —
                ; literalMinimumData, arg = the char. Either way the char is
                ; consumed and DROPPED (it is not literal data). The zero-
                ; length unrecognized token used to loop here forever ('%' in
                ; a minimum literal) — report_non_sgml_param consumes it.
                if this.report_non_sgml_param() = false
                {
                    let ins ps.current_input()
                    let ts ins.current_token_string()
                    let cs StringC^host(ts.data_ptr(), ts.get_size())
                    this.report1_at(ParserMessages.literalMinimumData(), *cs, ins.token_start_location())
                }
            }
            else
            {
                ; other tokens in literal context: treat first char as data.
                let oloc ps.current_input().token_start_location()
                hu.note_data(buf, oloc)
                buf.add(ps.current_input().current_char())
                locbuf.add(oloc)
            }
        }
        if ok = false
            return false
        ; parseLiteral's `done:` epilogue (parseCommon.cxx:219): under
        ; literalSingleSpace a TRAILING space is dropped — ignoreLastChar
        ; tests only the last char, so a space entered via `&#32;` is dropped
        ; too. An all-space/empty tokenized value therefore ends up EMPTY,
        ; which is what makes attributeValueSyntax reachable.
        var out_n buf.get_length()
        if single_space
        {
            if out_n > (0 as size_t)
            {
                if this.last_char(buf) = (0x20 as u32)
                    set out_n: out_n - (1 as size_t)
            }
        }
        ; the maxLength check (parseCommon.cxx:223), on the size AFTER the
        ; trailing-space drop. For attribute-value literals the reference
        ; first tries the unterminated-literal guess
        ; (AttributeValue::handleAsUnterminated): if the last data item, its
        ; trailing spaces stripped, ends with the VI delimiter, report
        ; literalClosingDelimiter at the literal's FIRST item location and
        ; fail the literal; otherwise the too-long quantity message.
        if out_n > max_length
        {
            if (lit_mode = alitMode) or (lit_mode = alitaMode) or (lit_mode = talitMode) or (lit_mode = talitaMode)
            {
                hu.close(buf)
                if hu.have_last
                {
                    var ll hu.last_len
                    while (ll > (0 as size_t)) and (*(buf.get_buffer() + hu.last_start + ll - (1 as size_t)) = space)
                        set ll: ll - (1 as size_t)
                    let syn ps.get_syntax()
                    let vn syn.delim_general_len(dVI)
                    if (vn > (0 as size_t)) and (ll >= vn)
                    {
                        var vi_match true
                        var vj: size_t 0
                        while vj < vn
                        {
                            if *(buf.get_buffer() + hu.last_start + ll - vn + vj) <> syn.delim_general_char(dVI, vj)
                                set vi_match: false
                            set vj: vj + 1
                        }
                        if vi_match
                        {
                            let first_loc *(locbuf.get_buffer())
                            this.report0_at(ParserMessages.literalClosingDelimiter(), first_loc)
                            return false
                        }
                    }
                }
            }
            this.report_num_at(too_long, max_length as u64, ps.current_input().token_start_location())
        }
        var sc StringC()
        if out_n > (0 as size_t)
        {
            let scp StringC^host(buf.get_buffer(), out_n)
            set sc: *scp
        }
        set *out_text: Text(sc, locbuf.get_buffer())
        true
    }

    function last_char(this: Parser, buf: pointer[Array[u32]]) returns u32
    {
        let n buf.get_length()
        if n = (0 as size_t)
            return 0 as u32
        *(buf.get_buffer() + (n - (1 as size_t)))
    }

    ; ---- parseParam (parseParam.cxx) --------------------------------------
    function parse_param(this: Parser, allow: pointer[AllowedParams], decl_input_level: u32, parm: pointer[Param]) returns bool
    {
        var looping true
        while looping
        {
            let token ps.get_token(allow.main_mode)
            if token = tokenUnrecognized
            {
                ; a reported non-SGML character is skipped and the loop continues
                ; (parseParam.cxx:27); an SGML character is a hard error.
                if this.report_non_sgml_param() = false
                {
                    let ct ps.current_token()
                    let a2 this.allowed_params_message_arg(allow)
                    this.report_str_raw_at(ParserMessages.markupDeclarationCharacter(), ct, a2, ps.current_input().token_start_location())
                    return false
                }
            }
            else if token = tokenEe
            {
                if ps.get_input_level() <= decl_input_level
                {
                    ; declarationLevel: the entity that opened the declaration
                    ; ended inside a parameter separator.
                    this.report0_at(ParserMessages.declarationLevel(), ps.current_input().token_start_location())
                    return false
                }
                ps.pop_input_stack()
            }
            else if token = tokenCom
            {
                ; a comment in a parameter separator (parseParam.cxx:44): parse it
                ; and continue; warnPsComment is option-gated (off by default).
                if this.parse_comment(comMode) = false
                    return false
            }
            else if token = tokenDso
            {
                if allow.dso_ok = false
                {
                    this.param_invalid_token(tokenDso, allow)
                    return false
                }
                set parm.kind: P_DSO
                return true
            }
            else if token = tokenGrpo
            {
                if allow.group_type = P_MODELGROUP
                {
                    var grp: pointer[CmNode] null
                    if this.parse_model_group((1 as u32), decl_input_level, &grp, grpsufMode) = false
                        return false
                    set parm.model_group: grp
                    set parm.kind: P_MODELGROUP
                    return true
                }
                else if allow.group_type = P_NAMEGROUP
                {
                    if this.parse_name_group(decl_input_level, parm) = false
                        return false
                    set parm.kind: P_NAMEGROUP
                    return true
                }
                else if allow.group_type = P_NAMETOKENGROUP
                {
                    if this.parse_name_token_group(decl_input_level, parm) = false
                        return false
                    set parm.kind: P_NAMETOKENGROUP
                    return true
                }
                else
                {
                    this.param_invalid_token(tokenGrpo, allow)
                    return false
                }
            }
            else if (token = tokenLit) or (token = tokenLita)
            {
                set parm.kind: allow.literal_type
                set parm.lita: token = tokenLita
                if allow.literal_type = P_INVALID
                {
                    this.param_invalid_token(token, allow)
                    return false
                }
                let txt host.allocate(sizeof Text, alignof Text) as pointer[Text]
                ; each literal kind carries its own maxLength + quantity
                ; message (parseParam.cxx:954-991 / parseAttribute.cxx:389):
                ; minimum literal = the REFERENCE LITLEN (240), system id /
                ; param literal = LITLEN, attribute values = LITLEN - NORMSEP
                ; (via the shared wrappers, including the negative-limit edge).
                var lit_ok true
                if allow.literal_type = P_MINIMUMLITERAL
                {
                    var lmode: int mlitMode
                    if parm.lita
                        set lmode: mlitaMode
                    let syn ps.get_syntax()
                    set lit_ok: this.parse_literal(lmode, true, syn.reference_quantity(qLITLEN) as size_t, ParserMessages.minimumLiteralLength(), txt)
                }
                else if allow.literal_type = P_SYSTEMIDENTIFIER
                {
                    var lmode: int slitMode
                    if parm.lita
                        set lmode: slitaMode
                    set lit_ok: this.parse_literal(lmode, false, ps.get_syntax().get_quantity(qLITLEN) as size_t, ParserMessages.systemIdentifierLength(), txt)
                }
                else if allow.literal_type = P_ATTRIBUTEVALUELITERAL
                    set lit_ok: this.parse_attribute_value_literal(parm.lita, txt)
                else if allow.literal_type = P_TOKENIZEDATTRIBUTEVALUELITERAL
                    set lit_ok: this.parse_tokenized_attribute_value_literal(parm.lita, txt)
                else
                {
                    var lmode: int plitMode
                    if parm.lita
                        set lmode: plitaMode
                    set lit_ok: this.parse_literal(lmode, false, ps.get_syntax().get_quantity(qLITLEN) as size_t, ParserMessages.parameterLiteralLength(), txt)
                }
                if lit_ok = false
                    return false
                set parm.literal_text: txt
                return true
            }
            else if token = tokenMdc
            {
                if allow.mdc_ok = false
                {
                    this.param_invalid_token(tokenMdc, allow)
                    return false
                }
                ; parameterEntityNotEnded (parseParam.cxx:126): a PE referenced
                ; in a parameter separator must end in the same declaration.
                if ps.get_input_level() > decl_input_level
                    this.report0_at(ParserMessages.parameterEntityNotEnded(), ps.current_input().token_start_location())
                set parm.kind: P_MDC
                return true
            }
            else if token = tokenMinus
            {
                set parm.kind: P_MINUS
                return true
            }
            else if token = tokenMinusGrpo
            {
                if allow.exclusions_ok = false
                {
                    this.param_invalid_token(tokenMinusGrpo, allow)
                    return false
                }
                set parm.kind: P_EXCLUSIONS
                return this.parse_element_name_group(decl_input_level, parm)
            }
            else if token = tokenPero
            {
                set parm.kind: P_PERO
                return true
            }
            else if (token = tokenPeroNameStart) or (token = tokenPeroGrpo)
            {
                ; parseParam case tokenPeroNameStart: a parameter-entity reference
                ; where a parameter is expected -> declReference stacks it; the
                ; loop continues, reading the replacement text as the parameter
                ; (the tokenEe arm above pops the entity when it is exhausted).
                ; A name group in the reference (`%(`) is not allowed in the
                ; prolog, where parse_param always runs (parseParam.cxx:153).
                if token = tokenPeroGrpo
                    this.report0_at(ParserMessages.peroGrpoProlog(), ps.current_input().token_start_location())
                if this.parse_parameter_entity_reference() = false
                    return false
            }
            else if token = tokenPlusGrpo
            {
                if allow.inclusions_ok = false
                {
                    this.param_invalid_token(tokenPlusGrpo, allow)
                    return false
                }
                set parm.kind: P_INCLUSIONS
                return this.parse_element_name_group(decl_input_level, parm)
            }
            else if token = tokenRni
            {
                if allow.rni_ok = false
                {
                    this.param_invalid_token(tokenRni, allow)
                    return false
                }
                return this.parse_indicated_reserved_name(allow, parm)
            }
            else if token = tokenS
            {
                ; whitespace between parameters: skip
            }
            else if token = tokenNameStart
            {
                if allow.name_start_type = P_INVALID
                {
                    this.param_invalid_token(tokenNameStart, allow)
                    return false
                }
                else if allow.name_start_type = P_RESERVED_NAME
                    return this.parse_reserved_name(allow, parm)
                else if allow.name_start_type = P_NAME
                {
                    this.extend_name_token(this.namelen(), ParserMessages.nameLength())
                    set parm.kind: P_NAME
                    set parm.orig_token: ps.current_token^host()
                    set parm.token: this.name_folded^host()
                    return true
                }
                else if allow.name_start_type = P_ENTITYNAME
                {
                    this.extend_name_token(this.namelen(), ParserMessages.nameLength())
                    set parm.kind: P_ENTITYNAME
                    ; NAMECASE ENTITY NO: entity names stay case-exact (unlike
                    ; P_NAME above, which folds under NAMECASE GENERAL YES).
                    set parm.token: ps.current_token^host()
                    return true
                }
                else if allow.name_start_type = P_PARAMENTITYNAME
                {
                    this.extend_name_token(this.penamelen(), ParserMessages.parameterEntityNameLength())
                    set parm.kind: P_PARAMENTITYNAME
                    ; NAMECASE ENTITY NO: parameter-entity names stay case-exact.
                    set parm.token: ps.current_token^host()
                    return true
                }
                else if allow.name_start_type = P_ATTRIBUTEVALUE
                    return this.parse_attribute_value_param(parm)
                else
                {
                    ; every name-start type is handled above — the reference
                    ; switch has no further case (CANNOT_HAPPEN).
                    return false
                }
            }
            else if token = tokenDigit
            {
                if allow.digit_type = P_NUMBER
                {
                    this.extend_number(this.namelen())
                    set parm.kind: P_NUMBER
                    set parm.token: ps.current_token^host()
                    return true
                }
                else if allow.digit_type = P_ATTRIBUTEVALUE
                    return this.parse_attribute_value_param(parm)
                else
                {
                    this.param_invalid_token(tokenDigit, allow)
                    return false
                }
            }
            else if token = tokenLcUcNmchar
            {
                if allow.nmchar_type = P_ATTRIBUTEVALUE
                    return this.parse_attribute_value_param(parm)
                else
                {
                    this.param_invalid_token(tokenLcUcNmchar, allow)
                    return false
                }
            }
            else
            {
                ; the modes parse_param scans with produce no other token —
                ; the reference's CANNOT_HAPPEN.
                return false
            }
        }
        false
    }

    function extend_number(this: Parser, maxlen: size_t)
    {
        let ins ps.current_input()
        if ins = null
            return
        var length ins.current_token_length()
        let syn ps.get_syntax()
        var scanning true
        while scanning
        {
            let ch ins.token_char()
            if syn.is_digit(ch as u32) = false
                set scanning: false
            else
                set length: length + (1 as size_t)
        }
        ; parseCommon.cxx:580 — a number longer than NAMELEN.
        if length > maxlen
            this.report_num_at(ParserMessages.numberLength(), maxlen as u64, ins.token_start_location())
        ins.end_token(length)
    }

    ; extendHexNumber (parseCommon.cxx:584): grow the current token over hex
    ; digits (0-9 a-f A-F per Syntax::isHexDigit), reporting hexNumberLength
    ; past NAMELEN.
    function extend_hex_number(this: Parser, maxlen: size_t)
    {
        let ins ps.current_input()
        if ins = null
            return
        var length ins.current_token_length()
        let syn ps.get_syntax()
        var scanning true
        while scanning
        {
            let ch ins.token_char()
            if syn.is_hex_digit(ch as u32) = false
                set scanning: false
            else
                set length: length + (1 as size_t)
        }
        if length > maxlen
            this.report_num_at(ParserMessages.hexNumberLength(), maxlen as u64, ins.token_start_location())
        ins.end_token(length)
    }

    ; CharsetInfo::hexDigitWeight (CharsetInfo.cxx:117) reduced to the identity
    ; charset: the callers only pass chars admitted by Syntax.is_hex_digit.
    function hex_digit_weight(this: Parser, c: u32) returns u32
    {
        if (c >= (0x30 as u32)) and (c <= (0x39 as u32))
            return c - (0x30 as u32)
        if (c >= (0x41 as u32)) and (c <= (0x46 as u32))
            return c - (0x41 as u32) + (10 as u32)
        c - (0x61 as u32) + (10 as u32)
    }

    ; parseAttributeValueParam — an unquoted attribute value (name/number/nmchar).
    function parse_attribute_value_param(this: Parser, parm: pointer[Param]) returns bool
    {
        this.extend_name_token(this.attribute_value_max_length(), ParserMessages.attributeValueLength())
        set parm.kind: P_ATTRIBUTEVALUE
        ; Copy the token onto the stable run region (^host), not the transient
        ; caller page: a default attribute value parsed here is stored in the DTD
        ; and read back at instance time, long after this DTD-parsing frame's
        ; region is reclaimed — ps.current_token() alone would dangle.
        let sc ps.current_token^host()
        let txt host.allocate(sizeof Text, alignof Text) as pointer[Text]
        ; per-char locations (linear: the value is one source token) — the
        ; makeValue category messages point INTO the default value.
        let ins ps.current_input()
        let tn sc.get_size()
        let tstart ins.current_token_start_index()
        let torg ins.get_origin()
        let tlb host.allocate(tn * sizeof Location, alignof Location) as pointer[Location]
        var tli: size_t 0
        while tli < tn
        {
            set *(tlb + tli): Location(torg, (tstart + tli) as u32)
            set tli: tli + 1
        }
        set *txt: Text(sc, tlb)
        set parm.literal_text: txt
        true
    }

    ; parseReservedName — a plain reserved name in name-start position.
    function parse_reserved_name(this: Parser, allow: pointer[AllowedParams], parm: pointer[Param]) returns bool
    {
        var rn: int 0
        if this.get_reserved_name(&rn) = false
            return false
        if allow.reserved_name_allowed(rn) = false
        {
            ; invalidReservedName (parseParam.cxx:1019): arg = the CANONICAL
            ; spelling (syntax().reservedName(rn)), not the scanned token.
            let spell this.reserved_name_spelling(rn)
            this.report1_at(ParserMessages.invalidReservedName(), spell, ps.current_input().token_start_location())
            return false
        }
        set parm.kind: P_RESERVED_NAME + rn
        true
    }

    function get_reserved_name(this: Parser, out_rn: pointer[int]) returns bool
    {
        this.extend_name_token(this.namelen(), ParserMessages.nameLength())
        let buffer this.name_folded()
        let rn this.lookup_reserved_name(buffer)
        if rn < 0
        {
            ; noSuchReservedName (parseParam.cxx:1059): the name is not a reserved
            ; name. Arg = the folded name (quoted); location = the name token start.
            let loc ps.current_input().token_start_location()
            this.report1_at(ParserMessages.noSuchReservedName(), buffer, loc)
            return false
        }
        set *out_rn: rn
        true
    }

    ; parseIndicatedReservedName — after RNI (`#`), the reserved name.
    function parse_indicated_reserved_name(this: Parser, allow: pointer[AllowedParams], parm: pointer[Param]) returns bool
    {
        var rn: int 0
        if this.get_indicated_reserved_name(&rn) = false
            return false
        if allow.reserved_name_allowed(rn) = false
        {
            ; invalidReservedName (parseParam.cxx:1004): arg = currentToken(),
            ; the scanned name as written (the RNI is a separate token).
            let ct ps.current_token()
            this.report1_at(ParserMessages.invalidReservedName(), ct, ps.current_input().token_start_location())
            return false
        }
        set parm.kind: P_INDICATED_RESERVED_NAME + rn
        true
    }

    function get_indicated_reserved_name(this: Parser, out_rn: pointer[int]) returns bool
    {
        let ins ps.current_input()
        ins.start_token()
        let first ins.token_char()
        if ps.get_syntax().is_name_start_character(first as u32) = false
        {
            ; rniNameStart (parseParam.cxx:1052).
            this.report0_at(ParserMessages.rniNameStart(), ins.token_start_location())
            return false
        }
        this.extend_name_token(this.namelen(), ParserMessages.nameLength())
        let buffer this.name_folded()
        let rn this.lookup_reserved_name(buffer)
        if rn < 0
        {
            ; noSuchReservedName (parseParam.cxx:1059): the folded name, quoted.
            this.report1_at(ParserMessages.noSuchReservedName(), buffer, ps.current_input().token_start_location())
            return false
        }
        set *out_rn: rn
        true
    }

    ; ---- group parser (Group.cs) ------------------------------------------
    function has_gt(this: Parser, allow: int, t: int) returns bool
        (allow & (1 << t)) <> 0

    function gt_group(this: Parser, allow: int) returns int
    {
        if this.has_gt(allow, GT_MODELGROUP)
            return GT_MODELGROUP
        if this.has_gt(allow, GT_DATATAGTEMPLATEGROUP)
            return GT_DATATAGTEMPLATEGROUP
        GT_INVALID
    }

    function gt_name_start(this: Parser, allow: int) returns int
    {
        if this.has_gt(allow, GT_ELEMENTTOKEN)
            return GT_ELEMENTTOKEN
        if this.has_gt(allow, GT_NAMETOKEN)
            return GT_NAMETOKEN
        if this.has_gt(allow, GT_NAME)
            return GT_NAME
        GT_INVALID
    }

    function has_gc(this: Parser, allow: int, c: int) returns bool
        (allow & (1 << c)) <> 0

    ; getOccurrenceIndicator(oiMode)
    function get_occurrence_indicator(this: Parser, oi_mode: int) returns int
    {
        let token ps.get_token(oi_mode)
        if token = tokenPlus
            return OI_PLUS
        if token = tokenOpt
            return OI_OPT
        if token = tokenRep
            return OI_REP
        ps.current_input().unget_token()
        OI_NONE
    }

    ; parseGroupToken(allow, nestingLevel, declInputLevel, groupInputLevel, gt)
    function parse_group_token(this: Parser, allow: int, nesting_level: u32, decl_input_level: u32, group_input_level: u32, gt: pointer[GroupToken]) returns bool
    {
        var looping true
        while looping
        {
            let token ps.get_token(grpMode)
            if token = tokenEe
            {
                if ps.get_input_level() <= group_input_level
                {
                    ; groupLevel: an entity end in a token separator must
                    ; terminate an entity referenced in the same group.
                    this.report0_at(ParserMessages.groupLevel(), ps.current_input().token_start_location())
                    if ps.get_input_level() <= decl_input_level
                        return false
                }
                else if ps.get_sd().www() = false
                {
                    ; groupEntityEnd (parseParam.cxx:293): an entity end in a
                    ; token separator that does not follow a token (non-WWW).
                    this.report0_at(ParserMessages.groupEntityEnd(), ps.current_input().token_start_location())
                }
                ps.pop_input_stack()
            }
            else if (token = tokenPeroNameStart) or (token = tokenPeroGrpo)
            {
                ; parseGroupToken case tokenPeroNameStart: a parameter-entity
                ; reference IN a model group (`(%pe;)*`) -> declReference stacks it;
                ; the loop continues, reading the group tokens from the replacement
                ; text (the tokenEe arm above pops the entity when exhausted).
                ; A name group (`%(`) is not allowed in the prolog, where groups
                ; always parse (parseParam.cxx:299).
                if token = tokenPeroGrpo
                    this.report0_at(ParserMessages.peroGrpoProlog(), ps.current_input().token_start_location())
                if this.parse_parameter_entity_reference() = false
                    return false
            }
            else if token = tokenUnrecognized
            {
                ; a reported non-SGML character is skipped (parseParam.cxx:321).
                if this.report_non_sgml_param() = false
                {
                    let ct ps.current_token()
                    let a2 this.allowed_group_tokens_message_arg(allow)
                    this.report_str_raw_at(ParserMessages.groupCharacter(), ct, a2, ps.current_input().token_start_location())
                    return false
                }
            }
            else if token = tokenDtgo
            {
                ; data-tag group (parseParam.cxx:330). The allow check maps to
                ; groupTokenInvalidToken; parsing the group itself
                ; (parseDataTagGroup) is the DATATAG feature axis, unported
                ; (FEATURES DATATAG is likewise unmodeled = NO, so the
                ; reference's own datatagNotImplemented arm cannot fire).
                if this.has_gt(allow, GT_DATATAGGROUP) = false
                {
                    this.group_token_invalid_token(tokenDtgo, allow)
                    return false
                }
                return false
            }
            else if token = tokenGrpo
            {
                if this.gt_group(allow) = GT_MODELGROUP
                {
                    var mg: pointer[CmNode] null
                    if this.parse_model_group(nesting_level + (1 as u32), decl_input_level, &mg, grpMode) = false
                        return false
                    set gt.model: mg
                    set gt.kind: GT_MODELGROUP
                    return true
                }
                else
                {
                    ; the dataTagTemplateGroup arm is the DATATAG axis; every
                    ; other group kind is invalid here (parseParam.cxx:358).
                    this.group_token_invalid_token(tokenGrpo, allow)
                    return false
                }
            }
            else if token = tokenRni
            {
                if (this.has_gt(allow, GT_PCDATA) = false) and (this.has_gt(allow, GT_ALL) = false) and (this.has_gt(allow, GT_IMPLICIT) = false)
                {
                    this.group_token_invalid_token(tokenRni, allow)
                    return false
                }
                var rn: int 0
                if this.get_indicated_reserved_name(&rn) = false
                    return false
                if (rn = R_PCDATA) and this.has_gt(allow, GT_PCDATA)
                {
                    set gt.kind: GT_PCDATA
                    ; PcdataToken() : LeafContentToken(0, rep) — pcdata is
                    ; inherently optional AND repeatable (the self-loop that lets
                    ; (#PCDATA) admit any run of data). OI_REP, never OI_NONE.
                    set gt.content_token: ContentToken.make_leaf(host, null as pointer[ElementType], OI_REP, true, false)
                    return true
                }
                else if ((rn = R_ALL) and this.has_gt(allow, GT_ALL)) or ((rn = R_IMPLICIT) and this.has_gt(allow, GT_IMPLICIT))
                {
                    ; the reference itself does not implement these
                    ; (parseParam.cxx:379).
                    this.report0_at(ParserMessages.sorryAllImplicit(), ps.current_input().token_start_location())
                    return false
                }
                else
                {
                    ; invalidToken (parseParam.cxx:389): arg = RNI + the
                    ; canonical reserved-name spelling, quoted.
                    let buf Array[u32]^host()
                    let syn ps.get_syntax()
                    let rl syn.delim_general_len(dRNI)
                    var j: size_t 0
                    while j < rl
                    {
                        let rc syn.delim_general_char(dRNI, j)
                        buf.add(rc)
                        set j: j + 1
                    }
                    let spell this.reserved_name_spelling(rn)
                    this.arg_append(buf, spell)
                    let tok this.arg_to_string(buf)
                    this.report1_at(ParserMessages.invalidToken(), tok, ps.current_input().token_start_location())
                    return false
                }
            }
            else if token = tokenS
            {
                ; whitespace in group: skip
            }
            else if token = tokenNameStart
            {
                let ns this.gt_name_start(allow)
                if ns = GT_ELEMENTTOKEN
                {
                    this.extend_name_token(this.namelen(), ParserMessages.nameLength())
                    let buffer this.name_folded()
                    let e this.lookup_create_element(buffer)
                    let oi this.get_occurrence_indicator(grpMode)
                    set gt.kind: GT_ELEMENTTOKEN
                    set gt.content_token: ContentToken.make_leaf(host, e, oi, false, false)
                    return true
                }
                else if (ns = GT_NAME) or (ns = GT_NAMETOKEN)
                {
                    this.extend_name_token(this.namelen(), ParserMessages.nameLength())
                    set gt.token: this.name_folded^host()
                    set gt.kind: ns
                    return true
                }
                else
                {
                    this.group_token_invalid_token(tokenNameStart, allow)
                    return false
                }
            }
            else if (token = tokenDigit) or (token = tokenLcUcNmchar)
            {
                if this.has_gt(allow, GT_NAMETOKEN) = false
                {
                    this.group_token_invalid_token(token, allow)
                    return false
                }
                this.extend_name_token(this.namelen(), ParserMessages.nameTokenLength())
                set gt.token: this.name_folded^host()
                set gt.kind: GT_NAMETOKEN
                return true
            }
            else
            {
                ; connectors, occurrence indicators, literals where a group
                ; token is expected (parseParam.cxx:458-475).
                this.group_token_invalid_token(token, allow)
                return false
            }
        }
        false
    }

    ; parseGroupConnector(allow, declInputLevel, groupInputLevel, gc)
    function parse_group_connector(this: Parser, allow: int, decl_input_level: u32, group_input_level: u32, out_gc: pointer[int]) returns bool
    {
        var looping true
        while looping
        {
            let token ps.get_token(grpMode)
            if token = tokenEe
            {
                if ps.get_input_level() <= group_input_level
                {
                    ; groupLevel (parseParam.cxx:491).
                    this.report0_at(ParserMessages.groupLevel(), ps.current_input().token_start_location())
                    if ps.get_input_level() <= decl_input_level
                        return false
                }
                ps.pop_input_stack()
            }
            else if token = tokenS
            {
                ; skip
            }
            else if (token = tokenPeroNameStart) or (token = tokenPeroGrpo)
            {
                ; parseGroupConnector case tokenPeroNameStart: a parameter-entity
                ; reference in connector position. Only allowed under WWW (the XML
                ; profile); otherwise groupEntityReference — reported, the token is
                ; dropped, and the loop continues (parseParam.cxx:513).
                if ps.get_sd().www() = false
                    this.report0_at(ParserMessages.groupEntityReference(), ps.current_input().token_start_location())
                else if this.parse_parameter_entity_reference() = false
                    return false
            }
            else if token = tokenUnrecognized
            {
                ; a reported non-SGML character is skipped (parseParam.cxx:523).
                if this.report_non_sgml_param() = false
                {
                    let ct ps.current_token()
                    let a2 this.allowed_group_connectors_message_arg(allow)
                    this.report_str_raw_at(ParserMessages.groupCharacter(), ct, a2, ps.current_input().token_start_location())
                    return false
                }
            }
            else if token = tokenAnd
            {
                if this.has_gc(allow, GC_AND) = false
                {
                    this.group_connector_invalid_token(tokenAnd, allow)
                    return false
                }
                set *out_gc: GC_AND
                return true
            }
            else if token = tokenSeq
            {
                if this.has_gc(allow, GC_SEQ) = false
                {
                    this.group_connector_invalid_token(tokenSeq, allow)
                    return false
                }
                set *out_gc: GC_SEQ
                return true
            }
            else if token = tokenOr
            {
                if this.has_gc(allow, GC_OR) = false
                {
                    this.group_connector_invalid_token(tokenOr, allow)
                    return false
                }
                set *out_gc: GC_OR
                return true
            }
            else if token = tokenGrpc
            {
                if this.has_gc(allow, GC_GRPC) = false
                {
                    this.group_connector_invalid_token(tokenGrpc, allow)
                    return false
                }
                ; groupParameterEntityNotEnded (parseParam.cxx:577): a PE
                ; referenced in a token separator must end in the same group.
                if ps.get_input_level() > group_input_level
                    this.report0_at(ParserMessages.groupParameterEntityNotEnded(), ps.current_input().token_start_location())
                set *out_gc: GC_GRPC
                return true
            }
            else
            {
                ; any other token where a connector is expected
                ; (parseParam.cxx:581, the switch default).
                this.group_connector_invalid_token(token, allow)
                return false
            }
        }
        false
    }

    ; parseModelGroup(nestingLevel, declInputLevel, group, oiMode)
    function parse_model_group(this: Parser, nesting_level: u32, decl_input_level: u32, out_group: pointer[pointer[CmNode]], oi_mode: int) returns bool
    {
        ; parseParam.cxx:824 — model groups nest against GRPLVL (fires once,
        ; when the nesting depth reaches exactly the limit).
        let grplvl_q ps.get_syntax().get_quantity(qGRPLVL)
        if (nesting_level - (1 as u32)) = grplvl_q
            this.report_num_at(ParserMessages.grplvl(), grplvl_q as u64, ps.current_input().token_start_location())
        let group_input_level ps.get_input_level()
        let members ContentToken.new_node_vec(host)
        var connector: int GC_GRPC
        let gt GroupToken.make(host)
        ; allowed content tokens: pcdata, elementToken, modelGroup (data-tag deferred).
        let allow_content (1 << GT_PCDATA) | ((1 << GT_ELEMENTTOKEN) | (1 << GT_MODELGROUP))
        ; connector allow-sets
        let allow_any ((1 << GC_OR) | (1 << GC_AND)) | ((1 << GC_SEQ) | (1 << GC_GRPC))
        let allow_or (1 << GC_OR) | (1 << GC_GRPC)
        let allow_and (1 << GC_AND) | (1 << GC_GRPC)
        let allow_seq (1 << GC_SEQ) | (1 << GC_GRPC)
        var connectorp: int allow_any
        var gc: int GC_GRPC
        var first true
        var running true
        while running
        {
            if this.parse_group_token(allow_content, nesting_level, decl_input_level, group_input_level, gt) = false
                return false
            var content_token: pointer[CmNode] null
            if gt.kind = GT_MODELGROUP
                set content_token: gt.model
            else
                set content_token: gt.content_token
            ; parseParam.cxx:865 — fires once, at exactly GRPCNT tokens,
            ; BEFORE this token is appended.
            let mg_grpcnt_q ps.get_syntax().get_quantity(qGRPCNT) as size_t
            if members.get_length() = mg_grpcnt_q
                this.report_num_at(ParserMessages.groupCount(), mg_grpcnt_q as u64, ps.current_input().token_start_location())
            members.add(content_token)
            if this.parse_group_connector(connectorp, decl_input_level, group_input_level, &gc) = false
                return false
            if first
            {
                set first: false
                set connector: gc
                if gc = GC_OR
                    set connectorp: allow_or
                else if gc = GC_SEQ
                    set connectorp: allow_seq
                else if gc = GC_AND
                    set connectorp: allow_and
            }
            if gc = GC_GRPC
                set running: false
        }
        let oi this.get_occurrence_indicator(oi_mode)
        var conn: int CONN_SEQ
        if connector = GC_OR
            set conn: CONN_OR
        else if connector = GC_AND
            set conn: CONN_AND
        else
            set conn: CONN_SEQ
        set *out_group: ContentToken.make_group(host, conn, members, oi)
        true
    }

    ; parseGroup(allowToken, declInputLevel, parm) — a name/nametoken group.
    function parse_group(this: Parser, allow_token: int, decl_input_level: u32, parm: pointer[Param]) returns bool
    {
        let group_input_level ps.get_input_level()
        let vec Array[NameToken]^host()
        let gt GroupToken.make(host)
        var n_duplicates: size_t 0
        var running true
        while running
        {
            if this.parse_group_token(allow_token, 0 as u32, decl_input_level, group_input_level, gt) = false
                return false
            if this.group_contains(vec, gt.token) = false
                vec.add(NameToken(gt.token, ps.current_token(), ps.current_location()))
            else
            {
                ; duplicateGroupToken (parseParam.cxx:692): this token already
                ; occurred in the group. Arg = the folded token (quoted); location =
                ; the token's start.
                set n_duplicates: n_duplicates + (1 as size_t)
                let dtok gt.token
                let dloc ps.current_input().token_start_location()
                this.report1_at(ParserMessages.duplicateGroupToken(), dtok, dloc)
            }
            var gc: int GC_GRPC
            let allow_any ((1 << GC_OR) | (1 << GC_AND)) | ((1 << GC_SEQ) | (1 << GC_GRPC))
            if this.parse_group_connector(allow_any, decl_input_level, group_input_level, &gc) = false
                return false
            if gc = GC_GRPC
                set running: false
        }
        ; parseParam.cxx:725 — group tokens (duplicates included) vs GRPCNT.
        let grpcnt_q ps.get_syntax().get_quantity(qGRPCNT) as size_t
        if (n_duplicates + vec.get_length()) > grpcnt_q
            this.report_num_at(ParserMessages.groupCount(), grpcnt_q as u64, ps.current_input().token_start_location())
        set parm.name_tokens: vec
        true
    }

    function group_contains(this: Parser, vec: pointer[Array[NameToken]], str: StringC) returns bool
    {
        let n vec.get_length()
        let buf vec.get_buffer()
        var i: size_t 0
        while i < n
        {
            let nt *(buf + i)
            if nt.name.equals(str)
                return true
            set i: i + 1
        }
        false
    }

    function parse_name_group(this: Parser, decl_input_level: u32, parm: pointer[Param]) returns bool
        this.parse_group(1 << GT_NAME, decl_input_level, parm)

    function parse_name_token_group(this: Parser, decl_input_level: u32, parm: pointer[Param]) returns bool
        this.parse_group(1 << GT_NAMETOKEN, decl_input_level, parm)

    ; parseElementNameGroup — a name group, then resolve to element types.
    function parse_element_name_group(this: Parser, decl_input_level: u32, parm: pointer[Param]) returns bool
    {
        if this.parse_group(1 << GT_NAME, decl_input_level, parm) = false
            return false
        let elems Array[pointer[ElementType]]^host()
        let nt parm.name_tokens
        let n nt.get_length()
        let buf nt.get_buffer()
        var i: size_t 0
        while i < n
        {
            let entry *(buf + i)
            elems.add(this.lookup_create_element(entry.name))
            set i: i + 1
        }
        set parm.elements: elems
        true
    }

    ; PublicId::init's MessageType1* out-params, reporting side: map a
    ; classification error code to its fpi* / urn* message (arg = the public
    ; id string, quoted). Code 0 is unreachable here (the switch below only
    ; reports the LOSING decomposition's error) — the missing-field message
    ; keeps it total.
    function report_fpi_error(this: Parser, code: int, arg: StringC, loc: Location)
    {
        if code = FPI_ERR_MISSING_TEXT_CLASS_SPACE
            this.report1_at(ParserMessages.fpiMissingTextClassSpace(), arg, loc)
        else if code = FPI_ERR_INVALID_TEXT_CLASS
            this.report1_at(ParserMessages.fpiInvalidTextClass(), arg, loc)
        else if code = FPI_ERR_INVALID_LANGUAGE
            this.report1_at(ParserMessages.fpiInvalidLanguage(), arg, loc)
        else if code = FPI_ERR_ILLEGAL_DISPLAY_VERSION
            this.report1_at(ParserMessages.fpiIllegalDisplayVersion(), arg, loc)
        else if code = FPI_ERR_EXTRA_FIELD
            this.report1_at(ParserMessages.fpiExtraField(), arg, loc)
        else
            this.report1_at(ParserMessages.fpiMissingField(), arg, loc)
    }

    function report_urn_error(this: Parser, code: int, arg: StringC, loc: Location)
    {
        if code = URN_ERR_MISSING_PREFIX
            this.report1_at(ParserMessages.urnMissingPrefix(), arg, loc)
        else if code = URN_ERR_INVALID_NID
            this.report1_at(ParserMessages.urnInvalidNid(), arg, loc)
        else if code = URN_ERR_INVALID_NSS
            this.report1_at(ParserMessages.urnInvalidNss(), arg, loc)
        else
            this.report1_at(ParserMessages.urnMissingField(), arg, loc)
    }

    ; ---- parseExternalId (scoped) -----------------------------------------
    function parse_external_id(this: Parser, sysid_allow: pointer[AllowedParams], end_allow: pointer[AllowedParams], decl_input_level: u32, parm: pointer[Param], out_id: pointer[ExternalId]) returns bool
    {
        if parm.kind = (P_RESERVED_NAME + R_PUBLIC)
        {
            let allow_min AllowedParams.a1(host, P_MINIMUMLITERAL)
            if this.parse_param(allow_min, decl_input_level, parm) = false
                return false
            let public_str this.stringc_to_bytes(parm.literal_text.string())
            set *out_id: ExternalId(true, public_str, false, String())
            ; PublicId::init (id.setPublic) + the FORMAL/URN reporting switch
            ; (parseDecl.cxx:1523-1543): under FORMAL YES a non-FPI public id
            ; reports the FPI decomposition's error, under URN YES a non-URN
            ; one the URN error; a valid FPI whose text class is SD needs a
            ; WWW declaration. Arg = the public id, location = the minimum
            ; literal's token start (plain message()).
            out_id.classify_public()
            let sdp ps.get_sd()
            let pub_sc parm.literal_text.string()
            let msg_loc ps.current_input().token_start_location()
            let ptype out_id.get_public_type()
            if ptype = PUBLIC_FPI
            {
                if sdp.formal()
                {
                    if out_id.get_text_class() = TC_SD
                        this.report0_at(ParserMessages.wwwRequired(), msg_loc)
                }
                if sdp.urn()
                {
                    if sdp.formal() = false
                        this.report_urn_error(out_id.get_urn_error(), pub_sc, msg_loc)
                }
            }
            else if ptype = PUBLIC_URN
            {
                if sdp.formal()
                {
                    if sdp.urn() = false
                        this.report_fpi_error(out_id.get_fpi_error(), pub_sc, msg_loc)
                }
            }
            else
            {
                if sdp.formal()
                    this.report_fpi_error(out_id.get_fpi_error(), pub_sc, msg_loc)
                if sdp.urn()
                    this.report_urn_error(out_id.get_urn_error(), pub_sc, msg_loc)
            }
        }
        else
            set *out_id: ExternalId()
        if this.parse_param(sysid_allow, decl_input_level, parm) = false
            return false
        if parm.kind = P_SYSTEMIDENTIFIER
        {
            let system_str this.stringc_to_bytes(parm.literal_text.string())
            out_id.set_system(system_str)
            if this.parse_param(end_allow, decl_input_level, parm) = false
                return false
        }
        true
    }

    ; ---- parseElementDecl --------------------------------------------------
    function parse_element_decl(this: Parser) returns bool
    {
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        let allow_name_namegroup AllowedParams.a2(host, P_NAME, P_NAMEGROUP)
        if this.parse_param(allow_name_namegroup, decl_input_level, parm) = false
            return false

        var names Array[NameToken]^host()
        if parm.kind = P_NAMEGROUP
        {
            let src parm.name_tokens
            let n src.get_length()
            let buf src.get_buffer()
            var i: size_t 0
            while i < n
            {
                let ent *(buf + i)
                names.add(ent)
                set i: i + 1
            }
        }
        else
        {
            let loc ps.current_location()
            let nt NameToken(parm.token, parm.orig_token, loc)
            names.add(nt)
        }

        let allow_roc AllowedParams.a8(host, P_NUMBER, P_RESERVED_NAME + R_O, P_MINUS, P_RESERVED_NAME + R_CDATA, P_RESERVED_NAME + R_RCDATA, P_RESERVED_NAME + R_EMPTY, P_RESERVED_NAME + R_ANY, P_MODELGROUP)
        if this.parse_param(allow_roc, decl_input_level, parm) = false
            return false

        if parm.kind = P_NUMBER
        {
            ; RANK feature axis (parseDecl.cxx:571): a number here is a rank
            ; suffix — the reference builds rank stems (lookupCreateRankStem,
            ; setRank) and parses the declaration normally, with NO diagnostic.
            ; Unported; err keeps the abort visible in the error count until
            ; the axis lands.
            this.err(50)
            return false
        }

        ; resolve element types.
        var elements Array[pointer[ElementType]]^host()
        let nn names.get_length()
        let nbuf names.get_buffer()
        var k: size_t 0
        while k < nn
        {
            let entry *(nbuf + k)
            let e this.lookup_create_element(entry.name)
            e.set_orig_name(entry.orig_name)
            elements.add(e)
            set k: k + 1
        }

        ; omitted-tag minimization.
        var omit_flags: u8 0
        if (parm.kind = P_MINUS) or (parm.kind = (P_RESERVED_NAME + R_O))
        {
            set omit_flags: OMIT_SPEC
            if parm.kind <> P_MINUS
                set omit_flags: omit_flags | OMIT_START
            let allow_omission AllowedParams.a2(host, P_RESERVED_NAME + R_O, P_MINUS)
            if this.parse_param(allow_omission, decl_input_level, parm) = false
                return false
            if parm.kind <> P_MINUS
                set omit_flags: omit_flags | OMIT_END
            let allow_content AllowedParams.a5(host, P_RESERVED_NAME + R_CDATA, P_RESERVED_NAME + R_RCDATA, P_RESERVED_NAME + R_EMPTY, P_RESERVED_NAME + R_ANY, P_MODELGROUP)
            if this.parse_param(allow_content, decl_input_level, parm) = false
                return false
        }
        else
        {
            ; missingTagMinimization (parseDecl.cxx:639): the omitted-tag
            ; minimization parameter was omitted, which is only allowed under
            ; OMITTAG NO. Reported at the current cursor (just past the content
            ; token). E0 — no argument.
            if ps.get_sd().omittag()
                this.report0(ParserMessages.missingTagMinimization())
        }

        let dtd ps.get_def_dtd()
        let loc ps.current_location()
        let allow_mdc AllowedParams.a1(host, P_MDC)
        var def: pointer[ElementDefinition] null

        if parm.kind = (P_RESERVED_NAME + R_CDATA)
        {
            set def: ElementDefinition.make(host, loc, dtd.alloc_element_definition_index(), omit_flags, DC_CDATA, false)
            if this.parse_param(allow_mdc, decl_input_level, parm) = false
                return false
        }
        else if parm.kind = (P_RESERVED_NAME + R_RCDATA)
        {
            set def: ElementDefinition.make(host, loc, dtd.alloc_element_definition_index(), omit_flags, DC_RCDATA, false)
            if this.parse_param(allow_mdc, decl_input_level, parm) = false
                return false
        }
        else if parm.kind = (P_RESERVED_NAME + R_EMPTY)
        {
            set def: ElementDefinition.make(host, loc, dtd.alloc_element_definition_index(), omit_flags, DC_EMPTY, false)
            if this.parse_param(allow_mdc, decl_input_level, parm) = false
                return false
        }
        else if parm.kind = (P_RESERVED_NAME + R_ANY)
        {
            set def: ElementDefinition.make(host, loc, dtd.alloc_element_definition_index(), omit_flags, DC_ANY, false)
            if this.parse_exceptions(decl_input_level, def) = false
                return false
        }
        else if parm.kind = P_MODELGROUP
        {
            ; parseDecl.cxx:685 — the grand total of content tokens vs
            ; GRPGTCNT; the outermost model group isn't formally a token.
            let gtcnt ContentToken.grpgtcnt_of(parm.model_group)
            let grpgtcnt_q ps.get_syntax().get_quantity(qGRPGTCNT)
            if (gtcnt - (1 as u64)) > (grpgtcnt_q as u64)
                this.report_num_at(ParserMessages.grpgtcnt(), grpgtcnt_q as u64, ps.current_input().token_start_location())
            let ambiguities ContentToken.new_amb_vec(host)
            var pcdata_unreachable false
            let compiled ContentToken.compile(host, parm.model_group, dtd.n_element_type_index(), ambiguities, &pcdata_unreachable)
            ; pcdataUnreachable is option-gated (options().warnMixedContent,
            ; parseDecl.cxx:695) — with the -w CLI flags.
            ; reportAmbiguity loop (parseDecl.cxx:697): validate-gated; plain
            ; message() = the current token's start (the just-consumed group
            ; close, verified 2:25/2:28/2:31/2:38 against real onsgmls).
            if ps.validate()
            {
                let amb_loc ps.current_input().token_start_location()
                var a_i: size_t 0
                let a_n ambiguities.get_length()
                let a_buf ambiguities.get_buffer()
                while a_i < a_n
                {
                    let amb a_buf + a_i
                    this.report_ambiguity(amb.from, amb.to1, amb.to2, amb.and_depth, amb_loc)
                    set a_i: a_i + 1
                }
            }
            set def: ElementDefinition.make_with_model(host, loc, dtd.alloc_element_definition_index(), omit_flags, DC_MODEL_GROUP, compiled)
            if this.parse_exceptions(decl_input_level, def) = false
                return false
        }
        else
        {
            ; the allow set admits only CDATA/RCDATA/EMPTY/ANY/model group,
            ; all handled above — the reference has no further case.
            return false
        }

        def.compute_mode()

        var e_index: size_t 0
        let ecount elements.get_length()
        let ebuf elements.get_buffer()
        while e_index < ecount
        {
            let e *(ebuf + e_index)
            if e.get_definition() = null
                e.set_element_definition(def, e_index)
            else
            {
                ; duplicateElementDefinition (parseDecl.cxx:719): this element type
                ; already has a definition. Gated on validate(); arg = element name
                ; (quoted); location = the just-consumed MDC (current_location is one
                ; past it, so use the current token's start).
                if ps.validate()
                {
                    let gi e.get_name()
                    let loc ps.current_input().token_start_location()
                    this.report1_at(ParserMessages.duplicateElementDefinition(), gi, loc)
                }
            }
            set e_index: e_index + 1
        }
        true
    }

    ; parseExceptions(declInputLevel, def)
    function parse_exceptions(this: Parser, decl_input_level: u32, def: pointer[ElementDefinition]) returns bool
    {
        let parm Param.make(host)
        let allow_exc AllowedParams.a3(host, P_MDC, P_EXCLUSIONS, P_INCLUSIONS)
        if this.parse_param(allow_exc, decl_input_level, parm) = false
            return false
        if parm.kind = P_EXCLUSIONS
        {
            def.set_exclusions(parm.elements)
            let allow_inc AllowedParams.a2(host, P_MDC, P_INCLUSIONS)
            if this.parse_param(allow_inc, decl_input_level, parm) = false
                return false
        }
        if parm.kind = P_INCLUSIONS
        {
            def.set_inclusions(parm.elements)
            let allow_mdc AllowedParams.a1(host, P_MDC)
            if this.parse_param(allow_mdc, decl_input_level, parm) = false
                return false
        }
        true
    }

    ; ---- parseAttlistDecl (scoped: no Lpd/notation-fanout/afdr/events) ----
    function parse_attlist_decl(this: Parser) returns bool
    {
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        var attributed Array[pointer[void]]^host()
        var is_notation false
        if this.parse_attributed(decl_input_level, parm, &attributed, &is_notation) = false
            return false

        var defs Array[pointer[AttributeDefinition]]^host()
        var any_current false
        ; parseDecl.cxx:899 — one per attribute name, plus one per group token.
        var attcnt: size_t 0
        let allow_name AllowedParams.a1(host, P_NAME)
        if this.parse_param(allow_name, decl_input_level, parm) = false
            return false

        while parm.kind <> P_MDC
        {
            let attribute_name parm.token
            let orig_attribute_name parm.orig_token
            set attcnt: attcnt + (1 as size_t)

            let declared_value this.parse_declared_value(decl_input_level, is_notation, parm)
            if declared_value = null
                return false
            let group_tokens (*declared_value).get_tokens()
            if group_tokens <> null
                set attcnt: attcnt + group_tokens.get_length()

            var def: pointer[AttributeDefinition] null
            if this.parse_default_value(decl_input_level, is_notation, parm, attribute_name, declared_value, &def, &any_current) = false
                return false
            def.set_orig_name(orig_attribute_name)
            defs.add(def)

            let allow_name_mdc AllowedParams.a2(host, P_NAME, P_MDC)
            if this.parse_param(allow_name_mdc, decl_input_level, parm) = false
                return false
        }
        ; parseDecl.cxx:975 — the accumulated count vs ATTCNT (both numbers).
        let attcnt_q ps.get_syntax().get_quantity(qATTCNT) as size_t
        if attcnt > attcnt_q
            this.report_num_num_at(ParserMessages.attcnt(), attcnt as u64, attcnt_q as u64, ps.current_input().token_start_location())

        let dtd ps.get_def_dtd()
        let adl AttributeDefinitionList.make(host, dtd.alloc_attribute_definition_list_index())
        let nd defs.get_length()
        let dbuf defs.get_buffer()
        var i: size_t 0
        while i < nd
        {
            adl.append(*(dbuf + i))
            set i: i + 1
        }

        let na attributed.get_length()
        let abuf attributed.get_buffer()
        var j: size_t 0
        while j < na
        {
            let a *(abuf + j)
            ; a second ATTLIST for the same element/notation is a duplicate
            ; attribute definition list (parseDecl.cxx:1009/1034) — reported at
            ; the just-consumed MDC (current_location is one past it).
            let mdc_loc ps.current_input().token_start_location()
            if is_notation
            {
                let nt a as pointer[Notation]
                if nt.get_attribute_def() = null
                    nt.set_attribute_def(adl)
                else
                {
                    let nn nt.get_name()
                    this.report1_at(ParserMessages.duplicateAttlistNotation(), nn, mdc_loc)
                }
            }
            else
            {
                let e a as pointer[ElementType]
                if e.get_attribute_def() = null
                    e.set_attribute_def(adl)
                else
                {
                    let en e.get_name()
                    this.report1_at(ParserMessages.duplicateAttlistElement(), en, mdc_loc)
                }
            }
            set j: j + 1
        }
        true
    }

    ; parseAttributed(declInputLevel, parm, attributed, isNotation) — scoped:
    ; NOTATION data-attributes + element (name / name group). ALL / IMPLICIT and
    ; the Lpd branches are deferred.
    function parse_attributed(this: Parser, decl_input_level: u32, parm: pointer[Param], attributed: pointer[Array[pointer[void]]], out_is_notation: pointer[bool]) returns bool
    {
        let ind_notation P_INDICATED_RESERVED_NAME + R_NOTATION
        let allow AllowedParams.a3(host, P_NAME, P_NAMEGROUP, ind_notation)
        if this.parse_param(allow, decl_input_level, parm) = false
        {
            set *out_is_notation: false
            return false
        }
        if parm.kind = ind_notation
        {
            set *out_is_notation: true
            let allow2 AllowedParams.a2(host, P_NAME, P_NAMEGROUP)
            if this.parse_param(allow2, decl_input_level, parm) = false
                return false
            if parm.kind = P_NAMEGROUP
            {
                let nt parm.name_tokens
                let n nt.get_length()
                let buf nt.get_buffer()
                var i: size_t 0
                while i < n
                {
                    let entry *(buf + i)
                    let nt_ptr this.lookup_create_notation(entry.name)
                    attributed.add(nt_ptr as pointer[void])
                    set i: i + 1
                }
            }
            else
            {
                let nt_ptr this.lookup_create_notation(parm.token)
                attributed.add(nt_ptr as pointer[void])
            }
        }
        else
        {
            set *out_is_notation: false
            if parm.kind = P_NAMEGROUP
            {
                let nt parm.name_tokens
                let n nt.get_length()
                let buf nt.get_buffer()
                var i: size_t 0
                while i < n
                {
                    let entry *(buf + i)
                    let el_ptr this.lookup_create_element(entry.name)
                    attributed.add(el_ptr as pointer[void])
                    set i: i + 1
                }
            }
            else
            {
                let el_ptr this.lookup_create_element(parm.token)
                attributed.add(el_ptr as pointer[void])
            }
        }
        true
    }

    ; parseDeclaredValue -> a DeclaredValue (null on failure). rDATA deferred.
    function parse_declared_value(this: Parser, decl_input_level: u32, is_notation: bool, parm: pointer[Param]) returns pointer[DeclaredValue]
    {
        var codes int[17]
        let cp codes as pointer[int]
        set *(cp + (0 as size_t)): P_RESERVED_NAME + R_CDATA
        set *(cp + (1 as size_t)): P_RESERVED_NAME + R_ENTITY
        set *(cp + (2 as size_t)): P_RESERVED_NAME + R_ENTITIES
        set *(cp + (3 as size_t)): P_RESERVED_NAME + R_ID
        set *(cp + (4 as size_t)): P_RESERVED_NAME + R_IDREF
        set *(cp + (5 as size_t)): P_RESERVED_NAME + R_IDREFS
        set *(cp + (6 as size_t)): P_RESERVED_NAME + R_NAME
        set *(cp + (7 as size_t)): P_RESERVED_NAME + R_NAMES
        set *(cp + (8 as size_t)): P_RESERVED_NAME + R_NMTOKEN
        set *(cp + (9 as size_t)): P_RESERVED_NAME + R_NMTOKENS
        set *(cp + (10 as size_t)): P_RESERVED_NAME + R_NUMBER
        set *(cp + (11 as size_t)): P_RESERVED_NAME + R_NUMBERS
        set *(cp + (12 as size_t)): P_RESERVED_NAME + R_NUTOKEN
        set *(cp + (13 as size_t)): P_RESERVED_NAME + R_NUTOKENS
        set *(cp + (14 as size_t)): P_RESERVED_NAME + R_NOTATION
        set *(cp + (15 as size_t)): P_NAMETOKENGROUP
        set *(cp + (16 as size_t)): P_RESERVED_NAME + R_DATA
        let allow AllowedParams.an(host, cp, 16)
        if this.parse_param(allow, decl_input_level, parm) = false
            return null

        let k parm.kind
        if k = (P_RESERVED_NAME + R_CDATA)
            return DeclaredValue.make_cdata(host)
        if k = (P_RESERVED_NAME + R_ENTITY)
            return DeclaredValue.make_entity(host, false)
        if k = (P_RESERVED_NAME + R_ENTITIES)
            return DeclaredValue.make_entity(host, true)
        if k = (P_RESERVED_NAME + R_ID)
            return DeclaredValue.make_id(host)
        if k = (P_RESERVED_NAME + R_IDREF)
            return DeclaredValue.make_idref(host, false)
        if k = (P_RESERVED_NAME + R_IDREFS)
            return DeclaredValue.make_idref(host, true)
        if k = (P_RESERVED_NAME + R_NAME)
            return DeclaredValue.make_tokenized(host, TT_NAME, false)
        if k = (P_RESERVED_NAME + R_NAMES)
            return DeclaredValue.make_tokenized(host, TT_NAME, true)
        if k = (P_RESERVED_NAME + R_NMTOKEN)
            return DeclaredValue.make_tokenized(host, TT_NAMETOKEN, false)
        if k = (P_RESERVED_NAME + R_NMTOKENS)
            return DeclaredValue.make_tokenized(host, TT_NAMETOKEN, true)
        if k = (P_RESERVED_NAME + R_NUMBER)
            return DeclaredValue.make_tokenized(host, TT_NUMBER, false)
        if k = (P_RESERVED_NAME + R_NUMBERS)
            return DeclaredValue.make_tokenized(host, TT_NUMBER, true)
        if k = (P_RESERVED_NAME + R_NUTOKEN)
            return DeclaredValue.make_tokenized(host, TT_NUMBERTOKEN, false)
        if k = (P_RESERVED_NAME + R_NUTOKENS)
            return DeclaredValue.make_tokenized(host, TT_NUMBERTOKEN, true)
        if k = (P_RESERVED_NAME + R_NOTATION)
        {
            let allow_ng AllowedParams.a1(host, P_NAMEGROUP)
            if this.parse_param(allow_ng, decl_input_level, parm) = false
                return null
            let group this.group_names(parm)
            return DeclaredValue.make_notation(host, group)
        }
        if k = P_NAMETOKENGROUP
        {
            let group this.group_names(parm)
            return DeclaredValue.make_name_token_group(host, group)
        }
        ; Every allowed kind is handled above, so this is the reference's
        ; CANNOT_HAPPEN. NB the WWW-only DATA declared value (data attributes,
        ; parseDecl.cxx:127: `sd().www() ? allowDeclaredValueData : ...`) is
        ; NOT in the allow set yet — parse_param reports paramInvalidToken for
        ; it; porting DataDeclaredValue belongs to the data-attribute family.
        null
    }

    function group_names(this: Parser, parm: pointer[Param]) returns pointer[Array[StringC]]
    {
        let out Array[StringC]^host()
        let nt parm.name_tokens
        let n nt.get_length()
        let buf nt.get_buffer()
        var i: size_t 0
        while i < n
        {
            let entry *(buf + i)
            out.add(entry.name)
            set i: i + 1
        }
        out
    }

    ; parseDefaultValue -> writes *out_def. scoped makeValue (pure part only).
    function parse_default_value(this: Parser, decl_input_level: u32, is_notation: bool, parm: pointer[Param], attribute_name: StringC, declared_value: pointer[DeclaredValue], out_def: pointer[pointer[AttributeDefinition]], any_current: pointer[bool]) returns bool
    {
        let ind_fixed P_INDICATED_RESERVED_NAME + R_FIXED
        let ind_required P_INDICATED_RESERVED_NAME + R_REQUIRED
        let ind_current P_INDICATED_RESERVED_NAME + R_CURRENT
        let ind_conref P_INDICATED_RESERVED_NAME + R_CONREF
        let ind_implied P_INDICATED_RESERVED_NAME + R_IMPLIED
        var lit_type: int P_ATTRIBUTEVALUELITERAL
        if declared_value.tokenized()
            set lit_type: P_TOKENIZEDATTRIBUTEVALUELITERAL
        let allow AllowedParams.a7(host, ind_fixed, ind_required, ind_current, ind_conref, ind_implied, P_ATTRIBUTEVALUE, lit_type)
        if this.parse_param(allow, decl_input_level, parm) = false
            return false

        let dtd ps.get_def_dtd()
        if parm.kind = ind_fixed
        {
            let allow_val AllowedParams.a2(host, P_ATTRIBUTEVALUE, lit_type)
            if this.parse_param(allow_val, decl_input_level, parm) = false
                return false
            let value this.make_attribute_value(declared_value, parm.literal_text, attribute_name)
            ; idDeclaredValue (parseDecl.cxx:1439): an ID attribute may only
            ; default to IMPLIED or REQUIRED.
            if declared_value.is_id()
                this.report0_at(ParserMessages.idDeclaredValue(), ps.current_input().token_start_location())
            set *out_def: AttributeDefinition.make_fixed(host, attribute_name, declared_value, value)
        }
        else if (parm.kind = P_ATTRIBUTEVALUE) or (parm.kind = P_ATTRIBUTEVALUELITERAL) or (parm.kind = P_TOKENIZEDATTRIBUTEVALUELITERAL)
        {
            let value this.make_attribute_value(declared_value, parm.literal_text, attribute_name)
            if declared_value.is_id()
                this.report0_at(ParserMessages.idDeclaredValue(), ps.current_input().token_start_location())
            set *out_def: AttributeDefinition.make_default(host, attribute_name, declared_value, value)
        }
        else if parm.kind = ind_required
            set *out_def: AttributeDefinition.make_required(host, attribute_name, declared_value)
        else if parm.kind = ind_current
        {
            set *any_current: true
            set *out_def: AttributeDefinition.make_current(host, attribute_name, declared_value, dtd.alloc_current_attribute_index())
        }
        else if parm.kind = ind_conref
            set *out_def: AttributeDefinition.make_conref(host, attribute_name, declared_value)
        else if parm.kind = ind_implied
            set *out_def: AttributeDefinition.make_implied(host, attribute_name, declared_value)
        else
        {
            ; every kind the allow set admits is handled above — the
            ; reference's CANNOT_HAPPEN (parseDecl.cxx parseDefaultValue).
            return false
        }
        true
    }

    ; makeValue for a DTD default/FIXED value (parseDefaultValue calls
    ; declaredValue->makeValue): CDATA -> cdata value; tokenized -> fold +
    ; space-split. The validation half (category/length checks, group
    ; membership) runs here at DECLARATION time, exactly like the reference —
    ; entity/notation/id RESOLUTION stays instance-side (makeSemantics).
    function make_attribute_value(this: Parser, dv: pointer[DeclaredValue], text: pointer[Text], attribute_name: StringC) returns pointer[AttributeValue]
    {
        ; parseDefaultValue's specLength is local and discarded.
        var dummy_spec: size_t 0
        if dv.tokenized() = false
        {
            this.validate_attribute_value(dv, text, attribute_name, &dummy_spec)
            return AttributeValue.make_cdata(host, text)
        }
        ; tokenized: NAMECASE-fold the value (general subst — TokenizedDeclaredValue
        ; ::makeTokenizedValue), then record the single-space separator positions.
        ; A default/fixed value is built here (not through set_value), so its fold
        ; happens here (e.g. an enumerated default `a` -> `A`). Entity-name values
        ; go through entitySubstTable = identity (NAMECASE ENTITY NO), like
        ; set_value — a folded default would name the wrong entity.
        let fold_general dv.is_entity() = false
        let raw text.string()
        let rn raw.get_size()
        if rn > (0 as size_t)
        {
            let syn ps.get_syntax()
            let fbuf host.allocate(rn * (4 as size_t), 4) as pointer[u32]
            var fi: size_t 0
            while fi < rn
            {
                var fc raw.get(fi)
                if fold_general
                    set fc: syn.fold(fc)
                set *(fbuf + fi): fc
                set fi: fi + 1
            }
            set *text: Text(StringC^host(fbuf, rn))
        }
        this.validate_attribute_value(dv, text, attribute_name, &dummy_spec)
        let sc text.string()
        let n sc.get_size()
        let space_index Array[size_t]^host()
        var i: size_t 0
        while i < n
        {
            if sc.get(i) = (0x20 as u32)
                space_index.add(i)
            set i: i + 1
        }
        AttributeValue.make_tokenized(host, text, space_index)
    }

    ; ---- parseNotationDecl -------------------------------------------------
    function parse_notation_decl(this: Parser) returns bool
    {
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        let allow_name AllowedParams.a1(host, P_NAME)
        if this.parse_param(allow_name, decl_input_level, parm) = false
            return false
        let name_loc ps.current_input().token_start_location()
        let nt this.lookup_create_notation(parm.token)
        ; duplicateNotationDeclaration (parseDecl.cxx:1566): gated on validate();
        ; arg = notation name (quoted); location = the name token's start.
        if ps.validate() and nt.is_defined()
        {
            let nn parm.token
            this.report1_at(ParserMessages.duplicateNotationDeclaration(), nn, name_loc)
        }
        let allow_pub_sys AllowedParams.a2(host, P_RESERVED_NAME + R_PUBLIC, P_RESERVED_NAME + R_SYSTEM)
        if this.parse_param(allow_pub_sys, decl_input_level, parm) = false
            return false
        let allow_sys_mdc AllowedParams.a2(host, P_SYSTEMIDENTIFIER, P_MDC)
        let allow_mdc AllowedParams.a1(host, P_MDC)
        var id ExternalId()
        if this.parse_external_id(allow_sys_mdc, allow_mdc, decl_input_level, parm, &id) = false
            return false
        ; parseDecl.cxx:1593: under FORMAL YES a notation's public id that IS a
        ; formal public identifier must have text class NOTATION (getTextClass
        ; yields one only for type fpi). Plain message() = the MDC token start.
        if ps.validate()
        {
            let sdp ps.get_sd()
            if sdp.formal()
            {
                if id.get_public_type() = PUBLIC_FPI
                {
                    if id.get_text_class() <> TC_NOTATION
                        this.report0_at(ParserMessages.notationIdentifierTextClass(), ps.current_input().token_start_location())
                }
            }
        }
        if nt.is_defined() = false
        {
            ; pin the id strings to the run page (ExternalId.make) — `id` aliases
            ; the transient literal buffer (cf. parse_entity_decl); the ESIS
            ; writer reads them long after this declaration (the notation's
            ; p/s definition lines).
            let hid ExternalId.make(host, id)
            nt.set_external_id(*hid, ps.current_location())
        }
        true
    }

    ; ---- parseEntityDecl ---------------------------------------------------
    ; mdo_loc: the declaration's MDO (markupLocation()) — the entity's defLocation_.
    function parse_entity_decl(this: Parser, mdo_loc: Location) returns bool
    {
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        let ind_default P_INDICATED_RESERVED_NAME + R_DEFAULT
        let allow_start AllowedParams.a3(host, P_ENTITYNAME, ind_default, P_PERO)
        if this.parse_param(allow_start, decl_input_level, parm) = false
            return false

        ; The entity name is captured NOW (parm.token is valid here and gets
        ; overwritten by the later text/MDC reads) by deep-copying it into a
        ; heap InternalEntity's name FIELD — the only `^host` form that lowers
        ; correctly (local/return forms mis-lower to empty/garbage).
        var is_parameter false
        var iep: pointer[InternalEntity] null
        if parm.kind = P_PERO
        {
            set is_parameter: true
            let allow_pen AllowedParams.a1(host, P_PARAMENTITYNAME)
            if this.parse_param(allow_pen, decl_input_level, parm) = false
                return false
            set iep: InternalEntity.make(host, parm.token, StringC(), DT_SGML)
        }
        else if parm.kind = P_ENTITYNAME
            set iep: InternalEntity.make(host, parm.token, StringC(), DT_SGML)
        else
            set iep: InternalEntity.make(host, StringC(), StringC(), DT_SGML)
        ; (indDEFAULT -> empty name, the default entity)
        let name iep.get_name()

        var text_codes int[10]
        let tcp text_codes as pointer[int]
        set *(tcp + (0 as size_t)): P_PARAMLITERAL
        set *(tcp + (1 as size_t)): P_RESERVED_NAME + R_CDATA
        set *(tcp + (2 as size_t)): P_RESERVED_NAME + R_SDATA
        set *(tcp + (3 as size_t)): P_RESERVED_NAME + R_PI
        set *(tcp + (4 as size_t)): P_RESERVED_NAME + R_STARTTAG
        set *(tcp + (5 as size_t)): P_RESERVED_NAME + R_ENDTAG
        set *(tcp + (6 as size_t)): P_RESERVED_NAME + R_MS
        set *(tcp + (7 as size_t)): P_RESERVED_NAME + R_MD
        set *(tcp + (8 as size_t)): P_RESERVED_NAME + R_SYSTEM
        set *(tcp + (9 as size_t)): P_RESERVED_NAME + R_PUBLIC
        let allow_text AllowedParams.an(host, tcp, 10)
        if this.parse_param(allow_text, decl_input_level, parm) = false
            return false

        if (parm.kind = (P_RESERVED_NAME + R_SYSTEM)) or (parm.kind = (P_RESERVED_NAME + R_PUBLIC))
            return this.parse_external_entity(name, is_parameter, decl_input_level, parm, mdo_loc)

        ; bracketed text (parseDecl.cxx:68-134): STARTTAG/ENDTAG/MS/MD wrap the
        ; parameter literal in the corresponding delimiters at reference time.
        var data_type: int DT_SGML
        var bracketed: int 0
        if parm.kind = (P_RESERVED_NAME + R_CDATA)
            set data_type: DT_CDATA
        else if parm.kind = (P_RESERVED_NAME + R_SDATA)
            set data_type: DT_SDATA
        else if parm.kind = (P_RESERVED_NAME + R_PI)
            set data_type: DT_PI
        else if parm.kind = (P_RESERVED_NAME + R_STARTTAG)
            set bracketed: 1
        else if parm.kind = (P_RESERVED_NAME + R_ENDTAG)
            set bracketed: 2
        else if parm.kind = (P_RESERVED_NAME + R_MS)
            set bracketed: 3
        else if parm.kind = (P_RESERVED_NAME + R_MD)
            set bracketed: 4

        if parm.kind <> P_PARAMLITERAL
        {
            let allow_pl AllowedParams.a1(host, P_PARAMLITERAL)
            if this.parse_param(allow_pl, decl_input_level, parm) = false
                return false
        }
        let lt parm.literal_text
        let text_sc lt.string()
        ; DEEP-COPY the replacement text onto the host page — like the name — so it
        ; does not alias the transient literal buffer (which later parsing reuses;
        ; a shallow store corrupted it to a later token by reference time).
        if bracketed = 0
            set iep.text: StringC^host(text_sc.data_ptr(), text_sc.get_size())
        else
        {
            ; open/close delimiter strings per bracket kind (parseDecl.cxx:98).
            let wrap Array[u32]^host()
            if bracketed = 1
                this.append_delim_chars(wrap, dSTAGO)
            else if bracketed = 2
                this.append_delim_chars(wrap, dETAGO)
            else if bracketed = 3
            {
                this.append_delim_chars(wrap, dMDO)
                this.append_delim_chars(wrap, dDSO)
            }
            else
                this.append_delim_chars(wrap, dMDO)
            this.arg_append(wrap, text_sc)
            if bracketed = 1
                this.append_delim_chars(wrap, dTAGC)
            else if bracketed = 2
                this.append_delim_chars(wrap, dTAGC)
            else if bracketed = 3
            {
                this.append_delim_chars(wrap, dMSC)
                this.append_delim_chars(wrap, dMDC)
            }
            else
                this.append_delim_chars(wrap, dMDC)
            let total wrap.get_length()
            set iep.text: StringC^host(wrap.get_buffer(), total)
            ; bracketedLitlen (parseDecl.cxx:134): only when the DELIMITERS
            ; push the interpreted text past LITLEN (the literal alone fits).
            let litlen ps.get_syntax().get_quantity(qLITLEN) as size_t
            if (total > litlen) and (text_sc.get_size() <= litlen)
                this.report_num_at(ParserMessages.bracketedLitlen(), litlen as u64, ps.current_input().token_start_location())
        }

        let allow_mdc AllowedParams.a1(host, P_MDC)
        if this.parse_param(allow_mdc, decl_input_level, parm) = false
            return false

        ; internalParameterDataEntity (parseDecl.cxx:141): an internal parameter
        ; entity cannot be CDATA or SDATA — reported at the MDC, NOT defined.
        if is_parameter and ((data_type = DT_CDATA) or (data_type = DT_SDATA))
        {
            this.report1_at(ParserMessages.internalParameterDataEntity(), name, ps.current_input().token_start_location())
            return true
        }

        set iep.data_type: data_type
        let ent host.allocate(sizeof Entity, alignof Entity) as pointer[Entity]
        let iev *iep
        set *ent: Entity.Internal(iev)
        this.maybe_define_entity(ent, is_parameter)
        true
    }

    ; parseExternalEntity(name, isParameter, declInputLevel, parm, mdo_loc).
    ; mdo_loc = markupLocation() — every entity built here carries it as its
    ; defLocation_ (where entityNotationUndefined and the "entity was defined
    ; here" auxiliary point: the declaration's MDO, verified col 0).
    function parse_external_entity(this: Parser, name: StringC, is_parameter: bool, decl_input_level: u32, parm: pointer[Param], mdo_loc: Location) returns bool
    {
        var sys_codes int[6]
        let scp sys_codes as pointer[int]
        set *(scp + (0 as size_t)): P_SYSTEMIDENTIFIER
        set *(scp + (1 as size_t)): P_RESERVED_NAME + R_SUBDOC
        set *(scp + (2 as size_t)): P_RESERVED_NAME + R_CDATA
        set *(scp + (3 as size_t)): P_RESERVED_NAME + R_SDATA
        set *(scp + (4 as size_t)): P_RESERVED_NAME + R_NDATA
        set *(scp + (5 as size_t)): P_MDC
        let allow_sys AllowedParams.an(host, scp, 6)
        let allow_end AllowedParams.a5(host, P_RESERVED_NAME + R_SUBDOC, P_RESERVED_NAME + R_CDATA, P_RESERVED_NAME + R_SDATA, P_RESERVED_NAME + R_NDATA, P_MDC)
        var id ExternalId()
        if this.parse_external_id(allow_sys, allow_end, decl_input_level, parm, &id) = false
            return false
        ; pin the id strings to the run page IMMEDIATELY (ExternalId.make) —
        ; `id` points into the literal buffer, which the very next parse_param
        ; (the notation name / DSO / MDC of the data arms) reuses; a late copy
        ; pins garbage. Capture the CURRENT declaration base directory too
        ; (this <!ENTITY>'s file) so a relative system id resolves against the
        ; right directory when used later — by then the declaring file is off
        ; the input stack.
        let hid ExternalId.make(host, id)
        let hbase String^host(ps.get_decl_base_dir())

        if parm.kind = P_MDC
        {
            let ent host.allocate(sizeof Entity, alignof Entity) as pointer[Entity]
            set *ent: Entity.ExternalText(ExternalTextEntity(name, *hid, hbase, mdo_loc))
            this.maybe_define_entity(ent, is_parameter)
            return true
        }

        let allow_mdc AllowedParams.a1(host, P_MDC)
        let ent host.allocate(sizeof Entity, alignof Entity) as pointer[Entity]
        if parm.kind = (P_RESERVED_NAME + R_SUBDOC)
        {
            ; the reference reports subdocEntity when the SGML declaration says
            ; SUBDOC NO. Our Sd does not model the SUBDOC feature; the reference
            ; (implied) declaration says SUBDOC YES so no message fires there —
            ; the xml.dcl (SUBDOC NO) case is owed to FEATURES parsing (full
            ; parseSd axis), like the other constant Sd feature accessors.
            if this.parse_param(allow_mdc, decl_input_level, parm) = false
                return false
            set *ent: Entity.Subdoc(SubdocEntity(name, *hid, hbase, mdo_loc))
        }
        else
        {
            var data_type: int DT_NDATA
            if parm.kind = (P_RESERVED_NAME + R_CDATA)
                set data_type: DT_CDATA
            else if parm.kind = (P_RESERVED_NAME + R_SDATA)
                set data_type: DT_SDATA
            ; (warnExternalCdataEntity / warnExternalSdataEntity: option-off.)
            let allow_notname AllowedParams.a1(host, P_NAME)
            if this.parse_param(allow_notname, decl_input_level, parm) = false
                return false
            let nt this.lookup_create_notation(parm.token)
            let allow_dso_mdc AllowedParams.a2(host, P_DSO, P_MDC)
            if this.parse_param(allow_dso_mdc, decl_input_level, parm) = false
                return false
            ; the entity's data attributes: an AttributeList over the notation's
            ; attribute definitions — either specified in a DSO group here or
            ; defaulted by finish() (the writer's D records read them).
            let adl nt.get_attribute_def()
            let atts AttributeList.make(host, adl)
            let ctx ps.get_attribute_context()
            if parm.kind = P_DSO
            {
                if atts.size() = (0 as size_t)
                    if ps.get_sd().www() = false
                    {
                        ; notationNoAttributes — a data attribute specification
                        ; for a notation that defined none.
                        let nnm nt.get_name()
                        this.report1(ParserMessages.notationNoAttributes(), nnm)
                    }
                var net false
                var new_att_def: pointer[AttributeDefinitionList] null
                if this.parse_attribute_spec(asMode, atts, &net, &new_att_def) = false
                    return false
                if new_att_def <> null
                {
                    let dtd ps.get_def_dtd()
                    new_att_def.set_index(dtd.alloc_attribute_definition_list_index())
                    nt.set_attribute_def(new_att_def)
                }
                if atts.n_spec_of() = (0 as size_t)
                    this.report0(ParserMessages.emptyDataAttributeSpec())
                if this.parse_param(allow_mdc, decl_input_level, parm) = false
                    return false
            }
            else
            {
                atts.finish(ctx)
                this.check_missing_semantics(atts)
            }
            set *ent: Entity.ExternalData(ExternalDataEntity(name, *hid, hbase, mdo_loc, data_type, nt as pointer[void], atts as pointer[void]))
        }
        ; external CDATA/SDATA/NDATA/SUBDOC parameter entities are rejected
        ; (reported, NOT defined) unless WWW extensions are on.
        if is_parameter
            if ps.get_sd().www() = false
            {
                this.report1(ParserMessages.externalParameterDataSubdocEntity(), name)
                return true
            }
        this.maybe_define_entity(ent, is_parameter)
        true
    }

    ; maybeDefineEntity (scoped): insert into the def DTD (the Lpd/defaulted
    ; arms are LINK-axis); a FRESH insert runs generateSystemId (a duplicate
    ; keeps the old definition and generates nothing).
    function maybe_define_entity(this: Parser, entity: pointer[Entity], is_parameter: bool)
    {
        let dtd ps.get_def_dtd()
        let name entity.get_name()
        if name.get_size() = (0 as size_t)
            dtd.set_default_entity(entity)
        else
        {
            let inserted dtd.insert_entity(entity, is_parameter, false)
            if inserted = entity
                this.generate_system_id(entity, is_parameter)
        }
    }

    ; ExternalEntity::generateSystemId (Entity.cxx:127), run at define time.
    ; With a system id the storage manager resolves it (our effective id is the
    ; base-dir join computed lazily at use sites) — silent. With only a public
    ; id there is no catalog mapping → cannotGenerateSystemIdPublic (W, arg =
    ; the public id text). With neither → cannotGenerateSystemIdGeneral /
    ; ...Parameter (W, arg = the entity name). All at the current token start
    ; (the MDC — verified 3:19/4:20 vs real onsgmls). Internal entities and
    ; notation declarations generate nothing (notations verified silent).
    function generate_system_id(this: Parser, entity: pointer[Entity], is_parameter: bool)
    {
        if entity.is_external() = false
            return
        let id entity.get_external_id()
        if id.has_system_id()
            return
        let loc ps.current_input().token_start_location()
        if id.has_public_id()
        {
            ; widen the (8-bit) public id String into a StringC message arg.
            let pub id.get_public_id()
            let pn pub.get_length()
            let pbuf host.allocate(pn * (4 as size_t), 4) as pointer[u32]
            var pi: size_t 0
            while pi < pn
            {
                set *(pbuf + pi): pub.get(pi) as u32
                set pi: pi + 1
            }
            let parg StringC(pbuf, pn)
            this.report1_at(ParserMessages.cannotGenerateSystemIdPublic(), parg, loc)
            return
        }
        let ename entity.get_name()
        if is_parameter
            this.report1_at(ParserMessages.cannotGenerateSystemIdParameter(), ename, loc)
        else
            this.report1_at(ParserMessages.cannotGenerateSystemIdGeneral(), ename, loc)
    }

    ; ---- parseShortrefDecl -------------------------------------------------
    function parse_shortref_decl(this: Parser) returns bool
    {
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        let allow_name AllowedParams.a1(host, P_NAME)
        if this.parse_param(allow_name, decl_input_level, parm) = false
            return false
        let map this.lookup_create_map(parm.token)
        if map.defined() = false
            map.set_def_location(ps.current_location())

        let allow_pl AllowedParams.a1(host, P_PARAMLITERAL)
        if this.parse_param(allow_pl, decl_input_level, parm) = false
            return false

        let dtd ps.get_def_dtd()
        let vec Array[StringC]^host()
        var running true
        while running
        {
            let delim parm.literal_text.string()
            let sr_index dtd.intern_shortref(delim)
            ; grow vec to sr_index+1
            while vec.get_length() <= sr_index
                vec.add(StringC())
            let allow_ent AllowedParams.a1(host, P_ENTITYNAME)
            if this.parse_param(allow_ent, decl_input_level, parm) = false
                return false
            vec.put(sr_index, parm.token)
            let allow_pl_mdc AllowedParams.a2(host, P_PARAMLITERAL, P_MDC)
            if this.parse_param(allow_pl_mdc, decl_input_level, parm) = false
                return false
            if parm.kind = P_MDC
                set running: false
        }
        map.set_name_map(vec)
        true
    }

    ; The reserved-name-in-context dispatch of the "declaration not allowed in X"
    ; trio (parseDecl.cxx doProlog/doDtdSubset, parseInstance.cxx doContent). Each
    ; predicate names EXACTLY the declaration reserved names the reference reports
    ; as not-allowed in that context; every other recognized reserved name falls to
    ; the switch's noSuchDeclarationType default at the call site.
    ; doProlog: only DOCTYPE (and the deferred LINKTYPE) start a prolog declaration.
    function prolog_declaration_not_allowed(this: Parser, rn: int) returns bool
    {
        if rn = R_ELEMENT
            return true
        if rn = R_ATTLIST
            return true
        if rn = R_ENTITY
            return true
        if rn = R_NOTATION
            return true
        if rn = R_SHORTREF
            return true
        if rn = R_USEMAP
            return true
        if rn = R_USELINK
            return true
        if rn = R_LINK
            return true
        if rn = R_IDLINK
            return true
        false
    }

    ; doDtdSubset (inDtd): ELEMENT/ATTLIST/ENTITY/NOTATION/SHORTREF/USEMAP belong in
    ; a DTD; DOCTYPE/LINKTYPE/USELINK/LINK/IDLINK do not.
    function dtd_subset_declaration_not_allowed(this: Parser, rn: int) returns bool
    {
        if rn = R_DOCTYPE
            return true
        if rn = R_LINKTYPE
            return true
        if rn = R_USELINK
            return true
        if rn = R_LINK
            return true
        if rn = R_IDLINK
            return true
        false
    }

    ; doContent: USEMAP/USELINK are the only markup declarations allowed in the
    ; instance; DOCTYPE/LINKTYPE/ELEMENT/ATTLIST/ENTITY/NOTATION/SHORTREF/LINK/IDLINK
    ; are not.
    function instance_declaration_not_allowed(this: Parser, rn: int) returns bool
    {
        if rn = R_DOCTYPE
            return true
        if rn = R_LINKTYPE
            return true
        if rn = R_ELEMENT
            return true
        if rn = R_ATTLIST
            return true
        if rn = R_ENTITY
            return true
        if rn = R_NOTATION
            return true
        if rn = R_SHORTREF
            return true
        if rn = R_LINK
            return true
        if rn = R_IDLINK
            return true
        false
    }

    ; ---- parseDeclarationName (after MDO) ---------------------------------
    function parse_declaration_name(this: Parser, out_rn: pointer[int]) returns bool
    {
        ps.current_input().discard_initial()
        this.extend_name_token(this.namelen(), ParserMessages.nameLength())
        let name this.name_folded()
        let rn this.lookup_reserved_name(name)
        if rn < 0
        {
            ; noSuchDeclarationType (parseDecl.cxx:529): the reserved name read is
            ; not a declaration type. Arg = the folded name (quoted); location =
            ; the name token's start.
            let loc ps.current_input().token_start_location()
            this.report1_at(ParserMessages.noSuchDeclarationType(), name, loc)
            return false
        }
        set *out_rn: rn
        true
    }

    ; parseComment (parseCommon.cxx): read a comment body up to the closing COM
    ; (`--`). The markup capture is not wanted for ESIS; just consume the chars.
    ; tokenEe inside a comment is an error.
    function parse_comment(this: Parser, mode: int) returns bool
    {
        ; startLoc (parseCommon.cxx:537) — where the comment opened; the
        ; auxiliary "comment started here" line points at it.
        let start_loc ps.current_location()
        var running true
        var ok true
        while running
        {
            let token ps.get_token(mode)
            if token = tokenCom
                set running: false
            else if token = tokenEe
            {
                ; commentEntityEnd (parseCommon.cxx:550): unterminated comment.
                this.report0_aux(ParserMessages.commentEntityEnd(), ps.current_input().token_start_location(), ParserMessages.commentEntityEnd_aux(), start_loc)
                set ok: false
                set running: false
            }
            else if token = tokenUnrecognized
            {
                ; parseComment's tokenUnrecognized arm (parseCommon.cxx:546):
                ; a non-SGML char reports nonSgmlCharacter; a valid SGML char
                ; that is not significant in the SD comment mode reports
                ; sdCommentSignificant. report_non_sgml_param CONSUMES the
                ; char either way (a zero-length unrecognized token would
                ; loop forever otherwise — only reachable in sdcomMode, whose
                ; tokenChar set is significant, not sgmlChar).
                if this.report_non_sgml_param() = false
                {
                    let ins ps.current_input()
                    let ts ins.current_token_string()
                    this.report1_at(ParserMessages.sdCommentSignificant(), ts, ins.token_start_location())
                }
            }
            ; else: a comment character (already consumed by get_token) — continue
        }
        ok
    }

    ; parseProcessingInstruction (parseCommon.cxx): the PIO (`<?`) is already
    ; consumed; read chars in piMode up to the PIC (`?>` / `>`), accumulating the
    ; raw PI content, then queue a PI event. SgmlsEventHandler::pi emits it as
    ; `?` + data + RE. onsgmls treats an XML declaration (`<?xml ...?>`) as a
    ; perfectly ordinary PI — no special-casing.
    function parse_processing_instruction(this: Parser) returns bool
    {
        let loc ps.current_location()
        let buf Array[u32]^host()
        var running true
        var ok true
        while running
        {
            let token ps.get_token(piMode)
            if token = tokenPic
                set running: false
            else if token = tokenEe
            {
                ; processingInstructionEntityEnd (parseCommon.cxx:28).
                this.report0_at(ParserMessages.processingInstructionEntityEnd(), ps.current_input().token_start_location())
                set ok: false
                set running: false
            }
            else
            {
                ; tokenChar / tokenUnrecognized — accumulate the char(s).
                let ins ps.current_input()
                let ts ins.current_token_string()
                let m ts.get_size()
                let pilen_q ps.get_syntax().get_quantity(qPILEN) as size_t
                var i: size_t 0
                while i < m
                {
                    buf.add(ts.get(i))
                    ; parseCommon.cxx:35 — past TWICE the limit the PIC is
                    ; assumed missing: report the length AND the missing
                    ; delimiter, abandon the PI (the rest re-scans as content).
                    if (buf.get_length() / (2 as size_t)) > pilen_q
                    {
                        let ploc ps.current_input().token_start_location()
                        this.report_num_at(ParserMessages.processingInstructionLength(), pilen_q as u64, ploc)
                        this.report0_at(ParserMessages.processingInstructionClose(), ploc)
                        return false
                    }
                    set i: i + 1
                }
            }
        }
        if ok
        {
            let cnt buf.get_length()
            ; parseCommon.cxx:44 — the closed PI's data over PILEN.
            let pilen_q ps.get_syntax().get_quantity(qPILEN) as size_t
            if cnt > pilen_q
                this.report_num_at(ParserMessages.processingInstructionLength(), pilen_q as u64, ps.current_input().token_start_location())
            var sc: StringC StringC()
            if cnt > (0 as size_t)
            {
                let cb host.allocate(cnt * (4 as size_t), 4) as pointer[u32]
                let src buf.get_buffer()
                var j: size_t 0
                while j < cnt
                {
                    set *(cb + j): *(src + j)
                    set j: j + 1
                }
                set sc: StringC^host(cb, cnt)
            }
            let ev Event.make_pi(host, sc, loc)
            ps.queue_event(ev)
        }
        ok
    }

    ; parseCommentDecl (parseDecl.cxx): a `<!-- ... -->` comment declaration. The
    ; opening MDO+COM (tokenMdoCom `<!--`) is already consumed; read the first
    ; comment body, then in mdMode allow whitespace / further comments before the
    ; closing MDC (`>`).
    function parse_comment_decl(this: Parser) returns bool
    {
        ; markupLocation() — the MDO that opened the declaration (the tokenMdoCom
        ; the caller just consumed); the "comment declaration started here"
        ; auxiliaries point at it.
        let mdo_loc ps.current_input().token_start_location()
        if this.parse_comment(comMode) = false
            return false
        var running true
        var ok true
        while running
        {
            let token ps.get_token(mdMode)
            if token = tokenS
            {
                ; whitespace between comments / before the MDC: skip
            }
            else if token = tokenCom
            {
                if this.parse_comment(comMode) = false
                {
                    set ok: false
                    set running: false
                }
            }
            else if token = tokenMdc
                set running: false
            else if token = tokenEe
            {
                ; declarationLevel (parseDecl.cxx parseCommentDecl tokenEe).
                this.report0_at(ParserMessages.declarationLevel(), ps.current_input().token_start_location())
                set ok: false
                set running: false
            }
            else if token = tokenUnrecognized
            {
                ; commentDeclarationCharacter + "comment declaration started
                ; here" at the MDO; a non-SGML character reports separately
                ; and continues (parseDecl.cxx parseCommentDecl).
                if this.report_non_sgml_param() = false
                {
                    let ct ps.current_token()
                    this.report1_aux(ParserMessages.commentDeclarationCharacter(), ct, ps.current_input().token_start_location(), ParserMessages.commentDeclarationCharacter_aux(), mdo_loc)
                    set ok: false
                    set running: false
                }
            }
            else
            {
                ; commentDeclInvalidToken: any other markup-declaration token.
                let a1 this.token_message_arg(token, mdMode)
                this.report_raw_aux(ParserMessages.commentDeclInvalidToken(), a1, ps.current_input().token_start_location(), ParserMessages.commentDeclInvalidToken_aux(), mdo_loc)
                set ok: false
                set running: false
            }
        }
        ok
    }

    ; ---- doDeclSubset (scoped driver) -------------------------------------
    ; Drives a declaration subset (internal or external). `subset_level` is the
    ; input level the subset itself occupies (1 for the document's internal
    ; subset; the pushed entity's level for an external subset); an end-of-entity
    ; that pops BELOW that level ends the subset. `external` selects the external
    ; subset's termination (end-of-entity, no DSC). Returns 0 at end of subset.
    ; PIs / PE-refs / marked sections recover rather than resolving (deferred).
    function parse_decl_subset(this: Parser, subset_level: u32, external: bool) returns int
    {
        ps.set_current_mode(dsMode)
        var running true
        var rc: int 0
        while running
        {
            let token ps.get_token(ps.get_current_mode())
            let start_level ps.get_input_level()
            if token = tokenEe
            {
                if (external = false) and (ps.get_input_level() = subset_level)
                {
                    ; documentEndDtdSubset (doDeclSubset tokenEe, inputLevel 1):
                    ; the DOCUMENT entity ended inside the internal subset —
                    ; message BEFORE popping, then abort the run (allDone()).
                    ; Without this the caller went on to read the DSC from an
                    ; empty input stack (segfault).
                    this.report0_at(ParserMessages.documentEndDtdSubset(), ps.current_input().token_start_location())
                    ps.pop_input_stack()
                    set rc: 1
                    set running: false
                }
                else
                {
                    ; end of an entity: pop it. When we drop below the subset's
                    ; own level the subset is finished (an external subset ends
                    ; here; a nested parameter entity returns to the subset).
                    ps.pop_input_stack()
                    if ps.get_input_level() < subset_level
                        set running: false
                }
            }
            else if token = tokenDsc
            {
                if external
                    this.decl_subset_recover(start_level)
                else
                    set running: false
            }
            else if token = tokenMdoCom
            {
                if this.parse_comment_decl() = false
                    this.decl_subset_recover(start_level)
            }
            else if token = tokenMdoNameStart
            {
                ; markupLocation() — the MDO of the declaration (the token start
                ; BEFORE parse_declaration_name re-tokenizes the name). It becomes
                ; an entity's defLocation_ (EntityDecl ctor takes markup.location()),
                ; where entityNotationUndefined and the "entity was defined here"
                ; auxiliary point.
                let mdo_loc ps.current_input().token_start_location()
                var decl_name: int 0
                if this.parse_declaration_name(&decl_name)
                {
                    var result false
                    if decl_name = R_ELEMENT
                        set result: this.parse_element_decl()
                    else if decl_name = R_ATTLIST
                        set result: this.parse_attlist_decl()
                    else if decl_name = R_ENTITY
                        set result: this.parse_entity_decl(mdo_loc)
                    else if decl_name = R_NOTATION
                        set result: this.parse_notation_decl()
                    else if decl_name = R_SHORTREF
                        set result: this.parse_shortref_decl()
                    else
                    {
                        ; doDtdSubset (parseDecl.cxx:368): a declaration reserved
                        ; name not allowed in a DTD subset -> dtdSubsetDeclaration;
                        ; any other recognized reserved name -> noSuchDeclarationType.
                        ; USEMAP is allowed in a DTD (parseUsemapDecl) but is not
                        ; ported — left as err(71), corpus-unreached.
                        let spell this.name_folded()
                        let dloc ps.current_input().token_start_location()
                        if this.dtd_subset_declaration_not_allowed(decl_name)
                            this.report1_at(ParserMessages.dtdSubsetDeclaration(), spell, dloc)
                        else if decl_name = R_USEMAP
                            this.err(71)
                        else
                            this.report1_at(ParserMessages.noSuchDeclarationType(), spell, dloc)
                        set result: false
                    }
                    if result = false
                        this.decl_subset_recover(start_level)
                }
                else
                    this.decl_subset_recover(start_level)
            }
            else if token = tokenS
            {
                ; whitespace between declarations: skip
            }
            else if token = tokenMdoMdc
            {
                ; empty comment declaration: skip
            }
            else if token = tokenMdoDso
            {
                ; doDeclSubset case tokenMdoDso: a marked section declaration
                ; (`<![ status [`). The ParserState marked-section machine already
                ; handles the dsMode<->dsiMode switching (startMarkedSection).
                if this.parse_marked_section_decl_start() = false
                    this.decl_subset_recover(start_level)
            }
            else if token = tokenMscMdc
            {
                ; doDeclSubset case tokenMscMdc: a `]]>` closing the innermost
                ; open marked section (endMarkedSection restores dsMode).
                this.handle_marked_section_end()
            }
            else if token = tokenIgnoredChar
            {
                ; a char inside an IGNORE marked section (imsMode) — no event
                ; wanted for ESIS; skip.
            }
            else if (token = tokenRe) or (token = tokenRs) or (token = tokenCroNameStart) or (token = tokenCroDigit) or (token = tokenHcroHexDigit) or (token = tokenEroNameStart) or (token = tokenEroGrpo) or (token = tokenChar)
            {
                ; doDeclSubset: these occur only inside a CDATA or RCDATA marked
                ; section (cmsMode/rcmsMode) — data is not allowed in a
                ; declaration subset. One message at the first data token, then
                ; recover to the section's `]]>`.
                let dloc ps.current_input().token_start_location()
                this.report0_at(ParserMessages.dataMarkedSectionDeclSubset(), dloc)
                this.decl_subset_recover(start_level)
            }
            else if token = tokenPio
            {
                ; a processing instruction in the declaration subset (doDeclSubset
                ; case tokenPio) — e.g. an external DTD that opens with `<?xml?>`.
                if this.parse_processing_instruction() = false
                    this.decl_subset_recover(start_level)
            }
            else if (token = tokenPeroNameStart) or (token = tokenPeroGrpo)
            {
                ; doDeclSubset case tokenPeroNameStart: a parameter-entity reference
                ; BETWEEN declarations -> dsReference stacks it; its tokens (whole
                ; declarations) then flow into this same loop, and the tokenEe arm
                ; above pops it when exhausted.
                if this.parse_parameter_entity_reference() = false
                    this.decl_subset_recover(start_level)
            }
            else
            {
                ; a stray character between declarations (doDeclSubset's
                ; tokenUnrecognized): if it is a non-SGML char (C0/DEL — sgmlChar
                ; in our scanner, so it reaches here) reportNonSgmlCharacter and
                ; break; otherwise declSubsetCharacter (the token spelling, quoted)
                ; — matching parseDecl.cxx:246. Then recover past it either way.
                let dc ps.current_input().current_char()
                let loc ps.current_input().token_start_location()
                if this.is_non_sgml_char(dc)
                    this.report_num_at(ParserMessages.nonSgmlCharacter(), dc as u64, loc)
                else
                {
                    ; currentToken() is the single unrecognized char (the scanner
                    ; leaves the token zero-length here, so build it from the char).
                    var cbuf u32[1]
                    set *(cbuf as pointer[u32]): dc
                    let tok StringC^host(cbuf as pointer[u32], 1 as size_t)
                    this.report1_at(ParserMessages.declSubsetCharacter(), tok, loc)
                }
                this.decl_subset_recover(start_level)
            }
        }
        rc
    }

    ; declSubsetRecover(startLevel) — skip to the next declaration boundary.
    function decl_subset_recover(this: Parser, start_level: u32)
    {
        var running true
        while running
        {
            let token ps.get_token(ps.get_current_mode())
            if token = tokenEe
            {
                if ps.get_input_level() <= start_level
                    set running: false
                else
                    ps.pop_input_stack()
            }
            else if (token = tokenMdoCom) or (token = tokenDsc) or (token = tokenMdoNameStart) or (token = tokenMdoMdc) or (token = tokenMdoDso) or (token = tokenMscMdc) or (token = tokenPio)
            {
                if ps.get_input_level() = start_level
                {
                    ps.current_input().unget_token()
                    set running: false
                }
            }
            else if token = tokenUnrecognized
            {
                ; consume one char to make progress.
                var advc ps.current_input().token_char()
                ps.current_input().end_token(1 as size_t)
            }
            else
            {
                ; other tokens already consumed; keep scanning.
            }
        }
    }

    ; skipDeclaration (parseInstance.cxx): after a markup declaration that is not
    ; allowed / not handled in the current context, consume tokens in mdMode until
    ; the closing MDC (`>`) at the starting input level, so parsing resumes cleanly
    ; on the token that follows the declaration. (The reference's proMode-scanning
    ; prologRecover converges on the same resume point for a well-formed but
    ; misplaced declaration, so the prolog reuses this.)
    function skip_declaration(this: Parser, start_level: u32)
    {
        var running true
        while running
        {
            let token ps.get_token(mdMode)
            if token = tokenUnrecognized
            {
                ; a stray char: consume one to make progress (getChar()).
                var advc ps.current_input().token_char()
                ps.current_input().end_token(1 as size_t)
            }
            else if token = tokenEe
            {
                if ps.get_input_level() <= start_level
                    set running: false
                else
                    ps.pop_input_stack()
            }
            else if token = tokenMdc
            {
                if ps.get_input_level() = start_level
                    set running: false
            }
            ; else: an ordinary declaration token, already consumed — keep scanning.
        }
    }

    ; ---- mode setup: install the recognizers the decl parser drives -------
    function install_recognizers(this: Parser, table: pointer[Array[PackedTokenInfo]])
    {
        let sdv *ps.get_sd()
        let synv *ps.get_syntax()
        var modes int[27]
        let mp modes as pointer[int]
        set *(mp + (0 as size_t)): dsMode
        set *(mp + (1 as size_t)): dsiMode
        set *(mp + (2 as size_t)): mdMode
        set *(mp + (3 as size_t)): mdMinusMode
        set *(mp + (4 as size_t)): mdPeroMode
        set *(mp + (5 as size_t)): grpMode
        set *(mp + (6 as size_t)): grpsufMode
        set *(mp + (7 as size_t)): plitMode
        set *(mp + (8 as size_t)): plitaMode
        set *(mp + (9 as size_t)): slitMode
        set *(mp + (10 as size_t)): slitaMode
        set *(mp + (11 as size_t)): mlitMode
        set *(mp + (12 as size_t)): mlitaMode
        set *(mp + (13 as size_t)): proMode
        set *(mp + (14 as size_t)): comMode
        set *(mp + (15 as size_t)): refMode
        ; Attribute-value-literal modes (modeUsedInProlog | modeUsedInInstance in
        ; the reference): an ATTLIST default value literal (`x CDATA "y"`) is a
        ; literal parsed DURING the declaration subset, so these must be present
        ; here, not only in the content-mode set. Without them parse_literal reads
        ; a null-recognizer tokenEe and the whole ATTLIST is dropped.
        set *(mp + (16 as size_t)): alitMode
        set *(mp + (17 as size_t)): alitaMode
        set *(mp + (18 as size_t)): aliteMode
        set *(mp + (19 as size_t)): talitMode
        set *(mp + (20 as size_t)): talitaMode
        set *(mp + (21 as size_t)): taliteMode
        ; piMode: a processing instruction (`<?...?>`) can appear in the prolog and
        ; in a declaration subset; parse_processing_instruction reads it in piMode.
        set *(mp + (22 as size_t)): piMode
        ; pliteMode: the `e` variant of the parameter-literal mode — parse_literal
        ; switches to it while an entity reference is open inside a param literal.
        set *(mp + (23 as size_t)): pliteMode
        ; Marked-section content modes: a marked section can open inside a
        ; declaration subset (doDeclSubset tokenMdoDso), so the IGNORE/CDATA/
        ; RCDATA scan modes must be installed for the prolog too, not only for
        ; the instance (same null-recognizer trap as piMode above: without them
        ; get_token yields tokenEe and the subset is silently abandoned).
        set *(mp + (24 as size_t)): imsMode
        set *(mp + (25 as size_t)): cmsMode
        set *(mp + (26 as size_t)): rcmsMode
        var i: int 0
        while i < 27
        {
            let m *(mp + (i as size_t))
            let r Recognizer.build_recognizer(host, m, sdv, synv, table)
            ps.set_recognizer(m, r)
            set i: i + 1
        }
    }

    ; ======================================================================
    ; Instance / content parsing — Stage 4, Increment 1 (the well-formed path).
    ;
    ; Ports the core of parseInstance.cxx doContent: the token-dispatch loop that
    ; walks instance content, drives the ContentState transition automaton
    ; (already ported), and appends StartElement/EndElement/characterData events
    ; in document order. Scoped to the well-formed, explicit-markup case that the
    ; simplest corpus models and the self-test exercise.
    ;
    ; OMITTAG minimization (tryImplyTag imply loop — end- and start-tag omission)
    ; landed Stage 4 Inc 4; the speculative Undo/eventList rollback is still
    ; deferred (see try_imply_tag — unreachable for conforming documents).
    ; DEFERRED to later increments (each a distinct parseInstance.cxx region):
    ;  - tag MINIMIZATION: SHORTTAG empty start/end tags, NET, ranked elements,
    ;    group tags; the tryImplyTag undo rollback for invalid documents.
    ;  - attribute-spec parsing in start tags (parseAttributeSpec); events carry
    ;    no attribute payload yet — a start tag with an attribute spec is left
    ;    unconsumed (ungetToken) for the attribute increment.
    ;  - entity/character references in content, PIs, comments, marked sections,
    ;    shortref (handleShortref), CDATA/RCDATA special parse.
    ;  - ID/IDREF checking (checkIdrefs), inclusion/exclusion recovery, the RS/RE
    ;    record-boundary event semantics (Re/Rs are treated as ignorable seps).

    ; must this element's end tag be omitted (EMPTY content)? CONREF check
    ; deferred (needs the attribute list on the event).
    function must_omit_end(this: Parser, e: pointer[ElementType]) returns bool
    {
        let def e.get_definition()
        if def = null
            return false
        def.get_declared_content() = DC_EMPTY
    }

    ; ---- attribute-spec parsing (parseAttribute.cxx) ---------------------
    ; The quoted/unquoted attribute-value path. DEFERRED: SHORTTAG name-token
    ; minimization (handleAttributeNameToken), the data-attribute / newAttDef
    ; branch (undeclared attrs), recoverUnquoted recovery, piPasMode, Markup
    ; capture, and the full makeValue validation (folding/category/id/idref/
    ; entity/notation — see AttributeList.set_value).

    ; maxLength of an attribute value literal (parseAttribute.cxx:391):
    ; LITLEN less NORMSEP, clamped at zero.
    function attribute_value_max_length(this: Parser) returns size_t
    {
        let syn ps.get_syntax()
        let litlen syn.get_quantity(qLITLEN) as size_t
        let normsep syn.get_quantity(qNORMSEP) as size_t
        if litlen > normsep
            return litlen - normsep
        0 as size_t
    }

    ; the NORMSEP > LITLEN edge (parseAttribute.cxx:402): an EMPTY value still
    ; exceeds the (negative) limit — report with the shortfall as argument.
    function report_attribute_value_length_neg(this: Parser, text: pointer[Text], neg_mt: MessageType)
    {
        if (*text).size() <> (0 as size_t)
            return
        let syn ps.get_syntax()
        let litlen syn.get_quantity(qLITLEN) as size_t
        let normsep syn.get_quantity(qNORMSEP) as size_t
        if normsep > litlen
            this.report_num_at(neg_mt, (normsep - litlen) as u64, ps.current_input().token_start_location())
    }

    function parse_attribute_value_literal(this: Parser, lita: bool, out_text: pointer[Text]) returns bool
    {
        var m alitMode
        if lita
            set m: alitaMode
        let maxlen this.attribute_value_max_length()
        if this.parse_literal(m, false, maxlen, ParserMessages.attributeValueLength(), out_text) = false
            return false
        this.report_attribute_value_length_neg(out_text, ParserMessages.attributeValueLengthNeg())
        true
    }

    function parse_tokenized_attribute_value_literal(this: Parser, lita: bool, out_text: pointer[Text]) returns bool
    {
        var m talitMode
        if lita
            set m: talitaMode
        let maxlen this.attribute_value_max_length()
        if this.parse_literal(m, true, maxlen, ParserMessages.tokenizedAttributeValueLength(), out_text) = false
            return false
        this.report_attribute_value_length_neg(out_text, ParserMessages.tokenizedAttributeValueLengthNeg())
        true
    }

    ; extendUnquotedAttributeValue (parseAttribute.cxx:373): grow the current
    ; token to the next S / non-SGML char / entity end / first TAGC char.
    function extend_unquoted_attribute_value(this: Parser)
    {
        let ins ps.current_input()
        var length ins.current_token_length()
        let syn ps.get_syntax()
        let tagc syn.delim_general_char(dTAGC, 0 as size_t)
        let sset syn.char_set(setS)
        var scanning true
        while scanning
        {
            let c ins.token_char()
            if c < 0
                set scanning: false
            else
            {
                let is_s sset.contains(c as u32)
                let is_non_sgml this.is_non_sgml_char(c as u32)
                if (is_s or is_non_sgml) or ((c as u32) = tagc)
                    set scanning: false
                else
                    set length: length + (1 as size_t)
            }
        }
        ins.end_token(length)
    }

    ; copy the current token into `text` as an attribute value with linear
    ; per-char locations. The copy pins the run page: current_token_string's
    ; buffer is transient, and a CDATA value is stored verbatim (no fold-copy
    ; in set_value), so it would dangle and read as later token bytes.
    function copy_unquoted_value(this: Parser, text: pointer[Text])
    {
        let ins ps.current_input()
        let ts ins.current_token_string()
        let tn ts.get_size()
        let tstart ins.current_token_start_index()
        let tlb host.allocate(tn * sizeof Location, alignof Location) as pointer[Location]
        let torg ins.get_origin()
        var tli: size_t 0
        while tli < tn
        {
            set *(tlb + tli): Location(torg, (tstart + tli) as u32)
            set tli: tli + 1
        }
        set *text: Text(StringC^host(ts.data_ptr(), ts.get_size()), tlb)
    }

    ; parseAttributeParameter — read the next attribute-spec token, classify it,
    ; and skip separators. allow_vi permits a value-indicator (`=`).
    function parse_attribute_parameter(this: Parser, mode: int, allow_vi: bool, result: pointer[int], net: pointer[bool]) returns bool
    {
        var token ps.get_token(mode)
        while token = tokenS
            set token: ps.get_token(mode)
        if token = tokenEe
        {
            ; attributeSpecEntityEnd (parseAttribute.cxx): entity end outside
            ; an attribute value literal.
            this.report0_at(ParserMessages.attributeSpecEntityEnd(), ps.current_input().token_start_location())
            return false
        }
        else if (token = tokenEtago) or (token = tokenStago)
        {
            ; unclosedStartTagShorttag (parseAttribute.cxx:304): a STAGO/ETAGO
            ; inside the spec ends the tag; legal only under SHORTTAG STARTTAG
            ; UNCLOSED YES (message only — the tag still ends here).
            if ps.get_sd().start_tag_unclosed() = false
                this.report0_at(ParserMessages.unclosedStartTagShorttag(), ps.current_input().token_start_location())
            let ins ps.current_input()
            ins.unget_token()
            set *net: false
            set *result: APT_END
        }
        else if token = tokenNestc
        {
            ; NESTC (`/`) closes a net-enabling start tag. Under NETENABL IMMEDNET
            ; the NET (`>`) must immediately follow (`/>`): peek it and unget so
            ; do_content sees the tokenNet that closes the element. NETENABL ALL
            ; net-enables with no immediate requirement; NETENABL NO requires
            ; SHORTTAG YES (netEnablingStartTagShorttag, message only).
            let ne ps.get_sd().start_tag_net_enable()
            if ne = NET_ENABLE_NO
                this.report0_at(ParserMessages.netEnablingStartTagShorttag(), ps.current_input().token_start_location())
            else if ne = NET_ENABLE_IMMEDNET
            {
                ; nestcWithoutNet: the NET must immediately follow the NESTC.
                if ps.get_token(econnetMode) <> tokenNet
                    this.report0_at(ParserMessages.nestcWithoutNet(), ps.current_input().token_start_location())
                ps.current_input().unget_token()
            }
            set *net: true
            set *result: APT_END
        }
        else if token = tokenTagc
        {
            set *net: false
            set *result: APT_END
        }
        else if token = tokenDsc
            set *result: APT_END
        else if token = tokenNameStart
        {
            this.extend_name_token(this.namelen(), ParserMessages.nameTokenLength())
            set *result: APT_NAME
        }
        else if (token = tokenDigit) or (token = tokenLcUcNmchar)
        {
            this.extend_name_token(this.namelen(), ParserMessages.nameTokenLength())
            set *result: APT_NAMETOKEN
        }
        else if (token = tokenLit) or (token = tokenLita)
        {
            ; a literal can only follow a VI (parseAttribute.cxx:~140).
            if allow_vi
                this.report0_at(ParserMessages.attributeSpecLiteral(), ps.current_input().token_start_location())
            else
                this.report0_at(ParserMessages.attributeSpecNameTokenExpected(), ps.current_input().token_start_location())
            return false
        }
        else if token = tokenVi
        {
            if allow_vi = false
            {
                this.report0_at(ParserMessages.attributeSpecNameTokenExpected(), ps.current_input().token_start_location())
                return false
            }
            set *result: APT_VI
        }
        else
        {
            ; tokenUnrecognized (parseAttribute.cxx:289): a genuine non-SGML
            ; character is reported and aborts the spec; any other character is
            ; recovered as an unquoted-value chunk — extended to the next
            ; S / non-SGML / TAGC — for AttributeList::recoverUnquoted.
            if this.report_non_sgml_param()
                return false
            this.extend_unquoted_attribute_value()
            set *result: APT_RECOVER_UNQUOTED
        }
        true
    }

    ; parseAttributeValueSpec — after a VI, resolve the attribute and read its
    ; value (quoted literal, or an unquoted name token via SHORTTAG).
    ; `new_att_def` is the reference's `Ptr<AttributeDefinitionList> &newAttDef`:
    ; null until an undeclared attribute forces a private, grown copy of the
    ; element's definition list. It is threaded through the whole start tag (all
    ; its undeclared attributes append to the same copy) and installed on the
    ; element type by do_parse_start_tag.
    function parse_attribute_value_spec(this: Parser, mode: int, name: StringC, atts: pointer[AttributeList], spec_length: pointer[size_t], new_att_def: pointer[pointer[AttributeDefinitionList]]) returns bool
    {
        var token ps.get_token(mode)
        while token = tokenS
            set token: ps.get_token(mode)
        let idx atts.attribute_index(name)
        var index: size_t 0
        if idx < 0
        {
            ; An attribute no ATTLIST declares. Under IMPLYDEF ATTLIST (which
            ; enableImplydef turns on for a document with no DOCTYPE) it is not an
            ; error: it gets an implied CDATA definition appended to a COPY of the
            ; element's definition list. Because the copy is installed on the
            ; element type afterwards, a LATER occurrence of the same element finds
            ; the attribute declared — and if that occurrence omits it, ESIS reports
            ; `A <name> IMPLIED`, exactly as onsgmls does. (The data-attribute
            ; branch — an undeclared attribute in a NOTATION's spec — is deferred.)
            if ps.get_implydef_attlist() = false
            {
                ; noSuchAttribute (parseAttribute.cxx:182): the element has no such
                ; attribute. Reported, but onsgmls STILL appends an implied CDATA
                ; definition and processes the value (ESIS shows `A<name> CDATA …`),
                ; so do NOT bail — fall through to the implied-def append.
                let loc ps.current_input().token_start_location()
                this.report1_at(ParserMessages.noSuchAttribute(), name, loc)
            }
            if *new_att_def = null
            {
                let cur atts.get_def()
                set *new_att_def: AttributeDefinitionList.copy(host, cur)
            }
            let nad *new_att_def
            let cdv DeclaredValue.make_cdata(host)
            let nd AttributeDefinition.make_implied(host, name, cdv)
            nad.append(nd)
            atts.change_def(host, nad)
            set index: atts.size() - (1 as size_t)
        }
        else
            set index: idx as size_t
        let ctx ps.get_attribute_context()
        ; duplicateAttributeSpec (Attribute.cxx:1274): this attribute was already
        ; specified in this start tag. Reported (arg = attr name, quoted; location =
        ; the value-token start); onsgmls still overwrites with the new value.
        if atts.specified(index)
        {
            let dloc ps.current_input().token_start_location()
            this.report1_at(ParserMessages.duplicateAttributeSpec(), name, dloc)
        }
        atts.set_spec(index, ctx)
        let text host.allocate(sizeof Text, alignof Text) as pointer[Text]
        set *text: Text(StringC())
        var ok true
        if (token = tokenLit) or (token = tokenLita)
        {
            let lita token = tokenLita
            if atts.tokenized(index)
                set ok: this.parse_tokenized_attribute_value_literal(lita, text)
            else
                set ok: this.parse_attribute_value_literal(lita, text)
        }
        else if (token = tokenNameStart) or (token = tokenDigit) or (token = tokenLcUcNmchar)
        {
            ; unquoted (SHORTTAG) value — legal only under SHORTTAG ATTRIB
            ; VALUE YES (parseAttribute.cxx:221; message at the value's first
            ; char, the un-extended token start, verified 5:7 on `v=xy`). The
            ; option-gated warnAttributeValueNotLiteral W stays unmodeled with
            ; the other -w flags.
            if ps.get_sd().attribute_value_not_literal() = false
                this.report0_at(ParserMessages.attributeValueShorttag(), ps.current_input().token_start_location())
            this.extend_name_token(this.attribute_value_max_length(), ParserMessages.attributeValueLength())
            this.copy_unquoted_value(text)
        }
        else if (token = tokenUnrecognized) or (token = tokenEtago) or (token = tokenStago) or (token = tokenNestc)
        {
            ; unquotedAttributeValue (parseAttribute.cxx:~200): recovered as an
            ; unquoted value running to the next separator/TAGC.
            this.report0_at(ParserMessages.unquotedAttributeValue(), ps.current_input().token_start_location())
            this.extend_unquoted_attribute_value()
            this.copy_unquoted_value(text)
        }
        else if token = tokenEe
        {
            this.report0_at(ParserMessages.attributeSpecEntityEnd(), ps.current_input().token_start_location())
            return false
        }
        else if (token = tokenTagc) or (token = tokenDsc) or (token = tokenVi)
        {
            ; attributeValueExpected: the VI was not followed by a value.
            this.report0_at(ParserMessages.attributeValueExpected(), ps.current_input().token_start_location())
            return false
        }
        else
        {
            ; no other token is possible here (the reference's CANNOT_HAPPEN).
            return false
        }
        if ok = false
            return false
        ; set_value folds the value in place; the makeValue validation half
        ; (validate_attribute_value: categories / lengths / group membership)
        ; then runs on the folded text and accumulates the NORMALIZED length
        ; into spec_length (the reference's specLength += normalizedLength),
        ; and the makeSemantics half follows — the reference's message order.
        let sv_ok atts.set_value(host, index, text, ctx)
        this.validate_attribute_value(atts.declared_value(index), text, name, spec_length)
        ; checkValue wraps makeValue (Attribute.h:637): notFixedValue /
        ; noteCurrentAttribute fire after the validation messages, before the
        ; makeSemantics ones.
        this.check_attribute_value(atts, index)
        this.check_value_semantics(atts, index, text)
        sv_ok
    }

    ; ParserState::getAttributeEntity (ParserState.cxx:837) — lookupEntity on
    ; the current DTD. The reference's defaulted-entity substitution (#DEFAULT
    ; clones) and the option-off warnDefaultEntityReference warning are not
    ; modeled — the content reference path shares the same gap.
    function get_attribute_entity(this: Parser, name: StringC) returns pointer[Entity]
    {
        let dtd ps.get_current_dtd()
        dtd.lookup_entity(false, name)
    }

    ; ParserState::getAttributeNotation (ParserState.cxx:810) — currentDtd
    ; lookupNotation. The implydefNotation auto-create branch is unreachable
    ; (our Sd never sets IMPLYDEF NOTATION — constant, like implydef_doctype);
    ; the resultAttributeSpecMode arm is LINK-axis.
    function get_attribute_notation(this: Parser, name: StringC) returns pointer[Notation]
    {
        let dtd ps.get_current_dtd()
        dtd.lookup_notation(name)
    }

    ; Text::charLocation(i) for the makeValue message locations. i == size
    ; resolves to one past the last char (the reference's per-item run
    ; arithmetic yields the same for the trailing position); untracked text
    ; yields the null Location (defensive — every validated Text carries
    ; per-char locations).
    function text_char_location(this: Parser, text: pointer[Text], i: size_t) returns Location
    {
        let locs (*text).get_locs()
        if locs = null
            return Location()
        let n (*text).size()
        if n = (0 as size_t)
            return Location()
        if i < n
            return *(locs + i)
        let last *(locs + (n - (1 as size_t)))
        Location(last.get_origin(), last.get_index() + (1 as u32))
    }

    ; The validation half of DeclaredValue::makeValue — reported from the
    ; parser (the check_value_semantics precedent). Runs over the FOLDED value
    ; Text (after AttributeList.set_value / the make_attribute_value fold) for
    ; BOTH instance values and DTD default/FIXED values (the reference calls
    ; makeValue from parseDefaultValue too).
    ;   CDATA/DATA (checkNormalizedLength, Attribute.cxx:90): the normalized
    ;   length (size + NORMSEP) accumulates into spec_length, with the LITLEN
    ;   overflow message.
    ;   tokenized (makeTokenizedValue, :189): per token, the declared value's
    ;   initial/subsequent character-category checks — attributeValueChar (a
    ;   char allowed nowhere), attributeValueNumberToken / attributeValueName
    ;   (a char that cannot START a number token / name) — validate-gated, at
    ;   the offending char; the NAMELEN check (nameTokenLength, NOT gated, at
    ;   the char just past the token). An empty value or one ending in a
    ;   space (only enterable via a numeric char ref — parse_literal collapses
    ;   plain spaces) reports attributeValueSyntax; a second token in a
    ;   non-list value reports attributeValueMultiple at the first space. The
    ;   normalized length (NORMSEP + size, list adjustment per token) then
    ;   accumulates with the LITLEN check.
    ;   group (GroupDeclaredValue::makeValue, :350): the whole folded value
    ;   must be one of the declared tokens — attributeValueNotInGroup
    ;   (validate-gated; %3 lists the group). NOTATION shares this (it IS a
    ;   GroupDeclaredValue); its unknown-notation check stays in
    ;   check_value_semantics (makeSemantics).
    ; Messages with no per-char anchor (syntax / normalized-length / group)
    ; report at the current parse location, like the reference's unlocated
    ; context.message.
    function validate_attribute_value(this: Parser, dv: pointer[DeclaredValue], text: pointer[Text], attribute_name: StringC, spec_length: pointer[size_t])
    {
        if dv = null
            return
        let syn ps.get_syntax()
        let normsep syn.get_quantity(qNORMSEP) as size_t
        let litlen syn.get_quantity(qLITLEN) as size_t
        let vn (*text).size()
        if dv.tokenized() = false
        {
            let cn vn + normsep
            set *spec_length: *spec_length + cn
            if litlen >= normsep
            {
                if vn <= litlen - normsep
                {
                    if cn > litlen
                        this.report_num_num_at(ParserMessages.normalizedAttributeValueLength(), litlen as u64, cn as u64, ps.current_input().token_start_location())
                }
            }
            return
        }
        let s (*text).string()
        let initial dv.get_initial_categories()
        let subsequent dv.get_subsequent_categories()
        let namelen_q syn.get_quantity(qNAMELEN) as size_t
        let space (0x20 as u32)
        let validate ps.validate()
        var nspaces: size_t 0
        var i: size_t 0
        var running true
        while running
        {
            if i >= vn
            {
                ; empty value, or one that ends with a space.
                if validate
                    this.report0_at(ParserMessages.attributeValueSyntax(), ps.current_input().token_start_location())
                set running: false
            }
            else
            {
                let start_index i
                if validate
                {
                    let c0 s.get(i)
                    if (syn.category_of(c0) & initial) = 0
                    {
                        let cs StringC^host(s.data_ptr() + i, 1 as size_t)
                        let cloc this.text_char_location(text, i)
                        if (syn.category_of(c0) & subsequent) = 0
                            this.report2_at(ParserMessages.attributeValueChar(), *cs, attribute_name, cloc)
                        else if initial = CAT_DIGIT
                            this.report2_at(ParserMessages.attributeValueNumberToken(), *cs, attribute_name, cloc)
                        else
                            this.report2_at(ParserMessages.attributeValueName(), *cs, attribute_name, cloc)
                    }
                    else
                    {
                        set i: i + 1
                        var in_token true
                        while in_token
                        {
                            if i >= vn
                                set in_token: false
                            else if (syn.category_of(s.get(i)) & subsequent) = 0
                                set in_token: false
                            else
                                set i: i + 1
                        }
                        if i < vn
                        {
                            if s.get(i) <> space
                            {
                                ; this char is not allowed anywhere in the value
                                let cs2 StringC^host(s.data_ptr() + i, 1 as size_t)
                                let cloc2 this.text_char_location(text, i)
                                this.report2_at(ParserMessages.attributeValueChar(), *cs2, attribute_name, cloc2)
                            }
                        }
                    }
                }
                var to_space true
                while to_space
                {
                    if i >= vn
                        set to_space: false
                    else if s.get(i) = space
                        set to_space: false
                    else
                        set i: i + 1
                }
                if i - start_index > namelen_q
                {
                    let nloc this.text_char_location(text, i)
                    this.report_num_at(ParserMessages.nameTokenLength(), namelen_q as u64, nloc)
                }
                if i = vn
                    set running: false
                else
                {
                    if dv.get_is_list() = false
                    {
                        if validate
                        {
                            if nspaces = (0 as size_t)
                            {
                                let mloc this.text_char_location(text, i)
                                this.report1_at(ParserMessages.attributeValueMultiple(), attribute_name, mloc)
                            }
                        }
                    }
                    set nspaces: nspaces + 1
                    set i: i + 1
                }
            }
        }
        var tn normsep + vn
        if dv.get_is_list()
        {
            set tn: tn + (1 as size_t)
            if normsep > (0 as size_t)
                set tn: tn + ((normsep - 1) * (nspaces + 1))
            else
                set tn: tn - (nspaces + 1)
        }
        set *spec_length: *spec_length + tn
        ; a length error will already have been given if vn > litlen - normsep.
        if litlen >= normsep
        {
            if vn <= litlen - normsep
            {
                if tn > litlen
                    this.report_num_num_at(ParserMessages.normalizedAttributeValueLength(), litlen as u64, tn as u64, ps.current_input().token_start_location())
            }
        }
        let allowed dv.get_tokens()
        if allowed <> null
        {
            if validate
            {
                if dv.contains_token(s) = false
                    this.report2_vec_at(ParserMessages.attributeValueNotInGroup(), s, attribute_name, allowed, ps.current_input().token_start_location())
            }
        }
    }

    ; The makeSemantics half of makeValue (Attribute.cxx) — reported from the
    ; parser (the duplicateAttributeSpec precedent).
    ;   ID/IDREF (IdDeclaredValue/IdrefDeclaredValue, :534/:556): an ID value
    ;   defines its id — a repeat reports duplicateId (E1, at the value token)
    ;   with the "ID %1 first defined here" auxiliary at the FIRST definition;
    ;   each IDREF token books a pending reference, resolved at document end
    ;   (check_idrefs -> missingId). define_id/note_idref gate themselves on
    ;   inInstance+validate, so DTD default/FIXED values never book anything.
    ;   ENTITY/ENTITIES (EntityDeclaredValue, :472): per token,
    ;   getAttributeEntity — unknown reports invalidEntityAttribute, a non-data
    ;   entity notDataOrSubdocEntity (both E1, validate-gated, at the token
    ;   start); the token count accumulates into nEntityNames (GRPCNT check in
    ;   finish); ALL tokens valid -> EntityAttributeSemantics on the Attribute,
    ;   any invalid -> NO semantics (the ESIS A-line then says TOKEN).
    ;   NOTATION (NotationDeclaredValue, :430): the WHOLE value is the name;
    ;   unknown reports invalidNotationAttribute (E1, validate-gated, at the
    ;   first token) and leaves no semantics.
    ; Values are single-space-normalized by parse_literal, so tokens split on
    ; one 0x20; token locations come from the value Text's per-char locations
    ; (verified vs real onsgmls: each message points at its token's first
    ; char, entity-expanded tokens resolving through the origin chain).
    ; nIdrefs/nEntityNames accumulate on the AttributeList; the GRPCNT checks
    ; run in the finish tail (check_missing_semantics).
    function check_value_semantics(this: Parser, atts: pointer[AttributeList], index: size_t, text: pointer[Text])
    {
        ; TokenizedAttributeValue::makeSemantics (Attribute.cxx:1077): an
        ; empty value has no semantics — no lookups, no messages, no counts.
        if (*text).size() = (0 as size_t)
            return
        let is_id atts.id(index)
        let is_idref atts.idref(index)
        let is_ent atts.entity(index)
        if atts.notation(index)
        {
            let s (*text).string()
            let nt this.get_attribute_notation(s)
            if nt = null
            {
                if ps.validate()
                {
                    let tloc0 (*text).loc_at(0 as size_t)
                    let sc StringC^host(s.data_ptr(), s.get_size())
                    this.report1_at(ParserMessages.invalidNotationAttribute(), *sc, tloc0)
                }
                return
            }
            let a atts.attribute(index)
            let sem AttributeSemantics.make_notation(host, nt as pointer[void])
            a.set_semantics(sem)
            return
        }
        if (is_id = false) and (is_idref = false) and (is_ent = false)
            return
        let s (*text).string()
        let n s.get_size()
        var valid true
        var ntokens: u32 0
        let ents Array[pointer[void]]^host()
        var start: size_t 0
        while start < n
        {
            var e start
            var scanning true
            while scanning
            {
                if e >= n
                    set scanning: false
                else if s.get(e) = (0x20 as u32)
                    set scanning: false
                else
                    set e: e + 1
            }
            let tok StringC^host(s.data_ptr() + start, e - start)
            let tloc (*text).loc_at(start)
            set ntokens: ntokens + (1 as u32)
            if is_id
            {
                var prev_loc Location()
                if ps.define_id(*tok, tloc, &prev_loc) = false
                    this.report1_aux(ParserMessages.duplicateId(), *tok, tloc, ParserMessages.duplicateId_aux(), prev_loc)
            }
            else if is_idref
            {
                ps.note_idref(*tok, tloc)
                ; IdrefDeclaredValue::makeSemantics (Attribute.cxx:564).
                atts.add_idrefs(1 as u32)
            }
            else
            {
                let ent this.get_attribute_entity(*tok)
                if ent = null
                {
                    if ps.validate()
                        this.report1_at(ParserMessages.invalidEntityAttribute(), *tok, tloc)
                    set valid: false
                }
                else if ent.is_data_or_subdoc() = false
                {
                    if ps.validate()
                        this.report1_at(ParserMessages.notDataOrSubdocEntity(), *tok, tloc)
                    set valid: false
                }
                else
                    ents.add(ent as pointer[void])
            }
            set start: e + (1 as size_t)
        }
        if is_ent
        {
            atts.add_entity_names(ntokens)
            if valid
            {
                let a atts.attribute(index)
                let sem AttributeSemantics.make_entity(host, &ents)
                a.set_semantics(sem)
            }
        }
    }

    ; AttributeDefinition::checkValue (Attribute.cxx:617) — the wrapper around
    ; makeValue for SPECIFIED values; two overrides exist:
    ;   CURRENT (:719) noteCurrentAttribute — remember the value so a later tag
    ;   omitting the attribute reuses it (ESIS-visible);
    ;   FIXED (:840) — compare against the declared default, notFixedValue
    ;   (E1, validate-gated) when they differ. The reference compares
    ;   Text::fixedEqual (string + entity-item structure) for CDATA and the
    ;   normalized strings for tokenized values; our Text carries no item
    ;   structure, so both arms compare the value strings (value and default
    ;   share one DeclaredValue, so their types always agree). Location:
    ;   unlocated context.message = current token START (the literal's closing
    ;   quote — same convention as the other makeValue messages, verified
    ;   5:11 on `<doc v="2.0">`).
    function check_attribute_value(this: Parser, atts: pointer[AttributeList], index: size_t)
    {
        let d atts.definition(index)
        if d = null
            return
        if d.is_current()
        {
            let ctx ps.get_attribute_context()
            let v atts.value(index)
            ctx.note_current_attribute(d.get_current_index(), v)
        }
        if d.is_fixed()
        {
            if ps.validate()
            {
                let v atts.value(index)
                let fixed d.get_default_value()
                if (v <> null) and (fixed <> null)
                {
                    let vt v.get_text()
                    let ft fixed.get_text()
                    if (vt <> null) and (ft <> null)
                    {
                        let vs (*vt).string()
                        let fs (*ft).string()
                        if vs.equals(fs) = false
                            this.report1_at(ParserMessages.notFixedValue(), d.get_name(), ps.current_input().token_start_location())
                    }
                }
            }
        }
    }

    ; AttributeList::recoverUnquoted (Attribute.cxx:1338) + the AttributeValue
    ; overrides (TokenizedAttributeValue :289, CdataAttributeValue :1100): the
    ; junk after the last specified value is adopted when that value is a
    ; SINGLE contiguous data item ending exactly where the junk begins —
    ; CDATA appends the junk (unquotedAttributeValue E0 at the junk start),
    ; tokenized only reports (attributeValueChar E2: first junk char + attr
    ; name). Item test under our per-char-location Text: same-origin
    ; consecutive locations, abutting the junk token, AND byte-equal to the
    ; origin's source chars — a folded char got its item location wrapped in a
    ; MultiReplacementOrigin by Text::subst (Text.cxx:183), so the reference's
    ; origin-pointer comparison FAILS then (verified: `t=a,b` aborts with
    ; attributeSpecCharacter, `t=A,B` recovers with attributeValueChar).
    ; Returns the reference's recoverUnquoted verdict: true = recovered, keep
    ; parsing the spec; false = caller runs the unterminated-literal guess.
    function recover_unquoted_spec(this: Parser, atts: pointer[AttributeList]) returns bool
    {
        let ins ps.current_input()
        let nspec atts.n_spec_of()
        if nspec = (0 as size_t)
            return false
        ; the LAST specified attribute (specIndex == nSpec-1); none found or a
        ; null value -> the reference breaks out and returns 1 (recovered,
        ; junk silently dropped).
        let n_att atts.size()
        var found false
        var ai: size_t 0
        var i: size_t 0
        while i < n_att
        {
            if atts.specified(i)
            {
                if atts.spec_index(i) = nspec - (1 as size_t)
                {
                    set found: true
                    set ai: i
                    set i: n_att
                }
                else
                    set i: i + 1
            }
            else
                set i: i + 1
        }
        if found = false
            return true
        let val atts.value(ai)
        if val = null
            return true
        if val.value_type() = AVT_IMPLIED
            return false
        let t val.get_text()
        if t = null
            return false
        let n (*t).size()
        let locs (*t).get_locs()
        if (n = (0 as size_t)) or (locs = null)
            return false
        let str_loc ins.token_start_location()
        let org0 (*locs).get_origin()
        let idx0 (*locs).get_index()
        if org0 = null
            return false
        if org0 <> str_loc.get_origin()
            return false
        if idx0 + (n as u32) <> str_loc.get_index()
            return false
        let vs (*t).string()
        let contents org0.get_contents()
        var j: size_t 0
        while j < n
        {
            let lj *(locs + j)
            if (lj.get_origin() <> org0) or (lj.get_index() <> idx0 + (j as u32))
                return false
            if contents <> null
            {
                if *(contents + ((idx0 as size_t) + j)) <> vs.get(j)
                    return false
            }
            set j: j + 1
        }
        ; the junk token (transient — deep-copy before touching the input).
        let ts ins.current_token_string()
        let sn ts.get_size()
        let sc StringC^host(ts.data_ptr(), sn)
        if atts.tokenized(ai)
        {
            let c1 StringC^host(sc.data_ptr(), 1 as size_t)
            this.report2_at(ParserMessages.attributeValueChar(), *c1, atts.name(ai), str_loc)
            return true
        }
        ; CDATA: append the junk chars (linear locations from the junk start).
        let comb host.allocate((n + sn) * (sizeof u32), alignof u32) as pointer[u32]
        let clocs host.allocate((n + sn) * (sizeof Location), alignof Location) as pointer[Location]
        var k: size_t 0
        while k < n
        {
            set *(comb + k): vs.get(k)
            set *(clocs + k): *(locs + k)
            set k: k + 1
        }
        var m: size_t 0
        while m < sn
        {
            set *(comb + n + m): sc.get(m)
            set *(clocs + n + m): Location(org0, str_loc.get_index() + (m as u32))
            set m: m + 1
        }
        let nsc StringC^host(comb, n + sn)
        set *t: Text(*nsc, clocs)
        this.report0_at(ParserMessages.unquotedAttributeValue(), str_loc)
        true
    }

    ; AttributeValue::handleAsUnterminated (Attribute.cxx:1377) on a COMPLETED
    ; value Text — the missing-closing-quote guess: reconstruct the item
    ; structure (HuState replay over the per-char locations — contiguous
    ; same-origin runs merge, exactly parse_literal's tracking), tail-strip
    ; spaces from the last data item, and when it ends with the VI delimiter
    ; report literalClosingDelimiter at the text's FIRST located char.
    function value_handle_as_unterminated(this: Parser, t: pointer[Text]) returns bool
    {
        let n (*t).size()
        if n = (0 as size_t)
            return false
        let locs (*t).get_locs()
        if locs = null
            return false
        let s (*t).string()
        let buf Array[u32]^host()
        let hu host.allocate(sizeof HuState, alignof HuState) as pointer[HuState]
        set *hu: HuState()
        var i: size_t 0
        while i < n
        {
            hu.note_data(buf, *(locs + i))
            buf.add(s.get(i))
            set i: i + 1
        }
        hu.close(buf)
        if hu.have_last = false
            return false
        var ll hu.last_len
        while (ll > (0 as size_t)) and (*(buf.get_buffer() + hu.last_start + ll - (1 as size_t)) = (0x20 as u32))
            set ll: ll - (1 as size_t)
        let syn ps.get_syntax()
        let vn syn.delim_general_len(dVI)
        if (vn = (0 as size_t)) or (ll < vn)
            return false
        var vj: size_t 0
        while vj < vn
        {
            if *(buf.get_buffer() + hu.last_start + ll - vn + vj) <> syn.delim_general_char(dVI, vj)
                return false
            set vj: vj + 1
        }
        ; startLoc = the first char location with a real origin (:1389).
        var first_loc Location()
        var fi: size_t 0
        while fi < n
        {
            let fl *(locs + fi)
            if fl.get_origin() <> null
            {
                set first_loc: fl
                set fi: n
            }
            else
                set fi: fi + 1
        }
        this.report0_at(ParserMessages.literalClosingDelimiter(), first_loc)
        true
    }

    ; AttributeList::handleAsUnterminated (Attribute.cxx:1357) — run the guess
    ; on the last specified attribute's value text.
    function atts_handle_as_unterminated(this: Parser, atts: pointer[AttributeList]) returns bool
    {
        let nspec atts.n_spec_of()
        if nspec = (0 as size_t)
            return false
        let n_att atts.size()
        var i: size_t 0
        while i < n_att
        {
            if atts.specified(i)
            {
                if atts.spec_index(i) = nspec - (1 as size_t)
                {
                    let val atts.value(i)
                    if val = null
                        return false
                    let t val.get_text()
                    if t = null
                        return false
                    return this.value_handle_as_unterminated(t)
                }
            }
            set i: i + 1
        }
        false
    }

    ; the makeSemantics half of AttributeList::finish (Attribute.cxx:1246):
    ; an UNSPECIFIED attribute whose missing value is a real tokenized value
    ; gets its semantics (ID/IDREF booking, entity/notation resolution + the
    ; validation messages) exactly like a specified one — message locations
    ; come from the DTD default literal's Text locations. Runs right after
    ; finish, in definition order, mirroring the reference's loop.
    function check_missing_semantics(this: Parser, atts: pointer[AttributeList])
    {
        let n atts.size()
        var i: size_t 0
        while i < n
        {
            if atts.specified(i) = false
            {
                ; the makeMissingValue message half (finish's loop fires it in
                ; the same iteration as the value's makeSemantics — Attribute
                ; .cxx:1247): re-derive the virtual dispatch from the kind.
                ; The CONREF exclusion (conref specified -> the NOTATION slot
                ; gets NO makeMissingValue call at all, :1248) is skipped the
                ; same way. Locations: unlocated context.message = the current
                ; token's START (the TAGC — verified 5:4 / 7:21).
                var mm_skip false
                if atts.conref_of()
                {
                    let adl atts.get_def()
                    if adl <> null
                    {
                        if adl.get_notation_index() = i
                            set mm_skip: true
                    }
                }
                if mm_skip = false
                {
                    let d atts.definition(i)
                    if d <> null
                    {
                        let kind d.get_ad_kind()
                        let ctx ps.get_attribute_context()
                        if kind = ADK_REQUIRED
                        {
                            if ps.validate()
                                this.report1_at(ParserMessages.requiredAttributeMissing(), d.get_name(), ps.current_input().token_start_location())
                        }
                        else if kind = ADK_CURRENT
                        {
                            if ctx.may_default_attribute()
                            {
                                ; finish stored getCurrentAttribute's result:
                                ; still null = no occurrence specified yet.
                                if atts.value(i) = null
                                {
                                    if ps.validate()
                                        this.report1_at(ParserMessages.currentAttributeMissing(), d.get_name(), ps.current_input().token_start_location())
                                }
                            }
                            else if ps.validate()
                                this.report1_at(ParserMessages.attributeMissing(), d.get_name(), ps.current_input().token_start_location())
                        }
                        else if (kind = ADK_DEFAULT) or (kind = ADK_FIXED)
                        {
                            if ctx.may_default_attribute() = false
                            {
                                if ps.validate()
                                    this.report1_at(ParserMessages.attributeMissing(), d.get_name(), ps.current_input().token_start_location())
                            }
                        }
                    }
                }
                let v atts.value(i)
                if v <> null
                {
                    if v.value_type() = AVT_TOKENIZED
                    {
                        let t v.get_text()
                        if t <> null
                            this.check_value_semantics(atts, i, t)
                    }
                }
            }
            set i: i + 1
        }
        ; the tail of AttributeList::finish (Attribute.cxx:1259) — runs here
        ; so the GRPCNT totals include the defaulted values' counts:
        ; idrefGrpcnt / entityNameGrpcnt (quantity errors, not validate-gated)
        ; and the CONREF/NOTATION exclusion (validate-gated).
        let syn ps.get_syntax()
        let grpcnt_q syn.get_quantity(qGRPCNT)
        if atts.n_idrefs_of() > grpcnt_q
            this.report_num_at(ParserMessages.idrefGrpcnt(), grpcnt_q as u64, ps.current_input().token_start_location())
        if atts.n_entity_names_of() > grpcnt_q
            this.report_num_at(ParserMessages.entityNameGrpcnt(), grpcnt_q as u64, ps.current_input().token_start_location())
        if ps.validate()
        {
            if atts.conref_notation_specified()
                this.report0_at(ParserMessages.conrefNotation(), ps.current_input().token_start_location())
        }
    }

    ; handleAttributeNameToken (parseAttribute.cxx) — SHORTTAG attribute-name
    ; minimization: a bare token whose attribute name was omitted (`<content
    ; multiple optional>`). Resolve the attribute whose declared enumerated /
    ; notation / nametoken value set contains `token` and record it as that
    ; attribute's value. First-match; under WebSGML a non-unique token is an
    ; error. `token` is the already-folded current name.
    function handle_attribute_name_token(this: Parser, token: StringC, atts: pointer[AttributeList], spec_length: pointer[size_t]) returns bool
    {
        let idx atts.token_index(token)
        if idx < 0
        {
            ; noSuchAttributeToken (parseAttribute.cxx:105): this token is not a
            ; member of any attribute's group. onsgmls reports it (arg = the folded
            ; token, quoted), marks the spec invalid, and CONTINUES (the attribute
            ; stays unspecified → defaults). Location = the token's start.
            let loc ps.current_input().token_start_location()
            this.report1_at(ParserMessages.noSuchAttributeToken(), token, loc)
            return true
        }
        if ps.get_sd().www()
        {
            if atts.token_index_unique(token, idx) = false
            {
                ; attributeTokenNotUnique (parseAttribute.cxx:110): the spec is
                ; noted invalid and parsing CONTINUES (the reference returns 1).
                atts.note_invalid_spec()
                this.report1_at(ParserMessages.attributeTokenNotUnique(), token, ps.current_input().token_start_location())
                return true
            }
        }
        let index idx as size_t
        ; attributeNameShorttag (parseAttribute.cxx:115): OMITNAME disabled
        ; makes the shorthand illegal (message only; the value still books).
        ; The else-arm's missingAttributeName (W0) is gated on the
        ; warnMissingAttributeName option — unmodeled with the -w flags.
        if ps.get_sd().attribute_omit_name() = false
            this.report0_at(ParserMessages.attributeNameShorttag(), ps.current_input().token_start_location())
        let ctx ps.get_attribute_context()
        atts.set_spec(index, ctx)
        let text host.allocate(sizeof Text, alignof Text) as pointer[Text]
        set *text: Text(token)
        ; GroupDeclaredValue::makeValueFromToken (Attribute.cxx:369): no
        ; category/group validation (the token matched the group) — only the
        ; LITLEN check and the normalized-length accounting (size + NORMSEP).
        let syn ps.get_syntax()
        let normsep syn.get_quantity(qNORMSEP) as size_t
        let litlen syn.get_quantity(qLITLEN) as size_t
        let tsz token.get_size()
        if (normsep > litlen) or (tsz > litlen - normsep)
            this.report_num_num_at(ParserMessages.normalizedAttributeValueLength(), litlen as u64, (tsz + normsep) as u64, ps.current_input().token_start_location())
        set *spec_length: *spec_length + tsz + normsep
        ; checkValue wraps makeValueFromToken too (Attribute.h:648) — bind the
        ; set_value result: it is this function's return value (tail position).
        let sv_ok atts.set_value(host, index, text, ctx)
        this.check_attribute_value(atts, index)
        sv_ok
    }

    ; parseAttributeSpec — the attribute-spec loop: (name VI value)* up to the
    ; close delimiter, then finish the list (fill defaults).
    function parse_attribute_spec(this: Parser, mode: int, atts: pointer[AttributeList], net: pointer[bool], new_att_def: pointer[pointer[AttributeDefinitionList]]) returns bool
    {
        var spec_length: size_t 0
        var cur_parm: int 0
        if this.parse_attribute_parameter(mode, false, &cur_parm, net) = false
            return false
        var running true
        var ok true
        while running
        {
            if cur_parm = APT_END
                set running: false
            else if cur_parm = APT_NAME
            {
                let nm this.name_folded()
                if this.parse_attribute_parameter(mode, true, &cur_parm, net) = false
                {
                    set ok: false
                    set running: false
                }
                else if cur_parm = APT_VI
                {
                    ; the attribute NAME contributes its size + NORMSEP to the
                    ; spec length (parseAttribute.cxx:41).
                    let normsep_n ps.get_syntax().get_quantity(qNORMSEP) as size_t
                    set spec_length: spec_length + nm.get_size() + normsep_n
                    if this.parse_attribute_value_spec(mode, nm, atts, &spec_length, new_att_def) = false
                    {
                        set ok: false
                        set running: false
                    }
                    else if this.parse_attribute_parameter(mode, false, &cur_parm, net) = false
                    {
                        set ok: false
                        set running: false
                    }
                }
                else
                {
                    ; SHORTTAG name value shorthand: `nm` was a NAME not followed
                    ; by a VI, so it is a value with the attribute name omitted.
                    ; The lookahead parameter (cur_parm) is reused as-is.
                    if this.handle_attribute_name_token(nm, atts, &spec_length) = false
                    {
                        set ok: false
                        set running: false
                    }
                }
            }
            else if cur_parm = APT_NAMETOKEN
            {
                ; a NAMETOKEN can never be an attribute name -> always an omitted-
                ; name value; read the next parameter afterwards.
                let nt this.name_folded()
                if this.handle_attribute_name_token(nt, atts, &spec_length) = false
                {
                    set ok: false
                    set running: false
                }
                else if this.parse_attribute_parameter(mode, false, &cur_parm, net) = false
                {
                    set ok: false
                    set running: false
                }
            }
            else if cur_parm = APT_RECOVER_UNQUOTED
            {
                ; parseAttributeSpec's recoverUnquoted arm (parseAttribute.cxx
                ; :70): adopted junk continues the spec loop; otherwise shrink
                ; the token to its first character, try the missing-closing-
                ; quote guess, and failing that report attributeSpecCharacter
                ; (arg = that character) — the spec is abandoned either way.
                if this.recover_unquoted_spec(atts)
                {
                    if this.parse_attribute_parameter(mode, false, &cur_parm, net) = false
                    {
                        set ok: false
                        set running: false
                    }
                }
                else
                {
                    let ins ps.current_input()
                    ins.end_token(1 as size_t)
                    if this.atts_handle_as_unterminated(atts) = false
                    {
                        let ts ins.current_token_string()
                        let cs StringC^host(ts.data_ptr(), ts.get_size())
                        this.report1_at(ParserMessages.attributeSpecCharacter(), *cs, ins.token_start_location())
                    }
                    set ok: false
                    set running: false
                }
            }
            else
            {
                ; cur_parm can only be APT_VI here, and every head-position
                ; parse_attribute_parameter call passes allow_vi = false, which
                ; already rejects a bare VI (attributeSpecNameTokenExpected) —
                ; unreachable (the reference's CANNOT_HAPPEN).
                set ok: false
                set running: false
            }
        }
        if ok = false
            return false
        let ctx ps.get_attribute_context()
        atts.finish(ctx)
        this.check_missing_semantics(atts)
        ; parseAttributeSpec tail (parseAttribute.cxx:89): the ATTSPLEN check
        ; over the accumulated normalized spec length.
        let attsplen_q ps.get_syntax().get_quantity(qATTSPLEN) as size_t
        if spec_length > attsplen_q
            this.report_num_num_at(ParserMessages.attsplen(), attsplen_q as u64, spec_length as u64, ps.current_input().token_start_location())
        true
    }

    function do_parse_start_tag(this: Parser, out_net: pointer[bool]) returns pointer[Event]
    {
        let ins ps.current_input()
        ; markupLocation() — the STAGO of the start tag. do_content's get_token
        ; already consumed the STAGO+name-start token, so the scan cursor sits
        ; past it; the token's START location is the STAGO. This becomes the open
        ; element's start location (and the "start tag was here" aux); `loc` below
        ; (after the GI name) is the TAGC position elementNotAllowed reports at.
        let mloc ins.token_start_location()
        ins.discard_initial()
        this.extend_name_token(this.namelen(), ParserMessages.nameLength())
        let name this.name_folded()
        let dtd ps.get_current_dtd()
        var e dtd.lookup_element_type(name)
        if e = null
        {
            let cs ps.get_content_state()
            let uloc ps.current_location()
            set e: cs.lookup_create_undefined_element(host, name, uloc, dtd, true)
        }
        let loc ps.current_location()
        let adl e.get_attribute_def()
        let atts AttributeList.make(host, adl)
        let ctx ps.get_attribute_context()
        var net false
        ; grown by an undeclared attribute (IMPLYDEF ATTLIST) — see
        ; parse_attribute_value_spec.
        var new_att_def: pointer[AttributeDefinitionList] null
        let close_token ps.get_token(tagMode)
        if close_token = tokenTagc
        {
            ; parseInstance.cxx:444 — the GI alone over TAGLEN (the cheap
            ; pre-check; check_taglen re-measures from the tag start).
            if name.get_size() > (ps.get_syntax().get_quantity(qTAGLEN) as size_t)
                this.check_taglen(mloc.get_index())
            atts.finish(ctx)
            this.check_missing_semantics(atts)
        }
        else
        {
            ins.unget_token()
            let okatt this.parse_attribute_spec(tagMode, atts, &net, &new_att_def)
            ; parse_attribute_spec finishes the list (mirrors C++ parseAttributeSpec).
            ; parseInstance.cxx:456 — the whole start tag over TAGLEN.
            if okatt
            {
                let cur_idx ps.current_input().token_start_location()
                if (cur_idx.get_index() - mloc.get_index()) > (ps.get_syntax().get_quantity(qTAGLEN) as u32)
                    this.check_taglen(mloc.get_index())
            }
        }
        ; doParseStartTag: give the grown definition list its own DTD index and
        ; install it on the element type, so it survives this start tag.
        if new_att_def <> null
        {
            let didx dtd.alloc_attribute_definition_list_index()
            new_att_def.set_index(didx)
            e.set_attribute_def(new_att_def)
        }
        set *out_net: net
        let ev Event.make_start(host, e, loc)
        ev.set_markup_loc(mloc)
        ev.set_attributes(atts)
        ev
    }

    ; checkTaglen (parseInstance.cxx:499): measure the start tag from past the
    ; STAGO to the current token and report taglen when it exceeds TAGLEN. The
    ; reference converts indexes to source offsets (startOffset — one extra per
    ; named char ref); our index model is 1:1, so the plain difference serves.
    function check_taglen(this: Parser, tag_start_index: u32)
    {
        let syn ps.get_syntax()
        let taglen_q syn.get_quantity(qTAGLEN)
        let stago_len syn.delim_general_len(dSTAGO) as u32
        let cur ps.current_input().token_start_location()
        if (cur.get_index() - (tag_start_index + stago_len)) > taglen_q
            this.report_num_at(ParserMessages.taglen(), taglen_q as u64, cur)
    }

    function parse_start_tag(this: Parser)
    {
        var net false
        let event this.do_parse_start_tag(&net)
        let e event.get_element_type()
        this.accept_start_tag(e, event, net)
    }

    ; tryImplyTag (parseInstance.cxx:748) — one OMITTAG inference step at the
    ; current position, SPECULATIVE: events buffer into `events`, every content
    ; mutation records its inverse in `undo`. The caller commits the chain with
    ; queue_element_events (releasing kept messages) or rolls it back with
    ; undo_all + discard_kept_messages. Either implies an END tag (current
    ; element finished + its end tag omissible) or a START tag (the uniquely
    ; required next element). Returns true if a tag was implied (retry the
    ; pending token).
    function try_imply_tag(this: Parser, loc: Location, start_implied: pointer[u32], undo: pointer[Array[UndoEntry]], events: pointer[Array[pointer[Event]]]) returns bool
    {
        if ps.get_sd().omittag() = false
            return false
        let cs ps.get_content_state()
        let ce cs.current_element()
        if ce.is_finished()
        {
            if cs.tag_level_of() = (0 as u32)
                return false
            let def ce.get_type().get_definition()
            if def <> null
                if def.can_omit_end_tag() = false
                    return false
            ; an end tag is implied for an element whose START tag was itself
            ; implied in this chain: the element was implied empty.
            if *start_implied > (0 as u32)
            {
                let gi_empty ce.get_type().get_name()
                this.report1_at(ParserMessages.startTagEmptyElement(), gi_empty, ps.current_input().token_start_location())
                set *start_implied: *start_implied - (1 as u32)
            }
            let e ce.get_type()
            let endev Event.make_end(host, e, loc)
            events.add(endev)
            var ue UndoEntry()
            set ue.kind: UNDO_END_TAG
            set ue.element: ps.pop_save_element_mode()
            set ue.state: null
            undo.add(ue)
            return true
        }
        let tok ce.implied_start_token()
        if tok = null
            return false
        let e ContentToken.token_element(tok)
        if e = null
            return false
        ; the required element is excluded — contextually required elements may
        ; not be excluded (E3); the imply proceeds regardless (reference).
        if cs.element_is_excluded(e)
        {
            let ord_req (ContentToken.token_type_index(tok) as u64) + (1 as u64)
            this.report_ord2_at(ParserMessages.requiredElementExcluded(), ord_req, e.get_name(), ce.get_type().get_name(), ps.current_input().token_start_location())
        }
        if cs.tag_level_of() <> (0 as u32)
        {
            var ut UndoEntry()
            set ut.kind: UNDO_TRANSITION
            set ut.element: null
            set ut.state: ce.copy_match_state(host)
            undo.add(ut)
        }
        ce.do_required_transition()
        let def2 e.get_definition()
        ; start-tag omission diagnostics (parseInstance.cxx:799-807): declared
        ; content other than a model group / ANY; an undefined element (the
        ; OMITTAG-inference undefinedElement — probe g1); a declaration that
        ; does not permit start-tag omission.
        if def2 <> null
        {
            let dc def2.get_declared_content()
            if (dc <> DC_MODEL_GROUP) and (dc <> DC_ANY)
                this.report1_at(ParserMessages.omitStartTagDeclaredContent(), e.get_name(), ps.current_input().token_start_location())
            if def2.undefined()
                this.report1_at(ParserMessages.undefinedElement(), e.get_name(), ps.current_input().token_start_location())
            else if def2.can_omit_start_tag() = false
                this.report1_at(ParserMessages.omitStartTagDeclare(), e.get_name(), ps.current_input().token_start_location())
        }
        let adl e.get_attribute_def()
        let atts AttributeList.make(host, adl)
        let ctx ps.get_attribute_context()
        atts.finish(ctx)
        ; gives an error if the element has a required attribute (kept while
        ; speculating, like the reference's finish under keepMessages).
        this.check_missing_semantics(atts)
        set *start_implied: *start_implied + (1 as u32)
        let stev Event.make_start(host, e, loc)
        stev.set_attributes(atts)
        this.push_element_check_spec(e, stev, undo, events)
        ; checkImplyLoop (parseInstance.cxx:821): break a non-advancing infinite
        ; imply chain after a fairly arbitrary limit.
        if *start_implied > (30 as u32)
            if cs.check_imply_loop(*start_implied) = false
                return false
        true
    }

    ; pushElementCheck (parseInstance.cxx:973), the SPECULATIVE variant: the
    ; start event buffers into the event list; a mustOmitEnd (EMPTY) element
    ; buffers its end event right behind it and is never pushed; otherwise the
    ; element is pushed live and the undo list records the pop.
    function push_element_check_spec(this: Parser, e: pointer[ElementType], event: pointer[Event], undo: pointer[Array[UndoEntry]], events: pointer[Array[pointer[Event]]])
    {
        let taglvl_q ps.get_syntax().get_quantity(qTAGLVL)
        if ps.get_content_state().tag_level_of() = taglvl_q
            this.report_num_at(ParserMessages.taglvlOpenElements(), taglvl_q as u64, ps.current_input().token_start_location())
        events.add(event)
        if this.must_omit_end(e)
        {
            let endev Event.make_end(host, e, event.get_loc())
            if event.is_included()
                endev.set_included()
            events.add(endev)
        }
        else
        {
            var ue UndoEntry()
            set ue.kind: UNDO_START_TAG
            set ue.element: null
            set ue.state: null
            undo.add(ue)
            let cs ps.get_content_state()
            let ce cs.current_element()
            var map e.get_map()
            if map = null
                set map: ce.get_map()
            let oe OpenElement.make(host, e, false, event.is_included(), map, event.get_markup_loc())
            ps.push_element_mode(oe)
        }
    }

    ; queueElementEvents (parseInstance.cxx:693) — the speculation commits:
    ; release the kept diagnostics, then emit the buffered events in document
    ; order, noting each start/end.
    function queue_element_events(this: Parser, events: pointer[Array[pointer[Event]]])
    {
        ps.release_kept_messages()
        let n events.get_length()
        var i: size_t 0
        while i < n
        {
            let ev *(events.get_buffer() + i)
            if ev.get_type() = EV_START_ELEMENT
                ps.note_start_element(ev.is_included())
            else
                ps.note_end_element(ev.is_included())
            ps.queue_event(ev)
            set i: i + 1
        }
    }

    ; undo (parseInstance.cxx:684) — roll the speculation back, newest first.
    function undo_all(this: Parser, undo: pointer[Array[UndoEntry]])
    {
        var i undo.get_length()
        while i > (0 as size_t)
        {
            set i: i - (1 as size_t)
            let ue *(undo.get_buffer() + i)
            if ue.kind = UNDO_START_TAG
                ps.pop_element_mode()
            else if ue.kind = UNDO_END_TAG
                ps.push_element_mode(ue.element)
            else
            {
                let cs ps.get_content_state()
                let ce cs.current_element()
                ce.set_match_state(ue.state)
            }
        }
    }

    ; checkExclusion (parseInstance.cxx:715) — the excluded element's transition
    ; token exists but is neither inherently optional nor an OR-group member:
    ; the exclusion is invalid (E3).
    function check_exclusion(this: Parser, e: pointer[ElementType])
    {
        let cs ps.get_content_state()
        let ce cs.current_element()
        let tok ce.invalid_exclusion(e)
        if tok <> null
        {
            let ord_exc (ContentToken.token_type_index(tok) as u64) + (1 as u64)
            let tname ContentToken.token_element(tok)
            var tgi StringC()
            if tname <> null
                set tgi: tname.get_name()
            this.report_ord2_at(ParserMessages.invalidExclusion(), ord_exc, tgi, ce.get_type().get_name(), ps.current_input().token_start_location())
        }
    }

    ; tryStartTag (parseInstance.cxx:725) — one admission attempt for the
    ; pending start tag after an imply step: exclusion refutes it (with the
    ; invalid-exclusion check), a clean transition or an inclusion admits it
    ; (committing the buffered chain).
    function try_start_tag(this: Parser, e: pointer[ElementType], event: pointer[Event], net: bool, events: pointer[Array[pointer[Event]]]) returns bool
    {
        let cs ps.get_content_state()
        if cs.element_is_excluded(e)
        {
            this.check_exclusion(e)
            return false
        }
        let ce cs.current_element()
        if ce.try_transition(e)
        {
            this.queue_element_events(events)
            this.push_element_check(e, event, net)
            return true
        }
        if cs.element_is_included(e)
        {
            this.queue_element_events(events)
            event.set_included()
            this.push_element_check(e, event, net)
            return true
        }
        false
    }

    function accept_start_tag(this: Parser, e: pointer[ElementType], event: pointer[Event], net: bool)
    {
        ; undefinedElement (parseInstance.cxx:643): the element's definition is
        ; the checkDtd/lookupCreate UNDEFINED one and elements may not be
        ; implied (IMPLYDEF ELEMENT NO). onsgmls reports it and ADMITS the
        ; element (undefined content pre-empts elementNotAllowed below);
        ; location = the start tag's TAGC.
        let def e.get_definition()
        var undefined false
        if def <> null
            set undefined: def.undefined()
        if undefined and (ps.get_implydef_element() = IMPLYDEF_ELEMENT_NO)
        {
            let uname e.get_name()
            this.report1_at(ParserMessages.undefinedElement(), uname, event.get_loc())
        }
        let cs ps.get_content_state()
        if cs.element_is_excluded(e)
        {
            ps.keep_messages()
            if ps.validate()
                this.check_exclusion(e)
        }
        else
        {
            let ce cs.current_element()
            if ce.try_transition(e)
            {
                this.push_element_check(e, event, net)
                return
            }
            if cs.element_is_included(e)
            {
                event.set_included()
                this.push_element_check(e, event, net)
                return
            }
            ps.keep_messages()
        }
        ; OMITTAG: imply end/start tags speculatively until e is admissible.
        ; Implied tags carry the pending event's MARKUP location (its STAGO) —
        ; the reference's event->location().
        var start_implied: u32 0
        let undo Array[UndoEntry]^host()
        let events Array[pointer[Event]]^host()
        while this.try_imply_tag(event.get_markup_loc(), &start_implied, undo, events)
        {
            if this.try_start_tag(e, event, net, events)
                return
        }
        ; Not admissible even after minimization: roll the speculation back.
        ps.discard_kept_messages()
        this.undo_all(undo)
        if ps.validate() and (undefined = false)
            this.handle_bad_start_tag(e, event, net)
        else
        {
            ; elementNotAllowed (parseInstance.cxx:676) — a plain message() at
            ; the CURRENT scan token (normally the start tag's TAGC). Gated:
            ; validating parses report it only when elements may be implied
            ; (IMPLYDEF), non-validating ones only after the document element.
            var say_not_allowed false
            if ps.validate()
                set say_not_allowed: ps.get_implydef_element() <> IMPLYDEF_ELEMENT_NO
            else
                set say_not_allowed: cs.after_document_element()
            if say_not_allowed
            {
                let gi e.get_name()
                let eloc ps.current_input().token_start_location()
                this.report1_at(ParserMessages.elementNotAllowed(), gi, eloc)
            }
            ; if the element could not occur because it was excluded, do the
            ; transition here; then force-push so parsing continues.
            let ce3 cs.current_element()
            let discard ce3.try_transition(e)
            this.push_element_check(e, event, net)
        }
    }

    ; handleBadStartTag (parseInstance.cxx:1206) — the validating recovery for
    ; a defined element the model rejects: search the possible transitions for
    ; element(s) whose own content admits it. Exactly one candidate -> report
    ; missingElementInferred, push the inferred element, then the pending one.
    ; Several -> report missingElementMultiple (candidate list in DTD order)
    ; and force-push. None -> imply an end tag (if permitted) and retry one
    ; level up; when that runs dry, elementNotAllowed + force-push.
    function handle_bad_start_tag(this: Parser, e: pointer[ElementType], event: pointer[Event], net: bool)
    {
        let cs ps.get_content_state()
        let undo Array[UndoEntry]^host()
        let events Array[pointer[Event]]^host()
        ps.keep_messages()
        var looping true
        while looping
        {
            let missing Array[pointer[ElementType]]^host()
            this.find_missing_tag(e, missing)
            if missing.get_length() = (1 as size_t)
            {
                this.queue_element_events(events)
                let m *(missing.get_buffer() + (0 as size_t))
                this.report2_at(ParserMessages.missingElementInferred(), e.get_name(), m.get_name(), ps.current_input().token_start_location())
                let adl m.get_attribute_def()
                let atts AttributeList.make(host, adl)
                let ctx ps.get_attribute_context()
                atts.finish(ctx)
                this.check_missing_semantics(atts)
                let inferev Event.make_start(host, m, event.get_markup_loc())
                inferev.set_attributes(atts)
                let ce_i cs.current_element()
                if ce_i.try_transition(m) = false
                    inferev.set_included()
                this.push_element_check(m, inferev, false)
                let ce_e cs.current_element()
                if ce_e.try_transition(e) = false
                    event.set_included()
                this.push_element_check(e, event, net)
                return
            }
            if missing.get_length() > (0 as size_t)
            {
                this.queue_element_events(events)
                let names Array[StringC]^host()
                let nm missing.get_length()
                var i: size_t 0
                while i < nm
                {
                    let mi *(missing.get_buffer() + i)
                    names.add(mi.get_name())
                    set i: i + 1
                }
                this.report_str_vec_at(ParserMessages.missingElementMultiple(), e.get_name(), names, ps.current_input().token_start_location())
                this.push_element_check(e, event, net)
                return
            }
            let ce cs.current_element()
            var can_pop false
            if ps.get_sd().omittag() and ce.is_finished() and (cs.tag_level_of() <> (0 as u32))
            {
                let def ce.get_type().get_definition()
                if def <> null
                    set can_pop: def.can_omit_end_tag()
            }
            if can_pop
            {
                let endev Event.make_end(host, ce.get_type(), event.get_markup_loc())
                events.add(endev)
                var ue UndoEntry()
                set ue.kind: UNDO_END_TAG
                set ue.element: ps.pop_save_element_mode()
                set ue.state: null
                undo.add(ue)
            }
            else
                set looping: false
        }
        ps.discard_kept_messages()
        this.undo_all(undo)
        let gi e.get_name()
        this.report1_at(ParserMessages.elementNotAllowed(), gi, ps.current_input().token_start_location())
        let ce4 cs.current_element()
        let discard ce4.try_transition(e)
        this.push_element_check(e, event, net)
    }

    ; findMissingTag (parseInstance.cxx:1273) — the candidate elements whose
    ; own content model (or inclusions) admit `e` (e = null searches for a
    ; #PCDATA host), filtered by the live exclusions, sorted in DTD declaration
    ; order (insertion sort, like the reference).
    function find_missing_tag(this: Parser, e: pointer[ElementType], v: pointer[Array[pointer[ElementType]]])
    {
        let cs ps.get_content_state()
        let ce cs.current_element()
        if ce.current_position() = null
        {
            if e = null
                v.add(null as pointer[ElementType])
            return
        }
        if e <> null
            if cs.element_is_excluded(e)
                return
        let cands Array[pointer[ElementType]]^host()
        ce.possible_transitions(cands)
        let n cands.get_length()
        var i: size_t 0
        while i < n
        {
            let cand *(cands.get_buffer() + i)
            if cand <> null
            {
                if cs.element_is_excluded(cand) = false
                {
                    var success false
                    let cdef cand.get_definition()
                    if cdef <> null
                    {
                        let dc cdef.get_declared_content()
                        if dc = DC_MODEL_GROUP
                        {
                            let grp cdef.compiled_model_group()
                            let state ContentToken.make_match_state(host, grp)
                            if e = null
                                set success: ContentToken.ms_try_transition_pcdata(state)
                            else
                            {
                                if ContentToken.ms_try_transition(state, e)
                                    set success: true
                                if success = false
                                {
                                    let ni cdef.n_inclusions()
                                    var j: size_t 0
                                    while j < ni
                                    {
                                        if cdef.inclusion(j) = e
                                        {
                                            set success: true
                                            set j: ni
                                        }
                                        else
                                            set j: j + 1
                                    }
                                }
                                if success
                                {
                                    let ne cdef.n_exclusions()
                                    var k: size_t 0
                                    while k < ne
                                    {
                                        if cdef.exclusion(k) = e
                                        {
                                            set success: false
                                            set k: ne
                                        }
                                        else
                                            set k: k + 1
                                    }
                                }
                            }
                        }
                        else if (dc = DC_CDATA) or (dc = DC_RCDATA)
                        {
                            if e = null
                                set success: true
                        }
                    }
                    if success
                        v.add(cand)
                }
            }
            set i: i + 1
        }
        ; insertion sort by DTD declaration order (ElementType::index).
        var s: size_t 1
        while s < v.get_length()
        {
            let tem *(v.get_buffer() + s)
            var j2 s
            var moving true
            while moving
            {
                if j2 > (0 as size_t)
                {
                    let prev *(v.get_buffer() + (j2 - (1 as size_t)))
                    if prev.get_index() > tem.get_index()
                    {
                        v.put(j2, prev)
                        set j2: j2 - (1 as size_t)
                    }
                    else
                        set moving: false
                }
                else
                    set moving: false
            }
            v.put(j2, tem)
            set s: s + 1
        }
    }

    function push_element_check(this: Parser, e: pointer[ElementType], event: pointer[Event], net: bool)
    {
        ; pushElementCheck (parseInstance.cxx:831) — open elements vs TAGLVL.
        let taglvl_q ps.get_syntax().get_quantity(qTAGLVL)
        if ps.get_content_state().tag_level_of() = taglvl_q
            this.report_num_at(ParserMessages.taglvlOpenElements(), taglvl_q as u64, ps.current_input().token_start_location())
        ps.note_start_element(event.is_included())
        if this.must_omit_end(e)
        {
            if ps.get_sd().empty_element_normal()
            {
                ; EMPTYNRM: emit start, then consume the empty-element tag's
                ; closing NET (`<x/>`) / end tag before implying the end.
                let included event.is_included()
                let sloc event.get_loc()
                ps.queue_event(event)
                this.end_tag_empty_element(e, net, included, sloc)
            }
            else
            {
                ; EMPTY element: emit start immediately followed by an implied end.
                ps.note_end_element(event.is_included())
                ps.queue_event(event)
                let endev Event.make_end(host, e, event.get_loc())
                if event.is_included()
                    endev.set_included()
                ps.queue_event(endev)
            }
            return
        }
        let cs ps.get_content_state()
        let ce cs.current_element()
        var map e.get_map()
        if map = null
            set map: ce.get_map()
        let oe OpenElement.make(host, e, net, event.is_included(), map, event.get_markup_loc())
        ps.push_element_mode(oe)
        ps.queue_event(event)
    }

    function parse_end_tag(this: Parser) returns pointer[Event]
    {
        let ins ps.current_input()
        ins.discard_initial()
        this.extend_name_token(this.namelen(), ParserMessages.nameLength())
        let name this.name_folded()
        let dtd ps.get_current_dtd()
        let e dtd.lookup_element_type(name)
        let loc ps.current_location()
        this.parse_end_tag_close()
        if e = null
        {
            ; an end tag naming an UNDECLARED element: it is nowhere open, so
            ; onsgmls likewise reports elementNotOpen (with the folded GI) and
            ; drops the tag. Reported here since the null type reaches no
            ; acceptEndTag. Location is the end tag's (before its TAGC).
            let mt_notopen ParserMessages.elementNotOpen()
            this.report1_at(mt_notopen, name, loc)
            return null
        }
        Event.make_end(host, e, loc)
    }

    ; parseEndTagClose (parseInstance.cxx:1036) — consume the end tag's close:
    ; S separators up to the TAGC; an ETAGO/STAGO leaves the tag unclosed
    ; (legal only under SHORTTAG YES / ENDTAG UNCLOSED); anything else is
    ; diagnosed and ends the tag.
    function parse_end_tag_close(this: Parser)
    {
        var looping true
        while looping
        {
            let token ps.get_token(tagMode)
            if token = tokenUnrecognized
            {
                ; a single character not recognized in tag mode: non-SGML chars
                ; report as such; anything else is endTagCharacter.
                let ins ps.current_input()
                if ins.current_token_length() = (0 as size_t)
                    ins.end_token(1 as size_t)
                let ts ins.current_token_string()
                let c ts.get(0 as size_t)
                let cloc ins.token_start_location()
                if this.is_non_sgml_char(c)
                    this.report_num_at(ParserMessages.nonSgmlCharacter(), c as u64, cloc)
                else
                    this.report1_at(ParserMessages.endTagCharacter(), ts, cloc)
                return
            }
            else if token = tokenEe
            {
                this.report0_at(ParserMessages.endTagEntityEnd(), ps.current_input().token_start_location())
                return
            }
            else if (token = tokenEtago) or (token = tokenStago)
            {
                if ps.get_sd().end_tag_unclosed() = false
                    this.report0_at(ParserMessages.unclosedEndTagShorttag(), ps.current_input().token_start_location())
                ps.current_input().unget_token()
                return
            }
            else if token = tokenTagc
                return
            else if token = tokenS
                set looping: looping
            else
            {
                let targ this.token_message_arg(token, tagMode)
                this.report_raw_at(ParserMessages.endTagInvalidToken(), targ, ps.current_input().token_start_location())
                return
            }
        }
    }

    ; endTagEmptyElement (EMPTYNRM) — an EMPTY element's start tag is immediately
    ; followed by the tag that ends it: a NET (`<x/>`), an empty end tag (`</>`)
    ; or a matching `</x>`. Consume that token and emit the end; anything else
    ; is ungotten and the end implied. (Mismatch-recovery is scoped to the
    ; conforming corpus: an implied end at the start location.)
    function end_tag_empty_element(this: Parser, e: pointer[ElementType], net: bool, included: bool, start_loc: Location)
    {
        var m econMode
        if net
            set m: econnetMode
        let token ps.get_token(m)
        if (token = tokenNet) and net
        {
            let endev Event.make_end(host, e, ps.current_location())
            if included
                endev.set_included()
            ps.queue_event(endev)
            ps.note_end_element(included)
            return
        }
        if token = tokenEtagoTagc
        {
            let endev Event.make_end(host, e, ps.current_location())
            if included
                endev.set_included()
            ps.queue_event(endev)
            ps.note_end_element(included)
            return
        }
        if token = tokenEtagoNameStart
        {
            let end this.parse_end_tag()
            if (end <> null) and (end.get_element_type() = e)
            {
                if included
                    end.set_included()
                ps.queue_event(end)
                ps.note_end_element(included)
                return
            }
            ; the following end tag names a DIFFERENT element. If that element is
            ; open, this empty element's (implied) end comes first, then the end
            ; tag closes the enclosing element (endTagEmptyElement: implyEmptyElementEnd
            ; then acceptEndTag). Dropping it here (the old behavior) left the
            ; enclosing element to be closed at document end — a spurious
            ; omitEndTag/notFinished diagnostic. `parse_end_tag` already returns null
            ; (and reports elementNotOpen) for an UNDECLARED name.
            if end <> null
            {
                let cs ps.get_content_state()
                if cs.element_is_open(end.get_element_type())
                {
                    let endev2 Event.make_end(host, e, start_loc)
                    if included
                        endev2.set_included()
                    ps.queue_event(endev2)
                    ps.note_end_element(included)
                    this.accept_end_tag(end)
                    return
                }
                ; declared but not open: elementNotOpen, then imply this end.
                let mt_notopen ParserMessages.elementNotOpen()
                let gi_notopen end.get_element_type().get_name()
                this.report1_at(mt_notopen, gi_notopen, end.get_loc())
            }
            let endev4 Event.make_end(host, e, start_loc)
            if included
                endev4.set_included()
            ps.queue_event(endev4)
            ps.note_end_element(included)
            return
        }
        ; not the element's end: unget and imply the end at the start location.
        ps.current_input().unget_token()
        let endev3 Event.make_end(host, e, start_loc)
        if included
            endev3.set_included()
        ps.queue_event(endev3)
        ps.note_end_element(included)
    }

    ; implyCurrentElementEnd — emit an implied end for the current element and
    ; pop it (used when an end tag or document end closes elements above it whose
    ; own end tags were omitted). omitEndTag diagnostics deferred.
    function imply_current_element_end(this: Parser, loc: Location)
    {
        let cs ps.get_content_state()
        let ce cs.current_element()
        let e ce.get_type()
        ; implyCurrentElementEnd (parseInstance.cxx): an end tag is being OMITTED
        ; for the current element. If OMITTAG NO is in force it may never be
        ; omitted (omitEndTagOmittag); otherwise the element's declaration must
        ; permit omission (omitEndTagDeclare when it does not). Both carry a
        ; "start tag was here" auxiliary line at the element's start location.
        let gi_omit e.get_name()
        let start_here ce.get_start_location()
        if ps.get_sd().omittag() = false
        {
            let mt_omittag ParserMessages.omitEndTagOmittag()
            let aux_omittag ParserMessages.omitEndTagOmittag_aux()
            this.report1_aux(mt_omittag, gi_omit, loc, aux_omittag, start_here)
        }
        else
        {
            let def e.get_definition()
            if def <> null
                if def.can_omit_end_tag() = false
                {
                    let mt_declare ParserMessages.omitEndTagDeclare()
                    let aux_declare ParserMessages.omitEndTagDeclare_aux()
                    this.report1_aux(mt_declare, gi_omit, loc, aux_declare, start_here)
                }
        }
        ps.note_end_element(ce.get_included())
        let endev Event.make_end(host, e, loc)
        if ce.get_included()
            endev.set_included()
        ps.queue_event(endev)
        ps.pop_element_mode()
    }

    ; close the current element WITHOUT an omitted-end-tag diagnostic — used when
    ; the end is genuinely marked (a NET null end tag closing its net-enabling
    ; element), where onsgmls emits a real EndElementEvent via acceptEndTag rather
    ; than implyCurrentElementEnd.
    function close_current_element(this: Parser, loc: Location)
    {
        let cs ps.get_content_state()
        let ce cs.current_element()
        let e ce.get_type()
        ps.note_end_element(ce.get_included())
        let endev Event.make_end(host, e, loc)
        if ce.get_included()
            endev.set_included()
        ps.queue_event(endev)
        ps.pop_element_mode()
    }

    ; parseNullEndTag — a NET delimiter (`>` under the XML/scaly syntax) closes
    ; the nearest net-enabling element on the stack, implying ends of any
    ; INTERVENING open elements first (each via implyCurrentElementEnd, which
    ; complains if it is unfinished / may not be omitted). The net-enabling
    ; element itself is closed by a genuine (null) end tag — no omission
    ; diagnostic — but still elementEndTagNotFinished if its model is unsatisfied.
    function parse_null_end_tag(this: Parser)
    {
        let cs ps.get_content_state()
        var guard: int 0
        var running true
        while running and (cs.tag_level_of() > (0 as u32))
        {
            let ce cs.current_element()
            if ce.get_net_enabling()
            {
                if (ce.is_finished() = false) and ps.validate()
                {
                    let mt_endnotfin ParserMessages.elementEndTagNotFinished()
                    let gi_endnotfin ce.get_type().get_name()
                    this.report1(mt_endnotfin, gi_endnotfin)
                }
                this.close_current_element(ps.current_location())
                set running: false
            }
            else
            {
                if (ce.is_finished() = false) and ps.validate()
                {
                    let mt_notfin ParserMessages.elementNotFinished()
                    let gi_notfin ce.get_type().get_name()
                    this.report1(mt_notfin, gi_notfin)
                }
                this.imply_current_element_end(ps.current_location())
            }
            set guard: guard + 1
            if guard > 100000
                set running: false
        }
    }

    function accept_end_tag(this: Parser, event: pointer[Event])
    {
        if event = null
            return
        let e event.get_element_type()
        let cs ps.get_content_state()
        if cs.element_is_open(e) = false
        {
            ; a stray end tag naming an element that is nowhere open
            ; (acceptEndTag, parseInstance.cxx): elementNotOpen, drop the tag.
            ; Reported at the end tag's location (captured before its TAGC).
            let gi e.get_name()
            let eloc event.get_loc()
            let mt_notopen ParserMessages.elementNotOpen()
            this.report1_at(mt_notopen, gi, eloc)
            return
        }
        ; Close intervening open elements (OMITTAG end-tag omission) until the
        ; current element is the one this end tag names.
        var guard: int 0
        var running true
        while running
        {
            let ce cs.current_element()
            if ce.get_type() = e
                set running: false
            else
            {
                ; an intervening open element is being closed by omission: if its
                ; own content model is unsatisfied, elementNotFinished.
                if (ce.is_finished() = false) and ps.validate()
                {
                    let mt_notfin ParserMessages.elementNotFinished()
                    let gi_notfin ce.get_type().get_name()
                    this.report1_at(mt_notfin, gi_notfin, event.get_loc())
                }
                this.imply_current_element_end(event.get_loc())
                set guard: guard + 1
                if guard > 100000
                    return
            }
        }
        let cef cs.current_element()
        ; the named element itself: if its content model is unsatisfied at its
        ; explicit end tag, elementEndTagNotFinished.
        if (cef.is_finished() = false) and ps.validate()
        {
            let mt_endnotfin ParserMessages.elementEndTagNotFinished()
            let gi_endnotfin cef.get_type().get_name()
            this.report1_at(mt_endnotfin, gi_endnotfin, event.get_loc())
        }
        if cef.get_included()
            event.set_included()
        ps.note_end_element(event.is_included())
        ps.queue_event(event)
        ps.pop_element_mode()
    }

    function accept_pcdata(this: Parser, loc: Location)
    {
        let cs ps.get_content_state()
        let ce cs.current_element()
        if ce.try_transition_pcdata()
            return
        ; need to test here since implying tags may turn off pcdataRecovering.
        if ps.is_pcdata_recovering()
            return
        ; OMITTAG: imply end/start tags speculatively until #PCDATA is admissible.
        var start_implied: u32 0
        let undo Array[UndoEntry]^host()
        let events Array[pointer[Event]]^host()
        ps.keep_messages()
        while this.try_imply_tag(loc, &start_implied, undo, events)
        {
            let cei cs.current_element()
            if cei.try_transition_pcdata()
            {
                this.queue_element_events(events)
                return
            }
        }
        ps.discard_kept_messages()
        this.undo_all(undo)
        ; pcdataNotAllowed (parseInstance.cxx:635) — a plain message() at the
        ; current token; then recover (switch to the mixed-content mode and
        ; suppress repeats until an element pushes or pops).
        if ps.validate() or cs.after_document_element()
            this.report0_at(ParserMessages.pcdataNotAllowed(), ps.current_input().token_start_location())
        ps.pcdata_recover()
    }

    function parse_pcdata(this: Parser)
    {
        let ins ps.current_input()
        let ts ins.current_token_string()
        ; the data token's START (the reference's currentLocation()) — an
        ; element implied by this data carries it as its start location.
        let loc ins.token_start_location()
        this.accept_pcdata(loc)
        ps.note_data()
        let ev Event.make_data(host, ts, loc)
        ps.queue_event(ev)
        ; reportNonSgmlCharacter (parseInstance.cxx): a non-SGML char in the data
        ; run is still emitted as data (onsgmls does the same) but reported at its
        ; own location. The token slice maps 1:1 onto [start_index, cur_index).
        this.check_non_sgml(ts, ins.get_origin(), ins.current_token_start_index())
    }

    ; a document character NOT in the SGML character set. The reference concrete
    ; syntax's non-SGML chars are the C0 controls other than TAB/RS/RE (9/10/13)
    ; plus DEL (127); xml.dcl agrees on this C0 range (chars >= 128 differ between
    ; declarations but do not occur in the corpus). Kept separate from
    ; Syntax.setSgmlChar (deliberately 0..U+FFFD so a stray decoded char stays
    ; DATA rather than aborting) — this predicate only drives the diagnostic.
    function is_non_sgml_char(this: Parser, c: u32) returns bool
    {
        if c <= (8 as u32)
            return true
        if (c = (11 as u32)) or (c = (12 as u32))
            return true
        if (c >= (14 as u32)) and (c <= (31 as u32))
            return true
        if c = (127 as u32)
            return true
        false
    }

    function check_non_sgml(this: Parser, ts: StringC, origin: pointer[Origin], start: size_t)
    {
        var i: size_t 0
        let n ts.get_size()
        let mt ParserMessages.nonSgmlCharacter()
        while i < n
        {
            let c ts.get(i)
            if this.is_non_sgml_char(c)
            {
                let cloc Location(origin, (start + i) as u32)
                this.report_num_at(mt, c as u64, cloc)
            }
            set i: i + 1
        }
    }


    ; endAllElements (parseInstance.cxx:1118). Closes every still-open element,
    ; complaining about each one whose content model is unsatisfied, and then —
    ; once the stack is back down to the synthetic document-element container —
    ; complains if even THAT is unfinished, i.e. the document element never
    ; appeared. That last check is what makes a prolog-only document (a DOCTYPE
    ; and nothing else) non-conforming: `E: no document element`, exit 1, and an
    ; empty ESIS because the `C` marker is gated on conformance.
    function end_all_elements(this: Parser)
    {
        let cs ps.get_content_state()
        var running true
        while running
        {
            if cs.tag_level_of() = (0 as u32)
                set running: false
            else
            {
                let ce cs.current_element()
                if ce.is_finished() = false
                {
                    ; elementNotFinishedDocumentEnd (no validate() guard in the
                    ; reference) — the open element's content model is unsatisfied
                    ; at end of document. Reported at the current scan cursor.
                    let mt_docend ParserMessages.elementNotFinishedDocumentEnd()
                    let gi_docend ce.get_type().get_name()
                    this.report1(mt_docend, gi_docend)
                }
                ; implyCurrentElementEnd — closes it (and complains if its end tag
                ; may not be omitted here).
                this.imply_current_element_end(ps.current_location())
            }
        }
        let root cs.current_element()
        if root.is_finished() = false
            if ps.validate()
            {
                this.report0(ParserMessages.noDocumentElement())
            }
    }

    function end_instance(this: Parser)
    {
        this.end_all_elements()
        ; unclosedMarkedSection (parseInstance.cxx:60): every still-open marked
        ; section reports "missing marked section end" at the current location
        ; (EOF) with a "marked section started here" auxiliary at its MDO.
        while ps.get_marked_section_level() > (0 as u32)
        {
            let ms_loc ps.current_marked_section_start_location()
            this.report0_aux(ParserMessages.unclosedMarkedSection(), ps.current_location(), ParserMessages.unclosedMarkedSection_aux(), ms_loc)
            ps.end_marked_section()
        }
        this.check_idrefs()
        ps.pop_input_stack()
    }

    ; checkIdrefs (parseInstance.cxx:70): at document end, every pending IDREF
    ; whose target ID was never defined reports missingId (X1, IdrefError —
    ; counts toward the error exit like any error) at the REFERENCE's location.
    ; The iteration is the id table's raw bucket order (PointerTableIter), NOT
    ; document order — the IdTable port preserves the reference's hash layout
    ; precisely so this message order is byte-identical.
    function check_idrefs(this: Parser)
    {
        let t ps.get_id_table()
        let n (*t).bucket_count()
        var i: size_t 0
        while i < n
        {
            let id (*t).bucket_at(i)
            if id <> null
            {
                let m id.n_pending_refs()
                var j: size_t 0
                while j < m
                {
                    let rloc id.pending_ref_at(j)
                    this.report1_at(ParserMessages.missingId(), id.get_name(), rloc)
                    set j: j + 1
                }
            }
            set i: i + 1
        }
    }

    ; parseMarkedSectionDeclStart (parseDecl.cxx) — after tokenMdoDso, read the
    ; status keywords up to the DSO that opens the section body, then enter the
    ; section: INCLUDE parses normally; CDATA/RCDATA/IGNORE switch to a special
    ; parse mode until the matching `]]>` (handleMarkedSectionEnd). A `<![` nested
    ; inside an already-special (ignored) section is itself ignored content.
    function parse_marked_section_decl_start(this: Parser) returns bool
    {
        ; the section's start (its MDO-DSO) — the unclosedMarkedSection aux.
        let ms_start ps.current_input().token_start_location()
        ; parseDecl.cxx:3404 — marked sections nest against TAGLVL.
        let mstaglvl_q ps.get_syntax().get_quantity(qTAGLVL)
        if ps.get_marked_section_level() = mstaglvl_q
            this.report_num_at(ParserMessages.markedSectionLevel(), mstaglvl_q as u64, ps.current_input().token_start_location())
        if ps.get_marked_section_special_level() > (0 as u32)
        {
            ps.start_marked_section(ms_start)
            return true
        }
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        var codes int[6]
        let cp codes as pointer[int]
        set *(cp + (0 as size_t)): P_DSO
        set *(cp + (1 as size_t)): P_RESERVED_NAME + R_CDATA
        set *(cp + (2 as size_t)): P_RESERVED_NAME + R_RCDATA
        set *(cp + (3 as size_t)): P_RESERVED_NAME + R_IGNORE
        set *(cp + (4 as size_t)): P_RESERVED_NAME + R_INCLUDE
        set *(cp + (5 as size_t)): P_RESERVED_NAME + R_TEMP
        let allow AllowedParams.an(host, cp, 6)
        if this.parse_param(allow, decl_input_level, parm) = false
            return false
        var status: int MS_INCLUDE
        var running true
        while running
        {
            if parm.kind = P_DSO
                set running: false
            else
            {
                if parm.kind = (P_RESERVED_NAME + R_CDATA)
                {
                    if status < MS_CDATA
                        set status: MS_CDATA
                }
                else if parm.kind = (P_RESERVED_NAME + R_RCDATA)
                {
                    if status < MS_RCDATA
                        set status: MS_RCDATA
                }
                else if parm.kind = (P_RESERVED_NAME + R_IGNORE)
                {
                    if status < MS_IGNORE
                        set status: MS_IGNORE
                }
                ; INCLUDE / TEMP: no status bump (include is the minimum).
                if this.parse_param(allow, decl_input_level, parm) = false
                    return false
            }
        }
        if status = MS_INCLUDE
            ps.start_marked_section(ms_start)
        else if status = MS_CDATA
            ps.start_special_marked_section(cmsMode, ms_start)
        else if status = MS_RCDATA
            ps.start_special_marked_section(rcmsMode, ms_start)
        else
            ps.start_special_marked_section(imsMode, ms_start)
        true
    }

    ; handleMarkedSectionEnd (parseDecl.cxx) — a `]]>`: close the innermost open
    ; marked section (the state machine restores the enclosing mode). The markup /
    ; ignored-chars events are not wanted for ESIS.
    function handle_marked_section_end(this: Parser)
    {
        if ps.get_marked_section_level() = (0 as u32)
        {
            ; markedSectionEnd (parseDecl.cxx:3528): a `]]>` outside any marked
            ; section declaration. E0 — no argument; location = the MSC token start.
            let loc ps.current_input().token_start_location()
            this.report0_at(ParserMessages.markedSectionEnd(), loc)
        }
        else
            ps.end_marked_section()
    }

    ; parseEntityReference (parseCommon.cxx, scoped): `&name;` in content. Read the
    ; entity name (NAMECASE ENTITY NO -> raw), consume the REFC, look it up, and
    ; push its text as a new input source (contentReference -> normalReference):
    ; an internal entity stacks its replacement text, an external text entity is
    ; opened from disk. Char-data (CDATA/SDATA/NDATA/subdoc) entities emit events
    ; instead of stacking and are deferred.
    ;
    ; Entity::checkEntlvl + checkNotOpen guard the two ways a reference can fail to
    ; terminate: nesting deeper than ENTLVL, and an entity that (transitively)
    ; references itself — the latter is caught by identity against the open input
    ; stack (ParserState.entity_is_open), so the entity's decl travels in the
    ; source's Origin.
    ; createUndefinedEntity (ParserState.cxx): fabricate an undefined external text
    ; entity with an EMPTY external id (no system id), remember it in the
    ; undefined-entity table keyed by name (so subsequent references reuse it), and
    ; run generateSystemId — with no entity catalog to map the name to a storage id
    ; it always fails, reporting cannotGenerateSystemIdGeneral (Warning) at the
    ; entity-name location. def_loc (the reference site) becomes the entity's
    ; defLocation, later used as the nonExistentEntityRef auxiliary. Returns the
    ; entity so the reference proceeds (and fails to open → nonExistentEntityRef).
    function create_undefined_entity(this: Parser, name: StringC, def_loc: Location, name_loc: Location) returns pointer[Entity]
    {
        let hname StringC^host(name.data_ptr(), name.get_size())
        let ent host.allocate(sizeof Entity, alignof Entity) as pointer[Entity]
        set *ent: Entity.ExternalText(ExternalTextEntity(hname, ExternalId(), String(), def_loc))
        ps.add_undefined_entity(ent)
        this.report1_at(ParserMessages.cannotGenerateSystemIdGeneral(), hname, name_loc)
        ent
    }

    function parse_entity_reference(this: Parser) returns bool
    {
        let ins ps.current_input()
        ; the reference start (the CRO `&`) is the current token's start, captured
        ; BEFORE discard_initial peels the delimiter — EntityOrigin's refLocation.
        let ref_start ins.token_start_location()
        ins.discard_initial()
        this.extend_name_token(this.namelen(), ParserMessages.nameLength())
        let name ps.current_token^host()
        ; the entity-name start (cannotGenerateSystemId + entityUndefined point here).
        let name_loc ins.token_start_location()
        let dtd ps.get_current_dtd()
        var ent dtd.lookup_entity(false, name)
        ; consume the REFC (`;`) or record-end that terminates the reference.
        let refc ps.get_token(refMode)
        ; the REFC location (nonExistentEntityRef points here) — the current token
        ; start, before the cursor advances past `;`.
        let refc_loc ins.token_start_location()
        ; refLength = the full span of `&name;` (parseCommon.cxx): the cursor now
        ; sits just past the reference, so end − start is its length.
        let ref_len (ins.here_location().get_index() - ref_start.get_index()) as size_t
        if ent = null
        {
            ; parseCommon.cxx: an undefined general-entity reference. IMPLYDEF
            ; ENTITY implies undefined entities (that handling is deferred — drop).
            if ps.get_sd().implydef_entity()
                return true
            ; createUndefinedEntity, cached by name: on the FIRST reference build the
            ; undefined entity (which reports cannotGenerateSystemIdGeneral) + report
            ; entityUndefined; a later reference reuses it silently. Either way the
            ; entity is referenced below and, having no system id, fails to open →
            ; nonExistentEntityRef fires on EVERY reference.
            var uent ps.lookup_undefined_entity(name)
            if uent = null
            {
                set uent: this.create_undefined_entity(name, ref_start, name_loc)
                this.report1_at(ParserMessages.entityUndefined(), name, name_loc)
            }
            set ent: uent
        }

        ; checkEntlvl (Entity.cxx:583): nesting deeper than ENTLVL is a diagnostic
        ; only — the entity is still stacked (the document entity is not counted).
        ; Recursion stays bounded by checkNotOpen, which cannot let the same
        ; entity open twice.
        let entlvl ps.get_syntax().get_quantity(qENTLVL)
        if (ps.get_input_level() - (1 as u32)) = entlvl
            this.report_num_at(ParserMessages.entlvl(), entlvl as u64, ps.current_input().token_start_location())
        ; checkNotOpen (Entity.cxx): a recursive entity reference. This fires from
        ; INSIDE the entity's replacement text; resolve_location walks the origin
        ; chain up to the reference in the enclosing source (the reference position
        ; ref_start + ref_len records on the pushed origin) so the reported
        ; file:line:col is byte-identical to onsgmls.
        if ps.entity_is_open(ent as pointer[void])
        {
            this.report1(ParserMessages.recursiveEntityReference(), name)
            return true
        }

        let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org: Origin(ref_start, ent as pointer[void], ref_len)
        choose *ent
            when i: Internal
            {
                let itext i.get_text()
                let isrc host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
                set *isrc: InputSource(org, itext.data_ptr(), itext.get_size())
                ps.push_input(isrc)
            }
            when e: ExternalText
            {
                ; ExternalTextEntity::normalReference — open the effective system
                ; id (resolved against the document's directory) and stack it. An
                ; external TEXT entity produces NO ESIS event: its content is
                ; included inline (only external DATA entities emit `&name`).
                let id e.get_external_id()
                if id.has_system_id() = false
                {
                    ; ExternalTextEntity::normalReference: no effective system id to
                    ; open → nonExistentEntityRef, at the REFC, with the entity's
                    ; declaration/first-reference site as the "entity was defined
                    ; here" auxiliary.
                    let ename e.get_name()
                    let edef e.get_def_location()
                    this.report1_aux(ParserMessages.nonExistentEntityRef(), ename, refc_loc, ParserMessages.nonExistentEntityRef_aux(), edef)
                    return true
                }
                let ebase e.get_base_dir()
                let esys id.get_system_id()
                let esrc this.open_external_text(ebase, esys, org)
                if esrc = null
                {
                    ; EntityManager.open failed: openSystemCall ("cannot open
                    ; ...") at the reference site (ParentLocationMessenger's
                    ; parent = the origin's refLocation, the ERO), with the
                    ; effective system id + strerror text; the reference is
                    ; dropped and the parse continues.
                    let disp Path.join(ebase, esys)
                    let dispc StringC^host(disp.to_c_string())
                    let stor Storage.OsFile(ebase)
                    let emsg stor.open_error(esys)
                    if emsg <> null
                        this.report_open_failure(dispc, emsg, ref_start)
                    return true
                }
                ps.push_input(esrc)
            }
            when d: ExternalData
            {
                ; ExternalDataEntity::contentReference — a data (CDATA/SDATA/
                ; NDATA) entity reference emits an ExternalDataEntityEvent
                ; instead of stacking input; the writer prints the entity's
                ; definition records (once per document) and the `&name` line.
                ; checkRef/checkEntlvl ran above; noteData's data-run break is
                ; what the writer's flush-before-`&` models.
                ps.queue_event(Event.make_entity_ref(host, ent, ref_start))
            }
            when sub: Subdoc
            {
                ; SubdocEntity::contentReference — fires a SubdocEntityEvent and
                ; parses the subdocument with a nested parser (`{name` … `}name`).
                ; The sub-parse is the SUBDOC feature axis (unported); the
                ; entity itself (declaration + ENTITY-attribute semantics + the
                ; ESIS S definition record) is modeled.
                this.err(64)
            }
        true
    }

    ; parseEntityReference(isParameter=1) (parseCommon.cxx:428) + the declReference/
    ; dsReference push (entity.cxx). A `%name;` parameter-entity reference inside
    ; a markup declaration or the declaration subset: look the PE up, then STACK
    ; its replacement text as an InputSource so its tokens flow transparently into
    ; the running parse. The enclosing loop's tokenEe arm pops it when exhausted —
    ; EXACTLY the general-entity content path (parse_entity_reference above), only
    ; with is_parameter=true. The target DTDs are EXTERNAL, where PE references
    ; inside declarations are allowed. Only internal TEXT entities occur here (a
    ; PE with an external / non-text body is not exercised by the corpus).
    function parse_parameter_entity_reference(this: Parser) returns bool
    {
        let ins ps.current_input()
        ; the reference start (the PERO `%`) is the current token's start, before
        ; discard_initial peels it — EntityOrigin's refLocation.
        let ref_start ins.token_start_location()
        ; discard_initial drops the PERO (`%`); the name grows over name chars.
        ; extend_name_token's length limit is deferred (penamelen == namelen - the
        ; PERO length, but the limit is never enforced), so namelen is exact here.
        ins.discard_initial()
        this.extend_name_token(this.penamelen(), ParserMessages.parameterEntityNameLength())
        let name ps.current_token^host()
        let name_loc ins.token_start_location()
        let dtd ps.get_current_dtd()
        var ent dtd.lookup_entity(true, name)
        ; consume the REFC (`;`) or record-end that terminates the reference.
        let refc ps.get_token(refMode)
        let refc_loc ins.token_start_location()
        ; refLength = the full span of `%name;` (parseCommon.cxx).
        let ref_len (ins.here_location().get_index() - ref_start.get_index()) as size_t
        if ent = null
        {
            ; parameterEntityUndefined (parseCommon.cxx:490): the PE is not defined.
            ; Reported (exit 1), reference dropped. Arg = name (quoted); location =
            ; the name token's start.
            this.report1_at(ParserMessages.parameterEntityUndefined(), name, name_loc)
            return true
        }

        ; checkEntlvl (Entity.cxx:583): nesting deeper than ENTLVL is a
        ; diagnostic only.
        let entlvl ps.get_syntax().get_quantity(qENTLVL)
        if (ps.get_input_level() - (1 as u32)) = entlvl
            this.report_num_at(ParserMessages.entlvl(), entlvl as u64, ps.current_input().token_start_location())
        ; checkNotOpen: a recursive parameter-entity reference. Reported like the
        ; general-entity case; resolve_location fixes up the location up the chain.
        ; (Hard to provoke cleanly — a self-referential PE literal is expanded at
        ; declaration time and errors as parameterEntityUndefined first — so no
        ; fixture, per the task's testcase directive; wired for fidelity.)
        if ps.entity_is_open(ent as pointer[void])
        {
            this.report1(ParserMessages.recursiveEntityReference(), name)
            return true
        }

        let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org: Origin(ref_start, ent as pointer[void], ref_len)
        choose *ent
            when i: Internal
            {
                let itext i.get_text()
                let isrc host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
                set *isrc: InputSource(org, itext.data_ptr(), itext.get_size())
                ps.push_input(isrc)
            }
            when e: ExternalText
            {
                let id e.get_external_id()
                if id.has_system_id() = false
                {
                    ; normalReference: no effective system id → nonExistentEntityRef,
                    ; at the REFC, aux at the entity's declaration site.
                    let ename e.get_name()
                    let edef e.get_def_location()
                    this.report1_aux(ParserMessages.nonExistentEntityRef(), ename, refc_loc, ParserMessages.nonExistentEntityRef_aux(), edef)
                    return true
                }
                let ebase e.get_base_dir()
                let esys id.get_system_id()
                let esrc this.open_external_text(ebase, esys, org)
                if esrc = null
                {
                    ; EntityManager.open failed: openSystemCall at the PERO
                    ; reference site (see the general-entity arm above).
                    let disp Path.join(ebase, esys)
                    let dispc StringC^host(disp.to_c_string())
                    let stor Storage.OsFile(ebase)
                    let emsg stor.open_error(esys)
                    if emsg <> null
                        this.report_open_failure(dispc, emsg, ref_start)
                    return true
                }
                ps.push_input(esrc)
            }
            when d: ExternalData
            {
                ; ExternalNonTextEntity::normalReference — a data PE referenced
                ; in a declaration context is not text (only definable under
                ; WWW, where external data parameter entities are admitted).
                this.report0(ParserMessages.externalNonTextEntityReference())
            }
            when sub: Subdoc
                this.report0(ParserMessages.externalNonTextEntityReference())
        true
    }

    ; parseNamedCharRef (parseCommon.cxx:239): `&#NAME;` — NAME must be a
    ; function name (RE/RS/SPACE plus declared FUNCTION names); the named char
    ; is re-injected into the input (push_char_ref) and scanned as an ordinary
    ; source char, so RE/RS/SPACE semantics fall out of the normal record and
    ; data machinery. An unknown name reports functionName (E1, at the
    ; name-token start; the arg is the namecase-folded name — verified vs real
    ; onsgmls: `&#x41;` under the reference syntax reports "X41", `&#space;`
    ; under xml.dcl's NAMECASE NO reports "space") and produces nothing. The
    ; terminating REFC (or RE) is consumed either way; always returns true
    ; like the reference. warnNamedCharRef/warnRefc and the markup capture
    ; (wantMarkup, incl. the origin's NamedCharRef notes) are only observable
    ; under options the drop-in does not expose — not ported.
    function parse_named_char_ref(this: Parser) returns bool
    {
        let ins ps.current_input()
        ins.discard_initial()
        this.extend_name_token(this.namelen(), ParserMessages.nameLength())
        let name_loc ins.token_start_location()
        let name this.name_folded()
        var c: u32 0
        var valid true
        if ps.get_syntax().lookup_function_char(name, &c) = false
        {
            this.report1_at(ParserMessages.functionName(), name, name_loc)
            set valid: false
        }
        let refc ps.get_token(refMode)
        ins.start_token()
        if valid
            ins.push_char_ref(c)
        true
    }

    ; parseNumericCharRef (parseCommon.cxx:282, scoped): a decimal `&#NN;` or
    ; hex `&#xNN;` reference -> the referenced document-charset Char (via
    ; out_ch). is_hex = the dispatch token was tokenHcroHexDigit (parseCommon
    ; passes token==tokenHcroHexDigit at both call sites). The digits fold to
    ; a value guarded against the CONSTANT charMax = 0x10FFFF (constant.h:12 —
    ; the internal Char range, NOT a charset-derived cap); then the number
    ; must be DECLARED in the document character set
    ; (sd().docCharsetDecl().charDeclared — UNUSED ranges count as declared),
    ; else characterNumber. Both failures report at the number token's start
    ; (verified vs real onsgmls: the first digit — for hex the char after the
    ; HCRO `&#x`, message arg = the digits WITHOUT the x, e.g. "110000") and
    ; return false with no char produced; the REFC is consumed either way.
    ; out_refc_loc = the start of the reference-terminating token (the REFC
    ; `;`) — where the translate-stage diagnostics point (verified: real
    ; onsgmls reports numericCharRefNoInternal/UnknownBase at the `;`).
    ; The markup capture (wantMarkup) is still deferred.
    function parse_numeric_char_ref(this: Parser, is_hex: bool, out_ch: pointer[u32], out_refc_loc: pointer[Location]) returns bool
    {
        let ins ps.current_input()
        ins.discard_initial()
        if is_hex
            this.extend_hex_number(this.namelen())
        else
            this.extend_number(this.namelen())
        ; the number token's start — where characterNumber points.
        let numloc ins.token_start_location()
        let tok ps.current_token()
        let n tok.get_size()
        var c: u32 0
        var valid true
        var i: size_t 0
        if is_hex
        {
            while (i < n) and valid
            {
                let d this.hex_digit_weight(tok.get(i))
                ; the base-16 fold, guarded exactly like the decimal one below.
                if (c <= (CHAR_MAX / (16 as u32))) and ((c * (16 as u32)) <= (CHAR_MAX - d))
                    set c: c * (16 as u32) + d
                else
                {
                    this.report1_at(ParserMessages.characterNumber(), tok, numloc)
                    set valid: false
                }
                set i: i + 1
            }
        }
        else
        {
            while (i < n) and valid
            {
                let d tok.get(i) - (0x30 as u32)
                ; fold guarded against charMax (parseCommon.cxx): the instant the next
                ; digit would exceed charMax, report characterNumber and stop, so a long
                ; digit run cannot overflow and the char is not produced.
                if (c <= (CHAR_MAX / (10 as u32))) and ((c * (10 as u32)) <= (CHAR_MAX - d))
                    set c: c * (10 as u32) + d
                else
                {
                    this.report1_at(ParserMessages.characterNumber(), tok, numloc)
                    set valid: false
                }
                set i: i + 1
            }
        }
        ; the fold stayed in range, but the number must be a DECLARED character
        ; of the document charset (charDeclared counts UNUSED ranges — an
        ; UNUSED number passes here and is dropped by translate, NOT an error).
        if valid
        {
            if ps.get_sd().doc_charset_decl().char_declared(c) = false
            {
                this.report1_at(ParserMessages.characterNumber(), tok, numloc)
                set valid: false
            }
        }
        ; consume the REFC (`;`) or record-end that terminates the reference (always,
        ; valid or not — the reference is recovered past either way).
        let refc ps.get_token(refMode)
        set *out_refc_loc: ps.current_input().token_start_location()
        if valid = false
            return false
        set *out_ch: c
        true
    }

    ; translateNumericCharRef (parseCommon.cxx:360): translate a character
    ; number in the DOCUMENT character set into the INTERNAL character set.
    ; In the default mode the internal charset IS the doc charset — no
    ; translation, every declared ref is an SGML char (the reference's
    ; warnNonSgmlCharRef refinement is a non-default option, not ported).
    ; Under SP_CHARSET_FIXED (internalCharsetIsDocCharset false):
    ;   - docCharset().descToUniv succeeds -> internalCharset().univToDesc:
    ;     the fixed internal charset is the system charset, identity over
    ;     0..INTERNAL_CHAR_MAX (see CharsetDecl.scaly) — in range translates
    ;     the char, beyond it reports numericCharRefNoInternal (E1, at the
    ;     REFC). The reference's numericCharRefBadInternal arm (ambiguous /
    ;     over-charMax internal mapping) is unreachable with an identity map.
    ;   - descToUniv fails -> getCharInfo classifies the number: an UNUSED
    ;     range is a declared NON-SGML char (return true, is_sgml_char false —
    ;     the callers drop it silently); a string-described range reports
    ;     numericCharRefUnknownDesc (E2); a number range whose base char the
    ;     baseset does not cover reports numericCharRefUnknownBase (E3, args:
    ;     doc number, base number, QUOTED baseset public id).
    ; Returns false when the char could not be translated (already reported).
    function translate_numeric_char_ref(this: Parser, ch: pointer[u32], is_sgml_char: pointer[bool], refc_loc: Location) returns bool
    {
        let sd ps.get_sd()
        if sd.internal_charset_is_doc_charset()
        {
            set *is_sgml_char: true
            return true
        }
        let c *ch
        var univ: u32 0
        if sd.doc_charset_desc().desc_to_univ(c, &univ)
        {
            if univ <= INTERNAL_CHAR_MAX
            {
                set *ch: univ
                set *is_sgml_char: true
                return true
            }
            this.report_num_at(ParserMessages.numericCharRefNoInternal(), c as u64, refc_loc)
            return false
        }
        let r sd.doc_charset_decl().find_range(c)
        if r = null
        {
            ; CANNOT_HAPPEN (parseCommon.cxx:381): charDeclared passed in
            ; parse_numeric_char_ref, so a covering range exists. Defensive:
            ; report as an unknown base char of an anonymous baseset.
            this.report_num_num_str_at(ParserMessages.numericCharRefUnknownBase(), c as u64, c as u64, StringC(), refc_loc)
            return false
        }
        if r.range_type = CHARSET_RANGE_UNUSED
        {
            set *is_sgml_char: false
            return true
        }
        if r.range_type = CHARSET_RANGE_STRING
        {
            let dstr r.str
            this.report_num_str_at(ParserMessages.numericCharRefUnknownDesc(), c as u64, dstr, refc_loc)
            return false
        }
        let base_n r.base_min + (c - r.desc_min)
        let pid ps.get_sd().doc_charset_decl().section_pubid(r.section)
        this.report_num_num_str_at(ParserMessages.numericCharRefUnknownBase(), c as u64, base_n as u64, pid, refc_loc)
        false
    }

    ; doContent — the instance token-dispatch loop (well-formed subset).
    function do_content(this: Parser)
    {
        var running true
        while running
        {
            ; doContent (parseInstance.cxx): the error limit was reached — STOP
            ; without closing the open elements or ending the instance. onsgmls
            ; truncates the ESIS here (no closing tags, no conformance marker).
            if ps.is_cancelled()
                return
            let token ps.get_token(ps.get_current_mode())
            if token = tokenEe
            {
                if ps.get_input_level() <= (1 as u32)
                {
                    this.end_instance()
                    set running: false
                }
                else
                {
                    ; an entity ends inside CDATA/RCDATA content or an ignored
                    ; marked section (the special parse) — parseInstance.cxx:96.
                    if ps.get_input_level() = ps.get_special_parse_input_level()
                        this.report0_at(ParserMessages.specialParseEntityEnd(), ps.current_input().token_start_location())
                    if ps.get_content_state().after_document_element()
                        this.report0_at(ParserMessages.afterDocumentElementEntityEnd(), ps.current_input().token_start_location())
                    ; (contentAsyncEntityRef needs INTEGRAL YES — the parseSd
                    ; axis; sd().integrallyStored() is never set here.)
                    ps.pop_input_stack()
                }
            }
            else if (token = tokenEroNameStart) or (token = tokenEroGrpo)
            {
                if ps.get_content_state().after_document_element()
                    this.report0_at(ParserMessages.entityReferenceAfterDocumentElement(), ps.current_input().token_start_location())
                this.parse_entity_reference()
            }
            else if token = tokenNet
                this.parse_null_end_tag()
            else if (token = tokenCroDigit) or (token = tokenHcroHexDigit)
            {
                if ps.get_content_state().after_document_element()
                    this.report0_at(ParserMessages.characterReferenceAfterDocumentElement(), ps.current_input().token_start_location())
                let loc ps.current_location()
                var ch: u32 0
                var refc_loc Location()
                let is_hex_ref token = tokenHcroHexDigit
                if this.parse_numeric_char_ref(is_hex_ref, &ch, &refc_loc)
                {
                    ; doContent (parseInstance.cxx:119): pcdata is accepted and
                    ; data noted BEFORE translation; a char the fixed internal
                    ; charset cannot represent (translate false) or a declared
                    ; NON-SGML char (UNUSED range — is_sgml false; the
                    ; reference's NonSgmlCharEvent, which onsgmls's default
                    ; output ignores) emits NO data — silently dropped.
                    this.accept_pcdata(loc)
                    ps.note_data()
                    var is_sgml true
                    if this.translate_numeric_char_ref(&ch, &is_sgml, refc_loc)
                    {
                        if is_sgml
                        {
                            let scp StringC^host(&ch, 1 as size_t)
                            let cev Event.make_data(host, *scp, loc)
                            ps.queue_event(cev)
                        }
                    }
                }
            }
            else if token = tokenCroNameStart
            {
                ; doContent (parseInstance.cxx:137): a named function char ref;
                ; the pushed char re-scans through the normal token dispatch
                ; (an RE lands in the tokenRe arm and the record machinery).
                if ps.get_content_state().after_document_element()
                    this.report0_at(ParserMessages.characterReferenceAfterDocumentElement(), ps.current_input().token_start_location())
                this.parse_named_char_ref()
            }
            else if token = tokenStagoNameStart
                this.parse_start_tag()
            else if token = tokenStagoTagc
                this.parse_empty_start_tag()
            else if token = tokenEtagoNameStart
            {
                let ee this.parse_end_tag()
                this.accept_end_tag(ee)
            }
            else if token = tokenEtagoTagc
                this.parse_empty_end_tag()
            else if token = tokenMdoCom
            {
                ; a comment declaration in the instance (doContent): markup, no
                ; event — the data on either side of it is ONE data run.
                this.parse_comment_decl()
                ps.note_markup()
            }
            else if token = tokenMdoNameStart
            {
                ; doContent (parseInstance.cxx:196): a markup declaration in the
                ; instance. DOCTYPE/LINKTYPE/ELEMENT/ATTLIST/ENTITY/NOTATION/
                ; SHORTREF/LINK/IDLINK are not allowed here -> instanceDeclaration;
                ; any other recognized reserved name -> noSuchDeclarationType.
                ; USEMAP/USELINK are allowed in the instance (parseUsemapDecl /
                ; parseUselinkDecl) but are not ported — err(0), corpus-unreached.
                ; Then skip the declaration to its MDC and continue the content.
                let inst_decl_level ps.get_input_level()
                var decl_name: int 0
                if this.parse_declaration_name(&decl_name)
                {
                    let spell this.name_folded()
                    let dloc ps.current_input().token_start_location()
                    if this.instance_declaration_not_allowed(decl_name)
                        this.report1_at(ParserMessages.instanceDeclaration(), spell, dloc)
                    else if (decl_name = R_USEMAP) or (decl_name = R_USELINK)
                    {
                        ; SHORTREF / LINK feature axes: the reference parses
                        ; these in the instance (parseUsemapDecl /
                        ; parseUselinkDecl) with NO diagnostic. err keeps the
                        ; skip counted until the axes land.
                        this.err(0)
                    }
                    else
                        this.report1_at(ParserMessages.noSuchDeclarationType(), spell, dloc)
                }
                this.skip_declaration(inst_decl_level)
                ps.note_markup()
            }
            else if token = tokenMdoMdc
            {
                ; the empty comment declaration `<!>` (emptyCommentDecl).
                ps.note_markup()
            }
            else if token = tokenMdoDso
            {
                if ps.get_content_state().after_document_element()
                    this.report0_at(ParserMessages.markedSectionAfterDocumentElement(), ps.current_input().token_start_location())
                this.parse_marked_section_decl_start()
                ps.note_markup()
            }
            else if token = tokenMscMdc
            {
                this.handle_marked_section_end()
                ps.note_markup()
            }
            else if token = tokenRe
            {
                this.accept_pcdata(ps.current_input().token_start_location())
                ps.queue_re()
            }
            else if token = tokenRs
            {
                this.accept_pcdata(ps.current_input().token_start_location())
                ps.note_rs()
            }
            else if token = tokenChar
                this.parse_pcdata()
            else if token = tokenCharDelim
                this.parse_pcdata()
            else if token = tokenIgnoredChar
                ; content of an IGNORE marked section: extend + discard.
                set running: running
            else if token = tokenPio
            {
                ; a processing instruction in content (doContent case tokenPio).
                this.parse_processing_instruction()
                ps.note_markup()
            }
            else if token = tokenS
                set running: running
            else if token = tokenUnrecognized
            {
                ; reportNonSgmlCharacter + parsePcdata (parseInstance.cxx:281):
                ; the unmatched char joins the data run; parse_pcdata's
                ; check_non_sgml reports any non-SGML chars in the run at their
                ; own locations. A zero-length unrecognized token must consume
                ; its character or the loop would not advance.
                let ins_u ps.current_input()
                if ins_u.current_token_length() = (0 as size_t)
                    ins_u.end_token(1 as size_t)
                this.parse_pcdata()
            }
            else
                ; Unhandled token in this increment (shortref, group tags).
                ; Bail rather than risk a non-advancing loop; the axes handle
                ; these.
                set running: false
        }
    }

    ; parseEmptyStartTag (parseInstance.cxx:511) — `<>`: the empty start tag
    ; names the most recently ended element under OMITTAG NO, the currently
    ; open element otherwise, falling back to the document element type.
    ; (warnEmptyTag is option-gated off; emptyStartTagBaseDtd needs a non-base
    ; DTD = the LINK/CONCUR axes.)
    function parse_empty_start_tag(this: Parser)
    {
        let cs ps.get_content_state()
        var e: pointer[ElementType] null
        if ps.get_sd().omittag() = false
            set e: cs.last_ended_element_type()
        else if cs.tag_level_of() > (0 as u32)
            set e: cs.current_element().get_type()
        if e = null
        {
            let dtd ps.get_current_dtd()
            set e: dtd.get_document_element_type()
        }
        if e = null
            return
        let adl e.get_attribute_def()
        let atts AttributeList.make(host, adl)
        let ctx ps.get_attribute_context()
        atts.finish(ctx)
        this.check_missing_semantics(atts)
        let loc ps.current_input().token_start_location()
        let stev Event.make_start(host, e, loc)
        stev.set_attributes(atts)
        this.accept_start_tag(e, stev, false)
    }

    ; parseEmptyEndTag (parseInstance.cxx:1070) — `</>`: ends the currently
    ; open element; with no open elements it is an error and is dropped.
    ; (warnEmptyTag / emptyEndTagBaseDtd as above.)
    function parse_empty_end_tag(this: Parser)
    {
        let cs ps.get_content_state()
        if cs.tag_level_of() = (0 as u32)
        {
            this.report0_at(ParserMessages.emptyEndTagNoOpenElements(), ps.current_input().token_start_location())
            return
        }
        let e cs.current_element().get_type()
        let endev Event.make_end(host, e, ps.current_input().token_start_location())
        this.accept_end_tag(endev)
    }

    ; install the content-mode recognizers doContent drives (in addition to the
    ; declaration/prolog modes install_recognizers builds). Kept separate so the
    ; declaration-parser path stays byte-identical.
    function install_content_recognizers(this: Parser, table: pointer[Array[PackedTokenInfo]])
    {
        let sdv *ps.get_sd()
        let synv *ps.get_syntax()
        var modes int[17]
        let mp modes as pointer[int]
        set *(mp + (0 as size_t)): econMode
        set *(mp + (1 as size_t)): econnetMode
        set *(mp + (2 as size_t)): mconMode
        set *(mp + (3 as size_t)): mconnetMode
        set *(mp + (4 as size_t)): tagMode
        set *(mp + (5 as size_t)): cconMode
        set *(mp + (6 as size_t)): rcconMode
        set *(mp + (7 as size_t)): alitMode
        set *(mp + (8 as size_t)): alitaMode
        set *(mp + (9 as size_t)): talitMode
        set *(mp + (10 as size_t)): talitaMode
        set *(mp + (11 as size_t)): imsMode
        set *(mp + (12 as size_t)): cmsMode
        set *(mp + (13 as size_t)): rcmsMode
        set *(mp + (14 as size_t)): refMode
        set *(mp + (15 as size_t)): rcconeMode
        ; piMode: processing instructions in content (doContent case tokenPio).
        set *(mp + (16 as size_t)): piMode
        ; the `e` (in-entity) literal variants: an attribute value in the instance
        ; can reference an entity (`x="&quot;..."`); parse_literal switches to the
        ; matching e-mode while the entity is open, so a `"` in the replacement is
        ; data, not the literal close. Without these installed, get_token(e-mode)
        ; would run to EOF (a null recognizer returns tokenChar forever).
        set *(mp + (17 as size_t)): aliteMode
        set *(mp + (18 as size_t)): taliteMode
        set *(mp + (19 as size_t)): pliteMode
        var i: int 0
        while i < 20
        {
            let m *(mp + (i as size_t))
            let r Recognizer.build_recognizer(host, m, sdv, synv, table)
            ps.set_recognizer(m, r)
            set i: i + 1
        }
    }

    ; ======================================================================
    ; Prolog + full-document driver — Stage 4, Increment 3 (external subset: 6).
    ;
    ; A SCOPED port of doProlog + parseDoctypeDeclStart (Parser.cs): drives the
    ; document from the first token through the DOCTYPE declaration into content
    ; parsing, so a whole SGML document parses end-to-end and the event queue
    ; feeds the ESIS writer (Esis.write) — the tests/sgml corpus harness. Handles
    ; both an INTERNAL DTD subset (`<!DOCTYPE name [ ... ]>`) and an EXTERNAL one
    ; (`<!DOCTYPE name SYSTEM "sub.dtd">` / `PUBLIC "..." "sub.dtd"`), resolved
    ; relative to the document's base directory.
    ;
    ; DEFERRED: catalog resolution of a PUBLIC id with no system id
    ; (generateSystemId), an implied DTD from the first start tag (implyDtd),
    ; LINKTYPE, prolog PIs/comments, the startDtd/endProlog markup events.

    ; Build an InputSource from raw entity bytes: DECODE them as UTF-8 to Chars and
    ; apply the `lf` record normalization, so declaration-subset whitespace
    ; tokenizes as separators. The Char buffer lives on `host`.
    ;
    ; RECORD NORMALIZATION (ExtendEntityManager.cxx, ExternalInputSource::fill +
    ; init): a source's records are RS-delimited. `insertRS_` starts TRUE for EVERY
    ; external input source — the document entity, the external DTD subset AND a
    ; text entity included in content — and is re-armed after every record end, so
    ; the Char stream is
    ;
    ;     RS line1 RE RS line2 RE RS line3 ...
    ;
    ; i.e. one RS (0x0A) before the first record, each source LF (0x0A) translated
    ; to RE (0x0D), and one RS inserted before the NEXT char after each RE. A
    ; pending RS at end of entity is dropped (fill returns eE without flushing it),
    ; so a file ending in a newline ends with RE, not RE RS.
    ;
    ; That is the `lf` RECORD TYPE. The reference DETECTS the type per entity from
    ; its first CR/LF (recordType_ starts `unknown`), and the three types reach the
    ; same RE-RS shape by different routes — note that RS *is* LF and RE *is* CR:
    ;   lf     LF -> RE, an RS is INSERTED after it        (Unix)
    ;   crlf   CR already IS the RE, LF already IS the RS  (Windows) — nothing is
    ;          translated or inserted at all; a final LF at end of entity is dropped
    ;          (the reference deletes the RS "not followed by anything"), so a CRLF
    ;          file also ends with RE.
    ;   cr     CR already IS the RE, an RS is INSERTED     (classic Mac)
    ; A source with no CR and no LF at all is `asis`: no records, nothing inserted
    ; but the leading RS. Getting this wrong on a CRLF file emits RE RE RS per line
    ; (the CR passing through as a second record end).
    ;
    ; The inserted RSs are load-bearing under KEEPRSRE YES (xml.dcl): RS and RE are
    ; then ordinary DATA chars, and onsgmls prints them in ESIS as `\012` and `\n`
    ; respectively (SgmlsEventHandler::outputString) — so `x<LF>y` in mixed content
    ; is the data `x` RE RS `y`. Under KEEPRSRE NO they tokenize as tokenRs and the
    ; OutputState machine drops them.
    ;
    ; onsgmls under SP_ENCODING=XML decodes EVERY entity as UTF-8 (XMLCodingSystem
    ; -> UTF8CodingSystem): a well-formed sequence yields its Char, a byte that
    ; cannot start or continue one yields U+FFFD and is consumed ALONE (so a
    ; Latin-1 `ü` in an otherwise-ASCII file becomes exactly one U+FFFD and the
    ; following chars still scan normally), and a leading BOM is stripped. That
    ; U+FFFD is the only Char >= 256 the corpus produces; see Partition's high-char
    ; slot for how it stays a DATA char rather than colliding with the eE sentinel.
    ;
    ; Continuation bytes are all >= 0x80, so no multibyte sequence can hide an LF —
    ; the record normalization stays correct after decoding.
    function make_char_source(host: pointer[Page], bytes: String, org: pointer[Origin]) returns pointer[InputSource]
    {
        let n bytes.get_length()
        ; upper bound: at most one Char per input byte (multibyte sequences only
        ; ever shrink) plus its inserted RS (an all-LF source doubles), + slack.
        let buf host.allocate(((n * (2 as size_t)) + (2 as size_t)) * (4 as size_t), 4) as pointer[u32]
        var out: size_t 0
        ; the leading RS: armed at entity start, flushed before the first Char.
        var pending_rs true

        var i: size_t 0
        ; strip a leading UTF-8 BOM (EF BB BF).
        if n >= (3 as size_t)
        {
            if bytes.get(0 as size_t) = (0xEF as u8)
            {
                if bytes.get(1 as size_t) = (0xBB as u8)
                {
                    if bytes.get(2 as size_t) = (0xBF as u8)
                        set i: 3 as size_t
                }
            }
        }

        ; recordType_: the first CR or LF in the entity decides it (CR and LF are
        ; ASCII, so the raw bytes answer this — no multibyte sequence can hide one).
        var rt: int RT_ASIS
        var s i
        while s < n
        {
            let b bytes.get(s) as u32
            if b = (0x0A as u32)
            {
                set rt: RT_LF
                set s: n
            }
            else if b = (0x0D as u32)
            {
                ; a CR with nothing after it is the reference's crUnknown -> cr.
                set rt: RT_CR
                if (s + (1 as size_t)) < n
                {
                    let b2 bytes.get(s + (1 as size_t)) as u32
                    if b2 = (0x0A as u32)
                        set rt: RT_CRLF
                }
                set s: n
            }
            else
                set s: s + (1 as size_t)
        }

        while i < n
        {
            let b0 bytes.get(i) as u32
            ; default: an invalid byte decodes to U+FFFD and consumes just itself.
            var ch: u32 0xFFFD as u32
            var len: size_t 1
            if b0 < (0x80 as u32)
            {
                set ch: b0
            }
            else
            {
                ; lead byte -> how many continuations follow, and its payload bits.
                ; 0xC0/0xC1 (overlong) and > 0xF4 (out of range) are not leads.
                var need: size_t 0
                var acc: u32 0
                if b0 >= (0xC2 as u32)
                {
                    if b0 <= (0xDF as u32)
                    {
                        set need: 1 as size_t
                        set acc: b0 & (0x1F as u32)
                    }
                }
                if b0 >= (0xE0 as u32)
                {
                    if b0 <= (0xEF as u32)
                    {
                        set need: 2 as size_t
                        set acc: b0 & (0x0F as u32)
                    }
                }
                if b0 >= (0xF0 as u32)
                {
                    if b0 <= (0xF4 as u32)
                    {
                        set need: 3 as size_t
                        set acc: b0 & (0x07 as u32)
                    }
                }
                if need > (0 as size_t)
                {
                    var ok true
                    var k: size_t 1
                    while k <= need
                    {
                        if (i + k) >= n
                            set ok: false
                        else
                        {
                            let bc bytes.get(i + k) as u32
                            if (bc & (0xC0 as u32)) <> (0x80 as u32)
                                set ok: false
                            else
                                set acc: (acc << (6 as u32)) | (bc & (0x3F as u32))
                        }
                        set k: k + 1
                    }
                    if ok
                    {
                        set ch: acc
                        set len: need + (1 as size_t)
                    }
                }
            }
            ; flush the RS armed by the entity start / the previous record end.
            if pending_rs
            {
                set *(buf + out): 0x0A as u32
                set out: out + (1 as size_t)
                set pending_rs: false
            }
            ; the record end, per record type. `lf`: the LF becomes RE and arms the
            ; next record's RS (which stays unflushed — and so is dropped — at end
            ; of entity). `cr`: the CR already IS the RE, it only arms the RS.
            ; `crlf` / `asis`: nothing — CR and LF are already RE and RS.
            if rt = RT_LF
            {
                if ch = (0x0A as u32)
                {
                    set ch: 0x0D as u32
                    set pending_rs: true
                }
            }
            else if rt = RT_CR
            {
                if ch = (0x0D as u32)
                    set pending_rs: true
            }
            set *(buf + out): ch
            set out: out + (1 as size_t)
            set i: i + len
        }

        ; crlf: "Need to delete final RS if not followed by anything" — a source
        ; ending in CRLF ends with the RE, like every other record type.
        if rt = RT_CRLF
        {
            if out > (0 as size_t)
            {
                if *(buf + (out - (1 as size_t))) = (0x0A as u32)
                    set out: out - (1 as size_t)
            }
        }

        ; stash the normalized buffer on the origin so a diagnostic that resolves
        ; to this source (possibly below the current top input) can compute line/col
        ; from it — MessageReporter::printLocation's origin-chain resolution.
        org.set_buffer(buf, out)
        let src host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
        set *src: InputSource(org, buf, out)
        src
    }

    ; Load an external DTD subset named by a system id, resolved relative to the
    ; document's base directory (Storage.OsFile), into an InputSource (not yet
    ; pushed). Returns null ONLY if the file cannot be opened (the caller
    ; reports openSystemCall and parses on with the internal subset alone); an
    ; existing-but-EMPTY file is a valid zero-char subset, as in real onsgmls.
    function load_external_subset(this: Parser, base_dir: String, system_id: String) returns pointer[InputSource]
    {
        let storage Storage.OsFile(base_dir)
        let bytes storage.read(system_id)
        if bytes.get_length() = (0 as size_t)
        {
            let emsg storage.open_error(system_id)
            if emsg <> null
                return null
        }
        let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org: Origin()
        ; the storage id onsgmls displays for a location in this external subset:
        ; ExternalEntity::generateSystemId's effective system id = the relative
        ; SYSTEM literal resolved against the document's directory (base_dir).
        ; Verified vs real onsgmls: a diagnostic in dtd/model.dtd prints
        ; `dtd/model.dtd`, the RESOLVED path — Path.join(base_dir, system_id). Pin
        ; the widened StringC on host (^host) so it outlives the transient String.
        let disp Path.join(base_dir, system_id)
        org.set_file_name(StringC^host(disp.to_c_string()))
        Parser.make_char_source(host, bytes, org)
    }

    ; EntityManager::open for an external TEXT entity: resolve its (relative)
    ; system id against `base_dir` (the directory of the file the entity was
    ; DECLARED in — see ExternalTextEntity.base_dir) and decode the file into an
    ; InputSource carrying `org` (whose entity_decl arms the recursion guard). The
    ; SAME record normalization as the document entity applies — an included text
    ; entity is an external input source like any other. Null ONLY if the file
    ; cannot be opened (the caller reports openSystemCall at the reference site);
    ; an existing-but-empty entity file is valid, zero-char content.
    function open_external_text(this: Parser, base_dir: String, system_id: String, org: pointer[Origin]) returns pointer[InputSource]
    {
        let storage Storage.OsFile(base_dir)
        let bytes storage.read(system_id)
        if bytes.get_length() = (0 as size_t)
        {
            let emsg storage.open_error(system_id)
            if emsg <> null
                return null
        }
        ; the storage id onsgmls displays for a location in this external text
        ; entity: its effective system id = the entity's SYSTEM literal resolved
        ; against the DECLARING file's directory (base_dir = ExternalTextEntity's
        ; captured base_dir). Verified vs real onsgmls: an entity declared in
        ; dtd/model.dtd as SYSTEM "chap.sgm" prints `dtd/chap.sgm`, the RESOLVED
        ; path — Path.join(base_dir, system_id). Pin the widened StringC on host.
        let disp Path.join(base_dir, system_id)
        org.set_file_name(StringC^host(disp.to_c_string()))
        Parser.make_char_source(host, bytes, org)
    }

    ; ParserState::startDtd's PredefinedEntity loop: every entity the SGML
    ; declaration's SYNTAX ENTITIES section names (xml.dcl: "amp" 38, "lt" 60,
    ; "gt" 62, "quot" 34, "apos" 39) is inserted into the new DTD as an internal
    ; text entity whose replacement text is that one Char. `&lt;` in content then
    ; resolves through the ordinary entity path. The reference declaration names
    ; none, so a catalog-less document is unaffected.
    function insert_predefined_entities(this: Parser, dtd: pointer[Dtd])
    {
        let syn ps.get_syntax()
        let n syn.n_entities()
        var i: size_t 0
        while i < n
        {
            var ch: u32 0
            set ch: syn.entity_char(i)
            let nm syn.entity_name(i)
            let text StringC^host(&ch, 1 as size_t)
            let iep InternalEntity.make(host, nm, text, DT_SGML)
            let iev *iep
            let ent host.allocate(sizeof Entity, alignof Entity) as pointer[Entity]
            set *ent: Entity.Internal(iev)
            dtd.insert_entity(ent, false, false)
            set i: i + 1
        }
    }

    ; parseDoctypeDeclStart (scoped): name -> def/current Dtd; an optional external
    ; identifier (PUBLIC/SYSTEM), then the internal subset (`[ ... ]`), then the
    ; external subset (parsed AFTER the internal one — SGML order), then the MDC.
    function parse_doctype_decl_start(this: Parser, base_dir: String) returns bool
    {
        let decl_input_level ps.get_input_level()
        let parm Param.make(host)
        let allow_name AllowedParams.a1(host, P_NAME)
        if this.parse_param(allow_name, decl_input_level, parm) = false
            return false
        let docname parm.token
        let dtd Dtd.make(host, docname, true)
        ps.set_def_dtd(dtd)
        ps.set_current_dtd(dtd)
        this.insert_predefined_entities(dtd)

        let allow_ext AllowedParams.a4(host, P_DSO, P_MDC, P_RESERVED_NAME + R_SYSTEM, P_RESERVED_NAME + R_PUBLIC)
        if this.parse_param(allow_ext, decl_input_level, parm) = false
            return false

        ; ---- external identifier (PUBLIC/SYSTEM), if present ----
        ; the file itself is NOT opened here: the reference stashes the doctype
        ; entity (setDsEntity) and references it only when the internal subset
        ; ends — at the DSC (referenceDsEntity in the tokenDsc arm) or, with no
        ; internal subset, at the MDC. Only the system id is captured now.
        var has_ext false
        var dtd_sys String()
        if (parm.kind = (P_RESERVED_NAME + R_SYSTEM)) or (parm.kind = (P_RESERVED_NAME + R_PUBLIC))
        {
            var id ExternalId()
            let allow_sys AllowedParams.a3(host, P_SYSTEMIDENTIFIER, P_DSO, P_MDC)
            let allow_end AllowedParams.a2(host, P_DSO, P_MDC)
            if this.parse_external_id(allow_sys, allow_end, decl_input_level, parm, &id) = false
                return false
            if id.has_system_id()
            {
                ; pin the DTD's system id onto host before any further parsing —
                ; id.get_system_id() aliases the transient literal buffer.
                set dtd_sys: String^host(id.get_system_id())
                set has_ext: true
            }
            ; parm.kind is now P_DSO or P_MDC (the end token).
        }

        ps.set_phase(PHASE_DECL_SUBSET)

        ; ---- internal subset (`[ ... ]`), if a DSO opened it ----
        var has_internal false
        if parm.kind = P_DSO
        {
            let inner_level ps.get_input_level()
            let rc this.parse_decl_subset(inner_level, false)
            if rc <> 0
                return false
            set has_internal: true
        }

        ; ---- external subset, parsed AFTER the internal subset (SGML order) ----
        if has_ext
        {
            let ext_src this.load_external_subset(base_dir, dtd_sys)
            if ext_src = null
            {
                ; the external subset file could not be opened: real onsgmls
                ; reports openSystemCall ("cannot open ...") through the entity
                ; manager at the point the doctype entity is referenced — the
                ; DSC's (or, without an internal subset, the MDC's) token start,
                ; which IS the current token here — and parses on with the
                ; internal subset alone (referenceDsEntity returns 0).
                let disp Path.join(base_dir, dtd_sys)
                let dispc StringC^host(disp.to_c_string())
                let storage Storage.OsFile(base_dir)
                let emsg storage.open_error(dtd_sys)
                let ins ps.current_input()
                let floc ins.token_start_location()
                if emsg <> null
                    this.report_open_failure(dispc, emsg, floc)
            }
            else
            {
                ; relative SYSTEM ids in the external subset's declarations
                ; resolve against the DTD's own directory while it is parsed
                ; (extractDir of the DTD's system id, combined with the document
                ; base); restore the document base afterwards.
                let dtd_dir Path.get_directory_name(dtd_sys)
                let ext_base Path.join(base_dir, dtd_dir)
                ps.set_decl_base_dir(ext_base)
                ps.push_input(ext_src)
                let ext_level ps.get_input_level()
                this.parse_decl_subset(ext_level, true)
                ps.set_decl_base_dir(base_dir)
            }
        }

        ; ---- checkDtd (parseDecl.cxx:2352) ----
        ; parseDoctypeDeclEnd calls checkDtd BEFORE parsing the final MDC, so a
        ; current-location diagnostic (attlistNotationUndefined) points at the
        ; DSC. Element sweep first (undefined definitions), then the
        ; entity/notation sweeps.
        this.check_dtd(dtd)
        this.check_dtd_notations(dtd)

        ; ---- the closing MDC ----
        ; In the MDC-only case (no internal subset) the MDC was already consumed
        ; by allow_ext / parse_external_id; otherwise it follows the DSC.
        if has_internal
        {
            let allow_mdc AllowedParams.a1(host, P_MDC)
            if this.parse_param(allow_mdc, decl_input_level, parm) = false
                return false
        }
        true
    }

    ; lookingAtStartTag (parseDecl.cxx) — "This is harder than might be expected
    ; since we may not have compiled the recognizers for the instance yet": in the
    ; prolog a start tag is NOT a token (proMode has no STAGO), so the unrecognized
    ; token at the cursor is peeked by hand — does the input read STAGO followed by
    ; a name-start character? If so the general identifier is collected (folded
    ; through the instance syntax's substitution table, like every element name).
    ; The scan cursor is left where the peek stopped; the caller ungets the token.
    ; Returns the general identifier, EMPTY when the input is not a start tag (an
    ; out-parameter would make the escape checker reject the store — the returned
    ; StringC's characters live on `host`, but the checker is field-insensitive).
    function looking_at_start_tag(this: Parser) returns StringC
    {
        let ins ps.current_input()
        if ins = null
            return StringC()
        let syn ps.get_instance_syntax()
        let dlen syn.delim_general_len(dSTAGO)
        if dlen = (0 as size_t)
            return StringC()
        var i: size_t 0
        while i < dlen
        {
            let c ins.token_char()
            if c < 0
                return StringC()
            let f syn.fold(c as u32)
            if f <> syn.delim_general_char(dSTAGO, i)
                return StringC()
            set i: i + 1
        }
        var c2 ins.token_char()
        if c2 < 0
            return StringC()
        if syn.is_name_start_character(c2 as u32) = false
            return StringC()
        let buf Array[u32]^host()
        var scanning true
        while scanning
        {
            let f2 syn.fold(c2 as u32)
            buf.add(f2)
            set c2: ins.token_char()
            if c2 < 0
                set scanning: false
            else if syn.is_name_character(c2 as u32) = false
                set scanning: false
        }
        this.build_stringc(buf)
    }

    ; checkDtd's ELEMENT sweep (parseDecl.cxx:2389): every element type that was
    ; only ever REFERENCED (no <!ELEMENT> declared it) gets the shared undefined
    ; definition — ANY content, end tag omissible, undefined index — so the
    ; content checker admits it instead of tripping over a null definition, and
    ; acceptStartTag / tryImplyTag report undefinedElement off the flag. The
    ; definition-less DOCUMENT element additionally reports
    ; documentElementUndefined (validating + IMPLYDEF ELEMENT NO); other
    ; undefined elements are warn-gated (warnUndefinedElement, off). Runs for
    ; every DTD (parseDoctypeDeclEnd + implyDtd), like the reference.
    function check_dtd(this: Parser, dtd: pointer[Dtd])
    {
        let allow_recursion ps.get_implydef_element() <> IMPLYDEF_ELEMENT_ANYOTHER
        let det dtd.get_document_element_type()
        let n dtd.n_element_types()
        var def: pointer[ElementDefinition] null
        var di: size_t 0
        var i: size_t 0
        while i < n
        {
            let p dtd.get_element_type_at(i)
            if p <> null
            {
                if p.get_definition() = null
                {
                    if p = det
                    {
                        if ps.validate() and (ps.get_implydef_element() = IMPLYDEF_ELEMENT_NO)
                        {
                            ; currentLocation() = the START of the current token
                            ; (the DSC / MDC that ended the subset).
                            let ins ps.current_input()
                            let cloc ins.token_start_location()
                            this.report0_at(ParserMessages.documentElementUndefined(), cloc)
                        }
                    }
                    if def = null
                    {
                        let loc ps.current_location()
                        set def: ElementDefinition.make(host, loc, ELEMENT_UNDEFINED_INDEX, OMIT_END, DC_ANY, allow_recursion)
                    }
                    p.set_element_definition(def, di)
                    set di: di + (1 as size_t)
                }
            }
            set i: i + 1
        }
    }

    ; checkDtd (parseDecl.cxx:2466-2520), the ENTITY/NOTATION halves — the
    ; element half stays with the implied-DTD check_dtd above. Runs at DOCTYPE
    ; end BEFORE the closing MDC is parsed (so a current-location message points
    ; at the DSC, verified vs real onsgmls). Two sweeps:
    ;   - every external data entity whose notation is still undefined reports
    ;     entityNotationUndefined (notation, entity) at the entity's declaration
    ;     MDO (its defLocation);
    ;   - every undefined notation that carries an attribute definition list
    ;     reports attlistNotationUndefined at the current location.
    ; Both sweeps iterate the reference's NamedTable BUCKET order, NOT
    ; declaration order (verified: zebra/mike/alpha) — re-derived by inserting
    ; the names in declaration order into an IdTable (the faithful
    ; Hash/PointerTable port) and walking its buckets. The reference's
    ; implydefNotation branch (auto-define instead of report) is unreachable:
    ; our Sd never sets IMPLYDEF NOTATION (constant, like implydef_doctype).
    ; Under WWW the reference sweeps parameter entities too.
    function check_dtd_notations(this: Parser, dtd: pointer[Dtd])
    {
        if ps.validate() = false
            return
        ; (the element sweep — undefined definitions + documentElementUndefined —
        ; runs just before this in check_dtd, reference order.)
        var passes: int 1
        if ps.get_sd().www()
            set passes: 2
        var pass: int 0
        while pass < passes
        {
            let is_parameter pass = 1
            let n dtd.n_entities(is_parameter)
            let t IdTable.make(host)
            var i: size_t 0
            while i < n
            {
                let ent dtd.entity_at(is_parameter, i)
                if ent <> null
                {
                    let ename ent.get_name()
                    t.lookup_create(host, ename)
                }
                set i: i + 1
            }
            let nb (*t).bucket_count()
            var b: size_t 0
            while b < nb
            {
                let slot (*t).bucket_at(b)
                if slot <> null
                {
                    let sname slot.get_name()
                    let ent2 dtd.lookup_entity(is_parameter, sname)
                    if ent2 <> null
                    {
                        let ntv ent2.get_data_notation()
                        if ntv <> null
                        {
                            let nt ntv as pointer[Notation]
                            if nt.is_defined() = false
                            {
                                let nn nt.get_name()
                                let en ent2.get_name()
                                let dl ent2.get_def_location()
                                this.report2_at(ParserMessages.entityNotationUndefined(), nn, en, dl)
                            }
                        }
                    }
                }
                set b: b + 1
            }
            set pass: pass + 1
        }
        let nnot dtd.n_notations()
        let tn IdTable.make(host)
        var j: size_t 0
        while j < nnot
        {
            let ntj dtd.notation_at(j)
            if ntj <> null
            {
                let nname ntj.get_name()
                tn.lookup_create(host, nname)
            }
            set j: j + 1
        }
        let nb2 (*tn).bucket_count()
        var b2: size_t 0
        while b2 < nb2
        {
            let slot2 (*tn).bucket_at(b2)
            if slot2 <> null
            {
                let sname2 slot2.get_name()
                let nt2 dtd.lookup_notation(sname2)
                if nt2 <> null
                {
                    if nt2.is_defined() = false
                        if nt2.get_attribute_def() <> null
                        {
                            ; current-location message: the current TOKEN start
                            ; (the DSC — verified 7:0 vs real onsgmls; report1's
                            ; cursor position is one past it).
                            let nn2 nt2.get_name()
                            let nloc ps.current_input().token_start_location()
                            this.report1_at(ParserMessages.attlistNotationUndefined(), nn2, nloc)
                        }
                }
            }
            set b2: b2 + 1
        }
    }

    ; implyDtd (parseDecl.cxx) — the document has no document type declaration at
    ; all: the first thing in the prolog is the document element's start tag.
    ;
    ; Two errors, in this order (both hard — the parse continues but the document
    ; does NOT conform, so onsgmls exits 1 and writes no trailing `C`):
    ;   omittedProlog  the prolog may only be omitted with CONCUR NO, LINK EXPLICIT
    ;                  NO and IMPLYDEF ELEMENT or DOCTYPE YES. xml.dcl and the
    ;                  reference declaration say IMPLYDEF NO -> always reported.
    ;   noDtd          "no document type declaration; will parse without validation"
    ;                  — the reference reaches it when the catalog has no DTD filed
    ;                  under the document element's name. We do not wire that
    ;                  lookup: no corpus catalog declares a DOCTYPE entry, so the
    ;                  lookup would always fail and this is the only branch.
    ;
    ; Then enableImplydef: for the rest of the parse an undeclared element is
    ; implied (ANY content) rather than an error, and an undeclared attribute gets
    ; an implied CDATA definition. The DTD itself is a base Dtd named after the GI,
    ; carrying only the syntax's predefined entities.
    function imply_dtd(this: Parser, gi: StringC)
    {
        let sd ps.get_sd()
        if sd.implydef_element() = IMPLYDEF_ELEMENT_NO
        {
            if sd.implydef_doctype() = false
            {
                this.report0(ParserMessages.omittedProlog())
            }
        }
        this.report0(ParserMessages.noDtd())
        ps.enable_implydef()

        let dtd Dtd.make(host, gi, true)
        ps.set_def_dtd(dtd)
        ps.set_current_dtd(dtd)
        this.insert_predefined_entities(dtd)
        this.check_dtd(dtd)
    }

    ; doProlog (scoped): skip separators, dispatch the DOCTYPE declaration, and
    ; leave the input positioned at the first instance token.
    ; prologRecover (parseDecl.cxx): after an invalid prolog character, skip
    ; ahead to something that could open a declaration / PI / the instance.
    function prolog_recover(this: Parser)
    {
        var skip_count: u32 0
        let re_ch ps.get_syntax().standard_function(fRE)
        var looping true
        while looping
        {
            var token ps.get_token(proMode)
            set skip_count: skip_count + (1 as u32)
            if token = tokenUnrecognized
            {
                ; the `]>`-of-a-lost-subset heuristic: an MDC followed by S
                ; ends the recovery.
                set token: ps.get_token(mdMode)
                if token = tokenMdc
                {
                    set token: ps.get_token(proMode)
                    if token = tokenS
                        return
                }
            }
            if token = tokenUnrecognized
            {
                ; getChar() — consume the unmatched character.
                let ins ps.current_input()
                if ins.current_token_length() = (0 as size_t)
                    ins.end_token(1 as size_t)
            }
            else if token = tokenEe
                return
            else if (token = tokenMdoMdc) or (token = tokenMdoCom) or (token = tokenMdoNameStart) or (token = tokenPio)
            {
                ps.current_input().unget_token()
                return
            }
            else if token = tokenS
            {
                let cc ps.current_input().current_char()
                if (cc = re_ch) and (skip_count >= (250 as u32))
                    return
            }
        }
    }

    ; consume the prolog separators (S / record boundaries) that follow the
    ; DOCTYPE declaration and leave the cursor on the first instance token.
    function skim_prolog_separators(this: Parser)
    {
        var skimming true
        while skimming
        {
            let t ps.get_token(proMode)
            if (t = tokenS) or (t = tokenRe) or (t = tokenRs)
                set skimming: skimming
            else
            {
                ps.current_input().unget_token()
                set skimming: false
            }
        }
    }

    function parse_prolog(this: Parser, base_dir: String) returns bool
    {
        ps.set_current_mode(proMode)
        ps.set_phase(PHASE_PROLOG)
        var running true
        var ok true
        var prolog_tries: u32 0
        while running
        {
            let token ps.get_token(proMode)
            if token = tokenS
            {
                ; separator between prolog constructs: skip
            }
            else if (token = tokenRe) or (token = tokenRs)
            {
                ; record boundary in the prolog: ignore
            }
            else if token = tokenMdoNameStart
            {
                let prolog_decl_level ps.get_input_level()
                var decl_name: int 0
                if this.parse_declaration_name(&decl_name) = false
                {
                    set ok: false
                    set running: false
                }
                else if decl_name = R_DOCTYPE
                {
                    set ok: this.parse_doctype_decl_start(base_dir)
                    ; doProlog keeps scanning after the DOCTYPE: the separators
                    ; between `]>` and the instance are PROLOG separators —
                    ; consumed here, so the instance's first token (which
                    ; doInstanceStart inspects) is the document element's start
                    ; tag, never a record boundary.
                    if ok
                        this.skim_prolog_separators()
                    set running: false
                }
                else
                {
                    ; doProlog (parseDecl.cxx:108): a declaration reserved name that
                    ; is not allowed in the prolog. ELEMENT/ATTLIST/ENTITY/NOTATION/
                    ; SHORTREF/USEMAP/USELINK/LINK/IDLINK -> prologDeclaration; any
                    ; other recognized reserved name -> noSuchDeclarationType (the
                    ; switch default). Then recover past the declaration and keep
                    ; scanning the prolog (DOCTYPE / the instance may still follow).
                    ; LINKTYPE (parseLinktypeDeclStart) is part of the deferred LINK
                    ; feature axis — left as err(81), corpus-unreached.
                    let spell this.name_folded()
                    let dloc ps.current_input().token_start_location()
                    if this.prolog_declaration_not_allowed(decl_name)
                        this.report1_at(ParserMessages.prologDeclaration(), spell, dloc)
                    else if decl_name = R_LINKTYPE
                        this.err(81)
                    else
                        this.report1_at(ParserMessages.noSuchDeclarationType(), spell, dloc)
                    this.skip_declaration(prolog_decl_level)
                }
            }
            else if token = tokenPio
            {
                ; a processing instruction in the prolog (e.g. an XML declaration
                ; `<?xml ...?>` before the document element). doProlog: parse it
                ; and keep scanning the prolog. Must precede the unrecognized /
                ; implyDtd arm so a leading PI does not derail No-DOCTYPE detection.
                if this.parse_processing_instruction() = false
                {
                    set ok: false
                    set running: false
                }
            }
            else if token = tokenEe
            {
                ; documentEndProlog (doProlog tokenEe): the document ended
                ; before any content. This loop exits once a DOCTYPE (or an
                ; implied DTD) is in hand, so hadDtd() is always false here.
                this.report0_at(ParserMessages.documentEndProlog(), ps.current_input().token_start_location())
                set ok: false
                set running: false
            }
            else if token = tokenUnrecognized
            {
                ; proMode has no STAGO recognizer, so the document element's start
                ; tag arrives here as an unrecognized token. With a DTD in hand the
                ; instance simply begins (unget, let do_content rescan it); WITHOUT
                ; one this is a document with no DOCTYPE — peek for the start tag
                ; and imply the DTD from its general identifier (doProlog).
                if ps.get_current_dtd() = null
                {
                    let gi this.looking_at_start_tag()
                    if gi.get_size() > (0 as size_t)
                    {
                        ps.current_input().unget_token()
                        this.imply_dtd(gi)
                        set running: false
                    }
                    else
                    {
                        ; prologCharacter (parseDecl.cxx:74) — a character that can
                        ; neither open a declaration nor start the instance; a
                        ; non-SGML character reports its own message instead. Then
                        ; recover (prologRecover) and keep scanning the prolog —
                        ; after maxTries (10) rounds give up (notSgml).
                        if this.report_non_sgml_param() = false
                        {
                            set prolog_tries: prolog_tries + (1 as u32)
                            if prolog_tries >= (10 as u32)
                            {
                                this.report0_at(ParserMessages.notSgml(), ps.current_input().token_start_location())
                                this.report0(ParserMessages.giveUp())
                                set ok: false
                                set running: false
                            }
                            else
                            {
                                let ct ps.current_token()
                                this.report1_at(ParserMessages.prologCharacter(), ct, ps.current_input().token_start_location())
                                this.prolog_recover()
                            }
                        }
                    }
                }
                else
                {
                    ps.current_input().unget_token()
                    set running: false
                }
            }
            else
            {
                ; the instance begins (data / another instance token): unget and stop.
                ps.current_input().unget_token()
                set running: false
            }
        }
        ok
    }

    ; doInstanceStart (parseInstance.cxx:16) — the instance's FIRST token: when
    ; it is not a tag (or entity end), the document element's start tag is
    ; implied under OMITTAG YES; under OMITTAG NO the instance must start with
    ; the document element (instanceStartOmittag) and the data stays outside.
    ; The token is ungotten either way and re-dispatched by do_content.
    function do_instance_start(this: Parser)
    {
        let token ps.get_token(ps.get_current_mode())
        var needs_imply true
        if token = tokenEe
            set needs_imply: false
        else if (token = tokenStagoNameStart) or (token = tokenStagoTagc) or (token = tokenStagoGrpo)
            set needs_imply: false
        else if (token = tokenEtagoNameStart) or (token = tokenEtagoTagc) or (token = tokenEtagoGrpo)
            set needs_imply: false
        if needs_imply
        {
            if ps.get_sd().omittag()
            {
                var start_implied: u32 0
                let undo Array[UndoEntry]^host()
                let events Array[pointer[Event]]^host()
                let discard this.try_imply_tag(ps.current_input().token_start_location(), &start_implied, undo, events)
                this.queue_element_events(events)
            }
            else
                this.report0_at(ParserMessages.instanceStartOmittag(), ps.current_input().token_start_location())
        }
        ps.current_input().unget_token()
    }

    ; the full document drive: prolog (DOCTYPE) -> content events.
    ; The caller installs the prolog/decl recognizers (install_recognizers) and
    ; pushes the document InputSource; parse_document adds the content-mode
    ; recognizers, enters the instance, and runs doContent over the SAME input.
    function parse_document(this: Parser, table: pointer[Array[PackedTokenInfo]], base_dir: String) returns bool
    {
        if this.parse_prolog(base_dir) = false
            return false
        let dtd ps.get_current_dtd()
        if dtd = null
            return false
        ; SCOPE INSTANCE: the instance parses with the DECLARED syntax; the
        ; content-mode recognizers compile from it.
        let inst ps.get_instance_syntax()
        let cur_syn ps.get_syntax()
        if (inst <> null) and (inst <> cur_syn)
            ps.switch_to_instance_syntax()
        this.install_content_recognizers(table)
        ps.start_instance(host, dtd)
        this.do_instance_start()
        this.do_content()
        true
    }

    ; ======================================================================
    ; The SGML-declaration parser (parseSd.cxx) — parseSdParam tokenizer
    ; level. Sections and the parseSgmlDecl driver follow below.

    ; every plain message() in the SD context anchors at the current token's
    ; start (the S27 location convention).
    function sd_loc(this: Parser) returns Location
    {
        let ins ps.current_input()
        ins.token_start_location()
    }

    ; StringMessageArg + NumberMessageArg pair (delimiterLength).
    function report_str_num_at(this: Parser, mt: MessageType, a1: StringC, a2: u64, loc: Location)
    {
        var args Vector[MessageArg](2 as size_t)
        set *(args.get(0 as size_t)): MessageArg.Str(a1)
        set *(args.get(1 as size_t)): MessageArg.Num(a2)
        ps.report_at(mt, args, loc)
    }

    function arg_append_dec(this: Parser, buf: pointer[Array[u32]], v: u64)
    {
        var digits u32[24]
        let dp digits as pointer[u32]
        var n: size_t 0
        var x v
        if x = (0 as u64)
        {
            buf.add(0x30 as u32)
            return
        }
        while x > (0 as u64)
        {
            set *(dp + n): ((0x30 as u64) + (x % (10 as u64))) as u32
            set x: x / (10 as u64)
            set n: n + 1
        }
        while n > (0 as size_t)
        {
            set n: n - (1 as size_t)
            buf.add(*(dp + n))
        }
    }

    ; CharsetMessageArg (parseSd.cxx:3456): number list, "a" / "a, b" for an
    ; adjacent pair / "a-b" for a longer range; ", " between entries. Rendered
    ; via appendNumber/appendFragment — UNQUOTED.
    function charset_message_arg(this: Parser, cset: pointer[ISet]) returns StringC
    {
        let buf Array[u32]^host()
        var first true
        var i: size_t 0
        let n cset.get_count()
        while i < n
        {
            let mn cset.range_min(i)
            let mx cset.range_max(i)
            this.arg_append_sep(buf, &first)
            this.arg_append_dec(buf, mn as u64)
            if mx <> mn
            {
                if mx = (mn + (1 as u32))
                    this.arg_append(buf, StringC(", "))
                else
                    this.arg_append(buf, StringC("-"))
                this.arg_append_dec(buf, mx as u64)
            }
            set i: i + 1
        }
        this.arg_to_string(buf)
    }

    ; AllowedSdParamsMessageArg (parseSd.cxx:3313): fragments unquoted,
    ; appendChars pieces quoted, listSep between entries.
    function sd_allow_arg(this: Parser, allow: AllowedSdParams) returns StringC
    {
        let buf Array[u32]^host()
        var first true
        var i: int 0
        while i < 6
        {
            let t allow.get(i)
            if t = SDP_INVALID
                break
            this.arg_append_sep(buf, &first)
            if t = SDP_EE
                this.arg_append(buf, StringC("entity end"))
            else if t = SDP_MINIMUM_LITERAL
                this.arg_append(buf, StringC("minimum literal"))
            else if t = SDP_MDC
            {
                this.arg_append(buf, StringC("delimiter "))
                this.arg_append_quoted(buf, StringC(">"))
            }
            else if t = SDP_NUMBER
                this.arg_append(buf, StringC("number"))
            else if t = SDP_NAME
                this.arg_append(buf, StringC("name"))
            else if t = SDP_PARAM_LITERAL
                this.arg_append(buf, StringC("parameter literal"))
            else if t = SDP_SYSTEM_IDENTIFIER
                this.arg_append(buf, StringC("system identifier"))
            else if t = SDP_CAPACITY_NAME
                this.arg_append(buf, StringC("name of capacity"))
            else if t = SDP_GENERAL_DELIMITER_NAME
                this.arg_append(buf, StringC("name of general delimiter role"))
            else if t = SDP_REFERENCE_RESERVED_NAME
                this.arg_append(buf, StringC("reference reserved name"))
            else if t = SDP_QUANTITY_NAME
                this.arg_append(buf, StringC("name of quantity"))
            else if t = SDP_MINUS
                this.arg_append_quoted(buf, StringC("..."))
            else
            {
                let sdv ps.get_sd()
                let spell sdv.sd_reserved_name(t - SDP_RESERVED_NAME)
                this.arg_append_quoted(buf, spell)
            }
            set i: i + 1
        }
        this.arg_to_string(buf)
    }

    ; Parser::sdParamInvalidToken (parseSd.cxx:3251).
    function sd_param_invalid_token(this: Parser, token: u32, allow: AllowedSdParams)
    {
        let tok_arg this.token_message_arg(token, sdMode)
        let allow_arg this.sd_allow_arg(allow)
        this.report_raw_raw_at(ParserMessages.sdParamInvalidToken(), tok_arg, allow_arg, this.sd_loc())
    }

    ; Parser::stringToNumber over the current token (u64 accumulation with the
    ; reference's overflow guard).
    function sd_token_number(this: Parser, out_n: pointer[u64]) returns bool
    {
        let ins ps.current_input()
        let start ins.current_token_start_index()
        let len ins.current_token_length()
        var n: u64 0
        var i: size_t 0
        while i < len
        {
            let c ins.char_at(start + i)
            let d (c - (0x30 as u32)) as u64
            if n > (0x1999999999999999 as u64)
                return false
            set n: n * (10 as u64)
            if n > ((0xFFFFFFFFFFFFFFFF as u64) - d)
                return false
            set n: n + d
            set i: i + 1
        }
        set *out_n: n
        true
    }

    ; Parser::parseSdParam (parseSd.cxx:2882) — the SD tokenizer/dispatcher.
    function parse_sd_param(this: Parser, allow: AllowedSdParams, parm: pointer[SdParam]) returns bool
    {
        while true
        {
            let token ps.get_token(sdMode)
            if token = tokenUnrecognized
            {
                if this.report_non_sgml_param()
                {
                    ; reported + consumed; keep scanning.
                }
                else
                {
                    let ins ps.current_input()
                    let ts ins.current_token_string()
                    let allow_arg this.sd_allow_arg(allow)
                    this.report_str_raw_at(ParserMessages.markupDeclarationCharacter(), ts, allow_arg, this.sd_loc())
                    return false
                }
            }
            else if token = tokenEe
            {
                if allow.param(SDP_EE)
                {
                    set parm.kind: SDP_EE
                    ps.pop_input_stack()
                    return true
                }
                let allow_arg this.sd_allow_arg(allow)
                this.report_raw_at(ParserMessages.sdEntityEnd(), allow_arg, this.sd_loc())
                return false
            }
            else if token = tokenS
            {
                ; separator — keep scanning.
            }
            else if token = tokenCom
            {
                if this.parse_comment(sdcomMode) = false
                    return false
            }
            else if (token = tokenDso) or (token = tokenGrpo) or (token = tokenMinusGrpo) or (token = tokenPlusGrpo) or (token = tokenRni) or (token = tokenPeroNameStart) or (token = tokenPeroGrpo)
            {
                this.sd_param_invalid_token(token, allow)
                return false
            }
            else if token = tokenMinus
            {
                if allow.param(SDP_MINUS)
                {
                    set parm.kind: SDP_MINUS
                    return true
                }
                this.sd_param_invalid_token(tokenMinus, allow)
                return false
            }
            else if (token = tokenLit) or (token = tokenLita)
            {
                let lita token = tokenLita
                if allow.param(SDP_MINIMUM_LITERAL)
                {
                    var lmode: int mlitMode
                    if lita
                        set lmode: mlitaMode
                    let txt host.allocate(sizeof Text, alignof Text) as pointer[Text]
                    let syn ps.get_syntax()
                    if this.parse_literal(lmode, true, syn.reference_quantity(qLITLEN) as size_t, ParserMessages.minimumLiteralLength(), txt) = false
                        return false
                    set parm.kind: SDP_MINIMUM_LITERAL
                    set parm.literal_text: txt
                }
                else if allow.param(SDP_PARAM_LITERAL)
                {
                    if this.parse_sd_param_literal(lita, parm) = false
                        return false
                    set parm.kind: SDP_PARAM_LITERAL
                }
                else if allow.param(SDP_SYSTEM_IDENTIFIER)
                {
                    let txt host.allocate(sizeof Text, alignof Text) as pointer[Text]
                    if this.parse_sd_system_identifier(lita, txt) = false
                        return false
                    set parm.kind: SDP_SYSTEM_IDENTIFIER
                    set parm.literal_text: txt
                }
                else
                {
                    this.sd_param_invalid_token(token, allow)
                    return false
                }
                return true
            }
            else if token = tokenMdc
            {
                if allow.param(SDP_MDC)
                {
                    set parm.kind: SDP_MDC
                    return true
                }
                this.sd_param_invalid_token(tokenMdc, allow)
                return false
            }
            else if token = tokenNameStart
            {
                let syn ps.get_syntax()
                let namelen syn.get_quantity(qNAMELEN) as size_t
                this.extend_name_token(namelen, ParserMessages.nameLength())
                ; NB: `#` here resolves to parse_sd_param's FRAME page (no
                ; _rp in the chain — the s196 local-page fallback), and
                ; StringC.init(chars, n) deep-copies the chars onto the
                ; StringC's OWN page — so the host-allocated buffer inside
                ; current_token_subst does NOT survive into tok; its
                ; payload sits on this frame's page, released on return.
                ; parm outlives this frame, so pin the content onto host.
                ; (The corpus does not reliably provoke the dangle —
                ; page reuse is timing-dependent — but the lifetime
                ; analysis is unambiguous; S30 crashed here: 0x4500000053
                ; = packed 'S','E' u32s read from a reused page.)
                let tok ps.current_token_subst#(syn)
                set parm.token: StringC^host(tok.data_ptr(), tok.get_size())
                let sdv ps.get_sd()
                if allow.param(SDP_CAPACITY_NAME)
                {
                    let ci sdv.lookup_capacity_name(parm.token)
                    if ci >= 0
                    {
                        set parm.kind: SDP_CAPACITY_NAME
                        set parm.idx: ci
                        return true
                    }
                }
                if allow.param(SDP_REFERENCE_RESERVED_NAME)
                {
                    let rr syn.lookup_reserved_name(parm.token)
                    if rr >= 0
                    {
                        set parm.kind: SDP_REFERENCE_RESERVED_NAME
                        set parm.idx: rr
                        return true
                    }
                }
                if allow.param(SDP_GENERAL_DELIMITER_NAME)
                {
                    let di sdv.lookup_general_delimiter_name(parm.token)
                    if di >= 0
                    {
                        set parm.kind: SDP_GENERAL_DELIMITER_NAME
                        set parm.idx: di
                        return true
                    }
                }
                if allow.param(SDP_QUANTITY_NAME)
                {
                    let qi sdv.lookup_quantity_name(parm.token)
                    if qi >= 0
                    {
                        set parm.kind: SDP_QUANTITY_NAME
                        set parm.idx: qi
                        return true
                    }
                }
                var ai: int 0
                while ai < 6
                {
                    let t allow.get(ai)
                    if t = SDP_INVALID
                        break
                    if t >= SDP_RESERVED_NAME
                    {
                        let spell sdv.sd_reserved_name(t - SDP_RESERVED_NAME)
                        if parm.token.equals(spell)
                        {
                            set parm.kind: t
                            return true
                        }
                    }
                    set ai: ai + 1
                }
                if allow.param(SDP_NAME)
                {
                    set parm.kind: SDP_NAME
                    return true
                }
                let allow_arg this.sd_allow_arg(allow)
                this.report_str_raw_at(ParserMessages.sdInvalidNameToken(), parm.token, allow_arg, this.sd_loc())
                return false
            }
            else if token = tokenDigit
            {
                if allow.param(SDP_NUMBER)
                {
                    let syn ps.get_syntax()
                    let nlen syn.get_quantity(qNAMELEN) as size_t
                    this.extend_number(nlen)
                    set parm.kind: SDP_NUMBER
                    var n64: u64 0
                    var num_ok this.sd_token_number(&n64)
                    if num_ok
                    {
                        if n64 > (4294967295 as u64)
                            set num_ok: false
                    }
                    if num_ok = false
                    {
                        let ins ps.current_input()
                        let ts ins.current_token_string()
                        this.report1_at(ParserMessages.numberTooBig(), ts, this.sd_loc())
                        set parm.n: 4294967295 as u32
                    }
                    else
                        set parm.n: n64 as u32
                    ; a name start directly after a number needs a separator
                    ; (parseSd.cxx:3053).
                    let peek ps.get_token(sdMode)
                    if peek = tokenNameStart
                        this.report0_at(ParserMessages.psRequired(), this.sd_loc())
                    let ins2 ps.current_input()
                    ins2.unget_token()
                    return true
                }
                this.sd_param_invalid_token(tokenDigit, allow)
                return false
            }
            else
            {
                ; CANNOT_HAPPEN in the reference; treat as invalid.
                this.sd_param_invalid_token(token, allow)
                return false
            }
        }
        false
    }

    ; Parser::parseSdParamLiteral (parseSd.cxx:3070) — a parameter literal in
    ; the SGML declaration; chars are SYNTAX chars (numeric refs bounded by
    ; syntaxCharMax, not the document charset).
    function parse_sd_param_literal(this: Parser, lita: bool, parm: pointer[SdParam]) returns bool
    {
        var lmode: int sdplitMode
        if lita
            set lmode: sdplitaMode
        let syn ps.get_syntax()
        let ref_litlen syn.reference_quantity(qLITLEN) as size_t
        let buf Array[u32]^host()
        var running true
        while running
        {
            let token ps.get_token(lmode)
            if token = tokenEe
            {
                this.report0_at(ParserMessages.literalLevel(), this.sd_loc())
                return false
            }
            else if token = tokenUnrecognized
            {
                if this.report_non_sgml_param()
                {
                    ; non-SGML char reported + consumed (dropped).
                }
                else
                {
                    ; options().errorSignificant (sdLiteralSignificant) is a
                    ; -w flag, default off; the char joins the literal.
                    let ins ps.current_input()
                    let pc ins.current_char()
                    buf.add(pc)
                }
            }
            else if token = tokenCroDigit
            {
                let ins ps.current_input()
                ins.discard_initial()
                let nlen2 syn.get_quantity(qNAMELEN) as size_t
                this.extend_number(nlen2)
                var n64: u64 0
                var valid this.sd_token_number(&n64)
                if valid
                {
                    if n64 > (4294967295 as u64)
                        set valid: false
                }
                if valid = false
                {
                    let ts ins.current_token_string()
                    this.report1_at(ParserMessages.syntaxCharacterNumber(), ts, this.sd_loc())
                }
                ; consume the reference end (REFC / RE / neither); warnRefc is
                ; a -w flag, default off.
                let rt ps.get_token(refMode)
                if valid
                    buf.add(n64 as u32)
            }
            else if token = tokenCroNameStart
            {
                if this.parse_named_char_ref() = false
                    return false
            }
            else if (token = tokenLit) or (token = tokenLita)
                set running: false
            else if (token = tokenPeroNameStart) or (token = tokenPeroGrpo)
            {
                this.report0_at(ParserMessages.sdParameterEntity(), this.sd_loc())
                let ins ps.current_input()
                let start ins.current_token_start_index()
                let len ins.current_token_length()
                var i: size_t 0
                while i < len
                {
                    let c ins.char_at(start + i)
                    buf.add(c)
                    set i: i + 1
                }
            }
            else if token = tokenChar
            {
                let ins ps.current_input()
                let pc ins.current_char()
                if buf.get_length() > ref_litlen
                {
                    let re_char syn.standard_function(fRE)
                    if pc = re_char
                    {
                        this.report_num_at(ParserMessages.parameterLiteralLength(), ref_litlen as u64, this.sd_loc())
                        ; guess that the closing delimiter has been omitted
                        this.report0_at(ParserMessages.literalClosingDelimiter(), this.sd_loc())
                        return false
                    }
                }
                buf.add(pc)
            }
            else
            {
                ; no other token is recognized in the sdplit modes.
                set running: false
            }
        }
        if buf.get_length() > ref_litlen
            this.report_num_at(ParserMessages.parameterLiteralLength(), ref_litlen as u64, this.sd_loc())
        set parm.param_literal: StringC^host(buf.get_buffer(), buf.get_length())
        true
    }

    ; Parser::parseSdSystemIdentifier (parseSd.cxx:3191).
    function parse_sd_system_identifier(this: Parser, lita: bool, txt: pointer[Text]) returns bool
    {
        var lmode: int sdslitMode
        if lita
            set lmode: sdslitaMode
        let syn ps.get_syntax()
        let ref_litlen syn.reference_quantity(qLITLEN) as size_t
        let buf Array[u32]^host()
        var running true
        while running
        {
            let token ps.get_token(lmode)
            if token = tokenEe
            {
                this.report0_at(ParserMessages.literalLevel(), this.sd_loc())
                return false
            }
            else if token = tokenUnrecognized
            {
                if this.report_non_sgml_param()
                {
                    ; reported + consumed (dropped).
                }
                else
                {
                    let ins ps.current_input()
                    let pc ins.current_char()
                    buf.add(pc)
                }
            }
            else if (token = tokenLit) or (token = tokenLita)
                set running: false
            else if token = tokenChar
            {
                let ins ps.current_input()
                let pc ins.current_char()
                buf.add(pc)
            }
            else
                set running: false
        }
        if buf.get_length() > ref_litlen
            this.report_num_at(ParserMessages.systemIdentifierLength(), ref_litlen as u64, this.sd_loc())
        let s StringC^host(buf.get_buffer(), buf.get_length())
        set *txt: Text(s)
        true
    }

    ; the modes the SGML-declaration parse drives, compiled from the
    ; PROVISIONAL (reference) syntax before the declaration is parsed
    ; (compileSdModes).
    function install_sd_recognizers(this: Parser, table: pointer[Array[PackedTokenInfo]])
    {
        let sdv *ps.get_sd()
        let synv *ps.get_syntax()
        var modes int[9]
        let mp modes as pointer[int]
        set *(mp + (0 as size_t)): sdMode
        set *(mp + (1 as size_t)): sdcomMode
        set *(mp + (2 as size_t)): sdplitMode
        set *(mp + (3 as size_t)): sdplitaMode
        set *(mp + (4 as size_t)): sdslitMode
        set *(mp + (5 as size_t)): sdslitaMode
        set *(mp + (6 as size_t)): mlitMode
        set *(mp + (7 as size_t)): mlitaMode
        set *(mp + (8 as size_t)): refMode
        var i: int 0
        while i < 9
        {
            let m *(mp + (i as size_t))
            let r Recognizer.build_recognizer(host, m, sdv, synv, table)
            ps.set_recognizer(m, r)
            set i: i + 1
        }
    }

    ; Parser::scanForSgmlDecl (parseSd.cxx:593) — does the current input open
    ; with `<!SGML` + non-name-char? Consumes the prefix on success (pushing
    ; the last peeked char back); the CALLER ungets the token on failure.
    function scan_for_sgml_decl(this: Parser) returns bool
    {
        let ins ps.current_input()
        ins.start_token_no_multicode()
        var c ins.token_char()
        while (c = 10) or (c = 13) or (c = 32) or (c = 9)
            set c: ins.token_char()
        if c <> 60
            return false
        if ins.token_char() <> 33
            return false
        set c: ins.token_char()
        if (c <> 83) and (c <> 115)
            return false
        set c: ins.token_char()
        if (c <> 71) and (c <> 103)
            return false
        set c: ins.token_char()
        if (c <> 77) and (c <> 109)
            return false
        set c: ins.token_char()
        if (c <> 76) and (c <> 108)
            return false
        set c: ins.token_char()
        if c < 0
            return true
        let tl ins.current_token_length()
        ins.end_token(tl - (1 as size_t))
        if c = 45
            return false
        if c = 46
            return false
        if (c >= 97) and (c < 123)
            return false
        if (c >= 65) and (c < 91)
            return false
        if (c >= 48) and (c < 58)
            return false
        true
    }

    ; Parser::findMissingMinimum (parseSd.cxx:652): the minimum-data chars a
    ; charset must map — letters, digits and the special minimum-data chars.
    function find_missing_minimum(this: Parser, charset: pointer[UnivCharsetDesc], missing: pointer[ISet])
    {
        var to: u32 0
        var cnt: u32 0
        var i: u32 0
        while i < (26 as u32)
        {
            let uc (65 as u32) + i
            let m1 charset.univ_to_desc(uc, &to, &cnt, null)
            if m1 = (0 as u32)
                missing.add(uc)
            let lc (97 as u32) + i
            let m2 charset.univ_to_desc(lc, &to, &cnt, null)
            if m2 = (0 as u32)
                missing.add(lc)
            set i: i + (1 as u32)
        }
        set i: 0 as u32
        while i < (10 as u32)
        {
            let dc (48 as u32) + i
            let m3 charset.univ_to_desc(dc, &to, &cnt, null)
            if m3 = (0 as u32)
                missing.add(dc)
            set i: i + (1 as u32)
        }
        var special u32[11]
        let sp special as pointer[u32]
        set *(sp + (0 as size_t)): 39 as u32
        set *(sp + (1 as size_t)): 40 as u32
        set *(sp + (2 as size_t)): 41 as u32
        set *(sp + (3 as size_t)): 43 as u32
        set *(sp + (4 as size_t)): 44 as u32
        set *(sp + (5 as size_t)): 45 as u32
        set *(sp + (6 as size_t)): 46 as u32
        set *(sp + (7 as size_t)): 47 as u32
        set *(sp + (8 as size_t)): 58 as u32
        set *(sp + (9 as size_t)): 61 as u32
        set *(sp + (10 as size_t)): 63 as u32
        var j: size_t 0
        while j < (11 as size_t)
        {
            let sc *(sp + j)
            let m4 charset.univ_to_desc(sc, &to, &cnt, null)
            if m4 = (0 as u32)
                missing.add(sc)
            set j: j + 1
        }
    }

    ; Parser::intersectCharSets (parseSd.cxx:1899).
    function intersect_char_sets(this: Parser, s1: pointer[ISet], s2: pointer[ISet], inter: pointer[ISet])
    {
        var i: size_t 0
        let n1 s1.get_count()
        while i < n1
        {
            let a_min s1.range_min(i)
            let a_max s1.range_max(i)
            var j: size_t 0
            let n2 s2.get_count()
            while j < n2
            {
                let b_min s2.range_min(j)
                let b_max s2.range_max(j)
                var lo a_min
                if b_min > lo
                    set lo: b_min
                var hi a_max
                if b_max < hi
                    set hi: b_max
                if lo <= hi
                    inter.add_range(lo, hi)
                set j: j + 1
            }
            set i: i + 1
        }
    }

    ; ---- SD charset translation (parseSd.cxx:2505-2701) -------------------

    ; the internal charset of an Sd as a desc->univ mapping: the document
    ; charset in the default mode, the fixed system charset otherwise.
    function sd_internal_of(this: Parser, sdp: pointer[Sd], sys: pointer[UnivCharsetDesc]) returns pointer[UnivCharsetDesc]
    {
        if sdp.internal_charset_is_doc_charset()
        {
            let d sdp.doc_charset_desc()
            if d <> null
                return d
        }
        sys
    }

    ; univToDescCheck (parseSd.cxx:2844): >1 matches would warn
    ; ambiguousDocCharacter under -wsgmldecl (off); success needs a match at
    ; or below charMax.
    function univ_to_desc_check(this: Parser, charset: pointer[UnivCharsetDesc], from: u32, out_to: pointer[u32]) returns bool
    {
        var c: u32 0
        var cnt: u32 0
        let m charset.univ_to_desc(from, &c, &cnt, null)
        if (m > (0 as u32)) and (c <= CHAR_MAX)
        {
            set *out_to: c
            return true
        }
        false
    }

    function univ_to_desc_check_count(this: Parser, charset: pointer[UnivCharsetDesc], from: u32, out_to: pointer[u32], out_count: pointer[u32]) returns bool
    {
        var c: u32 0
        var cnt: u32 0
        let m charset.univ_to_desc(from, &c, &cnt, null)
        if (m > (0 as u32)) and (c <= CHAR_MAX)
        {
            set *out_to: c
            set *out_count: cnt
            return true
        }
        false
    }

    ; the translateSyntaxCharDoc/translateSyntaxCharInternal pair — selected
    ; by the CURRENT parser sd's internal-charset mode (the reference's sd()).
    function report_translate_syntax_char(this: Parser, c: u32)
    {
        let sdp ps.get_sd()
        if sdp.internal_charset_is_doc_charset()
            this.report_num_at(ParserMessages.translateSyntaxCharDoc(), c as u64, this.sd_loc())
        else
            this.report_num_at(ParserMessages.translateSyntaxCharInternal(), c as u64, this.sd_loc())
    }

    ; Parser::translateUniv (parseSd.cxx:2683).
    function translate_univ(this: Parser, univ: u32, switcher: pointer[CharSwitcher], syn_charset: pointer[UnivCharsetDesc]) returns u32
    {
        var sc: u32 0
        var cnt: u32 0
        let m syn_charset.univ_to_desc(univ, &sc, &cnt, null)
        if m <> (1 as u32)
        {
            this.report_num_at(ParserMessages.missingSyntaxChar(), univ as u64, this.sd_loc())
            return univ
        }
        let tem switcher.subst(sc)
        if tem <> sc
        {
            var univ2: u32 0
            if syn_charset.desc_to_univ(tem, &univ2)
                return univ2
            this.report_translate_syntax_char(tem)
        }
        univ
    }

    ; Parser::translateSyntaxNoSwitch (parseSd.cxx:2582).
    function translate_syntax_no_switch(this: Parser, b: pointer[SdBuilder], syntax_char: u32, out_doc: pointer[u32], out_count: pointer[u32]) returns bool
    {
        if b.sd.internal_charset_is_doc_charset()
        {
            let r b.syntax_charset_decl.find_range(syntax_char)
            if r <> null
            {
                let doc_chars ISet^host()
                var count r.count - (syntax_char - r.desc_min)
                if r.range_type = CHARSET_RANGE_STRING
                {
                    let ddecl b.sd.doc_charset_decl()
                    ddecl.string_to_char(r.str, doc_chars)
                }
                else if r.range_type = CHARSET_RANGE_NUMBER
                {
                    let n r.base_min + (syntax_char - r.desc_min)
                    var count2: u32 0
                    let sid b.syntax_charset_decl.section_pubid(r.section)
                    let sdg b.syntax_charset_decl.section_desig(r.section)
                    let ddecl b.sd.doc_charset_decl()
                    ddecl.number_to_char(sid, sdg, n, doc_chars, &count2)
                    if doc_chars.is_empty() = false
                    {
                        if count2 < count
                            set count: count2
                    }
                }
                if doc_chars.is_empty() = false
                {
                    ; >1 doc chars would warn ambiguousDocCharacter (-wsgmldecl).
                    let mn doc_chars.range_min(0 as size_t)
                    if mn <= CHAR_MAX
                    {
                        set *out_doc: mn
                        set *out_count: count
                        return true
                    }
                }
            }
        }
        var univ: u32 0
        var also_max: u32 0
        if b.syntax_charset.desc_to_univ_also_max(syntax_char, &univ, &also_max)
        {
            let internal this.sd_internal_of(b.sd, b.sys_desc)
            var doc: u32 0
            var count2: u32 0
            if this.univ_to_desc_check_count(internal, univ, &doc, &count2)
            {
                var count (also_max - syntax_char) + (1 as u32)
                if count2 < count
                    set count: count2
                set *out_doc: doc
                set *out_count: count
                return true
            }
        }
        set b.valid: false
        this.report_translate_syntax_char(syntax_char)
        false
    }

    ; Parser::translateSyntax(SdBuilder&, WideChar, Char&) (parseSd.cxx:2572).
    function translate_syntax(this: Parser, b: pointer[SdBuilder], syntax_char: u32, out_doc: pointer[u32]) returns bool
    {
        var count: u32 0
        let subst b.switcher.subst(syntax_char)
        this.translate_syntax_no_switch(b, subst, out_doc, &count)
    }

    ; Parser::translateSyntax over a syntax string (parseSd.cxx:2646).
    function translate_syntax_string(this: Parser, b: pointer[SdBuilder], s: StringC, out_str: pointer[StringC]) returns bool
    {
        let buf Array[u32]^host()
        var ret true
        var i: size_t 0
        let n s.get_size()
        while i < n
        {
            var c: u32 0
            let sc s.get(i)
            if this.translate_syntax(b, sc, &c)
                buf.add(c)
            else
                set ret: false
            set i: i + 1
        }
        set *out_str: StringC^host(buf.get_buffer(), buf.get_length())
        ret
    }

    ; Parser::translateName (parseSd.cxx:2662) — a name spelled in the
    ; CURRENT internal charset carried into the new syntax.
    function translate_name(this: Parser, b: pointer[SdBuilder], name: StringC, out_str: pointer[StringC]) returns bool
    {
        let cur_sd ps.get_sd()
        let cur_internal this.sd_internal_of(cur_sd, b.sys_desc)
        let new_internal this.sd_internal_of(b.sd, b.sys_desc)
        let buf Array[u32]^host()
        var i: size_t 0
        let n name.get_size()
        while i < n
        {
            var univ: u32 0
            let nc name.get(i)
            let got cur_internal.desc_to_univ(nc, &univ)
            let univ2 this.translate_univ(univ, b.switcher, b.syntax_charset)
            var c: u32 0
            if this.univ_to_desc_check(new_internal, univ2, &c) = false
            {
                this.report_num_at(ParserMessages.translateDocChar(), univ2 as u64, this.sd_loc())
                set b.valid: false
                set *out_str: StringC()
                return false
            }
            buf.add(c)
            set i: i + 1
        }
        set *out_str: StringC^host(buf.get_buffer(), buf.get_length())
        true
    }

    ; Parser::translateRange (parseSd.cxx:2523) — switch-aware bulk range
    ; translation.
    function translate_range(this: Parser, b: pointer[SdBuilder], start_in: u32, end: u32, chars: pointer[ISet])
    {
        var start start_in
        var running true
        while running
        {
            var done_up_to end
            var got_switch false
            var first_switch: u32 0
            var i: size_t 0
            let nsw b.switcher.n_switches()
            while i < nsw
            {
                let c b.switcher.switch_from(i)
                if (start <= c) and (c <= end)
                {
                    if got_switch = false
                    {
                        set got_switch: true
                        set first_switch: c
                    }
                    else if c < first_switch
                        set first_switch: c
                }
                set i: i + 1
            }
            if got_switch and (first_switch = start)
            {
                set done_up_to: start
                var doc_char: u32 0
                if this.translate_syntax(b, start, &doc_char)
                    chars.add(doc_char)
            }
            else
            {
                if got_switch
                    set done_up_to: first_switch - (1 as u32)
                var doc_char: u32 0
                var count: u32 0
                if this.translate_syntax_no_switch(b, start, &doc_char, &count)
                {
                    if (count - (1 as u32)) < (done_up_to - start)
                        set done_up_to: start + (count - (1 as u32))
                    chars.add_range(doc_char, doc_char + (done_up_to - start))
                }
            }
            if done_up_to = end
                set running: false
            else
                set start: done_up_to + (1 as u32)
        }
    }

    ; ---- SD syntax checks (parseSd.cxx:2703-2842) --------------------------

    function check_not_function(this: Parser, syn: pointer[Syntax], c: u32) returns bool
    {
        let fset syn.char_set(setFunctionChar)
        if fset.contains(c)
        {
            this.report_num_at(ParserMessages.oneFunction(), c as u64, this.sd_loc())
            return false
        }
        true
    }

    ; checkShortrefDelim: at most one B sequence, not adjacent to blanks.
    function check_shortref_delim(this: Parser, syn: pointer[Syntax], delim: StringC) returns bool
    {
        var had_b false
        let bset syn.char_set(setBlank)
        let n delim.get_size()
        var i: size_t 0
        while i < n
        {
            if delim.get(i) = (66 as u32)
            {
                if had_b
                {
                    this.report1_at(ParserMessages.multipleBSequence(), delim, this.sd_loc())
                    return false
                }
                set had_b: true
                if i > (0 as size_t)
                {
                    let prev delim.get(i - (1 as size_t))
                    if bset.contains(prev)
                    {
                        this.report1_at(ParserMessages.blankAdjacentBSequence(), delim, this.sd_loc())
                        return false
                    }
                }
                while ((i + (1 as size_t)) < n) and (delim.get(i + (1 as size_t)) = (66 as u32))
                    set i: i + 1
                if (i + (1 as size_t)) < n
                {
                    let nxt delim.get(i + (1 as size_t))
                    if bset.contains(nxt)
                    {
                        this.report1_at(ParserMessages.blankAdjacentBSequence(), delim, this.sd_loc())
                        return false
                    }
                }
            }
            set i: i + 1
        }
        true
    }

    function check_general_delim(this: Parser, syn: pointer[Syntax], delim: StringC) returns bool
    {
        let fset syn.char_set(setFunctionChar)
        let n delim.get_size()
        if n > (0 as size_t)
        {
            var all_function true
            var i: size_t 0
            while i < n
            {
                if fset.contains(delim.get(i)) = false
                    set all_function: false
                set i: i + 1
            }
            if all_function
            {
                this.report1_at(ParserMessages.generalDelimAllFunction(), delim, this.sd_loc())
                return false
            }
        }
        true
    }

    ; checkSwitches: neither side of a switch may be a letter or digit.
    function check_switches(this: Parser, switcher: pointer[CharSwitcher], syn_charset: pointer[UnivCharsetDesc]) returns bool
    {
        var valid true
        var i: size_t 0
        let n switcher.n_switches()
        while i < n
        {
            var j: int 0
            while j < 2
            {
                var c switcher.switch_from(i)
                if j = 1
                    set c: switcher.switch_to(i)
                var univ: u32 0
                if syn_charset.desc_to_univ(c, &univ)
                {
                    var bad false
                    if (univ >= (97 as u32)) and (univ < (123 as u32))
                        set bad: true
                    if (univ >= (65 as u32)) and (univ < (91 as u32))
                        set bad: true
                    if (univ >= (48 as u32)) and (univ < (58 as u32))
                        set bad: true
                    if bad
                    {
                        this.report_num_at(ParserMessages.switchLetterDigit(), univ as u64, this.sd_loc())
                        set valid: false
                    }
                }
                set j: j + 1
            }
            set i: i + 1
        }
        valid
    }

    function check_switches_markup(this: Parser, switcher: pointer[CharSwitcher]) returns bool
    {
        var valid true
        var i: size_t 0
        let n switcher.n_switches()
        while i < n
        {
            if switcher.switch_used(i) = false
            {
                let c switcher.switch_from(i)
                this.report_num_at(ParserMessages.switchNotMarkup(), c as u64, this.sd_loc())
                set valid: false
            }
            set i: i + 1
        }
        valid
    }

    ; checkSyntaxNames: every function name must be a valid name in the
    ; declared syntax.
    function check_syntax_names(this: Parser, syn: pointer[Syntax])
    {
        var i: size_t 0
        let n syn.n_funcs()
        while i < n
        {
            let fname syn.func_name(i)
            var k: size_t 1
            let fn fname.get_size()
            while k < fn
            {
                if syn.is_name_character(fname.get(k)) = false
                {
                    this.report1_at(ParserMessages.reservedNameSyntax(), fname, this.sd_loc())
                    set k: fn
                }
                else
                    set k: k + 1
            }
            set i: i + 1
        }
    }

    ; checkSyntaxNamelen: delimiters (general + complex shortref) longer than
    ; NAMELEN; over-long reserved names are -wsgmldecl only.
    function check_syntax_namelen(this: Parser, syn: pointer[Syntax])
    {
        let namelen syn.get_quantity(qNAMELEN)
        var i: int 0
        while i < N_DELIM_GENERAL
        {
            let dl syn.delim_general_len(i)
            if dl > (namelen as size_t)
            {
                let ds syn.delim_string(i)
                this.report_str_num_at(ParserMessages.delimiterLength(), ds, namelen as u64, this.sd_loc())
            }
            set i: i + 1
        }
        var j: size_t 0
        let nc syn.n_delim_shortref_complex()
        while j < nc
        {
            let sc syn.delim_shortref_complex(j)
            if sc.get_size() > (namelen as size_t)
                this.report_str_num_at(ParserMessages.delimiterLength(), sc, namelen as u64, this.sd_loc())
            set j: j + 1
        }
    }

    ; checkNmchars (parseSd.cxx:1857): declared naming chars must not collide
    ; with letters, digits, RE/RS/SPACE or SEPCHARs.
    function check_nmchars(this: Parser, cset: pointer[ISet], syn: pointer[Syntax]) returns bool
    {
        var valid true
        let bad ISet^host()
        this.intersect_char_sets(cset, syn.char_set(setNameStart), bad)
        if bad.is_empty() = false
        {
            let arg this.charset_message_arg(bad)
            this.report_raw_at(ParserMessages.nmcharLetter(), arg, this.sd_loc())
            set valid: false
            bad.clear()
        }
        this.intersect_char_sets(cset, syn.char_set(setDigit), bad)
        if bad.is_empty() = false
        {
            let arg2 this.charset_message_arg(bad)
            this.report_raw_at(ParserMessages.nmcharDigit(), arg2, this.sd_loc())
            set valid: false
            bad.clear()
        }
        var fc: u32 0
        if syn.get_standard_function(fRE, &fc)
        {
            if cset.contains(fc)
            {
                this.report_num_at(ParserMessages.nmcharRe(), fc as u64, this.sd_loc())
                set valid: false
            }
        }
        if syn.get_standard_function(fRS, &fc)
        {
            if cset.contains(fc)
            {
                this.report_num_at(ParserMessages.nmcharRs(), fc as u64, this.sd_loc())
                set valid: false
            }
        }
        if syn.get_standard_function(fSPACE, &fc)
        {
            if cset.contains(fc)
            {
                this.report_num_at(ParserMessages.nmcharSpace(), fc as u64, this.sd_loc())
                set valid: false
            }
        }
        this.intersect_char_sets(cset, syn.char_set(setSepchar), bad)
        if bad.is_empty() = false
        {
            let arg3 this.charset_message_arg(bad)
            this.report_raw_at(ParserMessages.nmcharSepchar(), arg3, this.sd_loc())
            set valid: false
        }
        valid
    }

    ; setRefNames (parseSd.cxx:433): enter the reference reserved-name
    ; spellings into empty slots; rDATA/rIMPLICIT are WWW-only (rALL would be
    ; gated by --errorAfdr, which the drop-in does not model).
    function set_ref_names(this: Parser, syn: pointer[Syntax], www: bool)
    {
        var i: int 0
        while i < N_SYNTAX_NAMES
        {
            var skip false
            if (i = R_DATA) or (i = R_IMPLICIT)
            {
                if www = false
                    set skip: true
            }
            if skip = false
            {
                let doc_name syn.ref_reserved_name(i)
                let existing syn.lookup_reserved_name(doc_name)
                if existing >= 0
                    this.report1_at(ParserMessages.nameReferenceReservedName(), doc_name, this.sd_loc())
                let cur syn.reserved_name(i)
                if cur.get_size() = (0 as size_t)
                    syn.set_name(i, doc_name)
            }
            set i: i + 1
        }
    }

    ; setRefDelimGeneral (parseSd.cxx:363): fill every UNSPECIFIED slot from
    ; Figure 3 column 3 (the Syntax module's DELIM_LEN/DELIM_CHARS seed),
    ; translated through the switcher; delims whose chars the internal charset
    ; lacks collect into missingSignificant646.
    function set_ref_delim_general(this: Parser, b: pointer[SdBuilder], syn: pointer[Syntax], syn_charset: pointer[UnivCharsetDesc], specified: pointer[u8]) returns bool
    {
        var valid true
        let missing ISet^host()
        let internal this.sd_internal_of(b.sd, b.sys_desc)
        var i: int 0
        while i < N_DELIM_GENERAL
        {
            var is_spec false
            if specified <> null
            {
                if (*(specified + (i as size_t))) <> (0 as u8)
                    set is_spec: true
            }
            if is_spec = false
            {
                let dp host.allocate(12 as size_t, 4) as pointer[u32]
                let want *(DELIM_LEN + (i as size_t)) as size_t
                var got: size_t 0
                var j: size_t 0
                while j < want
                {
                    let fig_char *(DELIM_CHARS + ((i as size_t) * MAX_DELIM_LEN + j))
                    let univ this.translate_univ(fig_char, b.switcher, syn_charset)
                    var c: u32 0
                    if this.univ_to_desc_check(internal, univ, &c)
                    {
                        set *(dp + got): c
                        set got: got + 1
                    }
                    else
                    {
                        missing.add(univ)
                        set valid: false
                    }
                    set j: j + 1
                }
                if got = want
                {
                    let ds StringC^host(dp, got)
                    if this.check_general_delim(syn, ds)
                        syn.set_delim_general(i, dp, got)
                    else
                        set valid: false
                }
            }
            set i: i + 1
        }
        if missing.is_empty() = false
        {
            let arg this.charset_message_arg(missing)
            this.report_raw_at(ParserMessages.missingSignificant646(), arg, this.sd_loc())
        }
        valid
    }

    ; addRefDelimShortref (parseSd.cxx:522): the 31 Figure-4 short reference
    ; delimiters ('B' = a blank sequence position).
    function add_ref_delim_shortref(this: Parser, b: pointer[SdBuilder], syn: pointer[Syntax], syn_charset: pointer[UnivCharsetDesc]) returns bool
    {
        let missing ISet^host()
        let internal this.sd_internal_of(b.sd, b.sys_desc)
        var row: int 0
        while row < 32
        {
            let dp host.allocate(12 as size_t, 4) as pointer[u32]
            let want *(SHORTREF_DELIM_LEN + (row as size_t)) as size_t
            var got: size_t 0
            var j: size_t 0
            while j < want
            {
                let fig_char *(SHORTREF_DELIM_CHARS + ((row as size_t) * (3 as size_t) + j))
                let univ this.translate_univ(fig_char, b.switcher, syn_charset)
                var c: u32 0
                if this.univ_to_desc_check(internal, univ, &c)
                {
                    set *(dp + got): c
                    set got: got + 1
                }
                else
                    missing.add(univ)
                set j: j + 1
            }
            if got = want
            {
                let ds StringC^host(dp, got)
                var dup false
                let nsw b.switcher.n_switches()
                if nsw > (0 as size_t)
                {
                    if syn.is_valid_shortref(ds)
                        set dup: true
                }
                if dup
                    this.report1_at(ParserMessages.duplicateDelimShortref(), ds, this.sd_loc())
                else
                    syn.add_delim_shortref(ds)
            }
            set row: row + 1
        }
        if missing.is_empty() = false
        {
            let arg this.charset_message_arg(missing)
            this.report_raw_at(ParserMessages.missingSignificant646(), arg, this.sd_loc())
        }
        true
    }

    ; setStandardSyntax (parseSd.cxx:273) over a bare syntax: shunned
    ; controls, standard + TAB functions, '-'/'.' name chars, namecase, the
    ; reference delimiters/names, and (refSyntax only) the Figure-4 shortrefs.
    function set_standard_syntax(this: Parser, b: pointer[SdBuilder], syn: pointer[Syntax], shortref: bool, www: bool) returns bool
    {
        let id128 UnivCharsetDesc.make_identity128(host)
        var valid true
        if this.check_switches(b.switcher, id128) = false
            set valid: false
        var si: size_t 0
        let nsw b.switcher.n_switches()
        while si < nsw
        {
            let sto b.switcher.switch_to(si)
            if sto >= (128 as u32)
                this.report_num_at(ParserMessages.switchNotInCharset(), sto as u64, this.sd_loc())
            set si: si + 1
        }
        var shc: u32 0
        while shc < (32 as u32)
        {
            syn.add_shunchar(shc)
            set shc: shc + (1 as u32)
        }
        syn.add_shunchar(127 as u32)
        syn.add_shunchar(255 as u32)
        syn.set_shunchar_controls()
        var fi: int 0
        while fi < 3
        {
            var fig: u32 13
            if fi = 1
                set fig: 10 as u32
            else if fi = 2
                set fig: 32 as u32
            var doc_char: u32 0
            if this.translate_syntax_switcher(b, fig, id128, &doc_char)
            {
                if this.check_not_function(syn, doc_char)
                    syn.set_standard_function(fi, doc_char)
                else
                    set valid: false
            }
            else
                set valid: false
            set fi: fi + 1
        }
        ; added function TAB SEPCHAR 9 (coreFunctions).
        var tab_char: u32 0
        if this.translate_syntax_switcher(b, 9 as u32, id128, &tab_char)
        {
            if this.check_not_function(syn, tab_char)
                syn.add_function_char(StringC("TAB"), cSEPCHAR, tab_char)
            else
                set valid: false
        }
        else
            set valid: false
        ; name characters '-' '.'
        let name_char_set ISet^host()
        var nci: int 0
        while nci < 2
        {
            var fig2: u32 45
            if nci = 1
                set fig2: 46 as u32
            var doc2: u32 0
            if this.translate_syntax_switcher(b, fig2, id128, &doc2)
                name_char_set.add(doc2)
            else
                set valid: false
            set nci: nci + 1
        }
        if this.check_nmchars(name_char_set, syn) = false
            set valid: false
        else
            this.apply_name_chars(syn, name_char_set)
        syn.set_namecase_general(true)
        syn.set_namecase_entity(false)
        if this.set_ref_delim_general(b, syn, id128, null) = false
            set valid: false
        this.set_ref_names(syn, www)
        syn.enter_standard_function_names()
        if shortref
        {
            if this.add_ref_delim_shortref(b, syn, id128) = false
                set valid: false
        }
        valid
    }

    ; translateSyntax(CharSwitcher&, syntaxCharset, internalCharset, ...)
    ; (parseSd.cxx:2505) — the standard-syntax flavor: switch, map through
    ; the syntax charset to univ, then into the internal charset.
    function translate_syntax_switcher(this: Parser, b: pointer[SdBuilder], syntax_char: u32, syn_charset: pointer[UnivCharsetDesc], out_doc: pointer[u32]) returns bool
    {
        let sc b.switcher.subst(syntax_char)
        var univ: u32 0
        if syn_charset.desc_to_univ(sc, &univ)
        {
            let internal this.sd_internal_of(b.sd, b.sys_desc)
            if this.univ_to_desc_check(internal, univ, out_doc)
                return true
        }
        this.report_translate_syntax_char(sc)
        false
    }

    ; apply an ISet of name characters to the syntax (nmchar set + category).
    function apply_name_chars(this: Parser, syn: pointer[Syntax], cset: pointer[ISet])
    {
        let nm syn.char_set(setNmchar)
        var i: size_t 0
        let n cset.get_count()
        while i < n
        {
            let lo cset.range_min(i)
            let hi cset.range_max(i)
            nm.add_range(lo, hi)
            syn.add_name_characters(lo, hi)
            set i: i + 1
        }
    }

    function apply_name_start_chars(this: Parser, syn: pointer[Syntax], cset: pointer[ISet])
    {
        let ns syn.char_set(setNameStart)
        var i: size_t 0
        let n cset.get_count()
        while i < n
        {
            let lo cset.range_min(i)
            let hi cset.range_max(i)
            ns.add_range(lo, hi)
            syn.add_name_start_characters(lo, hi)
            set i: i + 1
        }
    }

    ; Syntax::checkSgmlChar (Syntax.cxx:343): a shunned char that is not
    ; significant (in either syntax) yet declared an SGML char is invalid.
    function check_sgml_char(this: Parser, syn: pointer[Syntax], sdp: pointer[Sd], other: pointer[Syntax], sys: pointer[UnivCharsetDesc], invalid: pointer[ISet])
    {
        let shun syn.shunchar_set()
        let sig syn.char_set(setSignificant)
        let sgml syn.char_set(setSgmlChar)
        var i: size_t 0
        let n shun.get_count()
        while i < n
        {
            var c shun.range_min(i)
            let mx shun.range_max(i)
            var scanning true
            while scanning
            {
                ; internal != doc translation is skipped: with the identity
                ; system charset a shunned doc char IS the internal char when
                ; it is mapped at all.
                var sig_ok sig.contains(c)
                if (sig_ok = false) and (other <> null)
                {
                    let osig other.char_set(setSignificant)
                    set sig_ok: osig.contains(c)
                }
                if (sig_ok = false) and sgml.contains(c)
                    invalid.add(c)
                if c = mx
                    set scanning: false
                else
                    set c: c + (1 as u32)
            }
            set i: i + 1
        }
        if syn.shunchar_controls()
        {
            var u: u32 0
            while u < (32 as u32)
            {
                this.check_univ_control_char(u, syn, other, sdp, sys, invalid)
                set u: u + (1 as u32)
            }
            set u: 127 as u32
            while u < (160 as u32)
            {
                this.check_univ_control_char(u, syn, other, sdp, sys, invalid)
                set u: u + (1 as u32)
            }
        }
    }

    function check_univ_control_char(this: Parser, univ: u32, syn: pointer[Syntax], other: pointer[Syntax], sdp: pointer[Sd], sys: pointer[UnivCharsetDesc], invalid: pointer[ISet])
    {
        let charset this.sd_internal_of(sdp, sys)
        var c: u32 0
        if this.univ_to_desc_check(charset, univ, &c) = false
            return
        let sig syn.char_set(setSignificant)
        var sig_ok sig.contains(c)
        if (sig_ok = false) and (other <> null)
        {
            let osig other.char_set(setSignificant)
            set sig_ok: osig.contains(c)
        }
        let sgml syn.char_set(setSgmlChar)
        if (sig_ok = false) and sgml.contains(c)
            invalid.add(c)
    }

    ; ---- SD section parsers (parseSd.cxx:781-2503) --------------------------

    ; widen a byte substring of an ExternalId's public id into a StringC.
    function bytes_to_stringc(this: Parser, s: String, start: size_t, len: size_t) returns StringC
    {
        if len = (0 as size_t)
            return StringC^host(null as pointer[u32], 0 as size_t)
        let cb host.allocate(len * (4 as size_t), 4) as pointer[u32]
        var i: size_t 0
        while i < len
        {
            set *(cb + i): s.get(start + i) as u32
            set i: i + 1
        }
        StringC^host(cb, len)
    }

    ; PublicId::init over a minimum literal + the SD formal-error queueing:
    ; a non-FPI id queues its FPI decomposition error; a valid FPI whose text
    ; class differs from the section's required one queues the class message.
    function sd_classify_public(this: Parser, b: pointer[SdBuilder], parm: pointer[SdParam], tc_required: int, class_kind: int, out_id: pointer[ExternalId])
    {
        let pub_sc parm.literal_text.string()
        ; pin the byte copy on host: the classified id is read again LATER
        ; (lookupSyntax, referencePublic) — a frame-transient String buffer
        ; would be reused by then (the ExternalId.make discipline).
        let pb0 this.stringc_to_bytes(pub_sc)
        let pub_bytes String^host(pb0)
        set *out_id: ExternalId(true, pub_bytes, false, String())
        out_id.classify_public()
        if out_id.get_public_type() <> PUBLIC_FPI
        {
            let fe out_id.get_fpi_error()
            b.add_formal_error(SDFE_FPI, fe, pub_sc, this.sd_loc())
        }
        else if out_id.get_text_class() <> tc_required
            b.add_formal_error(class_kind, 0, pub_sc, this.sd_loc())
    }

    ; the ISO designating sequence of a CHARSET-class FPI (empty otherwise).
    function sd_designating_sequence(this: Parser, id: pointer[ExternalId]) returns StringC
    {
        var ds_start: size_t 0
        var ds_len: size_t 0
        if id.get_owner_type() <> OWNER_ISO
            return StringC^host(null as pointer[u32], 0 as size_t)
        if id.get_designating_sequence_bytes(&ds_start, &ds_len)
        {
            let pub id.get_public_id()
            return this.bytes_to_stringc(pub, ds_start, ds_len)
        }
        StringC^host(null as pointer[u32], 0 as size_t)
    }

    ; Parser::referencePublic (parseSd.cxx:1185): resolve the public id
    ; through the entity catalog and push the file as the current input.
    ; given_error = an open failure was already reported.
    function sd_reference_public(this: Parser, id: pointer[ExternalId], out_given: pointer[bool]) returns bool
    {
        set *out_given: false
        let cat ps.get_entity_catalog()
        if cat = null
            return false
        let pub id.get_public_id()
        let sysid cat.lookup_public(pub)
        if sysid.get_length() = (0 as size_t)
            return false
        let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org: Origin()
        let empty_base String()
        let src this.open_external_text(empty_base, sysid, org)
        if src = null
        {
            let storage Storage.OsFile(empty_base)
            let emsg storage.open_error(sysid)
            this.report_open_failure(StringC^host(sysid.to_c_string()), emsg, this.sd_loc())
            set *out_given: true
            return false
        }
        ps.push_input(src)
        true
    }

    ; Parser::sdParseSgmlDeclRef (parseSd.cxx:781) — `<!SGML name SYSTEM/PUBLIC ...>`.
    function sd_parse_sgml_decl_ref(this: Parser, b: pointer[SdBuilder], parm: pointer[SdParam], out_id: pointer[ExternalId]) returns bool
    {
        let allow1 AllowedSdParams(SDP_RESERVED_NAME + SDR_SYSTEM, SDP_RESERVED_NAME + SDR_PUBLIC, SDP_MDC)
        if this.parse_sd_param(allow1, parm) = false
            return false
        if parm.kind = SDP_MDC
            return true
        if parm.kind = (SDP_RESERVED_NAME + SDR_PUBLIC)
        {
            let allow2 AllowedSdParams(SDP_MINIMUM_LITERAL)
            if this.parse_sd_param(allow2, parm) = false
                return false
            this.sd_classify_public(b, parm, TC_SD, SDFE_TEXTCLASS_SD, out_id)
        }
        let allow3 AllowedSdParams(SDP_SYSTEM_IDENTIFIER, SDP_MDC)
        if this.parse_sd_param(allow3, parm) = false
            return false
        if parm.kind = SDP_MDC
            return true
        let sb0 this.stringc_to_bytes(parm.literal_text.string())
        let sys_bytes String^host(sb0)
        out_id.set_system(sys_bytes)
        let allow4 AllowedSdParams(SDP_MDC)
        this.parse_sd_param(allow4, parm)
    }

    ; Parser::sdParseDocumentCharset (parseSd.cxx:814).
    function sd_parse_document_charset(this: Parser, b: pointer[SdBuilder], parm: pointer[SdParam]) returns bool
    {
        let allow1 AllowedSdParams(SDP_RESERVED_NAME + SDR_CHARSET)
        if this.parse_sd_param(allow1, parm) = false
            return false
        let allow2 AllowedSdParams(SDP_RESERVED_NAME + SDR_BASESET)
        if this.parse_sd_param(allow2, parm) = false
            return false
        let decl CharsetDecl^host()
        let desc UnivCharsetDesc^host()
        if this.sd_parse_charset(b, parm, true, decl, desc) = false
            return false
        let missing ISet^host()
        this.find_missing_minimum(desc, missing)
        if missing.is_empty() = false
        {
            let arg this.charset_message_arg(missing)
            this.report_raw_at(ParserMessages.missingMinimumChars(), arg, this.sd_loc())
            return false
        }
        let sgml_char ISet^host()
        decl.used_set(sgml_char)
        b.sd.set_doc_charset_desc(desc)
        b.sd.set_doc_charset_decl(decl)
        let syn Syntax^host(*(b.sd))
        syn.reset_to_bare(*(b.sd))
        set b.syntax: syn
        let cur_sd ps.get_sd()
        if cur_sd.internal_charset_is_doc_charset()
            syn.set_sgml_char_set(sgml_char)
        else
        {
            ; translateDocSet (parseSd.cxx:849): doc charset -> internal.
            let internal_sgml ISet^host()
            this.translate_doc_set(desc, b.sys_desc, sgml_char, internal_sgml)
            syn.set_sgml_char_set(internal_sgml)
        }
        true
    }

    ; Parser::translateDocSet (parseSd.cxx:849).
    function translate_doc_set(this: Parser, from_charset: pointer[UnivCharsetDesc], to_charset: pointer[UnivCharsetDesc], from_set: pointer[ISet], to_set: pointer[ISet])
    {
        var i: size_t 0
        let n from_set.get_count()
        while i < n
        {
            var min from_set.range_min(i)
            let max from_set.range_max(i)
            var scanning true
            while scanning
            {
                var univ: u32 0
                var also_max: u32 0
                if from_charset.desc_to_univ_also_max(min, &univ, &also_max) = false
                {
                    if also_max >= max
                        set scanning: false
                    else
                        set min: also_max + (1 as u32)
                }
                else
                {
                    var internal_char: u32 0
                    var count2: u32 0
                    let n_map this.univ_to_desc_check_count(to_charset, univ, &internal_char, &count2)
                    var upto also_max
                    if upto > max
                        set upto: max
                    if (upto - min) > (count2 - (1 as u32))
                        set upto: min + (count2 - (1 as u32))
                    if n_map
                        to_set.add_range(internal_char, internal_char + (upto - min))
                    if upto >= max
                        set scanning: false
                    else
                        set min: upto + (1 as u32)
                }
            }
            set i: i + 1
        }
    }

    ; Parser::sdParseCharset (parseSd.cxx:882) — BASESET/DESCSET section list.
    function sd_parse_charset(this: Parser, b: pointer[SdBuilder], parm: pointer[SdParam], is_document: bool, decl: pointer[CharsetDecl], desc: pointer[UnivCharsetDesc]) returns bool
    {
        let multiply_declared ISet^host()
        var maybe_iso646 true
        var outer true
        while outer
        {
            let allow_lit AllowedSdParams(SDP_MINIMUM_LITERAL)
            if this.parse_sd_param(allow_lit, parm) = false
                return false
            let base_desc UnivCharsetDesc^host()
            let id host.allocate(sizeof ExternalId, alignof ExternalId) as pointer[ExternalId]
            this.sd_classify_public(b, parm, TC_CHARSET, SDFE_TEXTCLASS_BASESET, id)
            let id_sc parm.literal_text.string()
            var found false
            var given_error false
            if this.sd_reference_public(id, &given_error)
            {
                if this.sd_parse_external_charset(b, base_desc) = false
                    return false
                set found: true
            }
            else if given_error = false
            {
                if id.get_owner_type() = OWNER_ISO
                {
                    let desig this.sd_designating_sequence(id)
                    if desig.get_size() > (0 as size_t)
                    {
                        let reg CharsetRegistry.get_registration_number(host, desig)
                        if reg <> CR_UNREGISTERED
                        {
                            var iter CharsetRegistryIter()
                            if CharsetRegistry.make_iter(reg, &iter)
                            {
                                set found: true
                                var mn: u32 0
                                var mx: u32 0
                                var uv: u32 0
                                while iter.next(&mn, &mx, &uv)
                                    base_desc.add_range(mn, (mx - mn) + (1 as u32), uv, false)
                            }
                        }
                    }
                }
                if found = false
                    this.report1_at(ParserMessages.unknownBaseset(), id_sc, this.sd_loc())
            }
            if found = false
                set maybe_iso646: false
            let desig2 this.sd_designating_sequence(id)
            ; pin both onto host — the literal buffer is transient and the
            ; escape checker treats call results as frame-local.
            let id_pin StringC^host(id_sc.data_ptr(), id_sc.get_size())
            let desig_pin StringC^host(desig2.data_ptr(), desig2.get_size())
            decl.add_section(id_pin, desig_pin)
            let allow_descset AllowedSdParams(SDP_RESERVED_NAME + SDR_DESCSET)
            if this.parse_sd_param(allow_descset, parm) = false
                return false
            let allow_num AllowedSdParams(SDP_NUMBER)
            if this.parse_sd_param(allow_num, parm) = false
                return false
            var inner true
            while inner
            {
                let min parm.n
                if this.parse_sd_param(allow_num, parm) = false
                    return false
                let count parm.n
                var adj_count count
                ; zeroNumberOfCharacters is -wsgmldecl only.
                decl.range_declared(min, count, multiply_declared)
                if is_document and (count > (0 as u32))
                {
                    var over false
                    if min > CHAR_MAX
                        set over: true
                    else if (count - (1 as u32)) > (CHAR_MAX - min)
                        set over: true
                    if over
                    {
                        this.report_num_at(ParserMessages.documentCharMax(), CHAR_MAX as u64, this.sd_loc())
                        if min > CHAR_MAX
                            set adj_count: 0 as u32
                        else
                            set adj_count: (CHAR_MAX - min) + (1 as u32)
                        set maybe_iso646: false
                    }
                }
                let allow_val AllowedSdParams(SDP_NUMBER, SDP_MINIMUM_LITERAL, SDP_RESERVED_NAME + SDR_UNUSED)
                if this.parse_sd_param(allow_val, parm) = false
                    return false
                if parm.kind = SDP_NUMBER
                {
                    decl.add_range_number(min, count, parm.n)
                    if found and (adj_count > (0 as u32))
                    {
                        let base_missing ISet^host()
                        desc.add_base_desc_range(base_desc, min, adj_count, parm.n, base_missing)
                        ; basesetCharsMissing is -wsgmldecl only.
                    }
                }
                else if parm.kind = (SDP_RESERVED_NAME + SDR_UNUSED)
                    decl.add_range_unused(min, count)
                else
                {
                    let name_sc parm.literal_text.string()
                    let c b.sd.name_to_univ(name_sc)
                    var adj2 adj_count
                    if adj2 > (256 as u32)
                    {
                        this.report0_at(ParserMessages.tooManyCharsMinimumLiteral(), this.sd_loc())
                        set adj2: 256 as u32
                    }
                    if adj2 > (0 as u32)
                        desc.add_range(min, adj2, c, true)
                    set maybe_iso646: false
                    let name_pin StringC^host(name_sc.data_ptr(), name_sc.get_size())
                    decl.add_range_string(min, count, name_pin)
                }
                var follow SDP_RESERVED_NAME + SDR_CAPACITY
                if is_document = false
                    set follow: SDP_RESERVED_NAME + SDR_FUNCTION
                let allow_next AllowedSdParams(SDP_NUMBER, SDP_RESERVED_NAME + SDR_BASESET, follow)
                if this.parse_sd_param(allow_next, parm) = false
                    return false
                if parm.kind <> SDP_NUMBER
                    set inner: false
            }
            if parm.kind <> (SDP_RESERVED_NAME + SDR_BASESET)
                set outer: false
        }
        if multiply_declared.is_empty() = false
        {
            let arg this.charset_message_arg(multiply_declared)
            this.report_raw_at(ParserMessages.duplicateCharNumbers(), arg, this.sd_loc())
        }
        let declared decl.declared_set()
        let holes ISet^host()
        var hi: size_t 0
        let hn declared.get_count()
        while hi < hn
        {
            if hi > (0 as size_t)
            {
                let prev_max declared.range_max(hi - (1 as size_t))
                let cur_min declared.range_min(hi)
                if (cur_min - prev_max) > (1 as u32)
                    holes.add_range(prev_max + (1 as u32), cur_min - (1 as u32))
            }
            set hi: hi + 1
        }
        if holes.is_empty() = false
        {
            let harg this.charset_message_arg(holes)
            this.report_raw_at(ParserMessages.codeSetHoles(), harg, this.sd_loc())
        }
        if (is_document = false) and b.sd.scope_instance()
        {
            ; SCOPE INSTANCE requires the syntax reference charset to be
            ; ISO 646 (parseSd.cxx:1031) — an ordered identity walk to 128.
            var next_min: u32 0
            var ri: size_t 0
            let rn desc.range_count()
            while maybe_iso646 and (ri <= rn)
            {
                if ri = rn
                {
                    if next_min <> (128 as u32)
                        set maybe_iso646: false
                    set ri: ri + 1
                }
                else
                {
                    var dmin: u32 0
                    var dcount: u32 0
                    var duniv: u32 0
                    desc.range_at2(ri, &dmin, &dcount, &duniv)
                    if (dmin <> next_min) or (duniv <> dmin)
                        set maybe_iso646: false
                    set next_min: dmin + dcount
                    set ri: ri + 1
                }
            }
            if maybe_iso646 = false
                this.report0_at(ParserMessages.scopeInstanceSyntaxCharset(), this.sd_loc())
        }
        true
    }

    ; Parser::sdParseExternalCharset (parseSd.cxx:1054) — rows from a catalog-
    ; resolved external charset entity.
    function sd_parse_external_charset(this: Parser, b: pointer[SdBuilder], desc: pointer[UnivCharsetDesc]) returns bool
    {
        let parm2 host.allocate(sizeof SdParam, alignof SdParam) as pointer[SdParam]
        set *parm2: SdParam()
        var running true
        while running
        {
            let allow1 AllowedSdParams(SDP_NUMBER, SDP_EE)
            if this.parse_sd_param(allow1, parm2) = false
            {
                ps.pop_input_stack()
                return false
            }
            if parm2.kind = SDP_EE
                return true
            let min parm2.n
            let allow_num AllowedSdParams(SDP_NUMBER)
            if this.parse_sd_param(allow_num, parm2) = false
            {
                ps.pop_input_stack()
                return false
            }
            var count parm2.n
            let allow_val AllowedSdParams(SDP_NUMBER, SDP_MINIMUM_LITERAL, SDP_RESERVED_NAME + SDR_UNUSED)
            if this.parse_sd_param(allow_val, parm2) = false
            {
                ps.pop_input_stack()
                return false
            }
            if parm2.kind = SDP_NUMBER
            {
                if count > (0 as u32)
                    desc.add_range(min, count, parm2.n, false)
            }
            else if parm2.kind = SDP_MINIMUM_LITERAL
            {
                let name_sc parm2.literal_text.string()
                let c b.sd.name_to_univ(name_sc)
                if count > (256 as u32)
                {
                    this.report0_at(ParserMessages.tooManyCharsMinimumLiteral(), this.sd_loc())
                    set count: 256 as u32
                }
                if count > (0 as u32)
                    desc.add_range(min, count, c, true)
            }
        }
        true
    }

    ; Parser::sdParseCapacity (parseSd.cxx:1099).
    function sd_parse_capacity(this: Parser, b: pointer[SdBuilder], parm: pointer[SdParam]) returns bool
    {
        if b.www
        {
            let allow_www AllowedSdParams(SDP_RESERVED_NAME + SDR_NONE, SDP_RESERVED_NAME + SDR_PUBLIC, SDP_RESERVED_NAME + SDR_SGMLREF)
            if this.parse_sd_param(allow_www, parm) = false
                return false
        }
        else
        {
            let allow_std AllowedSdParams(SDP_RESERVED_NAME + SDR_PUBLIC, SDP_RESERVED_NAME + SDR_SGMLREF)
            if this.parse_sd_param(allow_std, parm) = false
                return false
        }
        var pushed false
        if parm.kind = (SDP_RESERVED_NAME + SDR_NONE)
        {
            let allow_scope AllowedSdParams(SDP_RESERVED_NAME + SDR_SCOPE)
            return this.parse_sd_param(allow_scope, parm)
        }
        if parm.kind = (SDP_RESERVED_NAME + SDR_PUBLIC)
        {
            let allow_lit AllowedSdParams(SDP_MINIMUM_LITERAL)
            if this.parse_sd_param(allow_lit, parm) = false
                return false
            let id host.allocate(sizeof ExternalId, alignof ExternalId) as pointer[ExternalId]
            this.sd_classify_public(b, parm, TC_CAPACITY, SDFE_TEXTCLASS_CAPACITY, id)
            let id_sc parm.literal_text.string()
            var is_ref false
            if id_sc.equals(StringC("ISO 8879-1986//CAPACITY Reference//EN"))
                set is_ref: true
            if id_sc.equals(StringC("ISO 8879:1986//CAPACITY Reference//EN"))
                set is_ref: true
            if is_ref = false
            {
                var given_error false
                if this.sd_reference_public(id, &given_error)
                    set pushed: true
                else if given_error = false
                    this.report1_at(ParserMessages.unknownCapacitySet(), id_sc, this.sd_loc())
            }
            if pushed = false
            {
                let allow_scope2 AllowedSdParams(SDP_RESERVED_NAME + SDR_SCOPE)
                return this.parse_sd_param(allow_scope2, parm)
            }
        }
        let specified host.allocate(N_CAPACITY as size_t, 1) as pointer[u8]
        var ci: int 0
        while ci < N_CAPACITY
        {
            set *(specified + (ci as size_t)): 0 as u8
            set ci: ci + 1
        }
        var final SDP_RESERVED_NAME + SDR_SCOPE
        if pushed
            set final: SDP_EE
        if b.www
        {
            let allow_first AllowedSdParams(SDP_CAPACITY_NAME, final)
            if this.parse_sd_param(allow_first, parm) = false
                return false
        }
        else
        {
            let allow_first2 AllowedSdParams(SDP_CAPACITY_NAME)
            if this.parse_sd_param(allow_first2, parm) = false
                return false
        }
        while parm.kind = SDP_CAPACITY_NAME
        {
            let cap_idx parm.idx
            let allow_num AllowedSdParams(SDP_NUMBER)
            if this.parse_sd_param(allow_num, parm) = false
                return false
            if (*(specified + (cap_idx as size_t))) = (0 as u8)
            {
                b.sd.set_capacity(cap_idx, parm.n)
                set *(specified + (cap_idx as size_t)): 1 as u8
            }
            ; duplicateCapacity is -wsgmldecl only.
            let allow_more AllowedSdParams(SDP_CAPACITY_NAME, final)
            if this.parse_sd_param(allow_more, parm) = false
                return false
        }
        let sdv b.sd
        let totalcap sdv.capacity(0)
        var k: int 1
        while k < N_CAPACITY
        {
            let cv sdv.capacity(k)
            if cv > totalcap
            {
                let cn sdv.capacity_name(k)
                this.report1_at(ParserMessages.capacityExceedsTotalcap(), cn, this.sd_loc())
            }
            set k: k + 1
        }
        if pushed
        {
            let allow_scope3 AllowedSdParams(SDP_RESERVED_NAME + SDR_SCOPE)
            return this.parse_sd_param(allow_scope3, parm)
        }
        true
    }

    ; Parser::sdParseScope (parseSd.cxx:1221).
    function sd_parse_scope(this: Parser, b: pointer[SdBuilder], parm: pointer[SdParam]) returns bool
    {
        let allow AllowedSdParams(SDP_RESERVED_NAME + SDR_INSTANCE, SDP_RESERVED_NAME + SDR_DOCUMENT)
        if this.parse_sd_param(allow, parm) = false
            return false
        if parm.kind = (SDP_RESERVED_NAME + SDR_INSTANCE)
            b.sd.set_scope_instance()
        true
    }

    ; Parser::lookupSyntax (parseSd.cxx:1348) — the two standard public
    ; syntaxes; out_shortref selects refSyntax vs coreSyntax.
    function sd_lookup_syntax(this: Parser, id: pointer[ExternalId], out_shortref: pointer[bool]) returns bool
    {
        if id.get_public_type() <> PUBLIC_FPI
            return false
        if id.get_owner_type() <> OWNER_ISO
            return false
        var o_start: size_t 0
        var o_len: size_t 0
        if id.get_owner_bytes(&o_start, &o_len) = false
            return false
        let pub id.get_public_id()
        let owner this.bytes_to_stringc(pub, o_start, o_len)
        var owner_ok false
        if owner.equals(StringC("ISO 8879:1986"))
            set owner_ok: true
        if owner.equals(StringC("ISO 8879-1986"))
            set owner_ok: true
        if owner_ok = false
            return false
        if id.get_text_class() <> TC_SYNTAX
            return false
        var d_start: size_t 0
        var d_len: size_t 0
        if id.get_description_bytes(&d_start, &d_len) = false
            return false
        let descr this.bytes_to_stringc(pub, d_start, d_len)
        if descr.equals(StringC("Reference"))
        {
            set *out_shortref: true
            return true
        }
        if descr.equals(StringC("Core"))
        {
            set *out_shortref: false
            return true
        }
        false
    }

    ; Parser::sdParseSyntax (parseSd.cxx:1232).
    function sd_parse_syntax(this: Parser, b: pointer[SdBuilder], parm: pointer[SdParam]) returns bool
    {
        let allow1 AllowedSdParams(SDP_RESERVED_NAME + SDR_SYNTAX)
        if this.parse_sd_param(allow1, parm) = false
            return false
        let allow2 AllowedSdParams(SDP_RESERVED_NAME + SDR_SHUNCHAR, SDP_RESERVED_NAME + SDR_PUBLIC)
        if this.parse_sd_param(allow2, parm) = false
            return false
        if parm.kind = (SDP_RESERVED_NAME + SDR_PUBLIC)
        {
            let allow_lit AllowedSdParams(SDP_MINIMUM_LITERAL)
            if this.parse_sd_param(allow_lit, parm) = false
                return false
            let id host.allocate(sizeof ExternalId, alignof ExternalId) as pointer[ExternalId]
            this.sd_classify_public(b, parm, TC_SYNTAX, SDFE_TEXTCLASS_SYNTAX, id)
            let id_sc parm.literal_text.string()
            let allow3 AllowedSdParams(SDP_RESERVED_NAME + SDR_FEATURES, SDP_RESERVED_NAME + SDR_SWITCHES)
            if this.parse_sd_param(allow3, parm) = false
                return false
            if parm.kind = (SDP_RESERVED_NAME + SDR_SWITCHES)
            {
                let allow_num AllowedSdParams(SDP_NUMBER)
                if this.parse_sd_param(allow_num, parm) = false
                    return false
                var switching true
                while switching
                {
                    let c parm.n
                    if this.parse_sd_param(allow_num, parm) = false
                        return false
                    b.switcher.add_switch(c, parm.n)
                    let allow_more AllowedSdParams(SDP_NUMBER, SDP_RESERVED_NAME + SDR_FEATURES)
                    if this.parse_sd_param(allow_more, parm) = false
                        return false
                    if parm.kind <> SDP_NUMBER
                        set switching: false
                }
            }
            var spec_shortref false
            if this.sd_lookup_syntax(id, &spec_shortref)
            {
                if this.set_standard_syntax(b, b.syntax, spec_shortref, b.www) = false
                    set b.valid: false
            }
            else
            {
                var given_error false
                if this.sd_reference_public(id, &given_error)
                {
                    set b.external_syntax: true
                    let parm2 host.allocate(sizeof SdParam, alignof SdParam) as pointer[SdParam]
                    set *parm2: SdParam()
                    let allow_shun AllowedSdParams(SDP_RESERVED_NAME + SDR_SHUNCHAR)
                    if this.parse_sd_param(allow_shun, parm2) = false
                        return false
                    if this.sd_parse_explicit_syntax(b, parm2) = false
                        return false
                }
                else
                {
                    if given_error = false
                        this.report1_at(ParserMessages.unknownPublicSyntax(), id_sc, this.sd_loc())
                    set b.valid: false
                }
            }
        }
        else
        {
            if this.sd_parse_explicit_syntax(b, parm) = false
                return false
        }
        if b.sd.scope_instance() = false
        {
            let invalid ISet^host()
            this.check_sgml_char(b.syntax, b.sd, null, b.sys_desc, invalid)
            if invalid.is_empty() = false
            {
                let arg this.charset_message_arg(invalid)
                this.report_raw_at(ParserMessages.invalidSgmlChar(), arg, this.sd_loc())
            }
        }
        this.check_syntax_names(b.syntax)
        this.check_syntax_namelen(b.syntax)
        this.check_switches_markup(b.switcher)
        true
    }

    ; Parser::sdParseExplicitSyntax (parseSd.cxx:1329).
    function sd_parse_explicit_syntax(this: Parser, b: pointer[SdBuilder], parm: pointer[SdParam]) returns bool
    {
        if this.sd_parse_shunchar(b, parm) = false
            return false
        if this.sd_parse_syntax_charset(b, parm) = false
            return false
        if this.sd_parse_function(b, parm) = false
            return false
        if this.sd_parse_naming(b, parm) = false
            return false
        if this.sd_parse_delim(b, parm) = false
            return false
        if this.sd_parse_names(b, parm) = false
            return false
        if this.sd_parse_quantity(b, parm) = false
            return false
        true
    }

    ; Parser::sdParseSyntaxCharset (parseSd.cxx:1371).
    function sd_parse_syntax_charset(this: Parser, b: pointer[SdBuilder], parm: pointer[SdParam]) returns bool
    {
        if this.sd_parse_charset(b, parm, false, b.syntax_charset_decl, b.syntax_charset) = false
            return false
        this.check_switches(b.switcher, b.syntax_charset)
        var i: size_t 0
        let n b.switcher.n_switches()
        while i < n
        {
            let sto b.switcher.switch_to(i)
            if b.syntax_charset_decl.char_declared(sto) = false
                this.report_num_at(ParserMessages.switchNotInCharset(), sto as u64, this.sd_loc())
            set i: i + 1
        }
        let missing ISet^host()
        this.find_missing_minimum(b.syntax_charset, missing)
        if missing.is_empty() = false
        {
            let arg this.charset_message_arg(missing)
            this.report_raw_at(ParserMessages.missingMinimumChars(), arg, this.sd_loc())
        }
        true
    }

    ; Parser::sdParseShunchar (parseSd.cxx:1390).
    function sd_parse_shunchar(this: Parser, b: pointer[SdBuilder], parm: pointer[SdParam]) returns bool
    {
        let allow1 AllowedSdParams(SDP_RESERVED_NAME + SDR_NONE, SDP_RESERVED_NAME + SDR_CONTROLS, SDP_NUMBER)
        if this.parse_sd_param(allow1, parm) = false
            return false
        if parm.kind = (SDP_RESERVED_NAME + SDR_NONE)
        {
            let allow_bs AllowedSdParams(SDP_RESERVED_NAME + SDR_BASESET)
            return this.parse_sd_param(allow_bs, parm)
        }
        if parm.kind = (SDP_RESERVED_NAME + SDR_CONTROLS)
            b.syntax.set_shunchar_controls()
        else
        {
            if parm.n <= CHAR_MAX
                b.syntax.add_shunchar(parm.n)
        }
        var running true
        while running
        {
            let allow_more AllowedSdParams(SDP_RESERVED_NAME + SDR_BASESET, SDP_NUMBER)
            if this.parse_sd_param(allow_more, parm) = false
                return false
            if parm.kind <> SDP_NUMBER
                set running: false
            else
            {
                if parm.n <= CHAR_MAX
                    b.syntax.add_shunchar(parm.n)
            }
        }
        true
    }

    ; Parser::sdParseFunction (parseSd.cxx:1420).
    function sd_parse_function(this: Parser, b: pointer[SdBuilder], parm: pointer[SdParam]) returns bool
    {
        var fi: int 0
        while fi < 3
        {
            var std_name SDR_RE
            if fi = 1
                set std_name: SDR_RS
            else if fi = 2
                set std_name: SDR_SPACE
            let allow_std AllowedSdParams(SDP_RESERVED_NAME + std_name)
            if this.parse_sd_param(allow_std, parm) = false
                return false
            let allow_num AllowedSdParams(SDP_NUMBER)
            if this.parse_sd_param(allow_num, parm) = false
                return false
            var c: u32 0
            if this.translate_syntax(b, parm.n, &c)
            {
                if this.check_not_function(b.syntax, c)
                    b.syntax.set_standard_function(fi, c)
                else
                    set b.valid: false
            }
            set fi: fi + 1
        }
        var have_msichar false
        var have_msochar false
        var running true
        while running
        {
            if b.external_syntax
            {
                let allow_name AllowedSdParams(SDP_NAME, SDP_PARAM_LITERAL)
                if this.parse_sd_param(allow_name, parm) = false
                    return false
            }
            else
            {
                let allow_name2 AllowedSdParams(SDP_NAME)
                if this.parse_sd_param(allow_name2, parm) = false
                    return false
            }
            var name_was_literal false
            var invalid_name false
            var name StringC()
            if parm.kind = SDP_PARAM_LITERAL
            {
                set name_was_literal: true
                if this.translate_syntax_string(b, parm.param_literal, &name) = false
                    set invalid_name: true
            }
            else
            {
                ; NB a plain struct assignment from the pointer field
                ; mis-copied here (size garbage) — copy via the accessors.
                let tdp parm.token.data_ptr()
                let tdn parm.token.get_size()
                set name: StringC^host(tdp, tdn)
            }
            if name_was_literal
            {
                let allow_cls AllowedSdParams(SDP_RESERVED_NAME + SDR_FUNCHAR, SDP_RESERVED_NAME + SDR_MSICHAR, SDP_RESERVED_NAME + SDR_MSOCHAR, SDP_RESERVED_NAME + SDR_MSSCHAR, SDP_RESERVED_NAME + SDR_SEPCHAR)
                if this.parse_sd_param(allow_cls, parm) = false
                    return false
            }
            else
            {
                let allow_cls2 AllowedSdParams(SDP_RESERVED_NAME + SDR_FUNCHAR, SDP_RESERVED_NAME + SDR_MSICHAR, SDP_RESERVED_NAME + SDR_MSOCHAR, SDP_RESERVED_NAME + SDR_MSSCHAR, SDP_RESERVED_NAME + SDR_SEPCHAR, SDP_RESERVED_NAME + SDR_LCNMSTRT)
                if this.parse_sd_param(allow_cls2, parm) = false
                    return false
            }
            if parm.kind = (SDP_RESERVED_NAME + SDR_LCNMSTRT)
            {
                let sdv ps.get_sd()
                let naming_spell sdv.sd_reserved_name(SDR_NAMING)
                if name.equals(naming_spell) = false
                    this.report1_at(ParserMessages.namingBeforeLcnmstrt(), name, this.sd_loc())
                set running: false
            }
            else
            {
                if name_was_literal = false
                {
                    var trans StringC()
                    if this.translate_name(b, name, &trans) = false
                        set invalid_name: true
                    else
                        set name: trans
                }
                var fcls cFUNCHAR
                if parm.kind = (SDP_RESERVED_NAME + SDR_MSICHAR)
                {
                    set have_msichar: true
                    set fcls: cMSICHAR
                }
                else if parm.kind = (SDP_RESERVED_NAME + SDR_MSOCHAR)
                {
                    set have_msochar: true
                    set fcls: cMSOCHAR
                }
                else if parm.kind = (SDP_RESERVED_NAME + SDR_MSSCHAR)
                    set fcls: cMSSCHAR
                else if parm.kind = (SDP_RESERVED_NAME + SDR_SEPCHAR)
                    set fcls: cSEPCHAR
                let allow_num2 AllowedSdParams(SDP_NUMBER)
                if this.parse_sd_param(allow_num2, parm) = false
                    return false
                var c2: u32 0
                var ok this.translate_syntax(b, parm.n, &c2)
                if ok
                    set ok: this.check_not_function(b.syntax, c2)
                if ok and (invalid_name = false)
                {
                    var tem: u32 0
                    if b.syntax.lookup_declared_function_char(name, &tem)
                        this.report1_at(ParserMessages.duplicateFunctionName(), name, this.sd_loc())
                    else
                        b.syntax.add_function_char(name, fcls, c2)
                }
            }
        }
        if have_msochar and (have_msichar = false)
            this.report0_at(ParserMessages.msocharRequiresMsichar(), this.sd_loc())
        true
    }

    ; Parser::sdParamConvertToLiteral (parseSd.cxx:3259).
    function sd_param_convert_to_literal(this: Parser, parm: pointer[SdParam])
    {
        if parm.kind = SDP_NUMBER
        {
            set parm.kind: SDP_PARAM_LITERAL
            let cb host.allocate(4 as size_t, 4) as pointer[u32]
            set *cb: parm.n
            set parm.param_literal: StringC^host(cb, 1 as size_t)
        }
    }

    ; Parser::requireWWW (parseSd.cxx:3268).
    function sd_require_www(this: Parser, b: pointer[SdBuilder])
    {
        if b.www = false
        {
            this.report0_at(ParserMessages.wwwRequired(), this.sd_loc())
            set b.www: true
        }
    }

    ; Parser::sdParseNaming (parseSd.cxx:1531) — LCNMSTRT/UCNMSTRT (+WWW
    ; NAMESTRT) then LCNMCHAR/UCNMCHAR (+NAMECHAR), with the LC/UC pairing and
    ; range machinery, terminated by NAMECASE GENERAL/ENTITY.
    function sd_parse_naming(this: Parser, b: pointer[SdBuilder], parm: pointer[SdParam]) returns bool
    {
        let name_start_char ISet^host()
        let name_char ISet^host()
        var is_namechar: int 0
        var iterating true
        while iterating
        {
            ; keys[isNamechar*3 + k]: 0 -> UCNMSTRT/UCNMCHAR, 1 -> NAMESTRT/
            ; NAMECHAR, 2 -> LCNMCHAR/NAMECASE.
            var key0 SDR_UCNMSTRT
            var key1 SDR_NAMESTRT
            var key2 SDR_LCNMCHAR
            if is_namechar = 1
            {
                set key0: SDR_UCNMCHAR
                set key1: SDR_NAMECHAR
                set key2: SDR_NAMECASE
            }
            let lc Array[u32]^host()
            let range_index Array[u32]^host()
            ; --- LC side ---
            var prev_param: int 0
            var lc_running true
            while lc_running
            {
                if prev_param = 0
                {
                    let allow_a AllowedSdParams(SDP_PARAM_LITERAL, SDP_NUMBER)
                    if this.parse_sd_param(allow_a, parm) = false
                        return false
                }
                else if prev_param = 1
                {
                    let allow_b AllowedSdParams(SDP_RESERVED_NAME + key0, SDP_PARAM_LITERAL, SDP_NUMBER, SDP_MINUS)
                    if this.parse_sd_param(allow_b, parm) = false
                        return false
                }
                else
                {
                    let allow_c AllowedSdParams(SDP_RESERVED_NAME + key0, SDP_PARAM_LITERAL, SDP_NUMBER)
                    if this.parse_sd_param(allow_c, parm) = false
                        return false
                }
                ; numbers (and non-leading literals) are ENR extensions.
                var enr_hit false
                if parm.kind = SDP_NUMBER
                    set enr_hit: true
                else if (parm.kind = SDP_PARAM_LITERAL) and (prev_param <> 0)
                    set enr_hit: true
                if enr_hit and (b.external_syntax = false) and (b.enr = false)
                {
                    this.report0_at(ParserMessages.enrRequired(), this.sd_loc())
                    set b.enr: true
                }
                if parm.kind = SDP_NUMBER
                    set prev_param: 1
                else
                    set prev_param: 2
                if parm.kind = SDP_MINUS
                {
                    let allow_num AllowedSdParams(SDP_NUMBER)
                    if this.parse_sd_param(allow_num, parm) = false
                        return false
                    let lc_len lc.get_length()
                    let last *(lc.get_buffer() + lc_len - (1 as size_t))
                    if parm.n < last
                        this.report0_at(ParserMessages.sdInvalidRange(), this.sd_loc())
                    else
                    {
                        if parm.n > (last + (1 as u32))
                            range_index.add((lc_len - (1 as size_t)) as u32)
                        lc.add(parm.n)
                    }
                }
                else
                {
                    this.sd_param_convert_to_literal(parm)
                    if parm.kind <> SDP_PARAM_LITERAL
                        set lc_running: false
                    else
                    {
                        var pi: size_t 0
                        let pn parm.param_literal.get_size()
                        while pi < pn
                        {
                            lc.add(parm.param_literal.get(pi))
                            set pi: pi + 1
                        }
                    }
                }
            }
            ; --- UC side ---
            var lc_pos: size_t 0
            var range_index_pos: size_t 0
            var range_left: u32 0
            var next_range_char: u32 0
            ; explicit pointer type: an untyped var here COPIES the ISet
            ; value (the parm.token footgun class) and the adds vanish.
            var target: pointer[ISet] name_start_char
            if is_namechar = 1
                set target: name_char
            var chars Array[u32]^host()
            var run_out false
            set prev_param: 0
            var uc_running true
            while uc_running
            {
                if prev_param = 0
                {
                    let allow_d AllowedSdParams(SDP_PARAM_LITERAL, SDP_NUMBER)
                    if this.parse_sd_param(allow_d, parm) = false
                        return false
                }
                else if prev_param = 1
                {
                    let allow_e AllowedSdParams(SDP_RESERVED_NAME + key1, SDP_RESERVED_NAME + key2, SDP_PARAM_LITERAL, SDP_NUMBER, SDP_MINUS)
                    if this.parse_sd_param(allow_e, parm) = false
                        return false
                }
                else
                {
                    let allow_f AllowedSdParams(SDP_RESERVED_NAME + key1, SDP_RESERVED_NAME + key2, SDP_PARAM_LITERAL, SDP_NUMBER)
                    if this.parse_sd_param(allow_f, parm) = false
                        return false
                }
                var enr_hit2 false
                if parm.kind = SDP_NUMBER
                    set enr_hit2: true
                else if (parm.kind = SDP_PARAM_LITERAL) and (prev_param <> 0)
                    set enr_hit2: true
                if enr_hit2 and (b.external_syntax = false) and (b.enr = false)
                {
                    this.report0_at(ParserMessages.enrRequired(), this.sd_loc())
                    set b.enr: true
                }
                if parm.kind = SDP_NUMBER
                    set prev_param: 1
                else
                    set prev_param: 2
                if parm.kind = SDP_MINUS
                {
                    let allow_num2 AllowedSdParams(SDP_NUMBER)
                    if this.parse_sd_param(allow_num2, parm) = false
                        return false
                    let start0 *(chars.get_buffer() + (0 as size_t))
                    var start start0
                    let end parm.n
                    if start > end
                        this.report0_at(ParserMessages.sdInvalidRange(), this.sd_loc())
                    else
                    {
                        var count (end + (1 as u32)) - start
                        while count > (0 as u32)
                        {
                            if range_left = (0 as u32)
                            {
                                if range_index_pos < range_index.get_length()
                                {
                                    let ri_val *(range_index.get_buffer() + range_index_pos)
                                    if (ri_val as size_t) = lc_pos
                                    {
                                        let lo *(lc.get_buffer() + lc_pos)
                                        let hi *(lc.get_buffer() + lc_pos + (1 as size_t))
                                        set range_left: (hi - lo) + (1 as u32)
                                        set next_range_char: lo
                                        set lc_pos: lc_pos + (2 as size_t)
                                        set range_index_pos: range_index_pos + (1 as size_t)
                                    }
                                }
                            }
                            var c: u32 0
                            if range_left > (0 as u32)
                            {
                                set range_left: range_left - (1 as u32)
                                set c: next_range_char
                                set next_range_char: next_range_char + (1 as u32)
                            }
                            else if lc_pos < lc.get_length()
                            {
                                set c: *(lc.get_buffer() + lc_pos)
                                set lc_pos: lc_pos + (1 as size_t)
                            }
                            else
                            {
                                set c: start
                                set run_out: true
                            }
                            var bulk false
                            if (c = start) and (count > (1 as u32))
                            {
                                if run_out or (range_left > (0 as u32))
                                    set bulk: true
                            }
                            if bulk
                            {
                                var n: u32 0
                                if run_out
                                    set n: count
                                else if range_left < count
                                {
                                    set n: range_left + (1 as u32)
                                    set range_left: 0 as u32
                                }
                                else
                                {
                                    set n: count
                                    set range_left: range_left - (n - (1 as u32))
                                    set next_range_char: next_range_char + (n - (1 as u32))
                                }
                                this.translate_range(b, start, start + (n - (1 as u32)), target)
                                set count: count - n
                                set start: start + n
                            }
                            else
                            {
                                var trans_lc: u32 0
                                var trans_uc: u32 0
                                var ok1 this.translate_syntax(b, c, &trans_lc)
                                if ok1
                                {
                                    if this.translate_syntax(b, start, &trans_uc)
                                    {
                                        target.add(trans_lc)
                                        if trans_lc <> trans_uc
                                        {
                                            target.add(trans_uc)
                                            b.syntax.add_subst(trans_lc, trans_uc)
                                        }
                                    }
                                }
                                set count: count - (1 as u32)
                                set start: start + (1 as u32)
                            }
                        }
                    }
                    set chars: Array[u32]^host()
                }
                else
                {
                    var ci: size_t 0
                    let cn chars.get_length()
                    while ci < cn
                    {
                        if range_left = (0 as u32)
                        {
                            if range_index_pos < range_index.get_length()
                            {
                                let ri_val2 *(range_index.get_buffer() + range_index_pos)
                                if (ri_val2 as size_t) = lc_pos
                                {
                                    let lo2 *(lc.get_buffer() + lc_pos)
                                    let hi2 *(lc.get_buffer() + lc_pos + (1 as size_t))
                                    set range_left: (hi2 - lo2) + (1 as u32)
                                    set next_range_char: lo2
                                    set lc_pos: lc_pos + (2 as size_t)
                                    set range_index_pos: range_index_pos + (1 as size_t)
                                }
                            }
                        }
                        var c2: u32 0
                        if range_left > (0 as u32)
                        {
                            set range_left: range_left - (1 as u32)
                            set c2: next_range_char
                            set next_range_char: next_range_char + (1 as u32)
                        }
                        else if lc_pos < lc.get_length()
                        {
                            set c2: *(lc.get_buffer() + lc_pos)
                            set lc_pos: lc_pos + (1 as size_t)
                        }
                        else
                        {
                            set run_out: true
                            set c2: *(chars.get_buffer() + ci)
                        }
                        var trans_lc2: u32 0
                        var trans_uc2: u32 0
                        var ok2 this.translate_syntax(b, c2, &trans_lc2)
                        if ok2
                        {
                            let uc_char *(chars.get_buffer() + ci)
                            if this.translate_syntax(b, uc_char, &trans_uc2)
                            {
                                target.add(trans_lc2)
                                if trans_lc2 <> trans_uc2
                                {
                                    target.add(trans_uc2)
                                    b.syntax.add_subst(trans_lc2, trans_uc2)
                                }
                            }
                        }
                        set ci: ci + 1
                    }
                    this.sd_param_convert_to_literal(parm)
                    if parm.kind <> SDP_PARAM_LITERAL
                        set uc_running: false
                    else
                    {
                        set chars: Array[u32]^host()
                        var pi2: size_t 0
                        let pn2 parm.param_literal.get_size()
                        while pi2 < pn2
                        {
                            chars.add(parm.param_literal.get(pi2))
                            set pi2: pi2 + 1
                        }
                    }
                }
            }
            var length_err false
            if run_out and (b.external_syntax = false)
                set length_err: true
            if range_left > (0 as u32)
                set length_err: true
            if lc_pos < lc.get_length()
                set length_err: true
            if length_err
            {
                if is_namechar = 1
                    this.report0_at(ParserMessages.nmcharLength(), this.sd_loc())
                else
                    this.report0_at(ParserMessages.nmstrtLength(), this.sd_loc())
            }
            ; the WWW NAMESTRT/NAMECHAR extension list.
            if parm.kind = (SDP_RESERVED_NAME + key1)
            {
                if (b.external_syntax = false) and (b.enr = false)
                {
                    this.report0_at(ParserMessages.enrRequired(), this.sd_loc())
                    set b.enr: true
                }
                set prev_param: 0
                var ext_running true
                while ext_running
                {
                    if prev_param = 0
                    {
                        let allow_g AllowedSdParams(SDP_PARAM_LITERAL, SDP_NUMBER)
                        if this.parse_sd_param(allow_g, parm) = false
                            return false
                    }
                    else if prev_param = 1
                    {
                        let allow_h AllowedSdParams(SDP_RESERVED_NAME + key2, SDP_PARAM_LITERAL, SDP_NUMBER, SDP_MINUS)
                        if this.parse_sd_param(allow_h, parm) = false
                            return false
                    }
                    else
                    {
                        let allow_i AllowedSdParams(SDP_RESERVED_NAME + key2, SDP_PARAM_LITERAL, SDP_NUMBER)
                        if this.parse_sd_param(allow_i, parm) = false
                            return false
                    }
                    let was_number parm.kind = SDP_NUMBER
                    if parm.kind = SDP_MINUS
                    {
                        let prev_number parm.n
                        let allow_num3 AllowedSdParams(SDP_NUMBER)
                        if this.parse_sd_param(allow_num3, parm) = false
                            return false
                        if parm.n < prev_number
                            this.report0_at(ParserMessages.sdInvalidRange(), this.sd_loc())
                        else if parm.n > prev_number
                            this.translate_range(b, prev_number + (1 as u32), parm.n, target)
                    }
                    else
                    {
                        this.sd_param_convert_to_literal(parm)
                        if parm.kind <> SDP_PARAM_LITERAL
                            set ext_running: false
                        else
                        {
                            var pi3: size_t 0
                            let pn3 parm.param_literal.get_size()
                            while pi3 < pn3
                            {
                                var trans3: u32 0
                                let plc parm.param_literal.get(pi3)
                                if this.translate_syntax(b, plc, &trans3)
                                    target.add(trans3)
                                set pi3: pi3 + 1
                            }
                            if was_number
                                set prev_param: 1
                            else
                                set prev_param: 2
                        }
                    }
                }
            }
            if this.check_nmchars(target, b.syntax) = false
                set b.valid: false
            if is_namechar = 1
                set iterating: false
            set is_namechar: is_namechar + 1
        }
        let bad ISet^host()
        this.intersect_char_sets(name_start_char, name_char, bad)
        if bad.is_empty() = false
        {
            set b.valid: false
            let arg this.charset_message_arg(bad)
            this.report_raw_at(ParserMessages.nmcharNmstrt(), arg, this.sd_loc())
        }
        this.apply_name_start_chars(b.syntax, name_start_char)
        this.apply_name_chars(b.syntax, name_char)
        let allow_gen AllowedSdParams(SDP_RESERVED_NAME + SDR_GENERAL)
        if this.parse_sd_param(allow_gen, parm) = false
            return false
        let allow_yn AllowedSdParams(SDP_RESERVED_NAME + SDR_NO, SDP_RESERVED_NAME + SDR_YES)
        if this.parse_sd_param(allow_yn, parm) = false
            return false
        b.syntax.set_namecase_general(parm.kind = (SDP_RESERVED_NAME + SDR_YES))
        let allow_ent AllowedSdParams(SDP_RESERVED_NAME + SDR_ENTITY)
        if this.parse_sd_param(allow_ent, parm) = false
            return false
        if this.parse_sd_param(allow_yn, parm) = false
            return false
        b.syntax.set_namecase_entity(parm.kind = (SDP_RESERVED_NAME + SDR_YES))
        true
    }

    ; fold a string through the builder syntax's general substitution table.
    function sd_general_subst(this: Parser, b: pointer[SdBuilder], s: StringC) returns StringC
    {
        let n s.get_size()
        if n = (0 as size_t)
            return StringC^host(null as pointer[u32], 0 as size_t)
        let cb host.allocate(n * (4 as size_t), 4) as pointer[u32]
        var i: size_t 0
        while i < n
        {
            set *(cb + i): b.syntax.fold(s.get(i))
            set i: i + 1
        }
        StringC^host(cb, n)
    }

    ; Parser::sdParseDelim (parseSd.cxx:1936).
    function sd_parse_delim(this: Parser, b: pointer[SdBuilder], parm: pointer[SdParam]) returns bool
    {
        let allow_delim AllowedSdParams(SDP_RESERVED_NAME + SDR_DELIM)
        if this.parse_sd_param(allow_delim, parm) = false
            return false
        let allow_general AllowedSdParams(SDP_RESERVED_NAME + SDR_GENERAL)
        if this.parse_sd_param(allow_general, parm) = false
            return false
        let allow_sgmlref AllowedSdParams(SDP_RESERVED_NAME + SDR_SGMLREF)
        if this.parse_sd_param(allow_sgmlref, parm) = false
            return false
        let specified host.allocate(N_DELIM_GENERAL as size_t, 1) as pointer[u8]
        var di: int 0
        while di < N_DELIM_GENERAL
        {
            set *(specified + (di as size_t)): 0 as u8
            set di: di + 1
        }
        var general_running true
        while general_running
        {
            let allow_role AllowedSdParams(SDP_GENERAL_DELIMITER_NAME, SDP_RESERVED_NAME + SDR_SHORTREF)
            if this.parse_sd_param(allow_role, parm) = false
                return false
            if parm.kind = (SDP_RESERVED_NAME + SDR_SHORTREF)
                set general_running: false
            else
            {
                let dg parm.idx
                if (*(specified + (dg as size_t))) <> (0 as u8)
                {
                    let sdv ps.get_sd()
                    let dn sdv.general_delimiter_name(dg)
                    this.report1_at(ParserMessages.duplicateDelimGeneral(), dn, this.sd_loc())
                }
                if (dg = dHCRO) or (dg = dNESTC)
                    this.sd_require_www(b)
                if b.external_syntax
                {
                    let allow_val AllowedSdParams(SDP_PARAM_LITERAL, SDP_NUMBER)
                    if this.parse_sd_param(allow_val, parm) = false
                        return false
                }
                else
                {
                    let allow_val2 AllowedSdParams(SDP_PARAM_LITERAL)
                    if this.parse_sd_param(allow_val2, parm) = false
                        return false
                }
                this.sd_param_convert_to_literal(parm)
                if parm.param_literal.get_size() = (0 as size_t)
                    this.report0_at(ParserMessages.sdEmptyDelimiter(), this.sd_loc())
                else
                {
                    var str StringC()
                    if this.translate_syntax_string(b, parm.param_literal, &str)
                    {
                        let folded this.sd_general_subst(b, str)
                        var ok this.check_general_delim(b.syntax, folded)
                        if ok
                        {
                            if (*(specified + (dg as size_t))) = (0 as u8)
                            {
                                let fdp folded.data_ptr()
                                let fdn folded.get_size()
                                b.syntax.set_delim_general(dg, fdp, fdn)
                            }
                            else
                            {
                                ; a re-specified role invalidates the declaration
                                ; (parseSd.cxx:1981's && arm).
                                set b.valid: false
                            }
                        }
                        else
                            set b.valid: false
                    }
                }
                set *(specified + (dg as size_t)): 1 as u8
            }
        }
        ; NET declared without NESTC: NESTC defaults to NET (parseSd.cxx:1989).
        if (b.syntax.delim_general_len(dNET) > (0 as size_t)) and (b.syntax.delim_general_len(dNESTC) = (0 as size_t))
        {
            ; specified[] gates the reference fill below; NET's chars stand in.
            let net_len b.syntax.delim_general_len(dNET)
            let net_buf host.allocate(net_len * (4 as size_t), 4) as pointer[u32]
            var ni: size_t 0
            while ni < net_len
            {
                set *(net_buf + ni): b.syntax.delim_general_char(dNET, ni)
                set ni: ni + 1
            }
            b.syntax.set_delim_general(dNESTC, net_buf, net_len)
            set *(specified + (dNESTC as size_t)): 1 as u8
        }
        ; HCRO stays empty unless declared: mark every still-empty slot whose
        ; Figure-3 row is empty as specified so the fill skips it faithfully.
        if this.set_ref_delim_general(b, b.syntax, b.syntax_charset, specified) = false
            set b.valid: false
        let allow_sr AllowedSdParams(SDP_RESERVED_NAME + SDR_SGMLREF, SDP_RESERVED_NAME + SDR_NONE)
        if this.parse_sd_param(allow_sr, parm) = false
            return false
        if parm.kind = (SDP_RESERVED_NAME + SDR_SGMLREF)
        {
            if this.add_ref_delim_shortref(b, b.syntax, b.syntax_charset) = false
                set b.valid: false
        }
        var last_literal StringC()
        var have_last false
        var sr_running true
        while sr_running
        {
            if b.external_syntax
            {
                let allow_sr2 AllowedSdParams(SDP_PARAM_LITERAL, SDP_NUMBER, SDP_MINUS, SDP_RESERVED_NAME + SDR_NAMES)
                if this.parse_sd_param(allow_sr2, parm) = false
                    return false
            }
            else
            {
                let allow_sr3 AllowedSdParams(SDP_PARAM_LITERAL, SDP_RESERVED_NAME + SDR_NAMES)
                if this.parse_sd_param(allow_sr3, parm) = false
                    return false
            }
            this.sd_param_convert_to_literal(parm)
            if parm.kind = SDP_MINUS
            {
                let allow_hi AllowedSdParams(SDP_PARAM_LITERAL, SDP_NUMBER)
                if this.parse_sd_param(allow_hi, parm) = false
                    return false
                this.sd_param_convert_to_literal(parm)
                if parm.param_literal.get_size() = (0 as size_t)
                    this.report0_at(ParserMessages.sdEmptyDelimiter(), this.sd_loc())
                else
                {
                    var not_single false
                    if have_last = false
                        set not_single: true
                    else if last_literal.get_size() <> (1 as size_t)
                        set not_single: true
                    if parm.param_literal.get_size() <> (1 as size_t)
                        set not_single: true
                    if not_single
                        this.report0_at(ParserMessages.sdRangeNotSingleChar(), this.sd_loc())
                    else
                    {
                        let lo_c last_literal.get(0 as size_t)
                        let hi_c parm.param_literal.get(0 as size_t)
                        if hi_c < lo_c
                            this.report0_at(ParserMessages.sdInvalidRange(), this.sd_loc())
                        else if hi_c <> lo_c
                        {
                            let shortref_chars ISet^host()
                            this.translate_range(b, lo_c + (1 as u32), hi_c, shortref_chars)
                            let duplicates ISet^host()
                            this.intersect_char_sets(shortref_chars, b.syntax.delim_shortref_simple(), duplicates)
                            var ki: size_t 0
                            let kn b.syntax.n_delim_shortref_complex()
                            while ki < kn
                            {
                                let cd b.syntax.delim_shortref_complex(ki)
                                if cd.get_size() = (1 as size_t)
                                {
                                    let cc cd.get(0 as size_t)
                                    if shortref_chars.contains(cc)
                                        duplicates.add(cc)
                                }
                                set ki: ki + 1
                            }
                            if duplicates.is_empty() = false
                            {
                                let arg this.charset_message_arg(duplicates)
                                this.report_raw_at(ParserMessages.duplicateDelimShortrefSet(), arg, this.sd_loc())
                            }
                            b.syntax.add_delim_shortrefs_set(shortref_chars)
                        }
                    }
                }
                set have_last: false
            }
            else if parm.kind = SDP_PARAM_LITERAL
            {
                ; same struct-assignment footgun as parm.token — copy via
                ; the accessors.
                let lldp parm.param_literal.data_ptr()
                let lldn parm.param_literal.get_size()
                set last_literal: StringC^host(lldp, lldn)
                set have_last: true
                if last_literal.get_size() = (0 as size_t)
                    this.report0_at(ParserMessages.sdEmptyDelimiter(), this.sd_loc())
                else
                {
                    var str2 StringC()
                    if this.translate_syntax_string(b, last_literal, &str2)
                    {
                        let folded2 this.sd_general_subst(b, str2)
                        var sr_ok folded2.get_size() = (1 as size_t)
                        if sr_ok = false
                            set sr_ok: this.check_shortref_delim(b.syntax, folded2)
                        if sr_ok
                        {
                            if b.syntax.is_valid_shortref(folded2)
                                this.report1_at(ParserMessages.duplicateDelimShortref(), folded2, this.sd_loc())
                            else
                                b.syntax.add_delim_shortref(folded2)
                        }
                    }
                }
            }
            else
                set sr_running: false
        }
        true
    }

    ; Parser::sdParseNames (parseSd.cxx:2084).
    function sd_parse_names(this: Parser, b: pointer[SdBuilder], parm: pointer[SdParam]) returns bool
    {
        let allow_sgmlref AllowedSdParams(SDP_RESERVED_NAME + SDR_SGMLREF)
        if this.parse_sd_param(allow_sgmlref, parm) = false
            return false
        var running true
        while running
        {
            let allow_rn AllowedSdParams(SDP_RESERVED_NAME + SDR_QUANTITY, SDP_REFERENCE_RESERVED_NAME)
            if this.parse_sd_param(allow_rn, parm) = false
                return false
            if parm.kind = (SDP_RESERVED_NAME + SDR_QUANTITY)
                set running: false
            else
            {
                let rn parm.idx
                if (rn = R_ALL) or (rn = R_DATA) or (rn = R_IMPLICIT)
                    this.sd_require_www(b)
                if b.external_syntax
                {
                    let allow_nm AllowedSdParams(SDP_NAME, SDP_PARAM_LITERAL)
                    if this.parse_sd_param(allow_nm, parm) = false
                        return false
                }
                else
                {
                    let allow_nm2 AllowedSdParams(SDP_NAME)
                    if this.parse_sd_param(allow_nm2, parm) = false
                        return false
                }
                var trans_name StringC()
                var trans_ok false
                if parm.kind = SDP_NAME
                    set trans_ok: this.translate_name(b, parm.token, &trans_name)
                else
                    set trans_ok: this.translate_syntax_string(b, parm.param_literal, &trans_name)
                if trans_ok
                {
                    let existing b.syntax.lookup_reserved_name(trans_name)
                    if existing >= 0
                        this.report1_at(ParserMessages.ambiguousReservedName(), trans_name, this.sd_loc())
                    else
                    {
                        var bad_name false
                        if trans_name.get_size() = (0 as size_t)
                            set bad_name: true
                        else if b.syntax.is_name_start_character(trans_name.get(0 as size_t)) = false
                            set bad_name: true
                        if bad_name
                        {
                            this.report1_at(ParserMessages.reservedNameSyntax(), trans_name, this.sd_loc())
                            set trans_name: StringC^host(null as pointer[u32], 0 as size_t)
                        }
                        var ni: size_t 1
                        let nn trans_name.get_size()
                        while ni < nn
                        {
                            if b.syntax.is_name_character(trans_name.get(ni)) = false
                            {
                                this.report1_at(ParserMessages.reservedNameSyntax(), trans_name, this.sd_loc())
                                set trans_name: StringC^host(null as pointer[u32], 0 as size_t)
                                set ni: nn
                            }
                            else
                                set ni: ni + 1
                        }
                        let folded this.sd_general_subst(b, trans_name)
                        let cur b.syntax.reserved_name(rn)
                        if cur.get_size() > (0 as size_t)
                        {
                            let syn ps.get_syntax()
                            let spell syn.reserved_name(rn)
                            this.report1_at(ParserMessages.duplicateReservedName(), spell, this.sd_loc())
                        }
                        else if folded.get_size() > (0 as size_t)
                            b.syntax.set_name(rn, folded)
                        else
                            set b.valid: false
                    }
                }
            }
        }
        this.set_ref_names(b.syntax, b.www)
        var fi: int 0
        while fi < 3
        {
            var rn_idx R_RE
            if fi = 1
                set rn_idx: R_RS
            else if fi = 2
                set rn_idx: R_SPACE
            let fname b.syntax.reserved_name(rn_idx)
            var tem: u32 0
            if b.syntax.lookup_declared_function_char(fname, &tem)
                this.report1_at(ParserMessages.duplicateFunctionName(), fname, this.sd_loc())
            set fi: fi + 1
        }
        b.syntax.enter_standard_function_names()
        true
    }

    ; Parser::sdParseQuantity (parseSd.cxx:2162).
    function sd_parse_quantity(this: Parser, b: pointer[SdBuilder], parm: pointer[SdParam]) returns bool
    {
        if b.www
        {
            let allow_a AllowedSdParams(SDP_RESERVED_NAME + SDR_NONE, SDP_RESERVED_NAME + SDR_SGMLREF)
            if this.parse_sd_param(allow_a, parm) = false
                return false
        }
        else
        {
            let allow_b AllowedSdParams(SDP_RESERVED_NAME + SDR_SGMLREF)
            if this.parse_sd_param(allow_b, parm) = false
                return false
        }
        var final SDP_RESERVED_NAME + SDR_FEATURES
        if b.external_syntax
            set final: SDP_EE
        if parm.kind = (SDP_RESERVED_NAME + SDR_NONE)
        {
            var qi: int 0
            while (qi as size_t) < N_QUANTITY
            {
                if qi <> qNORMSEP
                    b.syntax.set_quantity(qi, SYNTAX_UNLIMITED)
                set qi: qi + 1
            }
            let allow_end AllowedSdParams(final, SDP_RESERVED_NAME + SDR_ENTITIES)
            if this.parse_sd_param(allow_end, parm) = false
                return false
        }
        else
        {
            var q_running true
            while q_running
            {
                if b.www
                {
                    let allow_q AllowedSdParams(SDP_QUANTITY_NAME, final, SDP_RESERVED_NAME + SDR_ENTITIES)
                    if this.parse_sd_param(allow_q, parm) = false
                        return false
                }
                else
                {
                    let allow_q2 AllowedSdParams(SDP_QUANTITY_NAME, final)
                    if this.parse_sd_param(allow_q2, parm) = false
                        return false
                }
                if parm.kind <> SDP_QUANTITY_NAME
                    set q_running: false
                else
                {
                    let quantity parm.idx
                    let allow_num AllowedSdParams(SDP_NUMBER)
                    if this.parse_sd_param(allow_num, parm) = false
                        return false
                    b.syntax.set_quantity(quantity, parm.n)
                }
            }
            if b.sd.scope_instance()
            {
                let syn ps.get_syntax()
                let sdv ps.get_sd()
                var qi2: int 0
                while (qi2 as size_t) < N_QUANTITY
                {
                    let nv b.syntax.get_quantity(qi2)
                    let pv syn.get_quantity(qi2)
                    if nv < pv
                    {
                        let qn sdv.quantity_name(qi2)
                        this.report1_at(ParserMessages.scopeInstanceQuantity(), qn, this.sd_loc())
                    }
                    set qi2: qi2 + 1
                }
            }
        }
        if parm.kind = (SDP_RESERVED_NAME + SDR_ENTITIES)
            return this.sd_parse_entities(b, parm)
        true
    }

    ; Parser::sdParseEntities (parseSd.cxx:2211).
    function sd_parse_entities(this: Parser, b: pointer[SdBuilder], parm: pointer[SdParam]) returns bool
    {
        var final SDP_RESERVED_NAME + SDR_FEATURES
        if b.external_syntax
            set final: SDP_EE
        var running true
        while running
        {
            let allow_e AllowedSdParams(final, SDP_PARAM_LITERAL)
            if this.parse_sd_param(allow_e, parm) = false
                return false
            if parm.kind <> SDP_PARAM_LITERAL
                set running: false
            else
            {
                var name StringC()
                var name_ok this.translate_syntax_string(b, parm.param_literal, &name)
                if name_ok
                {
                    var bad false
                    if name.get_size() = (0 as size_t)
                        set bad: true
                    else if b.syntax.is_name_start_character(name.get(0 as size_t)) = false
                        set bad: true
                    if bad
                    {
                        this.report1_at(ParserMessages.entityNameSyntax(), name, this.sd_loc())
                        set name_ok: false
                    }
                    else
                    {
                        var ni: size_t 1
                        let nn name.get_size()
                        while ni < nn
                        {
                            if b.syntax.is_name_character(name.get(ni)) = false
                            {
                                this.report1_at(ParserMessages.entityNameSyntax(), name, this.sd_loc())
                                set name_ok: false
                                set ni: nn
                            }
                            else
                                set ni: ni + 1
                        }
                    }
                }
                let allow_num AllowedSdParams(SDP_NUMBER)
                if this.parse_sd_param(allow_num, parm) = false
                    return false
                var c: u32 0
                if this.translate_syntax(b, parm.n, &c)
                {
                    if name_ok
                    {
                        if name.get_size() > (0 as size_t)
                            b.syntax.add_entity_str(name, c)
                    }
                }
            }
        }
        true
    }

    ; Parser::sdParseFeatures (parseSd.cxx:2247) — the ordered FEATURES table.
    function sd_parse_features(this: Parser, b: pointer[SdBuilder], parm: pointer[SdParam]) returns bool
    {
        ; the FeatureInfo table: SD reserved name + argument kind
        ; (0 none, 1 boolean, 2 number, 3 netenabl, 4 implyelt).
        var feat_names int[34]
        var feat_args int[34]
        let fn feat_names as pointer[int]
        let fa feat_args as pointer[int]
        this.sd_fill_features(fn, fa)
        var boolean_feature: int 0
        var number_feature: int 0
        var i: int 0
        while i < 34
        {
            let name_i *(fn + (i as size_t))
            var arg_i *(fa + (i as size_t))
            var handled false
            if name_i = SDR_STARTTAG
            {
                ; SHORTTAG YES/NO or the Annex-K sub-form.
                let allow_st AllowedSdParams(SDP_RESERVED_NAME + SDR_STARTTAG, SDP_RESERVED_NAME + SDR_NO, SDP_RESERVED_NAME + SDR_YES)
                if this.parse_sd_param(allow_st, parm) = false
                    return false
                ; STARTTAG itself was consumed here (the reference's switch
                ; break) — don't parse the keyword again below.
                if parm.kind = (SDP_RESERVED_NAME + SDR_STARTTAG)
                    set handled: true
                if parm.kind <> (SDP_RESERVED_NAME + SDR_STARTTAG)
                {
                    b.sd.set_shorttag(parm.kind = (SDP_RESERVED_NAME + SDR_YES))
                    ; skip the sub-features up to EMPTYNRM, counting booleans.
                    set i: i + 1
                    while (*(fn + (i as size_t))) <> SDR_EMPTYNRM
                    {
                        if (*(fa + (i as size_t))) = 1
                            set boolean_feature: boolean_feature + 1
                        set i: i + 1
                    }
                    ; fall into the EMPTYNRM|LINK choice below.
                    let allow_el AllowedSdParams(SDP_RESERVED_NAME + SDR_EMPTYNRM, SDP_RESERVED_NAME + SDR_LINK)
                    if this.parse_sd_param(allow_el, parm) = false
                        return false
                    if parm.kind = (SDP_RESERVED_NAME + SDR_EMPTYNRM)
                        this.sd_require_www(b)
                    else
                    {
                        set boolean_feature: boolean_feature + 5
                        set i: i + 7
                    }
                    set arg_i: *(fa + (i as size_t))
                    set handled: true
                }
            }
            else if name_i = SDR_EMPTYNRM
            {
                let allow_el2 AllowedSdParams(SDP_RESERVED_NAME + SDR_EMPTYNRM, SDP_RESERVED_NAME + SDR_LINK)
                if this.parse_sd_param(allow_el2, parm) = false
                    return false
                if parm.kind = (SDP_RESERVED_NAME + SDR_EMPTYNRM)
                    this.sd_require_www(b)
                else
                {
                    set boolean_feature: boolean_feature + 5
                    set i: i + 7
                }
                set arg_i: *(fa + (i as size_t))
                set handled: true
            }
            else if name_i = SDR_URN
            {
                let allow_urn AllowedSdParams(SDP_RESERVED_NAME + SDR_URN, SDP_RESERVED_NAME + SDR_APPINFO)
                if this.parse_sd_param(allow_urn, parm) = false
                    return false
                if parm.kind = (SDP_RESERVED_NAME + SDR_APPINFO)
                    return true
                this.sd_require_www(b)
                set handled: true
            }
            if handled = false
            {
                let allow_kw AllowedSdParams(SDP_RESERVED_NAME + name_i)
                if this.parse_sd_param(allow_kw, parm) = false
                    return false
            }
            if arg_i = 2
            {
                ; number feature: NO or YES n.
                let allow_yn AllowedSdParams(SDP_RESERVED_NAME + SDR_NO, SDP_RESERVED_NAME + SDR_YES)
                if this.parse_sd_param(allow_yn, parm) = false
                    return false
                if parm.kind = (SDP_RESERVED_NAME + SDR_YES)
                {
                    let allow_num AllowedSdParams(SDP_NUMBER)
                    if this.parse_sd_param(allow_num, parm) = false
                        return false
                    b.sd.set_number_feature(number_feature, parm.n)
                }
                else
                    b.sd.set_number_feature(number_feature, 0 as u32)
                set number_feature: number_feature + 1
            }
            else if arg_i = 3
            {
                let allow_ne AllowedSdParams(SDP_RESERVED_NAME + SDR_NO, SDP_RESERVED_NAME + SDR_IMMEDNET, SDP_RESERVED_NAME + SDR_ALL)
                if this.parse_sd_param(allow_ne, parm) = false
                    return false
                if parm.kind = (SDP_RESERVED_NAME + SDR_NO)
                    b.sd.set_start_tag_net_enable(NET_ENABLE_NO)
                else if parm.kind = (SDP_RESERVED_NAME + SDR_IMMEDNET)
                    b.sd.set_start_tag_net_enable(NET_ENABLE_IMMEDNET)
                else
                    b.sd.set_start_tag_net_enable(NET_ENABLE_ALL)
            }
            else if arg_i = 4
            {
                let allow_ie AllowedSdParams(SDP_RESERVED_NAME + SDR_NO, SDP_RESERVED_NAME + SDR_YES, SDP_RESERVED_NAME + SDR_ANYOTHER)
                if this.parse_sd_param(allow_ie, parm) = false
                    return false
                if parm.kind = (SDP_RESERVED_NAME + SDR_NO)
                    b.sd.set_implydef_element(IMPLYDEF_ELEMENT_NO)
                else if parm.kind = (SDP_RESERVED_NAME + SDR_YES)
                    b.sd.set_implydef_element(IMPLYDEF_ELEMENT_YES)
                else
                    b.sd.set_implydef_element(IMPLYDEF_ELEMENT_ANYOTHER)
            }
            else if arg_i = 1
            {
                let allow_yn2 AllowedSdParams(SDP_RESERVED_NAME + SDR_NO, SDP_RESERVED_NAME + SDR_YES)
                if this.parse_sd_param(allow_yn2, parm) = false
                    return false
                let cur_name *(fn + (i as size_t))
                if cur_name = SDR_EMPTYNRM
                {
                    if (parm.kind = (SDP_RESERVED_NAME + SDR_NO)) and (b.sd.start_tag_net_enable() = NET_ENABLE_IMMEDNET)
                    {
                        this.report0_at(ParserMessages.immednetRequiresEmptynrm(), this.sd_loc())
                        set b.valid: false
                    }
                }
                b.sd.set_boolean_feature(boolean_feature, parm.kind = (SDP_RESERVED_NAME + SDR_YES))
                set boolean_feature: boolean_feature + 1
            }
            set i: i + 1
        }
        let allow_val AllowedSdParams(SDP_RESERVED_NAME + SDR_NOASSERT, SDP_RESERVED_NAME + SDR_TYPE)
        if this.parse_sd_param(allow_val, parm) = false
            return false
        b.sd.set_type_valid(parm.kind = (SDP_RESERVED_NAME + SDR_TYPE))
        let allow_ent AllowedSdParams(SDP_RESERVED_NAME + SDR_ENTITIES)
        if this.parse_sd_param(allow_ent, parm) = false
            return false
        let allow_ref AllowedSdParams(SDP_RESERVED_NAME + SDR_NOASSERT, SDP_RESERVED_NAME + SDR_REF)
        if this.parse_sd_param(allow_ref, parm) = false
            return false
        if parm.kind = (SDP_RESERVED_NAME + SDR_NOASSERT)
        {
            b.sd.set_integrally_stored(false)
            b.sd.set_entity_ref(ENTITY_REF_ANY)
        }
        else
        {
            let allow_refv AllowedSdParams(SDP_RESERVED_NAME + SDR_NONE, SDP_RESERVED_NAME + SDR_INTERNAL, SDP_RESERVED_NAME + SDR_ANY)
            if this.parse_sd_param(allow_refv, parm) = false
                return false
            if parm.kind = (SDP_RESERVED_NAME + SDR_NONE)
                b.sd.set_entity_ref(ENTITY_REF_NONE)
            else if parm.kind = (SDP_RESERVED_NAME + SDR_INTERNAL)
                b.sd.set_entity_ref(ENTITY_REF_INTERNAL)
            else
                b.sd.set_entity_ref(ENTITY_REF_ANY)
            let allow_int AllowedSdParams(SDP_RESERVED_NAME + SDR_INTEGRAL)
            if this.parse_sd_param(allow_int, parm) = false
                return false
            let allow_yn3 AllowedSdParams(SDP_RESERVED_NAME + SDR_NO, SDP_RESERVED_NAME + SDR_YES)
            if this.parse_sd_param(allow_yn3, parm) = false
                return false
            b.sd.set_integrally_stored(parm.kind = (SDP_RESERVED_NAME + SDR_YES))
        }
        let allow_app AllowedSdParams(SDP_RESERVED_NAME + SDR_APPINFO)
        this.parse_sd_param(allow_app, parm)
    }

    ; the FeatureInfo table (parseSd.cxx:2259) — names + argument kinds.
    function sd_fill_features(this: Parser, fn: pointer[int], fa: pointer[int])
    {
        set *(fn + (0 as size_t)): SDR_MINIMIZE
        set *(fa + (0 as size_t)): 0
        set *(fn + (1 as size_t)): SDR_DATATAG
        set *(fa + (1 as size_t)): 1
        set *(fn + (2 as size_t)): SDR_OMITTAG
        set *(fa + (2 as size_t)): 1
        set *(fn + (3 as size_t)): SDR_RANK
        set *(fa + (3 as size_t)): 1
        set *(fn + (4 as size_t)): SDR_SHORTTAG
        set *(fa + (4 as size_t)): 0
        set *(fn + (5 as size_t)): SDR_STARTTAG
        set *(fa + (5 as size_t)): 0
        set *(fn + (6 as size_t)): SDR_EMPTY
        set *(fa + (6 as size_t)): 1
        set *(fn + (7 as size_t)): SDR_UNCLOSED
        set *(fa + (7 as size_t)): 1
        set *(fn + (8 as size_t)): SDR_NETENABL
        set *(fa + (8 as size_t)): 3
        set *(fn + (9 as size_t)): SDR_ENDTAG
        set *(fa + (9 as size_t)): 0
        set *(fn + (10 as size_t)): SDR_EMPTY
        set *(fa + (10 as size_t)): 1
        set *(fn + (11 as size_t)): SDR_UNCLOSED
        set *(fa + (11 as size_t)): 1
        set *(fn + (12 as size_t)): SDR_ATTRIB
        set *(fa + (12 as size_t)): 0
        set *(fn + (13 as size_t)): SDR_DEFAULT
        set *(fa + (13 as size_t)): 1
        set *(fn + (14 as size_t)): SDR_OMITNAME
        set *(fa + (14 as size_t)): 1
        set *(fn + (15 as size_t)): SDR_VALUE
        set *(fa + (15 as size_t)): 1
        set *(fn + (16 as size_t)): SDR_EMPTYNRM
        set *(fa + (16 as size_t)): 1
        set *(fn + (17 as size_t)): SDR_IMPLYDEF
        set *(fa + (17 as size_t)): 0
        set *(fn + (18 as size_t)): SDR_ATTLIST
        set *(fa + (18 as size_t)): 1
        set *(fn + (19 as size_t)): SDR_DOCTYPE
        set *(fa + (19 as size_t)): 1
        set *(fn + (20 as size_t)): SDR_ELEMENT
        set *(fa + (20 as size_t)): 4
        set *(fn + (21 as size_t)): SDR_ENTITY
        set *(fa + (21 as size_t)): 1
        set *(fn + (22 as size_t)): SDR_NOTATION
        set *(fa + (22 as size_t)): 1
        set *(fn + (23 as size_t)): SDR_LINK
        set *(fa + (23 as size_t)): 0
        set *(fn + (24 as size_t)): SDR_SIMPLE
        set *(fa + (24 as size_t)): 2
        set *(fn + (25 as size_t)): SDR_IMPLICIT
        set *(fa + (25 as size_t)): 1
        set *(fn + (26 as size_t)): SDR_EXPLICIT
        set *(fa + (26 as size_t)): 2
        set *(fn + (27 as size_t)): SDR_OTHER
        set *(fa + (27 as size_t)): 0
        set *(fn + (28 as size_t)): SDR_CONCUR
        set *(fa + (28 as size_t)): 2
        set *(fn + (29 as size_t)): SDR_SUBDOC
        set *(fa + (29 as size_t)): 2
        set *(fn + (30 as size_t)): SDR_FORMAL
        set *(fa + (30 as size_t)): 1
        set *(fn + (31 as size_t)): SDR_URN
        set *(fa + (31 as size_t)): 1
        set *(fn + (32 as size_t)): SDR_KEEPRSRE
        set *(fa + (32 as size_t)): 1
        set *(fn + (33 as size_t)): SDR_VALIDITY
        set *(fa + (33 as size_t)): 0
    }

    ; Parser::sdParseAppinfo (parseSd.cxx:2469).
    function sd_parse_appinfo(this: Parser, b: pointer[SdBuilder], parm: pointer[SdParam]) returns bool
    {
        let loc this.sd_loc()
        let allow AllowedSdParams(SDP_RESERVED_NAME + SDR_NONE, SDP_MINIMUM_LITERAL)
        if this.parse_sd_param(allow, parm) = false
            return false
        if parm.kind = SDP_MINIMUM_LITERAL
        {
            let text parm.literal_text.string()
            let ev Event.make_appinfo(host, text, loc)
            ps.queue_event(ev)
        }
        true
    }

    ; Parser::sdParseSeealso (parseSd.cxx:2485).
    function sd_parse_seealso(this: Parser, b: pointer[SdBuilder], parm: pointer[SdParam]) returns bool
    {
        var final SDP_MDC
        if b.external
            set final: SDP_EE
        let allow AllowedSdParams(SDP_RESERVED_NAME + SDR_SEEALSO, final)
        if this.parse_sd_param(allow, parm) = false
            return false
        if parm.kind = final
            return true
        this.sd_require_www(b)
        let allow2 AllowedSdParams(SDP_MINIMUM_LITERAL, SDP_RESERVED_NAME + SDR_NONE)
        if this.parse_sd_param(allow2, parm) = false
            return false
        if parm.kind = (SDP_RESERVED_NAME + SDR_NONE)
        {
            let allow_end AllowedSdParams(final)
            return this.parse_sd_param(allow_end, parm)
        }
        var running true
        while running
        {
            let allow3 AllowedSdParams(SDP_MINIMUM_LITERAL, final)
            if this.parse_sd_param(allow3, parm) = false
                return false
            if parm.kind = final
                set running: false
        }
        true
    }

    ; Parser::parseSgmlDecl (parseSd.cxx:678) — the driver. On success the
    ; built Sd + the prolog/instance syntaxes are returned (they differ only
    ; under SCOPE INSTANCE).
    function parse_sgml_decl(this: Parser, out_sd: pointer[pointer[Sd]], out_pro: pointer[pointer[Syntax]], out_inst: pointer[pointer[Syntax]]) returns bool
    {
        let parm host.allocate(sizeof SdParam, alignof SdParam) as pointer[SdParam]
        set *parm: SdParam()
        let b host.allocate(sizeof SdBuilder, alignof SdBuilder) as pointer[SdBuilder]
        set *b: SdBuilder(host)
        let allow_ver AllowedSdParams(SDP_MINIMUM_LITERAL, SDP_NAME)
        if this.parse_sd_param(allow_ver, parm) = false
            return false
        if parm.kind = SDP_NAME
        {
            ; `<!SGML name ...>` — a WWW SGML-declaration reference.
            set b.external: true
            let id host.allocate(sizeof ExternalId, alignof ExternalId) as pointer[ExternalId]
            set *id: ExternalId()
            if this.sd_parse_sgml_decl_ref(b, parm, id) = false
                return false
            var sysid String()
            var sys_base String()
            if id.has_system_id()
            {
                ; copy-construct — a plain struct assignment into a var from
                ; a call result mis-copies (the parm.token footgun class).
                let s0 id.get_system_id()
                set sysid: String^host(s0)
                let b0 ps.get_decl_base_dir()
                set sys_base: String^host(b0)
            }
            else
            {
                let cat ps.get_entity_catalog()
                if cat <> null
                {
                    if id.has_public_id()
                    {
                        let p0 id.get_public_id()
                        let s1 cat.lookup_public(p0)
                        set sysid: String^host(s1)
                    }
                }
            }
            if sysid.get_length() = (0 as size_t)
            {
                this.report0_at(ParserMessages.cannotGenerateSystemIdSgml(), this.sd_loc())
                return false
            }
            let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
            set *org: Origin()
            let src this.open_external_text(sys_base, sysid, org)
            if src = null
            {
                let storage Storage.OsFile(sys_base)
                let emsg storage.open_error(sysid)
                let disp Path.join(sys_base, sysid)
                this.report_open_failure(StringC^host(disp.to_c_string()), emsg, this.sd_loc())
                return false
            }
            ps.push_input(src)
            let allow_ver2 AllowedSdParams(SDP_MINIMUM_LITERAL)
            if this.parse_sd_param(allow_ver2, parm) = false
                return false
        }
        let version parm.literal_text.string()
        if version.equals(StringC("ISO 8879:1986 (ENR)"))
            set b.enr: true
        else if version.equals(StringC("ISO 8879:1986 (WWW)"))
        {
            set b.enr: true
            set b.www: true
        }
        else
        {
            if version.equals(StringC("ISO 8879:1986")) = false
                this.report1_at(ParserMessages.standardVersion(), version, this.sd_loc())
        }
        if b.external and (b.www = false)
            this.report0_at(ParserMessages.sgmlDeclRefRequiresWww(), this.sd_loc())
        ; the raw Sd under construction (features all off until FEATURES).
        let bsd host.allocate(sizeof Sd, alignof Sd) as pointer[Sd]
        set *bsd: Sd()
        bsd.set_raw_defaults()
        let cur_sd ps.get_sd()
        if cur_sd.internal_charset_is_doc_charset() = false
            bsd.set_internal_charset_is_doc_charset(false)
        set b.sd: bsd
        if b.www
            bsd.set_www(true)
        if this.sd_parse_document_charset(b, parm) = false
            return false
        if b.valid = false
            return false
        if this.sd_parse_capacity(b, parm) = false
            return false
        if b.valid = false
            return false
        if this.sd_parse_scope(b, parm) = false
            return false
        if b.valid = false
            return false
        if this.sd_parse_syntax(b, parm) = false
            return false
        if b.valid = false
            return false
        if this.sd_parse_features(b, parm) = false
            return false
        if b.valid = false
            return false
        if this.sd_parse_appinfo(b, parm) = false
            return false
        if b.valid = false
            return false
        if this.sd_parse_seealso(b, parm) = false
            return false
        if b.valid = false
            return false
        ; setSdOverrides: -w CLI overrides — none in the drop-in.
        if b.sd.formal()
        {
            var fe: size_t 0
            while fe < b.n_ferr
            {
                let kind *(b.ferr_kind + fe)
                let code *(b.ferr_code + fe)
                let fid *(b.ferr_id + fe)
                let floc *(b.ferr_loc + fe)
                if kind = SDFE_FPI
                    this.report_fpi_error(code, fid, floc)
                else if kind = SDFE_TEXTCLASS_SD
                    this.report1_at(ParserMessages.sdTextClass(), fid, floc)
                else if kind = SDFE_TEXTCLASS_BASESET
                    this.report1_at(ParserMessages.basesetTextClass(), fid, floc)
                else if kind = SDFE_TEXTCLASS_CAPACITY
                    this.report1_at(ParserMessages.capacityTextClass(), fid, floc)
                else
                    this.report1_at(ParserMessages.syntaxTextClass(), fid, floc)
                set fe: fe + 1
            }
        }
        set *out_sd: b.sd
        if b.sd.scope_instance()
        {
            ; SCOPE INSTANCE: the prolog parses with the reference syntax
            ; (setStandardSyntax over a fresh syntax), the instance with the
            ; declared one; each must accept the other's SGML chars.
            let prosyn Syntax^host(*(b.sd))
            let inst_sgml b.syntax.char_set(setSgmlChar)
            prosyn.set_sgml_char_set(inst_sgml)
            let invalid ISet^host()
            this.check_sgml_char(prosyn, b.sd, b.syntax, b.sys_desc, invalid)
            this.check_sgml_char(b.syntax, b.sd, prosyn, b.sys_desc, invalid)
            if invalid.is_empty() = false
            {
                let arg this.charset_message_arg(invalid)
                this.report_raw_at(ParserMessages.invalidSgmlChar(), arg, this.sd_loc())
            }
            set *out_pro: prosyn
            set *out_inst: b.syntax
        }
        else
        {
            set *out_pro: b.syntax
            set *out_inst: b.syntax
        }
        ; a multicode syntax's markup scan table belongs to the CONCUR axis.
        true
    }

    ; ---- top-level entry: document bytes -> ESIS -------------------------
    ; The whole-document event-dump entry the onsgmls program calls: widen the
    ; input bytes to Char (identity/ASCII), set up ParserState (reference Sd +
    ; Syntax), drive parse_document, and return the ESIS text. *out_conforming
    ; is true iff the parse produced no errors (the onsgmls exit-0 condition).
    ; A concept STATIC so a user program resolves it across packages. `base_dir`
    ; is the document's directory — external DTD subsets (SYSTEM/PUBLIC) resolve
    ; their (relative) system ids against it.
    function parse_to_esis(host: pointer[Page], doc_bytes: String, base_dir: String, doc_name: StringC, prog_name: String, output_utf8: bool, charset_fixed: bool, out_conforming: pointer[bool]) returns String
    {
        ; Record normalization (ExtendEntityManager, `lf` record type — the whole
        ; Unix corpus): insert one RS (0x0A) at the entity start, and translate
        ; each source LF (0x0A) to RE (0x0D). Content newlines then tokenize as
        ; tokenRe (record ends the OutputState machine shapes into data); the
        ; leading RS + declaration-subset newlines are separators in prolog modes.
        ; A raw CR (0x0D) already IS the RE char and passes through. (crlf / cr-only
        ; record types are deferred; the corpus is LF.)
        let ps ParserState.make(host, null, 0 as u32, PHASE_PROLOG)
        ps.set_prog_name(prog_name)
        ; the output coding system (identity vs UTF-8) the driver derived from
        ; the environment — governs the ESIS stdout bytes and stderr encoding.
        ps.set_output_utf8(output_utf8)
        ; the document's directory: every relative SYSTEM id (external DTD subset,
        ; external text entity in content) resolves against it. The declaration
        ; base starts here too and follows the external subset while it is parsed.
        ps.set_base_dir(base_dir)
        ps.set_decl_base_dir(base_dir)

        ; ---- the SGML declaration (Parser::doInit, parseSd.cxx:144) --------
        ; A PROVISIONAL Sd + reference Syntax parse the declaration itself
        ; (ParserOptions defaults: SHORTTAG YES, OMITTAG YES, FORMAL YES; the
        ; SD-parsing syntax keeps the Syntax-ctor REFERENCE quantities).
        var sd: pointer[Sd] null
        set sd: host.allocate(sizeof Sd, alignof Sd) as pointer[Sd]
        set *sd: Sd()
        sd.set_formal(true)
        ; the document charset machinery (Parser.cxx:46-52): the implied
        ; declaration — one section with an EMPTY public id declaring
        ; 0..charMax — and the system-charset identity mapping. An explicit
        ; CHARSET section replaces both on the BUILT sd.
        sd.set_doc_charset_decl(CharsetDecl.make_implied(host))
        sd.set_doc_charset_desc(UnivCharsetDesc.make_system(host))
        ; SP_CHARSET_FIXED=YES/1 (the driver's charset_fixed): the internal
        ; charset is the FIXED system charset, no longer the document charset.
        if charset_fixed
            sd.set_internal_charset_is_doc_charset(false)
        var syn: pointer[Syntax] null
        set syn: Syntax^host(*sd)
        ps.set_sd(sd)
        ps.set_syntax(syn)

        let parser Parser.make(host, ps)
        let table ModeInfo.build_table(host)

        ; catalog: SGMLDECL binding + PUBLIC resolution for the SD parse.
        var have_decl false
        var decl_text String()
        var decl_name StringC()
        var cat_path base_dir
        if base_dir.get_length() = (0 as size_t)
            set cat_path: String("catalog")
        else
            set cat_path: Path.join(base_dir, String("catalog"))
        if File.exists(cat_path)
        {
            let cat_text File.read_to_string(cat_path)
            let catalog CatalogParser().parse(cat_text, base_dir)
            ps.set_entity_catalog(catalog)
            let decl_path catalog.lookup_sgmldecl()
            if (decl_path.get_length() <> (0 as size_t)) and File.exists(decl_path)
            {
                set decl_text: File.read_to_string(decl_path)
                set decl_name: StringC(decl_path.to_c_string())
                set have_decl: true
            }
        }

        let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org: Origin()
        ; the storage id onsgmls displays for a location in the document entity.
        org.set_file_name(doc_name)
        let src Parser.make_char_source(host, doc_bytes, org)
        ps.push_input(src)

        ; doInit's findMissingMinimum over the initial internal charset
        ; (parseSd.cxx:160): fatal when minimum-data chars are unmappable.
        ; The port's initial charset is the identity system charset, so the
        ; set is always empty — kept for fidelity of the check's shape.
        let init_missing ISet^host()
        let init_internal UnivCharsetDesc.make_system(host)
        parser.find_missing_minimum(init_internal, init_missing)
        if init_missing.is_empty() = false
        {
            let init_arg parser.charset_message_arg(init_missing)
            parser.report_raw_at(ParserMessages.sdMissingCharacters(), init_arg, ps.current_location())
            parser.report0_at(ParserMessages.giveUp(), ps.current_location())
            set *out_conforming: false
            return Esis.write(host, ps, false)
        }

        ; scanForSgmlDecl: the document itself first, then the catalog's
        ; SGMLDECL (badDefaultSgmlDecl when that file is no SGML declaration).
        var sd_found parser.scan_for_sgml_decl()
        if sd_found = false
        {
            let dins ps.current_input()
            dins.unget_token()
            if have_decl
            {
                let dorg host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
                set *dorg: Origin()
                dorg.set_file_name(decl_name)
                let dsrc Parser.make_char_source(host, decl_text, dorg)
                ps.push_input(dsrc)
                if parser.scan_for_sgml_decl()
                    set sd_found: true
                else
                {
                    let dins2 ps.current_input()
                    dins2.unget_token()
                    parser.report0_at(ParserMessages.badDefaultSgmlDecl(), parser.sd_loc())
                    ps.pop_input_stack()
                }
            }
        }
        var sd_failed false
        if sd_found
        {
            parser.install_sd_recognizers(table)
            var new_sd: pointer[Sd] null
            var new_pro: pointer[Syntax] null
            var new_inst: pointer[Syntax] null
            if parser.parse_sgml_decl(&new_sd, &new_pro, &new_inst)
            {
                ps.set_sd(new_sd)
                if new_inst <> new_pro
                    ps.set_syntaxes(new_pro, new_inst)
                else
                    ps.set_syntax(new_pro)
                if ps.get_input_level() = (2 as u32)
                    ps.pop_input_stack()
            }
            else
            {
                set sd_failed: true
                ; Parser::giveUp (Parser.cxx:183) — the SD parse is fatal.
                parser.report0_at(ParserMessages.giveUp(), parser.sd_loc())
            }
        }
        else
        {
            ; implySgmlDecl: the implied declaration parses with the OPTIONS
            ; quantities (NAMELEN 99999999, LITLEN 24000, ...), not the
            ; reference set the Syntax ctor installs.
            syn.set_options_quantities()
        }

        parser.install_recognizers(table)

        var ok false
        if sd_failed = false
            set ok: parser.parse_document(table, base_dir)
        ; errorLimitExceeded (ParserApp.cxx): after the parse, if the error count
        ; reached the limit, emit the locationless Info line (once). onsgmls prints
        ; this last, after every queued diagnostic.
        if (ERROR_LIMIT <> (0 as u32)) and (ps.get_n_errors() >= ERROR_LIMIT)
            ps.report_error_limit(ERROR_LIMIT)
        let conforming ok and (ps.get_n_errors() = (0 as u32))
        set *out_conforming: conforming
        Esis.write(host, ps, conforming)
    }

    ; ---- self-test: parse a synthetic DTD subset, assert the built Dtd -----
    function test() returns int
    {
        let anchor StringC("x")
        let host Page.get(anchor.data_ptr() as pointer[void])

        ; --- assemble the DTD subset text as an in-memory InputSource ---
        ;   <!ELEMENT doc (title, para+)>
        ;   <!ELEMENT title (#PCDATA)>
        ;   <!ELEMENT para (#PCDATA)>
        ;   <!ATTLIST doc id ID #IMPLIED>
        ;   <!ENTITY logo "LOGO">
        ;   <!NOTATION gif SYSTEM "gif.exe">
        let dtext StringC("<!ELEMENT doc - - (title, para+)> <!ELEMENT title - - (#PCDATA)> <!ELEMENT para - - (#PCDATA)> <!ATTLIST doc id ID #IMPLIED> <!ENTITY logo \"LOGO\"> <!NOTATION gif SYSTEM \"gif.exe\"> ]")
        let n dtext.get_size()
        let buf host.allocate(n * (4 as size_t), 4) as pointer[u32]
        var ci: size_t 0
        while ci < n
        {
            set *(buf + ci): dtext.get(ci)
            set ci: ci + 1
        }

        ; --- ParserState + Sd + Syntax ---
        let ps ParserState.make(host, null, 0 as u32, PHASE_DECL_SUBSET)
        let sd host.allocate(sizeof Sd, alignof Sd) as pointer[Sd]
        set *sd: Sd()
        sd.set_doc_charset_decl(CharsetDecl.make_implied(host))
        sd.set_doc_charset_desc(UnivCharsetDesc.make_system(host))
        ps.set_sd(sd)
        let syn Syntax^host(*sd)
        ps.set_syntax(syn)

        ; --- the def/current DTD (document element "DOC" auto-inserted at 1;
        ;     names fold to uppercase under NAMECASE GENERAL YES) ---
        let dtd Dtd.make(host, StringC("DOC"), true)
        ps.set_def_dtd(dtd)
        ps.set_current_dtd(dtd)

        ; --- recognizers + input source ---
        let parser Parser.make(host, ps)
        let table ModeInfo.build_table(host)
        parser.install_recognizers(table)

        let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org: Origin()
        let src host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
        set *src: InputSource(org, buf, n)
        ps.push_input(src)

        ; --- drive the declaration-subset parser (internal subset at level 1) ---
        let rc parser.parse_decl_subset(1 as u32, false)
        if rc <> 0
            return -1
        if ps.get_n_errors() <> (0 as u32)
            return -2

        ; --- assert element types + declared content (folded names) ---
        let doc dtd.lookup_element_type(StringC("DOC"))
        if doc = null
            return -3
        let title dtd.lookup_element_type(StringC("TITLE"))
        if title = null
            return -4
        let para dtd.lookup_element_type(StringC("PARA"))
        if para = null
            return -5
        let doc_def doc.get_definition()
        if doc_def = null
            return -6
        if doc_def.get_declared_content() <> DC_MODEL_GROUP
            return -7
        let title_def title.get_definition()
        if title_def = null
            return -8
        if title_def.get_declared_content() <> DC_MODEL_GROUP
            return -9

        ; --- drive the compiled content model of doc: (title, para+) ---
        let cmg doc_def.compiled_model_group()
        if cmg = null
            return -10
        let ms ContentToken.make_match_state(host, cmg)
        if ContentToken.ms_try_transition(ms, title) = false
            return -11
        if ContentToken.ms_try_transition(ms, para) = false
            return -12
        if ContentToken.ms_is_finished(ms) = false
            return -13
        ; para+ repeats
        if ContentToken.ms_try_transition(ms, para) = false
            return -14

        ; --- assert the ATTLIST on doc ---
        let adl doc.get_attribute_def()
        if adl = null
            return -15
        if adl.size() <> (1 as size_t)
            return -16
        let iddef adl.def(0 as size_t)
        if iddef = null
            return -17
        if iddef.get_name().equals(StringC("ID")) = false
            return -18

        ; --- assert the ENTITY (NAMECASE ENTITY NO: name stays lowercase) ---
        let logo dtd.lookup_entity(false, StringC("logo"))
        if logo = null
            return -19

        ; --- assert the NOTATION (folded) ---
        let gif dtd.lookup_notation(StringC("GIF"))
        if gif = null
            return -20
        if gif.is_defined() = false
            return -21
        if gif.has_system_id() = false
            return -22

        ; ================= Stage 4: instance parsing =====================
        ; Parse a well-formed instance against the DTD just built and assert the
        ; event stream for  <doc><title>Hi</title><para>X</para></doc>  (names
        ; fold to uppercase): START DOC, START TITLE, "Hi", END TITLE, START
        ; PARA, "X", END PARA, END DOC.
        let itext StringC("<doc id=\"D1\"><title>Hi</title><para>X</para></doc>")
        let ni itext.get_size()
        let ibuf host.allocate(ni * (4 as size_t), 4) as pointer[u32]
        var ii: size_t 0
        while ii < ni
        {
            set *(ibuf + ii): itext.get(ii)
            set ii: ii + 1
        }

        ; content-mode recognizers, then enter the instance
        parser.install_content_recognizers(table)
        ; drop the (exhausted) declaration-subset input so the instance parses at
        ; input level 1 (end-of-entity there ends the instance).
        ps.pop_input_stack()
        ps.start_instance(host, dtd)

        let iorg host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *iorg: Origin()
        let isrc host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
        set *isrc: InputSource(iorg, ibuf, ni)
        ps.push_input(isrc)

        parser.do_instance_start()
        parser.do_content()

        if ps.get_n_errors() <> (0 as u32)
            return -30

        ; walk the event queue: match the 6 structural events in order, and sum
        ; the total character-data length (robust to data-token coalescing).
        let n_ev ps.n_events()
        var si: int 0
        var data_total: size_t 0
        var k: size_t 0
        while k < n_ev
        {
            let ev ps.get_event(k)
            let ty ev.get_type()
            if ty = EV_DATA
            {
                let d ev.get_data()
                set data_total: data_total + d.get_size()
            }
            else
            {
                let et ev.get_element_type()
                let nm et.get_name()
                if si = 0
                {
                    if ty <> EV_START_ELEMENT
                        return -31
                    if nm.equals(StringC("DOC")) = false
                        return -32
                }
                else if si = 1
                {
                    if ty <> EV_START_ELEMENT
                        return -33
                    if nm.equals(StringC("TITLE")) = false
                        return -34
                }
                else if si = 2
                {
                    if ty <> EV_END_ELEMENT
                        return -35
                    if nm.equals(StringC("TITLE")) = false
                        return -36
                }
                else if si = 3
                {
                    if ty <> EV_START_ELEMENT
                        return -37
                    if nm.equals(StringC("PARA")) = false
                        return -38
                }
                else if si = 4
                {
                    if ty <> EV_END_ELEMENT
                        return -39
                    if nm.equals(StringC("PARA")) = false
                        return -40
                }
                else if si = 5
                {
                    if ty <> EV_END_ELEMENT
                        return -41
                    if nm.equals(StringC("DOC")) = false
                        return -42
                }
                else
                    return -43
                set si: si + 1
            }
            set k: k + 1
        }
        if si <> 6
            return -44
        if data_total <> (3 as size_t)
            return -45

        ; --- assert the attribute on the <doc> start event ---
        let ev0 ps.get_event(0 as size_t)
        let atts0 ev0.get_attributes()
        if atts0 = null
            return -46
        let ai atts0.attribute_index(StringC("ID"))
        if ai < 0
            return -47
        let av atts0.value(ai as size_t)
        if av = null
            return -48
        let avs av.get_string()
        if avs.equals(StringC("D1")) = false
            return -49

        ; ============= Stage 4 Increment 3: full document -> ESIS ==========
        ; Drive a whole SGML document (prolog DOCTYPE + internal subset +
        ; instance, ONE InputSource) through parse_document and assert the ESIS
        ; dump is byte-identical to the reference onsgmls output.
        let esis_rc parser_esis_check()
        if esis_rc <> 0
            return esis_rc

        0
    }

    ; a fresh-ParserState full-document drive + ESIS byte comparison.
    function parser_esis_check() returns int
    {
        let anchor StringC("y")
        let host Page.get(anchor.data_ptr() as pointer[void])

        let doc StringC("<!DOCTYPE doc [<!ELEMENT doc - - (title, para+)> <!ELEMENT title - - (#PCDATA)> <!ELEMENT para - - (#PCDATA)> <!ATTLIST doc id ID #IMPLIED>]><doc id=\"D1\"><title>Hi</title><para>X</para></doc>")
        let n doc.get_size()
        let buf host.allocate(n * (4 as size_t), 4) as pointer[u32]
        var ci: size_t 0
        while ci < n
        {
            set *(buf + ci): doc.get(ci)
            set ci: ci + 1
        }

        let ps ParserState.make(host, null, 0 as u32, PHASE_PROLOG)
        let sd host.allocate(sizeof Sd, alignof Sd) as pointer[Sd]
        set *sd: Sd()
        sd.set_doc_charset_decl(CharsetDecl.make_implied(host))
        sd.set_doc_charset_desc(UnivCharsetDesc.make_system(host))
        ps.set_sd(sd)
        let syn Syntax^host(*sd)
        ps.set_syntax(syn)

        let parser Parser.make(host, ps)
        let table ModeInfo.build_table(host)
        parser.install_recognizers(table)

        let org host.allocate(sizeof Origin, alignof Origin) as pointer[Origin]
        set *org: Origin()
        let src host.allocate(sizeof InputSource, alignof InputSource) as pointer[InputSource]
        set *src: InputSource(org, buf, n)
        ps.push_input(src)

        if parser.parse_document(table, String()) = false
            return -60

        let got Esis.write(host, ps, ps.get_n_errors() = (0 as u32))
        let want String("AID TOKEN D1\n(DOC\n(TITLE\n-Hi\n)TITLE\n(PARA\n-X\n)PARA\n)DOC\nC\n")
        if got.equals(want) = false
            return -61
        0
    }
}
