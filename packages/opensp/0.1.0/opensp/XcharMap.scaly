use scaly.memory.Page
use opensp.StringC.StringC

; XcharMap — XcharMap.cs (120 LOC). A map from an Xchar (an i32 = any Char value
; plus the -1 end-of-entity / EOF sentinel) to a value. C++ backs it with a
; SharedXcharMap of 2 + 0xFFFF entries whose ptr() points at v[1], so index -1
; (EOF) lands at v[0] and Char c lands at v[c+1].
;
; This port specializes the value type T to PackedBoolean (u8): the ONLY
; instantiation of XcharMap in OpenSP is `XcharMap<PackedBoolean> normalMap_` on
; ParserState (the "is this Char normal data?" bitmap). The [-1, 0xFFFF] range is
; held densely with the +1 offset; chars above 0xFFFF (C++'s separate hiMap_) are
; outside the reference/XML syntax's 8-bit character scope (matching the
; Partition 0..255 scope of Increment B) and clamp to the default value — a
; documented deferral, not a general-charset regression.
;
; PORT SHAPE: page-hosted flat struct. The backing buffer is a single u8 array of
; XCHARMAP_SIZE bytes region-allocated on the run's page; get/setRange/setChar
; mutate through that pointer (the map value can be copied freely — the buffer is
; shared, one region per run).

define XCHARMAP_HI: size_t 0xFFFF        ; highest densely-held Char
define XCHARMAP_SIZE: size_t 0x10001     ; 2 + 0xFFFF entries (index -1 .. 0xFFFF)

define XcharMap (v: pointer[u8], default_value: u8)
{
    function make(host: pointer[Page], default_value: u8) returns pointer[XcharMap]
    {
        let m host.allocate(sizeof XcharMap, alignof XcharMap) as pointer[XcharMap]
        set m.default_value: default_value
        set m.v: host.allocate(XCHARMAP_SIZE, 1) as pointer[u8]
        var i: size_t 0
        while i < XCHARMAP_SIZE
        {
            set *(m.v + i): default_value
            set i: i + 1
        }
        m
    }

    ; operator[](Xchar c): index -1 (EOF) -> v[0]; Char c -> v[c+1]. Chars above
    ; the densely-held range return the default (see hiMap_ deferral above).
    function get(this: XcharMap, c: i32) returns u8
    {
        if c > (XCHARMAP_HI as i32)
            return default_value

        *(v + ((c + 1) as size_t))
    }

    ; setRange(Char min, Char max, T val): fill [min, max] (clamped to 0xFFFF).
    function set_range(this: XcharMap, min: u32, max: u32, val: u8)
    {
        if min > max
            return

        var m max
        if m > (XCHARMAP_HI as u32)
            set m: XCHARMAP_HI as u32

        var c min
        while c <= m
        {
            set *(v + ((c + (1 as u32)) as size_t)): val
            set c: c + (1 as u32)
        }
    }

    ; setChar(Char c, T val).
    function set_char(this: XcharMap, c: u32, val: u8)
    {
        if c > (XCHARMAP_HI as u32)
            return

        set *(v + ((c + (1 as u32)) as size_t)): val
    }

    ; setEe(T val): the value for the -1 EOF sentinel (v[0]).
    function set_ee(this: XcharMap, val: u8)
        set *(v + (0 as size_t)): val

    function test() returns int
    {
        let anchor StringC("x")
        let host Page.get(anchor.data_ptr() as pointer[void])

        let m XcharMap.make(host, 0)
        ; everything starts at the default.
        if m.get(0x41) <> (0 as u8)
            return -1

        ; a range of letters becomes "normal".
        m.set_range(0x41, 0x5A, 1)
        if m.get(0x41) <> (1 as u8)
            return -2
        if m.get(0x5A) <> (1 as u8)
            return -3
        ; the char just below/above the range stays default.
        if m.get(0x40) <> (0 as u8)
            return -4
        if m.get(0x5B) <> (0 as u8)
            return -5

        ; a single char.
        m.set_char(0x23, 1)
        if m.get(0x23) <> (1 as u8)
            return -6

        ; the EOF sentinel maps through v[0].
        if m.get(-1 as i32) <> (0 as u8)
            return -7
        m.set_ee(1)
        if m.get(-1 as i32) <> (1 as u8)
            return -8

        ; a Char above the dense range clamps to the default.
        if m.get(0x10000) <> (0 as u8)
            return -9

        ; copies share the same backing buffer (mutation through either shows).
        let m2 m
        m2.set_char(0x30, 1)
        if m.get(0x30) <> (1 as u8)
            return -10

        0
    }
}
