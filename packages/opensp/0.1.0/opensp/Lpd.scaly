use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.Location.Location
use opensp.Dtd.Dtd
use opensp.ElementType.ElementType
use opensp.AttributeList.AttributeList
use opensp.AttributeList.AttributeDefinitionList

; Lpd — link process definitions (Lpd.h / Lpd.cxx). The LINK feature axis'
; data layer: one Lpd per LINKTYPE declaration (simple / implicit / explicit),
; complex LPDs carry LINK/IDLINK link sets whose rules attach link attribute
; lists (and, for explicit links, result element specs) to source elements.
;
; PORT SHAPE (the Event/CmNode convention): C++'s Lpd/SimpleLpd/ComplexLpd
; inheritance triangle collapses into ONE flat tagged struct keyed by `kind`
; (LPD_SIMPLE carries the Attributed half, IMPLICIT/EXPLICIT the complex half).
; SourceLinkRule and IdLinkRule likewise collapse (an IdLinkRule is a
; SourceLinkRule with a non-null assoc_element_types vector); ResultElementSpec
; is folded into the rule as (result_type, result_attributes). LinkSet's
; uselink/postlink slots inside SourceLinkRule are pointer[void] — LinkSet is
; declared AFTER SourceLinkRule in this module (the ExternalDataEntity.notation
; precedent for a type declared later than its borrower).
;
; NamedTable<LinkSet> / NamedTable<IdLinkRuleGroup> are OpenSP open-addressing
; hash tables; parseLinktypeDeclEnd SWEEPS the link-set table for undefined
; link sets, so the ITERATION ORDER (ascending bucket index) is message-order
; load-bearing — LinkSetTable mirrors the IdTable port exactly (initial size 8,
; usedLimit half, grow x2 reinserting in old bucket order, probe DOWNWARD).

define LPD_SIMPLE: int 0
define LPD_IMPLICIT: int 1
define LPD_EXPLICIT: int 2

; SourceLinkRule (+ IdLinkRule when assoc_element_types is non-null).
; uselink/postlink are pointer[void] = pointer[LinkSet] (declared below).
define SourceLinkRule
(
    uselink: pointer[void]
    postlink: pointer[void]
    postlink_restore: bool
    link_attributes: ref[AttributeList]?
    ; ResultElementSpec (explicit links): the result element (null = none
    ; looked up / no result dtd) and its attributes. has_result distinguishes
    ; an omitted (#IMPLIED) result from a present one.
    has_result: bool
    result_type: ref[ElementType]?
    result_attributes: ref[AttributeList]?
    ; IdLinkRule: the associated source element types.
    assoc_element_types: ref[Array[pointer[ElementType]]]?
)
{
    function make(host: pointer[Page]) returns ref[SourceLinkRule]
    {
        let r host.allocate(sizeof SourceLinkRule, alignof SourceLinkRule) as pointer[SourceLinkRule]
        set r.uselink: null
        set r.postlink: null
        set r.postlink_restore: false
        set r.link_attributes: null
        set r.has_result: false
        set r.result_type: null
        set r.result_attributes: null
        set r.assoc_element_types: null
        r
    }

    function set_uselink(this: ref[SourceLinkRule], ls: pointer[void])
        set this.uselink: ls

    function get_uselink(this: SourceLinkRule) returns pointer[void]
        uselink

    function set_postlink(this: ref[SourceLinkRule], ls: pointer[void])
        set this.postlink: ls

    function get_postlink(this: SourceLinkRule) returns pointer[void]
        postlink

    function set_postlink_restore(this: ref[SourceLinkRule])
        set this.postlink_restore: true

    function get_postlink_restore(this: SourceLinkRule) returns bool
        postlink_restore

    function set_link_attributes(this: ref[SourceLinkRule], atts: ref[AttributeList])
        set this.link_attributes: atts

    function attributes(this: SourceLinkRule) returns ref[AttributeList]
        link_attributes

    function set_result(this: ref[SourceLinkRule], e: ref[ElementType], atts: ref[AttributeList])
    {
        set this.has_result: true
        set this.result_type: e
        set this.result_attributes: atts
    }

    function get_result_type(this: SourceLinkRule) returns ref[ElementType]
        result_type

    function get_result_attributes(this: SourceLinkRule) returns ref[AttributeList]
        result_attributes

    function set_assoc_element_types(this: ref[SourceLinkRule], v: ref[Array[pointer[ElementType]]])
        set this.assoc_element_types: v

    ; IdLinkRule::isAssociatedWith.
    function is_associated_with(this: SourceLinkRule, e: ref[ElementType]) returns bool
    {
        if assoc_element_types = null
            return false
        let n assoc_element_types.get_length()
        var i: size_t 0
        while i < n
        {
            if *(assoc_element_types.get_buffer() + i) = e
                return true
            set i: i + 1
        }
        false
    }
}

; LinkSet (Lpd.h:99): link rules indexed by the SOURCE element's type index,
; plus the implied source link rules (result specs of `#IMPLIED source` rules).
; The reference sizes linkRules_ to the source DTD's nElementTypeIndex at
; construction and indexes UNCHECKED thereafter — but link rules may
; lookupCreateElement NEW elements, so the port grows the vector on demand
; (behaviorally identical for every input the reference handles defined).
define LinkSet
(
    name: StringC
    defined: bool
    ; per source-element type index: the rules for that element.
    link_rules: ref[Array[pointer[Array[pointer[SourceLinkRule]]]]]
    ; ResultElementSpecs of implied-source rules, stored as rules (result half).
    implied_rules: ref[Array[pointer[SourceLinkRule]]]
)
{
    ; deep-copies the name onto host (parm tokens are transient).
    function make(host: pointer[Page], name: StringC, dtd: ref[Dtd]) returns ref[LinkSet]
    {
        let ls host.allocate(sizeof LinkSet, alignof LinkSet) as pointer[LinkSet]
        set ls.name: StringC^host(name.data_ptr(), name.get_size())
        set ls.defined: false
        set ls.link_rules: Array[pointer[Array[pointer[SourceLinkRule]]]]^host()
        var n: size_t 0
        if dtd <> null
            set n: dtd.n_element_type_index()
        var i: size_t 0
        while i < n
        {
            ls.link_rules.add(null as pointer[Array[pointer[SourceLinkRule]]])
            set i: i + 1
        }
        set ls.implied_rules: Array[pointer[SourceLinkRule]]^host()
        ls
    }

    function get_name(this: LinkSet) returns StringC
        name

    function is_defined(this: LinkSet) returns bool
        defined

    function set_defined(this: ref[LinkSet])
        set this.defined: true

    function add_link_rule(this: ref[LinkSet], host: pointer[Page], e: ref[ElementType], rule: ref[SourceLinkRule])
    {
        let idx e.get_index()
        while this.link_rules.get_length() <= idx
            this.link_rules.add(null as pointer[Array[pointer[SourceLinkRule]]])
        var slot *(this.link_rules.get_buffer() + idx)
        if slot = null
        {
            set slot: Array[pointer[SourceLinkRule]]^host()
            this.link_rules.put(idx, slot)
        }
        slot.add(rule)
    }

    function n_link_rules(this: LinkSet, e: ref[ElementType]) returns size_t
    {
        let idx e.get_index()
        if idx >= link_rules.get_length()
            return 0 as size_t
        let slot *(link_rules.get_buffer() + idx)
        if slot = null
            return 0 as size_t
        slot.get_length()
    }

    function link_rule(this: LinkSet, e: ref[ElementType], i: size_t) returns ref[SourceLinkRule]
    {
        let slot *(link_rules.get_buffer() + e.get_index())
        *(slot.get_buffer() + i)
    }

    ; LinkSet::addImplied — record the result spec of an `#IMPLIED source` rule.
    function add_implied(this: ref[LinkSet], host: pointer[Page], e: ref[ElementType], atts: ref[AttributeList])
    {
        let r SourceLinkRule.make(host)
        r.set_result(e, atts)
        this.implied_rules.add(r)
    }

    function n_implied_link_rules(this: LinkSet) returns size_t
        implied_rules.get_length()

    function implied_link_rule(this: LinkSet, i: size_t) returns ref[SourceLinkRule]
        *(implied_rules.get_buffer() + i)

    ; LinkSet::impliedResultAttributes — whether a result spec for this result
    ; element type already exists (duplicateImpliedResult's test).
    function has_implied_result(this: LinkSet, result_type: ref[ElementType]) returns bool
    {
        let n implied_rules.get_length()
        var i: size_t 0
        while i < n
        {
            let r *(implied_rules.get_buffer() + i)
            if r.get_result_type() = result_type
                return true
            set i: i + 1
        }
        false
    }
}

; NamedTable<LinkSet> — the OpenSP OwnerTable/Hash open-addressing port (the
; IdTable pattern): iteration order = ascending bucket index, load-bearing for
; parseLinktypeDeclEnd's undefined-link-set sweep.
define LinkSetTable
(
    vec: pointer[pointer[LinkSet]]
    vec_size: size_t
    used: size_t
    used_limit: size_t
)
{
    function make(host: pointer[Page]) returns ref[LinkSetTable]
    {
        let t host.allocate(sizeof LinkSetTable, alignof LinkSetTable) as pointer[LinkSetTable]
        set t.vec: null
        set t.vec_size: 0
        set t.used: 0
        set t.used_limit: 0
        t
    }

    ; Hash::hash — h*33 + char.
    function hash(name: StringC) returns u64
    {
        var h: u64 0
        let n name.get_size()
        var i: size_t 0
        while i < n
        {
            set h: (h << 5) + h + (name.get(i) as u64)
            set i: i + 1
        }
        h
    }

    function start_index(this: LinkSetTable, name: StringC) returns size_t
        (LinkSetTable.hash(name) & ((vec_size - 1) as u64)) as size_t

    function next_index(this: LinkSetTable, i: size_t) returns size_t
    {
        if i = 0
            return vec_size - 1
        i - 1
    }

    function alloc_vec(host: pointer[Page], n: size_t) returns pointer[pointer[LinkSet]]
    {
        let v host.allocate(n * (sizeof pointer[LinkSet]), alignof pointer[LinkSet]) as pointer[pointer[LinkSet]]
        var i: size_t 0
        while i < n
        {
            set *(v + i): null
            set i: i + 1
        }
        v
    }

    function lookup(this: LinkSetTable, name: StringC) returns ref[LinkSet]?
    {
        if used = 0
            return null
        var i this.start_index(name)
        while *(vec + i) <> null
        {
            let ls *(vec + i)
            let lsname ls.get_name()
            if lsname.equals(name)
                return ls
            set i: this.next_index(i)
        }
        null
    }

    function insert(this: ref[LinkSetTable], host: pointer[Page], ls: ref[LinkSet])
    {
        var h: size_t 0
        if this.vec_size = 0
        {
            set this.vec: LinkSetTable.alloc_vec(host, 8)
            set this.vec_size: 8
            set this.used_limit: 4
            set h: (*this).start_index(ls.get_name())
        }
        else
        {
            set h: (*this).start_index(ls.get_name())
            while *(this.vec + h) <> null
                set h: (*this).next_index(h)
            if this.used >= this.used_limit
            {
                let old_vec this.vec
                let old_size this.vec_size
                set this.vec: LinkSetTable.alloc_vec(host, old_size * 2)
                set this.vec_size: old_size * 2
                set this.used_limit: this.vec_size / 2
                var oi: size_t 0
                while oi < old_size
                {
                    let e *(old_vec + oi)
                    if e <> null
                    {
                        var j (*this).start_index(e.get_name())
                        while *(this.vec + j) <> null
                            set j: (*this).next_index(j)
                        set *(this.vec + j): e
                    }
                    set oi: oi + 1
                }
                set h: (*this).start_index(ls.get_name())
                while *(this.vec + h) <> null
                    set h: (*this).next_index(h)
            }
        }
        set this.used: this.used + 1
        set *(this.vec + h): ls
    }

    ; the sweep surface (ConstNamedTableIter): ascending bucket index, callers
    ; skip nulls.
    function bucket_count(this: LinkSetTable) returns size_t
        vec_size

    function bucket_at(this: LinkSetTable, i: size_t) returns ref[LinkSet]
        *(vec + i)
}

; IdLinkRuleGroup (Lpd.h:137) — the ID link rules sharing one unique id.
define IdLinkRuleGroup
(
    name: StringC
    rules: ref[Array[pointer[SourceLinkRule]]]
)
{
    function make(host: pointer[Page], name: StringC) returns ref[IdLinkRuleGroup]
    {
        let g host.allocate(sizeof IdLinkRuleGroup, alignof IdLinkRuleGroup) as pointer[IdLinkRuleGroup]
        set g.name: StringC^host(name.data_ptr(), name.get_size())
        set g.rules: Array[pointer[SourceLinkRule]]^host()
        g
    }

    function get_name(this: IdLinkRuleGroup) returns StringC
        name

    function n_link_rules(this: IdLinkRuleGroup) returns size_t
        rules.get_length()

    function link_rule(this: IdLinkRuleGroup, i: size_t) returns ref[SourceLinkRule]
        *(rules.get_buffer() + i)

    function add_link_rule(this: ref[IdLinkRuleGroup], rule: ref[SourceLinkRule])
        this.rules.add(rule)
}

; NamedTable<IdLinkRuleGroup> — same table shape (lookup only, never swept).
define IdLinkTable
(
    vec: pointer[pointer[IdLinkRuleGroup]]
    vec_size: size_t
    used: size_t
    used_limit: size_t
)
{
    function make(host: pointer[Page]) returns ref[IdLinkTable]
    {
        let t host.allocate(sizeof IdLinkTable, alignof IdLinkTable) as pointer[IdLinkTable]
        set t.vec: null
        set t.vec_size: 0
        set t.used: 0
        set t.used_limit: 0
        t
    }

    function start_index(this: IdLinkTable, name: StringC) returns size_t
        (LinkSetTable.hash(name) & ((vec_size - 1) as u64)) as size_t

    function next_index(this: IdLinkTable, i: size_t) returns size_t
    {
        if i = 0
            return vec_size - 1
        i - 1
    }

    function alloc_vec(host: pointer[Page], n: size_t) returns pointer[pointer[IdLinkRuleGroup]]
    {
        let v host.allocate(n * (sizeof pointer[IdLinkRuleGroup]), alignof pointer[IdLinkRuleGroup]) as pointer[pointer[IdLinkRuleGroup]]
        var i: size_t 0
        while i < n
        {
            set *(v + i): null
            set i: i + 1
        }
        v
    }

    function lookup(this: IdLinkTable, name: StringC) returns ref[IdLinkRuleGroup]?
    {
        if used = 0
            return null
        var i this.start_index(name)
        while *(vec + i) <> null
        {
            let g *(vec + i)
            let gname g.get_name()
            if gname.equals(name)
                return g
            set i: this.next_index(i)
        }
        null
    }

    function insert(this: ref[IdLinkTable], host: pointer[Page], g: ref[IdLinkRuleGroup])
    {
        var h: size_t 0
        if this.vec_size = 0
        {
            set this.vec: IdLinkTable.alloc_vec(host, 8)
            set this.vec_size: 8
            set this.used_limit: 4
            set h: (*this).start_index(g.get_name())
        }
        else
        {
            set h: (*this).start_index(g.get_name())
            while *(this.vec + h) <> null
                set h: (*this).next_index(h)
            if this.used >= this.used_limit
            {
                let old_vec this.vec
                let old_size this.vec_size
                set this.vec: IdLinkTable.alloc_vec(host, old_size * 2)
                set this.vec_size: old_size * 2
                set this.used_limit: this.vec_size / 2
                var oi: size_t 0
                while oi < old_size
                {
                    let e *(old_vec + oi)
                    if e <> null
                    {
                        var j (*this).start_index(e.get_name())
                        while *(this.vec + j) <> null
                            set j: (*this).next_index(j)
                        set *(this.vec + j): e
                    }
                    set oi: oi + 1
                }
                set h: (*this).start_index(g.get_name())
                while *(this.vec + h) <> null
                    set h: (*this).next_index(h)
            }
        }
        set this.used: this.used + 1
        set *(this.vec + h): g
    }
}

; Lpd — the flat tagged struct (see the header note). SIMPLE uses
; attribute_def; IMPLICIT/EXPLICIT use the complex half.
define Lpd
(
    kind: int
    name: StringC
    location: Location
    active: bool
    source_dtd: ref[Dtd]
    ; SimpleLpd (Attributed):
    attribute_def: ref[AttributeDefinitionList]?
    ; ComplexLpd:
    result_dtd: ref[Dtd]?
    ; per source-element type index: the link attribute definitions
    ; (ComplexLpd::linkAttributeDefs_), grown on demand like LinkSet's rules.
    link_attribute_defs: ref[Array[pointer[AttributeDefinitionList]]]?
    link_sets: ref[LinkSetTable]?
    initial_link_set: ref[LinkSet]?
    empty_link_set: ref[LinkSet]?
    had_id_link_set: bool
    id_links: ref[IdLinkTable]?
    n_attribute_definition_list: size_t
)
{
    ; SimpleLpd ctor. Deep-copies the name (a swapped parm token).
    function make_simple(host: pointer[Page], name: StringC, loc: Location, source_dtd: ref[Dtd]) returns ref[Lpd]
    {
        let l host.allocate(sizeof Lpd, alignof Lpd) as pointer[Lpd]
        set l.kind: LPD_SIMPLE
        set l.name: StringC^host(name.data_ptr(), name.get_size())
        set l.location: loc
        set l.active: false
        set l.source_dtd: source_dtd
        set l.attribute_def: null
        set l.result_dtd: null
        set l.link_attribute_defs: null
        set l.link_sets: null
        set l.initial_link_set: null
        set l.empty_link_set: null
        set l.had_id_link_set: false
        set l.id_links: null
        set l.n_attribute_definition_list: 0
        l
    }

    ; ComplexLpd ctor. initial_name/empty_name are the syntax's RNI-prefixed
    ; INITIAL/EMPTY reserved names (the caller renders them — Lpd cannot see
    ; Syntax, declared later? no: Syntax precedes; passed to keep the ctor
    ; signature flat like the reference's syntax handle).
    function make_complex(host: pointer[Page], name: StringC, kind: int, loc: Location, initial_name: StringC, empty_name: StringC, source_dtd: ref[Dtd], result_dtd: ref[Dtd]) returns ref[Lpd]
    {
        let l host.allocate(sizeof Lpd, alignof Lpd) as pointer[Lpd]
        set l.kind: kind
        set l.name: StringC^host(name.data_ptr(), name.get_size())
        set l.location: loc
        set l.active: false
        set l.source_dtd: source_dtd
        set l.attribute_def: null
        set l.result_dtd: result_dtd
        set l.link_attribute_defs: Array[pointer[AttributeDefinitionList]]^host()
        var n: size_t 0
        if source_dtd <> null
            set n: source_dtd.n_element_type_index()
        var i: size_t 0
        while i < n
        {
            l.link_attribute_defs.add(null as pointer[AttributeDefinitionList])
            set i: i + 1
        }
        set l.link_sets: LinkSetTable.make(host)
        set l.initial_link_set: LinkSet.make(host, initial_name, source_dtd)
        set l.empty_link_set: LinkSet.make(host, empty_name, source_dtd)
        set l.had_id_link_set: false
        set l.id_links: IdLinkTable.make(host)
        set l.n_attribute_definition_list: 0
        l
    }

    function get_kind(this: Lpd) returns int
        kind

    function get_name(this: Lpd) returns StringC
        name

    function get_location(this: Lpd) returns Location
        location

    function is_active(this: Lpd) returns bool
        active

    function activate(this: ref[Lpd])
        set this.active: true

    function get_source_dtd(this: Lpd) returns ref[Dtd]
        source_dtd

    function get_result_dtd(this: Lpd) returns ref[Dtd]
        result_dtd

    ; ---- SimpleLpd (Attributed) ----
    function get_attribute_def(this: Lpd) returns ref[AttributeDefinitionList]
        attribute_def

    function set_attribute_def(this: ref[Lpd], adl: ref[AttributeDefinitionList])
        set this.attribute_def: adl

    ; ---- ComplexLpd ----
    function alloc_attribute_definition_list_index(this: ref[Lpd]) returns size_t
    {
        let i this.n_attribute_definition_list
        set this.n_attribute_definition_list: i + 1
        i
    }

    function initial_link_set_of(this: Lpd) returns ref[LinkSet]
        initial_link_set

    function empty_link_set_of(this: Lpd) returns ref[LinkSet]
        empty_link_set

    function lookup_link_set(this: Lpd, name: StringC) returns ref[LinkSet]
        link_sets.lookup(name)

    function insert_link_set(this: ref[Lpd], host: pointer[Page], ls: ref[LinkSet])
        this.link_sets.insert(host, ls)

    function get_link_sets(this: Lpd) returns ref[LinkSetTable]
        link_sets

    function had_id_link_set_of(this: Lpd) returns bool
        had_id_link_set

    function set_had_id_link_set(this: ref[Lpd])
        set this.had_id_link_set: true

    function lookup_id_link(this: Lpd, id: StringC) returns ref[IdLinkRuleGroup]
        id_links.lookup(id)

    ; ComplexLpd::lookupCreateIdLink.
    function lookup_create_id_link(this: ref[Lpd], host: pointer[Page], id: StringC) returns ref[IdLinkRuleGroup]
    {
        let found (*this).lookup_id_link(id)
        if found <> null
            return found
        let g IdLinkRuleGroup.make(host, id)
        this.id_links.insert(host, g)
        g
    }

    ; ComplexLpd::attributeDef(e) — null when unset (or index out of range).
    function link_attribute_def(this: Lpd, e: ref[ElementType]) returns ref[AttributeDefinitionList]?
    {
        let idx e.get_index()
        if idx >= link_attribute_defs.get_length()
            return null
        *(link_attribute_defs.get_buffer() + idx)
    }

    function set_link_attribute_def(this: ref[Lpd], e: ref[ElementType], adl: ref[AttributeDefinitionList])
    {
        let idx e.get_index()
        while this.link_attribute_defs.get_length() <= idx
            this.link_attribute_defs.add(null as pointer[AttributeDefinitionList])
        this.link_attribute_defs.put(idx, adl)
    }
}
