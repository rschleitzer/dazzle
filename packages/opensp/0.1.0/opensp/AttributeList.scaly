use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.Syntax.Syntax
use opensp.Sd.Sd
use opensp.Location.Location
use opensp.Attribute.Text
use opensp.Attribute.DeclaredValue
use opensp.Attribute.AttributeValue
use opensp.Attribute.AttributeDefinition
use opensp.Attribute.Attribute
use opensp.Attribute.AttributeContext
use opensp.Notation.Notation

; AttributeList — AttributeList.cs (AttributeDefinitionList, AttributeList) and
; Attributed.cs. The per-element-type list of attribute DEFINITIONS, the live
; per-element list of attribute VALUES, and the mix-in that holds a definition
; list (elements and notations are Attributed).
;
; PORT SHAPE: flat page-hosted structs (same rationale as Attribute.scaly). The
; C++ Owner/Ptr/ConstPtr sharing collapses to plain borrowed pointers in the
; one-region-per-run arena. The value-PRODUCTION paths that need the full
; content Text + live parser context (setValue/setValueToken/recoverUnquoted/
; handleAsUnterminated, and the makeSemantics half of finish) land with the
; parser stage; this increment ports the structural bookkeeping, the missing-
; value fill of finish(), and the spec-index tracking.

; size_t(-1): "no ID / no notation attribute", and "no definition list index".
define ADL_NONE: size_t 0xFFFFFFFFFFFFFFFF

; --- AttributeDefinitionList ---------------------------------------------
define AttributeDefinitionList
(
    defs: ref[Array[ref[AttributeDefinition]?]]
    index: size_t
    id_index: size_t
    notation_index: size_t
    any_current: bool
)
{
    function make(host: ref[Page], index: size_t) returns ref[AttributeDefinitionList]
    {
        let l &AttributeDefinitionList^host(Array[ref[AttributeDefinition]?]^host(), index, ADL_NONE, ADL_NONE, false)
        l
    }

    ; AttributeDefinitionList(const ConstPtr<AttributeDefinitionList>&) — the copy
    ; parseAttributeValueSpec makes before appending an implied definition for an
    ; undeclared attribute (IMPLYDEF ATTLIST): the element's own list is shared
    ; (the DTD's implicit one is shared by EVERY undefined element), so it must
    ; never be grown in place. The definitions themselves are immutable and are
    ; aliased, not cloned. The index is reassigned by the caller.
    function copy(host: ref[Page], src: ref[AttributeDefinitionList]?) returns ref[AttributeDefinitionList]
    {
        let l AttributeDefinitionList.make(host, ADL_NONE)
        if src = null
            return l
        let n src.size()
        var i: size_t 0
        while i < n
        {
            let d src.def(i)
            l.append(d)
            set i: i + 1
        }
        l
    }

    function size(this: AttributeDefinitionList) returns size_t
        defs.get_length()

    function def(this: AttributeDefinitionList, i: size_t) returns ref[AttributeDefinition]?
        defs[i]

    ; AttributeDefinitionList::append — track id/notation/current as they arrive.
    function append(this: ref[AttributeDefinitionList], d: ref[AttributeDefinition]?)
    {
        if d <> null
        {
            if d.is_id() and (this.id_index = ADL_NONE)
                set this.id_index: this.defs.get_length()
            if d.is_notation() and (this.notation_index = ADL_NONE)
                set this.notation_index: this.defs.get_length()
            if d.is_current()
                set this.any_current: true
        }
        this.defs.add(d)
    }

    ; attributeIndex — index of the definition named `name`, or -1.
    function attribute_index(this: AttributeDefinitionList, name: StringC) returns int
    {
        let n defs.get_length()
        var i: size_t 0
        while i < n
        {
            let d defs[i]
            if d <> null
            {
                if d.get_name().equals(name)
                    return i as int
            }
            set i: i + 1
        }
        -1
    }

    ; tokenIndex — index of the definition whose group contains `token`, or -1.
    function token_index(this: AttributeDefinitionList, token: StringC) returns int
    {
        let n defs.get_length()
        var i: size_t 0
        while i < n
        {
            let d defs[i]
            if d <> null
            {
                if d.contains_token(token)
                    return i as int
            }
            set i: i + 1
        }
        -1
    }

    function token_index_unique(this: AttributeDefinitionList, token: StringC, i: int) returns bool
    {
        let n defs.get_length()
        var j: size_t (i as size_t) + 1
        while j < n
        {
            let d defs[j]
            if d <> null
            {
                if d.contains_token(token)
                    return false
            }
            set j: j + 1
        }
        true
    }

    function get_index(this: AttributeDefinitionList) returns size_t
        index

    function set_index(this: ref[AttributeDefinitionList], index: size_t)
        set this.index: index

    function get_id_index(this: AttributeDefinitionList) returns size_t
        id_index

    ; parseAttlistDecl passes idIndex/notationIndex into the ctor explicitly
    ; (parseDecl.cxx:1016) with LAST-wins semantics from its tracking loop —
    ; append()'s first-wins auto-tracking is overridden by these setters there.
    function set_id_index(this: ref[AttributeDefinitionList], i: size_t)
        set this.id_index: i

    function set_notation_index(this: ref[AttributeDefinitionList], i: size_t)
        set this.notation_index: i

    function get_notation_index(this: AttributeDefinitionList) returns size_t
        notation_index

    function get_any_current(this: AttributeDefinitionList) returns bool
        any_current

    function test() returns int
    {
        let host Page.get(StringC("x").data_ptr())

        let adl AttributeDefinitionList.make(host, 0)

        ; append an implied CDATA "class", then a required ID "id".
        let cdv DeclaredValue.make_cdata(host)
        let a0 AttributeDefinition.make_implied(host, StringC("class"), cdv)
        adl.append(a0)
        if adl.get_id_index() <> ADL_NONE
            return -1

        let idv DeclaredValue.make_id(host)
        let a1 AttributeDefinition.make_required(host, StringC("id"), idv)
        adl.append(a1)
        if adl.size() <> 2
            return -2
        if adl.get_id_index() <> 1
            return -3
        if adl.get_notation_index() <> ADL_NONE
            return -4

        ; a CURRENT attribute flips any_current.
        let ndv DeclaredValue.make_cdata(host)
        let a2 AttributeDefinition.make_current(host, StringC("lang"), ndv, 0)
        adl.append(a2)
        if adl.get_any_current() = false
            return -5

        ; lookups
        if adl.attribute_index(StringC("id")) <> 1
            return -6
        if adl.attribute_index(StringC("missing")) <> (0 - 1)
            return -7

        0
    }
}

; --- AttributeList --------------------------------------------------------
define AttributeList
(
    conref: bool
    n_idrefs: u32
    n_entity_names: u32
    n_spec: size_t
    vec: ref[Array[ref[Attribute]?]]
    def: ref[AttributeDefinitionList]?
)
{
    function make(host: ref[Page], def: ref[AttributeDefinitionList]?) returns ref[AttributeList]
    {
        let a &AttributeList^host(false, 0, 0, 0, Array[ref[Attribute]?]^host(), def)
        var sz: size_t 0
        if def <> null
            set sz: def.size()
        var i: size_t 0
        while i < sz
        {
            a.vec.add(Attribute.make(host))
            set i: i + 1
        }
        a
    }

    function def_private(this: AttributeList, i: size_t) returns ref[AttributeDefinition]?
    {
        if def = null
            return null
        def.def(i)
    }

    function attribute(this: AttributeList, i: size_t) returns ref[Attribute]?
        vec[i]

    ; The definition behind slot i — the parser's checkValue/missing-value
    ; ports dispatch on its kind (null for an index past the definition list).
    function definition(this: AttributeList, i: size_t) returns ref[AttributeDefinition]?
        def_private(i)

    function size(this: AttributeList) returns size_t
        vec.get_length()

    function conref_of(this: AttributeList) returns bool
        conref

    function n_spec_of(this: AttributeList) returns size_t
        n_spec

    function name(this: AttributeList, i: size_t) returns StringC
    {
        let d def_private(i)
        if d = null
            return StringC()
        d.get_name()
    }

    function value(this: AttributeList, i: size_t) returns ref[AttributeValue]?
        attribute(i).get_value()

    function spec_index(this: AttributeList, i: size_t) returns size_t
        attribute(i).spec_index()

    function tokenized(this: AttributeList, i: size_t) returns bool
    {
        let d def_private(i)
        if d = null
            return false
        d.tokenized()
    }

    function specified(this: AttributeList, i: size_t) returns bool
        attribute(i).specified()

    function id(this: AttributeList, i: size_t) returns bool
    {
        let d def_private(i)
        if d = null
            return false
        d.is_id()
    }

    function idref(this: AttributeList, i: size_t) returns bool
    {
        let d def_private(i)
        if d = null
            return false
        d.is_idref()
    }

    ; entity-declared value (ENTITY/ENTITIES) — also selects the ENTITY subst
    ; table in set_value (entity names are not namecase-folded).
    function entity(this: AttributeList, i: size_t) returns bool
    {
        let d def_private(i)
        if d = null
            return false
        d.is_entity()
    }

    function notation(this: AttributeList, i: size_t) returns bool
    {
        let d def_private(i)
        if d = null
            return false
        d.is_notation()
    }

    ; nEntityNames accumulation (EntityDeclaredValue::makeSemantics adds the
    ; value's token count; finish checks the total against GRPCNT).
    function add_entity_names(this: ref[AttributeList], n: u32)
        set this.n_entity_names: this.n_entity_names + n

    ; nIdrefs accumulation (IdrefDeclaredValue::makeSemantics, Attribute.cxx:564).
    function add_idrefs(this: ref[AttributeList], n: u32)
        set this.n_idrefs: this.n_idrefs + n

    function n_idrefs_of(this: AttributeList) returns u32
        n_idrefs

    function n_entity_names_of(this: AttributeList) returns u32
        n_entity_names

    ; the definition's DeclaredValue (category/group info for makeValue checks).
    function declared_value(this: AttributeList, i: size_t) returns ref[DeclaredValue]?
    {
        let d def_private(i)
        if d = null
            return null
        d.get_declared_value()
    }

    function current(this: AttributeList, i: size_t) returns bool
    {
        let d def_private(i)
        if d = null
            return false
        d.is_current()
    }

    function any_current(this: AttributeList) returns bool
    {
        if def = null
            return false
        def.get_any_current()
    }

    function attribute_index(this: AttributeList, name: StringC) returns int
    {
        if def = null
            return -1
        def.attribute_index(name)
    }

    function token_index(this: AttributeList, name: StringC) returns int
    {
        if def = null
            return -1
        def.token_index(name)
    }

    ; no LATER definition also declares `token` (WebSGML uniqueness check).
    function token_index_unique(this: AttributeList, token: StringC, i: int) returns bool
    {
        if def = null
            return true
        def.token_index_unique(token, i)
    }

    function get_allowed_tokens(this: AttributeList, i: size_t) returns ref[Array[StringC]]?
    {
        let d def_private(i)
        if d = null
            return null
        d.get_tokens()
    }

    function def_index(this: AttributeList) returns size_t
    {
        if def = null
            return ADL_NONE
        def.get_index()
    }

    ; getId — the ID attribute's value string, or empty if none/implied.
    function get_id(this: AttributeList) returns StringC
    {
        if def = null
            return StringC()
        let i def.get_id_index()
        if i = ADL_NONE
            return StringC()
        let v value(i)
        if v = null
            return StringC()
        let t (*v).get_text()
        if t = null
            return StringC()
        (*t).string()
    }

    ; setSpec — record that attribute `index` was specified (or a duplicate).
    function set_spec(this: ref[AttributeList], index: size_t, context: ref[AttributeContext])
    {
        let a this.vec[index]
        if a.specified()
            context.message()
        else
        {
            a.set_spec(this.n_spec)
            set this.n_spec: this.n_spec + 1
        }
    }

    function note_invalid_spec(this: ref[AttributeList])
    {
        if this.n_spec > 0
            set this.n_spec: this.n_spec + 1
    }

    ; setValue — build the AttributeValue for a specified attribute from its
    ; parsed Text. CDATA -> verbatim; tokenized -> whitespace-separated tokens
    ; (space_index over the normalized text; null when single-token). The
    ; makeSemantics half (id/idref/entity/notation resolution + messages) runs
    ; parser-side right after (Parser.check_value_semantics), as do the
    ; makeValue validation checks (Parser.validate_attribute_value: token
    ; category/NAMELEN/normalized-length, group membership).
    function set_value(this: ref[AttributeList], host: ref[Page], index: size_t, text: ref[Text], context: ref[AttributeContext]) returns bool
    {
        let a this.vec[index]
        var v: ref[AttributeValue]? null
        if this.tokenized(index)
        {
            ; NAMECASE fold: a tokenized attribute value is substituted through
            ; the general subst table (TokenizedDeclaredValue::makeTokenizedValue)
            ; — EXCEPT entity-name values, which go through entitySubstTable:
            ; NAMECASE ENTITY NO (both supported syntaxes) = identity, so an
            ; ENTITY attribute value keeps its case (verified: real onsgmls
            ; prints `A... ENTITY pic` unfolded and rejects a case-mismatched
            ; name). FOLD ONLY — the literalSingleSpace normalization
            ; (collapse, leading/trailing drop — char-ref spaces included)
            ; already happened in parse_literal (talitMode), faithful to
            ; parseCommon.cxx; re-normalizing here would be invention.
            let fold_general this.entity(index) = false
            let syn context.attribute_syntax()
            let raw0 text.string()
            let rn raw0.get_size()
            if rn > 0
            {
                let fbuf allocate_slice[u32](host, rn)
                ; per-char locations ride along through the fold; the ID/IDREF
                ; messages point at value-TOKEN locations. Copied via the raw
                ; locs pointer, never a by-value accessor return — a struct
                ; returned by value reads as local-page to the escape checker
                ; (S19 lore). Untracked text stays untracked.
                let tlocs text.get_locs()
                var lbuf: pointer[Location] null
                if tlocs <> null
                    set lbuf: host.allocate(rn * sizeof Location, alignof Location) as pointer[Location]
                var fi: size_t 0
                while fi < rn
                {
                    var c raw0.get(fi)
                    if fold_general
                        set c: syn.fold(c)
                    fbuf.put(fi, c)
                    if lbuf <> null
                        set *(lbuf + fi): *(tlocs + fi)
                    set fi: fi + 1
                }
                set text: Text(StringC^host(fbuf), lbuf)
            }
            let s text.string()
            let n s.get_size()
            var has_space false
            var i: size_t 0
            while i < n
            {
                if s.get(i) = 0x20
                    set has_space: true
                set i: i + 1
            }
            if has_space
            {
                let space_idx Array[size_t]^host()
                var j: size_t 0
                while j < n
                {
                    if s.get(j) = 0x20
                        space_idx.add(j)
                    set j: j + 1
                }
                set v: AttributeValue.make_tokenized(host, text, space_idx)
            }
            else
                set v: AttributeValue.make_tokenized(host, text, null)
        }
        else
        {
            ; DataDeclaredValue::makeValue — a DATA declared value's CDATA
            ; carries the notation + the shared data-attribute list.
            let dvp this.declared_value(index)
            var dnt: ref[Notation]? null
            if dvp <> null
                set dnt: dvp.get_data_notation()
            if dnt <> null
                set v: AttributeValue.make_cdata_data(host, text, dnt, dvp.get_data_attributes())
            else
                set v: AttributeValue.make_cdata(host, text)
        }
        a.set_value(v)
        true
    }

    function get_def(this: AttributeList) returns ref[AttributeDefinitionList]?
        def

    ; the finish-tail conrefNotation condition (Attribute.cxx:1267): CONREF
    ; was specified AND the list has a NOTATION attribute that was specified.
    function conref_notation_specified(this: AttributeList) returns bool
    {
        if conref = false
            return false
        if def = null
            return false
        let ni def.get_notation_index()
        if ni = ADL_NONE
            return false
        specified(ni)
    }

    ; AttributeList::changeDef — adopt a grown definition list (vec_.resize):
    ; the already-parsed attributes KEEP their slots (and their values), the new
    ; definitions get fresh ones. Rebuilding the vector here would drop every
    ; attribute specified earlier in the same start tag.
    function change_def(this: ref[AttributeList], host: ref[Page], def: ref[AttributeDefinitionList]?)
    {
        var sz: size_t 0
        if def <> null
            set sz: def.size()
        var i this.vec.get_length()
        while i < sz
        {
            this.vec.add(Attribute.make(host))
            set i: i + 1
        }
        set this.def: def
    }

    ; AttributeList::finish — fill in the values of unspecified attributes from
    ; their definitions' missing-value rule. The makeSemantics half (idref /
    ; entity / notation resolution) needs the live parser context and lands with
    ; the parser stage; the grpcnt overflow + conref/notation checks are kept.
    function finish(this: ref[AttributeList], context: ref[AttributeContext])
    {
        let n this.vec.get_length()
        var i: size_t 0
        while i < n
        {
            let a this.vec[i]
            if a.specified() = false
            {
                let d this.def_private(i)
                if d <> null
                {
                    var skip false
                    if this.conref
                    {
                        if this.def.get_notation_index() = i
                            set skip: true
                    }
                    if skip = false
                        a.set_value(d.make_missing_value(context))
                }
            }
            set i: i + 1
        }
        ; the GRPCNT/conrefNotation tail of the reference finish runs
        ; parser-side (Parser.check_missing_semantics — it needs the live
        ; reporter and must see the defaulted values' entity-name counts);
        ; the synthetic-context stub only counts.
        let syntax context.attribute_syntax()
        let grpcnt (*syntax).get_quantity(qGRPCNT)
        if this.n_idrefs > grpcnt
            context.message()
        if this.n_entity_names > grpcnt
            context.message()
    }

    function test() returns int
    {
        let host Page.get(StringC("x").data_ptr())
        let syn &Syntax^host(Sd())

        ; definition list: implied CDATA "class" (0), required ID "id" (1).
        let adl AttributeDefinitionList.make(host, 0)
        let cdv DeclaredValue.make_cdata(host)
        adl.append(AttributeDefinition.make_implied(host, StringC("class"), cdv))
        let idv DeclaredValue.make_id(host)
        adl.append(AttributeDefinition.make_required(host, StringC("id"), idv))

        let al AttributeList.make(host, adl)
        if al.size() <> 2
            return -1
        if al.name(1).equals(StringC("id")) = false
            return -2
        if al.id(1) = false
            return -3
        if al.attribute_index(StringC("class")) <> 0
            return -4

        ; nothing specified yet.
        if al.specified(0)
            return -5

        let ctx AttributeContext.make(host, syn, true, false)

        ; specify "class" (index 0); n_spec advances, duplicate is a message.
        al.set_spec(0, ctx)
        if al.specified(0) = false
            return -6
        if al.n_spec_of() <> 1
            return -7
        al.set_spec(0, ctx)
        if ctx.n_messages <> 1
            return -8

        ; finish: unspecified "class" is already specified; "id" is required and
        ; unspecified -> makeMissingValue emits a message and leaves null.
        al.finish(ctx)
        if ctx.n_messages <> 2
            return -9
        if al.value(1) <> null
            return -10

        ; no ID value present -> get_id empty.
        if al.get_id().get_size() <> 0
            return -11

        0
    }
}

; --- Attributed -----------------------------------------------------------
; The mix-in for things with attribute definitions (elements, notations).
define Attributed (attribute_def: ref[AttributeDefinitionList]?)
{
    init()
    {
        set attribute_def: null
    }

    function make(host: ref[Page]) returns ref[Attributed]
    {
        let a &Attributed^host(null)
        a
    }

    function get_attribute_def(this: Attributed) returns ref[AttributeDefinitionList]?
        attribute_def

    function set_attribute_def(this: ref[Attributed], def: ref[AttributeDefinitionList]?)
        set this.attribute_def: def

    function test() returns int
    {
        let host Page.get(StringC("x").data_ptr())
        let at Attributed.make(host)
        if at.get_attribute_def() <> null
            return -1
        let adl AttributeDefinitionList.make(host, 3)
        at.set_attribute_def(adl)
        if at.get_attribute_def() <> adl
            return -2
        if at.get_attribute_def().get_index() <> 3
            return -3
        0
    }
}
