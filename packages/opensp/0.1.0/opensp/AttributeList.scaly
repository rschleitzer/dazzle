use scaly.memory.Page
use scaly.containers.Array
use opensp.StringC.StringC
use opensp.Syntax.Syntax
use opensp.Sd.Sd
use opensp.Attribute.Text
use opensp.Attribute.DeclaredValue
use opensp.Attribute.AttributeValue
use opensp.Attribute.AttributeDefinition
use opensp.Attribute.Attribute
use opensp.Attribute.AttributeContext

; AttributeList — AttributeList.cs (AttributeDefinitionList, AttributeList) and
; Attributed.cs. The per-element-type list of attribute DEFINITIONS, the live
; per-element list of attribute VALUES, and the mix-in that holds a definition
; list (elements and notations are Attributed).
;
; PORT SHAPE: flat page-hosted structs (same rationale as Attribute.scaly). The
; C++ Owner/Ptr/ConstPtr sharing collapses to plain borrowed pointers in the
; one-region-per-run arena. The value-PRODUCTION paths that need the full
; content Text + live parser context (setValue/setValueToken/recoverUnquoted/
; handleAsUnterminated, and the makeSemantics half of finish) land with the
; parser stage; this increment ports the structural bookkeeping, the missing-
; value fill of finish(), and the spec-index tracking.

; size_t(-1): "no ID / no notation attribute", and "no definition list index".
define ADL_NONE: size_t 0xFFFFFFFFFFFFFFFF

; --- AttributeDefinitionList ---------------------------------------------
define AttributeDefinitionList
(
    defs: pointer[Array[pointer[AttributeDefinition]]]
    index: size_t
    id_index: size_t
    notation_index: size_t
    any_current: bool
)
{
    function make(host: pointer[Page], index: size_t) returns pointer[AttributeDefinitionList]
    {
        let l host.allocate(sizeof AttributeDefinitionList, alignof AttributeDefinitionList) as pointer[AttributeDefinitionList]
        set l.defs: Array[pointer[AttributeDefinition]]^host()
        set l.index: index
        set l.id_index: ADL_NONE
        set l.notation_index: ADL_NONE
        set l.any_current: false
        l
    }

    function size(this: AttributeDefinitionList) returns size_t
        defs.get_length()

    function def(this: AttributeDefinitionList, i: size_t) returns pointer[AttributeDefinition]
        *(defs.get_buffer() + i)

    ; AttributeDefinitionList::append — track id/notation/current as they arrive.
    function append(this: pointer[AttributeDefinitionList], d: pointer[AttributeDefinition])
    {
        if d <> null
        {
            if d.is_id() and (this.id_index = ADL_NONE)
                set this.id_index: this.defs.get_length()
            if d.is_notation() and (this.notation_index = ADL_NONE)
                set this.notation_index: this.defs.get_length()
            if d.is_current()
                set this.any_current: true
        }
        this.defs.add(d)
    }

    ; attributeIndex — index of the definition named `name`, or -1.
    function attribute_index(this: AttributeDefinitionList, name: StringC) returns int
    {
        let n defs.get_length()
        let buf defs.get_buffer()
        var i: size_t 0
        while i < n
        {
            let d *(buf + i)
            if d <> null
            {
                if d.get_name().equals(name)
                    return i as int
            }
            set i: i + 1
        }
        -1
    }

    ; tokenIndex — index of the definition whose group contains `token`, or -1.
    function token_index(this: AttributeDefinitionList, token: StringC) returns int
    {
        let n defs.get_length()
        let buf defs.get_buffer()
        var i: size_t 0
        while i < n
        {
            let d *(buf + i)
            if d <> null
            {
                if d.contains_token(token)
                    return i as int
            }
            set i: i + 1
        }
        -1
    }

    function token_index_unique(this: AttributeDefinitionList, token: StringC, i: int) returns bool
    {
        let n defs.get_length()
        let buf defs.get_buffer()
        var j: size_t (i as size_t) + (1 as size_t)
        while j < n
        {
            let d *(buf + j)
            if d <> null
            {
                if d.contains_token(token)
                    return false
            }
            set j: j + 1
        }
        true
    }

    function get_index(this: AttributeDefinitionList) returns size_t
        index

    function set_index(this: pointer[AttributeDefinitionList], index: size_t)
        set this.index: index

    function get_id_index(this: AttributeDefinitionList) returns size_t
        id_index

    function get_notation_index(this: AttributeDefinitionList) returns size_t
        notation_index

    function get_any_current(this: AttributeDefinitionList) returns bool
        any_current

    function test() returns int
    {
        let host Page.get(StringC("x").data_ptr() as pointer[void])

        let adl AttributeDefinitionList.make(host, 0 as size_t)

        ; append an implied CDATA "class", then a required ID "id".
        let cdv DeclaredValue.make_cdata(host)
        let a0 AttributeDefinition.make_implied(host, StringC("class"), cdv)
        adl.append(a0)
        if adl.get_id_index() <> ADL_NONE
            return -1

        let idv DeclaredValue.make_id(host)
        let a1 AttributeDefinition.make_required(host, StringC("id"), idv)
        adl.append(a1)
        if adl.size() <> (2 as size_t)
            return -2
        if adl.get_id_index() <> (1 as size_t)
            return -3
        if adl.get_notation_index() <> ADL_NONE
            return -4

        ; a CURRENT attribute flips any_current.
        let ndv DeclaredValue.make_cdata(host)
        let a2 AttributeDefinition.make_current(host, StringC("lang"), ndv, 0 as size_t)
        adl.append(a2)
        if adl.get_any_current() = false
            return -5

        ; lookups
        if adl.attribute_index(StringC("id")) <> 1
            return -6
        if adl.attribute_index(StringC("missing")) <> (0 - 1)
            return -7

        0
    }
}

; --- AttributeList --------------------------------------------------------
define AttributeList
(
    conref: bool
    n_idrefs: u32
    n_entity_names: u32
    n_spec: size_t
    vec: pointer[Array[pointer[Attribute]]]
    def: pointer[AttributeDefinitionList]
)
{
    function make(host: pointer[Page], def: pointer[AttributeDefinitionList]) returns pointer[AttributeList]
    {
        let a host.allocate(sizeof AttributeList, alignof AttributeList) as pointer[AttributeList]
        set a.conref: false
        set a.n_idrefs: 0 as u32
        set a.n_entity_names: 0 as u32
        set a.n_spec: 0 as size_t
        set a.def: def
        set a.vec: Array[pointer[Attribute]]^host()
        var sz: size_t 0
        if def <> null
            set sz: def.size()
        var i: size_t 0
        while i < sz
        {
            a.vec.add(Attribute.make(host))
            set i: i + 1
        }
        a
    }

    function def_private(this: AttributeList, i: size_t) returns pointer[AttributeDefinition]
    {
        if def = null
            return null
        def.def(i)
    }

    function attribute(this: AttributeList, i: size_t) returns pointer[Attribute]
        *(vec.get_buffer() + i)

    function size(this: AttributeList) returns size_t
        vec.get_length()

    function conref_of(this: AttributeList) returns bool
        conref

    function n_spec_of(this: AttributeList) returns size_t
        n_spec

    function name(this: AttributeList, i: size_t) returns StringC
    {
        let d def_private(i)
        if d = null
            return StringC()
        d.get_name()
    }

    function value(this: AttributeList, i: size_t) returns pointer[AttributeValue]
        attribute(i).get_value()

    function spec_index(this: AttributeList, i: size_t) returns size_t
        attribute(i).spec_index()

    function tokenized(this: AttributeList, i: size_t) returns bool
    {
        let d def_private(i)
        if d = null
            return false
        d.tokenized()
    }

    function specified(this: AttributeList, i: size_t) returns bool
        attribute(i).specified()

    function id(this: AttributeList, i: size_t) returns bool
    {
        let d def_private(i)
        if d = null
            return false
        d.is_id()
    }

    function idref(this: AttributeList, i: size_t) returns bool
    {
        let d def_private(i)
        if d = null
            return false
        d.is_idref()
    }

    function current(this: AttributeList, i: size_t) returns bool
    {
        let d def_private(i)
        if d = null
            return false
        d.is_current()
    }

    function any_current(this: AttributeList) returns bool
    {
        if def = null
            return false
        def.get_any_current()
    }

    function attribute_index(this: AttributeList, name: StringC) returns int
    {
        if def = null
            return -1
        def.attribute_index(name)
    }

    function token_index(this: AttributeList, name: StringC) returns int
    {
        if def = null
            return -1
        def.token_index(name)
    }

    ; no LATER definition also declares `token` (WebSGML uniqueness check).
    function token_index_unique(this: AttributeList, token: StringC, i: int) returns bool
    {
        if def = null
            return true
        def.token_index_unique(token, i)
    }

    function get_allowed_tokens(this: AttributeList, i: size_t) returns pointer[Array[StringC]]
    {
        let d def_private(i)
        if d = null
            return null
        d.get_tokens()
    }

    function def_index(this: AttributeList) returns size_t
    {
        if def = null
            return ADL_NONE
        def.get_index()
    }

    ; getId — the ID attribute's value string, or empty if none/implied.
    function get_id(this: AttributeList) returns StringC
    {
        if def = null
            return StringC()
        let i def.get_id_index()
        if i = ADL_NONE
            return StringC()
        let v value(i)
        if v = null
            return StringC()
        let t (*v).get_text()
        if t = null
            return StringC()
        (*t).string()
    }

    ; setSpec — record that attribute `index` was specified (or a duplicate).
    function set_spec(this: pointer[AttributeList], index: size_t, context: pointer[AttributeContext])
    {
        let a *(this.vec.get_buffer() + index)
        if a.specified()
            context.message()
        else
        {
            a.set_spec(this.n_spec)
            set this.n_spec: this.n_spec + (1 as size_t)
        }
    }

    function note_invalid_spec(this: pointer[AttributeList])
    {
        if this.n_spec > (0 as size_t)
            set this.n_spec: this.n_spec + (1 as size_t)
    }

    ; setValue — build the AttributeValue for a specified attribute from its
    ; parsed Text. CDATA -> verbatim; tokenized -> whitespace-separated tokens
    ; (space_index over the normalized text; null when single-token). The full
    ; makeValue VALIDATION (category/length checks, allowed-value/id/idref/entity/
    ; notation resolution + name folding) is DEFERRED with the message-emitting
    ; stage; this produces the normalized value string the event stream needs.
    function set_value(this: pointer[AttributeList], host: pointer[Page], index: size_t, text: pointer[Text], context: pointer[AttributeContext]) returns bool
    {
        let a *(this.vec.get_buffer() + index)
        var v: pointer[AttributeValue] null
        if this.tokenized(index)
        {
            ; NAMECASE fold: a tokenized attribute value is substituted through
            ; the general subst table (TokenizedDeclaredValue::makeTokenizedValue).
            ; Entity-name values (entitySubstTable) are not yet distinguished —
            ; deferred; the corpus's tokenized values are general names/nametokens.
            let syn context.attribute_syntax()
            let raw0 (*text).string()
            let rn raw0.get_size()
            if rn > (0 as size_t)
            {
                let fbuf host.allocate(rn * (4 as size_t), 4) as pointer[u32]
                var fi: size_t 0
                while fi < rn
                {
                    set *(fbuf + fi): syn.fold(raw0.get(fi))
                    set fi: fi + 1
                }
                set *text: Text(StringC^host(fbuf, rn))
            }
            let s (*text).string()
            let n s.get_size()
            var has_space false
            var i: size_t 0
            while i < n
            {
                if s.get(i) = (0x20 as u32)
                    set has_space: true
                set i: i + 1
            }
            if has_space
            {
                let space_idx Array[size_t]^host()
                var j: size_t 0
                while j < n
                {
                    if s.get(j) = (0x20 as u32)
                        space_idx.add(j)
                    set j: j + 1
                }
                set v: AttributeValue.make_tokenized(host, text, space_idx)
            }
            else
                set v: AttributeValue.make_tokenized(host, text, null as pointer[Array[size_t]])
        }
        else
            set v: AttributeValue.make_cdata(host, text)
        a.set_value(v)
        true
    }

    function change_def(this: pointer[AttributeList], host: pointer[Page], def: pointer[AttributeDefinitionList])
    {
        var sz: size_t 0
        if def <> null
            set sz: def.size()
        set this.vec: Array[pointer[Attribute]]^host()
        var i: size_t 0
        while i < sz
        {
            this.vec.add(Attribute.make(host))
            set i: i + 1
        }
        set this.def: def
    }

    ; AttributeList::finish — fill in the values of unspecified attributes from
    ; their definitions' missing-value rule. The makeSemantics half (idref /
    ; entity / notation resolution) needs the live parser context and lands with
    ; the parser stage; the grpcnt overflow + conref/notation checks are kept.
    function finish(this: pointer[AttributeList], context: pointer[AttributeContext])
    {
        let n this.vec.get_length()
        var i: size_t 0
        while i < n
        {
            let a *(this.vec.get_buffer() + i)
            if a.specified() = false
            {
                let d this.def_private(i)
                if d <> null
                {
                    var skip false
                    if this.conref
                    {
                        if this.def.get_notation_index() = i
                            set skip: true
                    }
                    if skip = false
                        a.set_value(d.make_missing_value(context))
                }
            }
            set i: i + 1
        }
        let syntax context.attribute_syntax()
        let grpcnt (*syntax).get_quantity(qGRPCNT)
        if this.n_idrefs > grpcnt
            context.message()
        if this.n_entity_names > grpcnt
            context.message()
    }

    function test() returns int
    {
        let host Page.get(StringC("x").data_ptr() as pointer[void])
        let sd_syn Syntax(Sd())
        let syn host.allocate(sizeof Syntax, alignof Syntax) as pointer[Syntax]
        set *syn: sd_syn

        ; definition list: implied CDATA "class" (0), required ID "id" (1).
        let adl AttributeDefinitionList.make(host, 0 as size_t)
        let cdv DeclaredValue.make_cdata(host)
        adl.append(AttributeDefinition.make_implied(host, StringC("class"), cdv))
        let idv DeclaredValue.make_id(host)
        adl.append(AttributeDefinition.make_required(host, StringC("id"), idv))

        let al AttributeList.make(host, adl)
        if al.size() <> (2 as size_t)
            return -1
        if al.name(1 as size_t).equals(StringC("id")) = false
            return -2
        if al.id(1 as size_t) = false
            return -3
        if al.attribute_index(StringC("class")) <> 0
            return -4

        ; nothing specified yet.
        if al.specified(0 as size_t)
            return -5

        let ctx AttributeContext.make(host, syn, true, false)

        ; specify "class" (index 0); n_spec advances, duplicate is a message.
        al.set_spec(0 as size_t, ctx)
        if al.specified(0 as size_t) = false
            return -6
        if al.n_spec_of() <> (1 as size_t)
            return -7
        al.set_spec(0 as size_t, ctx)
        if ctx.n_messages <> 1
            return -8

        ; finish: unspecified "class" is already specified; "id" is required and
        ; unspecified -> makeMissingValue emits a message and leaves null.
        al.finish(ctx)
        if ctx.n_messages <> 2
            return -9
        if al.value(1 as size_t) <> null
            return -10

        ; no ID value present -> get_id empty.
        if al.get_id().get_size() <> (0 as size_t)
            return -11

        0
    }
}

; --- Attributed -----------------------------------------------------------
; The mix-in for things with attribute definitions (elements, notations).
define Attributed (attribute_def: pointer[AttributeDefinitionList])
{
    init()
    {
        set attribute_def: null
    }

    function make(host: pointer[Page]) returns pointer[Attributed]
    {
        let a host.allocate(sizeof Attributed, alignof Attributed) as pointer[Attributed]
        set a.attribute_def: null
        a
    }

    function get_attribute_def(this: Attributed) returns pointer[AttributeDefinitionList]
        attribute_def

    function set_attribute_def(this: pointer[Attributed], def: pointer[AttributeDefinitionList])
        set this.attribute_def: def

    function test() returns int
    {
        let host Page.get(StringC("x").data_ptr() as pointer[void])
        let at Attributed.make(host)
        if at.get_attribute_def() <> null
            return -1
        let adl AttributeDefinitionList.make(host, 3 as size_t)
        at.set_attribute_def(adl)
        if at.get_attribute_def() <> adl
            return -2
        if at.get_attribute_def().get_index() <> (3 as size_t)
            return -3
        0
    }
}
