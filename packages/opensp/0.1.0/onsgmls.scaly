; onsgmls — the OpenSP drop-in event-dump program (Stage 4 Increment 3).
;
; A minimal onsgmls: read an SGML document, parse it, and write the ESIS event
; stream to stdout — the harness tests/sgml/run.sh measures against the
; reference onsgmls (ROADMAP-dazzle.md Part I, the corpus counter). The full
; NsgmlsApp CLI (flags, catalogs, message output, the whole markup Event set)
; is Stage 5; this is the event-dump core that starts ticking the counter.
;
; Scope (Stage 4 Increment 3): a well-formed document with an INTERNAL DTD
; subset and explicit tags — parse_to_esis drives prolog (DOCTYPE) + content and
; Esis.write emits the ESIS. Exit 0 when conforming (no errors), else 1, matching
; onsgmls.

package scaly 0.1.0
package opensp 0.1.0

use opensp
use opensp.Parser.Parser
use scaly.io.File
use scaly.io.Console
use scaly.memory.Page
use scaly.containers.String

function main(argc: int, argv: pointer[pointer[char]]) returns int
{
    if argc < 2
        return 2
    let path_ptr *(argv + 1)
    let path String(path_ptr)
    let contents File.read_to_string(path)
    let host Page.get(contents.get_buffer() as pointer[void])
    var conforming false
    let esis Parser.parse_to_esis(host, contents, &conforming)
    Console.print(esis.to_c_string())
    if conforming
        return 0
    1
}
