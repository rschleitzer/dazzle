; onsgmls — the OpenSP drop-in event-dump program.
;
; Reads an SGML document, parses it, writes the ESIS event stream to stdout
; and every diagnostic to stderr (or the -f error file), byte-identical to
; James Clark's onsgmls (the harness tests/sgml/run.sh measures against it).
;
; The CLI is the reference option surface (NsgmlsApp -> ParserApp ->
; EntityApp -> CmdLineApp), scanned by the ported getopt clone (Options.scaly:
; clustered shorts, unique-prefix --long names, `--` terminator, the
; ?/-/= signal chars rendered as invalid/ambiguous/erroneous-argument
; errors + the "--help" info line, exit 1). Options implemented so far:
;
;   -a/--activate NAME     activate a link type
;   -w/--warning TYPE      enable a warning / validation flag
;   -E/--max-errors NUMBER error limit (0 = unlimited; bad value -> E + default)
;   -i/--include NAME      define parameter entity NAME as "INCLUDE"
;   -e/--open-entities     describe open entities in error messages
;   -g/--open-elements     show open elements in error messages
;   -n/--error-numbers     show message numbers in error messages
;   -x/--references        show relevant ISO 8879 clauses in error messages
;   -f/--error-file FILE   write error messages to FILE (truncates)
;   -v/--version           print the version banner (parse continues)
;   -s/--no-output         suppress the ESIS output (messages still print)
;   -p/--only-prolog       parse only the prolog (no output)
;   -B/--batch-mode        parse each remaining argument as its own document
;   -o/--option TYPE       enable an output option (SgmlsEventHandler flags):
;                          all line entity id included notation-sysid nonsgml
;                          empty data-attribute comment omitted tagomit
;                          attromit version; unknown -> app-level E, exit
;                          unaffected
;   -d, -l, -r, -u         NsgmlsApp aliases for -wduplicate / -oline /
;                          -wdefault / -wundefined
;
; NOT yet ported (their axes are later sessions; they render "invalid
; option", where the reference would accept them): -t (RAST),
; -A (architectures/ArcEngine), -c/-m/-C/-D/-R (the
; entity-manager catalog/search axis), -b (coding-system names), -h (usage
; text; renders from the full registry once every option exists). Multiple
; SYSIDs outside -B (mergeSystemIds: all files parse as ONE entity) are not
; merged yet — the first file wins. With NO file argument (or `-`) the
; document is read from stdin under the storage id `<OSFD>0`, as the
; reference's makeSystemId does.
;
; Known interim deviation: on an unterminated-literal recovery the reference
; shifts the `literal is missing closing delimiter` COLUMN by one under
; -otagomit (markup capture feeds a different anchor item into the guess);
; the port keeps the plain-run anchor (synth-literal-unterminated + -oall is
; the only sweep case). Revisit with the RAST axis (-t), which forces
; instance markup wholesale.

package scaly 0.1.0
package opensp 0.1.0

use opensp
use opensp.Parser.Parser
use opensp.StringC.StringC
use opensp.ParserOptions.ParserOptions
use opensp.ParserState.ParserState
use opensp.Options.Options
use opensp.Options.LongOpt
use opensp.Message.MessageType
use opensp.Message.MessageArg
use opensp.Message.MessageFormatter
use opensp.CmdLineAppMessages.CmdLineAppMessages
use opensp.ParserAppMessages.ParserAppMessages
use opensp.NsgmlsMessages.NsgmlsMessages
use opensp.PosixStorageMessages.PosixStorageMessages
use scaly.io.File
use scaly.io.Path
use scaly.io.Console
use scaly.memory.Page
use scaly.memory.root_pages.getenv
use scaly.containers.String
use scaly.containers.Array
use scaly.containers.Vector
use scaly.fiber.Io

; creat(2): open write-only, create + TRUNCATE — exactly the reference's
; FileOutputByteStream::open (probed: a pre-existing -f file is truncated,
; despite fHelp saying "Append"). Non-variadic, so a direct extern is fine
; (open(2) is variadic — containment rule (b) would force the shim).
function creat(path: pointer[const_char], mode: u32) returns i32 extern
; strerror(3) + the shim's errno accessor (rule (c)) — the openFileError %2.
; Prototypes match the package-side declarations (Storage.scaly, fiber).
function strerror(code: i32) returns pointer[const_char] extern
function scaly_eio_errno() returns i32 extern

; MessageReporter::options_ bits — keep in sync with ParserState.scaly REP_*.
define ONS_REP_OPEN_ENTITIES: u32 1
define ONS_REP_OPEN_ELEMENTS: u32 2
define ONS_REP_MESSAGE_NUMBERS: u32 4
define ONS_REP_CLAUSES: u32 8

; SgmlsEventHandler output flags — keep in sync with Event.scaly OF_*
; (SgmlsEventHandler.h; octal in the reference, outputAll = 07777).
define ONS_OF_LINE: u32 0x1
define ONS_OF_ENTITY: u32 0x2
define ONS_OF_ID: u32 0x4
define ONS_OF_INCLUDED: u32 0x8
define ONS_OF_NOTATION_SYSID: u32 0x10
define ONS_OF_NONSGML: u32 0x20
define ONS_OF_EMPTY: u32 0x40
define ONS_OF_DATA_ATT: u32 0x80
define ONS_OF_COMMENT: u32 0x100
define ONS_OF_TAG_OMISSION: u32 0x200
define ONS_OF_ATTR_OMISSION: u32 0x400
define ONS_OF_PARSER_INFO: u32 0x800
define ONS_OF_ALL: u32 0xFFF

; the -o option table (nsgmls.cxx outputOptions[]) — exact-match names; the
; leading "all" entry sets every flag, "omitted" is tagomit|attromit.
function output_option_flag(name: pointer[char], out_found: pointer[bool]) returns u32
{
    set *out_found: true
    let s String(name as pointer[const_char])
    if s.equals(String("all"))
        return ONS_OF_ALL
    if s.equals(String("line"))
        return ONS_OF_LINE
    if s.equals(String("entity"))
        return ONS_OF_ENTITY
    if s.equals(String("id"))
        return ONS_OF_ID
    if s.equals(String("included"))
        return ONS_OF_INCLUDED
    if s.equals(String("notation-sysid"))
        return ONS_OF_NOTATION_SYSID
    if s.equals(String("nonsgml"))
        return ONS_OF_NONSGML
    if s.equals(String("empty"))
        return ONS_OF_EMPTY
    if s.equals(String("data-attribute"))
        return ONS_OF_DATA_ATT
    if s.equals(String("comment"))
        return ONS_OF_COMMENT
    if s.equals(String("omitted"))
        return ONS_OF_TAG_OMISSION | ONS_OF_ATTR_OMISSION
    if s.equals(String("tagomit"))
        return ONS_OF_TAG_OMISSION
    if s.equals(String("attromit"))
        return ONS_OF_ATTR_OMISSION
    if s.equals(String("version"))
        return ONS_OF_PARSER_INFO
    set *out_found: false
    0 as u32
}

; case-insensitive exact match of a NUL-terminated env value against an ASCII
; key, CmdLineApp::stringMatches / CodingSystemKitImpl::match: each value char
; must equal the key char in either case, and both must end together.
function env_matches(v: pointer[const_char], key: String) returns bool
{
    let n key.get_length()
    var i: size_t 0
    while i < n
    {
        let c (*(v + i)) as u32
        if c = (0 as u32)
            return false
        var k (key.get(i)) as u32
        var cu c
        if (cu >= (0x61 as u32)) and (cu <= (0x7A as u32))
            set cu: cu - (0x20 as u32)
        if (k >= (0x61 as u32)) and (k <= (0x7A as u32))
            set k: k - (0x20 as u32)
        if cu <> k
            return false
        set i: i + 1
    }
    ((*(v + n)) as u32) = (0 as u32)
}

; SP_CHARSET_FIXED=YES/1 (any case) — CmdLineApp::initCodingSystem:
; internalCharsetIsDocCharset_ goes FALSE, i.e. the internal charset is the
; fixed system charset and document chars are TRANSLATED into it (numeric
; char refs run translateNumericCharRef against the CHARSET declaration).
; This is the ONLY input to the charset-fixed decision — SP_ENCODING never
; affects it (it only selects the coding systems below).
function charset_fixed() returns bool
{
    let fixed getenv("SP_CHARSET_FIXED")
    if fixed <> null
    {
        if env_matches(fixed, String("YES")) or env_matches(fixed, String("1"))
            return true
    }
    false
}

; The output coding system, CmdLineApp::initCodingSystem: SP_ENCODING is
; consulted ONLY when SP_CHARSET_FIXED fixes the internal charset to Unicode
; (is_fixed — the same test above); without it the BCTF variable SP_BCTF is
; consulted instead. Of the encoding table only XML and UTF-8 select a UTF-8
; output encoder (XMLCodingSystem::makeEncoder returns the UTF-8 encoder);
; any other (or no, or unknown) name falls back to the identity system — the
; SP_DEFAULT_ENCODING fallback IS8859-1 maps to identity on a Unicode system
; charset. The multi-byte systems we don't model (UTF-16, UCS-2, EUC, ...)
; are not selectable by the corpus. Verified against onsgmls 1.5.2:
; SP_ENCODING=XML alone (no SP_CHARSET_FIXED) stays identity.
function output_is_utf8(is_fixed: bool) returns bool
{
    if is_fixed
    {
        let enc getenv("SP_ENCODING")
        if enc <> null
        {
            if env_matches(enc, String("XML")) or env_matches(enc, String("UTF-8"))
                return true
        }
        return false
    }
    let bctf getenv("SP_BCTF")
    if bctf <> null
    {
        if env_matches(bctf, String("UTF-8"))
            return true
    }
    false
}

; One app-level diagnostic line on stderr — a CmdLineApp message with no
; location segment: `<prog>:[0.<number>:]<sev>: <formatted text>`. Honors -n
; (message numbers; module stand-in 0, see ParserState.emit_message) with
; option-order sensitivity: only options processed BEFORE this message count.
function app_msg(prog: String, utf8: bool, rep_numbers: bool, mt: MessageType, args: Vector[MessageArg])
{
    var buf u32[2048]
    let bp buf as pointer[u32]
    let cap 2048 as size_t
    var p: size_t 0
    var pi: size_t 0
    while pi < prog.get_length()
    {
        set p: ParserState.put_char(bp, cap, p, (*(prog.get_buffer() + pi)) as u32)
        set pi: pi + 1
    }
    set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
    if rep_numbers
    {
        set p: ParserState.put_char(bp, cap, p, 0x30 as u32)
        set p: ParserState.put_char(bp, cap, p, 0x2E as u32)
        set p: ParserState.put_dec(bp, cap, p, mt.get_number() as u64)
        set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
    }
    set p: ParserState.put_char(bp, cap, p, mt.severity_char())
    set p: ParserState.put_char(bp, cap, p, 0x3A as u32)
    set p: ParserState.put_char(bp, cap, p, 0x20 as u32)
    let fmt MessageFormatter()
    let added fmt.format(mt.get_text(), args, bp + p, cap - p, false)
    set p: p + added
    set p: ParserState.put_char(bp, cap, p, 0x0A as u32)
    ParserState.write_stderr(bp, p, utf8, 2)
}

function app_msg0(prog: String, utf8: bool, rep_numbers: bool, mt: MessageType)
{
    let args Vector[MessageArg]()
    app_msg(prog, utf8, rep_numbers, mt, args)
}

function app_msg1(prog: String, utf8: bool, rep_numbers: bool, mt: MessageType, arg: StringC)
{
    var args Vector[MessageArg](1 as size_t)
    set *(args.get(0 as size_t)): MessageArg.Str(arg)
    app_msg(prog, utf8, rep_numbers, mt, args)
}

; tcstoul semantics for the -E argument (ParserApp.cxx:110): skip leading
; whitespace, one optional sign, decimal digits; the WHOLE argument must be
; consumed, and the unsigned-long value must fit UINT_MAX. A negated nonzero
; value wraps past UINT_MAX (rejected); "-0" is 0 and valid (limit off).
function parse_error_limit(a: pointer[char], out_ok: pointer[bool]) returns u32
{
    set *out_ok: false
    var i: size_t 0
    var scanning true
    while scanning
    {
        let c (*(a + i)) as u32
        if (c = (0x20 as u32)) or ((c >= (0x09 as u32)) and (c <= (0x0D as u32)))
            set i: i + 1
        else
            set scanning: false
    }
    var minus false
    let sc (*(a + i)) as u32
    if sc = (0x2B as u32)
        set i: i + 1
    else if sc = (0x2D as u32)
    {
        set minus: true
        set i: i + 1
    }
    var n: u64 0
    var digits: size_t 0
    var overflow false
    var reading true
    while reading
    {
        let c (*(a + i)) as u32
        if (c >= (0x30 as u32)) and (c <= (0x39 as u32))
        {
            if n > (1844674407370955161 as u64)
                set overflow: true
            set n: (n * (10 as u64)) + ((c - (0x30 as u32)) as u64)
            set digits: digits + 1
            set i: i + 1
        }
        else
            set reading: false
    }
    if digits = (0 as size_t)
        return 0 as u32
    if ((*(a + i)) as u32) <> (0 as u32)
        return 0 as u32
    if overflow
        return 0 as u32
    if minus and (n <> (0 as u64))
        return 0 as u32
    if n > (4294967295 as u64)
        return 0 as u32
    set *out_ok: true
    n as u32
}

; Read fd 0 to EOF — the `<OSFD>0` storage object makeSystemId builds for a
; missing or `-` file argument.
function read_stdin_to_string() returns String
{
    let bytes Array[u8]()
    var buf u8[65536]
    let bp buf as pointer[void]
    var reading true
    while reading
    {
        let r Io.read(0 as i32, bp, 65536 as size_t)
        if r <= (0 as i64)
            set reading: false
        else
        {
            let n r as size_t
            var i: size_t 0
            while i < n
            {
                bytes.add(*((buf as pointer[u8]) + i))
                set i: i + 1
            }
        }
    }
    String(bytes.get_buffer() as pointer[const_char], bytes.get_length())
}

; Parse one document and print its ESIS (unless suppressed). Returns the
; per-document exit status (0 conforming, 1 not). A document file that
; cannot be OPENED prints the storage layer's `cannot open %1 (%2)`
; (openSystemCall) app-level, emits no ESIS for the document, and exits 1.
function process_document(doc_arg: pointer[char], prog_name: String, out_utf8: bool, is_fixed: bool, active_links: pointer[Array[String]], opts: pointer[ParserOptions], error_limit: u32, reporter_options: u32, output_flags: u32, msg_fd: int, prolog_only: bool, suppress: bool) returns int
{
    var use_stdin false
    if doc_arg = null
        set use_stdin: true
    else
    {
        ; a lone "-" names stdin (EntityApp::makeSystemId).
        if ((*(doc_arg + (0 as size_t))) as u32) = (0x2D as u32)
        {
            if ((*(doc_arg + (1 as size_t))) as u32) = (0 as u32)
                set use_stdin: true
        }
    }
    var path String("<OSFD>0")
    var contents String()
    var base_dir String()
    if use_stdin
        set contents: read_stdin_to_string()
    else
    {
        set path: String(doc_arg as pointer[const_char])
        if File.exists(path) = false
        {
            var oargs Vector[MessageArg](2 as size_t)
            set *(oargs.get(0 as size_t)): MessageArg.Str(StringC(doc_arg as pointer[const_char]))
            ; ENOENT's strerror text — the reference renders the live errno.
            set *(oargs.get(1 as size_t)): MessageArg.Raw(StringC(strerror(2 as i32)))
            app_msg(prog_name, out_utf8, (reporter_options & ONS_REP_MESSAGE_NUMBERS) <> (0 as u32), PosixStorageMessages.openSystemCall(), oargs)
            return 1
        }
        set contents: File.read_to_string(path)
        ; external DTD subsets resolve their (relative) system ids against
        ; the document's directory.
        set base_dir: Path.get_directory_name(path)
    }
    ; onsgmls displays the document's storage id (the path as given) in every
    ; diagnostic, prefixed by the program name (argv[0]).
    let doc_name StringC(path.to_c_string())
    ; Anchor the run region on the (small, page-hosted) path String — NOT on the
    ; document buffer: a document larger than PAGE_SIZE lands in an oversized
    ; bucket, and Page.get on an oversized object masks to a bogus page header.
    let host Page.get(path.get_buffer() as pointer[void])
    var conforming false
    let esis Parser.parse_to_esis(host, contents, base_dir, doc_name, prog_name, out_utf8, is_fixed, active_links, opts, error_limit, reporter_options, output_flags, msg_fd, prolog_only, &conforming)
    ; -s (MessageEventHandler) and -p (PrologMessageEventHandler) print no
    ; ESIS at all — not even the conformance marker.
    if (suppress = false) and (prolog_only = false)
        Console.print(esis.to_c_string())
    if conforming
        return 0
    1
}

function main(argc: int, argv: pointer[pointer[char]]) returns int
{
    let prog_name String(*argv)
    ; the coding systems come from the environment (initCodingSystem runs in
    ; the CmdLineApp constructor) — they govern option-time messages too.
    let is_fixed charset_fixed()
    let out_utf8 output_is_utf8(is_fixed)

    let anchor0 String("x")
    let arg_host Page.get(anchor0.get_buffer() as pointer[void])

    ; ---- the option registry, in reference registration order (CmdLineApp,
    ;      EntityApp, ParserApp, NsgmlsApp) — implemented options only; see
    ;      the header comment for the axes still to come. ----
    let reg Array[LongOpt]^arg_host()
    reg.add(LongOpt(String("error-file"), 0x66 as u32, true))
    reg.add(LongOpt(String("version"), 0x76 as u32, false))
    reg.add(LongOpt(String("activate"), 0x61 as u32, true))
    reg.add(LongOpt(String("max-errors"), 0x45 as u32, true))
    reg.add(LongOpt(String("open-entities"), 0x65 as u32, false))
    reg.add(LongOpt(String("open-elements"), 0x67 as u32, false))
    reg.add(LongOpt(String("error-numbers"), 0x6E as u32, false))
    reg.add(LongOpt(String("references"), 0x78 as u32, false))
    reg.add(LongOpt(String("include"), 0x69 as u32, true))
    reg.add(LongOpt(String("warning"), 0x77 as u32, true))
    reg.add(LongOpt(String("batch-mode"), 0x42 as u32, false))
    reg.add(LongOpt(String("option"), 0x6F as u32, true))
    reg.add(LongOpt(String("only-prolog"), 0x70 as u32, false))
    reg.add(LongOpt(String("no-output"), 0x73 as u32, false))
    reg.add(LongOpt(String(), 0x64 as u32, false))
    reg.add(LongOpt(String(), 0x6C as u32, false))
    reg.add(LongOpt(String(), 0x72 as u32, false))
    reg.add(LongOpt(String(), 0x75 as u32, false))

    let active_links Array[String]^arg_host()
    let opts ParserOptions.make(arg_host)
    var error_limit: u32 200
    var reporter_options: u32 0
    var output_flags: u32 0
    var prolog_only false
    var suppress false
    var batch false
    var error_file: pointer[char] null

    let os Options.make(arg_host, argc, argv, &reg)
    var c: u32 0
    var scanning os.get(&c)
    while scanning
    {
        if (c = (0x3F as u32)) or (c = (0x2D as u32)) or (c = (0x3D as u32))
        {
            ; CmdLineApp::processOptions error rendering: a long option's
            ; name comes from the raw argv cell (up to '=', 79 chars); a
            ; short option is its single char. Note a short option with a
            ; MISSING argument also lands here as '?' — the reference
            ; renders it as "invalid option", missingOptionArgError is dead.
            var nbuf u32[80]
            let nb nbuf as pointer[u32]
            var nlen: size_t 0
            if os.get_opt() = (0 as u32)
            {
                let cell *(argv + (os.get_ind() - 1))
                var ti: size_t 2
                var copying true
                while copying
                {
                    let tc (*(cell + ti)) as u32
                    if (tc = (0 as u32)) or (tc = (0x3D as u32)) or (nlen >= (79 as size_t))
                        set copying: false
                    else
                    {
                        set *(nb + nlen): tc
                        set nlen: nlen + 1
                        set ti: ti + 1
                    }
                }
            }
            else
            {
                set *nb: os.get_opt()
                set nlen: 1
            }
            let oname StringC(nb, nlen)
            var emt CmdLineAppMessages.invalidOptionError()
            if c = (0x2D as u32)
                set emt: CmdLineAppMessages.ambiguousOptionError()
            if c = (0x3D as u32)
                set emt: CmdLineAppMessages.erroneousOptionArgError()
            app_msg1(prog_name, out_utf8, (reporter_options & ONS_REP_MESSAGE_NUMBERS) <> (0 as u32), emt, oname)
            app_msg0(prog_name, out_utf8, (reporter_options & ONS_REP_MESSAGE_NUMBERS) <> (0 as u32), CmdLineAppMessages.tryHelpOptionForInfo())
            return 1
        }
        else if c = (0x61 as u32)
            active_links.add(String(os.get_arg() as pointer[const_char]))
        else if c = (0x77 as u32)
        {
            let wv String(os.get_arg() as pointer[const_char])
            if opts.enable_warning(wv) = false
                app_msg1(prog_name, out_utf8, (reporter_options & ONS_REP_MESSAGE_NUMBERS) <> (0 as u32), ParserAppMessages.unknownWarning(), StringC(os.get_arg() as pointer[const_char]))
        }
        else if c = (0x45 as u32)
        {
            var ok_lim false
            let lim parse_error_limit(os.get_arg(), &ok_lim)
            if ok_lim
                set error_limit: lim
            else
                app_msg0(prog_name, out_utf8, (reporter_options & ONS_REP_MESSAGE_NUMBERS) <> (0 as u32), ParserAppMessages.badErrorLimit())
        }
        else if c = (0x69 as u32)
        {
            if opts.includes = null
                set opts.includes: Array[StringC]^arg_host()
            let iv StringC^arg_host(os.get_arg() as pointer[const_char])
            opts.includes.add(iv)
        }
        else if c = (0x65 as u32)
            set reporter_options: reporter_options | ONS_REP_OPEN_ENTITIES
        else if c = (0x67 as u32)
            set reporter_options: reporter_options | ONS_REP_OPEN_ELEMENTS
        else if c = (0x6E as u32)
            set reporter_options: reporter_options | ONS_REP_MESSAGE_NUMBERS
        else if c = (0x78 as u32)
            set reporter_options: reporter_options | ONS_REP_CLAUSES
        else if c = (0x6F as u32)
        {
            ; NsgmlsApp::processOption 'o': exact table match; unknown names
            ; render the app-level unknownOutputOption E (quoted arg) and do
            ; NOT affect the exit code (probed: exit 0 on a clean doc).
            var found false
            let of output_option_flag(os.get_arg(), &found)
            if found
                set output_flags: output_flags | of
            else
                app_msg1(prog_name, out_utf8, (reporter_options & ONS_REP_MESSAGE_NUMBERS) <> (0 as u32), NsgmlsMessages.unknownOutputOption(), StringC(os.get_arg() as pointer[const_char]))
        }
        else if c = (0x6C as u32)
            set output_flags: output_flags | ONS_OF_LINE
        else if c = (0x64 as u32)
            opts.enable_warning(String("duplicate"))
        else if c = (0x72 as u32)
            opts.enable_warning(String("default"))
        else if c = (0x75 as u32)
            opts.enable_warning(String("undefined"))
        else if c = (0x76 as u32)
        {
            ; versionInfo: `"OpenSP" version "1.5.2"`, Info, parse continues.
            var vargs Vector[MessageArg](2 as size_t)
            set *(vargs.get(0 as size_t)): MessageArg.Str(StringC("OpenSP"))
            set *(vargs.get(1 as size_t)): MessageArg.Str(StringC("1.5.2"))
            app_msg(prog_name, out_utf8, (reporter_options & ONS_REP_MESSAGE_NUMBERS) <> (0 as u32), CmdLineAppMessages.versionInfo(), vargs)
        }
        else if c = (0x66 as u32)
            set error_file: os.get_arg()
        else if c = (0x42 as u32)
            set batch: true
        else if c = (0x70 as u32)
            set prolog_only: true
        else if c = (0x73 as u32)
            set suppress: true
        set scanning: os.get(&c)
    }

    ; -f: opened AFTER the option loop (processOptions does), so option-time
    ; messages always reach the real stderr; open failure aborts with the
    ; openFileError message (%2 = strerror text, unquoted).
    var msg_fd: int 2
    if error_file <> null
    {
        let fd creat(error_file as pointer[const_char], 0x1B6 as u32)
        if fd = ((0 - 1) as i32)
        {
            var fargs Vector[MessageArg](2 as size_t)
            set *(fargs.get(0 as size_t)): MessageArg.Str(StringC(error_file as pointer[const_char]))
            set *(fargs.get(1 as size_t)): MessageArg.Raw(StringC(strerror(scaly_eio_errno())))
            app_msg(prog_name, out_utf8, (reporter_options & ONS_REP_MESSAGE_NUMBERS) <> (0 as u32), CmdLineAppMessages.openFileError(), fargs)
            return 1
        }
        set msg_fd: fd as int
    }

    let first_arg os.get_ind()
    if batch
    {
        ; NsgmlsApp::processArguments batch mode: each argument is its own
        ; parse; the ESIS streams concatenate and the exit status is the max.
        var ret 0
        var ai first_arg
        while ai < argc
        {
            let r process_document(*(argv + ai), prog_name, out_utf8, is_fixed, &active_links, opts, error_limit, reporter_options, output_flags, msg_fd, prolog_only, suppress)
            if r > ret
                set ret: r
            set ai: ai + 1
        }
        return ret
    }
    var doc_arg: pointer[char] null
    if first_arg < argc
        set doc_arg: *(argv + first_arg)
    process_document(doc_arg, prog_name, out_utf8, is_fixed, &active_links, opts, error_limit, reporter_options, output_flags, msg_fd, prolog_only, suppress)
}
