; onsgmls — the OpenSP drop-in event-dump program.
;
; Reads an SGML document, parses it, writes the ESIS event stream to stdout
; and every diagnostic to stderr (or the -f error file), byte-identical to
; James Clark's onsgmls (the harness tests/sgml/run.sh measures against it).
;
; The CLI is the reference option surface (NsgmlsApp -> ParserApp ->
; EntityApp -> CmdLineApp), scanned by the ported getopt clone (Options.scaly:
; clustered shorts, unique-prefix --long names, `--` terminator, the
; ?/-/= signal chars rendered as invalid/ambiguous/erroneous-argument
; errors + the "--help" info line, exit 1). Options implemented so far:
;
;   -a/--activate NAME     activate a link type
;   -w/--warning TYPE      enable a warning / validation flag
;   -E/--max-errors NUMBER error limit (0 = unlimited; bad value -> E + default)
;   -i/--include NAME      define parameter entity NAME as "INCLUDE"
;   -e/--open-entities     describe open entities in error messages
;   -g/--open-elements     show open elements in error messages
;   -n/--error-numbers     show message numbers in error messages
;   -x/--references        show relevant ISO 8879 clauses in error messages
;   -f/--error-file FILE   write error messages to FILE (truncates)
;   -v/--version           print the version banner (parse continues)
;   -s/--no-output         suppress the ESIS output (messages still print)
;   -p/--only-prolog       parse only the prolog (no output)
;   -B/--batch-mode        parse each remaining argument as its own document
;   -o/--option TYPE       enable an output option (SgmlsEventHandler flags):
;                          all line entity id included notation-sysid nonsgml
;                          empty data-attribute comment omitted tagomit
;                          attromit version; unknown -> app-level E, exit
;                          unaffected
;   -t/--rast-file FILE    write RAST (ISO/IEC 13673) output to FILE instead
;                          of the ESIS stream (nothing goes to stdout; -s is
;                          overridden, -p wins over -t and creates no file).
;                          FILE is created/truncated before the parse; any
;                          error replaces the content with the #ERROR /
;                          #RAST-PI-ERROR marker; open failure -> openFileError
;                          + exit 1. Under -B the per-document file name is
;                          FILE concatenated with the argument.
;   -h/--help              print the usage text to stdout and exit 0 (parses
;                          nothing; only the flag is set during the option
;                          loop, so a later -b/-f still applies; a failing -f
;                          still aborts first). The registry advertises -A too,
;                          for byte-identical output, though its axis is unported.
;   -c/--catalog SYSID     use catalog SYSID (must exist; missing -> E);
;                          repeatable; SGML_CATALOG_FILES appends more
;                          (silent when missing); the document's own
;                          `catalog` file merges in between unless
;                          SP_USE_DOCUMENT_CATALOG=NO/0
;   -C/--catalogs          the file arguments are catalogs; the document
;                          comes from their first DOCUMENT entry
;   -D/--directory DIR     search DIR for (relative) system ids;
;                          SGML_SEARCH_PATH appends more
;   -R/--restricted        restricted file reading (only search-dir files)
;   -m SYSID               NsgmlsApp alias for -c
;   -d, -l, -r, -u         NsgmlsApp aliases for -wduplicate / -oline /
;                          -wdefault / -wundefined
;   -b/--bctf NAME         select the OUTPUT coding system (stdout ESIS or
;   -b/--encoding NAME     the -t RAST file; stderr stays on the environment
;                          system). Without SP_CHARSET_FIXED the long name is
;                          --bctf and NAME is a BCTF (IDENTITY FIXED-2 FIXED-4
;                          UTF-8 EUC SJIS BIG5); with it the long name is
;                          --encoding and NAME is an encoding (UTF-8 UCS-2/4
;                          UTF-16/32 UNICODE XML ISO-8859-1..9 KOI8-R EUC-JP/
;                          CN/KR SJIS BIG5 ...). Unknown NAME -> app-level
;                          unknownBctf/unknownEncoding E (exit unaffected) and
;                          the environment default reapplies.
;
; NOT yet ported (their axes are later sessions; they render "invalid
; option", where the reference would accept them):
; -A (architectures/ArcEngine).
; Multiple SYSIDs outside -B merge into ONE document entity
; (mergeSystemIds): per-file storage ids and line numbers (the Origin
; segment table), per-file declaration bases, per-file implicit `catalog`
; consultation (deduped), and lazily-reported open failures — a missing
; file reports `cannot open` when reading crosses its boundary and the
; parse continues with the remaining files. With NO file argument (or `-`)
; the document is read from stdin under the storage id `<OSFD>0`, as the
; reference's makeSystemId does; a `-` among several arguments is the same
; fd-0 storage object merged in place.
;
; Known interim deviation: on an unterminated-literal recovery the reference
; shifts the `literal is missing closing delimiter` COLUMN by one under
; -otagomit (markup capture feeds a different anchor item into the guess);
; the port keeps the plain-run anchor (synth-literal-unterminated + -oall is
; the only sweep case). Probed: -t does NOT capture instance markup — the
; stderr is identical with and without -t — so this stays a -otagomit-only
; deviation.

package scaly 0.1.0
package opensp 0.1.0

use opensp
use opensp.Parser.Parser
use opensp.StringC.StringC
use opensp.ParserOptions.ParserOptions
use opensp.ParserState.ParserState
use opensp.Options.Options
use opensp.Options.LongOpt
use opensp.EntityManager.EmConfig
use opensp.Message.MessageType
use opensp.Message.MessageFragment
use opensp.Message.MessageArg
use opensp.Message.MessageFormatter
use opensp.CmdLineAppMessages.CmdLineAppMessages
use opensp.CodingSystemKit.CodingSystemKit
use opensp.CodingSystem.CodingSystem
use opensp.CodingSystemKit.OutputEncoder
use opensp.EntityAppMessages.EntityAppMessages
use opensp.ParserAppMessages.ParserAppMessages
use opensp.NsgmlsMessages.NsgmlsMessages
use opensp.PosixStorageMessages.PosixStorageMessages
use scaly.io.File
use scaly.io.Path
use scaly.io.Console
use scaly.memory.Page
use scaly.memory.root_pages.getenv
use opensp.ContentToken.ContentToken
use scaly.containers.String
use scaly.containers.Array
use scaly.containers.Vector
use scaly.fiber.Io

; creat(2): open write-only, create + TRUNCATE — exactly the reference's
; FileOutputByteStream::open (probed: a pre-existing -f file is truncated,
; despite fHelp saying "Append"). Non-variadic, so a direct extern is fine
; (open(2) is variadic — containment rule (b) would force the shim).

; SP_REGION_BYTES=1: report the parse's RUN REGION size on stderr after the
; parse. Not a feature — a measurement hook for the memory work
; (tests/dazzle/PERFORMANCE.md, "Wo der Speicher liegt"). Peak RSS alone cannot
; say how much of it is ONE region that only dies at the end; this walks that
; region the way deallocate_extensions does (next_page chain + exclusive pages,
; oversized ones by their recorded block length) and sums the bytes. Measured
; 2026-08-02: 626 of 657 MB on a 13.1 MB document — 95 %.
;
; PAGE_SIZE is spelled 4096 on purpose: a module-level `define` of another
; package is invisible from inside a module (CLAUDE.md), and this file is the
; only place that needs it.
function run_region_bytes(p: ref[Page]) returns size_t
{
    var total: size_t 0
    ; `q` walks the next_page chain and genuinely reaches null at its end, so the
    ; local is the nullable form even though the parameter always refers to a page.
    var q: ref[Page]? p
    while q <> null
    {
        set total: total + 4096
        var nd q.exclusive_pages.head
        while nd <> null
        {
            let excl nd.page
            if excl.next_object = null
                set total: total + Page.oversized_size(excl)
            else
                set total: total + run_region_bytes(excl)
            set nd: nd.next
        }
        set q: q.next_page
    }
    total
}


function creat(path: pointer[const_char], mode: u32) returns i32 extern
; strerror(3) + the shim's errno accessor (rule (c)) — the openFileError %2.
; Prototypes match the package-side declarations (Storage.scaly, fiber).
function strerror(code: i32) returns pointer[const_char] extern
function scaly_eio_errno() returns i32 extern

; MessageReporter::options_ bits — keep in sync with ParserState.scaly REP_*.
define ONS_REP_OPEN_ENTITIES: u32 1
define ONS_REP_OPEN_ELEMENTS: u32 2
define ONS_REP_MESSAGE_NUMBERS: u32 4
define ONS_REP_CLAUSES: u32 8

; SgmlsEventHandler output flags — keep in sync with Event.scaly OF_*
; (SgmlsEventHandler.h; octal in the reference, outputAll = 07777).
define ONS_OF_LINE: u32 0x1
define ONS_OF_ENTITY: u32 0x2
define ONS_OF_ID: u32 0x4
define ONS_OF_INCLUDED: u32 0x8
define ONS_OF_NOTATION_SYSID: u32 0x10
define ONS_OF_NONSGML: u32 0x20
define ONS_OF_EMPTY: u32 0x40
define ONS_OF_DATA_ATT: u32 0x80
define ONS_OF_COMMENT: u32 0x100
define ONS_OF_TAG_OMISSION: u32 0x200
define ONS_OF_ATTR_OMISSION: u32 0x400
define ONS_OF_PARSER_INFO: u32 0x800
define ONS_OF_ALL: u32 0xFFF

; the -o option table (nsgmls.cxx outputOptions[]) — exact-match names; the
; leading "all" entry sets every flag, "omitted" is tagomit|attromit.
procedure output_option_flag(name: pointer[char], mutable out_found: ref[bool]) returns u32
{
    set out_found: true
    let s String(name as pointer[const_char])
    if s.equals(String("all"))
        return ONS_OF_ALL
    if s.equals(String("line"))
        return ONS_OF_LINE
    if s.equals(String("entity"))
        return ONS_OF_ENTITY
    if s.equals(String("id"))
        return ONS_OF_ID
    if s.equals(String("included"))
        return ONS_OF_INCLUDED
    if s.equals(String("notation-sysid"))
        return ONS_OF_NOTATION_SYSID
    if s.equals(String("nonsgml"))
        return ONS_OF_NONSGML
    if s.equals(String("empty"))
        return ONS_OF_EMPTY
    if s.equals(String("data-attribute"))
        return ONS_OF_DATA_ATT
    if s.equals(String("comment"))
        return ONS_OF_COMMENT
    if s.equals(String("omitted"))
        return ONS_OF_TAG_OMISSION | ONS_OF_ATTR_OMISSION
    if s.equals(String("tagomit"))
        return ONS_OF_TAG_OMISSION
    if s.equals(String("attromit"))
        return ONS_OF_ATTR_OMISSION
    if s.equals(String("version"))
        return ONS_OF_PARSER_INFO
    set out_found: false
    0 as u32
}

; case-insensitive exact match of a NUL-terminated env value against an ASCII
; key, CmdLineApp::stringMatches / CodingSystemKitImpl::match: each value char
; must equal the key char in either case, and both must end together.
function env_matches(v: pointer[const_char], key: String) returns bool
{
    let n key.get_length()
    var i: size_t 0
    while i < n
    {
        let c (*(v + i)) as u32
        if c = 0
            return false
        var k (key.get(i)) as u32
        var cu c
        if (cu >= 0x61) and (cu <= 0x7A)
            set cu: cu - 0x20
        if (k >= 0x61) and (k <= 0x7A)
            set k: k - 0x20
        if cu <> k
            return false
        set i: i + 1
    }
    ((*(v + n)) as u32) = 0
}

; SP_CHARSET_FIXED=YES/1 (any case) — CmdLineApp::initCodingSystem:
; internalCharsetIsDocCharset_ goes FALSE, i.e. the internal charset is the
; fixed system charset and document chars are TRANSLATED into it (numeric
; char refs run translateNumericCharRef against the CHARSET declaration).
; This is the ONLY input to the charset-fixed decision — SP_ENCODING never
; affects it (it only selects the coding systems below).
function charset_fixed() returns bool
{
    let fixed getenv("SP_CHARSET_FIXED")
    if fixed <> null
    {
        if env_matches(fixed, String("YES")) or env_matches(fixed, String("1"))
            return true
    }
    false
}

; The output coding system, CmdLineApp::initCodingSystem: SP_ENCODING is
; consulted ONLY when SP_CHARSET_FIXED fixes the internal charset to Unicode
; (is_fixed — the same test above); without it the BCTF variable SP_BCTF is
; consulted instead. Of the encoding table only XML and UTF-8 select a UTF-8
; output encoder (XMLCodingSystem::makeEncoder returns the UTF-8 encoder);
; any other (or no, or unknown) name falls back to the identity system — the
; SP_DEFAULT_ENCODING fallback IS8859-1 maps to identity on a Unicode system
; charset. The multi-byte systems we don't model (UTF-16, UCS-2, EUC, ...)
; are not selectable by the corpus. Verified against onsgmls 1.5.2:
; SP_ENCODING=XML alone (no SP_CHARSET_FIXED) stays identity.
function output_is_utf8(is_fixed: bool) returns bool
{
    if is_fixed
    {
        let enc getenv("SP_ENCODING")
        if enc <> null
        {
            if env_matches(enc, String("XML")) or env_matches(enc, String("UTF-8"))
                return true
        }
        return false
    }
    let bctf getenv("SP_BCTF")
    if bctf <> null
    {
        if env_matches(bctf, String("UTF-8"))
            return true
    }
    false
}

; The INPUT coding system, CmdLineApp::initCodingSystem: the environment name
; (SP_ENCODING when the internal charset is FIXED, else the BCTF variable
; SP_BCTF) is looked up in the corresponding table; a name in neither table
; falls back — under charset-fixed via SP_DEFAULT_ENCODING (IS8859-1, which on
; this port's ISO 10646 system charset IS the identity system) — to identity.
; ★And a system with more than one byte per char is REJECTED for this role
; (`codingSystem_->fixedBytesPerChar() > 1`), so `SP_ENCODING=UCS-2` reads
; 8-bit; only a byte-order mark or an XML declaration ever selects a
; fixed-width decoder.
procedure input_coding_system(host: ref[Page], is_fixed: bool, mutable out: ref[CodingSystem])
{
    let id CodingSystem.identity()
    id.store(out)
    var name: pointer[const_char] null
    if is_fixed
        set name: getenv("SP_ENCODING")
    else
        set name: getenv("SP_BCTF")
    var found false
    if name <> null
        set found: CodingSystemKit.lookup_input_name(host, String(name), is_fixed = false, out)
    if found = false
    {
        ; SP_DEFAULT_ENCODING under charset-fixed is IS8859-1 -> identity, and
        ; without it there is no default at all; either way, identity.
        id.store(out)
        return
    }
    let sel: CodingSystem out
    if sel.fixed_bytes_per_char() > 1
        id.store(out)
}

; The OUTPUT coding system, the second half of CmdLineApp::initCodingSystem:
; `codingSystem_` is BOTH the system coding system and — through
; processOptions' `if (!outputCodingSystem_) outputCodingSystem_ =
; codingSystem()` — the default for the ESIS/RAST stream, so the SAME
; environment name that selects the decoder selects the encoder. `-b` overrides
; only this half. The fixedBytesPerChar > 1 rejection applies here too (it is
; one object in the reference), so SP_ENCODING=UCS-2 writes 8-bit.
procedure output_coding_system(host: ref[Page], is_fixed: bool, mutable e: ref[OutputEncoder])
{
    var name: pointer[const_char] null
    if is_fixed
        set name: getenv("SP_ENCODING")
    else
        set name: getenv("SP_BCTF")
    if name <> null
    {
        var kind 0
        var which 0
        if CodingSystemKit.lookup(String(name), is_fixed = false, &kind, &which)
        {
            ; the same rejection as on the input side: a fixed-width system
            ; cannot be the app's coding system.
            var probe CodingSystem.identity()
            if CodingSystemKit.lookup_input_name(host, String(name), is_fixed = false, &probe)
            {
                if probe.fixed_bytes_per_char() > 1
                {
                    CodingSystemKit.make_default(host, false, e)
                    return
                }
            }
            CodingSystemKit.make_encoder(host, kind, which, e)
            return
        }
    }
    CodingSystemKit.make_default(host, false, e)
}

; One app-level diagnostic line on stderr — a CmdLineApp message with no
; location segment: `<prog>:[0.<number>:]<sev>: <formatted text>`. Honors -n
; (message numbers; module stand-in 0, see ParserState.emit_message) with
; option-order sensitivity: only options processed BEFORE this message count.
function app_msg(prog: String, utf8: bool, rep_numbers: bool, mt: MessageType, args: Vector[MessageArg])
{
    var buf u32[2048]
    let bp buf as pointer[u32]
    let cap: size_t 2048
    var p: size_t 0
    var pi: size_t 0
    while pi < prog.get_length()
    {
        set p: ParserState.put_char(Slice[u32](cap, bp), p, (*(prog.get_buffer() + pi)) as u32)
        set pi: pi + 1
    }
    set p: ParserState.put_char(Slice[u32](cap, bp), p, 0x3A)
    if rep_numbers
    {
        set p: ParserState.put_char(Slice[u32](cap, bp), p, 0x30)
        set p: ParserState.put_char(Slice[u32](cap, bp), p, 0x2E)
        set p: ParserState.put_dec(Slice[u32](cap, bp), p, mt.get_number() as u64)
        set p: ParserState.put_char(Slice[u32](cap, bp), p, 0x3A)
    }
    set p: ParserState.put_char(Slice[u32](cap, bp), p, mt.severity_char())
    set p: ParserState.put_char(Slice[u32](cap, bp), p, 0x3A)
    set p: ParserState.put_char(Slice[u32](cap, bp), p, 0x20)
    let fmt MessageFormatter()
    ; get_text() is the raw literal template now — widen it here (see
    ; opensp.Message.MessageFragment); passing the temporary straight into the
    ; call keeps it off a stack slot.
    let added fmt.format(StringC(mt.get_text()), args, Slice[u32](cap - p, bp + p), false)
    set p: p + added
    set p: ParserState.put_char(Slice[u32](cap, bp), p, 0x0A)
    ParserState.write_stderr(Slice[u32](p, bp), utf8, 2)
}

function app_msg0(prog: String, utf8: bool, rep_numbers: bool, mt: MessageType)
{
    let args Vector[MessageArg]()
    app_msg(prog, utf8, rep_numbers, mt, args)
}

function app_msg1(prog: String, utf8: bool, rep_numbers: bool, mt: MessageType, arg: StringC)
{
    var args Vector[MessageArg](1)
    set *(args.get(0)): MessageArg.Str(arg)
    app_msg(prog, utf8, rep_numbers, mt, args)
}

; tcstoul semantics for the -E argument (ParserApp.cxx:110): skip leading
; whitespace, one optional sign, decimal digits; the WHOLE argument must be
; consumed, and the unsigned-long value must fit UINT_MAX. A negated nonzero
; value wraps past UINT_MAX (rejected); "-0" is 0 and valid (limit off).
procedure parse_error_limit(a: pointer[char], mutable out_ok: ref[bool]) returns u32
{
    set out_ok: false
    var i: size_t 0
    var scanning true
    while scanning
    {
        let c (*(a + i)) as u32
        if (c = 0x20) or ((c >= 0x09) and (c <= 0x0D))
            set i: i + 1
        else
            set scanning: false
    }
    var minus false
    let sc (*(a + i)) as u32
    if sc = 0x2B
        set i: i + 1
    else if sc = 0x2D
    {
        set minus: true
        set i: i + 1
    }
    var n: u64 0
    var digits: size_t 0
    var overflow false
    var reading true
    while reading
    {
        let c (*(a + i)) as u32
        if (c >= 0x30) and (c <= 0x39)
        {
            if n > 1844674407370955161
                set overflow: true
            set n: (n * 10) + ((c - 0x30) as u64)
            set digits: digits + 1
            set i: i + 1
        }
        else
            set reading: false
    }
    if digits = 0
        return 0 as u32
    if ((*(a + i)) as u32) <> 0
        return 0 as u32
    if overflow
        return 0 as u32
    if minus and (n <> 0)
        return 0 as u32
    if n > 4294967295
        return 0 as u32
    set out_ok: true
    n as u32
}

; split a PATH_SEPARATOR-separated environment value into arr (EntityApp's
; SGML_SEARCH_PATH / SGML_CATALOG_FILES loops): ':' on POSIX; EMPTY segments
; are kept, exactly like the reference (they resolve to unopenable ids and
; skip silently downstream).
procedure split_path_env(mutable arr: ref[Array[String]], v: pointer[const_char], hp: ref[Page])
{
    if v = null
        return
    if ((*v) as u32) = 0
        return
    var start: size_t 0
    var i: size_t 0
    var scanning true
    while scanning
    {
        let ch (*(v + i)) as u32
        if (ch = 0) or (ch = 0x3A)
        {
            let seg String^hp(v + start, i - start)
            arr.add(*seg)
            if ch = 0
                set scanning: false
            else
            {
                set i: i + 1
                set start: i
            }
        }
        else
            set i: i + 1
    }
}

procedure append_str(mutable acc: ref[Array[u8]], s: String)
{
    var i: size_t 0
    while i < s.get_length()
    {
        acc.add(s.get(i))
        set i: i + 1
    }
}

procedure append_lit(mutable acc: ref[Array[u8]], s: pointer[const_char])
{
    var i: size_t 0
    var running true
    while running
    {
        let c *(s + i)
        if (c as u32) = 0
            set running: false
        else
        {
            acc.add(c as u8)
            set i: i + 1
        }
    }
}

; PosixStorageManager::isSafe for the document argument (-R): only
; [a-zA-Z0-9/.-_], no `..`, and the file's directory must sit under one of
; the search directories (with NO -D nothing at all is readable — probed:
; `-R doc.sgm` renders `cannot find "doc.sgm"; tried ` with an empty list).
function doc_path_safe(file: String, em: ref[EmConfig]) returns bool
{
    let n file.get_length()
    var i: size_t 0
    while i < n
    {
        let c file.get(i)
        if (c = 0x2E) and (i > 0)
        {
            if file.get(i - 1) = 0x2E
                return false
        }
        var ok false
        if (c >= 0x61) and (c <= 0x7A)
            set ok: true
        if (c >= 0x41) and (c <= 0x5A)
            set ok: true
        if (c >= 0x30) and (c <= 0x39)
            set ok: true
        if (c = 0x2F) or (c = 0x2E) or (c = 0x2D) or (c = 0x5F)
            set ok: true
        if ok = false
            return false
        set i: i + 1
    }
    ; extractDir (trailing slash kept), then the search-dir prefix test.
    var dlen: size_t 0
    var j n
    while j > 0
    {
        if file.get(j - 1) = 0x2F
        {
            set dlen: j
            set j: 0
        }
        else
            set j: j - 1
    }
    let sds em.search_dirs
    if sds = null
        return false
    let nsd sds.get_length()
    var k: size_t 0
    while k < nsd
    {
        let sd2 sds[k]
        let sn sd2.get_length()
        if dlen >= sn
        {
            var same true
            var m: size_t 0
            while m < sn
            {
                if sd2.get(m) <> file.get(m)
                {
                    set same: false
                    set m: sn
                }
                else
                    set m: m + 1
            }
            if same
            {
                if dlen = sn
                    return true
                if file.get(sn) = 0x2F
                    return true
            }
        }
        set k: k + 1
    }
    false
}

; Read fd 0 to EOF — the `<OSFD>0` storage object makeSystemId builds for a
; missing or `-` file argument.
procedure read_stdin_to_string() returns String
{
    let bytes Array[u8]()
    var buf u8[65536]
    let bp buf as pointer[void]
    var reading true
    while reading
    {
        let r Io.read(0 as i32, bp, 65536 as size_t)
        if r <= 0
            set reading: false
        else
        {
            let n r as size_t
            var i: size_t 0
            while i < n
            {
                bytes.add(buf[i])
                set i: i + 1
            }
        }
    }
    String(bytes.get_buffer() as pointer[const_char], bytes.get_length())
}

; Parse one document — possibly several file arguments merged into ONE
; document entity (EntityApp::makeSystemId + mergeSystemIds: per-file
; storage ids, per-file line numbers, lazy open-failure reporting) — and
; print its ESIS (unless suppressed). Returns the per-document exit status
; (0 conforming, 1 not). A single document file that cannot be OPENED
; prints the storage layer's `cannot open %1 (%2)` (openSystemCall)
; app-level, emits no ESIS for the document, and exits 1; in a multi-file
; document the failure reports when reading crosses the missing object and
; the parse continues with the remaining files.
; `have_rast`/`rast_path`: the -t RAST file (batch mode concatenates the
; argument onto the -t value). Returns -1 when the RAST file cannot be
; created — the reference exit(1)s from the handler constructor, aborting
; even a batch run.
procedure process_document(doc_args: pointer[pointer[char]], n_args: int, mutable prog_name: String, out_utf8: bool, mutable out_enc: ref[OutputEncoder], is_fixed: bool, mutable active_links: ref[Array[String]], mutable opts: ref[ParserOptions], error_limit: u32, reporter_options: u32, output_flags: u32, msg_fd: int, prolog_only: bool, suppress: bool, have_rast: bool, mutable rast_path: String, mutable em_cfg: ref[EmConfig], mutable arc_names: ref[Array[String]]) returns int mutable CM_SCRATCH_ARENAS, CM_SCRATCH_INLINE, CM_SCRATCH_PAGES, CM_SCRATCH_STATE, CM_SCRATCH_STATS
{
    ; -p wins over -t (makeEventHandler checks prologOnly_ first): no RAST
    ; file is even created.
    var use_rast have_rast
    if prolog_only
        set use_rast: false
    var rast_fd: i32 0 - 1
    if use_rast
    {
        ; the reference opens (creates/truncates) the file in the handler
        ; constructor, BEFORE the parse; failure is openFileError + exit 1.
        set rast_fd: creat(rast_path.to_c_string(), 0x1B6 as u32)
        if rast_fd = ((0 - 1) as i32)
        {
            var fargs Vector[MessageArg](2)
            set *(fargs.get(0)): MessageArg.Str(StringC(rast_path.to_c_string()))
            set *(fargs.get(1)): MessageArg.Raw(StringC(strerror(scaly_eio_errno())))
            app_msg(prog_name, out_utf8, (reporter_options & ONS_REP_MESSAGE_NUMBERS) <> 0, CmdLineAppMessages.openFileError(), fargs)
            return 0 - 1
        }
    }
    var use_stdin false
    if n_args = 0
        set use_stdin: true
    else if n_args = 1
    {
        ; a lone "-" names stdin (EntityApp::makeSystemId).
        let a0 *doc_args
        if ((*(a0 + 0)) as u32) = 0x2D
        {
            if ((*(a0 + 1)) as u32) = 0
                set use_stdin: true
        }
    }
    var path String("<OSFD>0")
    var contents String()
    var base_dir String()
    var specs Array[String]()
    var specs_ptr: ref[Array[String]]? null
    if use_stdin
        set contents: read_stdin_to_string()
    else
    {
        ; the document opens INSIDE the parser (Parser.cxx:81-99): -C maps
        ; it through the catalogs' DOCUMENT entry, -D/-R apply, and open
        ; failures report through the parser Messenger. Each argument is one
        ; spec; a "-" among SEVERAL becomes the fd-0 pseudo-spec `<OSFD>0`
        ; (its content pre-read here — the merge consumes it once).
        var ai 0
        var have_fd0 false
        while ai < n_args
        {
            let av *(doc_args + ai)
            var is_dash false
            if ((*(av + 0)) as u32) = 0x2D
            {
                if ((*(av + 1)) as u32) = 0
                    set is_dash: true
            }
            if is_dash
            {
                specs.add(String("<OSFD>0"))
                set have_fd0: true
            }
            else
                specs.add(String(av as pointer[const_char]))
            set ai: ai + 1
        }
        if have_fd0
            set contents: read_stdin_to_string()
        set specs_ptr: &specs
    }
    ; onsgmls displays the document's storage id (the path as given) in every
    ; diagnostic, prefixed by the program name (argv[0]).
    let doc_name StringC(path.to_c_string())
    ; Anchor the run region on the (small, page-hosted) path String — NOT on the
    ; document buffer: a document larger than PAGE_SIZE lands in an oversized
    ; bucket, and Page.get on an oversized object masks to a bogus page header.
    let host Page.get(path.get_buffer())
    var conforming false
    ; Where the STREAMED ESIS chunks go (Esis.flush_out at every drain): stdout,
    ; the same fd the tail below is written to. -1 means "discard at the drain",
    ; which is right for every mode that prints no ESIS — -s, -p, and -t (whose
    ; text goes to rast_fd and which does not stream at all). Without this the
    ; writer held the whole output in memory: 31.6 MiB of accumulator plus a
    ; 22.5 MiB String on a 13.1 MiB parse, 29 % of peak RSS.
    var esis_fd: int -1
    if (suppress = false) and (prolog_only = false) and (use_rast = false)
        set esis_fd: 1
    let esis Parser.parse_to_esis(host, contents, base_dir, doc_name, prog_name, out_utf8, out_enc, is_fixed, active_links, opts, error_limit, reporter_options, output_flags, msg_fd, prolog_only, use_rast, em_cfg, specs_ptr, &conforming, arc_names, esis_fd)
    if getenv("SP_REGION_BYTES") <> null
    {
        let rb run_region_bytes(host)
        scaly_eputs "onsgmls: run region bytes: "
        scaly_eputi(rb as i64)
        scaly_eputnl()
    }
    ; -t: the returned text is the RAST file's content (stdout stays empty —
    ; the RAST handler replaces the ESIS one; -s is irrelevant here).
    if use_rast
    {
        if esis.get_length() > 0
            write(rast_fd as int, esis.get_buffer() as pointer[void], esis.get_length())
        close(rast_fd as int)
    }
    ; -s (MessageEventHandler) and -p (PrologMessageEventHandler) print no
    ; ESIS at all — not even the conformance marker. Write the whole byte run
    ; (NOT to_c_string): a -b system such as UCS-2/UTF-16/UNICODE embeds NUL
    ; bytes that a C-string print would truncate at.
    else if (suppress = false) and (prolog_only = false)
    {
        if esis.get_length() > 0
            Io.write_all(1, esis.get_buffer() as pointer[void], esis.get_length())
    }
    if conforming
        return 0
    1
}

; ---- -h / --help usage text (CmdLineApp::usage) ----------------------------
; A single help row: the reference builds the left column from the option
; registry (short char, optional long name, optional argument name) then pads
; every left column to the widest + 3 and appends the formatted help text.
define UsageRow (key: u32, has_name: bool, name: StringC, has_arg: bool, arg: pointer[const_char], help: pointer[const_char])

; append every Char of a StringC to the render buffer.
procedure usage_put_stringc(mutable bp: Slice[u32], pos: size_t, s: StringC) returns size_t
{
    var p pos
    var i: size_t 0
    while i < s.get_size()
    {
        set p: ParserState.put_char(bp, p, s.get(i))
        set i: i + 1
    }
    p
}

; register one row (help/arg names sourced from the message catalog, so the
; text stays byte-identical to what real onsgmls prints).
procedure add_usage_row(mutable rows: ref[Array[UsageRow]], key: u32, has_name: bool, name: StringC, has_arg: bool, argf: MessageFragment, help: MessageType)
{
    var arg: pointer[const_char] null
    if has_arg
        set arg: argf.text
    rows.add(UsageRow(key, has_name, name, has_arg, arg, help.get_text()))
}

; CmdLineApp::usage's left-column builder: "  -X"[, --name[=ARG] | ARG].
procedure usage_emit_left(mutable bp: Slice[u32], row: UsageRow) returns size_t
{
    var p: size_t 0
    set p: ParserState.put_char(bp, p, 0x20)
    set p: ParserState.put_char(bp, p, 0x20)
    set p: ParserState.put_char(bp, p, 0x2D)
    set p: ParserState.put_char(bp, p, row.key)
    if row.has_name
    {
        set p: ParserState.put_char(bp, p, 0x2C)
        set p: ParserState.put_char(bp, p, 0x20)
    }
    else if row.has_arg
        set p: ParserState.put_char(bp, p, 0x20)
    if row.has_name
    {
        set p: ParserState.put_char(bp, p, 0x2D)
        set p: ParserState.put_char(bp, p, 0x2D)
        set p: usage_put_stringc(bp, p, row.name)
        if row.has_arg
            set p: ParserState.put_char(bp, p, 0x3D)
    }
    if row.has_arg
        set p: usage_put_stringc(bp, p, StringC(row.arg))
    p
}

; format one message template (single %1 = arg) as a whole line to stdout.
; The help message uses the environment default coding system (utf8), NOT the
; -b output coding system — CmdLineApp::usage says so explicitly.
function usage_emit_msg(template_lit: pointer[const_char], arg: StringC, utf8: bool)
{
    var buf u32[2048]
    let bp buf as pointer[u32]
    let cap: size_t 2048
    var args Vector[MessageArg](1)
    set *(args.get(0)): MessageArg.Str(arg)
    let fmt MessageFormatter()
    var p fmt.format(StringC(template_lit), args, Slice[u32](cap, bp), true)
    set p: ParserState.put_char(Slice[u32](cap, bp), p, 0x0A)
    ParserState.write_stderr(Slice[u32](p, bp), utf8, 1)
}

; Print the full usage text to stdout and return (the caller exits 0). The row
; registry mirrors the reference registration order (CmdLineApp, EntityApp,
; ParserApp, NsgmlsApp); -A is advertised for byte-identical output even though
; its ArcEngine axis is not yet ported (an actual -A still reports invalid).
function print_usage(prog: String, utf8: bool, is_fixed: bool)
{
    let progc StringC(prog.to_c_string())

    ; "Usage: <prog> [OPTION] SYSID..." — defaultUsage wrapped in usage.
    var b1 u32[2048]
    let bp1 b1 as pointer[u32]
    let cap1: size_t 2048
    var a1 Vector[MessageArg](1)
    set *(a1.get(0)): MessageArg.Str(progc)
    let fmt1 MessageFormatter()
    let inner_len fmt1.format(StringC(CmdLineAppMessages.defaultUsage().get_text()), a1, Slice[u32](cap1, bp1), true)
    let inner StringC(bp1, inner_len)
    usage_emit_msg(CmdLineAppMessages.usage().get_text(), inner, utf8)

    ; the usageStart pre-info line.
    usage_emit_msg(CmdLineAppMessages.usageStart().get_text(), progc, utf8)

    let rows Array[UsageRow]()
    if is_fixed
        add_usage_row(&rows, 0x62, true, StringC("encoding"), true, CmdLineAppMessages.name(), CmdLineAppMessages.eHelp())
    else
        add_usage_row(&rows, 0x62, true, StringC("bctf"), true, CmdLineAppMessages.name(), CmdLineAppMessages.bHelp())
    add_usage_row(&rows, 0x66, true, StringC("error-file"), true, CmdLineAppMessages.file(), CmdLineAppMessages.fHelp())
    add_usage_row(&rows, 0x76, true, StringC("version"), false, MessageFragment(), CmdLineAppMessages.vHelp())
    add_usage_row(&rows, 0x68, true, StringC("help"), false, MessageFragment(), CmdLineAppMessages.hHelp())
    add_usage_row(&rows, 0x63, true, StringC("catalog"), true, EntityAppMessages.sysid(), EntityAppMessages.cHelp())
    add_usage_row(&rows, 0x43, true, StringC("catalogs"), false, MessageFragment(), EntityAppMessages.CHelp())
    add_usage_row(&rows, 0x44, true, StringC("directory"), true, EntityAppMessages.directory(), EntityAppMessages.DHelp())
    add_usage_row(&rows, 0x52, true, StringC("restricted"), false, MessageFragment(), EntityAppMessages.RHelp())
    add_usage_row(&rows, 0x61, true, StringC("activate"), true, ParserAppMessages.name(), ParserAppMessages.aHelp())
    add_usage_row(&rows, 0x41, true, StringC("architecture"), true, ParserAppMessages.name(), ParserAppMessages.AHelp())
    add_usage_row(&rows, 0x45, true, StringC("max-errors"), true, ParserAppMessages.number(), ParserAppMessages.EHelp())
    add_usage_row(&rows, 0x65, true, StringC("open-entities"), false, MessageFragment(), ParserAppMessages.eHelp())
    add_usage_row(&rows, 0x67, true, StringC("open-elements"), false, MessageFragment(), ParserAppMessages.gHelp())
    add_usage_row(&rows, 0x6E, true, StringC("error-numbers"), false, MessageFragment(), ParserAppMessages.nHelp())
    add_usage_row(&rows, 0x78, true, StringC("references"), false, MessageFragment(), ParserAppMessages.xHelp())
    add_usage_row(&rows, 0x69, true, StringC("include"), true, ParserAppMessages.name(), ParserAppMessages.iHelp())
    add_usage_row(&rows, 0x77, true, StringC("warning"), true, ParserAppMessages.type(), ParserAppMessages.wHelp())
    add_usage_row(&rows, 0x42, true, StringC("batch-mode"), false, MessageFragment(), NsgmlsMessages.BHelp())
    add_usage_row(&rows, 0x6F, true, StringC("option"), true, NsgmlsMessages.option(), NsgmlsMessages.oHelp())
    add_usage_row(&rows, 0x70, true, StringC("only-prolog"), false, MessageFragment(), NsgmlsMessages.pHelp())
    add_usage_row(&rows, 0x73, true, StringC("no-output"), false, MessageFragment(), NsgmlsMessages.sHelp())
    add_usage_row(&rows, 0x74, true, StringC("rast-file"), true, NsgmlsMessages.file(), NsgmlsMessages.tHelp())
    add_usage_row(&rows, 0x64, false, StringC(), false, MessageFragment(), NsgmlsMessages.dHelp())
    add_usage_row(&rows, 0x6C, false, StringC(), false, MessageFragment(), NsgmlsMessages.lHelp())
    add_usage_row(&rows, 0x6D, false, StringC(), true, NsgmlsMessages.sysid(), NsgmlsMessages.mHelp())
    add_usage_row(&rows, 0x72, false, StringC(), false, MessageFragment(), NsgmlsMessages.rHelp())
    add_usage_row(&rows, 0x75, false, StringC(), false, MessageFragment(), NsgmlsMessages.uHelp())

    ; widest left column across every row (CmdLineApp::usage's leftSize).
    var maxw: size_t 0
    var scratch u32[256]
    let sp Slice[u32](256, scratch as pointer[u32])
    var i: size_t 0
    while i < rows.get_length()
    {
        let l usage_emit_left(sp, rows[i])
        if l > maxw
            set maxw: l
        set i: i + 1
    }

    set i: 0
    while i < rows.get_length()
    {
        let row rows[i]
        var lb u32[2048]
        let lbp lb as pointer[u32]
        let lcap: size_t 2048
        let lbuf Slice[u32](lcap, lbp)
        var p usage_emit_left(lbuf, row)
        ; pad the left column to maxw + 3 (leftSize = maxw + 2, then <=).
        while p <= (maxw + 2)
            set p: ParserState.put_char(Slice[u32](lcap, lbp), p, 0x20)
        var ah Vector[MessageArg](1)
        ; arg/help are literal templates from the catalog (see MessageFragment)
        var arg_sc StringC()
        if row.arg <> null
            set arg_sc: StringC(row.arg)
        set *(ah.get(0)): MessageArg.Str(arg_sc)
        let hf MessageFormatter()
        let added hf.format(StringC(row.help), ah, Slice[u32](lcap - p, lbp + p), true)
        set p: p + added
        set p: ParserState.put_char(Slice[u32](lcap, lbp), p, 0x0A)
        ParserState.write_stderr(Slice[u32](p, lbp), utf8, 1)
        set i: i + 1
    }

    ; the trailing description paragraph (info1..info8; %1 = prog in 1 and 6).
    usage_emit_msg(NsgmlsMessages.info1().get_text(), progc, utf8)
    usage_emit_msg(NsgmlsMessages.info2().get_text(), progc, utf8)
    usage_emit_msg(NsgmlsMessages.info3().get_text(), progc, utf8)
    usage_emit_msg(NsgmlsMessages.info4().get_text(), progc, utf8)
    usage_emit_msg(NsgmlsMessages.info5().get_text(), progc, utf8)
    usage_emit_msg(NsgmlsMessages.info6().get_text(), progc, utf8)
    usage_emit_msg(NsgmlsMessages.info7().get_text(), progc, utf8)
    usage_emit_msg(NsgmlsMessages.info8().get_text(), progc, utf8)
}

procedure main(argc: int, mutable argv: pointer[pointer[char]]) returns int mutable CM_SCRATCH_ARENAS, CM_SCRATCH_INLINE, CM_SCRATCH_PAGES, CM_SCRATCH_STATE, CM_SCRATCH_STATS, STDERR_ENC
{
    let prog_name String(*argv)
    ; the coding systems come from the environment (initCodingSystem runs in
    ; the CmdLineApp constructor) — they govern option-time messages too.
    let is_fixed charset_fixed()
    let out_utf8 output_is_utf8(is_fixed)

    let anchor0 String("x")
    let arg_host Page.get(anchor0.get_buffer())

    ; ---- the option registry, in reference registration order (CmdLineApp,
    ;      EntityApp, ParserApp, NsgmlsApp) — implemented options only; see
    ;      the header comment for the axes still to come. ----
    let reg Array[LongOpt]^arg_host()
    ; -b is CmdLineApp's FIRST registration; its long name is mode-dependent
    ; (initCodingSystem runs in the constructor before registerOption):
    ; --bctf without SP_CHARSET_FIXED, --encoding with it.
    if is_fixed
        reg.add(LongOpt(String("encoding"), 0x62, true))
    else
        reg.add(LongOpt(String("bctf"), 0x62, true))
    reg.add(LongOpt(String("error-file"), 0x66, true))
    reg.add(LongOpt(String("version"), 0x76, false))
    reg.add(LongOpt(String("help"), 0x68, false))
    reg.add(LongOpt(String("catalog"), 0x63, true))
    reg.add(LongOpt(String("catalogs"), 0x43, false))
    reg.add(LongOpt(String("directory"), 0x44, true))
    reg.add(LongOpt(String("restricted"), 0x52, false))
    reg.add(LongOpt(String("activate"), 0x61, true))
    reg.add(LongOpt(String("max-errors"), 0x45, true))
    reg.add(LongOpt(String("open-entities"), 0x65, false))
    reg.add(LongOpt(String("open-elements"), 0x67, false))
    reg.add(LongOpt(String("error-numbers"), 0x6E, false))
    reg.add(LongOpt(String("references"), 0x78, false))
    reg.add(LongOpt(String("include"), 0x69, true))
    reg.add(LongOpt(String("warning"), 0x77, true))
    reg.add(LongOpt(String("batch-mode"), 0x42, false))
    reg.add(LongOpt(String("option"), 0x6F, true))
    reg.add(LongOpt(String("only-prolog"), 0x70, false))
    reg.add(LongOpt(String("no-output"), 0x73, false))
    reg.add(LongOpt(String("rast-file"), 0x74, true))
    reg.add(LongOpt(String(), 0x64, false))
    reg.add(LongOpt(String(), 0x6C, false))
    ; -m: short-only in the reference too (its `--catalog` registration is
    ; commented out in nsgmls.cxx).
    reg.add(LongOpt(String(), 0x6D, true))
    reg.add(LongOpt(String(), 0x72, false))
    reg.add(LongOpt(String(), 0x75, false))
    reg.add(LongOpt(String("architecture"), 0x41, true))

    let active_links Array[String]^arg_host()
    ; -A architecture names (ParserApp::arcNames_). initParser activates
    ; arcNames_[0] as a link type; parseAll then drives the ArcEngine over
    ; the base event stream. (ArcEngine transform: see ArcEngine.scaly.)
    let arc_names Array[String]^arg_host()
    let opts ParserOptions.make(arg_host)
    ; the entity-manager surface (EntityApp): -c/-m catalogs (the command-line
    ; ones must exist), -D search dirs, -C, -R, plus the env additions below.
    let catalog_sysids Array[String]^arg_host()
    let search_dirs Array[String]^arg_host()
    var map_catalog_document false
    var restrict_reading false
    var error_limit: u32 200
    var reporter_options: u32 0
    var output_flags: u32 0
    var prolog_only false
    var suppress false
    var want_usage false
    var batch false
    var error_file: pointer[char] null
    var rast_file: pointer[char] null

    ; -b: outputCodingSystem_. Filled by a valid -b during the loop; when no
    ; -b (or only invalid ones — processOption resets the pointer to 0 on a
    ; failed lookup) the environment default applies after the loop.
    ; -b: outputCodingSystem_. Filled by a valid -b during the loop; when no
    ; -b (or only invalid ones — processOption resets the pointer to 0 on a
    ; failed lookup) the environment default applies after the loop. The
    ; record is page-allocated inside the opensp package (a cross-package
    ; sizeof of an opensp type in this driver miscompiles).
    let out_enc CodingSystemKit.new_encoder(arg_host)
    var have_b false
    let is_bctf is_fixed = false

    let os Options.make(arg_host, argc, argv, &reg)
    var c: u32 0
    var scanning os.get(&c)
    while scanning
    {
        if (c = 0x3F) or (c = 0x2D) or (c = 0x3D)
        {
            ; CmdLineApp::processOptions error rendering: a long option's
            ; name comes from the raw argv cell (up to '=', 79 chars); a
            ; short option is its single char. Note a short option with a
            ; MISSING argument also lands here as '?' — the reference
            ; renders it as "invalid option", missingOptionArgError is dead.
            var nbuf u32[80]
            let nb nbuf as pointer[u32]
            var nlen: size_t 0
            if os.get_opt() = 0
            {
                let cell *(argv + (os.get_ind() - 1))
                var ti: size_t 2
                var copying true
                while copying
                {
                    let tc (*(cell + ti)) as u32
                    if (tc = 0) or (tc = 0x3D) or (nlen >= 79)
                        set copying: false
                    else
                    {
                        set nbuf[nlen]: tc
                        set nlen: nlen + 1
                        set ti: ti + 1
                    }
                }
            }
            else
            {
                set *nb: os.get_opt()
                set nlen: 1
            }
            let oname StringC(nb, nlen)
            var emt CmdLineAppMessages.invalidOptionError()
            if c = 0x2D
                set emt: CmdLineAppMessages.ambiguousOptionError()
            if c = 0x3D
                set emt: CmdLineAppMessages.erroneousOptionArgError()
            app_msg1(prog_name, out_utf8, (reporter_options & ONS_REP_MESSAGE_NUMBERS) <> 0, emt, oname)
            app_msg0(prog_name, out_utf8, (reporter_options & ONS_REP_MESSAGE_NUMBERS) <> 0, CmdLineAppMessages.tryHelpOptionForInfo())
            return 1
        }
        else if c = 0x62
        {
            ; processOption 'b': outputCodingSystem_ = lookupCodingSystem(arg).
            ; An unknown name reports unknownBctf/unknownEncoding (quoted arg,
            ; exit unaffected, parse continues) and leaves the pointer 0 — the
            ; env default reapplies even after an earlier VALID -b.
            var bkind 0
            var bwhich 0
            let barg String(os.get_arg() as pointer[const_char])
            if CodingSystemKit.lookup(barg, is_bctf, &bkind, &bwhich)
            {
                CodingSystemKit.make_encoder(arg_host, bkind, bwhich, out_enc)
                set have_b: true
            }
            else
            {
                set have_b: false
                var emt CmdLineAppMessages.unknownBctf()
                if is_fixed
                    set emt: CmdLineAppMessages.unknownEncoding()
                app_msg1(prog_name, out_utf8, (reporter_options & ONS_REP_MESSAGE_NUMBERS) <> 0, emt, StringC(os.get_arg() as pointer[const_char]))
            }
        }
        else if c = 0x61
            active_links.add(String(os.get_arg() as pointer[const_char]))
        else if c = 0x41
            arc_names.add(String(os.get_arg() as pointer[const_char]))
        else if (c = 0x63) or (c = 0x6D)
        {
            ; -c / its NsgmlsApp alias -m: a command-line catalog (must exist).
            let cv String^arg_host(os.get_arg() as pointer[const_char])
            catalog_sysids.add(*cv)
        }
        else if c = 0x43
            set map_catalog_document: true
        else if c = 0x44
        {
            let dv String^arg_host(os.get_arg() as pointer[const_char])
            search_dirs.add(*dv)
        }
        else if c = 0x52
            set restrict_reading: true
        else if c = 0x77
        {
            let wv String(os.get_arg() as pointer[const_char])
            if opts.enable_warning(wv) = false
                app_msg1(prog_name, out_utf8, (reporter_options & ONS_REP_MESSAGE_NUMBERS) <> 0, ParserAppMessages.unknownWarning(), StringC(os.get_arg() as pointer[const_char]))
        }
        else if c = 0x45
        {
            var ok_lim false
            let lim parse_error_limit(os.get_arg(), &ok_lim)
            if ok_lim
                set error_limit: lim
            else
                app_msg0(prog_name, out_utf8, (reporter_options & ONS_REP_MESSAGE_NUMBERS) <> 0, ParserAppMessages.badErrorLimit())
        }
        else if c = 0x69
        {
            if opts.includes = null
                set opts.includes: Array[StringC]^arg_host()
            let iv StringC^arg_host(os.get_arg() as pointer[const_char])
            opts.includes.add(iv)
        }
        else if c = 0x65
            set reporter_options: reporter_options | ONS_REP_OPEN_ENTITIES
        else if c = 0x67
            set reporter_options: reporter_options | ONS_REP_OPEN_ELEMENTS
        else if c = 0x6E
            set reporter_options: reporter_options | ONS_REP_MESSAGE_NUMBERS
        else if c = 0x78
            set reporter_options: reporter_options | ONS_REP_CLAUSES
        else if c = 0x6F
        {
            ; NsgmlsApp::processOption 'o': exact table match; unknown names
            ; render the app-level unknownOutputOption E (quoted arg) and do
            ; NOT affect the exit code (probed: exit 0 on a clean doc).
            var found false
            let of output_option_flag(os.get_arg(), &found)
            if found
                set output_flags: output_flags | of
            else
                app_msg1(prog_name, out_utf8, (reporter_options & ONS_REP_MESSAGE_NUMBERS) <> 0, NsgmlsMessages.unknownOutputOption(), StringC(os.get_arg() as pointer[const_char]))
        }
        else if c = 0x6C
            set output_flags: output_flags | ONS_OF_LINE
        else if c = 0x64
            opts.enable_warning(String("duplicate"))
        else if c = 0x72
            opts.enable_warning(String("default"))
        else if c = 0x75
            opts.enable_warning(String("undefined"))
        else if c = 0x76
        {
            ; versionInfo: `"OpenSP" version "1.5.2"`, Info, parse continues.
            var vargs Vector[MessageArg](2)
            set *(vargs.get(0)): MessageArg.Str(StringC("OpenSP"))
            set *(vargs.get(1)): MessageArg.Str(StringC("1.5.2"))
            app_msg(prog_name, out_utf8, (reporter_options & ONS_REP_MESSAGE_NUMBERS) <> 0, CmdLineAppMessages.versionInfo(), vargs)
        }
        else if c = 0x66
            set error_file: os.get_arg()
        else if c = 0x74
            set rast_file: os.get_arg()
        else if c = 0x42
            set batch: true
        else if c = 0x70
            set prolog_only: true
        else if c = 0x73
            set suppress: true
        else if c = 0x68
            ; -h: like the reference, only SET the flag — the option loop runs
            ; to the end (so a -b after -h still applies) and usage prints after
            ; the -f error-file open below.
            set want_usage: true
        set scanning: os.get(&c)
    }

    ; processOptions epilogue: `if (!outputCodingSystem_) outputCodingSystem_
    ; = codingSystem()` — the environment pair (UTF-8 under SP_CHARSET_FIXED
    ; + SP_ENCODING=XML/UTF-8 or SP_BCTF=UTF-8, else identity).
    if have_b = false
        output_coding_system(arg_host, is_fixed, out_enc)
    ; makeStdErr(): the message stream encodes through codingSystem() — the
    ; ENVIRONMENT pair, never the -b override (which is outputCodingSystem_).
    let err_enc CodingSystemKit.new_encoder(arg_host)
    output_coding_system(arg_host, is_fixed, err_enc)
    ParserState.set_stderr_encoder(err_enc)

    ; -f: opened AFTER the option loop (processOptions does), so option-time
    ; messages always reach the real stderr; open failure aborts with the
    ; openFileError message (%2 = strerror text, unquoted).
    var msg_fd: int 2
    if error_file <> null
    {
        let fd creat(error_file as pointer[const_char], 0x1B6 as u32)
        if fd = ((0 - 1) as i32)
        {
            var fargs Vector[MessageArg](2)
            set *(fargs.get(0)): MessageArg.Str(StringC(error_file as pointer[const_char]))
            set *(fargs.get(1)): MessageArg.Raw(StringC(strerror(scaly_eio_errno())))
            app_msg(prog_name, out_utf8, (reporter_options & ONS_REP_MESSAGE_NUMBERS) <> 0, CmdLineAppMessages.openFileError(), fargs)
            return 1
        }
        set msg_fd: fd as int
    }

    ; -h/--help: CmdLineApp::run prints the usage AFTER processOptions (so a bad
    ; -f still aborts first) and returns 0 without touching the document.
    if want_usage
    {
        print_usage(prog_name, out_utf8, is_fixed)
        return 0
    }

    ; the entity-manager config (EntityApp::entityManager): the command-line
    ; catalogs count as must-exist; SGML_CATALOG_FILES and SGML_SEARCH_PATH
    ; append after them; SP_USE_DOCUMENT_CATALOG=NO/0 (any case) disables the
    ; document's implicit `catalog` file.
    let n_must_exist catalog_sysids.get_length()
    split_path_env(&catalog_sysids, getenv("SGML_CATALOG_FILES"), arg_host)
    split_path_env(&search_dirs, getenv("SGML_SEARCH_PATH"), arg_host)
    var use_doc_catalog true
    let udc getenv("SP_USE_DOCUMENT_CATALOG")
    if udc <> null
    {
        if env_matches(udc, String("NO")) or env_matches(udc, String("0"))
            set use_doc_catalog: false
    }
    var em_cfg EmConfig()
    set em_cfg.catalog_sysids: &catalog_sysids
    set em_cfg.n_must_exist: n_must_exist
    set em_cfg.search_dirs: &search_dirs
    set em_cfg.use_doc_catalog: use_doc_catalog
    set em_cfg.restrict_reading: restrict_reading
    set em_cfg.map_catalog_document: map_catalog_document
    ; codingSystem(): what every document, DTD, entity and catalog file is
    ; DECODED with (ExtendEntityManager::make's codingSystem argument).
    var in_cs CodingSystem.identity()
    input_coding_system(arg_host, is_fixed, &in_cs)
    em_cfg.set_input_cs(in_cs)

    let first_arg os.get_ind()
    if batch
    {
        ; NsgmlsApp::processArguments batch mode: each argument is its own
        ; parse; the ESIS streams concatenate and the exit status is the max.
        ; With -t the per-document RAST file is the -t value CONCATENATED
        ; with the argument (rastFile_.assign(rastOption_) + append(argv[i])).
        var ret 0
        var ai first_arg
        while ai < argc
        {
            var rp String()
            if rast_file <> null
            {
                let racc Array[u8]()
                append_lit(&racc, rast_file as pointer[const_char])
                append_lit(&racc, (*(argv + ai)) as pointer[const_char])
                set rp: String(racc.get_buffer() as pointer[const_char], racc.get_length())
            }
            let r process_document(argv + ai, 1, prog_name, out_utf8, out_enc, is_fixed, &active_links, opts, error_limit, reporter_options, output_flags, msg_fd, prolog_only, suppress, rast_file <> null, rp, &em_cfg, &arc_names)
            if r < 0
                return 1
            if r > ret
                set ret: r
            set ai: ai + 1
        }
        ContentToken.report_cm_scratch()
        return ret
    }
    ; without -B all file arguments merge into ONE document entity
    ; (EntityApp::makeSystemId -> mergeSystemIds).
    var rp2 String()
    if rast_file <> null
        set rp2: String(rast_file as pointer[const_char])
    let rmain process_document(argv + first_arg, argc - first_arg, prog_name, out_utf8, out_enc, is_fixed, &active_links, opts, error_limit, reporter_options, output_flags, msg_fd, prolog_only, suppress, rast_file <> null, rp2, &em_cfg, &arc_names)
    if rmain < 0
        return 1
    ContentToken.report_cm_scratch()
    rmain
}
