; onsgmls — the OpenSP drop-in event-dump program (Stage 4 Increment 3).
;
; A minimal onsgmls: read an SGML document, parse it, and write the ESIS event
; stream to stdout — the harness tests/sgml/run.sh measures against the
; reference onsgmls (ROADMAP-dazzle.md Part I, the corpus counter). The full
; NsgmlsApp CLI (flags, catalogs, message output, the whole markup Event set)
; is Stage 5; this is the event-dump core that starts ticking the counter.
;
; Scope (Stage 4 Increment 3): a well-formed document with an INTERNAL DTD
; subset and explicit tags — parse_to_esis drives prolog (DOCTYPE) + content and
; Esis.write emits the ESIS. Exit 0 when conforming (no errors), else 1, matching
; onsgmls.

package scaly 0.1.0
package opensp 0.1.0

use opensp
use opensp.Parser.Parser
use opensp.StringC.StringC
use opensp.ParserOptions.ParserOptions
use scaly.io.File
use scaly.io.Path
use scaly.io.Console
use scaly.memory.Page
use scaly.memory.root_pages.getenv
use scaly.containers.String
use scaly.containers.Array
use scaly.fiber.Io

; case-insensitive exact match of a NUL-terminated env value against an ASCII
; key, CmdLineApp::stringMatches / CodingSystemKitImpl::match: each value char
; must equal the key char in either case, and both must end together.
function env_matches(v: pointer[const_char], key: String) returns bool
{
    let n key.get_length()
    var i: size_t 0
    while i < n
    {
        let c (*(v + i)) as u32
        if c = (0 as u32)
            return false
        var k (key.get(i)) as u32
        var cu c
        if (cu >= (0x61 as u32)) and (cu <= (0x7A as u32))
            set cu: cu - (0x20 as u32)
        if (k >= (0x61 as u32)) and (k <= (0x7A as u32))
            set k: k - (0x20 as u32)
        if cu <> k
            return false
        set i: i + 1
    }
    ((*(v + n)) as u32) = (0 as u32)
}

; SP_CHARSET_FIXED=YES/1 (any case) — CmdLineApp::initCodingSystem:
; internalCharsetIsDocCharset_ goes FALSE, i.e. the internal charset is the
; fixed system charset and document chars are TRANSLATED into it (numeric
; char refs run translateNumericCharRef against the CHARSET declaration).
; This is the ONLY input to the charset-fixed decision — SP_ENCODING never
; affects it (it only selects the coding systems below).
function charset_fixed() returns bool
{
    let fixed getenv("SP_CHARSET_FIXED")
    if fixed <> null
    {
        if env_matches(fixed, String("YES")) or env_matches(fixed, String("1"))
            return true
    }
    false
}

; The output coding system, CmdLineApp::initCodingSystem: SP_ENCODING is
; consulted ONLY when SP_CHARSET_FIXED fixes the internal charset to Unicode
; (is_fixed — the same test above); without it the BCTF variable SP_BCTF is
; consulted instead. Of the encoding table only XML and UTF-8 select a UTF-8
; output encoder (XMLCodingSystem::makeEncoder returns the UTF-8 encoder);
; any other (or no, or unknown) name falls back to the identity system — the
; SP_DEFAULT_ENCODING fallback IS8859-1 maps to identity on a Unicode system
; charset. The multi-byte systems we don't model (UTF-16, UCS-2, EUC, ...)
; are not selectable by the corpus. Verified against onsgmls 1.5.2:
; SP_ENCODING=XML alone (no SP_CHARSET_FIXED) stays identity.
function output_is_utf8(is_fixed: bool) returns bool
{
    if is_fixed
    {
        let enc getenv("SP_ENCODING")
        if enc <> null
        {
            if env_matches(enc, String("XML")) or env_matches(enc, String("UTF-8"))
                return true
        }
        return false
    }
    let bctf getenv("SP_BCTF")
    if bctf <> null
    {
        if env_matches(bctf, String("UTF-8"))
            return true
    }
    false
}

; app-level diagnostic line on stderr (fd 2), no location segment:
; `<prog>:<sev>: <text>` — CmdLineApp messages (e.g. unknownWarning) render
; without any storage id. The newline is a numeric LF byte (see Console).
function eline(prog: String, mid: String, arg: String, tail: String)
{
    Io.write_all(2 as i32, prog.get_buffer() as pointer[void], prog.get_length())
    Io.write_all(2 as i32, mid.get_buffer() as pointer[void], mid.get_length())
    Io.write_all(2 as i32, arg.get_buffer() as pointer[void], arg.get_length())
    Io.write_all(2 as i32, tail.get_buffer() as pointer[void], tail.get_length())
    var nl: u8 (10 as u8)
    let nl_ptr &nl
    Io.write_all(2 as i32, nl_ptr as pointer[void], 1 as size_t)
}

function main(argc: int, argv: pointer[pointer[char]]) returns int
{
    if argc < 2
        return 2
    ; -a<name> / -a <name> (repeatable): activate a link type (ParserApp's
    ; 'a' option). -w<type> / -w <type> (repeatable): enable a warning /
    ; validation flag (ParserApp's 'w' option; unknown types render
    ; unknownWarning app-level and do NOT affect the exit code). The first
    ; non-option argument is the document path — the drop-in parses no other
    ; options.
    let anchor0 String("x")
    let arg_host Page.get(anchor0.get_buffer() as pointer[void])
    let active_links Array[String]^arg_host()
    let warn_args Array[String]^arg_host()
    var path_ptr: pointer[char] null
    var ai: int 1
    while ai < argc
    {
        let a *(argv + ai)
        let av String(a)
        var opt_char: u8 0 as u8
        if av.get_length() >= (2 as size_t)
        {
            if av.get(0) = (0x2D as u8)
            {
                if av.get(1) = (0x61 as u8)
                    set opt_char: 0x61 as u8
                if av.get(1) = (0x77 as u8)
                    set opt_char: 0x77 as u8
            }
        }
        if opt_char <> (0 as u8)
        {
            var opt_val String()
            var have_val false
            if av.get_length() > (2 as size_t)
            {
                set opt_val: String((a + (2 as size_t)) as pointer[const_char])
                set have_val: true
            }
            else
            {
                set ai: ai + 1
                if ai < argc
                {
                    set opt_val: String(*(argv + ai))
                    set have_val: true
                }
            }
            if have_val
            {
                if opt_char = (0x61 as u8)
                    active_links.add(opt_val)
                else
                    warn_args.add(opt_val)
            }
        }
        else
        {
            if path_ptr = null
                set path_ptr: a
        }
        set ai: ai + 1
    }
    if path_ptr = null
        return 2
    let path String(path_ptr)
    ; onsgmls displays the document's storage id (the path as given) in every
    ; diagnostic, prefixed by the program name (argv[0]); build both.
    let doc_name StringC(path.to_c_string())
    let prog_name String(*argv)
    let contents File.read_to_string(path)
    ; Anchor the run region on the (small, page-hosted) path String — NOT on the
    ; document buffer: a document larger than PAGE_SIZE lands in an oversized
    ; bucket, and Page.get on an oversized object masks to a bogus page header.
    let host Page.get(path.get_buffer() as pointer[void])
    ; external DTD subsets resolve their (relative) system ids against the
    ; document's directory.
    let base_dir Path.get_directory_name(path)
    ; the -w axis: apply each -w argument via the enableWarning table; an
    ; unknown type renders `<prog>:E: unknown warning type "<arg>"` on stderr
    ; BEFORE any parse output (option-processing time) and is otherwise
    ; ignored (the real onsgmls exit code is unaffected).
    let opts ParserOptions.make(host)
    let nw warn_args.get_length()
    var wi: size_t 0
    while wi < nw
    {
        let wv *(warn_args.get_buffer() + wi)
        if opts.enable_warning(wv) = false
        {
            let mid String(":E: unknown warning type \"")
            let tail String("\"")
            eline(prog_name, mid, wv, tail)
        }
        set wi: wi + 1
    }
    var conforming false
    let is_fixed charset_fixed()
    let out_utf8 output_is_utf8(is_fixed)
    let esis Parser.parse_to_esis(host, contents, base_dir, doc_name, prog_name, out_utf8, is_fixed, &active_links, opts, &conforming)
    Console.print(esis.to_c_string())
    if conforming
        return 0
    1
}
