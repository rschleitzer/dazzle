<!ATTLIST rule dash CDATA #IMPLIED>
<!ELEMENT table (row+)>
<!ELEMENT row (cell+)>
<!ELEMENT cell (#PCDATA)>
<!ATTLIST cell own CDATA #IMPLIED>
]>
<doc>
<p>Linien mit Strichmustern:</p>
<rule dash="even"/>
<rule dash="odd"/>
<rule dash="offset"/>
<rule dash="zero"/>
<rule/>
<p>Ein Wort mit <u>gestricheltem Strich darunter</u> und weiter.</p>
<table>
<row><cell>eins</cell><cell own="yes">zwei, mit eigenem Muster</cell></row>
<row><cell>drei</cell><cell>vier</cell></row>
</table>
</doc>
