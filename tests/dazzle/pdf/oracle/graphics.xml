<?xml version="1.0"?>
<!DOCTYPE doc [
<!ELEMENT doc (p | fig)+>
<!ELEMENT p (#PCDATA | fig)*>
<!ELEMENT fig EMPTY>
<!ATTLIST fig scale CDATA #IMPLIED mw CDATA #IMPLIED mh CDATA #IMPLIED>
]>
<doc>
<p>wie es ist:</p><fig />
<p>Faktor 2:</p><fig scale="2"/>
<p>Faktoren 2 und 0,5:</p><fig scale="2 0.5"/>
<p>max-width 100pt:</p><fig mw="100"/>
<p>max-height 10pt:</p><fig mh="10"/>
<p>beides, gleichmäßig:</p><fig mw="100" mh="20"/>
<p>max, je Richtung:</p><fig scale="max" mw="100" mh="20"/>
<p>max, nur Breite:</p><fig scale="max" mw="60"/>
<p>breiter als der Bereich:</p><fig scale="max-uniform" mw="500"/>
<p>Im Text <fig mh="8"/> auf der Zeile.</p>
</doc>
