<?xml version="1.0"?>
<fot>
<simple-page-sequence>
<simple-page-sequence.left-header>
<side-by-side keep="page"/>
<side-by-side-item/>
<embedded-text direction="right-to-left"/>
<text>hdr-et</text>
</embedded-text>
</side-by-side-item>
</side-by-side>
</simple-page-sequence.left-header>
<simple-page-sequence.center-header>
<included-container-area escapement-direction="left-to-right" display="true" scale="max-uniform" width="4pt" break-before-priority="2" space-before="5pt"/>
<text>hdr-ica</text>
</included-container-area>
</simple-page-sequence.center-header>
<simple-page-sequence.right-header>
<aligned-column keep-with-next="true"/>
<text>hdr-ac</text>
</aligned-column>
</simple-page-sequence.right-header>
<sequence>
<fraction>
<fraction.fraction-bar/>
<fraction.numerator>
<side-by-side/>
<side-by-side-item/>
<a name="0"/>
<a name="FIRST"/>
<text>num</text>
</side-by-side-item>
</side-by-side>
</fraction.numerator>
<fraction.denominator>
<included-container-area scale-x="3" scale-y="3"/>
<a name="FIRST"/>
<text>den</text>
</included-container-area>
</fraction.denominator>
</fraction>
<table>
<table.before-row-border border-present="false"/>
<table.after-row-border border-present="false"/>
<table.before-column-border border-present="false"/>
<table.after-column-border border-present="false"/>
<table-part>
<table-part.principal>
<table-row>
<sequence>
<table-cell column-number="1">
<table-cell.before-row-border border-present="false"/>
<table-cell.after-row-border border-present="false"/>
<table-cell.before-column-border border-present="false"/>
<table-cell.after-column-border border-present="false"/>
<embedded-text direction="left-to-right"/>
<text>td</text>
</embedded-text>
</table-cell>
</sequence>
<sequence>
<table-cell column-number="0">
<table-cell.before-row-border border-present="false"/>
<table-cell.after-row-border border-present="false"/>
<table-cell.before-column-border border-present="false"/>
<table-cell.after-column-border border-present="false"/>
</table-cell>
</sequence>
</table-row>
</table-part.principal>
<table-part.header>
<table-row>
<sequence>
<table-cell column-number="1">
<table-cell.before-row-border border-present="false"/>
<table-cell.after-row-border border-present="false"/>
<table-cell.before-column-border border-present="false"/>
<table-cell.after-column-border border-present="false"/>
<aligned-column space-after="2pt"/>
<a name="FIRST"/>
<text>th</text>
</aligned-column>
</table-cell>
</sequence>
<sequence>
<table-cell column-number="0">
<table-cell.before-row-border border-present="false"/>
<table-cell.after-row-border border-present="false"/>
<table-cell.before-column-border border-present="false"/>
<table-cell.after-column-border border-present="false"/>
</table-cell>
</sequence>
</table-row>
</table-part.header>
<table-part.footer>
</table-part.footer>
</table-part>
</table>
</sequence>
</simple-page-sequence>
</fot>
