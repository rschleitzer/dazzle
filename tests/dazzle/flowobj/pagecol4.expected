<?xml version="1.0"?>
<fot>
<simple-page-sequence>
<simple-page-sequence.left-header>
<page-sequence binding-edge="left"/>
<text>hdr-ps</text>
</page-sequence>
</simple-page-sequence.left-header>
<simple-page-sequence.center-header>
<column-set-sequence keep="page" space-before="5pt"/>
<text>hdr-css</text>
</column-set-sequence>
</simple-page-sequence.center-header>
<sequence>
<fraction>
<fraction.fraction-bar/>
<fraction.numerator>
<page-sequence/>
<a name="0"/>
<a name="FIRST"/>
<text>num</text>
</page-sequence>
</fraction.numerator>
<fraction.denominator>
<column-set-sequence break-after="column"/>
<a name="FIRST"/>
<text>den</text>
</column-set-sequence>
</fraction.denominator>
</fraction>
<table>
<table.before-row-border border-present="false"/>
<table.after-row-border border-present="false"/>
<table.before-column-border border-present="false"/>
<table.after-column-border border-present="false"/>
<table-part>
<table-part.principal>
<table-row>
<sequence>
<table-cell column-number="1">
<table-cell.before-row-border border-present="false"/>
<table-cell.after-row-border border-present="false"/>
<table-cell.before-column-border border-present="false"/>
<table-cell.after-column-border border-present="false"/>
<page-sequence page-category="page"/>
<text>td</text>
</page-sequence>
</table-cell>
</sequence>
<sequence>
<table-cell column-number="0">
<table-cell.before-row-border border-present="false"/>
<table-cell.after-row-border border-present="false"/>
<table-cell.before-column-border border-present="false"/>
<table-cell.after-column-border border-present="false"/>
</table-cell>
</sequence>
</table-row>
</table-part.principal>
<table-part.header>
<table-row>
<sequence>
<table-cell column-number="1">
<table-cell.before-row-border border-present="false"/>
<table-cell.after-row-border border-present="false"/>
<table-cell.before-column-border border-present="false"/>
<table-cell.after-column-border border-present="false"/>
<column-set-sequence space-after="2pt"/>
<a name="FIRST"/>
<text>th</text>
</column-set-sequence>
</table-cell>
</sequence>
<sequence>
<table-cell column-number="0">
<table-cell.before-row-border border-present="false"/>
<table-cell.after-row-border border-present="false"/>
<table-cell.before-column-border border-present="false"/>
<table-cell.after-column-border border-present="false"/>
</table-cell>
</sequence>
</table-row>
</table-part.header>
<table-part.footer>
</table-part.footer>
</table-part>
</table>
</sequence>
</simple-page-sequence>
</fot>
