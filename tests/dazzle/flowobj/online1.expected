<?xml version="1.0"?>
<fot>
<simple-page-sequence>
<sequence>
<marginalia>
<a name="0"/>
<a name="FIRST"/>
<text>marg-plain</text>
</marginalia>
<marginalia marginalia-sep="3pt" float-out-marginalia="true" marginalia-keep-with-previous="true" marginalia-side="start">
<text>marg-full</text>
</marginalia>
<marginalia>
<marginalia>
<text>marg-nested</text>
</marginalia>
</marginalia>
<multi-mode>
<text>mm-plain</text>
</multi-mode>
<multi-mode>
<multi-mode.mode>
<text>mm-principal</text>
</multi-mode.mode>
</multi-mode>
<multi-mode>
<text>mm-unlabelled</text>
<multi-mode.mode name="a">
<sequence>
<a name="FIRST"/>
<text>A</text>
</sequence>
</multi-mode.mode>
<multi-mode.mode name="b">
<sequence>
<a name="FIRST"/>
<text>B</text>
</sequence>
</multi-mode.mode>
</multi-mode>
<multi-mode>
<multi-mode.mode desc="pdesc">
<text>P</text>
</multi-mode.mode>
<multi-mode.mode name="x" desc="xdesc">
<sequence>
<a name="FIRST"/>
<text>X</text>
</sequence>
</multi-mode.mode>
<multi-mode.mode name="y">
<sequence>
<a name="FIRST"/>
<text>Y</text>
</sequence>
</multi-mode.mode>
</multi-mode>
<multi-mode>
<multi-mode.mode>
<text>only-principal</text>
</multi-mode.mode>
<multi-mode.mode name="empty">
</multi-mode.mode>
</multi-mode>
<multi-mode>
<multi-mode.mode name="dup">
<sequence>
<a name="FIRST"/>
<text>D</text>
</sequence>
</multi-mode.mode>
<multi-mode.mode name="dup">
</multi-mode.mode>
</multi-mode>
<multi-mode>
<text>mm-empty</text>
</multi-mode>
<multi-mode>
<multi-mode.mode desc="lazy-principal">
<text>LZP</text>
</multi-mode.mode>
<multi-mode.mode name="lz">
<sequence>
<a name="FIRST"/>
<text>LZ</text>
</sequence>
</multi-mode.mode>
</multi-mode>
<multi-mode>
<multi-mode.mode>
<text>OP</text>
<multi-mode>
<multi-mode.mode>
<text>IP</text>
</multi-mode.mode>
<multi-mode.mode name="inner">
<sequence>
<a name="FIRST"/>
<text>IN</text>
</sequence>
</multi-mode.mode>
</multi-mode>
</multi-mode.mode>
<multi-mode.mode name="outer">
<sequence>
<a name="FIRST"/>
<text>OUT</text>
</sequence>
</multi-mode.mode>
</multi-mode>
<marginalia>
<multi-mode>
<multi-mode.mode name="m">
<side-by-side/>
<side-by-side-item/>
<a name="FIRST"/>
<text>mixed</text>
</side-by-side-item>
</side-by-side>
</multi-mode.mode>
</multi-mode>
</marginalia>
</sequence>
</simple-page-sequence>
</fot>
