<?xml version="1.0"?>
<fot>
<simple-page-sequence>
<sequence>
<page-sequence/>
<a name="0"/>
<a name="FIRST"/>
<text>ps-default</text>
</page-sequence>
<page-sequence page-category="page" force-last-page="front" force-first-page="back" first-page-type="right" jystify-spread="true" binding-edge="right"/>
<text>ps-full</text>
</page-sequence>
<page-sequence jystify-spread="false"/>
<text>ps-false</text>
</page-sequence>
<column-set-sequence/>
<text>css-default</text>
</column-set-sequence>
<column-set-sequence keep-with-previous="true" keep-with-next="true" may-violate-keep-before="true" may-violate-keep-after="true" position-preference="bottom" keep="column-set" break-before="page" break-after="column" space-before="6pt" space-after="7pt"/>
<text>css-full</text>
</column-set-sequence>
<column-set-sequence space-before="3pt,1pt,9pt"/>
<text>css-space</text>
</column-set-sequence>
<column-set-sequence space-before="3pt"/>
<text>css-lazy</text>
</column-set-sequence>
<page-sequence binding-edge="left"/>
<text>ps-lazy</text>
</page-sequence>
<page-sequence font-size="11pt"/>
<text>ps-ic</text>
</page-sequence>
<column-set-sequence font-size="12pt"/>
<text>css-ic</text>
</column-set-sequence>
<page-sequence/>
<column-set-sequence/>
<page-sequence/>
<text>nested</text>
</page-sequence>
</column-set-sequence>
</page-sequence>
</sequence>
</simple-page-sequence>
</fot>
