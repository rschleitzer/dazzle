use scaly.memory.Page

; ---- measurement hook: DZ_FRAME_VOL --------------------------------------
; Not a feature. It answers the question the value-model design cannot be
; costed without (tests/dazzle/PERFORMANCE.md, "Die dritte und vierte Sprosse"
; → "Was das für Sprosse (ii) heißt"): a region per DSSSL frame is the lever
; the memory decomposition points at, but nobody has counted the FRAMES. If the
; engine pushes 10^8 of them, a page allocate/release per frame is ~2 s of a
; 13 s run — the whole projected win — so the design hinges on two numbers:
;
;   * how many frames are there, and
;   * how many of them allocate NOTHING (a lazily materialised frame region
;     costs those nothing, which is what decides "every frame" against
;     "selected frames").
;
; `frameprobe` measured the LIFETIME of the bytes (98.5 % die at one frame
; boundary). This measures the VOLUME and the COUNT — the other two factors of
; the same product.
;
; Mechanics: at every VM frame push/pop, read the eval region's bump position
; and attribute the delta to the frame that was running. That gives each frame
; its SELF bytes (its own allocations, excluding its callees', because a callee
; is the running frame while it allocates). Reading the position is amortised
; O(1): the page count walks forward from the last tail seen, and within a
; bracket a region only grows at the end, so the total hops over a run are the
; pages created, not the frames observed.
;
; The region is read by OFFSET (Page.scaly documents the first four slots as
; load-bearing byte offsets: next_object, current_page, next_page,
; exclusive_pages.head) rather than through Page's fields — Page is one of the
; runtime-opaque structs, and a probe has no business making this package lay
; it out.
;
; Known blind spots, all deliberate and all reported:
;   * only BUMP bytes are counted. An oversized/exclusive-page allocation is
;     not measured, only FLAGGED per frame (the exclusive-list head changed),
;     because measuring it needs a list walk on the hot path.
;   * a frame that straddles an eval-bracket switch is dropped, not guessed
;     (its baseline belongs to a region that is gone). Counted as `straddled`.
;   * bytes allocated while no frame is on the stack land in `outside`.
;
; Measurement builds only (DZ_FRAME_VOL unset = every hook is one load and a
; not-taken branch). Built by tests/dazzle/framevol/run.sh, never by
; build-cli.sh.

function getenv(name: pointer[const_char]) returns pointer[const_char] extern
function calloc(count: size_t, size: size_t) returns pointer[void] extern
procedure atexit(cb: pointer[void]) returns i32 extern
procedure scaly_eputs(s: pointer[const_char]) extern
procedure scaly_eputi(value: i64) extern
procedure scaly_eputnl() extern

define FV_PAGE_SIZE: i64 4096
; the per-frame columns; deeper frames are counted, not measured
define FV_MAX_DEPTH: i64 65536
; eval brackets nest with the document, so this is generous
define FV_MAX_BRACKET: i64 1024
; bucket 0 = "allocated nothing", bucket k = 2^(k-1) .. 2^k - 1 bytes
define FV_N_BUCKETS: i64 40

; 0 = not yet asked, 1 = on, 2 = off
shared fv_state: int 0

; ---- the region clock ----------------------------------------------------
; the eval region we are currently metering (null = the run page, untracked)
shared fv_head: pointer[void] null
; the last tail of its extension chain we saw, and the pages before it
shared fv_tail: pointer[void] null
shared fv_pages: i64 0
; its bump volume at the last observation
shared fv_last_vol: i64 0
; bumped on every bracket switch — a frame whose push and pop disagree is
; dropped rather than guessed
shared fv_gen: i64 0

; ---- the bracket stack (brackets nest, so the parent's clock resumes) ----
shared fv_bhead: pointer[i64] null
shared fv_btail: pointer[i64] null
shared fv_bpages: pointer[i64] null
shared fv_blast: pointer[i64] null
shared fv_bdepth: i64 0
shared fv_bover: i64 0

; ---- per-frame columns ---------------------------------------------------
shared fv_self: pointer[i64] null
shared fv_gen_at: pointer[i64] null
shared fv_excl_at: pointer[i64] null

; ---- results -------------------------------------------------------------
shared fv_top: i64 -1
shared fv_frames: i64 0
shared fv_measured: i64 0
shared fv_zero: i64 0
shared fv_bytes: i64 0
shared fv_outside: i64 0
shared fv_oversized: i64 0
shared fv_straddled: i64 0
shared fv_deep: i64 0
shared fv_depth_max: i64 0
shared fv_switches: i64 0
shared fv_hist: pointer[i64] null
; bytes per bucket — the design question is where the BYTES are, not where the
; frames are, and those two rankings need not agree
shared fv_hbytes: pointer[i64] null

; the atexit entry point: a bare module-level function name is a function
; pointer value, which a concept static is not.
function fv_report_hook()
    FrameVol.report()

define FrameVol
{
    procedure on() returns bool mutable fv_bhead, fv_blast, fv_bpages, fv_btail, fv_excl_at, fv_gen_at, fv_hbytes, fv_hist, fv_self, fv_state
    {
        if fv_state = 0
            FrameVol.setup()
        fv_state = 1
    }

    procedure setup() mutable fv_bhead, fv_blast, fv_bpages, fv_btail, fv_excl_at, fv_gen_at, fv_hbytes, fv_hist, fv_self, fv_state
    {
        set fv_state: 2
        let e getenv("DZ_FRAME_VOL")
        if e = null
            return
        set fv_self: calloc(FV_MAX_DEPTH as size_t, 8) as pointer[i64]
        set fv_gen_at: calloc(FV_MAX_DEPTH as size_t, 8) as pointer[i64]
        set fv_excl_at: calloc(FV_MAX_DEPTH as size_t, 8) as pointer[i64]
        set fv_bhead: calloc(FV_MAX_BRACKET as size_t, 8) as pointer[i64]
        set fv_btail: calloc(FV_MAX_BRACKET as size_t, 8) as pointer[i64]
        set fv_bpages: calloc(FV_MAX_BRACKET as size_t, 8) as pointer[i64]
        set fv_blast: calloc(FV_MAX_BRACKET as size_t, 8) as pointer[i64]
        set fv_hist: calloc(FV_N_BUCKETS as size_t, 8) as pointer[i64]
        set fv_hbytes: calloc(FV_N_BUCKETS as size_t, 8) as pointer[i64]
        if fv_hbytes = null
            return
        if fv_self = null
            return
        if fv_gen_at = null
            return
        if fv_excl_at = null
            return
        if fv_bhead = null
            return
        if fv_btail = null
            return
        if fv_bpages = null
            return
        if fv_blast = null
            return
        if fv_hist = null
            return
        atexit(&fv_report_hook)
        set fv_state: 1
    }

    ; The metered region's bump volume, in bytes. Page slots by offset:
    ; 0 next_object, 1 current_page (null while the head IS the tail),
    ; 2 next_page, 3 exclusive_pages.head.
    procedure vol() returns i64 mutable fv_pages, fv_tail
    {
        if fv_head = null
            return 0
        let h fv_head as pointer[size_t]
        var tail *(h + 1) as pointer[size_t]
        if tail = null
            set tail: h
        if fv_tail = null
            set fv_tail: fv_head
        var cur fv_tail as pointer[size_t]
        var guard: i64 0
        while cur <> tail
        {
            let nxt *(cur + 2) as pointer[size_t]
            if nxt = null
                set cur: tail
            else
            {
                set cur: nxt
                set fv_pages: fv_pages + 1
            }
            set guard: guard + 1
            if guard > 1048576
                set cur: tail
        }
        set fv_tail: cur as pointer[void]
        let base cur as size_t
        let next_obj *cur
        (fv_pages * FV_PAGE_SIZE) + ((next_obj - base) as i64)
    }

    ; the exclusive-page list head, as a change tag (see the blind spots)
    function excl_head() returns i64
    {
        if fv_head = null
            return 0
        let h fv_head as pointer[size_t]
        *(h + 3) as i64
    }

    ; attribute everything allocated since the last observation to the frame
    ; that was running
    procedure observe() mutable fv_last_vol, fv_outside, fv_pages, fv_self, fv_tail
    {
        let v FrameVol.vol()
        let d v - fv_last_vol
        set fv_last_vol: v
        if d <= 0
            return
        if fv_top < 0
        {
            set fv_outside: fv_outside + d
            return
        }
        if fv_top >= FV_MAX_DEPTH
            return
        set *(fv_self + fv_top): *(fv_self + fv_top) + d
    }

    ; VM.push_frame, after csp was incremented — the new frame's index is csp-1
    procedure push(csp: int) mutable fv_bhead, fv_blast, fv_bpages, fv_btail, fv_deep, fv_depth_max, fv_excl_at, fv_frames, fv_gen_at, fv_hbytes, fv_hist, fv_last_vol, fv_outside, fv_pages, fv_self, fv_state, fv_tail, fv_top
    {
        if FrameVol.on() = false
            return
        FrameVol.observe()
        let idx (csp - 1) as i64
        set fv_frames: fv_frames + 1
        if idx > fv_depth_max
            set fv_depth_max: idx
        set fv_top: idx
        if idx >= FV_MAX_DEPTH
        {
            set fv_deep: fv_deep + 1
            return
        }
        if idx < 0
            return
        set *(fv_self + idx): 0
        set *(fv_gen_at + idx): fv_gen
        set *(fv_excl_at + idx): FrameVol.excl_head()
    }

    ; VM.pop_frame, after csp was decremented — the leaving frame's index IS csp
    procedure pop(csp: int) mutable fv_bhead, fv_blast, fv_bpages, fv_btail, fv_bytes, fv_excl_at, fv_gen_at, fv_hbytes, fv_hist, fv_last_vol, fv_measured, fv_outside, fv_oversized, fv_pages, fv_self, fv_state, fv_straddled, fv_tail, fv_top, fv_zero
    {
        if FrameVol.on() = false
            return
        FrameVol.observe()
        let idx csp as i64
        set fv_top: idx - 1
        if idx >= FV_MAX_DEPTH
            return
        if idx < 0
            return
        if *(fv_gen_at + idx) <> fv_gen
        {
            set fv_straddled: fv_straddled + 1
            return
        }
        let own *(fv_self + idx)
        if FrameVol.excl_head() <> *(fv_excl_at + idx)
            set fv_oversized: fv_oversized + 1
        set fv_measured: fv_measured + 1
        set fv_bytes: fv_bytes + own
        if own = 0
            set fv_zero: fv_zero + 1
        let b FrameVol.bucket(own)
        set *(fv_hist + b): *(fv_hist + b) + 1
        set *(fv_hbytes + b): *(fv_hbytes + b) + own
    }

    ; Interpreter.set_eval_region — a bracket opens or closes
    procedure region(p: pointer[Page]) mutable fv_bdepth, fv_bhead, fv_blast, fv_bover, fv_bpages, fv_btail, fv_excl_at, fv_gen, fv_gen_at, fv_hbytes, fv_head, fv_hist, fv_last_vol, fv_outside, fv_pages, fv_self, fv_state, fv_switches, fv_tail
    {
        if FrameVol.on() = false
            return
        FrameVol.observe()
        let np p as pointer[void]
        if np = fv_head
            return
        set fv_switches: fv_switches + 1
        set fv_gen: fv_gen + 1
        ; a RESTORE if the incoming region is the one below the top of the stack
        if fv_bdepth > 0
        {
            if *(fv_bhead + (fv_bdepth - 1)) = (np as i64)
            {
                set fv_bdepth: fv_bdepth - 1
                set fv_head: np
                set fv_tail: *(fv_btail + fv_bdepth) as pointer[void]
                set fv_pages: *(fv_bpages + fv_bdepth)
                set fv_last_vol: *(fv_blast + fv_bdepth)
                return
            }
        }
        ; otherwise a PUSH
        if fv_bdepth < FV_MAX_BRACKET
        {
            set *(fv_bhead + fv_bdepth): fv_head as i64
            set *(fv_btail + fv_bdepth): fv_tail as i64
            set *(fv_bpages + fv_bdepth): fv_pages
            set *(fv_blast + fv_bdepth): fv_last_vol
            set fv_bdepth: fv_bdepth + 1
        }
        else
            set fv_bover: fv_bover + 1
        set fv_head: np
        set fv_tail: null
        set fv_pages: 0
        set fv_last_vol: 0
        set fv_last_vol: FrameVol.vol()
    }

    ; 0 for nothing, else 1 + floor(log2(n))
    function bucket(n: i64) returns i64
    {
        if n <= 0
            return 0
        var b: i64 1
        var v n
        while v > 1
        {
            set v: v >> 1
            set b: b + 1
        }
        if b >= FV_N_BUCKETS
            return FV_N_BUCKETS - 1
        b
    }

    procedure report()
    {
        if fv_state <> 1
            return
        scaly_eputs "framevol: "
        scaly_eputi fv_frames
        scaly_eputs " frames pushed, "
        scaly_eputi fv_measured
        scaly_eputs " measured, max depth "
        scaly_eputi fv_depth_max
        scaly_eputnl()
        scaly_eputs "framevol: "
        scaly_eputi fv_zero
        scaly_eputs " measured frames allocated NOTHING ("
        ; a parenless call whose argument is a chained call mis-parses
        ; (CLAUDE.md) — bind first. It printed an EMPTY number, silently.
        let zp FrameVol.permille(fv_zero, fv_measured)
        scaly_eputi zp
        scaly_eputs " per mille), "
        scaly_eputi fv_oversized
        scaly_eputs " touched an exclusive page"
        scaly_eputnl()
        scaly_eputs "framevol: "
        scaly_eputi fv_bytes
        scaly_eputs " bump bytes attributed to frames, "
        scaly_eputi fv_outside
        scaly_eputs " outside any frame"
        scaly_eputnl()
        scaly_eputs "framevol: "
        scaly_eputi fv_switches
        scaly_eputs " bracket switches, "
        scaly_eputi fv_straddled
        scaly_eputs " frames straddled one, "
        scaly_eputi fv_deep
        scaly_eputs " past the depth cap, "
        scaly_eputi fv_bover
        scaly_eputs " past the bracket cap"
        scaly_eputnl()
        ; the distribution — one line per non-empty bucket, with the running
        ; share of BYTES, because the design question is where the bytes are,
        ; not where the frames are
        var i: i64 0
        while i < FV_N_BUCKETS
        {
            let n *(fv_hist + i)
            if n > 0
            {
                scaly_eputs "framevol:   "
                if i = 0
                    scaly_eputs "0 B"
                else
                {
                    scaly_eputs ">= "
                    let lo FrameVol.low_of(i)
                    scaly_eputi lo
                    scaly_eputs " B"
                }
                scaly_eputs ": "
                scaly_eputi n
                scaly_eputs " frames ("
                let np FrameVol.permille(n, fv_measured)
                scaly_eputi np
                scaly_eputs " per mille), "
                let hb *(fv_hbytes + i)
                scaly_eputi hb
                scaly_eputs " B ("
                let bp FrameVol.permille(hb, fv_bytes)
                scaly_eputi bp
                scaly_eputs " per mille of the bytes)"
                scaly_eputnl()
            }
            set i: i + 1
        }
    }

    function low_of(b: i64) returns i64
    {
        if b <= 0
            return 0
        var v: i64 1
        var k: i64 1
        while k < b
        {
            set v: v + v
            set k: k + 1
        }
        v
    }

    function permille(n: i64, total: i64) returns i64
    {
        if total <= 0
            return 0
        (n * 1000) / total
    }
}
