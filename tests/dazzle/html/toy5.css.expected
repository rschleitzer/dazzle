SPAN.P {
  font-family: Times New Roman,serif;
  font-weight: 500;
  font-style: normal;
  font-size: 14pt;
  color: #000000;
}
SPAN.TITLE {
  font-family: Times New Roman,serif;
  font-weight: 500;
  font-style: normal;
  font-size: 20pt;
  color: #000000;
}
SPAN.EM {
  font-family: Times New Roman,serif;
  font-weight: 500;
  font-style: italic;
  font-size: 28pt;
  color: #000000;
}
DIV { margin-top: 0pt; margin-bottom: 0pt; margin-left: 0pt; margin-right: 0pt }
DIV.P {
  margin-left: 5pt;
  text-align: left;
  line-height: 12pt;
  text-indent: 0pt;
}
DIV.TITLE {
  margin-left: 10pt;
  text-align: left;
  line-height: 24pt;
  text-indent: 0pt;
}
