SPAN.EM {
  font-family: Times New Roman,serif;
  font-weight: 500;
  font-style: italic;
  font-size: 10pt;
  color: #000000;
}
SPAN.P, SPAN.TITLE {
  font-family: Times New Roman,serif;
  font-weight: 500;
  font-style: normal;
  font-size: 10pt;
  color: #000000;
}
DIV { margin-top: 0pt; margin-bottom: 0pt; margin-left: 0pt; margin-right: 0pt }
DIV.P {
  text-align: right;
  line-height: 12pt;
  text-indent: 0pt;
}
DIV.TITLE {
  text-align: left;
  line-height: 12pt;
  text-indent: 0pt;
}
