SPAN.KCELL, SPAN.TBL2, SPAN.TALL, SPAN.WIDE, SPAN.CELL {
  font-family: Times New Roman,serif;
  font-weight: 500;
  font-style: normal;
  font-size: 10pt;
  color: #000000;
}
DIV { margin-top: 0pt; margin-bottom: 0pt; margin-left: 0pt; margin-right: 0pt }
DIV.KCELL, DIV.TBL3, DIV.TBL2 {
  text-align: left;
  line-height: 12pt;
  text-indent: 0pt;
}
