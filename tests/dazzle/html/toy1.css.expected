SPAN.P {
  font-family: Times New Roman,serif;
  font-weight: 500;
  font-style: normal;
  font-size: 10pt;
  color: #000000;
}
SPAN.TITLE {
  font-family: Times New Roman,serif;
  font-weight: 700;
  font-style: normal;
  font-size: 18pt;
  color: #000000;
}
SPAN.EM {
  font-family: Times New Roman,serif;
  font-weight: 500;
  font-style: italic;
  font-size: 10pt;
  color: #000000;
}
DIV { margin-top: 0pt; margin-bottom: 0pt; margin-left: 0pt; margin-right: 0pt }
DIV.P {
  margin-left: 0.5pt;
  text-align: left;
  line-height: 12pt;
  text-indent: -3pt;
}
DIV.TITLE {
  margin-top: 12pt;
  text-align: center;
  line-height: 12pt;
  text-indent: 0pt;
}
