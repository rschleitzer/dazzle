<!DOCTYPE STYLE-SHEET PUBLIC "-//James Clark//DTD DSSSL Style Sheet//EN">
<STYLE-SHEET>
<STYLE-SPECIFICATION ID=main>
<![CDATA[
(root (empty-sosofo))
; parseModeGroup -> badModeForm. The reference reports the SAME message for a
; head with no syntactic key at all and for a key with no meaning in a mode
; group, so one arm covers both.
(mode m (frobnicate x (empty-sosofo)))
]]>
</STYLE-SPECIFICATION>
</STYLE-SHEET>
