<!DOCTYPE doc [
<!ELEMENT doc - - (sec|note)*>
<!ELEMENT sec - - (title?, para*, sub*)>
<!ELEMENT sub - - (title?, para*)>
<!ELEMENT note - - (para*)>
<!ELEMENT title - - (#PCDATA)>
<!ELEMENT para - - (#PCDATA|em)*>
<!ELEMENT em - - (#PCDATA)>
<!ATTLIST sec
  xid    ID       #IMPLIED
  cls    CDATA    #IMPLIED>
<!ATTLIST para
  align  CDATA    #IMPLIED
  cls    CDATA    #IMPLIED
  xid    ID       #IMPLIED
  kind   (one|two) two
  toks   NMTOKENS #IMPLIED>
]>
<doc><sec xid="s1" cls="big"><title>T1</title><para align="center" xid="p1">A</para><para kind="one" cls="big">B</para></sec><sec xid="s2"><sub><title>T2</title><para toks="a b">C<em>E</em></para></sub></sec><note><para>D</para></note></doc>
