<!DOCTYPE STYLE-SHEET PUBLIC "-//James Clark//DTD DSSSL Style Sheet//EN">
<STYLE-SHEET>
<STYLE-SPECIFICATION ID=main>
<![CDATA[
(root (empty-sosofo))
; doDeclareDefaultLanguage's part gate: the SECOND declaration in the same
; part is the duplicate; the first one wins and is kept.
(declare-default-language (language "en" "US"))
(declare-default-language (language "de" "DE"))
]]>
</STYLE-SPECIFICATION>
</STYLE-SHEET>
