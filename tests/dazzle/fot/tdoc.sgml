<!DOCTYPE tdoc [
<!ELEMENT tdoc - - (tbl, tbl2, tbl3)>
<!ELEMENT tbl - - (part+)>
<!ELEMENT part - - (row+)>
<!ELEMENT tbl2 - - (row+)>
<!ELEMENT tbl3 - - (kcell+)>
<!ELEMENT row - - (cell|wide|tall)*>
<!ELEMENT cell - - (#PCDATA)>
<!ELEMENT wide - - (#PCDATA)>
<!ELEMENT tall - - (#PCDATA)>
<!ELEMENT kcell - - (#PCDATA)>
<!ATTLIST kcell s (s|n) "n">
]>
<tdoc>
<tbl>
<part>
<row><cell>a1</cell><cell>b1</cell><cell>c1</cell></row>
<row><cell>a2</cell><wide>bc2</wide></row>
<row><tall>a3</tall><cell>b3</cell><cell>c3</cell></row>
<row><cell>b4</cell><cell>c4</cell></row>
</part>
</tbl>
<tbl2>
<row><cell>x1</cell><cell>y1</cell></row>
<row><cell>x2</cell><cell>y2</cell></row>
</tbl2>
<tbl3>
<kcell s=s>k1</kcell><kcell>k2</kcell><kcell s=s>k3</kcell><kcell>k4</kcell>
</tbl3>
</tdoc>
