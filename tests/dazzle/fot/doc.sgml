<!DOCTYPE doc [
<!ELEMENT doc - - (title, p+)>
<!ELEMENT title - - (#PCDATA)>
<!ELEMENT p - - (#PCDATA|em)*>
<!ELEMENT em - - (#PCDATA)>
<!ATTLIST p id ID #IMPLIED>
]>
<doc>
<title>Hello &#38; Welcome</title>
<p id=first>First <em>paragraph</em> with 5 &#60; 7.</p>
<p>Zweite Zeile mit Umlaut: &#252;.</p>
</doc>
