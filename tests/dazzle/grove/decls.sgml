<!DOCTYPE doc [
<!NOTATION gif PUBLIC "-//Scaly//NOTATION gif//EN">
<!NOTATION tiff SYSTEM "tiff.exe">
<!NOTATION both PUBLIC "-//Scaly//NOTATION both//EN" "both.exe">
<!ATTLIST #NOTATION gif
          res     NUMBER      #IMPLIED
          scheme  (rgb|cmyk)  rgb
>
<!ENTITY text-ent "some text">
<!ENTITY ext-ent SYSTEM "ext.sgm">
<!ENTITY logo SYSTEM "logo.gif" NDATA gif>
<!ENTITY pi-ent PI "the pi">
<!ENTITY cd-ent CDATA "cdata text">
<!ENTITY sd-ent SDATA "sdata text">
<!ENTITY % pent "p | note">
<!ENTITY #DEFAULT "the default">
<!ELEMENT doc   - - (title?, (%pent;)+, fig*)>
<!ELEMENT title - - (#PCDATA)>
<!ELEMENT p     - O (#PCDATA | hl)*>
<!ELEMENT note  O O (#PCDATA) +(hl)>
<!ELEMENT hl    - - (#PCDATA) -(hl)>
<!ELEMENT fig   - - (#PCDATA)>
<!ELEMENT sep   - - EMPTY>
<!ELEMENT raw   - - CDATA>
<!ELEMENT anye  - - ANY>
<!ATTLIST doc
          id      ID          #IMPLIED
          version CDATA       "1.0"
>
<!ATTLIST (p|note)
          id      ID          #IMPLIED
          kind    NMTOKEN     #CURRENT
>
<!ATTLIST fig
          id      ID          #REQUIRED
          file    ENTITY      #REQUIRED
          form    NOTATION (gif|tiff) #IMPLIED
>
<!ATTLIST (title|hl|sep|raw|anye) style CDATA #IMPLIED>
]>
<doc id="d1">
<title>The title</title>
<p id="p1" kind="first">First &text-ent; and &missing; para.</p>
<note id="n1">A note.</note>
<fig id="f1" file="logo" form="gif">Cap.</fig>
</doc>
