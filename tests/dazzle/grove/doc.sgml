<!DOCTYPE doc [
<!ELEMENT doc - - (title, p+)>
<!ELEMENT title - - (#PCDATA)>
<!ELEMENT p - - (#PCDATA|em)*>
<!ELEMENT em - - (#PCDATA)>
<!ATTLIST doc lang CDATA #IMPLIED>
<!ATTLIST p id ID #IMPLIED>
]>
<?prolog-one?>
<doc lang="de">
<title>Axis</title>
<p id=first>First <em>inner</em> text.</p>
<p>Second.</p>
</doc>
<?epilog-one?>
