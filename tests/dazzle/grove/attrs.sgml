<!DOCTYPE doc [
<!NOTATION gif PUBLIC "-//Scaly//NOTATION gif//EN">
<!NOTATION tiff SYSTEM "tiff.exe">
<!ENTITY logo SYSTEM "logo.gif" NDATA gif>
<!ENTITY seal SYSTEM "seal.tif" NDATA tiff>
<!ENTITY text-ent "some text">
<!ELEMENT doc  - - (p+, fig+)>
<!ELEMENT p    - - (#PCDATA)>
<!ELEMENT fig  - - (#PCDATA)>
<!ATTLIST doc
          lang    CDATA               #IMPLIED
          version CDATA               "1.0"
          state   (draft|final)       final
          fixed   CDATA               #FIXED "F"
>
<!ATTLIST p
          id      ID                  #IMPLIED
          refs    IDREFS              #IMPLIED
          words   NMTOKENS            #IMPLIED
          n       NUMBER              #IMPLIED
          kind    NMTOKEN             #CURRENT
>
<!ATTLIST fig
          file    ENTITY              #REQUIRED
          more    ENTITIES            #IMPLIED
          form    NOTATION (gif|tiff) #IMPLIED
>
]>
<doc lang="de" state="draft">
<p id="one" refs="one two" words="alpha beta gamma" n="42" kind="first">Text one.</p>
<p id="two">Text two.</p>
<fig file="logo" more="logo seal" form="gif">Cap.</fig>
<fig file="seal"></fig>
</doc>
