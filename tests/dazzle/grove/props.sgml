<!DOCTYPE doc [
<!ELEMENT doc   - - (title, p+) +(note)>
<!ELEMENT title - - (#PCDATA)>
<!ELEMENT p     - - (#PCDATA|em|br|ref)*>
<!ELEMENT em    - - (#PCDATA)>
<!ELEMENT br    - o EMPTY>
<!ELEMENT ref   - o (#PCDATA)>
<!ELEMENT note  - - (#PCDATA)>
<!ATTLIST doc lang CDATA #IMPLIED>
<!ATTLIST p   id ID #IMPLIED>
<!ATTLIST ref target IDREF #CONREF>
]>
<?prolog-one?>
<doc lang="de">
<title>Props</title>
<p id=first>First <em>inner</em> text.<br><ref target=first></p>
<note>Inc</note>
<p>Second.</p>
</doc>
<?epilog-one?>
