; Stage-6a dazzle unit harness. Runs dazzle.test() (style-engine layer
; checks) AOT-linked against libdazzle.a + libopensp.a — see run.sh for why
; never --jit (the opensp false-pass lesson: undefined externals become
; 0-returning stubs and nothing runs).

package scaly 0.1.0
package opensp 0.1.0
package dazzle 0.1.0

use dazzle

let result dazzle.test()
if result = 0
    print("PASS")
else
    print("FAIL `result`")
