<MIFFile 5.0>
<PgfCatalog 
  <Pgf 
    <PgfTag `Default Pgf Format'>
    <PgfFont 
      <FFamily `Times New Roman'>
      <FAngle `Regular'>
      <FWeight `Regular'>
      <FVar `Regular'>
      <FSize 10pt>
      <FColor `Black'>
      <FUnderlining FNoUnderlining>
      <FOverline No>
      <FStrike No>
      <FPosition FNormal>
      <FPairKern No>
      <FCase FAsTyped>
      <FDX 0.000000>
      <FDY 0.000000>
      <FDW 0.000000>
    >
    <PgfLanguage NoLanguage>
    <PgfFIndent 0pt>
    <PgfLIndent 0pt>
    <PgfRIndent 0pt>
    <PgfAlignment Left>
    <PgfSpBefore 0pt>
    <PgfSpAfter 0pt>
    <PgfLineSpacing Fixed>
    <PgfLeading 0pt>
    <PgfNumTabs 0>
    <PgfPlacement Anywhere>
    <PgfPlacementStyle Normal>
    <PgfWithPrev No>
    <PgfWithNext No>
    <PgfBlockSize 2>
    <PgfAutoNum No>
    <PgfHyphenate No>
    <HyphenMaxLines 999>
    <HyphenMinPrefix 2>
    <HyphenMinSuffix 2>
    <HyphenMinWord 2>
    <PgfLetterSpace No>
    <PgfCellAlignment Top>
    <PgfCellMargins 0pt 0pt 0pt 0pt>
    <PgfCellLMarginFixed Yes>
    <PgfCellTMarginFixed Yes>
    <PgfCellRMarginFixed Yes>
    <PgfCellBMarginFixed Yes>
  >
>
<Document 
  <DMargins 0.001pt 0.001pt 0.001pt 0.001pt>
  <DColumns 1>
  <DPageSize 576pt 828pt>
>
<Para 
  <Pgf 
    <PgfTag `Default Pgf Format'>
    <PgfFont 
      <FSize 24pt>
    >
    <PgfFIndent 10pt>
    <PgfLIndent 10pt>
  >
  <ParaLine 
    <Font 
      <FSize 20pt>
    >
    <String `Hello '>
    <String `&'>
    <String ` Welcome'>
  >
>
<Para 
  <Pgf 
    <PgfFont 
      <FSize 12pt>
    >
    <PgfFIndent 5pt>
    <PgfLIndent 5pt>
    <PgfNumTabs 1>
    <TabStop 
      <TSX 19pt>
      <TSType Left>
      <TSLeaderStr ` '>
    >
  >
  <ParaLine 
    <Font 
      <FSize 14pt>
    >
    <String `x'>
    <Char Tab>
    <String `First '>
    <Font 
      <FAngle `Italic'>
      <FSize 28pt>
    >
    <String `paragraph'>
    <Font 
      <FAngle `Regular'>
      <FSize 14pt>
    >
    <String ` with 5 '>
    <String `<'>
    <String ` 7.'>
  >
>
<Para 
  <Pgf 
    <PgfNumTabs 2>
    <TabStop 
      <TSX 19pt>
      <TSType Left>
      <TSLeaderStr ` '>
    >
  >
  <ParaLine 
    <Font 
      <FSize 14pt>
    >
    <String `x'>
    <Char Tab>
    <String `Zweite Zeile mit Umlaut: '>
    <String `\x9f '>
    <String `.'>
  >
>