<chap><title>One</title>
<p>c1p1</p><p>c1p2</p></chap>
<chap><title>Two</title>
<sec><title>Two A</title><p>c2s1p1</p><p id=probe>c2s1p2 <note>n</note></p></sec>
<sec><title>Two B</title><p>c2s2p1</p></sec>
</chap>
<chap><title>Three</title>
<sec><title>Three A</title><p>c3s1p1</p><p>c3s1p2</p><p>c3s1p3</p></sec>
</chap>
</doc>
