<!DOCTYPE doc [
<!ELEMENT doc  - - (chap+)>
<!ELEMENT chap - - (title, (sec+ | p+))>
<!ELEMENT sec  - - (title, p+)>
<!ELEMENT title - - (#PCDATA)>
<!ELEMENT p    - - (#PCDATA | note)*>
<!ELEMENT note - - (#PCDATA)>
<!ATTLIST p id ID #IMPLIED>
]>
