<!DOCTYPE doc [
<!ELEMENT doc - - (a|b|c|d|e|f|g|h|i)*>
<!ELEMENT a - - (kid*)>
<!ELEMENT b - - (kid*)>
<!ELEMENT c - - (kid*)>
<!ELEMENT d - - (kid*)>
<!ELEMENT e - - (kid*)>
<!ELEMENT f - - (kid*)>
<!ELEMENT g - - (kid*)>
<!ELEMENT h - - (kid*)>
<!ELEMENT i - - (kid*)>
<!ELEMENT kid - - EMPTY>
]>
<doc>
<a><kid><kid></a>
<b><kid><kid></b>
<c><kid><kid></c>
<d><kid><kid></d>
<e><kid><kid></e>
<f><kid><kid></f>
<g><kid><kid></g>
<h><kid><kid></h>
<i><kid><kid></i>
</doc>
