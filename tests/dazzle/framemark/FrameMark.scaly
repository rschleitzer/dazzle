use scaly.memory.Page

; ---- the frame MARK: DZ_FRAME_MARK ---------------------------------------
; Sprosse (ii) of stage 6b — "frame = mini region" — in the shape the
; measurement picked (tests/dazzle/framevol, and the section "Die Frames
; GEZÄHLT" in ../PERFORMANCE.md): NOT a region per frame (82 M frames × the
; ~20-40 ns an exclusive page costs = the whole win), but a BUMP MARK on the
; region the frame already allocates from. Entering a frame saves
; `next_object`; leaving it restores it, and everything the frame allocated is
; gone for the price of one store.
;
; A rewind is only sound if nothing above the mark is reachable afterwards, so
; the whole design is in the CONSERVATIVE test that decides it. Five conditions,
; all of them O(1), and the frame is rewound only when every one holds:
;
;   1. VALID    — the mark was taken in the eval bracket that is still current
;                 (a bracket switch replaces the region under us).
;   2. ONE PAGE — the region's tail page is still the page the mark points into.
;                 Restricting the rewind to frames that never crossed a page
;                 boundary costs almost nothing (measured: 99.7 % of frames
;                 allocate under 4 KB) and buys two things — the rewind is a
;                 single store, and no extension page has to be handed back.
;   3. EXCLUSIVE— the region's exclusive-page list is unchanged, so no oversized
;                 allocation happened that the bump pointer does not describe
;                 (measured: 4185 frames of 82 M, so nothing is lost by giving
;                 up on them).
;   4. RESULT   — the value the frame RETURNS does not lie above the mark. This
;                 is the one escape route the frame itself owns, and it is an
;                 address comparison rather than a graph walk.
;   5. QUIET    — nothing PUBLISHED while the frame was running.
;
; ★★★Condition 5 is the whole trick, and it is one global counter. A frame's
; lifetime is exactly the window in which only IT and its DESCENDANTS run (a
; sibling runs after the pop), and every ancestor's rewind range CONTAINS this
; frame's. So "no publication happened anywhere between my push and my pop" is
; both necessary in the conservative reading and sufficient — and it needs no
; propagation to ancestors, just `epoch` compared against `epoch_at_push`.
; Publication is any store that could put a pointer into memory above some
; mark: `SetBox`, a control-stack unwind (call/cc), a frame popped by a path
; that reports no result, and — by default — EVERY primitive. A primitive may
; only be trusted not to publish after an audit; `DZ_FRAME_MARK_TRUST_PRIMS=1`
; trusts them all AT ONCE, which is not sound and is not meant to be: it is the
; CEILING measurement, the answer to "what could this rule ever reclaim if the
; audit went perfectly?" against the FLOOR that the default (trust nothing)
; measures. Building the live mode before knowing that pair would be the same
; mistake the two JIT dispatch rungs were.
;
; Modes: DZ_FRAME_MARK=dry accounts only and never writes the bump pointer
; (completely safe — this is what the floor/ceiling pair is measured with);
; DZ_FRAME_MARK=1 actually rewinds. Unset, every hook is a load and a
; not-taken branch.
;
; The region is read and written through the documented Page byte offsets
; (Page.scaly keeps the first four slots as load-bearing offsets: next_object,
; current_page, next_page, exclusive_pages.head) — Page is one of the
; runtime-opaque structs, and this instrument has no business making the dazzle
; package lay it out. When this graduates into the engine it wants a proper
; `Page.mark`/`Page.rewind` pair in the stdlib instead.

function getenv(name: pointer[const_char]) returns pointer[const_char] extern
function atol(s: pointer[const_char]) returns i64 extern
function calloc(count: size_t, size: size_t) returns pointer[void] extern
procedure atexit(cb: pointer[void]) returns i32 extern
procedure scaly_eputs(s: pointer[const_char]) extern
procedure scaly_eputi(value: i64) extern
procedure scaly_eputnl() extern

define FM_MAX_DEPTH: i64 65536
define FM_MAX_PRIMS: i64 1024

; 0 = not yet asked, 1 = dry, 2 = live, 3 = off
shared fm_mode: int 0
shared fm_trust_prims: bool false
shared fm_publish_stack: bool false
; DZ_FRAME_MARK_QUIET: no report at all. Needed to put this build in front of
; the byte-identity gates — they diff STDERR against the golden, so the probe's
; own report reads as 48 failures with every generated tree actually correct.
shared fm_quiet: bool false
; the multi-page rewind (DZ_FRAME_MARK_SINGLE_PAGE=1 turns it off, which is how
; its contribution is measured)
shared fm_multipage: bool true
; the innermost live frame's index
shared fm_top: i64 -1

; the region we are marking, and the bracket generation
shared fm_head: pointer[void] null
shared fm_gen: i64 0
; the publication counter — condition 5
shared fm_epoch: i64 0

; per-frame columns
shared fm_page: pointer[i64] null       ; the tail page the mark points into
shared fm_off: pointer[i64] null        ; next_object at push
shared fm_gen_at: pointer[i64] null
shared fm_epoch_at: pointer[i64] null
shared fm_excl_at: pointer[i64] null

; results
shared fm_frames: i64 0
shared fm_rewound: i64 0
shared fm_bytes: i64 0
shared fm_b_invalid: i64 0
shared fm_b_page: i64 0
shared fm_b_excl: i64 0
shared fm_b_result: i64 0
shared fm_b_publish: i64 0
shared fm_b_noresult: i64 0
shared fm_b_deep: i64 0
shared fm_publishes: i64 0
; stores into a pre-existing object that were SAFE because the target sits in
; the innermost frame's own range (so a rewind discards both)
shared fm_stores_local: i64 0
shared fm_rewound_multi: i64 0
shared fm_pages_freed: i64 0
; which primitive ids are TRUSTED not to publish (index = id, 1 = trusted)
shared fm_trusted: pointer[i64] null
; ★ SCOPING the two-arena rung: which primitive produced the result that blocked
; the rewind? 89 % of frames leave through prim_tail_call, so the LAST primitive
; dispatched before the pop is the one whose value is being returned. The
; histogram says how many per-primitive RETENTION summaries the escape analysis
; would have to carry, and for which primitives — the analysis cannot put a
; result in the escaping arena without knowing whether it retains its arguments
; (PairObj holds car/cdr, StrCatObj holds parts: `cons` alone settles that).
shared fm_last_prim: i64 -1
shared fm_result_by_prim: pointer[i64] null

; ★★★THE SECOND ARENA (rung 3, DZ_FRAME_MARK_ARENA=1). Up to here the mark lived
; IN the eval region, which is why 37 % of frames were blocked by their own
; RESULT: in one bump space "outward" means lower addresses, and those are
; occupied. So the frame-local allocation moves to an arena of its OWN — F, a
; region taken from the PERM host on first use and rewound per frame — while
; everything that must outlive the frame keeps going to the eval region P.
;
; ★The rule that decides F or P per call, and it needs no retention summaries:
; a primitive in TAIL position produces the frame's return value, so its result
; must go to P — but only if every POINTER ARGUMENT already lies outside F's
; live range. Otherwise the result could retain something F is about to reclaim
; (`PairObj` holds car/cdr, `StrCatObj` holds parts, a select view holds its
; source), and it goes to F instead, exactly as before. **Testing the arguments
; substitutes for knowing whether the primitive retains them** — which is what
; made this rung buildable without the Insn-graph dataflow.
;
; A non-tail primitive keeps allocating in F: its value is frame-local unless it
; later reaches a Return (condition 4 still catches that) or is published
; (condition 5).
shared fm_arena: bool false
shared fm_p_host: pointer[Page] null
shared fm_tail_call: bool false
shared fm_to_p: i64 0
shared fm_to_f: i64 0
shared fm_to_f_argdeps: i64 0

function fm_report_hook()
    FrameMark.report()

define FrameMark
{
    function on() returns bool
    {
        if fm_mode = 0
            FrameMark.setup()
        fm_mode < 3
    }

    function live() returns bool
        fm_mode = 2

    procedure setup()
    {
        set fm_mode: 3
        let e getenv("DZ_FRAME_MARK")
        if e = null
            return
        set fm_page: calloc(FM_MAX_DEPTH as size_t, 8) as pointer[i64]
        set fm_off: calloc(FM_MAX_DEPTH as size_t, 8) as pointer[i64]
        set fm_gen_at: calloc(FM_MAX_DEPTH as size_t, 8) as pointer[i64]
        set fm_epoch_at: calloc(FM_MAX_DEPTH as size_t, 8) as pointer[i64]
        set fm_excl_at: calloc(FM_MAX_DEPTH as size_t, 8) as pointer[i64]
        set fm_trusted: calloc(FM_MAX_PRIMS as size_t, 8) as pointer[i64]
        set fm_result_by_prim: calloc(FM_MAX_PRIMS as size_t, 8) as pointer[i64]
        if fm_result_by_prim = null
            return
        if fm_page = null
            return
        if fm_off = null
            return
        if fm_gen_at = null
            return
        if fm_epoch_at = null
            return
        if fm_excl_at = null
            return
        if fm_trusted = null
            return
        let t getenv("DZ_FRAME_MARK_TRUST_PRIMS")
        if t <> null
            set fm_trust_prims: true
        let ar getenv("DZ_FRAME_MARK_ARENA")
        if ar <> null
            set fm_arena: true
        let sp1 getenv("DZ_FRAME_MARK_SINGLE_PAGE")
        if sp1 <> null
            set fm_multipage: false
        let q getenv("DZ_FRAME_MARK_QUIET")
        if q <> null
            set fm_quiet: true
        let ps getenv("DZ_FRAME_MARK_PUBLISH_STACK")
        if ps <> null
            set fm_publish_stack: true
        ; a comma-free list of decimal ids, e.g. "12 40 41" — the audited set
        let w getenv("DZ_FRAME_MARK_TRUSTED_IDS")
        if w <> null
            FrameMark.parse_ids(w)
        atexit(&fm_report_hook)
        ; "dry" is anything whose first byte is not '1'
        let one "1" as char
        if ((*e) as u32) = (one as u32)
            set fm_mode: 2
        else
            set fm_mode: 1
    }

    procedure parse_ids(s: pointer[const_char])
    {
        var p s as pointer[u8]
        var cur: i64 0 - 1
        repeat
        {
            let c *p as i64
            if c >= 48
            {
                if c <= 57
                {
                    if cur < 0
                        set cur: 0
                    set cur: (cur * 10) + (c - 48)
                }
            }
            if c < 48
                set cur: FrameMark.flush_id(cur)
            if c > 57
                set cur: FrameMark.flush_id(cur)
            if c = 0
                break
            set p: p + 1
        }
    }

    function flush_id(cur: i64) returns i64
    {
        if cur < 0
            return 0 - 1
        if cur < FM_MAX_PRIMS
            set *(fm_trusted + cur): 1
        0 - 1
    }

    ; --- the region, by documented offset ---------------------------------
    ; 0 next_object, 1 current_page (null while the head IS the tail),
    ; 2 next_page, 3 exclusive_pages.head
    function tail() returns pointer[size_t]
    {
        let h fm_head as pointer[size_t]
        let t *(h + 1) as pointer[size_t]
        if t = null
            return h
        t
    }

    function excl_head() returns i64
    {
        if fm_head = null
            return 0
        let h fm_head as pointer[size_t]
        *(h + 3) as i64
    }

    ; --- hooks -------------------------------------------------------------

    ; VM.push_frame, after csp was incremented: the new frame's index is csp-1
    procedure push(csp: int)
    {
        if FrameMark.on() = false
            return
        let idx (csp - 1) as i64
        set fm_frames: fm_frames + 1
        set fm_top: idx
        if idx < 0
            return
        if idx >= FM_MAX_DEPTH
        {
            set fm_b_deep: fm_b_deep + 1
            return
        }
        if fm_head = null
        {
            ; outside any eval bracket the run page is the host, and that is
            ; never rewound — mark the slot unusable
            set *(fm_gen_at + idx): 0 - 1
            return
        }
        let t FrameMark.tail()
        set *(fm_page + idx): t as i64
        set *(fm_off + idx): *t as i64
        set *(fm_gen_at + idx): fm_gen
        set *(fm_epoch_at + idx): fm_epoch
        set *(fm_excl_at + idx): FrameMark.excl_head()
    }

    ; The ReturnInsn arm, before VM.pop_frame — `csp` is still the leaving
    ; frame's, so its index is csp-1, and `result` is the value it yields.
    procedure pop(csp: int, result: pointer[void])
    {
        if FrameMark.on() = false
            return
        let idx (csp - 1) as i64
        set fm_top: idx - 1
        if idx < 0
            return
        if idx >= FM_MAX_DEPTH
            return
        if fm_head = null
        {
            set fm_b_invalid: fm_b_invalid + 1
            return
        }
        ; 1. VALID
        if *(fm_gen_at + idx) <> fm_gen
        {
            set fm_b_invalid: fm_b_invalid + 1
            return
        }
        ; 5. QUIET (checked early — it is the cheapest and the most common no)
        if *(fm_epoch_at + idx) <> fm_epoch
        {
            set fm_b_publish: fm_b_publish + 1
            return
        }
        ; 3. EXCLUSIVE — the region head's list. ★It is checked on the HEAD
        ; because that is where a frame-hosted oversized allocation lands
        ; (`allocate` forwards to allocate_oversized on the page it was called
        ; on, and a frame allocates on its host = the head). The residual is
        ; named at `store`: an oversized block requested through Page.get(obj)
        ; for an obj on an INTERMEDIATE page attaches to THAT page's list, and
        ; its PageNode is bump-allocated in our range. The multi-page rewind
        ; below refuses any chain that carries such a list, which closes it for
        ; every page the rewind touches; a surviving intermediate page is the
        ; part that stays open (measured rare: 4185 frames of 82 M touched an
        ; exclusive list at all).
        let eh FrameMark.excl_head()
        if eh <> *(fm_excl_at + idx)
        {
            set fm_b_excl: fm_b_excl + 1
            return
        }
        let mark *(fm_off + idx)
        let mp *(fm_page + idx) as pointer[size_t]
        ; 2. THE CHAIN — the mark page is still the tail (the cheap, common
        ; case: one store), or the frame appended pages and we hand them back.
        let t FrameMark.tail()
        if (t as i64) <> (mp as i64)
        {
            FrameMark.pop_multipage(idx, mp, mark, result)
            return
        }
        let now *t as i64
        ; 4. RESULT — does the returned value lie above the mark? The range is
        ; inside ONE page by condition 2, so this is an address comparison.
        let r result as i64
        if r >= mark
        {
            if r < now
            {
                set fm_b_result: fm_b_result + 1
                FrameMark.charge_result()
                return
            }
        }
        let d now - mark
        if d <= 0
            return
        set fm_rewound: fm_rewound + 1
        set fm_bytes: fm_bytes + d
        if FrameMark.live()
            set *t: mark as size_t
    }

    ; ★The MULTI-PAGE rewind. Everything from `mp.next_page` onward was appended
    ; by this frame — `allocate` only ever appends at the region's tail — so the
    ; whole tail of the chain goes back to the heap bucket and `mp` becomes the
    ; tail again. Worth having because the PAGE blocker is not about frame size
    ; (99.7 % of frames allocate under 4 KB) but about where the bump pointer
    ; happened to stand at entry: measured, it blocked 19 % of all frames.
    ;
    ; Two passes on purpose: VALIDATE the whole chain first, then release. A page
    ; carrying an exclusive-page list must not be dropped — its PageNode was
    ; bump-allocated in our own range, so the list head would dangle — and
    ; finding that out half way through the release would leave the region in
    ; pieces.
    procedure pop_multipage(idx: i64, mp: pointer[size_t], mark: i64, result: pointer[void])
    {
        if fm_multipage = false
        {
            set fm_b_page: fm_b_page + 1
            return
        }
        ; ★★★Condition 4 (RESULT) has to be re-asked HERE, over the whole chain —
        ; and forgetting it is exactly what happened on the first attempt: the
        ; single-page path checks the result AFTER the chain test, so the
        ; multi-page branch returned before ever looking at it and freed the
        ; value the frame was returning. The engine said so within one run
        ; ("1st argument for primitive reverse of wrong type ... not a list",
        ; with unknown objects at plausible addresses). The DRY numbers had looked
        ; excellent — accounting cannot catch a missing condition, only running
        ; can.
        let rp Page.get(result) as i64
        if rp = (mp as i64)
        {
            if (result as i64) >= mark
            {
                set fm_b_result: fm_b_result + 1
                FrameMark.charge_result()
                return
            }
        }
        var p *(mp + 2) as pointer[size_t]
        var bytes (*mp as i64) - mark
        var pages: i64 0
        while p <> null
        {
            if *(p + 3) <> 0
            {
                ; an exclusive-page list hangs off this page
                set fm_b_excl: fm_b_excl + 1
                return
            }
            if rp = (p as i64)
            {
                ; the returned value lives on a page we would hand back
                set fm_b_result: fm_b_result + 1
                FrameMark.charge_result()
                return
            }
            set bytes: bytes + ((*p as i64) - (p as i64))
            set pages: pages + 1
            set p: *(p + 2) as pointer[size_t]
        }
        if bytes <= 0
            return
        set fm_rewound: fm_rewound + 1
        set fm_rewound_multi: fm_rewound_multi + 1
        set fm_bytes: fm_bytes + bytes
        set fm_pages_freed: fm_pages_freed + pages
        if FrameMark.live() = false
            return
        var q *(mp + 2) as pointer[size_t]
        while q <> null
        {
            let nxt *(q + 2) as pointer[size_t]
            Page.release_page(q as pointer[Page])
            set q: nxt
        }
        ; mp is the tail again: cut the chain, restore the head's tail pointer
        ; (null when the head IS the tail — that is what `allocate` expects, it
        ; creates the first extension on demand) and put the bump pointer back.
        set *(mp + 2): 0 as size_t
        let h fm_head as pointer[size_t]
        if (mp as i64) = (fm_head as i64)
            set *(h + 1): 0 as size_t
        else
            set *(h + 1): mp as size_t
        set *mp: mark as size_t
    }

    ; a frame left by a path that reports no result (continuations, call/cc
    ; unwinds): nothing may be rewound and nothing above ANY live mark can be
    ; trusted, so this publishes.
    procedure pop_unknown()
    {
        if FrameMark.on() = false
            return
        set fm_b_noresult: fm_b_noresult + 1
        FrameMark.publish()
    }

    ; Primitive.dispatch — every primitive publishes unless it is trusted.
    procedure prim(id: int)
    {
        if FrameMark.on() = false
            return
        set fm_last_prim: id as i64
        if fm_trust_prims
            return
        let i id as i64
        if i >= 0
        {
            if i < FM_MAX_PRIMS
            {
                if *(fm_trusted + i) <> 0
                    return
            }
        }
        FrameMark.publish()
    }

    ; ★★★A STORE into a pre-existing object — the audit's real subject. It
    ; publishes only in one shape, and the test for it is two comparisons:
    ;
    ;   * `target` lives in the region we are marking, AND
    ;   * `target` lies BELOW the innermost frame's mark.
    ;
    ; Then whatever the store allocates lands at the region's TAIL, i.e. inside
    ; the frame's range, while the target survives the rewind — a dangling
    ; pointer. If the target is in ANOTHER region (the grove, the run page), a
    ; container growing off it allocates at THAT region's tail and can never
    ; point into our range. If the target is inside the innermost frame's own
    ; range, every rewind that discards the pointee discards the target too.
    ;
    ; ★This is the finding that made the audit worth doing: the engine already
    ; hosts such memoizations on `Page.get(object)` — the rope flatten says so
    ; in its comment — and that protects against BRACKET granularity, where the
    ; object's region and the caller's scratch are different regions. It does
    ; NOT protect against a frame mark: within ONE region `Page.get(x)` resolves
    ; to the region's tail, which is above every live mark.
    procedure store(target: pointer[void])
    {
        if FrameMark.on() = false
            return
        if target = null
            return
        if fm_head = null
            return
        let tp Page.get(target)
        let tpp tp as pointer[size_t]
        ; Page.region — the head of the region the target's page belongs to
        let treg *(tpp + 4) as pointer[void]
        if treg <> fm_head
            return
        if fm_top < 0
        {
            FrameMark.publish()
            return
        }
        if fm_top >= FM_MAX_DEPTH
        {
            FrameMark.publish()
            return
        }
        if *(fm_gen_at + fm_top) <> fm_gen
        {
            FrameMark.publish()
            return
        }
        let t FrameMark.tail()
        if (t as i64) <> *(fm_page + fm_top)
        {
            FrameMark.publish()
            return
        }
        let r target as i64
        if r >= *(fm_off + fm_top)
        {
            if r < (*t as i64)
            {
                set fm_stores_local: fm_stores_local + 1
                return
            }
        }
        FrameMark.publish()
    }

    procedure charge_result()
    {
        if fm_result_by_prim = null
            return
        let i fm_last_prim
        if i < 0
            return
        if i >= FM_MAX_PRIMS
            return
        set *(fm_result_by_prim + i): *(fm_result_by_prim + i) + 1
    }

    ; the escaping host: the eval region as the engine would have used it
    function p_host(interp_host: pointer[Page]) returns pointer[Page]
    {
        if fm_p_host <> null
            return fm_p_host
        interp_host
    }

    ; F, created on first use from the perm host and never handed back (one page
    ; plus whatever it grows; a frame pop returns the growth).
    function f_arena(perm: pointer[Page]) returns pointer[Page]
    {
        if fm_head <> null
            return fm_head as pointer[Page]
        let a perm.allocate_exclusive_page()
        set fm_head: a as pointer[void]
        a
    }

    ; ★★★Is `v` in F AT ALL? Not "in the innermost frame's range" — that was the
    ; first version and it SIGSEGVed on the first live run. F holds nothing but
    ; frame-local data, so every byte of it dies at SOME frame pop; an argument
    ; belonging to an OUTER frame's range is just as fatal for a result placed in
    ; P, only later. The sound test is therefore the REGION, not the range: a P
    ; object may never reference F.
    function in_arena(v: pointer[void]) returns bool
    {
        if v = null
            return false
        if fm_head = null
            return false
        let pg Page.get(v) as pointer[size_t]
        ; Page.region — the head of the region this address belongs to
        let reg *(pg + 4) as pointer[void]
        if reg = fm_head
            return true
        ; the arena's own head page reports itself as its region
        if (pg as pointer[void]) = fm_head
            return true
        false
    }

    ; ★ THE HOST DECISION for one primitive call (rung 3). Called from
    ; Primitive.dispatch in place of `interp.get_host()`.
    function prim_host(n_args: int, args: pointer[pointer[void]], interp_host: pointer[Page], perm: pointer[Page]) returns pointer[Page]
    {
        if FrameMark.on() = false
            return interp_host
        if fm_arena = false
            return interp_host
        if fm_tail_call = false
        {
            set fm_to_f: fm_to_f + 1
            return FrameMark.f_arena(perm)
        }
        ; tail position: the result IS the frame's value, so it wants P — unless
        ; an argument lives in F and the result might retain it.
        var i 0
        while i < n_args
        {
            let a *(args + i)
            if FrameMark.in_arena(a)
            {
                set fm_to_f_argdeps: fm_to_f_argdeps + 1
                set fm_to_f: fm_to_f + 1
                return FrameMark.f_arena(perm)
            }
            set i: i + 1
        }
        set fm_to_p: fm_to_p + 1
        FrameMark.p_host(interp_host)
    }

    procedure note_tail(t: bool)
    {
        if FrameMark.on() = false
            return
        set fm_tail_call: t
    }

    procedure publish()
    {
        if FrameMark.on() = false
            return
        set fm_epoch: fm_epoch + 1
        set fm_publishes: fm_publishes + 1
    }

    ; ★ The insns that write the VM's VALUE STACK (`StackSet`, `SetImmediate`)
    ; rather than an ELObj. The value stack does not live in the eval region at
    ; all, and their offsets address the RUNNING frame's own locals, which die
    ; at its Return — so on that reading they cannot publish. That reading is an
    ; ASSUMPTION, not a proof, so it is switchable: DZ_FRAME_MARK_PUBLISH_STACK=1
    ; treats them as publications too, and the difference between the two runs is
    ; exactly what the assumption is worth. Boxes are a different matter and
    ; always publish — a box can belong to any enclosing frame.
    procedure publish_stack()
    {
        if FrameMark.on() = false
            return
        if fm_publish_stack = false
            return
        FrameMark.publish()
    }

    ; Interpreter.set_eval_region — the region under every live mark changes
    procedure region(p: pointer[Page])
    {
        if FrameMark.on() = false
            return
        ; with the second arena the marked region is F, which a bracket switch
        ; does NOT replace — only the escaping host P changes. Frames nest
        ; inside brackets, so an outer frame's F allocations must survive the
        ; inner bracket: F is reset by frame pops only.
        if fm_arena
        {
            set fm_p_host: p
            set fm_gen: fm_gen + 1
            return
        }
        let np p as pointer[void]
        if np = fm_head
            return
        set fm_head: np
        set fm_gen: fm_gen + 1
    }

    procedure report()
    {
        if fm_mode > 2
            return
        if fm_quiet
            return
        scaly_eputs "framemark: mode "
        if fm_mode = 2
            scaly_eputs "LIVE"
        else
            scaly_eputs "dry"
        if fm_trust_prims
            scaly_eputs ", ALL primitives trusted (ceiling, not sound)"
        if fm_publish_stack
            scaly_eputs ", value-stack writes publish too"
        scaly_eputnl()
        scaly_eputs "framemark: "
        scaly_eputi fm_frames
        scaly_eputs " frames, "
        scaly_eputi fm_rewound
        scaly_eputs " rewound ("
        let rp FrameMark.permille(fm_rewound, fm_frames)
        scaly_eputi rp
        scaly_eputs " per mille), "
        scaly_eputi fm_bytes
        scaly_eputs " bytes reclaimed"
        scaly_eputnl()
        scaly_eputs "framemark: "
        scaly_eputi fm_rewound_multi
        scaly_eputs " of those spanned pages, "
        scaly_eputi fm_pages_freed
        scaly_eputs " extension pages handed back"
        scaly_eputnl()
        scaly_eputs "framemark: blocked by  publish "
        scaly_eputi fm_b_publish
        scaly_eputs "  result "
        scaly_eputi fm_b_result
        scaly_eputs "  page "
        scaly_eputi fm_b_page
        scaly_eputs "  bracket "
        scaly_eputi fm_b_invalid
        scaly_eputs "  exclusive "
        scaly_eputi fm_b_excl
        scaly_eputs "  no-result "
        scaly_eputi fm_b_noresult
        scaly_eputs "  too-deep "
        scaly_eputi fm_b_deep
        scaly_eputnl()
        scaly_eputs "framemark: "
        scaly_eputi fm_publishes
        scaly_eputs " publications, "
        scaly_eputi fm_stores_local
        scaly_eputs " stores kept local"
        scaly_eputnl()
        if fm_arena
        {
            scaly_eputs "framemark: arena split — "
            scaly_eputi fm_to_p
            scaly_eputs " calls to P, "
            scaly_eputi fm_to_f
            scaly_eputs " to F (of those "
            scaly_eputi fm_to_f_argdeps
            scaly_eputs " tail calls held back by an argument in F)"
            scaly_eputnl()
        }
        FrameMark.report_result_prims()
    }

    ; the primitives whose RESULT blocked a rewind, descending, down to 1 % of
    ; the blocked total — the scoping list for the escape analysis's retention
    ; summaries.
    procedure report_result_prims()
    {
        if fm_result_by_prim = null
            return
        if fm_b_result <= 0
            return
        let floor fm_b_result / 100
        var shown: i64 0
        var round: i64 0
        while round < 12
        {
            var best: i64 0 - 1
            var bestn: i64 0
            var i: i64 0
            while i < FM_MAX_PRIMS
            {
                let n *(fm_result_by_prim + i)
                if n > bestn
                {
                    set bestn: n
                    set best: i
                }
                set i: i + 1
            }
            if best < 0
                return
            if bestn <= floor
                return
            scaly_eputs "framemark:   result from primitive id "
            scaly_eputi best
            scaly_eputs ": "
            scaly_eputi bestn
            scaly_eputs " frames blocked ("
            let pm FrameMark.permille(bestn, fm_b_result)
            scaly_eputi pm
            scaly_eputs " per mille of them)"
            scaly_eputnl()
            set *(fm_result_by_prim + best): 0
            set shown: shown + 1
            set round: round + 1
        }
    }

    function permille(n: i64, total: i64) returns i64
    {
        if total <= 0
            return 0
        (n * 1000) / total
    }
}
