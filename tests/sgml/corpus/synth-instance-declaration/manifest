# synth-instance-declaration — an <!ELEMENT> declaration inside the document
# instance. Markup declarations (DOCTYPE/LINKTYPE/ELEMENT/ATTLIST/ENTITY/NOTATION/
# SHORTREF/LINK/IDLINK) are not allowed in the instance, so onsgmls reports
# instanceDeclaration ("X" declaration not allowed in instance), skips the
# declaration, and continues the content (Stage 4, declaration-not-allowed trio).
BASE=entry
DOC=doc.sgm
