<!DOCTYPE doc [
<!ELEMENT doc - - (s, t, u)>
<!ELEMENT s - - ((a & b?), b)>
<!ELEMENT t - - (((a & b?) & c?), b)>
<!ELEMENT u - - (a & b?)*>
<!ELEMENT a - - (#PCDATA)>
<!ELEMENT b - - (#PCDATA)>
<!ELEMENT c - - (#PCDATA)>
]>
<doc><s><a>x</a><b>y</b></s><t><a>x</a><b>y</b></t><u><a>x</a><b>y</b></u></doc>
