<!DOCTYPE doc [
<!-- Undo.cxx: the speculation ROLLBACK of acceptStartTag. B is not
     admissible, so tryImplyTag speculatively opens A (O O); B is not
     admissible there either and C cannot be implied (- -), so the imply
     loop runs dry and Parser::undo pops the speculative A back off
     (UndoStartTag) before handleBadStartTag reports elementNotAllowed. -->
<!ELEMENT doc - - (a, b)>
<!ELEMENT a O O (c)>
<!ELEMENT b - - (#PCDATA)>
<!ELEMENT c - - (#PCDATA)>
]>
<doc><b>q</b></doc>
