<!DOCTYPE memo [
<!ELEMENT memo  - - (from, to, body)>
<!ELEMENT from  - O (#PCDATA)>
<!ELEMENT to    - O (#PCDATA)>
<!ELEMENT body  - O (para+)>
<!ELEMENT para  O O (#PCDATA)>
<!ATTLIST memo  priority (low|high) low>
]>
<memo priority=high>
<from>Alice
<to>Bob
<body>
<para>First line.
<para>Second line.
</memo>
