# synth-prolog-declaration — an <!ELEMENT> declaration in the PROLOG, before the
# DOCTYPE. Only DOCTYPE (and LINKTYPE) start a prolog declaration, so onsgmls
# reports prologDeclaration ("X" declaration not allowed in prolog), recovers past
# it, then parses the real DOCTYPE + instance normally (Stage 4, the "declaration
# not allowed in X" trio via reserved-name-in-context dispatch).
BASE=entry
DOC=doc.sgm
