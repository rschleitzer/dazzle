<!-- synth external DTD subset exercising parameter entities -->
<!ENTITY % inline  "(#PCDATA)">
<!ENTITY % item    "item">
<!ENTITY % common  "id ID #IMPLIED">
<!ELEMENT doc    - - (title, list, note)>
<!ELEMENT title  - - %inline;>
<!ELEMENT list   - - (%item;)+>
<!ELEMENT item   - O %inline;>
<!ELEMENT note   - - %inline;>
<!ATTLIST doc    %common; >
