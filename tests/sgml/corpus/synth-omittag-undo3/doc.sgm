<!DOCTYPE doc [
<!-- Both halves of the speculation in one document: the leading character
     data SUCCEEDS (SEC and P are implied, their buffered eventList is
     queued through queueElementEvents and the undo list is dropped), then
     Q fails everywhere and the same machinery rolls the attempt back:
     UndoEndTag re-pushes the elements popped while searching one level up
     in handleBadStartTag. (ASCII only - see undo2.) -->
<!ELEMENT doc - - (sec+)>
<!ELEMENT sec O O (p+)>
<!ELEMENT p O O (#PCDATA)>
<!ELEMENT q - - (#PCDATA)>
]>
<doc>text<q>x</q>more</doc>
