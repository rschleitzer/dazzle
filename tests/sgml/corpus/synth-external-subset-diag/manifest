# synth-external-subset-diag — a duplicate <!ELEMENT doc> inside an EXTERNAL DTD
# subset (doc.dtd, referenced via <!DOCTYPE doc SYSTEM "doc.dtd">). Proves an
# already-wired decl-subset diagnostic (duplicateElementDefinition) prints the
# EXTERNAL subset's display storage id (doc.dtd), not an empty file name —
# MessageReporter::printLocation's actualStorageId = the effective (resolved)
# system id (Stage 4 Increment 12, external-source display names).
BASE=entry
DOC=doc.sgm
