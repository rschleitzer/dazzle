<!DOCTYPE src [
<!ELEMENT src - - (a+)>
<!ELEMENT a - - (#PCDATA)>
]>
<!DOCTYPE rslt [
<!ELEMENT rslt - - (b+)>
<!ELEMENT b - - (#PCDATA)>
<!ATTLIST b size CDATA #IMPLIED>
]>
<!LINKTYPE map src rslt [
<!LINK #INITIAL a b [size="1"] #IMPLIED src rslt>
<!LINK other a nosuch a b [] a #IMPLIED>
<!LINK third #IMPLIED src rslt #IMPLIED src rslt>
]>
<src><a>t</a></src>
