<!-- external DTD subset in its own subdirectory; the entity's relative
     system id must resolve against THIS directory, not the document's -->
<!ELEMENT doc    - - (title, body)>
<!ELEMENT title  - - (#PCDATA)>
<!ELEMENT body   - - (item+)>
<!ELEMENT item   - O (#PCDATA)>
<!ENTITY  bodyref SYSTEM "bodycontent.sgm">
