# synth-entity-dtd-relative — an external general entity (`&bodyref;`) whose
# relative SYSTEM id is declared in an external DTD subset living in its own
# subdirectory (dtd/model.dtd). The entity's file (dtd/bodycontent.sgm) sits
# next to the DTD, NOT next to the document, so it is found only if the
# relative system id resolves against the DECLARING file's directory
# (PosixStorageManager::resolveRelative base = the DTD), captured at
# declaration time (Stage 4 Increment 11).
BASE=entry
DOC=doc.sgm
