<!DOCTYPE doc [
<!ELEMENT doc - - (head, body)>
<!ELEMENT head - - (#PCDATA)>
<!ELEMENT body - - (#PCDATA)>
]>
<!LINKTYPE fmt doc #IMPLIED [
<!ATTLIST head font CDATA #IMPLIED>
<!ATTLIST body font CDATA #IMPLIED>
<!LINK #INITIAL head [font="big"] body [font="small"]>
]>
<doc><head>h</head><body>b</body></doc>
