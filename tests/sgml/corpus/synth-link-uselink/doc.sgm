<!DOCTYPE doc [
<!ELEMENT doc - - (sec+)>
<!ELEMENT sec - - (par+)>
<!ELEMENT par - - (#PCDATA)>
]>
<!LINKTYPE fmt doc #IMPLIED [
<!ATTLIST (sec, par) style CDATA #IMPLIED>
<!LINK #INITIAL sec [style="s1"] par [style="p1"]>
<!LINK alt sec #USELINK #INITIAL [style="s2"] par #POSTLINK #RESTORE [style="p2"]>
]>
<doc><sec><par>a</par></sec>
<!USELINK alt fmt>
<sec><par>b</par></sec></doc>
