<!DOCTYPE doc [
<!ELEMENT doc - - (#PCDATA)>
<!ELEMENT oth - - (#PCDATA)>
]>
<!LINKTYPE spl #SIMPLE doc [
]>
<!LINKTYPE sp2 #SIMPLE #IMPLIED [
<!ATTLIST doc a CDATA #IMPLIED b CDATA #FIXED "v" c CDATA #CURRENT>
<!ATTLIST oth d CDATA #FIXED "w">
<!ATTLIST doc e ID #IMPLIED>
<!LINK #INITIAL doc>
<!IDLINK z doc>
]>
<doc>x</doc>
