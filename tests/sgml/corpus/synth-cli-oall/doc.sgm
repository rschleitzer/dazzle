<!DOCTYPE doc [
<!ELEMENT doc - - (p|q)+ +(note)>
<!ELEMENT p - O (#PCDATA)>
<!ELEMENT q - O EMPTY>
<!ELEMENT note - - (#PCDATA)>
<!NOTATION gif SYSTEM "gifview">
<!ENTITY zeta "z">
<!ENTITY pic SYSTEM "pic.gif" NDATA gif>
<!ENTITY alpha "a">
<!ENTITY beta SDATA "[beta]">
]>
