<!DOCTYPE doc [
<!ELEMENT doc - - (a & b)>
<!ELEMENT a - O EMPTY>
<!ELEMENT b - - (#PCDATA | c) +(c)>
<!ELEMENT c - - CDATA>
<!ATTLIST (b, c) n NUTOKEN #IMPLIED
                 v CDATA x
                 w CDATA #CURRENT>
<!ENTITY % unused "x">
<!ENTITY #DEFAULT "d">
<!ENTITY ic CDATA "y">
<!SHORTREF um "#" ic>
]>
<doc><a><b>t&undef;<?p?><![ INCLUDE [u]]></b></doc>
