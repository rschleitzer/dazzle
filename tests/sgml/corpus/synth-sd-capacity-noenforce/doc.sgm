<!DOCTYPE main [
<!ELEMENT main - - (a|b|c|d|e)+>
<!ELEMENT (a|b|c|d|e) - - (#PCDATA)>
<!ATTLIST main x CDATA #IMPLIED y CDATA #IMPLIED z CDATA #IMPLIED>
<!ATTLIST a id ID #IMPLIED ref IDREF #IMPLIED>
<!ENTITY e1 "one text that is long enough">
<!ENTITY e2 "two text that is long enough">
<!ENTITY e3 "three text that is long enough">
<!ENTITY e4 "four text that is long enough">
<!ENTITY e5 "five text that is long enough">
]>
<main x="hello" y="world" z="again">
<a id=i1>&e1;</a>
<b>&e2;</b>
<c>&e3;</c>
<d>&e4;</d>
<e>&e5;</e>
<a id=i2 ref=i1>&e1;&e2;&e3;</a>
</main>
