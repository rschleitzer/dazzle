<?rast-active-lpd:MYLINK>
<!DOCTYPE doc [
<!ELEMENT doc - - (p+)>
<!ELEMENT p - - (#PCDATA)>
]>
<!LINKTYPE mylink doc #IMPLIED [
<!ATTLIST p score CDATA #IMPLIED>
<!LINK setb p [score="9"]>
<!LINK #INITIAL p [score="5" #USELINK setb]>
]>
<doc><p>one</p><p>two</p><!USELINK #INITIAL mylink><p>three</p></doc>
