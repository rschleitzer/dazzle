<!DOCTYPE doc [
<!ELEMENT doc - - (#PCDATA)>
<!NOTATION tex PUBLIC "+//IDN example//NOTATION TeX//EN">
<!NOTATION gif SYSTEM "gifview">
<!ATTLIST #NOTATION gif w NUMBER #IMPLIED h NUMBER 42>
<!ENTITY pic PUBLIC "+//IDN example//NONSGML pic//EN" "pic.gif" NDATA gif>
<!ENTITY sub SYSTEM "sub.sgm" SUBDOC>
<!ATTLIST doc fmt NOTATION (tex|gif) #IMPLIED g ENTITY "pic" s ENTITY #IMPLIED>
]>
<doc fmt="tex" s="sub">hi</doc>
