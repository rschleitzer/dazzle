<!DOCTYPE doc [
<!-- Undo.cxx via acceptPcdata: character data inside A is not allowed and
     nothing can be implied to make it allowed (B is EMPTY and - -), so the
     undo list is rolled back and pcdataNotAllowed is reported. Exercises
     the message buffering too: keepMessages/discardKeptMessages must
     swallow every failed speculation attempt. (ASCII only - a non-SGML
     character in a comment is itself an error here.) -->
<!ELEMENT doc - - (a)>
<!ELEMENT a - - (b)>
<!ELEMENT b - - EMPTY>
]>
<doc><a>text<b></a></doc>
