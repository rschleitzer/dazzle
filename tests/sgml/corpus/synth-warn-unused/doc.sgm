<!DOCTYPE doc [
<!ENTITY #DEFAULT "dflt">
<!ENTITY % unused1 "x">
<!ENTITY % st "INCLUDE">
<!ELEMENT doc - - (#PCDATA)>
<!ATTLIST doc e ENTITY #IMPLIED>
<!ENTITY real SYSTEM "real.dat" NDATA fmt>
<!NOTATION fmt SYSTEM>
<!SHORTREF used "@" undef1>
<!SHORTREF unusedm "#" undef1>
<!USEMAP used doc>
]>
<doc e="undefent">x&noent;y</doc>
