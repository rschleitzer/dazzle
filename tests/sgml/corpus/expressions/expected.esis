)EXPECT
)TEST
AID TOKEN HEX-ZERO
ASKIP IMPLIED
APROGRAM IMPLIED
(TEST
(INPUT
-0x0
)INPUT
(EXPECT
-0\n\n    
)EXPECT
)TEST
)TESTS
AID TOKEN FLOAT-LITERALS
ATITLE CDATA Floating-Point Literals
(TESTS
(PROSE
-Floating-point literals contain a decimal point separating the integer and fractional parts.\n        
)PROSE
AID TOKEN FLOAT-PI
ASKIP IMPLIED
APROGRAM IMPLIED
(TEST
(INPUT
-3.14
)INPUT
(EXPECT
-3.14\n        
)EXPECT
)TEST
AID TOKEN FLOAT-TWO
ASKIP IMPLIED
APROGRAM IMPLIED
(TEST
(INPUT
-2.0
)INPUT
(EXPECT
-2.0\n        
)EXPECT
)TEST
AID TOKEN FLOAT-HALF
ASKIP IMPLIED
APROGRAM IMPLIED
(TEST
(INPUT
-0.5
)INPUT
(EXPECT
-0.5\n\n    
)EXPECT
