<!DOCTYPE doc [
<!ELEMENT doc - - (a*)>
<!ELEMENT a - - (#PCDATA)>
<!NOTATION gif SYSTEM "gifview">
<!ENTITY pic SYSTEM "pic.gif" NDATA gif>
<!ENTITY pic2 SYSTEM "p2.gif" NDATA gif>
<!ENTITY c CDATA "ctext">
<!ENTITY s SDATA "stext">
<!ATTLIST a g ENTITY #IMPLIED h ENTITIES #IMPLIED>
]>
<doc><a g="pic" h="c s pic2">x&pic;y</a><a g="pic2" h="pic">z</a></doc>
