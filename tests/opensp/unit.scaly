; Stage-1 opensp unit harness. Runs opensp.test() (foundation-layer checks)
; through the in-process JIT, mirroring tests/selfhosted:
;   scalyc --jit tests/opensp/unit.scaly    -> prints PASS on success
; A zero opensp.test() return means all foundation checks passed.

package scaly 0.1.0
package opensp 0.1.0

use opensp

if opensp.test() = 0
    print("PASS")
else
    print("FAIL")
