<Project Sdk="Microsoft.NET.Sdk">
  <!-- tools/oracle: sets a document with the C# backend Dazzle.Pdf (github.com/rschleitzer/dazzle-net)
       for tools/oracle/compare.py, which holds this port's PDF backend against it. Not a part of the
       port and not built by any suite of tests/run.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dazzle.Pdf" Version="0.14.0" />
  </ItemGroup>
</Project>
