# Build artifacts
*.o
*.lo
*.la
*.a
*.dylib
*.so
*.so.*
.libs/
.deps/

# Executables (of the C++ build under upstream/ -- anchored there: a bare
# `dazzle` would also ignore every NEW file under tests/dazzle and
# packages/dazzle)
upstream/**/openjade
upstream/**/jade/dazzle
upstream/dazzle

# OpenSP executables
opensp/nsgmls/onsgmls
opensp/sgmlnorm/osgmlnorm
opensp/spam/ospam
opensp/spent/ospent
opensp/spcat/ospcat
opensp/sx/osx

# Generated files
Makefile
Makefile.lt
Makefile.dep
config.h
config.status
config.log
config.cache
libtool
autom4te.cache/
Makefile.comm
Makefile.lib
Makefile.prog
stamp-*
po/*.gmo
po/stamp-po

# OpenSP generated files
opensp/config.h
opensp/config.status
opensp/config.log
opensp/libtool
opensp/msggen.pl
opensp/OpenSP-*.spec
opensp/intl/
opensp/po/Makefile
opensp/po/Makefile.in
opensp/po/POTFILES

# Generated message headers
*Messages.h
*Messages.cxx

# Generated instantiation files
*_inst.cxx
*_inst.m4

# Build directory
build/
opensp-install/

# IDE files (keep .vscode for shared settings)
.DS_Store
*.swp
*.swo
*~

# Claude Code
.claude/

# Core dumps
core
core.*

# Temporary files
*.tmp
*.bak

# --- the Scaly port (packages/, tests/) ---------------------------------

# dazzle/OpenSP corpus -- local-only local tier (see tests/sgml/README.md)
tests/sgml/corpus-private/
tests/sgml/corpus-private/corpus.map

# dazzle codegen tier -- local-only local tier (mirrored real-world
# models + blessed reference output trees; see tests/dazzle/codegen.map.example)
tests/dazzle/codegen-private/
tests/dazzle/codegen-private/codegen.map

# local workload paths for the perf survey (they name other repos)
tests/dazzle/perf-survey.local

# what a suite or a build leaves behind (the suites themselves write to
# scratch directories, not into the tree)
tests/**/build/
tests/**/out/
__pycache__/
*.pyc
