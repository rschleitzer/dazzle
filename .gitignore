# --- everywhere -------------------------------------------------------------

.DS_Store
*.swp
*.swo
*~
*.tmp
*.bak
.claude/

# --- the Scaly port (packages/, tests/) -------------------------------------

# optional local tiers of further documents and workloads, never committed
tests/sgml/corpus-private/
tests/dazzle/codegen-private/
tests/dazzle/perf-survey.local

# what a suite or a build leaves behind (the suites themselves write to
# scratch directories, not into the tree)
tests/**/build/
tests/**/out/
__pycache__/
*.pyc

# a checkout of the pdf package linked in for work on both (README, Build)
/packages/pdf
